            <xpdl2:Activity Id="_sUgkDsmREe6tB5HEgGPwCw" Name="TIMNOWConvertitore_DettaglioOrdine" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="TIMNOW-Convertitore_DettaglioOrdine">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_pI0ojiXtEea6a4eCDXx0DA" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
                  <xpdExt:InputMappings MapperContext="ProcessToSubProcess" MappingDirection="IN">
                    <xpdExt:DataMappings>
                      <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="DettaglioOrdineXSD">
                        <xpdl2:Actual ScriptGrammar="JavaScript">currentArricchimento.dettaglioOrdineElement</xpdl2:Actual>
                      </xpdExt:DataMapping>
                    </xpdExt:DataMappings>
                  </xpdExt:InputMappings>
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="OUT" Formal="DettaglioOrdineBOM">
                      <xpdl2:Actual ScriptGrammar="JavaScript">ARR_dettaglioOrdine</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" Width="128.0">
                  <xpdl2:Coordinates XCoordinate="301.0" YCoordinate="90.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">var listaIDRimossi = DataUtil.createList();&#xD;
var listaComponentiRimosse = DataUtil.createList();&#xD;
&#xD;
//SM_11280&#xD;
var GPONDIATTESTAZIONE = &quot;&quot;;&#xD;
GPONDIATTESTAZIONE = null;&#xD;
var IDSERVIZIO = &quot;&quot;;&#xD;
IDSERVIZIO = null;&#xD;
var PININTERVENTOAVUOTO = &quot;&quot;;&#xD;
PININTERVENTOAVUOTO = null;&#xD;
var COLLEGAMENTOFO = &quot;&quot;;&#xD;
COLLEGAMENTOFO = null;&#xD;
var COSTOEXTRA = &quot;&quot;;&#xD;
COSTOEXTRA = null;&#xD;
&#xD;
//Rimuovi componente per sostituzione&#xD;
for(var j = 0; j &lt; ARR_dettaglioOrdine.size(); j++)&#xD;
{&#xD;
	var currentARRdettOrdine = ARR_dettaglioOrdine.get(j);&#xD;
	if(localRequest.ordine != null)&#xD;
	{&#xD;
		var k = 0;&#xD;
		while(k &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(k);&#xD;
&#xD;
			if(componente.nomeComponente == currentARRdettOrdine.nomeComponente)&#xD;
			{	&#xD;
				//SM_11280: ECCEZIONE ATTRIBUTI DI OFDATITECNICI - vanno arricchiti considerando sempre il delta&#xD;
				if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OFDATITECNICI)&#xD;
				{&#xD;
					for(var z = 0; z&lt;componente.attributiDettaglioOrdine.size(); z++)&#xD;
					{&#xD;
						var attributo = componente.attributiDettaglioOrdine.get(z);&#xD;
					&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.GPONDIATTESTAZIONE){&#xD;
							GPONDIATTESTAZIONE = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDSERVIZIO){&#xD;
							IDSERVIZIO = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PININTERVENTOAVUOTO){&#xD;
							PININTERVENTOAVUOTO = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COLLEGAMENTOFO){&#xD;
							COLLEGAMENTOFO = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COSTOEXTRA){&#xD;
							COSTOEXTRA = attributo.valoreAttributo;&#xD;
						}&#xD;
					}&#xD;
				}								&#xD;
				Process.auditLog(&quot;E' stata rimossa per sostituzione la componente &quot;+currentARRdettOrdine.nomeComponente);&#xD;
				listaIDRimossi.add(componente.IDDettaglioOrdine);&#xD;
				listaComponentiRimosse.add(componente.nomeComponente);&#xD;
				localRequest.ordine.dettaglioordine.remove(k);&#xD;
				k--;&#xD;
			}&#xD;
			k++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//Aggiungi&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
for(var j = 0; j &lt; ARR_dettaglioOrdine.size(); j++)&#xD;
{		&#xD;
       var currentARRdettOrdine = ARR_dettaglioOrdine.get(j);&#xD;
       &#xD;
	   //RU_1564 - C11 2025 - INT UNICO - SM_11833: spostato if per costruzione array&#xD;
	   //Per OFSERVIZIOAGGIUNTIVO/OFAPPARATO serve gestire il legame delle componenti di livello L3 (script successivo)&#xD;
	   if((currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OFSERVIZIOAGGIUNTIVO&#xD;
					 ||currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OFAPPARATO)&#xD;
				&amp;&amp; StateMachineValidationResponseOF != null &#xD;
				&amp;&amp; (StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null&#xD;
				    ||StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null)   //MIG RIENTRI DEL82 - C01 2026&#xD;
				&amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.flagIU == &quot;SI&quot;)&#xD;
       {&#xD;
			ARR_dettaglioOrdineOF_L3.add(ScriptUtil.copy(currentARRdettOrdine)); //me le salvo tutte in questo array per poi manipolarle nello script successivo&#xD;
			Process.auditLog(&quot;Aggiunta nell'arrayOF la componente: &quot; + String(currentARRdettOrdine.nomeComponente)+ &quot; con IDDettaglioOrdine: &quot; + String(currentARRdettOrdine.IDDettaglioOrdine));&#xD;
       }&#xD;
	   else&#xD;
	   {	   &#xD;
		   currentARRdettOrdine.integrationID = localRequest.IDRichiestaOLO + (localRequest.ordine.dettaglioordine.size() + 1);&#xD;
		   var idDettOrd = localRequest.ordine.dettaglioordine.size() + 1 + listaIDRimossi.size(); //Aggiunto listaIDRimossi.size() per evitare ID duplicati&#xD;
		   &#xD;
		   if(listaComponentiRimosse.contains(currentARRdettOrdine.nomeComponente))&#xD;
		   {&#xD;
				 var trovato = false;&#xD;
				 var z = 0;&#xD;
				 &#xD;
				 while(!trovato &amp;&amp; z &lt; listaComponentiRimosse.size())&#xD;
				 {&#xD;
						if(listaComponentiRimosse.get(z) == currentARRdettOrdine.nomeComponente)&#xD;
						{&#xD;
							   idDettOrd = listaIDRimossi.get(z);&#xD;
							   listaComponentiRimosse.remove(z);&#xD;
							   listaIDRimossi.remove(z);&#xD;
							   trovato = true;&#xD;
						}&#xD;
						z++;&#xD;
				 }&#xD;
		   }            &#xD;
		   currentARRdettOrdine.IDDettaglioOrdine = idDettOrd;&#xD;
		   currentARRdettOrdine.IDDettaglioOrdineParent = 1;&#xD;
		   currentARRdettOrdine.IDDettaglioOrdineRoot = 1;&#xD;
		   currentARRdettOrdine.created = date;&#xD;
		   currentARRdettOrdine.lastUpdate = date;&#xD;
		   &#xD;
		   &#xD;
		   for(var i = 0; i &lt; currentARRdettOrdine.attributiDettaglioOrdine.size(); i++)&#xD;
		   {&#xD;
				 var attributo = currentARRdettOrdine.attributiDettaglioOrdine.get(i);            &#xD;
				 attributo.IDDettaglioOrdine = idDettOrd;&#xD;
				 attributo.created = date;&#xD;
				 attributo.lastUpdate = date;&#xD;
						&#xD;
				 //SM_11280&#xD;
				 if(currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OFDATITECNICI)&#xD;
				 {&#xD;
					var foundGPONDIATTESTAZIONE = false;&#xD;
					var foundIDSERVIZIO = false;&#xD;
					var foundPININTERVENTOAVUOTO = false;				&#xD;
					var foundCOLLEGAMENTOFO = false;&#xD;
					var foundCOSTOEXTRA= false;	&#xD;
					&#xD;
					if(GPONDIATTESTAZIONE != null &amp;&amp; !foundGPONDIATTESTAZIONE)&#xD;
					{	&#xD;
						for(var z=0; z&lt;currentARRdettOrdine.attributiDettaglioOrdine.size(); z++)&#xD;
						{&#xD;
							var attributoARRdettOrdn = currentARRdettOrdine.attributiDettaglioOrdine.get(z);&#xD;
						&#xD;
							if(attributoARRdettOrdn.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.GPONDIATTESTAZIONE){&#xD;
								foundGPONDIATTESTAZIONE = true;&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						if(!foundGPONDIATTESTAZIONE){&#xD;
							var attributoARRdettOrdn = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();								&#xD;
							attributoARRdettOrdn.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							attributoARRdettOrdn.IDDettaglioOrdine = currentARRdettOrdine.IDDettaglioOrdine;&#xD;
							attributoARRdettOrdn.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							attributoARRdettOrdn.created = date;&#xD;
							attributoARRdettOrdn.lastUpdate = date;&#xD;
							attributoARRdettOrdn.operatore = &quot;BPM&quot;;&#xD;
							attributoARRdettOrdn.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.GPONDIATTESTAZIONE;&#xD;
							attributoARRdettOrdn.valoreAttributo = GPONDIATTESTAZIONE;&#xD;
							currentARRdettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoARRdettOrdn));&#xD;
							Process.auditLog(&quot;Aggiunto GPONDIATTESTAZIONE in &quot;+currentARRdettOrdine.nomeComponente+&quot; con valore: &quot;+attributoARRdettOrdn.valoreAttributo);&#xD;
							GPONDIATTESTAZIONE = null;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					if(IDSERVIZIO != null &amp;&amp; !foundIDSERVIZIO)&#xD;
					{		&#xD;
						for(var z=0; z&lt;currentARRdettOrdine.attributiDettaglioOrdine.size(); z++)&#xD;
						{&#xD;
							var attributoARRdettOrdn = currentARRdettOrdine.attributiDettaglioOrdine.get(z);&#xD;
						&#xD;
							if(attributoARRdettOrdn.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDSERVIZIO){&#xD;
								foundIDSERVIZIO = true;&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						if(!foundIDSERVIZIO){&#xD;
							var attributoARRdettOrdn = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();								&#xD;
							attributoARRdettOrdn.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							attributoARRdettOrdn.IDDettaglioOrdine = currentARRdettOrdine.IDDettaglioOrdine;&#xD;
							attributoARRdettOrdn.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							attributoARRdettOrdn.created = date;&#xD;
							attributoARRdettOrdn.lastUpdate = date;&#xD;
							attributoARRdettOrdn.operatore = &quot;BPM&quot;;&#xD;
							attributoARRdettOrdn.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDSERVIZIO;&#xD;
							attributoARRdettOrdn.valoreAttributo = IDSERVIZIO;&#xD;
							currentARRdettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoARRdettOrdn));&#xD;
							Process.auditLog(&quot;Aggiunto IDSERVIZIO in &quot;+currentARRdettOrdine.nomeComponente+&quot; con valore: &quot;+attributoARRdettOrdn.valoreAttributo);&#xD;
							IDSERVIZIO = null;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					if(PININTERVENTOAVUOTO != null &amp;&amp; !foundPININTERVENTOAVUOTO)&#xD;
					{		&#xD;
						for(var z=0; z&lt;currentARRdettOrdine.attributiDettaglioOrdine.size(); z++)&#xD;
						{&#xD;
							var attributoARRdettOrdn = currentARRdettOrdine.attributiDettaglioOrdine.get(z);&#xD;
						&#xD;
							if(attributoARRdettOrdn.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PININTERVENTOAVUOTO){&#xD;
								foundPININTERVENTOAVUOTO= true;&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						if(!foundPININTERVENTOAVUOTO){&#xD;
							var attributoARRdettOrdn = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();								&#xD;
							attributoARRdettOrdn.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							attributoARRdettOrdn.IDDettaglioOrdine = currentARRdettOrdine.IDDettaglioOrdine;&#xD;
							attributoARRdettOrdn.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							attributoARRdettOrdn.created = date;&#xD;
							attributoARRdettOrdn.lastUpdate = date;&#xD;
							attributoARRdettOrdn.operatore = &quot;BPM&quot;;&#xD;
							attributoARRdettOrdn.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PININTERVENTOAVUOTO;&#xD;
							attributoARRdettOrdn.valoreAttributo = PININTERVENTOAVUOTO;&#xD;
							currentARRdettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoARRdettOrdn));&#xD;
							Process.auditLog(&quot;Aggiunto PININTERVENTOAVUOTO in &quot;+currentARRdettOrdine.nomeComponente+&quot; con valore: &quot;+attributoARRdettOrdn.valoreAttributo);&#xD;
							PININTERVENTOAVUOTO = null;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					if(COLLEGAMENTOFO != null &amp;&amp; !foundCOLLEGAMENTOFO)&#xD;
					{		&#xD;
						for(var z=0; z&lt;currentARRdettOrdine.attributiDettaglioOrdine.size(); z++)&#xD;
						{&#xD;
							var attributoARRdettOrdn = currentARRdettOrdine.attributiDettaglioOrdine.get(z);&#xD;
						&#xD;
							if(attributoARRdettOrdn.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COLLEGAMENTOFO){&#xD;
								foundCOLLEGAMENTOFO = true;&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						if(!foundCOLLEGAMENTOFO){&#xD;
							var attributoARRdettOrdn = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();								&#xD;
							attributoARRdettOrdn.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							attributoARRdettOrdn.IDDettaglioOrdine = currentARRdettOrdine.IDDettaglioOrdine;&#xD;
							attributoARRdettOrdn.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							attributoARRdettOrdn.created = date;&#xD;
							attributoARRdettOrdn.lastUpdate = date;&#xD;
							attributoARRdettOrdn.operatore = &quot;BPM&quot;;&#xD;
							attributoARRdettOrdn.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COLLEGAMENTOFO;&#xD;
							attributoARRdettOrdn.valoreAttributo = COLLEGAMENTOFO;&#xD;
							currentARRdettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoARRdettOrdn));&#xD;
							Process.auditLog(&quot;Aggiunto COLLEGAMENTOFO in &quot;+currentARRdettOrdine.nomeComponente+&quot; con valore: &quot;+attributoARRdettOrdn.valoreAttributo);&#xD;
							COLLEGAMENTOFO = null;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					if(COSTOEXTRA != null &amp;&amp; !foundCOSTOEXTRA)&#xD;
					{	&#xD;
						for(var z=0; z&lt;currentARRdettOrdine.attributiDettaglioOrdine.size(); z++)&#xD;
						{&#xD;
							var attributoARRdettOrdn = currentARRdettOrdine.attributiDettaglioOrdine.get(z);&#xD;
						&#xD;
							if(attributoARRdettOrdn.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COSTOEXTRA){&#xD;
								foundCOSTOEXTRA = true;&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						if(!foundCOSTOEXTRA){&#xD;
							var attributoARRdettOrdn = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();								&#xD;
							attributoARRdettOrdn.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							attributoARRdettOrdn.IDDettaglioOrdine = currentARRdettOrdine.IDDettaglioOrdine;&#xD;
							attributoARRdettOrdn.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							attributoARRdettOrdn.created = date;&#xD;
							attributoARRdettOrdn.lastUpdate = date;&#xD;
							attributoARRdettOrdn.operatore = &quot;BPM&quot;;&#xD;
							attributoARRdettOrdn.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COSTOEXTRA;&#xD;
							attributoARRdettOrdn.valoreAttributo = COSTOEXTRA;&#xD;
							currentARRdettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoARRdettOrdn));&#xD;
							Process.auditLog(&quot;Aggiunto COSTOEXTRA in &quot;+currentARRdettOrdine.nomeComponente+&quot; con valore: &quot;+attributoARRdettOrdn.valoreAttributo);&#xD;
							COSTOEXTRA = null;&#xD;
						}&#xD;
					}&#xD;
				 }&#xD;
				 //ARRICCHIMENTO DEGLI ATTRIBUTI DI SERVIZIOAGGIUNTIVO DALLA COMPONENTE OFSERVIZIOAGGIUNTIVO &#xD;
				 //APPARATO DA OF NON RISALE, MA SOLO DA DTU&#xD;
				 //RU_1564 - C11 2025 - INT UNICO - QUESTA LOGICA RIMANE SOLO PER FLAGIU NON VALORIZZATO&#xD;
				 else if(currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OFSERVIZIOAGGIUNTIVO &#xD;
						 &amp;&amp; attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMESERVIZIO&#xD;
						 &amp;&amp; StateMachineValidationResponseOF != null &amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null&#xD;
						 &amp;&amp; localRequest.ordine != null&#xD;
						 &amp;&amp; (localRequest.ordine.flagIU == null || localRequest.ordine.flagIU == &quot;&quot;))  //C11 2025 - INT UNICO&#xD;
				 {&#xD;
					var NOMESERVIZIOOF = &quot;&quot;;&#xD;
					NOMESERVIZIOOF = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo NOMESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente DTUSERVIZIOAGGIUNTIVO con IDDett &quot;+currentARRdettOrdine.IDDettaglioOrdine);	&#xD;
					&#xD;
					for(var m=0; m&lt;localRequest.ordine.dettaglioordine.size(); m++)&#xD;
					{&#xD;
						var componenteRic = localRequest.ordine.dettaglioordine.get(m);&#xD;
						&#xD;
						if(componenteRic.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOAGGIUNTIVO)&#xD;
						{&#xD;
							var NOMESERVIZIORICHIESTA = &quot;&quot;;&#xD;
							NOMESERVIZIORICHIESTA = null;&#xD;
							&#xD;
							for(var q=0; q&lt;componenteRic.attributiDettaglioOrdine.size(); q++)&#xD;
							{&#xD;
								var attributoRic = componenteRic.attributiDettaglioOrdine.get(q);&#xD;
								&#xD;
								if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMESERVIZIO)&#xD;
								{&#xD;
									NOMESERVIZIORICHIESTA = attributoRic.valoreAttributo;&#xD;
									Process.auditLog(&quot;Trovato attributo NOMESERVIZIO&quot;+ attributoRic.valoreAttributo +&quot; su componente SERVIZIOAGGIUNTIVO con IDDett &quot;+componenteRic.IDDettaglioOrdine);			&#xD;
								}&#xD;
							}&#xD;
							&#xD;
							//DEVO ARRICCHIRE LA COMPONENTE SERVIZIOAGGIUNTIVO CHE HA LO STESSO NOMESERVIZIO DI QUELLO DELLA COMPONENTE DTUSERVIZIOAGGIUNTIVO&#xD;
							if(NOMESERVIZIORICHIESTA == NOMESERVIZIOOF)&#xD;
							{&#xD;
								var ESITOSERVIZIO = &quot;&quot;;&#xD;
								ESITOSERVIZIO = null;&#xD;
								var CODICEMOTIVAZIONESERVIZIO = &quot;&quot;;&#xD;
								CODICEMOTIVAZIONESERVIZIO = null;&#xD;
								var MOTIVAZIONESERVIZIO = &quot;&quot;;&#xD;
								MOTIVAZIONESERVIZIO = null;&#xD;
								&#xD;
								var foundESITO = false;&#xD;
								var foundCAUSALEESITO = false;&#xD;
								var foundDESCRIZIONEESITO = false;&#xD;
								&#xD;
								//RECUPERO GLI ATTRIBUTI DALLA COMPONENTE DTUSERVIZIOAGGIUNTIVO&#xD;
								for(var z=0; z&lt;currentARRdettOrdine.attributiDettaglioOrdine.size(); z++)&#xD;
								{&#xD;
									var attributoARRdettOrdine = currentARRdettOrdine.attributiDettaglioOrdine.get(z);&#xD;
								&#xD;
									if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITOSERVIZIO)&#xD;
									{&#xD;
										ESITOSERVIZIO = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMOTIVAZIONESERVIZIO)&#xD;
									{&#xD;
										CODICEMOTIVAZIONESERVIZIO = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MOTIVAZIONESERVIZIO )&#xD;
									{&#xD;
										MOTIVAZIONESERVIZIO  = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
								}&#xD;
									&#xD;
								//ARRICCHISCO LA COMPONENTE SERVIZIOAGGIUNTIVO CON I VALORI RECUPERATI DA DTUSERVIZIOAGGIUNTIVO&#xD;
								for(var k=0; k&lt;componenteRic.attributiDettaglioOrdine.size(); k++)&#xD;
								{&#xD;
									var attributoRic = componenteRic.attributiDettaglioOrdine.get(k);&#xD;
									&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITO&#xD;
									   &amp;&amp; ESITOSERVIZIO != null)&#xD;
									{&#xD;
										foundESITO = true;&#xD;
										attributoRic.valoreAttributo = ESITOSERVIZIO;&#xD;
										Process.auditLog(&quot;Aggiornato attributo ESITO&quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
									}&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAUSALEESITO &#xD;
									   &amp;&amp; CODICEMOTIVAZIONESERVIZIO != null)&#xD;
									{&#xD;
										foundCAUSALEESITO = true;&#xD;
										attributoRic.valoreAttributo = CODICEMOTIVAZIONESERVIZIO;&#xD;
										Process.auditLog(&quot;Aggiornato attributo CAUSALEESITO&quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
									}&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONEESITO&#xD;
									   &amp;&amp; MOTIVAZIONESERVIZIO  != null)&#xD;
									{&#xD;
										foundDESCRIZIONEESITO = true;&#xD;
										attributoRic.valoreAttributo = MOTIVAZIONESERVIZIO ;&#xD;
										Process.auditLog(&quot;Aggiornato attributo DESCRIZIONEESITO &quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
									}								&#xD;
								}&#xD;
								&#xD;
								var attributoDaAggiungere = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
								var data = DateTimeUtil.createDatetime();&#xD;
								attributoDaAggiungere.IDDettaglioOrdine = componenteRic.IDDettaglioOrdine;&#xD;
								attributoDaAggiungere.IDRichiestaOLO = componenteRic.IDRichiestaOLO;&#xD;
								attributoDaAggiungere.created = data;&#xD;
								attributoDaAggiungere.lastUpdate = data;&#xD;
								attributoDaAggiungere.operatore = componenteRic.operatore;&#xD;
								attributoDaAggiungere.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
								&#xD;
								if(ESITOSERVIZIO != null &amp;&amp; !foundESITO)&#xD;
								{&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITO;&#xD;
									attributoDaAggiungere.valoreAttributo = ESITOSERVIZIO;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo ESITO&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
								if(CODICEMOTIVAZIONESERVIZIO != null &amp;&amp; !foundCAUSALEESITO)&#xD;
								{&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAUSALEESITO;&#xD;
									attributoDaAggiungere.valoreAttributo = CODICEMOTIVAZIONESERVIZIO;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo CAUSALEESITO&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
								if(MOTIVAZIONESERVIZIO != null &amp;&amp; !foundDESCRIZIONEESITO)&#xD;
								{&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONEESITO;&#xD;
									attributoDaAggiungere.valoreAttributo = MOTIVAZIONESERVIZIO;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo DESCRIZIONEESITO&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
		   }&#xD;
			   &#xD;
		   // ARRICCHIMENTO&#xD;
		   localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(currentARRdettOrdine));&#xD;
	   }&#xD;
}</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_sUgkEcmREe6tB5HEgGPwCw" Name="ErrorEvent" xpdExt:Visibility="Private" xpdExt:DisplayName="Error Event">
              <xpdl2:Event>
                <xpdl2:EndEvent Result="Error">
                  <xpdl2:ResultError ErrorCode="Arricchimento non gestito"/>
                </xpdl2:EndEvent>
              </xpdl2:Event>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" Width="45.0">
                  <xpdl2:Coordinates XCoordinate="169.0" YCoordinate="220.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:AssociatedParameters DisableImplicitAssociation="true"/>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_8HMXoMCVEfCIb9HPiytCnA" Name="ArricchimentoordinedaOF" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento ordine da OF" xpdExt:RequireNewTransaction="false">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">//RU_1564 - C11 2025 - INT UNICO - LOGICA PARTICOLARE PER LA GESTIONE DELLE COMPONENTI DI LIVELLO L3 (PER ORA SOLO APPARATO)&#xD;
//Le componenti mi arrivano con IDDettaglioOrdine sempre incrementato partendo da 1 e con Parent/Root a seconda se la componente è L2 o L3&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
    ||localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)  //SM_11949&#xD;
   &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM &#xD;
   &amp;&amp; ARR_dettaglioOrdineOF_L3 != null &amp;&amp; ARR_dettaglioOrdineOF_L3.size()>0)&#xD;
{	&#xD;
    //STEP1&#xD;
	//Sistemo le componenti OFSERVIZIOGGIUNTIVO e OFAPPARATO nell'array prima di aggiungerle nella richiesta&#xD;
	for(var i=0; i&lt; ARR_dettaglioOrdineOF_L3.size(); i++)&#xD;
	{	&#xD;
		//Componenti&#xD;
		if(ARR_dettaglioOrdineOF_L3.get(i).nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OFSERVIZIOAGGIUNTIVO)&#xD;
		{&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdine = ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdine + localRequest.ordine.dettaglioordine.size();&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdineParent = 1;&#xD;
		}&#xD;
		else if(ARR_dettaglioOrdineOF_L3.get(i).nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OFAPPARATO)&#xD;
		{&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdine = ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdine + localRequest.ordine.dettaglioordine.size();&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdineParent = ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdineParent + localRequest.ordine.dettaglioordine.size();&#xD;
		}		&#xD;
		ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdineRoot = 1;	&#xD;
		ARR_dettaglioOrdineOF_L3.get(i).integrationID = localRequest.IDRichiestaOLO + (localRequest.ordine.dettaglioordine.size() + i + 1);		&#xD;
		ARR_dettaglioOrdineOF_L3.get(i).created = date;&#xD;
		ARR_dettaglioOrdineOF_L3.get(i).lastUpdate = date;		&#xD;
		Process.auditLog(&quot;Manipolata la componente: &quot;+ARR_dettaglioOrdineOF_L3.get(i).nomeComponente+ &quot; con IDDettaglioOrdine: &quot; +String(ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdine) +&quot; e con IDDettaglioOrdineParent: &quot; +String(ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdineParent));&#xD;
		&#xD;
		//Attributi&#xD;
		for(var k=0; k&lt;ARR_dettaglioOrdineOF_L3.get(i).attributiDettaglioOrdine.size(); k++)&#xD;
	    {&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).attributiDettaglioOrdine.get(k).IDDettaglioOrdine = ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdine;&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).attributiDettaglioOrdine.get(k).created = date;&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).attributiDettaglioOrdine.get(k).lastUpdate = date;&#xD;
		}&#xD;
	}		&#xD;
	//Aggiungo&#xD;
	localRequest.ordine.dettaglioordine.addAll(ARR_dettaglioOrdineOF_L3);&#xD;
	Process.auditLog(&quot;Aggiunte numero componenti all'ordine: &quot; +String(ARR_dettaglioOrdineOF_L3.size()));&#xD;
&#xD;
	&#xD;
	//STEP2&#xD;
	//Arricchisco SERVIZIOAGGIUNTIVO e APPARATO dell'ordine a partire dalle componenti OFSERVIZIOAGGIUNTIVO e OFAPPARATO&#xD;
	for(var i=0; i&lt; ARR_dettaglioOrdineOF_L3.size(); i++)&#xD;
	{&#xD;
		var currentARRdettOrdineOF = ARR_dettaglioOrdineOF_L3.get(i);&#xD;
		&#xD;
		for(var k=0; k&lt;currentARRdettOrdineOF.attributiDettaglioOrdine.size(); k++)&#xD;
		{&#xD;
			var attributo = currentARRdettOrdineOF.attributiDettaglioOrdine.get(k);&#xD;
		&#xD;
			if(currentARRdettOrdineOF.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OFSERVIZIOAGGIUNTIVO&#xD;
			   &amp;&amp; attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMESERVIZIO&#xD;
			   &amp;&amp; StateMachineValidationResponseOF != null &#xD;
			   &amp;&amp; (StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null&#xD;
			       ||StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null))   //RIENTRI DEL82&#xD;
			{&#xD;
				var NOMESERVIZIOOF = &quot;&quot;;&#xD;
				NOMESERVIZIOOF = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo NOMESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente OFSERVIZIOAGGIUNTIVO con IDDett &quot;+currentARRdettOrdineOF.IDDettaglioOrdine);	&#xD;
				&#xD;
				for(var m=0; m&lt;localRequest.ordine.dettaglioordine.size(); m++)&#xD;
				{&#xD;
					var componenteRic = localRequest.ordine.dettaglioordine.get(m);&#xD;
					&#xD;
					if(componenteRic.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOAGGIUNTIVO)&#xD;
					{&#xD;
						var NOMESERVIZIO = &quot;&quot;; NOMESERVIZIO = null;&#xD;
						&#xD;
						for(var q=0; q&lt;componenteRic.attributiDettaglioOrdine.size(); q++){&#xD;
							var attributoRic = componenteRic.attributiDettaglioOrdine.get(q);&#xD;
							&#xD;
							if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMESERVIZIO)&#xD;
							{&#xD;
								NOMESERVIZIO = attributoRic.valoreAttributo;&#xD;
								Process.auditLog(&quot;Trovato attributo NOMESERVIZIO&quot;+ attributoRic.valoreAttributo +&quot; su componente SERVIZIOAGGIUNTIVO con IDDett &quot;+componenteRic.IDDettaglioOrdine);			&#xD;
							}&#xD;
						}&#xD;
&#xD;
						//Legame OFSERVIZIOGGIUNTIVO - SERVIZIOAGGIUNTIVO&#xD;
						if(NOMESERVIZIO == NOMESERVIZIOOF)&#xD;
						{&#xD;
							var ESITOSERVIZIO = &quot;&quot;; ESITOSERVIZIO = null;&#xD;
							var foundESITO = false;&#xD;
							&#xD;
							//Recupero i valori&#xD;
							for(var z=0; z&lt;currentARRdettOrdineOF.attributiDettaglioOrdine.size(); z++)&#xD;
							{&#xD;
								var attributoARRdettOrdine = currentARRdettOrdineOF.attributiDettaglioOrdine.get(z);&#xD;
							&#xD;
								if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITOSERVIZIO){&#xD;
									ESITOSERVIZIO = attributoARRdettOrdine.valoreAttributo;&#xD;
								}&#xD;
							}&#xD;
								&#xD;
							//Arricchisco la componente&#xD;
							for(var x=0; x&lt;componenteRic.attributiDettaglioOrdine.size(); x++)&#xD;
							{&#xD;
								var attributoRic = componenteRic.attributiDettaglioOrdine.get(x);&#xD;
								&#xD;
								if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITO){&#xD;
									foundESITO = true;&#xD;
									&#xD;
									//Caso di Espletamento negativo&#xD;
									if((StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null &amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.STATO_ORDINE == &quot;1&quot;)&#xD;
									   ||(StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null &amp;&amp; StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request.STATO_ORDINE == &quot;1&quot;)){   //MIG RIENTRI DEL82&#xD;
										attributoRic.valoreAttributo = &quot;KO&quot;;&#xD;
									}&#xD;
									//Espletamento positivo - Valorizzata sempre con OK tranne nel caso di TLC3 con ESITOSERVIZIO = 1&#xD;
									if(NOMESERVIZIOOF == &quot;TLC3&quot; &amp;&amp; ESITOSERVIZIO == &quot;1&quot;){&#xD;
										attributoRic.valoreAttributo = &quot;KO&quot;;  	&#xD;
									}&#xD;
									else{&#xD;
										attributoRic.valoreAttributo = &quot;OK&quot;;  	&#xD;
									}&#xD;
									Process.auditLog(&quot;Aggiornato attributo ESITO&quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
							}&#xD;
							&#xD;
							var attributoDaAggiungere = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
							var data = DateTimeUtil.createDatetime();&#xD;
							attributoDaAggiungere.IDDettaglioOrdine = componenteRic.IDDettaglioOrdine;&#xD;
							attributoDaAggiungere.IDRichiestaOLO = componenteRic.IDRichiestaOLO;&#xD;
							attributoDaAggiungere.created = data;&#xD;
							attributoDaAggiungere.lastUpdate = data;&#xD;
							attributoDaAggiungere.operatore = componenteRic.operatore;&#xD;
							attributoDaAggiungere.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							&#xD;
							if(!foundESITO)&#xD;
							{&#xD;
								attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITO;&#xD;
								&#xD;
								//Caso di Espletamento negativo&#xD;
								if((StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null &amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.STATO_ORDINE == &quot;1&quot;)&#xD;
								   ||(StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null &amp;&amp; StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request.STATO_ORDINE == &quot;1&quot;)){    //MIG RIENTRI DEL82&#xD;
									attributoRic.valoreAttributo = &quot;KO&quot;;&#xD;
								}&#xD;
								//Espletamento positivo - Valorizzata sempre con OK tranne nel caso di TLC3 con ESITOSERVIZIO = 1&#xD;
								else if(NOMESERVIZIOOF == &quot;TLC3&quot; &amp;&amp; ESITOSERVIZIO == &quot;1&quot;){&#xD;
									attributoDaAggiungere.valoreAttributo = &quot;KO&quot;;  	&#xD;
								}&#xD;
								else{&#xD;
									attributoDaAggiungere.valoreAttributo = &quot;OK&quot;;  	&#xD;
								}&#xD;
								componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
								Process.auditLog(&quot;Creato attributo ESITO&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
							}&#xD;
									&#xD;
							//Arricchimento OFAPPARATO -> APPARATO&#xD;
							//OFAPPARATO ha i seguenti attributi: TIPOLOGIAAPPARATO, ESITOCONSEGNAAPPARATO, IDAPPARATOCONSEGNATO, CODICEMOTIVAZIONECONSEGNA, MOTIVAZIONECONSEGNA&#xD;
							for(var i1=0; i1&lt; ARR_dettaglioOrdineOF_L3.size(); i1++)&#xD;
							{&#xD;
								var currentDettARR = ARR_dettaglioOrdineOF_L3.get(i1);&#xD;
								&#xD;
								//Per ogni OFAPPARATO legata alla OFSERVIZIOAGGIUNTIVO corrente&#xD;
								if(currentDettARR.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OFAPPARATO&#xD;
								   &amp;&amp; currentDettARR.IDDettaglioOrdineParent == currentARRdettOrdineOF.IDDettaglioOrdine) &#xD;
								{&#xD;
									var TIPOLOGIAAPPARATO = &quot;&quot;; TIPOLOGIAAPPARATO = null;&#xD;
									var ESITOCONSEGNAAPPARATO = &quot;&quot;; ESITOCONSEGNAAPPARATO = null;&#xD;
									var IDAPPARATOCONSEGNATO = &quot;&quot;; IDAPPARATOCONSEGNATO = null;&#xD;
									var CODICEMOTIVAZIONECONSEGNA = &quot;&quot;; CODICEMOTIVAZIONECONSEGNA = null;&#xD;
									var MOTIVAZIONECONSEGNA = &quot;&quot;; MOTIVAZIONECONSEGNA = null;&#xD;
									var CODICEAPPARATO = &quot;&quot;; CODICEAPPARATO = null;&#xD;
&#xD;
									var foundTIPOLOGIAAPPARATO = false;&#xD;
									var foundQTAAPPARATO = false;&#xD;
									var foundESITOCONSEGNAAPPARATO= false;&#xD;
									var foundIDAPPARATOCONSEGNATO = false;&#xD;
									var foundCODICEMOTIVAZIONECONSEGNA = false;&#xD;
									var foundMOTIVAZIONECONSEGNA = false;&#xD;
									&#xD;
									//Recupero i valori&#xD;
									for(var z1=0; z1&lt;currentDettARR.attributiDettaglioOrdine.size(); z1++)&#xD;
									{&#xD;
										var currentAttARR = currentDettARR.attributiDettaglioOrdine.get(z1);&#xD;
									&#xD;
										if(currentAttARR.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIAAPPARATO){&#xD;
											TIPOLOGIAAPPARATO = currentAttARR.valoreAttributo;&#xD;
										}	&#xD;
										else if(currentAttARR.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITOCONSEGNAAPPARATO){&#xD;
											ESITOCONSEGNAAPPARATO = currentAttARR.valoreAttributo;&#xD;
										}&#xD;
										else if(currentAttARR.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDAPPARATOCONSEGNATO){&#xD;
											IDAPPARATOCONSEGNATO = currentAttARR.valoreAttributo;&#xD;
										}&#xD;
										else if(currentAttARR.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMOTIVAZIONECONSEGNA){&#xD;
											CODICEMOTIVAZIONECONSEGNA = currentAttARR.valoreAttributo;&#xD;
										}&#xD;
										else if(currentAttARR.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MOTIVAZIONECONSEGNA){&#xD;
