												&#xD;
												//Arricchisco APPARATO dell'ordine&#xD;
												for(var k2=0; k2&lt;currentDettRICH.attributiDettaglioOrdine.size(); k2++)&#xD;
												{&#xD;
													var attributoRic1 = currentDettRICH.attributiDettaglioOrdine.get(k2);&#xD;
													&#xD;
													//ESITO&#xD;
													if(attributoRic1.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITO&#xD;
													   &amp;&amp; ESITOCONSEGNAAPPARATO != null)&#xD;
													{&#xD;
														foundESITOApparato = true;&#xD;
														&#xD;
														//Espletamento negativo&#xD;
														if((StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null &amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.STATO_ORDINE == &quot;1&quot;)&#xD;
														   ||(StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null &amp;&amp; StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request.STATO_ORDINE == &quot;1&quot;))   //MIG RIENTRI DEL82&#xD;
														{&#xD;
															attributoRic1.valoreAttributo = &quot;KO&quot;;&#xD;
														}&#xD;
														else if(((ESITOCONSEGNAAPPARATO == &quot;0&quot; || ESITOCONSEGNAAPPARATO == &quot;5&quot;) &amp;&amp; NOMESERVIZIOOF == &quot;TLC1&quot;)&#xD;
															||((ESITOCONSEGNAAPPARATO == &quot;0&quot; || ESITOCONSEGNAAPPARATO == &quot;5&quot;) &amp;&amp; NOMESERVIZIOOF == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO == null)&#xD;
														    ||(ESITOCONSEGNAAPPARATO == &quot;1&quot; &amp;&amp; NOMESERVIZIOOF == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO != null))&#xD;
														{&#xD;
															attributoRic1.valoreAttributo = &quot;KO&quot;;&#xD;
														}&#xD;
														else{&#xD;
															attributoRic1.valoreAttributo = &quot;OK&quot;;&#xD;
														}&#xD;
														Process.auditLog(&quot;Aggiornato attributo ESITO&quot;+ attributoRic1.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
													}&#xD;
													//SM_11967 - solo per RIENTRI MIG DEL82&#xD;
													else if(attributoRic1.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITOCONSEGNAAPPARATO&#xD;
													        &amp;&amp; ESITOCONSEGNAAPPARATO != null&#xD;
															&amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
