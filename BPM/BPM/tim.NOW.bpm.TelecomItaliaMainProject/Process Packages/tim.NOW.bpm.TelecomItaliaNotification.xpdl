          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_jVYsLAOpEeaIdPdRimpTnw" Width="128.0">
              <xpdl2:Coordinates XCoordinate="3108.0" YCoordinate="1471.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">//Bug #32964 - serve per capire se è stata già inviata un'attivazione FF/FC&#xD;
if(ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null&#xD;
&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NICONFIGURAZIONELOGICA)&#xD;
{&#xD;
    inviataAttFF_FC = true;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeExternalService/Process Packages/tim.NOW.bpm.invokeExternalService.FF.xpdl.TINOWInviaaFFFC&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_TfIZwMqSEeuYsfI1nXEwrA" Name="CheckNumerazioniFittizie" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Check Numerazioni Fittizie" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">callNumFittizie = false;&#xD;
IDRISORSADaInserire = null;&#xD;
&#xD;
if(localRequest.IDRisorsa != null &amp;&amp; localRequest.IDRisorsa != '' &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA != null)&#xD;
{	&#xD;
	//LOGICA SU QUALE IDRISORSA ANDARE A CONSIDERARE&#xD;
	//SM_10069: PER I SERVIZI METROWEB O OPENFIBER controlliamo IDRISORSANOW e non IDRISORSA&#xD;
	if(localRequest.ordine != null &amp;&amp; localRequest.ordine.IDRisorsaNOW != null &amp;&amp; localRequest.ordine.IDRisorsaNOW != ''&#xD;
	   &amp;&amp;(localRequest.IDRisorsa.slice(0,1) == &quot;M&quot; || localRequest.IDRisorsa.slice(0,1) == &quot;O&quot; &#xD;
	       ||localRequest.ordine.IDRisorsaNOW != localRequest.IDRisorsa))&#xD;
	{&#xD;
		IDRISORSADaInserire = localRequest.ordine.IDRisorsaNOW;&#xD;
		var idRisorsaLen = String(localRequest.ordine.IDRisorsaNOW).length;&#xD;
	}&#xD;
	else //solito (PRE-SM_10069)&#xD;
	{&#xD;
		IDRISORSADaInserire = localRequest.IDRisorsa;&#xD;
		var idRisorsaLen = String(localRequest.IDRisorsa).length;&#xD;
	}		&#xD;
	&#xD;
	//LOGICA PER CHIAMARE INSERIMENTO NUMERAZIONI FITTIZIE&#xD;
	//SM_10069: sostituito localRequest.IDRisorsa con IDRISORSADaInserire&#xD;
	if (IDRISORSADaInserire != null&#xD;
		&amp;&amp;&#xD;
		(archi.contains(IDRISORSADaInserire.slice(3,6))) //CR 467: sostituito IDRISORSA == 147 con archi.contains(IDRISORSA)&#xD;
		&amp;&amp;&#xD;
		(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
		||&#xD;
		localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)&#xD;
		&amp;&amp;&#xD;
		(!(String(localRequest.offerta).length>16 &amp;&amp; String(localRequest.offerta).slice(12,16) == &quot;SIMM&quot;)) //CR 467: escludere i SIMMETRICI&#xD;
		&amp;&amp;&#xD;
		((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp; &#xD;
		(ManageNotificationDTU.STATO_SUCCESSIVO == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO ||&#xD;
		ManageNotificationDTU.STATO_SUCCESSIVO == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO))&#xD;
		||&#xD;
		(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &amp;&amp;  //SM_8161&#xD;
		(ManageNotificationDTU.STATO_SUCCESSIVO == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO ||&#xD;
		ManageNotificationDTU.STATO_SUCCESSIVO == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO) &amp;&amp;&#xD;
		IDRISORSADaInserire.slice(idRisorsaLen - 3,idRisorsaLen) == 'W00') &#xD;
		||&#xD;
		(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp; &#xD;
		ManageNotificationDTU.STATO_SUCCESSIVO == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICO &amp;&amp;&#xD;
		IDRISORSADaInserire.slice(0,1) !=&quot;U&quot;)             // SM_11895&#xD;
		||&#xD;
		(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFCONFERMAANNULLAMENTO &amp;&amp; &#xD;
		ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == &quot;025&quot; &amp;&amp; IDRISORSADaInserire.slice(idRisorsaLen - 3,idRisorsaLen) == 'W00'&#xD;
		&amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA))) //SM_9711 se CAMBIOTECNOLOGIA salto inserimento&#xD;
	{&#xD;
		callNumFittizie = true;&#xD;
		Process.auditLog(&quot;IDRISORSA da inserire&quot;+ IDRISORSADaInserire +&quot;per lavorazione: &quot;+String(localRequest.lavorazione)+ &quot;e offerta:&quot; + String(localRequest.offerta));&#xD;
	}&#xD;
	&#xD;
	//SM_10069: MIGRAZIONE DI UN REGOLATORIO CON DONATING DATI&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
		    &amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO&#xD;
		    &amp;&amp; ManageNotificationDTU.STATO_SUCCESSIVO == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICO)&#xD;
	{&#xD;
		var IDRISORSA = &quot;&quot;;&#xD;
		IDRISORSA = null;&#xD;
		var IDRISORSANOW = &quot;&quot;;&#xD;
		IDRISORSANOW = null;&#xD;
		&#xD;
		IDRISORSADaInserire = null;&#xD;
		&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI&#xD;
			   &amp;&amp; componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
					{&#xD;
						IDRISORSA = attributo.valoreAttributo;				&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSANOW)&#xD;
					{&#xD;
						IDRISORSANOW = attributo.valoreAttributo;				&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				if(IDRISORSA != null &amp;&amp; IDRISORSANOW != null &amp;&amp; (IDRISORSA.slice(0,1) == &quot;M&quot; || IDRISORSA.slice(0,1) == &quot;O&quot; || IDRISORSA != IDRISORSANOW))&#xD;
				{&#xD;
					IDRISORSADaInserire = IDRISORSANOW;&#xD;
				}&#xD;
				else &#xD;
				{&#xD;
					IDRISORSADaInserire = IDRISORSA;&#xD;
				}	&#xD;
			}	&#xD;
		}&#xD;
		&#xD;
		if(IDRISORSADaInserire != null &amp;&amp; (archi.contains(IDRISORSADaInserire.slice(3,6))) &#xD;
		   &amp;&amp; IDRISORSADaInserire.slice(IDRISORSADaInserire.length - 3, IDRISORSADaInserire.length - 2) == 'W')&#xD;
		{&#xD;
			callNumFittizie = true;&#xD;
			Process.auditLog(&quot;IDRISORSA da inserire&quot;+ IDRISORSADaInserire +&quot;per lavorazione: &quot;+String(localRequest.lavorazione)+ &quot;e offerta: &quot; + String(localRequest.offerta));&#xD;
		}&#xD;
	}	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_jVYsLAOpEeaIdPdRimpTnw" Width="96.0">
              <xpdl2:Coordinates XCoordinate="3622.0" YCoordinate="835.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_ovJawsqSEeuYsfI1nXEwrA">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_pMKt8MqSEeuYsfI1nXEwrA"/>
                  <xpdl2:TransitionRef Id="_yf3G4MqSEeuYsfI1nXEwrA"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="45.0" LaneId="_jVYsLAOpEeaIdPdRimpTnw" Width="43.0">
              <xpdl2:Coordinates XCoordinate="3719.0" YCoordinate="968.0"/>
