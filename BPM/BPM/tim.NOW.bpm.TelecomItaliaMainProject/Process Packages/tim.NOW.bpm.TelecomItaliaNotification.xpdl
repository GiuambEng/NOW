          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">//Aggiunto Log per ricezione evento da OF&#xD;
&#xD;
if(StateMachineValidationResponseOF != null)&#xD;
{&#xD;
	if(StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request != null)&#xD;
	{&#xD;
		Process.auditLog(&quot;Ricevuto da OF evento di OF_StatusUpdate_OpenStream_Request con STATO_ORDINE: &quot; +StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.STATO_ORDINE);&#xD;
	}&#xD;
	else if(StateMachineValidationResponseOF.OF_Reschedule_OpenStream_Request != null)&#xD;
	{&#xD;
		Process.auditLog(&quot;Ricevuto da OF evento di OF_Reschedule_OpenStream_Request&quot;);&#xD;
	}&#xD;
	else if(StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null)&#xD;
	{&#xD;
		Process.auditLog(&quot;Ricevuto da OF evento di OF_CompletionOrder_OpenStream_Request&quot;);&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
