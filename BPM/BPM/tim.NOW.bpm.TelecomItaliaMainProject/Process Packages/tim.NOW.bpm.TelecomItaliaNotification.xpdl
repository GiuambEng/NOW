								attributoDaAggiungere.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
								&#xD;
								if(ESITO != null &amp;&amp; !foundESITO)&#xD;
								{&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITO;&#xD;
									attributoDaAggiungere.valoreAttributo = ESITO;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo ESITO&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
								if(CAUSALEESITO != null &amp;&amp; !foundCAUSALEESITO)&#xD;
								{&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAUSALEESITO;&#xD;
									attributoDaAggiungere.valoreAttributo = CAUSALEESITO;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo CAUSALEESITO&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
								if(DESCRIZIONEESITO != null &amp;&amp; !foundDESCRIZIONEESITO)&#xD;
								{&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONEESITO;&#xD;
									attributoDaAggiungere.valoreAttributo = DESCRIZIONEESITO;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo DESCRIZIONEESITO&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
										&#xD;
								//COMMENTATO CON LA SM_11294	&#xD;
								//Arricchimento DTUAPPARATO -> APPARATO&#xD;
								/*for(var i1=0; i1&lt; ARR_dettaglioOrdineOF_L3.size(); i1++)&#xD;
								{&#xD;
									var currentDettARR = ARR_dettaglioOrdineOF_L3.get(i1);&#xD;
									&#xD;
									//Per ogni DTUAPPARATO legata alla DTUSERVIZIOAGGIUNTIVO corrente&#xD;
									if(currentDettARR.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAPPARATO&#xD;
									   &amp;&amp; currentDettARR.IDDettaglioOrdineParent == currentARRdettOrdineOF.IDDettaglioOrdine) &#xD;
									{&#xD;
										var ESITOApparato = &quot;&quot;;&#xD;
										ESITOApparato = null;&#xD;
										var CAUSALEESITOApparato = &quot;&quot;;&#xD;
										CAUSALEESITOApparato = null;&#xD;
										var DESCRIZIONEESITOApparato = &quot;&quot;;&#xD;
										DESCRIZIONEESITOApparato = null;&#xD;
										var CODICEAPPARATO_DTU = &quot;&quot;;&#xD;
										CODICEAPPARATO_DTU = null;&#xD;
										var foundESITOApparato = false;&#xD;
										var foundCAUSALEESITOApparato = false;&#xD;
										var foundDESCRIZIONEESITOApparato = false;&#xD;
										&#xD;
										//Recupero i valori&#xD;
										for(var z1=0; z1&lt;currentDettARR.attributiDettaglioOrdine.size(); z1++)&#xD;
										{&#xD;
											var currentAttARR = currentDettARR.attributiDettaglioOrdine.get(z1);&#xD;
										&#xD;
											if(currentAttARR.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITO){&#xD;
												ESITOApparato = currentAttARR.valoreAttributo;&#xD;
											}&#xD;
											else if(currentAttARR.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAUSALEESITO){&#xD;
												CAUSALEESITOApparato = currentAttARR.valoreAttributo;&#xD;
											}&#xD;
											else if(currentAttARR.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONEESITO){&#xD;
												DESCRIZIONEESITOApparato = currentAttARR.valoreAttributo;&#xD;
											}&#xD;
											else if(currentAttARR.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEAPPARATO){&#xD;
												CODICEAPPARATO_DTU = currentAttARR.valoreAttributo;&#xD;
											}										&#xD;
										}&#xD;
										&#xD;
										//Devo individuare la componente APPARATO corrispondente nell'ordine (ma sempre gli APPARATO legati al SERVIZIOAGGIUNTIVO corrente)&#xD;
										for(var m1=0; m1&lt;localRequest.ordine.dettaglioordine.size(); m1++)&#xD;
										{&#xD;
											var currentDettRICH = localRequest.ordine.dettaglioordine.get(m1);&#xD;
											&#xD;
											if(currentDettRICH.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPARATO&#xD;
											   &amp;&amp; currentDettRICH.IDDettaglioOrdineParent == componenteRic.IDDettaglioOrdine) //Legame APPARATO - SERVIZIOAGGIUNTIVO&#xD;
											{				&#xD;
												var CODICEAPPARATO_RICH = &quot;&quot;;&#xD;
												CODICEAPPARATO_RICH = null;&#xD;
												&#xD;
												for(var q1=0; q1&lt;currentDettRICH.attributiDettaglioOrdine.size(); q1++)&#xD;
												{&#xD;
													var attribApp = currentDettRICH.attributiDettaglioOrdine.get(q1);&#xD;
													&#xD;
													if(attribApp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEAPPARATO)&#xD;
													{&#xD;
														CODICEAPPARATO_RICH = attribApp.valoreAttributo;&#xD;
														Process.auditLog(&quot;Trovato attributo CODICEAPPARATO&quot;+ attribApp.valoreAttributo +&quot; su componente APPARATO con IDDett &quot;+currentDettRICH.IDDettaglioOrdine);			&#xD;
													}&#xD;
												}&#xD;
												&#xD;
												//Legame tra APPARATO - DTUAPPARATO&#xD;
												if(CODICEAPPARATO_DTU == CODICEAPPARATO_RICH)&#xD;
												{&#xD;
													//Arricchisco APPARATO dell'ordine&#xD;
													for(var k2=0; k2&lt;currentDettRICH.attributiDettaglioOrdine.size(); k2++)&#xD;
													{&#xD;
														var attributoRic1 = currentDettRICH.attributiDettaglioOrdine.get(k2);&#xD;
														&#xD;
