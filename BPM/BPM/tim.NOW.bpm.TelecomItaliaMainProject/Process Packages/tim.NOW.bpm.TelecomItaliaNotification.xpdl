				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEARLTI2 &amp;&amp; POSIZIONEARLTI2dtu != null){&#xD;
					trovatoPOSIZIONEARLTI2 = true;&#xD;
					POSIZIONEARLTI2old = currentAttDettOrdine.valoreAttributo;&#xD;
					currentAttDettOrdine.valoreAttributo = POSIZIONEARLTI2dtu;&#xD;
					Process.auditLog(&quot;Aggiornato POSIZIONEARLTI2 da &quot;+POSIZIONEARLTI2old+&quot; con valore: &quot;+POSIZIONEARLTI2dtu);&#xD;
				}				&#xD;
				z++;&#xD;
			}			&#xD;
			if(IDSLUCOold == null &amp;&amp; IDSLUCOdtu != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDSLUCO;&#xD;
				attributoACC.valoreAttributo = IDSLUCOdtu;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto IDSLUCO in &quot;+currentDettOrdine.nomeComponente+&quot; con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}&#xD;
			else if(IDSLUCOold != null &amp;&amp; IDSLUCOdtu != null &amp;&amp; IDSLUCOold != IDSLUCOdtu){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDSLUCOOLD;&#xD;
				attributoACC.valoreAttributo = IDSLUCOold;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto IDSLUCOOLD in &quot;+currentDettOrdine.nomeComponente+&quot; con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}			&#xD;
			if((POSIZIONEARLTI1old == null &amp;&amp; POSIZIONEARLTI1dtu != null)){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEARLTI1;&#xD;
				attributoACC.valoreAttributo = POSIZIONEARLTI1dtu;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto POSIZIONEARLTI1 in &quot;+currentDettOrdine.nomeComponente+&quot; con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}&#xD;
			else if(POSIZIONEARLTI1old != null &amp;&amp; POSIZIONEARLTI1dtu != null &amp;&amp; POSIZIONEARLTI1old != POSIZIONEARLTI1dtu){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEARLTI1OLD;&#xD;
				attributoACC.valoreAttributo = POSIZIONEARLTI1old;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto POSIZIONEARLTI1old in &quot;+currentDettOrdine.nomeComponente+&quot; con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}&#xD;
			if((POSIZIONEARLTI2old == null &amp;&amp; POSIZIONEARLTI2dtu != null)){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEARLTI2;&#xD;
				attributoACC.valoreAttributo = POSIZIONEARLTI2dtu;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto POSIZIONEARLTI2 in &quot;+currentDettOrdine.nomeComponente+&quot; con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}&#xD;
			else if(POSIZIONEARLTI2old != null &amp;&amp; POSIZIONEARLTI2dtu != null &amp;&amp; POSIZIONEARLTI2old != POSIZIONEARLTI2dtu){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
