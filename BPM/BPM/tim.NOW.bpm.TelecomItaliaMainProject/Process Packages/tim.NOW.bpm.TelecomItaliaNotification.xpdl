				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALIBIDIREZIONALI &amp;&amp; CANALIBIDIREZIONALI != null){&#xD;
					trovatoCANALIBIDIREZIONALI = true;&#xD;
					currentAttDettOrdine.valoreAttributo = CANALIBIDIREZIONALI;&#xD;
					Process.auditLog(&quot;Aggiornato CANALIBIDIREZIONALI con valore: &quot;+CANALIBIDIREZIONALI);&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALIENTRANTI &amp;&amp; CANALIENTRANTI != null){&#xD;
					trovatoCANALIENTRANTI = true;&#xD;
					currentAttDettOrdine.valoreAttributo = CANALIENTRANTI;&#xD;
					Process.auditLog(&quot;Aggiornato CANALIENTRANTI con valore: &quot;+CANALIENTRANTI);&#xD;
				}				&#xD;
				z++;&#xD;
			}			&#xD;
			if(!trovatoCANALITOTALI &amp;&amp; CANALITOTALI != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALITOTALI;&#xD;
				attributoACC.valoreAttributo = CANALITOTALI;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto CANALITOTALI in &quot;+currentDettOrdine.nomeComponente+&quot; con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}&#xD;
			if(!trovatoCANALIBIDIREZIONALI &amp;&amp; CANALIBIDIREZIONALI != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALIBIDIREZIONALI;&#xD;
				attributoACC.valoreAttributo = CANALIBIDIREZIONALI;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto CANALIBIDIREZIONALI in &quot;+currentDettOrdine.nomeComponente+&quot; con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}			&#xD;
			if(!trovatoCANALIENTRANTI &amp;&amp; CANALIENTRANTI != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALIENTRANTI;&#xD;
				attributoACC.valoreAttributo = CANALIENTRANTI;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto CANALIENTRANTI in &quot;+currentDettOrdine.nomeComponente+&quot; con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}			&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
if(RADICALE != null || CAPOSTIPITE != null){&#xD;
	var trovatoCAPOSTIPITE = false; var trovatoRADICALE = false;&#xD;
	for(var i2 = 0; i2 &lt; localRequest.ordine.dettaglioordine.size(); i2++){&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i2);		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAGGIUNTIVO &#xD;
		&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA || &#xD;
			localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA)){&#xD;
			var y = 0;&#xD;
			while(y &lt; currentDettOrdine.attributiDettaglioOrdine.size()){&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(y);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSTIPITE &amp;&amp; CAPOSTIPITE != null){&#xD;
					trovatoCAPOSTIPITE = true;&#xD;
					currentAttDettOrdine.valoreAttributo = CAPOSTIPITE;&#xD;
					Process.auditLog(&quot;Aggiornato CAPOSTIPITE in DTUAGGIUNTIVO con valore: &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE &amp;&amp; RADICALE != null){&#xD;
					trovatoRADICALE = true;&#xD;
					currentAttDettOrdine.valoreAttributo = RADICALE;&#xD;
					Process.auditLog(&quot;Aggiornato RADICALE in DTUAGGIUNTIVO con valore: &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
				}&#xD;
				y++;&#xD;
			}			&#xD;
			if(!trovatoCAPOSTIPITE &amp;&amp; CAPOSTIPITE != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSTIPITE;&#xD;
				attributoACC.valoreAttributo = CAPOSTIPITE;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto CAPOSTIPITE in DTUAGGIUNTIVO con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}			&#xD;
			if(!trovatoRADICALE &amp;&amp; RADICALE != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE;&#xD;
				attributoACC.valoreAttributo = RADICALE;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto RADICALE in DTUAGGIUNTIVO con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}&#xD;
		}&#xD;
		else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUPRENOTAZIONEAGGIUNTIVO){&#xD;
			var y = 0;&#xD;
			while(y &lt; currentDettOrdine.attributiDettaglioOrdine.size()){&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(y);				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSTIPITE &amp;&amp; CAPOSTIPITE != null){&#xD;
					trovatoCAPOSTIPITE = true;&#xD;
					currentAttDettOrdine.valoreAttributo = CAPOSTIPITE;&#xD;
					Process.auditLog(&quot;Aggiornato CAPOSTIPITE in DTUPRENOTAZIONEAGGIUNTIVO con valore: &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE &amp;&amp; RADICALE != null){&#xD;
					trovatoRADICALE = true;&#xD;
					currentAttDettOrdine.valoreAttributo = RADICALE;&#xD;
					Process.auditLog(&quot;Aggiornato RADICALE in DTUPRENOTAZIONEAGGIUNTIVO con valore: &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
				}&#xD;
				y++;&#xD;
			}			&#xD;
			if(!trovatoCAPOSTIPITE &amp;&amp; CAPOSTIPITE != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSTIPITE;&#xD;
				attributoACC.valoreAttributo = CAPOSTIPITE;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto CAPOSTIPITE in DTUPRENOTAZIONEAGGIUNTIVO con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}			&#xD;
			if(!trovatoRADICALE &amp;&amp; RADICALE != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE;&#xD;
				attributoACC.valoreAttributo = RADICALE;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto RADICALE in DTUPRENOTAZIONEAGGIUNTIVO con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}	&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
