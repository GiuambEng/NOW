        <xpdl2:Transition Id="_ZdV30f8_Eeabvb71ykxCCQ" xpdExt:DisplayName="" Name="" From="_k6OGoObcEeaZ6ce7dBsScg" To="_ZdV30P8_Eeabvb71ykxCCQ">
          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var result = false;&#xD;
if(ManageNotificationDTU != null&#xD;
	&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA != null&#xD;
	&amp;&amp; ((ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NISOSPENSIONE&#xD;
			|| ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIFINETENTATIVOCONTATTO)&#xD;
	|| (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO&#xD;
			&amp;&amp; localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESACONFERMAANNULLAMENTO)))&#xD;
{&#xD;
//localRequest.statoRichiestaNOW==it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESO || localRequest.statoRichiestaNOW==it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOAPPUNTAMENTO){&#xD;
	result = true;&#xD;
	if(localRequest.codiceCausaleInterno != null)&#xD;
	{&#xD;
		Process.auditLog(&quot;codiceCausaleInterno: &quot; + localRequest.codiceCausaleInterno );&#xD;
		&#xD;
		//RU_1059: Cessazione dei simmetrici con NISOSPENSIONE, va fatta desospensione automatica da DTU&#xD;
		if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
               ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL&#xD;
               ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT&#xD;
			   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICO)&#xD;
		   &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
		   &amp;&amp; (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NISOSPENSIONE&#xD;
		   ||  ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIFINETENTATIVOCONTATTO)) //NIFINE aggiunto con SM_9897&#xD;
		{&#xD;
			result = false;&#xD;
			&#xD;
			if(localRequest.codiceCausaleInterno.slice(0,3) == &quot;N36&quot;&#xD;
			   ||localRequest.codiceCausaleInterno.slice(0,3) == &quot;N37&quot;&#xD;
			   ||localRequest.codiceCausaleInterno.slice(0,3) == &quot;N43&quot;&#xD;
			   ||localRequest.codiceCausaleInterno.slice(0,3) == &quot;N44&quot;&#xD;
			   ||localRequest.codiceCausaleInterno.slice(0,3) == &quot;W51&quot;)&#xD;
			{&#xD;
				result = true;&#xD;
				AvvioDesospensioneAutomatica = true;&#xD;
			}&#xD;
		}&#xD;
		//----------------------------------------------------------------------------------------------&#xD;
		&#xD;
		else if(localRequest.codiceCausaleInterno == &quot;TENT_CONT&quot; || localRequest.codiceCausaleInterno.slice(0,3) == &quot;N36&quot;)&#xD;
		{&#xD;
			result = false;&#xD;
			if(localRequest.ordine != null)&#xD;
			{&#xD;
				var i = 0;&#xD;
				while(!result &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
				{&#xD;
					var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
					if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUFINECONTATTO&#xD;
					&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NISOSPENSIONE) //SM_9412&#xD;
					{&#xD;
						result = true;&#xD;
					}&#xD;
					i++;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			result = true;&#xD;
		}&#xD;
	}&#xD;
	else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESACONFERMAANNULLAMENTO)&#xD;
	{&#xD;
		result = true;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		result = false;&#xD;
	}&#xD;
}&#xD;
/*else if(localRequest.statoRichiestaNOW==it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOOPERESPECIALI){&#xD;
	result = true;&#xD;
}*/&#xD;
&#xD;
result;</xpdl2:Expression>
</xpdl2:Condition>
