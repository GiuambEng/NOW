            <xpdl2:Activity Id="_T_80dCXxEea6a4eCDXx0DA" Name="TIMNOWConvertitore_Sede" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="TIMNOW-Convertitore_Sede">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_pI0omCXtEea6a4eCDXx0DA" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="SedeXSD">
                      <xpdl2:Actual ScriptGrammar="JavaScript">currentArricchimento.arricchimento.sedeElement</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="OUT" Formal="SedeBOM">
                      <xpdl2:Actual ScriptGrammar="JavaScript">ARR_sede</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" Width="128.0">
                  <xpdl2:Coordinates XCoordinate="265.0" YCoordinate="331.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">var foundSedeCert = false;&#xD;
var sedeCertificata = false;&#xD;
var foundSedeOld = false;&#xD;
var indexSedeOld = 0;&#xD;
indexSedeOld = null;&#xD;
&#xD;
if(ARR_sede != null &amp;&amp; ARR_sede.codiceToponomastica != null &amp;&amp; ARR_sede.codiceToponomastica != &quot;&quot;)&#xD;
{&#xD;
	sedeCertificata = true;&#xD;
}&#xD;
else if(ARR_sede != null &amp;&amp; &#xD;
		ARR_sede.particellaToponomastica != null &amp;&amp; ARR_sede.particellaToponomastica != &quot;&quot; &amp;&amp;&#xD;
		ARR_sede.via != null &amp;&amp; ARR_sede.via != &quot;&quot; &amp;&amp;&#xD;
		ARR_sede.civico != null &amp;&amp; ARR_sede.civico != &quot;&quot; &amp;&amp;&#xD;
		ARR_sede.localita != null &amp;&amp; ARR_sede.localita != &quot;&quot; &amp;&amp;&#xD;
		ARR_sede.codiceISTATComune != null &amp;&amp; ARR_sede.codiceISTATComune != &quot;&quot;)&#xD;
{&#xD;
	sedeCertificata = true;&#xD;
}&#xD;
&#xD;
if(ARR_sede != null&#xD;
	&amp;&amp; currentArricchimento.operation == com_tim_NOW_xsd_BPM_DTUNotificationManagement_v1_OperationType.CREATE)&#xD;
{&#xD;
	if(localRequest.ordine.sede != null)&#xD;
	{&#xD;
		var i = 0;&#xD;
		while((!foundSedeCert || !foundSedeOld) &amp;&amp; i &lt; localRequest.ordine.sede.size())&#xD;
		{&#xD;
			if(localRequest.ordine.sede.get(i).tipologiaSede == it_telecomitalia_it_NOW_casedata_TipologiaSedeEnumeration.SEDECLIENTECERT)&#xD;
			{&#xD;
				//Trovata una SedeCertificata, imposto il flag per uscire dal ciclo e la rimuovo&#xD;
				foundSedeCert = true;&#xD;
				localRequest.ordine.sede.remove(i);&#xD;
				i--;&#xD;
			}&#xD;
			else if(localRequest.ordine.sede.get(i).tipologiaSede == it_telecomitalia_it_NOW_casedata_TipologiaSedeEnumeration.SEDECLIENTEOLD)&#xD;
			{&#xD;
				foundSedeOld = true;&#xD;
				indexSedeOld = i;&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(sedeCertificata&#xD;
		|| (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
			&amp;&amp; String(localRequest.ordine.tipologiaSottolav).slice(0,8) == &quot;TRASLOCO&quot;)&#xD;
		|| !foundSedeOld)&#xD;
	{&#xD;
		//Aggiungo la SedeCertificata&#xD;
		localRequest.ordine.sede.add(ARR_sede);&#xD;
	}&#xD;
	else if(indexSedeOld != null)&#xD;
	{&#xD;
		localRequest.ordine.sede.get(indexSedeOld).tipologiaSede = it_telecomitalia_it_NOW_casedata_TipologiaSedeEnumeration.SEDECLIENTECERT;&#xD;
	}&#xD;
}</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_T_80dSXxEea6a4eCDXx0DA" Name="ErrorEvent" xpdExt:Visibility="Private" xpdExt:DisplayName="Error Event">
              <xpdl2:Event>
                <xpdl2:EndEvent Result="Error">
                  <xpdl2:ResultError ErrorCode="Arricchimento non gestito"/>
                </xpdl2:EndEvent>
              </xpdl2:Event>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" Width="59.0">
                  <xpdl2:Coordinates XCoordinate="98.0" YCoordinate="315.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:AssociatedParameters DisableImplicitAssociation="true"/>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_J0WUcK7SEe2CINs-ZZayHg" Name="ArricchimentodaDTUecomponentiL3" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento da DTU e componenti L3">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">//RU_1450 - LOGICA PARTICOLARE PER LA GESTIONE DELLE COMPONENTI DI LIVELLO L3 (PER ORA SOLO APPARATO) --------------------------------------&#xD;
//Le componenti mi arrivano con IDDettaglioOrdine sempre incrementato partendo da 1 e con Parent/Root a seconda se la componente è L2 o L3&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
   &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM &#xD;
   &amp;&amp; ARR_dettaglioOrdineOF_L3 != null &amp;&amp; ARR_dettaglioOrdineOF_L3.size()>0)&#xD;
{	&#xD;
    //STEP1&#xD;
	//Sistemo le componenti DTUSERVIZIOGGIUNTIVO e DTUAPPARATO nell'array prima di aggiungerle nella richiesta&#xD;
	for(var i=0; i&lt; ARR_dettaglioOrdineOF_L3.size(); i++)&#xD;
	{	&#xD;
		//Componenti&#xD;
		if(ARR_dettaglioOrdineOF_L3.get(i).nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUSERVIZIOAGGIUNTIVO)&#xD;
		{&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdine = ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdine + localRequest.ordine.dettaglioordine.size();&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdineParent = 1;&#xD;
		}&#xD;
		else if(ARR_dettaglioOrdineOF_L3.get(i).nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAPPARATO)&#xD;
		{&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdine = ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdine + localRequest.ordine.dettaglioordine.size();&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdineParent = ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdineParent + localRequest.ordine.dettaglioordine.size();&#xD;
		}&#xD;
		&#xD;
		ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdineRoot = 1;	&#xD;
		ARR_dettaglioOrdineOF_L3.get(i).integrationID = localRequest.IDRichiestaOLO + (localRequest.ordine.dettaglioordine.size() + i + 1);		&#xD;
		ARR_dettaglioOrdineOF_L3.get(i).created = date;&#xD;
		ARR_dettaglioOrdineOF_L3.get(i).lastUpdate = date;		&#xD;
		Process.auditLog(&quot;Manipolata la componente: &quot;+ARR_dettaglioOrdineOF_L3.get(i).nomeComponente+ &quot; con IDDettaglioOrdine: &quot; +String(ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdine) +&quot; e con IDDettaglioOrdineParent: &quot; +String(ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdineParent));&#xD;
		&#xD;
		//Attributi&#xD;
		for(var k=0; k&lt;ARR_dettaglioOrdineOF_L3.get(i).attributiDettaglioOrdine.size(); k++)&#xD;
	    {&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).attributiDettaglioOrdine.get(k).IDDettaglioOrdine = ARR_dettaglioOrdineOF_L3.get(i).IDDettaglioOrdine;&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).attributiDettaglioOrdine.get(k).created = date;&#xD;
			ARR_dettaglioOrdineOF_L3.get(i).attributiDettaglioOrdine.get(k).lastUpdate = date;&#xD;
		}&#xD;
	}		&#xD;
	//Aggiungo&#xD;
	localRequest.ordine.dettaglioordine.addAll(ARR_dettaglioOrdineOF_L3);&#xD;
	Process.auditLog(&quot;Aggiunte numero componenti all'ordine: &quot; +String(ARR_dettaglioOrdineOF_L3.size()));&#xD;
&#xD;
	&#xD;
	//STEP2&#xD;
	//Arricchisco SERVIZIOAGGIUNTIVO e APPARATO dell'ordine a partire dalle componenti DTUSERVIZIOAGGIUNTIVO e DTUAPPARATO&#xD;
	//SM_11833: l'arricchimento da DTU di SERVIZIOAGGIUNTIVO non va fatto nel caso di INTERVENTO UNICO&#xD;
	if(localRequest.ordine != null &#xD;
	   &amp;&amp; (localRequest.ordine.flagIU == null || localRequest.ordine.flagIU == &quot;&quot;))&#xD;
	{&#xD;
		for(var i=0; i&lt; ARR_dettaglioOrdineOF_L3.size(); i++)&#xD;
		{&#xD;
			var currentARRdettOrdineOF = ARR_dettaglioOrdineOF_L3.get(i);&#xD;
			&#xD;
			for(var k=0; k&lt;currentARRdettOrdineOF.attributiDettaglioOrdine.size(); k++)&#xD;
			{&#xD;
				var attributo = currentARRdettOrdineOF.attributiDettaglioOrdine.get(k);&#xD;
			&#xD;
				if(currentARRdettOrdineOF.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUSERVIZIOAGGIUNTIVO&#xD;
				   &amp;&amp; attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO&#xD;
				   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &#xD;
				   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO)&#xD;
				{&#xD;
					var CODICESERVIZIODTU = &quot;&quot;;&#xD;
					CODICESERVIZIODTU = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente DTUSERVIZIOAGGIUNTIVO con IDDett &quot;+currentARRdettOrdineOF.IDDettaglioOrdine);	&#xD;
					&#xD;
					for(var m=0; m&lt;localRequest.ordine.dettaglioordine.size(); m++)&#xD;
					{&#xD;
						var componenteRic = localRequest.ordine.dettaglioordine.get(m);&#xD;
						&#xD;
						if(componenteRic.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOAGGIUNTIVO)&#xD;
						{&#xD;
							var NOMESERVIZIO = &quot;&quot;;&#xD;
							NOMESERVIZIO = null;&#xD;
							&#xD;
							for(var q=0; q&lt;componenteRic.attributiDettaglioOrdine.size(); q++){&#xD;
								var attributoRic = componenteRic.attributiDettaglioOrdine.get(q);&#xD;
								&#xD;
								if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMESERVIZIO)&#xD;
								{&#xD;
									NOMESERVIZIO = attributoRic.valoreAttributo;&#xD;
									Process.auditLog(&quot;Trovato attributo NOMESERVIZIO&quot;+ attributoRic.valoreAttributo +&quot; su componente SERVIZIOAGGIUNTIVO con IDDett &quot;+componenteRic.IDDettaglioOrdine);			&#xD;
								}&#xD;
							}&#xD;
&#xD;
							//Legame DTUSERVIZIOGGIUNTIVO - SERVIZIOAGGIUNTIVO&#xD;
							if(NOMESERVIZIO == CODICESERVIZIODTU)&#xD;
							{&#xD;
								var ESITO = &quot;&quot;;&#xD;
								ESITO = null;&#xD;
								var CAUSALEESITO = &quot;&quot;;&#xD;
								CAUSALEESITO = null;&#xD;
								var DESCRIZIONEESITO = &quot;&quot;;&#xD;
								DESCRIZIONEESITO = null;&#xD;
								var foundESITO = false;&#xD;
								var foundCAUSALEESITO = false;&#xD;
								var foundDESCRIZIONEESITO = false;&#xD;
								&#xD;
								//Recupero i valori&#xD;
								for(var z=0; z&lt;currentARRdettOrdineOF.attributiDettaglioOrdine.size(); z++)&#xD;
								{&#xD;
									var attributoARRdettOrdine = currentARRdettOrdineOF.attributiDettaglioOrdine.get(z);&#xD;
								&#xD;
									if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITO){&#xD;
										ESITO = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAUSALEESITO){&#xD;
										CAUSALEESITO = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONEESITO){&#xD;
										DESCRIZIONEESITO = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
								}&#xD;
									&#xD;
								//Arricchisco la componente&#xD;
								for(var x=0; x&lt;componenteRic.attributiDettaglioOrdine.size(); x++)&#xD;
								{&#xD;
									var attributoRic = componenteRic.attributiDettaglioOrdine.get(x);&#xD;
									&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITO&#xD;
									   &amp;&amp; ESITO != null)&#xD;
									{&#xD;
										foundESITO = true;&#xD;
										attributoRic.valoreAttributo = ESITO;&#xD;
										Process.auditLog(&quot;Aggiornato attributo ESITO&quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
									}&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAUSALEESITO&#xD;
									   &amp;&amp; CAUSALEESITO != null)&#xD;
									{&#xD;
										foundCAUSALEESITO = true;&#xD;
										attributoRic.valoreAttributo = CAUSALEESITO;&#xD;
										Process.auditLog(&quot;Aggiornato attributo CAUSALEESITO&quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
									}&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITOOAO&#xD;
