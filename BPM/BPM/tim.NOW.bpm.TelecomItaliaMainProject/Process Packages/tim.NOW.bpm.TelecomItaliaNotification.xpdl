&#xD;
if(StateMachineValidationResponseOF.OF_Reschedule_OpenStream_Request != null&#xD;
   &amp;&amp; StateMachineValidationResponseOF.OF_Reschedule_OpenStream_Request.DATA_PREVISTA_ATTIVAZIONE != null&#xD;
   &amp;&amp; DateTimeUtil.createDate(StateMachineValidationResponseOF.OF_Reschedule_OpenStream_Request.DATA_PREVISTA_ATTIVAZIONE) > DACDaConsiderare)&#xD;
{&#xD;
	result = true;&#xD;
&#xD;
	localRequest.ordine.DACRimodulata = DateTimeUtil.createDate(StateMachineValidationResponseOF.OF_Reschedule_OpenStream_Request.DATA_PREVISTA_ATTIVAZIONE);&#xD;
	Process.auditLog(&quot;DACRimodulata: &quot;+String(localRequest.ordine.DACRimodulata));&#xD;
}&#xD;
//RIENTRI DEL82&#xD;
else if(StateMachineValidationResponseOF.WHS_RescheduleMig_Request != null&#xD;
   &amp;&amp; StateMachineValidationResponseOF.WHS_RescheduleMig_Request.DATA_PREVISTA_ATTIVAZIONE != null&#xD;
