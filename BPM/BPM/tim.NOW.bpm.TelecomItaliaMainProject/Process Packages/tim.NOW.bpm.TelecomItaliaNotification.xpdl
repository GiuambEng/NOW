		}&#xD;
		else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR){&#xD;
			var trovatoCANALITOTALI = false; var trovatoCANALIBIDIREZIONALI = false; var trovatoCANALIENTRANTI = false;&#xD;
			var z = 0;&#xD;
			while((!trovatoCANALITOTALI || !trovatoCANALIBIDIREZIONALI || !trovatoCANALIENTRANTI) &amp;&amp; z &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALITOTALI &amp;&amp; CANALITOTALI != null){&#xD;
					trovatoCANALITOTALI = true;&#xD;
					currentAttDettOrdine.valoreAttributo = CANALITOTALI;&#xD;
