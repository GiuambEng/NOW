   &amp;&amp; localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOB2B)&#xD;
//RU_1450: con la NISOSPENSIONEOF finiamo di interagire con DTU e iniziamo ad interagire con OF&#xD;
||(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FIBERSTREAM &#xD;
   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null  &#xD;
   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NISOSPENSIONEOF&#xD;
   &amp;&amp; localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOINGAGGIOOF)))&#xD;
|| Outcome == &quot;TIMED_OUT&quot;&#xD;
|| Outcome == &quot;GESTIONE_DIS_CONSISTENZA&quot;&#xD;
//RU_1550: MIG DEL82, usciamo dalla gestione esiti DTU (e rieffettuiamo l'emissione) quando&#xD;
//1. è arrivata la NIVERIFICATECNICAETOPONOMASTICA e abbiamo terminato la verifica del codice sessione (stato NOW = INANNULLAMENTOSUDELIVERYD82 o CODICESESSIONEOKD82)&#xD;
//2. è arrivata la NISOSPENSIONE con causale MDL che fa sì che sbloccoDTU dell'ordine sia SI&#xD;
|| (localRequest.ordine != null &amp;&amp; localRequest.ordine.sbloccoDTU == &quot;SI&quot;&#xD;
   &amp;&amp; (localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDELIVERYD82				//SM_11702 - SM_11744&#xD;
       ||localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CODICESESSIONEOKD82))&#xD;
//SM_11804: dopo la NIPRESAAPPUNTAMENTO che porta in ACCETTATOD82 bisogna inviare evento di ACCETTATO verso DTU&#xD;
|| (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
    &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEDEL82&#xD;
	&amp;&amp; localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACCETTATOD82);</xpdl2:Expression></xpdl2:Condition>
