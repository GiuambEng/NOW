                  <xpdl2:Coordinates XCoordinate="1046.0" YCoordinate="191.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_LBYlgJSMEeaoz6QqwJkuNg" Name="Tracciamento2" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Tracciamento2">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_3MBOcO08EeaHW9ek9Jg1tw" PackageRef="tim.NOW.bpm.CasedataTracking.Interfaces" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="TipoOP">
