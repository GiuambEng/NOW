        <xpdl2:Activity Id="_IId2UsmWEe6tB5HEgGPwCw" Name="CalcoloDestinatarieALTRO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcolo Destinatari e ALTRO" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var i=0;&#xD;
&#xD;
while((IDAssetConsistenzaDati == null || CodificaOLOAGCOMConsistenzaDati == null) &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while((IDAssetConsistenzaDati == null || CodificaOLOAGCOMConsistenzaDati == null) &amp;&amp; j&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				IDAssetConsistenzaDati = currentAttDettOrdine.valoreAttributo;			&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING)&#xD;
			{&#xD;
				CodificaOLOAGCOMConsistenzaDati = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="77.0" LaneId="_KTFC0cmNEe6tB5HEgGPwCw" Width="109.0">
