                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">currentArricchimento = StateMachineValidationResponseOF.ARRICCHIMENTI.get(Process.getActivityLoopIndex());</xpdExt:Information>
                </xpdExt:AuditEvent>
