        <xpdl2:Activity Id="_jVYFEAOpEeaIdPdRimpTnw" Name="GestioneEsitiDTU" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Gestione Esiti DTU">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_qoQDqB6uEeaVsuX5wln4CQ" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="Requestref">
                  <xpdl2:Actual ScriptGrammar="JavaScript">Requestref</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="DACModificata">
                  <xpdl2:Actual ScriptGrammar="JavaScript">DACModificata</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="Outcome">
                  <xpdl2:Actual ScriptGrammar="JavaScript">Outcome</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="Requestref">
                  <xpdl2:Actual ScriptGrammar="JavaScript">Requestref</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="nextState">
                  <xpdExt:ScriptInformation Id="_P4tZwOFMEeaG8Idp7z4C2g" Name="nextState">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var result = &quot;&quot;;&#xD;
&#xD;
if(ManageNotificationDTU.STATO_SUCCESSIVO != null)&#xD;
{&#xD;
	result = String(ManageNotificationDTU.STATO_SUCCESSIVO);&#xD;
}&#xD;
&#xD;
result;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="IDTracciamento">
                  <xpdl2:Actual ScriptGrammar="JavaScript">IDTracciamento</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="action">
                  <xpdl2:Actual ScriptGrammar="JavaScript">Action</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="ManageNotificationDTU">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ManageNotificationDTU</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequestTEMP</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="68.0" LaneId="_jVYsLAOpEeaIdPdRimpTnw" Width="110.0">
              <xpdl2:Coordinates XCoordinate="3456.0" YCoordinate="1450.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">//Gestione Concorrenza con ricezione componenti Flash Fiber&#xD;
var componentePresente = false;&#xD;
ComponentiFFAggiornate = false;&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	componentePresente = false;&#xD;
	&#xD;
	for(var j=0; j&lt;localRequestTEMP.ordine.dettaglioordine.size(); j++)&#xD;
	{&#xD;
		var currentDettOrdineTEMP = localRequestTEMP.ordine.dettaglioordine.get(j);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == currentDettOrdineTEMP.nomeComponente)&#xD;
		{&#xD;
			componentePresente = true;&#xD;
			Process.auditLog('Nuova componente trovata: '+currentDettOrdine.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(!componentePresente)&#xD;
	{&#xD;
		localRequestTEMP.ordine.dettaglioordine.add(currentDettOrdine);&#xD;
		ComponentiFFAggiornate = true;&#xD;
		Process.auditLog('Componente '+currentDettOrdine.nomeComponente+' aggiornata sulla localRequest post concorrenza');&#xD;
	}&#xD;
}&#xD;
&#xD;
localRequestTEMP.ordine.IDRisorsaOperatoreRete = localRequest.ordine.IDRisorsaOperatoreRete;&#xD;
localRequestTEMP.idProgressivoNotificheFF = localRequest.idProgressivoNotificheFF;&#xD;
&#xD;
localRequest = ScriptUtil.copy(localRequestTEMP);&#xD;
&#xD;
// RU_859: quando siamo in espletamento tecnico KO e B2B Ricarica, impostiamo l'idAnagCausale a mano (Corrisponde a R016)&#xD;
if(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.B2B &amp;&amp;&#xD;
   localRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.RICARICA &amp;&amp;&#xD;
   localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO)&#xD;
{&#xD;
	localRequest.IDAnagraficaCausale = 598;&#xD;
	Process.auditLog(&quot;Espletamento Tecnico KO di una Ricarica da B2B, nuovo Id Anag Caus: &quot;+localRequest.IDAnagraficaCausale);&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
