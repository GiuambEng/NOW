													else if(((ESITOCONSEGNAAPPARATO == &quot;0&quot; || ESITOCONSEGNAAPPARATO == &quot;5&quot;) &amp;&amp; NOMESERVIZIOOF == &quot;TLC1&quot;)&#xD;
														||((ESITOCONSEGNAAPPARATO == &quot;0&quot; || ESITOCONSEGNAAPPARATO == &quot;5&quot;) &amp;&amp; NOMESERVIZIOOF == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO == null)&#xD;
														||(ESITOCONSEGNAAPPARATO == &quot;1&quot; &amp;&amp; NOMESERVIZIOOF == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO != null))&#xD;
