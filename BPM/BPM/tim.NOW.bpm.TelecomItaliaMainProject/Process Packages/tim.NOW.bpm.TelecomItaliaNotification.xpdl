        <xpdl2:Activity Id="_sUgkH8mREe6tB5HEgGPwCw" Name="RecuperoAsseteTipoNotifica" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupero Asset e TipoNotifica" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">AssetRef = Requestref.assetRef;&#xD;
&#xD;
if(AssetRef != null)&#xD;
{&#xD;
	localAsset = AssetRef.readAsset();&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Nessun Asset Recuperato&quot;);&#xD;
}&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; StateMachineValidationResponseOF != null)&#xD;
{&#xD;
	//CASI MIGRAZIONE FIBERSTREAM RIENTRI DEL82 - C01 2026&#xD;
	&#xD;
	//SM_11946 - SM_11947&#xD;
	if(StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request != null&#xD;
	         &amp;&amp; StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request.STATO_ORDINE == &quot;0&quot;)&#xD;
	{&#xD;
		localRequest.ordine.codiceOrdineOF = StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request.CODICE_ORDINE_WHS;&#xD;
	}&#xD;
	//ESPLETAMENTO OK - RIENTRI DEL82&#xD;
	else if(StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null&#xD;
	    &amp;&amp; StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request.STATO_ORDINE == &quot;0&quot;)&#xD;
	{&#xD;
		localRequest.ordine.idRisorsaOpenFiber = StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request.COR;&#xD;
	}&#xD;
	//SOSPENSIONE - RIENTRI DEL82&#xD;
	else if(StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request != null&#xD;
	         &amp;&amp; StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request.STATO_ORDINE == &quot;4&quot;&#xD;
	         &amp;&amp; StateMachineValidationResponseOF.NOTIFICA != null &amp;&amp; StateMachineValidationResponseOF.NOTIFICA.size()>0)&#xD;
	{&#xD;
		if(StateMachineValidationResponseOF.NOTIFICA.get(0).FLAG_ATTESA_DESOSP_OLO != null)&#xD;
		{&#xD;
			localRequest.flagAttesaDesospOLO = StateMachineValidationResponseOF.NOTIFICA.get(0).FLAG_ATTESA_DESOSP_OLO;		&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//CASI ATTIVAZIONE FIBERSTREAM&#xD;
	&#xD;
	//ESPLETAMENTO OK&#xD;
	else if(StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null&#xD;
	    &amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.STATO_ORDINE == &quot;0&quot;)&#xD;
	{&#xD;
		localRequest.ordine.idRisorsaOpenFiber = StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.ID_RISORSA;&#xD;
	}&#xD;
	//ACQUISIZIONE OK - SM_11288&#xD;
	else if(StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request != null&#xD;
	        &amp;&amp; StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.STATO_ORDINE == &quot;0&quot;)&#xD;
	{&#xD;
		localRequest.ordine.codiceOrdineOpenFiber = StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.CODICE_ORDINE_OLO;&#xD;
		localRequest.ordine.codiceOrdineOF = StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.CODICE_ORDINE_OF;   //RU_1564 &#xD;
	}&#xD;
	//SOSPENSIONE&#xD;
	else if(StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request != null&#xD;
	         &amp;&amp; StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.STATO_ORDINE == &quot;4&quot;&#xD;
	         &amp;&amp; StateMachineValidationResponseOF.NOTIFICA != null &amp;&amp; StateMachineValidationResponseOF.NOTIFICA.size()>0)&#xD;
	{&#xD;
		if(StateMachineValidationResponseOF.NOTIFICA.get(0).FLAG_ATTESA_DESOSP_OLO != null)&#xD;
		{&#xD;
			localRequest.flagAttesaDesospOLO = StateMachineValidationResponseOF.NOTIFICA.get(0).FLAG_ATTESA_DESOSP_OLO;		&#xD;
		}&#xD;
		&#xD;
		if(StateMachineValidationResponseOF.NOTIFICA.get(0).FLAG_ABILITAZIONE_MAN_GUI != null)&#xD;
		{&#xD;
			localRequest.flgAbilitazGuiManualOF = StateMachineValidationResponseOF.NOTIFICA.get(0).FLAG_ABILITAZIONE_MAN_GUI;    //RU_1458	&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//Arricchimento noteFiberStream - SM_11316&#xD;
	if(StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null &#xD;
	   &amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.NOTE != null)&#xD;
    {&#xD;
		localRequest.ordine.noteFiberStream = StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.NOTE;&#xD;
    }&#xD;
	else if(StateMachineValidationResponseOF.OF_Reschedule_OpenStream_Request != null &#xD;
	   &amp;&amp; StateMachineValidationResponseOF.OF_Reschedule_OpenStream_Request.NOTE != null)&#xD;
    {&#xD;
	    localRequest.ordine.noteFiberStream = StateMachineValidationResponseOF.OF_Reschedule_OpenStream_Request.NOTE;&#xD;
    }&#xD;
	else if(StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request != null &#xD;
	   &amp;&amp; StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.NOTE != null)&#xD;
    {&#xD;
	    localRequest.ordine.noteFiberStream = StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.NOTE;&#xD;
    }&#xD;
}&#xD;
&#xD;
//COSTRUZIONE ARRAY UTILI PER ARRICCHIMENTO E INVIO NOTIFICHE&#xD;
if(StateMachineValidationResponseOF != null)&#xD;
{&#xD;
	var idAnagraficaCausaleAggiornata = false;&#xD;
	&#xD;
	for(var i=0; i&lt;StateMachineValidationResponseOF.NOTIFICA.size();i++)&#xD;
	{&#xD;
		var notifica = StateMachineValidationResponseOF.NOTIFICA.get(i);&#xD;
		&#xD;
		if(notifica.ID_ANAGRAFICA_CAUSALE != null &amp;&amp; notifica.ID_ANAGRAFICA_CAUSALE != &quot;&quot;)&#xD;
		{&#xD;
			if(!idAnagraficaCausaleAggiornata)&#xD;
			{&#xD;
				localRequest.IDAnagraficaCausale = notifica.ID_ANAGRAFICA_CAUSALE;&#xD;
				idAnagraficaCausaleAggiornata = true;&#xD;
			}&#xD;
&#xD;
			var quantitaNotificheAggiunte = 0;&#xD;
			&#xD;
			if(notifica.ID_NOTIFICA_DONATING != null &amp;&amp; notifica.ID_NOTIFICA_DONATING != &quot;&quot;)&#xD;
			{ &#xD;
				Process.auditLog(&quot;Aggiungo IDNotifica: &quot; + notifica.ID_NOTIFICA_DONATING + &quot; per DONATING con COMPONENTE&quot; + notifica.COMPONENTE_DONATING);&#xD;
				TipologiaNotifica.add(notifica.ID_NOTIFICA_DONATING);&#xD;
				TargetNotifica.add(&quot;DONATING&quot;);&#xD;
				ComponenteDonating.add(notifica.COMPONENTE_DONATING);&#xD;
				quantitaNotificheAggiunte++;&#xD;
			}&#xD;
			if(notifica.ID_NOTIFICA_RECIPIENT != null &amp;&amp; notifica.ID_NOTIFICA_RECIPIENT != &quot;&quot;)&#xD;
			{&#xD;
				Process.auditLog(&quot;Aggiungo IDNotifica: &quot; + notifica.ID_NOTIFICA_RECIPIENT + &quot; per RECIPIENT&quot;);&#xD;
				TipologiaNotifica.add(notifica.ID_NOTIFICA_RECIPIENT);&#xD;
				TargetNotifica.add(&quot;RECIPIENT&quot;);&#xD;
				ComponenteDonating.add(&quot;NULL&quot;);&#xD;
				quantitaNotificheAggiunte++;&#xD;
			}&#xD;
			&#xD;
			for(var j=0; j&lt;quantitaNotificheAggiunte; j++)&#xD;
			{			&#xD;
				IDAnagraficaCausale.add(notifica.ID_ANAGRAFICA_CAUSALE);&#xD;
				CodiceCausale.add(notifica.CODICE_CAUSALE_NOW);								&#xD;
			}&#xD;
		}&#xD;
&#xD;
		Process.auditLog(&quot;StateMachineValidationResponseOF.STATO_SUCCESSIVO_OF:&quot; + StateMachineValidationResponseOF.STATO_SUCCESSIVO_OF);&#xD;
	&#xD;
		if(StateMachineValidationResponseOF.STATO_SUCCESSIVO_OF == &quot;SOSPESOOF&quot;)&#xD;
		{&#xD;
			var i=0;&#xD;
			var CodiceCausaleAltre = &quot;&quot;;&#xD;
			&#xD;
			while(TipologiaNotifica != null &amp;&amp; i&lt;TipologiaNotifica.size())&#xD;
			{&#xD;
				CodiceCausaleAltre = CodiceCausale.get(i);				&#xD;
				i++;&#xD;
			}&#xD;
						&#xD;
			localRequest.codiceCausaleInterno = CodiceCausaleAltre;&#xD;
			Process.auditLog(&quot;Stato SOSPESOOF con codiceCausaleInterno: &quot; + localRequest.codiceCausaleInterno);	&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
