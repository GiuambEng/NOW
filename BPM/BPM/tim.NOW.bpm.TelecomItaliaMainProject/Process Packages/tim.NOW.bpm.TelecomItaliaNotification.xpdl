          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="84.0" LaneId="_GL3B8XPJEeiNoc-cG11Fww" Width="131.0">
              <xpdl2:Coordinates XCoordinate="300.0" YCoordinate="272.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.DeliveryExposedService/Process Packages/tim.NOW.bpm.DeliveryExposedService.xpdl.TINOWDeliveryExposedService&quot;;&#xD;
&#xD;
&#xD;
&#xD;
if(localRequest.progressivoNotificaDTU == null)&#xD;
{&#xD;
       localRequest.progressivoNotificaDTU = 1;&#xD;
}&#xD;
if(FlagAnnullamentoAutomatico==null){&#xD;
       FlagAnnullamentoAutomatico = false;&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">	ManageNotificationDTU = com_tim_NOW_xsd_BPM_DTUNotificationManagement_v1_Factory.createmanageNotificationRequestType();&#xD;
&#xD;
&#xD;
	ManageNotificationDTU.ID_RICHIESTA = DeliveryExposedRequest.ID_RICHIESTA;&#xD;
	ManageNotificationDTU.codProcsoNoFile = DeliveryExposedRequest.codProcsoNoFile;&#xD;
	ManageNotificationDTU.idEsecProcsoNoFile = DeliveryExposedRequest.idEsecProcsoNoFile;&#xD;
	ManageNotificationDTU.idEventoOrdnNowWhls = DeliveryExposedRequest.idEventoOrdnNowWhls;&#xD;
	ManageNotificationDTU.progressivoNotificaDTU = DeliveryExposedRequest.progressivoNotificaDTU;	&#xD;
	if(DeliveryExposedRequest.ACK != null)&#xD;
	{&#xD;
		ManageNotificationDTU.ACK_COMUNICAZIONE = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_Factory.createack_Type();&#xD;
		ManageNotificationDTU.ACK_COMUNICAZIONE.CAUSALE_ESITO = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_CausaleEsitoAckType.get(DeliveryExposedRequest.ACK);&#xD;
		ManageNotificationDTU.ACK_COMUNICAZIONE.DATA = DateTimeUtil.createDatetime();&#xD;
		ManageNotificationDTU.ACK_COMUNICAZIONE.TRANSACTION_ID = 'TID';&#xD;
		ManageNotificationDTU.ACK_COMUNICAZIONE.TIPO_MESSAGGIO = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoMessaggioType.get(String(DeliveryExposedRequest.NOTIFICA)); // Bug #29725&#xD;
		&#xD;
		Process.auditLog(&quot;ACK - TIPO_MESSAGGIO: &quot;+ManageNotificationDTU.ACK_COMUNICAZIONE.TIPO_MESSAGGIO+&quot;, CAUSALE_ESITO: &quot;+ManageNotificationDTU.ACK_COMUNICAZIONE.CAUSALE_ESITO);		&#xD;
		&#xD;
		Process.auditLog(&quot;Ricevuta ACK DTU con ID: &quot; + DeliveryExposedRequest.idEventoOrdnNowWhls + &quot; e tipo: &quot; + DeliveryExposedRequest.ACK);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Ricevuta Notifica DTU con ID: &quot; + DeliveryExposedRequest.idEventoOrdnNowWhls + &quot; e tipo: &quot; + DeliveryExposedRequest.NOTIFICA);&#xD;
	}&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
//per permettere il caricamento di dati da DB se modificati.n&#xD;
//localRequest = Requestref.readRichiesta();&#xD;
if(localRequest.progressivoNotificaDTU == null)&#xD;
{&#xD;
	progressivoNotificaDTU = 1;&#xD;
	//localRequest.progressivoNotificaDTU = 1;&#xD;
}&#xD;
&#xD;
//Gestione Priorita&#xD;
if(DateTimeUtil.createDate(localRequest.created) == DateTimeUtil.createDate())&#xD;
{&#xD;
	Process.priority = 200;&#xD;
}&#xD;
else if(DeliveryExposedRequest.NOTIFICA != null &amp;&amp; String(DeliveryExposedRequest.NOTIFICA).slice(0, 2) == &quot;NF&quot;)&#xD;
{&#xD;
	Process.priority = 270;&#xD;
}&#xD;
else if(DeliveryExposedRequest.NOTIFICA != null &amp;&amp; DeliveryExposedRequest.NOTIFICA==&quot;NIRIMODULAZIONEDAC&quot;)&#xD;
{&#xD;
	Process.priority = 250;&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.priority = 230;&#xD;
}&#xD;
&#xD;
progressivoNotificaDTU = localRequest.progressivoNotificaDTU;&#xD;
progressivoNotificaDTU++;&#xD;
//localRequest.progressivoNotificaDTU++;&#xD;
//Mantenuto per retrocompatibilità pratiche in volo&#xD;
StateMachineValidationResponse = null;&#xD;
&#xD;
&#xD;
StateMachineValidationResponse_new = null;&#xD;
&#xD;
localRequest.codiceCausaleInterno = null;&#xD;
&#xD;
dataRicezioneNotificaDTU = DateTimeUtil.createDate();&#xD;
&#xD;
TipologiaNotifica.clear();&#xD;
TargetNotifica.clear();&#xD;
IDAnagraficaCausale.clear();&#xD;
CodiceCausale.clear();&#xD;
ComponenteDonating.clear();&#xD;
IDAssetConsistenzaCPS.clear(); //SM_9709</xpdExt:Information>
