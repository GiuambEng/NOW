          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">//SM_10716: spostato script Terminating Management prima della chiamata a FF/FC (SendToFLASH_FIBER_COP)&#xD;
&#xD;
//TerminatingMGMGateway&#xD;
(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
&amp;&amp;&#xD;
 (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH //RU_1164: aggiunte SEMI***&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH))&#xD;
&amp;&amp;&#xD;
//TIPOLOGIA NOTIFICA 1: è una condizione presente sul ramo del gateway TIPOLOGIA_NOTIFICA&#xD;
!(ManageNotificationDTU.EVENTO_NOTIFICA != null&#xD;
	&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO&#xD;
	&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CODICE_ESITO != com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_CodiceEsitoType._015&#xD;
	&amp;&amp; (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CODICE_ESITO != com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_CodiceEsitoType._016 || ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO != &quot;N28&quot;)&#xD;
	&amp;&amp; !(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CODICE_ESITO == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_CodiceEsitoType._016 &amp;&amp; (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == &quot;054&quot; || ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == &quot;055&quot;)))&#xD;
&amp;&amp;&#xD;
//TIPOLOGIA NOTIFICA 2: condizione prima presente su un ramo del gateway TIPOLOGIA_NOTIFICA che è stato eliminato con questa SM (andiamo direttamente nel ramo di default)&#xD;
!((ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
	ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA==com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFCONFERMAANNULLAMENTO &amp;&amp;&#xD;
	ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO != &quot;025&quot;)&#xD;
	||&#xD;
	(ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIVERIFICATECNICAETOPONOMASTICA &amp;&amp; localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPDONOROLO));</xpdl2:Expression></xpdl2:Condition>
