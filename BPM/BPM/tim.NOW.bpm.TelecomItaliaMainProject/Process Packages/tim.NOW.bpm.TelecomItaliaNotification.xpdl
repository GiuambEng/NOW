        <xpdl2:Activity Id="_SdQUENHtEeiHCLbV5yPjPw" Name="ArricchimentoOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">DettaglioOrdineFF = ScriptUtil.fromXML(DettaglioOrdineFF_XML);&#xD;
Process.auditLog('Ricezione notifica FF con componente '+DettaglioOrdineFF.nomeComponente);&#xD;
&#xD;
// *** LOGICHE VALORIZZAZIONE VALORI COMPONENTE FF ***&#xD;
DettaglioOrdineFF.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
DettaglioOrdineFF.integrationID = localRequest.IDRichiestaOLO + (localRequest.ordine.dettaglioordine.size() + 1);&#xD;
&#xD;
for(var j=0; j&lt;DettaglioOrdineFF.attributiDettaglioOrdine.size(); j++)&#xD;
{&#xD;
	var attributo = DettaglioOrdineFF.attributiDettaglioOrdine.get(j);&#xD;
	attributo.IDDettaglioOrdine = DettaglioOrdineFF.IDDettaglioOrdine;&#xD;
}&#xD;
&#xD;
// *** LOGICHE VALORIZZAZIONE VARIABILI/RICH ***&#xD;
// RU_737 - Inserire sull'ORDINE, nell’attributo IDENTIFICATIVO RISORSA OPERATORE RETE il valore ID RISORSA restituito da FLASH FIBER&#xD;
if(DettaglioOrdineFF.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.FFEMESSO)&#xD;
{&#xD;
	localRequest.ordine.IDRisorsaOperatoreRete = IDRisorsaFF_ARR;&#xD;
	Process.auditLog('localRequest.ordine.IDRisorsaOperatoreRete: '+localRequest.ordine.IDRisorsaOperatoreRete+', aggiornato con '+IDRisorsaFF_ARR);&#xD;
}&#xD;
&#xD;
if(DettaglioOrdineFF.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.FFRIFIUTOACQUISITO)&#xD;
{&#xD;
	localRequest.FFACQKO = 'Y';&#xD;
	GetFromStaging = true;&#xD;
	Process.auditLog('localRequest.FFACQKO: '+localRequest.FFACQKO);&#xD;
}&#xD;
&#xD;
if(DettaglioOrdineFF.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.FFCHIUSO)&#xD;
{&#xD;
	FFChiuso = true;&#xD;
	Process.auditLog('FFChiuso: '+FFChiuso);&#xD;
}&#xD;
&#xD;
// *** LOGICA ARRICCHIMENTO/SOSTITUZIONE COMPONENTE ORDINE CON QUELLA ARRIVATA DA FF *** - Inserita la sostituzione con SM_8591&#xD;
var componenteFFtrovata = false;&#xD;
var i = 0;&#xD;
&#xD;
while(!componenteFFtrovata &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
	if(componente.nomeComponente == DettaglioOrdineFF.nomeComponente)&#xD;
	{&#xD;
		//Sostituzione&#xD;
		componente = ScriptUtil.copy(DettaglioOrdineFF);&#xD;
		Process.auditLog(&quot;Componente FF &quot;+DettaglioOrdineFF.nomeComponente+&quot; sostituita a quella esistente nell'ordine&quot;);&#xD;
		componenteFFtrovata = true;&#xD;
	}&#xD;
&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(!componenteFFtrovata)&#xD;
{&#xD;
	//Aggiunta&#xD;
	localRequest.ordine.dettaglioordine.add(DettaglioOrdineFF);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_jVYsLAOpEeaIdPdRimpTnw" Width="147.0">
              <xpdl2:Coordinates XCoordinate="357.0" YCoordinate="2049.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
