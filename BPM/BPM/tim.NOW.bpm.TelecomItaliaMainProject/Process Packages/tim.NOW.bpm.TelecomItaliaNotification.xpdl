          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">Process.auditLog(&quot;Aggiornamento stati OF-NOW-OLO&quot;);&#xD;
&#xD;
if(StateMachineValidationResponseOF != null &amp;&amp; StateMachineValidationResponseOF.STATO_SUCCESSIVO_OF != null)&#xD;
{&#xD;
	//STATO OF&#xD;
	localRequest.statoRichiestaPrecedOF = localRequest.statoRichiestaOF;&#xD;
	localRequest.statoRichiestaOF = it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.get(String(StateMachineValidationResponseOF.STATO_SUCCESSIVO_OF));&#xD;
	&#xD;
	//MIGRAZIONE FIBERSTREAM RIENTRIDEL82 - C01 2026&#xD;
	if(localRequest.flagRientriDel82 == &quot;SI&quot;)  //SM_11958: fixati stati D82&#xD;
	{&#xD;
		//C35M02F11 – Evento di Acquisizione Rientri Del.82 con STATO ORDINE = 0 (positivo) con statoOLO = SOSPESO&#xD;
		//C35M02F12 – Evento di Accettazione Rientri Del.82 con STATO ORDINE = 2 (positivo) con statoOLO = SOSPESO&#xD;
		//C35M02F15 – Evento di Espletamento Rientri Del.82 con STATO ORDINE = 0 (positivo)&#xD;
		if((StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request != null&#xD;
		   &amp;&amp; (StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request.STATO_ORDINE == &quot;0&quot;&#xD;
			   ||StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request.STATO_ORDINE == &quot;2&quot;)&#xD;
		   &amp;&amp; localRequest.statoRichiestaOLO == it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SOSPESO)&#xD;
		  || (StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null&#xD;
			  &amp;&amp; StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request.STATO_ORDINE == &quot;0&quot;))&#xD;
		{	&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INDELIVERYD82;&#xD;
			&#xD;
			localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.INDELIVERY;&#xD;
		}&#xD;
		&#xD;
		//C35M02F11 – Evento di Acquisizione Rientri Del.82 con STATO ORDINE = 1 (negativo) e cluster AUTOMATICO &#xD;
		else if(StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request != null&#xD;
				&amp;&amp; StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request.STATO_ORDINE == &quot;1&quot;&#xD;
				&amp;&amp; StateMachineValidationResponseOF.NOTIFICA != null &#xD;
				&amp;&amp; StateMachineValidationResponseOF.NOTIFICA.get(0).ID_TPLG_EVENTO == &quot;ACQUISIZIONE_KO_AUTO_OF&quot;)&#xD;
		{	&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;	&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDTUPERKOOF;&#xD;
		}&#xD;
		&#xD;
		//C35M02F11 – Evento di Acquisizione Rientri Del.82 con STATO ORDINE = 1 (negativo) e cluster MANUALE &#xD;
		else if(StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request != null&#xD;
				&amp;&amp; StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request.STATO_ORDINE == &quot;1&quot;&#xD;
				&amp;&amp; StateMachineValidationResponseOF.NOTIFICA != null &#xD;
				&amp;&amp; StateMachineValidationResponseOF.NOTIFICA.get(0).ID_TPLG_EVENTO == &quot;ACQUISIZIONE_KO_OF_DEL82&quot;)&#xD;
		{&#xD;
			localRequest.flgAbilitazGuiManualOF = &quot;SI&quot;;&#xD;
		}&#xD;
		&#xD;
		//C35M02F12 – Evento di Accettazione Rientri Del.82 con STATO ORDINE = 3 (negativo) e cluster AUTOMATICO &#xD;
		//C35M02F15 – Evento di Espletamento Rientri Del.82 con STATO ORDINE = 1 (negativo)&#xD;
		else if((StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request != null&#xD;
				&amp;&amp; StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request.STATO_ORDINE == &quot;3&quot;&#xD;
				   &amp;&amp; StateMachineValidationResponseOF.NOTIFICA != null &#xD;
				   &amp;&amp; StateMachineValidationResponseOF.NOTIFICA.get(0).ID_TPLG_EVENTO == &quot;ACCETTAZIONE_KO_AUTO_OF&quot;)   //SM_12009&#xD;
				||(StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null&#xD;
					&amp;&amp; StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request.STATO_ORDINE == &quot;1&quot;))&#xD;
		{	&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDTUPEROF;&#xD;
		}&#xD;
		&#xD;
		//C35M02F07 – Evento di Annullamento Rientri Del.82&#xD;
		else if(StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request != null&#xD;
				&amp;&amp; StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request.STATO_ORDINE == &quot;5&quot;)&#xD;
		{&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDTUPERANNULLAMENTOOKOF;&#xD;
		}&#xD;
		&#xD;
		//C35M02F17 - Evento di Rimodulazione DAC Rientri Del.82&#xD;
		//C35M02F13 – Evento di Sospensione Rientri Del.82&#xD;
		else if(StateMachineValidationResponseOF.WHS_RescheduleMig_Request != null&#xD;
		         ||(StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request != null&#xD;
					&amp;&amp; StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request.STATO_ORDINE == &quot;4&quot;)) &#xD;
		{&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOD82;&#xD;
			&#xD;
			localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SOSPESO;&#xD;
		}&#xD;
		//C35M02F18 – Evento di Interruzione Sospensione Rientri Del.82 (Positivo)&#xD;
		else if(StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request != null&#xD;
					&amp;&amp; StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request.STATO_ORDINE == &quot;2&quot;&#xD;
					&amp;&amp; localRequest.statoRichiestaOLO == it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SOSPESO) &#xD;
		{&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INDELIVERYD82;&#xD;
			&#xD;
			localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.INDELIVERY;&#xD;
		}&#xD;
		//C35M02F18 – Evento di Interruzione Sospensione Rientri Del.82 (Negativo)&#xD;
		else if(StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request != null&#xD;
				&amp;&amp; StateMachineValidationResponseOF.WHS_StatusUpdateMig_Request.STATO_ORDINE == &quot;3&quot;&#xD;
				&amp;&amp; StateMachineValidationResponseOF.NOTIFICA != null &#xD;
				&amp;&amp; StateMachineValidationResponseOF.NOTIFICA.get(0).ID_TPLG_EVENTO == &quot;ACQUISIZIONE_KO_AUTO_OF&quot;) &#xD;
		{&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDTUPEROF;&#xD;
		}&#xD;
	}&#xD;
	else //LOGICA STANDARD - ATTIVAZIONE FIBERSTREAM&#xD;
	{&#xD;
		//C35M02F02 – Evento di Acquisizione con STATO ORDINE = 0 (positivo) con statoOLO = SOSPESO&#xD;
		//C35M02F03 – Evento di Accettazione con STATO ORDINE = 2 (positivo) con statoOLO = SOSPESO&#xD;
		//C35M02F04 – Evento di Espletamento con STATO ORDINE = 0 (positivo)&#xD;
		if((StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request != null&#xD;
		   &amp;&amp; (StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.STATO_ORDINE == &quot;0&quot;&#xD;
			   ||StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.STATO_ORDINE == &quot;2&quot;)&#xD;
		   &amp;&amp; localRequest.statoRichiestaOLO == it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SOSPESO)&#xD;
		  || (StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null&#xD;
			  &amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.STATO_ORDINE == &quot;0&quot;))&#xD;
		{	&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INDELIVERY;&#xD;
			&#xD;
			localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.INDELIVERY;&#xD;
		}&#xD;
		&#xD;
		//C35M02F02 – Evento di Acquisizione con STATO ORDINE = 1 (negativo) e cluster AUTOMATICO &#xD;
		else if(StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request != null&#xD;
				&amp;&amp; StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.STATO_ORDINE == &quot;1&quot;&#xD;
				&amp;&amp; StateMachineValidationResponseOF.NOTIFICA != null &#xD;
				&amp;&amp; StateMachineValidationResponseOF.NOTIFICA.get(0).ID_TPLG_EVENTO == &quot;ACQUISIZIONE_KO_AUTO_OF&quot;)&#xD;
		{	&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;	&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDTUPERKOOF;&#xD;
		}&#xD;
		&#xD;
		//C35M02F02 – Evento di Acquisizione con STATO ORDINE = 1 (negativo) e cluster MANUALE &#xD;
		else if(StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request != null&#xD;
				&amp;&amp; StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.STATO_ORDINE == &quot;1&quot;&#xD;
				&amp;&amp; StateMachineValidationResponseOF.NOTIFICA != null &#xD;
				&amp;&amp; StateMachineValidationResponseOF.NOTIFICA.get(0).ID_TPLG_EVENTO == &quot;ACQUISIZIONE_KO_MAN_OF&quot;)&#xD;
		{&#xD;
			localRequest.flgAbilitazGuiManualOF = &quot;SI&quot;;&#xD;
		}&#xD;
		&#xD;
		//C35M02F03 – Evento di Accettazione con STATO ORDINE = 3 (negativo) e cluster AUTOMATICO &#xD;
		//C35M02F04 – Evento di Espletamento con STATO ORDINE = 1 (negativo)&#xD;
		else if((StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request != null&#xD;
				&amp;&amp; StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.STATO_ORDINE == &quot;3&quot;&#xD;
				   &amp;&amp; StateMachineValidationResponseOF.NOTIFICA != null &#xD;
				   &amp;&amp; StateMachineValidationResponseOF.NOTIFICA.get(0).ID_TPLG_EVENTO == &quot;ACCETTAZIONE_KO_AUTO_OF&quot;)&#xD;
				||(StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null&#xD;
					&amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.STATO_ORDINE == &quot;1&quot;))&#xD;
		{	&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDTUPEROF;&#xD;
		}&#xD;
		&#xD;
		//C35M02F07 – Evento di Annullamento - SM_11308&#xD;
		else if(StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request != null&#xD;
				&amp;&amp; StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.STATO_ORDINE == &quot;5&quot;)&#xD;
		{&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDTUPERANNULLAMENTOOKOF;&#xD;
		}&#xD;
		&#xD;
		//C35M02F05 – Evento di Presa Appuntamento&#xD;
		//C35M02F06 – Evento di Sospensione con causale diversa da B06&#xD;
		else if(StateMachineValidationResponseOF.OF_Reschedule_OpenStream_Request != null&#xD;
				||(StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request != null&#xD;
					&amp;&amp; StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.STATO_ORDINE == &quot;4&quot;)) &#xD;
		{&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESO;&#xD;
			&#xD;
			localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SOSPESO;&#xD;
		}&#xD;
		//C35M02F08 - Evento di Espletamento Cessazione con STATO ORDINE = 7 (negativo) - SM_11328&#xD;
		else if(StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request != null&#xD;
				&amp;&amp; StateMachineValidationResponseOF.OF_StatusUpdate_OpenStream_Request.STATO_ORDINE == &quot;7&quot;)&#xD;
		{&#xD;
			localRequest.flgAbilitazGuiManualOF = &quot;SI&quot;;&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
localRequest.lastUpdate = date;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	localRequest.ordine.lastUpdate = date;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
