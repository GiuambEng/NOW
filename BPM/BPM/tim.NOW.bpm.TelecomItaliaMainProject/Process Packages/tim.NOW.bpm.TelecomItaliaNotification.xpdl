						var attributoARRdettOrdine = currentARRdettOrdine.attributiDettaglioOrdine.get(z);&#xD;
					&#xD;
						if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPORETE){&#xD;
