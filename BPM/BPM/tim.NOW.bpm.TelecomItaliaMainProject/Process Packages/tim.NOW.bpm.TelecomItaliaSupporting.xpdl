        </xpdl2:Activity>
        <xpdl2:Activity Id="_XPN9gCRZEeeAUIVIBex-Zw" Name="CalcolaTipoPacchetto" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola Tipo Pacchetto">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP)&#xD;
{&#xD;
	localRequest.tipoPacchetto = &quot;1&quot;;&#xD;
	if(localRequest.ordine!=null)&#xD;
	{&#xD;
		localRequest.ordine.tipoPacchetto = &quot;1&quot;;&#xD;
	}&#xD;
}&#xD;
else if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp; localRequest.ordine == it_telecomitalia_it_NOW_casedata_LNA_LAEnumeration.LA)&#xD;
			|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
			|| (localRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.ORDINE &amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274))&#xD;
{&#xD;
	localRequest.tipoPacchetto = &quot;0&quot;;&#xD;
	if(localRequest.ordine!=null)&#xD;
	{&#xD;
		localRequest.ordine.tipoPacchetto = &quot;0&quot;;&#xD;
	}&#xD;
}&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
		&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA))&#xD;
{&#xD;
	localRequest.tipoPacchetto = &quot;2&quot;;&#xD;
	if(localRequest.ordine!=null)&#xD;
	{&#xD;
		localRequest.ordine.tipoPacchetto = &quot;2&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	localRequest.tipoPacchetto = null;&#xD;
	if(localRequest.ordine!=null)&#xD;
	{&#xD;
		localRequest.ordine.tipoPacchetto = null;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
