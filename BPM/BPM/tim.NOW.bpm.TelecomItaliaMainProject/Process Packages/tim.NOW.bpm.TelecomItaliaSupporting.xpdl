          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_jCEV4PRIEeazKYdqUBpQKA" PackageRef="tim.NOW.bpm.ErrorCodeManagement.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="TipoOperazione">
