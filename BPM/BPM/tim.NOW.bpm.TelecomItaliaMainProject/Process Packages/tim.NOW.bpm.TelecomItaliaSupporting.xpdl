            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="80.0" LaneId="_1zpscTIzEeamluCw9N7DAQ" Width="128.0">
              <xpdl2:Coordinates XCoordinate="608.0" YCoordinate="356.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">Asset = AssetRef.readAsset();&#xD;
&#xD;
if(action == &quot;LOCK&quot;)&#xD;
{&#xD;
	Asset.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE;&#xD;
}&#xD;
else&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;IDRisorsa=:SearchIDRisorsa ORDER BY created DESC&quot;);&#xD;
	criteria.setQueryParameter(&quot;SearchIDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
	var list = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
	if (list.size()>0)&#xD;
	{&#xD;
		var foundNP=false;&#xD;
		for(var i = 0; i &lt; list.size(); i++)&#xD;
		{&#xD;
			var currentRic = list.get(i).readRichiesta();&#xD;
			if (currentRic.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG &amp;&amp;&#xD;
			currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO &amp;&amp;&#xD;
			currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATO &amp;&amp;&#xD;
			currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CHIUSO &amp;&amp;&#xD;
			currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOAFATTURAZIONE &amp;&amp;&#xD;
			currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO)&#xD;
			{	&#xD;
				foundNP=true;&#xD;
			}&#xD;
		}&#xD;
		if(!foundNP)&#xD;
		{&#xD;
			Asset.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
	Asset.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
	}&#xD;
}&#xD;
&#xD;
// RU_778 - UNLOCK/LOCK COMPONENTE&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp;&#xD;
   localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PORTIN)&#xD;
{&#xD;
	var indexDettaglio = -1;&#xD;
	&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{					&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVODETTAGLIOASSET) // RU_778&#xD;
				{&#xD;
					indexDettaglio = ScriptUtil.createBigInteger(currentAttDettOrdine.valoreAttributo);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(action == &quot;LOCK&quot; &amp;&amp; indexDettaglio != -1)&#xD;
	{&#xD;
		Asset.dettaglioasset.get(indexDettaglio).statoDettaglioAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE;&#xD;
		Process.auditLog('Effettuato lock id componente '+indexDettaglio+' dell asset '+Asset.IDAsset);&#xD;
	}&#xD;
	else if(indexDettaglio != -1)&#xD;
	{&#xD;
		Asset.dettaglioasset.get(indexDettaglio).statoDettaglioAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
		Process.auditLog('Effettuato unlock id componente '+indexDettaglio+' dell asset '+Asset.IDAsset);&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
