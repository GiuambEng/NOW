        <xpdl2:Activity Id="_zDSuYO4UEeaHtMFQ0XhLgQ" Name="Tracciamento1" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Tracciamento1">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_3MBOcO08EeaHW9ek9Jg1tw" PackageRef="tim.NOW.bpm.CasedataTracking.Interfaces" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="TipoOP">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;INSERT&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="IDEventoOrdnNowWhls">
                  <xpdl2:Actual ScriptGrammar="JavaScript">IDEventoOrdnNowWhls</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_dmlZhQOtEeaIdPdRimpTnw" Width="128.0">
              <xpdl2:Coordinates XCoordinate="2064.0" YCoordinate="805.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.CasedataTracking.xpdl.Tracciamento&quot;;&#xD;
&#xD;
//SM_11198&#xD;
//In uscita da &quot;Case Update Request / Order Status Input&quot; mappiamo localRequest in StrippedRequest quindi se &#xD;
//nel frattempo abbiamo modificato la DACRimodulata in StrippedRequest (mediante RDAC automatica) se non aggiorniamo anche nella localRequest&#xD;
//allora ci perdiamo il valore quando effettuiamo l'inserimento nella Tracciamento della localRequest&#xD;
&#xD;
if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
   &amp;&amp; localRequest.flagDelibera103 == &quot;Y&quot; &amp;&amp; StrippedRequest.ordine != null)&#xD;
{&#xD;
	var DACDaConsiderare = DateTimeUtil.createDate(); &#xD;
&#xD;
	if(localRequest.ordine != null &amp;&amp; localRequest.ordine.DACRimodulata != null)&#xD;
	{&#xD;
		DACDaConsiderare = DateTimeUtil.createDate(localRequest.ordine.DACRimodulata);&#xD;
	}&#xD;
	else if(localRequest.DAC != null)&#xD;
	{&#xD;
		DACDaConsiderare = DateTimeUtil.createDate(localRequest.DAC);&#xD;
	}&#xD;
&#xD;
	//SOSTITUISCO LA DAC SE è STATA RIMODULATA&#xD;
	if(DACDaConsiderare != null &amp;&amp; StrippedRequest.ordine.DACRimodulata != null&#xD;
	   &amp;&amp; DateTimeUtil.createDate(StrippedRequest.ordine.DACRimodulata) > DACDaConsiderare)&#xD;
    {&#xD;
	   localRequest.ordine.DACRimodulata = StrippedRequest.ordine.DACRimodulata;&#xD;
	   Process.auditLog(&quot;Aggiornata RDAC perché scaduto il timer di RDAC automatico: &quot;+String(localRequest.ordine.DACRimodulata));&#xD;
    }  &#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_cF5JEO4VEeaHtMFQ0XhLgQ" Name="Tracciamento2" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Tracciamento2">
