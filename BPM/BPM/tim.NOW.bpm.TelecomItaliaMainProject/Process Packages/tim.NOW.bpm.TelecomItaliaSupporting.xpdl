        <xpdl2:Activity Id="_8928QEYHEeevbJfmizMVGw" Name="CalcAsset" xpdExt:Visibility="Private" xpdExt:DisplayName="Calc Asset">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">for(var k = 0; k &lt; localRequest.assetTarget.size(); k++)&#xD;
{&#xD;
	var currentAssetTarget = localRequest.assetTarget.get(k);&#xD;
	&#xD;
	if(currentAssetTarget.flagInLavorazione)&#xD;
	{&#xD;
		var currentAssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(currentAssetTarget.IDAsset);&#xD;
		var currentAsset = currentAssetRef.readAsset();&#xD;
		&#xD;
		if(action == &quot;LOCK&quot;)&#xD;
		{&#xD;
			currentAsset.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			currentAsset.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
		}&#xD;
	&#xD;
		AssetTargetRef.add(currentAssetRef);&#xD;
		AssetTarget.add(ScriptUtil.copy(currentAsset));&#xD;
		&#xD;
		if(localRequest.lavorazione==it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
		&amp;&amp; String(localRequest.offerta).slice(0,3)==&quot;WLR&quot;&#xD;
		&amp;&amp; currentAsset.IDRisorsaCorrelato!=null &amp;&amp; currentAsset.IDRisorsaCorrelato!=&quot;&quot; &amp;&amp; action == &quot;UNLOCK&quot;)&#xD;
		{&#xD;
			//Cerco asset correlato&#xD;
			Process.auditLog(&quot;Cerco ASSET correlato per IDRisorsa = &quot; + currentAsset.IDRisorsaCorrelato);&#xD;
			var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa=:SearchIDRisorsa&quot;);&#xD;
&#xD;
			criteria.setQueryParameter(&quot;SearchIDRisorsa&quot;,currentAsset.IDRisorsaCorrelato);&#xD;
&#xD;
			var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
			//var assetCorrelato = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
			//assetCorrelato=null;&#xD;
	&#xD;
			if (list.size()>0)&#xD;
			{&#xD;
				for(var i = 0; i &lt; list.size(); i++)&#xD;
				{&#xD;
					var currAsset=list.get(i).readAsset();&#xD;
					//Controllo asset BTS IN LAVORAZIONE&#xD;
					if(currAsset.statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE&#xD;
					&amp;&amp; (String(currAsset.offerta).slice(0,6)==&quot;EASYIP&quot; || String(currAsset.offerta).slice(0,9)==&quot;BITSTREAM&quot; || String(currAsset.offerta).slice(0,4)==&quot;VULA&quot;))&#xD;
					{&#xD;
					&#xD;
						//Cerco richieste su IdRisorsaCorrelato&#xD;
						var criteriaReq = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;IDRisorsa=:SearchIDRisorsa ORDER BY created DESC&quot;);&#xD;
						criteriaReq.setQueryParameter(&quot;SearchIDRisorsa&quot;,currentAsset.IDRisorsaCorrelato);&#xD;
						var listReq = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteriaReq);&#xD;
						var foundBTS=false;&#xD;
						if (listReq.size()>0)&#xD;
						{&#xD;
							for(var j = 0; j &lt; listReq.size(); j++)&#xD;
							{&#xD;
								var currentRic = listReq.get(j).readRichiesta();&#xD;
								if (currentRic.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp;&#xD;
								currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO &amp;&amp;&#xD;
								currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATO &amp;&amp;&#xD;
								currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CHIUSO &amp;&amp;&#xD;
								currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOAFATTURAZIONE &amp;&amp;&#xD;
								currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO &amp;&amp;&#xD;
								(String(currentRic.offerta).slice(0,6)==&quot;EASYIP&quot; || String(currentRic.offerta).slice(0,9)==&quot;BITSTREAM&quot; || String(currentRic.offerta).slice(0,4)==&quot;VULA&quot;))&#xD;
								{	&#xD;
									foundBTS=true;&#xD;
								}	&#xD;
							}&#xD;
						}&#xD;
						if(!foundBTS)&#xD;
						{&#xD;
							currAsset.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
							AssetTargetRef.add(list.get(i));&#xD;
							AssetTarget.add(ScriptUtil.copy(currAsset));&#xD;
						}&#xD;
					&#xD;
					&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
	&#xD;
		}&#xD;
		&#xD;
		// RU_778 - UNLOCK/LOCK COMPONENTE&#xD;
		if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp;&#xD;
		   localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PORTIN)&#xD;
		{&#xD;
			var indexDettaglio = -1;&#xD;
			&#xD;
			for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
				{					&#xD;
					for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
					{&#xD;
						var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVODETTAGLIOASSET) // RU_778&#xD;
						{&#xD;
							indexDettaglio = ScriptUtil.createBigInteger(currentAttDettOrdine.valoreAttributo);&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if(action == &quot;LOCK&quot; &amp;&amp; indexDettaglio != -1)&#xD;
			{&#xD;
				currentAsset.dettaglioasset.get(indexDettaglio).statoDettaglioAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE;&#xD;
				Process.auditLog('Effettuato lock id componente '+indexDettaglio+' dell asset '+currentAssetTarget.IDAsset);&#xD;
			}&#xD;
			else if(indexDettaglio != -1)&#xD;
			{&#xD;
				currentAsset.dettaglioasset.get(indexDettaglio).statoDettaglioAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
				Process.auditLog('Effettuato unlock id componente '+indexDettaglio+' dell asset '+currentAssetTarget.IDAsset);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_1zpscTIzEeamluCw9N7DAQ" Width="96.0">
              <xpdl2:Coordinates XCoordinate="352.0" YCoordinate="106.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
