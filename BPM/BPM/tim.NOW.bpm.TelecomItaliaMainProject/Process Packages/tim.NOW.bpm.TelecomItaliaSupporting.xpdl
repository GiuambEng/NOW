        <xpdl2:Transition Id="_vbyuqJxDEeaMKe6gF5kaow" xpdExt:DisplayName="" Name="" From="_vvwBui5AEeaizoIY74CCpA" To="_Z8algIF0Eea1BcUITTCQOA">
          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var result = false;&#xD;
&#xD;
if (localRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.RICARICA)&#xD;
{&#xD;
	if (AssetRicarica!=null)&#xD;
	{&#xD;
		result = true;&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
else if(localRequest.codificaOLOAGCOM != &quot;TLC&quot;)&#xD;
{&#xD;
	result = true;&#xD;
}&#xD;
&#xD;
else&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!result &amp;&amp; i &lt; AssetAggiuntiviListJP.size())&#xD;
	{&#xD;
		if(AssetAggiuntiviListJP.get(i).codificaOLOAGCOM != &quot;TLC&quot;)&#xD;
		{&#xD;
			result = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	var i = 0;&#xD;
	while(!result &amp;&amp; i &lt; AssetCessatiListJP.size())&#xD;
	{&#xD;
		if(AssetCessatiListJP.get(i).codificaOLOAGCOM != &quot;TLC&quot; &#xD;
		&amp;&amp; AssetCessatiListJP.get(i).offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP)&#xD;
		{&#xD;
			result = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	var i = 0;&#xD;
	while(!result &amp;&amp; i &lt; AssetModificatiListJP.size())&#xD;
	{&#xD;
		if(AssetModificatiListJP.get(i).codificaOLOAGCOM != &quot;TLC&quot;)&#xD;
		{&#xD;
			result = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
// SM_9070 - per CESSAZIONE CPS non dobbiamo chiamare mai JPUB&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
{&#xD;
	result = false;&#xD;
}&#xD;
&#xD;
result;</xpdl2:Expression>
</xpdl2:Condition>
