        <xpdl2:Activity Id="_vtvRIIXCEe2mFek6qqf7YA" Name="CheckNotificaeRDACDel103" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Check Notifica e RDAC Del 103">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Aggiunto script con RU_1346 - DEL 103&#xD;
InvioNotificaRDAC = false;&#xD;
ScadenzaDACAggiunta = null;&#xD;
&#xD;
//SM_11047: per il confronto con la DAC andiamo a considerare i giorni lavorativi e non quelli solari (confrontiamo con OutputDate)&#xD;
&#xD;
var DACDaConsiderare = DateTimeUtil.createDate(); //SM_11034&#xD;
&#xD;
if(localRequest.ordine!= null &amp;&amp; localRequest.ordine.DACRimodulata != null)&#xD;
{&#xD;
	DACDaConsiderare = DateTimeUtil.createDate(localRequest.ordine.DACRimodulata);&#xD;
}&#xD;
else if(localRequest.DAC != null)&#xD;
{&#xD;
	DACDaConsiderare = DateTimeUtil.createDate(localRequest.DAC);&#xD;
}&#xD;
&#xD;
//CHECK sulla DACRIMODULATA o sulla DAC - fixato if con SM_10960&#xD;
if(DACDaConsiderare != null &amp;&amp; OutputDate != null &amp;&amp; DACDaConsiderare &lt; OutputDate)&#xD;
{	&#xD;
	Process.auditLog(&quot;DAC da considerare: &quot; + String(DACDaConsiderare));&#xD;
				&#xD;
	InvioNotificaRDAC = true;&#xD;
&#xD;
	//In questa casistica va anche rimodulata la DAC&#xD;
	//SM_11034: va fatta una cac diversa a seconda che siamo in caso semplice o complesso&#xD;
	if(CasoComplesso)&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key = 'DACAggiuntaNPDEL103CasoComplesso'&quot;);&#xD;
	}&#xD;
	else &#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key = 'DACAggiuntaNPDEL103CasoSemplice'&quot;);&#xD;
	}&#xD;
	&#xD;
	configurations = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(criteria);&#xD;
&#xD;
	if(configurations != null &amp;&amp; configurations.size()>0)&#xD;
	{&#xD;
		configuration = configurations.get(0).readConfiguration();&#xD;
		&#xD;
		Process.auditLog(&quot;Recuperata la configurazione ScadenzaDACAggiunta: &quot; + configuration.value);&#xD;
		&#xD;
		if(!isNaN(configuration.value))&#xD;
		{&#xD;
			ScadenzaDACAggiunta = parseInt(configuration.value, 10);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(ScadenzaDACAggiunta == null)&#xD;
	{&#xD;
		if(CasoComplesso)&#xD;
		{&#xD;
			ScadenzaDACAggiunta = 9;  //valore di default, caso Complesso (SM_11034)&#xD;
		}&#xD;
		else &#xD;
		{&#xD;
			ScadenzaDACAggiunta = 2;  //valore di default, caso Semplice (SM_11034)&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
