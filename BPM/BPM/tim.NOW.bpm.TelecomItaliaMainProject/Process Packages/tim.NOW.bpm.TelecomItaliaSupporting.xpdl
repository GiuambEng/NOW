                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="45.0" LaneId="_EITb1rQIEeegdcKeFiA4RA" Width="43.0">
              <xpdl2:Coordinates XCoordinate="739.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
