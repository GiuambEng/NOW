        <xpdl2:Activity Id="_uoNiYFKqEeedOpnTvj_ANQ" Name="EliminoAssetTLC" xpdExt:Visibility="Private" xpdExt:DisplayName="Elimino Asset TLC">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//SM_7927 EVO C10 - aggiunte logiche per non allineare consistenze EASY IP UBB per ordini di migrazione&#xD;
if(Asset != null &amp;&amp; (Asset.codificaOLOAGCOM == &quot;TLC&quot; ||&#xD;
  Asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB ||&#xD;
  Asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH ||&#xD;
  Asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH ||   //RU_1164&#xD;
  Asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIXEDWIRELESSACCESS)) //RU_716 - FWA&#xD;
{&#xD;
	Asset = null;&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; AssetAggiuntiviList.size(); i++)&#xD;
{&#xD;
	if(AssetAggiuntiviList.get(i).codificaOLOAGCOM == &quot;TLC&quot; ||&#xD;
	   AssetAggiuntiviList.get(i).offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB ||&#xD;
	   AssetAggiuntiviList.get(i).offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH ||&#xD;
	   AssetAggiuntiviList.get(i).offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH ||   //RU_1164&#xD;
	   AssetAggiuntiviList.get(i).offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIXEDWIRELESSACCESS //RU_716 - FWA&#xD;
	   )&#xD;
	{&#xD;
		AssetAggiuntiviList.remove(i);&#xD;
		i--;&#xD;
	}&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; AssetCessatiList.size(); i++)&#xD;
{&#xD;
	if(AssetCessatiList.get(i).codificaOLOAGCOM == &quot;TLC&quot; ||&#xD;
	   AssetCessatiList.get(i).offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB ||&#xD;
	   AssetCessatiList.get(i).offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH ||&#xD;
	   AssetCessatiList.get(i).offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH ||  //RU_1164&#xD;
	   AssetCessatiList.get(i).offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIXEDWIRELESSACCESS //RU_716 - FWA&#xD;
	)&#xD;
	{&#xD;
		AssetCessatiList.remove(i);&#xD;
		i--;&#xD;
	}&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; AssetModificatiList.size(); i++)&#xD;
{&#xD;
	if(AssetModificatiList.get(i).codificaOLOAGCOM == &quot;TLC&quot; ||&#xD;
	   AssetModificatiList.get(i).offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB ||&#xD;
	   AssetModificatiList.get(i).offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH ||&#xD;
	   AssetModificatiList.get(i).offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH ||  //RU_1164&#xD;
	   AssetModificatiList.get(i).offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIXEDWIRELESSACCESS //RU_716 - FWA&#xD;
	   )&#xD;
	{&#xD;
		AssetModificatiList.remove(i);&#xD;
		i--;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
