        <xpdl2:Activity Id="_3GQiEKu6Ee24mqG26Pp6Rw" Name="ArricchimentodaUnicaD103" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento da Unica D103">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">// BISOGNA TENERE ALLINEATI GLI SCRIPT PRESENTI IN:&#xD;
// TIMNOW-IrrobustimentoNPCautelare - Arricchimento da Unica D103&#xD;
// TINOW-Controlli Formali e Tecniche Attivazione NP Del 103 - Arricchimento Dettaglio Ordine&#xD;
// Sono lo STESSO script, per cui ogni modifica fatta qui, va riportata dal'altro lato (procedere tranquillamente con un copia e incolla)&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine.size() > 0)&#xD;
{&#xD;
	var tipoLineaOLO = &quot;&quot;;&#xD;
	tipoLineaOLO = null;	&#xD;
	var tipoLineaNP = &quot;&quot;;&#xD;
	tipoLineaNP = null;	&#xD;
	var FLAGNUMERAZIONIAGGIUNTIVE = &quot;&quot;;&#xD;
	FLAGNUMERAZIONIAGGIUNTIVE = null;	&#xD;
	var CODICEPIATTAFORMA = &quot;&quot;;&#xD;
	CODICEPIATTAFORMA = null;	&#xD;
	var OLORETAILER = &quot;&quot;;&#xD;
	OLORETAILER = null;	&#xD;
	var CODICEOPERATOREDONATING = &quot;&quot;;&#xD;
	CODICEOPERATOREDONATING = null;	&#xD;
	var TIPOSERVIZIO = &quot;&quot;;&#xD;
	TIPOSERVIZIO = null;	&#xD;
	var TIPONUMERO = &quot;&quot;;&#xD;
	TIPONUMERO = null;&#xD;
	var CAPOSERIE = &quot;&quot;;  //RU_1434&#xD;
	CAPOSERIE = null;&#xD;
	var RADICALE = &quot;&quot;;   //RU_1434&#xD;
	RADICALE = null;&#xD;
	&#xD;
	if(NumberPortability!=null &amp;&amp; NumberPortability.size()>0 &amp;&amp; NumberPortability.get(0).codicePiattaforma!=null)&#xD;
	{&#xD;
		CODICEPIATTAFORMA = NumberPortability.get(0).codicePiattaforma;&#xD;
	}&#xD;
	else if(InventoryResponse != null &amp;&amp; InventoryResponse.CRMWSResponse!= null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea != null)&#xD;
	{&#xD;
		CODICEPIATTAFORMA = InventoryResponse.CRMWSResponse.tipo_Linea.piattaforma;&#xD;
	}&#xD;
	&#xD;
	if(InventoryResponse != null &amp;&amp; InventoryResponse.CRMWSResponse != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea.tipo_Servizio != null)&#xD;
	{&#xD;
		TIPOSERVIZIO = InventoryResponse.CRMWSResponse.tipo_Linea.tipo_Servizio;&#xD;
	}&#xD;
	else if(NumberPortability!=null &amp;&amp; NumberPortability.size()>0 &amp;&amp; NumberPortability.get(0).tipoServizio!=null &amp;&amp; localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP)&#xD;
	{&#xD;
		TIPOSERVIZIO = NumberPortability.get(0).tipoServizio;&#xD;
	}&#xD;
	&#xD;
	if(InventoryResponse != null &amp;&amp; InventoryResponse.CRMWSResponse != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea.tipo_Numero != null)&#xD;
	{&#xD;
		TIPONUMERO = InventoryResponse.CRMWSResponse.tipo_Linea.tipo_Numero;&#xD;
	}&#xD;
	else if(NumberPortability!=null &amp;&amp; NumberPortability.size()>0 &amp;&amp; NumberPortability.get(0).tipoNumero!=null &amp;&amp; localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP)&#xD;
	{&#xD;
		TIPONUMERO = NumberPortability.get(0).tipoNumero;&#xD;
	}&#xD;
	&#xD;
	//RU_1434: modificato arricchimento di CAPOSERIE e RADICALE&#xD;
	if(InventoryResponse != null &amp;&amp; InventoryResponse.CRMWSResponse != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea.caposerie != null) &#xD;
	{&#xD;
		CAPOSERIE = InventoryResponse.CRMWSResponse.tipo_Linea.caposerie;&#xD;
	}&#xD;
	else if(NumberPortability!=null &amp;&amp; NumberPortability.size()>0 &amp;&amp; NumberPortability.get(0).caposerie!=null &amp;&amp; localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP)&#xD;
	{&#xD;
		CAPOSERIE = NumberPortability.get(0).caposerie;&#xD;
	}&#xD;
	&#xD;
	if(InventoryResponse != null &amp;&amp; InventoryResponse.CRMWSResponse != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea.radicale != null) &#xD;
	{&#xD;
		RADICALE = InventoryResponse.CRMWSResponse.tipo_Linea.radicale;&#xD;
	}&#xD;
	else if(NumberPortability!=null &amp;&amp; NumberPortability.size()>0 &amp;&amp; NumberPortability.get(0).radicale!=null &amp;&amp; localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP)&#xD;
	{&#xD;
		RADICALE = NumberPortability.get(0).radicale;&#xD;
	}&#xD;
	&#xD;
	&#xD;
	if(NumberPortability != null &amp;&amp; NumberPortability.size()>0)&#xD;
	{		&#xD;
		if(NumberPortability.get(0).OLORetailer != null)&#xD;
		{&#xD;
			OLORETAILER = NumberPortability.get(0).OLORetailer;&#xD;
			&#xD;
			if(OLORETAILER == 'WIN') &#xD;
			{&#xD;
				OLORETAILER = 'INF';&#xD;
			}&#xD;
		}&#xD;
						&#xD;
		if(NumberPortability.get(0).OLORetailer != null &#xD;
		   &amp;&amp;(String(localRequest.tipologiaScenario).slice(0,4) != &quot;NPSU&quot; &#xD;
		   || localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUTIF))&#xD;
		{			&#xD;
		&#xD;
			CODICEOPERATOREDONATING = OLORETAILER;&#xD;
		}&#xD;
		// Aggiunto con RU_889&#xD;
		else if(localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP&#xD;
		|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUULLNP&#xD;
		|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUSLUNP&#xD;
		|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUULLDNP&#xD;
		|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUWLR&#xD;
		|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUVULL &#xD;
		|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUAGGWLR)&#xD;
		{			&#xD;
			CODICEOPERATOREDONATING = NumberPortability.get(0).codiceOperatoreDonating;&#xD;
		}	&#xD;
	}&#xD;
&#xD;
	var data = DateTimeUtil.createDatetime();	&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	attributo.created = data;&#xD;
	attributo.lastUpdate = data;&#xD;
	attributo.operatore = localRequest.operatore;&#xD;
	&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		attributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
		&#xD;
		//NUMBERPORTABILITY&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			var foundDISTRETTO = false;&#xD;
			var foundNUMEROTELEFONICOPRINCIPALE = false;&#xD;
			var foundTIPOLINEANP = false;&#xD;
			var foundTIPONUMERO = false;&#xD;
			var foundTOTALEAGGIUNTIVI = false;&#xD;
			var foundTIPOSERVIZIO = false;&#xD;
			var foundRADICALE = false;&#xD;
			var foundCAPOSERIE = false;&#xD;
			var foundCODICE_RO = false;&#xD;
			var foundTOTALELINEE = false;&#xD;
			var foundCODICEOPERATOREDONATING = false;&#xD;
			var foundCODICEOPERATOREDONOR = false;&#xD;
			var foundNUMEROTELEFONICO = false;&#xD;
			var foundOLORETAILER = false;&#xD;
			var foundAGGIUNTIVOWLR = false;&#xD;
			&#xD;
			var indexDISTRETTO = -1;&#xD;
			var indexNUMEROTELEFONICOPRINCIPALE = -1;&#xD;
			var indexTIPOLINEANP = -1;&#xD;
			var indexTIPONUMERO = -1;&#xD;
			var indexTOTALEAGGIUNTIVI = -1;&#xD;
			var indexTIPOSERVIZIO = -1;&#xD;
			var indexRADICALE = -1;&#xD;
			var indexCAPOSERIE = -1;&#xD;
			var indexCODICE_RO = -1;&#xD;
			var indexTOTALELINEE = -1;&#xD;
			var indexCODICEOPERATOREDONATING = -1;&#xD;
			var indexCODICEOPERATOREDONOR = -1;&#xD;
			var indexCODICEPIATTAFORMA = -1;&#xD;
			var indexNUMEROTELEFONICO = -1;&#xD;
			var indexOLORETAILER = -1;&#xD;
			var indexAGGIUNTIVOWLR = -1;&#xD;
&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO)&#xD;
				{&#xD;
					foundDISTRETTO = true;&#xD;
					indexDISTRETTO = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE)&#xD;
				{&#xD;
					foundNUMEROTELEFONICOPRINCIPALE = true;&#xD;
					indexNUMEROTELEFONICOPRINCIPALE = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP)&#xD;
				{&#xD;
					foundTIPOLINEANP = true;&#xD;
					indexTIPOLINEANP = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO)&#xD;
				{&#xD;
					foundTIPONUMERO = true;&#xD;
					indexTIPONUMERO = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TOTALEAGGIUNTIVI)&#xD;
				{&#xD;
					foundTOTALEAGGIUNTIVI = true;&#xD;
					indexTOTALEAGGIUNTIVI = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO)&#xD;
				{&#xD;
					foundTIPOSERVIZIO = true;&#xD;
					indexTIPOSERVIZIO = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
				{&#xD;
					foundRADICALE = true;&#xD;
					indexRADICALE = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE)&#xD;
				{&#xD;
					foundCAPOSERIE = true;&#xD;
					indexCAPOSERIE = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICERO)&#xD;
				{&#xD;
					foundCODICE_RO = true;&#xD;
					indexCODICE_RO = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TOTALELINEE)&#xD;
				{&#xD;
					foundTOTALELINEE = true;&#xD;
					indexTOTALELINEE = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING)&#xD;
				{&#xD;
					foundCODICEOPERATOREDONATING = true;&#xD;
					indexCODICEOPERATOREDONATING = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR)&#xD;
				{&#xD;
					foundCODICEOPERATOREDONOR = true;&#xD;
					indexCODICEOPERATOREDONOR = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP)&#xD;
				{&#xD;
					tipoLineaOLO = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUMERAZIONIAGGIUNTIVE)&#xD;
				{&#xD;
					FLAGNUMERAZIONIAGGIUNTIVE = currentAttDettOrdine.valoreAttributo;&#xD;
				}				&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					foundNUMEROTELEFONICO = true;&#xD;
					indexNUMEROTELEFONICO = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER)&#xD;
				{&#xD;
					foundOLORETAILER = true;&#xD;
					indexOLORETAILER = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AGGIUNTIVOWLR)&#xD;
				{&#xD;
					foundAGGIUNTIVOWLR = true;&#xD;
					indexAGGIUNTIVOWLR = j;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//NUMBERPORTABILITY.DISTRETTO&#xD;
			if(InventoryResponse != null &amp;&amp; InventoryResponse.datiUnica != null &amp;&amp; InventoryResponse.datiUnica.distretto != null)&#xD;
			{&#xD;
				if(foundDISTRETTO)&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexDISTRETTO).valoreAttributo = InventoryResponse.datiUnica.distretto;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = InventoryResponse.datiUnica.distretto;					&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//NUMBERPORTABILITY.NUMEROTELEFONICOPRINCIPALE&#xD;
			if(localRequest.ordine!= null &amp;&amp; localRequest.ordine.numeroTelefonico!=null)&#xD;
			{&#xD;
				if(foundNUMEROTELEFONICOPRINCIPALE)&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexNUMEROTELEFONICOPRINCIPALE).valoreAttributo = localRequest.ordine.numeroTelefonico;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = localRequest.ordine.numeroTelefonico;					&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				localRequest.ordine.numTelPrincipale = localRequest.ordine.numeroTelefonico;&#xD;
			}&#xD;
			&#xD;
			//NUMBERPORTABILITY.TIPOLINEANP&#xD;
			if(InventoryResponse != null &amp;&amp; InventoryResponse.CRMWSResponse != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea.tipo_Numero != null)&#xD;
			{&#xD;
				//DNAGGIUNTIVI&#xD;
				var DNaggiuntivi = DataUtil.createList();&#xD;
				if(InventoryResponse != null&#xD;
					&amp;&amp; InventoryResponse.CRMWSResponse != null&#xD;
					&amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea != null&#xD;
					&amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea.aggiuntivi != null)&#xD;
				{&#xD;
					for(var z = 0; z &lt; InventoryResponse.CRMWSResponse.tipo_Linea.aggiuntivi.linee.item.size(); z++)&#xD;
					{&#xD;
						DNaggiuntivi.add(InventoryResponse.CRMWSResponse.tipo_Linea.aggiuntivi.linee.item.get(z).DN);&#xD;
					}&#xD;
				}				&#xD;
				&#xD;
				if(InventoryResponse.CRMWSResponse.tipo_Linea.tipo_Numero == &quot;GNR RADICALE&quot;&#xD;
					|| InventoryResponse.CRMWSResponse.tipo_Linea.tipo_Numero == &quot;RADICALE ACCORPATO&quot;)&#xD;
				{&#xD;
					tipoLineaNP = &quot;1&quot;;&#xD;
				}&#xD;
				else if(InventoryResponse.CRMWSResponse.tipo_Linea.tipo_Numero == &quot;GNR LINEE&quot;)&#xD;
				{&#xD;
