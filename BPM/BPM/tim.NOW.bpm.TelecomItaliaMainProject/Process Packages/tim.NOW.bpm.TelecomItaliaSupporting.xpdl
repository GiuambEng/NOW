                      <xpdExt:ScriptInformation Id="_AZXDPJloEeeOV_tcN-e0hA" Name="5">
                        <xpdExt:Expression ScriptGrammar="JavaScript"/>
                      </xpdExt:ScriptInformation>
                      <xpdl2:Actual ScriptGrammar="JavaScript">if(GiorniDaSottrarre != null)&#xD;
{&#xD;
	GiorniDaSottrarre;&#xD;
}&#xD;
else&#xD;
{&#xD;
	5;&#xD;
}</xpdl2:Actual>
                    </xpdl2:DataMapping>
