                  <xpdExt:ScriptInformation Id="_yh9xYPRTEeazKYdqUBpQKA" Name="Script1">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var causale =&quot;&quot;;&#xD;
var trovato=false;&#xD;
var i =0;&#xD;
while(!trovato &amp;&amp; i&lt;RecuperaCausaliResponse.size()){&#xD;
 if(RecuperaCausaliResponse.get(i).idAnagraficaCausale == localRequest.IDAnagraficaCausale){&#xD;
  causale = RecuperaCausaliResponse.get(i).codiceCausaleInterna;&#xD;
  trovato=true;&#xD;
 }&#xD;
 &#xD;
 i++;&#xD;
}&#xD;
&#xD;
causale;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="descrizioneInternoNEW">
                  <xpdExt:ScriptInformation Id="_3FniwPRTEeazKYdqUBpQKA" Name="Script2">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var descrizione =&quot;&quot;;&#xD;
var trovato=false;&#xD;
var i =0;&#xD;
while(!trovato &amp;&amp; i&lt;RecuperaCausaliResponse.size()){&#xD;
 if(RecuperaCausaliResponse.get(i).idAnagraficaCausale == localRequest.IDAnagraficaCausale){&#xD;
  descrizione = RecuperaCausaliResponse.get(i).descrizioneCausaleInterna;&#xD;
  trovato = true;&#xD;
 }&#xD;
 &#xD;
 i++;&#xD;
}&#xD;
&#xD;
descrizione;</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
