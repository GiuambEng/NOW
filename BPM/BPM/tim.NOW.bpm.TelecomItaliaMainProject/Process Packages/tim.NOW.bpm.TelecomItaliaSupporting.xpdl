          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">//Si legge eventuali modifiche fatte da STOP N GO e eventuale aggiornamento della DAC&#xD;
var tmp = Requestref.readRichiesta();&#xD;
&#xD;
if(tmp.ordine == null) // SM_8661: aggiunta valorizzazione ordine&#xD;
{&#xD;
	tmp.ordine = ScriptUtil.copy(localRequest.ordine);&#xD;
}&#xD;
&#xD;
localRequest = ScriptUtil.copy(tmp);&#xD;
&#xD;
//Commentato con SM_8664, ora idTplgCautelare resta sempre a Y (per gestire delle condizioni anche in uscita dai controlli), la precondizione su CTRL INVENTORY viene fatta su FlagRetryCautelare&#xD;
//localRequest.idTplgCautelare = FlagCautelare;&#xD;
//Process.auditLog(&quot;Impostato Flag Cautelare con quello che arriva da STOP N GO: &quot;+FlagCautelare);</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_KpEyAQxqEe-nJY3m0mPEHg" Name="CostruzionearrayNumerazioni" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Costruzione array Numerazioni">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)  &#xD;
		{&#xD;
			for	(var k=0; k&lt;localRequest.ordine.dettaglioordine.size();k++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(k);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					NumerazioniDaVerificare.add(attr.valoreAttributo);&#xD;
					Process.auditLog(&quot;Trovata numerazione &quot; + attr.valoreAttributo);&#xD;
				}&#xD;
			}		&#xD;
		}		&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
