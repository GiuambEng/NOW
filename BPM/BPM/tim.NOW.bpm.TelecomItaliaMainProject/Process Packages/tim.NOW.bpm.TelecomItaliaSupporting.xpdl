    <xpdl2:WorkflowProcess Id="_3nrnSi5AEeaizoIY74CCpA" xpdExt:DisplayName="TIMNOW-RecuperaOrdineTarget" Name="TIMNOWRecuperaOrdineTarget">
      <xpdl2:ProcessHeader/>
      <xpdl2:FormalParameters>
        <xpdl2:FormalParameter Id="_3nrnUC5AEeaizoIY74CCpA" Name="localRequest" Mode="INOUT" Required="true" xpdExt:DisplayName="localRequest">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_2Y1K_erUEeWg_qPSKmWaWg"/>
          </xpdl2:DataType>
        </xpdl2:FormalParameter>
        <xpdl2:FormalParameter Id="_3nrnUS5AEeaizoIY74CCpA" Name="targetRef" Mode="OUT" Required="false" xpdExt:DisplayName="targetRef">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_2Y1K_erUEeWg_qPSKmWaWg"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
        </xpdl2:FormalParameter>
        <xpdl2:FormalParameter Id="_bSlQ8LAIEeaIkOgVK6Xr4w" Name="targetRequest" Mode="OUT" Required="false" xpdExt:DisplayName="targetRequest">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_2Y1K_erUEeWg_qPSKmWaWg"/>
          </xpdl2:DataType>
        </xpdl2:FormalParameter>
      </xpdl2:FormalParameters>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_3nrnSy5AEeaizoIY74CCpA" Name="Start" xpdExt:Visibility="Private" xpdExt:DisplayName="Start">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="27.0" LaneId="_3nrnUy5AEeaizoIY74CCpA" Width="27.0">
              <xpdl2:Coordinates XCoordinate="53.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_3nrnTC5AEeaizoIY74CCpA" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_3nrnUy5AEeaizoIY74CCpA" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_3nrnTS5AEeaizoIY74CCpA" Name="RecuperaOrdineTarget" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Recupera Ordine Target">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var offerta = &quot;&quot;;&#xD;
offerta = null;&#xD;
var IDOfferta = 0;&#xD;
IDOfferta = null;&#xD;
&#xD;
//RU_1346: aggiunta logica per nuova lavorazione ESPLETAMENTODONATINGDONOR (NP DEL103)&#xD;
if(localRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.ALTRO&#xD;
   &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ESPLETAMENTODONATINGDONOR&#xD;
   &amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG)&#xD;
{&#xD;
	//Bug #46443: aggiunto numeroTelefonico nella ricerca&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;codiceOrdineOLO=:SearchCodiceOrdineOLO AND IDRichiestaOLO&lt;>:ID AND tipoRichiesta ='ORDINE' AND offerta='NP' AND numeroTelefonico=:SearchNumTel ORDER BY created DESC&quot;);//SM_11042: aggiunta condizione sull'offerta&#xD;
	criteria.setQueryParameter(&quot;SearchCodiceOrdineOLO&quot;,localRequest.codiceOrdineOLO);&#xD;
	//criteria.setQueryParameter(&quot;codificaOLOAGCOM&quot;,localRequest.codificaOLOAGCOM); eliminata con SM_10924&#xD;
	criteria.setQueryParameter(&quot;ID&quot;,localRequest.IDRichiestaOLO);&#xD;
	criteria.setQueryParameter(&quot;SearchNumTel&quot;,localRequest.numeroTelefonico);	&#xD;
	&#xD;
	var list = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
		&#xD;
	if(list != null &amp;&amp; list.size()>0 &amp;&amp; list.size() == 1)&#xD;
	{&#xD;
		targetRef = list.get(0);&#xD;
		Process.auditLog(&quot;Richiesta recuperata per: codiceOrdineOLO=&quot;+localRequest.codiceOrdineOLO+&quot; , numeroTelefonico=&quot;+localRequest.numeroTelefonico+&quot;, codificaOLOAGCOM&quot;+localRequest.codificaOLOAGCOM);&#xD;
	}&#xD;
	//Bug #46443: se vengono individuate più occorrenze, allora vanno escluse quelle in SCARTATO&#xD;
	else if(list != null &amp;&amp; list.size()>1)&#xD;
	{&#xD;
		var criteriaNoScarto = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;codiceOrdineOLO=:SearchCodiceOrdineOLO AND IDRichiestaOLO&lt;>:ID AND tipoRichiesta ='ORDINE' AND offerta='NP' AND numeroTelefonico=:SearchNumTel AND statoRichiestaNOW NOT IN ('SCARTATO') ORDER BY created DESC&quot;);&#xD;
		criteriaNoScarto.setQueryParameter(&quot;SearchCodiceOrdineOLO&quot;,localRequest.codiceOrdineOLO);&#xD;
		criteriaNoScarto.setQueryParameter(&quot;ID&quot;,localRequest.IDRichiestaOLO);&#xD;
		criteriaNoScarto.setQueryParameter(&quot;SearchNumTel&quot;,localRequest.numeroTelefonico);	&#xD;
		&#xD;
		var listNoScarto = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteriaNoScarto);&#xD;
		&#xD;
		if(listNoScarto != null &amp;&amp; listNoScarto.size()>0)&#xD;
		{&#xD;
			targetRef = listNoScarto.get(0);&#xD;
			Process.auditLog(&quot;Richiesta recuperata per: codiceOrdineOLO=&quot;+localRequest.codiceOrdineOLO+&quot; , numeroTelefonico=&quot;+localRequest.numeroTelefonico+&quot;, codificaOLOAGCOM&quot;+localRequest.codificaOLOAGCOM);&#xD;
		}&#xD;
		else &#xD;
		{&#xD;
			Process.auditLog(&quot;Nessuna o più richieste recuperate (sono tutte SCARTATE) per: codiceOrdineOLO=&quot;+localRequest.codiceOrdineOLO+&quot; , numeroTelefonico=&quot;+localRequest.numeroTelefonico+&quot;, codificaOLOAGCOM&quot;+localRequest.codificaOLOAGCOM);&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Nessuna o più richieste recuperate per: codiceOrdineOLO=&quot;+localRequest.codiceOrdineOLO+&quot; , numeroTelefonico=&quot;+localRequest.numeroTelefonico+&quot;, codificaOLOAGCOM&quot;+localRequest.codificaOLOAGCOM);&#xD;
	}&#xD;
}&#xD;
else if(localRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.ALTRO&#xD;
	&amp;&amp; (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTO&#xD;
	    ||localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTORECIPIENT)     //RU_1346: aggiunta ANNULLAMENTORECIPIENT&#xD;
	&amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG)&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;codiceOrdineOLO=:SearchCodiceOrdineOLO AND numeroTelefonico= :NumTel AND codificaOLOAGCOM= :codificaOLOAGCOM AND IDRichiestaOLO&lt;>:ID AND tipoRichiesta ='ORDINE' ORDER BY created DESC&quot;);&#xD;
	criteria.setQueryParameter(&quot;SearchCodiceOrdineOLO&quot;,localRequest.codiceOrdineOLO);&#xD;
	criteria.setQueryParameter(&quot;NumTel&quot;,localRequest.numeroTelefonico);&#xD;
	criteria.setQueryParameter(&quot;codificaOLOAGCOM&quot;,localRequest.codificaOLOAGCOM);&#xD;
	criteria.setQueryParameter(&quot;ID&quot;,localRequest.IDRichiestaOLO);&#xD;
	var list = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
	if (list.size()>0)&#xD;
	{&#xD;
		for(var i = 0; i &lt; list.size(); i++)&#xD;
		{&#xD;
			var currentRic = list.get(i).readRichiesta();&#xD;
			if(currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO ||&#xD;
			currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATOB2B ||&#xD;
			currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATO ||&#xD;
			currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATOB2B ||&#xD;
			currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CHIUSO ||&#xD;
			currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CHIUSOB2B ||&#xD;
			currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO ||&#xD;
			currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICO ||&#xD;
			currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOB2B ||&#xD;
			currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOAFATTURAZIONE ||&#xD;
			currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO)&#xD;
			{&#xD;
				if(offerta==null){&#xD;
					offerta = String(currentRic.offerta);&#xD;
					IDOfferta = currentRic.IDOfferta;&#xD;
				}&#xD;
				Process.auditLog(&quot;Rimuovo la richiesta: &quot; + currentRic.IDRichiestaOLO + &quot; perché di tipo ALTRO oppure non è in lavorazione&quot;);&#xD;
				list.remove(i);&#xD;
				i--;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(list.size() == 1)&#xD;
		{&#xD;
			targetRef = list.get(0);&#xD;
			//SM_4464&#xD;
			localRequest.codiceOrdineTITarget = targetRef.readRichiesta().codiceOrdineTI;&#xD;
			Process.auditLog(&quot;Richiesta recuperata per: codiceOrdineOLO=&quot;+localRequest.codiceOrdineOLO+&quot; , numeroTelefonico=&quot;+localRequest.numeroTelefonico+&quot;, codificaOLOAGCOM&quot;+localRequest.codificaOLOAGCOM);&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Nessuna o più richieste recuperate per: codiceOrdineOLO=&quot;+localRequest.codiceOrdineOLO+&quot; , numeroTelefonico=&quot;+localRequest.numeroTelefonico+&quot;, codificaOLOAGCOM&quot;+localRequest.codificaOLOAGCOM);&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Nessuna richiesta recuperata per: codiceOrdineOLO=&quot;+localRequest.codiceOrdineOLO+&quot; , numeroTelefonico=&quot;+localRequest.numeroTelefonico+&quot;, codificaOLOAGCOM&quot;+localRequest.codificaOLOAGCOM);&#xD;
	}&#xD;
	&#xD;
}&#xD;
else if(localRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.ALTRO&#xD;
	&amp;&amp; (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VALIDFORMALEDONATINGDONOR&#xD;
		|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VALIDTECNICADONATINGDONOR))&#xD;
{&#xD;
	//ESITOCODICESEGRETO e TLC (Per implementare la logica con CODICE OP RECIPIENT = “KEA” )&#xD;
	//SM_10852: escludere da questa logica le NP DEL103&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VALIDTECNICADONATINGDONOR&#xD;
		&amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
		&amp;&amp; localRequest.flagDelibera103 != &quot;Y&quot;)//SM_10852&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;codiceOrdineTI=:SearchCodiceOrdineOLO AND IDRichiestaOLO&lt;>:ID AND tipoRichiesta = 'ORDINE' ORDER BY created DESC&quot;);&#xD;
		&#xD;
		//var SubCodiceOrdineOLO = String(localRequest.codiceOrdineOLO).substring(4,localRequest.codiceOrdineOLO.length); //Task #32233&#xD;
		//Process.auditLog(&quot;SubCodiceOrdineOLO: &quot;+SubCodiceOrdineOLO);&#xD;
		&#xD;
		//criteria.setQueryParameter(&quot;SubCodiceOrdineOLO&quot;, SubCodiceOrdineOLO);&#xD;
		criteria.setQueryParameter(&quot;SearchCodiceOrdineOLO&quot;,'????' + localRequest.codiceOrdineOLO); //Pre-Task #32233&#xD;
		criteria.setQueryParameter(&quot;ID&quot;,localRequest.IDRichiestaOLO);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;codiceOrdineOLO=:SearchCodiceOrdineOLO AND numeroTelefonico= :NumTel AND codificaOLOAGCOMDonating= :codificaOLOAGCOMDon AND IDRichiestaOLO&lt;>:ID AND tipoRichiesta ='ORDINE' ORDER BY created DESC&quot;);&#xD;
		criteria.setQueryParameter(&quot;SearchCodiceOrdineOLO&quot;,localRequest.codiceOrdineOLO);&#xD;
		criteria.setQueryParameter(&quot;NumTel&quot;,localRequest.numeroTelefonico);              &#xD;
		// Modificata da localRequest.codificaOLOAGCOM a localRequest.codificaOLOAGCOMDonating per la SM_3676&#xD;
		criteria.setQueryParameter(&quot;codificaOLOAGCOMDon&quot;,localRequest.codificaOLOAGCOMDonating);&#xD;
		criteria.setQueryParameter(&quot;ID&quot;,localRequest.IDRichiestaOLO);&#xD;
		&#xD;
		//SM_8720 - nuovo tentativo con OLORETAILER se non trovo niente con quella codificaOLOAGCOMDonating&#xD;
		var OLORETAILER = &quot;&quot;;&#xD;
		OLORETAILER = null;		&#xD;
		var idRichiestaOLOCAC = &quot;&quot;;&#xD;
		idRichiestaOLOCAC = null;&#xD;
		&#xD;
		var listAppoggio = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
		&#xD;
		if (listAppoggio.size() == 0)&#xD;
		{&#xD;
			Process.auditLog(&quot;Nessuna richiesta recuperata per: codiceOrdineOLO=&quot;+localRequest.codiceOrdineOLO+&quot; , numeroTelefonico=&quot;+localRequest.numeroTelefonico+&quot;, codificaOLOAGCOMDonating&quot;+localRequest.codificaOLOAGCOM);&#xD;
			Process.auditLog(&quot;Nuovo tentativo con OLORETAILER&quot;);&#xD;
			&#xD;
			var criteria2 = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;codiceOrdineOLO=:SearchCodiceOrdineOLO AND numeroTelefonico= :NumTel AND IDRichiestaOLO&lt;>:ID AND tipoRichiesta ='ORDINE' ORDER BY created DESC&quot;);&#xD;
			criteria2.setQueryParameter(&quot;SearchCodiceOrdineOLO&quot;,localRequest.codiceOrdineOLO);&#xD;
			criteria2.setQueryParameter(&quot;NumTel&quot;,localRequest.numeroTelefonico);&#xD;
		    criteria2.setQueryParameter(&quot;ID&quot;,localRequest.IDRichiestaOLO);&#xD;
			&#xD;
			var listAppoggio2 = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria2);&#xD;
			&#xD;
			if(listAppoggio2.size() > 0)&#xD;
			{&#xD;
				for(var h=0; h&lt;listAppoggio2.size(); h++)&#xD;
				{&#xD;
					var RicAppoggio = listAppoggio2.get(h).readRichiesta();&#xD;
					&#xD;
					var z1 = 0;&#xD;
					var z2 = 0;&#xD;
