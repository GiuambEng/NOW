              <xpdl2:Coordinates XCoordinate="3017.0" YCoordinate="317.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier=&quot;/tim.NOW.bpm.invokeExternalService/Process Packages/tim.NOW.bpm.invokeExternalService.OLO.xpdl.TINOWNotificaOLO&quot;;&#xD;
&#xD;
localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaPrecedOLO;&#xD;
&#xD;
localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO;&#xD;
localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SCARTATO;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">// SM_8223&#xD;
StrippedRequest.IDNotificaDonating = localRequest.IDNotificaDonating;&#xD;
StrippedRequest.IDNotificaDonor = localRequest.IDNotificaDonor;&#xD;
StrippedRequest.IDNotifica = localRequest.IDNotifica;&#xD;
&#xD;
if(localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PRENOTIFICADONATING)&#xD;
{&#xD;
	localRequest.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DONOROLO;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
