        <xpdl2:Activity Id="_Tz9jAJDoEe2rdM1EkN85fQ" Name="CalcRDACasDACworkingday" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Calc RDAC as DAC + working day">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_76gV0IufEea6Hs4N8ixhVg" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="GiorniLavorativi">
                  <xpdExt:ScriptInformation Id="_Tz9jAZDoEe2rdM1EkN85fQ" Name="giorniLavorativi"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">ScadenzaDACAggiunta;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="ManagedDate">
                  <xpdExt:ScriptInformation Id="_Tz9jApDoEe2rdM1EkN85fQ" Name="DAC">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var RDACdate = DateTimeUtil.createDate();&#xD;
RDACdate = null;&#xD;
&#xD;
if(localRequest.ordine!= null &amp;&amp; localRequest.ordine.DACRimodulata!= null)&#xD;
{&#xD;
	RDACdate = localRequest.ordine.DACRimodulata;&#xD;
}&#xD;
else if(localRequest.ordine!=null)&#xD;
{&#xD;
	RDACdate = localRequest.ordine.DAC;&#xD;
}&#xD;
&#xD;
RDACdate;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="ManagedDate">
                  <xpdl2:Actual ScriptGrammar="JavaScript">DACRimodulata</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="85.0" LaneId="_K5JE1oElEemXD5TuR_N3Pg" Width="127.0">
              <xpdl2:Coordinates XCoordinate="1594.0" YCoordinate="718.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier =&quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.calcNextDateByDuration&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_1P5HQJDoEe2rdM1EkN85fQ" Name="UpdateDACRimodulata" FinishMode="Automatic" IsATransaction="false" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Update DAC Rimodulata" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;Richiesta&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">Requestref</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">Requestref</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="87.0" LaneId="_K5JE1oElEemXD5TuR_N3Pg" Width="110.0">
              <xpdl2:Coordinates XCoordinate="1727.0" YCoordinate="718.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">localRequest.ordine.DACRimodulata = DACRimodulata;&#xD;
Process.auditLog(&quot;DACRimodulata: &quot;+String(localRequest.ordine.DACRimodulata));</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_1P5HQZDoEe2rdM1EkN85fQ" Name="Tracciamento4" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Tracciamento">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_3MBOcO08EeaHW9ek9Jg1tw" PackageRef="tim.NOW.bpm.CasedataTracking.Interfaces" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="TipoOP">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;INSERT&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="IDTracciamento">
                  <xpdl2:Actual ScriptGrammar="JavaScript">IDTracciamento</xpdl2:Actual>
                </xpdl2:DataMapping>
