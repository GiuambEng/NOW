{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;ordine.codiceOrdineOLO=:codiceOrdineOLO AND numeroTelefonico=:DN AND IDRichiestaOLO&lt;>:ID AND tipoRichiesta ='ORDINE' ORDER BY created DESC&quot;);&#xD;
