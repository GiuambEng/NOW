              </xpdl2:TriggerTimer>
            </xpdl2:IntermediateEvent>
          </xpdl2:Event>
          <xpdl2:Deadline>
            <xpdl2:DeadlineDuration ScriptGrammar="JavaScript">var currentTime = DateTimeUtil.createTime();&#xD;
var currentDate = DateTimeUtil.createDate();&#xD;
&#xD;
if(currentTime > timeFineAcquisizionePacchetti)&#xD;
{&#xD;
	currentDate.add(DateTimeUtil.createDuration(true,0,0,1,0,0,0));&#xD;
}&#xD;
&#xD;
DateTimeUtil.createDatetime(currentDate,timeFineAcquisizionePacchetti);</xpdl2:DeadlineDuration>
          </xpdl2:Deadline>
