                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if(localRequest.tipoPacchetto == &quot;0&quot;)&#xD;
{&#xD;
	&quot;KO&quot;;&#xD;
}&#xD;
else if(localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.CESSAZIONE)&#xD;
{&#xD;
	&quot;TC12&quot;;&#xD;
}&#xD;
else if(localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PRENOTIFICADONATING)&#xD;
{&#xD;
	&quot;TC5&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;TC2&quot;;&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaOLODestinatario">
                  <xpdExt:ScriptInformation Id="_h8yDgFKoEeedOpnTvj_ANQ" Name="Destinatario">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if(localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PRENOTIFICADONATING)&#xD;
{&#xD;
	&quot;DONOR&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;RECIPIENT&quot;;&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
