            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="99.0" LaneId="_KN5Q8RoAEeezYc92PqP0CQ" Width="156.0">
              <xpdl2:Coordinates XCoordinate="2349.0" YCoordinate="154.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.GestionePacchetti.xpdl.AggiornaPacchetto&quot;;&#xD;
&#xD;
//RU_1346 (DEL 103) - non esiste più lo stato SCIOLTO, ma solo SCARTATO/ACQUISITO&#xD;
if(localRequest.flagDelibera103 == &quot;Y&quot;)&#xD;
{&#xD;
	if(ControlloFallito != null)&#xD;
	{&#xD;
		StatoPacchetto = &quot;SCARTATO&quot;;&#xD;
		localRequest.IDAnagraficaCausale = ControlloFallito.id_Causale;&#xD;
	}&#xD;
	else &#xD;
	{&#xD;
		StatoPacchetto = &quot;ACQUISITO&quot;;&#xD;
	}&#xD;
}&#xD;
else //solito - PRE DEL 103&#xD;
{&#xD;
	if(localRequest.tipoPacchetto == &quot;2&quot;)&#xD;
	{&#xD;
		StatoPacchetto = &quot;SCIOLTO&quot;;&#xD;
	}&#xD;
	else if(ControlloFallito != null)&#xD;
	{&#xD;
		if(ControlloFallito.codice_Controllo == &quot;CTRL VER APPARTENEN&quot; || ControlloFallito.codice_Controllo == &quot;CTRL OLO CODING PACCHETTO&quot;)&#xD;
		{&#xD;
			StatoPacchetto = &quot;SCIOLTO&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			StatoPacchetto = &quot;SCARTATO&quot;;&#xD;
			localRequest.IDAnagraficaCausale = ControlloFallito.id_Causale;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		StatoPacchetto = &quot;ACQUISITO&quot;;&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
