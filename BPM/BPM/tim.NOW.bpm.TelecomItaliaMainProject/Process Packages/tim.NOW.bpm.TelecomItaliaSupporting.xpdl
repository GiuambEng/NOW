        <xpdl2:Activity Id="_DeEtkANEEeevKdjqJ57WWg" Name="CaseUpdateRequestOrderStatusInputDiscard1" FinishMode="Automatic" IsATransaction="false" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Case Update Request / Order Status Input Discard 1">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">Requestref</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;Richiesta&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">Requestref</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="108.0" LaneId="_qoQDoh6uEeaVsuX5wln4CQ" Width="125.0">
              <xpdl2:Coordinates XCoordinate="2764.0" YCoordinate="917.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">//Updating the statorichestaNOW&#xD;
localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
&#xD;
Outcome = &quot;TIMED_OUT&quot;;&#xD;
&#xD;
//Update statoRichiestaOLO&#xD;
if(nextState!= null &amp;&amp; nextState!= &quot;&quot;)&#xD;
{&#xD;
	localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.get(nextState);&#xD;
	&#xD;
	//SM_11682 - MIG DEL82&#xD;
	if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACQUISITOKOD82){&#xD;
		localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ACQUISITOKO;&#xD;
	}&#xD;
	else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACCETTATOKOD82){&#xD;
		localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ACCETTATOKO;&#xD;
	}&#xD;
	else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETATOKOD82){&#xD;
		localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ESPLETATOKO;&#xD;
	}&#xD;
	//solito&#xD;
	else if(localRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOAPPUNTAMENTO&#xD;
	   &amp;&amp; localRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOOPERESPECIALI&#xD;
	   &amp;&amp; localRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESACONFERMAANNULLAMENTO)&#xD;
	{&#xD;
		localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.get(String(nextState));&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SOSPESO;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	localRequest.statoRichiestaNOW=it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO;&#xD;
	localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ESPLETAMENTOTECNICOKO;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
