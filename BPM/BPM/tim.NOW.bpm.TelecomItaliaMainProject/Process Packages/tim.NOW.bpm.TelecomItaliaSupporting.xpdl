            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">if(localRequest.ordine != null &amp;&amp; localRequest.tipoPacchetto != &quot;2&quot;)&#xD;
{&#xD;
	localRequest.ordine.codicePacchettoNOW = null;&#xD;
}&#xD;
&#xD;
