        <xpdl2:Activity Id="_nes18MLgEeeJksGmE3TdfQ" Name="RecuperoCFPIVAdaAsset" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupero CF PIVA da Asset">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var idasset = &quot;&quot;;&#xD;
idasset = null;&#xD;
&#xD;
var i = 0;&#xD;
while(idasset == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	var j = 0;&#xD;
	while(idasset == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
	{&#xD;
		var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
		&#xD;
		if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
		{&#xD;
			idasset = currentAttDettOrdine.valoreAttributo;&#xD;
		}&#xD;
		j++;&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(idasset != null)&#xD;
{&#xD;
	Process.auditLog(&quot;Si procede con l'arricchimento della PIVA o CF con l'IDAsset: &quot; + idasset);&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(idasset));&#xD;
	&#xD;
	Asset = AssetRef.readAsset();&#xD;
	&#xD;
	if(Asset.cliente != null)&#xD;
	{&#xD;
		if(Asset.cliente.codiceFiscale != null &amp;&amp; Asset.cliente.codiceFiscale != &quot;&quot;)&#xD;
		{&#xD;
			localRequest.ordine.CF = Asset.cliente.codiceFiscale;&#xD;
			Process.auditLog(&quot;Arricchito il CF: &quot; + Asset.cliente.codiceFiscale);&#xD;
		}&#xD;
		else if(Asset.cliente.partitaIVA != null &amp;&amp; Asset.cliente.partitaIVA != &quot;&quot;)&#xD;
		{&#xD;
			localRequest.ordine.PIVA = Asset.cliente.partitaIVA;&#xD;
			Process.auditLog(&quot;Arricchita la PIVA: &quot; + Asset.cliente.partitaIVA);&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Nessun IdentificativoAsset recuperato, arricchimento di PIVA o CF non possibile&quot;);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="96.0" LaneId="_EITb1rQIEeegdcKeFiA4RA" Width="138.0">
              <xpdl2:Coordinates XCoordinate="314.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
