        <xpdl2:Activity Id="_kwbkYOKfEeiWR5Xvc1p8Cw" Name="NotificadiCessazioneWLRVULLperNP" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Notifica di Cessazione WLR/VULL per NP">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_v3JtkIFrEeaG-Y7D3-yA8Q" PackageRef="tim.NOW.bpm.invokeExternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="TipologiaNotifica">
                  <xpdExt:ScriptInformation Id="_kwcLcOKfEeiWR5Xvc1p8Cw" Name="Tipo">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">	if (offertaAccesso.slice(0,3) == 'WLR') &#xD;
	{&#xD;
		'O5';&#xD;
	} else &#xD;
		{&#xD;
		'O6';&#xD;
		}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaOLODestinatario">
                  <xpdExt:ScriptInformation Id="_kwcLceKfEeiWR5Xvc1p8Cw" Name="target"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;DONATING&quot;;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="CodificaOLOAGCOM">
                  <xpdl2:Actual ScriptGrammar="JavaScript">codiceOperatoreDonating</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="IDAssetConsistenza">
                  <xpdl2:Actual ScriptGrammar="JavaScript">identificativoAsset</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="123.0" LaneId="_SJJWZZbREea-SOYGV3MLbg" Width="128.0">
              <xpdl2:Coordinates XCoordinate="702.0" YCoordinate="581.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeExternalService/Process Packages/tim.NOW.bpm.invokeExternalService.OLO.xpdl.TINOWNotificaOLO&quot;;&#xD;
&#xD;
localRequest.ordine.DES = dataEspletamentoDONOR;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_SI0eIOKhEeiWR5Xvc1p8Cw" Name="VerificaConsWLRVULLDaCessare" xpdExt:Visibility="Private" xpdExt:DisplayName="VerificaConsWLRVULLDaCessare">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var trovataConsistenza = false;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	&#xD;
	while (trovataConsistenza == false &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if (currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA  &#xD;
		&amp;&amp; currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		{&#xD;
			var j = 0;&#xD;
			&#xD;
			while (j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttrDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if (currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
				{&#xD;
					offertaAccesso = currentAttrDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if (currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING)&#xD;
				{&#xD;
					codiceOperatoreDonating = currentAttrDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if (currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					identificativoAsset = currentAttrDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				&#xD;
			j++;				&#xD;
			}&#xD;
			&#xD;
			trovataConsistenza = true;&#xD;
		}&#xD;
	i++; 	&#xD;
	}&#xD;
	&#xD;
	//SM_10976: AGGIUNTA TUTTA LA PARTE DI CESSAZIONE DELL'ASSET CORRISPONDENTE ALLA CONSISTENZAFONIA WLR/VULL SOLO PER LA DEL 103&#xD;
	if(localRequest.flagDelibera103 == &quot;Y&quot; &#xD;
	   &amp;&amp; (identificativoAsset != null &amp;&amp; identificativoAsset != &quot;&quot;)&#xD;
	   &amp;&amp; (offertaAccesso != null &amp;&amp; offertaAccesso != &quot;&quot;)&#xD;
	   &amp;&amp; (offertaAccesso.slice(0,3) == 'WLR' || offertaAccesso.slice(0,4) == 'VULL'))&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset=:idassetConsistenza&quot;);&#xD;
		criteria.setQueryParameter(&quot;idassetConsistenza&quot;,identificativoAsset);&#xD;
		var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
		&#xD;
		if(list != null)&#xD;
		{&#xD;
			AssetRef = list.get(0);&#xD;
			Asset = AssetRef.readAsset();&#xD;
			&#xD;
			if(Asset != null)&#xD;
			{&#xD;
				var date = DateTimeUtil.createDatetime();&#xD;
				&#xD;
				Asset.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
				Asset.DES = localRequest.ordine.DES;&#xD;
				Asset.ORA_DES = localRequest.ordine.ORA_DES;&#xD;
				Asset.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				Asset.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
				Asset.codiceOrdineTI = localRequest.codiceOrdineTI;&#xD;
				Asset.lastUpdate = date;&#xD;
				&#xD;
				for(var j=0; j&lt;Asset.dettaglioasset.size(); j++)&#xD;
				{&#xD;
					Asset.dettaglioasset.get(j).statoDettaglioAsset = Asset.statoAsset;&#xD;
					Asset.dettaglioasset.get(j).lastUpdate = date;&#xD;
				}&#xD;
			&#xD;
				Asset.lastUpdate = date;&#xD;
				&#xD;
				//Aggiungo l'asset in AssetCessatiList da inviare a JPUB&#xD;
				Process.auditLog(&quot;Cessato l'asset con IDASSET: &quot; +identificativoAsset);&#xD;
				AssetCessatiList.add(ScriptUtil.copy(Asset));&#xD;
			} 			&#xD;
		}&#xD;
		else &#xD;
		{&#xD;
			Process.auditLog(&quot;Nessun asset trovato con IDASSET: &quot; + identificativoAsset);&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;OFFERTA: &quot;+offertaAccesso+ &quot;, CodificaOLODonating &quot;+codiceOperatoreDonating+ &quot;, ID Asset &quot;+identificativoAsset);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_SJJWZZbREea-SOYGV3MLbg" Width="96.0">
              <xpdl2:Coordinates XCoordinate="582.0" YCoordinate="354.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
