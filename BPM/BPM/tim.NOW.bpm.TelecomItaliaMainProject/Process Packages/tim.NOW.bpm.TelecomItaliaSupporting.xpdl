        <xpdl2:Activity Id="_LiUzsEMeEei-QJMtaSYnsg" Name="AggiornaAssetRicaricaTarget" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna Asset Ricarica Target">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;AssetRicarica&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="SkipStorico">
                  <xpdExt:ScriptInformation Id="_LiUzsUMeEei-QJMtaSYnsg" Name="true">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">true;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localAssetRicarica">
                  <xpdl2:Actual ScriptGrammar="JavaScript">listAssetRicarica</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="assetRicaricaRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ListAssetRicaricaRef</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="80.0" LaneId="_1zpscTIzEeamluCw9N7DAQ" Width="128.0">
              <xpdl2:Coordinates XCoordinate="541.0" YCoordinate="721.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit/>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_3ymOkEO-EeikB5gD0W8I9g" Name="CalcAssetRicarica" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Calc Asset Ricarica">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//recupero IDASSETRICARICA&#xD;
&#xD;
var IDAssetRicarica = &quot;&quot;;&#xD;
IDAssetRicarica = null;&#xD;
var i=0; &#xD;
	while (IDAssetRicarica== null &amp;&amp; i&lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if (currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DATIRICARICA)&#xD;
		{&#xD;
			var j=0;&#xD;
			while (IDAssetRicarica== null &amp;&amp; j&lt; currentComponente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
&#xD;
				if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSETRICARICA)&#xD;
				{&#xD;
					IDAssetRicarica = currentAttributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Recuperato idassetRicarica per unlock&quot;+IDAssetRicarica);&#xD;
				}&#xD;
				&#xD;
			j++;&#xD;
			}&#xD;
		}&#xD;
	i++;&#xD;
	}&#xD;
&#xD;
if (IDAssetRicarica != null)&#xD;
{&#xD;
var AssetRicaricaRef = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.findByIDAssetRicarica(ScriptUtil.createBigInteger(IDAssetRicarica));&#xD;
&#xD;
	if (AssetRicaricaRef!= null)&#xD;
	{&#xD;
	&#xD;
		var AssetRicarica = it_telecomitalia_it_NOW_casedata_Factory.createAssetRicarica();&#xD;
		AssetRicarica = AssetRicaricaRef.readAssetRicarica();&#xD;
		&#xD;
		&#xD;
		if(action == &quot;UNLOCK&quot; &amp;&amp; localRequest.lavorazione==it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.SPEGNIMENTO)&#xD;
		{&#xD;
			AssetRicarica.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ACCESA;&#xD;
			Process.auditLog(&quot;Richiesta di spegnimento Scartata - Riportata in ACCESA la ricarica con ID &quot;+ IDAssetRicarica);&#xD;
		}&#xD;
		&#xD;
		else if (action == &quot;UNLOCK&quot; &#xD;
		&amp;&amp; localRequest.lavorazione==it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ACCENSIONE &#xD;
		&amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL)&#xD;
		{&#xD;
			AssetRicarica.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.SCARTATA;&#xD;
			Process.auditLog(&quot;Richiesta di accensione in espletamentoKO - SCARTATA la ricarica con ID &quot;+ IDAssetRicarica);&#xD;
		}&#xD;
		&#xD;
		ListAssetRicaricaRef.add(AssetRicaricaRef);&#xD;
		listAssetRicarica.add(AssetRicarica);&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
	&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
