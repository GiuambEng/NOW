        <xpdl2:Activity Id="_sDgzZwxoEe-nJY3m0mPEHg" Name="ArricchimentodaUnica" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento da Unica">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//SCRIPT COSTRUITO A PARTIRE DA QUELLO PRESENTE IN TINOW-Controlli Formali Attivazione NP Del 82&#xD;
&#xD;
Process.auditLog(&quot;Inizio Arricchimento Ordine&quot;); &#xD;
&#xD;
if(localRequest!= null &amp;&amp; localRequest.ordine!=null)&#xD;
{	&#xD;
	//Recupero AssetTarget&#xD;
	for(var i=0; i&lt;NumberPortability.size(); i++)&#xD;
	{&#xD;
		Process.auditLog(&quot;Cerco ASSET per IDASSET = &quot; + NumberPortability.get(i).IDAsset);&#xD;
		&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset =: idAsset&quot;);&#xD;
		criteria.setQueryParameter(&quot;idAsset&quot;,String(NumberPortability.get(i).IDAsset));&#xD;
		var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
		&#xD;
		var currentAsset = list.get(0).readAsset();		&#xD;
		AssetTarget.add(ScriptUtil.copy(currentAsset));&#xD;
		AssetTargetRef.add(list.get(0));&#xD;
	}&#xD;
&#xD;
	//Arricchimento di NUMBERPORTABILITY con azione ad A&#xD;
	for(var i2=0; i2&lt;localRequest.ordine.dettaglioordine.size(); i2++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i2);&#xD;
		&#xD;
		Process.auditLog(&quot;Arricchimento Componente &quot;+componente.IDDettaglioOrdine); //Debug&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			var NumeroTelefonicoOrdine = &quot;&quot;;&#xD;
			var NumeroTelefonicoAsset = &quot;&quot;;&#xD;
			var TIPOLINEANP = &quot;&quot;;&#xD;
			var TIPOSERVIZIO = &quot;&quot;;&#xD;
			var RADICALE = &quot;&quot;;&#xD;
			var CAPOSERIE = &quot;&quot;;&#xD;
			var CODICERO = &quot;&quot;;&#xD;
			var CODICEOPERATOREDONATING = &quot;&quot;;&#xD;
			var IDASSET = &quot;&quot;;&#xD;
			var DISTRETTO = &quot;&quot;;&#xD;
			var TIPONUMERO = &quot;&quot;;   &#xD;
			&#xD;
			NumeroTelefonicoOrdine = null;&#xD;
			NumeroTelefonicoAsset = null;&#xD;
			TIPOLINEANP = null;&#xD;
			TIPOSERVIZIO = null;&#xD;
			RADICALE = null;&#xD;
			CAPOSERIE = null;&#xD;
			CODICERO = null;&#xD;
			CODICEOPERATOREDONATING = null;&#xD;
			IDASSET = null;&#xD;
			DISTRETTO = null;&#xD;
			TIPONUMERO = null;    &#xD;
			&#xD;
			var foundTIPOLINEANP = false;&#xD;
			var foundTIPONUMERO = false;&#xD;
			var foundTIPOSERVIZIO = false;&#xD;
			var foundRADICALE = false;&#xD;
			var foundCAPOSERIE = false;&#xD;
			var foundCODICERO = false;&#xD;
			var foundCODICEOPERATOREDONATING = false;&#xD;
			&#xD;
			&#xD;
			//RECUPERO NUMEROTELEFONICO DELLA NUMBERPORTABILITY DALL'ORDINE&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					NumeroTelefonicoOrdine = attributo.valoreAttributo; &#xD;
					Process.auditLog(&quot;NP dell'ordine in arricchimento: &quot;+NumeroTelefonicoOrdine); &#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//Recupero il valore di TIPONUMERO da ARRAYINVENTORYOUTPUT, in particolare da DATIUNICA&#xD;
			if(ArrayInventoryOutput != null &amp;&amp; ArrayInventoryOutput.size() > 0)&#xD;
			{&#xD;
				for (var m=0; m&lt;ArrayInventoryOutput.size(); m++)&#xD;
				{&#xD;
					var currentInventoryOutput = ArrayInventoryOutput.get(m);&#xD;
					&#xD;
					if(currentInventoryOutput.datiUnica != null &amp;&amp; currentInventoryOutput.datiUnica.tipoNumero != null&#xD;
					   &amp;&amp; currentInventoryOutput.numero_Telefonico != null &amp;&amp; NumeroTelefonicoOrdine == currentInventoryOutput.numero_Telefonico)&#xD;
					{&#xD;
						TIPONUMERO = currentInventoryOutput.datiUnica.tipoNumero;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
						&#xD;
			//RECUPERO I VALORI DA CONSISTENZA/ASSET PER ARRICCHIMENTO &#xD;
			if(AssetTarget != null &amp;&amp; AssetTarget.size() > 0)&#xD;
			{&#xD;
				for(var j2=0; j2&lt;AssetTarget.size(); j2++)&#xD;
				{&#xD;
					var currentAsset = AssetTarget.get(j2);&#xD;
					Process.auditLog(&quot;Asset Target su cui si sta ciclando: &quot;+AssetTarget.get(j2).IDAsset); //Debug&#xD;
					&#xD;
					if(NumeroTelefonicoOrdine == currentAsset.numeroTelefonico)&#xD;
					{&#xD;
						Process.auditLog(&quot;Trovato Asset con Numero Telefonico: &quot;+NumeroTelefonicoOrdine); //Debug&#xD;
						&#xD;
						CODICEOPERATOREDONATING = currentAsset.codificaOLOAGCOM;  //SM_9419&#xD;
						&#xD;
						for(var k=0; k&lt;currentAsset.dettaglioasset.size(); k++)&#xD;
						{&#xD;
							var componenteAsset = currentAsset.dettaglioasset.get(k);&#xD;
							&#xD;
							if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
							{&#xD;
								for(var h=0; h&lt;componenteAsset.attributidettaglioasset.size(); h++)&#xD;
								{&#xD;
									var attributoAsset = componenteAsset.attributidettaglioasset.get(h);&#xD;
									&#xD;
									if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP)&#xD;
									{&#xD;
										TIPOLINEANP = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO)&#xD;
									{&#xD;
										TIPOSERVIZIO = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
									{&#xD;
										RADICALE = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE)&#xD;
									{&#xD;
										CAPOSERIE = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICERO)&#xD;
									{&#xD;
										CODICERO = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO)&#xD;
									{&#xD;
										DISTRETTO = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
								}	&#xD;
							}&#xD;
						}					&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//Arricchimento di NUMBERPORTABILITY con azione ad A&#xD;
				for(var j3=0; j3&lt;componente.attributiDettaglioOrdine.size(); j3++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j3);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP&#xD;
					   &amp;&amp; TIPOLINEANP != null)&#xD;
					{	&#xD;
						attributo.valoreAttributo = TIPOLINEANP;&#xD;
						foundTIPOLINEANP = true;&#xD;
						&#xD;
						Process.auditLog(&quot;Trovato TIPOLINEANP nell'ordine&quot; + attributo.valoreAttributo);&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO)&#xD;
					{	&#xD;
						attributo.valoreAttributo = TIPONUMERO;&#xD;
						foundTIPONUMERO = true;&#xD;
						&#xD;
						Process.auditLog(&quot;Trovato TIPONUMERO nell'ordine&quot; + attributo.valoreAttributo);&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO&#xD;
						   &amp;&amp; TIPOSERVIZIO != null)&#xD;
					{&#xD;
						attributo.valoreAttributo = TIPOSERVIZIO;&#xD;
						foundTIPOSERVIZIO = true;&#xD;
						&#xD;
						Process.auditLog(&quot;Trovato TIPOSERVIZIO nell'ordine&quot; + attributo.valoreAttributo);&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE&#xD;
						   &amp;&amp; RADICALE != null)&#xD;
					{	&#xD;
						attributo.valoreAttributo = RADICALE;&#xD;
						foundRADICALE = true;&#xD;
						&#xD;
						Process.auditLog(&quot;Trovato RADICALE nell'ordine&quot; + attributo.valoreAttributo);&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE&#xD;
						   &amp;&amp; CAPOSERIE != null)&#xD;
					{&#xD;
						attributo.valoreAttributo = CAPOSERIE;&#xD;
						foundCAPOSERIE = true;&#xD;
						&#xD;
						Process.auditLog(&quot;Trovato CAPOSERIE nell'ordine&quot; + attributo.valoreAttributo);&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICERO&#xD;
						   &amp;&amp; CODICERO != null)&#xD;
					{&#xD;
						attributo.valoreAttributo = CODICERO;&#xD;
						foundCODICERO = true;&#xD;
						&#xD;
						Process.auditLog(&quot;Trovato CODICERO nell'ordine&quot; + attributo.valoreAttributo);&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING&#xD;
						   &amp;&amp; CODICEOPERATOREDONATING != null)&#xD;
					{&#xD;
						attributo.valoreAttributo = CODICEOPERATOREDONATING;&#xD;
						foundCODICEOPERATOREDONATING = true;&#xD;
						&#xD;
						Process.auditLog(&quot;Trovato CODICEOPERATOREDONATING nell'ordine&quot; + attributo.valoreAttributo);&#xD;
					}&#xD;
				}&#xD;
&#xD;
				if(!foundTIPOLINEANP &amp;&amp; TIPOLINEANP != null)&#xD;
				{&#xD;
					var ora = DateTimeUtil.createDatetime();&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
					attributo.created = ora;&#xD;
					attributo.lastUpdate =ora;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP;&#xD;
					attributo.operatore = componente.operatore;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = TIPOLINEANP;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Aggiunto TIPOLINEANP nell'ordine&quot; + attributo.valoreAttributo);&#xD;
				}&#xD;
				&#xD;
				if(!foundTIPONUMERO &amp;&amp; TIPONUMERO != null)&#xD;
				{&#xD;
					var ora = DateTimeUtil.createDatetime();&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
					attributo.created = ora;&#xD;
					attributo.lastUpdate =ora;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO;&#xD;
					attributo.operatore = componente.operatore;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = TIPONUMERO;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
