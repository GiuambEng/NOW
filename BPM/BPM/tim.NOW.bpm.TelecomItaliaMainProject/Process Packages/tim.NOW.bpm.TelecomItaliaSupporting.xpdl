          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Per retrocompatibilitá delle pratiche in volo&#xD;
if(flagOrdineCreato == null)&#xD;
{&#xD;
	flagOrdineCreato = false;&#xD;
}&#xD;
&#xD;
//Per retrocompatibilitá delle pratiche in volo&#xD;
if(doUnlock == null)&#xD;
{&#xD;
	doUnlock = true;&#xD;
}&#xD;
&#xD;
if(FlagDeleteDatiVerificaCtrl == null)&#xD;
{&#xD;
	FlagDeleteDatiVerificaCtrl = true;&#xD;
}&#xD;
&#xD;
&#xD;
//read Counter from GCD &quot;processGv Dynamic&quot;&#xD;
&#xD;
var CounterRef = cac_it_telecomitalia_it_NOW_casedata_Process_GV_Static.findById(&quot;Gestione Esiti&quot;);&#xD;
&#xD;
if (CounterRef != null)&#xD;
{&#xD;
CheckCounter=CounterRef.readProcess_GV_Static().counter;&#xD;
 &#xD;
} else {&#xD;
CheckCounter = 3;&#xD;
Log.write(&quot;WARN: Configurazione max RETRY [Gestione Esiti] Gestione esiti non configurato, uso il default a 3.&quot;);&#xD;
}&#xD;
&#xD;
//Set IDAnagraficaCausale&#xD;
if(ControlloFallito.cod_Causale != &quot;ESITI_MULTIPLI&quot;)&#xD;
{&#xD;
	localRequest.IDAnagraficaCausale = ControlloFallito.id_Causale;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
