                  <xpdExt:ScriptInformation Id="_S4RI4CWtEeefmvnVbB4IVA" Name="FINE ACQUISIZIONE PACCHETTI">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">//RU_1346 (DEL 103)&#xD;
if(localRequest.flagDelibera103 == &quot;Y&quot;)&#xD;
{&#xD;
	&quot;FINE_ACQUISIZIONE_PACCHETTI_NP_DEL103&quot;;&#xD;
}&#xD;
else  //PRE - RU_1346 (DEL 103)&#xD;
{&#xD;
	if(localRequest.tipoPacchetto == &quot;0&quot;)&#xD;
	{&#xD;
		&quot;FINE_ACQUISIZIONE_PACCHETTI&quot;;&#xD;
	}&#xD;
	else if(localRequest.tipoPacchetto == &quot;1&quot;)&#xD;
	{&#xD;
		&quot;FINE_ACQUISIZIONE_PACCHETTI_NP&quot;;&#xD;
	}&#xD;
	else if(localRequest.tipoPacchetto == &quot;2&quot;)&#xD;
	{&#xD;
		&quot;FINE_ACQUISIZIONE_PACCHETTI_LNA&quot;;&#xD;
	}&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="ValoreStringa">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ValoreStringa</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
