        <xpdl2:Activity Id="_Pt1RuJSREeehvM70ybNicA" Name="EndEvent" xpdExt:DisplayName="End Event">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_Pt1RtpSREeehvM70ybNicA" Width="30.0">
              <xpdl2:Coordinates XCoordinate="592.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_QvBB4ZSREeehvM70ybNicA" Name="CalcolaIDRISORSAUSERVLANIDRISORSAVC" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola IDRISORSAUSERVLAN/IDRISORSAVC">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var nomeComponente = &quot;&quot;;&#xD;
var nomeAttributo = &quot;&quot;;&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
		||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
		||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
		||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
		||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
		||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
		||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
		)&#xD;
	{&#xD;
		nomeComponente = &quot;ATMVC&quot;;&#xD;
		nomeAttributo = &quot;IDRISORSAVC&quot;;&#xD;
	}&#xD;
	else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL)&#xD;
			/*&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
			&amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE*/)&#xD;
	{&#xD;
		nomeComponente = &quot;ATMVC&quot;;&#xD;
		nomeAttributo = &quot;IDRISORSAVC&quot;;&#xD;
	}&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT)&#xD;
	{&#xD;
		nomeComponente = &quot;GBEVC&quot;;&#xD;
		nomeAttributo = &quot;IDRISORSAVC&quot;;&#xD;
	}&#xD;
	else if(localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
			&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH              //RU_1164&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS              //RU_1543&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA))&#xD;
	{&#xD;
		nomeComponente = &quot;USERVLAN&quot;;&#xD;
		nomeAttributo = &quot;IDRISORSAUSERVLAN&quot;;&#xD;
	}&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT&#xD;
			&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
			&amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE&#xD;
			&amp;&amp; localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
	{&#xD;
		nomeComponente = &quot;USERVLAN&quot;;&#xD;
		nomeAttributo = &quot;IDRISORSAUSERVLAN&quot;;&#xD;
	}&#xD;
	&#xD;
	//RU_1450 &#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
			&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM)&#xD;
	{&#xD;
		nomeComponente = &quot;USERVLAN&quot;;&#xD;
		nomeAttributo = &quot;IDRISORSAUSERVLAN&quot;;&#xD;
	}&#xD;
	&#xD;
	//RIENTRI DEL82&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
			&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM &amp;&amp; localRequest.flagRientriDel82 == &quot;SI&quot;)&#xD;
	{&#xD;
		nomeComponente = &quot;USERVLAN&quot;;&#xD;
		nomeAttributo = &quot;IDRISORSAUSERVLAN&quot;;&#xD;
	}&#xD;
&#xD;
&#xD;
	if(nomeComponente != &quot;&quot; &amp;&amp; nomeAttributo != &quot;&quot; &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
	{&#xD;
		var CurrentDate = DateTimeUtil.createDatetime();&#xD;
		var conta = 1;&#xD;
		for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.get(nomeComponente))&#xD;
			{	&#xD;
				var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				nuovoAttributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				nuovoAttributo.created = CurrentDate;&#xD;
				nuovoAttributo.lastUpdate = CurrentDate;&#xD;
				nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(nomeAttributo);&#xD;
				nuovoAttributo.operatore = &quot;BPM&quot;;&#xD;
				nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				var Attributo = &quot;&quot;;&#xD;
				if(conta >= 1 &amp;&amp; conta &lt; 10)&#xD;
				{&#xD;
					Attributo = &quot;000&quot; + conta;&#xD;
				}&#xD;
				else if(conta >= 10 &amp;&amp; conta &lt; 100)&#xD;
				{&#xD;
					Attributo = &quot;00&quot; + conta;&#xD;
				}&#xD;
				else if(conta >= 100 &amp;&amp; conta &lt; 1000)&#xD;
				{&#xD;
					Attributo = &quot;0&quot; + conta;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					Attributo = conta;&#xD;
				}&#xD;
				&#xD;
				&#xD;
				// SM_9100&#xD;
				var foundIDRisorsa = false;   //SM_9689: cambiato nome da foundIDRisorsaVC a foundIDRisorsa&#xD;
				&#xD;
				if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
				{	&#xD;
					for(var z=0; z&lt;componente.attributiDettaglioOrdine.size(); z++)&#xD;
					{&#xD;
						var attributoComp = componente.attributiDettaglioOrdine.get(z);&#xD;
						&#xD;
						if(attributoComp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAVC&#xD;
						   ||attributoComp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAUSERVLAN)   //SM_9689: aggiunto OR per IDRISORSAUSERVLAN&#xD;
						{&#xD;
							if(localRequest.codiceRisorsaDonating != localRequest.IDRisorsa) //SM_9707 e //RU_1108 - se IDRISORSA è stato RIGENERATO dal TOOL...&#xD;
							{&#xD;
								attributoComp.valoreAttributo = localRequest.IDRisorsa+&quot;/&quot;+Attributo;&#xD;
							}&#xD;
							else&#xD;
							{&#xD;
								Process.auditLog(&quot;Offerta: &quot;+localRequest.offerta+&quot;, non eseguita la sostituzione&quot;);&#xD;
							}&#xD;
							&#xD;
							foundIDRisorsa = true;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
	&#xD;
				if(!foundIDRisorsa)&#xD;
				{&#xD;
					nuovoAttributo.valoreAttributo = localRequest.IDRisorsa+&quot;/&quot;+Attributo;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
				}&#xD;
				&#xD;
				conta++;&#xD;
			}&#xD;
		}		&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="91.0" LaneId="_Pt1RtpSREeehvM70ybNicA" Width="166.0">
              <xpdl2:Coordinates XCoordinate="327.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
