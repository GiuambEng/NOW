          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_pPxrRHH9EeetBZdKlhIs_w" Width="30.0">
              <xpdl2:Coordinates XCoordinate="592.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_rT1NsHH9EeetBZdKlhIs_w" Name="AdeguamentoIDdettaglioordine" xpdExt:Visibility="Private" xpdExt:DisplayName="Adeguamento ID dettaglio ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	var indiceComponente = 2;&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;&#xD;
		    ||(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY &#xD;
			   &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP)&#xD;
			|| String(componente.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;)     //Task #33783&#xD;
		{&#xD;
			componente.IDDettaglioOrdine = 1;&#xD;
			componente.IDDettaglioOrdineParent = null;&#xD;
			componente.IDDettaglioOrdineRoot = null;&#xD;
		}&#xD;
		else{&#xD;
			componente.IDDettaglioOrdine = indiceComponente;&#xD;
			componente.IDDettaglioOrdineParent = 1;&#xD;
			componente.IDDettaglioOrdineRoot = 1;&#xD;
			&#xD;
			indiceComponente++;&#xD;
		}&#xD;
		&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++){&#xD;
			componente.attributiDettaglioOrdine.get(j).IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else{&#xD;
	Process.auditLog(&quot;Richiesta/Ordine non presente&quot;);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="78.0" LaneId="_pPxrRHH9EeetBZdKlhIs_w" Width="182.0">
              <xpdl2:Coordinates XCoordinate="321.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
