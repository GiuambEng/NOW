              <xpdExt:Information ScriptGrammar="JavaScript">//Update Stati: Verifiche In Rete se non è stato scartato da nessun controllo in RisoluzioneAlineamentoConsistenza&#xD;
&#xD;
if(!EsitoFase2Allineamento) // Scarto Fase 2&#xD;
{&#xD;
	//Update statorichestaPrecedNOW con LAVORAZIONEHD&#xD;
	localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
	localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
&#xD;
 	localRequest.statoRichiestaNOW=it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO;&#xD;
 	localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ESPLETAMENTOTECNICOKO;&#xD;
 	action = &quot;DISCARD&quot;;&#xD;
}&#xD;
else if(!EsitoControlliAllineamento) // Scarto Servizio in consistenza o matrice di compatibilità&#xD;
{&#xD;
	//localRequest.statoRichiestaNOW=it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO;&#xD;
 	//localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SCARTATO;&#xD;
 	action = &quot;DISCARD&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	//Update statorichestaPrecedNOW con LAVORAZIONEHD&#xD;
	localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
	localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
&#xD;
	localRequest.statoRichiestaNOW=it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.VERIFICHEINRETE;&#xD;
	localRequest.statoRichiestaOLO=it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ACQUISITO;&#xD;
	action = &quot;RETRY&quot;;&#xD;
	Outcome = &quot;GESTIONE_IMPROPRIA&quot;; // SM_8420 aggiunta valorizzazione per permettere la riemissione DTU all'uscita da GestioneNotifiche DTU&#xD;
	&#xD;
	//localRequest.progressivoEmissioneDTU++; &#xD;
	// SM_8658 aggiunta valorizzazione per aumentare il profressivo per la riemissione DTU&#xD;
	var progressivo = localRequest.progressivoEmissioneDTU;&#xD;
	localRequest.progressivoEmissioneDTU = progressivo + 1;&#xD;
	Process.auditLog(&quot;Vecchio progressivo: &quot;+progressivo+&quot;. Nuovo progressivo: &quot;+localRequest.progressivoEmissioneDTU);&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_7kdFcYt6EemovdbS2yAJxA" Name="NotificationsManagementKO" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Notifications Management KO">
