        <xpdl2:Activity Id="_wou-FDZuEeeQZ4Wh7VBqAQ" Name="AggiornaAssetTarget2" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna Asset Target">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;Asset&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="SkipStorico">
                  <xpdExt:ScriptInformation Id="_wou-FTZuEeeQZ4Wh7VBqAQ" Name="true">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">true;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localAsset">
                  <xpdl2:Actual ScriptGrammar="JavaScript">Asset2</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="assetRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">AssetRef2</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="80.0" LaneId="_1zpscTIzEeamluCw9N7DAQ" Width="128.0">
              <xpdl2:Coordinates XCoordinate="608.0" YCoordinate="604.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">Asset2 = AssetRef.readAsset();&#xD;
&#xD;
if(action == &quot;LOCK&quot;)&#xD;
{&#xD;
	Asset2.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE;&#xD;
}&#xD;
else&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;IDRisorsa=:SearchIDRisorsa ORDER BY created DESC&quot;);&#xD;
	criteria.setQueryParameter(&quot;SearchIDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
	var list = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
	if (list.size()>0)&#xD;
	{&#xD;
		var foundNP=false;&#xD;
		for(var i = 0; i &lt; list.size(); i++)&#xD;
		{&#xD;
			var currentRic = list.get(i).readRichiesta();&#xD;
			if (currentRic.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG &amp;&amp;&#xD;
			currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO &amp;&amp;&#xD;
			currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATO &amp;&amp;&#xD;
			currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CHIUSO &amp;&amp;&#xD;
			currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOAFATTURAZIONE &amp;&amp;&#xD;
			currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO)&#xD;
			{	&#xD;
				foundNP=true;&#xD;
			}&#xD;
		}&#xD;
		if(!foundNP)&#xD;
		{&#xD;
			Asset2.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
	Asset2.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_sa6uYEYHEeevbJfmizMVGw" Name="AggiornaAssetTarget3" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna Asset Target">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;Asset&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="SkipStorico">
                  <xpdExt:ScriptInformation Id="_sa6uYUYHEeevbJfmizMVGw" Name="true">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">true;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="assetRef">
                  <xpdExt:ScriptInformation Id="_MzvP0EYIEeevbJfmizMVGw" Name="assetRef">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">AssetTargetRef.get(Process.getActivityLoopIndex());</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localAsset">
                  <xpdExt:ScriptInformation Id="_OiFA8EYIEeevbJfmizMVGw" Name="asset">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">AssetTarget.get(Process.getActivityLoopIndex());</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:Loop LoopType="MultiInstance">
            <xpdl2:LoopMultiInstance MI_FlowCondition="All" MI_Ordering="Sequential">
              <xpdl2:MI_Condition ScriptGrammar="JavaScript">AssetTargetRef.size();</xpdl2:MI_Condition>
              <xpdExt:MultiInstanceScripts/>
            </xpdl2:LoopMultiInstance>
          </xpdl2:Loop>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="80.0" LaneId="_1zpscTIzEeamluCw9N7DAQ" Width="128.0">
              <xpdl2:Coordinates XCoordinate="608.0" YCoordinate="106.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit/>
          <xpdExt:ScriptInformation Id="_qSTNEAUaEeiAYb1fU6F5VQ" Direction="OUT">
