              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">/*if(localRequest.IDRisorsa != null)&#xD;
{&#xD;
	if(action == &quot;LOCK&quot;)&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa=:SearchIDRisorsa AND statoAsset='ATTIVO'&quot;);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa=:SearchIDRisorsa AND statoAsset='INLAVORAZIONE'&quot;);&#xD;
	}&#xD;
	&#xD;
	criteria.setQueryParameter(&quot;SearchIDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
&#xD;
	var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
&#xD;
	if (list.size()>0)&#xD;
	{&#xD;
		Ref=list.get(0);&#xD;
	} &#xD;
}&#xD;
&#xD;
Log.write(&quot;Recupero Asset target, esito per richiesta:&quot;+localRequest.IDRichiestaOLO+&quot; -> &quot;+Ref);&#xD;
*/&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &amp;&amp;&#xD;
	((localRequest.codiceRisorsaDonating != null &amp;&amp; localRequest.codiceRisorsaDonating!=&quot;&quot;) ||&#xD;
		(localRequest.codiceRisorsaDonating2 != null &amp;&amp; localRequest.codiceRisorsaDonating2!=&quot;&quot;)))&#xD;
{&#xD;
	&#xD;
	//IDRisorsa = CodiceRisorsaDonating&#xD;
	if(localRequest.codiceRisorsaDonating != null &amp;&amp; localRequest.codiceRisorsaDonating != &quot;&quot;)&#xD;
	{&#xD;
		Process.auditLog(&quot;Cerco ASSET per IDRisorsa = &quot; + localRequest.codiceRisorsaDonating);&#xD;
		var criteria= cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr&quot;);&#xD;
		criteria.setQueryParameter(&quot;idr&quot;,&quot;*&quot;+localRequest.codiceRisorsaDonating+&quot;*&quot;);&#xD;
		var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
	}&#xD;
	&#xD;
	//NumeroFittizio = CodiceRisorsaDonating&#xD;
	if(list == null &amp;&amp; localRequest.codiceRisorsaDonating != null &amp;&amp; localRequest.codiceRisorsaDonating != &quot;&quot;)&#xD;
	{&#xD;
		Process.auditLog(&quot;Cerco ASSET per numeroFittizio = &quot; + localRequest.codiceRisorsaDonating);&#xD;
		var criteria= cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroFittizio =: NF&quot;);&#xD;
		criteria.setQueryParameter(&quot;NF&quot;,&quot;*&quot;+localRequest.codiceRisorsaDonating+&quot;*&quot;);&#xD;
		var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
	}&#xD;
	//NumeroTelefonico = CodiceRisorsaDonating&#xD;
	if(list == null &amp;&amp; localRequest.codiceRisorsaDonating != null &amp;&amp; localRequest.codiceRisorsaDonating != &quot;&quot;)&#xD;
	{&#xD;
		Process.auditLog(&quot;Cerco ASSET per numeroTelefonico = &quot; + localRequest.codiceRisorsaDonating);&#xD;
		var criteria= cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico =: NT&quot;);&#xD;
		criteria.setQueryParameter(&quot;NT&quot;,&quot;*&quot;+localRequest.codiceRisorsaDonating+&quot;*&quot;);&#xD;
		var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
	}&#xD;
	//IDRisorsa = CodiceRisorsaDonating2&#xD;
	if(list == null &amp;&amp; localRequest.codiceRisorsaDonating2 != null &amp;&amp; localRequest.codiceRisorsaDonating2 != &quot;&quot;)&#xD;
	{&#xD;
		Process.auditLog(&quot;Cerco ASSET per IDRisorsa = &quot; + localRequest.codiceRisorsaDonating2);&#xD;
		var criteria= cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr2&quot;);&#xD;
		criteria.setQueryParameter(&quot;idr2&quot;,&quot;*&quot;+localRequest.codiceRisorsaDonating2+&quot;*&quot;);&#xD;
		var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
	}&#xD;
	//NumeroFittizio = CodiceRisorsaDonating2&#xD;
		if(list == null &amp;&amp; localRequest.codiceRisorsaDonating2 != null &amp;&amp; localRequest.codiceRisorsaDonating2 != &quot;&quot;)&#xD;
	{&#xD;
		Process.auditLog(&quot;Cerco ASSET per numeroFittizio = &quot; + localRequest.codiceRisorsaDonating2);&#xD;
		var criteria= cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroFittizio =: NF2&quot;);&#xD;
		criteria.setQueryParameter(&quot;NF2&quot;,&quot;*&quot;+localRequest.codiceRisorsaDonating2+&quot;*&quot;);&#xD;
		var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
	}&#xD;
	//NumeroTelefonico = CodiceRisorsaDonating2&#xD;
	if(list == null &amp;&amp; localRequest.codiceRisorsaDonating2 != null &amp;&amp; localRequest.codiceRisorsaDonating2 != &quot;&quot;)&#xD;
	{&#xD;
		Process.auditLog(&quot;Cerco ASSET per numeroTelefonico = &quot; + localRequest.codiceRisorsaDonating2);&#xD;
		var criteria= cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico =: NT2&quot;);&#xD;
		criteria.setQueryParameter(&quot;NT2&quot;,&quot;*&quot;+localRequest.codiceRisorsaDonating2+&quot;*&quot;);&#xD;
		var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
	}&#xD;
	&#xD;
	if (list != null &amp;&amp; list.size()>0)&#xD;
	{&#xD;
		for(var i = 0; i &lt; list.size(); i++)&#xD;
		{&#xD;
			if(action == &quot;LOCK&quot;)&#xD;
			{&#xD;
				if(list.get(i).readAsset().statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO)&#xD;
				{&#xD;
					Ref=list.get(i);&#xD;
				}&#xD;
			}&#xD;
			else if(action == &quot;UNLOCK&quot;)&#xD;
			{&#xD;
				if(list.get(i).readAsset().statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE)&#xD;
				{&#xD;
					Ref=list.get(i);&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				Ref=list.get(0);&#xD;
			}&#xD;
		}&#xD;
	} &#xD;
}&#xD;
&#xD;
else if(localRequest.IDRisorsa != null &amp;&amp; localRequest.IDRisorsa != &quot;&quot;)&#xD;
{&#xD;
	Process.auditLog(&quot;Cerco ASSET per IDRisorsa = &quot; + localRequest.IDRisorsa);&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa=:SearchIDRisorsa&quot;);&#xD;
&#xD;
	criteria.setQueryParameter(&quot;SearchIDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
&#xD;
	var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
&#xD;
	if (list.size()>0)&#xD;
	{&#xD;
		for(var i = 0; i &lt; list.size(); i++)&#xD;
		{&#xD;
			if(action == &quot;LOCK&quot;)&#xD;
			{&#xD;
				if(list.get(i).readAsset().statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO)&#xD;
				{&#xD;
					Ref=list.get(i);&#xD;
				}&#xD;
			}&#xD;
			else if(action == &quot;UNLOCK&quot;)&#xD;
			{&#xD;
				if(list.get(i).readAsset().statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE)&#xD;
				{&#xD;
					Ref=list.get(i);&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				Ref=list.get(0);&#xD;
			}&#xD;
		}&#xD;
	} &#xD;
}&#xD;
&#xD;
&#xD;
Process.auditLog(&quot;Recupero Asset target, esito per richiesta:&quot;+localRequest.IDRichiestaOLO+&quot; -> &quot;+Ref);&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
