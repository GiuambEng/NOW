                  <xpdExt:ScriptInformation Id="_dQNA1DNeEei2e9dyLHNFPw" Name="KO"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if (localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
	{&#xD;
	  &quot;KC&quot;;&#xD;
	}else&#xD;
	{&#xD;
	  &quot;KO&quot;;	&#xD;
	}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
