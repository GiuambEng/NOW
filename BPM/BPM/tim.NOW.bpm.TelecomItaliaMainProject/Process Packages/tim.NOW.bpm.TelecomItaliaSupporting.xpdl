        <xpdl2:Transition Id="_sDgzmwxoEe-nJY3m0mPEHg" xpdExt:DisplayName="Back to Lavorazione Manuale/Cautelare" Name="BacktoLavorazioneManualeCautelare" From="_sDgzZgxoEe-nJY3m0mPEHg" To="_sDgzaAxoEe-nJY3m0mPEHg">
          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">//RU_1463&#xD;
var Scarto = false;&#xD;
&#xD;
for(var i=0; i&lt;ArrayEsitoInventory.size(); i++)&#xD;
{&#xD;
	var ElementEsito = ArrayEsitoInventory.get(i);&#xD;
	&#xD;
	if(!ElementEsito.codice) //Se uno è false allora andiamo in retry&#xD;
	{&#xD;
		Scarto = true;&#xD;
	}&#xD;
}&#xD;
&#xD;
Scarto;</xpdl2:Expression></xpdl2:Condition>
