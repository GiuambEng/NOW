            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_EITb1rQIEeegdcKeFiA4RA" Width="128.0">
              <xpdl2:Coordinates XCoordinate="1405.0" YCoordinate="397.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier=&quot;/tim.NOW.bpm.invokeExternalService/Process Packages/tim.NOW.bpm.invokeExternalService.OLO.xpdl.TINOWNotificaOLO&quot;;&#xD;
&#xD;
//Updating the statorichestaNOW with SCARTATO&#xD;
localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
&#xD;
&#xD;
//SCARTO CON LA CAUSALE DI INVENTORY = COD_CAUSALE_INTERNO = 525 REGOLATORIO COD_CAUSALE_INTERNO C13 XDSL/NGA&#xD;
if (localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
	{&#xD;
		localRequest.IDAnagraficaCausale = 379;&#xD;
	}else&#xD;
	{&#xD;
		localRequest.IDAnagraficaCausale = 323;&#xD;
	} &#xD;
	&#xD;
localRequest.statoRichiestaNOW=it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO;&#xD;
localRequest.statoRichiestaOLO=it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SCARTATO;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">StrippedRequest = ScriptUtil.copy(localRequest);&#xD;
StrippedRequest.ordine = null;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
      </xpdl2:Activities>
