            <xpdl2:ExtendedAttribute Name="bpmJspTask" Value="form://timNOWbpmTelecomItaliaSupporting/TINOWGestioneEsitiControlli/GestioneCausaleERRATA/GestioneCausaleERRATA.form"/>
          </xpdl2:ExtendedAttributes>
