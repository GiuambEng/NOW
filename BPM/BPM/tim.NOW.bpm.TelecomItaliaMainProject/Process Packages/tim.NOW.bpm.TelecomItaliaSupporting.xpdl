            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">timeFineAcquisizionePacchetti = DateTimeUtil.createTime(ValoreStringa + &quot;:00&quot;);</xpdExt:Information>
            </xpdExt:AuditEvent>
