					while(OLORETAILER == null &amp;&amp; z1 &lt; RicAppoggio.ordine.dettaglioordine.size())&#xD;
					{&#xD;
						var dettaglio = RicAppoggio.ordine.dettaglioordine.get(z1);&#xD;
					&#xD;
						while(OLORETAILER == null &amp;&amp; z2 &lt; dettaglio.attributiDettaglioOrdine.size())&#xD;
						{&#xD;
							var attributo = dettaglio.attributiDettaglioOrdine.get(z2);&#xD;
