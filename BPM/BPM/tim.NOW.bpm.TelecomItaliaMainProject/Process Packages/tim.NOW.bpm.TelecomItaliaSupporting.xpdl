        <xpdl2:Activity Id="_MZaWYLQIEeegdcKeFiA4RA" Name="VerificaNecessitadiRecuperoNumberPortability" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Necessita di Recupero NumberPortability">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var foundTipoNumero = false;&#xD;
var founfTipoServizio = false;&#xD;
var operatoreDonorTLC = false;&#xD;
var numtel = &quot;&quot;;&#xD;
var valoreTipoNumero = &quot;&quot;;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
                var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
                &#xD;
                if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
                {&#xD;
                               foundTipoNumero = false;&#xD;
                               founfTipoServizio = false;&#xD;
                               operatoreDonorTLC = false;&#xD;
                               numtel = null;&#xD;
							   valoreTipoNumero=&quot;&quot;;&#xD;
                               &#xD;
                               for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
                               {&#xD;
                                               var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
                                               &#xD;
                                               if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO)&#xD;
                                               {&#xD;
                                                               foundTipoNumero = true;&#xD;
															   valoreTipoNumero = currentAttDettOrdine.valoreAttributo;&#xD;
                                               }&#xD;
                                               else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO)&#xD;
                                               {&#xD;
                                                               founfTipoServizio = true;&#xD;
                                               }&#xD;
                                               else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
                                               {&#xD;
                                                               numtel = currentAttDettOrdine.valoreAttributo;&#xD;
                                               }&#xD;
                                               else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR&#xD;
                                                                              &amp;&amp; currentAttDettOrdine.valoreAttributo == &quot;TLC&quot;)&#xD;
                                               {&#xD;
                                                               operatoreDonorTLC = true;&#xD;
                                               }&#xD;
                               }&#xD;
                               &#xD;
                               if(operatoreDonorTLC  &#xD;
                               &amp;&amp; localRequest.tipologiaScenario!= it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP &#xD;
                               &amp;&amp; localRequest.tipologiaScenario!= it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUULLNP &#xD;
                               &amp;&amp; localRequest.tipologiaScenario!= it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUULLDNP&#xD;
                               &amp;&amp; localRequest.tipologiaScenario!= it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUSLUNP&#xD;
							   &amp;&amp; localRequest.tipologiaScenario!= it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNPDEL82     //SM_9384&#xD;
							   &amp;&amp; localRequest.tipologiaScenario!= it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPDEL82       //SM_11361&#xD;
                               &amp;&amp; (!foundTipoNumero || (!founfTipoServizio &amp;&amp; (localRequest.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274 ||&#xD;
                               localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE) &amp;&amp; valoreTipoNumero.toUpperCase()!=&quot;FOIP&quot;)))&#xD;
                               {&#xD;
                                               IDNumberPortabilityArricchimento.add(currentDettOrdine.IDDettaglioOrdine);&#xD;
                                               NumerTelefonico.add(numtel);&#xD;
                               }&#xD;
                }&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="94.0" LaneId="_EITb1rQIEeegdcKeFiA4RA" Width="147.0">
              <xpdl2:Coordinates XCoordinate="554.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_NgrgcLQIEeegdcKeFiA4RA" Name="RecuperaTipoNumeroTipoServizio" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupera TipoNumero TipoServizio">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_D253sLPlEeegdcKeFiA4RA" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="IDRichiestaOLO">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="NumeroTelefonico">
                  <xpdl2:Actual ScriptGrammar="JavaScript">NumerTelefonico</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="TipoNumero">
                  <xpdl2:Actual ScriptGrammar="JavaScript">TipoNumero</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="TipoServizio">
                  <xpdl2:Actual ScriptGrammar="JavaScript">TipoServizio</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="flagOscurato">
                  <xpdl2:Actual ScriptGrammar="JavaScript">flagOscurato</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="RecuperaTipoNumeroResponse">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RecuperaTipoNumeroResponse</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="100.0" LaneId="_EITb1rQIEeegdcKeFiA4RA" Width="128.0">
              <xpdl2:Coordinates XCoordinate="895.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.RecuperaTipoNumeroTipoServizio&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(!flagOscurato)&#xD;
{&#xD;
	var date = DateTimeUtil.createDatetime();&#xD;
	&#xD;
	var att = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	att.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	att.created = date;&#xD;
	att.lastUpdate = date;&#xD;
	att.operatore = &quot;BPM&quot;;&#xD;
	att.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
	&#xD;
	for(var i = 0; i &lt; IDNumberPortabilityArricchimento.size(); i++)&#xD;
	{&#xD;
		var updated = false;&#xD;
		var j = 0;&#xD;
		var foundTipoNumero = false;&#xD;
		var foundTipoServizio = false;&#xD;
		&#xD;
		while(!updated &amp;&amp; j &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(j);&#xD;
			&#xD;
			if(currentDettOrdine.IDDettaglioOrdine == IDNumberPortabilityArricchimento.get(i))&#xD;
			{&#xD;
				for(var z = 0; z  &lt; currentDettOrdine.attributiDettaglioOrdine.size(); z++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO)&#xD;
					{&#xD;
						//NULL é un placeholder che mette BW quando UNICAC non ritorna il campo&#xD;
						if(TipoNumero.get(i) != &quot;NULL&quot;)&#xD;
						{&#xD;
							currentAttDettOrdine.valoreAttributo = TipoNumero.get(i);&#xD;
							currentAttDettOrdine.lastUpdate = date;&#xD;
							foundTipoNumero = true;&#xD;
						}&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO)&#xD;
					{&#xD;
						//NULL é un placeholder che mette BW quando UNICAC non ritorna il campo&#xD;
						if(TipoServizio.get(i) != &quot;NULL&quot;)&#xD;
						{&#xD;
							currentAttDettOrdine.valoreAttributo = TipoServizio.get(i);&#xD;
							currentAttDettOrdine.lastUpdate = date;&#xD;
							foundTipoServizio = true;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				if(!foundTipoNumero &amp;&amp; TipoNumero.get(i) != &quot;NULL&quot;)&#xD;
				{&#xD;
					att.IDDettaglioOrdine = IDNumberPortabilityArricchimento.get(i);&#xD;
					att.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO;&#xD;
					att.valoreAttributo = TipoNumero.get(i);&#xD;
					&#xD;
					currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(att));&#xD;
				}&#xD;
				&#xD;
				if(!foundTipoServizio &amp;&amp; TipoServizio.get(i) != &quot;NULL&quot;)&#xD;
				{&#xD;
					att.IDDettaglioOrdine = IDNumberPortabilityArricchimento.get(i);&#xD;
					att.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO;&#xD;
					att.valoreAttributo = TipoServizio.get(i);&#xD;
					&#xD;
					currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(att));&#xD;
				}&#xD;
				&#xD;
				updated = true;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_O5AlULQIEeegdcKeFiA4RA">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
