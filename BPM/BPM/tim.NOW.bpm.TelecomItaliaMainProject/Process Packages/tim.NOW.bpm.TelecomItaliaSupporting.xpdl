              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">requestRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByIDRichiestaOLO(localRequest.IDRichiestaOLO);&#xD;
&#xD;
//Workarund per non sbiancare la rimodulazione DAC automatica&#xD;
var externalRequest = requestRef.readRichiesta();&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; externalRequest.ordine != null)&#xD;
{&#xD;
	localRequest.ordine.DACRimodulata = externalRequest.ordine.DACRimodulata;&#xD;
		&#xD;
		&#xD;
	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
