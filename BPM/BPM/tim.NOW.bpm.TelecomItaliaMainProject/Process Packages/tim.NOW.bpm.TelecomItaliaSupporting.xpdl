        <xpdl2:Activity Id="_SJQNUpDrEe2rdM1EkN85fQ" Name="ThrowGlobalAnnulamento_Desospensione_Rimodulazione" xpdExt:Visibility="Private" xpdExt:DisplayName="Throw Global: Annulamento_Desospensione_Rimodulazione">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Trigger="Signal">
              <xpdl2:TriggerResultSignal xpdExt:SignalType="Global" CatchThrow="THROW" Name="tim.now.bpm.signals/timNOWbpmsignals.gsd#Annulamento_Desospensione_Rimodulazione">
                <xpdExt:SignalData>
                  <xpdExt:CorrelationMappings>
                    <xpdExt:DataMapping Direction="IN" Formal="Correlation_IDRichiestaOLO">
                      <xpdExt:ScriptInformation Id="_ncycYJDrEe2rdM1EkN85fQ" Name="IDRichiestaOLO"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO;</xpdl2:Actual>
                    </xpdExt:DataMapping>
                  </xpdExt:CorrelationMappings>
                  <xpdExt:DataMappings>
                    <xpdExt:DataMapping Direction="IN" Formal="Lavorazione">
                      <xpdExt:ScriptInformation Id="_u7wvYJDrEe2rdM1EkN85fQ" Name="RIMUOVIRDACAUTOMATICA"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">&quot;RIMUOVIRDACAUTOMATICA&quot;;</xpdl2:Actual>
                    </xpdExt:DataMapping>
                  </xpdExt:DataMappings>
                </xpdExt:SignalData>
                <xpdl2:Properties/>
              </xpdl2:TriggerResultSignal>
            </xpdl2:IntermediateEvent>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" LaneId="_K5JE1oElEemXD5TuR_N3Pg" Width="362.0">
              <xpdl2:Coordinates XCoordinate="1339.0" YCoordinate="718.0"/>
