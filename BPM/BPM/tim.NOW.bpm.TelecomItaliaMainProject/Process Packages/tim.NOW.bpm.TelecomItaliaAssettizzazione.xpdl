        <xpdl2:FormalParameter Id="_oghFIDQnEei2e9dyLHNFPw" Name="AssetRicarica" ReadOnly="false" Mode="OUT" Required="false" xpdExt:DisplayName="AssetRicarica">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_f5h-QDETEeie7s-9JnTWGQ"/>
          </xpdl2:DataType>
        </xpdl2:FormalParameter>
      </xpdl2:FormalParameters>
