            <xpdl2:Activity Id="_0ZT4Yi_6EeehzMIy_SdzNg" Name="GestioneNUMEROTELEFONICOPRINCIPALE" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Gestione NUMEROTELEFONICOPRINCIPALE">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">var data = DateTimeUtil.createDatetime();&#xD;
var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numTelPrincipale = :numTel AND IDAsset &lt;> :ida AND offerta = 'NP' AND (statoAsset = 'ATTIVO' OR statoAsset = 'INLAVORAZIONE')&quot;);&#xD;
c.setQueryParameter(&quot;numTel&quot;,AssetCessato.IDRisorsa);&#xD;
c.setQueryParameter(&quot;ida&quot;,AssetCessato.IDAsset);&#xD;
var assets = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
&#xD;
for(var i = 0; i &lt; assets.size(); i++)&#xD;
{&#xD;
	assetRef = assets.get(i);&#xD;
	var assetNP = assetRef.readAsset();&#xD;
	&#xD;
	if((assetNP != null &amp;&amp; Asset != null &amp;&amp; assetNP.IDAsset != Asset.IDAsset) || Asset == null)&#xD;
	{&#xD;
		assetNP.numTelPrincipale = assetNP.numeroTelefonico;&#xD;
		assetNP.lastUpdate = data;&#xD;
		&#xD;
		var NPTrovata = false;&#xD;
		var j=0;&#xD;
		&#xD;
		while(!NPTrovata &amp;&amp; j&lt;assetNP.dettaglioasset.size())&#xD;
		{&#xD;
			var dettaglio = assetNP.dettaglioasset.get(j);&#xD;
				&#xD;
			if(dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
				NPTrovata = true;&#xD;
				var k = 0;&#xD;
				&#xD;
				while(k&lt;dettaglio.attributidettaglioasset.size())&#xD;
				{&#xD;
					&#xD;
					if(dettaglio.attributidettaglioasset.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE)&#xD;
					{&#xD;
						dettaglio.attributidettaglioasset.get(k).valoreAttributo = assetNP.numeroTelefonico;&#xD;
						dettaglio.lastUpdate = data;&#xD;
						Process.auditLog('AGGIORNATO attributo NUMEROTELEFONICO PRINCIPALE per asset '+assetNP.IDAsset+' con '+dettaglio.attributidettaglioasset.get(k).valoreAttributo);&#xD;
					}&#xD;
					//SM_8134: eliminazione attributi CAPOSERIE e RADICALE&#xD;
					else if(dettaglio.attributidettaglioasset.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE)&#xD;
					{&#xD;
						dettaglio.attributidettaglioasset.remove(k);&#xD;
						k = k-1; //SM_9322&#xD;
						Process.auditLog('Eliminato attributo CAPOSERIE per asset '+assetNP.IDAsset);&#xD;
					}&#xD;
					else if(dettaglio.attributidettaglioasset.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
					{&#xD;
						dettaglio.attributidettaglioasset.remove(k);&#xD;
						k = k-1; //SM_9322&#xD;
						Process.auditLog('Eliminato attributo RADICALE per asset '+assetNP.IDAsset);&#xD;
					}&#xD;
					&#xD;
					k++;&#xD;
				}&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
		ListaAssetModificatiRef.add(assetRef);&#xD;
		ListaAssetModificati.add(ScriptUtil.copy(assetNP));&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
                  </xpdl2:TaskScript>
                </xpdl2:Task>
              </xpdl2:Implementation>
