        <xpdl2:Activity Id="_JQpr0AWXEee0LZKXfoduSA" Name="ArricchimentoAzionecompDTUeconsistenze" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Azione comp DTU e consistenze">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;Arricchimento Azione per componenti DTU&quot;);&#xD;
&#xD;
var STRUTTURALINEA = &quot;&quot;;&#xD;
STRUTTURALINEA = null;&#xD;
&#xD;
var OFFERTADONATING = &quot;&quot;;&#xD;
OFFERTADONATING = null;&#xD;
&#xD;
var operatoreReteConsDati = &quot;&quot;;&#xD;
operatoreReteConsDati = null;&#xD;
&#xD;
var operatoreReteConsFonia = &quot;&quot;;&#xD;
operatoreReteConsFonia = null;&#xD;
&#xD;
// RECUPERO STRUTTURALINEA e OFFERTA DONATING&#xD;
for(var i2 = 0; i2 &lt; localRequest.ordine.dettaglioordine.size(); i2++)&#xD;
{	&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i2);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR ||&#xD;
	   currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULL ||&#xD;
	   currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS) // RU_975 - aggiunto CPS&#xD;
	{&#xD;
		var k = 0;&#xD;
		&#xD;
		while(STRUTTURALINEA == null &amp;&amp; k &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(k);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
			{&#xD;
				STRUTTURALINEA = currentAttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;Recuperata struttura linea: &quot;+STRUTTURALINEA);&#xD;
			}&#xD;
			&#xD;
			k++;&#xD;
		}&#xD;
	}&#xD;
	else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
	{&#xD;
		var k = 0;&#xD;
		&#xD;
		while(OFFERTADONATING == null &amp;&amp; k &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(k);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
			{&#xD;
				OFFERTADONATING = currentAttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;Recuperata offerta donating: &quot;+OFFERTADONATING);&#xD;
			}&#xD;
			&#xD;
			k++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if((componente.azione == null || String(componente.nomeComponente) == 'AGGIUNTIVO') &amp;&amp; OrdineComponente.contains(String(componente.nomeComponente)))&#xD;
	{&#xD;
		var indiceConfigurazione = 0;&#xD;
		indiceConfigurazione = null;&#xD;
		var j=0;&#xD;
		&#xD;
		while(indiceConfigurazione == null &amp;&amp; j&lt;OrdineComponente.size())&#xD;
		{&#xD;
			if(OrdineComponente.get(j) == String(componente.nomeComponente))&#xD;
			{&#xD;
				indiceConfigurazione = j;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
		if(indiceConfigurazione != null)&#xD;
		{&#xD;
			var VPIUTENTE = &quot;&quot;;&#xD;
			var VCIUTENTE = &quot;&quot;;&#xD;
			var USERVLAN = &quot;&quot;;&#xD;
			var DLCI_DTU = &quot;&quot;;&#xD;
			var statoAggiuntivo = &quot;&quot;;&#xD;
			var VPIUTENTETrovato = false;&#xD;
			var VCIUTENTETrovato = false;&#xD;
			var USERVLANTrovato = false;&#xD;
			var DLCI_DTUTrovato = false;&#xD;
			var statoAggiuntivoTrovato = false;&#xD;
			&#xD;
			var c =0;&#xD;
			while((!VPIUTENTETrovato || !VCIUTENTETrovato || !USERVLANTrovato || !DLCI_DTUTrovato || !statoAggiuntivoTrovato) &amp;&amp; c&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var temp = componente.attributiDettaglioOrdine.get(c);&#xD;
				&#xD;
				if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPIUTENTE)&#xD;
				{&#xD;
					VPIUTENTE = temp.valoreAttributo;&#xD;
					VPIUTENTETrovato = true;&#xD;
				} &#xD;
				else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCIUTENTE)&#xD;
				{&#xD;
					VCIUTENTE = temp.valoreAttributo;&#xD;
					VCIUTENTETrovato = true;&#xD;
				} &#xD;
				else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN)&#xD;
				{&#xD;
					USERVLAN = temp.valoreAttributo;&#xD;
					USERVLANTrovato = true;&#xD;
				}&#xD;
				else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI)&#xD;
				{&#xD;
					DLCI_DTU = temp.valoreAttributo;&#xD;
					DLCI_DTUTrovato = true;&#xD;
				}&#xD;
				else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATOAGGIUNTIVO &amp;&amp;&#xD;
						(OrdineComponente.get(indiceConfigurazione) == &quot;DTUAGGIUNTIVO&quot; &amp;&amp; AssetComponente.get(indiceConfigurazione) == &quot;AGGIUNTIVO&quot; ||&#xD;
						 OrdineComponente.get(indiceConfigurazione) == &quot;DTUPRENOTAZIONEAGGIUNTIVO&quot; &amp;&amp; AssetComponente.get(indiceConfigurazione) == &quot;AGGIUNTIVO&quot;))&#xD;
				{&#xD;
					statoAggiuntivo = temp.valoreAttributo;&#xD;
					statoAggiuntivoTrovato = true;&#xD;
				}&#xD;
				&#xD;
			c++;&#xD;
			}&#xD;
			&#xD;
			&#xD;
			var trovato = false;&#xD;
			var k=0;&#xD;
			&#xD;
			// ============== Configurazione MANUALE per AGGIUNTIVO ============== SM_8397/99, modificata completamente con SM_8470&#xD;
			// RU_975: integrata gestione aggiuntivi CPS&#xD;
			// AGGIUNTIVI DA DTU&#xD;
			if((OrdineComponente.get(indiceConfigurazione) == &quot;DTUPRENOTAZIONEAGGIUNTIVO&quot; &#xD;
			 || OrdineComponente.get(indiceConfigurazione) == &quot;DTUAGGIUNTIVO&quot;) &#xD;
			 &amp;&amp;(String(localRequest.offerta).slice(0,3) == &quot;WLR&quot; || String(localRequest.offerta).slice(0,4) == &quot;VULL&quot;&#xD;
				|| String(localRequest.offerta).slice(0,3) == &quot;CPS&quot;)) // RU_975: aggiunta CPS&#xD;
			{&#xD;
				var numeroDTU = &quot;&quot;;&#xD;
				numeroDTU = null;&#xD;
				&#xD;
				var x = 0;&#xD;
				&#xD;
				while(x &lt; componente.attributiDettaglioOrdine.size() &amp;&amp; numeroDTU == null)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(x);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TELAGGIUNTIVO)&#xD;
					{&#xD;
						numeroDTU = attributo.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato TelAggiuntivo DTU: &quot;+numeroDTU);&#xD;
					}&#xD;
					&#xD;
					x++;&#xD;
				}&#xD;
				&#xD;
				&#xD;
				if(statoAggiuntivo == &quot;NON ATTIVO&quot;)&#xD;
				{					&#xD;
					if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS&#xD;
					&amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE) // RU_975: per CPS potrebbero arrivare AGGIUNTIVI da DTU da cessare che non sono presenti nell'ordine, allora mettiamo anche a DTU AGGIUNTIVO l'azione a D (gestista negli script successivi)&#xD;
					{&#xD;
						componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
						Process.auditLog(&quot;Stato &quot;+statoAggiuntivo+&quot;, caso CPS, da cessare&quot;);&#xD;
					}&#xD;
					else&#xD;
					// CASO STANDARD&#xD;
					{&#xD;
						componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
						Process.auditLog(&quot;Stato &quot;+statoAggiuntivo+&quot;, da non assettizzare&quot;);&#xD;
					}&#xD;
				}&#xD;
				// INCREMENTO AGGIUNTIVI (da DTU ad A se non esisteva gia in asset)&#xD;
				else if((localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOCANALI&#xD;
						 &amp;&amp; ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA &amp;&amp; (STRUTTURALINEA == &quot;GNR&quot; || STRUTTURALINEA == &quot;PBX&quot;)) ||&#xD;
						     (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA &amp;&amp; (STRUTTURALINEA == &quot;GNR&quot; || STRUTTURALINEA == &quot;PBX&quot; || STRUTTURALINEA == &quot;BMU&quot;))))&#xD;
					 || (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTSMULTINUMERO &#xD;
						 &amp;&amp;  String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;)&#xD;
					 || (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOBORCHIA //Aggiunto con SM_8770&#xD;
						 &amp;&amp;  String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;))&#xD;
				{&#xD;
					var trovatoNUM = false;&#xD;
					var k = 0;&#xD;
					&#xD;
					while(!trovatoNUM &amp;&amp; k &lt; localRequest.ordine.dettaglioordine.size())&#xD;
					{&#xD;
						var componenteAgg = localRequest.ordine.dettaglioordine.get(k);&#xD;
						&#xD;
						if(componenteAgg.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
						{&#xD;
							var z = 0;&#xD;
							&#xD;
							while(!trovatoNUM &amp;&amp; z &lt; componenteAgg.attributiDettaglioOrdine.size())&#xD;
							{&#xD;
								var attributo = componenteAgg.attributiDettaglioOrdine.get(z);&#xD;
								&#xD;
								if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
								{&#xD;
									if(numeroDTU == attributo.valoreAttributo)&#xD;
									{&#xD;
										trovatoNUM = true;&#xD;
										Process.auditLog(&quot;AGGIUNTIVO da DTU &quot;+numeroDTU+&quot; già presente in ASSET: &quot;+attributo.nomeAttributo+&quot; da NON AGGIUNGERE&quot;);&#xD;
									}&#xD;
								}&#xD;
								&#xD;
								z++;&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						k++;&#xD;
					}&#xD;
					&#xD;
					if(trovatoNUM)&#xD;
					{&#xD;
						componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
						Process.auditLog(&quot;Sottolav &quot;+localRequest.tipologiaSottolav+&quot;, Azione di &quot;+componente.nomeComponente+&quot; a &quot;+componente.azione);&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
						Process.auditLog(&quot;Sottolav &quot;+localRequest.tipologiaSottolav+&quot;, Azione di &quot;+componente.nomeComponente+&quot; a &quot;+componente.azione);&#xD;
					}&#xD;
				}&#xD;
				// DECREMENTO AGGIUNTIVI (da DTU tutto ad N, vuol dire che non devono essere decrementati)&#xD;
				else if((localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOCANALI&#xD;
						&amp;&amp;((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA &amp;&amp; (STRUTTURALINEA == &quot;GNR&quot; || STRUTTURALINEA == &quot;PBX&quot;)) ||&#xD;
						   (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA &amp;&amp; (STRUTTURALINEA == &quot;GNR&quot; || STRUTTURALINEA == &quot;PBX&quot; || STRUTTURALINEA == &quot;BMU&quot;))))&#xD;
				     || (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CESSAZIONESTSMULTINUMERO&#xD;
						&amp;&amp;  String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;)&#xD;
					 || (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOBORCHIA //Aggiunto con SM_8770&#xD;
						&amp;&amp;  String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;))&#xD;
				{&#xD;
					// In caso di DECREMENTO Azioni a N. Per la cessazione si usano le componenti AGGIUNTIVO, da DTU risalgono solo quelle che dovranno restare ATTIVE&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
					Process.auditLog(&quot;Sottolav &quot;+localRequest.tipologiaSottolav+&quot;, Azione di &quot;+componente.nomeComponente+&quot; a &quot;+componente.azione);&#xD;
				}&#xD;
				//SM_9579: CESSAZIONE CPS&#xD;
				//Task #37119: MIGRAZIONE CPS con RIENTROCPS&#xD;
				else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAGGIUNTIVO&#xD;
				        &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS&#xD;
				        &amp;&amp; (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
						    ||(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
						        &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIENTROCPS)))&#xD;
				{&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
					Process.auditLog(&quot;CASO STANDARD. Offerta &quot;+localRequest.offerta+&quot;, Azione di &quot;+componente.nomeComponente+&quot; a &quot;+componente.azione);&#xD;
				}&#xD;
				// CASO STANDARD DA ALLEGATO 18&#xD;
				else if((OrdineComponente.get(indiceConfigurazione) == &quot;DTUPRENOTAZIONEAGGIUNTIVO&quot;)||&#xD;
						(OrdineComponente.get(indiceConfigurazione) == &quot;DTUAGGIUNTIVO&quot;))&#xD;
				{&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
					Process.auditLog(&quot;CASO STANDARD. Offerta &quot;+localRequest.offerta+&quot;, Azione di &quot;+componente.nomeComponente+&quot; a &quot;+componente.azione);&#xD;
			&#xD;
					// Se il DTUPRENOTAZIONEAGGIUNTIVO/DTUAGGIUNTIVO da AGGIUNGERE in ASSET ha un suo corrispondente come AGGIUNTIVO nell'ordine&#xD;
					// mettere azione di quest'ultimo a N (evita AGGIUNTIVI duplicati)			&#xD;
					var trovatoNUM = false;&#xD;
					&#xD;
					// RU_975: Aggiunto if esterno, per CPS vanno assettizzati a prescindere i DTU AGGIUNTIVO se in stato ATTIVO&#xD;
					if(localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
					{&#xD;
						for(var k = 0; k &lt; localRequest.ordine.dettaglioordine.size(); k++)&#xD;
						{&#xD;
							var componenteAgg = localRequest.ordine.dettaglioordine.get(k);&#xD;
							&#xD;
							trovatoNUM = false;&#xD;
							&#xD;
							if(componenteAgg.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO&#xD;
							&amp;&amp; (componenteAgg.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A || componenteAgg.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N))&#xD;
							{&#xD;
								var z = 0;&#xD;
								&#xD;
								while(!trovatoNUM &amp;&amp; z &lt; componenteAgg.attributiDettaglioOrdine.size())&#xD;
								{&#xD;
									var attributo = componenteAgg.attributiDettaglioOrdine.get(z);&#xD;
									&#xD;
									if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
									{&#xD;
										if(numeroDTU == attributo.valoreAttributo)&#xD;
										{&#xD;
											trovatoNUM = true;&#xD;
											Process.auditLog(&quot;AGGIUNTIVO da DTU &quot;+numeroDTU+&quot; già presente in ASSET: &quot;+attributo.nomeAttributo+&quot; da NON AGGIUNGERE&quot;);&#xD;
										}&#xD;
									}&#xD;
									&#xD;
									z++;&#xD;
								}&#xD;
							}&#xD;
							&#xD;
							if(trovatoNUM &amp;&amp; componenteAgg.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
							{&#xD;
								componenteAgg.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
								Process.auditLog(&quot;Azione di &quot;+componente.nomeComponente+&quot; con &quot;+numeroDTU+&quot; a &quot;+componente.azione);&#xD;
							}&#xD;
							// SM_8848 - PEZZA - Se nell'ordine è presente lo stesso AGGIUNTIVO arrivato da DTU ma con Azione a N allora non bisogna assettizzare nemmeno l'aggiuntivo arrivao da DTU, poiché fa parte di quelli già presenti in asset&#xD;
							else if(trovatoNUM &amp;&amp; componenteAgg.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)&#xD;
							{&#xD;
								componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
								Process.auditLog(&quot;SOVRASCRITTA Azione di &quot;+componente.nomeComponente+&quot; a &quot;+componente.azione+&quot;, PRESENTE LO STESSO AGGIUNTIVO NELL'ORDINE CON AZIONE A N&quot;);	&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					// DTUPRENOTAZIONEAGGIUNTIVO deve essere messo a N quando *WLR LNA/VULL LNA tranne MIG* o *MIG WLR LNA con Donating != WLR LNA*&#xD;
					// In questo caso va assettizzato solo DTUAGGIUNTIVO, altrimenti duplichiamo&#xD;
					if(OrdineComponente.get(indiceConfigurazione) == &quot;DTUPRENOTAZIONEAGGIUNTIVO&quot; &#xD;
					&amp;&amp; (((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA) &#xD;
							&amp;&amp; localRequest.lavorazione !== it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
					  || (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA &#xD;
						    &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &#xD;
							&amp;&amp; OFFERTADONATING != 'WLRLINEANONATTIVA')))&#xD;
					{&#xD;
						componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
						Process.auditLog(&quot;FILTRAGGIO DTUPRENOTAZIONEAGGIUNTIVO.&quot;);	&#xD;
					}&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
					Process.auditLog(&quot;ALTRO CASO. Azione di &quot;+componente.nomeComponente+&quot; a &quot;+componente.azione);&#xD;
				}&#xD;
				&#xD;
				trovato = true;&#xD;
			}&#xD;
			// DECREMENTO AGGIUNTIVI da CESSARE&#xD;
			else if(OrdineComponente.get(indiceConfigurazione) == &quot;AGGIUNTIVO&quot; &#xD;
					&amp;&amp; ((localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOCANALI&#xD;
							&amp;&amp;((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA &amp;&amp; (STRUTTURALINEA == &quot;GNR&quot; || STRUTTURALINEA == &quot;PBX&quot;)) ||&#xD;
							   (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA &amp;&amp; (STRUTTURALINEA == &quot;GNR&quot; || STRUTTURALINEA == &quot;PBX&quot; || STRUTTURALINEA == &quot;BMU&quot;))))&#xD;
					 || (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CESSAZIONESTSMULTINUMERO &#xD;
							&amp;&amp;  String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;)&#xD;
					 || (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOBORCHIA	// SM_8770&#xD;
							&amp;&amp;  String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;)&#xD;
					 || (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE // SM_8848 - Generalizzata a qualsiasi variazione che NON SIA un decremento&#xD;
							&amp;&amp; (STRUTTURALINEA == &quot;GNR&quot; || STRUTTURALINEA == &quot;PBX&quot;)&#xD;
							&amp;&amp; (String(localRequest.offerta).slice(0,3) == &quot;WLR&quot; || String(localRequest.offerta).slice(0,3) == &quot;VULL&quot;)&#xD;
							&amp;&amp; (localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOCANALI &amp;&amp;&#xD;
								localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CESSAZIONESTSMULTINUMERO &amp;&amp;&#xD;
								localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOBORCHIA))))&#xD;
			{&#xD;
				var numeroAGGOrdine = &quot;&quot;;&#xD;
				numeroAGGOrdine = null;&#xD;
				&#xD;
				var x = 0;&#xD;
				&#xD;
				while(x &lt; componente.attributiDettaglioOrdine.size() &amp;&amp; numeroAGGOrdine == null)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(x);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
					{&#xD;
						numeroAGGOrdine = attributo.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato numero AGGIUNTIVO nell'ordine: &quot;+numeroAGGOrdine);&#xD;
					}&#xD;
					&#xD;
					x++;&#xD;
				}&#xD;
&#xD;
				var trovatoNUM = false;&#xD;
				var statoAggiuntivoDEC = &quot;&quot;;&#xD;
				&#xD;
				var k = 0;&#xD;
				&#xD;
				while(!trovatoNUM &amp;&amp; k &lt; localRequest.ordine.dettaglioordine.size())&#xD;
				{&#xD;
					var componenteAgg = localRequest.ordine.dettaglioordine.get(k);&#xD;
					&#xD;
					if(componenteAgg.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUPRENOTAZIONEAGGIUNTIVO || &#xD;
					   componenteAgg.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAGGIUNTIVO)&#xD;
					{&#xD;
						var z = 0;&#xD;
						&#xD;
						statoAggiuntivoDEC = null;&#xD;
						&#xD;
						while((statoAggiuntivoDEC == null || !trovatoNUM) &amp;&amp; z &lt; componenteAgg.attributiDettaglioOrdine.size())&#xD;
						{&#xD;
							var attributo = componenteAgg.attributiDettaglioOrdine.get(z);&#xD;
							&#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TELAGGIUNTIVO)&#xD;
							{&#xD;
								if(numeroAGGOrdine == attributo.valoreAttributo)&#xD;
								{&#xD;
									trovatoNUM = true;&#xD;
									Process.auditLog(&quot;Arrivato da DTU aggiuntivo: &quot;+numeroAGGOrdine);&#xD;
								}&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATOAGGIUNTIVO)&#xD;
							{&#xD;
								statoAggiuntivoDEC = String(attributo.valoreAttributo);&#xD;
								Process.auditLog(&quot;StatoAggiuntivo: &quot;+statoAggiuntivoDEC);&#xD;
							}&#xD;
							&#xD;
							z++;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					k++;&#xD;
				}&#xD;
				&#xD;
				if(trovatoNUM &amp;&amp; statoAggiuntivoDEC == &quot;ATTIVO&quot;) //SM_8708: da non cessare solo se è arrivato da DTU con stato ATTIVO, se è arrivato come NON ATTIVO è da cessare&#xD;
				{&#xD;
					// DA NON CESSARE&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
					Process.auditLog(&quot;Sottolav &quot;+localRequest.tipologiaSottolav+&quot;, Azione di &quot;+componente.nomeComponente+&quot; a &quot;+componente.azione);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					// DA CESSARE&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
					Process.auditLog(&quot;Sottolav &quot;+localRequest.tipologiaSottolav+&quot;, Azione di &quot;+componente.nomeComponente+&quot; a &quot;+componente.azione);&#xD;
				}&#xD;
				&#xD;
				trovato = true;&#xD;
			}&#xD;
			// CPS Aggiuntivi semplici nell'ordine TUTTI ad N. Guida DTU con tutte le azioni ad A in caso di ATTIVAZIONE. - RU_975&#xD;
			else if (OrdineComponente.get(indiceConfigurazione) == &quot;AGGIUNTIVO&quot;&#xD;
			&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS&#xD;
			&amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
				Process.auditLog(&quot;CASO CPS ATTIVAZIONE. Azione di &quot;+componente.nomeComponente+&quot; a &quot;+componente.azione);&#xD;
			}&#xD;
			// ============== CONFIGURAZIONE GENERICA ==============&#xD;
			else&#xD;
			{&#xD;
				while(!trovato &amp;&amp; k&lt;localRequest.ordine.dettaglioordine.size())&#xD;
				{&#xD;
					var componenteConf = localRequest.ordine.dettaglioordine.get(k);&#xD;
					&#xD;
					if(componenteConf.azione!= null &amp;&amp; String(componenteConf.nomeComponente) == AssetComponente.get(indiceConfigurazione))&#xD;
					{&#xD;
						if(componenteConf.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &#xD;
						|| componenteConf.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
						|| componenteConf.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
						{&#xD;
							var VPI = &quot;&quot;;&#xD;
							var VCI = &quot;&quot;;&#xD;
							var USERVLANID = &quot;&quot;;&#xD;
							var DLCI = &quot;&quot;;&#xD;
							var VPITrovato = false;&#xD;
							var VCITrovato = false;&#xD;
							var USERVLANIDTrovato = false;&#xD;
							var DLCITrovato = false;&#xD;
				&#xD;
							var c =0;&#xD;
							while((!VPITrovato || !VCITrovato || !USERVLANIDTrovato || !DLCITrovato) &amp;&amp; c&lt;componenteConf.attributiDettaglioOrdine.size())&#xD;
							{&#xD;
								var temp = componenteConf.attributiDettaglioOrdine.get(c);&#xD;
								&#xD;
								if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
								{&#xD;
									VPI = temp.valoreAttributo;&#xD;
									VPITrovato = true;&#xD;
								} &#xD;
								else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
								{&#xD;
									VCI = temp.valoreAttributo;&#xD;
									VCITrovato = true;&#xD;
								} &#xD;
								else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
								{&#xD;
									USERVLANID = temp.valoreAttributo;&#xD;
									USERVLANIDTrovato = true;&#xD;
								}&#xD;
								else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI)&#xD;
								{&#xD;
									DLCI = temp.valoreAttributo;&#xD;
									DLCITrovato = true;&#xD;
								}&#xD;
								c++;&#xD;
							}&#xD;
							&#xD;
							Process.auditLog(&quot;VPI &quot;+VPITrovato+&quot;:&quot;+VPI+ &quot;,VCI &quot;+VCITrovato+&quot;:&quot;+VCI+&quot;,USERVLANID &quot;+USERVLANIDTrovato+&quot;:&quot;+USERVLANID+ &quot;, DLCI &quot;+DLCITrovato+&quot;:&quot;+DLCI);&#xD;
							&#xD;
							if(componenteConf.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
							{&#xD;
								if((USERVLANIDTrovato &amp;&amp; USERVLANTrovato &amp;&amp; USERVLANID== USERVLAN)&#xD;
								|| (DLCITrovato &amp;&amp; DLCI_DTUTrovato &amp;&amp; DLCI == DLCI_DTU))&#xD;
								{&#xD;
									componente.azione = componenteConf.azione;&#xD;
									trovato = true;&#xD;
								}&#xD;
							}&#xD;
							else&#xD;
							{&#xD;
								if((VPITrovato &amp;&amp; VCITrovato &amp;&amp; VPIUTENTETrovato &amp;&amp; VCIUTENTETrovato &amp;&amp; VPI==VPIUTENTE &amp;&amp; VCI==VCIUTENTE)&#xD;
								|| (DLCITrovato &amp;&amp; DLCI_DTUTrovato &amp;&amp; DLCI == DLCI_DTU))&#xD;
								{&#xD;
									componente.azione = componenteConf.azione;&#xD;
									trovato = true;&#xD;
								}&#xD;
							}&#xD;
							&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							componente.azione = componenteConf.azione;&#xD;
							trovato = true;&#xD;
						}&#xD;
						&#xD;
					}&#xD;
					k++;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if(!trovato)&#xD;
			{&#xD;
				Process.auditLog(&quot;Configurazione dell'elemento Azione non trovata in relazione alla Componente: &quot;+String(componente.nomeComponente)+&quot; VPIUTENTE: &quot;+VPIUTENTE +&quot;, VCIUTENTE: &quot;+VCIUTENTE+&quot;, USERVLAN: &quot;+USERVLAN);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				Process.auditLog(&quot;Configurazione Azione trovata: &quot;+String(componente.azione)+&quot; Componente: &quot;+String(componente.nomeComponente)+&quot; VPIUTENTE: &quot;+VPIUTENTE +&quot;, VCIUTENTE: &quot;+VCIUTENTE+&quot;, USERVLAN: &quot;+USERVLAN);&#xD;
			}		&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	// ============================================== RECUPERO ASSET ==============================================&#xD;
	// CONSISTENZA DATI&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
	{&#xD;
		var j=0;&#xD;
		var trovato = false;&#xD;
		while(!trovato &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
			if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				if(isNaN(attr.valoreAttributo))&#xD;
				{&#xD;
					Process.auditLog(&quot;Trovato un IDENTIFICATIVOASSET per CONSISTENZADATI non numerico: &quot;+ attr.valoreAttributo);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					var AssetID = ScriptUtil.createBigInteger(attr.valoreAttributo);&#xD;
					AssetConsistenzaDatiRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(AssetID);&#xD;
					&#xD;
					if(AssetConsistenzaDatiRef!=null)&#xD;
					{&#xD;
						AssetConsistenzaDati = AssetConsistenzaDatiRef.readAsset();&#xD;
						&#xD;
						if(AssetConsistenzaDati.statoAsset== it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)&#xD;
						{&#xD;
							AssetConsistenzaDati=null;&#xD;
							Process.auditLog(&quot;Trovato asset cessato con IDENTIFICATIVOASSET: &quot;+ AssetID);&#xD;
						}&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						Process.auditLog(&quot;Nessun asset trovato con IDENTIFICATIVOASSET: &quot;+ AssetID);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPERATORERETE)&#xD;
			{&#xD;
				operatoreReteConsDati = attr.valoreAttributo;&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	// CONSISTENZA FONIA&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
	{&#xD;
		var j=0;&#xD;
		var trovato = false;&#xD;
		while(!trovato &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
			if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				if(isNaN(attr.valoreAttributo))&#xD;
				{&#xD;
					Process.auditLog(&quot;Trovato un IDENTIFICATIVOASSET per CONSISTENZAFONIA non numerico: &quot;+ attr.valoreAttributo);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					var AssetID = ScriptUtil.createBigInteger(attr.valoreAttributo);&#xD;
					AssetConsistenzaFoniaRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(AssetID);&#xD;
					&#xD;
					if(AssetConsistenzaFoniaRef!=null)&#xD;
					{&#xD;
						AssetConsistenzaFonia = AssetConsistenzaFoniaRef.readAsset();&#xD;
						&#xD;
						if(AssetConsistenzaFonia.statoAsset== it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)&#xD;
						{&#xD;
							AssetConsistenzaFonia=null;&#xD;
							Process.auditLog(&quot;Trovato asset cessato con IDENTIFICATIVOASSET: &quot;+ AssetID);&#xD;
						}&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						Process.auditLog(&quot;Nessun asset trovato con IDENTIFICATIVOASSET: &quot;+ AssetID);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AGGIUNTIVOWLR&#xD;
				 &amp;&amp; attr.valoreAttributo == 'Y')&#xD;
			{&#xD;
				FoniaAggiuntivoWLR = true;&#xD;
			}&#xD;
			else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPERATORERETE)&#xD;
			{&#xD;
				operatoreReteConsFonia = attr.valoreAttributo;&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	// CONSISTENZACPS - SM_9066&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS)&#xD;
	{&#xD;
		var j = 0;&#xD;
		var trovato = false;&#xD;
		while(!trovato &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
