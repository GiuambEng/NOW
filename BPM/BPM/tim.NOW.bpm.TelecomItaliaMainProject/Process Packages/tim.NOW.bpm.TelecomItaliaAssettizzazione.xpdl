&#xD;
//RU_1142 - SM_9960: casistica di invio verso FC di VARIAZIONE WLR con AGGIUNTIVI post Espletamento (VARIAZIONIAGGIUNTIVI verso FC)&#xD;
if(&#xD;
localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
&amp;&amp; (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOCANALI&#xD;
 || localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOCANALI)&#xD;
&amp;&amp; (STRUTTURALINEA == &quot;GNR&quot; || STRUTTURALINEA == &quot;PBX&quot;)&#xD;
&amp;&amp; (operatoreReteConsDati == &quot;FC&quot; || operatoreReteConsFonia == &quot;FC&quot;)&#xD;
&amp;&amp; (String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;)&#xD;
)&#xD;
{&#xD;
	var z = 0;&#xD;
	&#xD;
	while(!sendVARIAZIONEAGGIUNTIVI &amp;&amp; z &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{	&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(z);&#xD;
		&#xD;
		if((currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUPRENOTAZIONEAGGIUNTIVO ||&#xD;
		    currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAGGIUNTIVO ||&#xD;
		    currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
			&amp;&amp; (currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A || currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D))&#xD;
		{&#xD;
			sendVARIAZIONEAGGIUNTIVI = true;&#xD;
		}&#xD;
		&#xD;
		z++;&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
