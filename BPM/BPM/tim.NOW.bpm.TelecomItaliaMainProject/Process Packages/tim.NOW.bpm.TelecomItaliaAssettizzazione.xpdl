            <xpdl2:Activity Id="_RpLUltmOEeaB-6lC68ZgcA" Name="SetNumeroaggiuntivo" xpdExt:Visibility="Private" xpdExt:DisplayName="Set Numero aggiuntivo">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">AssetAggiuntivo = ScriptUtil.copy(Asset);&#xD;
AssetAggiuntivo.dettaglioasset.clear();&#xD;
AssetAggiuntivo.numeroFittizio = null;&#xD;
AssetAggiuntivo.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP;&#xD;
AssetAggiuntivo.tipologiaAccesso = it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA;&#xD;
&#xD;
//SM_10108&#xD;
if(AssetAggiuntivo.operatoreRete == &quot;FC&quot;)&#xD;
{&#xD;
	AssetAggiuntivo.operatoreRete = null;&#xD;
}&#xD;
&#xD;
var currentComponenteNUMBERPORTABILITY = ComponenteNUMBERPORTABILITY.get(Process.getActivityLoopIndex());&#xD;
&#xD;
if(AssetAggiuntivo.numeroTelefonico==ISDN_NumeriTelefoniciAggiuntivi.get(Process.getActivityLoopIndex())){&#xD;
	Process.auditLog(&quot;Warning: il numero telefonico aggiuntivo coincide con il numero telefonico principale&quot;);&#xD;
}&#xD;
&#xD;
AssetAggiuntivo.numeroTelefonico = ISDN_NumeriTelefoniciAggiuntivi.get(Process.getActivityLoopIndex());&#xD;
&#xD;
AssetAggiuntivo.IDRisorsa = AssetAggiuntivo.numeroTelefonico;&#xD;
AssetAggiuntivo.IDRisorsaNOW = AssetAggiuntivo.numeroTelefonico;&#xD;
currentLocalRequest=ScriptUtil.copy(localRequestTemp);&#xD;
currentLocalRequest.ordine.IDRisorsa=AssetAggiuntivo.numeroTelefonico;&#xD;
currentLocalRequest.ordine.IDRisorsaNOW=AssetAggiuntivo.numeroTelefonico;&#xD;
currentLocalRequest.IDRisorsa = AssetAggiuntivo.numeroTelefonico;&#xD;
&#xD;
currentLocalRequest.ordine.dettaglioordine.clear();&#xD;
&#xD;
if(currentComponenteNUMBERPORTABILITY.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMERIAGGIUNTIVI)&#xD;
{&#xD;
	currentComponenteNUMBERPORTABILITY.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY;&#xD;
}&#xD;
&#xD;
currentLocalRequest.ordine.dettaglioordine.add(ScriptUtil.copy(currentComponenteNUMBERPORTABILITY));&#xD;
</xpdl2:Script>
                  </xpdl2:TaskScript>
                </xpdl2:Task>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="68.0" Width="134.0">
                  <xpdl2:Coordinates XCoordinate="193.0" YCoordinate="91.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:ActivityResourcePatterns>
                <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
              </xpdExt:ActivityResourcePatterns>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_RpLUl9mOEeaB-6lC68ZgcA" Name="Service" xpdExt:Visibility="Private" xpdExt:DisplayName="Create Asset Case Data">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskService xpdExt:ImplementationType="GlobalData" Implementation="Other">
                    <xpdl2:MessageIn Id="_RpLUmNmOEeaB-6lC68ZgcA"/>
                    <xpdl2:MessageOut Id="_RpLUmdmOEeaB-6lC68ZgcA"/>
                    <xpdExt:GlobalDataOperation>
                      <xpdExt:CaseAccessOperations>
                        <xpdExt:CaseClassExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
                        <xpdExt:Create FromFieldPath="AssetAggiuntivo" ToCaseRefField="AssetRef"/>
                      </xpdExt:CaseAccessOperations>
                    </xpdExt:GlobalDataOperation>
                  </xpdl2:TaskService>
                </xpdl2:Task>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="72.0" Width="106.0">
                  <xpdl2:Coordinates XCoordinate="390.0" YCoordinate="91.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:ActivityResourcePatterns>
                <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
              </xpdExt:ActivityResourcePatterns>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">AssetAggiuntivo=AssetRef.readAsset();

var id = AssetAggiuntivo.IDAsset;

for(var i = 0; i &lt; AssetAggiuntivo.dettaglioasset.size(); i++)
{
	AssetAggiuntivo.dettaglioasset.get(i).IDAsset = id;
	
	for(var j = 0; j &lt; AssetAggiuntivo.dettaglioasset.get(i).attributidettaglioasset.size(); j++)
	{
		AssetAggiuntivo.dettaglioasset.get(i).attributidettaglioasset.get(j).IDAsset = id;
	}
}</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_RpLUmtmOEeaB-6lC68ZgcA" Name="StoricizzaAsset1" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Storicizza Asset 1">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_-pRhQIFvEeaG-Y7D3-yA8Q" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="localAsset">
                      <xpdl2:Actual ScriptGrammar="JavaScript">AssetAggiuntivo</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
              <xpdl2:Priority></xpdl2:Priority>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" Width="128.0">
                  <xpdl2:Coordinates XCoordinate="1022.0" YCoordinate="91.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Initiated">
                  <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier= &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.Assettizzazione&quot;;</xpdExt:Information>
                </xpdExt:AuditEvent>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">AssetAggiuntivi.add(ScriptUtil.copy(AssetAggiuntivo));&#xD;
AssetRefAggiuntivi.add(AssetRef);&#xD;
AssetAggiuntiviJP.add(ScriptUtil.copy(AssetAggiuntivo));&#xD;
AssetRefAggiuntiviJP.add(AssetRef);</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_RpLUm9mOEeaB-6lC68ZgcA" Name="UpdateAssetCaseDataID" xpdExt:Visibility="Private" xpdExt:DisplayName="Update Asset Case Data ID">
