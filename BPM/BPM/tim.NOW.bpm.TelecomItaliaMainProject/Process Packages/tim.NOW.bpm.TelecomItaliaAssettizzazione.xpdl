          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript"> // set Data Fine&#xD;
 AssetRicarica.dataFine = DateTimeUtil.createDatetime(EndDate,DateTimeUtil.createTime(AssetRicarica.dataInizio.getHour(), AssetRicarica.dataInizio.getMinute(), 0, 0));&#xD;
 Process.auditLog('Set DATAFINE per RicaricaIniziale a '+ String(AssetRicarica.dataFine));</xpdExt:Information>
