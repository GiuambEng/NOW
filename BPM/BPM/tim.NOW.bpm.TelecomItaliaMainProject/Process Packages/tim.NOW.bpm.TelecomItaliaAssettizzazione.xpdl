            <xpdl2:Activity Id="_-zFwwIrUEeazB5r48IqaJg" Name="SetNumeroaggiuntivo" xpdExt:Visibility="Private" xpdExt:DisplayName="Set Numero aggiuntivo">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">AssetAggiuntivo = ScriptUtil.copy(AssetTemp);&#xD;
&#xD;
if(AssetAggiuntivo.numeroTelefonico==ISDN_NumeriTelefoniciAggiuntivi.get(Process.getActivityLoopIndex()))&#xD;
{&#xD;
	Process.auditLog(&quot;Warning: il numero telefonico aggiuntivo coincide con il numero telefonico principale&quot;);&#xD;
}&#xD;
&#xD;
AssetAggiuntivo.numeroTelefonico = ISDN_NumeriTelefoniciAggiuntivi.get(Process.getActivityLoopIndex());&#xD;
AssetAggiuntivo.IDRisorsa = AssetAggiuntivo.numeroTelefonico;&#xD;
AssetAggiuntivo.IDRisorsaNOW = AssetAggiuntivo.IDRisorsa;&#xD;
&#xD;
// SM_8493 - Numero telefonico dell'aggiuntivo da mettere nell'attributo NUMERO TELEFONICO dell'aggiuntivo durante l'assettizzazione, oltre che in testata&#xD;
var i = 0;&#xD;
var NumberPortabilityTrovata = false;&#xD;
var NumeroTelefonicoTrovato = false;&#xD;
&#xD;
while((!NumberPortabilityTrovata || !NumeroTelefonicoTrovato) &amp;&amp; i &lt; AssetAggiuntivo.dettaglioasset.size())&#xD;
{&#xD;
	var componente = AssetAggiuntivo.dettaglioasset.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
	{&#xD;
		NumberPortabilityTrovata = true;&#xD;
		&#xD;
		var j = 0;&#xD;
		&#xD;
		while(!NumeroTelefonicoTrovato &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
		{&#xD;
			var attributo = componente.attributidettaglioasset.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
			{&#xD;
				attributo.valoreAttributo = AssetAggiuntivo.numeroTelefonico;&#xD;
				Process.auditLog(&quot;Sostituito attributo NUMEROTELEFONICO con AGGIUNTIVO: &quot;+attributo.valoreAttributo);&#xD;
				NumeroTelefonicoTrovato = true;&#xD;
			}&#xD;
		&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
</xpdl2:Script>
                  </xpdl2:TaskScript>
                </xpdl2:Task>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="68.0" Width="134.0">
                  <xpdl2:Coordinates XCoordinate="265.0" YCoordinate="91.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:ActivityResourcePatterns>
                <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
              </xpdExt:ActivityResourcePatterns>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_UXBhZYrXEeazB5r48IqaJg" Name="Service" xpdExt:Visibility="Private" xpdExt:DisplayName="Create Asset Case Data">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskService xpdExt:ImplementationType="GlobalData" Implementation="Other">
                    <xpdl2:MessageIn Id="_UXBhZorXEeazB5r48IqaJg"/>
                    <xpdl2:MessageOut Id="_UXBhZ4rXEeazB5r48IqaJg"/>
                    <xpdExt:GlobalDataOperation>
                      <xpdExt:CaseAccessOperations>
                        <xpdExt:CaseClassExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
                        <xpdExt:Create FromFieldPath="AssetAggiuntivo" ToCaseRefField="AssetRef"/>
                      </xpdExt:CaseAccessOperations>
                    </xpdExt:GlobalDataOperation>
                  </xpdl2:TaskService>
                </xpdl2:Task>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="72.0" Width="106.0">
                  <xpdl2:Coordinates XCoordinate="467.0" YCoordinate="91.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:ActivityResourcePatterns>
                <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
              </xpdExt:ActivityResourcePatterns>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">AssetAggiuntivo=AssetRef.readAsset();

var id = AssetAggiuntivo.IDAsset;

for(var i = 0; i &lt; AssetAggiuntivo.dettaglioasset.size(); i++)
{
	AssetAggiuntivo.dettaglioasset.get(i).IDAsset = id;
	
	for(var j = 0; j &lt; AssetAggiuntivo.dettaglioasset.get(i).attributidettaglioasset.size(); j++)
	{
		AssetAggiuntivo.dettaglioasset.get(i).attributidettaglioasset.get(j).IDAsset = id;
	}
}

// SM_8506
AssetAggiuntivo.cliente.IDAsset = id;
Process.auditLog(&quot;Aggiornato ID Asset Aggiuntivo CLIENTE con: &quot;+AssetAggiuntivo.cliente.IDAsset);</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_WckRlIrXEeazB5r48IqaJg" Name="StoricizzaAsset12" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Storicizza Asset 1 2">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_-pRhQIFvEeaG-Y7D3-yA8Q" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="localAsset">
                      <xpdl2:Actual ScriptGrammar="JavaScript">AssetAggiuntivo</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
              <xpdl2:Priority></xpdl2:Priority>
