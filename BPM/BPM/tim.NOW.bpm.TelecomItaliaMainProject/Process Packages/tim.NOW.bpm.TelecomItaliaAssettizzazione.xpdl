        <xpdl2:Activity Id="_TMyFk0E6EeekX-brtRDFQQ" Name="RecuperaAsset" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupera Asset">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var AssetID = 0;&#xD;
AssetID =null;&#xD;
&#xD;
//Attivazioni NPNG con sottolav PORTABILITASUCCESSIVA - RU_1203&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &#xD;
&amp;&amp; (localRequest.offerta!= null &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NPNG)&#xD;
&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PORTABILITASUCCESSIVA){&#xD;
&#xD;
	var i=0;&#xD;
	while(AssetID== null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZANPNG)&#xD;
		{&#xD;
			var j=0;&#xD;
			while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					AssetID = parseInt(attr.valoreAttributo, 10);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}		&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
//Attivazioni CANALE - RU_1180&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &#xD;
&amp;&amp;&#xD;
(localRequest.offerta!= null &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE)){&#xD;
&#xD;
	var i=0;&#xD;
	while(AssetID== null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACANALE)&#xD;
		{&#xD;
			var j=0;&#xD;
			while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					AssetID = parseInt(attr.valoreAttributo, 10);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
//Variazione VLAN - RU_1058&#xD;
var ListaOfferteVLAN = DataUtil.createList();&#xD;
ListaOfferteVLAN.add(&quot;VLANNGA&quot;);&#xD;
ListaOfferteVLAN.add(&quot;VLAN&quot;);&#xD;
ListaOfferteVLAN.add(&quot;VLANVULA&quot;);&#xD;
ListaOfferteVLAN.add(&quot;VP&quot;);&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &#xD;
&amp;&amp;&#xD;
(localRequest.offerta!= null &amp;&amp; ListaOfferteVLAN.contains(String(localRequest.offerta)))){&#xD;
&#xD;
	var i=0;&#xD;
	while(AssetID== null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZARACCOLTA)&#xD;
		{&#xD;
			var j=0;&#xD;
			while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					AssetID = parseInt(attr.valoreAttributo, 10);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
//Variazione dati - TUTTE LE ALTRE&#xD;
var ListaOfferteDati = DataUtil.createList();&#xD;
ListaOfferteDati.add(&quot;SHACONMANODOPERA&quot;); // Inserita con SM_8145, serve Consistenza Dati per offerte SHA&#xD;
ListaOfferteDati.add(&quot;SHASENZAMANODOPERA&quot;); // Inserita con SM_8145&#xD;
ListaOfferteDati.add(&quot;BITSTREAMATMASIMMETRICOFLAT&quot;);&#xD;
ListaOfferteDati.add(&quot;BITSTREAMATMASIMMETRICOHL&quot;);&#xD;
ListaOfferteDati.add(&quot;BITSTREAMATMASIMMETRICOLITE&quot;);&#xD;
ListaOfferteDati.add(&quot;BITSTREAMGBEASIMMETRICOFLAT&quot;);&#xD;
ListaOfferteDati.add(&quot;BITSTREAMATMSIMMETRICOFLAT&quot;);&#xD;
ListaOfferteDati.add(&quot;BITSTREAMATMSIMMETRICOHL&quot;);&#xD;
ListaOfferteDati.add(&quot;BITSTREAMGBESIMMETRICOFLAT&quot;);&#xD;
ListaOfferteDati.add(&quot;BITSTREAMNGAFTTCAB&quot;);&#xD;
ListaOfferteDati.add(&quot;BITSTREAMNGAFTTH&quot;);&#xD;
ListaOfferteDati.add(&quot;EASYIPBASEPLUSFLAT&quot;);&#xD;
ListaOfferteDati.add(&quot;EASYIPBASEPLUSLITE&quot;);&#xD;
ListaOfferteDati.add(&quot;EASYIPSPECIALPROFILEFLAT&quot;);&#xD;
ListaOfferteDati.add(&quot;EASYIPSPECIALPROFILELITE&quot;);&#xD;
ListaOfferteDati.add(&quot;VULAFTTCAB&quot;);&#xD;
ListaOfferteDati.add(&quot;VULAFTTH&quot;);&#xD;
ListaOfferteDati.add(&quot;EASYIPNGAFTTH&quot;);&#xD;
ListaOfferteDati.add(&quot;EASYIPNGAFTTCAB&quot;);&#xD;
ListaOfferteDati.add(&quot;SEMIVULAFTTH&quot;);                   //RU_1164: aggiunte offerte SEMI***&#xD;
ListaOfferteDati.add(&quot;SEMIBITSTREAMNGAFTTH&quot;);&#xD;
ListaOfferteDati.add(&quot;SEMIEASYIPNGAFTTH&quot;);&#xD;
ListaOfferteDati.add(&quot;FULLGPONPLUS&quot;);                   //SM_11753&#xD;
ListaOfferteDati.add(&quot;FULLGPONPLUSNGA&quot;);&#xD;
&#xD;
&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &#xD;
&amp;&amp;&#xD;
(localRequest.offerta!= null &amp;&amp; ListaOfferteDati.contains(String(localRequest.offerta)))){&#xD;
&#xD;
	var i=0;&#xD;
	while(AssetID== null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
		{&#xD;
			var j=0;&#xD;
			while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					AssetID = parseInt(attr.valoreAttributo, 10);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
// SM_8446 - Valorizzazione SEDE CERT eventualmente variata&#xD;
if(localRequest.ordine != null &amp;&amp;&#xD;
localRequest.ordine.sede != null &amp;&amp;&#xD;
localRequest.ordine.sede.size()>0)&#xD;
{	&#xD;
	var s = 0;&#xD;
	var sede = localRequest.ordine.sede.get(s);&#xD;
&#xD;
	while(s &lt; localRequest.ordine.sede.size() &amp;&amp; sede.tipologiaSede != it_telecomitalia_it_NOW_casedata_TipologiaSedeEnumeration.SEDECLIENTECERT)&#xD;
	{&#xD;
		sede = localRequest.ordine.sede.get(s);&#xD;
		s++;&#xD;
	}	&#xD;
	SedeCert = ScriptUtil.copy(sede);&#xD;
}&#xD;
&#xD;
&#xD;
//Variazione fonia&#xD;
var ListaOfferteFonia = DataUtil.createList();&#xD;
//ListaOfferteFonia.add(&quot;SHACONMANODOPERA&quot;); // Tolta post SM_8145&#xD;
//ListaOfferteFonia.add(&quot;SHASENZAMANODOPERA&quot;);&#xD;
ListaOfferteFonia.add(&quot;SLULINEAATTIVA&quot;);&#xD;
ListaOfferteFonia.add(&quot;SLULINEAATTIVANP&quot;);&#xD;
ListaOfferteFonia.add(&quot;SLULINEANONATTIVA&quot;);&#xD;
ListaOfferteFonia.add(&quot;ULL&quot;);&#xD;
ListaOfferteFonia.add(&quot;ULLDATI&quot;);&#xD;
ListaOfferteFonia.add(&quot;ULLDATILINEAATTIVA&quot;);&#xD;
ListaOfferteFonia.add(&quot;ULLDATILINEAATTIVANP&quot;);&#xD;
ListaOfferteFonia.add(&quot;ULLDATILINEANONATTIVA&quot;);&#xD;
ListaOfferteFonia.add(&quot;ULLLINEAATTIVA&quot;);&#xD;
ListaOfferteFonia.add(&quot;ULLLINEAATTIVANP&quot;);&#xD;
ListaOfferteFonia.add(&quot;ULLLINEANONATTIVA&quot;);&#xD;
ListaOfferteFonia.add(&quot;VARIAZIONESLU&quot;);&#xD;
ListaOfferteFonia.add(&quot;VARIAZIONEULL&quot;);&#xD;
ListaOfferteFonia.add(&quot;VARIAZIONEWLR&quot;);&#xD;
ListaOfferteFonia.add(&quot;VULL&quot;);&#xD;
ListaOfferteFonia.add(&quot;VULLLINEANONATTIVA&quot;);&#xD;
ListaOfferteFonia.add(&quot;WLRLINEAATTIVA&quot;);&#xD;
ListaOfferteFonia.add(&quot;WLRLINEANONATTIVA&quot;);&#xD;
&#xD;
if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &#xD;
&amp;&amp;&#xD;
(localRequest.offerta!= null &amp;&amp; ListaOfferteFonia.contains(String(localRequest.offerta))))&#xD;
||&#xD;
(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL&#xD;
/*&amp;&amp;&#xD;
  (localRequest.codiceTrasformazione == &quot;DECREMENTO_NP&quot;&#xD;
|| localRequest.codiceTrasformazione == &quot;DECREMENTO_ULL&quot;&#xD;
|| localRequest.codiceTrasformazione == &quot;DECREMENTO_SLU&quot;)*/)){&#xD;
	var i=0;&#xD;
	while(AssetID== null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA){&#xD;
			var j=0;&#xD;
			while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET){&#xD;
					AssetID = parseInt(attr.valoreAttributo, 10);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;AssetID: &quot;+AssetID);&#xD;
AssetPrincipaleRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(AssetID);&#xD;
Asset = AssetPrincipaleRef.readAsset();&#xD;
Asset.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
&#xD;
Process.auditLog(&quot;Offerta Asset Recuperato: &quot;+Asset.offerta);&#xD;
&#xD;
RichiestaLinkedToAssetRef = AssetPrincipaleRef.richiestaRef;&#xD;
&#xD;
//AGGIORNA ASSET&#xD;
//RU_1180: due eccezioni, per Attivazione CANALE (ESISTENTEFEEDER e OLT) non va aggiornato nulla in chiaro sull'asset&#xD;
if(localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE&#xD;
||(localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CANALEESISTENTEFEEDER&#xD;
&amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CANALEESISTENTEOLT))&#xD;
{&#xD;
	// Create target &quot;Asset&quot; if it doesn't exist.&#xD;
	if (Asset == null) {&#xD;
		Asset = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
	}&#xD;
&#xD;
	// ----------------------------------------------------------------&#xD;
	//RU_1184: per le variazioni EASYIP ora va gestito il valore STATODISABILITAZIONEASSET (attributo nell'ordine ma campo in chiaro sull'asset)&#xD;
	if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
	 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
	 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)&#xD;
	{&#xD;
&#xD;
		var statoDisabilitazioneAsset = &quot;&quot;;&#xD;
		statoDisabilitazioneAsset = null;&#xD;
		&#xD;
		var i = 0;&#xD;
		&#xD;
		while (statoDisabilitazioneAsset== null &amp;&amp; i&lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if (String(currentComponente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				&#xD;
				while( statoDisabilitazioneAsset== null &amp;&amp; j&lt;currentComponente.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATODISABILITAZIONEASSET)&#xD;
					{&#xD;
						statoDisabilitazioneAsset = currentAttributo.valoreAttributo;&#xD;
					}&#xD;
				j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		if (statoDisabilitazioneAsset != null &amp;&amp; statoDisabilitazioneAsset!= &quot;&quot;)&#xD;
		{&#xD;
			Asset.statoDisAsset = statoDisabilitazioneAsset;&#xD;
		}&#xD;
	}&#xD;
	// ----------------------------------------------------------------&#xD;
&#xD;
	// Map from 'SedeCert.CAP' to 'Asset.CAP'&#xD;
	if (SedeCert != null &amp;&amp; SedeCert.CAP != null) {&#xD;
		Asset.CAP = SedeCert.CAP;&#xD;
	}&#xD;
	// Map from 'CLLI' to 'Asset.CLLI'&#xD;
&#xD;
	// Function for user defined mapping script: CLLI&#xD;
&#xD;
	if(localRequest.ordine!= null &amp;&amp; localRequest.ordine.CLLI != null){&#xD;
		Asset.CLLI = localRequest.ordine.CLLI ;&#xD;
	}&#xD;
&#xD;
&#xD;
	// Map from 'Copy1OfNOW' to 'Asset.CRMEstrattore'&#xD;
&#xD;
	// Function for user defined mapping script: Copy1OfNOW&#xD;
&#xD;
	Asset.CRMEstrattore = &quot;NOW&quot;;&#xD;
&#xD;
	// Map from 'NOW' to 'Asset.CRMOrigine'&#xD;
	Asset.CRMOrigine = &quot;NOW&quot;;&#xD;
&#xD;
	// Map from 'localRequest.ordine.DEC' to 'Asset.DEC'&#xD;
	if (localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.DEC != null) {&#xD;
		Asset.DEC = localRequest.ordine.DEC;&#xD;
	}&#xD;
&#xD;
	// Map from 'localRequest.ordine.DES' to 'Asset.DES'&#xD;
	if (localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.DES != null) {&#xD;
		Asset.DES = localRequest.ordine.DES;&#xD;
	}&#xD;
&#xD;
	// Map from 'IDCONTRATTO' to 'Asset.IDContratto'&#xD;
&#xD;
	// Function for user defined mapping script: IDCONTRATTO&#xD;
&#xD;
	if (localRequest.IDContratto == null){&#xD;
		Asset.IDContratto=localRequest.IDContratto;&#xD;
	}&#xD;
&#xD;
	// Map from 'localRequest.IDOfferta' to 'Asset.IDOfferta'&#xD;
	if (localRequest != null &amp;&amp; localRequest.IDOfferta != null) {&#xD;
		Asset.IDOfferta = localRequest.IDOfferta;&#xD;
	}&#xD;
&#xD;
	// Map from 'localRequest.IDRichiestaOLO' to 'Asset.IDRichiestaOLO'&#xD;
	if (localRequest != null) {&#xD;
		Asset.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	} else {&#xD;
		Asset.IDRichiestaOLO = null;&#xD;
	}&#xD;
&#xD;
	// Map from 'localRequest.ordine.IDRisorsa' to 'Asset.IDRisorsa'&#xD;
	if (localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.IDRisorsa!= null) {&#xD;
		Asset.IDRisorsa = localRequest.ordine.IDRisorsa;&#xD;
	} &#xD;
&#xD;
	// Map from 'localRequest.IDRisorsaCorrelato' to 'Asset.IDRisorsaCorrelato'&#xD;
	if (localRequest != null) {&#xD;
		Asset.IDRisorsaCorrelato = localRequest.IDRisorsaCorrelato;&#xD;
	} else {&#xD;
		Asset.IDRisorsaCorrelato = null;&#xD;
	}&#xD;
&#xD;
	// Map from 'localRequest.ordine.IDRisorsaNOW' to 'Asset.IDRisorsaNOW'&#xD;
	if (localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.IDRisorsaNOW!= null) {&#xD;
		Asset.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
	}&#xD;
&#xD;
