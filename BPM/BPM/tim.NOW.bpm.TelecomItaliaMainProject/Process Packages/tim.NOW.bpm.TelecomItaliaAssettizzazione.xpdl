        <xpdl2:Activity Id="_TMyFkUE6EeekX-brtRDFQQ" Name="GestionevariazioniconSottolavorazioniParticolari" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Gestione variazioni con Sottolavorazioni Particolari">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_iQNloNyjEea-L-dywrCoeA" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="Asset">
                  <xpdl2:Actual ScriptGrammar="JavaScript">Asset</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="AssetCessatiList">
                  <xpdl2:Actual ScriptGrammar="JavaScript">AssetCessatiTemp</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="AssetModificatiList">
                  <xpdl2:Actual ScriptGrammar="JavaScript">AssetModificatiTemp</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="142.0" LaneId="_TMyF3UE6EeekX-brtRDFQQ" Width="230.0">
              <xpdl2:Coordinates XCoordinate="4247.0" YCoordinate="448.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(AssetModificatiTemp!=null &amp;&amp; AssetModificatiTemp.size()>0){&#xD;
	AssetModificatiList.addAll(ScriptUtil.copyAll(AssetModificatiTemp));&#xD;
}&#xD;
if(AssetCessatiTemp!=null &amp;&amp; AssetCessatiTemp.size()>0){&#xD;
	AssetCessatiList.addAll(ScriptUtil.copyAll(AssetCessatiTemp));&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_TMyFkkE6EeekX-brtRDFQQ" Name="CheckGestioniParticolari" xpdExt:DisplayName="CheckGestioniParticolari">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_TMyFt0E6EeekX-brtRDFQQ"/>
                  <xpdl2:TransitionRef Id="_TMyFpkE6EeekX-brtRDFQQ"/>
                  <xpdl2:TransitionRef Id="_J9gQELinEee1INIgYaPcTw"/>
                  <xpdl2:TransitionRef Id="_B0DikDP_Eei2e9dyLHNFPw"/>
                  <xpdl2:TransitionRef Id="_Oo5rgJOPEeq0BLebgjpy0g"/>
                  <xpdl2:TransitionRef Id="_AC1dQNAxEeuG2al4m3GfCA"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="45.0" LaneId="_TMyF3UE6EeekX-brtRDFQQ" Width="43.0">
              <xpdl2:Coordinates XCoordinate="4547.0" YCoordinate="240.0"/>
