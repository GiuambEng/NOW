        <xpdl2:Activity Id="_RWTb0AmeEeeUksmJDqRw4Q" Name="CessaassetNPperAzioneD" xpdExt:Visibility="Private" xpdExt:DisplayName="Cessa asset NP per Azione D">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//TBD&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
var AssetIDConsistenzaFonia = 0;&#xD;
AssetIDConsistenzaFonia = null;&#xD;
var AssetIDConsistenzaDati = 0;&#xD;
AssetIDConsistenzaDati = null;&#xD;
&#xD;
//cerco id asset di consistenza dati e fonia per migrazioni&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
                    || localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274)&#xD;
{                   &#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		   var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		   // CERCO ID ASSET CONSISTENZA FONIA&#xD;
		   if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA &amp;&amp; comp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		   {&#xD;
				 &#xD;
				 var j=0;&#xD;
				 &#xD;
				 while(AssetIDConsistenzaFonia == null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size())&#xD;
				 {&#xD;
						var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
						if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
						{&#xD;
							  if(!isNaN(attr.valoreAttributo))&#xD;
							  {&#xD;
									 AssetIDConsistenzaFonia = ScriptUtil.createBigInteger(attr.valoreAttributo);&#xD;
									 Process.auditLog(&quot;Consistenza fonia da cessare con IdAsset &quot;+AssetIDConsistenzaFonia);&#xD;
							  }&#xD;
						}      &#xD;
						j++;&#xD;
				 }&#xD;
		   }&#xD;
		   &#xD;
		   //CERCO ID ASSET CONSISTENZA DATI&#xD;
		   if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI &amp;&amp; comp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		   {&#xD;
&#xD;
				 var j=0;&#xD;
				 &#xD;
				 while(AssetIDConsistenzaDati == null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size())&#xD;
				 {&#xD;
						var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
						if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
						{&#xD;
							  if(!isNaN(attr.valoreAttributo))&#xD;
							  {&#xD;
									 AssetIDConsistenzaDati = ScriptUtil.createBigInteger(attr.valoreAttributo);&#xD;
									 Process.auditLog(&quot;Consistenza dati da cessare con IdAsset &quot;+AssetIDConsistenzaDati);&#xD;
							  }&#xD;
						}      &#xD;
						j++;&#xD;
				 }&#xD;
		   }&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
       var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
       if(comp.nomeComponente== it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY &amp;&amp;&#xD;
             (((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
                    || localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274) &#xD;
                    &amp;&amp; comp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
             ||&#xD;
             comp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D))&#xD;
       {&#xD;
             var AssetID = 0;&#xD;
             AssetID = null;&#xD;
             var numeroTelefonico = &quot;&quot;;&#xD;
             numeroTelefonico = null;&#xD;
             &#xD;
             var j=0;&#xD;
             while((AssetID == null || numeroTelefonico == null) &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
                    var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
                    if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET){&#xD;
                          if(!isNaN(attr.valoreAttributo)){&#xD;
                                 AssetID = ScriptUtil.createBigInteger(attr.valoreAttributo);&#xD;
                          }&#xD;
                    }&#xD;
                    else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO){&#xD;
                          &#xD;
                          numeroTelefonico = attr.valoreAttributo;&#xD;
                          Process.auditLog(&quot;Numero telefonico NP &quot;+numeroTelefonico);&#xD;
                          &#xD;
                    }&#xD;
                    j++;&#xD;
             }&#xD;
             if(AssetID!= null || numeroTelefonico!= null)&#xD;
             {&#xD;
                    if(AssetID!= null){&#xD;
                          assetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(AssetID));&#xD;
                          assetTemp = assetRef.readAsset();&#xD;
                    }&#xD;
                    else&#xD;
                    {&#xD;
                          var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico = :NT AND statoAsset &lt;> 'CESSATO' AND offerta = 'NP'&quot;);&#xD;
                          c.setQueryParameter(&quot;NT&quot;,numeroTelefonico);&#xD;
                          var assetRetTemp = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
                          &#xD;
                          if ((assetRetTemp==null || assetRetTemp.size() ==0) &#xD;
                                 &amp;&amp; localRequest.lavorazione==it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &#xD;
                                 &amp;&amp; localRequest.codificaOLOAGCOM ==&quot;TLC&quot; &amp;&amp; &#xD;
                                 (String(offertaDonatingFonia).slice(0,3) == &quot;WLR&quot; || String(offertaDonatingFonia).slice(0,4) == &quot;VULL&quot;))&#xD;
                          {&#xD;
                                 Process.auditLog(&quot;Rientro in TI con donating WLR/VULL&quot;);&#xD;
                          }&#xD;
                          else if(assetRetTemp!=null &amp;&amp; assetRetTemp.size()>0)&#xD;
                          {&#xD;
                          		 assetRef = assetRetTemp.get(0);&#xD;
                          		 assetTemp = assetRef.readAsset();&#xD;
                          }&#xD;
                          else&#xD;
                          {&#xD;
                                 Process.auditLog(&quot;Nessun asset NP recuperato&quot;);&#xD;
                                 assetTemp=null;&#xD;
                          		 assetRef=null;&#xD;
                          }&#xD;
                    }&#xD;
                    &#xD;
                    &#xD;
                    // Escludo gli asset NP appena creati&#xD;
                    if(AssetRefAggiuntivi.contains(assetRef))&#xD;
                    {&#xD;
                          Process.auditLog(&quot;Asset NP appena creato con ID &quot;+assetTemp.IDAsset);&#xD;
                          assetTemp=null;&#xD;
                          assetRef=null;&#xD;
                    }&#xD;
                    &#xD;
                    &#xD;
                    var IDAssetNP=&quot;&quot;;&#xD;
                    IDAssetNP= null;&#xD;
                    if (assetTemp!=null)&#xD;
                    {&#xD;
                          IDAssetNP = ScriptUtil.createBigInteger(assetTemp.IDAsset);&#xD;
                          Process.auditLog(&quot;ID Asset NP: &quot;+String(IDAssetNP));&#xD;
                          assetTemp.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
                          assetTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
                          assetTemp.lastUpdate = date;&#xD;
                          assetTemp.DES =localRequest.ordine.DES;&#xD;
                          assetTemp.ORA_DES =localRequest.ordine.ORA_DES;&#xD;
                          assetTemp.codiceOrdineOLO  =localRequest.ordine.codiceOrdineOLO;&#xD;
                          assetTemp.codiceOrdineTI =localRequest.ordine.codiceOrdineTI;&#xD;
                          for(var j=0; j&lt;assetTemp.dettaglioasset.size(); j++)&#xD;
                          {&#xD;
                                 assetTemp.dettaglioasset.get(j).statoDettaglioAsset = assetTemp.statoAsset;&#xD;
                                 assetTemp.dettaglioasset.get(j).lastUpdate = date;&#xD;
                          }&#xD;
                          if(AssetRefDaCessare!=null &amp;&amp; AssetRefDaCessare.size()>0 &amp;&amp; AssetRefDaCessare.contains(assetRef))&#xD;
                          {&#xD;
                                 Process.auditLog(&quot;Asset già presente nella lista dei cancellati&quot;);&#xD;
                          }&#xD;
                          else&#xD;
                          {&#xD;
                                 AssetCessati.add(ScriptUtil.copy(assetTemp));&#xD;
                                 AssetRefDaCessare.add(assetRef);&#xD;
                          }&#xD;
                    }&#xD;
             }&#xD;
			 &#xD;
    // MIGRAZIONE CON NP SINCRONIZZATA &#xD;
	if ((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &#xD;
		  || localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274)&#xD;
	      &amp;&amp; numeroTelefonico!= null &amp;&amp; IDAssetNP!= null)&#xD;
	{&#xD;
			   &#xD;
	    //  verifico se NUMBER PORTABILITY con Azione=D  è legata ad un accesso&#xD;
	   &#xD;
	    var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;(numeroTelefonico = :NT OR IDRisorsa =: NT) AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta IN ('ULLLINEAATTIVANP', 'ULLDATILINEAATTIVANP', 'SLULINEAATTIVANP')&quot;);&#xD;
	    c.setQueryParameter(&quot;NT&quot;,numeroTelefonico);&#xD;
	   &#xD;
	    assetTemp = null;&#xD;
	    assetRef = null;&#xD;
	    var CodOLOAGCOMAccesso = &quot;&quot;;&#xD;
	    var numeroTelefonicoAccesso= &quot;&quot;;&#xD;
	   &#xD;
	    var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	    if (result != null &amp;&amp; result.size() > 0)&#xD;
	    {&#xD;
			 assetRef = result.get(0);&#xD;
			 assetTemp = assetRef.readAsset();&#xD;
			 CodOLOAGCOMAccesso = assetTemp.codificaOLOAGCOM;&#xD;
			 numeroTelefonicoAccesso = assetTemp.numeroTelefonico;&#xD;
			 Process.auditLog(&quot;Trovato accesso con IdAsset &quot;+String(assetTemp.IDAsset)+&quot; e codificaOLOAGCOM &quot;+CodOLOAGCOMAccesso+&quot; e numeroTelefonicoAccesso &quot;+numeroTelefonicoAccesso);&#xD;
	    }&#xD;
	   &#xD;
	    //SM_8184: se l'accesso in asset è stato appena creato non eseguire il controllo per TBUNDLE&#xD;
	    if(assetTemp != null &amp;&amp; assetTemp.IDPrimoOrdine != localRequest.IDRichiestaOLO)&#xD;
	    {&#xD;
		    //Verifico se l'accesso a cui è legata l'NP con azione D è oggetto di migrazione (ovvero se l'assetTemp appena trovato è uguale a consistenza fonia/dati nell'ordine)&#xD;
		    //se non è oggetto di migrazione verfico a quale accesso l'NP era precedentemente legata tramite NUMERAZIONE PRINCIPALE&#xD;
		&#xD;
		    if(CodOLOAGCOMAccesso!= &quot;&quot; &amp;&amp; (assetTemp.IDAsset !=  AssetIDConsistenzaDati  &amp;&amp;  assetTemp.IDAsset != AssetIDConsistenzaFonia) &amp;&amp; numeroTelefonicoAccesso!=&quot;&quot;)&#xD;
		    {&#xD;
				 var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;dettaglioasset.attributidettaglioasset.nomeAttributo = 'NUMEROTELEFONICOPRINCIPALE' AND dettaglioasset.attributidettaglioasset.valoreAttributo =:NT AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta = 'NP' and codificaOLOAGCOM = :codificaOLOAGCOM and IDAsset &lt;> :idAssetNP&quot;);&#xD;
				 &#xD;
				 criteria.setQueryParameter(&quot;NT&quot;,numeroTelefonicoAccesso);&#xD;
				 criteria.setQueryParameter(&quot;idAssetNP&quot;,IDAssetNP);&#xD;
				 criteria.setQueryParameter(&quot;codificaOLOAGCOM&quot;,CodOLOAGCOMAccesso);&#xD;
				 &#xD;
				 var resultNP = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
				 Process.auditLog(&quot;Trovati ulteriori &quot;+String(resultNP.size())+&quot; asset NP in bundle&quot;);&#xD;
				 &#xD;
				 if (resultNP == null || resultNP.size() == 0)&#xD;
				 {&#xD;
					// cambio BUNDLE DELL'ASSET TEMP con offerte ULL-SLU-ULLD + NP PRECEDENTEMENTE TROVATO&#xD;
					IdAssetPerIndotti.add(assetTemp.IDAsset);&#xD;
					Process.auditLog(&quot;Da creare TBUNDLE per IdAsset &quot;+String(assetTemp.IDAsset));&#xD;
				 }      &#xD;
		    }&#xD;
			else&#xD;
			{&#xD;
				Process.auditLog(&quot;Asset Accesso oggetto di migrazione&quot;);&#xD;
			}&#xD;
	     }&#xD;
		 else&#xD;
		 {&#xD;
			Process.auditLog(&quot;Asset Accesso non trovato o appena creato&quot;);&#xD;
		 }&#xD;
	  }&#xD;
   }&#xD;
&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="120.0" LaneId="_EVDa9tjpEeag_e2OckmEJw" Width="96.0">
              <xpdl2:Coordinates XCoordinate="3598.0" YCoordinate="168.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_4GIJUAmjEeec-bmBz7WnhQ" Name="EmbeddedSubProcess2" xpdExt:DisplayName="Embedded Sub-Process 2">
          <xpdl2:BlockActivity xpdExt:IsEventSubProcess="false" ActivitySetId="_4GIJUQmjEeec-bmBz7WnhQ" View="EXPANDED"/>
          <xpdl2:DataFields>
            <xpdl2:DataField Id="_AIUeIQmkEeec-bmBz7WnhQ" xpdExt:DisplayName="AssetCessato" Name="AssetCessato" ReadOnly="false">
              <xpdl2:DataType>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
              </xpdl2:DataType>
              <xpdl2:InitialValue/>
            </xpdl2:DataField>
            <xpdl2:DataField Id="_EXzWUQmkEeec-bmBz7WnhQ" xpdExt:DisplayName="AssetRefCessato" Name="AssetRefCessato" ReadOnly="false">
              <xpdl2:DataType>
                <xpdl2:RecordType>
                  <xpdl2:Member>
                    <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
                  </xpdl2:Member>
                </xpdl2:RecordType>
              </xpdl2:DataType>
              <xpdl2:InitialValue/>
            </xpdl2:DataField>
