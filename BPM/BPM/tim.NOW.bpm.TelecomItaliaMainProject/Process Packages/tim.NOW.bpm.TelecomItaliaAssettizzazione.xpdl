    <xpdl2:WorkflowProcess Id="_d7XEUjQnEei2e9dyLHNFPw" xpdExt:DisplayName="TINOW-CreaAssetRicarica" Name="TINOWCreaAssetRicarica">
      <xpdl2:ProcessHeader/>
      <xpdl2:FormalParameters>
        <xpdl2:FormalParameter Id="_d7XEYDQnEei2e9dyLHNFPw" Name="localRequest" Mode="INOUT" Required="false" xpdExt:DisplayName="localRequest">
