            <xpdl2:Activity Id="_8_3pUEjREeqiG95yd6Fgsg" Name="VerificaassetCPSprincipalecessato" xpdExt:DisplayName="Verifica asset CPS principale cessato">
              <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
