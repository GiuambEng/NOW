					&amp;&amp; AssetConsistenzaCPSMulti != null &#xD;
					&amp;&amp; AssetConsistenzaCPSMulti.size()>0&#xD;
					&amp;&amp; !CPScessate)&#xD;
					{&#xD;
						for(var index = 0; index &lt; AssetConsistenzaCPSMulti.size(); index++)&#xD;
						{&#xD;
							AssetConsistenzaCPS = ScriptUtil.copy(AssetConsistenzaCPSMulti.get(index)); //preleva i-esimo asset&#xD;
							&#xD;
							AssetConsistenzaCPS.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
							AssetConsistenzaCPS.codiceOrdineOLO = localRequest.codiceOrdineOLO; //SM_9074 - commentata come da Mail - SM_9645 - decommentata come da mail&#xD;
							AssetConsistenzaCPS.codiceOrdineTI = localRequest.codiceOrdineTI; //SM_9074 - commentata come da Mail - SM_9645 - decommentata come da mail&#xD;
							&#xD;
							var DESTemp = DateTimeUtil.createDate(localRequest.ordine.DES);&#xD;
