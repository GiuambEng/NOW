        <xpdl2:Activity Id="_TMyFfkE6EeekX-brtRDFQQ" Name="MappingBITSTREAMASIM" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Mapping BITSTREAM ASIM">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//RU_1371: nel caso di INDOTTE TCOND_NAKED in cui il TIPOLINEA del precedente asset è ISDN, VCISP e VPISP non arrivano da DTU (in DTUDATIVC) ma vanno assettizzati prendendoli dalla ATMVC. A sua volta nella ATMVC sono stati ribaltati (durante l'arricchimento della richiesta indotta) dalla ATMVC dell'asset precedente.&#xD;
var idAssetIndotta = &quot;&quot;;&#xD;
idAssetIndotta = null;&#xD;
var tipoLineaAsset = &quot;&quot;;&#xD;
tipoLineaAsset = null;&#xD;
&#xD;
if(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL&#xD;
   &amp;&amp; localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot;&#xD;
   &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
       || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
	   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE))&#xD;
{	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
		{&#xD;
			for(var j=0; j &lt; componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					idAssetIndotta = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;IDENTIFICATIVOASSET: &quot;+idAssetIndotta);&#xD;
				}&#xD;
			}	&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(idAssetIndotta != null)&#xD;
	{&#xD;
		AssetIndottaRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(idAssetIndotta));&#xD;
		AssetIndotta = AssetIndottaRef.readAsset();&#xD;
		&#xD;
		if(AssetIndotta != null)&#xD;
		{	&#xD;
			i=0;&#xD;
			while(tipoLineaAsset == null &amp;&amp; i &lt; AssetIndotta.dettaglioasset.size())&#xD;
			{&#xD;
				var comp = AssetIndotta.dettaglioasset.get(i);&#xD;
				if(String(comp.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var j=0;&#xD;
					while(tipoLineaAsset == null &amp;&amp; j &lt; comp.attributidettaglioasset.size())&#xD;
					{&#xD;
						if(comp.attributidettaglioasset.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
						{&#xD;
							tipoLineaAsset = comp.attributidettaglioasset.get(j).valoreAttributo;&#xD;
							Process.auditLog(&quot;tipoLineaAsset recuperato: &quot;+tipoLineaAsset);&#xD;
						}					&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
}	&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT)&#xD;
{&#xD;
 	OrdineComponente.add(&quot;ACCESSOATMASIMFLAT&quot;);&#xD;
	OrdineComponente.add(&quot;ACCESSOATMASIMFLAT&quot;);&#xD;
	OrdineComponente.add(&quot;ACCESSOATMASIMFLAT&quot;);&#xD;
	OrdineComponente.add(&quot;ACCESSOATMASIMFLAT&quot;);&#xD;
