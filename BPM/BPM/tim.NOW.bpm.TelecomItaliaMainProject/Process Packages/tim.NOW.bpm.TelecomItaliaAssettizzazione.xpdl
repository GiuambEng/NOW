                <xpdl2:MessageIn Id="_TMyFi0E6EeekX-brtRDFQQ"/>
                <xpdl2:MessageOut Id="_TMyFjEE6EeekX-brtRDFQQ"/>
                <xpdExt:GlobalDataOperation>
                  <xpdExt:CaseReferenceOperations>
                    <xpdExt:CaseRefField>Requestref</xpdExt:CaseRefField>
                    <xpdExt:AddLinkAssociations AddCaseRefField="AssetPrincipaleRef" AssociationName="asset"/>
                  </xpdExt:CaseReferenceOperations>
                </xpdExt:GlobalDataOperation>
              </xpdl2:TaskService>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
