                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;L'Asset in cessazione (Consistenza CPS con azione D) coincide con l'asset principale in variazione&quot;);&#xD;
AssetCessatiList.add(ScriptUtil.copy(AssetConsistenzaCPS));</xpdl2:Script>
