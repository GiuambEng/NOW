              <xpdl2:Coordinates XCoordinate="4888.0" YCoordinate="728.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(AssetCessatiTemp!=null &amp;&amp; AssetCessatiTemp.size()>0){&#xD;
	AssetCessatiList.addAll(ScriptUtil.copyAll(AssetCessatiTemp));&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_-9HZAdMREeq7la06MjxCkQ" Name="MappingVLANGPONCANALEFEEDERSEDEOLTVLANNGAMULTICASTFWAEOLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Mapping VLAN,GPON,CANALE,FEEDER,SEDEOLT,VLANNGAMULTICAST,FWAEOLO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Mapping introdotto con R1I-20-0150&#xD;
