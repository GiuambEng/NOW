									attributoDettaglioAsset.IDDettaglioAsset = dettaglioAsset.IDDettaglioAsset;&#xD;
									attributoDettaglioAsset.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.DATE;&#xD;
									attributoDettaglioAsset.created = ora;&#xD;
									attributoDettaglioAsset.lastUpdate = ora;&#xD;
									if(dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
									{&#xD;
										attributoDettaglioAsset.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAESPLETAMENTOUSERVLAN;&#xD;
									}&#xD;
									else&#xD;
									{&#xD;
										attributoDettaglioAsset.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAESPLETAMENTOVC;&#xD;
									}&#xD;
&#xD;
									attributoDettaglioAsset.operatore = dettaglioAsset.operatore;&#xD;
									attributoDettaglioAsset.valoreAttributo = localRequest.ordine.DES;&#xD;
									dettaglioAsset.attributidettaglioasset.add(ScriptUtil.copy(attributoDettaglioAsset));&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				else if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE) &amp;&amp; (comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS))&#xD;
				{&#xD;
					var codiceSTSOrdine = &quot;&quot;;&#xD;
					codiceSTSOrdine = null;&#xD;
					var t = 0;&#xD;
					while(codiceSTSOrdine== null &amp;&amp; t &lt; comp.attributiDettaglioOrdine.size()){&#xD;
						if(comp.attributiDettaglioOrdine.get(t).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE)&#xD;
						{&#xD;
							codiceSTSOrdine = comp.attributiDettaglioOrdine.get(t).valoreAttributo;&#xD;
						}&#xD;
						t++;&#xD;
					}&#xD;
