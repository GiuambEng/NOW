        <xpdl2:Activity Id="_EUYEYLinEee1INIgYaPcTw" Name="UpdateIDrisorsaCorrelatoSuAssetGenerante" xpdExt:Visibility="Private" xpdExt:DisplayName="Update IDrisorsaCorrelato Su Asset Generante">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: IDRC AND statoAsset = 'ATTIVO' AND tipologiaAccesso = 'FONIA'&quot;);&#xD;
&#xD;
criteria.setQueryParameter(&quot;IDRC&quot;, AssetPrincipale.IDRisorsaCorrelato);&#xD;
&#xD;
var assetRefs = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
&#xD;
if(assetRefs != null &amp;&amp; assetRefs.size() > 0)&#xD;
{&#xD;
	AssetGeneranteRef = assetRefs.get(0);&#xD;
	AssetGenerante = AssetGeneranteRef.readAsset();&#xD;
	&#xD;
	Process.auditLog(&quot;Aggiorno IDRisorsaCorrelato dell'Asset Generante: &quot; + AssetGenerante.IDAsset);&#xD;
	AssetGenerante.IDRisorsaCorrelato = AssetPrincipale.IDRisorsa;&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;WARNING: Nessun Asset recuperato per IDRisorsa = &quot; + AssetPrincipale.IDRisorsaCorrelato + &quot; in STATO ATTIVO e tipologiaAccesso FONIA&quot;);&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="98.0" LaneId="_BUYeIbinEee1INIgYaPcTw" Width="154.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_tg9FALioEee1INIgYaPcTw" Name="UpdateAssetGenerante" xpdExt:Visibility="Private" xpdExt:DisplayName="Update Asset Generante">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="GlobalData" Implementation="Other">
                <xpdl2:MessageIn Id="_vD6skLioEee1INIgYaPcTw"/>
                <xpdl2:MessageOut Id="_vD6skbioEee1INIgYaPcTw"/>
                <xpdExt:GlobalDataOperation>
                  <xpdExt:CaseReferenceOperations>
                    <xpdExt:CaseRefField>AssetGeneranteRef</xpdExt:CaseRefField>
                    <xpdExt:Update FromFieldPath="AssetGenerante"/>
                  </xpdExt:CaseReferenceOperations>
                </xpdExt:GlobalDataOperation>
              </xpdl2:TaskService>
            </xpdl2:Task>
          </xpdl2:Implementation>
