            <xpdl2:Activity Id="_v7AkIOYwEeexotfeLwiaxg" Name="CercoAssetNPdaCessare" xpdExt:Visibility="Private" xpdExt:DisplayName="Cerco Asset NP da Cessare">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">var currentComponenteNUMBERPORTABILITY = ComponenteNUMBERPORTABILITY.get(Process.getActivityLoopIndex());&#xD;
&#xD;
var idRisorsa = &quot;&quot;;&#xD;
idRisorsa = null;&#xD;
var i = 0;&#xD;
&#xD;
while(idRisorsa == null &amp;&amp; i &lt; currentComponenteNUMBERPORTABILITY.attributiDettaglioOrdine.size())&#xD;
{&#xD;
	var currentAtt = currentComponenteNUMBERPORTABILITY.attributiDettaglioOrdine.get(i);&#xD;
	&#xD;
	if(currentAtt.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
	{&#xD;
		idRisorsa = currentAtt.valoreAttributo;&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(idRisorsa != null)&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND offerta = 'NP' AND statoAsset = 'INLAVORAZIONE'&quot;);&#xD;
	criteria.setQueryParameter(&quot;idr&quot;, idRisorsa);&#xD;
	&#xD;
	var assetList = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
	&#xD;
	if(assetList != null &amp;&amp; assetList.size() > 0)&#xD;
	{&#xD;
		var date = DateTimeUtil.createDatetime();&#xD;
		&#xD;
		var AssetNPCessatoRef = assetList.get(0);&#xD;
		var AssetNPCessato = AssetNPCessatoRef.readAsset();&#xD;
		&#xD;
		AssetNPCessato.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
		&#xD;
		AssetNPCessato.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
		AssetNPCessato.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		AssetNPCessato.lastUpdate = date;&#xD;
		AssetNPCessato.DES =localRequest.ordine.DES;&#xD;
		AssetNPCessato.ORA_DES =localRequest.ordine.ORA_DES;&#xD;
		AssetNPCessato.codiceOrdineOLO  =localRequest.ordine.codiceOrdineOLO;&#xD;
		AssetNPCessato.codiceOrdineTI =localRequest.ordine.codiceOrdineTI;&#xD;
		&#xD;
		for(var j=0; j&lt;AssetNPCessato.dettaglioasset.size(); j++)&#xD;
		{&#xD;
			AssetNPCessato.dettaglioasset.get(j).statoDettaglioAsset = AssetNPCessato.statoAsset;&#xD;
			AssetNPCessato.dettaglioasset.get(j).lastUpdate = date;&#xD;
			&#xD;
			for(var k=0; k&lt;AssetNPCessato.dettaglioasset.get(j).attributidettaglioasset.size(); k++)&#xD;
			{			&#xD;
				// SM_8134: eliminazione attributi CAPOSERIE e RADICALE&#xD;
				if(AssetNPCessato.dettaglioasset.get(j).attributidettaglioasset.get(k) == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE)&#xD;
				{&#xD;
					AssetNPCessato.dettaglioasset.get(j).attributidettaglioasset.remove(k);&#xD;
					Process.auditLog('Eliminato attributo CAPOSERIE per asset '+AssetNPCessato.IDAsset);&#xD;
				}&#xD;
				else if(AssetNPCessato.dettaglioasset.get(j).attributidettaglioasset.get(k) == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
				{&#xD;
					AssetNPCessato.dettaglioasset.get(j).attributidettaglioasset.remove(k);&#xD;
					Process.auditLog('Eliminato attributo RADICALE per asset '+AssetNPCessato.IDAsset);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
			&#xD;
		AssetCessati.add(ScriptUtil.copy(AssetNPCessato));&#xD;
		AssetRefDaCessare.add(AssetNPCessatoRef);&#xD;
	}&#xD;
}</xpdl2:Script>
                  </xpdl2:TaskScript>
                </xpdl2:Task>
              </xpdl2:Implementation>
