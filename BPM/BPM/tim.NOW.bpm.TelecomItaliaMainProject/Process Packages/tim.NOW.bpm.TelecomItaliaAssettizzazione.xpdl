          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">Process.auditLog(&quot;Aggiorna consistenza fonia: &quot;+AssetConsistenzaFonia.IDAsset);&#xD;
&#xD;
// Bug #26220 - Per NP SU AGG X non vanno messi in AssetModificati, la gestione dell'arrayList è successiva, in Lavorazioni Particolari NP&#xD;
if(localRequest.tipologiaScenario != it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUAGGWLR)&#xD;
{&#xD;
   if(AssetConsistenzaFonia.statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)&#xD;
   {&#xD;
	   AssetCessatiList.add(ScriptUtil.copy(AssetConsistenzaFonia));&#xD;
   }&#xD;
   else&#xD;
   {&#xD;
	   AssetModificatiList.add(ScriptUtil.copy(AssetConsistenzaFonia));&#xD;
   }&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Scenario &quot;+localRequest.tipologiaScenario+&quot;, saltata gestione ArrayList AssetModificati/Cessati&quot;);&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
