					// RU_1180&#xD;
					else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAVLANMULTICAST &amp;&amp; AssetConsistenzaVLANMulticast != null)&#xD;
					{&#xD;
