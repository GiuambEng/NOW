        <xpdl2:Activity Id="_RpLUj9mOEeaB-6lC68ZgcA" Name="RecuperaoccorrenzeISDN" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupera occorrenze ISDN">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">localRequestTemp = ScriptUtil.copy(localRequest);

var numeroTelefonicoPrincipale =&quot;&quot;;
offertaDonatingFonia=&quot;&quot;;
if(localRequest.ordine!= null)
{
	var i =0;
	while (i&lt;localRequest.ordine.dettaglioordine.size()) 
	{
		var componente = localRequest.ordine.dettaglioordine.get(i);
		
		if((componente.nomeComponente== it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY
			|| componente.nomeComponente== it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMERIAGGIUNTIVI)
			&amp;&amp; componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A){
			var j=0;
			var numero =&quot;&quot;;
			var numeroTrovato = false;
			var donor =&quot;&quot;;
			var donorTrovato = false;
			
			while((!numeroTrovato || !donorTrovato) &amp;&amp;j&lt;componente.attributiDettaglioOrdine.size())
			{
				var attributo = componente.attributiDettaglioOrdine.get(j);
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO){
					numero = attributo.valoreAttributo;
					numeroTrovato=true;
				}
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR){
					donor = attributo.valoreAttributo;
					donorTrovato=true;
				}
				j++;
			}
			
			
			if(donor==&quot;TLC&quot; &amp;&amp; numeroTrovato){
				ISDN_NumeriTelefoniciAggiuntivi.add(numero);
				ComponenteNUMBERPORTABILITY.add(ScriptUtil.copy(componente));
				
			}
			else{
				Process.auditLog(&quot;Non è presente l'elemento NUMEROTELEFONICO oppure l'elemento STATO della componente NUMBERPORTABILITY, oppure donor = TLC ID: &quot;+ componente.IDDettaglioOrdine);
			}
		}
		if(componente.nomeComponente==it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA
			&amp;&amp; componente.azione==it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)
		{
			var k=0;
			var offertaDonatingFoniaTemp=&quot;&quot;;
			while(offertaDonatingFoniaTemp==&quot;&quot; &amp;&amp; k&lt;componente.attributiDettaglioOrdine.size())
			{
				var attributo = componente.attributiDettaglioOrdine.get(k);
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)
				{
					offertaDonatingFoniaTemp=attributo.valoreAttributo;
				}
				k++;
			}
			offertaDonatingFonia=offertaDonatingFoniaTemp;
		}	
		i++;
	}
}


</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
