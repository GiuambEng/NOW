        <xpdl2:Activity Id="_lLdcsJxGEeqRc4FUkabAww" Name="ConfigurazioneMappingNP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Configurazione Mapping NP">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var skipOLORETAILER = false;&#xD;
&#xD;
if(localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP&#xD;
|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUULLNP&#xD;
|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUULLDNP&#xD;
|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUSLUNP)&#xD;
{&#xD;
	skipOLORETAILER = true;&#xD;
}&#xD;
&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP)&#xD;
{&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	/*OrdineComponente.add(&quot;NUMERIAGGIUNTIVI&quot;); //SM_8493&#xD;
	OrdineComponente.add(&quot;NUMERIAGGIUNTIVI&quot;);&#xD;
	OrdineComponente.add(&quot;NUMERIAGGIUNTIVI&quot;);*/&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	if(!skipOLORETAILER)&#xD;
	{&#xD;
		OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	}&#xD;
	OrdineComponente.add(&quot;NUMBERPORTABILITY&quot;);&#xD;
	&#xD;
	&#xD;
	OrdineAttributo.add(&quot;TIPONUMERO&quot;);&#xD;
	OrdineAttributo.add(&quot;TOTALEAGGIUNTIVI&quot;);&#xD;
	OrdineAttributo.add(&quot;PORTABILITASUCCESSIVA&quot;);&#xD;
	OrdineAttributo.add(&quot;DISTRETTO&quot;);&#xD;
	OrdineAttributo.add(&quot;TIPOSERVIZIO&quot;);&#xD;
	OrdineAttributo.add(&quot;RIENTROTI&quot;);&#xD;
	OrdineAttributo.add(&quot;NUMEROTELEFONICO&quot;);&#xD;
	OrdineAttributo.add(&quot;ROUTINGNUMBER&quot;);&#xD;
	OrdineAttributo.add(&quot;TIPOLINEANP&quot;);&#xD;
	OrdineAttributo.add(&quot;FLAGNUMERAZIONIAGGIUNTIVE&quot;);&#xD;
	OrdineAttributo.add(&quot;RADICALE&quot;);&#xD;
	OrdineAttributo.add(&quot;CAPOSERIE&quot;);&#xD;
