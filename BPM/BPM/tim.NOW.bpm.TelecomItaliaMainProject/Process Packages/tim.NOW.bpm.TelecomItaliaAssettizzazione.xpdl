        <xpdl2:Activity Id="_9-u9IImLEeavwoK7-WzvaQ" Name="Recuperaregliasstedaggiornarliseesistono" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Recuperare gli asst ed aggiornarli se esistono">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var idRisorsaDaCessare =&quot;&quot;;&#xD;
idRisorsaDaCessare = null;&#xD;
var assetDaCessare = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetDaCessare = null;&#xD;
var assetDaCessareRef = &quot;&quot;;&#xD;
assetDaCessareRef = null;&#xD;
&#xD;
var data = DateTimeUtil.createDatetime();&#xD;
&#xD;
//recupero IDRISORSA e NUMEROTELEFONICO dalla componente NUMBERPORTABILITY con azione D&#xD;
&#xD;
	var i=0;&#xD;
	while(idRisorsaDaCessare == null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			var j=0;&#xD;
			while(idRisorsaDaCessare == null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				//if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					idRisorsaDaCessare= attr.valoreAttributo;&#xD;
				}&#xD;
			&#xD;
				j++;&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}&#xD;
&#xD;
&#xD;
//Recupero l'asset da cessare&#xD;
if(idRisorsaDaCessare != null)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa = :IDR AND offerta = 'NP' AND (statoAsset = 'ATTIVO' OR statoAsset = 'INLAVORAZIONE')&quot;);&#xD;
	c.setQueryParameter(&quot;IDR&quot;,idRisorsaDaCessare);&#xD;
	if(Asset != null){&#xD;
		c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa = :IDR AND offerta = 'NP' and IDAsset != :IDA AND (statoAsset = 'ATTIVO' OR statoAsset = 'INLAVORAZIONE')&quot;);&#xD;
		c.setQueryParameter(&quot;IDR&quot;,idRisorsaDaCessare);&#xD;
		c.setQueryParameter(&quot;IDA&quot;,ScriptUtil.createBigInteger(Asset.IDAsset));&#xD;
	}&#xD;
	&#xD;
	var assets = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(assets==null || assets.size()==0)&#xD;
	{&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;dettaglioasset.attributidettaglioasset.nomeAttributo = 'RADICALE' AND dettaglioasset.attributidettaglioasset.valoreAttributo=:DN AND statoAsset &lt;> 'CESSATO' AND offerta = 'NP'&quot;);&#xD;
		c.setQueryParameter(&quot;DN&quot;, idRisorsaDaCessare);&#xD;
		if(Asset != null)&#xD;
		{&#xD;
			c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;dettaglioasset.attributidettaglioasset.nomeAttributo = 'RADICALE' AND dettaglioasset.attributidettaglioasset.valoreAttributo=:DN AND statoAsset &lt;> 'CESSATO' AND offerta = 'NP' AND IDAsset != :IDA&quot;);&#xD;
			c.setQueryParameter(&quot;DN&quot;,idRisorsaDaCessare);&#xD;
			c.setQueryParameter(&quot;IDA&quot;,ScriptUtil.createBigInteger(Asset.IDAsset));&#xD;
		}&#xD;
		assets = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	}&#xD;
	&#xD;
	var i = 0;&#xD;
	while(assetDaCessare == null &amp;&amp; i &lt; assets.size())&#xD;
	{&#xD;
		var assetTemp = assets.get(i).readAsset();&#xD;
		if((Asset!= null &amp;&amp; Asset.IDAsset != assetTemp.IDAsset) || (Asset == null))&#xD;
		{&#xD;
			assetDaCessare = assetTemp;&#xD;
			assetDaCessare.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
			for(var j=0; j &lt; assetDaCessare.dettaglioasset.size(); j++)&#xD;
			{&#xD;
				assetDaCessare.dettaglioasset.get(j).statoDettaglioAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
				assetDaCessare.dettaglioasset.get(j).lastUpdate = data;&#xD;
			}&#xD;
			assetDaCessare.DES = localRequest.ordine.DES;&#xD;
			assetDaCessare.ORA_DES = localRequest.ordine.ORA_DES;&#xD;
			assetDaCessare.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			assetDaCessare.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
			assetDaCessare.codiceOrdineTI = localRequest.codiceOrdineTI;&#xD;
			assetDaCessare.lastUpdate = data;&#xD;
			&#xD;
			AssetCessati.add(assetDaCessare);&#xD;
			AssetRefCessati.add(assets.get(i));&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Nessuna IDRisorsa presente nella componente NP da cessare&quot;);&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
if(assetDaCessare!=null)&#xD;
{	&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numTelPrincipale = :numTel AND numeroTelefonico != :numero AND offerta = 'NP' AND (statoAsset = 'ATTIVO' OR statoAsset = 'INLAVORAZIONE')&quot;);&#xD;
	c.setQueryParameter(&quot;numTel&quot;,idRisorsaDaCessare);&#xD;
	c.setQueryParameter(&quot;numero&quot;,idRisorsaDaCessare);&#xD;
	var assets = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
&#xD;
	for(var i = 0; i &lt; assets.size(); i++)&#xD;
	{&#xD;
		assetRef = assets.get(i);&#xD;
		var assetNP = assetRef.readAsset();&#xD;
		var NPtrovata = false;&#xD;
		&#xD;
		if(((Asset != null &amp;&amp; assetNP.IDAsset != Asset.IDAsset) || (Asset == null)) &amp;&amp; (assetNP.IDAsset != assetDaCessare.IDAsset))&#xD;
		{&#xD;
			assetNP.numTelPrincipale = assetNP.numeroTelefonico;&#xD;
			assetNP.lastUpdate = data;&#xD;
			&#xD;
			var j=0;&#xD;
			&#xD;
			while(!NPtrovata &amp;&amp; j&lt;assetNP.dettaglioasset.size())&#xD;
			{&#xD;
				var dettaglio = assetNP.dettaglioasset.get(j);&#xD;
				&#xD;
				if(dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
				{&#xD;
					var k = 0;&#xD;
					NPtrovata = true;&#xD;
					&#xD;
					while(k &lt; dettaglio.attributidettaglioasset.size())&#xD;
					{&#xD;
						if(dettaglio.attributidettaglioasset.get(k).nomeAttributo== it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE)&#xD;
						{&#xD;
							dettaglio.attributidettaglioasset.get(k).valoreAttributo = assetNP.numeroTelefonico;&#xD;
							dettaglio.lastUpdate = data;&#xD;
						}&#xD;
						//Bug #22640: eliminazione attributi CAPOSERIE e RADICALE&#xD;
						else if(dettaglio.attributidettaglioasset.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE)&#xD;
						{&#xD;
							dettaglio.attributidettaglioasset.remove(k);&#xD;
							Process.auditLog('Eliminato attributo CAPOSERIE per asset '+assetNP.IDAsset);&#xD;
						}&#xD;
						else if(dettaglio.attributidettaglioasset.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
						{&#xD;
							dettaglio.attributidettaglioasset.remove(k);&#xD;
							Process.auditLog('Eliminato attributo RADICALE per asset '+assetNP.IDAsset);&#xD;
						}						&#xD;
						k++;&#xD;
					}&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			AssetRefList.add(assetRef);&#xD;
			AssetList.add(ScriptUtil.copy(assetNP));&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="96.0" LaneId="_cme6lIfAEeaRRPusWE612A" Width="122.0">
              <xpdl2:Coordinates XCoordinate="709.0" YCoordinate="765.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_Mlmf4ImMEeavwoK7-WzvaQ" Name="Recuperagliassetedaggiornalostato" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Recupera gli asset ed aggiorna lo stato">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest.ordine!= null)&#xD;
{&#xD;
	for(var i =0; i&lt;localRequest.ordine.dettaglioordine.size(); i++) &#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente== it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMERIAGGIUNTIVIOLO)&#xD;
		{&#xD;
			var j=0;&#xD;
			var numero =&quot;&quot;;&#xD;
			var numeroTrovato = false;&#xD;
			&#xD;
			while(!numeroTrovato &amp;&amp;j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					numero = attributo.valoreAttributo;&#xD;
					numeroTrovato = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(numeroTrovato)&#xD;
			{&#xD;
				var c1 = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico = :numeroTelefonico&quot;);&#xD;
				c1.setQueryParameter(&quot;numeroTelefonico&quot;,numero);		&#xD;
				var assetReference = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c1);&#xD;
				&#xD;
				for(var z=0; z&lt;assetReference.size(); z++)&#xD;
				{&#xD;
					var assetV = assetReference.get(i).readAsset();&#xD;
					var j=0;&#xD;
					var correlato = false;&#xD;
					&#xD;
					while(!correlato &amp;&amp; j&lt;assetV.dettaglioasset.size())&#xD;
					{&#xD;
						var dettaglio = assetV.dettaglioasset.get(j);&#xD;
						if(dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
						{&#xD;
							var k=0;&#xD;
							&#xD;
							while(!correlato &amp;&amp; k&lt;dettaglio.attributidettaglioasset.size())&#xD;
							{&#xD;
								var attributo = dettaglio.attributidettaglioasset.get(k);&#xD;
								if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE &amp;&amp; attributo.valoreAttributo == localRequest.numeroTelefonico)&#xD;
								{&#xD;
									correlato=true;&#xD;
								}&#xD;
								k++;&#xD;
							}&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
					&#xD;
					if(correlato)&#xD;
					{&#xD;
						assetV.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
						AssetList.add(ScriptUtil.copy(assetV));&#xD;
						AssetRefList.add(assetReference.get(i));&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
// ******* SM_8467 - recupero gli aggiuntivi legati alla NP cessata, modificato NUMTELPRINCIPALE con se stesso e elimino CAPOSERIE E RADICALE *******&#xD;
&#xD;
var c2 = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numTelPrincipale = :numeroTelefonicoP AND numeroTelefonico &lt;> :numeroTelefonico&quot;);&#xD;
c2.setQueryParameter(&quot;numeroTelefonicoP&quot;,localRequest.ordine.numeroTelefonico);	&#xD;
c2.setQueryParameter(&quot;numeroTelefonico&quot;,localRequest.ordine.numeroTelefonico);	&#xD;
var assetReference2 = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c2);&#xD;
&#xD;
Process.auditLog(&quot;Trovati &quot;+String(assetReference2.size())+&quot; aggiuntivi legati alla NP cessata &quot;+localRequest.ordine.numeroTelefonico);&#xD;
&#xD;
&#xD;
if(assetReference2.size()>0)&#xD;
{&#xD;
	for(var i = 0; i &lt; assetReference2.size(); i++)&#xD;
	{&#xD;
		var assetR = assetReference2.get(i);&#xD;
		var assetV = assetR.readAsset();&#xD;
		&#xD;
		assetV.numTelPrincipale = assetV.numeroTelefonico;&#xD;
		&#xD;
		var NPtrovata = false;&#xD;
		&#xD;
		var j = 0;&#xD;
		&#xD;
		while(!NPtrovata &amp;&amp; j &lt; assetV.dettaglioasset.size())&#xD;
		{&#xD;
			var dettaglio = assetV.dettaglioasset.get(j);&#xD;
			&#xD;
			if(dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
				NPtrovata = true;&#xD;
				&#xD;
				for(var k = 0; k &lt; dettaglio.attributidettaglioasset.size(); k++)&#xD;
				{&#xD;
					if(dettaglio.attributidettaglioasset.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE)&#xD;
					{&#xD;
						Process.auditLog(&quot;Aggiuntivo NP &quot;+assetV.numeroTelefonico+&quot;, eliminato legame con &quot;+dettaglio.attributidettaglioasset.get(k).valoreAttributo);&#xD;
						dettaglio.attributidettaglioasset.get(k).valoreAttributo = assetV.numeroTelefonico;&#xD;
					}&#xD;
					else if(dettaglio.attributidettaglioasset.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE)&#xD;
					{&#xD;
						Process.auditLog(&quot;Eliminato attributo &quot;+dettaglio.attributidettaglioasset.get(k).nomeAttributo+&quot; per asset &quot;+assetV.numeroTelefonico);&#xD;
						dettaglio.attributidettaglioasset.remove(k);&#xD;
					}&#xD;
					else if(dettaglio.attributidettaglioasset.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
					{&#xD;
						Process.auditLog(&quot;Eliminato attributo &quot;+dettaglio.attributidettaglioasset.get(k).nomeAttributo+&quot; per asset &quot;+assetV.numeroTelefonico);&#xD;
						dettaglio.attributidettaglioasset.remove(k);&#xD;
					}&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
		AssetRefList.add(assetR);&#xD;
		AssetList.add(ScriptUtil.copy(assetV));&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Nessun asset recuperato per offerta: &quot;+localRequest.offerta+&quot; numeroTelefonico: &quot;+localRequest.ordine.numeroTelefonico);&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="90.0" LaneId="_cme6lIfAEeaRRPusWE612A" Width="142.0">
              <xpdl2:Coordinates XCoordinate="709.0" YCoordinate="992.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_psEDQImNEeavwoK7-WzvaQ" Name="RecuperoTIPOLINEANPRIENTROTI" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupero TIPOLINEANP,RIENTROTI" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var RIENTROTITrovato = false;&#xD;
var TIPOLINEANPTrovato = false;&#xD;
var FLAGNUMERAZIONIAGGIUNTIVETrovato = false;&#xD;
var NUMEROTELEFONICOPRINCIPALETrovato=false;&#xD;
var i=0;&#xD;
while((!RIENTROTITrovato || !TIPOLINEANPTrovato || !FLAGNUMERAZIONIAGGIUNTIVETrovato || !NUMEROTELEFONICOPRINCIPALETrovato) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size()){&#xD;
 &#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
		&#xD;
		var j=0;&#xD;
		&#xD;
		while((!RIENTROTITrovato || !TIPOLINEANPTrovato || !FLAGNUMERAZIONIAGGIUNTIVETrovato || !NUMEROTELEFONICOPRINCIPALETrovato)  &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size()){&#xD;
			&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP){&#xD;
				TIPOLINEANP = attributo.valoreAttributo;&#xD;
				TIPOLINEANPTrovato = true;&#xD;
				Process.auditLog(&quot;Attributo TIPOLINEANP trovato con valore: &quot;+attributo.valoreAttributo);&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUMERAZIONIAGGIUNTIVE){&#xD;
				FLAGNUMERAZIONIAGGIUNTIVE = attributo.valoreAttributo;&#xD;
				FLAGNUMERAZIONIAGGIUNTIVETrovato = true;&#xD;
				Process.auditLog(&quot;Attributo FLAGNUMERAZIONIAGGIUNTIVE trovato con valore: &quot;+attributo.valoreAttributo);&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RIENTROTI){&#xD;
				RIENTROTI = attributo.valoreAttributo;&#xD;
				RIENTROTITrovato = true;&#xD;
				Process.auditLog(&quot;Attributo RIENTROTI trovato con valore: &quot;+attributo.valoreAttributo);&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE){&#xD;
				NUMEROTELEFONICOPRINCIPALE = attributo.valoreAttributo;&#xD;
				NUMEROTELEFONICOPRINCIPALETrovato = true;&#xD;
				Process.auditLog(&quot;Attributo NUMEROTELEFONICOPRINCIPALE trovato con valore: &quot;+attributo.valoreAttributo);&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
