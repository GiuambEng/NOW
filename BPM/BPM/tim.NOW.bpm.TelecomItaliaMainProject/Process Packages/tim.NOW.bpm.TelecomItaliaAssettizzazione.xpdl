&#xD;
    AssetVLANNGAMULTICAST.decommissioning = Asset.decommissioning;    &#xD;
}&#xD;
&#xD;
&#xD;
var data = DateTimeUtil.createDatetime();&#xD;
AssetVLANNGAMULTICAST.created = data;&#xD;
AssetVLANNGAMULTICAST.lastUpdate = data;&#xD;
&#xD;
AssetVLANNGAMULTICAST.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGAMULTICAST;&#xD;
AssetVLANNGAMULTICAST.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
&#xD;
var i = 0;&#xD;
var foundIDRisorsa = false;&#xD;
&#xD;
while(!foundIDRisorsa &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributoComp = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributoComp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
			{&#xD;
				AssetVLANNGAMULTICAST.IDRisorsa =  attributoComp.valoreAttributo;&#xD;
				AssetVLANNGAMULTICAST.IDRisorsaNOW = attributoComp.valoreAttributo;&#xD;
				foundIDRisorsa = true;&#xD;
				Process.auditLog(&quot;Trovato IDRISORSA per VLANNGAMULTICAST &quot;+ attributoComp.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}</xpdl2:Script>
