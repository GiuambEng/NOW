        <xpdl2:Activity Id="_Q8czcJxLEeqRc4FUkabAww" Name="CercaAssetNPdacessare" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Cerca Asset NP da cessare">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
if(localRequest.ordine!= null)&#xD;
{	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++) &#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY&#xD;
		&amp;&amp; componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		{&#xD;
			var j=0;&#xD;
			var idasset = &quot;&quot;;&#xD;
			idasset = null;&#xD;
			var idassetTrovato = false;&#xD;
			&#xD;
			while(!idassetTrovato &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					idasset = attributo.valoreAttributo;&#xD;
					idassetTrovato = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			Process.auditLog(&quot;IDAsset:&quot; + idasset);&#xD;
			&#xD;
			if(idassetTrovato)&#xD;
			{&#xD;
				NPDaCessare.add(idasset);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				Process.auditLog(&quot;Non è presente l'elemento IDENTIFICATIVOASSET della componente NUMBERPORTABILITY ID: &quot;+ componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
for(var k=0; k&lt;NPDaCessare.size(); k++)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset = :IDA AND offerta = 'NP' AND (statoAsset = 'ATTIVO' OR statoAsset = 'INLAVORAZIONE')&quot;);&#xD;
	&#xD;
	c.setQueryParameter(&quot;IDA&quot;,NPDaCessare.get(k));	&#xD;
	var assetReference = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
&#xD;
	Process.auditLog(&quot;Trovata &quot;+String(assetReference.size())+&quot; per la NP da cessare &quot;+NPDaCessare.get(k));&#xD;
&#xD;
&#xD;
	if(assetReference.size()>0)&#xD;
	{&#xD;
		var IDAssetNP = NPDaCessare.get(k);&#xD;
		&#xD;
		assetRef = assetReference.get(0);&#xD;
		var assetTemp = assetRef.readAsset();&#xD;
			&#xD;
		IDAssetNP = ScriptUtil.createBigInteger(assetTemp.IDAsset);&#xD;
		Process.auditLog(&quot;ID Asset NP: &quot;+String(IDAssetNP));&#xD;
			&#xD;
		assetTemp.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
		assetTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		assetTemp.lastUpdate = date;&#xD;
		assetTemp.DES = localRequest.ordine.DES;&#xD;
		assetTemp.ORA_DES = localRequest.ordine.ORA_DES;&#xD;
		assetTemp.codiceOrdineOLO  =localRequest.ordine.codiceOrdineOLO;&#xD;
		assetTemp.codiceOrdineTI =localRequest.ordine.codiceOrdineTI;&#xD;
			&#xD;
		for(var j=0; j&lt;assetTemp.dettaglioasset.size(); j++)&#xD;
		{&#xD;
			assetTemp.dettaglioasset.get(j).statoDettaglioAsset = assetTemp.statoAsset;&#xD;
			assetTemp.dettaglioasset.get(j).lastUpdate = date;&#xD;
		}&#xD;
			&#xD;
		if(AssetRefDaCessare!=null &amp;&amp; AssetRefDaCessare.size()>0 &amp;&amp; AssetRefDaCessare.contains(assetRef))&#xD;
		{&#xD;
			Process.auditLog(&quot;Asset già presente nella lista dei cancellati&quot;);&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			AssetCessati.add(ScriptUtil.copy(assetTemp));&#xD;
			AssetRefDaCessare.add(assetRef);&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Nessun asset recuperato per offerta: &quot;+localRequest.offerta+&quot; ID: &quot;+NPDaCessare.get(k));&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="91.0" LaneId="_cme6lIfAEeaRRPusWE612A" Width="111.0">
              <xpdl2:Coordinates XCoordinate="2439.0" YCoordinate="1442.0"/>
            </xpdl2:NodeGraphicsInfo>
