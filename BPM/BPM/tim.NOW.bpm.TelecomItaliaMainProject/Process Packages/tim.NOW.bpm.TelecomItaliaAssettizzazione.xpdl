        <xpdl2:Activity Id="_TMyFh0E6EeekX-brtRDFQQ" Name="Service" xpdExt:Visibility="Private" xpdExt:DisplayName="Create Asset Case Data">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="GlobalData" Implementation="Other">
                <xpdl2:MessageIn Id="_TMyFiEE6EeekX-brtRDFQQ"/>
                <xpdl2:MessageOut Id="_TMyFiUE6EeekX-brtRDFQQ"/>
                <xpdExt:GlobalDataOperation>
                  <xpdExt:CaseAccessOperations>
                    <xpdExt:CaseClassExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
                    <xpdExt:Create FromFieldPath="Asset" ToCaseRefField="AssetPrincipaleRef"/>
                  </xpdExt:CaseAccessOperations>
                </xpdExt:GlobalDataOperation>
              </xpdl2:TaskService>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="72.0" LaneId="_TMyF3UE6EeekX-brtRDFQQ" Width="106.0">
              <xpdl2:Coordinates XCoordinate="1139.0" YCoordinate="240.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">Asset=AssetPrincipaleRef.readAsset();&#xD;
&#xD;
var id = Asset.IDAsset;&#xD;
&#xD;
for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
{&#xD;
	Asset.dettaglioasset.get(i).IDAsset = id;&#xD;
	&#xD;
	for(var j = 0; j &lt; Asset.dettaglioasset.get(i).attributidettaglioasset.size(); j++)&#xD;
	{&#xD;
		Asset.dettaglioasset.get(i).attributidettaglioasset.get(j).IDAsset = id;&#xD;
	}&#xD;
}&#xD;
&#xD;
//R1F-21-0411&#xD;
IDAssetCreato = String(Asset.IDAsset);&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_TMyFikE6EeekX-brtRDFQQ" Name="LinkAssettoRequest" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Link Asset to Request" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
