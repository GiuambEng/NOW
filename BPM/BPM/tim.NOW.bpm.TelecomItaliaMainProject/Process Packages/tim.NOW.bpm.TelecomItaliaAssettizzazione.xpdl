          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">if(localRequest.ordine != null &amp;&amp;&#xD;
localRequest.ordine.sede != null &amp;&amp;&#xD;
localRequest.ordine.sede.size()>0)&#xD;
{	&#xD;
	var s = 0;&#xD;
	var sede = localRequest.ordine.sede.get(s);&#xD;
&#xD;
	while(s &lt; localRequest.ordine.sede.size() &amp;&amp; sede.tipologiaSede != it_telecomitalia_it_NOW_casedata_TipologiaSedeEnumeration.SEDECLIENTECERT)&#xD;
	{&#xD;
		sede = localRequest.ordine.sede.get(s);&#xD;
		s++;&#xD;
	}	&#xD;
	SedeCert = ScriptUtil.copy(sede);&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">&#xD;
// Gestione mapping di nuove enumeration, necessario per gestire istanze in versione precedente&#xD;
 &#xD;
if ( localRequest.tipologiaScenario !=null)&#xD;
{&#xD;
	Asset.tipologiaScenario = localRequest.tipologiaScenario;&#xD;
}&#xD;
if(localRequest.ordine.LNA_LA != null)&#xD;
{&#xD;
	Asset.LNA_LA = localRequest.ordine.LNA_LA;&#xD;
}&#xD;
&#xD;
if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)&#xD;
{&#xD;
	var opzioneDinamica = &quot;&quot;;&#xD;
	opzioneDinamica = null;&#xD;
	&#xD;
	//RU_1184: per le migrazioni EASYIP ora va gestito il valore STATODISABILITAZIONEASSET (attributo nell'ordine ma campo in chiaro sull'asset)&#xD;
	var statoDisabilitazioneAsset = &quot;&quot;;&#xD;
	statoDisabilitazioneAsset = null;&#xD;
	&#xD;
	var i = 0;&#xD;
	&#xD;
	while((opzioneDinamica == null || statoDisabilitazioneAsset == null) &amp;&amp; i&lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentComponente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			&#xD;
			while((opzioneDinamica == null || statoDisabilitazioneAsset == null) &amp;&amp; j&lt;currentComponente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONEDINAMICA)&#xD;
				{&#xD;
					opzioneDinamica = currentAttributo.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATODISABILITAZIONEASSET)&#xD;
				{&#xD;
					statoDisabilitazioneAsset = currentAttributo.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(opzioneDinamica != null &amp;&amp; opzioneDinamica != &quot;&quot;)&#xD;
	{&#xD;
		Asset.opzioneDinamica = opzioneDinamica;&#xD;
	}&#xD;
	if(statoDisabilitazioneAsset != null &amp;&amp; statoDisabilitazioneAsset!= &quot;&quot;)&#xD;
	{&#xD;
		Asset.statoDisAsset = statoDisabilitazioneAsset;&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
      </xpdl2:Activities>
