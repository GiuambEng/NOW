                    <xpdl2:DataMapping Direction="OUT" Formal="Asset">
                      <xpdl2:Actual ScriptGrammar="JavaScript">AssetAggiuntivo</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                      <xpdl2:Actual ScriptGrammar="JavaScript">currentLocalRequest</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
              <xpdl2:Priority></xpdl2:Priority>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" Width="128.0">
