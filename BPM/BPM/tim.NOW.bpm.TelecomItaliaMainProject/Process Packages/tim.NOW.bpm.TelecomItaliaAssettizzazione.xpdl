            </xpdl2:Activity>
            <xpdl2:Activity Id="_8Hy8Ki_8EeehzMIy_SdzNg" Name="UpdateAssetModificati" xpdExt:Visibility="Private" xpdExt:DisplayName="Update Asset Modificati">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskService xpdExt:ImplementationType="GlobalData" Implementation="Other">
                    <xpdl2:MessageIn Id="_8Hy8Ky_8EeehzMIy_SdzNg"/>
                    <xpdl2:MessageOut Id="_8Hy8LC_8EeehzMIy_SdzNg"/>
                    <xpdExt:GlobalDataOperation>
                      <xpdExt:CaseReferenceOperations>
                        <xpdExt:CaseRefField>ListaAssetModificatiRef</xpdExt:CaseRefField>
                        <xpdExt:Update FromFieldPath="ListaAssetModificati"/>
                      </xpdExt:CaseReferenceOperations>
                    </xpdExt:GlobalDataOperation>
                  </xpdl2:TaskService>
