                    <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.ordine.DES</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="GiorniLavorativi">
                    <xpdExt:ScriptInformation Id="_QMXvUI59EeiKHO-OcevEQg" Name="giorni">
                      <xpdExt:Expression ScriptGrammar="JavaScript">var days=10;&#xD;
return days;</xpdExt:Expression>
                    </xpdExt:ScriptInformation>
                    <xpdl2:Actual ScriptGrammar="JavaScript">__SCRIPT__</xpdl2:Actual>
