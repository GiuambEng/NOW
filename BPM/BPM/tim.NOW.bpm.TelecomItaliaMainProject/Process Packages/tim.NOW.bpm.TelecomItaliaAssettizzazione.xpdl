            <xpdl2:Activity Id="_295DUEjSEeqiG95yd6Fgsg" Name="AssetCPSPrincipaleCessato" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Asset CPS Principale Cessato" xpdExt:RequireNewTransaction="false">
              <xpdl2:Implementation>
