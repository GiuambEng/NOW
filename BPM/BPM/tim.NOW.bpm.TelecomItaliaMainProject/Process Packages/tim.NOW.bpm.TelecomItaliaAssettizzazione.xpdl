        <xpdl2:Activity Id="_WGHiQiMFEeq5D-DO1nGd-A" Name="CambioOffertaDECREMENTONP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Cambio Offerta DECREMENTO NP">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var OffertaDonating = &quot;&quot;;&#xD;
OffertaDonating = null;&#xD;
&#xD;
var OffertaOLD = localRequest.offerta;&#xD;
&#xD;
OffertaModificata = false;   //Bug #35563&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	//FONIA&#xD;
	if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
	{&#xD;
		if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTONP)&#xD;
		{&#xD;
			// RecuperoOfferta ConsistenzaFonia&#xD;
			for(var i2 = 0; i2 &lt; localRequest.ordine.dettaglioordine.size(); i2++)&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i2);&#xD;
				&#xD;
				if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
				{&#xD;
					var k = 0;&#xD;
					&#xD;
					while(OffertaDonating == null &amp;&amp; k &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(k);&#xD;
						&#xD;
						if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
						{&#xD;
							OffertaDonating = currentAttDettOrdine.valoreAttributo;&#xD;
							Process.auditLog(&quot;Recuperata OffertaDonating ConsistenzaFonia: &quot;+OffertaDonating);&#xD;
						}&#xD;
						&#xD;
						k++;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if(OffertaDonating!=null)&#xD;
			{&#xD;
				if(OffertaDonating == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA || OffertaDonating == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP)&#xD;
				{&#xD;
					localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA;&#xD;
					localRequest.ordine.LNA_LA = it_telecomitalia_it_NOW_casedata_LNA_LAEnumeration.LNA;&#xD;
					OffertaModificata = true;   //Bug #35563&#xD;
				}&#xD;
				else if(OffertaDonating == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA || OffertaDonating == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA || OffertaDonating == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP)&#xD;
				{&#xD;
					localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA;&#xD;
					localRequest.ordine.LNA_LA = it_telecomitalia_it_NOW_casedata_LNA_LAEnumeration.LNA;&#xD;
					OffertaModificata = true;   //Bug #35563&#xD;
				}&#xD;
				else if(OffertaDonating == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA || OffertaDonating == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP)&#xD;
				{&#xD;
					localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA;&#xD;
					localRequest.ordine.LNA_LA = it_telecomitalia_it_NOW_casedata_LNA_LAEnumeration.LNA;&#xD;
					OffertaModificata = true;   //Bug #35563&#xD;
				}&#xD;
				else if(OffertaDonating == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA)&#xD;
				{&#xD;
					localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA;&#xD;
					localRequest.ordine.LNA_LA = it_telecomitalia_it_NOW_casedata_LNA_LAEnumeration.LNA;&#xD;
					OffertaModificata = true;   //Bug #35563&#xD;
				}&#xD;
				else if(OffertaDonating == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA)&#xD;
				{&#xD;
					localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA;&#xD;
					localRequest.ordine.LNA_LA = it_telecomitalia_it_NOW_casedata_LNA_LAEnumeration.LNA;&#xD;
					OffertaModificata = true;   //Bug #35563&#xD;
				}&#xD;
				&#xD;
				Process.auditLog(&quot;Cambiata Offerta da &quot;+OffertaOLD+&quot; a &quot;+localRequest.offerta);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
/* COMMENTATA con MAIL &quot;RE: RU_1091: IRIDEOS&quot;&#xD;
//Mail: DES PRIMO ORDINE - ACCORPAMENTO OLO&#xD;
if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
{&#xD;
	var consistenzaType = &quot;&quot;;&#xD;
	consistenzaType = null;&#xD;
	var idassetConsistenza = &quot;&quot;;&#xD;
	idassetConsistenza = null;&#xD;
	&#xD;
	if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_v1_TipoStrutturaRichiestaEnumeration.NGA&#xD;
	|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_v1_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
	|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_v1_TipoStrutturaRichiestaEnumeration.FWA)&#xD;
	{&#xD;
		consistenzaType = &quot;CONSISTENZADATI&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		consistenzaType = &quot;CONSISTENZAFONIA&quot;;&#xD;
	}&#xD;
&#xD;
	var i = 0;&#xD;
&#xD;
	while(idassetConsistenza == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == consistenzaType)&#xD;
		{&#xD;
			var j = 0;&#xD;
			&#xD;
			while(idassetConsistenza == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					idassetConsistenza = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
&#xD;
	if(idassetConsistenza != null)&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset=:idassetConsistenza&quot;);&#xD;
		criteria.setQueryParameter(&quot;idassetConsistenza&quot;,idassetConsistenza);&#xD;
&#xD;
		var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
&#xD;
		if(list != null)&#xD;
		{&#xD;
			AssetPrincipaleRef = list.get(0);&#xD;
			Asset=AssetPrincipaleRef.readAsset();&#xD;
			DesPrimoOrdineACCORPAMENTOOLO = Asset.DESPrimoOrdine;&#xD;
		}&#xD;
	}&#xD;
}*/</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_TMyF3UE6EeekX-brtRDFQQ" Width="169.0">
              <xpdl2:Coordinates XCoordinate="456.0" YCoordinate="240.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
