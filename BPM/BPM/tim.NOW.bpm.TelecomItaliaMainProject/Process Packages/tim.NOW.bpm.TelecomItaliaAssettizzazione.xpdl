        <xpdl2:Activity Id="_JFX5kMbFEeawBPqzi1D_dw" Name="Calcola" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Azione / Aggiorna Cliente">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiAzioneA=false;&#xD;
EseguiAzioneD=false;&#xD;
EseguiAzioneN=false;&#xD;
EseguiAzioneM=false;&#xD;
EseguiAzioneT=false;&#xD;
&#xD;
if(localRequest!=null &amp;&amp; localRequest.ordine!=null &amp;&amp; localRequest.ordine.dettaglioordine!=null){&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A||componente.azione == null){&#xD;
			EseguiAzioneA=true;&#xD;
		}&#xD;
		else if(componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D){&#xD;
			EseguiAzioneD=true;&#xD;
		}&#xD;
		else if(componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M){&#xD;
			EseguiAzioneM=true;&#xD;
		}&#xD;
		else if(componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N){&#xD;
			EseguiAzioneN=true;&#xD;
		}&#xD;
		else if(componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.T){&#xD;
			EseguiAzioneT=true;&#xD;
		}&#xD;
	}&#xD;
&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;EseguiAzioneA: &quot;+EseguiAzioneA+&quot; EseguiAzioneD: &quot;+EseguiAzioneD+&quot; EseguiAzioneN: &quot;+EseguiAzioneN+&quot; EseguiAzioneM: &quot;+EseguiAzioneM+&quot; EseguiAzioneT: &quot;+EseguiAzioneT);&#xD;
&#xD;
&#xD;
if(localRequest.ordine!= null &amp;&amp; Asset != null){&#xD;
	var currentDate = DateTimeUtil.createDatetime();&#xD;
	var aggiornato = false;&#xD;
	if(Asset.cliente == null){&#xD;
		Asset.cliente = it_telecomitalia_it_NOW_casedata_Factory.createCliente();&#xD;
		Asset.cliente.created = currentDate;&#xD;
		aggiornato=true;&#xD;
	}&#xD;
	&#xD;
	if(localRequest.ordine.CF!=null &amp;&amp; localRequest.ordine.CF != &quot;&quot;){&#xD;
		Asset.cliente.codiceFiscale = localRequest.ordine.CF;&#xD;
		aggiornato=true;&#xD;
	}&#xD;
	&#xD;
	if(localRequest.ordine.cognomeRagioneSociale!=null &amp;&amp; localRequest.ordine.cognomeRagioneSociale != &quot;&quot;){&#xD;
		Asset.cliente.cognomeRagioneSociale = localRequest.ordine.cognomeRagioneSociale;&#xD;
		aggiornato=true;&#xD;
	}&#xD;
	&#xD;
	if(localRequest.ordine.nome!=null &amp;&amp; localRequest.ordine.nome != &quot;&quot;){&#xD;
		Asset.cliente.nome = localRequest.ordine.nome;&#xD;
		aggiornato=true;&#xD;
	}&#xD;
	&#xD;
	if(localRequest.ordine.PIVA!=null &amp;&amp; localRequest.ordine.PIVA != &quot;&quot;){&#xD;
		Asset.cliente.partitaIVA = localRequest.ordine.PIVA;&#xD;
		aggiornato=true;&#xD;
	}&#xD;
	&#xD;
	if(aggiornato){&#xD;
		Asset.cliente.lastUpdate = currentDate;&#xD;
	}&#xD;
	Asset.cliente.IDAsset = Asset.IDAsset;&#xD;
	Process.auditLog(&quot;Aggiornamento Asset.Cliente: &quot;+aggiornato);&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
