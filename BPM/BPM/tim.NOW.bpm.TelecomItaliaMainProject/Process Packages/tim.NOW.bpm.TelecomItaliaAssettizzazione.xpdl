&#xD;
((sottoLavorazioni.contains(String(localRequest.ordine.tipologiaSottolav)) &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE) || &#xD;
((localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.TSHAULLD ||&#xD;
localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.TBUNDLE) &amp;&amp; localRequest.canaleRichiesta== it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL))&#xD;
