        <xpdl2:Activity Id="_QDuUcpNzEeq0BLebgjpy0g" Name="RecuperanumerazioniAGGIUNTIVE" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Recupera numerazioni AGGIUNTIVE">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">localRequestTemp = ScriptUtil.copy(localRequest);&#xD;
&#xD;
if(localRequest.ordine!= null)&#xD;
{&#xD;
	var i = 0;&#xD;
	&#xD;
	while (i&lt;localRequest.ordine.dettaglioordine.size()) &#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		//SM_9566 tolto AGGIUNTIVO e lasciato solo DTUAGGIUNTIVO&#xD;
		if((componente.nomeComponente== it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAGGIUNTIVO)&#xD;
			&amp;&amp; componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
		{&#xD;
			var j=0;&#xD;
			var numero =&quot;&quot;;&#xD;
			var numeroTrovato = false;&#xD;
			var stato =&quot;&quot;;&#xD;
			var statoTrovato = false;&#xD;
			&#xD;
			while((!numeroTrovato || !statoTrovato) &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMPRENOTATO&#xD;
				|| attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO&#xD;
				|| attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TELAGGIUNTIVO) //SM_9566 aggiunto TELAGGIUNTIVO&#xD;
				{&#xD;
					numero = attributo.valoreAttributo;&#xD;
					numeroTrovato = true;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO&#xD;
					 || attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATOAGGIUNTIVO)&#xD;
				{&#xD;
					stato = attributo.valoreAttributo;&#xD;
					statoTrovato = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			&#xD;
			if(numeroTrovato &amp;&amp; stato == &quot;ATTIVO&quot;)&#xD;
			{&#xD;
				NumeriTelefoniciAggiuntivi.add(numero);&#xD;
				ComponenteAggiuntivoCPS.add(ScriptUtil.copy(componente));&#xD;
				Process.auditLog(&quot;Trovato &quot;+String(componente.nomeComponente)+&quot; con stato ATTIVO da AssetPrincipaletizzare&quot;);&#xD;
			}&#xD;
			else{&#xD;
				Process.auditLog(&quot;Non è presente l'elemento NUMPRENOTATO/NUMEROTELEFONICO: &quot;+numero+&quot; oppure l'elemento STATO: &quot;+stato+&quot; della componente DTUAGGIUNTIVO/AGGIUNTIVO: &quot;+ componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		i++;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
