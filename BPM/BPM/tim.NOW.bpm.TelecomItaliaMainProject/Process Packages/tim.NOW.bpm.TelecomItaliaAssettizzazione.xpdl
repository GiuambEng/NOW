              <xpdl2:DataType>
                <xpdl2:BasicType Type="STRING">
                  <xpdl2:Length>500</xpdl2:Length>
                </xpdl2:BasicType>
              </xpdl2:DataType>
            </xpdl2:DataField>
            <xpdl2:DataField Id="_TwWMsS_7EeehzMIy_SdzNg" xpdExt:DisplayName="ListaAssetModificatiRef" Name="ListaAssetModificatiRef" IsArray="true" ReadOnly="false">
              <xpdl2:DataType>
                <xpdl2:RecordType>
                  <xpdl2:Member>
                    <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
                  </xpdl2:Member>
                </xpdl2:RecordType>
              </xpdl2:DataType>
              <xpdl2:InitialValue/>
            </xpdl2:DataField>
            <xpdl2:DataField Id="_c0qF0C_7EeehzMIy_SdzNg" xpdExt:DisplayName="ListaAssetModificati" Name="ListaAssetModificati" IsArray="true" ReadOnly="false">
              <xpdl2:DataType>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
              </xpdl2:DataType>
              <xpdl2:InitialValue/>
            </xpdl2:DataField>
          </xpdl2:DataFields>
          <xpdl2:Loop LoopType="MultiInstance">
            <xpdl2:LoopMultiInstance MI_FlowCondition="All" MI_Ordering="Sequential">
              <xpdl2:MI_Condition ScriptGrammar="JavaScript">AssetCessati.size();</xpdl2:MI_Condition>
              <xpdExt:MultiInstanceScripts/>
            </xpdl2:LoopMultiInstance>
          </xpdl2:Loop>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,230,138" Height="585.0" LaneId="_EVDa9tjpEeag_e2OckmEJw" Width="1595.0">
              <xpdl2:Coordinates XCoordinate="4611.0" YCoordinate="343.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_fuM-AGifEeekNe11CAaQNQ" Name="CreaAsset" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Crea Asset">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_5Kb_EIo4EeaXiuJl6VlD_w" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
