        <xpdl2:Activity Id="_h7F04CnuEemshfdsZIFCTQ" Name="RecuperareComponenteassetecessarla" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Recuperare Componente asset e cessarla">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var i=0;&#xD;
&#xD;
var AssetIDdettaglio = &quot;&quot;;&#xD;
AssetIDdettaglio = null;&#xD;
var AssetID = &quot;&quot;;&#xD;
AssetID = null;&#xD;
var azione = &quot;&quot;;&#xD;
azione = null;&#xD;
&#xD;
var data = DateTimeUtil.createDatetime();&#xD;
&#xD;
while(azione == null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
	{&#xD;
		var j=0;&#xD;
		azione = String(comp.azione);&#xD;
		&#xD;
		while((AssetIDdettaglio == null || AssetID == null) &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVODETTAGLIOASSET)&#xD;
			{&#xD;
				AssetIDdettaglio = attr.valoreAttributo;&#xD;
			}&#xD;
			else if (attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				AssetID = attr.valoreAttributo;&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
		&#xD;
	i++;&#xD;
}&#xD;
&#xD;
&#xD;
if(AssetIDdettaglio != null &amp;&amp; AssetID != null)&#xD;
{&#xD;
	//Recupero l'asset con componente da cessare&#xD;
	if(azione == 'D')&#xD;
	{&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset = :IDA AND (statoAsset = 'ATTIVO' OR statoAsset = 'INLAVORAZIONE')&quot;);&#xD;
		c.setQueryParameter(&quot;IDA&quot;,ScriptUtil.createBigInteger(AssetID));&#xD;
			&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		&#xD;
		if(result.size() > 0)&#xD;
		{&#xD;
			var AssetCon = result.get(0).readAsset();&#xD;
			var indexDettaglio = ScriptUtil.createBigInteger(AssetIDdettaglio)-1;&#xD;
			&#xD;
			AssetCon.dettaglioasset.get(indexDettaglio).statoDettaglioAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
			AssetCon.dettaglioasset.get(indexDettaglio).lastUpdate = data;&#xD;
			&#xD;
			// decremento attributi quantita linee e/o numaggiuntivi&#xD;
			var i = 0;&#xD;
			var j = 0;&#xD;
			var AccessoTrovato = false;&#xD;
			&#xD;
			while(!AccessoTrovato &amp;&amp; i&lt;AssetCon.dettaglioasset.size())&#xD;
			{&#xD;
				var componenteAsset = AssetCon.dettaglioasset.get(i);&#xD;
				&#xD;
				if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
				{&#xD;
					AccessoTrovato = true;&#xD;
					j = 0;&#xD;
					Process.auditLog(&quot;Trovata componente &quot;+componenteAsset.nomeComponente);&#xD;
					&#xD;
					while(j&lt;componenteAsset.attributidettaglioasset.size())&#xD;
					{&#xD;
						var attributoAccesso = componenteAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(attributoAccesso.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITALINEE ||&#xD;
						   attributoAccesso.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMAGGIUNTIVI || &#xD;
						   attributoAccesso.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITACANALI) //SM_8995&#xD;
						{&#xD;
							var appoggio = ScriptUtil.createBigInteger(attributoAccesso.valoreAttributo);&#xD;
							attributoAccesso.valoreAttributo = String(appoggio - 1);&#xD;
							Process.auditLog(&quot;Aggiornato valore attributo di &quot;+attributoAccesso.nomeAttributo+&quot; con valore &quot;+attributoAccesso.valoreAttributo+ &quot;. OLD: &quot;+String(appoggio));&#xD;
						}&#xD;
						&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
			&#xD;
			AssetList.add(AssetCon);&#xD;
			AssetRefList.add(result.get(0));&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Asset con ID: &quot;+AssetID+&quot; non trovato&quot;);&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Nessuna componente da cessare trovata. Azione: &quot;+azione);&#xD;
	}&#xD;
	&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Nessuna componente o asset trovato. Asset ID: &quot;+AssetID+&quot;, AssetIDdettaglio: &quot;+AssetIDdettaglio);&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
