        <xpdl2:Activity Id="_TMyFdEE6EeekX-brtRDFQQ" Name="UpdateAsset" xpdExt:Visibility="Private" xpdExt:DisplayName="Update Asset">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//ricerca dell'asset da aggiornare&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
// NP&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
	&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP)&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;offerta = 'NP' AND statoAsset &lt;> 'CESSATO' AND (IDRisorsa=:IDRisorsa OR numeroTelefonico =:IDRisorsa)&quot;);&#xD;
	criteria.setQueryParameter(&quot;IDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
	&#xD;
	var assetRefs = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
	&#xD;
	if (assetRefs == null || assetRefs.size()==0)&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;dettaglioasset.attributidettaglioasset.nomeAttributo = 'RADICALE' AND dettaglioasset.attributidettaglioasset.valoreAttributo=:IDRisorsa AND statoAsset &lt;> 'CESSATO' AND offerta = 'NP'&quot;);&#xD;
		criteria.setQueryParameter(&quot;IDRisorsa&quot;, localRequest.IDRisorsa);&#xD;
	}&#xD;
}&#xD;
//RU_1215: aggiunto servizio in consistenza e quindi commentato questo else if&#xD;
// FIXEDWIRELESSACCESS - caso particolare perché non esiste il servizio in consistenza per FWA - // RU_833&#xD;
/*else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
	 &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIXEDWIRELESSACCESS)&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;offerta = 'FIXEDWIRELESSACCESS' AND statoAsset &lt;> 'CESSATO' AND IDRisorsa=:IDRisorsa&quot;);&#xD;
	criteria.setQueryParameter(&quot;IDRisorsa&quot;,localRequest.IDRisorsa);	&#xD;
}*/&#xD;
else&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset=:idassetConsistenza&quot;);&#xD;
	&#xD;
	var idassetConsistenza = &quot;&quot;;&#xD;
	idassetConsistenza = null;&#xD;
	&#xD;
	var consistenzaType = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration;&#xD;
&#xD;
	//DOPPIO ULLLINEANONATTIVA SM 7866 - DOPPIO SLULINEANONATTIVA RU_632&#xD;
	var azioneConsFonia = it_telecomitalia_it_NOW_casedata_AzioneEnumeration;&#xD;
	var azioneConsDati = it_telecomitalia_it_NOW_casedata_AzioneEnumeration;&#xD;
	var offertaConsFonia = it_telecomitalia_it_NOW_casedata_OffertaEnumeration;&#xD;
	var offertaConsDati = it_telecomitalia_it_NOW_casedata_OffertaEnumeration;&#xD;
	&#xD;
	&#xD;
	if (localRequest.codificaOLOAGCOM == &quot;TLC&quot; &amp;&amp;&#xD;
			(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA ||&#xD;
			 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA))  //RU_632&#xD;
	{&#xD;
		var i = 0;&#xD;
		var consistenze = 0;&#xD;
		while(i &lt; localRequest.ordine.dettaglioordine.size() &amp;&amp; consistenze &lt; 2)&#xD;
		{&#xD;
		&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA || currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
		{&#xD;
			var j = 0;&#xD;
			consistenze++;&#xD;
			var trovato = false;&#xD;
&#xD;
			while(j &lt; currentDettOrdine.attributiDettaglioOrdine.size() &amp;&amp; trovato == false)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
				{&#xD;
					if (currentAttDettOrdine.valoreAttributo == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA &amp;&amp; currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
					{&#xD;
						azioneConsFonia = currentDettOrdine.azione;&#xD;
						offertaConsFonia = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA;						&#xD;
					} &#xD;
					else if (currentAttDettOrdine.valoreAttributo == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA &amp;&amp; currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
					{&#xD;
						azioneConsDati = currentDettOrdine.azione;&#xD;
						offertaConsDati = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA;&#xD;
					}&#xD;
					else if (currentAttDettOrdine.valoreAttributo == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA &amp;&amp; currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
					{&#xD;
						azioneConsFonia = currentDettOrdine.azione;&#xD;
						offertaConsFonia = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA; //RU_632						&#xD;
					} &#xD;
					else if (currentAttDettOrdine.valoreAttributo == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA &amp;&amp; currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
					{&#xD;
						azioneConsDati = currentDettOrdine.azione;&#xD;
						offertaConsDati = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA; //RU_632					&#xD;
					} &#xD;
					&#xD;
					trovato = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
		&#xD;
		&#xD;
	}&#xD;
	&#xD;
	//RU_1203 - NPNG&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NPNG)&#xD;
	{&#xD;
		consistenzaType = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZANPNG;&#xD;
	}&#xD;
	//DATI - VLAN/VP - RU_1058&#xD;
	else if(String(localRequest.offerta).slice(0, 4) == &quot;VLAN&quot;&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VP)&#xD;
	{&#xD;
		consistenzaType = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZARACCOLTA;&#xD;
	}&#xD;
	//DATI - TUTTE LE ALTRE&#xD;
	else if(String(localRequest.offerta).slice(0, 3) == &quot;SHA&quot;&#xD;
	    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIXEDWIRELESSACCESS      //RU_1215&#xD;
		|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
		|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
		|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FIBERSTREAM) //SM_11295&#xD;
	{&#xD;
		consistenzaType = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI;&#xD;
	}&#xD;
	//DOPPIO ULLLINEANONATTIVA SM 7866 - DOPPIO SLULINEANONATTIVA RU_632&#xD;
	else if ((azioneConsFonia == &quot;M&quot; &amp;&amp; azioneConsDati == &quot;N&quot; &amp;&amp; offertaConsFonia == offertaConsDati) || (azioneConsFonia == &quot;N&quot; &amp;&amp; azioneConsDati == &quot;M&quot; &amp;&amp; offertaConsFonia == offertaConsDati)) &#xD;
	{&#xD;
		if (azioneConsFonia == &quot;M&quot;)&#xD;
		{&#xD;
			consistenzaType = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA;&#xD;
		} &#xD;
		else &#xD;
		{&#xD;
			consistenzaType = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI;&#xD;
		}&#xD;
		&#xD;
	}&#xD;
	//REGOLATORIO - CPS&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
	{&#xD;
		consistenzaType = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS;&#xD;
	}&#xD;
	//ALTRI REGOLATORI&#xD;
	else&#xD;
	{&#xD;
		consistenzaType = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA;&#xD;
	}&#xD;
	&#xD;
	var i = 0;&#xD;
&#xD;
	while(idassetConsistenza == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == consistenzaType)&#xD;
		{&#xD;
			var j = 0;&#xD;
			&#xD;
			while(idassetConsistenza == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					idassetConsistenza = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	criteria.setQueryParameter(&quot;idassetConsistenza&quot;,idassetConsistenza);&#xD;
}&#xD;
&#xD;
var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
&#xD;
if(list != null)&#xD;
{&#xD;
	AssetPrincipaleRef = list.get(0);&#xD;
	Asset=AssetPrincipaleRef.readAsset();&#xD;
	targetRequestRef = AssetPrincipaleRef.richiestaRef;&#xD;
}&#xD;
else &#xD;
{&#xD;
	Log.write(&quot;Nessun asset trovato con IDRisorsa:&quot; + localRequest.IDRisorsa);&#xD;
	Process.auditLog(&quot;Nessun asset trovato con IDRisorsa:&quot; + localRequest.IDRisorsa);&#xD;
}&#xD;
	&#xD;
if(Asset!=null &amp;&amp; AssetPrincipaleRef != null)&#xD;
{&#xD;
	&#xD;
	if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATO&#xD;
		|| localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO)&#xD;
	{&#xD;
		Asset.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Asset.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
		Asset.DES = localRequest.ordine.DES;&#xD;
		Asset.ORA_DES = localRequest.ordine.ORA_DES;&#xD;
		Asset.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		Asset.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
		Asset.codiceOrdineTI = localRequest.codiceOrdineTI;&#xD;
		Asset.lastUpdate = date;&#xD;
		&#xD;
		//RU_1203: aggiornamento dell'OLO per CESSAZIONE NPNG con sottolav CAMBIOOLO&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NPNG&#xD;
   		&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOOLO)&#xD;
		{&#xD;
			Asset.codificaOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
		}&#xD;
		&#xD;
		for(var j=0; j&lt;Asset.dettaglioasset.size(); j++)&#xD;
		{&#xD;
    		Asset.dettaglioasset.get(j).statoDettaglioAsset = Asset.statoAsset;&#xD;
    		Asset.dettaglioasset.get(j).lastUpdate = date;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	Asset.lastUpdate = DateTimeUtil.createDatetime();	&#xD;
} &#xD;
else &#xD;
{&#xD;
	Log.write(&quot;Errore recupero asset con IDRisorsa:&quot;+localRequest.IDRisorsa);&#xD;
	Process.auditLog(&quot;Errore recupero asset con IDRisorsa:&quot;+localRequest.IDRisorsa);&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_TMyF3UE6EeekX-brtRDFQQ" Width="104.0">
              <xpdl2:Coordinates XCoordinate="573.0" YCoordinate="682.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_TMyFdUE6EeekX-brtRDFQQ" Name="MappingFTTH" xpdExt:Visibility="Private" xpdExt:DisplayName="Mapping FTTH">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">/*FEA_32042 per ATTIVAZIONE E MIGRAZIONE, VULA e SEMIVULA, MERCATO deve essere assettizzato solo se non presenti &#xD;
CARATTERIZZAZIONEGEO o BANDOPUBBLICO*/&#xD;
var assettizzaMercato=true;&#xD;
if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &#xD;
|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH &#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH))&#xD;
{&#xD;
	&#xD;
	var i=0;&#xD;
&#xD;
	while(assettizzaMercato &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDOPUBBLICO&#xD;
				|| currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO)&#xD;
				{&#xD;
					assettizzaMercato=false;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
