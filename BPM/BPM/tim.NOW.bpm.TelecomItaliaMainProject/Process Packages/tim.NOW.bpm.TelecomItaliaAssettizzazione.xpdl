						{&#xD;
							DLCIOrdine = comp.attributiDettaglioOrdine.get(t).valoreAttributo;&#xD;
						}&#xD;
						t++;&#xD;
					}&#xD;
					Asset.CRMOrigine =&quot;NOW&quot;;&#xD;
					//asset principale&#xD;
					for(var j=0; j&lt;Asset.dettaglioasset.size(); j++)&#xD;
					{&#xD;
						var dettaglioAsset =Asset.dettaglioasset.get(j);&#xD;
						//cerco &#xD;
						if(dettaglioAsset.nomeComponente == comp.nomeComponente)&#xD;
						{&#xD;
							var VPIAsset = &quot;&quot;;&#xD;
							VPIAsset = null;&#xD;
							var VCIAsset = &quot;&quot;;&#xD;
							VCIAsset = null;&#xD;
							var uservlanAsset = &quot;&quot;;&#xD;
							uservlanAsset = null;&#xD;
							var DLCIAsset = &quot;&quot;;&#xD;
							DLCIAsset = null;&#xD;
							&#xD;
							var t=0;&#xD;
							while(t&lt;dettaglioAsset.attributidettaglioasset.size())&#xD;
							{&#xD;
								if(dettaglioAsset.attributidettaglioasset.get(t).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
								{&#xD;
									VPIAsset = dettaglioAsset.attributidettaglioasset.get(t).valoreAttributo;&#xD;
								}&#xD;
								else if(dettaglioAsset.attributidettaglioasset.get(t).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
								{&#xD;
									VCIAsset = dettaglioAsset.attributidettaglioasset.get(t).valoreAttributo;&#xD;
								}&#xD;
								else if(dettaglioAsset.attributidettaglioasset.get(t).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
								{&#xD;
