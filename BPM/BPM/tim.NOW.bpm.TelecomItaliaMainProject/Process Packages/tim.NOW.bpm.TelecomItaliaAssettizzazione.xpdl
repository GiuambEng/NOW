            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_Rk_vYAiiEeuQmL83hs9X9w" Name="RecuperoAssetFoniadaCessare" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Recupero Asset Fonia da Cessare">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset=:idassetConsistenza&quot;);&#xD;
&#xD;
var idassetConsistenza = &quot;&quot;;&#xD;
idassetConsistenza = null;&#xD;
var i = 0;&#xD;
&#xD;
while(idassetConsistenza == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA&#xD;
	&amp;&amp; currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
	{&#xD;
		var j = 0;&#xD;
		&#xD;
		while(idassetConsistenza == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				idassetConsistenza = currentAttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;Recuperato IDAsset: &quot;+idassetConsistenza);&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
criteria.setQueryParameter(&quot;idassetConsistenza&quot;,idassetConsistenza);&#xD;
&#xD;
var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
&#xD;
if(list != null)&#xD;
{&#xD;
	AssetRef = list.get(0);&#xD;
	AssetTemp=AssetRef.readAsset();&#xD;
}&#xD;
else &#xD;
{&#xD;
	Process.auditLog(&quot;Nessun asset trovato con IDRisorsa:&quot; + localRequest.IDRisorsa);&#xD;
}&#xD;
	&#xD;
if(AssetTemp!=null &amp;&amp; AssetRef != null)&#xD;
{&#xD;
	AssetTemp.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
	Process.auditLog(&quot;AssetTemp Cessato con ID: &quot;+AssetTemp.IDAsset);&#xD;
	AssetTemp.DES = localRequest.ordine.DES;&#xD;
	AssetTemp.ORA_DES = localRequest.ordine.ORA_DES;&#xD;
	AssetTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	AssetTemp.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
	AssetTemp.codiceOrdineTI = localRequest.codiceOrdineTI;&#xD;
	AssetTemp.lastUpdate = date;&#xD;
	&#xD;
	for(var j=0; j&lt;AssetTemp.dettaglioasset.size(); j++)&#xD;
	{&#xD;
		AssetTemp.dettaglioasset.get(j).statoDettaglioAsset = AssetTemp.statoAsset;&#xD;
		AssetTemp.dettaglioasset.get(j).lastUpdate = date;&#xD;
	}&#xD;
	&#xD;
	AssetTemp.lastUpdate = DateTimeUtil.createDatetime();&#xD;
	&#xD;
	if(AssetRefDaCessare!=null &amp;&amp; AssetRefDaCessare.size()>0 &amp;&amp; AssetRefDaCessare.contains(AssetRef))&#xD;
	{&#xD;
		Process.auditLog(&quot;AssetTemp già presente nella lista dei cancellati&quot;);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		AssetCessati.add(ScriptUtil.copy(AssetTemp));&#xD;
		AssetRefDaCessare.add(AssetRef);&#xD;
	}&#xD;
} &#xD;
else &#xD;
{&#xD;
	Process.auditLog(&quot;Errore recupero asset con IDRisorsa:&quot;+localRequest.IDRisorsa);&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
