            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_R9yRYFPNEeqyx_SC49wk1Q" Name="MappingACCORPAMENTOOLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Mapping ACCORPAMENTOOLO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">// SM_9100: per ACCORPAMENTOOLO va ribaltato 1-1 quello che c'è nell'ordine, qualsiasi sia l'offerta o la lavorazione&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	for(var j=0; j &lt; componente.attributiDettaglioOrdine.size(); j++)&#xD;
	{&#xD;
		var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
		&#xD;
		if(attributo.nomeAttributo != it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAESPLETAMENTOUSERVLAN&#xD;
		&amp;&amp; attributo.nomeAttributo != it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAESPLETAMENTOVC) // SM_9107&#xD;
		{&#xD;
			OrdineComponente.add(String(componente.nomeComponente));&#xD;
		&#xD;
			OrdineAttributo.add(String(attributo.nomeAttributo));&#xD;
		&#xD;
			AssetComponente.add(String(componente.nomeComponente));&#xD;
		&#xD;
			// COMPONENTI MULTIPLE&#xD;
			if(componente.nomeComponente == 'AGGIUNTIVO' &#xD;
			|| componente.nomeComponente == 'STS'&#xD;
			|| componente.nomeComponente == 'ATMVC'&#xD;
			|| componente.nomeComponente == 'GBEVC'&#xD;
			|| componente.nomeComponente == 'USERVLAN'&#xD;
			|| componente.nomeComponente == 'NUMERIAGGIUNTIVI'&#xD;
			|| componente.nomeComponente == 'NUMBERPORTABILITY'&#xD;
			|| componente.nomeComponente == 'MODEM'&#xD;
			|| componente.nomeComponente == 'SPLITTER'&#xD;
			|| componente.nomeComponente == 'PROTOCOLLO')&#xD;
			{&#xD;
				OrdineToAsset_TipoMapping.add(&quot;L12&quot;);&#xD;
			}&#xD;
			// COMPONENTI SINGOLE&#xD;
			else&#xD;
			{&#xD;
				OrdineToAsset_TipoMapping.add(&quot;L1&quot;);&#xD;
			}&#xD;
		&#xD;
			AssetAttributo.add(String(attributo.nomeAttributo));&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
