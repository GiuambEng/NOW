        <xpdl2:Transition Id="_Oo5rgJOPEeq0BLebgjpy0g" xpdExt:DisplayName="" Name="" From="_TMyFkkE6EeekX-brtRDFQQ" To="_I24pkZOPEeq0BLebgjpy0g">
          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">var Aggiuntivo = false;&#xD;
var STRUTTURALINEA = &quot;&quot;;&#xD;
STRUTTURALINEA = null;&#xD;
var TIPOLINEAREALE = &quot;&quot;;&#xD;
TIPOLINEAREALE = null;&#xD;
var Cessazione = false;&#xD;
&#xD;
// RU_975: deve entrare in questo processo se ci sono AGGIUNTIVI CPS PBX da assettizzare, o AGGIUNTIVI CPS PBX da cessare (legati a una CPS principale che viene cessata)&#xD;
if(localRequest.ordine!=null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while((STRUTTURALINEA == null || !Aggiuntivo || !Cessazione) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{	&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
		{&#xD;
			var k = 0;&#xD;
			&#xD;
			while(STRUTTURALINEA == null &amp;&amp; k &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(k);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
				{&#xD;
					STRUTTURALINEA = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				&#xD;
				k++;&#xD;
			}&#xD;
		}&#xD;
		else if((currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAGGIUNTIVO&#xD;
			  || currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
					&amp;&amp; currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
		{&#xD;
			Aggiuntivo = true;&#xD;
		}&#xD;
		else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS&#xD;
					&amp;&amp; currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		{&#xD;
			Cessazione = true;&#xD;
			&#xD;
			var k = 0;&#xD;
			&#xD;
			while(TIPOLINEAREALE == null &amp;&amp; k &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(k);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAREALE)&#xD;
				{&#xD;
					TIPOLINEAREALE = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				&#xD;
				k++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
((Aggiuntivo &amp;&amp; STRUTTURALINEA == &quot;PBX&quot;) || (Cessazione &amp;&amp; TIPOLINEAREALE == &quot;PBX&quot;));</xpdl2:Expression></xpdl2:Condition>
