					Asset.CRMOrigine =&quot;NOW&quot;;&#xD;
					var trovato= false;&#xD;
					for(var j=0; !trovato &amp;&amp; j&lt;Asset.dettaglioasset.size();j++){&#xD;
						var assetComponente = Asset.dettaglioasset.get(j);&#xD;
						if(assetComponente.nomeComponente == comp.nomeComponente){&#xD;
							//cerco codice STS Asset&#xD;
							var codiceSTSAsset=&quot;&quot;;&#xD;
							codiceSTSAsset = null;&#xD;
							var c=0;&#xD;
							while(codiceSTSAsset== null &amp;&amp; c &lt; assetComponente.attributidettaglioasset.size()){&#xD;
								if(assetComponente.attributidettaglioasset.get(c).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE){&#xD;
									codiceSTSAsset = assetComponente.attributidettaglioasset.get(c).valoreAttributo;&#xD;
								}&#xD;
								c++;&#xD;
							}&#xD;
							if(codiceSTSAsset == codiceSTSOrdine){&#xD;
								trovato = true;&#xD;
								assetComponente.statoDettaglioAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
								Process.auditLog(&quot;componente STS con CODICE = &quot;+codiceSTSAsset+ &quot; cessato&quot; );&#xD;
							}		&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				else if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE) &amp;&amp; (comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO))&#xD;
				{&#xD;
					var numeroTelefonicoAggiuntivoOrdine = &quot;&quot;;&#xD;
					numeroTelefonicoAggiuntivoOrdine = null;&#xD;
					codiceSTSOrdine = null;&#xD;
					var t=0;&#xD;
					&#xD;
					while(numeroTelefonicoAggiuntivoOrdine == null &amp;&amp; t &lt; comp.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						if(comp.attributiDettaglioOrdine.get(t).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
						{&#xD;
							numeroTelefonicoAggiuntivoOrdine = comp.attributiDettaglioOrdine.get(t).valoreAttributo;&#xD;
						}&#xD;
						&#xD;
						t++;&#xD;
					}&#xD;
					//asset principale&#xD;
					Asset.CRMOrigine =&quot;NOW&quot;;&#xD;
					&#xD;
					var trovato = false;	&#xD;
					for(var j=0; j&lt;Asset.dettaglioasset.size(); j++)&#xD;
					{&#xD;
						var assetComponente = Asset.dettaglioasset.get(j);&#xD;
						if(assetComponente.nomeComponente == comp.nomeComponente)&#xD;
						{&#xD;
							//cerco codice STS Asset&#xD;
							var numeroTelefonicoAggiuntivoAsset = &quot;&quot;;&#xD;
							numeroTelefonicoAggiuntivoAsset = null;&#xD;
							&#xD;
							var c = 0;&#xD;
							while(numeroTelefonicoAggiuntivoAsset == null &amp;&amp; c &lt; assetComponente.attributidettaglioasset.size())&#xD;
							{&#xD;
								if(assetComponente.attributidettaglioasset.get(c).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
								{&#xD;
									numeroTelefonicoAggiuntivoAsset = assetComponente.attributidettaglioasset.get(c).valoreAttributo;&#xD;
								}&#xD;
								c++;&#xD;
							}&#xD;
							&#xD;
							if(numeroTelefonicoAggiuntivoAsset == numeroTelefonicoAggiuntivoOrdine)&#xD;
							{&#xD;
								trovato = true;&#xD;
								assetComponente.statoDettaglioAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
								Process.auditLog(&quot;componente AGGIUNTIVO con NUMEROTELEFONICO = &quot;+numeroTelefonicoAggiuntivoAsset+ &quot; cessato&quot; );&#xD;
								&#xD;
								// Valorizzazione a NON ATTIVO di AGGIUNTIVO.STATO&#xD;
								var k = 0;&#xD;
								var trovatoStato = false;&#xD;
								while(!trovatoStato &amp;&amp; k &lt; assetComponente.attributidettaglioasset.size())&#xD;
								{&#xD;
									var attributo = assetComponente.attributidettaglioasset.get(k);&#xD;
									&#xD;
									if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO)&#xD;
									{&#xD;
										attributo.valoreAttributo = &quot;NON ATTIVO&quot;;&#xD;
										trovatoStato = true;&#xD;
										Process.auditLog(&quot;AGGIUNTIVO &quot;+numeroTelefonicoAggiuntivoAsset+&quot;, stato messo a &quot;+attributo.valoreAttributo);&#xD;
									}&#xD;
									k++;&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//RU_1220: Assettizzazione degli attributi in CESSAZIONE&#xD;
			//Verifico se il componente del dettaglio dell'ordine è candidato all'assettizzazione&#xD;
			else if(OrdineComponente.contains(String(comp.nomeComponente))&#xD;
				    &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
					//Commentata AND con offerte con la RU_1317 &#xD;
				    /*&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL&#xD;
                        ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
                        ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT&#xD;
						||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIXEDWIRELESSACCESS&#xD;
						||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
						||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
						||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
						||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
						||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL)*/)&#xD;
			{	&#xD;
				Process.auditLog(&quot;Inizio assettizzazione attributi in CESSAZIONE&quot;);&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				&#xD;
				//Cerco indice della configurazione&#xD;
				var indexComponente = 0;&#xD;
				&#xD;
				&#xD;
				for(var j=0; j&lt;comp.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttributoDettaglioOrdine = comp.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					var trovato = false;	&#xD;
					var k=0;&#xD;
					&#xD;
					//Verifico se la coppia componente-attributo sono candidati per l'assettizzazione&#xD;
					while(!trovato &amp;&amp; k&lt;OrdineAttributo.size())&#xD;
					{&#xD;
						//Attributi da assettizzare &#xD;
						if(currentAttributoDettaglioOrdine.nomeAttributo == OrdineAttributo.get(k) &amp;&amp; comp.nomeComponente == OrdineComponente.get(k)&#xD;
						   &amp;&amp; &#xD;
						   (OrdineAttributo.get(k) == &quot;RITIROPRODOTTI&quot;&#xD;
						   ||OrdineAttributo.get(k) == &quot;STATORESTITUZIONEPRODOTTI&quot;&#xD;
						   ||OrdineAttributo.get(k) == &quot;DATARESTITUZIONEPRODOTTI&quot;&#xD;
						   ||OrdineAttributo.get(k) == &quot;DATARICEZIONERICHIESTA&quot;&#xD;
						   ||OrdineAttributo.get(k) == &quot;TIPORIENTRO&quot;&#xD;
						   ||OrdineAttributo.get(k) == &quot;PROPRIETAMATERIALE&quot;))  //RU_1317&#xD;
						{&#xD;
							trovato = true;&#xD;
							indexComponente = k;&#xD;
							Process.auditLog(&quot;Trovato attributo e componente da assettizzare &quot;+OrdineAttributo.get(k)+&quot;, &quot;+OrdineComponente.get(k));&#xD;
						}&#xD;
						k++;	&#xD;
					}&#xD;
					&#xD;
					//Assettizzo l'attributo&#xD;
					if(trovato &amp;&amp; OrdineToAsset_TipoMapping.get(indexComponente) == &quot;L1&quot;)&#xD;
					{	&#xD;
						var trovataComponenteinAsset = false; &#xD;
						var trovatoAttributoinAsset = false;&#xD;
				&#xD;
						//Se l'attributo è in Asset -> sovrascrivo	&#xD;
						var k=0;&#xD;
						&#xD;
						while(!trovataComponenteinAsset &amp;&amp; k&lt;Asset.dettaglioasset.size())&#xD;
						{&#xD;
							var currentDettaglioAsset = Asset.dettaglioasset.get(k);&#xD;
							&#xD;
							if(currentDettaglioAsset.nomeComponente == AssetComponente.get(indexComponente))&#xD;
							{&#xD;
								trovataComponenteinAsset = true;&#xD;
								var m=0;&#xD;
								&#xD;
								while(!trovatoAttributoinAsset &amp;&amp; m&lt;currentDettaglioAsset.attributidettaglioasset.size())&#xD;
								{&#xD;
									var currentAttDettAsset = currentDettaglioAsset.attributidettaglioasset.get(m);&#xD;
									&#xD;
									if(currentAttDettAsset.nomeAttributo == AssetAttributo.get(indexComponente))&#xD;
									{&#xD;
										trovatoAttributoinAsset = true;&#xD;
										currentAttDettAsset.valoreAttributo = currentAttributoDettaglioOrdine.valoreAttributo;&#xD;
										Process.auditLog(&quot;Assettizzazione per sostituzione, Componente &quot;+currentDettaglioAsset.nomeComponente+&quot;, attributo &quot;+currentAttDettAsset.nomeAttributo+ &quot;con valore: &quot;+currentAttributoDettaglioOrdine.valoreAttributo);&#xD;
									}&#xD;
									m++;&#xD;
								}&#xD;
							}&#xD;
							k++;&#xD;
						}&#xD;
&#xD;
						//Se l'attributo non è in asset -> lo creo&#xD;
						if(!trovatoAttributoinAsset)&#xD;
						{&#xD;
							var attributoDettaglioAsset = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioAsset();				&#xD;
							attributoDettaglioAsset.IDAsset = Asset.IDAsset;&#xD;
							attributoDettaglioAsset.IDDettaglioAsset = currentDettaglioAsset.IDDettaglioAsset;&#xD;
							attributoDettaglioAsset.tipologiaDato = currentAttributoDettaglioOrdine.tipologiaDato;&#xD;
							attributoDettaglioAsset.created = ora;&#xD;
							attributoDettaglioAsset.lastUpdate = ora;&#xD;
							attributoDettaglioAsset.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(AssetAttributo.get(indexComponente));&#xD;
							attributoDettaglioAsset.operatore = currentAttributoDettaglioOrdine.operatore;&#xD;
							attributoDettaglioAsset.valoreAttributo = currentAttributoDettaglioOrdine.valoreAttributo;&#xD;
							&#xD;
							currentDettaglioAsset.attributidettaglioasset.add(ScriptUtil.copy(attributoDettaglioAsset));				&#xD;
							Process.auditLog(&quot;Assettizzazione Componente &quot;+currentDettaglioAsset.nomeComponente+&quot;, attributo &quot;+attributoDettaglioAsset.nomeAttributo+ &quot;con valore: &quot;+currentAttributoDettaglioOrdine.valoreAttributo);&#xD;
						}				&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="75.0" LaneId="_Wx-hO4o4EeaXiuJl6VlD_w" Width="101.0">
              <xpdl2:Coordinates XCoordinate="2428.0" YCoordinate="461.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_2LUYcMbGEeawBPqzi1D_dw" Name="Modifica" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Modifica" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;Inizio gestione assettizzazione, azione M&quot;);&#xD;
&#xD;
var ora = DateTimeUtil.createDatetime();&#xD;
&#xD;
if(localRequest.ordine!= null){&#xD;
	&#xD;
	var modificati = false;&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		var IDRisorsa = comp.IDRisorsa;&#xD;
		if(comp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M&#xD;
			&amp;&amp; comp.nomeComponente != it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI&#xD;
			&amp;&amp; comp.nomeComponente != it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA&#xD;
			&amp;&amp; comp.nomeComponente != it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS&#xD;
			&amp;&amp; comp.nomeComponente != it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZARACCOLTA&#xD;
			&amp;&amp; comp.nomeComponente != it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACANALE&#xD;
			&amp;&amp; comp.nomeComponente != it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFEEDER&#xD;
			&amp;&amp; comp.nomeComponente != it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZASEDEOLT&#xD;
			&amp;&amp; comp.nomeComponente != it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAVLANMULTICAST&#xD;
			&amp;&amp; comp.nomeComponente != it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZANPNG){  //RU_1203&#xD;
			Process.auditLog(&quot;Componente con AZIONE = M, lavorazione= &quot;+localRequest.lavorazione+ &quot; , nomeComponente = &quot;+comp.nomeComponente+ &quot; , comp.IDRisorsa = &quot;+comp.IDRisorsa+ &quot; ,comp.IDRisorsaNOW = &quot;+comp.IDRisorsaNOW );&#xD;
			modificati=true;&#xD;
			&#xD;
			Asset.CRMOrigine =&quot;NOW&quot;;&#xD;
			&#xD;
			var indexConfigurazione = 0;&#xD;
			var trovato = false;&#xD;
			var k=0;&#xD;
			while(!trovato &amp;&amp; k&lt;OrdineAttributo.size()){&#xD;
					&#xD;
				if(String(comp.nomeComponente) == OrdineComponente.get(k)){&#xD;
					trovato=true;&#xD;
					indexConfigurazione = k;&#xD;
				}&#xD;
				k++;	&#xD;
			}&#xD;
		&#xD;
			&#xD;
			&#xD;
			var DLCIOrdine = &quot;&quot;;&#xD;
			var VPIOrdine = &quot;&quot;;&#xD;
			var VCIOrdine = &quot;&quot;;&#xD;
			var USERVLANIDOrdine = &quot;&quot;;&#xD;
			var IDENTIFICATIVOCOSOrdine = &quot;&quot;;       //SM_9894&#xD;
			var DLCITrovato = false;&#xD;
			var VPITrovato = false;&#xD;
			var VCITrovato = false;&#xD;
			var USERVLANIDTrovato = false;&#xD;
			var IDENTIFICATIVOCOSTrovato = false;   //SM_9894&#xD;
			&#xD;
			&#xD;
			if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
				|| comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC&#xD;
				|| comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
				|| comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS        //SM_9894&#xD;
				){&#xD;
				var c =0;&#xD;
				while(c&lt;comp.attributiDettaglioOrdine.size()){&#xD;
					var temp = comp.attributiDettaglioOrdine.get(c);&#xD;
					if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI){&#xD;
						VPIOrdine = temp.valoreAttributo;&#xD;
						VPITrovato = true;&#xD;
					} else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI){&#xD;
						VCIOrdine = temp.valoreAttributo;&#xD;
						VCITrovato = true;&#xD;
					} else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID){&#xD;
						USERVLANIDOrdine = temp.valoreAttributo;&#xD;
						USERVLANIDTrovato = true;&#xD;
					} else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI){&#xD;
						DLCIOrdine = temp.valoreAttributo;&#xD;
						DLCITrovato = true;&#xD;
					} else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS){    //SM_9894&#xD;
						IDENTIFICATIVOCOSOrdine = temp.valoreAttributo;&#xD;
						IDENTIFICATIVOCOSTrovato = true;&#xD;
					}&#xD;
					c++;&#xD;
				}&#xD;
				&#xD;
				Process.auditLog(&quot;VPIOrdine: &quot;+VPIOrdine+&quot;, VCIOrdine: &quot;+VCIOrdine+&quot; ,USERVLANIDOrdine: &quot;+USERVLANIDOrdine+&quot;,DLCIOrdine: &quot;+DLCIOrdine +&quot;,IDENTIFICATIVOCOSOrdine: &quot; +IDENTIFICATIVOCOSOrdine);&#xD;
			}&#xD;
			else if(AssetComponente.get(indexConfigurazione) == &quot;ATMVC&quot;&#xD;
				|| AssetComponente.get(indexConfigurazione) == &quot;GBEVC&quot;&#xD;
				|| AssetComponente.get(indexConfigurazione) == &quot;USERVLAN&quot;&#xD;
				|| AssetComponente.get(indexConfigurazione) == &quot;TIPOCOS&quot;){          //SM_9894&#xD;
				var c =0;&#xD;
				while(c&lt;comp.attributiDettaglioOrdine.size()){&#xD;
					var temp = comp.attributiDettaglioOrdine.get(c);&#xD;
					if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPIUTENTE){&#xD;
						VPIOrdine = temp.valoreAttributo;&#xD;
						VPITrovato = true;&#xD;
					} else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCIUTENTE){&#xD;
						VCIOrdine = temp.valoreAttributo;&#xD;
						VCITrovato = true;&#xD;
					} else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN){&#xD;
						USERVLANIDOrdine = temp.valoreAttributo;&#xD;
						USERVLANIDTrovato = true;&#xD;
					} else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI){&#xD;
						DLCIOrdine = temp.valoreAttributo;&#xD;
						DLCITrovato = true;&#xD;
					} else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS){    //SM_9894&#xD;
						IDENTIFICATIVOCOSOrdine = temp.valoreAttributo;&#xD;
						IDENTIFICATIVOCOSTrovato = true;&#xD;
					}&#xD;
					c++;&#xD;
				}&#xD;
				Process.auditLog(&quot;VPIOrdine: &quot;+VPIOrdine+&quot;, VCIOrdine: &quot;+VCIOrdine+&quot; ,USERVLANIDOrdine: &quot;+USERVLANIDOrdine +&quot;,DLCIOrdine: &quot;+DLCIOrdine +&quot;,IDENTIFICATIVOCOSOrdine: &quot; +IDENTIFICATIVOCOSOrdine);&#xD;
				&#xD;
			}&#xD;
			var corrispondezaTrovata = true;&#xD;
			//asset Principale&#xD;
			for(var j=0;Asset!= null &amp;&amp; j&lt;Asset.dettaglioasset.size(); j++){&#xD;
				var dettaglioAsset =Asset.dettaglioasset.get(j);&#xD;
				corrispondezaTrovata = true;&#xD;
				&#xD;
				if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
				|| comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC&#xD;
				|| comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
				|| comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS    //SM_9894&#xD;
				){&#xD;
					var DLCI = &quot;&quot;;&#xD;
					var VPI = &quot;&quot;;&#xD;
					var VCI = &quot;&quot;;&#xD;
					var USERVLANID = &quot;&quot;;&#xD;
					var IDENTIFICATIVOCOS = &quot;&quot;;  //SM_9894&#xD;
					var DLCITrovato = false;&#xD;
					var VPITrovato = false;&#xD;
					var VCITrovato = false;&#xD;
					var USERVLANIDAssetTrovato = false;&#xD;
					var IDENTIFICATIVOCOSAssetTrovato = false;  //SM_9894&#xD;
			&#xD;
					var c =0;&#xD;
					while(c&lt;dettaglioAsset.attributidettaglioasset.size()){&#xD;
						var temp = dettaglioAsset.attributidettaglioasset.get(c);&#xD;
						if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI){&#xD;
							VPI = temp.valoreAttributo;&#xD;
							VPITrovato = true;&#xD;
						} else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI){&#xD;
							VCI = temp.valoreAttributo;&#xD;
							VCITrovato = true;&#xD;
						} else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID){&#xD;
							USERVLANID = temp.valoreAttributo;&#xD;
							USERVLANIDAssetTrovato = true;&#xD;
						}else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI){&#xD;
							DLCI = temp.valoreAttributo;&#xD;
							DLCITrovato = true;&#xD;
						}else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS){&#xD;
							IDENTIFICATIVOCOS = temp.valoreAttributo;&#xD;
							IDENTIFICATIVOCOSAssetTrovato = true;&#xD;
						}&#xD;
						c++;&#xD;
					}&#xD;
					&#xD;
					Process.auditLog(&quot;VPI: &quot;+VPI+&quot;, VCI: &quot;+VCI+&quot; ,USERVLANID: &quot;+USERVLANID+&quot;,DLCI: &quot;+DLCI+ &quot;,IDENTIFICATIVOCOS: &quot;+IDENTIFICATIVOCOS);&#xD;
					&#xD;
					corrispondezaTrovata= false;&#xD;
					if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
					|| comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC){&#xD;
						if((VPIOrdine != null &amp;&amp; VCIOrdine != null &amp;&amp; VPIOrdine != &quot;&quot; &amp;&amp; VCIOrdine != &quot;&quot; &amp;&amp; VPI == VPIOrdine &amp;&amp; VCI == VCIOrdine)&#xD;
						|| (DLCIOrdine != null &amp;&amp; DLCIOrdine != &quot;&quot; &amp;&amp; DLCI == DLCIOrdine)){&#xD;
							corrispondezaTrovata = true;&#xD;
						}&#xD;
						else{&#xD;
							corrispondezaTrovata = false;&#xD;
						}&#xD;
					}&#xD;
					else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
						if(USERVLANID == USERVLANIDOrdine){&#xD;
							corrispondezaTrovata = true;&#xD;
						}&#xD;
						else if(USERVLANIDTrovato &amp;&amp; localRequest.ordine.tipologiaSottolav!=null &#xD;
						&amp;&amp; localRequest.ordine.tipologiaSottolav==it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING &#xD;
						&amp;&amp; !USERVLANIDAssetTrovato &amp;&amp; dettaglioAsset.nomeComponente ==it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &#xD;
						&amp;&amp; dettaglioAsset.statoDettaglioAsset!=it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)&#xD;
						{&#xD;
							corrispondezaTrovata = true;&#xD;
						}&#xD;
						else{&#xD;
							corrispondezaTrovata = false;&#xD;
						}&#xD;
					}&#xD;
					//SM_9894&#xD;
					else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
					{&#xD;
						if(IDENTIFICATIVOCOSOrdine != &quot;&quot; &amp;&amp; IDENTIFICATIVOCOSOrdine != null &amp;&amp; IDENTIFICATIVOCOS != &quot;&quot; &amp;&amp; IDENTIFICATIVOCOS != null&#xD;
						   &amp;&amp; IDENTIFICATIVOCOS == IDENTIFICATIVOCOSOrdine){&#xD;
							corrispondezaTrovata = true;&#xD;
						}&#xD;
						else{&#xD;
							corrispondezaTrovata = false;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				Process.auditLog(&quot;corrispondezaTrovata: &quot; + corrispondezaTrovata);&#xD;
				&#xD;
				if(corrispondezaTrovata){&#xD;
					var trovato = false;&#xD;
					&#xD;
					if((localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC&#xD;
						|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONECARATTERISTICA)&#xD;
						&amp;&amp; String(comp.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot; &amp;&amp; String(dettaglioAsset.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						dettaglioAsset.nomeComponente = comp.nomeComponente;&#xD;
					}&#xD;
					&#xD;
					for(var k=0;!trovato &amp;&amp; k&lt;dettaglioAsset.attributidettaglioasset.size(); k++){&#xD;
						var attributoAsset = dettaglioAsset.attributidettaglioasset.get(k);&#xD;
						if(dettaglioAsset.nomeComponente == comp.nomeComponente &amp;&amp; (dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC  || dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC) &amp;&amp; attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAESPLETAMENTOVC){&#xD;
							&#xD;
							trovato = true;&#xD;
							attributoAsset.lastUpdate = ora;&#xD;
							dettaglioAsset.lastUpdate = ora;&#xD;
							attributoAsset.valoreAttributo = localRequest.ordine.DES;&#xD;
						}&#xD;
						if(dettaglioAsset.nomeComponente == comp.nomeComponente &amp;&amp; dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp; attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAESPLETAMENTOUSERVLAN){&#xD;
							trovato = true;&#xD;
							dettaglioAsset.lastUpdate = ora;&#xD;
							attributoAsset.lastUpdate = ora;&#xD;
							attributoAsset.valoreAttributo = localRequest.ordine.DES;&#xD;
						}&#xD;
					}	&#xD;
						&#xD;
					for(var attDetOrdi_index = 0; attDetOrdi_index&lt;comp.attributiDettaglioOrdine.size(); attDetOrdi_index++){	&#xD;
						var t = 0;&#xD;
						var trovatoAttributo = false;&#xD;
						var attDettaglioOrdine = comp.attributiDettaglioOrdine.get(attDetOrdi_index);&#xD;
						&#xD;
						// cerco la configurazione per il particolare attributo&#xD;
						var configurazioneTrovata = false;&#xD;
						var k=0;&#xD;
						while(!configurazioneTrovata &amp;&amp; k&lt;OrdineAttributo.size()){&#xD;
					&#xD;
							if(String(comp.nomeComponente) == OrdineComponente.get(k) &amp;&amp; String(attDettaglioOrdine.nomeAttributo)== OrdineAttributo.get(k)&#xD;
								&amp;&amp; String(dettaglioAsset.nomeComponente) == AssetComponente.get(k)){&#xD;
								configurazioneTrovata=true;&#xD;
								var indiceConfigurazione = k;&#xD;
							}&#xD;
							k++;	&#xD;
						}&#xD;
						&#xD;
						Process.auditLog(&quot;configurazioneTrovata: &quot; + configurazioneTrovata);&#xD;
						&#xD;
						if(configurazioneTrovata){&#xD;
							while(!trovatoAttributo &amp;&amp; t&lt;dettaglioAsset.attributidettaglioasset.size()){&#xD;
								var attDettaglioAsset = dettaglioAsset.attributidettaglioasset.get(t);&#xD;
								if(attDettaglioAsset.nomeAttributo == AssetAttributo.get(indiceConfigurazione)){&#xD;
									trovatoAttributo = true;&#xD;
									if(attDettaglioOrdine.valoreAttributo ==&quot;ATTRIBUTO IN ELIMINAZIONE&quot; ){&#xD;
										dettaglioAsset.attributidettaglioasset.remove(t);&#xD;
											Process.auditLog(&quot;Eliminato attributo &quot;+attDettaglioOrdine.nomeAttributo+ &quot; nella componente &quot;+dettaglioAsset.nomeComponente);&#xD;
										t--;&#xD;
										&#xD;
									}&#xD;
									else if(attDettaglioOrdine.valoreAttributo !=&quot;ATTRIBUTO IN ELIMINAZIONE&quot;){&#xD;
										attDettaglioAsset.valoreAttributo = attDettaglioOrdine.valoreAttributo;&#xD;
										attDettaglioAsset.lastUpdate = ora;&#xD;
										Process.auditLog(&quot;Modificato attributo &quot;+attDettaglioAsset.nomeAttributo+ &quot; nella componente &quot;+dettaglioAsset.nomeComponente);&#xD;
									}&#xD;
								&#xD;
								}&#xD;
								t++;&#xD;
							}&#xD;
							if(!trovatoAttributo){&#xD;
								var attributoDaAggiungere = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioAsset();&#xD;
								attributoDaAggiungere.IDAsset = dettaglioAsset.IDAsset;&#xD;
								attributoDaAggiungere.IDDettaglioAsset = dettaglioAsset.IDDettaglioAsset;&#xD;
								attributoDaAggiungere.created = ora;&#xD;
								attributoDaAggiungere.lastUpdate = ora;&#xD;
								attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(AssetAttributo.get(indiceConfigurazione));&#xD;
								attributoDaAggiungere.operatore = attDettaglioOrdine.operatore;&#xD;
								attributoDaAggiungere.tipologiaDato = attDettaglioOrdine.tipologiaDato;&#xD;
								attributoDaAggiungere.valoreAttributo = attDettaglioOrdine.valoreAttributo;&#xD;
									&#xD;
								dettaglioAsset.attributidettaglioasset.add(attributoDaAggiungere);&#xD;
								&#xD;
								Process.auditLog(&quot;Aggiunto attributo &quot;+attributoDaAggiungere.nomeAttributo+ &quot; nella componente &quot;+dettaglioAsset.nomeComponente);&#xD;
							}&#xD;
						}				&#xD;
					}&#xD;
					if(!trovato &amp;&amp; dettaglioAsset.nomeComponente == comp.nomeComponente &amp;&amp; (dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN || dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC  || dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)){&#xD;
						var attributoDettaglioAsset = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioAsset();&#xD;
						attributoDettaglioAsset.IDAsset = dettaglioAsset.IDAsset;	&#xD;
						attributoDettaglioAsset.IDDettaglioAsset = dettaglioAsset.IDDettaglioAsset;&#xD;
						attributoDettaglioAsset.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.DATE;&#xD;
						attributoDettaglioAsset.created = ora;&#xD;
						attributoDettaglioAsset.lastUpdate = ora;&#xD;
						if(dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
							attributoDettaglioAsset.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAESPLETAMENTOUSERVLAN;&#xD;
						}&#xD;
						else{&#xD;
							attributoDettaglioAsset.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAESPLETAMENTOVC;&#xD;
						}&#xD;
&#xD;
						attributoDettaglioAsset.operatore = dettaglioAsset.operatore;&#xD;
						attributoDettaglioAsset.valoreAttributo = localRequest.ordine.DES;&#xD;
						&#xD;
						dettaglioAsset.lastUpdate = ora;&#xD;
						dettaglioAsset.attributidettaglioasset.add(ScriptUtil.copy(attributoDettaglioAsset));&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			if(corrispondezaTrovata){&#xD;
				Process.auditLog(&quot;Componente asset trovato&quot;);&#xD;
			}&#xD;
			else{&#xD;
				Process.auditLog(&quot;Componente asset non trovato&quot;);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="86.0" LaneId="_Wx-hO4o4EeaXiuJl6VlD_w" Width="130.0">
              <xpdl2:Coordinates XCoordinate="2897.0" YCoordinate="461.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_NZT8cNi3Eea4Te2nwfwYNA">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_uj8VUdi3Eea4Te2nwfwYNA"/>
                  <xpdl2:TransitionRef Id="_B_vvANvfEeaT0Nqk9h1OlQ"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="45.0" LaneId="_Wx-hO4o4EeaXiuJl6VlD_w" Width="43.0">
              <xpdl2:Coordinates XCoordinate="3106.0" YCoordinate="461.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_uj8VUNi3Eea4Te2nwfwYNA" Name="C01M02F18GestioneCorrelazioneConsistenza" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="C01M02F18– Gestione Correlazione Consistenza" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Attivazione di un ULL Linea non Attiva con destinazione uso D per cui si necessita una correlazione con ULL destinazione uso F&#xD;
Process.auditLog(&quot;Inizio C01M02F18– Gestione Correlazione Consistenza.&quot;);&#xD;
&#xD;
//Set DestinazioneUsoDati&#xD;
var DestinazioneUsoDati = DataUtil.createList();&#xD;
DestinazioneUsoDati.add(&quot;10&quot;);&#xD;
DestinazioneUsoDati.add(&quot;4&quot;);&#xD;
DestinazioneUsoDati.add(&quot;5&quot;);&#xD;
DestinazioneUsoDati.add(&quot;9&quot;);&#xD;
&#xD;
//Set ServiziFonia&#xD;
var ServiziFonia =  DataUtil.createList();&#xD;
ServiziFonia.add(&quot;ULL&quot;);&#xD;
ServiziFonia.add(&quot;SLU&quot;);&#xD;
ServiziFonia.add(&quot;WLR&quot;);&#xD;
//ServiziFonia.add(&quot;SHA&quot;);&#xD;
		&#xD;
var IDRisorsaCorrelatoFoniaTrovato = false;&#xD;
var IDRisorsaCorrelatoFonia = &quot;&quot;;&#xD;
&#xD;
var IDRisorsaCorrelatoDatiTrovato = false;&#xD;
var IDRisorsaCorrelatoDati = &quot;&quot;;&#xD;
&#xD;
var componenteCONSISTENZAFONIA = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
componenteCONSISTENZAFONIA = null;&#xD;
&#xD;
var componenteCONSISTENZADATI = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
componenteCONSISTENZADATI = null;&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
while((!IDRisorsaCorrelatoFoniaTrovato || !IDRisorsaCorrelatoDatiTrovato) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
	{&#xD;
		componenteCONSISTENZAFONIA = ScriptUtil.copy(componente);&#xD;
		var j = 0;&#xD;
		Process.auditLog(&quot;Componente CONSISTENZAFONIA trovata.&quot;);&#xD;
		while(!IDRisorsaCorrelatoFoniaTrovato &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
			if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSACORRELATO)&#xD;
			{&#xD;
				IDRisorsaCorrelatoFoniaTrovato = true;&#xD;
				IDRisorsaCorrelatoFonia = attr.valoreAttributo;&#xD;
				Process.auditLog(&quot;Attributo IDRISORSACORRELATO della componente CONSISTENZAFONIA trovata.&quot;);&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
	{&#xD;
		componenteCONSISTENZADATI = ScriptUtil.copy(componente);&#xD;
		var j = 0;&#xD;
		Process.auditLog(&quot;Componente CONSISTENZADATI trovata.&quot;);&#xD;
		while(!IDRisorsaCorrelatoDatiTrovato &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
			if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSACORRELATO)&#xD;
			{&#xD;
				IDRisorsaCorrelatoDatiTrovato = true;&#xD;
				IDRisorsaCorrelatoDati = attr.valoreAttributo;&#xD;
				Process.auditLog(&quot;Attributo IDRISORSACORRELATO della componente CONSISTENZADATI trovata.&quot;);&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(AssetConsistenzaDati == null)&#xD;
{&#xD;
	Process.auditLog(&quot;AssetConsistenzaDati non presente.&quot;);&#xD;
}&#xD;
if(AssetConsistenzaFonia == null)&#xD;
{&#xD;
	Process.auditLog(&quot;AssetConsistenzaFonia non presente.&quot;);&#xD;
}&#xD;
&#xD;
if(IDRisorsaCorrelatoFoniaTrovato)&#xD;
{&#xD;
	//Attivazione di un ULL Linea non Attiva &#xD;
	if(localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
	{&#xD;
		var DESTINAZIONEUSO = &quot;&quot;;&#xD;
		DESTINAZIONEUSO = null;&#xD;
		var i = 0;&#xD;
		while(DESTINAZIONEUSO == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(DESTINAZIONEUSO == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
					{&#xD;
						DESTINAZIONEUSO = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		if(DESTINAZIONEUSO != null &amp;&amp; DestinazioneUsoDati.contains(DESTINAZIONEUSO))&#xD;
		{&#xD;
			if(AssetConsistenzaFonia != null)&#xD;
			{&#xD;
				AssetConsistenzaFonia.IDRisorsaCorrelato = IDRisorsaCorrelatoFonia;&#xD;
			}&#xD;
			&#xD;
			//Recupera ordine correlato&#xD;
			for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
			{&#xD;
				var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
				if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
				{&#xD;
					var j = 0;&#xD;
					var trovato = false;&#xD;
					while(!trovato &amp;&amp; j &lt; comp.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
						/*&#xD;
						if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRICHIESTAOLO)&#xD;
						{&#xD;
							correlatedRequestRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByIDRichiestaOLO(attr.valoreAttributo);&#xD;
							if(AssetConsistenzaDatiRef != null)&#xD;
							{&#xD;
								correlatedRequest = correlatedRequestRef.readRichiesta();&#xD;
							}&#xD;
							else&#xD;
							{&#xD;
								Process.auditLog(&quot;Nessuna Richiesta trovato con IDRICHIESTAOLO: &quot; + attr.valoreAttributo);&#xD;
							}&#xD;
							&#xD;
						}&#xD;
						*/&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if(correlatedRequest != null)&#xD;
			{&#xD;
				correlatedRequest.IDRisorsaCorrelato = IDRisorsaCorrelatoFonia;&#xD;
				correlatedRequestModificato=true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
//Attivazione di BTS condiviso (VULAC  su Linea Pots e BTS NGA FTTC su Linea Pots) e Attivazione SHA&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
	&amp;&amp;&#xD;
	((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB &amp;&amp; localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS)&#xD;
		||&#xD;
		(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB &amp;&amp; localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS)&#xD;
		||&#xD;
		((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE)&#xD;
			&amp;&amp; (localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS&#xD;
				|| localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN))&#xD;
		||		&#xD;
		(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT &amp;&amp; (localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS || localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN))&#xD;
		||&#xD;
		((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT || localRequest.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE) &amp;&amp; (localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS || localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN))&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA &#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA&#xD;
		))&#xD;
	{&#xD;
	&#xD;
	if(Asset != null &amp;&amp; IDRisorsaCorrelatoFoniaTrovato)&#xD;
	{&#xD;
		Asset.IDRisorsaCorrelato = IDRisorsaCorrelatoFonia;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Asset non creato, non è stato possibile aggiornare l'elemento IDRisorsaCorrelato dell'asset. IDRisorsaCorrelato: &quot; + IDRisorsaCorrelatoFonia);&#xD;
	}&#xD;
	&#xD;
	if(AssetConsistenzaDati != null)&#xD;
	{&#xD;
		AssetConsistenzaDati.IDRisorsaCorrelato= null;&#xD;
		ConsistenzaDatiModificato = true;&#xD;
	}&#xD;
	if(Asset!= null &amp;&amp; AssetConsistenzaFonia != null){&#xD;
		AssetConsistenzaFonia.IDRisorsaCorrelato= Asset.IDRisorsa;&#xD;
		ConsistenzaFoniaModificato = true;&#xD;
	}&#xD;
}&#xD;
&#xD;
//Variazione Fonia &#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
	&amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
{&#xD;
	var OffertaGenerica = String(localRequest.offerta).slice(0,3);&#xD;
	if(ServiziFonia.contains(OffertaGenerica)&#xD;
	/*|| (localRequest.ambito == &quot;BPM&quot; &amp;&amp; (localRequest.ordine.tipologiaSottolav.DECREMENTONP || localRequest.ordine.tipologiaSottolav.DECREMENTOULL || localRequest.ordine.tipologiaSottolav.DECREMENTOSLU))*/)&#xD;
	{&#xD;
		var SottoLav = DataUtil.createList();&#xD;
		SottoLav.add(&quot;TRASLOCOWLR13&quot;);&#xD;
		SottoLav.add(&quot;TRASLOCOWLR14&quot;);&#xD;
		SottoLav.add(&quot;TRASLOCOWLR15&quot;);&#xD;
		SottoLav.add(&quot;TRASLOCOWLR16&quot;);&#xD;
		SottoLav.add(&quot;CAMBIONUMERO3&quot;);&#xD;
		SottoLav.add(&quot;CAMBIONUMERO4&quot;);			&#xD;
		&#xD;
		var BTS = DataUtil.createList();&#xD;
		BTS.add(&quot;BITSTREAMATMASIMMETRICOFLAT&quot;);&#xD;
		BTS.add(&quot;BITSTREAMATMASIMMETRICOHL&quot;);&#xD;
		BTS.add(&quot;BITSTREAMATMASIMMETRICOLITE&quot;);&#xD;
		BTS.add(&quot;BITSTREAMGBEASIMMETRICOFLAT&quot;);&#xD;
		BTS.add(&quot;BITSTREAMNGAFTTCAB&quot;);&#xD;
		BTS.add(&quot;BITSTREAMNGAFTTH&quot;);&#xD;
		BTS.add(&quot;EASYIPBASEPLUSFLAT&quot;);&#xD;
		BTS.add(&quot;EASYIPBASEPLUSLITE&quot;);&#xD;
		BTS.add(&quot;EASYIPSPECIALPROFILEFLAT&quot;);&#xD;
		BTS.add(&quot;EASYIPSPECIALPROFILELITE&quot;);&#xD;
		BTS.add(&quot;VULAFTTCAB&quot;);&#xD;
		BTS.add(&quot;VULAFTTH&quot;);&#xD;
		BTS.add(&quot;BITSTREAMATMSIMMETRICOFLAT&quot;);&#xD;
		BTS.add(&quot;BITSTREAMATMSIMMETRICOHL&quot;);&#xD;
		BTS.add(&quot;BITSTREAMGBEASIMMETRICOFLAT&quot;);&#xD;
		BTS.add(&quot;BITSTREAMGBESIMMETRICOFLAT&quot;);&#xD;
		BTS.add(&quot;SEMIVULAFTTH&quot;);                   //RU_1164: aggiunte SEMI***&#xD;
		BTS.add(&quot;SEMIBITSTREAMNGAFTTH&quot;);&#xD;
&#xD;
					&#xD;
		if(localRequest.ordine != null &amp;&amp; SottoLav.contains(String(localRequest.ordine.tipologiaSottolav)))&#xD;
		{&#xD;
			if(AssetConsistenzaFonia.IDRisorsaCorrelato != null)&#xD;
			{&#xD;
				//Cerca asset correlato alla component fonia&#xD;
				var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: IDRis and statoAsset&lt;>'CESSATO'&quot;);&#xD;
				c.setQueryParameter(&quot;IDRis&quot;, AssetConsistenzaFonia.IDRisorsaCorrelato);&#xD;
				var AssetCorrelatoRefMultiplo = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);	&#xD;
				if(AssetCorrelatoRefMultiplo != null &amp;&amp; AssetCorrelatoRefMultiplo.size()>0)&#xD;
				{&#xD;
					AssetCorrelatoRef = AssetCorrelatoRefMultiplo.get(0);&#xD;
					AssetCorrelato = AssetCorrelatoRef.readAsset();&#xD;
					Process.auditLog(&quot;AssetCorrelato con offerta: &quot; + AssetCorrelato.offerta);&#xD;
&#xD;
					if(BTS.contains(String(AssetCorrelato.offerta)))&#xD;
					{&#xD;
						AssetCorrelatoModificato = true;&#xD;
						if(Asset != null)&#xD;
						{&#xD;
							AssetCorrelato.IDRisorsaCorrelato = Asset.IDRisorsa;&#xD;
							Asset.IDRisorsaCorrelato = AssetCorrelato.IDRisorsa;&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							Process.auditLog(&quot;Asset non creato, non è stato possibile aggiornare l'elemento IDRisorsaCorrelato dell'asset correlato con AssetConsistenzaFonia.IDRisorsaCorrelato: &quot; + AssetConsistenzaFonia.IDRisorsaCorrelato);&#xD;
						}&#xD;
						for(var l = 0; l &lt; AssetCorrelato.dettaglioasset.size(); l++)&#xD;
						{&#xD;
							var comp = AssetCorrelato.dettaglioasset.get(l);&#xD;
							if(String(comp.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
							{ &#xD;
								for(var k = 0; k &lt; comp.attributidettaglioasset.size(); k++)&#xD;
								{									&#xD;
									if(comp.attributidettaglioasset.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGCAMBIONUMERO)&#xD;
									{&#xD;
										comp.attributidettaglioasset.get(k).valoreAttributo = &quot;Y&quot;;&#xD;
									}&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
					else{&#xD;
						Process.auditLog(&quot;Asset correlato non BTS&quot;);&#xD;
					}&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					Process.auditLog(&quot;Nessun asset recuperato con AssetConsistenzaFonia.IDRisorsaCorrelato: &quot; + AssetConsistenzaFonia.IDRisorsaCorrelato);&#xD;
				}		&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
		&#xD;
//Cessazione ULL/WLR/SLU/VULL&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp; ((String(localRequest.offerta)).slice(0,3) == &quot;ULL&quot; || ((String(localRequest.offerta)).slice(0,3) == &quot;WLR&quot; || ((String(localRequest.offerta)).slice(0,3) == &quot;SLU&quot; || ((String(localRequest.offerta)).slice(0,4) == &quot;VULL&quot; )))))&#xD;
{&#xD;
	var i = 0;&#xD;
	var azioneDati = &quot;&quot;;&#xD;
	azioneDati = null;&#xD;
	while(azioneDati == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var DettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(DettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
		{&#xD;
			azioneDati = String(DettOrd.azione);&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	var i = 0;&#xD;
	var azioneFonia = &quot;&quot;;&#xD;
	azioneFonia = null;&#xD;
	while(azioneFonia == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var DettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(DettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			azioneFonia = String(DettOrd.azione);&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	Process.auditLog(&quot;Cessazione ULL/WLR/SLU/VULL - Fonia Azione:&quot;+azioneFonia+&quot;, Dati Azione:&quot;+azioneDati);&#xD;
	if(AssetConsistenzaDati != null &amp;&amp; AssetConsistenzaDati.IDRisorsaCorrelato == Asset.IDRisorsa &amp;&amp; azioneDati == &quot;M&quot;)&#xD;
	{&#xD;
		AssetConsistenzaDati.IDRisorsaCorrelato = null;&#xD;
		ConsistenzaDatiModificato = true;&#xD;
	}&#xD;
	&#xD;
	if(AssetConsistenzaFonia != null &amp;&amp; AssetConsistenzaDati != null)&#xD;
	{&#xD;
		Process.auditLog(&quot;AssetConsistenzaDati.offerta: &quot;+AssetConsistenzaDati.offerta+&quot;, AssetConsistenzaFonia.offerta:&quot;+AssetConsistenzaFonia.offerta);&#xD;
	}&#xD;
	&#xD;
	if(componenteCONSISTENZADATI != null &amp;&amp; componenteCONSISTENZAFONIA != null)&#xD;
	{&#xD;
		Process.auditLog(&quot;componenteCONSISTENZADATI.azione: &quot;+componenteCONSISTENZADATI.azione+&quot;, componenteCONSISTENZAFONIA.azione: &quot;+componenteCONSISTENZAFONIA.azione);&#xD;
	}&#xD;
	&#xD;
	//RU_632 - Scorrelazione degli asset perche uno dei due è stato cessato (caso ULL+ULL TLC o SLU+SLU TLC)&#xD;
	if(localRequest.codificaOLOAGCOM == &quot;TLC&quot; &#xD;
	&amp;&amp; componenteCONSISTENZADATI != null &amp;&amp; componenteCONSISTENZAFONIA != null &amp;&amp; AssetConsistenzaDati != null &amp;&amp; AssetConsistenzaFonia != null &#xD;
	&amp;&amp; ((AssetConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA &amp;&amp; AssetConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA)||&#xD;
		(AssetConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA &amp;&amp; AssetConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA))&#xD;
	&amp;&amp; ((componenteCONSISTENZADATI.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N &amp;&amp; componenteCONSISTENZAFONIA.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M)&#xD;
		|| (componenteCONSISTENZADATI.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M &amp;&amp; componenteCONSISTENZAFONIA.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)))&#xD;
	{&#xD;
		AssetConsistenzaDati.IDRisorsaCorrelato = null;&#xD;
		ConsistenzaDatiModificato = true;&#xD;
		&#xD;
		AssetConsistenzaFonia.IDRisorsaCorrelato = null;&#xD;
		ConsistenzaFoniaModificato = true;&#xD;
		&#xD;
		Process.auditLog(&quot;Asset con id &quot;+AssetConsistenzaDati.IDAsset+&quot; e &quot;+AssetConsistenzaFonia.IDAsset+&quot; scorrelati&quot;);&#xD;
		&#xD;
		//Scorrelazione asset principale&#xD;
		if(AssetConsistenzaDati.IDAsset == Asset.IDAsset)&#xD;
		{&#xD;
			Asset.IDRisorsaCorrelato = null;&#xD;
		}&#xD;
		else if(AssetConsistenzaFonia.IDAsset == Asset.IDAsset)&#xD;
		{&#xD;
			Asset.IDRisorsaCorrelato = null;&#xD;
		}&#xD;
	}&#xD;
}	&#xD;
&#xD;
	//Cessazione BTS/NGA/GBE/EASYIP/SHA&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &#xD;
        &amp;&amp; ((String(localRequest.offerta)).slice(0,9) == &quot;BITSTREAM&quot; || (String(localRequest.offerta)).slice(0,6) == &quot;EASYIP&quot; || (String(localRequest.offerta)).slice(0,3) == &quot;SHA&quot; || (String(localRequest.offerta)).slice(0,4) == &quot;VULA&quot; || (String(localRequest.offerta)).slice(0,4) == &quot;SEMI&quot;))   //RU_1164: aggiunte SEMI***&#xD;
{&#xD;
	var i = 0;&#xD;
	var azioneFonia = &quot;&quot;;&#xD;
	azioneFonia = null;&#xD;
	while(azioneFonia == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var DettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(DettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			azioneFonia = String(DettOrd.azione);&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	Process.auditLog(&quot;Casistica Attivazione WLR/VULL LA- azioneFonia:&quot;+azioneFonia);&#xD;
	if(AssetConsistenzaFonia != null &amp;&amp; AssetConsistenzaFonia.IDRisorsaCorrelato == Asset.IDRisorsa &amp;&amp; azioneFonia == &quot;M&quot;)&#xD;
	{&#xD;
		AssetConsistenzaFonia.IDRisorsaCorrelato = null;&#xD;
		ConsistenzaFoniaModificato = true;&#xD;
	}&#xD;
}&#xD;
&#xD;
//--------------------------------------------------RU_392--------------------------------------------------//&#xD;
//Attivazione WLR/VULL LA&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp; ((String(localRequest.offerta)).slice(0,3) == &quot;WLR&quot; || (String(localRequest.offerta)).slice(0,4) == &quot;VULL&quot; ))&#xD;
{&#xD;
	//Recupera ordine correlato&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var Foniaazione = &quot;&quot;;&#xD;
		var	Datiazione = &quot;&quot;;&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			Foniaazione = String(comp.azione);&#xD;
		}&#xD;
		else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
		{&#xD;
			Datiazione = String(comp.azione);&#xD;
		}			&#xD;
	}&#xD;
	Process.auditLog(&quot;Casistica Attivazione WLR/VULL LA- Foniaazione:&quot;+Foniaazione+&quot;, Datiazione:&quot;+Datiazione);&#xD;
	if(AssetConsistenzaDati != null &amp;&amp; Foniaazione == &quot;D&quot; &amp;&amp; Datiazione == &quot;M&quot;)&#xD;
	{&#xD;
		AssetConsistenzaDati.IDRisorsaCorrelato = Asset.IDRisorsa;&#xD;
		ConsistenzaDatiModificato = true;&#xD;
		Asset.IDRisorsaCorrelato = AssetConsistenzaDati.IDRisorsa;&#xD;
	}&#xD;
}&#xD;
//SM_9694 - Migrazione ACCORPAMENTOOLO (MIG OLO ASSET) - gestione dedicata&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &amp;&amp; AssetConsistenzaDati != null &amp;&amp; AssetConsistenzaFonia != null&#xD;
&amp;&amp; AssetConsistenzaDati.IDRisorsaCorrelato == AssetConsistenzaFonia.IDRisorsa&#xD;
&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
{&#xD;
	Process.auditLog(&quot;Inizio logiche per MIG ACCORPAMENTOOLO (MIG OLO ASSET)&quot;);&#xD;
	&#xD;
	var Foniaazione = &quot;&quot;;&#xD;
	var	Datiazione = &quot;&quot;;&#xD;
	&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			Foniaazione = String(comp.azione);&#xD;
		}&#xD;
		else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
		{&#xD;
			Datiazione = String(comp.azione);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	Process.auditLog(&quot;Casistica Migrazione Foniaazione:&quot;+Foniaazione+&quot;, Datiazione:&quot;+Datiazione);&#xD;
	&#xD;
	if(Foniaazione == &quot;M&quot; &amp;&amp; Datiazione == &quot;D&quot;)&#xD;
	{&#xD;
		AssetConsistenzaFonia.IDRisorsaCorrelato = Asset.IDRisorsa;&#xD;
		ConsistenzaFoniaModificato = true;&#xD;
		Asset.IDRisorsaCorrelato = AssetConsistenzaFonia.IDRisorsa;&#xD;
	}&#xD;
	else if(Foniaazione == &quot;D&quot; &amp;&amp; Datiazione == &quot;M&quot;)&#xD;
	{&#xD;
		AssetConsistenzaDati.IDRisorsaCorrelato = Asset.IDRisorsa;&#xD;
		ConsistenzaFoniaModificato = true;&#xD;
		Asset.IDRisorsaCorrelato = AssetConsistenzaDati.IDRisorsa;&#xD;
	}&#xD;
}&#xD;
//Migrazione da DonatingCondiviso&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &amp;&amp; AssetConsistenzaDati != null &amp;&amp; AssetConsistenzaFonia != null)&#xD;
{&#xD;
	Process.auditLog(&quot;Inizio logiche per Migrazioni&quot;);&#xD;
	var Tipolinea = &quot;&quot;;&#xD;
	var Foniaazione = &quot;&quot;;&#xD;
	var	Datiazione = &quot;&quot;;&#xD;
	var DestinazioneUsoRecipient = &quot;&quot;;&#xD;
	&#xD;
	//Recupera ordine correlato&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
			&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			Foniaazione = String(comp.azione);&#xD;
		}&#xD;
		else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
		{&#xD;
			Datiazione = String(comp.azione);&#xD;
			&#xD;
			for(var j = 0; j &lt; comp.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					&#xD;
					Tipolinea = attr.valoreAttributo;&#xD;
					Process.auditLog(&quot;Tipolinea:&quot;+Tipolinea);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if (String(comp.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j = 0; j &lt; comp.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
				{&#xD;
					&#xD;
					DestinazioneUsoRecipient = attr.valoreAttributo;&#xD;
					Process.auditLog(&quot;DestinazioneUsoRecipient:&quot;+DestinazioneUsoRecipient);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	Process.auditLog(&quot;Casistica Migrazione - Foniaazione:&quot;+Foniaazione+&quot;, Datiazione:&quot;+Datiazione);&#xD;
	if(AssetConsistenzaFonia != null &amp;&amp; Foniaazione == &quot;M&quot; &amp;&amp; Datiazione == &quot;D&quot; &amp;&amp; Tipolinea == &quot;POTS&quot;)&#xD;
	{&#xD;
		AssetConsistenzaFonia.IDRisorsaCorrelato = Asset.IDRisorsa;&#xD;
		ConsistenzaFoniaModificato = true;&#xD;
		Asset.IDRisorsaCorrelato = AssetConsistenzaFonia.IDRisorsa;&#xD;
	}&#xD;
		&#xD;
	else if(AssetConsistenzaDati != null &amp;&amp; AssetConsistenzaFonia != null &amp;&amp; Foniaazione == &quot;M&quot; &amp;&amp; Datiazione == &quot;D&quot; &amp;&amp; Tipolinea == &quot;ISDN&quot;)&#xD;
	{&#xD;
		var FullLoop = DataUtil.createList();&#xD;
		FullLoop.add(&quot;ULLLINEAATTIVA&quot;);&#xD;
		FullLoop.add(&quot;ULLLINEANONATTIVA&quot;);&#xD;
		FullLoop.add(&quot;ULLLINEAATTIVANP&quot;);&#xD;
		FullLoop.add(&quot;ULLDATILINEAATTIVA&quot;);&#xD;
		FullLoop.add(&quot;ULLDATILINEANONATTIVA&quot;);&#xD;
		FullLoop.add(&quot;ULLDATILINEAATTIVANP&quot;);&#xD;
		FullLoop.add(&quot;SLULINEAATTIVA&quot;);&#xD;
		FullLoop.add(&quot;SLULINEANONATTIVA&quot;);&#xD;
		FullLoop.add(&quot;SLULINEAATTIVANP&quot;);	&#xD;
		&#xD;
		var FullLoopTLC = DataUtil.createList();&#xD;
		FullLoopTLC.add(&quot;ULLLINEAATTIVA&quot;);&#xD;
		FullLoopTLC.add(&quot;ULLLINEANONATTIVA&quot;);&#xD;
		FullLoopTLC.add(&quot;ULLLINEAATTIVANP&quot;);&#xD;
		FullLoopTLC.add(&quot;SLULINEAATTIVA&quot;);&#xD;
		FullLoopTLC.add(&quot;SLULINEANONATTIVA&quot;);&#xD;
		FullLoopTLC.add(&quot;SLULINEAATTIVANP&quot;);	&#xD;
					&#xD;
		if((localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO&#xD;
				&amp;&amp; localRequest.codificaOLOAGCOM != &quot;TLC&quot;&#xD;
				&amp;&amp; FullLoop.contains(String(localRequest.offerta)))&#xD;
			|| (localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO&#xD;
				&amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
				&amp;&amp; FullLoopTLC.contains(String(localRequest.offerta)))&#xD;
			|| (localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA &amp;&amp; localRequest.flagNaked == &quot;S&quot;))&#xD;
		{&#xD;
			AssetConsistenzaFonia.IDRisorsaCorrelato = null;&#xD;
			ConsistenzaFoniaModificato = true;&#xD;
		}&#xD;
		&#xD;
		for(var i = 0; i &lt; AssetConsistenzaDati.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var TipolineaAsset = &quot;&quot;;&#xD;
			var comp = AssetConsistenzaDati.dettaglioasset.get(i);&#xD;
			if(String(comp.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for(var j = 0; j &lt; comp.attributidettaglioasset.size(); j++)&#xD;
				{&#xD;
					var attr = comp.attributidettaglioasset.get(i);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						TipolineaAsset = attr.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if((Asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB &amp;&amp; TipolineaAsset == &quot;POTS&quot;) || Asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA)&#xD;
		{&#xD;
			AssetConsistenzaFonia.IDRisorsaCorrelato = Asset.IDRisorsa;&#xD;
			ConsistenzaFoniaModificato = true;&#xD;
			Asset.IDRisorsaCorrelato = AssetConsistenzaFonia.IDRisorsa;&#xD;
		}&#xD;
	}&#xD;
		&#xD;
	else if(AssetConsistenzaDati != null &amp;&amp; Foniaazione == &quot;D&quot; &amp;&amp; Datiazione == &quot;M&quot;)&#xD;
	{&#xD;
		//SM_7026&#xD;
		if ( String(localRequest.offerta).slice(0,3)== &quot;SLU&quot; &amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot; &amp;&amp; DestinazioneUsoRecipient == &quot;10&quot; &#xD;
				&amp;&amp; String(AssetConsistenzaFonia.offerta).slice(0,3) == &quot;ULL&quot; &amp;&amp; AssetConsistenzaFonia.codificaOLOAGCOM== &quot;TLC&quot;&#xD;
				&amp;&amp; String(AssetConsistenzaDati.offerta).slice(0,3) == &quot;ULL&quot; &amp;&amp; AssetConsistenzaDati.codificaOLOAGCOM== &quot;TLC&quot;)&#xD;
		{&#xD;
			AssetConsistenzaDati.IDRisorsaCorrelato = null;&#xD;
			ConsistenzaDatiModificato = true;&#xD;
			Asset.IDRisorsaCorrelato = null;&#xD;
		}&#xD;
		&#xD;
		//SM_8730&#xD;
		else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB || &#xD;
				 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH || &#xD;
				 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB ||&#xD;
				 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH ||&#xD;
				 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB ||&#xD;
				 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH ||&#xD;
				 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH ||        //RU_1164: aggiunte SEMI***       &#xD;
				 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH ||&#xD;
				 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)&#xD;
			&amp;&amp; localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.LINEANONFONIA&#xD;
			&amp;&amp; String(AssetConsistenzaDati.offerta).slice(0,3) == &quot;ULL&quot; &amp;&amp; AssetConsistenzaDati.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
		{&#xD;
			AssetConsistenzaDati.IDRisorsaCorrelato = null;&#xD;
			ConsistenzaDatiModificato = true;&#xD;
			Asset.IDRisorsaCorrelato = null;&#xD;
		}&#xD;
		//END SM_8730&#xD;
		&#xD;
		else&#xD;
		{&#xD;
			AssetConsistenzaDati.IDRisorsaCorrelato = localRequest.IDRisorsa;&#xD;
			ConsistenzaDatiModificato = true;&#xD;
			Asset.IDRisorsaCorrelato = AssetConsistenzaDati.IDRisorsa;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
// SM_8608 - CASO PARTICOLARE - Attivazione 274 Condivisa Dati su TI Fonia ULL LNA&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &amp;&amp; AssetConsistenzaDati == null &amp;&amp; AssetConsistenzaFonia != null&#xD;
&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274 &#xD;
&amp;&amp;(localRequest.ordine.tipologiaLinea == 'ISDN' || localRequest.ordine.tipologiaLinea == 'POTS')&#xD;
&amp;&amp; AssetConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA)&#xD;
{&#xD;
	Process.auditLog(&quot;Inizio logiche per CASO PARTICOLARE - Attivazione 274 Condivisa Dati su TI Fonia ULL LNA&quot;);&#xD;
	&#xD;
	var Foniaazione = &quot;&quot;;&#xD;
	Foniaazione = null;&#xD;
	var DestinazioneUsoConsistenza = &quot;&quot;;&#xD;
	DestinazioneUsoConsistenza = null;&#xD;
	&#xD;
	//Recupera ordine correlato&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			Foniaazione = String(comp.azione);&#xD;
			Process.auditLog(&quot;Fonia Azione:&quot;+Foniaazione);&#xD;
			&#xD;
			for(var j = 0; j &lt; comp.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
				{&#xD;
					DestinazioneUsoConsistenza = attr.valoreAttributo;&#xD;
					Process.auditLog(&quot;DestinazioneUsoConsistenza:&quot;+DestinazioneUsoConsistenza);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(DestinazioneUsoConsistenza.length > 2 &amp;&amp; Foniaazione == &quot;M&quot;)&#xD;
	{&#xD;
		AssetConsistenzaFonia.IDRisorsaCorrelato = localRequest.IDRisorsa;&#xD;
		ConsistenzaFoniaModificato = true;&#xD;
		&#xD;
		Asset.IDRisorsaCorrelato = AssetConsistenzaFonia.IDRisorsa;&#xD;
		localRequest.IDRisorsaCorrelato = AssetConsistenzaFonia.IDRisorsa;&#xD;
		&#xD;
		Process.auditLog(&quot;Correlato Asset principale &quot;+Asset.IDRisorsa+&quot; con IDRisorsa &quot;+Asset.IDRisorsaCorrelato+&quot;, e Asset Consistenza Fonia &quot;+AssetConsistenzaFonia.IDRisorsa+&quot; con IDRisorsa &quot;+AssetConsistenzaFonia.IDRisorsaCorrelato);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Correlazione Skippata&quot;);&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="116.0" LaneId="_Wx-hO4o4EeaXiuJl6VlD_w" Width="167.0">
              <xpdl2:Coordinates XCoordinate="3367.0" YCoordinate="461.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_1yEI4Ni3Eea4Te2nwfwYNA" Name="C01M02F19GestioneModificaDestinazioneUso" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="C01M02F19– Gestione Modifica Destinazione Uso">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;Inizio fiunzione Gestione Modifica Destinazione Uso&quot;);&#xD;
&#xD;
var CasoParticolare = false;&#xD;
&#xD;
// SM_8608 - CASO PARTICOLARE - Attivazione 274 Condivisa Dati su TI Fonia ULL LNA&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &amp;&amp; AssetConsistenzaDati == null &amp;&amp; AssetConsistenzaFonia != null&#xD;
&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274 &#xD;
&amp;&amp;(localRequest.ordine.tipologiaLinea == 'ISDN' || localRequest.ordine.tipologiaLinea == 'POTS')&#xD;
&amp;&amp; AssetConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA)&#xD;
{&#xD;
	Process.auditLog(&quot;CASO PARTICOLARE - Attivazione 274 Condivisa Dati su TI Fonia ULL LNA&quot;);&#xD;
	&#xD;
	var Foniaazione = &quot;&quot;;&#xD;
	Foniaazione = null;&#xD;
	var DestinazioneUsoConsistenza = &quot;&quot;;&#xD;
	DestinazioneUsoConsistenza = null;&#xD;
	&#xD;
	//Recupera ordine correlato&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			Foniaazione = String(comp.azione);&#xD;
			Process.auditLog(&quot;Fonia Azione:&quot;+Foniaazione);&#xD;
			&#xD;
			for(var j = 0; j &lt; comp.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
				{&#xD;
					DestinazioneUsoConsistenza = attr.valoreAttributo;&#xD;
					Process.auditLog(&quot;DestinazioneUsoConsistenza:&quot;+DestinazioneUsoConsistenza);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(DestinazioneUsoConsistenza.length > 2 &amp;&amp; Foniaazione == &quot;M&quot;)&#xD;
	{&#xD;
		CasoParticolare = true;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Modifica Dest Uso Skippata&quot;);&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
if(&#xD;
((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE) &#xD;
	&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA))&#xD;
|| &#xD;
((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB &amp;&amp; localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS)&#xD;
		||&#xD;
		(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB &amp;&amp; localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS)&#xD;
		||&#xD;
		((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT||localRequest.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL|| localRequest.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE) &amp;&amp; (localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS || localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN))&#xD;
		||&#xD;
		(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT &amp;&amp; (localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS || localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN))&#xD;
		||&#xD;
		((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT||localRequest.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE|| localRequest.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT || localRequest.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE) &amp;&amp; (localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS || localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN))&#xD;
	)&#xD;
|| CasoParticolare)&#xD;
{&#xD;
	&#xD;
	Process.auditLog(&quot;Inizio fiunzione Gestione Modifica Destinazione Uso&quot;);&#xD;
	&#xD;
	if(AssetConsistenzaFonia != null){&#xD;
		if(AssetConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA &#xD;
		|| AssetConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
		|| AssetConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
		|| AssetConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA){&#xD;
			Process.auditLog(&quot;AssetConsistenzaFonia&quot;);&#xD;
			var destinazioneTrovata= false;&#xD;
			var destinazione = &quot;&quot;;&#xD;
			var accessoTrovato = false;&#xD;
			var i=0;&#xD;
			while(!accessoTrovato &amp;&amp; i&lt;AssetConsistenzaFonia.dettaglioasset.size())&#xD;
			{&#xD;
				var comp = AssetConsistenzaFonia.dettaglioasset.get(i);&#xD;
				&#xD;
				if(String(comp.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					accessoTrovato=true;&#xD;
					var j=0;&#xD;
					&#xD;
					while(!destinazioneTrovata &amp;&amp; j&lt;comp.attributidettaglioasset.size())&#xD;
					{&#xD;
						var attr = comp.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
						{&#xD;
							Process.auditLog(&quot;DESTINAZIONEUSO: &quot;+attr.valoreAttributo);&#xD;
							destinazioneTrovata=true;&#xD;
							destinazione = attr.valoreAttributo;&#xD;
							if(destinazione.length>2){&#xD;
								&#xD;
								var primoCarattereDestinazione = destinazione.slice(0,1);&#xD;
								if(primoCarattereDestinazione == &quot;1&quot; || primoCarattereDestinazione==&quot;2&quot; || primoCarattereDestinazione==&quot;3&quot;)&#xD;
								{&#xD;
									attr.valoreAttributo = primoCarattereDestinazione;&#xD;
									Process.auditLog(&quot;DESTINAZIONEUSO Modificato: &quot;+attr.valoreAttributo);&#xD;
									ConsistenzaFoniaModificato = true;&#xD;
									&#xD;
									if(AssetConsistenzaFonia.statoAsset==it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE)&#xD;
									{&#xD;
										AssetConsistenzaFonia.statoAsset=it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
									}&#xD;
								}&#xD;
								&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						j++;&#xD;
					}	&#xD;
				}&#xD;
				i++;&#xD;
			}	&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(AssetConsistenzaDati != null){&#xD;
		if(AssetConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA &#xD;
		|| AssetConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
		|| AssetConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
		|| AssetConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA){&#xD;
			Process.auditLog(&quot;AssetConsistenzaDati&quot;);&#xD;
			var destinazioneTrovata= false;&#xD;
			var destinazione = &quot;&quot;;&#xD;
			var accessoTrovato = false;&#xD;
			var i=0;&#xD;
			while(!accessoTrovato &amp;&amp; i&lt;AssetConsistenzaDati.dettaglioasset.size()){&#xD;
				var comp = AssetConsistenzaDati.dettaglioasset.get(i);&#xD;
				if(String(comp.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
					accessoTrovato=true;&#xD;
					var j=0;&#xD;
					while(!destinazioneTrovata &amp;&amp; j&lt;comp.attributidettaglioasset.size()){&#xD;
						var attr = comp.attributidettaglioasset.get(j);&#xD;
						if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO){&#xD;
							Process.auditLog(&quot;DESTINAZIONEUSO: &quot;+attr.valoreAttributo);&#xD;
							destinazioneTrovata=true;&#xD;
							destinazione = attr.valoreAttributo;&#xD;
							if(destinazione.length>2){&#xD;
								&#xD;
								var primoCarattereDestinazione = destinazione.slice(0,1);&#xD;
								if(primoCarattereDestinazione == &quot;1&quot; || primoCarattereDestinazione==&quot;2&quot; || primoCarattereDestinazione==&quot;3&quot;){&#xD;
									attr.valoreAttributo = primoCarattereDestinazione;&#xD;
									Process.auditLog(&quot;DESTINAZIONEUSO Modificato: &quot;+attr.valoreAttributo);&#xD;
									ConsistenzaDatiModificato = true;&#xD;
									if(AssetConsistenzaDati.statoAsset==it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE)&#xD;
									{&#xD;
										AssetConsistenzaDati.statoAsset=it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
									}&#xD;
								}&#xD;
								&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						j++;&#xD;
					}	&#xD;
				}&#xD;
				i++;&#xD;
			}	&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="118.0" LaneId="_Wx-hO4o4EeaXiuJl6VlD_w" Width="187.0">
