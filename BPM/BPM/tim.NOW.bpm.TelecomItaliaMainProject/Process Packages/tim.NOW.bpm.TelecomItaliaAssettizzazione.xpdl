                          <xpdExt:Expression ScriptGrammar="JavaScript">//Introdotto script con SM_9560&#xD;
&#xD;
var codificaOLOAGCOM = &quot;&quot;;&#xD;
codificaOLOAGCOM = null;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE        &#xD;
    &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS&#xD;
    &amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR)&#xD;
{&#xD;
	codificaOLOAGCOM = localRequest.codificaOLOAGCOMDonating;&#xD;
}&#xD;
else&#xD;
{&#xD;
	codificaOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
}&#xD;
&#xD;
return codificaOLOAGCOM;</xpdExt:Expression>
