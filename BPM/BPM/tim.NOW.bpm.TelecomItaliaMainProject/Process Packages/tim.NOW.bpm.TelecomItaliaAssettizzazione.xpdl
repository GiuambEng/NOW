        <xpdl2:Activity Id="_1GYoYJQvEeqt_eyBG7-otg" Name="CercaAssetCPSdacessare" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Cerca Asset CPS da cessare" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
var DNcessato = &quot;&quot;;&#xD;
DNcessato = null;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(DNcessato == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{	&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS&#xD;
					&amp;&amp; currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		{	&#xD;
			for(var k = 0; k&lt;currentDettOrdine.attributiDettaglioOrdine.size(); k++)&#xD;
			{&#xD;
				var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(k);&#xD;
				&#xD;
				if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					DNcessato = String(currentAttributo.valoreAttributo);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
		}&#xD;
		&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(DNcessato != null)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numTelPrincipale = :DNprincipale AND numeroTelefonico &lt;> :numeroTelefonico AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND offerta IN ('CPS')&quot;);&#xD;
	&#xD;
	c.setQueryParameter(&quot;DNprincipale&quot;,DNcessato);&#xD;
	c.setQueryParameter(&quot;numeroTelefonico&quot;,DNcessato);	&#xD;
	var assetReference = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
&#xD;
	Process.auditLog(&quot;Trovati &quot;+String(assetReference.size())+&quot; aggiuntivi legati alla CPS cessata &quot;+DNcessato);&#xD;
&#xD;
&#xD;
	if(assetReference.size()>0)&#xD;
	{&#xD;
		var IDAssetCPS = &quot;&quot;;&#xD;
		IDAssetCPS = null;&#xD;
		&#xD;
		for(var i = 0; i &lt; assetReference.size(); i++)&#xD;
		{&#xD;
			assetRef = assetReference.get(i);&#xD;
			var assetTemp = assetRef.readAsset();&#xD;
			&#xD;
			IDAssetCPS = ScriptUtil.createBigInteger(assetTemp.IDAsset);&#xD;
			Process.auditLog(&quot;ID Asset CPS: &quot;+String(IDAssetCPS));&#xD;
			&#xD;
			assetTemp.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
			assetTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			assetTemp.lastUpdate = date;&#xD;
			assetTemp.DES = localRequest.ordine.DES;&#xD;
			assetTemp.ORA_DES = localRequest.ordine.ORA_DES;&#xD;
			assetTemp.codiceOrdineOLO  =localRequest.ordine.codiceOrdineOLO;&#xD;
			assetTemp.codiceOrdineTI =localRequest.ordine.codiceOrdineTI;&#xD;
			&#xD;
			for(var j=0; j&lt;assetTemp.dettaglioasset.size(); j++)&#xD;
			{&#xD;
				assetTemp.dettaglioasset.get(j).statoDettaglioAsset = assetTemp.statoAsset;&#xD;
				assetTemp.dettaglioasset.get(j).lastUpdate = date;&#xD;
			}&#xD;
			&#xD;
			if(AssetRefDaCessare!=null &amp;&amp; AssetRefDaCessare.size()>0 &amp;&amp; AssetRefDaCessare.contains(assetRef))&#xD;
			{&#xD;
				Process.auditLog(&quot;Asset già presente nella lista dei cancellati&quot;);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				AssetCessati.add(ScriptUtil.copy(assetTemp));&#xD;
				AssetRefDaCessare.add(assetRef);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Nessun asset recuperato per offerta: &quot;+localRequest.offerta+&quot; numeroTelefonico: &quot;+DNcessato);&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Al numero: &quot;+DNcessato+&quot; non corrispondono asset aggiuntivi CPS da cessare&quot;);&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
