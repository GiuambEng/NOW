	OrdineComponente.add(&quot;ACCESSOCPS&quot;);&#xD;
	OrdineComponente.add(&quot;ACCESSOCPS&quot;);   //RU_975&#xD;
	OrdineComponente.add(&quot;ACCESSOCPS&quot;);   //RU_975&#xD;
	&#xD;
	OrdineComponente.add(&quot;ACCESSOCPS&quot;);&#xD;
	OrdineComponente.add(&quot;ACCESSOCPS&quot;);&#xD;
	OrdineComponente.add(&quot;ACCESSOCPS&quot;);&#xD;
	&#xD;
	OrdineComponente.add(&quot;DTUAGGIUNTIVO&quot;); // SM_9087&#xD;
	OrdineComponente.add(&quot;DTUAGGIUNTIVO&quot;);&#xD;
	OrdineComponente.add(&quot;DTUAGGIUNTIVO&quot;);&#xD;
	OrdineComponente.add(&quot;DTUAGGIUNTIVO&quot;);&#xD;
	OrdineComponente.add(&quot;DTUAGGIUNTIVO&quot;);&#xD;
	OrdineComponente.add(&quot;DTUAGGIUNTIVO&quot;);&#xD;
	OrdineComponente.add(&quot;DTUAGGIUNTIVO&quot;); // --&#xD;
	&#xD;
	// ---------------------------------------------------------------------------------------------------------&#xD;
&#xD;
	OrdineAttributo.add(&quot;TIPODNRICHIESTO&quot;);&#xD;
	OrdineAttributo.add(&quot;TIPODNREALE&quot;);&#xD;
