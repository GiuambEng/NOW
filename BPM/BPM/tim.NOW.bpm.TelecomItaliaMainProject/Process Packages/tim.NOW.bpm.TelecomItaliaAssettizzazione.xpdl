            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="68.0" LaneId="_TMyF3UE6EeekX-brtRDFQQ" Width="176.0">
              <xpdl2:Coordinates XCoordinate="2593.0" YCoordinate="845.0"/>
