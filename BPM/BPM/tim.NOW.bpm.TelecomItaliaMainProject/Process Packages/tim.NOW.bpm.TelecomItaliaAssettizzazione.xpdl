        <xpdl2:Activity Id="_lZSq8DQmEei2e9dyLHNFPw" Name="TipologiaRichiesta" xpdExt:DisplayName="TipologiaRichiesta">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_Y88CgDQnEei2e9dyLHNFPw"/>
                  <xpdl2:TransitionRef Id="_OLB0IDvzEei7IcgYfvd3tQ"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="61.0" LaneId="_2R_NkTP-Eei2e9dyLHNFPw" Width="151.0">
