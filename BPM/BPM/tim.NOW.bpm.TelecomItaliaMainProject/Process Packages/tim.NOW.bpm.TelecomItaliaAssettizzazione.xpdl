        <xpdl2:Activity Id="__1T4cM3cEeuytMhYxss0gQ" Name="CreaAssociazioneCanaleFeederOLT" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Crea Associazione Canale Feeder OLT">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">AssociazioneCanaleFeederOLT =  it_telecomitalia_it_NOW_casedata_Factory.createAssociazioneCanaleFeederOLT();&#xD;
var Data = DateTimeUtil.createDate();&#xD;
var Datatime = DateTimeUtil.createDatetime();&#xD;
&#xD;
var idAssetCANALE = 0;&#xD;
var idAssetFEEDER = 0;&#xD;
var idAssetSEDEOLT = 0;&#xD;
&#xD;
var i=0;&#xD;
while((idAssetCANALE == 0 || idAssetFEEDER == 0 || idAssetSEDEOLT == 0) &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACANALE)&#xD;
	{&#xD;
		var j=0;&#xD;
		while(idAssetCANALE == 0 &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
			var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
			if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				idAssetCANALE = parseInt(attr.valoreAttributo, 10);&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFEEDER)&#xD;
	{&#xD;
		var j=0;&#xD;
		while(idAssetFEEDER == 0 &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
			var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
			if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				idAssetFEEDER = parseInt(attr.valoreAttributo, 10);&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZASEDEOLT)&#xD;
	{&#xD;
		var j=0;&#xD;
		while(idAssetSEDEOLT == 0 &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
			var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
			if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				idAssetSEDEOLT = parseInt(attr.valoreAttributo, 10);&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CREAZIONECANALEFEEDER)&#xD;
{&#xD;
	AssociazioneCanaleFeederOLT.IDAssetCanale = Asset.IDAsset;&#xD;
}&#xD;
else&#xD;
{&#xD;
	AssociazioneCanaleFeederOLT.IDAssetCanale = idAssetCANALE;&#xD;
}&#xD;
&#xD;
if(idAssetFEEDER != null)&#xD;
{&#xD;
	AssociazioneCanaleFeederOLT.IDAssetFeeder = idAssetFEEDER;&#xD;
}&#xD;
&#xD;
if(idAssetSEDEOLT != null)&#xD;
{&#xD;
	AssociazioneCanaleFeederOLT.IDAssetOLT = idAssetSEDEOLT;&#xD;
}&#xD;
&#xD;
AssociazioneCanaleFeederOLT.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
AssociazioneCanaleFeederOLT.codificaOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
AssociazioneCanaleFeederOLT.dataFineValidita = DateTimeUtil.createDate(&quot;9999-12-31&quot;);&#xD;
AssociazioneCanaleFeederOLT.dataInizioValidita = Data;&#xD;
AssociazioneCanaleFeederOLT.timestampAggiornamento = Datatime;&#xD;
AssociazioneCanaleFeederOLT.timestampInserimento = Datatime;&#xD;
&#xD;
if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CANALEESISTENTEOLT)&#xD;
{&#xD;
	AssociazioneCanaleFeederOLT.tipologiaAssociazione = &quot;OLT&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	AssociazioneCanaleFeederOLT.tipologiaAssociazione = &quot;FEEDER&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
