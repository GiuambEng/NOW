            <xpdl2:Activity Id="_O9VVHtmVEeaB-6lC68ZgcA" Name="CacolamappingAsset" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Cacola mapping Asset">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_Wx-hLoo4EeaXiuJl6VlD_w" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="true">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="AssetAttributo">
                      <xpdl2:Actual ScriptGrammar="JavaScript">AssetAttributo</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="AssetComponente">
                      <xpdl2:Actual ScriptGrammar="JavaScript">AssetComponente</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="OrdineAttributo">
