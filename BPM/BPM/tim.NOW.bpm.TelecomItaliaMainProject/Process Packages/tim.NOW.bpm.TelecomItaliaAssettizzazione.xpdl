        <xpdl2:Activity Id="_kKS9kN1wEeaTc6m_q9HwoA" Name="TraslocoWLRconcambionumero" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Trasloco WLR con cambio numero" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//recupera asset&#xD;
&#xD;
var AssetID = 0;&#xD;
	AssetID =null;&#xD;
	var i=0;&#xD;
	while(AssetID== null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			var j=0;&#xD;
			while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					AssetID = parseInt(attr.valoreAttributo, 10);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
	i++;&#xD;
	}&#xD;
	&#xD;
	if (AssetID != null &amp;&amp; AssetID != &quot;&quot;)&#xD;
	{&#xD;
		var c=cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset =:IDA&quot;);&#xD;
		c.setQueryParameter(&quot;IDA&quot;,AssetID);&#xD;
		&#xD;
		var assetRecuperati = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		if(assetRecuperati.size()>0)&#xD;
			&#xD;
		{&#xD;
			AssetCorrelatoRef = assetRecuperati.get(0);&#xD;
			AssetCorrelato = AssetCorrelatoRef.readAsset();&#xD;
			&#xD;
			if(AssetCorrelato != null)&#xD;
			{&#xD;
				AssetCorrelato.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
				AssetCorrelato.lastUpdate = DateTimeUtil.createDatetime();&#xD;
