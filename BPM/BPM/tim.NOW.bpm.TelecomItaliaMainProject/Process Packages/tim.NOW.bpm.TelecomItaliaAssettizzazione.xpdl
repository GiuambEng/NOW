                <xpdl2:Script ScriptGrammar="JavaScript">/*RU_683 gestione attributo CCLIONU*/&#xD;
var existCLLIONU=false;&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB){&#xD;
	&#xD;
	var i=0;&#xD;
&#xD;
	while(!existCLLIONU &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente) == &quot;DTUINDIRIZZOCERT&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CCLIONU)&#xD;
				{&#xD;
					existCLLIONU=true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
&#xD;
