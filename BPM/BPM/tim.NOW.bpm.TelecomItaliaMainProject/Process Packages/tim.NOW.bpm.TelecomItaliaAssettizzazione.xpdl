            <xpdl2:Activity Id="_vxpJsC_6EeehzMIy_SdzNg" Name="CessazioniULLNPSLUNPNPoMIG" xpdExt:DisplayName="Cessazioni ULL+NP/SLU+NP/NP o MIG">
              <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
              <xpdl2:TransitionRestrictions>
                <xpdl2:TransitionRestriction>
                  <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                    <xpdl2:TransitionRefs>
                      <xpdl2:TransitionRef Id="_nXWp8SWyEeeqDbUNSxywMQ"/>
                      <xpdl2:TransitionRef Id="_0ZT4Yy_6EeehzMIy_SdzNg"/>
                    </xpdl2:TransitionRefs>
                  </xpdl2:Split>
                </xpdl2:TransitionRestriction>
              </xpdl2:TransitionRestrictions>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="86.0" Width="102.0">
