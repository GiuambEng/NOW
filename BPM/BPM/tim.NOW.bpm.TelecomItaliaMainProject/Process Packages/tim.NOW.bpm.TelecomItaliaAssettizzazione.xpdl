        <xpdl2:Activity Id="_sn7NYF0OEeieHfW0dqk-_A" Name="UnlockAssetCorrelato" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Unlock Asset Correlato">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">UpdateAssetCorrelato=false;&#xD;
&#xD;
if(localRequest.lavorazione==it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
&amp;&amp; String(localRequest.offerta).slice(0,3)==&quot;WLR&quot;&#xD;
&amp;&amp; Asset.IDRisorsaCorrelato!=null &amp;&amp; Asset.IDRisorsaCorrelato!=&quot;&quot;)&#xD;
{&#xD;
	//Cerco asset correlato&#xD;
	Process.auditLog(&quot;Cerco ASSET correlato per IDRisorsa = &quot; + Asset.IDRisorsaCorrelato);&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa=:SearchIDRisorsa&quot;);&#xD;
&#xD;
	criteria.setQueryParameter(&quot;SearchIDRisorsa&quot;,Asset.IDRisorsaCorrelato);&#xD;
&#xD;
	var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
	assetCorrelato = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
	assetCorrelato=null;&#xD;
	&#xD;
	if (list.size()>0)&#xD;
	{&#xD;
		for(var i = 0; i &lt; list.size(); i++)&#xD;
		{&#xD;
			var currAsset=list.get(i).readAsset();&#xD;
			Process.auditLog(&quot;Trovato asset correlato avente id &quot;+currAsset.IDAsset);&#xD;
			//Controllo asset BTS IN LAVORAZIONE&#xD;
			if(currAsset.statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE&#xD;
				&amp;&amp; (String(currAsset.offerta).slice(0,6)==&quot;EASYIP&quot; || String(currAsset.offerta).slice(0,9)==&quot;BITSTREAM&quot; || String(currAsset.offerta).slice(0,4)==&quot;VULA&quot;))&#xD;
				{&#xD;
					//Cerco richieste su IdRisorsaCorrelato&#xD;
					var criteriaReq = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;IDRisorsa=:SearchIDRisorsa ORDER BY created DESC&quot;);&#xD;
					criteriaReq.setQueryParameter(&quot;SearchIDRisorsa&quot;,Asset.IDRisorsaCorrelato);&#xD;
					var listReq = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteriaReq);&#xD;
					var foundBTS=false;&#xD;
					if (listReq.size()>0)&#xD;
					{&#xD;
						for(var j = 0; j &lt; listReq.size(); j++)&#xD;
						{&#xD;
							var currentRic = listReq.get(j).readRichiesta();&#xD;
							Process.auditLog(&quot;Trovata richiesta di cessazione con &quot;+ currentRic.IDRichiestaOLO);&#xD;
							if (currentRic.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp;&#xD;
							currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO &amp;&amp;&#xD;
							currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATO &amp;&amp;&#xD;
							currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CHIUSO &amp;&amp;&#xD;
							currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOAFATTURAZIONE &amp;&amp;&#xD;
							currentRic.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO &amp;&amp;&#xD;
							(String(currentRic.offerta).slice(0,6)==&quot;EASYIP&quot; || String(currentRic.offerta).slice(0,9)==&quot;BITSTREAM&quot; || String(currentRic.offerta).slice(0,4)==&quot;VULA&quot;))&#xD;
							{	&#xD;
								foundBTS=true;&#xD;
								Process.auditLog(&quot;Trovata richiesta di cessazione con &quot;+ currentRic.IDRichiestaOLO);&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
					if(!foundBTS)&#xD;
					{&#xD;
						assetCorrelato=currAsset;&#xD;
						assetCorrelatoRef=list.get(i);&#xD;
						assetCorrelato.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
						Process.auditLog(&quot;Unlock asset correlato avente id &quot; + currAsset.IDAsset);&#xD;
						UpdateAssetCorrelato=true;&#xD;
					}&#xD;
					&#xD;
					&#xD;
				}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
