        <xpdl2:Activity Id="_UN94MLGIEea_vM0KqnQW4w" Name="MappingAssetComponentiMultiple" xpdExt:Visibility="Private" xpdExt:DisplayName="Mapping Asset Componenti Multiple">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;Inizio gestione assettizzazione, azione A - L2&quot;);&#xD;
var ora = DateTimeUtil.createDatetime();&#xD;
var ordine = localRequest.ordine;&#xD;
var foundAtLeastOneAtt = false;&#xD;
var listaDettaglioAssetCreati = DataUtil.createList();&#xD;
var nuovoDettaglioAsset=true;&#xD;
var indiceDettaglioAsset =0;&#xD;
var indexComponente = 0;&#xD;
&#xD;
var STRUTTURALINEA = &quot;&quot;;&#xD;
STRUTTURALINEA = null;&#xD;
&#xD;
//PEZZA PER CPS - RU_975 - RECUPERO STRUTTURA LINEA PER LOGICA SUCCESSIVA&#xD;
// Serve perché solo per GNR i DTU AGGIUNTIVO vanno messi come dettaglio dell'ordine, per PBX devono essere asset singoli&#xD;
for(var i2 = 0; i2 &lt; localRequest.ordine.dettaglioordine.size(); i2++)&#xD;
{	&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i2);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
	{&#xD;
		var k = 0;&#xD;
		&#xD;
		while(STRUTTURALINEA == null &amp;&amp; k &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(k);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
			{&#xD;
				STRUTTURALINEA = currentAttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;Recuperata struttura linea: &quot;+STRUTTURALINEA);&#xD;
			}&#xD;
			&#xD;
			k++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//ciclo sulla lista dettaglio ordine&#xD;
for(var i = 0; i &lt; ordine.dettaglioordine.size(); i++)&#xD;
{					&#xD;
	var currentDettOrdine = ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	// Verifico se il componente del dettaglio dell'ordine è candidato all'assettizzazione&#xD;
	// SM_9300: aggiunto caso STRUTTURALINEA = BRA MULTI e BMU, anche per BRA MULTI e BMU vanno aggiunte le componenti DTU AGGIUNTIVO&#xD;
	if(OrdineComponente.contains(String(currentDettOrdine.nomeComponente)) &amp;&amp; (currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A || currentDettOrdine.azione ==null)&#xD;
	&amp;&amp; !((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE) &amp;&amp; currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY &amp;&amp; localRequest.codificaOLOAGCOMDonating!=&quot;TLC&quot;)&#xD;
	&amp;&amp; (String(currentDettOrdine.nomeComponente) != &quot;DTUAGGIUNTIVO&quot; || STRUTTURALINEA == null || STRUTTURALINEA == 'GNR' || STRUTTURALINEA == 'BRA MULTI' || STRUTTURALINEA == 'BMU')) //RU_975 - se STRUTTURALINEA valorizzato allora è un ATTIVAZIONE CPS, e SOLO per GNR vanno aggiunte le componenti DTU AGGIUNTIVO)&#xD;
	{&#xD;
		&#xD;
		&#xD;
		//cerco indice della configurazione&#xD;
		indexComponente = 0;&#xD;
		var trovato = false;&#xD;
		var k=0;&#xD;
		while(!trovato &amp;&amp; k&lt;OrdineAttributo.size()){&#xD;
				&#xD;
			if(currentDettOrdine.nomeComponente == OrdineComponente.get(k)){&#xD;
				trovato=true;&#xD;
				indexComponente = k;&#xD;
			}&#xD;
			k++;	&#xD;
		}&#xD;
		if(OrdineToAsset_TipoMapping.get(indexComponente)==&quot;L12&quot;){&#xD;
			Process.auditLog(&quot;DettOrdine da assettizzare: &quot;+currentDettOrdine.IDDettaglioOrdine);&#xD;
			&#xD;
			var dettaglio_asset = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioAsset();&#xD;
			//dettaglio_asset.IDAsset = Asset.IDAsset; //Asset non ha un ID valorizzato non essendo stato ancora creato&#xD;
			dettaglio_asset.IDAsset = Asset.IDAsset;&#xD;
			dettaglio_asset.IDDettaglioAsset = Asset.dettaglioasset.size()+1;&#xD;
			&#xD;
			//RU_1564 - Assettizzazione componente APPARATO - di livello L3, quindi legata alla componente SERVIZIOAGGIUNTIVO&#xD;
			if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FIBERSTREAM&#xD;
			   &amp;&amp; currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPARATO)&#xD;
			{&#xD;
				dettaglio_asset.IDDettaglioAssetParent = currentDettOrdine.IDDettaglioOrdineParent;&#xD;
				dettaglio_asset.IDDettaglioAssetRoot = currentDettOrdine.IDDettaglioOrdineRoot;&#xD;
			}&#xD;
			else //Caso generico&#xD;
			{&#xD;
				dettaglio_asset.IDDettaglioAssetParent = 1;&#xD;
				dettaglio_asset.IDDettaglioAssetRoot = 1;&#xD;
			}&#xD;
			&#xD;
			dettaglio_asset.created = ora;&#xD;
			dettaglio_asset.lastUpdate = ora;&#xD;
			dettaglio_asset.statoDettaglioAsset = Asset.statoAsset;&#xD;
			dettaglio_asset.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.get(AssetComponente.get(indexComponente));&#xD;
		&#xD;
			//========================================= Bug #33823: PROGRESSIVO =========================================&#xD;
			//Per ogni componente multipla, devo controllare se sono presenti già altre componenti con quel nome in asset&#xD;
			//o perchè le ho inserite con l'ultima riga di questo script o perchè erano già presenti (come nel caso delle Variazioni)&#xD;
			&#xD;
			var indicePROGRESSIVO = 0;&#xD;
			&#xD;
			if(Asset != null &amp;&amp; Asset.dettaglioasset != null &amp;&amp; Asset.dettaglioasset.size()>0)&#xD;
			{	&#xD;
				for(var z=0; z&lt;Asset.dettaglioasset.size(); z++)&#xD;
				{&#xD;
					var componenteAsset = Asset.dettaglioasset.get(z);				&#xD;
					&#xD;
					if(componenteAsset.nomeComponente == currentDettOrdine.nomeComponente)&#xD;
					{&#xD;
						indicePROGRESSIVO = currentDettOrdine.progressivo;  &#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			dettaglio_asset.progressivo = indicePROGRESSIVO++;&#xD;
			//============================================================================================================&#xD;
			&#xD;
			&#xD;
			if (ordine.IDRisorsa != null &amp;&amp; ordine.IDRisorsa != &quot;&quot;)&#xD;
			{	&#xD;
				dettaglio_asset.IDRisorsa = ordine.IDRisorsa;&#xD;
				dettaglio_asset.IDRisorsaNOW = ordine.IDRisorsa;&#xD;
			}&#xD;
			else&#xD;
			{	&#xD;
				dettaglio_asset.IDRisorsa = 0;	&#xD;
				dettaglio_asset.IDRisorsaNOW = 0;&#xD;
			}&#xD;
			dettaglio_asset.integrationID = currentDettOrdine.integrationID;&#xD;
			dettaglio_asset.operatore = currentDettOrdine.operatore;&#xD;
		&#xD;
		&#xD;
		&#xD;
		&#xD;
		&#xD;
		&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++){&#xD;
				var currentAttributoDettaglioOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				var trovato = false;	&#xD;
				var k=0;&#xD;
			&#xD;
				//verifico se la coppia componente-attributo sono candidati per l'assettizzazione&#xD;
				while(!trovato &amp;&amp; k&lt;OrdineAttributo.size()){&#xD;
				&#xD;
					if(currentAttributoDettaglioOrdine.nomeAttributo == OrdineAttributo.get(k) &amp;&amp; currentDettOrdine.nomeComponente== OrdineComponente.get(k)){&#xD;
						trovato=true;&#xD;
						indexComponente = k;&#xD;
						Process.auditLog(&quot;currentAttributoDettaglioOrdine da assettizzare: &quot;+currentAttributoDettaglioOrdine.nomeAttributo);&#xD;
					}&#xD;
					k++;	&#xD;
				}&#xD;
			&#xD;
				if(trovato){&#xD;
				&#xD;
				&#xD;
					var attributoDettaglioAsset = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioAsset();&#xD;
				&#xD;
					attributoDettaglioAsset.IDAsset = Asset.IDAsset;&#xD;
					&#xD;
					attributoDettaglioAsset.IDDettaglioAsset = dettaglio_asset.IDDettaglioAsset;&#xD;
					attributoDettaglioAsset.tipologiaDato = currentAttributoDettaglioOrdine.tipologiaDato;&#xD;
					attributoDettaglioAsset.created = ora;&#xD;
					attributoDettaglioAsset.lastUpdate = ora;&#xD;
					attributoDettaglioAsset.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(AssetAttributo.get(indexComponente));&#xD;
					attributoDettaglioAsset.operatore = currentAttributoDettaglioOrdine.operatore;&#xD;
					attributoDettaglioAsset.valoreAttributo = currentAttributoDettaglioOrdine.valoreAttributo;&#xD;
				&#xD;
					dettaglio_asset.attributidettaglioasset.add(ScriptUtil.copy(attributoDettaglioAsset));&#xD;
			&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			&#xD;
			&#xD;
			//Per le componenti VC/USERVLAN dei servizi dati inserire l’attributo DATAESPLETAMENTOVC/DATAESPLETAMENTOUSRVLAN valorizzandolo ocn la DES dell’ordine&#xD;
			if(dettaglio_asset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN ||dettaglio_asset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || dettaglio_asset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC){&#xD;
				var attributoDettaglioAsset = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioAsset();&#xD;
				&#xD;
				attributoDettaglioAsset.IDAsset = Asset.IDAsset;	&#xD;
				attributoDettaglioAsset.IDDettaglioAsset = dettaglio_asset.IDDettaglioAsset;&#xD;
				attributoDettaglioAsset.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.DATE;&#xD;
				attributoDettaglioAsset.created = ora;&#xD;
				attributoDettaglioAsset.lastUpdate = ora;&#xD;
				if(dettaglio_asset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
					attributoDettaglioAsset.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAESPLETAMENTOUSERVLAN;&#xD;
				}&#xD;
				else{&#xD;
					attributoDettaglioAsset.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAESPLETAMENTOVC;&#xD;
				}&#xD;
	&#xD;
				attributoDettaglioAsset.operatore = dettaglio_asset.operatore;&#xD;
				attributoDettaglioAsset.valoreAttributo = ordine.DES;&#xD;
				&#xD;
				dettaglio_asset.attributidettaglioasset.add(ScriptUtil.copy(attributoDettaglioAsset));&#xD;
			}&#xD;
			&#xD;
			&#xD;
			Asset.dettaglioasset.add(ScriptUtil.copy(dettaglio_asset));&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="98.0" LaneId="_Wx-hO4o4EeaXiuJl6VlD_w" Width="142.0">
              <xpdl2:Coordinates XCoordinate="1557.0" YCoordinate="461.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_YoWY0LGIEea_vM0KqnQW4w" Name="MappingAssetComponentiSpeciali" xpdExt:Visibility="Private" xpdExt:DisplayName="Mapping Asset Componenti Speciali">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;Correlazione componenti aggiuntive&quot;);&#xD;
if(localRequest.ordine !=null){&#xD;
	&#xD;
	var countUSERVLAN =0;&#xD;
	for(var k=0; k&lt;localRequest.ordine.dettaglioordine.size(); k++){&#xD;
		var ctemp = localRequest.ordine.dettaglioordine.get(k);&#xD;
		//cerco DTUDATIVC VC&#xD;
		if(ctemp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUDATIVC &amp;&amp; (ctemp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A || ctemp.azione ==null)){&#xD;
			dettaglioOrdineTemp.add(ScriptUtil.copy(ctemp));&#xD;
		}&#xD;
		//Conto le uservlan in quanto se uservlan=1 --> DTUDATIVC non ha i datoi di correlazione.&#xD;
		if(ctemp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
			countUSERVLAN++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(dettaglioOrdineTemp!= null){&#xD;
		Process.auditLog(&quot;Trovate: &quot;+dettaglioOrdineTemp.size()+&quot; DTUDATIVC&quot;);&#xD;
	}&#xD;
	&#xD;
	for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var dettaglioAsset = Asset.dettaglioasset.get(i);&#xD;
		if(dettaglioOrdineTemp != null &amp;&amp; dettaglioOrdineTemp.size()>0 &amp;&amp; (dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN || dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC))&#xD;
		{&#xD;
			var VPI = &quot;&quot;;&#xD;
			var VCI = &quot;&quot;;&#xD;
			var DLCI = &quot;&quot;;&#xD;
			var USERVLANID = &quot;&quot;;&#xD;
			var VPITrovato = false;&#xD;
			var VCITrovato = false;&#xD;
			var DLCITrovato = false;&#xD;
			var USERVLANIDTrovato = false;&#xD;
			&#xD;
			var c =0;&#xD;
			while(c&lt;dettaglioAsset.attributidettaglioasset.size()){&#xD;
				var temp = dettaglioAsset.attributidettaglioasset.get(c);&#xD;
				if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI){&#xD;
					VPI = temp.valoreAttributo;&#xD;
					VPITrovato = true;&#xD;
				} else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI){&#xD;
					VCI = temp.valoreAttributo;&#xD;
					VCITrovato = true;&#xD;
				} else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID){&#xD;
					USERVLANID = temp.valoreAttributo;&#xD;
					USERVLANIDTrovato = true;&#xD;
				} else if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI){&#xD;
					DLCI = temp.valoreAttributo;&#xD;
					DLCITrovato = true;&#xD;
				}&#xD;
				c++;&#xD;
			}&#xD;
		&#xD;
			Process.auditLog(&quot;VPI: &quot;+VPI+ &quot; VCI: &quot;+VCI+ &quot; USERVLANID: &quot;+USERVLANID  +&quot; DLCI:&quot;+DLCI);&#xD;
		&#xD;
			var attributoDettaglioAsset = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioAsset();&#xD;
			&#xD;
			attributoDettaglioAsset.IDAsset= Asset.IDAsset;&#xD;
			&#xD;
			attributoDettaglioAsset.IDDettaglioAsset = dettaglioAsset.IDDettaglioAsset;&#xD;
			//attributoDettaglioAsset.tipologiaDato;&#xD;
			attributoDettaglioAsset.created = dettaglioAsset.created;&#xD;
			attributoDettaglioAsset.lastUpdate = dettaglioAsset.created;&#xD;
			//attributoDettaglioAsset.nomeAttributo;&#xD;
			attributoDettaglioAsset.operatore = dettaglioAsset.operatore;&#xD;
			//attributoDettaglioAsset.valoreAttributo;&#xD;
			&#xD;
			var DTUDATIVCTrovata = false;&#xD;
			var j=0;&#xD;
			while(!DTUDATIVCTrovata &amp;&amp; j&lt;dettaglioOrdineTemp.size())&#xD;
			{&#xD;
				var dettaglioOrdine = dettaglioOrdineTemp.get(j);&#xD;
				if(dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
					Process.auditLog(&quot;COMPONENTE: &quot;+dettaglioAsset.nomeComponente+ &quot; &quot; + dettaglioAsset.IDDettaglioAsset);&#xD;
					if(countUSERVLAN==1){&#xD;
						/*attributoDettaglioAsset.tipologiaDato&#xD;
						attributoDettaglioAsset.nomeAttributo&#xD;
						attributoDettaglioAsset.valoreAttributo*/&#xD;
						&#xD;
						//INIZIO PARTE COMUNE--------------------------------------------------------------------&#xD;
						var l = 0;&#xD;
						while(l &lt; dettaglioOrdine.attributiDettaglioOrdine.size()){&#xD;
							var attributoTemp = dettaglioOrdine.attributiDettaglioOrdine.get(l);&#xD;
							var configurazioneTrovata = false;&#xD;
							var m = 0;&#xD;
							var indiceConfigurazione = 0;&#xD;
							while(!configurazioneTrovata &amp;&amp; m &lt; OrdineAttributo.size()){&#xD;
								if(String(attributoTemp.nomeAttributo) == OrdineAttributo.get(m) &amp;&amp; String(dettaglioOrdine.nomeComponente) == OrdineComponente.get(m)){&#xD;
									indiceConfigurazione = m;&#xD;
									configurazioneTrovata=true;&#xD;
								}&#xD;
								m++;&#xD;
							}&#xD;
							if(configurazioneTrovata){&#xD;
								&#xD;
								//Bug #34086: Aggiunta sostituzione&#xD;
								var c =0;&#xD;
								var attributoSostituito = false;&#xD;
								&#xD;
								while(c&lt;dettaglioAsset.attributidettaglioasset.size()){&#xD;
									var temp = dettaglioAsset.attributidettaglioasset.get(c);&#xD;
									if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(OrdineAttributo.get(indiceConfigurazione))){&#xD;
										temp.valoreAttributo = attributoTemp.valoreAttributo;&#xD;
										attributoSostituito = true;&#xD;
										Process.auditLog(&quot;Sostituito attributo: &quot;+temp.nomeAttributo+&quot; nell'asset, sotto &quot;+dettaglioAsset.nomeComponente+&quot;, nuovo valore: &quot;+temp.valoreAttributo);&#xD;
									}&#xD;
									c++;&#xD;
								}&#xD;
								&#xD;
								//Se non ha sostituito (non l'ha trovato già nell'asset), allora lo aggiunge&#xD;
								if(!attributoSostituito){&#xD;
									attributoDettaglioAsset.tipologiaDato=attributoTemp.tipologiaDato;&#xD;
									attributoDettaglioAsset.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(OrdineAttributo.get(indiceConfigurazione));&#xD;
									attributoDettaglioAsset.valoreAttributo = attributoTemp.valoreAttributo;&#xD;
								&#xD;
									dettaglioAsset.attributidettaglioasset.add(ScriptUtil.copy(attributoDettaglioAsset));&#xD;
									Process.auditLog(&quot;Aggiunto attributo: &quot;+attributoDettaglioAsset.nomeAttributo+&quot; nell'asset, sotto &quot;+dettaglioAsset.nomeComponente+&quot;, nuovo valore: &quot;+attributoTemp.valoreAttributo);&#xD;
								}&#xD;
							}&#xD;
							l++;&#xD;
						}&#xD;
						//FINE PARTE COMUNE----------------------------------------------------------------------&#xD;
					&#xD;
					}&#xD;
					else{&#xD;
						&#xD;
						var USERVLAN = &quot;&quot;;&#xD;
						var USERVLANTrovato = false;&#xD;
						var t=0;&#xD;
						while(!USERVLANTrovato &amp;&amp; t&lt;dettaglioOrdine.attributiDettaglioOrdine.size()){&#xD;
							var attributoTemp = dettaglioOrdine.attributiDettaglioOrdine.get(t);&#xD;
							if(attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN){&#xD;
								USERVLAN = attributoTemp.valoreAttributo;&#xD;
								USERVLANTrovato=true;&#xD;
							} &#xD;
							t++;&#xD;
						}&#xD;
						&#xD;
						Process.auditLog(&quot;USERVLAN: &quot;+USERVLAN);&#xD;
						if(USERVLANTrovato &amp;&amp; USERVLANIDTrovato &amp;&amp; USERVLAN == USERVLANID){&#xD;
							&#xD;
							//INIZIO PARTE COMUNE--------------------------------------------------------------------&#xD;
							var l = 0;&#xD;
							while(l &lt; dettaglioOrdine.attributiDettaglioOrdine.size()){&#xD;
								var attributoTemp = dettaglioOrdine.attributiDettaglioOrdine.get(l);&#xD;
								var configurazioneTrovata = false;&#xD;
								var m = 0;&#xD;
								var indiceConfigurazione = 0;&#xD;
								while(!configurazioneTrovata &amp;&amp; m &lt; OrdineAttributo.size()){&#xD;
									if(String(attributoTemp.nomeAttributo) == OrdineAttributo.get(m) &amp;&amp; String(dettaglioOrdine.nomeComponente) == OrdineComponente.get(m)){&#xD;
										indiceConfigurazione = m;&#xD;
										configurazioneTrovata=true;&#xD;
									}&#xD;
									m++;&#xD;
								}&#xD;
								if(configurazioneTrovata){&#xD;
									&#xD;
									//Bug #34086: Aggiunta sostituzione&#xD;
									var c =0;&#xD;
									var attributoSostituito = false;&#xD;
									&#xD;
									while(c&lt;dettaglioAsset.attributidettaglioasset.size()){&#xD;
										var temp = dettaglioAsset.attributidettaglioasset.get(c);&#xD;
										if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(OrdineAttributo.get(indiceConfigurazione))){&#xD;
											temp.valoreAttributo = attributoTemp.valoreAttributo;&#xD;
											attributoSostituito = true;&#xD;
											Process.auditLog(&quot;Sostituito attributo: &quot;+temp.nomeAttributo+&quot; nell'asset, sotto &quot;+dettaglioAsset.nomeComponente+&quot;, nuovo valore: &quot;+temp.valoreAttributo);&#xD;
										}&#xD;
										c++;&#xD;
									}&#xD;
									&#xD;
									//Se non ha sostituito (non l'ha trovato già nell'asset), allora lo aggiunge&#xD;
									if(!attributoSostituito){&#xD;
										attributoDettaglioAsset.tipologiaDato=attributoTemp.tipologiaDato;&#xD;
										attributoDettaglioAsset.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(OrdineAttributo.get(indiceConfigurazione));&#xD;
										attributoDettaglioAsset.valoreAttributo = attributoTemp.valoreAttributo;&#xD;
									&#xD;
										dettaglioAsset.attributidettaglioasset.add(ScriptUtil.copy(attributoDettaglioAsset));&#xD;
										Process.auditLog(&quot;Aggiunto attributo: &quot;+attributoDettaglioAsset.nomeAttributo+&quot; nell'asset, sotto &quot;+dettaglioAsset.nomeComponente+&quot;, nuovo valore: &quot;+attributoTemp.valoreAttributo);&#xD;
									}&#xD;
								}&#xD;
								l++;&#xD;
							}&#xD;
							//FINE PARTE COMUNE----------------------------------------------------------------------&#xD;
							DTUDATIVCTrovata = true;&#xD;
							&#xD;
						}&#xD;
					&#xD;
					}&#xD;
					&#xD;
					&#xD;
				}&#xD;
				&#xD;
				if(dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC){&#xD;
					Process.auditLog(&quot;COMPONENTE: &quot;+dettaglioAsset.nomeComponente+ &quot; &quot; + dettaglioAsset.IDDettaglioAsset);&#xD;
					&#xD;
					var DLCIUTENTE = &quot;&quot;;&#xD;
					var VPIUTENTE = &quot;&quot;;&#xD;
					var VCIUTENTE = &quot;&quot;;&#xD;
					var DLCIUTENTETrovato = false;&#xD;
					var VPIUTENTETrovato = false;&#xD;
					var VCIUTENTETrovato = false;&#xD;
					var t=0;&#xD;
					while((!VPIUTENTETrovato || !VCIUTENTETrovato || !DLCIUTENTETrovato) &amp;&amp; t&lt;dettaglioOrdine.attributiDettaglioOrdine.size()){&#xD;
						var attributoTemp = dettaglioOrdine.attributiDettaglioOrdine.get(t);&#xD;
						if(attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPIUTENTE){&#xD;
							VPIUTENTE = attributoTemp.valoreAttributo;&#xD;
							VPIUTENTETrovato=true;&#xD;
						} &#xD;
						else if (attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCIUTENTE){&#xD;
							VCIUTENTE = attributoTemp.valoreAttributo;&#xD;
							VCIUTENTETrovato = true;&#xD;
						}&#xD;
						else if (attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCIUTENTE){&#xD;
							DLCIUTENTE = attributoTemp.valoreAttributo;&#xD;
							DLCIUTENTETrovato = true;&#xD;
						}&#xD;
						t++;&#xD;
					}&#xD;
					Process.auditLog(&quot;VPIUTENTE: &quot;+VPIUTENTE+ &quot; VCIUTENTE: &quot; +VCIUTENTE+ &quot; DLCIUTENTE:&quot;+DLCIUTENTE );&#xD;
					&#xD;
					if((VPITrovato &amp;&amp; VCITrovato &amp;&amp; VPIUTENTETrovato &amp;&amp; VCIUTENTETrovato &amp;&amp; VPIUTENTE== VPI &amp;&amp; VCIUTENTE == VCI)&#xD;
						||&#xD;
						(DLCIUTENTETrovato &amp;&amp; DLCITrovato &amp;&amp; DLCIUTENTE == DLCI)){&#xD;
						&#xD;
						//INIZIO PARTE COMUNE--------------------------------------------------------------------&#xD;
						var l = 0;&#xD;
						while(l &lt; dettaglioOrdine.attributiDettaglioOrdine.size()){&#xD;
							var attributoTemp = dettaglioOrdine.attributiDettaglioOrdine.get(l);&#xD;
							var configurazioneTrovata = false;&#xD;
							var m = 0;&#xD;
							var indiceConfigurazione = 0;&#xD;
							while(!configurazioneTrovata &amp;&amp; m &lt; OrdineAttributo.size()){&#xD;
								if(String(attributoTemp.nomeAttributo) == OrdineAttributo.get(m) &amp;&amp; String(dettaglioOrdine.nomeComponente) == OrdineComponente.get(m)){&#xD;
									indiceConfigurazione = m;&#xD;
									configurazioneTrovata=true;&#xD;
								}&#xD;
								m++;&#xD;
							}&#xD;
							if(configurazioneTrovata){				&#xD;
								//Bug #34086: Aggiunta sostituzione&#xD;
								var c =0;&#xD;
								var attributoSostituito = false;&#xD;
								&#xD;
								while(c&lt;dettaglioAsset.attributidettaglioasset.size()){&#xD;
									var temp = dettaglioAsset.attributidettaglioasset.get(c);&#xD;
									if(temp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(OrdineAttributo.get(indiceConfigurazione))){&#xD;
										temp.valoreAttributo = attributoTemp.valoreAttributo;&#xD;
										attributoSostituito = true;&#xD;
										Process.auditLog(&quot;Sostituito attributo: &quot;+temp.nomeAttributo+&quot; nell'asset, sotto &quot;+dettaglioAsset.nomeComponente+&quot;, nuovo valore: &quot;+temp.valoreAttributo);&#xD;
									}&#xD;
									c++;&#xD;
								}&#xD;
								&#xD;
								//Se non ha sostituito (non l'ha trovato già nell'asset), allora lo aggiunge&#xD;
								if(!attributoSostituito){&#xD;
									attributoDettaglioAsset.tipologiaDato=attributoTemp.tipologiaDato;&#xD;
									attributoDettaglioAsset.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(OrdineAttributo.get(indiceConfigurazione));&#xD;
									attributoDettaglioAsset.valoreAttributo = attributoTemp.valoreAttributo;&#xD;
								&#xD;
									dettaglioAsset.attributidettaglioasset.add(ScriptUtil.copy(attributoDettaglioAsset));&#xD;
									Process.auditLog(&quot;Aggiunto attributo: &quot;+attributoDettaglioAsset.nomeAttributo+&quot; nell'asset, sotto &quot;+dettaglioAsset.nomeComponente+&quot;, nuovo valore: &quot;+attributoTemp.valoreAttributo);&#xD;
								}&#xD;
							}&#xD;
							l++;&#xD;
						}&#xD;
						//FINE PARTE COMUNE----------------------------------------------------------------------&#xD;
						DTUDATIVCTrovata = true;&#xD;
							&#xD;
					}&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
