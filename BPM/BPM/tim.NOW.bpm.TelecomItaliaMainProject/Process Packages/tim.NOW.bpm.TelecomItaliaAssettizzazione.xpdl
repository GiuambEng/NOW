              </xpdExt:ActivityResourcePatterns>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">currentAsset=AssetRefDel82.readAsset();

var id = currentAsset.IDAsset;

for(var i = 0; i &lt; currentAsset.dettaglioasset.size(); i++)
{
	currentAsset.dettaglioasset.get(i).IDAsset = id;
	
	for(var j = 0; j &lt; currentAsset.dettaglioasset.get(i).attributidettaglioasset.size(); j++)
	{
		currentAsset.dettaglioasset.get(i).attributidettaglioasset.get(j).IDAsset = id;
	}
}</xpdExt:Information>
