							}&#xD;
							&#xD;
							if((VPIAsset!= null &amp;&amp; VPIOrdine != null &amp;&amp; VPIAsset == VPIOrdine &amp;&amp; VCIAsset != null &amp;&amp; VCIOrdine!= null &amp;&amp; VCIAsset == VCIOrdine)&#xD;
								|| uservlanAsset!= null &amp;&amp; uservlanOrdine != null &amp;&amp; uservlanAsset == uservlanOrdine&#xD;
								|| DLCIAsset != null &amp;&amp; DLCIOrdine != null &amp;&amp; DLCIAsset == DLCIOrdine){&#xD;
								dettaglioAsset.statoDettaglioAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
								dettaglioAsset.lastUpdate = ora;&#xD;
								if(dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
								{&#xD;
									Process.auditLog(&quot;componente &quot;+String(dettaglioAsset.nomeComponente)+&quot; con = uservlan&quot;+uservlanAsset+ &quot; cessato&quot; );&#xD;
								}&#xD;
								else&#xD;
								{		&#xD;
									Process.auditLog(&quot;componente &quot;+String(dettaglioAsset.nomeComponente)+&quot; con = VPI=&quot;+VPIAsset +&quot;, VCI=&quot;+ VCIAsset+ &quot; cessato&quot; );&#xD;
								}&#xD;
								var trovato = false;&#xD;
								for(var k=0;!trovato &amp;&amp; k&lt;dettaglioAsset.attributidettaglioasset.size(); k++)&#xD;
								{&#xD;
									var attributo = dettaglioAsset.attributidettaglioasset.get(k);&#xD;
									if((dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC  || dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC) &amp;&amp; attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAESPLETAMENTOVC)&#xD;
									{&#xD;
										trovato = true;&#xD;
										attributo.lastUpdate = ora;&#xD;
										attributo.valoreAttributo = localRequest.ordine.DES;&#xD;
									}&#xD;
									if(dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp; attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAESPLETAMENTOUSERVLAN)&#xD;
									{&#xD;
										trovato = true;&#xD;
										attributo.lastUpdate = ora;&#xD;
										attributo.valoreAttributo = localRequest.ordine.DES;&#xD;
									}&#xD;
								}&#xD;
								if(!trovato &amp;&amp; (dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN || dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC  || dettaglioAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC))&#xD;
								{&#xD;
									var attributoDettaglioAsset = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioAsset();&#xD;
				&#xD;
