        <xpdl2:Activity Id="_v_amdYrnEeazB5r48IqaJg" Name="Recuperaregliassetedaggiornarliseesistono2" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Recuperare gli asset ed aggiornarli se esistono">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">// ******* Parte del SW pre-SM_8467, Sbianca NUMTELPRINCIPALE dell'asset NP appena cessato (probabilmente non serve a niente) *******&#xD;
&#xD;
var c1 = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico = :numeroTelefonico&quot;);&#xD;
c1.setQueryParameter(&quot;numeroTelefonico&quot;,localRequest.ordine.numeroTelefonico);	&#xD;
var assetReference = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c1);&#xD;
&#xD;
if(assetReference.size()>0)&#xD;
{&#xD;
	for(var i=0; i&lt;assetReference.size(); i++)&#xD;
	{&#xD;
		var assetR = assetReference.get(i);&#xD;
		var assetV = assetR.readAsset();&#xD;
		&#xD;
		assetV.numTelPrincipale=&quot;&quot;;&#xD;
		var PRINCIPALETrovato= false;&#xD;
		var j=0;&#xD;
		&#xD;
		while(!PRINCIPALETrovato &amp;&amp; j&lt;assetV.dettaglioasset.size())&#xD;
		{&#xD;
			var dettaglio = assetV.dettaglioasset.get(j);&#xD;
			&#xD;
			if(dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
				var k=0;&#xD;
				&#xD;
				while(!PRINCIPALETrovato &amp;&amp; k&lt;dettaglio.attributidettaglioasset.size())&#xD;
				{&#xD;
					if(dettaglio.attributidettaglioasset.get(k).nomeAttributo== it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE)&#xD;
					{&#xD;
						PRINCIPALETrovato = true;&#xD;
						dettaglio.attributidettaglioasset.get(k).valoreAttributo=&quot; &quot;;&#xD;
					}&#xD;
					k++;&#xD;
				}&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
		AssetRefList.add(assetR);&#xD;
		AssetList.add(ScriptUtil.copy(assetV));&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Nessun asset recuperato per offerta: &quot;+localRequest.offerta+&quot; numeroTelefonico: &quot;+localRequest.ordine.numeroTelefonico);&#xD;
}&#xD;
&#xD;
&#xD;
// ******* SM_8467 - recupero gli aggiuntivi legati alla NP cessata, modificato NUMTELPRINCIPALE con se stesso e elimino CAPOSERIE E RADICALE *******&#xD;
&#xD;
var c2 = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numTelPrincipale = :numeroTelefonicoP AND numeroTelefonico &lt;> :numeroTelefonico&quot;);&#xD;
c2.setQueryParameter(&quot;numeroTelefonicoP&quot;,localRequest.ordine.numeroTelefonico);&#xD;
c2.setQueryParameter(&quot;numeroTelefonico&quot;,localRequest.ordine.numeroTelefonico);	&#xD;
var assetReference2 = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c2);&#xD;
&#xD;
Process.auditLog(&quot;Trovati &quot;+String(assetReference2.size())+&quot; aggiuntivi legati alla NP cessata &quot;+localRequest.ordine.numeroTelefonico);&#xD;
&#xD;
&#xD;
if(assetReference2.size()>0)&#xD;
{&#xD;
	for(var i = 0; i &lt; assetReference2.size(); i++)&#xD;
	{&#xD;
		var assetR = assetReference2.get(i);&#xD;
		var assetV = assetR.readAsset();&#xD;
		&#xD;
		assetV.numTelPrincipale = assetV.numeroTelefonico;&#xD;
		&#xD;
		var NPtrovata = false;&#xD;
		&#xD;
		var j = 0;&#xD;
		&#xD;
		while(!NPtrovata &amp;&amp; j &lt; assetV.dettaglioasset.size())&#xD;
		{&#xD;
			var dettaglio = assetV.dettaglioasset.get(j);&#xD;
			&#xD;
			if(dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
				NPtrovata = true;&#xD;
				&#xD;
				for(var k = 0; k &lt; dettaglio.attributidettaglioasset.size(); k++)&#xD;
				{&#xD;
					if(dettaglio.attributidettaglioasset.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE)&#xD;
					{&#xD;
						Process.auditLog(&quot;Aggiuntivo NP &quot;+assetV.numeroTelefonico+&quot;, eliminato legame con &quot;+dettaglio.attributidettaglioasset.get(k).valoreAttributo);&#xD;
						&#xD;
						dettaglio.attributidettaglioasset.get(k).valoreAttributo = assetV.numeroTelefonico;&#xD;
					}&#xD;
					else if(dettaglio.attributidettaglioasset.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE)&#xD;
					{&#xD;
						Process.auditLog(&quot;Eliminato attributo &quot;+dettaglio.attributidettaglioasset.get(k).nomeAttributo+&quot; per asset &quot;+assetV.numeroTelefonico);&#xD;
						dettaglio.attributidettaglioasset.remove(k);&#xD;
					}&#xD;
					else if(dettaglio.attributidettaglioasset.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
					{&#xD;
						Process.auditLog(&quot;Eliminato attributo &quot;+dettaglio.attributidettaglioasset.get(k).nomeAttributo+&quot; per asset &quot;+assetV.numeroTelefonico);&#xD;
						dettaglio.attributidettaglioasset.remove(k);&#xD;
					}&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
		AssetRefList.add(assetR);&#xD;
		AssetList.add(ScriptUtil.copy(assetV));&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Nessun asset recuperato per offerta: &quot;+localRequest.offerta+&quot; numeroTelefonico: &quot;+localRequest.ordine.numeroTelefonico);&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="96.0" LaneId="_cme6lIfAEeaRRPusWE612A" Width="122.0">
              <xpdl2:Coordinates XCoordinate="709.0" YCoordinate="1149.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
