          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">var trovataComponenteACCESSO_A = false;&#xD;
var trovataComponenteRACCOLTA_A = false;&#xD;
var i=0;&#xD;
while((!trovataComponenteACCESSO_A || !trovataComponenteRACCOLTA_A) &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
	if(String(localRequest.ordine.dettaglioordine.get(i).nomeComponente).slice(0,7) == &quot;ACCESSO&quot; &amp;&amp; localRequest.ordine.dettaglioordine.get(i).azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A){&#xD;
		trovataComponenteACCESSO_A=true;&#xD;
	}&#xD;
	// RU_1058&#xD;
	else if(String(localRequest.ordine.dettaglioordine.get(i).nomeComponente).slice(0,8) == &quot;RACCOLTA&quot; &amp;&amp; localRequest.ordine.dettaglioordine.get(i).azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A){&#xD;
		trovataComponenteRACCOLTA_A=true;&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp; (trovataComponenteACCESSO_A || trovataComponenteRACCOLTA_A)) //RU_1180, aggiunti i due booleani su trovataComponenteACCESSO&#xD;
||&#xD;
(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG) //Task #35039: le NPG non hanno ACCESSO/RACCOLTA&#xD;
||&#xD;
(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIENTROCPS) //SM_9508: aggiunto != RIENTRO CPS&#xD;
||&#xD;
(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &amp;&amp; (trovataComponenteACCESSO_A || trovataComponenteRACCOLTA_A))&#xD;
||&#xD;
(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE        //SM_9560&#xD;
  &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS&#xD;
  &amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR&#xD;
  &amp;&amp; trovataComponenteACCESSO_A))&#xD;
&amp;&amp; &#xD;
!(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
	&amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
	&amp;&amp; localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PORTIN&#xD;
	&amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
	&amp;&amp; localRequest.codificaOLOAGCOMDonor == &quot;TLC&quot;&#xD;
	&amp;&amp; localRequest.codificaOLOAGCOMDonating != &quot;TLC&quot;);</xpdl2:Expression></xpdl2:Condition>
