            <xpdl2:Activity Id="_xahrp5N0Eeq0BLebgjpy0g" Name="SetNumeroaggiuntivo" xpdExt:Visibility="Private" xpdExt:DisplayName="Set Numero aggiuntivo">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">AssetAggiuntivo = ScriptUtil.copy(AssetTemp);&#xD;
&#xD;
AssetAggiuntivo.dettaglioasset.clear();&#xD;
AssetAggiuntivo.numeroFittizio = null;&#xD;
AssetAggiuntivo.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS;&#xD;
AssetAggiuntivo.tipologiaAccesso = it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA;&#xD;
&#xD;
//SM_10108&#xD;
if(AssetAggiuntivo.operatoreRete == &quot;FC&quot;)&#xD;
{&#xD;
	AssetAggiuntivo.operatoreRete = null;&#xD;
}&#xD;
&#xD;
var currentComponenteAggiuntivoCPS = ComponenteAggiuntivoCPS.get(Process.getActivityLoopIndex());&#xD;
&#xD;
if(AssetAggiuntivo.numeroTelefonico==NumeriTelefoniciAggiuntivi.get(Process.getActivityLoopIndex()))&#xD;
{&#xD;
	Process.auditLog(&quot;Warning: il numero telefonico aggiuntivo coincide con il numero telefonico principale&quot;);&#xD;
}&#xD;
&#xD;
AssetAggiuntivo.numeroTelefonico = NumeriTelefoniciAggiuntivi.get(Process.getActivityLoopIndex());&#xD;
&#xD;
AssetAggiuntivo.IDRisorsa = AssetAggiuntivo.numeroTelefonico;&#xD;
AssetAggiuntivo.IDRisorsaNOW = AssetAggiuntivo.numeroTelefonico;&#xD;
&#xD;
//SM_9579&#xD;
var data = DateTimeUtil.createDatetime();&#xD;
AssetAggiuntivo.created = data;&#xD;
AssetAggiuntivo.lastUpdate = data;&#xD;
//---------&#xD;
//SM_9587&#xD;
AssetAggiuntivo.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO;&#xD;
//---------&#xD;
&#xD;
currentLocalRequest = ScriptUtil.copy(localRequestTemp);&#xD;
currentLocalRequest.ordine.IDRisorsa=AssetAggiuntivo.numeroTelefonico;&#xD;
currentLocalRequest.ordine.IDRisorsaNOW=AssetAggiuntivo.numeroTelefonico;&#xD;
currentLocalRequest.IDRisorsa = AssetAggiuntivo.numeroTelefonico;&#xD;
&#xD;
// SET DN con l'AGGIUNTIVO IN ACCESSOCPS&#xD;
var i = 0;&#xD;
&#xD;
var DNTrovato = false;&#xD;
&#xD;
while (i&lt;currentLocalRequest.ordine.dettaglioordine.size()) &#xD;
{&#xD;
	var componente = currentLocalRequest.ordine.dettaglioordine.get(i);&#xD;
	var j = 0;&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
	{&#xD;
		while(!DNTrovato &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN)&#xD;
			{&#xD;
				attributo.valoreAttributo = String(AssetAggiuntivo.numeroTelefonico);&#xD;
				DNTrovato = true;&#xD;
				Process.auditLog(&quot;Sostituito DN di ACCESSOCPS con quello dell'aggiuntivo: &quot;+String(attributo.valoreAttributo));&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
		AccessoCPS = ScriptUtil.copy(componente);&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
currentLocalRequest.ordine.dettaglioordine.clear();&#xD;
currentLocalRequest.ordine.dettaglioordine.add(ScriptUtil.copy(AccessoCPS));</xpdl2:Script>
                  </xpdl2:TaskScript>
                </xpdl2:Task>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="68.0" Width="134.0">
                  <xpdl2:Coordinates XCoordinate="193.0" YCoordinate="91.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:ActivityResourcePatterns>
                <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
              </xpdExt:ActivityResourcePatterns>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_xahrqJN0Eeq0BLebgjpy0g" Name="Service" xpdExt:Visibility="Private" xpdExt:DisplayName="Create Asset Case Data">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskService xpdExt:ImplementationType="GlobalData" Implementation="Other">
                    <xpdl2:MessageIn Id="_xahrqZN0Eeq0BLebgjpy0g"/>
                    <xpdl2:MessageOut Id="_xahrqpN0Eeq0BLebgjpy0g"/>
                    <xpdExt:GlobalDataOperation>
                      <xpdExt:CaseAccessOperations>
                        <xpdExt:CaseClassExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
                        <xpdExt:Create FromFieldPath="AssetAggiuntivo" ToCaseRefField="AssetRef"/>
                      </xpdExt:CaseAccessOperations>
                    </xpdExt:GlobalDataOperation>
                  </xpdl2:TaskService>
                </xpdl2:Task>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="72.0" Width="106.0">
                  <xpdl2:Coordinates XCoordinate="390.0" YCoordinate="91.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:ActivityResourcePatterns>
                <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
              </xpdExt:ActivityResourcePatterns>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">AssetAggiuntivo=AssetRef.readAsset();

var id = AssetAggiuntivo.IDAsset;

for(var i = 0; i &lt; AssetAggiuntivo.dettaglioasset.size(); i++)
{
	AssetAggiuntivo.dettaglioasset.get(i).IDAsset = id;
	
	for(var j = 0; j &lt; AssetAggiuntivo.dettaglioasset.get(i).attributidettaglioasset.size(); j++)
	{
		AssetAggiuntivo.dettaglioasset.get(i).attributidettaglioasset.get(j).IDAsset = id;
	}
}</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_xahrq5N0Eeq0BLebgjpy0g" Name="StoricizzaAsset1" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Storicizza Asset 1">
