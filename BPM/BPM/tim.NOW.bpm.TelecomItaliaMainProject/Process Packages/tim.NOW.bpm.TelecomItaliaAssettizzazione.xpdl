            </xpdl2:Activity>
            <xpdl2:Activity Id="_sNm6kptmEeqKY6L7g4699A" Name="SetNPecurrentLocalRequest" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Set NP e currentLocalRequest" xpdExt:RequireNewTransaction="false">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">//currentAsset relativo alla NP su cui si sta ciclando&#xD;
currentAsset = ScriptUtil.copy(Asset);&#xD;
currentAsset.dettaglioasset.clear();&#xD;
&#xD;
currentAsset.numeroTelefonico = NPDaAggiungere.get(Process.getActivityLoopIndex());&#xD;
currentAsset.numTelPrincipale = NPDaAggiungere.get(Process.getActivityLoopIndex());&#xD;
currentAsset.IDRisorsa = NPDaAggiungere.get(Process.getActivityLoopIndex());&#xD;
currentAsset.IDRisorsaNOW = NPDaAggiungere.get(Process.getActivityLoopIndex());&#xD;
&#xD;
&#xD;
//currentlocalRequest relativa alla NP su cui si sta ciclando&#xD;
currentLocalRequest = ScriptUtil.copy(localRequest);&#xD;
&#xD;
currentLocalRequest.IDRisorsa = currentAsset.numeroTelefonico;&#xD;
currentLocalRequest.ordine.IDRisorsa = currentAsset.numeroTelefonico;&#xD;
currentLocalRequest.ordine.IDRisorsaNOW = currentAsset.numeroTelefonico;&#xD;
&#xD;
&#xD;
var i= 0;&#xD;
var foundNP = false;&#xD;
&#xD;
while(!foundNP &amp;&amp; i&lt;currentLocalRequest.ordine.dettaglioordine.size()) &#xD;
{&#xD;
	var componente = currentLocalRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
	{&#xD;
		var j=0;&#xD;
		var numero = &quot;&quot;;&#xD;
		numero = null;&#xD;
		var numeroTrovato = false;&#xD;
		&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
			{&#xD;
				numero = attributo.valoreAttributo;&#xD;
				numeroTrovato = true;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE)&#xD;
			{&#xD;
				currentLocalRequest.ordine.numTelPrincipale = attributo.valoreAttributo;&#xD;
				currentAsset.numTelPrincipale = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO)&#xD;
			{&#xD;
				currentLocalRequest.ordine.distretto = attributo.valoreAttributo;&#xD;
				currentAsset.distretto = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING)&#xD;
			{&#xD;
				currentLocalRequest.ordine.codificaOLOAGCOMDonating = attributo.valoreAttributo;&#xD;
				currentLocalRequest.codificaOLOAGCOMDonating = attributo.valoreAttributo;&#xD;
				currentAsset.codificaOLOAGCOMDonating = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR)&#xD;
			{&#xD;
				currentLocalRequest.ordine.codificaOLOAGCOMDonor = attributo.valoreAttributo;&#xD;
				currentLocalRequest.codificaOLOAGCOMDonor = attributo.valoreAttributo;&#xD;
				currentAsset.codificaOLOAGCOMDonor = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//NP su cui sto ciclando&#xD;
		if(numero == NPDaAggiungere.get(Process.getActivityLoopIndex()))&#xD;
		{&#xD;
			foundNP = true;&#xD;
			currentLocalRequest.ordine.dettaglioordine.clear();&#xD;
			currentLocalRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}</xpdl2:Script>
                  </xpdl2:TaskScript>
                </xpdl2:Task>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="87.0" Width="119.0">
