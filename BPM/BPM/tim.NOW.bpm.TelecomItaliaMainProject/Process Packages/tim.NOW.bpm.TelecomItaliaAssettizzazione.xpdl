        <xpdl2:Activity Id="_jjDzeornEeazB5r48IqaJg" Name="UpdateAsset2" xpdExt:Visibility="Private" xpdExt:DisplayName="Update Asset">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="GlobalData" Implementation="Other">
                <xpdl2:MessageIn Id="_jjDze4rnEeazB5r48IqaJg"/>
