                <xpdl2:DataMapping Direction="IN" Formal="tipologiaAccessoResponse">
                  <xpdl2:Actual ScriptGrammar="JavaScript">tipologiaAccessoResponse</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="Asset">
                  <xpdl2:Actual ScriptGrammar="JavaScript">Asset</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="SedeCert">
                  <xpdl2:Actual ScriptGrammar="JavaScript">SedeCert</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="tipologiaAccessoResponse">
                  <xpdl2:Actual ScriptGrammar="JavaScript">tipologiaAccessoResponse</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
