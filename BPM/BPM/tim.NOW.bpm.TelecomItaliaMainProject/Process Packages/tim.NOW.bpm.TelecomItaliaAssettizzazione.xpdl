          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var trovata = false;&#xD;
&#xD;
if(localRequest.ordine!=null &#xD;
&amp;&amp; localRequest.strutturaRichiesta != it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG &#xD;
&amp;&amp; (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &#xD;
	|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &#xD;
	|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &#xD;
	|| (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &#xD;
		&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP))))&#xD;
	{&#xD;
	var i=0;&#xD;
	while(!trovata &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
		if(localRequest.ordine.dettaglioordine.get(i).nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY &amp;&amp; (localRequest.ordine.dettaglioordine.get(i).azione==it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A || localRequest.ordine.dettaglioordine.get(i).azione==it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)){&#xD;
			trovata = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
trovata &amp;&amp; localRequest.strutturaRichiesta != it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG;</xpdl2:Expression>
</xpdl2:Condition>
