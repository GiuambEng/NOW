        <xpdl2:Activity Id="_P1-BgptkEeqKY6L7g4699A" Name="RecuperaoccorrenzeNP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupera occorrenze NP" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{	&#xD;
	//RU_1554&#xD;
	if(localRequest.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
	{&#xD;
		Process.auditLog(&quot;Nel caso TLC non vanno assettizzate le NUMBERPORTABILITY con azione A&quot;);&#xD;
	}&#xD;
	else &#xD;
	{	&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++) &#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY&#xD;
			&amp;&amp; componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
			{&#xD;
				var j=0;&#xD;
				var numero = &quot;&quot;;&#xD;
				numero = null;&#xD;
				var numeroTrovato = false;&#xD;
				&#xD;
				while(!numeroTrovato &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
					{&#xD;
						numero = attributo.valoreAttributo;&#xD;
						numeroTrovato = true;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
				&#xD;
				Process.auditLog(&quot;numero:&quot; + numero);&#xD;
				&#xD;
				if(numeroTrovato)&#xD;
				{&#xD;
					NPDaAggiungere.add(numero);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					Process.auditLog(&quot;Non è presente l'elemento NUMEROTELEFONICO della componente NUMBERPORTABILITY ID: &quot;+ componente.IDDettaglioOrdine);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
