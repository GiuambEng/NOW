	AssetCessatiList.addAll(ScriptUtil.copyAll(AssetCessatiTemp));&#xD;
}&#xD;
&#xD;
if(AssetModificatiTemp!=null &amp;&amp; AssetModificatiTemp.size()>0){&#xD;
	AssetModificatiList.addAll(ScriptUtil.copyAll(AssetModificatiTemp));&#xD;
}&#xD;
&#xD;
//SM_9400&#xD;
if(AssetNPsuNPDel82 != null &#xD;
&amp;&amp; localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNPDEL82)&#xD;
{&#xD;
