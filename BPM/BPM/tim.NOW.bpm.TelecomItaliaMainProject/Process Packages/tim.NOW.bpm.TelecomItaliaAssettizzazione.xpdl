        <xpdl2:Activity Id="_zboMp_jqEeuXotChd8W7kg" Name="RecuperaoccorrenzeFEEDERSUCCESSIVO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupera occorrenze FEEDERSUCCESSIVO" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">localRequestTemp = ScriptUtil.copy(localRequest);&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++) &#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.FEEDERSUCCESSIVO&#xD;
		   &amp;&amp; componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
		{&#xD;
			var CLLIFEEDERSUCCESSIVO = &quot;&quot;;&#xD;
			var IDRISORSA = &quot;&quot;;&#xD;
			CLLIFEEDERSUCCESSIVO = null;&#xD;
			IDRISORSA = null;&#xD;
			var BANDA = ''; 				//RU_1414&#xD;
			BANDA = null;					//RU_1414&#xD;
&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIFEEDERSUCCESSIVO)&#xD;
				{&#xD;
					CLLIFEEDERSUCCESSIVO = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
				{&#xD;
					IDRISORSA = attributo.valoreAttributo;&#xD;
				}&#xD;
				//RU_1414&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA) &#xD;
				{&#xD;
					BANDA = attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			Process.auditLog(&quot;CLLIFEEDERSUCCESSIVO: &quot; + CLLIFEEDERSUCCESSIVO + &quot;e IDRISORSA: &quot; +IDRISORSA+&quot;BANDA: &quot;+BANDA);&#xD;
			&#xD;
			if(CLLIFEEDERSUCCESSIVO != null &amp;&amp; IDRISORSA != null &amp;&amp; BANDA != null)&#xD;
			{&#xD;
				ClliFeederSuccessivoDaAggiungere.add(CLLIFEEDERSUCCESSIVO);&#xD;
				IDRisorsaDaAggiungere.add(IDRISORSA);&#xD;
				BandaDaAggiungere.add(BANDA); 							 //RU_1414&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				Process.auditLog(&quot;Non è presente la tripletta CLLIFEEDERSUCCESSIVO-IDRISORSA-BANDA della componente FEEDERSUCCESSIVO ID: &quot;+ componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
