            <xpdl2:Activity Id="_zboMmPjqEeuXotChd8W7kg" Name="Service1" xpdExt:Visibility="Private" xpdExt:DisplayName="Create Asset Case Data">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskService xpdExt:ImplementationType="GlobalData" Implementation="Other">
                    <xpdl2:MessageIn Id="_zboMmfjqEeuXotChd8W7kg"/>
                    <xpdl2:MessageOut Id="_zboMmvjqEeuXotChd8W7kg"/>
                    <xpdExt:GlobalDataOperation>
                      <xpdExt:CaseAccessOperations>
