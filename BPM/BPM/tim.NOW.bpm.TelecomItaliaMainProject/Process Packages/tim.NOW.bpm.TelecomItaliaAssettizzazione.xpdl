        <xpdl2:Activity Id="_IM2UQpNyEeq0BLebgjpy0g" Name="CalcolamappingCPS" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Calcola mapping CPS">
          <xpdl2:Implementation>
