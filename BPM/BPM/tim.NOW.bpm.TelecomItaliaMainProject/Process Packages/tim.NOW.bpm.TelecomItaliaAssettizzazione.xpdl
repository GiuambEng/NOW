        <xpdl2:Activity Id="_vwfkoN1wEeaTc6m_q9HwoA" Name="DecrementoNP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Decremento NP" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//recupera asset&#xD;
&#xD;
var AssetID = 0;&#xD;
	AssetID =null;&#xD;
	var i=0;&#xD;
	while(AssetID== null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			var j=0;&#xD;
			while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					AssetID = parseInt(attr.valoreAttributo, 10);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
	i++;&#xD;
	}&#xD;
	&#xD;
	if (AssetID != null &amp;&amp; AssetID != &quot;&quot;)&#xD;
	{&#xD;
		var c=cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset =:IDA&quot;);&#xD;
		c.setQueryParameter(&quot;IDA&quot;,AssetID);&#xD;
		&#xD;
		var assetRecuperati = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		if(assetRecuperati.size()>0)&#xD;
			&#xD;
		{&#xD;
			AssetCorrelatoRef = assetRecuperati.get(0);&#xD;
			AssetCorrelato = AssetCorrelatoRef.readAsset();&#xD;
			&#xD;
			if(AssetCorrelato != null)&#xD;
			{&#xD;
				AssetCorrelato.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
				AssetCorrelato.lastUpdate = DateTimeUtil.createDatetime();&#xD;
			}&#xD;
			&#xD;
			&#xD;
		}&#xD;
		else &#xD;
		{&#xD;
			Process.auditLog(&quot;Nessun asset recuperato con IDAsset della consistenza fonia: &quot;+ AssetID);&#xD;
		}&#xD;
	}	&#xD;
	&#xD;
	else &#xD;
	{&#xD;
		Process.auditLog(&quot;Non recuperata Consistenza Fonia e/o IdentificativoAsset vuoto o non presente &quot;+ AssetID);&#xD;
	}&#xD;
		&#xD;
&#xD;
&#xD;
//Recupera Asset NP&#xD;
i=0;&#xD;
var NumberPortabilityTrovata = false;&#xD;
while(!NumberPortabilityTrovata &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
	var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
	if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
		&#xD;
		NumberPortabilityTrovata = true;&#xD;
		var attributoTrovato= false;&#xD;
		var j=0;&#xD;
		while(!attributoTrovato &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
			var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
			if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO){&#xD;
				attributoTrovato=true;&#xD;
				Process.auditLog(&quot;Trovato attributo NUMEROTELEFONICO: &quot;+attr.valoreAttributo);&#xD;
				var c=cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico =:Num&quot;);&#xD;
				c.setQueryParameter(&quot;Num&quot;,attr.valoreAttributo);&#xD;
		&#xD;
				var assetRecuperati = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
				if(assetRecuperati.size()>0){&#xD;
					&#xD;
					if(assetRecuperati.size()>1){&#xD;
						var k=0;&#xD;
						var assetTrovato = false;&#xD;
						while(!assetTrovato &amp;&amp; k&lt;assetRecuperati.size()){&#xD;
							if(assetRecuperati.get(k).readAsset().statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO){&#xD;
								assetTrovato=true;&#xD;
								AssetCorrelatoNPRef = assetRecuperati.get(k);&#xD;
								AssetCorrelatoNP = AssetCorrelatoRef.readAsset();&#xD;
							}&#xD;
							&#xD;
							k++;&#xD;
						}&#xD;
						if(assetTrovato){&#xD;
							Process.auditLog(&quot;Sono stati recuperati piu asset con numeroTelefonico della componente NUMEROTELEFONICO: &quot;+attr.valoreAttributo+ &quot;. Solo il primo  con stato ATTIVO è stato considerato&quot;);&#xD;
						}&#xD;
						else{&#xD;
							Process.auditLog(&quot;Sono stati recuperati piu asset con numeroTelefonico della componente NUMEROTELEFONICO: &quot;+attr.valoreAttributo+ &quot;, nessuno in stato ATTIVO&quot;);&#xD;
						}&#xD;
					}&#xD;
					else{&#xD;
						AssetCorrelatoNPRef = assetRecuperati.get(0);&#xD;
						AssetCorrelatoNP = AssetCorrelatoRef.readAsset();&#xD;
					}&#xD;
				}&#xD;
				else {&#xD;
					Process.auditLog(&quot;Nessun asset recuperato con IDRisorsa della consistenza fonia: &quot;+comp.IDRisorsa);&#xD;
				}&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(AssetCorrelatoNP!= null){&#xD;
	AssetCorrelatoNP.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
	AssetCorrelatoNP.lastUpdate = DateTimeUtil.createDatetime();&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="78.0" LaneId="_iQZy49yjEea-L-dywrCoeA" Width="121.0">
              <xpdl2:Coordinates XCoordinate="490.0" YCoordinate="130.0"/>
            </xpdl2:NodeGraphicsInfo>
