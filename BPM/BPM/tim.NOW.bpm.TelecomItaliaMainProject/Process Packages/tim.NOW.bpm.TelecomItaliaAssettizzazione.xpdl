    AssetVLANNGAMULTICAST.provincia = Asset.provincia;&#xD;
&#xD;
&#xD;
// Map from 'Asset.scala' to 'AssetVLANNGAMULTICAST.scala'&#xD;
&#xD;
    AssetVLANNGAMULTICAST.scala = Asset.scala;&#xD;
&#xD;
&#xD;
// Map from 'Asset.siglaProvincia' to 'AssetVLANNGAMULTICAST.siglaProvincia'&#xD;
&#xD;
    AssetVLANNGAMULTICAST.siglaProvincia = Asset.siglaProvincia;&#xD;
&#xD;
&#xD;
// Map from 'Asset.statoAsset' to 'AssetVLANNGAMULTICAST.statoAsset'&#xD;
	if(Asset.statoAsset != null){&#xD;
		AssetVLANNGAMULTICAST.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.get(String(Asset.statoAsset));&#xD;
	}&#xD;
&#xD;
// Map from 'Asset.tipologiaAccesso' to 'AssetVLANNGAMULTICAST.tipologiaAccesso'&#xD;
	if(Asset.tipologiaAccesso != null){&#xD;
		AssetVLANNGAMULTICAST.tipologiaAccesso = it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.get(String(Asset.tipologiaAccesso));&#xD;
	}&#xD;
&#xD;
// Map from 'Asset.tipologiaScenario' to 'AssetVLANNGAMULTICAST.tipologiaScenario'&#xD;
	if(Asset.tipologiaScenario!= null){&#xD;
		AssetVLANNGAMULTICAST.tipologiaScenario = it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.get(String(Asset.tipologiaScenario));&#xD;
	}&#xD;
&#xD;
