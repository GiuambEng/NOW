        <xpdl2:Activity Id="_s01KMMbGEeawBPqzi1D_dw" Name="Cancella" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Cancella" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;Inizio gestione assettizzazione, azione D&quot;);&#xD;
var ora = DateTimeUtil.createDatetime();&#xD;
var CPScessate = false;&#xD;
&#xD;
if(localRequest.ordine!= null)&#xD;
{&#xD;
	var modificati = false;&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++)&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		var IDRisorsa = comp.IDRisorsa;&#xD;
		if(comp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		{&#xD;
			Process.auditLog(&quot;Componente con AZIONE = D, lavorazione= &quot;+localRequest.lavorazione+ &quot; , nomeComponente = &quot;+comp.nomeComponente+ &quot; , comp.IDRisorsa = &quot;+comp.IDRisorsa+ &quot; ,comp.IDRisorsaNOW = &quot;+comp.IDRisorsaNOW );&#xD;
			if(((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE ||&#xD;
				localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE || &#xD;
				localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE) &#xD;
				&amp;&amp; (comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA ||&#xD;
					comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI ||&#xD;
					comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS || //sm9066&#xD;
					comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZARACCOLTA || //RU_1058&#xD;
					comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACANALE ||		//RU_1180&#xD;
					comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFEEDER ||		//RU_1180&#xD;
					comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZASEDEOLT ||		//RU_1180&#xD;
					comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAVLANMULTICAST ||	//RU_1180&#xD;
					comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZANPNG ||			//RU_1203&#xD;
					comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY || &#xD;
					comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO || &#xD;
					comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS))&#xD;
			|| (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &amp;&amp; &#xD;
				(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC ||&#xD;
				comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC ||&#xD;
				comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN ||&#xD;
				comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO))&#xD;
			|| (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE //SM_9560&#xD;
					&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS&#xD;
					&amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR&#xD;
					&amp;&amp; comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS))&#xD;
			{&#xD;
				if(((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE || &#xD;
					localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE ||&#xD;
					localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE) &#xD;
					&amp;&amp; (comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA ||&#xD;
						comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS || //sm9066&#xD;
						comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI ||&#xD;
						comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZARACCOLTA ||		 //RU_1058&#xD;
						comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACANALE ||		//RU_1180&#xD;
						comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFEEDER ||		//RU_1180&#xD;
						comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZASEDEOLT ||		//RU_1180&#xD;
						comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAVLANMULTICAST || //RU_1180&#xD;
						comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZANPNG)) 	//RU_1203&#xD;
				 || (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE //SM_9560&#xD;
					&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS&#xD;
					&amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR&#xD;
					&amp;&amp; comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS))&#xD;
				{&#xD;
					if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI &amp;&amp; AssetConsistenzaDati!= null)&#xD;
					{&#xD;
						AssetConsistenzaDati.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
						AssetConsistenzaDati.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
						AssetConsistenzaDati.codiceOrdineTI = localRequest.codiceOrdineTI;&#xD;
						&#xD;
						var DESTemp = DateTimeUtil.createDate(localRequest.ordine.DES);&#xD;
						DESTemp.add(DateTimeUtil.createDuration(false,0,0,1,0,0,0));&#xD;
						AssetConsistenzaDati.DES = DESTemp;&#xD;
						&#xD;
						AssetConsistenzaDati.ORA_DES =localRequest.ordine.ORA_DES;&#xD;
						AssetConsistenzaDati.lastUpdate = ora;&#xD;
						AssetConsistenzaDati.IDRichiestaOLO = localRequest.IDRichiestaOLO;		&#xD;
						ConsistenzaDatiModificato = true;&#xD;
						AssetConsistenzaDati.CRMOrigine =&quot;NOW&quot;;&#xD;
						&#xD;
						// in caso l'asset principale sia in cessazione &#xD;
						if(Asset!= null &amp;&amp; AssetConsistenzaDati.IDAsset == Asset.IDAsset)&#xD;
						{&#xD;
							Asset = ScriptUtil.copy(AssetConsistenzaDati);&#xD;
						}&#xD;
					}&#xD;
					else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA &amp;&amp; &#xD;
						AssetConsistenzaFonia != null &amp;&amp; !FoniaAggiuntivoWLR)&#xD;
					{&#xD;
						AssetConsistenzaFonia.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO;&#xD;
						AssetConsistenzaFonia.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
						AssetConsistenzaFonia.codiceOrdineTI = localRequest.codiceOrdineTI;&#xD;
						&#xD;
						var DESTemp =  DateTimeUtil.createDate(localRequest.ordine.DES);&#xD;
						//In caso di ATTIVAZIONE (cessazione di un accesso WLR/VULL a causa di portabilità della numerazione) rimane la DES dell'ordine&#xD;
						if(localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
						{&#xD;
							DESTemp.add(DateTimeUtil.createDuration(false,0,0,1,0,0,0));&#xD;
						}&#xD;
						AssetConsistenzaFonia.DES = DESTemp;&#xD;
						&#xD;
						AssetConsistenzaFonia.ORA_DES =localRequest.ordine.ORA_DES;&#xD;
