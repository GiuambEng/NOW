            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_28RkEDQnEei2e9dyLHNFPw" Name="CreaAssetRicarica" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">AssetRicarica =  it_telecomitalia_it_NOW_casedata_Factory.createAssetRicarica();
var Data= DateTimeUtil.createDatetime();

// MAP PER RICARICA INIZIALE DA ATTIVAZIONE BTS DINAMICO

if (Asset!= null)
{
	AssetRicarica.created = Data;
	AssetRicarica.lastUpdate = Data;
	AssetRicarica.operatore = localRequest.operatore;
	AssetRicarica.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ACCESA;
	AssetRicarica.tipologiaRicarica = 10; 
	AssetRicarica.IDAsset = Asset.IDAsset;
	AssetRicarica.famigliaAsset = it_telecomitalia_it_NOW_casedata_FamigliaAsset.RICARICAINIZIALE;
	
	//DataInizio E Data Accensione:
		// corrispondono alla DES dell'ordine  e Ore/Minuti/Secondi di ORA DES dell'ordine arrotondanto per eccesso allo slot di trenta minuti successivo.
	var roundedHour = localRequest.ordine.ORA_DES.getHour();
	var roundedMin = localRequest.ordine.ORA_DES.getMinute();
	if(roundedMin &lt;= 30 &amp;&amp; roundedMin > 0)
 	{
 		 roundedMin = 30;
	 }
 	else if(roundedMin > 30)
 	{
 		 roundedMin = 00;
 		 roundedHour++;
	 }
	AssetRicarica.dataInizio = DateTimeUtil.createDatetime(localRequest.ordine.DES,DateTimeUtil.createTime(roundedHour,roundedMin,0,0));
	AssetRicarica.dataAccensione = AssetRicarica.dataInizio;
	AssetRicarica.dataFine = DateTimeUtil.createDatetime();
}
 
 
// MAP DA ORDINE di RICARICA
else
{
	AssetRicarica.created = Data;
	AssetRicarica.lastUpdate = Data;
	AssetRicarica.operatore = localRequest.operatore;
	
	
	if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ACCENSIONE)
	{
		AssetRicarica.dataAccensione = DateTimeUtil.createDatetime(localRequest.ordine.DES, DateTimeUtil.createTime(localRequest.ordine.ORA_DES));
		AssetRicarica.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ACCESA;
	}
	
	else if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.SCHEDULAZIONE ||
	localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.PROLUNGAMENTO)
	{
		AssetRicarica.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.SCHEDULATA;
	}		
				
	for (var i=0; i&lt; localRequest.ordine.dettaglioordine.size(); i++)
	{
		var currentComponente = localRequest.ordine.dettaglioordine.get(i);
		
		if (currentComponente. nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DATIRICARICA)
		{
			for (var j=0; j&lt; currentComponente.attributiDettaglioOrdine.size(); j++)
			{
				var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);
				
				if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAINIZIORICARICA)
				{
					Process.auditLog(&quot;DataInizio Richiesta: &quot;+String(currentAttributo.valoreAttributo));
					AssetRicarica.dataInizio = DateTimeUtil.createDatetime(currentAttributo.valoreAttributo);
					Process.auditLog(&quot;DataInizioAsset appena creato (dentro): &quot;+AssetRicarica.dataInizio);
				}
				
				else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAFINERICARICA)
				{
					AssetRicarica.dataFine = DateTimeUtil.createDatetime(currentAttributo.valoreAttributo);
				}
				
				else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)
				{
					AssetRicarica.IDAsset = ScriptUtil.createBigInteger(currentAttributo.valoreAttributo);
				}
				
				else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOTIPOLOGIARICARICA)
				{
					AssetRicarica.tipologiaRicarica = parseInt(currentAttributo.valoreAttributo, 10);
				}
				else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIAACCENSIONERICARICA
						&amp;&amp; (AssetRicarica.famigliaAsset == null || AssetRicarica.famigliaAsset == &quot;&quot;) )
				{
					AssetRicarica.famigliaAsset = it_telecomitalia_it_NOW_casedata_FamigliaAsset.get(currentAttributo.valoreAttributo);
				}		
			}
		}
	}
 }
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
