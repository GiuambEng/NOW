        <xpdl2:Activity Id="_osDIgIrREeazB5r48IqaJg" Name="RecuperaoccorrenzeISDN" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupera occorrenze ISDN">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">
if(localRequest.ordine!= null){
	var i =0;
	while (i&lt;localRequest.ordine.dettaglioordine.size()) {
		var componente = localRequest.ordine.dettaglioordine.get(i);
		if(componente.nomeComponente== it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMERIAGGIUNTIVI){
			var j=0;
			var numero =&quot;&quot;;
			var stato=&quot;&quot;;
			var numeroTrovato = false;
			var statoTrovato= false;
			while((!numeroTrovato || !statoTrovato) &amp;&amp;j&lt;componente.attributiDettaglioOrdine.size()){
				var attributo = componente.attributiDettaglioOrdine.get(j);
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO){
					stato = attributo.valoreAttributo;
					statoTrovato=true;
				}
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO){
					numero = attributo.valoreAttributo;
					numeroTrovato=true;
				}
				j++;
			}
			
			Process.auditLog(&quot;numero:&quot;+numero+&quot;,stato: &quot;+stato);
			if(numeroTrovato &amp;&amp; statoTrovato){
				if(stato.toUpperCase()==&quot;ATTIVO&quot;){
					ISDN_NumeriTelefoniciAggiuntivi.add(numero);
				}
			}
			else{
				Process.auditLog(&quot;Non è presente l'elemento NUMEROTELEFONICO oppure l'elemento STATO della componente NUMERIAGGIUNTIVI ID: &quot;+ componente.IDDettaglioOrdine);
			}
		}
		i++;
	}
}

var componenteNUMBERPORTABILITY = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioAsset();
componenteNUMBERPORTABILITY=null;


for(var i = 0; i &lt; AssetTemp.dettaglioasset.size(); i++){
	var componente = AssetTemp.dettaglioasset.get(i);
	
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){
		componenteNUMBERPORTABILITY= ScriptUtil.copy(componente);
		componenteNUMBERPORTABILITY.IDAsset= 0;
		
		/*var attributoDettaglioAsset = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioAsset();
		attributoDettaglioAsset.IDAsset = 0;
		attributoDettaglioAsset.IDDettaglioAsset = componenteNUMBERPORTABILITY.IDDettaglioAsset;
		attributoDettaglioAsset.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;
		attributoDettaglioAsset.created = componenteNUMBERPORTABILITY.created;
		attributoDettaglioAsset.lastUpdate = componenteNUMBERPORTABILITY.created;
		attributoDettaglioAsset.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;
		attributoDettaglioAsset.operatore = componenteNUMBERPORTABILITY.operatore;
		attributoDettaglioAsset.valoreAttributo = NUMEROTELEFONICOPRINCIPALE;
		componenteNUMBERPORTABILITY.attributidettaglioasset.add(ScriptUtil.copy(attributoDettaglioAsset));*/
	}
}
AssetTemp.dettaglioasset.clear();
AssetTemp.dettaglioasset.add(ScriptUtil.copy(componenteNUMBERPORTABILITY));
AssetTemp.numTelPrincipale = NUMEROTELEFONICOPRINCIPALE;</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="78.0" LaneId="_cme6lIfAEeaRRPusWE612A" Width="132.0">
              <xpdl2:Coordinates XCoordinate="1010.0" YCoordinate="324.0"/>
            </xpdl2:NodeGraphicsInfo>
