          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" LaneId="_TMyF3UE6EeekX-brtRDFQQ" Width="45.0">
              <xpdl2:Coordinates XCoordinate="6082.0" YCoordinate="240.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_TMyFc0E6EeekX-brtRDFQQ" Name="Azione" xpdExt:DisplayName="Azione">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_TMyFwkE6EeekX-brtRDFQQ"/>
                  <xpdl2:TransitionRef Id="_TMyFuUE6EeekX-brtRDFQQ"/>
                  <xpdl2:TransitionRef Id="_Gu4T4Dk9EequqZwFqcZDUw"/>
                  <xpdl2:TransitionRef Id="_JKXe4Dk9EequqZwFqcZDUw"/>
                  <xpdl2:TransitionRef Id="_Lb5coDk9EequqZwFqcZDUw"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="71.0" LaneId="_TMyF3UE6EeekX-brtRDFQQ" Width="56.0">
