          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
&amp;&amp; &#xD;
(localRequest.canaleRichiesta != it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL&#xD;
|| &#xD;
(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL &amp;&amp; localRequest.codiceTrasformazione=='CBTSATMSIMM')&#xD;
||&#xD;
(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL &amp;&amp; localRequest.codiceTrasformazione=='CCAMBIOTECNOLOGIA') //RU_1109&#xD;
))&#xD;
|| localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIENTROCPS; //SM_9508: aggiunto RIENTROCPS</xpdl2:Expression></xpdl2:Condition>
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo">
