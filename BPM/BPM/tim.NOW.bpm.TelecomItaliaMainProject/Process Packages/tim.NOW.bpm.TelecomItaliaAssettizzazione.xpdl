/*16*/	OrdineComponente.add(&quot;RACCOLTAVLANNGA&quot;);&#xD;
/*17*/	OrdineComponente.add(&quot;RACCOLTAVLANNGA&quot;);&#xD;
/*18*/	OrdineComponente.add(&quot;RACCOLTAVLANNGA&quot;);&#xD;
/*19*/	OrdineComponente.add(&quot;RACCOLTAVLANNGA&quot;);&#xD;
/*20*/	OrdineComponente.add(&quot;RACCOLTAVLANNGA&quot;);&#xD;
/*21*/ 	OrdineComponente.add(&quot;RACCOLTAVLANNGA&quot;);&#xD;
/*22*/ 	OrdineComponente.add(&quot;RACCOLTAVLANNGA&quot;);&#xD;
/*23*/ 	OrdineComponente.add(&quot;RACCOLTAVLANNGA&quot;);&#xD;
/*24*/ 	OrdineComponente.add(&quot;RACCOLTAVLANNGA&quot;);&#xD;
/*25*/ 	OrdineComponente.add(&quot;RACCOLTAVLANNGA&quot;);&#xD;
