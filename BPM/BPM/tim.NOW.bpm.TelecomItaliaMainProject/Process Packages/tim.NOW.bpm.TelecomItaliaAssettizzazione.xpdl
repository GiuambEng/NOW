              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">//SM_10308: inserito AssetCopiaFeederSuccessivo invece di AssetFeederSuccessivo&#xD;
AssetCopiaFeederSuccessivo = AssetRef.readAsset();&#xD;
var id = AssetCopiaFeederSuccessivo.IDAsset;&#xD;
&#xD;
//Aggiunto dettaglioAsset di AssetFeederSuccessivo per update&#xD;
AssetCopiaFeederSuccessivo.dettaglioasset.addAll(ScriptUtil.copyAll(AssetFeederSuccessivo.dettaglioasset));&#xD;
&#xD;
&#xD;
for(var i = 0; i &lt; AssetCopiaFeederSuccessivo.dettaglioasset.size(); i++)&#xD;
{&#xD;
	AssetCopiaFeederSuccessivo.dettaglioasset.get(i).IDAsset = id;&#xD;
	&#xD;
	for(var j = 0; j &lt; AssetCopiaFeederSuccessivo.dettaglioasset.get(i).attributidettaglioasset.size(); j++)&#xD;
	{&#xD;
		AssetCopiaFeederSuccessivo.dettaglioasset.get(i).attributidettaglioasset.get(j).IDAsset = id;&#xD;
	}&#xD;
}&#xD;
&#xD;
//Task #35710&#xD;
AssetCopiaFeederSuccessivo.cliente.IDAsset = id;&#xD;
Process.auditLog(&quot;Aggiornato ID Asset Feeder Successivo CLIENTE con: &quot;+AssetCopiaFeederSuccessivo.cliente.IDAsset);&#xD;
</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
