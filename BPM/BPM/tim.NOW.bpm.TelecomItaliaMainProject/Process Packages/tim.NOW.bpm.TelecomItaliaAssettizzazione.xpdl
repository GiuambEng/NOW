          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">//RU_1180: aggiunto ciclo per cercare Componenti di accesso ad M/N&#xD;
//RU_1180: aggiunta lav ATTIVAZIONE e logica su ACCESSO a M/N, perché per le nuove offerte CANALE ci sono due sottolav (CANALE ESISTENTE FEEDER e OLT) che prevede delle Attivazioni con azione ad N, che andranno trattate come Variazioni&#xD;
var trovataComponenteACCESSO_MN = false;&#xD;
var trovataComponenteRACCOLTA_MN = false;&#xD;
var i=0;&#xD;
while((!trovataComponenteACCESSO_MN || !trovataComponenteRACCOLTA_MN) &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
	if(String(localRequest.ordine.dettaglioordine.get(i).nomeComponente).slice(0,7) == &quot;ACCESSO&quot; &#xD;
		&amp;&amp; (localRequest.ordine.dettaglioordine.get(i).azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M&#xD;
		 || localRequest.ordine.dettaglioordine.get(i).azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)){&#xD;
		trovataComponenteACCESSO_MN=true;&#xD;
	}&#xD;
	// RU_1058&#xD;
	else if(String(localRequest.ordine.dettaglioordine.get(i).nomeComponente).slice(0,8) == &quot;RACCOLTA&quot; &#xD;
		&amp;&amp; (localRequest.ordine.dettaglioordine.get(i).azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M&#xD;
		 || localRequest.ordine.dettaglioordine.get(i).azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)){&#xD;
		trovataComponenteRACCOLTA_MN=true;&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
|| localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL&#xD;
|| (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp; (trovataComponenteACCESSO_MN || trovataComponenteRACCOLTA_MN));</xpdl2:Expression></xpdl2:Condition>
