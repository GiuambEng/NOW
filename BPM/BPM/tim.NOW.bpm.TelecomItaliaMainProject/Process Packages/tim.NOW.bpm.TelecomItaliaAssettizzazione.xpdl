            <xpdl2:Activity Id="_zboMl_jqEeuXotChd8W7kg" Name="SetcurrentAsset" xpdExt:Visibility="Private" xpdExt:DisplayName="Set currentAsset">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">//ASSET PER IL FEEDERSUCCESSIVO SU CUI SI STA CICLANDO&#xD;
AssetFeederSuccessivo = ScriptUtil.copy(AssetTemp);&#xD;
&#xD;
AssetFeederSuccessivo.IDRisorsa = IDRisorsaDaAggiungere.get(Process.getActivityLoopIndex());&#xD;
AssetFeederSuccessivo.IDRisorsaNOW = IDRisorsaDaAggiungere.get(Process.getActivityLoopIndex());&#xD;
&#xD;
var data = DateTimeUtil.createDatetime();&#xD;
AssetFeederSuccessivo.created = data;&#xD;
AssetFeederSuccessivo.lastUpdate = data;&#xD;
&#xD;
//SET CLLIFEEDERSUCCESSIVO-IDRISORSA IN ACCESSOFEEDER con il FEEDERSUCCESSIVO su cui si sta ciclando &#xD;
for(var i=0; i&lt;AssetFeederSuccessivo.dettaglioasset.size(); i++) &#xD;
{&#xD;
	var componente = AssetFeederSuccessivo.dettaglioasset.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOFEEDER)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributidettaglioasset.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributidettaglioasset.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIFEEDERSUCCESSIVO)&#xD;
			{&#xD;
				attributo.valoreAttributo = ClliFeederSuccessivoDaAggiungere.get(Process.getActivityLoopIndex());&#xD;
&#xD;
				Process.auditLog(&quot;Sostituito CLLIFEEDERSUCCESSIVO di ACCESSOFEEDER con quello del FEEDERSUCCESSIVO: &quot;+ attributo.valoreAttributo);&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
			{&#xD;
				attributo.valoreAttributo = AssetFeederSuccessivo.IDRisorsa;&#xD;
&#xD;
				Process.auditLog(&quot;Sostituito IDRISORSA di ACCESSOFEEDER con quello del FEEDERSUCCESSIVO: &quot;+ attributo.valoreAttributo);&#xD;
			}&#xD;
			//RU_1414&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
			{&#xD;
				attributo.valoreAttributo = BandaDaAggiungere.get(Process.getActivityLoopIndex());&#xD;
&#xD;
				Process.auditLog(&quot;Sostituito BANDA di ACCESSOFEEDER con quello del FEEDERSUCCESSIVO: &quot;+ attributo.valoreAttributo);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//SM_10308&#xD;
AssetCopiaFeederSuccessivo = ScriptUtil.copy(AssetFeederSuccessivo);&#xD;
AssetCopiaFeederSuccessivo.dettaglioasset.clear();</xpdl2:Script>
                  </xpdl2:TaskScript>
                </xpdl2:Task>
