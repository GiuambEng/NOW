        <xpdl2:Activity Id="_RnBRII5gEeeZe50DvZS-Uw" Name="CreatAssettemp" xpdExt:Visibility="Private" xpdExt:DisplayName="Creat Asset temp">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">// Create target 'AssetTemp' if it doesn't exist.
if (AssetTemp == null) {
    AssetTemp = it_telecomitalia_it_NOW_casedata_Factory.createAsset();
}

if (Asset != null) {
// Map from 'Asset.CAP' to 'AssetTemp.CAP'

    AssetTemp.CAP = Asset.CAP;
 

// Map from 'Asset.CLLI' to 'AssetTemp.CLLI'

    AssetTemp.CLLI = Asset.CLLI;
 

// Map from 'Asset.CRMEstrattore' to 'AssetTemp.CRMEstrattore'

    AssetTemp.CRMEstrattore = Asset.CRMEstrattore;
 

// Map from 'Asset.CRMOrigine' to 'AssetTemp.CRMOrigine'

    AssetTemp.CRMOrigine = Asset.CRMOrigine;
 

// Map from 'Asset.DEC' to 'AssetTemp.DEC'

    AssetTemp.DEC = Asset.DEC;
 

// Map from 'Asset.DES' to 'AssetTemp.DES'

    AssetTemp.DES = Asset.DES;
 

// Map from 'Asset.DESPrimoOrdine' to 'AssetTemp.DESPrimoOrdine'

    AssetTemp.DESPrimoOrdine = Asset.DESPrimoOrdine;
 

// Map from 'Asset.IDAssetCRMWS' to 'AssetTemp.IDAssetCRMWS'

    AssetTemp.IDAssetCRMWS = Asset.IDAssetCRMWS;
 

// Map from 'Asset.IDAssetDa' to 'AssetTemp.IDAssetDa'

    AssetTemp.IDAssetDa = Asset.IDAssetDa;
 

// Map from 'Asset.IDContratto' to 'AssetTemp.IDContratto'

    AssetTemp.IDContratto = Asset.IDContratto;
 

// Map from 'Asset.IDCorrelazione' to 'AssetTemp.IDCorrelazione'

    AssetTemp.IDCorrelazione = Asset.IDCorrelazione;
 

// Map from 'Asset.IDOfferta' to 'AssetTemp.IDOfferta'

    AssetTemp.IDOfferta = Asset.IDOfferta;
 

// Map from 'Asset.IDPrimoOrdine' to 'AssetTemp.IDPrimoOrdine'

    AssetTemp.IDPrimoOrdine = Asset.IDPrimoOrdine;
 

// Map from 'Asset.IDRichiestaOLD' to 'AssetTemp.IDRichiestaOLD'

    AssetTemp.IDRichiestaOLD = Asset.IDRichiestaOLD;
 

// Map from 'Asset.IDRichiestaOLO' to 'AssetTemp.IDRichiestaOLO'

    AssetTemp.IDRichiestaOLO = Asset.IDRichiestaOLO;
 

// Map from 'Asset.IDRisorsa' to 'AssetTemp.IDRisorsa'

    AssetTemp.IDRisorsa = Asset.IDRisorsa;
 

// Map from 'Asset.IDRisorsaCorrelato' to 'AssetTemp.IDRisorsaCorrelato'

    AssetTemp.IDRisorsaCorrelato = Asset.IDRisorsaCorrelato;
 

// Map from 'Asset.IDRisorsaNOW' to 'AssetTemp.IDRisorsaNOW'

    AssetTemp.IDRisorsaNOW = Asset.IDRisorsaNOW;
 

// Map from 'Asset.IDRisorsaOLD' to 'AssetTemp.IDRisorsaOLD'

    AssetTemp.IDRisorsaOLD = Asset.IDRisorsaOLD;
 

// Map from 'Asset.LNA_LA' to 'AssetTemp.LNA_LA'
	if (Asset.LNA_LA != null) {
		AssetTemp.LNA_LA = it_telecomitalia_it_NOW_casedata_LNA_LAEnumeration.get(String(String(Asset.LNA_LA)));
	}

// Map from 'Asset.ORA_DES' to 'AssetTemp.ORA_DES'

    AssetTemp.ORA_DES = Asset.ORA_DES;
 

// Map from 'Asset.RO' to 'AssetTemp.RO'

    AssetTemp.RO = Asset.RO;
 

// Map from 'Asset.codiceFatturazioneJPUB' to 'AssetTemp.codiceFatturazioneJPUB'

    AssetTemp.codiceFatturazioneJPUB = Asset.codiceFatturazioneJPUB;
 

// Map from 'Asset.codiceISTATComune' to 'AssetTemp.codiceISTATComune'

    AssetTemp.codiceISTATComune = Asset.codiceISTATComune;
 

// Map from 'Asset.codiceISTATProvincia' to 'AssetTemp.codiceISTATProvincia'

    AssetTemp.codiceISTATProvincia = Asset.codiceISTATProvincia;
 

// Map from 'Asset.codiceOrdineOLO' to 'AssetTemp.codiceOrdineOLO'

    AssetTemp.codiceOrdineOLO = Asset.codiceOrdineOLO;
 

// Map from 'Asset.codiceOrdineTI' to 'AssetTemp.codiceOrdineTI'

    AssetTemp.codiceOrdineTI = Asset.codiceOrdineTI;


// Map from 'Asset.codiceSLAAssurance' to 'AssetTemp.codiceSLAAssurance'

    AssetTemp.codiceSLAAssurance = Asset.codiceSLAAssurance;

// Map from 'Asset.codiceToponomastica' to 'AssetTemp.codiceToponomastica'

    AssetTemp.codiceToponomastica = Asset.codiceToponomastica;

// Map from 'Asset.codificaOLOAGCOM' to 'AssetTemp.codificaOLOAGCOM'

    AssetTemp.codificaOLOAGCOM = Asset.codificaOLOAGCOM;


// Map from 'Asset.codificaOLOAGCOMDonating' to 'AssetTemp.codificaOLOAGCOMDonating'

    AssetTemp.codificaOLOAGCOMDonating = Asset.codificaOLOAGCOMDonating;


// Map from 'Asset.codificaOLOAGCOMDonor' to 'AssetTemp.codificaOLOAGCOMDonor'

    AssetTemp.codificaOLOAGCOMDonor = Asset.codificaOLOAGCOMDonor;


// Map from 'Asset.codificaOLONOWDonating' to 'AssetTemp.codificaOLONOWDonating'

    AssetTemp.codificaOLONOWDonating = Asset.codificaOLONOWDonating;


// Map from 'Asset.codificaOLONOWDonor' to 'AssetTemp.codificaOLONOWDonor'

    AssetTemp.codificaOLONOWDonor = Asset.codificaOLONOWDonor;


// Map from 'Asset.complesso' to 'AssetTemp.complesso'

    AssetTemp.complesso = Asset.complesso;


// Map from 'Asset.comune' to 'AssetTemp.comune'

    AssetTemp.comune = Asset.comune;


// Map from 'Asset.created' to 'AssetTemp.created'

    AssetTemp.created = Asset.created;


// Map from 'Asset.descrPartToponomastica' to 'AssetTemp.descrPartToponomastica'

    AssetTemp.descrPartToponomastica = Asset.descrPartToponomastica;


// Map from 'Asset.descrizioneVia' to 'AssetTemp.descrizioneVia'

    AssetTemp.descrizioneVia = Asset.descrizioneVia;


// Map from 'Asset.distretto' to 'AssetTemp.distretto'

    AssetTemp.distretto = Asset.distretto;


// Map from 'Asset.indirizzoEstesoNonCert' to 'AssetTemp.indirizzoEstesoNonCert'

    AssetTemp.indirizzoEstesoNonCert = Asset.indirizzoEstesoNonCert;


// Map from 'Asset.interno' to 'AssetTemp.interno'

    AssetTemp.interno = Asset.interno;


// Map from 'Asset.invariante' to 'AssetTemp.invariante'

    AssetTemp.invariante = Asset.invariante;


// Map from 'Asset.lastUpdate' to 'AssetTemp.lastUpdate'

    AssetTemp.lastUpdate = Asset.lastUpdate;


// Map from 'Asset.lineaRiferimento' to 'AssetTemp.lineaRiferimento'

    AssetTemp.lineaRiferimento = Asset.lineaRiferimento;


// Map from 'Asset.localita' to 'AssetTemp.localita'

    AssetTemp.localita = Asset.localita;


// Map from 'Asset.modalitaFatturazione' to 'AssetTemp.modalitaFatturazione'

    AssetTemp.modalitaFatturazione = Asset.modalitaFatturazione;


// Map from 'Asset.numTelPrincipale' to 'AssetTemp.numTelPrincipale'

    AssetTemp.numTelPrincipale = Asset.numTelPrincipale;


// Map from 'Asset.numeroCivico' to 'AssetTemp.numeroCivico'

    AssetTemp.numeroCivico = Asset.numeroCivico;


// Map from 'Asset.numeroFittizio' to 'AssetTemp.numeroFittizio'

    AssetTemp.numeroFittizio = Asset.numeroFittizio;


// Map from 'Asset.numeroTelefonico' to 'AssetTemp.numeroTelefonico'

    AssetTemp.numeroTelefonico = Asset.numeroTelefonico;


// Map from 'Asset.offerta' to 'AssetTemp.offerta'
	if(Asset.offerta != null){
		AssetTemp.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.get(String(Asset.offerta));
	}

// Map from 'Asset.operatore' to 'AssetTemp.operatore'

    AssetTemp.operatore = Asset.operatore;


// Map from 'Asset.operatoreRete' to 'AssetTemp.operatoreRete'

    AssetTemp.operatoreRete = Asset.operatoreRete;

// Map from 'Asset.piano' to 'AssetTemp.piano'

    AssetTemp.piano = Asset.piano;


// Map from 'Asset.provincia' to 'AssetTemp.provincia'

    AssetTemp.provincia = Asset.provincia;


// Map from 'Asset.scala' to 'AssetTemp.scala'

    AssetTemp.scala = Asset.scala;


// Map from 'Asset.siglaProvincia' to 'AssetTemp.siglaProvincia'

    AssetTemp.siglaProvincia = Asset.siglaProvincia;

// Map from 'Asset.flagDelibera103' to 'AssetTemp.flagDelibera103'

    AssetTemp.flagDelibera103 = Asset.flagDelibera103; //SM_10935


// Map from 'Asset.statoAsset' to 'AssetTemp.statoAsset'
	if(Asset.statoAsset != null){
		AssetTemp.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.get(String(Asset.statoAsset));
	}

// Map from 'Asset.tipologiaAccesso' to 'AssetTemp.tipologiaAccesso'
	if(Asset.tipologiaAccesso != null){
		AssetTemp.tipologiaAccesso = it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.get(String(Asset.tipologiaAccesso));
	}

// Map from 'Asset.tipologiaScenario' to 'AssetTemp.tipologiaScenario'
	if(Asset.tipologiaScenario!= null){
		AssetTemp.tipologiaScenario = it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.get(String(Asset.tipologiaScenario));
	}

// Map from 'Asset.totaleOrdinePacchetto' to 'AssetTemp.totaleOrdinePacchetto'

    AssetTemp.totaleOrdinePacchetto = Asset.totaleOrdinePacchetto;
 
// Map from 'Asset.cliente' to 'AssetTemp.cliente'
	if(Asset.cliente!= null){
		AssetTemp.cliente = ScriptUtil.copy(Asset.cliente);
	}
	
	if(Asset.dettaglioasset!= null &amp;&amp; Asset.dettaglioasset.size()>0){
		AssetTemp.dettaglioasset.addAll(ScriptUtil.copyAll(Asset.dettaglioasset));
	}
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_cme6lIfAEeaRRPusWE612A" Width="107.0">
              <xpdl2:Coordinates XCoordinate="846.0" YCoordinate="324.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:AssociatedParameters DisableImplicitAssociation="false">
            <xpdExt:AssociatedParameter FormalParam="AssetTemp" Mode="OUT" Mandatory="false">
              <xpdl2:Description></xpdl2:Description>
            </xpdExt:AssociatedParameter>
            <xpdExt:AssociatedParameter FormalParam="Asset" Mode="IN" Mandatory="false"/>
          </xpdExt:AssociatedParameters>
