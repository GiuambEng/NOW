              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Initiated">
                  <xpdExt:Information ScriptGrammar="JavaScript">Process.auditLog(&quot;Aggiorna consistenza CPS: &quot;+AssetConsistenzaCPS.IDAsset);&#xD;
&#xD;
if(AssetConsistenzaCPS.statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)&#xD;
{&#xD;
	AssetCessatiList.add(ScriptUtil.copy(AssetConsistenzaCPS));&#xD;
}&#xD;
else&#xD;
{&#xD;
	AssetModificatiList.add(ScriptUtil.copy(AssetConsistenzaCPS));&#xD;
}</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
              <xpdExt:ScriptInformation Id="_XsbykEjSEeqiG95yd6Fgsg">
