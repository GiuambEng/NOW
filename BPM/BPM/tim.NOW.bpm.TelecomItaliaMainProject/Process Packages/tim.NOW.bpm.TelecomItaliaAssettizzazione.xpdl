				else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &amp;&amp; (comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC || comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN))&#xD;
				{&#xD;
					var VPIOrdine = &quot;&quot;;&#xD;
					VPIOrdine = null;&#xD;
					var VCIOrdine = &quot;&quot;;&#xD;
					VCIOrdine = null;&#xD;
					var uservlanOrdine = &quot;&quot;;&#xD;
					uservlanOrdine = null;&#xD;
					var DLCIOrdine = &quot;&quot;;&#xD;
					DLCIOrdine = null;&#xD;
					&#xD;
					var t=0;&#xD;
					while(t&lt;comp.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						if(comp.attributiDettaglioOrdine.get(t).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
						{&#xD;
							VPIOrdine = comp.attributiDettaglioOrdine.get(t).valoreAttributo;&#xD;
						}&#xD;
						else if(comp.attributiDettaglioOrdine.get(t).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
						{&#xD;
							VCIOrdine = comp.attributiDettaglioOrdine.get(t).valoreAttributo;&#xD;
						}&#xD;
						else if(comp.attributiDettaglioOrdine.get(t).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
						{&#xD;
							uservlanOrdine = comp.attributiDettaglioOrdine.get(t).valoreAttributo;&#xD;
						}&#xD;
