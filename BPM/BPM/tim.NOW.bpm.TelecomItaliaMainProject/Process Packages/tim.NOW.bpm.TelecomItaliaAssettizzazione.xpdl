        <xpdl2:Activity Id="_NYxFsKNhEee-csXjsBbgcA" Name="TrascodificaOfferta" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Trascodifica Offerta">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_koutAJ4CEee3G_cDX6uohw" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="Offerta">
                  <xpdExt:ScriptInformation Id="_PzgCwKNhEee-csXjsBbgcA" Name="NP">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;NP&quot;;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="IDRichiestaOLO">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="IDOfferta">
                  <xpdl2:Actual ScriptGrammar="JavaScript">Asset.IDOfferta</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_EVDa9tjpEeag_e2OckmEJw" Width="142.0">
              <xpdl2:Coordinates XCoordinate="939.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.TrascodificaOfferta&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
