        <xpdl2:Activity Id="_JS06EDQnEei2e9dyLHNFPw" Name="UpdateAsset" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Update Asset">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var DateTime = DateTimeUtil.createDatetime();&#xD;
IDAssetRicarica = null;&#xD;
&#xD;
if (localRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.RICARICA)&#xD;
{&#xD;
	&#xD;
	var IDAsset = &quot;&quot;;&#xD;
	IDAsset = null;&#xD;
	&#xD;
	var i=0;&#xD;
	while ((IDAssetRicarica == null || IDAsset == null) &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{	&#xD;
		var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if (currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DATIRICARICA)&#xD;
		{&#xD;
		&#xD;
			var j=0;&#xD;
			while ((IDAssetRicarica == null || IDAsset == null) &amp;&amp; j&lt;currentComponente.attributiDettaglioOrdine.size())&#xD;
			{	&#xD;
				var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
				if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSETRICARICA)&#xD;
				{&#xD;
					IDAssetRicarica = currentAttributo.valoreAttributo; &#xD;
					Process.auditLog('Recuperato IDAssetRicarica: '+ IDAssetRicarica);&#xD;
				&#xD;
				}&#xD;
				else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					IDAsset = currentAttributo.valoreAttributo; &#xD;
					Process.auditLog('Recuperato IDAsset dell accesso dinamico: '+ IDAsset);			&#xD;
				}		&#xD;
			j++;&#xD;
			}&#xD;
		}&#xD;
	i++;&#xD;
	}&#xD;
&#xD;
	// ricavo asset Ricarica	&#xD;
	AssetRicaricaRef = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.findByIDAssetRicarica(ScriptUtil.createBigInteger(IDAssetRicarica));&#xD;
	AssetRicarica = it_telecomitalia_it_NOW_casedata_Factory.createAssetRicarica();&#xD;
	AssetRicarica = AssetRicaricaRef.readAssetRicarica();	&#xD;
	&#xD;
	//INIZIO AGGIONRAMENTO ASSET RICARICA&#xD;
	AssetRicarica.lastUpdate = DateTime;&#xD;
	&#xD;
		// ANNULLAMENTO&#xD;
		if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTO)&#xD;
		{&#xD;
			AssetRicarica.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ANNULLATA;&#xD;
			AssetRicarica.dataAnnullamento = DateTime;&#xD;
			AssetRicarica.lastUpdate = DateTime;&#xD;
			ListAssetRicaricheRef.add(AssetRicaricaRef);&#xD;
			ListAssetRicariche.add(AssetRicarica);&#xD;
			ListIDAssetModified.add(AssetRicarica.IDAssetRicarica);&#xD;
			Process.auditLog('Annullato asset ricarica con IDAssetRicarica: '+ IDAssetRicarica);&#xD;
		}&#xD;
	&#xD;
		//PROLUNGAMENTO e SCHEDULAZIONE&#xD;
		//Task legato all'SM_8732 Bug #23166&#xD;
		if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.PROLUNGAMENTO || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.SCHEDULAZIONE)&#xD;
		{&#xD;
			AssetRicarica.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.SCHEDULATA;&#xD;
			AssetRicarica.dataSpegnimento = DateTime;&#xD;
			AssetRicarica.lastUpdate = DateTime;&#xD;
			ListAssetRicaricheRef.add(AssetRicaricaRef);&#xD;
			ListAssetRicariche.add(AssetRicarica);&#xD;
			ListIDAssetModified.add(AssetRicarica.IDAssetRicarica);&#xD;
			Process.auditLog('Schedulato asset ricarica con IDAssetRicarica: '+ IDAssetRicarica);&#xD;
		}&#xD;
		//End Bug #23166&#xD;
	&#xD;
		//SPEGNIMENTO DIRETTO&#xD;
		if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.SPEGNIMENTO)&#xD;
		{&#xD;
			AssetRicarica.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.SPENTA;&#xD;
			AssetRicarica.dataSpegnimento = DateTime;&#xD;
			AssetRicarica.lastUpdate = DateTime;&#xD;
			ListAssetRicaricheRef.add(AssetRicaricaRef);&#xD;
			ListAssetRicariche.add(AssetRicarica);&#xD;
			ListIDAssetModified.add(AssetRicarica.IDAssetRicarica);&#xD;
			Process.auditLog('Spento asset ricarica con IDAssetRicarica: '+ IDAssetRicarica);&#xD;
		}&#xD;
		&#xD;
		//ACCENSIONE&#xD;
		else if ( localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ACCENSIONE)&#xD;
		{&#xD;
			AssetRicarica.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ACCESA;&#xD;
			AssetRicarica.lastUpdate = DateTime;&#xD;
			if(localRequest.codiceTrasformazione != null &amp;&amp; localRequest.codiceTrasformazione == &quot;ACCPROL&quot;)&#xD;
			{&#xD;
				AssetRicarica.dataAccensione = AssetRicarica.dataInizio;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				AssetRicarica.dataAccensione = DateTimeUtil.createDatetime(localRequest.ordine.DES, DateTimeUtil.createTime(localRequest.ordine.ORA_DES));&#xD;
			}&#xD;
			ListAssetRicaricheRef.add(AssetRicaricaRef);&#xD;
			ListAssetRicariche.add(AssetRicarica);&#xD;
			ListIDAssetModified.add(AssetRicarica.IDAssetRicarica);&#xD;
			Process.auditLog('Acceso asset ricarica con IDAssetRicarica: '+ IDAssetRicarica);&#xD;
			&#xD;
		}&#xD;
}&#xD;
	&#xD;
//SPEGNIMENTO INDOTTO&#xD;
	//CASO 1: ACCENSIONE DI UN PROLUNGAMENTO NRT: si ricerca se esistono ricariche accese da spegnere&#xD;
	if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ACCENSIONE &amp;&amp;&#xD;
	localRequest.codiceTrasformazione != null &amp;&amp; localRequest.codiceTrasformazione == &quot;ACCPROL&quot;)&#xD;
	{&#xD;
		if (IDAsset!= null &amp;&amp; IDAsset!= &quot;&quot;)&#xD;
		{&#xD;
			var criteria = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.createCriteria(&quot;IDAsset=: IDAssetAccessoDinamico AND IDAssetRicarica &lt;>: IDAssetRicarica AND statoAsset='ACCESA'&quot;);&#xD;
			criteria.setQueryParameter(&quot;IDAssetAccessoDinamico&quot;,ScriptUtil.createBigInteger(IDAsset));&#xD;
			criteria.setQueryParameter(&quot;IDAssetRicarica&quot;,ScriptUtil.createBigInteger(IDAssetRicarica));&#xD;
			&#xD;
			var result = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.findByCriteria(criteria);	&#xD;
			Process.auditLog('Accensione di un Prolungamento - verifico se esistono ricariche da spegnere');&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	// CASO 2 : CESSAZIONE ACCESSO DINAMICO: vengono spente tutte le Ricariche&#xD;
	else if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
	{&#xD;
		if (Asset!= null)&#xD;
		{&#xD;
			var criteria = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.createCriteria(&quot;IDAsset =: IDAssetAccessoDinamico AND statoAsset &lt;>'SPENTA'&quot;);&#xD;
			criteria.setQueryParameter(&quot;IDAssetAccessoDinamico&quot;,ScriptUtil.createBigInteger(Asset.IDAsset));&#xD;
			&#xD;
			var result = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.findByCriteria(criteria);&#xD;
			Process.auditLog('Cessazione accesso dinamico con idasset '+ Asset.IDAsset +' verifico se esistono ricariche da spegnere');&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	else if(localRequest.lavorazione==it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &amp;&amp; localRequest.ordine!=null &#xD;
	&amp;&amp; localRequest.ordine.dettaglioordine!=null &amp;&amp; localRequest.ordine.dettaglioordine.size()>0)&#xD;
	{&#xD;
		var trovataCons=false;&#xD;
		var opzioneDinamica=&quot;&quot;;&#xD;
		var idAssetDinamico=&quot;&quot;;&#xD;
		var i=0;&#xD;
		while(!trovataCons &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDett = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(currentDett.nomeComponente==it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
			{&#xD;
				trovataCons=true;&#xD;
				if(currentDett.attributiDettaglioOrdine != null &amp;&amp; currentDett.attributiDettaglioOrdine.size()>0 &#xD;
				&amp;&amp; currentDett.azione==it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
				{&#xD;
					var j=0;&#xD;
					while((opzioneDinamica==&quot;&quot; || idAssetDinamico==&quot;&quot;) &amp;&amp; j&lt;currentDett.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currAttr=currentDett.attributiDettaglioOrdine.get(j);&#xD;
						if(currAttr.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONEDINAMICA)&#xD;
						{&#xD;
							opzioneDinamica=currAttr.valoreAttributo;&#xD;
						}&#xD;
						else if(currAttr.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
						{&#xD;
							idAssetDinamico=currAttr.valoreAttributo;&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		if(opzioneDinamica!=null &amp;&amp; opzioneDinamica==&quot;Y&quot; &amp;&amp; idAssetDinamico!=null &amp;&amp; idAssetDinamico!=&quot;&quot;)&#xD;
		{&#xD;
			var criteria = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.createCriteria(&quot;IDAsset =: IDAssetAccessoDinamico AND statoAsset &lt;>'SPENTA'&quot;);&#xD;
			criteria.setQueryParameter(&quot;IDAssetAccessoDinamico&quot;,ScriptUtil.createBigInteger(idAssetDinamico));&#xD;
			&#xD;
			var result = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.findByCriteria(criteria);&#xD;
			Process.auditLog('Cessazione accesso dinamico da migrazione con idasset '+ idAssetDinamico +' verifico se esistono ricariche da spegnere');&#xD;
		}&#xD;
	}&#xD;
			&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		for (var k=0; k&lt;result.size(); k++)&#xD;
		{&#xD;
			var AssetRicTempRef = result.get(k);&#xD;
			AssetRicaricaTemp = ScriptUtil.copy(AssetRicTempRef.readAssetRicarica());&#xD;
					&#xD;
			if(AssetRicaricaTemp.statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ACCESA&#xD;
			|| AssetRicaricaTemp.statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.SCHEDULATA&#xD;
			|| AssetRicaricaTemp.statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.PROGRAMMATA)&#xD;
			{&#xD;
				if(AssetRicaricaTemp.statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ACCESA)&#xD;
				{&#xD;
					AssetRicaricaTemp.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.SPENTA;&#xD;
					AssetRicaricaTemp.dataSpegnimento = DateTime;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					AssetRicaricaTemp.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ANNULLATA;&#xD;
					AssetRicaricaTemp.dataAnnullamento = DateTime;&#xD;
				}&#xD;
				AssetRicaricaTemp.lastUpdate = DateTime;&#xD;
			&#xD;
				ListAssetRicaricheRef.add(AssetRicTempRef);&#xD;
				ListAssetRicariche.add(AssetRicaricaTemp);&#xD;
				ListIDAssetModified.add(AssetRicaricaTemp.IDAssetRicarica);&#xD;
				IDAssetRicarica = AssetRicaricaTemp.IDAssetRicarica; //rimappo IDASSET ricarica perch+ valorizzato solo per tiporichiesta RICARICA e non per CESSAZIONE.&#xD;
			&#xD;
				Process.auditLog('Spenta Ricarica con IDAssetRicarica ' + String(AssetRicaricaTemp.IDAssetRicarica) );&#xD;
			}		&#xD;
		}				&#xD;
	}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="74.0" LaneId="_2R_NkTP-Eei2e9dyLHNFPw" Width="174.0">
              <xpdl2:Coordinates XCoordinate="384.0" YCoordinate="317.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_9j5YUDQnEei2e9dyLHNFPw" Name="TINOWCreaAssetRicarica" xpdExt:Visibility="Private" xpdExt:DisplayName="TINOW-CreaAssetRicarica">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_d7XEUjQnEei2e9dyLHNFPw" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdExt:InputMappings MapperContext="ProcessToSubProcess" MappingDirection="IN">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="Asset">
                    <xpdl2:Actual ScriptGrammar="JavaScript">Asset</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="localRequest">
                    <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:InputMappings>
              <xpdExt:OutputMappings MapperContext="SubProcessToProcess" MappingDirection="OUT">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="SubProcessToProcess.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="AssetRicarica">
                    <xpdl2:Actual ScriptGrammar="JavaScript">AssetRicarica</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="SubProcessToProcess.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="localRequest">
                    <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:OutputMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_2R_NkTP-Eei2e9dyLHNFPw" Width="128.0">
              <xpdl2:Coordinates XCoordinate="398.0" YCoordinate="49.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(AssetRicarica != null)&#xD;
{&#xD;
	Process.auditLog(&quot;DataInizioAsset appena creato: &quot;+AssetRicarica.dataInizio);&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_COe0gDvxEei7IcgYfvd3tQ" Name="CalcolaDataFineRicaricaperRICARICAINIZIALE" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola Data Fine Ricarica per RICARICAINIZIALE">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_76gV0IufEea6Hs4N8ixhVg" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdExt:OutputMappings MapperContext="SubProcessToProcess" MappingDirection="OUT">
