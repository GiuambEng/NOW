          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//DA TENERE ALLINEATO CON &#xD;
// Assettizzazione - Gestione Componenti CPS Aggiuntive -> &quot;Calcola Mapping CPS&quot;&#xD;
//RU_915: Assettizzazione CPS.&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
{&#xD;
	OrdineComponente.add(&quot;ACCESSOCPS&quot;);&#xD;
