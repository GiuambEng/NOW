                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">if(Process.getActivityLoopIndex() == 0) //SM_9452: se è il primo Asset creato si mette in ASSET, altrimenti in ASSETAGGIUNTIVI&#xD;
{&#xD;
