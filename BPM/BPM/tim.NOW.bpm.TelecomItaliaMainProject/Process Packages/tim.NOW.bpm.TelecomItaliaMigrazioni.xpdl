        </xpdl2:Activity>
        <xpdl2:Activity Id="_7miQgDvhEeeY9NczQql8Ig" Name="VerificanecessitageneraIDRisorsa" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica necessita genera ID Risorsa">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var DN = &quot;&quot;;&#xD;
DN = null;&#xD;
&#xD;
var IDRisorsa = &quot;&quot;;&#xD;
IDRisorsa = null;&#xD;
&#xD;
var IDRisorsaNow = &quot;&quot;;&#xD;
IDRisorsaNow = null;&#xD;
&#xD;
var accessoTrovato = false;&#xD;
var i = 0;&#xD;
while(!accessoTrovato &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		accessoTrovato = true;&#xD;
		var j = 0;&#xD;
		while(DN == null &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN)&#xD;
			{&#xD;
				DN = attributo.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}	&#xD;
	i++;&#xD;
}&#xD;
Process.auditLog(&quot;DN: &quot;+DN);&#xD;
&#xD;
var SimmToSimmNaked = false;&#xD;
&#xD;
// RU_685 - Nel caso di donating BTS Simm Naked e recipient VULAC/NGA FTTC/BTS Naked si genererà una nuova risorsa naked richiamando il servizio BW&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB)&#xD;
{&#xD;
	&#xD;
	var tipoLineaOrdine = '';&#xD;
	tipoLineaOrdine = null;&#xD;
		&#xD;
	if(ConsistenzaDati != null &amp;&amp;&#xD;
	   ConsistenzaDati.offerta != null &amp;&amp;&#xD;
		(ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMSIMMETRICO ||&#xD;
		 ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT ||&#xD;
	     ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL) &amp;&amp;&#xD;
	   ConsistenzaDati.tipoLinea != null &amp;&amp;&#xD;
	   ConsistenzaDati.tipoLinea == 'LineaNonFonia')&#xD;
	 {&#xD;
		&#xD;
		//Cerco tipoLineaOrdine per capire se anche l'offerta in input NAKED&#xD;
		var i = 0;&#xD;
		while(tipoLineaOrdine == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(tipoLineaOrdine == null &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						tipoLineaOrdine = attributo.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		// Bisogna generare nuovo IDRisorsa&#xD;
		if(tipoLineaOrdine == 'LineaNonFonia')&#xD;
		{&#xD;
			IDRisorsa = null;&#xD;
			IDRisorsaNow = null;&#xD;
			SimmToSimmNaked = true;&#xD;
		}&#xD;
	 }&#xD;
}&#xD;
&#xD;
//Richiesta WLR LA - WLR LNA - VULL&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA) &amp;&amp;&#xD;
!SimmToSimmNaked)&#xD;
{&#xD;
	//Donating WLR - VULL - ULL NP - SLU NP - ULL Dati NP&#xD;
	if(ConsistenzaFonia != null &#xD;
	&amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEAATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULL&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULLLINEANONATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEAATTIVANP&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVANP))&#xD;
	{&#xD;
		IDRisorsa = ConsistenzaFonia.IDRisorsa;&#xD;
		IDRisorsaNow = ConsistenzaFonia.IDRisorsaNOW;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		IDRisorsa = DN;&#xD;
		IDRisorsaNow = DN;&#xD;
	}&#xD;
}&#xD;
&#xD;
//Richiesta SLU NP - ULL NP - ULL DATI NP&#xD;
else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP) &amp;&amp;&#xD;
!SimmToSimmNaked)&#xD;
{&#xD;
	IDRisorsa = DN;&#xD;
	IDRisorsaNow = DN;&#xD;
}&#xD;
&#xD;
//Richiesta SLU LNA - ULL LNA - ULL DATI LNA&#xD;
else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA) &amp;&amp;&#xD;
!SimmToSimmNaked)&#xD;
{&#xD;
	//Donating SLU LA - ULL LA - ULL DATI LA&#xD;
	if(ConsistenzaFonia != null&#xD;
	&amp;&amp;(ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEAATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVA))&#xD;
	{&#xD;
		IDRisorsa = ConsistenzaFonia.IDRisorsa;&#xD;
		IDRisorsaNow = ConsistenzaFonia.IDRisorsaNOW;&#xD;
	}&#xD;
	&#xD;
	//Donating SLU LNA - ULL LNA - ULL DATI LNA&#xD;
	else if(ConsistenzaFonia != null&#xD;
	&amp;&amp;(ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEANONATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEANONATTIVA))&#xD;
	{&#xD;
		//RU_1587: per i casi TIM-TIM in cui CODICEORDINEOLO inizi per MVG, non va rigenerato l'IDRISORSA&#xD;
		if(ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot; &amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
		   &amp;&amp; localRequest.codiceOrdineOLO != null &amp;&amp; localRequest.codiceOrdineOLO.slice(0,3) == &quot;MVG&quot;)&#xD;
		{&#xD;
			IDRisorsa = ConsistenzaFonia.IDRisorsa;&#xD;
			IDRisorsaNow = ConsistenzaFonia.IDRisorsaNOW;&#xD;
		}&#xD;
		//solito&#xD;
		else if(ConsistenzaFonia.codificaOLOAGCOMDonating != &quot;TLC&quot;&#xD;
		|| (ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot; &amp;&amp; ConsistenzaFonia.IDRisorsa.charAt(0) == &quot;U&quot;))&#xD;
		{&#xD;
			IDRisorsa = ConsistenzaFonia.IDRisorsa;&#xD;
			IDRisorsaNow = ConsistenzaFonia.IDRisorsaNOW;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//Richiesta SLU LA - ULL LA - ULL DATI LA&#xD;
else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA) &amp;&amp;&#xD;
!SimmToSimmNaked)&#xD;
{&#xD;
	//Donating SLU LNA - ULL LNA - ULL DATI LNA&#xD;
	if(ConsistenzaFonia != null&#xD;
	&amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEAATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVA))&#xD;
	{&#xD;
		if(ConsistenzaFonia.IDRisorsa.charAt(0) == &quot;U&quot;)&#xD;
		{&#xD;
			IDRisorsa = ConsistenzaFonia.IDRisorsa;&#xD;
			IDRisorsaNow = ConsistenzaFonia.IDRisorsaNOW;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//Donating SLU LA - ULL LA - ULL DATI LA&#xD;
	if(ConsistenzaFonia != null&#xD;
	&amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEAATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVA))&#xD;
	{&#xD;
		IDRisorsa = ConsistenzaFonia.IDRisorsa;&#xD;
		IDRisorsaNow = ConsistenzaFonia.IDRisorsaNOW;&#xD;
	}&#xD;
}&#xD;
&#xD;
//Richiesta SHA&#xD;
else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA) &amp;&amp;&#xD;
!SimmToSimmNaked)&#xD;
{&#xD;
	if(ConsistenzaDati != null &#xD;
	&amp;&amp; (((ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULAFTTCAB &#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPSPECIALPROFILELITE)&#xD;
		&amp;&amp; ConsistenzaDati.tipoLinea == &quot;POTS&quot;)&#xD;
	))&#xD;
	{&#xD;
		IDRisorsa = ConsistenzaFonia.IDRisorsa;&#xD;
		IDRisorsaNow = ConsistenzaFonia.IDRisorsaNOW;&#xD;
	}&#xD;
	else if (ConsistenzaDati != null &amp;&amp; (ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SHACONMANODOPERA&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SHASENZAMANODOPERA))&#xD;
		{&#xD;
		IDRisorsa = ConsistenzaDati.IDRisorsa;&#xD;
		IDRisorsaNow = ConsistenzaDati.IDRisorsaNOW;&#xD;
		}&#xD;
}&#xD;
&#xD;
//Richiesta VULA FTTH - BTS FTTH&#xD;
else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH                  //RU_1164: aggiunte SEMI***&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH) &amp;&amp;&#xD;
!SimmToSimmNaked)&#xD;
{&#xD;
	if(ConsistenzaDati != null&#xD;
	&amp;&amp;(ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMNGAFTTH &#xD;
	    || ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIBITSTREAMNGAFTTH   //RU_1164: aggiunte SEMI***&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULAFTTH&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIVULAFTTH&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPNGAFTTH&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.FULLGPONPLUS			//SM_11648&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.FULLGPONPLUSNGA))&#xD;
	{&#xD;
		if(ConsistenzaDati.IDRisorsa != ConsistenzaDati.IDRisorsaNOW)&#xD;
		{&#xD;
			//Per verificare se donating è Metroweb&#xD;
			IDRisorsa = ConsistenzaDati.IDRisorsa;&#xD;
			IDRisorsaNow = ConsistenzaDati.IDRisorsaNOW;&#xD;
		}&#xD;
		else if(ConsistenzaDati.IDRisorsa == &quot;&quot; || isNaN(ConsistenzaDati.IDRisorsa))&#xD;
		{&#xD;
			Process.auditLog(&quot;Calcola IDRisorsa aggiungendo 2, IDRisorsa :&quot; + ConsistenzaDati.IDRisorsa);&#xD;
			var IDRisorsa_parteSinistra = ConsistenzaDati.IDRisorsa.slice(0, ConsistenzaDati.IDRisorsa.length - 2);&#xD;
			var IDRisorsa_parteDestraNun = parseInt(ConsistenzaDati.IDRisorsa.slice(ConsistenzaDati.IDRisorsa.length - 2, ConsistenzaDati.IDRisorsa.length), 10) + 2;&#xD;
			var IDRisorsa_parteDestra = &quot;&quot;;&#xD;
			IDRisorsa_parteDestra = null;&#xD;
			if(IDRisorsa_parteDestraNun &lt; 10)&#xD;
			{&#xD;
				IDRisorsa_parteDestra = &quot;0&quot; + IDRisorsa_parteDestraNun;&#xD;
			}&#xD;
			else if(IDRisorsa_parteDestraNun &lt; 100)&#xD;
			{&#xD;
				IDRisorsa_parteDestra = &quot;&quot;+IDRisorsa_parteDestraNun;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				//Valore 100 superato&#xD;
				Process.auditLog(&quot;Il contatore per la generazione dell'IDRisorsa ha superato 99.&quot;);&#xD;
				IDRisorsa_parteDestra.length;&#xD;
			}&#xD;
			IDRisorsa = IDRisorsa_parteSinistra + IDRisorsa_parteDestra;&#xD;
			IDRisorsaNow = IDRisorsa_parteSinistra + IDRisorsa_parteDestra;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//Richiesta VULAC - NGA FTTCAB - BTS - EASYIP Condivisi e Naked&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB) &amp;&amp;&#xD;
!SimmToSimmNaked)&#xD;
{&#xD;
	if(ConsistenzaDati != null&#xD;
	&amp;&amp; (ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULAFTTCAB&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPNGAFTTCAB))&#xD;
	{&#xD;
		var tipoLineaOrdine = &quot;&quot;;&#xD;
		tipoLineaOrdine = null;&#xD;
		var tipoLineaAsset = &quot;&quot;;&#xD;
		tipoLineaAsset = null;&#xD;
		&#xD;
		//Cerco tipoLineaOrdine&#xD;
		var i = 0;&#xD;
		while(tipoLineaOrdine == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(tipoLineaOrdine == null &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						tipoLineaOrdine = attributo.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		//Cerco tipoLineaAsset&#xD;
		var assetDatiRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
		var assetDati = assetDatiRef.readAsset();&#xD;
		&#xD;
		var i = 0;&#xD;
		while(tipoLineaAsset == null &amp;&amp; i &lt; assetDati.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetDati.dettaglioasset.get(i);&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(tipoLineaAsset == null &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						tipoLineaAsset = attributo.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		/*&#xD;
		//SM_3355&#xD;
		if((tipoLineaAsset == &quot;LineaNonFonia&quot; &amp;&amp; tipoLineaOrdine == &quot;ISDN&quot;)&#xD;
		|| (tipoLineaOrdine == &quot;LineaNonFonia&quot; &amp;&amp; tipoLineaAsset == &quot;ISDN&quot;)&#xD;
		|| (tipoLineaAsset != &quot;LineaNonFonia&quot; &amp;&amp; tipoLineaOrdine != &quot;LineaNonFonia&quot;))&#xD;
		*/&#xD;
		//	if(!(tipoLineaOrdine == &quot;LineaNonFonia&quot; &amp;&amp; tipoLineaAsset == &quot;POTS&quot;))&#xD;
	&#xD;
&#xD;
		//RU_1515: nel caso in cui l'asset ha FlagPortato = Y, va generato un nuovo IDRisorsa (è un ex asset ULL su cui è stato effettuato il porting)&#xD;
		if(assetDati != null &amp;&amp; assetDati.flagPortato == &quot;Y&quot;)&#xD;
		{&#xD;
			IDRisorsa = null;&#xD;
			IDRisorsaNow = null;&#xD;
		}&#xD;
		//SM_8246 : modificata gestione quando tipoLineaOrdine == &quot;LineaNonFonia&quot; &amp;&amp; tipoLineaAsset==&quot;ISDN&quot; &amp;&amp; ConsistenzaDati.azione==&quot;D&quot;&#xD;
		else if((tipoLineaOrdine != &quot;LineaNonFonia&quot; &amp;&amp; tipoLineaAsset != &quot;LineaNonFonia&quot;)|| 					// se recipient e donating entrambi condivisi&#xD;
			(tipoLineaOrdine == &quot;LineaNonFonia&quot; &amp;&amp; tipoLineaAsset == &quot;LineaNonFonia&quot;)||						// se recipient e donating entrambi naked&#xD;
			(tipoLineaOrdine == &quot;LineaNonFonia&quot; &amp;&amp; tipoLineaAsset==&quot;ISDN&quot; &amp;&amp; ConsistenzaDati.azione==&quot;D&quot;))	// se recipient naked e donating condiviso su linea ISDN e azione consistenza D&#xD;
		{																									// IDRisorsa Wxx + 2&#xD;
			Process.auditLog(&quot;Calcola IDRisorsa aggiungendo 2, IDRisorsa :&quot; + ConsistenzaDati.IDRisorsa);&#xD;
			&#xD;
			var IDRisorsa_parteSinistra = ConsistenzaDati.IDRisorsa.slice(0, ConsistenzaDati.IDRisorsa.length - 2);&#xD;
			var IDRisorsa_parteDestraNun = parseInt(ConsistenzaDati.IDRisorsa.slice(ConsistenzaDati.IDRisorsa.length - 2, ConsistenzaDati.IDRisorsa.length), 10) + 2;&#xD;
			var IDRisorsa_parteDestra = &quot;&quot;;&#xD;
			&#xD;
			IDRisorsa_parteDestra = null;&#xD;
			&#xD;
			if(IDRisorsa_parteDestraNun &lt; 10)&#xD;
			{&#xD;
				IDRisorsa_parteDestra = &quot;0&quot; + IDRisorsa_parteDestraNun;&#xD;
			}&#xD;
			else if(IDRisorsa_parteDestraNun &lt; 100)&#xD;
			{&#xD;
				IDRisorsa_parteDestra = &quot;&quot; + IDRisorsa_parteDestraNun;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				//Valore 100 superato&#xD;
				Process.auditLog(&quot;Il contatore per la generazione dell'IDRisorsa ha superato 99.&quot;);&#xD;
			}&#xD;
			IDRisorsa = IDRisorsa_parteSinistra+IDRisorsa_parteDestra;&#xD;
			IDRisorsaNow = IDRisorsa_parteSinistra+IDRisorsa_parteDestra;&#xD;
		}&#xD;
		else if((tipoLineaOrdine == &quot;LineaNonFonia&quot; &amp;&amp; tipoLineaAsset == &quot;POTS&quot;) 							   // se recipient naked e donating POTS&#xD;
			  ||(tipoLineaOrdine == &quot;LineaNonFonia&quot; &amp;&amp; tipoLineaAsset==&quot;ISDN&quot; &amp;&amp; ConsistenzaDati.azione==&quot;T&quot;)) // se recipient naked e donating condiviso su linea ISDN e azione consistenza T&#xD;
		{ 																									   // Genera nuova risorsa&#xD;
			IDRisorsa = null;&#xD;
			IDRisorsaNow = null;&#xD;
		}	&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
if(IDRisorsa != null)&#xD;
{&#xD;
	localRequest.IDRisorsa = IDRisorsa;&#xD;
	localRequest.ordine.IDRisorsa = IDRisorsa;&#xD;
	localRequest.ordine.IDRisorsaNOW = IDRisorsaNow;&#xD;
	Process.auditLog(&quot;IDRIsorsa non rigenerato: &quot; + IDRisorsa);&#xD;
	Process.auditLog(&quot;IDRIsorsaNOW non rigenerato: &quot; + IDRisorsaNow);&#xD;
	GeneraNuovoIDRisorsa = false;&#xD;
}&#xD;
else&#xD;
{&#xD;
	GeneraNuovoIDRisorsa = true;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="101.0" LaneId="_ze5qceLeEeaWYbcGUPwBjw" Width="122.0">
