        <xpdl2:Activity Id="_XzlJAOVGEeaAR8AxHp6uag" Name="CalcolaEsito" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola Esito">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;EsitoVerificaTIM:&quot;+EsitoVerificaTIM+&quot;,EsitoSessioneDati:&quot;+EsitoSessioneDati+&quot;,EsitoSessioneFonia:&quot;+EsitoSessioneFonia);&#xD;
&#xD;
if(EsitoVerificaTIM ==&quot;0&quot; &amp;&amp; ControlloFallito== null)&#xD;
{&#xD;
	if(EsitoSessioneDati == &quot;OK&quot; &#xD;
		&amp;&amp; EsitoSessioneFonia== &quot;OK&quot;)&#xD;
	{&#xD;
	&#xD;
		EsitoFase2 = &quot;OK&quot;;&#xD;
	}&#xD;
	else{&#xD;
		EsitoFase2 = &quot;KO&quot;;&#xD;
	}&#xD;
}&#xD;
//SM_7947 EVO C10 Condizione per RIENTRI in TI e DONATING FONIA TLC ignora la risposta da DBCFX&#xD;
else if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIENTROINTI &amp;&amp; CODIFICAOLOAGCOMDONATINGConsistenzaFonia == &quot;TLC&quot;)&#xD;
{&#xD;
	if(EsitoSessioneDati == &quot;OK&quot; &#xD;
		&amp;&amp; EsitoSessioneFonia== &quot;OK&quot;)&#xD;
	{&#xD;
	&#xD;
		EsitoFase2 = &quot;OK&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoFase2 = &quot;KO&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{	&#xD;
	EsitoFase2 = &quot;KO&quot;;&#xD;
}&#xD;
&#xD;
&#xD;
// RU_897: in caso di MIGRAZIONE OLO2OLO e CAMBIOTECNOLOGIA consisderare solo output di verificaFase2 per l'esito, niente verifica fase 2 donating&#xD;
if(localRequest.cambioTecnologia == 'S' &#xD;
&amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO)&#xD;
{&#xD;
	if(EsitoVerificaTIM == &quot;0&quot; &amp;&amp; ControlloFallito == null)&#xD;
	{&#xD;
		EsitoFase2 = &quot;OK&quot;;&#xD;
	}&#xD;
	else&#xD;
	{	&#xD;
		EsitoFase2 = &quot;KO&quot;;&#xD;
	}&#xD;
	&#xD;
	Process.auditLog(&quot;Cambio Tecnologia: &quot;+localRequest.cambioTecnologia+&quot;, sottolav: &quot;+localRequest.ordine.tipologiaSottolav+&quot;, EsitoFase2: &quot;+EsitoFase2);&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_bOUmMuMEEeaVydgbBK3EXw" Width="119.0">
              <xpdl2:Coordinates XCoordinate="3127.0" YCoordinate="474.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
