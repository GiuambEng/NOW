        <xpdl2:DataField Id="_lxf1AFs1EfGP4M8EkdiGjg" xpdExt:DisplayName="IDAnagCausDonating" Name="IDAnagCausDonating" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="INTEGER">
              <xpdl2:Precision>9</xpdl2:Precision>
