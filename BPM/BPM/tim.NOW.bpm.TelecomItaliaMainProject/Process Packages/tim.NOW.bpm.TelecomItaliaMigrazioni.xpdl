          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(localRequestTemp.IDNotifica != null)&#xD;
{&#xD;
	localRequest.IDNotifica = localRequestTemp.IDNotifica;&#xD;
}&#xD;
&#xD;
if(localRequestTemp.IDNotificaDonating != null)&#xD;
{&#xD;
	localRequest.IDNotificaDonating = localRequestTemp.IDNotificaDonating;&#xD;
}&#xD;
&#xD;
if(localRequestTemp.IDNotificaDonor != null)&#xD;
{&#xD;
