            <xpdl2:Activity Id="_BBJVYOV6EeadE7r7ut65Og" Name="CalcolaCODIFICAOLOAGCOMNP" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola CODIFICAOLOAGCOMNP">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">CODIFICAOLOAGCOMNP = null;&#xD;
var compTemp = ComponenteNP.get(Process.getActivityLoopIndex());&#xD;
var i=0;&#xD;
while(CODIFICAOLOAGCOMNP==null &amp;&amp; i&lt;compTemp.attributiDettaglioOrdine.size()){&#xD;
	var attr = compTemp.attributiDettaglioOrdine.get(i);&#xD;
	if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR){&#xD;
		CODIFICAOLOAGCOMNP= attr.valoreAttributo;&#xD;
	}&#xD;
	i++;&#xD;
}</xpdl2:Script>
                  </xpdl2:TaskScript>
                </xpdl2:Task>
              </xpdl2:Implementation>
