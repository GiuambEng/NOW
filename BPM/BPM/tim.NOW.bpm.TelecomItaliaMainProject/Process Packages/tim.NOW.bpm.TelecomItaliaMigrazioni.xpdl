          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_TiXYQOl0EeabDOcEQPWpDw" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdExt:OutputMappings MapperContext="SubProcessToProcess" MappingDirection="OUT">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="SubProcessToProcess.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="endDateTime">
                    <xpdl2:Actual ScriptGrammar="JavaScript">endDateTime</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:OutputMappings>
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="duration">
                  <xpdExt:ScriptInformation Id="_t3joI2FpEfCEGoVXuCO0jw" Name="duration"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;P&quot; + (daysTimeout - 1) + &quot;DT23H59M&quot;;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="startDateTime">
                  <xpdExt:ScriptInformation Id="_t3joJGFpEfCEGoVXuCO0jw" Name="startDateTime"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">DateTimeUtil.createDatetime(DataVerificaCodiceSessione,DateTimeUtil.createTime());</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
