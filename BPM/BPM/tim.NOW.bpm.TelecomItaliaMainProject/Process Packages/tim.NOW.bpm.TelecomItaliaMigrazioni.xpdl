        <xpdl2:Activity Id="_oBIxNeoyEeaGjLZQtIXuJw" Name="CreateCaseOrder" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Create CaseOrder">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;Richiesta&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="FlagAggiornaContatori">
                  <xpdExt:ScriptInformation Id="_oBIxNuoyEeaGjLZQtIXuJw" Name="Script1">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">true;</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="80.0" LaneId="_06IWVuoFEeaw07IKCJjMIw" Width="128.0">
              <xpdl2:Coordinates XCoordinate="3185.0" YCoordinate="808.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
&#xD;
localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACQUISITO;&#xD;
localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ACQUISITO;&#xD;
&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
localRequest.ordine.created = date;&#xD;
localRequest.ordine.lastUpdate = date;&#xD;
&#xD;
var foundCodeVlanSingleTag = false;&#xD;
var foundSvlanCode = false;&#xD;
var indexCodeVlanSingleTag = 0;&#xD;
var indexSvlanCode = 0;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	foundCodeVlanSingleTag = false;&#xD;
	foundSvlanCode = false;&#xD;
	indexCodeVlanSingleTag = null;&#xD;
	indexSvlanCode = null;&#xD;
	&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
			{&#xD;
				indexCodeVlanSingleTag = j;&#xD;
				foundCodeVlanSingleTag = true;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
			{&#xD;
				indexSvlanCode = j;&#xD;
				foundSvlanCode = true;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(foundCodeVlanSingleTag)&#xD;
		{&#xD;
			if(foundSvlanCode)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexSvlanCode).valoreAttributo = localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexCodeVlanSingleTag).valoreAttributo;&#xD;
				localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.remove(indexCodeVlanSingleTag);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexCodeVlanSingleTag).nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//SM_9404: per alcune VARIAZIONI, nel momento in cui chiamiamo DETERMINACLUSTER non abbiamo ancora l'accesso, quindi di perderemmo l'arricchimento di TIPOLOGIACLUSTERCOMUNE&#xD;
// Per quelle variazioni, rimediamo in questo script, facendosci uscire il valore TIPOLOGIACLUSTERCOMUNE e arricchendolo subito prima della scrittura su BDS come ACQUISITO&#xD;
//verifico se DeterminaCluster ha restituito tipologia cluster&#xD;
var foundTipologiaCluster = false;&#xD;
&#xD;
if (TipologiaClusterComune != null &amp;&amp; TipologiaClusterComune != &quot;&quot;)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			//se già presente nell'ordine lo sovrascrivo&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var x = 0;&#xD;
				while(!foundTipologiaCluster &amp;&amp; x &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(x);&#xD;
					if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE)&#xD;
					{&#xD;
						foundTipologiaCluster = true;&#xD;
						currentAttributo.valoreAttributo = TipologiaClusterComune;&#xD;
					}&#xD;
				x++;&#xD;
				}&#xD;
				// se non presente nell'ordine lo aggiungo&#xD;
				if(!foundTipologiaCluster)&#xD;
				{&#xD;
					var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
					nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
					nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
					nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE;&#xD;
					nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					nuovoAttributo.valoreAttributo = TipologiaClusterComune;&#xD;
					nuovoAttributo.operatore = localRequest.operatore;&#xD;
					currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
					Process.auditLog(&quot;Aggiunto TIPOLOGIACLUSTERCOMUNE post controllo&quot;);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
