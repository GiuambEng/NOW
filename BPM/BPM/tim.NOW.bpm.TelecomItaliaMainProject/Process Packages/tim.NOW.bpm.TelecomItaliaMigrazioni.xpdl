        <xpdl2:Activity Id="_aYS2tlTSEeeS7Nn2-lxQJg" Name="AggiornaNUMBERPORTABILITYAGGIUNTIVO" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna NUMBER PORTABILITY/AGGIUNTIVO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var data = DateTimeUtil.createDatetime();&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	//attributo.IDDettaglioOrdine&#xD;
	attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	attributo.created = data;&#xD;
	attributo.lastUpdate = data;&#xD;
	//attributo.nomeAttributo &#xD;
	attributo.operatore = localRequest.operatore;&#xD;
	//attributo.tipologiaDato&#xD;
	//attributo.valoreAttributo&#xD;
	&#xD;
	if(DatiDiogene != null)&#xD;
	{&#xD;
		Process.auditLog(&quot;DatiDiogene.codificaOloAgicomDonor: &quot; + DatiDiogene.codificaOloAgicomDonor + &quot;, DatiDiogene.flagDnDonorOlo: &quot; + DatiDiogene.flagDnDonorOlo + &quot;, DatiDiogene.invioaDtu: &quot; + DatiDiogene.invioaDtu);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;DatiDiogene null.&quot;);&#xD;
	}&#xD;
&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			var CODICEOPERATOREDONORTrovato = false;&#xD;
			var FLAGDNDONOROLOTrovato = false;&#xD;
			var INVIOADTUTrovato = false;&#xD;
			var j = 0;&#xD;
			while(j &lt; componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(i);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONOR)&#xD;
				{&#xD;
					if(DatiDiogene != null &amp;&amp; DatiDiogene.codificaOloAgicomDonor != null &amp;&amp; DatiDiogene.codificaOloAgicomDonor != &quot;&quot;)&#xD;
					{&#xD;
						attr.valoreAttributo = DatiDiogene.codificaOloAgicomDonor;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						attr.valoreAttributo = &quot;TLC&quot;;&#xD;
					}&#xD;
					CODICEOPERATOREDONORTrovato = true;&#xD;
					attr.lastUpdate = data;&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGDNDONOROLO)&#xD;
				{&#xD;
					if(DatiDiogene != null &amp;&amp; DatiDiogene.flagDnDonorOlo != null &amp;&amp; DatiDiogene.flagDnDonorOlo != &quot;&quot;)&#xD;
					{&#xD;
						attr.valoreAttributo = DatiDiogene.flagDnDonorOlo;&#xD;
						attr.lastUpdate = data;&#xD;
					}&#xD;
					&#xD;
					FLAGDNDONOROLOTrovato = true;&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU)&#xD;
				{&#xD;
					if(DatiDiogene != null &amp;&amp; DatiDiogene.invioaDtu != null &amp;&amp; DatiDiogene.invioaDtu != &quot;&quot;)&#xD;
					{&#xD;
						attr.valoreAttributo = DatiDiogene.invioaDtu;&#xD;
						attr.lastUpdate = data;&#xD;
					}&#xD;
					&#xD;
					INVIOADTUTrovato = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			if(!CODICEOPERATOREDONORTrovato)&#xD;
			{&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONOR;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				if(DatiDiogene != null &amp;&amp; DatiDiogene.codificaOloAgicomDonor != null &amp;&amp; DatiDiogene.codificaOloAgicomDonor != &quot;&quot;)&#xD;
				{&#xD;
					attributo.valoreAttributo = DatiDiogene.codificaOloAgicomDonor;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					attributo.valoreAttributo = &quot;TLC&quot;;&#xD;
				}&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			if(!INVIOADTUTrovato &amp;&amp; DatiDiogene != null &amp;&amp; DatiDiogene.invioaDtu != null &amp;&amp; DatiDiogene.invioaDtu != &quot;&quot;)&#xD;
			{&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				attributo.valoreAttributo = DatiDiogene.invioaDtu;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			if(!FLAGDNDONOROLOTrovato &amp;&amp; DatiDiogene != null &amp;&amp; DatiDiogene.flagDnDonorOlo != null &amp;&amp; DatiDiogene.flagDnDonorOlo != &quot;&quot;)&#xD;
			{&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGDNDONOROLO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = DatiDiogene.flagDnDonorOlo;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		else if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var CODICEOPERATOREDONORTrovato = false;&#xD;
			var j = 0;&#xD;
			while( j &lt; componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(i);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR)&#xD;
				{&#xD;
					if(DatiDiogene != null &amp;&amp; DatiDiogene.codificaOloAgicomDonor != null &amp;&amp; DatiDiogene.codificaOloAgicomDonor != &quot;&quot;)&#xD;
