            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.calcDeadline&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">Process.auditLog(&quot;Data restituita: &quot; + String(endDateTime));&#xD;
&#xD;
timeout = DateTimeUtil.createDate(endDateTime);&#xD;
TimeValue = DateTimeUtil.createTime(endDateTime);</xpdExt:Information>
