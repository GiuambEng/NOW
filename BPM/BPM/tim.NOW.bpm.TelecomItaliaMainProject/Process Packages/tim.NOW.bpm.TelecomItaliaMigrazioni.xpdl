        <xpdl2:Activity Id="_ufCZMOMVEeaseLaiS2akPg" Name="CalcolaOLOpernotifiche" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola OLO per notifiche">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var ListaDonating = DataUtil.createList();&#xD;
var ListaDonor = DataUtil.createList();&#xD;
&#xD;
//Richiedente&#xD;
ListaDonating.add(localRequest.codificaOLOAGCOMDonating);&#xD;
&#xD;
//consistenza fonia&#xD;
if(eseguireNotificaPerConsFonia != null &amp;&amp; eseguireNotificaPerConsFonia == true){&#xD;
	if(!ListaDonating.contains(CODIFICAOLOAGCOMDONATINGConsistenzaFonia)){&#xD;
		eseguireNotificaPerConsFonia = true;&#xD;
		ListaDonating.add(CODIFICAOLOAGCOMDONATINGConsistenzaFonia);&#xD;
	}&#xD;
	else{&#xD;
		Process.auditLog(&quot;Consistenza Fonia - Notifica ad OLO &quot;+CODIFICAOLOAGCOMDONATINGConsistenzaFonia+&quot; prevista per altre casistiche&quot;);&#xD;
		eseguireNotificaPerConsFonia= false;&#xD;
	}&#xD;
}else{&#xD;
	eseguireNotificaPerConsFonia=false;&#xD;
}&#xD;
&#xD;
//Consistenza dati&#xD;
if(eseguireNotificaPerConsDati != null &amp;&amp; eseguireNotificaPerConsDati == true){&#xD;
	if(!ListaDonating.contains(CODIFICAOLOAGCOMDONATINGConsistenzaDati)){&#xD;
		eseguireNotificaPerConsDati = true;&#xD;
		ListaDonating.add(CODIFICAOLOAGCOMDONATINGConsistenzaDati);&#xD;
	}&#xD;
	else{&#xD;
		Process.auditLog(&quot;Consistenza Dati - Notifica ad OLO &quot;+CODIFICAOLOAGCOMDONATINGConsistenzaDati+&quot; prevista per altre casistiche&quot;);&#xD;
		eseguireNotificaPerConsDati= false;&#xD;
	}&#xD;
}else{&#xD;
	eseguireNotificaPerConsDati=false;&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
if(localRequest.ordine != null){&#xD;
	var i=0;&#xD;
	&#xD;
	while(i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
			var trovato = false;&#xD;
			var daInviare = false;&#xD;
			var j=0;&#xD;
			var CODIFICAOLOAGCOMDONOR = &quot;&quot;;&#xD;
			while(!trovato &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONOR){&#xD;
					trovato = true;&#xD;
					if(!ListaDonor.contains(attr.valoreAttributo) &amp;&amp; attr.valoreAttributo != &quot;TLC&quot;){&#xD;
						daInviare=true;&#xD;
						CODIFICAOLOAGCOMDONOR = attr.valoreAttributo;&#xD;
						ListaDonor.add(attr.valoreAttributo);&#xD;
					}&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(daInviare){&#xD;
				//da attivare dopo aver individuato la logica corretta per invio di notifiche a DONOR con tutte le numerazioni coinvolte&#xD;
				//ComponenteNP.add(ScriptUtil.copy(comp));&#xD;
			}&#xD;
			if(trovato &amp;&amp; !daInviare){&#xD;
				Process.auditLog(&quot;Componente NUMBERPORTABILITY - Notifica ad OLO &quot;+CODIFICAOLOAGCOMDONOR+&quot; prevista per altre casistiche&quot;);&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
//Calcolo della tipologia di Notifica in caso di KO della Fase2TIM in relazione alla struttura del destinatario SM_5643&#xD;
if(TipoNotifica == &quot;KO&quot;)&#xD;
{&#xD;
	//RECIPIENT&#xD;
	if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
	{&#xD;
		TipologiaNotificaRecipient = &quot;KC&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		TipologiaNotificaRecipient = &quot;KO&quot;;&#xD;
	}&#xD;
	&#xD;
	//DONATING DATI&#xD;
	if(eseguireNotificaPerConsDati)&#xD;
	{&#xD;
		var offertaAssetDati = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(IDAssetConsistenzaDati)).readAsset().offerta;&#xD;
		&#xD;
		var offertaAssetDati3 = String(offertaAssetDati).slice(0, 3);&#xD;
		var offertaAssetDati4 = String(offertaAssetDati).slice(0, 4);&#xD;
		&#xD;
		//REGOLATORIO&#xD;
		if(offertaAssetDati3 == &quot;ULL&quot; || offertaAssetDati3 == &quot;SLU&quot; || offertaAssetDati3 == &quot;SHA&quot; || offertaAssetDati3 == &quot;WLR&quot; || offertaAssetDati4 == &quot;VULL&quot;)&#xD;
		{&#xD;
			TipologiaNotificaConsistenzaDati = &quot;KC&quot;;&#xD;
		}&#xD;
		//NON REGOLATORIO&#xD;
		else&#xD;
		{&#xD;
			TipologiaNotificaConsistenzaDati = &quot;KO&quot;;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//DONATING FONIA&#xD;
	if(eseguireNotificaPerConsFonia)&#xD;
	{&#xD;
		var offertaAssetFonia = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(IDAssetConsistenzaFonia)).readAsset().offerta;&#xD;
		&#xD;
		var offertaAssetFonia3 = String(offertaAssetFonia).slice(0, 3);&#xD;
		var offertaAssetFonia4 = String(offertaAssetFonia).slice(0, 4);&#xD;
		&#xD;
		//REGOLATORIO&#xD;
		if(offertaAssetFonia3 == &quot;ULL&quot; || offertaAssetFonia3 == &quot;SLU&quot; || offertaAssetFonia3 == &quot;SHA&quot; || offertaAssetFonia3 == &quot;WLR&quot; || offertaAssetFonia4 == &quot;VULL&quot;)&#xD;
		{&#xD;
			TipologiaNotificaConsistenzaFonia = &quot;KC&quot;;&#xD;
		}&#xD;
		//NON REGOLATORIO&#xD;
		else&#xD;
		{&#xD;
			TipologiaNotificaConsistenzaFonia = &quot;KO&quot;;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
//Altrimenti uso quella in INPUT&#xD;
else&#xD;
{&#xD;
	TipologiaNotificaRecipient = TipoNotifica;&#xD;
	TipologiaNotificaConsistenzaDati = TipoNotifica;&#xD;
	TipologiaNotificaConsistenzaFonia = TipoNotifica;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
