        <xpdl2:Activity Id="_3SdTEFhQEei-kYa-z1WVIA" Name="ValorizzazioneDN" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Valorizzazione DN">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">/*if(NumeroTelefonico!= null &amp;&amp; NumeroTelefonico!= &quot;&quot;)&#xD;
{&#xD;
	Process.auditLog(&quot;NumeroTelefonico in input = &quot;+ NumeroTelefonico);&#xD;
}&#xD;
else{*/&#xD;
	if(localRequest.numeroTelefonico!= null)&#xD;
	{&#xD;
		NumeroTelefonico = localRequest.numeroTelefonico;&#xD;
		Process.auditLog(&quot;NumeroTelefonico valorizzato con quello della richiesta &quot;+ localRequest.numeroTelefonico);&#xD;
	}&#xD;
	else{&#xD;
		var numero = &quot;&quot;;&#xD;
		numero = null;&#xD;
		var i=0;&#xD;
		while(numero!=null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(String(componente.nomeComponente).slice(0,7) ==&quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j=0;&#xD;
				while(numero!= null &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
					{&#xD;
						numero = attr.valoreAttributo;&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN){&#xD;
						numero = attr.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			&#xD;
			i++;	&#xD;
		}&#xD;
		&#xD;
		NumeroTelefonico = numero;&#xD;
		Process.auditLog(&quot;NumeroTelefonico valorizzato da attributo NUMEROTELEFONICO o DN &quot;+ numero);&#xD;
	}&#xD;
//}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
