        <xpdl2:Activity Id="_oAvtYO1YEeaMxKOnb5A-aA" Name="AggiungiSTS" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiungi STS">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(STS != null &amp;&amp; STS.size()>0)&#xD;
{&#xD;
	var data = DateTimeUtil.createDatetime();&#xD;
	for(var n =0; n&lt;STS.size(); n++)&#xD;
	{&#xD;
		var stsTemo = STS.get(n);&#xD;
		var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS;&#xD;
		componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
		componente.IDDettaglioOrdineParent = 1;&#xD;
		componente.IDDettaglioOrdineRoot = 1;&#xD;
		componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componente.IDRisorsa = localRequest.numeroTelefonico;&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
		componente.created = data;&#xD;
		componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
		componente.lastUpdate = data;&#xD;
		componente.operatore = localRequest.operatore;&#xD;
		componente.progressivo = 1;&#xD;
		&#xD;
		//CODICE&#xD;
		var attributoOrdine = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
		attributoOrdine.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
		attributoOrdine.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
		attributoOrdine.created = data;&#xD;
		attributoOrdine.lastUpdate = data;&#xD;
		attributoOrdine.operatore = componente.operatore;&#xD;
		attributoOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE;&#xD;
		attributoOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attributoOrdine.valoreAttributo = stsTemo.CODICESTS;&#xD;
		componente.attributiDettaglioOrdine.add(ScriptUtil.copy((attributoOrdine)));&#xD;
		&#xD;
		//CODICEDTU&#xD;
		attributoOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEDTU;&#xD;
		attributoOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attributoOrdine.valoreAttributo = stsTemo.CODICEDTU;&#xD;
		componente.attributiDettaglioOrdine.add(ScriptUtil.copy((attributoOrdine)));&#xD;
		&#xD;
		//DESCRIZIONE&#xD;
		attributoOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONE;&#xD;
		attributoOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attributoOrdine.valoreAttributo = stsTemo.descrizione;&#xD;
		componente.attributiDettaglioOrdine.add(ScriptUtil.copy((attributoOrdine)));&#xD;
		&#xD;
		//STATO&#xD;
		attributoOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
		attributoOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attributoOrdine.valoreAttributo = &quot;ATTIVO&quot;;&#xD;
		componente.attributiDettaglioOrdine.add(ScriptUtil.copy((attributoOrdine)));&#xD;
		&#xD;
		localRequest.ordine.dettaglioordine.add(componente);&#xD;
					&#xD;
		&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="85.0" LaneId="_7KFFsuxbEeaif7aQcfsFlQ" Width="118.0">
              <xpdl2:Coordinates XCoordinate="1532.0" YCoordinate="679.0"/>
