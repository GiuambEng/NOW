        <xpdl2:Activity Id="_6utMAH6mEeiA87KYciTnHQ" Name="DatiVerificaControlli" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Dati Verifica Controlli">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_Aa1wkMIeEeaIJ-AnJ3AotA" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="Azione">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;INSERT&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="IDRichiestaOLO">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="Operatore">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.operatore</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="LavorazioneRichiesta">
                  <xpdl2:Actual ScriptGrammar="JavaScript">LavorazioneRichiesta</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="LavorazioneRichiesta">
                  <xpdl2:Actual ScriptGrammar="JavaScript">LavorazioneRichiesta</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:Priority></xpdl2:Priority>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="91.0" LaneId="_7KFFsuxbEeaif7aQcfsFlQ" Width="147.0">
              <xpdl2:Coordinates XCoordinate="1911.0" YCoordinate="679.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.utils.xpdl.DatiVerificaControlliStorico&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
      </xpdl2:Activities>
      <xpdl2:Transitions>
        <xpdl2:Transition Id="_2TP5oexbEeaif7aQcfsFlQ" xpdExt:DisplayName="" Name="" From="_oAvtYO1YEeaMxKOnb5A-aA" To="_2TP5oOxbEeaif7aQcfsFlQ">
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.LabelAnchorPosition"/>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.StartAnchorPosition"/>
          </xpdl2:ConnectorGraphicsInfos>
        </xpdl2:Transition>
        <xpdl2:Transition Id="_cn6LAOl1EeaAPaAE_qvaEw" Name="" From="_4A5ddu07EeaslJ4119qtHA" To="_7KLMUuxbEeaif7aQcfsFlQ">
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo">
