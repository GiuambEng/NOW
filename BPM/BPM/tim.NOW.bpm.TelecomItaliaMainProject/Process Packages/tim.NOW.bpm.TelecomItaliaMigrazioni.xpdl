        <xpdl2:Activity Id="_k5208e1YEeaMxKOnb5A-aA" Name="RecuperaDettaglioSTS" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupera Dettaglio STS">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_5JLdtO-4EeaEEa7piwcrUw" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="CodiceSTS">
                  <xpdl2:Actual ScriptGrammar="JavaScript">listaCodiceSTS</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="STS">
                  <xpdl2:Actual ScriptGrammar="JavaScript">STS</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="79.0" LaneId="_7KFFsuxbEeaif7aQcfsFlQ" Width="105.0">
              <xpdl2:Coordinates XCoordinate="1354.0" YCoordinate="679.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">for(var i=0; i&lt;InventoryPrincipale.CRMWSResponse.STS.codice_STS.size(); i++){&#xD;
	listaCodiceSTS.add(InventoryPrincipale.CRMWSResponse.STS.codice_STS.get(i));&#xD;
}&#xD;
&#xD;
ProcessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.EnrichmentSTS&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
