        <xpdl2:Activity Id="_VRnFEeLhEeaWYbcGUPwBjw" Name="CalcolatipologiadiMigrazione" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola tipologia di Migrazione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;Migrazione SottoLav: &quot;+localRequest.ordine.tipologiaSottolav);&#xD;
&#xD;
//OLO2TIM&#xD;
if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIENTROINTI)&#xD;
{&#xD;
	Casistica = &quot;OLO2TIM&quot;;&#xD;
}&#xD;
&#xD;
//OLO2OLO&#xD;
if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO)&#xD;
{&#xD;
	Casistica = &quot;OLO2OLO&quot;;&#xD;
}&#xD;
&#xD;
//TIM2OLO&#xD;
if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274)&#xD;
{&#xD;
	Casistica = &quot;TIM2OLO&quot;;&#xD;
}&#xD;
&#xD;
//ACCORPAMENTO OLO - SM_8935&#xD;
if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
{&#xD;
	if(localRequest.codificaOLOAGCOM == 'TLC' &amp;&amp; localRequest.codificaOLOAGCOMDonating != null &amp;&amp; localRequest.codificaOLOAGCOMDonating != 'TLC')&#xD;
	{&#xD;
		Casistica = &quot;OLO2TIM&quot;;&#xD;
	}&#xD;
	else if(localRequest.codificaOLOAGCOM != 'TLC' &amp;&amp; localRequest.codificaOLOAGCOMDonating != null &amp;&amp; localRequest.codificaOLOAGCOMDonating == 'TLC')&#xD;
	{&#xD;
		Casistica = &quot;TIM2OLO&quot;;&#xD;
	}&#xD;
	else if(localRequest.codificaOLOAGCOM != 'TLC' &amp;&amp; localRequest.codificaOLOAGCOMDonating != null &amp;&amp; localRequest.codificaOLOAGCOMDonating != 'TLC')&#xD;
	{&#xD;
		Casistica = &quot;OLO2OLO&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Casistica: &quot;+Casistica);&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="106.0" LaneId="_ze5qceLeEeaWYbcGUPwBjw" Width="154.0">
              <xpdl2:Coordinates XCoordinate="288.0" YCoordinate="507.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
