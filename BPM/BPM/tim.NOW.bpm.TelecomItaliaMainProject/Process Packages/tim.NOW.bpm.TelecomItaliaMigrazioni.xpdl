          </xpdl2:Event>
          <xpdl2:Deadline>
            <xpdl2:DeadlineDuration ScriptGrammar="JavaScript">if(daysTimeout == null &amp;&amp; hoursTimeout == null)&#xD;
{&#xD;
	//Setto il valore di default a 1 giorno&#xD;
	daysTimeout = 1;&#xD;
}&#xD;
&#xD;
if(timeout == null)&#xD;
{&#xD;
	if(daysTimeout != null)&#xD;
	{&#xD;
		var def = 1000 * 60 * 60 * 24 * (daysTimeout);&#xD;
	}&#xD;
	else if(hoursTimeout != null)&#xD;
	{&#xD;
		var def = 1000 * 60 * 60 * (hoursTimeout);&#xD;
	}&#xD;
	timeout = DataVerificaCodiceSessione;&#xD;
	timeout.add(DateTimeUtil.createDuration(parseInt(def, 10)));&#xD;
}&#xD;
&#xD;
if(TimeValue == null || TimeValue ==&quot;&quot;)&#xD;
{&#xD;
	TimeValue=DateTimeUtil.createTime();&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Timeout : &quot;+timeout);&#xD;
Process.auditLog(&quot;TimeValue : &quot;+TimeValue);&#xD;
timeoutWithTime = DateTimeUtil.createDatetime(timeout,TimeValue);&#xD;
Process.auditLog(&quot;TimeoutWithTime : &quot;+timeoutWithTime);&#xD;
&#xD;
&#xD;
timeoutWithTime;</xpdl2:DeadlineDuration>
          </xpdl2:Deadline>
