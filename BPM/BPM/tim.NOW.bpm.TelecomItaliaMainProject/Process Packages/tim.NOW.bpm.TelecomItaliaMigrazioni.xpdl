        <xpdl2:Activity Id="_FHE4MGFpEfCEGoVXuCO0jw" Name="TimerEvent" xpdExt:Visibility="Private" xpdExt:DisplayName="Timer Event">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Target="_5rha4GFoEfCEGoVXuCO0jw" Trigger="Timer">
              <xpdl2:TriggerTimer>
                <xpdl2:TimeDate/>
              </xpdl2:TriggerTimer>
            </xpdl2:IntermediateEvent>
          </xpdl2:Event>
          <xpdl2:Deadline>
            <xpdl2:DeadlineDuration ScriptGrammar="JavaScript">if(daysTimeout == null &amp;&amp; hoursTimeout == null)&#xD;
{&#xD;
	//Setto il valore di default a 1 giorno&#xD;
	daysTimeout = 1;&#xD;
}&#xD;
&#xD;
if(timeout == null)&#xD;
{&#xD;
	if(daysTimeout != null)&#xD;
	{&#xD;
		var def = 1000 * 60 * 60 * 24 * (daysTimeout);&#xD;
	}&#xD;
	else if(hoursTimeout != null)&#xD;
	{&#xD;
		var def = 1000 * 60 * 60 * (hoursTimeout);&#xD;
	}&#xD;
	timeout = DataVerificaCodiceSessione;&#xD;
	timeout.add(DateTimeUtil.createDuration(parseInt(def, 10)));&#xD;
}&#xD;
&#xD;
if(TimeValue == null || TimeValue ==&quot;&quot;)&#xD;
{&#xD;
	TimeValue = DateTimeUtil.createTime();&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Timeout : &quot;+timeout);&#xD;
Process.auditLog(&quot;TimeValue : &quot;+TimeValue);&#xD;
timeoutWithTime = DateTimeUtil.createDatetime(timeout,TimeValue);&#xD;
Process.auditLog(&quot;TimeoutWithTime : &quot;+timeoutWithTime);&#xD;
&#xD;
&#xD;
timeoutWithTime;</xpdl2:DeadlineDuration>
          </xpdl2:Deadline>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" LaneId="_5fK6lmFgEfCEGoVXuCO0jw" Width="46.0">
              <xpdl2:Coordinates XCoordinate="0.0" YCoordinate="0.0"/>
            </xpdl2:NodeGraphicsInfo>
            <xpdl2:NodeGraphicsInfo ToolId="XPD.BorderEventPosition">
              <xpdl2:Coordinates XCoordinate="42.79661016949153" YCoordinate="0.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">EsitoRicezioneCodiceSessione = &quot;OK&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_kYcpYmFpEfCEGoVXuCO0jw" Name="Ricercaconfigurazionetimer" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Ricerca configurazione timer" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//CALCOLA TIMEOUT&#xD;
DataVerificaCodiceSessione = DateTimeUtil.createDate();&#xD;
&#xD;
var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key=:inputKey&quot;);&#xD;
criteria.setQueryParameter(&quot;inputKey&quot;,&quot;VerificaCodiceSessione_timeout_Del82&quot;);&#xD;
var configurations = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(criteria);&#xD;
&#xD;
if(configurations != null &amp;&amp; configurations.size() > 0)&#xD;
{&#xD;
	configuration = configurations.get(0).readConfiguration();&#xD;
	&#xD;
	var ConfigRecuperata = configuration.value;	&#xD;
	var confLength = ConfigRecuperata.length;	&#xD;
	Process.auditLog(&quot;Recuperata Configurazione: &quot; +ConfigRecuperata);&#xD;
	&#xD;
	daysType = ConfigRecuperata.slice(confLength - 1, confLength);&#xD;
&#xD;
	//GIORNI LAVORATIVI/SOLARI&#xD;
	if(daysType == 'W' || daysType == 'C')&#xD;
	{&#xD;
		var slicedDays = ConfigRecuperata.slice(0, confLength -1);&#xD;
&#xD;
		if(!isNaN(slicedDays))&#xD;
		{&#xD;
			daysTimeout = parseInt(slicedDays, 10);&#xD;
		}&#xD;
	}&#xD;
	else if(!isNaN(ConfigRecuperata))                          &#xD;
	{&#xD;
		hoursTimeout = parseInt(ConfigRecuperata, 10);&#xD;
	}	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="86.0" LaneId="_5fK6lmFgEfCEGoVXuCO0jw" Width="130.0">
              <xpdl2:Coordinates XCoordinate="897.0" YCoordinate="310.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
