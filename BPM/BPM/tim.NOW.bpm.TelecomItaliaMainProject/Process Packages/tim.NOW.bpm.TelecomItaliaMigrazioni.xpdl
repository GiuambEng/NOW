          <xpdl2:DataType>
            <xpdl2:BasicType Type="BOOLEAN"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
          <xpdExt:InitialValues>
            <xpdExt:Value>false</xpdExt:Value>
          </xpdExt:InitialValues>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_YlqHAF50Eey-EvfKRdCIbA" xpdExt:DisplayName="daysType" Name="daysType" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_qj2gAF52Eey-EvfKRdCIbA" xpdExt:DisplayName="daysTimeout" Name="daysTimeout" ReadOnly="false">
