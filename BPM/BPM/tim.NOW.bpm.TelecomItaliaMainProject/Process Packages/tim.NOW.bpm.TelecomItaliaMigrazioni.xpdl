      <xpdl2:Activities>
        <xpdl2:Activity Id="_bOUmNOMEEeaVydgbBK3EXw" Name="EndEvent" xpdExt:DisplayName="End Event">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_bOUmMuMEEeaVydgbBK3EXw" Width="54.0">
              <xpdl2:Coordinates XCoordinate="3997.0" YCoordinate="474.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_oYVFMOMLEeaVydgbBK3EXw" Name="RicercaConsistenzaeconfigurazioni" xpdExt:Visibility="Private" xpdExt:DisplayName="Ricerca Consistenza e configurazioni">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//gestione flagSaltaFase2TIM&#xD;
&#xD;
//RU_897: salta verifica fase 2 donating in caso di OLO2OLO e cambiotecnologia&#xD;
if((localRequest.cambioTecnologia == 'S' &#xD;
 &amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO)&#xD;
 || localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO) // SM_9100&#xD;
{&#xD;
	flagSaltaFase2OLO = true;&#xD;
}&#xD;
&#xD;
//Bug #33000&#xD;
if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
{&#xD;
	flagSaltaFase2TIM = true;&#xD;
}&#xD;
&#xD;
if(flagSaltaFase2TIM==null){&#xD;
	flagSaltaFase2TIM=false;&#xD;
}&#xD;
if(flagSaltaFase2OLO == null){&#xD;
	flagSaltaFase2OLO = false;&#xD;
}&#xD;
Process.auditLog(&quot;flagSaltaFase2TIM: &quot;+flagSaltaFase2TIM+&quot;, flagSaltaFase2OLO:&quot;+flagSaltaFase2OLO);&#xD;
&#xD;
if(localRequest.ordine != null){&#xD;
&#xD;
	var i=0;&#xD;
	&#xD;
	while((ComponenteConsistenzaDati==null || ComponenteConsistenzaFonia==null) &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		//Primo Ramo: RU_685 - SM_7843 - SF 5.81 (valorizzare componente consistenza dati, così da inviare CS in caso di...)&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI &amp;&amp; &#xD;
		   comp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.T &amp;&amp;&#xD;
				(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB ||&#xD;
				 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB) &amp;&amp;&#xD;
		   localRequest.flagNaked == 'S')&#xD;
		{&#xD;
			&#xD;
			var j=0;&#xD;
			var offerta = &quot;&quot;;&#xD;
			offerta = null;&#xD;
			&#xD;
			while(j&lt;comp.attributiDettaglioOrdine.size()){&#xD;
				var attr = 	comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING)&#xD;
				{&#xD;
					CODIFICAOLOAGCOMDONATINGConsistenzaDati = attr.valoreAttributo;&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					IDAssetConsistenzaDati = attr.valoreAttributo;&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
				{&#xD;
					offerta = attr.valoreAttributo;&#xD;
				}&#xD;
			j++;&#xD;
			}&#xD;
			&#xD;
			if(offerta != null &amp;&amp; &#xD;
				(offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICO ||&#xD;
				 offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT ||&#xD;
				 offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL))&#xD;
			{&#xD;
				ComponenteConsistenzaDati = ScriptUtil.copy(comp);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				CODIFICAOLOAGCOMDONATINGConsistenzaDati = null;&#xD;
				IDAssetConsistenzaDati = null;&#xD;
			}&#xD;
			&#xD;
		}&#xD;
		else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI &amp;&amp; comp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		{&#xD;
			ComponenteConsistenzaDati = ScriptUtil.copy(comp);&#xD;
			var j=0;&#xD;
			while(j&lt;ComponenteConsistenzaDati.attributiDettaglioOrdine.size()){&#xD;
				var attr = 	ComponenteConsistenzaDati.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING){&#xD;
					&#xD;
					CODIFICAOLOAGCOMDONATINGConsistenzaDati = attr.valoreAttributo;&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					IDAssetConsistenzaDati = attr.valoreAttributo;&#xD;
				}&#xD;
			j++;&#xD;
			}		&#xD;
		}&#xD;
		else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			var Destinazioneuso=&quot;&quot;;&#xD;
			Destinazioneuso = null;&#xD;
			var j=0;&#xD;
			while(j &lt; comp.attributiDettaglioOrdine.size()){&#xD;
				var attr = 	comp.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING){&#xD;
					CODIFICAOLOAGCOMDONATINGConsistenzaFonia = attr.valoreAttributo;&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					IDAssetConsistenzaFonia = attr.valoreAttributo;&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
				{&#xD;
					Destinazioneuso = attr.valoreAttributo;&#xD;
				}&#xD;
			j++;&#xD;
			}&#xD;
			&#xD;
			if ( comp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D || (comp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M &amp;&amp; Destinazioneuso!=null &amp;&amp; Destinazioneuso.slice(1,2)==&quot;|&quot;))&#xD;
			{&#xD;
				ComponenteConsistenzaFonia = ScriptUtil.copy(comp);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				CODIFICAOLOAGCOMDONATINGConsistenzaFonia = null;&#xD;
				IDAssetConsistenzaFonia = null;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
//Set valori iniziali&#xD;
// EsitoSessione OK-KO&#xD;
EsitoSessioneDati = &quot;OK&quot;;&#xD;
EsitoSessioneFonia = &quot;OK&quot;;&#xD;
&#xD;
// EsitoVerificaTIM  0 = (OK) || 1 = KO (codice segreto non valido) || 2 = KO (fase 2 effettuata ma scaduta)&#xD;
if(EsitoVerificaTIM == null || EsitoVerificaTIM==&quot;&quot;)&#xD;
{&#xD;
	EsitoVerificaTIM = &quot;0&quot;;&#xD;
}&#xD;
&#xD;
//CALCOLA TIMEOUT - CR596 aggiunta gestione per giorni lavorativi&#xD;
//Creazione DataVerificaCodiceSessione&#xD;
DataVerificaCodiceSessione = DateTimeUtil.createDate();&#xD;
&#xD;
var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key=:inputKey&quot;);&#xD;
criteria.setQueryParameter(&quot;inputKey&quot;,&quot;VerificaCodiceSessione_timeout&quot;);&#xD;
var configurations = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(criteria);&#xD;
&#xD;
if(configurations != null &amp;&amp; configurations.size() > 0)&#xD;
{&#xD;
	configuration = configurations.get(0).readConfiguration();&#xD;
	&#xD;
	var ConfigRecuperata = configuration.value;	&#xD;
	var confLength = ConfigRecuperata.length;	&#xD;
	Process.auditLog(&quot;Recuperata Configurazione: &quot; +ConfigRecuperata);&#xD;
	&#xD;
	daysType = ConfigRecuperata.slice(confLength - 1, confLength);&#xD;
&#xD;
	//CR596: GIORNI LAVORATIVI/SOLARI&#xD;
	if(daysType == 'W' || daysType == 'C')&#xD;
	{&#xD;
		var slicedDays = ConfigRecuperata.slice(0, confLength -1);&#xD;
&#xD;
		if(!isNaN(slicedDays))&#xD;
		{&#xD;
			daysTimeout = parseInt(slicedDays, 10);&#xD;
		}&#xD;
	}&#xD;
	//per gestire il numero di ore PRE-CR596&#xD;
	else if(!isNaN(ConfigRecuperata))                          //SM_10537: spostato l'if con NaN&#xD;
	{&#xD;
		hoursTimeout = parseInt(ConfigRecuperata, 10);&#xD;
	}	&#xD;
}&#xD;
&#xD;
&#xD;
// RU_838: Eccezione per non inviare notifica CS in ambito DATI in caso di Migrazione da VULL+BTS con unico Codice Risorsa nella Richiesta da OAO&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
&amp;&amp; (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO &#xD;
 || localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIENTROINTI)&#xD;
&amp;&amp; ComponenteConsistenzaFonia != null &#xD;
&amp;&amp; ComponenteConsistenzaDati != null&#xD;
&amp;&amp; ComponenteConsistenzaFonia.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D&#xD;
&amp;&amp; ComponenteConsistenzaDati.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D&#xD;
&amp;&amp; localRequest.codiceRisorsaDonating != null&#xD;
&amp;&amp; localRequest.codiceRisorsaDonating2 == null)&#xD;
{&#xD;
	Process.auditLog(&quot;Eccezione per non inviare notifica CS in ambito DATI - valutazione...&quot;);&#xD;
	var offertaConsistenzaFonia = &quot;&quot;;&#xD;
	offertaConsistenzaFonia = null;&#xD;
	&#xD;
	var offertaConsistenzaDati = &quot;&quot;;&#xD;
	offertaConsistenzaDati= null;	&#xD;
	&#xD;
	var j = 0;&#xD;
	&#xD;
	while(offertaConsistenzaFonia == null &amp;&amp; j &lt; ComponenteConsistenzaFonia.attributiDettaglioOrdine.size())&#xD;
	{&#xD;
		var attr = 	ComponenteConsistenzaFonia.attributiDettaglioOrdine.get(j);&#xD;
		&#xD;
		if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
		{&#xD;
			offertaConsistenzaFonia = String(attr.valoreAttributo);&#xD;
			Process.auditLog(&quot;Offerta Consistenza Fonia: &quot;+offertaConsistenzaFonia);&#xD;
		}&#xD;
		&#xD;
		j++;&#xD;
	}&#xD;
	&#xD;
	&#xD;
	j = 0;&#xD;
	&#xD;
	while(offertaConsistenzaDati == null &amp;&amp; j &lt; ComponenteConsistenzaDati.attributiDettaglioOrdine.size())&#xD;
	{&#xD;
		var attr = 	ComponenteConsistenzaDati.attributiDettaglioOrdine.get(j);&#xD;
		&#xD;
		if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
		{&#xD;
			offertaConsistenzaDati = String(attr.valoreAttributo);&#xD;
			Process.auditLog(&quot;Offerta Consistenza Dati: &quot;+offertaConsistenzaDati);&#xD;
		}&#xD;
		&#xD;
		j++;&#xD;
	}&#xD;
	&#xD;
	if(offertaConsistenzaFonia == &quot;VULL&quot; &amp;&amp; (offertaConsistenzaDati.slice(0,9) == &quot;BITSTREAM&quot; || offertaConsistenzaDati.slice(0,6) == &quot;EASYIP&quot; || offertaConsistenzaDati.slice(0,4) == &quot;VULA&quot;))&#xD;
	{&#xD;
		Eccezione = true;&#xD;
		Process.auditLog(&quot;Eccezione Confermata&quot;);&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
// RU_959 - SM_9146 - se trovo NP in modalità wholesaler devo mettermi in attesa dopo&#xD;
if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO)&#xD;
{&#xD;
	var i = 0;&#xD;
	&#xD;
	while(!NPWholesaler &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			var x = 0;&#xD;
			&#xD;
			while(!NPWholesaler &amp;&amp; x &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(x);&#xD;
				&#xD;
				if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER)&#xD;
				{&#xD;
					NPWholesaler = true;&#xD;
					Process.auditLog(&quot;Trovato NP in modalità Wholesaler, cioè OLORETAILER valorizzato&quot;);&#xD;
				}&#xD;
				&#xD;
				x++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="86.0" LaneId="_bOUmMuMEEeaVydgbBK3EXw" Width="126.0">
              <xpdl2:Coordinates XCoordinate="659.0" YCoordinate="474.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
