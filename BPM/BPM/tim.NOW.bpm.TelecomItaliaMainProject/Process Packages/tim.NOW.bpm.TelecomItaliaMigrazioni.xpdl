        <xpdl2:Activity Id="_dmfswDsPEeeaHsTZTgiz-w" Name="VerificaesistenzaDNetipomigrazione" xpdExt:DisplayName="Verifica esistenza DN e tipo migrazione">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_r4pG4OLiEeaWYbcGUPwBjw"/>
                  <xpdl2:TransitionRef Id="_CtlLsDviEeeY9NczQql8Ig"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="146.0" LaneId="_ze5qceLeEeaWYbcGUPwBjw" Width="104.0">
              <xpdl2:Coordinates XCoordinate="2769.0" YCoordinate="657.0"/>
