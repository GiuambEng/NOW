        <xpdl2:Activity Id="_vQgZAHIuEe2oK8wKjP8xaw" Name="DeterminaCasoSempliceComplesso" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Determina Caso Semplice/Complesso" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Script per determinare Caso SEMPLICE/COMPLESSO per ATTIVAZIONE NP DEL. 103&#xD;
CasoSemplice = false;&#xD;
CasoComplesso = false;&#xD;
&#xD;
//ATTIVAZIONE NP CON sottolavorazione = NORMALE oppure PORTABILITASUCCESSIVA con scenari NPSUWLR, NPSUVULL - C02M66 e C02M68&#xD;
if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE&#xD;
   || (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PORTABILITASUCCESSIVA&#xD;
       &amp;&amp; (String(localRequest.tipologiaScenario).slice(0,8) == &quot;NPSUVULL&quot;&#xD;
	       ||String(localRequest.tipologiaScenario).slice(0,7) == &quot;NPSUWLR&quot;)))&#xD;
{		&#xD;
	&#xD;
	//SM_11034: nel caso in cui entriamo in gestione Cautelare, saltiamo la chiamata ad Inventory, dunque per il calcolo di caso Semplice/Complesso vanno considerati TIPONUMERO e TIPOSERVIZIO della prima chiamata ad Inventory&#xD;
	if(localRequest.idTplgCautelare == 'Y' &amp;&amp; TIPONUMERO != null &amp;&amp; TIPONUMERO != &quot;&quot; &amp;&amp; TIPOSERVIZIO != null &amp;&amp; TIPOSERVIZIO != &quot;&quot;)&#xD;
	{&#xD;
		if(TIPOSERVIZIO == &quot;CAPOSERIE&quot;&#xD;
		   ||TIPOSERVIZIO == &quot;ISDN BMU&quot;&#xD;
		   ||TIPOSERVIZIO == &quot;LINEA PBX&quot;&#xD;
		   ||TIPONUMERO == &quot;GNR RADICALE&quot;&#xD;
		   ||TIPONUMERO == &quot;RADICALE ACCORPATO&quot;&#xD;
		   ||TIPONUMERO == &quot;RADICALE LINEE&quot;)&#xD;
		{&#xD;
			CasoComplesso = true;  &#xD;
		}&#xD;
		else &#xD;
		{&#xD;
			CasoSemplice = true;&#xD;
		}&#xD;
		Process.auditLog(&quot;TipologiaSottolav = &quot; +localRequest.tipologiaSottolav+ &quot; , TipologiaScenario = &quot; +localRequest.tipologiaScenario+ &quot; , tipoNumero = &quot; +TIPONUMERO+ &quot; , tipoServizio = &quot; +TIPOSERVIZIO);&#xD;
	}&#xD;
	//solito&#xD;
	else if(InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null &amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea != null)&#xD;
	{&#xD;
		if(InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;CAPOSERIE&quot;&#xD;
		   ||InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;ISDN BMU&quot;&#xD;
		   ||InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;LINEA PBX&quot;&#xD;
		   ||InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero == &quot;GNR RADICALE&quot;&#xD;
		   ||InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero == &quot;RADICALE ACCORPATO&quot;&#xD;
		   ||InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero == &quot;RADICALE LINEE&quot;)&#xD;
	   {&#xD;
		   CasoComplesso = true;   &#xD;
	   }&#xD;
	   else&#xD;
	   {&#xD;
		   CasoSemplice = true;&#xD;
	   }   &#xD;
	   Process.auditLog(&quot;TipologiaSottolav = &quot; +localRequest.tipologiaSottolav+ &quot; , TipologiaScenario = &quot; +localRequest.tipologiaScenario+ &quot; , tipoNumero = &quot; +InventoryOutput.datiUnica.tipoNumero+ &quot; , tipoServizio = &quot; +InventoryOutput.datiUnica.tipoServizio);&#xD;
	}	&#xD;
}&#xD;
//RU_1392: commentato NPSUNP poichè con questa RU non è sempre caso semplice, ma dipende da TIPOLINEA&#xD;
//ATTIVAZIONE NP CON sottolavorazione = PORTABILITASUCCESSIVA con scenario NPSUNP - C02M67&#xD;
/*else if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PORTABILITASUCCESSIVA&#xD;
       &amp;&amp; localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP)&#xD;
{	&#xD;
	CasoSemplice = true;&#xD;
	Process.auditLog(&quot;TipologiaSottolav = &quot; +localRequest.tipologiaSottolav+ &quot; , TipologiaScenario = &quot; +localRequest.tipologiaScenario+ &quot; , quindi siamo sempre nel caso Semplice&quot;);&#xD;
}*/&#xD;
//ATTIVAZIONE NP CON sottolavorazione = DONOROLO con scenario NPSUNP - C02M69&#xD;
else if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DONOROLO&#xD;
        || (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PORTABILITASUCCESSIVA   //RU_1392&#xD;
            &amp;&amp; localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP))&#xD;
{	&#xD;
	if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
	{&#xD;
		var TipoLineaOLO = &quot;&quot;;&#xD;
		TipoLineaOLO = null;&#xD;
		&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					//RU_1392: usato TIPOLINEAOLO invece di TIPOLINEANP&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAOLO)     &#xD;
					{&#xD;
						TipoLineaOLO = attributo.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
					}&#xD;
				}&#xD;
			}	&#xD;
		}&#xD;
&#xD;
		if(TipoLineaOLO == &quot;1&quot;)&#xD;
		{&#xD;
			CasoComplesso = true; &#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			CasoSemplice = true;&#xD;
		}	&#xD;
		Process.auditLog(&quot;TipologiaSottolav = &quot; +localRequest.tipologiaSottolav+ &quot; , TipologiaScenario = &quot; +localRequest.tipologiaScenario+ &quot; , tipoLinea = &quot; +TipoLineaOLO);		&#xD;
	}	&#xD;
}&#xD;
else &#xD;
{&#xD;
	Process.auditLog(&quot;Non rientriamo in alcuna casistica per determinare caso Semplice/Complesso&quot;);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="83.0" LaneId="_Q_PNMXIeEe2oK8wKjP8xaw" Width="142.0">
              <xpdl2:Coordinates XCoordinate="4761.0" YCoordinate="752.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_qrEiInIyEe2oK8wKjP8xaw">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_rEXy8HIyEe2oK8wKjP8xaw"/>
                  <xpdl2:TransitionRef Id="_WBtcAHIzEe2oK8wKjP8xaw"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="45.0" LaneId="_Q_PNMXIeEe2oK8wKjP8xaw" Width="43.0">
              <xpdl2:Coordinates XCoordinate="3121.0" YCoordinate="900.0"/>
