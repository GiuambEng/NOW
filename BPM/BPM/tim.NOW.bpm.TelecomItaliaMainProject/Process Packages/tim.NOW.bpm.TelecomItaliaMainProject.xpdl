        <xpdl2:Activity Id="_mHVXUJtPEeqx6_acRk-1Yg" Name="ThrowGlobalRicezioneSbloccoB2BFastData" xpdExt:Visibility="Private" xpdExt:DisplayName="Throw Global: RicezioneSbloccoB2BFastData">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Trigger="Signal">
              <xpdl2:TriggerResultSignal xpdExt:SignalType="Global" CatchThrow="THROW" Name="tim.now.bpm.signals/timNOWbpmsignals.gsd#RicezioneSbloccoB2BFastData">
                <xpdExt:SignalData>
                  <xpdExt:CorrelationMappings>
                    <xpdExt:DataMapping Direction="IN" Formal="Correlation_IDRichiestaOLO">
                      <xpdExt:ScriptInformation Id="_KfmMAJtfEeqx6_acRk-1Yg" Name="IDRichiestaOLO"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">TargetRequest.IDRichiestaOLO;</xpdl2:Actual>
                    </xpdExt:DataMapping>
                  </xpdExt:CorrelationMappings>
                  <xpdExt:DataMappings>
                    <xpdExt:DataMapping Direction="IN" Formal="StatoRichiestaNOW">
                      <xpdExt:ScriptInformation Id="_NkFQsJtfEeqx6_acRk-1Yg" Name="StatoRichiestaNOW"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ESECUZIONE)&#xD;
{&#xD;
	&quot;INVIATOADELIVERYB2B&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;ANNULLATOB2B&quot;;&#xD;
}</xpdl2:Actual>
                    </xpdExt:DataMapping>
                  </xpdExt:DataMappings>
                </xpdExt:SignalData>
                <xpdl2:Properties/>
              </xpdl2:TriggerResultSignal>
