        <xpdl2:Transition Id="_oR2YICAXEeuKnO8QpgAeaA" xpdExt:DisplayName="" Name="" From="_WsFbUiAXEeuKnO8QpgAeaA" To="_jSxPACAXEeuKnO8QpgAeaA">
          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">CodiceCausaleDesospensione != null &amp;&amp; CodiceCausaleDesospensione != &quot;&quot;;</xpdl2:Expression></xpdl2:Condition>
