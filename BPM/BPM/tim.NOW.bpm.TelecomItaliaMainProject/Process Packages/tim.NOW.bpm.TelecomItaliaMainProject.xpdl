            <xpdl2:Activity Id="_IGFDULreEeayMYHkhkINIw" Name="CalcolaFlagEseguiNotificaAnnullamento" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola FlagEseguiNotificaAnnullamento">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">FlagEseguiNotificaAnnullamento = true;&#xD;
&#xD;
if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG)&#xD;
{&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE){&#xD;
		FlagEseguiNotificaAnnullamento = false;&#xD;
	}&#xD;
	else if(  !(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &#xD;
				&amp;&amp; (localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP&#xD;
					|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUULLNP&#xD;
					|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUULLDNP&#xD;
					|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUSLUNP&#xD;
					|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUWLR&#xD;
					|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUVULL //SM_9729: aggiunto NPSUVULL&#xD;
					|| (localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PRENOTIFICADONATING&#xD;
						|| localRequest.codificaOLOAGCOMDonating != &quot;TLC&quot;)&#xD;
					|| ((String(localRequest.tipologiaScenario).slice(0,7) == &quot;NPSUTIF&quot;    //SM_11176&#xD;
						|| localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUBTS)	&#xD;
						&amp;&amp; localRequest.flagDelibera103 == 'Y') //SM_10867&#xD;
					)&#xD;
				&amp;&amp; (localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVERIFICADONATING &#xD;
					||localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVERIFICHETECNICHE    //SM_10774&#xD;
					||(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.LAVORAZIONEHD &#xD;
						&amp;&amp; localRequest.statoRichiestaPrecedNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVERIFICHETECNICHE)&#xD;
					)&#xD;
				)&#xD;
			)&#xD;
	{&#xD;
		FlagEseguiNotificaAnnullamento = false;&#xD;
	}&#xD;
}</xpdl2:Script>
                  </xpdl2:TaskScript>
                </xpdl2:Task>
              </xpdl2:Implementation>
