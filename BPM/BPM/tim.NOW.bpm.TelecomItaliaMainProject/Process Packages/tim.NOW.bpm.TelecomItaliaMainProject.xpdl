	Process.auditLog(&quot;Valorizzata Fascia Oraria UA dell'ordine target con &quot;+parseInt(localRequest.IDFasciaOraria));&#xD;
}&#xD;
	&#xD;
if(localRequest.ordine!= null &amp;&amp; localRequest.ordine.DADRimodulata != null &amp;&amp; localRequest.ordine.DADRimodulata != &quot;&quot;)&#xD;
{&#xD;
	ExistingOrder.ordine.DUA = localRequest.ordine.DADRimodulata;&#xD;
	Process.auditLog(&quot;Valorizzata DUA dell'ordine target con &quot;+String(localRequest.ordine.DADRimodulata));&#xD;
}&#xD;
else &#xD;
{&#xD;
	ExistingOrder.ordine.DUA = localRequest.DAD;&#xD;
	Process.auditLog(&quot;Valorizzata DUA dell'ordine target con &quot;+String(localRequest.DAD));&#xD;
}&#xD;
&#xD;
if(localRequest.DAD != null)&#xD;
{&#xD;
	ExistingOrder.ordine.DADRimodulata = localRequest.DAD;&#xD;
	Process.auditLog(&quot;Valorizzata DADRimodulata dell'ordine target con &quot;+String(localRequest.DAD));&#xD;
}&#xD;
</xpdExt:Information>
