            <xpdl2:Activity Id="_NPgsECKgEeaT5Zkofg-o8Q" Name="InviaNotificaKOversoOLO" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Invia Notifica KO verso OLO">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_v3JtkIFrEeaG-Y7D3-yA8Q" PackageRef="tim.NOW.bpm.invokeExternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="TipologiaNotifica">
                      <xpdExt:ScriptInformation Id="_dxHRoC7fEeavOKiCbjk-zw" Name="KO"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">//RU_1346: inserito if per DEL 103&#xD;
if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
   &amp;&amp; localRequest.flagDelibera103 == &quot;Y&quot;)&#xD;
{&#xD;
	&quot;TC18&quot;;&#xD;
}&#xD;
else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG)&#xD;
{&#xD;
	&quot;TC11&quot;;&#xD;
}&#xD;
else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL || &#xD;
		localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)  //Segnalazione MLP 02/05/2019&#xD;
{&#xD;
	&quot;KO&quot;; // Solo Dati&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;KC&quot;; // SM_8452 - modificato da KO a KC (da Acquisizione KO a Accettato KO) &#xD;
}</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="tipologiaOLODestinatario">
                      <xpdExt:ScriptInformation Id="_luVloC_iEeeEHNoXfpWZUQ" Name="Script1">
                        <xpdExt:Expression ScriptGrammar="JavaScript"/>
                      </xpdExt:ScriptInformation>
                      <xpdl2:Actual ScriptGrammar="JavaScript">if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG)&#xD;
{&#xD;
	&quot;DONATING&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;RECIPIENT&quot;;&#xD;
}</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
