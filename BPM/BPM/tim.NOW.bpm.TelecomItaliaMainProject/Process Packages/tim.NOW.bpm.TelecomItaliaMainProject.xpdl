        <xpdl2:Activity Id="_S8Ow7QchEeausamuxOzEJA" Name="CreateCaseREQUESTRECEIVEDforRequestActivation" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Create Case REQUEST &quot;RECEIVED&quot; for Request Activation">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_BdsCIPpDEeWhLceLewjJYA" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="OUT" Formal="RequestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRefActivation</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="pvm">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
