            <xpdl2:Activity Id="_doCJMBXoEeaom4r-1ZSjhQ" Name="UpdateDACRimodulata" FinishMode="Automatic" IsATransaction="false" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Update DAC Rimodulata" xpdExt:RequireNewTransaction="false">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="requestRef">
                      <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                      <xpdl2:Actual ScriptGrammar="JavaScript">&quot;Richiesta&quot;</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="OUT" Formal="requestRef">
                      <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="87.0" Width="110.0">
                  <xpdl2:Coordinates XCoordinate="1197.0" YCoordinate="69.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Initiated">
                  <xpdExt:Information ScriptGrammar="JavaScript">var tmp = RequestRef.readRichiesta();&#xD;
&#xD;
if(tmp.ordine == null) //SM_8660: aggiunta valorizzazione ordine, altirmenti si spacca l'update della DACRidomulata&#xD;
{&#xD;
	tmp.ordine = ScriptUtil.copy(localRequest.ordine);&#xD;
}&#xD;
&#xD;
localRequest = ScriptUtil.copy(tmp);&#xD;
&#xD;
localRequest.IDAnagraficaCausale = IDAnagraficaTemp;&#xD;
localRequest.ordine.DACRimodulata = DACRimodulata;&#xD;
&#xD;
//Bug #37894&#xD;
UpdateRDAC = DACRimodulata;&#xD;
UpdateIDAnagCaus = IDAnagraficaTemp;&#xD;
&#xD;
Process.auditLog(&quot;DACRimodulata: &quot;+String(localRequest.ordine.DACRimodulata));</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_pFC78D6hEeaA3Ie5-HTmGg" Name="UpdateRequestRefandlocalRequestfromDB" xpdExt:Visibility="Private" xpdExt:DisplayName="Update RequestRef and localRequest from DB">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">RequestRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByIDRichiestaOLO(localRequest.IDRichiestaOLO);&#xD;
&#xD;
var tmp = RequestRef.readRichiesta();&#xD;
&#xD;
if(tmp.ordine == null)&#xD;
{&#xD;
	tmp.ordine = ScriptUtil.copy(localRequest.ordine);&#xD;
}&#xD;
&#xD;
localRequest = ScriptUtil.copy(tmp);&#xD;
FlagRDAAutomaticaEseguita = true;</xpdl2:Script>
                  </xpdl2:TaskScript>
                </xpdl2:Task>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="101.0" Width="133.0">
                  <xpdl2:Coordinates XCoordinate="512.0" YCoordinate="70.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:ActivityResourcePatterns>
                <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
              </xpdExt:ActivityResourcePatterns>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_Wn1CIIuiEea6Hs4N8ixhVg" Name="CalcRDACasDAC1workingday" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Calc RDAC as DAC + 1 working day">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_76gV0IufEea6Hs4N8ixhVg" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="GiorniLavorativi">
                      <xpdExt:ScriptInformation Id="_bEuEMIuiEea6Hs4N8ixhVg" Name="giorniLavorativi"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">ScadenzaDACAggiunta;</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="ManagedDate">
                      <xpdExt:ScriptInformation Id="_HmaVsObZEeaSiYHa_-Fa3Q" Name="DAC">
                        <xpdExt:Expression ScriptGrammar="JavaScript"/>
                      </xpdExt:ScriptInformation>
                      <xpdl2:Actual ScriptGrammar="JavaScript">var RDACdate = DateTimeUtil.createDate();&#xD;
RDACdate = null;&#xD;
&#xD;
if(localRequest.ordine.DACRimodulata!= null){&#xD;
	RDACdate =localRequest.ordine.DACRimodulata;&#xD;
}&#xD;
else{&#xD;
	RDACdate = localRequest.ordine.DAC;&#xD;
}&#xD;
&#xD;
RDACdate;</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="OUT" Formal="ManagedDate">
                      <xpdl2:Actual ScriptGrammar="JavaScript">DACRimodulata</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="85.0" Width="127.0">
                  <xpdl2:Coordinates XCoordinate="699.0" YCoordinate="70.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Initiated">
                  <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier =&quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.calcNextDateByDuration&quot;;</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_9zUUdcK8EeaJAM4jywMkjA" Name="NotoficationManagementOK" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Notofication Management OK">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_l-ElkAOpEeaIdPdRimpTnw" PackageRef="tim.NOW.bpm.TelecomItaliaNotification" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
