        <xpdl2:Activity Id="_tpJ6QptgEeqx6_acRk-1Yg" Name="RICHIESTAESECUZIONEANNULLAMENTOFASTDATA" xpdExt:Visibility="Private" xpdExt:DisplayName="RICHIESTA ESECUZIONE/ANNULLAMENTO FASTDATA">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_WjeSwJtNEeqx6_acRk-1Yg" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdExt:InputMappings MapperContext="ProcessToSubProcess" MappingDirection="IN">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="localRequest">
                    <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="RequestRef">
                    <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="ScartoFastData">
