          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">Outcome == &quot;GESTIONE_KO&quot;
|| (Outcome==&quot;GESTIONE_IMPROPRIA&quot; &amp;&amp; DTUaction==&quot;RETRY&quot;);</xpdl2:Expression>
</xpdl2:Condition>
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.LabelAnchorPosition">
              <xpdl2:Coordinates XCoordinate="58.92857142857143" YCoordinate="0.0"/>
              <xpdl2:Coordinates XCoordinate="11.0" YCoordinate="0.0"/>
            </xpdl2:ConnectorGraphicsInfo>
