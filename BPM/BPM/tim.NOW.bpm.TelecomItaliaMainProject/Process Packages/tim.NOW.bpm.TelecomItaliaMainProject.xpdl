        <xpdl2:Activity Id="_dbFGwMr1EeepVZgECi53Sg" Name="NotificationsManagementKODonor" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Notifications Management KO Donor">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_l-ElkAOpEeaIdPdRimpTnw" PackageRef="tim.NOW.bpm.TelecomItaliaNotification" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaNotifica">
                  <xpdExt:ScriptInformation Id="_dbFGwcr1EeepVZgECi53Sg" Name="KO"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;AN&quot;;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="Requestref">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaOLODestinatario">
                  <xpdExt:ScriptInformation Id="_nsUGAMr1EeepVZgECi53Sg" Name="Script1">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;DONOR&quot;;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="IdNotificaUpdated">
                  <xpdl2:Actual ScriptGrammar="JavaScript">IdNotificaUpdated</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="CodificaOLOAGCOM">
                  <xpdExt:ScriptInformation Id="_iCmjALtyEe61TbPdbrDixA" Name="codOloAgcom"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var codiceOperatoreDonor =  &quot;&quot;;&#xD;
codiceOperatoreDonor = null;&#xD;
&#xD;
if(localRequest.ordine.dettaglioordine != null &amp;&amp; localRequest.ordine.dettaglioordine != '')&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR)&#xD;
				{&#xD;
					codiceOperatoreDonor = attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
codiceOperatoreDonor;</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="89.0" LaneId="_OTs_cwJCEeaPBpRvSvxznA" Width="144.0">
              <xpdl2:Coordinates XCoordinate="5867.0" YCoordinate="1859.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit/>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_MWDp0OP_Eee7yZjHTM9tIw" Name="CalcoloNotificheKODonating" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcolo Notifiche KO Donating">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">IDAssetConsistenzaDati = null;&#xD;
IDAssetConsistenzaFonia = null;&#xD;
StrutturaConsistenzaDati = null;&#xD;
StrutturaConsistenzaFonia = null;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if((currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		&amp;&amp; currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
				{&#xD;
					IDAssetConsistenzaDati = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					IDAssetConsistenzaFonia = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
			{&#xD;
				var offertaSliced3 = currentAttDettOrdine.valoreAttributo.slice(0,3);&#xD;
				var offertaSliced4 = currentAttDettOrdine.valoreAttributo.slice(0,4);&#xD;
				&#xD;
				if(offertaSliced3 == &quot;ULL&quot;&#xD;
					|| offertaSliced3 == &quot;SLU&quot;&#xD;
					|| offertaSliced3 == &quot;SHA&quot;&#xD;
					|| offertaSliced3 == &quot;WLR&quot;&#xD;
					|| offertaSliced4 == &quot;VULL&quot;)&#xD;
				{&#xD;
					if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
					{&#xD;
						StrutturaConsistenzaDati = &quot;REGOLATORIO&quot;;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						StrutturaConsistenzaFonia = &quot;REGOLATORIO&quot;;&#xD;
					}&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
					{&#xD;
						StrutturaConsistenzaDati = &quot;NGA&quot;;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						StrutturaConsistenzaFonia = &quot;NGA&quot;;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
