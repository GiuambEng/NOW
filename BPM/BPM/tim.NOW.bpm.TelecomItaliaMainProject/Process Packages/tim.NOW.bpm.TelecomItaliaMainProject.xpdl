        <xpdl2:Activity Id="__1hL4nIgEe2oK8wKjP8xaw" Name="CalcolaAttesa" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola Attesa">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Timeout = DateTimeUtil.createDatetime(TimeoutDate,DateTimeUtil.createTime(18,30,0,0));   //Bug #45147&#xD;
&#xD;
Esito_RicezioneCodiceSegreto = &quot;0&quot;;&#xD;
IDAnagraficaCausaleCodiceSegreto = null;&#xD;
&#xD;
//RU_1433 &#xD;
//Se TimeoutDate (la data in cui deve scattate il timer di silezio assenso) coincide proprio con la DAC-2 (quel 2 è configurabile), allora il timer scatterà a DAC-2 ore 18:30.&#xD;
//Questo comporta che entrando poi in Irrobustimento Cautelare mandiamo la RDAC e la TC10 dopo le 18 del giorno DAC-2 e quindi il file di notifiche verrà generato il giorno dopo.&#xD;
//Dobbiamo fare qui una prima rimodulazione per cambiare la DAC nel caso in cui TimeoutDate = DAC-2 ed evitare questa situazione.&#xD;
&#xD;
RDACPreCautelare = false;&#xD;
&#xD;
if(localRequest.idTplgCautelare == 'Y'&amp;&amp; DateTimeUtil.createDate(TimeoutDate) == DateTimeUtil.createDate(ScadenzaRDAC))&#xD;
{&#xD;
	RDACPreCautelare = true;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="60.0" LaneId="_Q_PNMXIeEe2oK8wKjP8xaw" Width="95.0">
              <xpdl2:Coordinates XCoordinate="5053.0" YCoordinate="918.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
