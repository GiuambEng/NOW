          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">ExistingOrder.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACQUISITO&#xD;
||&#xD;
(ExistingOrder.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.LAVORAZIONEHD &amp;&amp;&#xD;
	ExistingOrder.statoRichiestaPrecedNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACQUISITO)&#xD;
||&#xD;
ExistingOrder.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.PERVENUTO&#xD;
||&#xD;
ExistingOrder.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACCETTATO // Bug #24515&#xD;
||&#xD;
ExistingOrder.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVERIFICADONATING // Bug #24515&#xD;
||&#xD;
//NP DEL 35: va sempre qui (pre-delivery)&#xD;
(ExistingOrder.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
&amp;&amp; ExistingOrder.flagDelibera103 != &quot;Y&quot;)&#xD;
||&#xD;
//SM_10926: per DEL 103 la TC16 (RDACRECIPIENTDONOR) deve andare qui o sopra a seconda che la target sia stata o meno inviata a DTU, quindi a seconda se siano o meno soddisfatte le condizioni sugli stati&#xD;
//Le altre RDAC (TC10, TC17) vanno sempre qui (pre-delivery)&#xD;
(ExistingOrder.flagDelibera103 == &quot;Y&quot;&#xD;
  &amp;&amp; ExistingOrder.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
  &amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RDACRECIPIENTDONOR);&#xD;
</xpdl2:Expression>
</xpdl2:Condition>
