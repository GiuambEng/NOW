        <xpdl2:Activity Id="_n4fXVZtpEea62cEIbBbcaQ" Name="NotificaversoOLO" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Notifica verso OLO">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_v3JtkIFrEeaG-Y7D3-yA8Q" PackageRef="tim.NOW.bpm.invokeExternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaOLODestinatario">
                  <xpdExt:ScriptInformation Id="_7BawAJtpEea62cEIbBbcaQ" Name="DONATING">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;DONATING&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="TipologiaNotifica">
                  <xpdExt:ScriptInformation Id="_vhgIkJuUEeaLrquH9ACbBg" Name="TC10">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">//RU_1346(DEL 103)- per C03M19 va inviata TC17&#xD;
if(ExistingOrder.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
   &amp;&amp; ExistingOrder.flagDelibera103 == &quot;Y&quot;&#xD;
   &amp;&amp; (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RDACRECIPIENTDONOR    &#xD;
      || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RDACDONORDONATING))&#xD;
{&#xD;
	&quot;TC17&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;TC10&quot;;&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ExistingOrder</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ExistingOrder</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="CodificaOLOAGCOM">
                  <xpdExt:ScriptInformation Id="_HFstUIzaEe2REdrtAUMhFw" Name="codiceOperatoreDonating"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">//Script Editor inserito con RU_1346 (NP DEL 103)&#xD;
var codiceOperatoreDonating = &quot;&quot;;&#xD;
codiceOperatoreDonating = null;&#xD;
var oloRetailer = &quot;&quot;;&#xD;
oloRetailer = null;&#xD;
&#xD;
if(ExistingOrder.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
   &amp;&amp; ExistingOrder.flagDelibera103 == &quot;Y&quot;)&#xD;
{&#xD;
	for(var i=0; i&lt;ExistingOrder.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = ExistingOrder.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			for(var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING)&#xD;
				{&#xD;
					codiceOperatoreDonating = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovata NUMBERPORTABILITY con CODICEOPERATOREDONATING: &quot;+codiceOperatoreDonating);&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER)&#xD;
				{&#xD;
					oloRetailer = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovata NUMBERPORTABILITY con OLORETAILER: &quot;+oloRetailer);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//SM_11178&#xD;
if(oloRetailer != null)&#xD;
{&#xD;
	oloRetailer;&#xD;
}&#xD;
else&#xD;
{&#xD;
	codiceOperatoreDonating;&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="123.0" LaneId="__YSt8JnaEea3XbSY-2UydA" Width="128.0">
              <xpdl2:Coordinates XCoordinate="3999.0" YCoordinate="931.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">&#xD;
ProcessIdentifier = &quot;/tim.NOW.bpm.invokeExternalService/Process Packages/tim.NOW.bpm.invokeExternalService.OLO.xpdl.TINOWNotificaOLO&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">localRequest.IDNotificaDonating = ExistingOrder.IDNotificaDonating;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
