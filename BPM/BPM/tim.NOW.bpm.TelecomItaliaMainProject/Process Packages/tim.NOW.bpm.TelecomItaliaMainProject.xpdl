        <xpdl2:Activity Id="_0wCqwhCkEeyoFuPDVkQVkA" Name="ArricchimentoOrdineeLogicaSblocco" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Ordine e Logica Sblocco">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//MODIFICA DEGLI IDDETTAGLIOORDINE E RECUPERO LE INFO DALLA COMPONENTE GSRIDATIESITI&#xD;
//AGGIORNO VALORI ORDINE: DES, ORADES, DACRIMODULATA&#xD;
DettOrdine_BOM.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
DettOrdine_BOM.integrationID = localRequest.IDRichiestaOLO + (localRequest.ordine.dettaglioordine.size() + 1);&#xD;
&#xD;
var CAUSORDINE = &quot;&quot;;&#xD;
CAUSORDINE = null;&#xD;
var STATOORDINE = &quot;&quot;;&#xD;
STATOORDINE = null;&#xD;
&#xD;
for(var i=0; i&lt;DettOrdine_BOM.attributiDettaglioOrdine.size(); i++)&#xD;
{&#xD;
	var attributo = DettOrdine_BOM.attributiDettaglioOrdine.get(i);&#xD;
	&#xD;
	attributo.IDDettaglioOrdine = DettOrdine_BOM.IDDettaglioOrdine;&#xD;
	&#xD;
	if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAUSORDINE)&#xD;
	{&#xD;
		CAUSORDINE = attributo.valoreAttributo;&#xD;
		Process.auditLog(&quot;Trovato attributo CAUSORDINE&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+DettOrdine_BOM.IDDettaglioOrdine);			&#xD;
	}&#xD;
	else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATOORDINE)&#xD;
	{&#xD;
		STATOORDINE = attributo.valoreAttributo;&#xD;
		Process.auditLog(&quot;Trovato attributo STATOORDINE&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+DettOrdine_BOM.IDDettaglioOrdine);			&#xD;
	}&#xD;
	else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DES)&#xD;
	{&#xD;
		localRequest.ordine.DES = DateTimeUtil.createDate(attributo.valoreAttributo.slice(6,10)+&quot;-&quot;+attributo.valoreAttributo.slice(3,5)+&quot;-&quot;+attributo.valoreAttributo.slice(0,2));&#xD;
		Process.auditLog(&quot;Trovato attributo DES&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+DettOrdine_BOM.IDDettaglioOrdine+&quot; e convertita in &quot;+String(localRequest.ordine.DES));			&#xD;
	}&#xD;
	else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ORADES)&#xD;
	{&#xD;
		localRequest.ordine.ORA_DES = DateTimeUtil.createTime(attributo.valoreAttributo+&quot;:00&quot;);&#xD;
		Process.auditLog(&quot;Trovato attributo ORADES&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+DettOrdine_BOM.IDDettaglioOrdine);			&#xD;
	}&#xD;
	else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATACUTOVER)&#xD;
	{&#xD;
		localRequest.ordine.DACRimodulata = DateTimeUtil.createDate(attributo.valoreAttributo.slice(6,10)+&quot;-&quot;+attributo.valoreAttributo.slice(3,5)+&quot;-&quot;+attributo.valoreAttributo.slice(0,2));&#xD;
		Process.auditLog(&quot;Trovato attributo DATACUTOVER&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+DettOrdine_BOM.IDDettaglioOrdine+&quot; e convertita in &quot;+String(localRequest.ordine.DACRimodulata));			&#xD;
	}	&#xD;
}&#xD;
&#xD;
//AGGIUNGO LA COMPONENTE NELL'ORDINE&#xD;
localRequest.ordine.dettaglioordine.add(DettOrdine_BOM);&#xD;
&#xD;
&#xD;
//LOGICA DI SBLOCCO DELLA RICHIESTA DA GSRI/GUI LAVORAZIONE MANUALE&#xD;
StatoRichiestaModificato = false;&#xD;
&#xD;
localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
&#xD;
if(CAUSORDINE != null)//SM_10919&#xD;
{&#xD;
	if((CAUSORDINE == &quot;0&quot; &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
		||(CAUSORDINE == &quot;1&quot; &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE))&#xD;
	{&#xD;
		if(STATOORDINE == 0 &amp;&amp; localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACQUISITO)&#xD;
		{	&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOADELIVERY;&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.INVIATOADELIVERY;&#xD;
			StatoRichiestaModificato = true;&#xD;
		}&#xD;
		else if(STATOORDINE == 1 &amp;&amp; localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOADELIVERY)&#xD;
		{&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICO;&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ESPLETAMENTOTECNICO;&#xD;
			StatoRichiestaModificato = true;&#xD;
		}&#xD;
	}&#xD;
	else if(CAUSORDINE == &quot;2&quot;)&#xD;
	{		&#xD;
		if(STATOORDINE == null //SM_10919&#xD;
			&amp;&amp; localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACQUISITO)&#xD;
		{&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO;&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SCARTATO;&#xD;
			StatoRichiestaModificato = true;&#xD;
			&#xD;
			localRequest.IDAnagraficaCausale = IDAnagraficaCausale;						&#xD;
		}&#xD;
		else if(STATOORDINE == 1 &amp;&amp; localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOADELIVERY)&#xD;
		{&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO;&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ESPLETAMENTOTECNICOKO;&#xD;
			StatoRichiestaModificato = true;&#xD;
		&#xD;
			localRequest.IDAnagraficaCausale = IDAnagraficaCausale;					&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="84.0" LaneId="_1RYSsRCjEeyoFuPDVkQVkA" Width="130.0">
              <xpdl2:Coordinates XCoordinate="591.0" YCoordinate="293.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
