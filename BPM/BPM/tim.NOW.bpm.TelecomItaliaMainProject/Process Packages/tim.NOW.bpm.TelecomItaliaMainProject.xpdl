              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_l-ElkAOpEeaIdPdRimpTnw" PackageRef="tim.NOW.bpm.TelecomItaliaNotification" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="Requestref">
                      <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="OUT" Formal="Requestref">
                      <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="tipologiaNotifica">
                      <xpdExt:ScriptInformation Id="_3q9cEfQMEem5rsYd11eFSQ" Name="tipologiaNotifica"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">&quot;TC10&quot;;</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="CodificaOLOAGCOM">
                      <xpdExt:ScriptInformation Id="_OVbB0PQNEem5rsYd11eFSQ" Name="OLO"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">var OLODonating=&quot;&quot;;&#xD;
OLODonating = null;&#xD;
&#xD;
var i=0;&#xD;
var j=0;&#xD;
&#xD;
while(i&lt;localRequest.ordine.dettaglioordine.size() &amp;&amp; OLODonating == null)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if (componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY&#xD;
	 &amp;&amp; componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
	{&#xD;
		j=0;&#xD;
		&#xD;
		while(j&lt;componente.attributiDettaglioOrdine.size() &amp;&amp; OLODonating == null)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING)&#xD;
			{&#xD;
				OLODonating = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;OLODonating = &quot;+OLODonating);&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
} &#xD;
&#xD;
OLODonating;</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="tipologiaOLODestinatario">
                      <xpdExt:ScriptInformation Id="_LcYYIPQNEem5rsYd11eFSQ" Name="DONATING"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">&quot;DONATING&quot;;</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
