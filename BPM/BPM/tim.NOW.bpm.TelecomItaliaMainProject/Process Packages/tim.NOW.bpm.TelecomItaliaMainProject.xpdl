                  <xpdExt:ScriptInformation Id="_T13PMFuFEe6nUaw1zLr3Zw" Name="Richiesta"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">//SM_11124&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON&#xD;
    ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON)&#xD;
{&#xD;
    ScriptUtil.copy(localRequest);&#xD;
}&#xD;
else&#xD;
{&#xD;
	ScriptUtil.copy(ExistingOrder);&#xD;
}</xpdl2:Actual>
