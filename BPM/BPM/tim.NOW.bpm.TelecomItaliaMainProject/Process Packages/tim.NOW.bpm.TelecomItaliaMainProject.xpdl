localRequest.canaleRichiesta != it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL&#xD;
&amp;&amp; localRequest.codiceTrasformazione != null&#xD;
&amp;&amp; localRequest.codiceTrasformazione !=&quot;&quot;)&#xD;
{&#xD;
	if(localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot; &amp;&amp; &#xD;
		localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp;&#xD;
		String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;)&#xD;
	{&#xD;
		//cerca id asset consistenza dati&#xD;
		var idAssetDati = &quot;&quot;;&#xD;
		var foundIdAsset=false;&#xD;
		if(localRequest.ordine!=null &amp;&amp; localRequest.ordine.dettaglioordine!=null &#xD;
			&amp;&amp; localRequest.ordine.dettaglioordine.size()>0)&#xD;
		{&#xD;
			var i=0;&#xD;
			var foundConsistenzaDati=false;&#xD;
			while(!foundConsistenzaDati &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var currDett=localRequest.ordine.dettaglioordine.get(i);&#xD;
				if(currDett.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
				{&#xD;
					foundConsistenzaDati=true;&#xD;
					if(currDett.attributiDettaglioOrdine!=null &amp;&amp; currDett.attributiDettaglioOrdine.size()>0)&#xD;
					{&#xD;
						var j=0;&#xD;
						while(!foundIdAsset  &amp;&amp; j&lt;currDett.attributiDettaglioOrdine.size())&#xD;
						{&#xD;
							var currAtt = currDett.attributiDettaglioOrdine.get(j);&#xD;
							if(currAtt.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
							{&#xD;
								foundIdAsset=true;&#xD;
								idAssetDati=currAtt.valoreAttributo;&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
		//recupera stato asset a partire da idAssetDati&#xD;
		if(foundIdAsset &amp;&amp; idAssetDati!=null &amp;&amp; idAssetDati!=&quot;&quot;)&#xD;
		{&#xD;
			var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset =: ida AND statoAsset IN ('CESSATO', 'INLAVORAZIONE') AND offerta  NOT IN ('SHASENZAMANODOPERA','SHACONMANODOPERA') &quot;);&#xD;
			c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(idAssetDati));&#xD;
			var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			if(result!=null &amp;&amp; result.size()>0)&#xD;
			{&#xD;
				lavorazioneIndotta=false;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				lavorazioneIndotta=true;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		&#xD;
		&#xD;
		&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		lavorazioneIndotta=true;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
lavorazioneIndotta;</xpdl2:Expression>
</xpdl2:Condition>
