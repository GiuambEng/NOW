        <xpdl2:Activity Id="_vCko-HKwEfCTDtqitNXjKg" Name="AggiornaCaseRICHIESTATarget" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna Case RICHIESTA Target">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;Richiesta&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ExistingOrder</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ExistingOrderRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ExistingOrderRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ExistingOrder</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="80.0" LaneId="_u8YW0HKvEfCTDtqitNXjKg" Width="128.0">
              <xpdl2:Coordinates XCoordinate="463.0" YCoordinate="428.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ExistingOrder = ExistingOrderRef.readRichiesta();&#xD;
ExistingOrder.flagAttesaDesospOLO = 'NO';&#xD;
&#xD;
if(ExistingOrder.ordine != null)&#xD;
{&#xD;
	ExistingOrder.ordine.DACRimodulata = localRequest.DAC;&#xD;
	ExistingOrder.ordine.fasciaOraUltimoApptD82 = localRequest.fasciaOrariaAppuntamento;&#xD;
}&#xD;
&#xD;
//Inserito arricchimento per REFERENTERIMODULAZIONEDAC (ricevuto come parameter nella richiesta di RIMODULAZIONEDAC)&#xD;
var calcProgressivo = 4;&#xD;
&#xD;
if(referenteAltreLavorazioni != null)&#xD;
{&#xD;
	for(var i=0; i&lt;ExistingOrder.ordine.referente.size(); i++)&#xD;
	{&#xD;
		var currentReferente = ExistingOrder.ordine.referente.get(i);&#xD;
&#xD;
		if(currentReferente.tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTERIMODULAZIONEAPPUNTAMENTO&#xD;
		   ||currentReferente.tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTEPERINTERRUZIONESOSPENSIONE&#xD;
		   ||currentReferente.tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTERIMODULAZIONEDAC)&#xD;
		{&#xD;
			calcProgressivo++;&#xD;
		}&#xD;
	}&#xD;
   &#xD;
   referenteAltreLavorazioni.progressivoReferente = calcProgressivo;&#xD;
   referenteAltreLavorazioni.IDRichiestaOLO = ExistingOrder.IDRichiestaOLO;&#xD;
   ExistingOrder.ordine.referente.add(ScriptUtil.copy(referenteAltreLavorazioni));  &#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
