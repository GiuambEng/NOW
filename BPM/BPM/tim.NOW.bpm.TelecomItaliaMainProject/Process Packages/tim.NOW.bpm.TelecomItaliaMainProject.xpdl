        <xpdl2:Activity Id="_m8HdwPKEEeqXyLL0-h_BJQ" Name="RecuperoArchi" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupero Archi" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">// CR467 - RECUPERO LISTA ARCHI DATI RECUPERABILI DALLA NOW CONFIGURATION&#xD;
var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key=:inputKey&quot;);&#xD;
criteria.setQueryParameter(&quot;inputKey&quot;,&quot;Lista_ArchiDatiRecuperabili&quot;);&#xD;
var configurations = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(criteria);&#xD;
var Lista = &quot;&quot;;&#xD;
&#xD;
if(configurations != null &amp;&amp; configurations.size() > 0)&#xD;
{&#xD;
	var configuration = configurations.get(0).readConfiguration();	&#xD;
	Process.auditLog(&quot;Recuperata lista Archi: &quot; + configuration.value);&#xD;
	Lista = configuration.value;&#xD;
}&#xD;
&#xD;
var arcoSingolo = &quot;&quot;;&#xD;
var k = 0;&#xD;
&#xD;
while(k&lt;Lista.length)&#xD;
{&#xD;
	var charAt = Lista.charAt(k);&#xD;
	&#xD;
	if(charAt == &quot;|&quot; &amp;&amp; arcoSingolo != null &amp;&amp; arcoSingolo != &quot;&quot;){&#xD;
		archi.add(arcoSingolo);&#xD;
		Process.auditLog(&quot;Inserito Arco nell'array: &quot; + arcoSingolo);&#xD;
		arcoSingolo = &quot;&quot;;&#xD;
	}&#xD;
	else{&#xD;
		arcoSingolo = arcoSingolo+charAt;&#xD;
	}&#xD;
	&#xD;
	k++;&#xD;
}&#xD;
&#xD;
if(arcoSingolo != &quot;&quot;){&#xD;
archi.add(arcoSingolo);&#xD;
Process.auditLog(&quot;Inserito Arco nell'array: &quot; + arcoSingolo);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_URKpDQItEeakQOuA4HJGNg" Width="96.0">
              <xpdl2:Coordinates XCoordinate="1861.0" YCoordinate="369.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
