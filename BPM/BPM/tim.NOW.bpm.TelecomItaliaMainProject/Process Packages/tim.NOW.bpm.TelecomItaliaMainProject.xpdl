        <xpdl2:Activity Id="_KuS-QJU4EeaK6KCRIRatSw" Name="calcDeadline" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="calc Deadline">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_TiXYQOl0EeabDOcEQPWpDw" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="identifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="duration">
                  <xpdExt:ScriptInformation Id="_IIDJQOnxEealkvBzMVJP3w" Name="duration">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;P&quot; + (daysTimeout - 1) + &quot;DT23H&quot;;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="startDateTime">
                  <xpdExt:ScriptInformation Id="_JF__QOnxEealkvBzMVJP3w" Name="startDateTime">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">DateTimeUtil.createDatetime(DataAnnullamento,DateTimeUtil.createTime(4,0,0,0));</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="endDateTime">
                  <xpdl2:Actual ScriptGrammar="JavaScript">endDateTime</xpdl2:Actual>
