        <xpdl2:Activity Id="__1hMFHIgEe2oK8wKjP8xaw" Name="calcDeadline" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="calc Deadline">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_TiXYQOl0EeabDOcEQPWpDw" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="duration">
                  <xpdExt:ScriptInformation Id="__1hMFXIgEe2oK8wKjP8xaw" Name="duration">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">//In base alla DAC e Tempi di processo calcolati (per casi Semplici/Complessi) NOW attende la scadenza del Time-out di silenzio – assenso (per casi semplici e per i casi Complessi)&#xD;
//Tempi del timer presenti nel paragrafo &quot;C04M01F14 – Verifica DAC SLA&quot; e nei paragrafi master delle lavorazioni&#xD;
//SM_10886: corrette tutte le duration settate: vanno messe con un giorno in meno&#xD;
&#xD;
//PORTIN (C02M66, C02M67, C02M68) -> hanno CodificaOLOAGCOMDonor = TLC&#xD;
if(localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PORTIN)&#xD;
{&#xD;
	if(CasoComplesso)&#xD;
	{&#xD;
		&quot;P4DT23H&quot;; //SM_10848: DataInvioTC3 + 5 GIORNI&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		&quot;P0DT23H&quot;; //SM_10848: DataInvioTC3 + 1 GIORNO&#xD;
	}&#xD;
}&#xD;
//PRENOTIFICADONATING -> ha CodificaOLOAGCOMDonor != TLC&#xD;
else &#xD;
{		&#xD;
	if(CasoComplesso)&#xD;
	{&#xD;
		&quot;P4DT23H&quot;; //T3 = DRO + 5 GIORNI&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		&quot;P0DT23H&quot;; //T3 = DRO + 1 GIORNO&#xD;
	}&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="startDateTime">
                  <xpdExt:ScriptInformation Id="__1hMFnIgEe2oK8wKjP8xaw" Name="startDateTime">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if (localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PORTIN)&#xD;
{&#xD;
	DateTimeUtil.createDatetime(DataInvioTC3,DateTimeUtil.createTime(4,0,0,0)); //SM_10848&#xD;
}&#xD;
else&#xD;
{&#xD;
	DateTimeUtil.createDatetime(localRequest.DRO,DateTimeUtil.createTime(4,0,0,0));&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="endDateTime">
                  <xpdl2:Actual ScriptGrammar="JavaScript">endDateTime</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_Q_PNMXIeEe2oK8wKjP8xaw" Width="128.0">
              <xpdl2:Coordinates XCoordinate="4916.0" YCoordinate="752.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.calcDeadline&quot;;&#xD;
&#xD;
var date;&#xD;
&#xD;
if (localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PORTIN)&#xD;
{&#xD;
	date=DateTimeUtil.createDatetime(DataInvioTC3,DateTimeUtil.createTime(4,0,0,0));&#xD;
}&#xD;
else&#xD;
{&#xD;
	date=DateTimeUtil.createDatetime(localRequest.DRO,DateTimeUtil.createTime(4,0,0,0));&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Valore in input a clc Deadline: &quot; +String(date));</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">TimeoutDate = DateTimeUtil.createDate(endDateTime);&#xD;
&#xD;
Process.auditLog(&quot;Valore restituito da clc Deadline: &quot; +String(TimeoutDate));&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
