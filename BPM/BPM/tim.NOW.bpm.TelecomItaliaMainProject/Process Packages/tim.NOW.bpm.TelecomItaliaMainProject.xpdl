          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">//SM_11353: va messa la stessa tipologiaSottolav della target individuata (PRIMAPORTABILITA o PORTABILITASUCCESSIVA) &#xD;
if(TargetRequest != null &amp;&amp; localRequest.ordine != null&#xD;
   &amp;&amp; TargetRequest.tipologiaSottolav != null &amp;&amp; TargetRequest.tipologiaSottolav != &quot;&quot;)&#xD;
{&#xD;
