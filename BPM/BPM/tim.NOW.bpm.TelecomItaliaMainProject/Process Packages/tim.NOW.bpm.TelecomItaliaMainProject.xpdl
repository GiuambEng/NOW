        <xpdl2:Activity Id="_Pfj1d97fEemKFq87v_lMEg" Name="B2BRicaricheESPLETAMENTO" xpdExt:Visibility="Private" xpdExt:DisplayName="B2B Ricariche ESPLETAMENTO">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_mQ8AILm_Eemgcbm71HEQ6A" PackageRef="tim.NOW.bpm.invokeExternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdExt:InputMappings MapperContext="ProcessToSubProcess" MappingDirection="IN">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="localRequest">
                    <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="IDAssetRicarica">
                    <xpdl2:Actual ScriptGrammar="JavaScript">IDAssetRicarica</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="BusinessID">
                    <xpdExt:ScriptInformation Id="_Pfj1eN7fEemKFq87v_lMEg" Name="BusinessIDMapping">
                      <xpdExt:Expression ScriptGrammar="JavaScript">var businessIdMapping = &quot;&quot;;&#xD;
if(BusinessID != null)&#xD;
{&#xD;
	businessIdMapping = BusinessID;&#xD;
}&#xD;
return businessIdMapping;</xpdExt:Expression>
                    </xpdExt:ScriptInformation>
                    <xpdl2:Actual ScriptGrammar="JavaScript">__SCRIPT__</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:InputMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_OTs_cwJCEeaPBpRvSvxznA" Width="128.0">
              <xpdl2:Coordinates XCoordinate="5172.0" YCoordinate="1004.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeExternalService/Process Packages/tim.NOW.bpm.invokeExternalService.B2B.xpdl.TINOWB2BRicariche&quot;;&#xD;
&#xD;
for (var i=0; i&lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if (currentComponente. nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DATIRICARICA)&#xD;
	{&#xD;
		for (var j=0; j&lt; currentComponente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSETRICARICA)&#xD;
			{&#xD;
				IDAssetRicarica = currentAttributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Chiamata a B2B, Stato: &quot;+localRequest.statoRichiestaNOW+&quot;. IDAssetRicarica: &quot;+IDAssetRicarica);</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
