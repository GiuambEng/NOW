        <xpdl2:Activity Id="_TPTycIz5Ee2REdrtAUMhFw" Name="NotificaScartoCongruenzaversoOLO7" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Notifica Scarto Congruenza verso OLO">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_v3JtkIFrEeaG-Y7D3-yA8Q" PackageRef="tim.NOW.bpm.invokeExternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="TipologiaNotifica">
                  <xpdExt:ScriptInformation Id="_TPTycYz5Ee2REdrtAUMhFw" Name="Tipo">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if(localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PRENOTIFICADONATING)&#xD;
{&#xD;
	&quot;TC5&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;TC6&quot;;&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaOLODestinatario">
                  <xpdExt:ScriptInformation Id="_TPTycoz5Ee2REdrtAUMhFw" Name="target"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if(localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PRENOTIFICADONATING)&#xD;
{&#xD;
	&quot;DONOR&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;RECIPIENT&quot;;&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="123.0" LaneId="_Q_PNMXIeEe2oK8wKjP8xaw" Width="128.0">
              <xpdl2:Coordinates XCoordinate="7237.0" YCoordinate="1378.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">//Updating the statorichestaNOW with SCARTATO&#xD;
localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
&#xD;
localRequest.statoRichiestaNOW=it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO;&#xD;
localRequest.statoRichiestaOLO=it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SCARTATO;&#xD;
&#xD;
ProcessIdentifier = &quot;/tim.NOW.bpm.invokeExternalService/Process Packages/tim.NOW.bpm.invokeExternalService.OLO.xpdl.TINOWNotificaOLO&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_b1gzMIz5Ee2REdrtAUMhFw" Name="TrascodificaCodiceCausale7" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Trascodifica CodiceCausale">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_yewCgIueEea6Hs4N8ixhVg" PackageRef="tim.NOW.bpm.ErrorCodeManagement.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="CodiceCausale">
                  <xpdExt:ScriptInformation Id="_b1gzMYz5Ee2REdrtAUMhFw" Name="CodiceCausale">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">//Logica presente in C04M05F05&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
   &amp;&amp;(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE&#xD;
      ||(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PORTABILITASUCCESSIVA&#xD;
          &amp;&amp; String(localRequest.tipologiaScenario).slice(0,6) == &quot;NPSUNP&quot;)))&#xD;
{&#xD;
	&quot;17&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;28&quot;;&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="IDAnagraficaCausale">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDAnagraficaCausale</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_Q_PNMXIeEe2oK8wKjP8xaw" Width="137.0">
              <xpdl2:Coordinates XCoordinate="7068.0" YCoordinate="1378.0"/>
            </xpdl2:NodeGraphicsInfo>
