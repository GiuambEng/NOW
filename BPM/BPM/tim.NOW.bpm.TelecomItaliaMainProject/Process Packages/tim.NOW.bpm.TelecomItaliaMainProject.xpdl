        <xpdl2:Transition Id="_m8HdwfKEEeqXyLL0-h_BJQ" xpdExt:DisplayName="" Name="" From="_qCH6gegQEeiIZP_rWOULag" To="_zh1WMOgQEeiIZP_rWOULag">
          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">var callInserimento = false;&#xD;
IDRISORSADaInserire = null;&#xD;
&#xD;
if(localRequest.IDRisorsa != null &amp;&amp; localRequest.IDRisorsa != '')&#xD;
{&#xD;
	//LOGICA SU QUALE IDRISORSA ANDARE A CONSIDERARE&#xD;
	//SM_10069: PER I SERVIZI METROWEB O OPENFIBER controlliamo IDRISORSANOW e non IDRISORSA&#xD;
	if(localRequest.ordine != null &amp;&amp; localRequest.ordine.IDRisorsaNOW != null &amp;&amp; localRequest.ordine.IDRisorsaNOW != ''  //SM_10224&#xD;
	   &amp;&amp;(localRequest.IDRisorsa.slice(0,1) == &quot;M&quot; || localRequest.IDRisorsa.slice(0,1) == &quot;O&quot; &#xD;
	       ||localRequest.ordine.IDRisorsaNOW != localRequest.IDRisorsa))&#xD;
	{&#xD;
		IDRISORSADaInserire = localRequest.ordine.IDRisorsaNOW;&#xD;
		var idRisorsaLen = String(localRequest.ordine.IDRisorsaNOW).length;  //SM_10692&#xD;
	}&#xD;
	else //solito (PRE-SM_10069)&#xD;
	{&#xD;
		IDRISORSADaInserire = localRequest.IDRisorsa;&#xD;
		var idRisorsaLen = String(localRequest.IDRisorsa).length;  //SM_10692&#xD;
	}&#xD;
	&#xD;
	//LOGICA PER CHIAMARE INSERIMENTO NUMERAZIONI FITTIZIE&#xD;
	//SM_10069: sostituito localRequest.IDRisorsa con IDRISORSADaInserire&#xD;
	if(IDRISORSADaInserire != null &#xD;
	&amp;&amp;&#xD;
	(archi.contains(IDRISORSADaInserire.slice(3,6))) //CR 467: sostituito IDRISORSA == 147 con archi.contains(IDRISORSA)&#xD;
	&amp;&amp;&#xD;
	(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
	||&#xD;
	localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)&#xD;
	&amp;&amp;&#xD;
	IDRISORSADaInserire.slice(idRisorsaLen - 3,idRisorsaLen) == 'W00'      //SM_10692&#xD;
	&amp;&amp;&#xD;
	(!(String(localRequest.offerta).length>16 &amp;&amp; String(localRequest.offerta).slice(12,16) == &quot;SIMM&quot;)) //CR 467: escludere i SIMMETRICI&#xD;
	&amp;&amp; targetRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA) //SM_9711 se la target è CAMBIOTECNOLOGIA bisogna saltare&#xD;
	{&#xD;
		callInserimento = true;&#xD;
	}&#xD;
}&#xD;
&#xD;
callInserimento;</xpdl2:Expression></xpdl2:Condition>
