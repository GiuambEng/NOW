          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;codicePacchettoNOW=:SearchCodicePacchettoNOW AND tipoRichiesta ='ORDINE' ORDER BY created DESC&quot;);&#xD;
&#xD;
