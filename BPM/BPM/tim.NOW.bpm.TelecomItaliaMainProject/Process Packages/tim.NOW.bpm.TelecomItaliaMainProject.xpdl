              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
                  <xpdExt:OutputMappings MapperContext="SubProcessToProcess" MappingDirection="OUT">
                    <xpdExt:DataMappings>
                      <xpdExt:DataMapping xpdExt:SourceContributorId="SubProcessToProcess.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="RichiestaRefTempPacto">
                        <xpdl2:Actual ScriptGrammar="JavaScript">requestRef</xpdl2:Actual>
                      </xpdExt:DataMapping>
                      <xpdExt:DataMapping xpdExt:SourceContributorId="SubProcessToProcess.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="RichiestaTempPacto">
