        <xpdl2:Activity Id="_mZY54P0CEeaOLPpzGCQltg" Name="CalcolaNotifichePerMigrazione" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola Notifiche Per Migrazione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(ExistingOrder.ordine != null){&#xD;
&#xD;
	var i=0;&#xD;
	&#xD;
	while((ComponenteConsistenzaDati==null || ComponenteConsistenzaFonia==null) &amp;&amp; i&lt;ExistingOrder.ordine.dettaglioordine.size()){&#xD;
		var comp = ExistingOrder.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI){&#xD;
			ComponenteConsistenzaDati = ScriptUtil.copy(comp);&#xD;
			var j=0;&#xD;
			var trovato = false;&#xD;
			while(j&lt;ComponenteConsistenzaDati.attributiDettaglioOrdine.size()){&#xD;
				var attr = 	ComponenteConsistenzaDati.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING){&#xD;
					trovato=true;&#xD;
					CODIFICAOLOAGCOMDONATINGConsistenzaDati = String(attr.valoreAttributo);&#xD;
				}&#xD;
			j++;&#xD;
			}		&#xD;
		} else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA){&#xD;
			ComponenteConsistenzaFonia = ScriptUtil.copy(comp);&#xD;
			var j=0;&#xD;
			var trovato = false;&#xD;
			while(j&lt;ComponenteConsistenzaFonia.attributiDettaglioOrdine.size()){&#xD;
				var attr = 	ComponenteConsistenzaFonia.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING){&#xD;
					trovato=true;&#xD;
					CODIFICAOLOAGCOMDONATINGConsistenzaFonia = String(attr.valoreAttributo);&#xD;
				}&#xD;
			j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="71.0" LaneId="__YSt8JnaEea3XbSY-2UydA" Width="117.0">
              <xpdl2:Coordinates XCoordinate="2963.0" YCoordinate="98.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
