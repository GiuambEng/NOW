          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">&#xD;
var codiceFatturazioneTrovato = false;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp;&#xD;
	(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR&#xD;
  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA))  &#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
		{		&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAtttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEFATTURAZIONE)&#xD;
				{&#xD;
					codiceFatturazioneTrovato = true;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
(localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE || !codiceFatturazioneTrovato) &amp;&amp;&#xD;
	(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR&#xD;
  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA);</xpdl2:Expression>
</xpdl2:Condition>
