          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">localRequest = RequestRef.readRichiesta();&#xD;
&#xD;
//Sbianco post sblocco dal tool C26M35&#xD;
localRequest.flgAbilitazGuiManualOF = null;&#xD;
&#xD;
//RU_1492&#xD;
//C11M08F104 - Risottometti evento Fiberstream&#xD;
//C11M08F105 - Modifica e invio evento Fiberstream&#xD;
if(TipoSbloccoFBS == &quot;RisottomettiEvento_C11M08F104&quot; || TipoSbloccoFBS == &quot;ModificaInviaEvento_C11M08F105&quot;)&#xD;
{&#xD;
