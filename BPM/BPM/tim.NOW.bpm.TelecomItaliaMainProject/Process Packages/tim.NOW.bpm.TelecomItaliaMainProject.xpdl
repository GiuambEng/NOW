          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">if(ControlloFallito != null || IDRichiestaOLOTarget == null || IDRichiestaOLOTarget == &quot;&quot;)&#xD;
{      &#xD;
	false;&#xD;
}&#xD;
//SM_10904 NP DEL 103&#xD;
else if(localRequest.flagDelibera103 == &quot;Y&quot;)&#xD;
{&#xD;
	//Codici da accettare e per cui deve avvenire lo sblocco della target&#xD;
	if(localRequest.codiceRifiuto == &quot;9&quot;  || localRequest.codiceRifiuto == &quot;10&quot; ||&#xD;
	        localRequest.codiceRifiuto == &quot;11&quot; || localRequest.codiceRifiuto == &quot;12&quot; ||&#xD;
            localRequest.codiceRifiuto == &quot;14&quot; || localRequest.codiceRifiuto == &quot;16&quot; ||&#xD;
			localRequest.codiceRifiuto == &quot;27&quot; || localRequest.codiceRifiuto == &quot;28&quot; ||&#xD;
			localRequest.codiceRifiuto == &quot;29&quot; || localRequest.codiceRifiuto == &quot;30&quot; ||&#xD;
			localRequest.codiceRifiuto == &quot;31&quot; || localRequest.codiceRifiuto == &quot;34&quot;)&#xD;
       {  &#xD;
			false;&#xD;
       }&#xD;
	   else&#xD;
	   {&#xD;
		   true;&#xD;
	   }&#xD;
}&#xD;
else //solito&#xD;
{&#xD;
       if(localRequest.codiceRifiuto == &quot;14&quot; &amp;&amp;&#xD;
       (targetRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUTIF &#xD;
       || targetRequest.tipoComunicazioneNP==it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PRENOTIFICADONATING))&#xD;
       {      false;&#xD;
       }&#xD;
       else if((localRequest.codiceRifiuto == &quot;9&quot; || &#xD;
                    localRequest.codiceRifiuto == &quot;14&quot; || &#xD;
                    localRequest.codiceRifiuto == &quot;10&quot; ||&#xD;
                    localRequest.codiceRifiuto == &quot;16&quot; ||&#xD;
                    localRequest.codiceRifiuto == &quot;11&quot; ||&#xD;
                    localRequest.codiceRifiuto == &quot;12&quot; ||&#xD;
                    localRequest.codiceRifiuto == &quot;27&quot; ||&#xD;
                    localRequest.codiceRifiuto == &quot;28&quot;) &#xD;
                    &amp;&amp; targetRequest.tipologiaScenario != it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUTIF &#xD;
                    &amp;&amp; targetRequest.tipoComunicazioneNP!=it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PRENOTIFICADONATING)&#xD;
       {      false;&#xD;
       }&#xD;
       &#xD;
       else if(localRequest.esito!=&quot;1&quot;)&#xD;
		{ &#xD;
		false;&#xD;
 		}&#xD;
       else&#xD;
       {      true;&#xD;
       }&#xD;
}            </xpdl2:Expression></xpdl2:Condition>
