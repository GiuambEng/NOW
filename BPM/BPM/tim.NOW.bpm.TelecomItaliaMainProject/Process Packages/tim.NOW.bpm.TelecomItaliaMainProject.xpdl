        <xpdl2:Activity Id="_KdCVEFaZEeen8JrEtRL51w" Name="VerificanecessitageneraIDRisorsa" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica necessita genera ID Risorsa">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var DN = &quot;&quot;;&#xD;
DN = null;&#xD;
&#xD;
var IDRisorsa = &quot;&quot;;&#xD;
IDRisorsa = null;&#xD;
&#xD;
var IDRisorsaNow = &quot;&quot;;&#xD;
IDRisorsaNow = null;&#xD;
&#xD;
var IDRisorsaOLD = &quot;&quot;;&#xD;
IDRisorsaOLD = null;&#xD;
&#xD;
var accessoTrovato = false;&#xD;
var i=0;&#xD;
while(!accessoTrovato &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	if(String(componente.nomeComponente).slice(0,7)==&quot;ACCESSO&quot;)&#xD;
	{&#xD;
		accessoTrovato = true;&#xD;
		var j=0;&#xD;
		while((DN == null || IDRisorsaOLD == null) &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA)&#xD;
			&amp;&amp; attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
			{&#xD;
				DN = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN)&#xD;
			{&#xD;
				DN = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAOLD)&#xD;
			{&#xD;
				IDRisorsaOLD = attributo.valoreAttributo;&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
	}	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;DN: &quot;+DN+&quot;, IDRISORSAOLD: &quot;+IDRisorsaOLD);&#xD;
&#xD;
// SM_8962&#xD;
if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA&#xD;
&amp;&amp; IDRisorsaOLD != null&#xD;
&amp;&amp; (ConsistenzaFonia != null &amp;&amp; // SM_9089 - aggiunto ConsistenzaFonia != null, se non c'è va generato nuovo IDRISORSA&#xD;
	ConsistenzaFonia.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP &amp;&amp;&#xD;
	ConsistenzaFonia.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP &amp;&amp;&#xD;
	ConsistenzaFonia.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP))&#xD;
{&#xD;
	IDRisorsa = IDRisorsaOLD;&#xD;
	IDRisorsaNow = IDRisorsaOLD;	&#xD;
}&#xD;
// Richiesta WLR LA - WLR LNA - VULL&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA){&#xD;
&#xD;
	//donating WLR, VULL, ULL NP, SLU NP, ULL Dati NP&#xD;
	if(ConsistenzaFonia!=null &#xD;
	&amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEAATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULL&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULLLINEANONATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEAATTIVANP&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVANP)){&#xD;
		&#xD;
		IDRisorsa = ConsistenzaFonia.IDRisorsa;&#xD;
		IDRisorsaNow = ConsistenzaFonia.IDRisorsaNOW;&#xD;
	}&#xD;
	else{&#xD;
&#xD;
		IDRisorsa = DN;&#xD;
		IDRisorsaNow = DN;&#xD;
	}&#xD;
	&#xD;
}&#xD;
//Richiesta SLU NP - ULL NP - ULL DATI NP&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP){&#xD;
	&#xD;
	IDRisorsa = DN;&#xD;
	IDRisorsaNow = DN;&#xD;
}&#xD;
&#xD;
// Richiesta SLU LNA - ULL LNA - ULL DATI LNA&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA){&#xD;
	&#xD;
	// Donating SLU LA - ULL LA - ULL DATI LA&#xD;
	if(ConsistenzaFonia!=null&#xD;
	&amp;&amp;(ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEAATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVA)){&#xD;
	&#xD;
		IDRisorsa = ConsistenzaFonia.IDRisorsa;&#xD;
		IDRisorsaNow = ConsistenzaFonia.IDRisorsaNOW;&#xD;
	}&#xD;
	// Donating SLU LNA - ULL LNA - ULL DATI LNA&#xD;
	else if(ConsistenzaFonia!=null&#xD;
	&amp;&amp;(ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEANONATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEANONATTIVA))&#xD;
	{&#xD;
		if(ConsistenzaFonia.codificaOLOAGCOMDonating != &quot;TLC&quot;&#xD;
		|| (ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot; &amp;&amp; ConsistenzaFonia.IDRisorsa.charAt(0)== &quot;U&quot;)){&#xD;
			&#xD;
			IDRisorsa = ConsistenzaFonia.IDRisorsa;&#xD;
			IDRisorsaNow = ConsistenzaFonia.IDRisorsaNOW;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
//Richiesta SLU LA - ULL LA - ULL DATI LA&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA){&#xD;
	&#xD;
	// Donating SLU LNA - ULL LNA - ULL DATI LNA&#xD;
	if(ConsistenzaFonia!=null&#xD;
	&amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
		|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEANONATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEANONATTIVA)){&#xD;
		&#xD;
		if(ConsistenzaFonia.IDRisorsa.charAt(0)== &quot;U&quot;){&#xD;
			IDRisorsa = ConsistenzaFonia.IDRisorsa;&#xD;
			IDRisorsaNow = ConsistenzaFonia.IDRisorsaNOW;&#xD;
		}&#xD;
	}&#xD;
	// Donating SLU LA - ULL LA - ULL DATI LA&#xD;
	if(ConsistenzaFonia!=null&#xD;
	&amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEAATTIVA&#xD;
	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVA)){&#xD;
	&#xD;
		IDRisorsa = ConsistenzaFonia.IDRisorsa;&#xD;
		IDRisorsaNow = ConsistenzaFonia.IDRisorsaNOW;&#xD;
	}&#xD;
}&#xD;
&#xD;
//RICHIESTA SHASENZAMANODOPERA&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA){&#xD;
	&#xD;
	&#xD;
		IDRisorsa = DN;&#xD;
		IDRisorsaNow = DN;&#xD;
	&#xD;
}&#xD;
&#xD;
if(IDRisorsa != null){&#xD;
	localRequest.IDRisorsa = IDRisorsa;&#xD;
	localRequest.ordine.IDRisorsa = IDRisorsa;&#xD;
	localRequest.ordine.IDRisorsaNOW = IDRisorsaNow;&#xD;
	Process.auditLog(&quot;IDRIsorsa non rigenerato: &quot;+IDRisorsa);&#xD;
	Process.auditLog(&quot;IDRIsorsaNOW non rigenerato: &quot;+IDRisorsaNow);&#xD;
	GeneraNuovoIDRisorsa = false;&#xD;
}&#xD;
else{&#xD;
	GeneraNuovoIDRisorsa = true;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
