        <xpdl2:Transition Id="_AsLWcLI7EeuucNa3ECxjEA" xpdExt:DisplayName="" Name="" From="_mC4rALI3EeuucNa3ECxjEA" To="_7aZ60LI6EeuucNa3ECxjEA">
          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">var skipInvioConsuntivo = false;&#xD;
&#xD;
&#xD;
//SM_9991 quando REGOLATORIO &amp;&amp; TIPOOPA = NO, nel processo non chiamiamo JPUB per il preventivo, ma storicizziamo tutti importi a 0. Quindi, una volta ricevuto il consuntivo, non dobbiamo inviare a JPUB, ma saltare l'invio.&#xD;
//Tuttavia dobbiamo comunque tracciare il cambio di stato in INVIATOAFATTURAZIONE, poiché poi una volta ricevuto l'esito verrà messo in CHIUSO dall'orderbilling (abbiamo comunque inviato a fatturazione l'accesso sul solito invio a JPUB)&#xD;
&#xD;
if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO&#xD;
|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
{&#xD;
	var foundTIPOOPA = true;&#xD;
	foundTIPOOPA = false;&#xD;
	&#xD;
	var foundCONTRIBUTOCLIENTE = true;&#xD;
	foundCONTRIBUTOCLIENTE = false;&#xD;
	&#xD;
	var TIPOOPA = &quot;&quot;;&#xD;
	var CONTRIBUTOCLIENTE = &quot;&quot;;&#xD;
&#xD;
	var i = 0;&#xD;
	&#xD;
	while((!foundTIPOOPA || !foundCONTRIBUTOCLIENTE) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUOPERESPECIALI)&#xD;
		{&#xD;
			var j = 0;&#xD;
			&#xD;
			while((!foundTIPOOPA || !foundCONTRIBUTOCLIENTE) &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOOPA)&#xD;
				{&#xD;
					foundTIPOOPA = true;&#xD;
					TIPOOPA = currentAttDettOrdine.valoreAttributo;&#xD;
					&#xD;
					Process.auditLog(&quot;TIPOOPA: &quot;+ TIPOOPA);&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CONTRIBUTOCLIENTE)&#xD;
				{&#xD;
					foundCONTRIBUTOCLIENTE = true;&#xD;
					CONTRIBUTOCLIENTE = currentAttDettOrdine.valoreAttributo;&#xD;
					&#xD;
					Process.auditLog(&quot;CONTRIBUTOCLIENTE: &quot;+ CONTRIBUTOCLIENTE);&#xD;
				}&#xD;
				&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO &amp;&amp; TIPOOPA == 'NO')&#xD;
	{&#xD;
		skipInvioConsuntivo = true;&#xD;
	}&#xD;
	else if((localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
		|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
		&amp;&amp; TIPOOPA == 'NO' &amp;&amp; CONTRIBUTOCLIENTE == 'NO')&#xD;
	{&#xD;
		skipInvioConsuntivo = true;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
skipInvioConsuntivo;</xpdl2:Expression></xpdl2:Condition>
