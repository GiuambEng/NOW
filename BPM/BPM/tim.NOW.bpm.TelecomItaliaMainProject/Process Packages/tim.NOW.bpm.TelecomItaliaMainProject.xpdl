        <xpdl2:Activity Id="_NMzDBPRZEeazKYdqUBpQKA" Name="VerificaConsistenzaAllineata" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Consistenza Allineata" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">esitoVerificaConsistenzaAllineata = true;&#xD;
&#xD;
var assetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(IDAsset));&#xD;
&#xD;
var asset = assetRef.readAsset();&#xD;
&#xD;
var tipoLineaAsset = &quot;&quot;;&#xD;
tipoLineaAsset = null;&#xD;
var i=0;&#xD;
while(tipoLineaAsset == null &amp;&amp; i&lt;asset.dettaglioasset.size())&#xD;
{&#xD;
	var comp = asset.dettaglioasset.get(i);&#xD;
	if(String(comp.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
		var j=0;&#xD;
		while(tipoLineaAsset == null &amp;&amp; j&lt;comp.attributidettaglioasset.size()){&#xD;
			if(comp.attributidettaglioasset.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
				tipoLineaAsset =comp.attributidettaglioasset.get(j).valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
if(tipoLineaAsset!= null){&#xD;
	if(localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;){&#xD;
		esitoVerificaConsistenzaAllineata = (tipoLineaAsset == &quot;LineaNonFonia&quot;);&#xD;
	}&#xD;
	else if(localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot;){&#xD;
		esitoVerificaConsistenzaAllineata = (tipoLineaAsset != &quot;LineaNonFonia&quot;);&#xD;
	}	&#xD;
}&#xD;
else &#xD;
{&#xD;
	Process.auditLog(&quot;tipoLinea dell'asset non trovata, IDAsset: &quot;+IDAsset);&#xD;
	esitoVerificaConsistenzaAllineata = false;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="81.0" LaneId="_NMzqGfRZEeazKYdqUBpQKA" Width="111.0">
              <xpdl2:Coordinates XCoordinate="941.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
