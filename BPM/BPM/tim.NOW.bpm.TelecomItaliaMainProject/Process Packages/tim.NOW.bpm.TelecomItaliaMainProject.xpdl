                  <xpdl2:Actual ScriptGrammar="JavaScript">if(localRequest.tipoComunicazioneNP==it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PORTIN)&#xD;
{&#xD;
