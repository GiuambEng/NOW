        <xpdl2:Activity Id="_oKrznXIzEe2oK8wKjP8xaw" Name="NotificaversoOLO" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Notifica verso OLO">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_l-ElkAOpEeaIdPdRimpTnw" PackageRef="tim.NOW.bpm.TelecomItaliaNotification" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaOLODestinatario">
                  <xpdExt:ScriptInformation Id="_oKrznnIzEe2oK8wKjP8xaw" Name="DONATING"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var destinatario = &quot;DONATING&quot;;&#xD;
&#xD;
destinatario;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="Requestref">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaNotifica">
                  <xpdExt:ScriptInformation Id="_oKrzn3IzEe2oK8wKjP8xaw" Name="Tipo"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;TC3&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="Requestref">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="CodificaOLOAGCOM">
                  <xpdExt:ScriptInformation Id="_oKrzoHIzEe2oK8wKjP8xaw" Name="OLORetailer"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var OLORetailer=&quot;&quot;;&#xD;
&#xD;
for (var i=0;i&lt;NumberPortability.size();i++){&#xD;
	if (NumberPortability.get(i).OLORetailer != &quot;&quot; &amp;&amp; NumberPortability.get(i).OLORetailer != null){&#xD;
		OLORetailer=NumberPortability.get(i).OLORetailer;&#xD;
		Process.auditLog(&quot;OLORetailer = &quot;+NumberPortability.get(i).OLORetailer+&quot; &quot;+i);&#xD;
		}&#xD;
} &#xD;
&#xD;
OLORetailer;&#xD;
&#xD;
</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="94.0" LaneId="_Q_PNMXIeEe2oK8wKjP8xaw" Width="128.0">
              <xpdl2:Coordinates XCoordinate="3668.0" YCoordinate="907.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeExternalService/Process Packages/tim.NOW.bpm.invokeExternalService.OLO.xpdl.TINOWNotificaOLO&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">DataInvioTC3 = DateTimeUtil.createDate(); //SM_10848&#xD;
&#xD;
//SM_11024: se abbiamo superato l'orario di chiusura della finestra temporale di invio notifiche ad OLO (limite di FENP), allora esse verranno inviate il giorno dopo, motivo per cui va considerata come data per far scattare il Timer di silenzio/assenso la DataInvioTC3 (cioè la data di chiamata al notification) + 1 giorno (che è quando effettivamente vengono inviate le notifiche)&#xD;
var currentTime = DateTimeUtil.createTime();&#xD;
var TimeFineInvioNotificheOLO = DateTimeUtil.createTime(&quot;18:30&quot; + &quot;:00&quot;);&#xD;
&#xD;
if(currentTime > TimeFineInvioNotificheOLO)&#xD;
{&#xD;
	DataInvioTC3.add(DateTimeUtil.createDuration(true,0,0,1,0,0,0));&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Valore provvisorio di DataInvioTC3: &quot; +String(DataInvioTC3));&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
