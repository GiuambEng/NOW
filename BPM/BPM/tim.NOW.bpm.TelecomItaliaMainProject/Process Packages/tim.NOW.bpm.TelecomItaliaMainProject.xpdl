          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">//RU_1346: NP DEL 103 per richieste a pacchetto&#xD;
//Se arriva una RIMODULAZIONEDAC su un richiesta di un pacchetto, allora vanno rimodulate TUTTE le richieste di quel pacchetto&#xD;
RichiestePacchettoRef.size()>0&#xD;
&amp;&amp;&#xD;
(&#xD;
//Non ancora inviata a DTU&#xD;
ExistingOrder.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACQUISITO&#xD;
||&#xD;
(ExistingOrder.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.LAVORAZIONEHD &amp;&amp;&#xD;
	ExistingOrder.statoRichiestaPrecedNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACQUISITO)&#xD;
||&#xD;
ExistingOrder.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.PERVENUTO&#xD;
||&#xD;
ExistingOrder.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACCETTATO &#xD;
||&#xD;
ExistingOrder.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVERIFICADONATING &#xD;
||&#xD;
//Non è una TC16 (quindi TC10 o TC17) -> va a prescindere qua; la TC16 invece dipende da se è stata o meno inviata a delivery&#xD;
localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RDACRECIPIENTDONOR&#xD;
);&#xD;
&#xD;
</xpdl2:Expression></xpdl2:Condition>
