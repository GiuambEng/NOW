                      <xpdl2:Actual ScriptGrammar="JavaScript">IDAssetConsistenzaFonia</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="IDAssetConsistenzaDati">
                      <xpdl2:Actual ScriptGrammar="JavaScript">IDAssetConsistenzaDati</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="skipRecipient">
                      <xpdExt:ScriptInformation Id="_I20K8NCpEemgNMp0cGyngw" Name="skipRecipient"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">if(FlagEseguiNotificaAnnullamento) //Aggiunta con SM_8717, prima SkipRecipient non veniva mappato mai&#xD;
{&#xD;
	true;&#xD;
}&#xD;
else&#xD;
{&#xD;
	false;&#xD;
}</xpdl2:Actual>
                    </xpdl2:DataMapping>
