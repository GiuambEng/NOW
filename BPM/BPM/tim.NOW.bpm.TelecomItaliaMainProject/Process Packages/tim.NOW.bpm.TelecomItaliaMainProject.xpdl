            <xpdl2:Activity Id="_Bm-pUBYtEeeQAYHivVqD7A" Name="CalcoloNotifiche" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcolo Notifiche">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">var ComponenteConsistenzaDati = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
var ComponenteConsistenzaFonia = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
ComponenteConsistenzaDati = null;&#xD;
ComponenteConsistenzaFonia = null;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	var i=0;&#xD;
	&#xD;
	while((ComponenteConsistenzaDati==null || ComponenteConsistenzaFonia==null) &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
		{&#xD;
			ComponenteConsistenzaDati = ScriptUtil.copy(comp);&#xD;
			var j=0;&#xD;
			var trovato = false;&#xD;
			while(j&lt;ComponenteConsistenzaDati.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = 	ComponenteConsistenzaDati.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING)&#xD;
				{&#xD;
					trovato=true;&#xD;
					CODIFICAOLOAGCOMDONATINGConsistenzaDati = String(attr.valoreAttributo);&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					IDAssetConsistenzaDati = String(attr.valoreAttributo);&#xD;
				}&#xD;
			j++;&#xD;
			}		&#xD;
		} &#xD;
		else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			ComponenteConsistenzaFonia = ScriptUtil.copy(comp);&#xD;
			var j=0;&#xD;
			var trovato = false;&#xD;
			while(j&lt;ComponenteConsistenzaFonia.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = 	ComponenteConsistenzaFonia.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING)&#xD;
				{&#xD;
					trovato=true;&#xD;
					CODIFICAOLOAGCOMDONATINGConsistenzaFonia = String(attr.valoreAttributo);&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					IDAssetConsistenzaFonia = String(attr.valoreAttributo);&#xD;
				}&#xD;
			j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(ComponenteConsistenzaDati != null&#xD;
&amp;&amp; CODIFICAOLOAGCOMDONATINGConsistenzaDati != &quot;TLC&quot;&#xD;
&amp;&amp; localRequest.codificaOLOAGCOM != CODIFICAOLOAGCOMDONATINGConsistenzaDati)&#xD;
{&#xD;
	eseguitoCodiceSessioneConsDati = true;&#xD;
	Process.auditLog(&quot;EseguiCodiceSessioneDati con idasset: &quot;+IDAssetConsistenzaDati);&#xD;
}&#xD;
else if(ComponenteConsistenzaFonia!= null&#xD;
&amp;&amp; CODIFICAOLOAGCOMDONATINGConsistenzaFonia != &quot;TLC&quot;&#xD;
&amp;&amp; localRequest.codificaOLOAGCOM != CODIFICAOLOAGCOMDONATINGConsistenzaFonia)&#xD;
{&#xD;
	eseguitoCodiceSessioneConsFonia = true;&#xD;
	Process.auditLog(&quot;EseguiCodiceSessioneDati con idasset: &quot;+IDAssetConsistenzaFonia);&#xD;
}</xpdl2:Script>
                  </xpdl2:TaskScript>
                </xpdl2:Task>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="68.0" Width="99.0">
                  <xpdl2:Coordinates XCoordinate="1920.0" YCoordinate="112.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:ActivityResourcePatterns>
                <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
              </xpdExt:ActivityResourcePatterns>
            </xpdl2:Activity>
