        <xpdl2:Activity Id="_NMzDEPRZEeazKYdqUBpQKA" Name="GenerateIDResource" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="GenerateIDResource">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_q6tyUIF3Eea1BcUITTCQOA" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_NMzqGfRZEeazKYdqUBpQKA" Width="128.0">
              <xpdl2:Coordinates XCoordinate="1724.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.GenerateIDResource&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot; || localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot;)&#xD;
{&#xD;
	var idx = 1; //Progressivo&#xD;
	var i = 0;&#xD;
	while(i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var compOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(compOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || &#xD;
		   compOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC ||&#xD;
		   compOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(j &lt; compOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attrOrdine = compOrdine.attributiDettaglioOrdine.get(j);&#xD;
				if(attrOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAVC || &#xD;
				   attrOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAUSERVLAN)&#xD;
				{&#xD;
					var idxlen = idx.toString();&#xD;
					&#xD;
					if(idxlen.length == 1)&#xD;
					{	&#xD;
						idxlen = &quot;000&quot; + idx;&#xD;
					}&#xD;
					else if(idxlen.length == 2)&#xD;
					{&#xD;
						idxlen = &quot;00&quot; + idx;&#xD;
					}&#xD;
					else if(idxlen.length == 3)&#xD;
					{&#xD;
						idxlen = &quot;0&quot; + idx;&#xD;
					}&#xD;
					idx++;&#xD;
					attrOrdine.valoreAttributo = localRequest.IDRisorsa + &quot;/&quot; + idxlen;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
	 	}&#xD;
		i++;&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
