        <xpdl2:Activity Id="_82mnaXbCEeeHqtzCIDiTgA" Name="calcDeadline" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="calc Deadline">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_TiXYQOl0EeabDOcEQPWpDw" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="duration">
                  <xpdExt:ScriptInformation Id="_82mnanbCEeeHqtzCIDiTgA" Name="duration">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if(localRequest.tipologiaScenario==it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUTIF)&#xD;
{	&quot;P1DT23H&quot;;&#xD;
}&#xD;
else&#xD;
{		var i = 0;&#xD;
		var tipoLineaOrdine=&quot;&quot;;&#xD;
		var strutturaLineaOrdine=&quot;&quot;;&#xD;
		while(i &lt; localRequest.ordine.dettaglioordine.size() &amp;&amp; (tipoLineaOrdine==&quot;&quot; || strutturaLineaOrdine==&quot;&quot;))&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(String(currentDettOrdine.nomeComponente).slice(0,7)==&quot;ACCESSO&quot;)&#xD;
			{	var j=0;&#xD;
				while(j &lt; currentDettOrdine.attributiDettaglioOrdine.size() &amp;&amp; (tipoLineaOrdine==&quot;&quot; || strutturaLineaOrdine==&quot;&quot;))&#xD;
				{ 	var currentAttrDettOrdine=currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					if(currentAttrDettOrdine.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{	tipoLineaOrdine=currentAttrDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAttrDettOrdine.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
