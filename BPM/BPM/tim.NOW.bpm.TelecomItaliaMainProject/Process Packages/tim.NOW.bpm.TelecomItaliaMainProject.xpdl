        <xpdl2:Activity Id="_AqePIWVAEeugIsiojhr-dg" Name="CalcTimeout" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Calc Timeout" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//SM_9757&#xD;
var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key=:inputKey&quot;);&#xD;
criteria.setQueryParameter(&quot;inputKey&quot;,&quot;TIMEOUT_ORD_B2B&quot;);&#xD;
var configurations = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(criteria);&#xD;
&#xD;
if(configurations != null &amp;&amp; configurations.size() > 0)&#xD;
{&#xD;
	configuration = configurations.get(0).readConfiguration();&#xD;
	var confLength = configuration.value.length;&#xD;
		&#xD;
	Process.auditLog(&quot;Recuperata Configurazione: &quot; + configuration.value);&#xD;
	var Days = configuration.value;&#xD;
&#xD;
&#xD;
	if(!isNaN(Days))&#xD;
	{&#xD;
		GiorniDiAttesaTimeout = parseInt(Days, 10);&#xD;
	}&#xD;
}&#xD;
else //Default&#xD;
{&#xD;
	GiorniDiAttesaTimeout = parseInt(180, 10);&#xD;
}&#xD;
&#xD;
timeout = DateTimeUtil.createDatetime();&#xD;
timeout.add(DateTimeUtil.createDuration(true,0,0,GiorniDiAttesaTimeout,0,0,0));&#xD;
&#xD;
Process.auditLog(String(timeout));</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_HXAg4ZjiEeqylJJx26bO0Q" Width="96.0">
              <xpdl2:Coordinates XCoordinate="1155.0" YCoordinate="363.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
