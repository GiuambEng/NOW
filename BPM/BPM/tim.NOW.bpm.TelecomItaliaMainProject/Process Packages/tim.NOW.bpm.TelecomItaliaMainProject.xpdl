            <xpdl2:Activity Id="_6TNTFMTQEe2uWMPWs6HAZA" Name="Tracciamento10" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Tracciamento10">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_3MBOcO08EeaHW9ek9Jg1tw" PackageRef="tim.NOW.bpm.CasedataTracking.Interfaces" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
                  <xpdl2:DataMappings>
