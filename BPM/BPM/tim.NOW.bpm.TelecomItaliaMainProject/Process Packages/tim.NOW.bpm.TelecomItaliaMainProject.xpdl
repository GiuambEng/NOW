        <xpdl2:Activity Id="_pRjH0on8Eeq4Stnx9TP1Mw" Name="CalcTimeout" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Calc Timeout">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//RU_975&#xD;
var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key=:inputKey&quot;);&#xD;
criteria.setQueryParameter(&quot;inputKey&quot;,&quot;VerificaPrenotificaCPS_timeout&quot;);&#xD;
var configurations = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(criteria);&#xD;
&#xD;
if(configurations != null &amp;&amp; configurations.size() > 0)&#xD;
{&#xD;
	configuration = configurations.get(0).readConfiguration();&#xD;
	var confLength = configuration.value.length;&#xD;
		&#xD;
	Process.auditLog(&quot;Recuperata Configurazione: &quot; + configuration.value);&#xD;
	var Days = configuration.value;&#xD;
&#xD;
&#xD;
	if(!isNaN(Days))&#xD;
	{&#xD;
		GiorniDiAttesaPrenotifica = parseInt(Days, 10);&#xD;
	}&#xD;
}&#xD;
&#xD;
timeout = DateTimeUtil.createDatetime();&#xD;
timeout.add(DateTimeUtil.createDuration(true,0,0,GiorniDiAttesaPrenotifica,0,0,0));</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_-0xoZhzSEeqbfuVd2xGyJQ" Width="96.0">
              <xpdl2:Coordinates XCoordinate="2469.0" YCoordinate="370.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
