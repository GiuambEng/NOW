        </xpdl2:Transition>
        <xpdl2:Transition Id="_OTs_UQJCEeaPBpRvSvxznA" xpdExt:DisplayName="" Name="" From="_UC1XMIvhEeaDmJEDSrf-Fg" To="_teOVgY-cEeaUz-vG_2Hovw">
          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var result = false;&#xD;
&#xD;
if ((localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH &amp;&amp;&#xD;
	localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB &amp;&amp;&#xD;
	localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH &amp;&amp;    //RU_1164&#xD;
	localRequest.tipoRichiesta!= it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.RICARICA)&#xD;
	//SM_7927 EVO C10 - aggiunta condizione per cessare consistenza diversa da EASY IP UBB in ordini di migrazione&#xD;
	||&#xD;
	((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH ||&#xD;
	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB ||&#xD;
	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH) &amp;&amp;   //RU_1164&#xD;
	(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
	))&#xD;
{&#xD;
&#xD;
	if(localRequest.codificaOLOAGCOM != &quot;TLC&quot;)&#xD;
	{&#xD;
		result = true;&#xD;
	}&#xD;
	else if (localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.CNPCROLO) // Bug redmine #21289&#xD;
	{&#xD;
		result = true;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		var i = 0;&#xD;
		while(!result &amp;&amp; i &lt; AssetAggiuntiviList.size())&#xD;
		{&#xD;
			if(AssetAggiuntiviList.get(i).codificaOLOAGCOM != &quot;TLC&quot;)&#xD;
			{&#xD;
				result = true;&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		var i = 0;&#xD;
		while(!result &amp;&amp; i &lt; AssetCessatiList.size())&#xD;
		{&#xD;
			if(AssetCessatiList.get(i).codificaOLOAGCOM != &quot;TLC&quot;)&#xD;
			{&#xD;
				result = true;&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		var i = 0;&#xD;
		while(!result &amp;&amp; i &lt; AssetModificatiList.size())&#xD;
		{&#xD;
			if(AssetModificatiList.get(i).codificaOLOAGCOM != &quot;TLC&quot;)&#xD;
			{&#xD;
				result = true;&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
// Inibizione alllineamento per TIPO LINEA = ISDN/STRUTTURA LINEA=BRA MULTI, offerta VULL&#xD;
// &quot;Task inibizione Allineamento OGG per VULL ISDN BRA MULTI ( Ex SM_8392) - EVO C04&quot;&#xD;
var inibizione = false;&#xD;
&#xD;
//R1I-22-0106: inibito per tutte le offerte, tranne VLAN e NPNG&#xD;
if(localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN&#xD;
&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANVULA&#xD;
&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VP&#xD;
&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NPNG)&#xD;
{&#xD;
	inibizione = true;&#xD;
}&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL)&#xD;
{&#xD;
	var k = 0;&#xD;
	var AccessoTrovato = false;&#xD;
	var TipoLineaTrovato = false;&#xD;
	var currentTipoLinea = &quot;&quot;;&#xD;
	var StrutturaLineaTrovato = false;&#xD;
	var currentStrutturaLinea = &quot;&quot;;&#xD;
	&#xD;
	while(!AccessoTrovato &amp;&amp; k &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(k);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULL)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(!TipoLineaTrovato &amp;&amp; !StrutturaLineaTrovato &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					currentTipoLinea = String(attributo.valoreAttributo);&#xD;
					Process.auditLog(&quot;Trovato Tipo Linea &quot;+currentTipoLinea);&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
				{&#xD;
					currentStrutturaLinea = String(attributo.valoreAttributo);&#xD;
					Process.auditLog(&quot;Trovato Struttura Linea &quot;+currentStrutturaLinea);&#xD;
				}&#xD;
				&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		k++;&#xD;
	}&#xD;
	&#xD;
	if(currentTipoLinea == 'ISDN' &amp;&amp; currentStrutturaLinea == 'BRA MULTI')&#xD;
	{&#xD;
		inibizione = true;&#xD;
		Process.auditLog(&quot;Inibito Allineamento OGG: offerta VULL, Tipo Linea &quot;+currentTipoLinea+&quot;, Struttura Linea &quot;+currentStrutturaLinea+&quot;.&quot;);&#xD;
	}&#xD;
}&#xD;
//RU_1150&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON         &#xD;
        ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON&#xD;
		||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE         //RU_1180: MULTICAST&#xD;
		||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER&#xD;
		||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT)&#xD;
{&#xD;
	inibizione = true;&#xD;
	Process.auditLog(&quot;Inibito Allineamento OGG: offerta &quot; +String(localRequest.offerta)+ &quot;.&quot;);&#xD;
}&#xD;
	&#xD;
&#xD;
result &amp;&amp; !inibizione;</xpdl2:Expression>
</xpdl2:Condition>
