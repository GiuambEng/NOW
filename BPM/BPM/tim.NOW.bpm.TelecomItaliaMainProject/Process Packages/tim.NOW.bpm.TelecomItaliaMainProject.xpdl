          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;Richiesta&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">StrippedRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="FlagAggiornaContatori">
                  <xpdExt:ScriptInformation Id="_kVqrwZjmEeqylJJx26bO0Q" Name="Script1">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">true;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">StrippedRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="80.0" LaneId="_HXAg4ZjiEeqylJJx26bO0Q" Width="128.0">
              <xpdl2:Coordinates XCoordinate="758.0" YCoordinate="104.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">//Updating the statorichestaNOW with SCARTATO&#xD;
localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
&#xD;
localRequest.statoRichiestaNOW=it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATOB2B;&#xD;
localRequest.statoRichiestaOLO=it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ACQUISITOKO; //SM_9546: da SCARTATO a ACQUISITOKO&#xD;
&#xD;
&#xD;
StrippedRequest = ScriptUtil.copy(localRequest);&#xD;
StrippedRequest.ordine = null;&#xD;
&#xD;
//SM_9371: se lo scarto arriva direttamente dal servizio B2B/FastData, non creiamo la struttura ControlloFalito, e di conseguenza non saltiamo l'invio a DTU/ArricchimentiComuni, quindi la creiamo manualmente noi&#xD;
if(ScartoFastData == &quot;SCARTO&quot; &amp;&amp; ControlloFallito == null)&#xD;
{&#xD;
	ControlloFallito = com_tim_NOW_xsd_ControlliAmmessi_Factory.createLista_Controlli();&#xD;
	ControlloFallito.cod_Causale = '';&#xD;
	ControlloFallito.id_Causale = 155;&#xD;
	ControlloFallito.codice_Controllo = &quot;FASTDATAB2B&quot;;&#xD;
	ControlloFallito.mesaggio_Scarto = &quot;SCARTO DIRETTAMENTE DA FASTDATAB2B&quot;;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_kVqrwpjmEeqylJJx26bO0Q" Name="Tracciamento1" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Tracciamento1">
