		{&#xD;
			localRequestIndottaDati.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA;&#xD;
		}&#xD;
	}&#xD;
	else{&#xD;
		localRequestIndottaDati.offerta = assetConsistenzaDati.offerta;&#xD;
	}&#xD;
	&#xD;
	localRequestIndottaDati.IDOfferta = assetConsistenzaDati.IDOfferta;&#xD;
&#xD;
	if(listaOfferteNGA.contains(String(assetConsistenzaDati.offerta))){&#xD;
		localRequestIndottaDati.strutturaRichiesta = it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA;&#xD;
	}&#xD;
	else if(listaOfferteXDSL.contains(String(assetConsistenzaDati.offerta))){&#xD;
		localRequestIndottaDati.strutturaRichiesta = it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL;&#xD;
	}&#xD;
	else{&#xD;
		localRequestIndottaDati.strutturaRichiesta = it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO;&#xD;
	}&#xD;
&#xD;
	if(localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;&#xD;
	|| localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;){&#xD;
		localRequestIndottaDati.numeroTelefonico = localRequest.numeroTelefonico;&#xD;
	}&#xD;
&#xD;
	if(localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;){&#xD;
		localRequestIndottaDati.IDRisorsaCorrelato = localRequest.IDRisorsa;&#xD;
	}&#xD;
	&#xD;
	//Prepara Ordine&#xD;
	localRequestIndottaDati.ordine.codificaOLOAGCOM = localRequestIndottaDati.codificaOLOAGCOM;	&#xD;
	localRequestIndottaDati.ordine.offerta = localRequestIndottaDati.offerta;&#xD;
	&#xD;
	//tipologiaAccesso	&#xD;
	if(localRequestIndottaDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP){&#xD;
		localRequestIndottaDati.ordine.tipologiaAccesso = it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIADATI;&#xD;
	}&#xD;
	else if(listaOfferteFONIA.contains(String(localRequestIndottaDati.offerta))){&#xD;
		localRequestIndottaDati.ordine.tipologiaAccesso = it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA;&#xD;
	}&#xD;
	else{&#xD;
		localRequestIndottaDati.ordine.tipologiaAccesso = it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.DATI;&#xD;
	}&#xD;
	&#xD;
	//tipologiaSottolav&#xD;
	if(localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;){&#xD;
		localRequestIndottaDati.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PASSAGGIOLA;&#xD;
	}&#xD;
	else if(localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot;){&#xD;
		localRequestIndottaDati.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PASSAGGIOLNF;&#xD;
	}&#xD;
	else if(localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;){&#xD;
		localRequestIndottaDati.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PASSAGGIOULLD;&#xD;
	}&#xD;
