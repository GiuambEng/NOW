      <xpdl2:Activities>
        <xpdl2:Activity Id="_OTs_IQJCEeaPBpRvSvxznA" Name="StartEventAcquisizioneRichiestaMaster" xpdExt:DisplayName="Start EventAcquisizione Richiesta Master" xpdExt:Visibility="Private">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="192,192,192" Height="112.0" LaneId="_OTs_cwJCEeaPBpRvSvxznA" Width="122.0">
              <xpdl2:Coordinates XCoordinate="181.0" YCoordinate="577.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:AssociatedParameters DisableImplicitAssociation="false">
            <xpdExt:AssociatedParameter FormalParam="localRequest" Mode="INOUT" Mandatory="false"/>
            <xpdExt:AssociatedParameter FormalParam="localRequestCancellation" Mode="INOUT" Mandatory="false"/>
            <xpdExt:AssociatedParameter FormalParam="referenteAltreLavorazioni" Mode="IN" Mandatory="false"/>
            <xpdExt:AssociatedParameter FormalParam="AcquisitionID" Mode="IN" Mandatory="false"/>
            <xpdExt:AssociatedParameter FormalParam="BusinessID" Mode="IN" Mandatory="false"/>
            <xpdExt:AssociatedParameter FormalParam="InternalB2B" Mode="IN" Mandatory="false"/>
            <xpdExt:AssociatedParameter FormalParam="esitoCPS" Mode="IN" Mandatory="false"/>
            <xpdExt:AssociatedParameter FormalParam="IDEsec" Mode="IN" Mandatory="false"/>
            <xpdExt:AssociatedParameter FormalParam="ScartoFastData" Mode="IN" Mandatory="false"/>
            <xpdExt:AssociatedParameter FormalParam="numeroRecordCSV" Mode="IN" Mandatory="false"/>
          </xpdExt:AssociatedParameters>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">//Correlation_CodiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
if(localRequest.testMode == &quot;BONIFICA_NOMAIN&quot;)&#xD;
{&#xD;
	Process.auditLog(&quot;Ingressata la richiesta: &quot; + localRequest.IDRichiestaOLO + &quot; per bonifica NOMAIN&quot;);&#xD;
	Correlation_IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
}&#xD;
//SM_11346&#xD;
else if(localRequest.testMode == &quot;BONIFICA_NOMAIN_OF&quot;)&#xD;
{&#xD;
	Process.auditLog(&quot;Ingressata la richiesta: &quot; + localRequest.IDRichiestaOLO + &quot; per bonifica NOMAIN OF&quot;);&#xD;
	Correlation_IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
}&#xD;
else&#xD;
{&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
InternalProcessData = it_telecomitalia_it_NOW_localbom_Factory.createInternalProcessdata();&#xD;
InternalProcessData.counter=0;&#xD;
&#xD;
var processID = Process.getId();&#xD;
Correlation_IDRichiestaOLO = processID;&#xD;
&#xD;
localRequest.IDRichiestaOLO = processID;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE		//SM_11653&#xD;
&amp;&amp; (localRequest.flagMigDel82 == &quot;SI&quot; || localRequest.flagRientriDel82 == &quot;SI&quot;))  //RU_RIENTRIDEL82&#xD;
{&#xD;
	localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOD82;&#xD;
	localRequest.statoRichiestaPrecedNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOD82;&#xD;
}&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ESECUZIONE&#xD;
&amp;&amp; localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATOB2B) //SM_9320 - FASTDATA, in caso di ESECUZIONE inviata direttamente in ANNULLATO bisogna solo creare la richiesta sulla BDS e non fare nient'altro&#xD;
{&#xD;
	localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATOB2B;&#xD;
	localRequest.statoRichiestaPrecedNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATOB2B;&#xD;
}&#xD;
else if(!((localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
              ||localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FIBERSTREAM) //RU_1463&#xD;
          &amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.B2B))&#xD;
{&#xD;
	localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.PERVENUTO;&#xD;
	localRequest.statoRichiestaPrecedNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.PERVENUTO;&#xD;
}&#xD;
else // RU_989 - FASTDATA&#xD;
{&#xD;
	localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.PERVENUTOB2B;&#xD;
	localRequest.statoRichiestaPrecedNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.PERVENUTOB2B;&#xD;
}&#xD;
&#xD;
localRequest.created = date;&#xD;
localRequest.lastUpdate = date;&#xD;
localRequest.progressivoEmissioneDTU = 1;&#xD;
localRequest.flagAttesaDesospOLO='NO';&#xD;
localRequest.flagDeliveryExposed='Y';&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.PORTIN&#xD;
	|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.PRENOTIFICADONATING)&#xD;
{&#xD;
	localRequest.lavorazione = it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE;&#xD;
	if(localRequest.ordine != null)&#xD;
	{&#xD;
		localRequest.ordine.tipologiaLavorazione = it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	localRequest.ordine.IDRichiestaOLO = processID;&#xD;
	&#xD;
	if(localRequest.ordine.dettaglioordine != null &amp;&amp; localRequest.ordine.dettaglioordine.size() > 0)&#xD;
	{&#xD;
		for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var dettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
			dettOrd.IDRichiestaOLO = processID;&#xD;
			dettOrd.integrationID = processID + i;&#xD;
			&#xD;
			//Per Richieste provenienti da FILE ricalcolo l'IDDettaglioOrdine per eliminare eventuali buchi nella progressione&#xD;
			if(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.FILE)&#xD;
			{&#xD;
				dettOrd.IDDettaglioOrdine = i + 1;&#xD;
			}&#xD;
			&#xD;
			if(dettOrd.attributiDettaglioOrdine != null &amp;&amp; dettOrd.attributiDettaglioOrdine.size() > 0)&#xD;
			{&#xD;
				for(var j = 0; j &lt; dettOrd.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = dettOrd.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					dettOrd.attributiDettaglioOrdine.get(j).IDRichiestaOLO = processID;&#xD;
					dettOrd.attributiDettaglioOrdine.get(j).IDDettaglioOrdine = dettOrd.IDDettaglioOrdine;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(localRequest.ordine.sede != null &amp;&amp; localRequest.ordine.sede.size() > 0)&#xD;
	{&#xD;
		for(var i = 0; i &lt; localRequest.ordine.sede.size(); i++)&#xD;
		{&#xD;
			localRequest.ordine.sede.get(i).IDRichiestaOLO = processID;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(localRequest.ordine.referente != null &amp;&amp; localRequest.ordine.referente.size() > 0)&#xD;
	{&#xD;
		for(var i = 0; i &lt; localRequest.ordine.referente.size(); i++)&#xD;
		{&#xD;
			localRequest.ordine.referente.get(i).IDRichiestaOLO = processID;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(localRequestCancellation != null)&#xD;
{&#xD;
	localRequestCancellation.IDRichiestaOLO = processID + '_ANN';&#xD;
	localRequestCancellation.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.PERVENUTO;&#xD;
	localRequestCancellation.statoRichiestaPrecedNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.PERVENUTO;&#xD;
	localRequestCancellation.created = date;&#xD;
	localRequestCancellation.lastUpdate = date;&#xD;
	localRequestCancellation.progressivoEmissioneDTU = 1;&#xD;
}&#xD;
&#xD;
//Creo ordine in caso di lavorazione cessazione&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE){&#xD;
		if(localRequest.ordine == null)&#xD;
		{&#xD;
			//creo ordine se non c'è&#xD;
			var ordine = it_telecomitalia_it_NOW_casedata_Factory.createOrdine();&#xD;
			ordine.created = date;&#xD;
			ordine.codificaOLONOW = localRequest.codificaOLONOW;&#xD;
			ordine.codificaOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
			ordine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			ordine.tipologiaLavorazione = localRequest.lavorazione;&#xD;
			ordine.offerta = localRequest.offerta;&#xD;
			localRequest.ordine = ScriptUtil.copy(ordine);&#xD;
		}&#xD;
}&#xD;
}&#xD;
&#xD;
//RU_761 AGGIUNTO PARAMETER Acquisition ID&#xD;
if (AcquisitionID != null &amp;&amp; AcquisitionID != &quot;&quot;)&#xD;
{&#xD;
	Process.auditLog(&quot;AcquisitionID: &quot; +AcquisitionID);&#xD;
}&#xD;
&#xD;
if(BusinessID != null &amp;&amp; BusinessID != &quot;&quot;)&#xD;
{&#xD;
	Process.auditLog(&quot;BusinessID: &quot; +BusinessID);&#xD;
}&#xD;
&#xD;
//SM_8776 e SM_8773&#xD;
if(InternalB2B != null &amp;&amp; InternalB2B != &quot;&quot;)&#xD;
{&#xD;
	Process.auditLog(&quot;InternalB2B: &quot; +InternalB2B);&#xD;
}&#xD;
&#xD;
//RU_915&#xD;
if(esitoCPS != null &amp;&amp; esitoCPS != &quot;&quot;)&#xD;
{&#xD;
	Process.auditLog(&quot;esitoCPS: &quot; +esitoCPS);&#xD;
}&#xD;
&#xD;
//RU_989&#xD;
if(IDEsec != null &amp;&amp; IDEsec != &quot;&quot;)&#xD;
{&#xD;
	Process.auditLog(&quot;IDEsec: &quot; +IDEsec);&#xD;
}&#xD;
&#xD;
//SM_9320&#xD;
if(ScartoFastData != null &amp;&amp; ScartoFastData != &quot;&quot;)&#xD;
{&#xD;
	Process.auditLog(&quot;ScartoFastData: &quot; +ScartoFastData);&#xD;
}&#xD;
&#xD;
//RU_1180&#xD;
if(numeroRecordCSV != null &amp;&amp; numeroRecordCSV != &quot;&quot;)&#xD;
{&#xD;
	Process.auditLog(&quot;numeroRecordCSV: &quot; +numeroRecordCSV);&#xD;
}&#xD;
&#xD;
Process.priority = 310;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
