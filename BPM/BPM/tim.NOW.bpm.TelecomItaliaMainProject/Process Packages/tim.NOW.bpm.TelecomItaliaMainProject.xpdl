        <xpdl2:Activity Id="_6PsD8In8Eeq4Stnx9TP1Mw" Name="CatchGlobalRicezionePrenotificaCPS" xpdExt:Visibility="Private" xpdExt:DisplayName="Catch Global: RicezionePrenotificaCPS">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Trigger="Signal">
              <xpdl2:TriggerResultSignal xpdExt:SignalType="Global" xpdExt:EventHandlerFlowStrategy="SerializeConcurrent" CatchThrow="CATCH" Name="tim.now.bpm.signals/timNOWbpmsignals.gsd#RicezionePrenotificaCPS">
                <xpdExt:SignalData>
                  <xpdExt:CorrelationMappings>
                    <xpdExt:DataMapping Direction="OUT" Formal="Correlation_IDRichiestaOLO">
                      <xpdl2:Actual ScriptGrammar="JavaScript">CorrelationFieldIDRichiestaOLO</xpdl2:Actual>
                    </xpdExt:DataMapping>
                  </xpdExt:CorrelationMappings>
                  <xpdExt:DataMappings>
                    <xpdExt:DataMapping Direction="OUT" Formal="TipoNotifica">
                      <xpdl2:Actual ScriptGrammar="JavaScript">TipoNotifica</xpdl2:Actual>
                    </xpdExt:DataMapping>
                    <xpdExt:DataMapping Direction="OUT" Formal="EsitoTipoNotifica">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoTipoNotifica</xpdl2:Actual>
                    </xpdExt:DataMapping>
                    <xpdExt:DataMapping Direction="OUT" Formal="CodiceMotivoRifiuto">
                      <xpdl2:Actual ScriptGrammar="JavaScript">CodiceMotivoRifiuto</xpdl2:Actual>
                    </xpdExt:DataMapping>
                    <xpdExt:DataMapping Direction="OUT" Formal="IdAnagraficaCausale">
                      <xpdl2:Actual ScriptGrammar="JavaScript">IdAnagraficaCausale</xpdl2:Actual>
                    </xpdExt:DataMapping>
                  </xpdExt:DataMappings>
                </xpdExt:SignalData>
                <xpdExt:EventHandlerInitialisers Id="_FMDq4NM7EeqaRKgqTAKpnA">
                  <xpdExt:ActivityRef xpdExt:IdRef="_-6514NM6EeqaRKgqTAKpnA"/>
                </xpdExt:EventHandlerInitialisers>
                <xpdl2:Properties/>
              </xpdl2:TriggerResultSignal>
            </xpdl2:IntermediateEvent>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="72.0" LaneId="_y_hpAon8Eeq4Stnx9TP1Mw" Width="162.0">
              <xpdl2:Coordinates XCoordinate="130.0" YCoordinate="552.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">// TIPO NOTIFICA 4 ARRIVA PER LA PRIMA VOLTA&#xD;
if(TipoNotifica == '4' &amp;&amp; TIPONOTIFICA4 == null)&#xD;
{&#xD;
	TIPONOTIFICA4 = 'OK';&#xD;
	Process.auditLog(&quot;Arrivata TIPONOTIFICA4 per la prima volta&quot;);&#xD;
	&#xD;
	//IF per gestire CASO 3&#xD;
	if(CodiceMotivoRifiuto != null &amp;&amp; EsitoTipoNotifica)&#xD;
	{&#xD;
		EsitoPrenotificaCPS = true;&#xD;
		// Sulle SF è Caso 3 (Tipo Notifica 4) con esito del controllo OK, ma è assibilitabile a TipoNotifica4 Caso 2&#xD;
		Process.auditLog(&quot;CodiceMotivoRifiuto: &quot;+CodiceMotivoRifiuto+&quot;, esito: &quot;+String(EsitoTipoNotifica));&#xD;
	}&#xD;
	else if(CodiceMotivoRifiuto != null &amp;&amp; !EsitoTipoNotifica)&#xD;
	{&#xD;
		EsitoPrenotificaCPS = false;&#xD;
		Process.auditLog(&quot;CodiceMotivoRifiuto: &quot;+CodiceMotivoRifiuto+&quot;, esito: &quot;+String(EsitoTipoNotifica));&#xD;
	}&#xD;
}&#xD;
// TIPO NOTIFICA 5 ARRIVA PER LA PRIMA VOLTA&#xD;
else if(TipoNotifica == '5' &amp;&amp; TIPONOTIFICA5 == null)&#xD;
{&#xD;
	TIPONOTIFICA5 = 'OK';&#xD;
	Process.auditLog(&quot;Arrivata TIPONOTIFICA5 per la prima volta&quot;);&#xD;
	&#xD;
	//CASO 2b&#xD;
	if(CodiceMotivoRifiuto != null &amp;&amp; CodiceMotivoRifiuto != '10' &amp;&amp; CodiceMotivoRifiuto != '12')&#xD;
	{&#xD;
		if(EsitoTipoNotifica)&#xD;
		{&#xD;
			EsitoPrenotificaCPS = true;&#xD;
			Process.auditLog(&quot;CodiceMotivoRifiuto: &quot;+CodiceMotivoRifiuto+&quot;, esito: &quot;+String(EsitoTipoNotifica));&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoPrenotificaCPS = false;&#xD;
			Process.auditLog(&quot;CodiceMotivoRifiuto: &quot;+CodiceMotivoRifiuto+&quot;, esito: &quot;+String(EsitoTipoNotifica));&#xD;
		}	&#xD;
	}&#xD;
	else if(CodiceMotivoRifiuto == null)&#xD;
	{&#xD;
		EsitoPrenotificaCPS = true;&#xD;
		Process.auditLog(&quot;CodiceMotivoRifiuto non valorizzato, esito OK&quot;);&#xD;
	}&#xD;
}&#xD;
// TIPO NOTIFICA 4 ARRIVA PER LA SECONDA VOLTA&#xD;
else if(TipoNotifica == '4' &amp;&amp; TIPONOTIFICA4 == 'OK')&#xD;
{&#xD;
	EsitoPrenotificaCPS = true;&#xD;
	Process.auditLog(&quot;Arrivata TIPONOTIFICA4 per la seconda volta&quot;);&#xD;
}&#xD;
&#xD;
&#xD;
//SM_9465: valorizzazione di idAnagraficaCausale&#xD;
if(!EsitoTipoNotifica)&#xD;
{&#xD;
	localRequest.IDAnagraficaCausale = IdAnagraficaCausale;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_6PsD84n8Eeq4Stnx9TP1Mw" Name="ThrowRicezionePrenotificaCPS" xpdExt:Visibility="Private" xpdExt:DisplayName="Throw: RicezionePrenotificaCPS">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Trigger="Signal">
              <xpdl2:TriggerResultSignal CatchThrow="THROW" Name="RicezionePrenotificaCPS">
