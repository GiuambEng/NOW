          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">(localRequest.canaleRichiesta != it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL &amp;&amp;&#xD;
 (localRequest.tipologiaScenario == null || localRequest.tipologiaScenario != it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNPDEL82) &amp;&amp;&#xD;
(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
||&#xD;
localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.PRENOTIFICADONATING &#xD;
||&#xD;
