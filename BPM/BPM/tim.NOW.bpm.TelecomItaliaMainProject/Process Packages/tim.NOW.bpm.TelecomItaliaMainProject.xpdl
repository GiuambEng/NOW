        <xpdl2:Activity Id="_Eihp3BFaEey1a5PGyqnXBA" Name="CreazioneCaseOrder" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Creazione Case Order">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
