            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">timeout = DateTimeUtil.createDate(endDateTime);&#xD;
//timeout.add(DateTimeUtil.createDuration(true,0,0,1,0,0,0));</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
