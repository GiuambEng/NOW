            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="80.0" LaneId="_0-IVIYAQEeaBDPcmg1dPOQ" Width="128.0">
              <xpdl2:Coordinates XCoordinate="2569.0" YCoordinate="355.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW; &#xD;
localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
&#xD;
localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACQUISITO;&#xD;
localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ACQUISITO;&#xD;
&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
localRequest.ordine.created = date;&#xD;
localRequest.ordine.lastUpdate = date;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_xqeFgIGQEeaeStPHjHXbGA" Name="EsitoVerificatecnicheinviatodaTIRetail" FinishMode="Automatic" IsATransaction="false" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Esito Verifica tecniche  inviato da TI Retail" xpdExt:ActivityDeadlineEventId="_Z9mqYJwlEeaVttTg_VgIYQ">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="__HI7EJwgEeaVttTg_VgIYQ" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="IDRichiestaOLO">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="EsitoVerificaRichiesta">
                  <xpdl2:Actual ScriptGrammar="JavaScript">EsitoVerificheTecniche</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="DAC">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.ordine.DAC</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="CodiceRifiuto">
                  <xpdl2:Actual ScriptGrammar="JavaScript">CodiceRifiuto</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="routingNumber">
                  <xpdl2:Actual ScriptGrammar="JavaScript">routingNumberTC13</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="DAC">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.DAC</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="90.0" LaneId="_0-IVIYAQEeaBDPcmg1dPOQ" Width="137.0">
              <xpdl2:Coordinates XCoordinate="4002.0" YCoordinate="355.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">// E' necessario annullare l'IDAnagraficaCausale per permettere a BW di identificare lo scarto per KO da OLO&#xD;
localRequest.IDAnagraficaCausale = null;&#xD;
&#xD;
// RU_773 - Aggiornamento Routing Number con quello eventualmente arrivato dalla TC13&#xD;
if(routingNumberTC13 != null)&#xD;
{&#xD;
	localRequest.routingNumber = routingNumberTC13;&#xD;
	var RNtrovato = false;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER)&#xD;
				{&#xD;
					attributo.valoreAttributo = routingNumberTC13;&#xD;
					RNtrovato = true;&#xD;
					Process.auditLog(&quot;Aggiornato Routing Number con TC13: &quot;+routingNumberTC13);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if(!RNtrovato)&#xD;
			{	&#xD;
				var date = DateTimeUtil.createDatetime();&#xD;
				var attributoRN = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				&#xD;
				attributoRN.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoRN.created = date;&#xD;
				attributoRN.lastUpdate = date;&#xD;
				attributoRN.operatore = &quot;BPM&quot;;&#xD;
				attributoRN.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributoRN.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER;&#xD;
				attributoRN.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoRN.valoreAttributo = routingNumberTC13;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributoRN));&#xD;
				Process.auditLog(&quot;Aggiunto attributo Routing Number da TC13: &quot;+routingNumberTC13);&#xD;
			}	&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
