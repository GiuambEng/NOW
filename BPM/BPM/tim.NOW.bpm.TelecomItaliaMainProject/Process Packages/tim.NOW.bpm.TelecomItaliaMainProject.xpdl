        <xpdl2:Activity Id="_JeHkqhFbEey1a5PGyqnXBA" Name="GestioneNotificaOLO" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Gestione Notifica OLO">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_l-ElkAOpEeaIdPdRimpTnw" PackageRef="tim.NOW.bpm.TelecomItaliaNotification" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="Requestref">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="Requestref">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaNotifica">
                  <xpdExt:ScriptInformation Id="_JeHkqxFbEey1a5PGyqnXBA" Name="Notifica"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var NotificaDaInviare = &quot;&quot;;&#xD;
NotificaDaInviare = null;&#xD;
&#xD;
if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOADELIVERY)&#xD;
{&#xD;
	NotificaDaInviare = &quot;AC&quot;;&#xD;
}&#xD;
else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICO)&#xD;
{&#xD;
	NotificaDaInviare = &quot;OK&quot;;&#xD;
}&#xD;
else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO&#xD;
        ||localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO)&#xD;
{&#xD;
	NotificaDaInviare = &quot;KO&quot;;&#xD;
}&#xD;
&#xD;
NotificaDaInviare;</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
