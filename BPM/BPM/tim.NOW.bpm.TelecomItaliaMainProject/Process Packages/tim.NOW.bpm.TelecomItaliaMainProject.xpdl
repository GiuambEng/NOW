        <xpdl2:Activity Id="_TEw9ECAcEeuKnO8QpgAeaA" Name="TimerEvent" xpdExt:Visibility="Private" xpdExt:DisplayName="Timer Event">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Trigger="Timer">
              <xpdl2:TriggerTimer>
                <xpdl2:TimeDate/>
              </xpdl2:TriggerTimer>
            </xpdl2:IntermediateEvent>
          </xpdl2:Event>
          <xpdl2:Deadline>
            <xpdl2:DeadlineDuration ScriptGrammar="JavaScript">if(daysTimeout == null)&#xD;
{&#xD;
	//Setto il valore di default a 30 giorni&#xD;
	daysTimeout = 30;&#xD;
}&#xD;
&#xD;
if(timeout == null)&#xD;
{&#xD;
	var def = 1000 * 60 * 60 * 24 * (daysTimeout);&#xD;
	timeout = DataDesospensione;&#xD;
	timeout.add(DateTimeUtil.createDuration(parseInt(def, 10)));&#xD;
}&#xD;
&#xD;
&#xD;
if (TimeValue == null || TimeValue ==&quot;&quot;){&#xD;
	TimeValue=&quot;22:00:00&quot;;&#xD;
	}&#xD;
else&#xD;
	{&#xD;
TimeValue+=&quot;:00&quot;;&#xD;
	}&#xD;
&#xD;
Process.auditLog(&quot;Timeout : &quot;+timeout);&#xD;
Process.auditLog(&quot;TimeValue : &quot;+TimeValue);&#xD;
var timeFine = DateTimeUtil.createTime(TimeValue);&#xD;
timeoutWithTime = DateTimeUtil.createDatetime(timeout,timeFine);&#xD;
Process.auditLog(&quot;TimeoutWithTime : &quot;+timeoutWithTime);&#xD;
&#xD;
&#xD;
timeoutWithTime;&#xD;
//timeout;</xpdl2:DeadlineDuration>
          </xpdl2:Deadline>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" LaneId="_3ucpER9TEeui1oVJuBY9tg" Width="46.0">
              <xpdl2:Coordinates XCoordinate="1152.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_vmbmyyAcEeuKnO8QpgAeaA" Name="calcDeadline" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="calc Deadline">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_TiXYQOl0EeabDOcEQPWpDw" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="identifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="duration">
                  <xpdExt:ScriptInformation Id="_vmbmzCAcEeuKnO8QpgAeaA" Name="duration">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;P&quot; + (daysTimeout - 1) + &quot;DT23H&quot;;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="startDateTime">
                  <xpdExt:ScriptInformation Id="_vmbmzSAcEeuKnO8QpgAeaA" Name="startDateTime">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">DateTimeUtil.createDatetime(DataDesospensione,DateTimeUtil.createTime(4,0,0,0));</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="endDateTime">
                  <xpdl2:Actual ScriptGrammar="JavaScript">endDateTime</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="88.0" LaneId="_3ucpER9TEeui1oVJuBY9tg" Width="128.0">
              <xpdl2:Coordinates XCoordinate="828.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">identifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.calcDeadline&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">timeout = DateTimeUtil.createDate(endDateTime);&#xD;
//timeout.add(DateTimeUtil.createDuration(true,0,0,1,0,0,0));</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
      </xpdl2:Activities>
      <xpdl2:Transitions>
        <xpdl2:Transition Id="_WsFbUyAXEeuKnO8QpgAeaA" Name="" From="_3ucpEh9TEeui1oVJuBY9tg" To="_WsFbUiAXEeuKnO8QpgAeaA">
