        <xpdl2:Activity Id="_9Z-C0PnoEeemY7FIm2j5Jg" Name="CalcoloRientro" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcolo Rientro">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var foundNP = false;&#xD;
var foundRientro = false;&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
while(!foundNP &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
	{&#xD;
		foundNP = true;&#xD;
		&#xD;
		var j = 0;&#xD;
		&#xD;
		while(!foundRientro &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RIENTROTI)&#xD;
			{&#xD;
				foundRientro = true;&#xD;
				ConRientro = true;&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_0-IVIYAQEeaBDPcmg1dPOQ" Width="104.0">
              <xpdl2:Coordinates XCoordinate="166.0" YCoordinate="355.0"/>
            </xpdl2:NodeGraphicsInfo>
