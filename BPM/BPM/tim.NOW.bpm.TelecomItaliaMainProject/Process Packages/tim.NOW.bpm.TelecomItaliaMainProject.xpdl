        <xpdl2:Activity Id="_QV2kQ2oIEeqgX4-dD32nqw" Name="CallCalcolaRemoteID" xpdExt:Visibility="Private" xpdExt:DisplayName="Call CalcolaRemoteID">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_FumGMF-KEeq9DrMHh8xhhw" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
              <xpdExt:OutputMappings MapperContext="SubProcessToProcess" MappingDirection="OUT">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="SubProcessToProcess.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="LavorazioneRichiesta">
                    <xpdl2:Actual ScriptGrammar="JavaScript">LavorazioneRichiesta</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:OutputMappings>
              <xpdExt:InputMappings MapperContext="ProcessToSubProcess" MappingDirection="IN">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="localRequest">
                    <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="LavorazioneRichiesta">
                    <xpdl2:Actual ScriptGrammar="JavaScript">LavorazioneRichiesta</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="ConsistenzaDati">
                    <xpdl2:Actual ScriptGrammar="JavaScript">ConsistenzaDati</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:InputMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:Priority></xpdl2:Priority>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_NMzqGfRZEeazKYdqUBpQKA" Width="128.0">
              <xpdl2:Coordinates XCoordinate="2152.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier=&quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.CalcoloRemoteID_C01M02F27&quot;;&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
	{&#xD;
		var foundRemoteId = false;&#xD;
		var j=0;&#xD;
		&#xD;
		//SE REMOTEID ESISTE&#xD;
		while(!foundRemoteId &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.REMOTEID)&#xD;
			{&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.remoteId;&#xD;
				foundRemoteId = true;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
&#xD;
		//SE REMOTEID NON ESISTE&#xD;
		if(!foundRemoteId)&#xD;
		{&#xD;
			var AttributoRemoteId = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
		 &#xD;
			AttributoRemoteId.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			AttributoRemoteId.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			AttributoRemoteId.created = DateTimeUtil.createDatetime();&#xD;
			AttributoRemoteId.lastUpdate = DateTimeUtil.createDatetime();&#xD;
			AttributoRemoteId.operatore = &quot;BPM&quot;;&#xD;
			AttributoRemoteId.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			&#xD;
			AttributoRemoteId.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.REMOTEID;&#xD;
			AttributoRemoteId.valoreAttributo = LavorazioneRichiesta.remoteId;&#xD;
			&#xD;
			componente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoRemoteId));&#xD;
			Process.auditLog(&quot;Creato attributo REMOTEID &quot;+ LavorazioneRichiesta.remoteId +&quot; su UserVlan con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
