        <xpdl2:Activity Id="_cYBkcJBOEeqnltQFQbj_Sw" Name="NotoficationManagementOK2" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Notofication Management OK2">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_l-ElkAOpEeaIdPdRimpTnw" PackageRef="tim.NOW.bpm.TelecomItaliaNotification" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="Requestref">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="Requestref">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaNotifica">
                  <xpdExt:ScriptInformation Id="_cYBkcZBOEeqnltQFQbj_Sw" Name="Tipo"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;NC&quot;;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaOLODestinatario">
                  <xpdExt:ScriptInformation Id="_L-foIPjDEeqVRM5jvpPcNw" Name="DONATING"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;DONATING&quot;;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="idAssetConsistenza">
                  <xpdExt:ScriptInformation Id="_6kJ7gPwgEequW72Mlb7hsg" Name="idAssetConsistenza"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var idAsset = &quot;&quot;;&#xD;
idAsset = null;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentComponente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{			&#xD;
				idAsset = currentAttributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
idAsset;</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_-0xoZhzSEeqbfuVd2xGyJQ" Width="128.0">
              <xpdl2:Coordinates XCoordinate="2545.0" YCoordinate="700.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">if(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR)&#xD;
{&#xD;
	var foundAccesso = false;&#xD;
	var k = 0;&#xD;
	&#xD;
	while(!foundAccesso &amp;&amp; k&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(k);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
		{&#xD;
			foundAccesso = true;&#xD;
			&#xD;
			for(var i=0; i&lt;componente.attributiDettaglioOrdine.size(); i++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(i);	&#xD;
			&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SOTTOLAVORAZIONESDR)&#xD;
				{&#xD;
					Process.auditLog(&quot;SOTTOLAVORAZIONE SDR: &quot;+attributo.valoreAttributo);&#xD;
					&#xD;
					localRequest.codiceCausaleInterno = &quot;CPS_SDR&quot; + attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
		k++;&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
