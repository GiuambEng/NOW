          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var sendNotifyDonor = false;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	var i=0;&#xD;
	&#xD;
	while (!sendNotifyDonor &amp;&amp; i&lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if (currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			for (var j=0; j&lt;currentComponente.attributiDettaglioOrdine.size();j++)&#xD;
			{&#xD;
				var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR&#xD;
				&amp;&amp; currentAttributo.valoreAttributo != &quot;TLC&quot;)&#xD;
				{&#xD;
					sendNotifyDonor=true;&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			&#xD;
		}&#xD;
	i++;&#xD;
	}&#xD;
	&#xD;
	&#xD;
}&#xD;
&#xD;
sendNotifyDonor;</xpdl2:Expression>
</xpdl2:Condition>
