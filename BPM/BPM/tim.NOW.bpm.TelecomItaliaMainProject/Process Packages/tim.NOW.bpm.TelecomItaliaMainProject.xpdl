        <xpdl2:Activity Id="_OTs_OwJCEeaPBpRvSvxznA" Name="AggiornaRichiestainINANNULLAMENTOSUDELIVERY" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna Richiesta in &quot;IN ANNULLAMENTO SU DELIVERY&quot;">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;Richiesta&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="107.0" LaneId="_OTs_cwJCEeaPBpRvSvxznA" Width="138.0">
              <xpdl2:Coordinates XCoordinate="2598.0" YCoordinate="1870.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">localRequest = RequestRef.readRichiesta();&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
   &amp;&amp; localRequest.flagMigDel82 == &quot;SI&quot;)&#xD;
{&#xD;
	//RU_1550 - MIG DEL82&#xD;
	if(AnnullametoAutomatico)&#xD;
	{&#xD;
		if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOD82)&#xD;
		{&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOTIMEOUTSUDELIVERYD82;&#xD;
		}&#xD;
		else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOACD82)&#xD;
		{&#xD;
			localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
			localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOACSUDELIVERYD82;&#xD;
		}&#xD;
	}&#xD;
	//RU_1554: Ricezione richiesta di Annullamento DEL82&#xD;
	else&#xD;
	{&#xD;
		localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
		localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOD82;	&#xD;
		&#xD;
		localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
		localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.INANNULLAMENTO;&#xD;
	}&#xD;
}&#xD;
else //solito&#xD;
{&#xD;
	localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
	localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSULDELIVERY;&#xD;
}&#xD;
&#xD;
localRequest.flagAttesaDesospOLO = &quot;NO&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
