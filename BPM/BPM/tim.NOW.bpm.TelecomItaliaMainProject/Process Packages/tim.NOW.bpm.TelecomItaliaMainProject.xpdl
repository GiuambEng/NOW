        <xpdl2:Activity Id="_YdYqYxbGEeaeO9dGiH03ag" Name="TimerEvent" xpdExt:Visibility="Private" xpdExt:DisplayName="Timer Event">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Trigger="Timer">
              <xpdl2:TriggerTimer>
                <xpdl2:TimeDate/>
              </xpdl2:TriggerTimer>
            </xpdl2:IntermediateEvent>
          </xpdl2:Event>
          <xpdl2:Deadline>
            <xpdl2:DeadlineDuration ScriptGrammar="JavaScript">if(daysTimeout == null)&#xD;
{&#xD;
	//Setto il valore di default a 30 giorni&#xD;
	daysTimeout = 30;&#xD;
}&#xD;
&#xD;
if(timeout == null)&#xD;
{&#xD;
	var def = 1000 * 60 * 60 * 24 * (daysTimeout);&#xD;
	timeout = DataAnnullamento;&#xD;
	timeout.add(DateTimeUtil.createDuration(parseInt(def, 10)));&#xD;
}&#xD;
&#xD;
&#xD;
if (TimeValue == null || TimeValue ==&quot;&quot;){&#xD;
	TimeValue=&quot;22:00:00&quot;;&#xD;
	}&#xD;
else&#xD;
	{&#xD;
TimeValue+=&quot;:00&quot;;&#xD;
	}&#xD;
&#xD;
Process.auditLog(&quot;Timeout : &quot;+timeout);&#xD;
Process.auditLog(&quot;TimeValue : &quot;+TimeValue);&#xD;
var timeFine = DateTimeUtil.createTime(TimeValue);&#xD;
timeoutWithTime = DateTimeUtil.createDatetime(timeout,timeFine);&#xD;
Process.auditLog(&quot;TimeoutWithTime : &quot;+timeoutWithTime);&#xD;
&#xD;
&#xD;
timeoutWithTime;&#xD;
//timeout;</xpdl2:DeadlineDuration>
          </xpdl2:Deadline>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="72.0" LaneId="_YdYqbRbGEeaeO9dGiH03ag" Width="40.0">
              <xpdl2:Coordinates XCoordinate="1153.0" YCoordinate="215.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
