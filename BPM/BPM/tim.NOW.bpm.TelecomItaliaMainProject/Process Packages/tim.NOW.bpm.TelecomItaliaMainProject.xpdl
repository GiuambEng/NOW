                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ExistingOrderRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ExistingOrder</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="101.0" LaneId="_tywahQIyEeakQOuA4HJGNg" Width="171.0">
              <xpdl2:Coordinates XCoordinate="1030.0" YCoordinate="567.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ExistingOrder.flagAttesaDesospOLO='NO';&#xD;
&#xD;
//RU_1479&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FWAITALIA1GIGASARDEGNA)&#xD;
{&#xD;
	Process.auditLog(&quot;Non valorizzo IDFasciaOrariaUA, DUA e DADRimodulata in caso di offerta FWAITALIA1GIGASARDEGNA&quot;);&#xD;
}&#xD;
else //solito&#xD;
{&#xD;
	if(localRequest.IDFasciaOraria!=null &amp;&amp; localRequest.IDFasciaOraria!=&quot;&quot;)&#xD;
	{&#xD;
		ExistingOrder.ordine.IDFasciaOrariaUA = parseInt(localRequest.IDFasciaOraria);&#xD;
		Process.auditLog(&quot;Valorizzata Fascia Oraria UA dell'ordine target con &quot;+parseInt(localRequest.IDFasciaOraria));&#xD;
	}	&#xD;
	if (localRequest.ordine!= null &amp;&amp; localRequest.ordine.DADRimodulata != null &amp;&amp; localRequest.ordine.DADRimodulata !=&quot;&quot;)&#xD;
	{&#xD;
		ExistingOrder.ordine.DUA = localRequest.ordine.DADRimodulata;&#xD;
		Process.auditLog(&quot;Valorizzata DUA dell'ordine target con &quot;+String(localRequest.ordine.DADRimodulata));&#xD;
	}&#xD;
	else &#xD;
	{&#xD;
		ExistingOrder.ordine.DUA = localRequest.DAD;&#xD;
		Process.auditLog(&quot;Valorizzata DUA dell'ordine target con &quot;+String(localRequest.DAD));&#xD;
	}&#xD;
&#xD;
	//SM_8680&#xD;
	if(localRequest.DAD != null)&#xD;
	{&#xD;
		ExistingOrder.ordine.DADRimodulata = localRequest.DAD;&#xD;
		Process.auditLog(&quot;Valorizzata DADRimodulata dell'ordine target con &quot;+String(localRequest.DAD));&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
