                </xpdExt:AuditEvent>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">localRequest.IDNotificaDonating = RichiestaTempPacto.IDNotificaDonating;</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
