            <xpdl2:Activity Id="_5COW4MTREe2uWMPWs6HAZA" Name="NotificaversoOLO11" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Notifica verso OLO">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_v3JtkIFrEeaG-Y7D3-yA8Q" PackageRef="tim.NOW.bpm.invokeExternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="tipologiaOLODestinatario">
                      <xpdExt:ScriptInformation Id="_5COW4cTREe2uWMPWs6HAZA" Name="DONATING">
                        <xpdExt:Expression ScriptGrammar="JavaScript"/>
                      </xpdExt:ScriptInformation>
                      <xpdl2:Actual ScriptGrammar="JavaScript">&quot;DONATING&quot;;</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="TipologiaNotifica">
                      <xpdExt:ScriptInformation Id="_5COW4sTREe2uWMPWs6HAZA" Name="TC17">
                        <xpdExt:Expression ScriptGrammar="JavaScript"/>
                      </xpdExt:ScriptInformation>
                      <xpdl2:Actual ScriptGrammar="JavaScript">&quot;TC17&quot;;&#xD;
</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="CodificaOLOAGCOM">
                      <xpdExt:ScriptInformation Id="_5COW48TREe2uWMPWs6HAZA" Name="codiceOperatoreDonating"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">//Script Editor inserito con RU_1346 (NP DEL 103)&#xD;
var codiceOperatoreDonating = &quot;&quot;;&#xD;
codiceOperatoreDonating = null;&#xD;
var oloRetailer = &quot;&quot;;&#xD;
oloRetailer = null;&#xD;
&#xD;
if(RichiestaTempPacto.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
   &amp;&amp; RichiestaTempPacto.flagDelibera103 == &quot;Y&quot;)&#xD;
{&#xD;
	for(var i=0; i&lt;RichiestaTempPacto.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = RichiestaTempPacto.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			for(var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING)&#xD;
				{&#xD;
					codiceOperatoreDonating = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovata NUMBERPORTABILITY con CODICEOPERATOREDONATING: &quot;+codiceOperatoreDonating);&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER)&#xD;
				{&#xD;
					oloRetailer = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovata NUMBERPORTABILITY con OLORETAILER: &quot;+oloRetailer);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//SM_11178&#xD;
if(oloRetailer != null)&#xD;
{&#xD;
	oloRetailer;&#xD;
}&#xD;
else&#xD;
{&#xD;
	codiceOperatoreDonating;&#xD;
}</xpdl2:Actual>
