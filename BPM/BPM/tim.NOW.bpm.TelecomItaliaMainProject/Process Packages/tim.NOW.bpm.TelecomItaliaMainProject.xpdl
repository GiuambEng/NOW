          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_OTs_cwJCEeaPBpRvSvxznA" Width="128.0">
              <xpdl2:Coordinates XCoordinate="1467.0" YCoordinate="3848.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_EDPhUP8wEeqO1sB0HnE9Ig" Name="PrecondizioneInvioaJpub" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione Invio a Jpub">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">InvioaJPUB = true;&#xD;
&#xD;
&#xD;
//SM_9520: Per VULA FTTCAB/FTTH, NGA FTTCAB/FTTH, BitstreamGBEAsimm e caratterizzati in Riconfigurazione Accesso dalla sola modifica del parametro INTERMEDIATE AGENT FULL pur avendo lavorazione di VARIAZIONE, &#xD;
//non devono essere notificati a JPUB SOLO NEL CASO IN CUI LA VARIAZIONE DI INTERMEDIATEAGETFULL SIA DA SI A NO OPPURE DA NO A NO &#xD;
//(Questo requisito era stato introdotto con la RU_1041, ma c'era un errore sulle specifiche, corretto poi con SM_9520)&#xD;
&#xD;
var IntermediateAgent = &quot;&quot;;&#xD;
IntermediateAgent = null;&#xD;
var ValoreInteragent = &quot;&quot;;   //SM_9550&#xD;
ValoreInteragent = null;     //SM_9550&#xD;
&#xD;
var foundInteragent = false;&#xD;
var IntermediateAgentNO = false;&#xD;
&#xD;
if(LavorazioneAutoespletante != null &amp;&amp; LavorazioneAutoespletante == true //LavorazioneAutoespletante in Variazione = modificato solo INTERMEDIATEAGENTFULL&#xD;
   &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INTERMEDIATEAGENTFULL)&#xD;
				{&#xD;
					IntermediateAgent = attributo.valoreAttributo;			&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC&#xD;
			 || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INTERAGENT)&#xD;
				{&#xD;
					foundInteragent = true;		&#xD;
					ValoreInteragent = attributo.valoreAttributo;      //SM_9550&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//Inibire invio a JPUB&#xD;
	if(IntermediateAgent == &quot;NO&quot; &amp;&amp; (!foundInteragent || (foundInteragent &amp;&amp; ValoreInteragent == &quot;INTERAGENT&quot;)))       //SM_9550: aggiunto caso in cui c'è INTERAGENT valorizzato a INTERAGENT&#xD;
	{&#xD;
		IntermediateAgentNO = true;&#xD;
	}	&#xD;
}&#xD;
&#xD;
&#xD;
//R1E-21-0325: se è presente WHITELIST nella consistenza/NP e siamo in Cessazione/Variazione, non inviare a JPUB&#xD;
//La logica per MIGRAZIONE è presente sul servizio JPUB, poiché lì bisogna inibire solo l'invio della consistenza&#xD;
var foundWhiteList = false;&#xD;
//RU_1353&#xD;
/* RU_1383 : Rimossa logica di ricerca dell'attributo CARATTERIZZAZIONEGEO&#xD;
var foundCaratterizzazioneGeo = false; */&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA&#xD;
	|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI&#xD;
	|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZARACCOLTA&#xD;
	|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS&#xD;
	|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.WHITELIST&#xD;
				&amp;&amp; (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
					|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE))&#xD;
			{&#xD;
				foundWhiteList = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	/*&#xD;
	RU_1383 : Rimossa logica di ricerca dell'attributo CARATTERIZZAZIONEGEO&#xD;
	else if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)//RU_1353&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO&#xD;
				&amp;&amp; (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
					|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
					|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE))&#xD;
			{&#xD;
				foundCaratterizzazioneGeo = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	*/&#xD;
}&#xD;
&#xD;
//PRECONDIZIONE PRE-ESISTENTE, PRIMA DELLA 9520 sul RAMO&#xD;
if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR20&#xD;
|| &#xD;
(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
 &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
|| &#xD;
(localRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.RICARICA&#xD;
	&amp;&amp; (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.PROLUNGAMENTO&#xD;
		|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.SCHEDULAZIONE&#xD;
		|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTO&#xD;
		|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.SPEGNIMENTO))&#xD;
||&#xD;
//Bug #30764&#xD;
(localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNPDEL82&#xD;
&amp;&amp; localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOB2B)&#xD;
||&#xD;
//SM_9520 - sostituita logica pre-esistente con il booleano IntermediateAgentNO (vedi sopra)&#xD;
IntermediateAgentNO&#xD;
||&#xD;
//R1E-21-0325: se è presente WHITELIST nella consistenza/NP e siamo in Cessazione/Variazione, non inviare a JPUB&#xD;
foundWhiteList&#xD;
||&#xD;
//RU_1204: se valorizzato whitelist in ATTIVAZIONE va inibito l'invio verso JPUB&#xD;
(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE&#xD;
&amp;&amp; localRequest.ordineAssetWhiteList != null)&#xD;
||&#xD;
//SM_9508: RIENTRICPS non devono essere inviati a JPUB&#xD;
localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIENTROCPS&#xD;
||&#xD;
//RU_1058&#xD;
localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONENUMEROCONDIVISORI&#xD;
||&#xD;
//RU_1203&#xD;
localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOOLO&#xD;
||&#xD;
//RU_1150&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON&#xD;
||&#xD;
//RU_1581&#xD;
(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIGPON1BPNRR &amp;&amp; OneStep != 'Y')  //SM_11935 inserita condizione OneStep diverso da Y&#xD;
||&#xD;
(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPON1BPNRR &amp;&amp; OneStep != 'Y')&#xD;
||&#xD;
//RU_1450&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM&#xD;
||&#xD;
//RU_1479&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FWAITALIA1GIGASARDEGNA&#xD;
||&#xD;
//RU_1317 + Bug #39832&#xD;
((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON &amp;&amp;&#xD;
	((!(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)) || OneStep != 'Y')) &#xD;
	//SM_11149 per INATTESACONSUNTIVO l'OL non deve passare in CHIUSO&#xD;
	&amp;&amp; localRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESACONSUNTIVO)&#xD;
//RU_1353:  se esiste CARATTERIZZAZIONEGEO nell'ACCESSO, allora non inviare evento a JPUB (LOGICA RIMOSSA IN RU_1383)&#xD;
/*|| foundCaratterizzazioneGeo*/&#xD;
)&#xD;
{&#xD;
	InvioaJPUB = false;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
