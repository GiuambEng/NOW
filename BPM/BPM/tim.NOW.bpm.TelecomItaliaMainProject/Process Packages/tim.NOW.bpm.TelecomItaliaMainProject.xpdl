        <xpdl2:Activity Id="_d2lZgE0eEeeRMYTkeazoyQ" Name="CalcolaDAC" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola DAC">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_TiXYQOl0EeabDOcEQPWpDw" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="duration">
                  <xpdExt:ScriptInformation Id="_peLHsE0eEeeRMYTkeazoyQ" Name="duration">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;P&quot; + (GIORNIPREVISTI - 1) + &quot;DT23H&quot;;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="startDateTime">
                  <xpdExt:ScriptInformation Id="_s8r18E0eEeeRMYTkeazoyQ" Name="date">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">DateTimeUtil.createDatetime(DROAltreLavorazioni,DateTimeUtil.createTime(4,0,0,0));</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="endDateTime">
                  <xpdl2:Actual ScriptGrammar="JavaScript">dateTimeTemp</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_OTs_cwJCEeaPBpRvSvxznA" Width="128.0">
              <xpdl2:Coordinates XCoordinate="3476.0" YCoordinate="1628.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier=&quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.calcDeadline&quot;;&#xD;
&#xD;
localRequest = RequestRef.readRichiesta();&#xD;
&#xD;
GIORNIPREVISTI = null;&#xD;
FLAGPERMESSI = null;&#xD;
var i=0;&#xD;
while((GIORNIPREVISTI== null || FLAGPERMESSI == null)&amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
	if(localRequest.ordine.dettaglioordine.get(i).nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUOPERESPECIALI){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		var j=0;&#xD;
		while((GIORNIPREVISTI== null || FLAGPERMESSI == null) &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size()){&#xD;
			if(componente.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.GIORNIPREVISTI){&#xD;
				GIORNIPREVISTI = parseInt(componente.attributiDettaglioOrdine.get(j).valoreAttributo,10);&#xD;
			}&#xD;
			else if(componente.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGPERMESSI){&#xD;
				FLAGPERMESSI = componente.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">var timeout = DateTimeUtil.createDate(dateTimeTemp);&#xD;
timeout.add(DateTimeUtil.createDuration(true,0,0,1,0,0,0));&#xD;
&#xD;
localRequest.ordine.DACRimodulata = timeout;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
