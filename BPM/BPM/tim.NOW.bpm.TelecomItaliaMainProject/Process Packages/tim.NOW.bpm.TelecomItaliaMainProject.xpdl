        <xpdl2:Activity Id="_Vz8jwD5YEei7IcgYfvd3tQ" Name="RecuperaDATIRICARICA" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Recupera DATI RICARICA">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">for (var i=0; i&lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	if (currentComponente. nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DATIRICARICA)&#xD;
	{&#xD;
		for (var j=0; j&lt; currentComponente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
			if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAINIZIORICARICA)&#xD;
			{&#xD;
				DataInizioRicarica = DateTimeUtil.createDatetime(currentAttributo.valoreAttributo);&#xD;
			}&#xD;
				&#xD;
			else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAFINERICARICA)&#xD;
			{&#xD;
				DataFineRicarica = DateTimeUtil.createDatetime(currentAttributo.valoreAttributo);&#xD;
			}&#xD;
				&#xD;
			else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				IDAssetAccessoDinamico = currentAttributo.valoreAttributo;&#xD;
			}&#xD;
				&#xD;
			else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSETRICARICA)&#xD;
			{&#xD;
				IDAssetRicarica = currentAttributo.valoreAttributo;&#xD;
			}&#xD;
				&#xD;
			else if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIAACCENSIONERICARICA)&#xD;
			{&#xD;
				TipologiaAccensioneRicarica = currentAttributo.valoreAttributo;&#xD;
			}&#xD;
				&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="66.0" LaneId="_9soQQT1sEei7IcgYfvd3tQ" Width="95.0">
              <xpdl2:Coordinates XCoordinate="348.0" YCoordinate="311.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
