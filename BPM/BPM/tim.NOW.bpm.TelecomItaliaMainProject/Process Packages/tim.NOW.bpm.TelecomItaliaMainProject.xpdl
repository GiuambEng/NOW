        <xpdl2:Activity Id="_82mnNHbCEeeHqtzCIDiTgA" Name="CalcolaAttesa" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola Attesa">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">/*&#xD;
if(localRequest.tipologiaScenario==it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUTIF)&#xD;
{&#xD;
	Timeout.setTime(17,0,0);&#xD;
}&#xD;
else&#xD;
{	&#xD;
	Timeout.setTime(17,59,0);	&#xD;
}&#xD;
*/&#xD;
&#xD;
// SM_8679: sostituita logica di set del Timeout&#xD;
if(localRequest.tipologiaScenario==it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUTIF&#xD;
|| String(localRequest.tipologiaScenario).slice(0,10) == &quot;NPSUTIFCPS&quot;) //SM_9722&#xD;
{&#xD;
	Timeout = DateTimeUtil.createDatetime(TimeoutDate,DateTimeUtil.createTime(17,0,0,0));&#xD;
}&#xD;
else&#xD;
{	&#xD;
	Timeout = DateTimeUtil.createDatetime(TimeoutDate,DateTimeUtil.createTime(17,59,0,0));&#xD;
}&#xD;
&#xD;
&#xD;
Esito_RicezioneCodiceSegreto = &quot;0&quot;;&#xD;
Esito_RicezioneCapacitaEvasione = &quot;0&quot;;&#xD;
&#xD;
IDAnagraficaCausaleCapacitaEvasione=null;&#xD;
IDAnagraficaCausaleCodiceSegreto=null;</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
