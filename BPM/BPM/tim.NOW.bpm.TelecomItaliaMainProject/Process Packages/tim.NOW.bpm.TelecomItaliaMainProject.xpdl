	*/&#xD;
	&#xD;
	if(localRequest.codiceTrasformazione != null &amp;&amp; localRequest.codiceTrasformazione != &quot;&quot;){&#xD;
		&#xD;
		if(consistenzaFoniaTemp != null)&#xD;
		{&#xD;
			Process.auditLog(&quot;consistenzaFonia utilizzata per creare ordine indotto&quot;);&#xD;
			localRequestIndottaFonia = ScriptUtil.copy(richiestaTemp);&#xD;
			consistenzaFoniaTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
			localRequestIndottaFonia.ordine.dettaglioordine.add(ScriptUtil.copy(consistenzaFoniaTemp));&#xD;
		}&#xD;
		else if(consistenzaDatiTemp != null)&#xD;
		{&#xD;
			Process.auditLog(&quot;consistenzaDati utilizzata per creare ordine indotto&quot;);&#xD;
			localRequestIndottaDati = ScriptUtil.copy(richiestaTemp);&#xD;
			&#xD;
			if(localRequest.codiceTrasformazione != &quot;CBTSATMSIMM&quot;){	&#xD;
				consistenzaDatiTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
			}			&#xD;
			localRequestIndottaDati.ordine.dettaglioordine.add(ScriptUtil.copy(consistenzaDatiTemp));&#xD;
		}&#xD;
		else if(IdAssetTBUNDLE != null)&#xD;
		{&#xD;
			Process.auditLog(&quot;IdAssetTBUNDLE utilizzata per creare ordine indotto&quot;);&#xD;
			localRequestIndottaFonia = ScriptUtil.copy(richiestaTemp);&#xD;
		}			&#xD;
	}&#xD;
}&#xD;
&#xD;
//Prepara richiesta per dati&#xD;
if(localRequestIndottaDati != null){&#xD;
&#xD;
	//recupera ID Asset&#xD;
	var assetConsistenzaDati = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
	assetConsistenzaDati = null;&#xD;
	var idAsset = 0;&#xD;
	idAsset = null;&#xD;
	var tipoLineaAssetDati=&quot;&quot;;&#xD;
	var idRisorsaAssetDati=&quot;&quot;;&#xD;
	&#xD;
	var i=0;	&#xD;
	while(i&lt;consistenzaDatiTemp.attributiDettaglioOrdine.size()){&#xD;
		var attr = consistenzaDatiTemp.attributiDettaglioOrdine.get(i);&#xD;
		if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET){&#xD;
			if(!isNaN(attr.valoreAttributo)){&#xD;
				idAsset = ScriptUtil.createBigInteger(attr.valoreAttributo);&#xD;
				Process.auditLog(&quot;idAsset utilizzato per ordine indotto relativo alla consistenza dati:&quot;+idAsset);&#xD;
			}&#xD;
		}&#xD;
		else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA){&#xD;
			idRisorsaAssetDati = attr.valoreAttributo;&#xD;
		}&#xD;
		else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
			tipoLineaAssetDati = attr.valoreAttributo;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	// recupera asset&#xD;
	var assetTemp = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(idAsset);&#xD;
	assetConsistenzaDati = assetTemp.readAsset();&#xD;
	&#xD;
	// RU_904: aggiunta valorizzazione codiceOrdineOLOPadre da passare al processo di GenerazioneCodiceOrdineOLO per la concat con la sequence&#xD;
	CodiceOrdineOloPadre = assetConsistenzaDati.codiceOrdineOLO;&#xD;
	&#xD;
	// prepara richiesta&#xD;
	localRequestIndottaDati.codificaOLOAGCOM = assetConsistenzaDati.codificaOLOAGCOM;	&#xD;
	localRequestIndottaDati.codificaOLONOW; // da aggiungere il recupero mediante servizio&#xD;
	&#xD;
	// RU_685, per migrazione con asset simmetrico deve assegnare id contratto della consistenza (bisogna saltare recupera id contratto)&#xD;
	if(localRequest.codiceTrasformazione == &quot;CBTSATMSIMM&quot;&#xD;
	|| localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;) //RU_1109&#xD;
	{&#xD;
		localRequestIndottaDati.IDContratto = assetConsistenzaDati.IDContratto;&#xD;
	}&#xD;
	&#xD;
	if(localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;){&#xD;
		localRequestIndottaDati.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA;&#xD;
	}&#xD;
	else if(localRequest.codiceTrasformazione == &quot;TBUNDLE&quot;){&#xD;
		if(assetConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP)&#xD;
		{&#xD;
			localRequestIndottaDati.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA;&#xD;
		} &#xD;
		else if(assetConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP)&#xD;
