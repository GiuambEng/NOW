          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">Process.priority = 280;&#xD;
AnnullametoAutomatico = null;&#xD;
&#xD;
//SM_11804&#xD;
if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACCETTATOD82)&#xD;
{&#xD;
	Lavorazioni = &quot;AccettatoVsDTU&quot;;&#xD;
}&#xD;
//RU_1550: MIG DEL 82 - verifica codice sessione KO&#xD;
else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDELIVERYD82)&#xD;
{&#xD;
	Lavorazioni = &quot;ANNULLAMENTO&quot;;&#xD;
}&#xD;
//solito&#xD;
else if(!(Outcome == &quot;GESTIONE_KO&quot;&#xD;
|| (Outcome==&quot;GESTIONE_IMPROPRIA&quot; &amp;&amp; DTUaction==&quot;RETRY&quot;)))&#xD;
{&#xD;
	Lavorazioni = null;&#xD;
}&#xD;
else&#xD;
{&#xD;
	Lavorazioni = &quot;EMISSIONE&quot;;&#xD;
}&#xD;
&#xD;
if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESACONSUNTIVO){&#xD;
	flagOpereSpeciali = true;&#xD;
}&#xD;
else{&#xD;
	flagOpereSpeciali = false;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">if(localRequest.testMode == &quot;BONIFICA_NOMAIN&quot;)&#xD;
{&#xD;
	localRequest = RequestRef.readRichiesta();&#xD;
	localRequest.testMode = &quot;BONIFICA_NOMAIN:&quot; + Process.getId();&#xD;
}&#xD;
else&#xD;
{&#xD;
	localRequest = RequestRef.readRichiesta();&#xD;
}&#xD;
//Process.priority = 210;&#xD;
Process.priority = 320;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
