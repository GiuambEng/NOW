                      </xpdExt:DataMapping>
                    </xpdExt:DataMappings>
                  </xpdExt:OutputMappings>
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                      <xpdl2:Actual ScriptGrammar="JavaScript">&quot;Richiesta&quot;</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                      <xpdl2:Actual ScriptGrammar="JavaScript">RichiestaTempPacto</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="requestRef">
                      <xpdl2:Actual ScriptGrammar="JavaScript">RichiestaRefTempPacto</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="80.0" Width="128.0">
                  <xpdl2:Coordinates XCoordinate="146.0" YCoordinate="62.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Initiated">
                  <xpdExt:Information ScriptGrammar="JavaScript">//SM_11004: spostato qua invece che nell'Initiate script dell'embedded sub-process&#xD;
//RefRichiesta e Richiesta temporanee per selezionare quella su cui sto ciclando&#xD;
RichiestaRefTempPacto = RichiestePacchettoRef.get(Process.getActivityLoopIndex());&#xD;
RichiestaTempPacto = RichiestaRefTempPacto.readRichiesta();&#xD;
Process.auditLog(&quot;Ciclo sul seguente IDRichiestaOLO: &quot; + String(RichiestaTempPacto.IDRichiestaOLO));&#xD;
&#xD;
//Aggiorno la DACRimodulata della richiesta su cui sto ciclando&#xD;
RichiestaTempPacto.ordine.DACRimodulataTemp = localRequest.DAC;&#xD;
	&#xD;
</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
            </xpdl2:Activity>
