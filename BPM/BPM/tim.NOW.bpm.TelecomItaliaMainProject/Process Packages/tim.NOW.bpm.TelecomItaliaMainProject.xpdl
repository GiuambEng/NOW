              <xpdExt:Information ScriptGrammar="JavaScript">localRequest = RequestRef.readRichiesta();&#xD;
&#xD;
localRequest.statoRichiestaPrecedOF = localRequest.statoRichiestaOF;&#xD;
localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
&#xD;
//Annullamento ricevuto da CASO 4 delle richieste di annullamento FBS&#xD;
if(TipoSbloccoFBS == &quot;RICHIESTA_ANNULLAMENTO_BPM&quot;)&#xD;
{&#xD;
	localRequest.statoRichiestaOF = it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.NRDEFINITIVO;&#xD;
	localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDTUPEROF;&#xD;
&#xD;
	Lavorazioni = &quot;ANNULLAMENTO_FBS_DA_OLO&quot;;&#xD;
}&#xD;
//RU_1492 (C11M08F103 - Conferma Scarto Fiberstream)&#xD;
else&#xD;
{&#xD;
	localRequest.statoRichiestaOF = it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.NRDEFINITIVO;&#xD;
	localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDTUPERKOOF;&#xD;
&#xD;
	Lavorazioni = &quot;ConfermaScarto_C11M08F103&quot;;&#xD;
	localRequest.flgAbilitazGuiManualOF = null;&#xD;
	localRequest.IDAnagraficaCausale = null;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
