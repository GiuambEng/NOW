              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="80.0" LaneId="_OTs_cwJCEeaPBpRvSvxznA" Width="128.0">
              <xpdl2:Coordinates XCoordinate="5757.0" YCoordinate="1334.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
&#xD;
// BUG #30764 SERVIZIO FASTDATA: settiamo CHIUSOB2B&#xD;
if(localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNPDEL82)&#xD;
{&#xD;
	localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CHIUSOB2B;&#xD;
	localRequest.ordine.dataChiusuraOrdine = DateTimeUtil.createDate();&#xD;
}&#xD;
else //solito&#xD;
{&#xD;
	localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CHIUSO;&#xD;
	localRequest.ordine.dataChiusuraOrdine = DateTimeUtil.createDate();&#xD;
}&#xD;
&#xD;
if (localRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.RICARICA&#xD;
&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ACCENSIONE&#xD;
&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.SPEGNIMENTO)&#xD;
{&#xD;
	localRequest.ordine = null;&#xD;
&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
