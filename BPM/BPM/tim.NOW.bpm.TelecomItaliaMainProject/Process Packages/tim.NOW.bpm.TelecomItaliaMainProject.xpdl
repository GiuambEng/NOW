&#xD;
RichiestePacchettoRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
	&#xD;
if(RichiestePacchettoRef.size()>0)&#xD;
{&#xD;
	Process.auditLog(&quot;Recuperate&quot; +RichiestePacchettoRef.size()+ &quot;richieste per codicePacchettoNOW = &quot; +targetRequest.codicePacchettoNOW);//SM_10978&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Nessuna richiesta recuperata per codicePacchettoNOW = &quot; +targetRequest.codicePacchettoNOW);//SM_10978&#xD;
}&#xD;
</xpdl2:Script>
