					localRequestIndottaFonia.ordine.tipologiaScenario = it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.CESSAZIONEMIG;&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.add(ScriptUtil.copy(consistenzaFoniaTemp));&#xD;
