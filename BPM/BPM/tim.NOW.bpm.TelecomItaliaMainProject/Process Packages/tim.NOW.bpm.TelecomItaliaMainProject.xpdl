              <xpdl2:Coordinates XCoordinate="297.0" YCoordinate="215.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">identifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.ErrorCodeManagement.xpdl.TrascodificaCausale&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
