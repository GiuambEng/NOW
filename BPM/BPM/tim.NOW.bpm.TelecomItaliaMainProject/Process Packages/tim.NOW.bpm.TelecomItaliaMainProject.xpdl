        <xpdl2:Activity Id="_5NQHHJawEea-hfjt0Wa0jg" Name="NotificaScartoCongruenzaversoOLO" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Notifica Scarto Congruenza verso OLO">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_v3JtkIFrEeaG-Y7D3-yA8Q" PackageRef="tim.NOW.bpm.invokeExternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="TipologiaNotifica">
                  <xpdExt:ScriptInformation Id="_5NQHHpawEea-hfjt0Wa0jg" Name="Tipo">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">// Se si tratta di uno scarto in seguito a un'altra richiesta a pacchetto che ha scartato&#xD;
if(localRequest.IDCorrelazione != null &#xD;
	&amp;&amp; localRequest.IDCorrelazione != &quot;&quot; &#xD;
	&amp;&amp; StatoPacchetto != &quot;SCIOLTO&quot; &#xD;
	&amp;&amp; FlagScartatoPacchetto)&#xD;
{&#xD;
	if(localRequest.tipoPacchetto == &quot;0&quot;)&#xD;
	{&#xD;
		&quot;KO&quot;;&#xD;
	}&#xD;
	else if(ScartoPactoPreTecni) // Se ha scartato prima di andare in verifiche tecniche&#xD;
	{&#xD;
		&quot;TC12&quot;;&#xD;
	}&#xD;
	else // Se ha scartato dopo essere andato in verifiche tecniche&#xD;
	{&#xD;
		&quot;TC13&quot;;&#xD;
	}&#xD;
}&#xD;
// Nel caso standard&#xD;
else&#xD;
{&#xD;
	&quot;TC12&quot;;&#xD;
}&#xD;
</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaOLODestinatario">
                  <xpdExt:ScriptInformation Id="_5NQHHZawEea-hfjt0Wa0jg" Name="target"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;DONATING&quot;;</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="123.0" LaneId="_0-IVIYAQEeaBDPcmg1dPOQ" Width="128.0">
              <xpdl2:Coordinates XCoordinate="2144.0" YCoordinate="76.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">//Updating the statorichestaNOW with SCARTATO&#xD;
localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
&#xD;
localRequest.statoRichiestaNOW=it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO;&#xD;
localRequest.statoRichiestaOLO=it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SCARTATO;&#xD;
&#xD;
ProcessIdentifier = &quot;/tim.NOW.bpm.invokeExternalService/Process Packages/tim.NOW.bpm.invokeExternalService.OLO.xpdl.TINOWNotificaOLO&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">StrippedRequest = ScriptUtil.copy(localRequest);&#xD;
StrippedRequest.ordine = null;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
