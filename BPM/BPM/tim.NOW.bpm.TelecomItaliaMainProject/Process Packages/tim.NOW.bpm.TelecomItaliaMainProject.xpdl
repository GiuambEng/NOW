				}&#xD;
			}&#xD;
			&#xD;
			//NP su WLR - BTS || NP su WLR - EIP || NP su VULL - BTS || NP su VULL - BTS || NPDONOROLOSUWLRBTS || NPDONOROLOSUWLREIP || NPDONOROLOSUVULLBTS&#xD;
			if(localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUWLRBTS&#xD;
