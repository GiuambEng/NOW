        <xpdl2:Activity Id="_87jMAETmEeath6K40vyaKg" Name="AggiornaRichiestaReferenteperDesospensione" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna Richiesta Referente per Desospensione">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;Richiesta&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="89.0" LaneId="_OTs_cwJCEeaPBpRvSvxznA" Width="128.0">
              <xpdl2:Coordinates XCoordinate="2273.0" YCoordinate="1199.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">localRequest = RequestRef.readRichiesta();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	//RU_1059: arricchimento attributi DESOSPENSIONEOLO e RITIROPRODOTTI dell'ACCESSO nel caso di Desospensione automatica da DTU con timeout&#xD;
	if(DesospensioneAutomatica)&#xD;
	{&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var foundDesospensioneOlo = false;&#xD;
				&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					//Aggiornamento DESOSPESIONEOLO&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESOSPENSIONEOLO)&#xD;
					{&#xD;
						attributo.valoreAttributo = &quot;NO&quot;;&#xD;
						foundDesospensioneOlo = true;&#xD;
						Process.auditLog(&quot;Aggiornato attributo DESOSPENSIONEOLO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
					}&#xD;
					//Aggiornamento RITIROPRODOTTI&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RITIROPRODOTTI&#xD;
							&amp;&amp; attributo.valoreAttributo == &quot;Y&quot;)&#xD;
					{&#xD;
						attributo.valoreAttributo = &quot;C&quot;;&#xD;
						Process.auditLog(&quot;Aggiornato attributo RITIROPRODOTTI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
					}&#xD;
				}&#xD;
&#xD;
				//Creazione DESOSPENSIONEOLO&#xD;
				if(!foundDesospensioneOlo)&#xD;
				{&#xD;
					var ora = DateTimeUtil.createDatetime();&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
					attributo.created = ora;&#xD;
					attributo.lastUpdate = ora;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESOSPENSIONEOLO;&#xD;
					attributo.operatore = componente.operatore;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = &quot;NO&quot;;&#xD;
					&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					&#xD;
					Process.auditLog(&quot;Creato attributo DESOSPENSIONEOLO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
				}&#xD;
			}	&#xD;
		}		&#xD;
	}&#xD;
&#xD;
	else //solito&#xD;
	{		&#xD;
		var calcProgressivo = 4;&#xD;
&#xD;
		if(referenteAltreLavorazioni != null)&#xD;
		{&#xD;
					   for(var i = 0; i &lt; localRequest.ordine.referente.size(); i++)&#xD;
					   {&#xD;
									  var currentReferente = localRequest.ordine.referente.get(i);&#xD;
									  &#xD;
									  if(currentReferente.tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTEPERINTERRUZIONESOSPENSIONE&#xD;
									     ||currentReferente.tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTERIMODULAZIONEAPPUNTAMENTO)  //SM_10519&#xD;
									  {&#xD;
													calcProgressivo++;&#xD;
									  }&#xD;
					   }&#xD;
					   &#xD;
					   referenteAltreLavorazioni.progressivoReferente = calcProgressivo;&#xD;
					   referenteAltreLavorazioni.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					   localRequest.ordine.referente.add(ScriptUtil.copy(referenteAltreLavorazioni));&#xD;
		}&#xD;
		&#xD;
		//RU_1479&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FWAITALIA1GIGASARDEGNA)&#xD;
		{&#xD;
			Process.auditLog(&quot;Non valorizzo IDFasciaOraria e DADRimodulata in caso di offerta FWAITALIA1GIGASARDEGNA&quot;);&#xD;
		}&#xD;
		else //solito&#xD;
		{&#xD;
			if(DADRimodulata != null)&#xD;
			{&#xD;
				localRequest.ordine.DADRimodulata = DADRimodulata;&#xD;
			}&#xD;
&#xD;
			if(IDFasciaOraria != null)&#xD;
			{&#xD;
				localRequest.IDFasciaOraria = IDFasciaOraria;&#xD;
			}		&#xD;
		}&#xD;
				&#xD;
		//RU_1112: se arriva una Desospensione da GUI dopo la Desospensione Automatica da DTU, DESOSPENSIONEOLO va rimosso&#xD;
		for(var m=0; m&lt;localRequest.ordine.dettaglioordine.size(); m++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(m);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for(var k=0; k&lt;componente.attributiDettaglioOrdine.size(); k++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESOSPENSIONEOLO&#xD;
					   &amp;&amp; attributo.valoreAttributo == &quot;NO&quot;)   //valorizzato così nella desospensioneautomatica da DTU con timer&#xD;
					{&#xD;
						componente.attributiDettaglioOrdine.remove(k);&#xD;
						k--;	&#xD;
						&#xD;
						Process.auditLog(&quot;Eliminato attributo DESOSPENSIONEOLO a NO&quot;);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}		&#xD;
	}&#xD;
}&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
