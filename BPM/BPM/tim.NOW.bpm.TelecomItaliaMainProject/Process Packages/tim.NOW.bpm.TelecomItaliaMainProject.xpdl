          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">//[S6] Richiesta di chiarimenti - RU_364&#xD;
//Per il punto 1) vanno prese in considerazione tutte le offerte di NP o che coinvolgano una NP (ad es. anche una ULL + NP) e che si trovino in fase di attivazione della NP (la comunicazione a RAC parte all’espletamento di un’uscita da TIM).&#xD;
//Per il punto 2) è corretto l’OLO Donating = ‘TLC’ e il Recipient &lt;> ‘TLC’, considerando però soli archi nativi TIM, quindi OLO Donor = ‘TLC’.&#xD;
&#xD;
(localRequest.codificaOLOAGCOMDonor == &quot;TLC&quot;&#xD;
&amp;&amp;&#xD;
localRequest.codificaOLOAGCOMDonating == &quot;TLC&quot;&#xD;
&amp;&amp;&#xD;
localRequest.codificaOLOAGCOM != &quot;TLC&quot;&#xD;
&amp;&amp;&#xD;
(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP&#xD;
||&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
||&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
||&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
||&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
||&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA)&#xD;
&amp;&amp;&#xD;
localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR20)&#xD;
|| //RU_1111: ora va inviata notifica a RAC per tutte le attivazioni/cessazioni FWA&#xD;
((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
	|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIXEDWIRELESSACCESS) ;</xpdl2:Expression>
</xpdl2:Condition>
