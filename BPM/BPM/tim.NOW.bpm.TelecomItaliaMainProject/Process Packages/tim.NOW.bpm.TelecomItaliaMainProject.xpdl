              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.ErrorCodeManagement.xpdl.TrascodificaCodiceCausale&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">//SM_8280 - per non inviare a DTU la lavorazione dopo lo scarto. &#xD;
ControlloFallito = com_tim_NOW_xsd_ControlliAmmessi_Factory.createLista_Controlli();&#xD;
ControlloFallito.cod_Causale = &quot;NP_20&quot;;&#xD;
ControlloFallito.codice_Controllo = &quot;CTRL CAPACITA EVASIONE&quot;;&#xD;
ControlloFallito.id_Causale = localRequest.IDAnagraficaCausale;&#xD;
ControlloFallito.mesaggio_Scarto = &quot;Superato il valore della capacita' di evasione&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_82mnRnbCEeeHqtzCIDiTgA" Name="TrascodificaCodiceCausale" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Trascodifica CodiceCausale">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_yewCgIueEea6Hs4N8ixhVg" PackageRef="tim.NOW.bpm.ErrorCodeManagement.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="OUT" Formal="IDAnagraficaCausale">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDAnagraficaCausale</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="CodiceCausale">
                  <xpdExt:ScriptInformation Id="_82mnR3bCEeeHqtzCIDiTgA" Name="codiceCausale">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if(FlagScartatoPacchetto)&#xD;
{&#xD;
	&quot;28&quot;;&#xD;
}&#xD;
else if(Esito_RicezioneCapacitaEvasione == &quot;1&quot;)&#xD;
{&#xD;
	&quot;NP_20&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;NP_14&quot;;&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="IDAnagraficaCausale">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDAnagraficaCausaleGUI</xpdl2:Actual>
                </xpdl2:DataMapping>
