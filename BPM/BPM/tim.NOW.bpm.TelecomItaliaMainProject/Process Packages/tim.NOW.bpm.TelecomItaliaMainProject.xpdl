          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier =&quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.substractWorkingDate&quot;;&#xD;
&#xD;
//RU_1433&#xD;
ScadenzaDACAttesa = null;&#xD;
&#xD;
var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key = 'ScadenzaDACAttesaNPCautelareDEL103'&quot;);&#xD;
configurations = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(criteria);&#xD;
&#xD;
if(configurations != null &amp;&amp; configurations.size() > 0)&#xD;
{&#xD;
	configuration = configurations.get(0).readConfiguration();&#xD;
	&#xD;
	Process.auditLog(&quot;Recuperata la configurazione ScadenzaDACAttesa: &quot; + configuration.value);&#xD;
	&#xD;
	if(!isNaN(configuration.value))&#xD;
	{&#xD;
		ScadenzaDACAttesa = parseInt(configuration.value, 10);&#xD;
	}&#xD;
}&#xD;
&#xD;
if(ScadenzaDACAttesa == null)&#xD;
{&#xD;
	ScadenzaDACAttesa = 2;&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;ScadenzaDACAttesa: &quot; + ScadenzaDACAttesa);&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">Process.auditLog(&quot;ScadenzaRDAC =&quot;+ String(ScadenzaRDAC));</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
