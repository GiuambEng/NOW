        <xpdl2:Activity Id="_U6RwMELdEeaKJYomgIRP2g" Name="AggiornaRichiestaDADRimodulata" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna Richiesta DADRimodulata">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;Richiesta&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="80.0" LaneId="_OTs_cwJCEeaPBpRvSvxznA" Width="128.0">
              <xpdl2:Coordinates XCoordinate="2273.0" YCoordinate="1083.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">localRequest = RequestRef.readRichiesta();&#xD;
&#xD;
if(DADRimodulata != null)&#xD;
{&#xD;
	localRequest.ordine.DADRimodulata = DADRimodulata;&#xD;
}&#xD;
&#xD;
if(IDFasciaOraria != null)&#xD;
{&#xD;
	localRequest.IDFasciaOraria = IDFasciaOraria;&#xD;
}&#xD;
&#xD;
//RU_1451&#xD;
if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FIBERSTREAM)&#xD;
{&#xD;
	Process.auditLog(&quot;Nessun aggornamento di stato nel cso di strutturaRichiesta FIBERSTREAM&quot;);&#xD;
}&#xD;
else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)&#xD;
{&#xD;
	localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
	localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOAPPUNTAMENTO;&#xD;
	localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
	localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SOSPESO;&#xD;
}&#xD;
// Mail &quot;R: Verifiche su passaggi di stato (Tracciamento) su eventi di RIMODULAZIONE_DAD (post DESOSPENSIONE)&quot;.&#xD;
// Quando arriva una RIMODULAZIONE DAD, nel caso REGOLATORIO, dobbiamo settare lo stato precedente con INDELIVERY e stato corrente resta INDELIVERY, &#xD;
// in modo tale che con il prossimo tracciamento (nell'emissione DTU) ci saranno gli stati INDELIVERY-INDELIVERY&#xD;
else&#xD;
{&#xD;
	localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
	localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
}&#xD;
&#xD;
//SM_10519: inserito arricchimento per REFERENTERIMODULAZIONEAPPUNTAMENTO (ricevuto come parameter nella richiesta di RIMODULAZIONEDAD)&#xD;
var calcProgressivo = 4;&#xD;
&#xD;
if(referenteAltreLavorazioni != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.referente.size(); i++)&#xD;
	{&#xD;
		var currentReferente = localRequest.ordine.referente.get(i);&#xD;
&#xD;
		if(currentReferente.tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTERIMODULAZIONEAPPUNTAMENTO&#xD;
		   ||currentReferente.tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTEPERINTERRUZIONESOSPENSIONE)&#xD;
		{&#xD;
			calcProgressivo++;&#xD;
		}&#xD;
	}&#xD;
   &#xD;
   referenteAltreLavorazioni.progressivoReferente = calcProgressivo;&#xD;
   referenteAltreLavorazioni.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
   localRequest.ordine.referente.add(ScriptUtil.copy(referenteAltreLavorazioni));  &#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_q6K5gELeEeaKJYomgIRP2g" Name="STATOAVANZAMENTO" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="STATO AVANZAMENTO">
          <xpdl2:Implementation>
