                          <xpdExt:Expression ScriptGrammar="JavaScript">var date = localRequest.ordine.DAC;&#xD;
if(localRequest.ordine.DACRimodulata!= null){&#xD;
	date = localRequest.ordine.DACRimodulata;&#xD;
}&#xD;
return date;</xpdExt:Expression>
                        </xpdExt:ScriptInformation>
