        <xpdl2:Activity Id="_OAPgUJccEe2Rnqb94oHp4w" Name="RecuperaRichiestePacchetto" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupera Richieste Pacchetto" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;codicePacchettoNOW=:SearchCodicePacchettoNOW AND tipoRichiesta ='ORDINE' ORDER BY created DESC&quot;);&#xD;
&#xD;
criteria.setQueryParameter(&quot;SearchCodicePacchettoNOW&quot;,ExistingOrder.codicePacchettoNOW);//SM_10978&#xD;
&#xD;
RichiestePacchettoRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
	&#xD;
if(RichiestePacchettoRef.size()>0)&#xD;
{&#xD;
	Process.auditLog(&quot;Recuperate &quot; +RichiestePacchettoRef.size()+ &quot;richieste per codicePacchettoNOW = &quot; +ExistingOrder.codicePacchettoNOW);&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Nessuna richiesta recuperata per codicePacchettoNOW = &quot; +ExistingOrder.codicePacchettoNOW);&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
