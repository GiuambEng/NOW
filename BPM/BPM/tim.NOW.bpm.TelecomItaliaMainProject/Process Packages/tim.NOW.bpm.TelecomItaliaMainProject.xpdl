            <xpdl2:Activity Id="_tlTH0J-hEeeWhfL4ajlwhQ" Name="RecuperaInfoNotifiche" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="RecuperaInfoNotifiche">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_dPO4UJ-hEeeWhfL4ajlwhQ" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="IDRichiestaOLO">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="OUT" Formal="InfoNotifiche">
                      <xpdl2:Actual ScriptGrammar="JavaScript">InfoNotifiche</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="76.0" Width="122.0">
                  <xpdl2:Coordinates XCoordinate="2439.0" YCoordinate="243.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Initiated">
                  <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.RecuperaInfoNotifiche&quot;;</xpdExt:Information>
                </xpdExt:AuditEvent>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">if(InfoNotifiche != null)&#xD;
{&#xD;
	for(var i=0; i&lt;InfoNotifiche.recuperaInfoNotf_Output.size(); i++)&#xD;
	{&#xD;
		var Notifica = InfoNotifiche.recuperaInfoNotf_Output.get(i);&#xD;
		if((Notifica.tipologiaDestinatario == &quot;DONOR&quot; &amp;&amp; Notifica.tipologiaNotifica == &quot;RD&quot;)&#xD;
		|| (Notifica.tipologiaDestinatario == &quot;DONATING&quot; &amp;&amp; Notifica.tipologiaNotifica == &quot;SC&quot;))&#xD;
		{&#xD;
			if(!ListaOLO.contains(Notifica.codificaOloAgcom))&#xD;
			{&#xD;
				ListaOLO.add(Notifica.codificaOloAgcom);&#xD;
				ListaTipologiaOLO.add(Notifica.tipologiaDestinatario);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_QHpnAMrjEeepVZgECi53Sg" Name="RecuperoConfigurazione" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupero Configurazione">
              <xpdl2:Implementation>
                <xpdl2:Task>
                  <xpdl2:TaskScript>
                    <xpdl2:Script ScriptGrammar="JavaScript">ScadenzaDACAttesa = null;&#xD;
ScadenzaDACAggiunta = null;&#xD;
&#xD;
//SM_10985: metto a null ogni volta altrimenti ad ogni ricalcolo della DAC mantengono il valore precedente (messo quando scatta il timer e siamo in Arricchimenti Comuni)&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
   &amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
   &amp;&amp; FlagRDACCautelare == &quot;Y&quot; &#xD;
   &amp;&amp; flagDelibera103 == &quot;Y&quot;)&#xD;
{&#xD;
	UpdateRDAC = null;&#xD;
	UpdateIDAnagCaus = null;&#xD;
}&#xD;
&#xD;
if(FlagRDACCautelare == 'Y') // RU_813 - Irrobustimento NP Cautelare&#xD;
{&#xD;
	//RU_1346 - NP DEL 103&#xD;
	if(flagDelibera103 == &quot;Y&quot;)&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key = 'ScadenzaDACAttesaNPCautelareDEL103'&quot;);&#xD;
	}&#xD;
	else //solito&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key = 'ScadenzaDACAttesaNPCautelare'&quot;);&#xD;
	}&#xD;
}&#xD;
else // Gestione Standard&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key = 'ScadenzaDACAttesa'&quot;);&#xD;
}&#xD;
&#xD;
var configurations = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(criteria);&#xD;
&#xD;
if(configurations != null &amp;&amp; configurations.size() > 0)&#xD;
{&#xD;
	configuration = configurations.get(0).readConfiguration();&#xD;
	&#xD;
	Process.auditLog(&quot;Recuperata la configurazione ScadenzaDACAttesa: &quot; + configuration.value + &quot;, Cautelare: &quot;+FlagRDACCautelare);&#xD;
	&#xD;
	if(!isNaN(configuration.value))&#xD;
	{&#xD;
		ScadenzaDACAttesa = parseInt(configuration.value, 10);&#xD;
	}&#xD;
}&#xD;
&#xD;
if(FlagRDACCautelare == 'Y') // RU_813 - Irrobustimento NP Cautelare&#xD;
{&#xD;
	//RU_1346 - NP DEL 103&#xD;
	if(flagDelibera103 == &quot;Y&quot;)&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key = 'ScadenzaDACAggiuntaNPCautelareDEL103'&quot;);&#xD;
	}&#xD;
	else //solito&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key = 'ScadenzaDACAggiuntaNPCautelare'&quot;);&#xD;
	}&#xD;
}&#xD;
else // Gestione Standard&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key = 'ScadenzaDACAggiunta'&quot;);&#xD;
}&#xD;
&#xD;
var configurations = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(criteria);&#xD;
&#xD;
if(configurations != null &amp;&amp; configurations.size() > 0)&#xD;
{&#xD;
	configuration = configurations.get(0).readConfiguration();&#xD;
	&#xD;
	Process.auditLog(&quot;Recuperata la configurazione ScadenzaDACAggiunta: &quot; + configuration.value + &quot;, Cautelare: &quot;+FlagRDACCautelare);&#xD;
	&#xD;
	if(!isNaN(configuration.value))&#xD;
	{&#xD;
		ScadenzaDACAggiunta = parseInt(configuration.value, 10);&#xD;
	}&#xD;
}&#xD;
&#xD;
if(ScadenzaDACAttesa == null &amp;&amp; FlagRDACCautelare == 'Y')&#xD;
{&#xD;
	//RU_1346 - NP DEL 103&#xD;
	if(flagDelibera103 == &quot;Y&quot;)&#xD;
	{&#xD;
		ScadenzaDACAttesa = 2;&#xD;
	}&#xD;
	else //solito&#xD;
	{&#xD;
		ScadenzaDACAttesa = 5;&#xD;
	}&#xD;
}&#xD;
else if(ScadenzaDACAttesa == null)&#xD;
{&#xD;
	ScadenzaDACAttesa = 3;&#xD;
}&#xD;
&#xD;
if(ScadenzaDACAggiunta == null)&#xD;
{&#xD;
	ScadenzaDACAggiunta = 5;&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;ScadenzaDACAttesa: &quot; + ScadenzaDACAttesa);&#xD;
Process.auditLog(&quot;ScadenzaDACAggiunta: &quot; + ScadenzaDACAggiunta);</xpdl2:Script>
                  </xpdl2:TaskScript>
                </xpdl2:Task>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="83.0" Width="135.0">
                  <xpdl2:Coordinates XCoordinate="212.0" YCoordinate="69.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:ActivityResourcePatterns>
                <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
              </xpdExt:ActivityResourcePatterns>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_xlDAkGQSEeiVmeTzkkDwwg" Name="CalcolascadenzaTimeringiorniLavorativi" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola scadenza Timer in giorni Lavorativi">
              <xpdl2:Implementation>
