                  <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier =&quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.substractWorkingDate&quot;;</xpdExt:Information>
                </xpdExt:AuditEvent>
