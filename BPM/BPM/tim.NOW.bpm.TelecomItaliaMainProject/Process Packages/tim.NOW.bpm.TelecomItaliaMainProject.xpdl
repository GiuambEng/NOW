		localRequestIndottaDati.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TBUNDLE;&#xD;
	}&#xD;
	else if(localRequest.codiceTrasformazione == &quot;CBTSATMSIMM&quot;&#xD;
		 || localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;) //RU_1109&#xD;
	{&#xD;
		localRequestIndottaDati.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
	}&#xD;
	localRequestIndottaDati.tipologiaSottolav = localRequestIndottaDati.ordine.tipologiaSottolav;&#xD;
	&#xD;
	if(localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;&#xD;
		|| localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot;&#xD;
		|| localRequest.codiceTrasformazione == &quot;CBTSATMSIMM&quot;&#xD;
		|| localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;) //RU_1109&#xD;
	{&#xD;
		localRequestIndottaDati.ordine.codiceSLAAssurance = assetConsistenzaDati.codiceSLAAssurance;&#xD;
		&#xD;
		//IDRISORSA ISDN - per CESS ATM SIMM in tutti i casi valorizza con idrisorsa dell'asset - stessa cosa per CCAMBIOTECNOLOGIA&#xD;
		if((tipoLineaAssetDati!=null &amp;&amp; tipoLineaAssetDati == &quot;ISDN&quot; &amp;&amp; idRisorsaAssetDati!=null &amp;&amp; idRisorsaAssetDati!=&quot;&quot;)&#xD;
		|| (localRequest.codiceTrasformazione == &quot;CBTSATMSIMM&quot; &amp;&amp; idRisorsaAssetDati!=null &amp;&amp; idRisorsaAssetDati!=&quot;&quot;)&#xD;
		|| (localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot; &amp;&amp; idRisorsaAssetDati!=null &amp;&amp; idRisorsaAssetDati!=&quot;&quot;)) //RU_1109&#xD;
		{&#xD;
			localRequestIndottaDati.IDRisorsa = idRisorsaAssetDati;&#xD;
			localRequestIndottaDati.ordine.IDRisorsa = idRisorsaAssetDati;&#xD;
			localRequestIndottaDati.ordine.IDRisorsaNOW = idRisorsaAssetDati;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(assetConsistenzaDati.cliente != null){&#xD;
		localRequestIndottaDati.ordine.nome = assetConsistenzaDati.cliente.nome;&#xD;
		localRequestIndottaDati.ordine.PIVA = assetConsistenzaDati.cliente.partitaIVA;&#xD;
	}&#xD;
	&#xD;
	localRequestIndottaDati.ordine.operatore = localRequestIndottaDati.operatore;&#xD;
	localRequestIndottaDati.ordine.numeroTelefonico = localRequestIndottaDati.numeroTelefonico;	&#xD;
	localRequestIndottaDati.ordine.distretto = assetConsistenzaDati.distretto;	&#xD;
	localRequestIndottaDati.ordine.CLLI = assetConsistenzaDati.CLLI;	&#xD;
	&#xD;
	//SM_8945 Aggiunta valorizzazione NUMEROFITTIZIO DALLA CONSISTENZA DATI&#xD;
	if ((localRequest.codiceTrasformazione!=&quot;CBTSATMSIMM&quot; || localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;)&#xD;
	&amp;&amp; assetConsistenzaDati.numeroFittizio!= null &amp;&amp; assetConsistenzaDati.numeroFittizio!=&quot;&quot;){&#xD;
		localRequestIndottaDati.ordine.numeroFittizio = assetConsistenzaDati.numeroFittizio;&#xD;
	}&#xD;
	&#xD;
	//RU_1386: per TSHA_ULLD e TCOND_NAKED con tipolinea = POTS, se una fra CONSISTENZAFONIA o DATI è marcata FC allora l'indotta va marcata FC&#xD;
	if(OPRETEconsDatiFonia != null &amp;&amp; TIPOLINEAconsDati == &quot;POTS&quot;)&#xD;
	{&#xD;
		localRequestIndottaDati.operatoreRete = OPRETEconsDatiFonia;&#xD;
		localRequestIndottaDati.ordine.operatoreRete = OPRETEconsDatiFonia;&#xD;
	}&#xD;
	else //solito&#xD;
	{	&#xD;
		//RU_1142 - SM_10667&#xD;
		localRequestIndottaDati.operatoreRete = assetConsistenzaDati.operatoreRete;&#xD;
		localRequestIndottaDati.ordine.operatoreRete = assetConsistenzaDati.operatoreRete;&#xD;
	}&#xD;
}&#xD;
&#xD;
//Prepara richiesta per fonia&#xD;
if(localRequestIndottaFonia != null){&#xD;
&#xD;
	//recupera ID Asset&#xD;
	var assetConsistenzaFonia = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
	assetConsistenzaFonia = null;&#xD;
	var idAsset = 0;&#xD;
	idAsset = null;&#xD;
	var idRisorsaAssetFonia = &quot;&quot;;&#xD;
	idRisorsaAssetFonia = null;&#xD;
	&#xD;
	if(consistenzaFoniaTemp!=null)&#xD;
	{&#xD;
		var i=0;	&#xD;
		while(i&lt;consistenzaFoniaTemp.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attr = consistenzaFoniaTemp.attributiDettaglioOrdine.get(i);&#xD;
			if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				if(!isNaN(attr.valoreAttributo)){&#xD;
					idAsset = ScriptUtil.createBigInteger(attr.valoreAttributo);&#xD;
					Process.auditLog(&quot;idAsset utilizzato per ordine indotto relativo alla consistenza fonia:&quot;+idAsset);&#xD;
				}&#xD;
			}&#xD;
			else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
			{&#xD;
				idRisorsaAssetFonia = attr.valoreAttributo;&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
	else{&#xD;
		idAsset=IdAssetTBUNDLE;&#xD;
	}&#xD;
	&#xD;
	// recupera asset&#xD;
	var assetTemp = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(idAsset);&#xD;
	assetConsistenzaFonia = assetTemp.readAsset();&#xD;
	&#xD;
	// RU_904: aggiunta valorizzazione codiceOrdineOLOPadre da passare al processo di GenerazioneCodiceOrdineOLO per la concat con la sequence&#xD;
	CodiceOrdineOloPadre = assetConsistenzaFonia.codiceOrdineOLO;	&#xD;
	localRequestIndottaFonia.codificaOLOAGCOM = assetConsistenzaFonia.codificaOLOAGCOM;&#xD;
	localRequestIndottaFonia.codificaOLONOW; // da aggiungere il recupero mediante servizio&#xD;
	&#xD;
	// RU_1109&#xD;
	if(localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;){&#xD;
		localRequestIndottaFonia.IDContratto = assetConsistenzaFonia.IDContratto;&#xD;
	}&#xD;
	&#xD;
	if(localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;){&#xD;
		localRequestIndottaFonia.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA;&#xD;
	}&#xD;
	else if(localRequest.codiceTrasformazione == &quot;TBUNDLE&quot;){&#xD;
		if(assetConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP){&#xD;
			localRequestIndottaFonia.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA;&#xD;
		} &#xD;
		else if(assetConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP){&#xD;
			localRequestIndottaFonia.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA;&#xD;
		}&#xD;
		else if(assetConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP){&#xD;
			localRequestIndottaFonia.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA;&#xD;
		}&#xD;
	}&#xD;
	else{&#xD;
		localRequestIndottaFonia.offerta = assetConsistenzaFonia.offerta;&#xD;
	}&#xD;
	&#xD;
	localRequestIndottaFonia.IDOfferta = assetConsistenzaFonia.IDOfferta;&#xD;
	&#xD;
	if(listaOfferteNGA.contains(String(assetConsistenzaFonia.offerta))){&#xD;
		localRequestIndottaFonia.strutturaRichiesta = it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA;&#xD;
	}&#xD;
	else if(listaOfferteXDSL.contains(String(assetConsistenzaFonia.offerta))){&#xD;
		localRequestIndottaFonia.strutturaRichiesta = it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL;&#xD;
	}&#xD;
	else{&#xD;
		localRequestIndottaFonia.strutturaRichiesta = it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO;&#xD;
	}&#xD;
	&#xD;
	if(localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;&#xD;
	|| localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;){&#xD;
		localRequestIndottaFonia.numeroTelefonico = localRequest.numeroTelefonico;&#xD;
	}&#xD;
&#xD;
	if(localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;){&#xD;
		localRequestIndottaFonia.IDRisorsaCorrelato = localRequest.IDRisorsa;&#xD;
	}&#xD;
	&#xD;
	//Prepara Ordine&#xD;
	localRequestIndottaFonia.ordine.codificaOLOAGCOM = localRequestIndottaFonia.codificaOLOAGCOM;	&#xD;
	localRequestIndottaFonia.ordine.offerta = localRequestIndottaFonia.offerta;&#xD;
	&#xD;
	//tipologiaAccesso	&#xD;
	if(localRequestIndottaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP){&#xD;
		localRequestIndottaFonia.ordine.tipologiaAccesso = it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIADATI;&#xD;
	}&#xD;
	else if(listaOfferteFONIA.contains(String(localRequestIndottaFonia.offerta))){&#xD;
		localRequestIndottaFonia.ordine.tipologiaAccesso = it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA;&#xD;
	}&#xD;
	else{&#xD;
		localRequestIndottaFonia.ordine.tipologiaAccesso = it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.DATI;&#xD;
	}&#xD;
	&#xD;
	//tipologiaSottolav&#xD;
	if(localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;){&#xD;
		localRequestIndottaFonia.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PASSAGGIOLA;&#xD;
	}&#xD;
	else if(localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot;){&#xD;
		localRequestIndottaFonia.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PASSAGGIOLNF;&#xD;
	}&#xD;
	else if(localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;){&#xD;
		localRequestIndottaFonia.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PASSAGGIOULLD;&#xD;
	}&#xD;
	else if(localRequest.codiceTrasformazione == &quot;TBUNDLE&quot;){&#xD;
		localRequestIndottaFonia.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TBUNDLE;&#xD;
	}&#xD;
	else if(localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;){&#xD;
		localRequestIndottaFonia.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
	}&#xD;
	&#xD;
	localRequestIndottaFonia.tipologiaSottolav = localRequestIndottaFonia.ordine.tipologiaSottolav;&#xD;
	&#xD;
	if(localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;) //RU_1109&#xD;
	{&#xD;
		if(idRisorsaAssetFonia!=null &amp;&amp; idRisorsaAssetFonia!=&quot;&quot;){&#xD;
			localRequestIndottaFonia.IDRisorsa = idRisorsaAssetFonia;&#xD;
			localRequestIndottaFonia.ordine.IDRisorsa = idRisorsaAssetFonia;&#xD;
			localRequestIndottaFonia.ordine.IDRisorsaNOW = idRisorsaAssetFonia;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(assetConsistenzaFonia.cliente != null){&#xD;
		localRequestIndottaFonia.ordine.nome = assetConsistenzaFonia.cliente.nome;&#xD;
		localRequestIndottaFonia.ordine.PIVA = assetConsistenzaFonia.cliente.partitaIVA;&#xD;
	}&#xD;
	&#xD;
	localRequestIndottaFonia.ordine.operatore = localRequestIndottaFonia.operatore;&#xD;
	localRequestIndottaFonia.ordine.numeroTelefonico = localRequestIndottaFonia.numeroTelefonico;&#xD;
	&#xD;
	//RU_1386: per TSHA_ULLD e TCOND_NAKED con tipolinea = POTS, se una fra CONSISTENZAFONIA o DATI è marcata FC allora l'indotta va marcata FC&#xD;
	if(OPRETEconsDatiFonia != null &amp;&amp; TIPOLINEAconsDati == &quot;POTS&quot;)&#xD;
	{&#xD;
		localRequestIndottaDati.operatoreRete = OPRETEconsDatiFonia;&#xD;
		localRequestIndottaDati.ordine.operatoreRete = OPRETEconsDatiFonia;&#xD;
	}&#xD;
	else //solito&#xD;
	{&#xD;
		//RU_1142 - SM_10667&#xD;
		localRequestIndottaFonia.operatoreRete = assetConsistenzaFonia.operatoreRete;&#xD;
		localRequestIndottaFonia.ordine.operatoreRete = assetConsistenzaFonia.operatoreRete;&#xD;
	}&#xD;
	&#xD;
	localRequestIndottaFonia.ordine.distretto = assetConsistenzaFonia.distretto;	&#xD;
	localRequestIndottaFonia.ordine.CLLI = assetConsistenzaFonia.CLLI;&#xD;
	&#xD;
	if(IdAssetTBUNDLE!=null &amp;&amp; IdAssetTBUNDLE!=&quot;&quot;)&#xD;
	{&#xD;
		var TIPOLINEA=&quot;&quot;;&#xD;
		var STRUTTURALINEA=&quot;&quot;;&#xD;
		var k=0;&#xD;
		var trovataAccesso=false;&#xD;
		&#xD;
		while(!trovataAccesso &amp;&amp; k&lt;assetConsistenzaFonia.dettaglioasset.size()){&#xD;
			var compTemp = assetConsistenzaFonia.dettaglioasset.get(k);&#xD;
				&#xD;
			if(String(compTemp.nomeComponente).slice(0,7)==&quot;ACCESSO&quot;){&#xD;
				trovataAccesso=true;&#xD;
			&#xD;
				var j=0;			&#xD;
				while((TIPOLINEA==&quot;&quot; || STRUTTURALINEA==&quot;&quot;) &amp;&amp; j&lt;compTemp.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attrTemp = compTemp.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
						TIPOLINEA = attrTemp.valoreAttributo;&#xD;
					}&#xD;
						&#xD;
					if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA){&#xD;
						STRUTTURALINEA = attrTemp.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	&#xD;
		ConsistenzaFonia = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFoniaType();&#xD;
		ConsistenzaFonia.IDRisorsa = assetConsistenzaFonia.IDRisorsa;&#xD;
		&#xD;
		//ID RISORSA CORRELATO&#xD;
		if(assetConsistenzaFonia.IDRisorsaCorrelato!= null &amp;&amp; assetConsistenzaFonia.IDRisorsaCorrelato!= &quot;&quot;){&#xD;
			ConsistenzaFonia.IDRisorsaCorrelato = assetConsistenzaFonia.IDRisorsaCorrelato;&#xD;
		}&#xD;
		&#xD;
		//OFFERTA&#xD;
		if(assetConsistenzaFonia.offerta != null &amp;&amp; assetConsistenzaFonia.offerta != &quot;&quot;){&#xD;
			ConsistenzaFonia.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetConsistenzaFonia.offerta));&#xD;
		}	&#xD;
				&#xD;
		//CODICEOPERATOREDONATING&#xD;
		ConsistenzaFonia.codificaOLOAGCOMDonating = assetConsistenzaFonia.codificaOLOAGCOM;&#xD;
		&#xD;
		//CODICEORDINETI&#xD;
		if(assetConsistenzaFonia.codiceOrdineTI != null &amp;&amp; assetConsistenzaFonia.codiceOrdineTI !=&quot;&quot;){&#xD;
			ConsistenzaFonia.codiceOrdineTI = assetConsistenzaFonia.codiceOrdineTI;&#xD;
		}&#xD;
		&#xD;
		//CODICEORDINEOLO&#xD;
		if(assetConsistenzaFonia.codiceOrdineOLO != null &amp;&amp; assetConsistenzaFonia.codiceOrdineOLO !=&quot;&quot;){&#xD;
			ConsistenzaFonia.codiceOrdineOLO = assetConsistenzaFonia.codiceOrdineOLO;&#xD;
		}&#xD;
		&#xD;
		//IDENTIFICATIVOASSET&#xD;
		if(assetConsistenzaFonia.IDAsset != null){&#xD;
			ConsistenzaFonia.IDAsset = assetConsistenzaFonia.IDAsset;&#xD;
		}&#xD;
		&#xD;
		//TIPOLINEA&#xD;
		if(TIPOLINEA != null &amp;&amp; TIPOLINEA!= &quot;&quot;){&#xD;
			ConsistenzaFonia.tipoLinea = TIPOLINEA;&#xD;
		}&#xD;
		&#xD;
		//STRUTTURALINEA&#xD;
		if(STRUTTURALINEA!= null &amp;&amp; STRUTTURALINEA!=&quot;&quot;){&#xD;
			ConsistenzaFonia.strutturaLinea = STRUTTURALINEA;&#xD;
		}&#xD;
		&#xD;
		//STATO&#xD;
		ConsistenzaFonia.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(assetConsistenzaFonia.statoAsset));&#xD;
		&#xD;
		//NUMERO TELEFONICO&#xD;
		if(assetConsistenzaFonia.numeroTelefonico != null &amp;&amp; assetConsistenzaFonia.numeroTelefonico != &quot;&quot;){&#xD;
			ConsistenzaFonia.numeroTelefonico = assetConsistenzaFonia.numeroTelefonico;&#xD;
		}&#xD;
		&#xD;
		//NUMERO TELEFONICO PRINCIPALE&#xD;
		if(assetConsistenzaFonia.numTelPrincipale!= null &amp;&amp; assetConsistenzaFonia.numTelPrincipale!= &quot;&quot;){&#xD;
			ConsistenzaFonia.numeroTelefonicoPrincipale = assetConsistenzaFonia.numTelPrincipale;&#xD;
		}&#xD;
		&#xD;
		//NUMERO FITTIZIO&#xD;
		if(assetConsistenzaFonia.numeroFittizio!= null &amp;&amp; assetConsistenzaFonia.numeroFittizio != &quot;&quot;){&#xD;
			ConsistenzaFonia.numeroFittizio = assetConsistenzaFonia.numeroFittizio;&#xD;
		}&#xD;
		&#xD;
		//OPERATORERETE - Bug #39091&#xD;
		if(assetConsistenzaFonia.operatoreRete!= null &amp;&amp; assetConsistenzaFonia.operatoreRete != &quot;&quot;){&#xD;
			ConsistenzaFonia.operatoreRete = assetConsistenzaFonia.operatoreRete;&#xD;
		}&#xD;
		&#xD;
		//AZIONE&#xD;
		ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
		&#xD;
		if(localRequestIndottaFonia.ordine != null)&#xD;
		{&#xD;
			if(ConsistenzaFonia != null){&#xD;
				var data = DateTimeUtil.createDatetime();&#xD;
				&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDRichiestaOLO = localRequestIndottaFonia.IDRichiestaOLO;&#xD;
				attributo.created = data;&#xD;
				attributo.lastUpdate = data;&#xD;
				attributo.operatore = localRequestIndottaFonia.operatore;&#xD;
				&#xD;
				var indexConsistenzaFonia = -1;&#xD;
				var dettaglio = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
				dettaglio.IDDettaglioOrdine = 2;				&#xD;
				attributo.IDDettaglioOrdine = dettaglio.IDDettaglioOrdine;&#xD;
				&#xD;
				dettaglio.IDDettaglioOrdineParent = 1;&#xD;
				dettaglio.IDDettaglioOrdineRoot = 1;&#xD;
				dettaglio.IDRichiestaOLO = localRequestIndottaFonia.IDRichiestaOLO;&#xD;
				dettaglio.IDRisorsa = localRequestIndottaFonia.IDRisorsa;&#xD;
				dettaglio.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(ConsistenzaFonia.azione);&#xD;
				dettaglio.created = data;&#xD;
				dettaglio.integrationID = localRequestIndottaFonia.IDRichiestaOLO + dettaglio.IDDettaglioOrdine;&#xD;
				dettaglio.lastUpdate = data;&#xD;
				dettaglio.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA;&#xD;
				dettaglio.operatore = &quot;BPM&quot;;&#xD;
				dettaglio.progressivo = 1;&#xD;
				&#xD;
				localRequestIndottaFonia.ordine.dettaglioordine.add(ScriptUtil.copy(dettaglio));&#xD;
				indexConsistenzaFonia = localRequestIndottaFonia.ordine.dettaglioordine.size() - 1;&#xD;
				&#xD;
				//CONSISTENZAFONIA.IDRISORSA&#xD;
				if(ConsistenzaFonia.IDRisorsa != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = ConsistenzaFonia.IDRisorsa;				&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//CONSISTENZAFONIA.IDRISORSACORRELATO&#xD;
				if(ConsistenzaFonia.IDRisorsaCorrelato != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSACORRELATO;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = ConsistenzaFonia.IDRisorsaCorrelato;					&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//CONSISTENZAFONIA.OFFERTA&#xD;
				if(ConsistenzaFonia.offerta != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = String(ConsistenzaFonia.offerta);					&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//CONSISTENZAFONIA.CODICEOPERATOREDONATING&#xD;
				if(ConsistenzaFonia.codificaOLOAGCOMDonating != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = ConsistenzaFonia.codificaOLOAGCOMDonating;					&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}		&#xD;
				&#xD;
				//CONSISTENZAFONIA.CODICEORDINETI&#xD;
				if(ConsistenzaFonia.codiceOrdineTI != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETI;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = ConsistenzaFonia.codiceOrdineTI;					&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//CONSISTENZAFONIA.CODICEORDINEOLO&#xD;
				if(ConsistenzaFonia.codiceOrdineOLO != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLO;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = ConsistenzaFonia.codiceOrdineOLO;					&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//CONSISTENZAFONIA.IDENTIFICATIVOASSET&#xD;
				if(ConsistenzaFonia.IDAsset != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = ConsistenzaFonia.IDAsset;					&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//CONSISTENZAFONIA.TIPOLINEA&#xD;
				if(ConsistenzaFonia.tipoLinea != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = ConsistenzaFonia.tipoLinea;					&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//CONSISTENZAFONIA.STRUTTURALINEA&#xD;
				if(ConsistenzaFonia.strutturaLinea != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = ConsistenzaFonia.strutturaLinea;					&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//CONSISTENZAFONIA.STATO&#xD;
				if(ConsistenzaFonia.stato != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = String(ConsistenzaFonia.stato);					&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));	&#xD;
				}&#xD;
				&#xD;
				//CONSISTENZAFONIA.NUMEROTELEFONICO&#xD;
				if(ConsistenzaFonia.numeroTelefonico != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = ConsistenzaFonia.numeroTelefonico;					&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//CONSISTENZAFONIA.NUMEROTELEFONICOPRINCIPALE&#xD;
				if(ConsistenzaFonia.numeroTelefonicoPrincipale != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = ConsistenzaFonia.numeroTelefonicoPrincipale;					&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//CONSISTENZAFONIA.OPERATORERETE - Bug #39091&#xD;
				if(ConsistenzaFonia.operatoreRete != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPERATORERETE;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = ConsistenzaFonia.operatoreRete;				&#xD;
					localRequestIndottaFonia.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
			}&#xD;
			else{&#xD;
				Process.auditLog(&quot;Consistenza Fonia non trovata&quot;);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//In caso di TNAKED_COND valorizzo la TipologiaLinea dell'ordine con quella dell'ACCESSOWLR per utilizzarlo poi in fase di arricchiemnto dell'indotta come TipoLineaFonia&#xD;
if((localRequestIndottaFonia != null &amp;&amp; localRequestIndottaFonia.codiceTrasformazione == &quot;TNAKED_COND&quot;)&#xD;
	|| (localRequestIndottaDati != null &amp;&amp; localRequestIndottaDati.codiceTrasformazione == &quot;TNAKED_COND&quot;))&#xD;
{&#xD;
	var tipoLineaFonia = &quot;&quot;;&#xD;
	tipoLineaFonia = null;&#xD;
	&#xD;
	var i = 0;&#xD;
	&#xD;
	while(tipoLineaFonia == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
		{&#xD;
			var j = 0;&#xD;
			&#xD;
			while(tipoLineaFonia == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
					tipoLineaFonia = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(tipoLineaFonia != null)&#xD;
	{&#xD;
		if(localRequestIndottaDati != null){&#xD;
			localRequestIndottaDati.ordine.tipologiaLinea = it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.get(tipoLineaFonia.toUpperCase());&#xD;
		}&#xD;
		&#xD;
		if(localRequestIndottaFonia != null){&#xD;
			localRequestIndottaFonia.ordine.tipologiaLinea = it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.get(tipoLineaFonia.toUpperCase());&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
