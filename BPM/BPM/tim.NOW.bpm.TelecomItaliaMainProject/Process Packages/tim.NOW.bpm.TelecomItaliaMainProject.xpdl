                  <xpdExt:ScriptInformation Id="_kUVyRRYTEeyISIzJMrLBiw" Name="TipoNotifica"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if(localRequest.testMode != null &amp;&amp; localRequest.testMode == 1)&#xD;
{&#xD;
	&quot;TM&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;KO&quot;;&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
