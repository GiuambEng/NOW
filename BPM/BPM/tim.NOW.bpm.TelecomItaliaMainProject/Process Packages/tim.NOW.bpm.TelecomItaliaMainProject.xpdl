        <xpdl2:Activity Id="_04iCAlxNEe6Zd8rLxxiF9A" Name="VerificaRDAC" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica RDAC" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//SCRIPT INSERITO CON SM_11126&#xD;
//Quando solo alcune delle richieste di un pacchetto sono entrate in cautelare, la RDAC è avvenuta solo su quelle che sono entrate in cautelare, quindi dobbiamo:&#xD;
//1) Rimodulare la DAC di quelle richieste non entrate in cautelare&#xD;
//2) Rimodulare la DAC di quelle entrate in cautelare ma aventi una DAC minore&#xD;
&#xD;
RimodulazioneDAC = false;&#xD;
&#xD;
//LA RICHIESTA FA PARTE DI UN PACCHETTO&#xD;
if(localRequest.codicePacchettoNOW != null &amp;&amp; localRequest.codicePacchettoNOW != &quot;&quot; &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;codicePacchettoNOW=:SearchCodicePacchettoNOW AND tipoRichiesta='ORDINE' AND idTplgCautelare='Y' AND ordine.DACRimodulata != NULL ORDER BY ordine.DACRimodulata DESC&quot;);&#xD;
	criteria.setQueryParameter(&quot;SearchCodicePacchettoNOW&quot;,localRequest.codicePacchettoNOW);		&#xD;
	RichiestePacchettoRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
	&#xD;
	//SE è PRESENTE ALMENO UNA RICHIESTA DEL PACCHETTO ANDATA IN CAUTELARE, ALLORA BISOGNA ALLINEARE LE DAC CON LA RIMODULAZIONE	&#xD;
	if(RichiestePacchettoRef.size()>0)&#xD;
	{&#xD;
		Process.auditLog(&quot;Recuperate &quot; +RichiestePacchettoRef.size()+ &quot;richieste in cautelare per codicePacchettoNOW = &quot; +localRequest.codicePacchettoNOW);&#xD;
		&#xD;
		//SALVO LA DAC MAGGIORE e l'IDRICHIESTAOLO con DAC MAGGIORE&#xD;
		var RichiestaPactoRef = RichiestePacchettoRef.get(0);&#xD;
		var RichiestaPacto = RichiestaPactoRef.readRichiesta();&#xD;
		&#xD;
		if(RichiestaPacto != null &amp;&amp; RichiestaPacto.ordine != null &amp;&amp; RichiestaPacto.ordine.DACRimodulata != null)&#xD;
		{&#xD;
			DACmaggiore = DateTimeUtil.createDate(RichiestaPacto.ordine.DACRimodulata);&#xD;
			&#xD;
			//VERIFICO LE CONDIZIONI PER RIMODULARE LA DAC&#xD;
			//Se la richiesta corrente è proprio quella con DAC maggiore o la richiesta corrente ha già la stessa DAC della DAC maggiore (è entrata in cautelare e ha rimodulato allo stesso modo), allora non devo rimodulare&#xD;
			if(localRequest.IDRichiestaOLO != RichiestaPacto.IDRichiestaOLO &#xD;
			   &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.DACRimodulata != null     //Bug #52927&#xD;
			   &amp;&amp; DateTimeUtil.createDate(localRequest.ordine.DACRimodulata) &lt; DACmaggiore)    //Bug #52421&#xD;
			{&#xD;
				RimodulazioneDAC = true;&#xD;
				Process.auditLog(&quot;Rimoduliamo la richiesta avente DACRimodulata = &quot; +String(localRequest.ordine.DACRimodulata) + &quot;con la DACmaggiore = &quot; +String(DACmaggiore));&#xD;
			}&#xD;
			//Bug #52927&#xD;
			else if(localRequest.ordine != null &amp;&amp; localRequest.ordine.DACRimodulata == null)&#xD;
			{&#xD;
				RimodulazioneDAC = true;&#xD;
				Process.auditLog(&quot;Rimoduliamo la richiesta corrente avente DACRimodulata = null, allineandola alla DACmaggiore&quot;);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				Process.auditLog(&quot;Non rimoduliamo la richiesta perchè ha già la DAC maggiore del pacchetto&quot;);&#xD;
			}&#xD;
		}&#xD;
		else &#xD;
		{&#xD;
			Process.auditLog(&quot;Non è presente la DACRimodulata nella richiesta&quot;);&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Nessuna richiesta in cautelare recuperata per codicePacchettoNOW = &quot; +localRequest.codicePacchettoNOW);&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="62.0" LaneId="_Q_PNMXIeEe2oK8wKjP8xaw" Width="98.0">
              <xpdl2:Coordinates XCoordinate="7264.0" YCoordinate="1089.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit/>
        </xpdl2:Activity>
