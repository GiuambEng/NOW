isBITSTREAMATMGBEeEASYIPCondiviso == false &amp;&amp; // Non è BTS ATM/GBE EasyIP CONDIVISO&#xD;
	(isVULACBITSTREAMNGAFTTCabCondiviso || 	  // Non è BTS ATM/GBE EasyIP NAKED, ma è uno degli altri casi&#xD;
