        <xpdl2:Activity Id="_1KRd0P0OEeaOLPpzGCQltg" Name="AggiornaRichiestainESPLETATAMENTOTECNICOOK" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna Richiesta in &quot;ESPLETATAMENTO TECNICO OK&quot;">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_ZnOAThbGEeaeO9dGiH03ag" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="dataType">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;Richiesta&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="requestRef">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="78.0" LaneId="_OTs_cwJCEeaPBpRvSvxznA" Width="158.0">
              <xpdl2:Coordinates XCoordinate="3054.0" YCoordinate="523.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
&#xD;
localRequest.statoRichiestaNOW=it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICO;&#xD;
localRequest.statoRichiestaOLO=it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ESPLETAMENTOTECNICO;&#xD;
&#xD;
//RU_1205&#xD;
if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOOLO)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATACUTOVER)&#xD;
				{&#xD;
					localRequest.ordine.DES = DateTimeUtil.createDate(attributo.valoreAttributo);&#xD;
					Process.auditLog(&quot;Trovato attributo DATACUTOVER&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ORACUTOVER)&#xD;
				{&#xD;
					localRequest.ordine.ORA_DES = DateTimeUtil.createTime(attributo.valoreAttributo);&#xD;
					Process.auditLog(&quot;Trovato attributo ORACUTOVER&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
}&#xD;
else //solito&#xD;
{&#xD;
	localRequest.ordine.DES = localRequest.DRO;&#xD;
}&#xD;
&#xD;
if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
{&#xD;
	localRequest.ordine.DEC = localRequest.ordine.DES;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
