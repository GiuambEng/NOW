        <xpdl2:Activity Id="_iCg1MuFKEe6Z9KxUL0H_Jw" Name="CatchDesospensione" xpdExt:Visibility="Private" xpdExt:DisplayName="Catch: Desospensione">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Target="_w4Xtscp2Ee6SQPH0yeqDKw" Trigger="Signal">
              <xpdl2:TriggerResultSignal CatchThrow="CATCH" Name="Desospensione">
                <xpdl2:Properties/>
              </xpdl2:TriggerResultSignal>
            </xpdl2:IntermediateEvent>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" LaneId="_OTs_cwJCEeaPBpRvSvxznA" Width="102.0">
              <xpdl2:Coordinates XCoordinate="0.0" YCoordinate="0.0"/>
            </xpdl2:NodeGraphicsInfo>
            <xpdl2:NodeGraphicsInfo ToolId="XPD.BorderEventPosition">
              <xpdl2:Coordinates XCoordinate="24.3436754176611" YCoordinate="0.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">localRequest = RequestRef.readRichiesta();&#xD;
&#xD;
//Aggiornamento campo flagAttesaDesospOLO&#xD;
localRequest.flagAttesaDesospOLO = 'NO';&#xD;
&#xD;
//Aggiornamento referenteAltreLavorazioni&#xD;
var calcProgressivo = 4;&#xD;
&#xD;
if(referenteAltreLavorazioni != null)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.referente.size(); i++)&#xD;
	{&#xD;
		var currentReferente = localRequest.ordine.referente.get(i);&#xD;
&#xD;
		if(currentReferente.tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTEPERINTERRUZIONESOSPENSIONE&#xD;
		   ||currentReferente.tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTERIMODULAZIONEAPPUNTAMENTO)&#xD;
		{&#xD;
			calcProgressivo++;&#xD;
		}&#xD;
	}	&#xD;
	referenteAltreLavorazioni.progressivoReferente = calcProgressivo;&#xD;
	referenteAltreLavorazioni.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	localRequest.ordine.referente.add(ScriptUtil.copy(referenteAltreLavorazioni));&#xD;
}	</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
