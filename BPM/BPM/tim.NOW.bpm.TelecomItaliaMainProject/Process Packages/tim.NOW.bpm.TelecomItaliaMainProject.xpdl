&amp;&amp; (!(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG   &#xD;
    &amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.B2B)) //SM_11353: sostituito NPG &amp;&amp; B2B invece di PORTABILITASUCCESSIVADEL82&#xD;
&amp;&amp; localRequest.strutturaRichiesta != it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FIBERSTREAM   //RU_1451&#xD;
