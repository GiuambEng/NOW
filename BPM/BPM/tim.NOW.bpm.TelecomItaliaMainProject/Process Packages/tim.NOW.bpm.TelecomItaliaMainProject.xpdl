          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="94.0" LaneId="_Q_PNMXIeEe2oK8wKjP8xaw" Width="163.0">
              <xpdl2:Coordinates XCoordinate="1063.0" YCoordinate="663.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.Controls.Management/Process Packages/tim.NOW.bpm.TelecomItaliaControlli.xpdl.TINOWControlliFormalieTecnicheAttivazioneNPDel103&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">//SM_11034: nel caso in cui entriamo in gestione Cautelare, saltiamo la chiamata ad Inventory, dunque per il calcolo di caso Semplice/Complesso vanno considerati TIPONUMERO e TIPOSERVIZIO della prima chiamata ad Inventory&#xD;
if(InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null &amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea != null)&#xD;
{&#xD;
	//TIPONUMERO&#xD;
	if(InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero != null)&#xD;
	{&#xD;
		TIPONUMERO = InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero;&#xD;
	}&#xD;
	&#xD;
	//TIPOSERVIZIO&#xD;
	if(InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio != null)&#xD;
	{&#xD;
		TIPOSERVIZIO = InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;TIPONUMERO: &quot; + TIPONUMERO + &quot;; TIPOSERVIZIO: &quot; + TIPOSERVIZIO);</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
