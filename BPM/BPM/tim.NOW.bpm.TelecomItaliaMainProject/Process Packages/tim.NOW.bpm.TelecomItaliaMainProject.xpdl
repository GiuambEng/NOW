        <xpdl2:Activity Id="_RI6HwPOfEea0IIfSNuNvZQ" Name="PreparaRichiestaIndotta" xpdExt:Visibility="Private" xpdExt:DisplayName="Prepara Richiesta Indotta">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var listaOfferteREGOLATORIO = DataUtil.createList();&#xD;
var listaOfferteXDSL = DataUtil.createList();&#xD;
var listaOfferteNGA = DataUtil.createList();&#xD;
var listaOfferteFONIA = DataUtil.createList();&#xD;
&#xD;
listaOfferteFONIA.add(&quot;ULLLINEANONATTIVA&quot;);&#xD;
listaOfferteFONIA.add(&quot;ULLLINEAATTIVA&quot;);&#xD;
listaOfferteFONIA.add(&quot;ULLDATILINEANONATTIVA&quot;);&#xD;
listaOfferteFONIA.add(&quot;ULLDATILINEAATTIVA&quot;);&#xD;
listaOfferteFONIA.add(&quot;SLULINEANONATTIVA&quot;);&#xD;
listaOfferteFONIA.add(&quot;SLULINEAATTIVA&quot;);&#xD;
listaOfferteFONIA.add(&quot;VULLLINEANONATTIVA&quot;);&#xD;
listaOfferteFONIA.add(&quot;WLRLINEANONATTIVA&quot;);&#xD;
listaOfferteFONIA.add(&quot;WLRLINEAATTIVA&quot;);&#xD;
listaOfferteFONIA.add(&quot;VULL&quot;);&#xD;
listaOfferteFONIA.add(&quot;ULLLINEAATTIVANP&quot;);&#xD;
listaOfferteFONIA.add(&quot;ULLDATILINEAATTIVANP&quot;);&#xD;
listaOfferteFONIA.add(&quot;SLULINEAATTIVANP&quot;);&#xD;
&#xD;
listaOfferteREGOLATORIO.add(&quot;ULLLINEANONATTIVA&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;ULLLINEAATTIVA&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;ULLDATILINEANONATTIVA&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;ULLDATILINEAATTIVA&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;SLULINEANONATTIVA&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;SLULINEAATTIVA&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;VULLLINEANONATTIVA&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;WLRLINEANONATTIVA&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;SHACONMANODOPERA&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;SHASENZAMANODOPERA&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;WLRLINEAATTIVA&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;VULL&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;ULLLINEAATTIVANP&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;ULLDATILINEAATTIVANP&quot;);&#xD;
listaOfferteREGOLATORIO.add(&quot;SLULINEAATTIVANP&quot;);&#xD;
&#xD;
listaOfferteXDSL.add(&quot;BITSTREAMGBEASIMMETRICOFLAT&quot;);&#xD;
listaOfferteXDSL.add(&quot;BITSTREAMATMASIMMETRICOFLAT&quot;);&#xD;
listaOfferteXDSL.add(&quot;BITSTREAMATMASIMMETRICOHL&quot;);&#xD;
listaOfferteXDSL.add(&quot;BITSTREAMATMASIMMETRICOLITE&quot;);&#xD;
listaOfferteXDSL.add(&quot;EASYIPBASEPLUSFLAT&quot;);&#xD;
listaOfferteXDSL.add(&quot;EASYIPBASEPLUSLITE&quot;);&#xD;
listaOfferteXDSL.add(&quot;EASYIPSPECIALPROFILEFLAT&quot;);&#xD;
listaOfferteXDSL.add(&quot;EASYIPSPECIALPROFILELITE&quot;);&#xD;
listaOfferteXDSL.add(&quot;BITSTREAMATMSIMMETRICOFLAT&quot;);&#xD;
listaOfferteXDSL.add(&quot;BITSTREAMATMSIMMETRICOHL&quot;);&#xD;
listaOfferteXDSL.add(&quot;BITSTREAMGBESIMMETRICOFLAT&quot;);&#xD;
listaOfferteXDSL.add(&quot;BITSTREAMATMSIMMETRICO&quot;);&#xD;
listaOfferteXDSL.add(&quot;BITSTREAMGBESIMMETRICO&quot;);&#xD;
&#xD;
listaOfferteNGA.add(&quot;BITSTREAMNGAFTTCAB&quot;);&#xD;
listaOfferteNGA.add(&quot;BITSTREAMNGAFTTH&quot;);&#xD;
listaOfferteNGA.add(&quot;VULAFTTCAB&quot;);&#xD;
listaOfferteNGA.add(&quot;VULAFTTH&quot;);&#xD;
listaOfferteNGA.add(&quot;EASYIPNGAFTTCAB&quot;);&#xD;
listaOfferteNGA.add(&quot;EASYIPNGAFTTH&quot;);&#xD;
listaOfferteNGA.add(&quot;SEMIVULAFTTH&quot;);              //RU_1164: aggiunte offerte SEMI***&#xD;
listaOfferteNGA.add(&quot;SEMIBITSTREAMNGAFTTH&quot;);&#xD;
listaOfferteNGA.add(&quot;SEMIEASYIPNGAFTTH&quot;);&#xD;
&#xD;
//RU_1386: recupero TIPOLINEA e OPERATORERETE&#xD;
var TIPOLINEAconsDati = &quot;&quot;; TIPOLINEAconsDati = null;&#xD;
var OPRETEconsDatiFonia = &quot;&quot;; OPRETEconsDatiFonia = null;&#xD;
&#xD;
if(localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot; || localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot;)&#xD;
{	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI&#xD;
		   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++){&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA&#xD;
				   &amp;&amp; componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI){&#xD;
					TIPOLINEAconsDati = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo TIPOLINEA della CONSISTENZADATI: &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPERATORERETE){&#xD;
					OPRETEconsDatiFonia = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo OPERATORERETE&quot;+ attributo.valoreAttributo +&quot; su componente &quot;+componente.nomeComponente);			&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
localRequestIndottaDati = null;&#xD;
localRequestIndottaFonia= null;&#xD;
var date = DateTimeUtil.createDate();&#xD;
var datetime = DateTimeUtil.createDatetime();&#xD;
Process.auditLog(&quot;Inizio calcolo lavorazioni indotte, codice trasformazione: &quot;+localRequest.codiceTrasformazione);&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.canaleRichiesta != it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL)&#xD;
{&#xD;
	var richiestaTemp = it_telecomitalia_it_NOW_casedata_Factory.createRichiesta();&#xD;
	richiestaTemp.ordine = it_telecomitalia_it_NOW_casedata_Factory.createOrdine();&#xD;
	&#xD;
	//richiesta&#xD;
	richiestaTemp.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.PERVENUTO;&#xD;
	richiestaTemp.ambito = &quot;NOW&quot;;&#xD;
	richiestaTemp.canaleRichiesta = it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL;&#xD;
	&#xD;
	if(localRequest.codiceTrasformazione == &quot;CBTSATMSIMM&quot;&#xD;
	|| localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;) //RU_1109&#xD;
	{&#xD;
		richiestaTemp.lavorazione =  it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE;&#xD;
	}&#xD;
	else{&#xD;
		richiestaTemp.lavorazione =  it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE;&#xD;
