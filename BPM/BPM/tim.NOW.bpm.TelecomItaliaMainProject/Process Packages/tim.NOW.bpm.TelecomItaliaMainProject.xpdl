	}&#xD;
	&#xD;
	richiestaTemp.IDRichiestaOLOGenerante = localRequest.IDRichiestaOLO;&#xD;
	richiestaTemp.codiceTrasformazione = localRequest.codiceTrasformazione;&#xD;
	richiestaTemp.codificaOLONOW = &quot;&quot;; // da aggiungere il recupero mediante servizio&#xD;
