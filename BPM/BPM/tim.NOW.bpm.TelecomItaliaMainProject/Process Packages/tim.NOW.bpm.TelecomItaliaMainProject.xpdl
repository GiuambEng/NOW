	{&#xD;
		richiestaTemp.ordine.DAC = date;&#xD;
	}&#xD;
	&#xD;
	richiestaTemp.ordine.operatore = &quot;BPM&quot;;&#xD;
	richiestaTemp.ordine.codificaOLONOW = &quot;&quot;; // da aggiungere il recupero mediante servizio&#xD;
	&#xD;
	if(localRequest.codiceTrasformazione == &quot;CBTSATMSIMM&quot;&#xD;
	|| localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;) //RU_1109&#xD;
	{&#xD;
		richiestaTemp.ordine.tipologiaLavorazione =  it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE;&#xD;
	}&#xD;
	else{&#xD;
		richiestaTemp.ordine.tipologiaLavorazione = it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE;&#xD;
	}&#xD;
	&#xD;
	richiestaTemp.ordine.created = datetime;&#xD;
	richiestaTemp.ordine.IDRichiestaOLO = &quot;&quot;;&#xD;
	richiestaTemp.ordine.IDRisorsa = localRequest.ordine.IDRisorsa;&#xD;
	richiestaTemp.ordine.sede.addAll(ScriptUtil.copyAll(localRequest.ordine.sede));&#xD;
&#xD;
	//cerca componenti consistenza&#xD;
	var consistenzaDatiTemp = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
	consistenzaDatiTemp= null;&#xD;
	var consistenzaFoniaTemp = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
	consistenzaFoniaTemp = null;&#xD;
	&#xD;
	var i=0;&#xD;
	while(i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI &amp;&amp; comp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.T)&#xD;
		{&#xD;
			consistenzaDatiTemp = ScriptUtil.copy(comp);&#xD;
			&#xD;
			//RU_1109: da mettere ad S solo se nell'ambito di CCAMBIOTECNOLOGIA troviamo la consistenza dati e non la fonia a T&#xD;
			if(localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;)&#xD;
			{&#xD;
				richiestaTemp.flagNaked = &quot;S&quot;;&#xD;
			}&#xD;
		} &#xD;
		else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA &amp;&amp; comp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.T)&#xD;
		{&#xD;
			consistenzaFoniaTemp = ScriptUtil.copy(comp);&#xD;
		}		&#xD;
		i++;&#xD;
	}	&#xD;
	Process.auditLog(&quot;consistenzaDati recuperata: &quot;+(consistenzaDatiTemp!=null)+ &quot; consistenzaFonia recuperata: &quot;+(consistenzaFoniaTemp != null));&#xD;
	&#xD;
	/*&#xD;
