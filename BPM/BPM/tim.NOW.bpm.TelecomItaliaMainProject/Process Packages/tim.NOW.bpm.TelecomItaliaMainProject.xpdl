        <xpdl2:Activity Id="_IU9vYJU4EeaK6KCRIRatSw" Name="Calcolatimer" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcola timer">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">// gestione DataAvvioAnnullamento null&#xD;
if(DataAvvioAnnullamento!= null){&#xD;
	DataAnnullamento = DataAvvioAnnullamento;&#xD;
}&#xD;
else{&#xD;
	DataAnnullamento = DateTimeUtil.createDate();&#xD;
}&#xD;
&#xD;
var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key=:inputKey&quot;);&#xD;
&#xD;
if(ConfigurazioneTimeout!= null &amp;&amp; ConfigurazioneTimeout != &quot;&quot;){&#xD;
	//possibili valori ConfigurazioneTimeout: OpereSpeciali_timeoutAccettazionePreventivo&#xD;
	criteria.setQueryParameter(&quot;inputKey&quot;,ConfigurazioneTimeout);&#xD;
}&#xD;
else{&#xD;
	criteria.setQueryParameter(&quot;inputKey&quot;,&quot;AnnullamentoPerTimeOut_&quot;+CodiceCausale);&#xD;
	var criteriaTime = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key=:inputKey&quot;);		&#xD;
	criteriaTime.setQueryParameter(&quot;inputKey&quot;,&quot;TimeAnnullamentoPerTimeOut_&quot;+CodiceCausale);&#xD;
	var configurationsTime = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(criteriaTime);&#xD;
	&#xD;
		if (configurationsTime != null &amp;&amp; configurationsTime.size() > 0) {&#xD;
			configurationTime = configurationsTime.get(0).readConfiguration();&#xD;
	&#xD;
			Process.auditLog(&quot;Recuperata ConfigurazioneTime: &quot;+configurationTime.value);&#xD;
	&#xD;
	&#xD;
			TimeValue=configurationTime.value;&#xD;
			//TimeHours = configurationTime.value.slice(0,2);&#xD;
			//TimeMinutes = configurationTime.value.slice(3,6);&#xD;
			Process.auditLog(&quot;Recuperato TimeValue:&quot;+TimeValue);&#xD;
		}&#xD;
}&#xD;
&#xD;
var configurations = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(criteria);&#xD;
&#xD;
&#xD;
if(configurations != null &amp;&amp; configurations.size() > 0)&#xD;
{&#xD;
	configuration = configurations.get(0).readConfiguration();&#xD;
	var confLength = configuration.value.length;&#xD;
		&#xD;
	Process.auditLog(&quot;Recuperata Configurazione: &quot;+configuration.value);&#xD;
	daysType = configuration.value.slice(confLength - 1, confLength);&#xD;
	var slicedDays = configuration.value.slice(0, confLength -1);&#xD;
&#xD;
	if(!isNaN(slicedDays))&#xD;
	{&#xD;
		daysTimeout = parseInt(slicedDays, 10);&#xD;
	}&#xD;
	skip = false;&#xD;
&#xD;
	&#xD;
	&#xD;
}&#xD;
else&#xD;
{&#xD;
	skip = true;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
