||&#xD;
//RU_1554&#xD;
((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.INTERRUZIONESOSPENSIONE&#xD;
    ||localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDACDARECIPIENT)&#xD;
  &amp;&amp; localRequest.flagMigDel82 == &quot;SI&quot;)&#xD;
||&#xD;
localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ESPLETAMENTODONORRECIPIENTDONATING&#xD;
||&#xD;
(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTO&#xD;
	&amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG)&#xD;
