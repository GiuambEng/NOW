        <xpdl2:Activity Id="_Jhhc9hzpEeqbfuVd2xGyJQ" Name="Tracciamento1" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Tracciamento1">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_3MBOcO08EeaHW9ek9Jg1tw" PackageRef="tim.NOW.bpm.CasedataTracking.Interfaces" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="TipoOP">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;INSERT&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="IDTracciamento">
                  <xpdl2:Actual ScriptGrammar="JavaScript">IDTracciamento</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_-0xoZhzSEeqbfuVd2xGyJQ" Width="128.0">
              <xpdl2:Coordinates XCoordinate="1815.0" YCoordinate="700.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.CasedataTracking.xpdl.Tracciamento&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">NessunaNotificaDaInviare = false;&#xD;
&#xD;
if(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR)&#xD;
{&#xD;
	AutoEspletante = true; //Tutte le cessazioni SDR sono AUTOESPLETANTI&#xD;
	localRequest.ordine.DES = localRequest.DRO; //SM_9472 - dovrebbe essere messa nel task espletamento tecnico dell'autoespletamento, ma lo mettiamo già ora perché serve alla notifica NC successiva&#xD;
&#xD;
	var foundAccesso = false;&#xD;
	var k = 0;&#xD;
	&#xD;
	while(!foundAccesso &amp;&amp; k&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(k);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
		{&#xD;
			foundAccesso = true;&#xD;
			&#xD;
			for(var i=0; i&lt;componente.attributiDettaglioOrdine.size(); i++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(i);	&#xD;
			&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SOTTOLAVORAZIONESDR)&#xD;
				{&#xD;
					Process.auditLog(&quot;SOTTOLAVORAZIONE SDR: &quot;+attributo.valoreAttributo);&#xD;
					&#xD;
					if(attributo.valoreAttributo == &quot;05&quot;&#xD;
					|| attributo.valoreAttributo == &quot;06&quot;)&#xD;
					//|| attributo.valoreAttributo == &quot;08&quot;) // PER 08 non deve essere inviata doppia NC - Mail &quot;I: Re:R: Re:R: [EXT] FW: Richiesta  Documentazione SPecifiche  della RU_1051 R1I-19-0212    (Gestione servizio CPS su NCD - Addon Gestione merge File delle notifiche) #CGO#&quot;&#xD;
					{&#xD;
						TrasformazioneCPS = true;&#xD;
					}&#xD;
					else if(attributo.valoreAttributo == &quot;07&quot;)&#xD;
					{&#xD;
						NessunaNotificaDaInviare = true;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		k++;&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_Jhhc9xzpEeqbfuVd2xGyJQ" Name="NotoficationManagementOK" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Notofication Management OK">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_l-ElkAOpEeaIdPdRimpTnw" PackageRef="tim.NOW.bpm.TelecomItaliaNotification" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="Requestref">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="Requestref">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RequestRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaNotifica">
                  <xpdExt:ScriptInformation Id="_Jhhc-BzpEeqbfuVd2xGyJQ" Name="Tipo"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR)&#xD;
{&#xD;
	&quot;NC&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;AQ&quot;;&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="tipologiaOLODestinatario">
                  <xpdExt:ScriptInformation Id="_FlkXMPjDEeqVRM5jvpPcNw" Name="DONATING"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR)&#xD;
{&#xD;
	&quot;DONATING&quot;;&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="idAssetConsistenza">
                  <xpdExt:ScriptInformation Id="_3LEf0PwgEequW72Mlb7hsg" Name="idAssetConsistenza"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var idAsset = &quot;&quot;;&#xD;
idAsset = null;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentComponente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{			&#xD;
				idAsset = currentAttributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
idAsset;</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
