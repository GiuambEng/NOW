        <xpdl2:Activity Id="_ReSHcCAcEeuKnO8QpgAeaA" Name="MergebeforeTimer" xpdExt:DisplayName="Merge before Timer">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="43.0" LaneId="_3ucpER9TEeui1oVJuBY9tg" Width="41.0">
