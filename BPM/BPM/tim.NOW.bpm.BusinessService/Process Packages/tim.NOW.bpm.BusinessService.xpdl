        <xpdl2:Activity Id="_Kq-rMEqfEeab8pZcovplug" Name="Checkparameters" xpdExt:Visibility="Private" xpdExt:DisplayName="Check parameters">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var main = QPI_OutputMain.processInstances.processInstance.get(0);
var sub = QPI_Output.processInstances.processInstance.get(0);
Check= true;
var termina = false;

if(main.customAttributes!=null &amp;&amp; sub.customAttributes!=null){
	for(var i=0; i&lt;ProcessParameters.parameters.size() &amp;&amp; !termina; i++) {
		var ParamTemp = ProcessParameters.parameters.get(i);
		
		var trovato = false;
		for(var j =0; j&lt;main.customAttributes.customAttribute.size() &amp;&amp; !trovato; j++){
			if(ParamTemp.parameterMainProcess.chiave== main.customAttributes.customAttribute.get(j).name){
				trovato=true;
				ParamTemp.parameterMainProcess.valore=main.customAttributes.customAttribute.get(j).value;
			}
		}
		
		var trovato2 = false;
		for(var k =0; k&lt;sub.customAttributes.customAttribute.size() &amp;&amp; !trovato2; k++){
			if(ParamTemp.parameterSubProcess.chiave==sub.customAttributes.customAttribute.get(k).name){
				trovato2=true;
				ParamTemp.parameterSubProcess.valore = sub.customAttributes.customAttribute.get(k).value;
			}
		}
		Note=&quot;&quot;;
		
		if(!trovato){
			termina=true;
			Check=false;
			Note = &quot;Parametro &quot;+ParamTemp.parameterMainProcess+&quot; non trovato nel main process&quot;;
		}
		
		if(!trovato2){
			termina=true;
			Check=false;
			Note += &quot;Parametro &quot;+ParamTemp.parameterSubProcess+&quot; non trovato nel sub process&quot;;
		}
	}
}
else{
	if(ProcessParameters.parameters.size()>0){
		Check=false;
		Note=&quot;Custom parameters non presenti nei processi BPM, Mapping impossibile&quot;;
	}
	else{
		Check=true;
		
	}
}

</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="143,191,251" Height="64.0" LaneId="_qR96UUqPEeafmKsSu0q52g" Width="96.0">
              <xpdl2:Coordinates XCoordinate="2219.0" YCoordinate="296.0"/>
            </xpdl2:NodeGraphicsInfo>
