        <xpdl2:Activity Id="_b7U4xJR5Eeae1JSONJUw-Q" Name="RetrieveOldValue" xpdExt:Visibility="Private" xpdExt:DisplayName="Retrieve Old Value">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var confOld = cac_it_telecomitalia_it_NOW_Configuration.findAll();&#xD;
if(confOld.size()>0){&#xD;
	for(var i=0; i&lt;confOld.size();i++){&#xD;
		var conf = confOld.get(i).readConfiguration();&#xD;
		&#xD;
		for(var j=0; j&lt;Configuration.size();j++){&#xD;
			if(conf.key == Configuration.get(j).key){&#xD;
				ConfigurationRefOld.add(confOld.get(i));	&#xD;
			}&#xD;
		}&#xD;
		&#xD;
	}&#xD;
}&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
