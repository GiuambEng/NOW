        <xpdl2:Activity Id="_FufJwEqkEeab8pZcovplug" Name="ScriptTask8" xpdExt:Visibility="Private" xpdExt:DisplayName="Script Task 8">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">SetProcessVariableInput = com_tibco_bx__2009_management_processManagerType_Factory.createsetAvailableProcessInstanceVariablesInputType();&#xD;
SetProcessVariableInput.processID= ParentProcessInstanceID;&#xD;
SetProcessVariableInput.variableMap = com_tibco_bx__2009_management_processManagerType_Factory.createvariableMapType();&#xD;
&#xD;
&#xD;
for(var i=0; i&lt;ProcessParameters.parameters.size(); i++){&#xD;
var TempParam =ProcessParameters.parameters.get(i);&#xD;
var temp = com_tibco_bx__2009_management_processManagerType_Factory.createNameValuePair();&#xD;
temp.name= TempParam.parameterMainProcess.chiave;&#xD;
temp.value = TempParam.parameterSubProcess.valore;&#xD;
SetProcessVariableInput.variableMap.variable.add(ScriptUtil.copy(temp));&#xD;
	&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
