        <xpdl2:Activity Id="_bGOHopR3Eeae1JSONJUw-Q" Name="SetDefault" xpdExt:Visibility="Private" xpdExt:DisplayName="Set Default">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">// Annullamento Automatico&#xD;
