			}			&#xD;
			if(!foundIDRISORSASEDEOLT &amp;&amp; ConsistenzaSedeOLT != null &amp;&amp; ConsistenzaSedeOLT.IDRisorsa != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSASEDEOLT;&#xD;
