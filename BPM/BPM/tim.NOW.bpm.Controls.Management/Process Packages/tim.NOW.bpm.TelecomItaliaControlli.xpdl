        <xpdl2:Activity Id="_Jt-EYDWDEee1ULNyFeCSXQ" Name="CallEnrichmentSedeServiceTask" FinishMode="Automatic" IsATransaction="false" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Call EnrichmentSede Service Task">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_h5UAUDV-Eee1ULNyFeCSXQ" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="EnrichmentSedeOutput">
                  <xpdl2:Actual ScriptGrammar="JavaScript">EnrichmentSedeOutput</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="Asset">
                  <xpdl2:Actual ScriptGrammar="JavaScript">assetFoniaRef</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:Priority></xpdl2:Priority>
