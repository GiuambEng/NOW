        <xpdl2:Activity Id="_eDsLIAu7Ee-VjeOcbuL9tQ" Name="CostruzionearrayNumerazioniDaVerificare" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Costruzione array NumerazioniDaVerificare">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	//PORTABILITASUCCESSIVADEL82&#xD;
	if(NumberPortability != null &amp;&amp; NumberPortability.size()>0&#xD;
	   &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PORTABILITASUCCESSIVADEL82)&#xD;
	{&#xD;
		for(var i=0; i&lt;NumberPortability.size();i++)&#xD;
		{&#xD;
			NumerazioniDaVerificare.add(NumberPortability.get(i).numeroTelefonico);&#xD;
			Process.auditLog(&quot;Trovata numerazione &quot; + NumberPortability.get(i).numeroTelefonico);&#xD;
		}&#xD;
	}&#xD;
	//PRIMAPORTABILITADEL82&#xD;
	else&#xD;
	{&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)  &#xD;
			{&#xD;
				for	(var k=0; k&lt;localRequest.ordine.dettaglioordine.size();k++)&#xD;
				{&#xD;
					var attr = componente.attributiDettaglioOrdine.get(k);&#xD;
					&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
					{&#xD;
						NumerazioniDaVerificare.add(attr.valoreAttributo);&#xD;
						Process.auditLog(&quot;Trovata numerazione &quot; + attr.valoreAttributo);&#xD;
					}&#xD;
				}		&#xD;
			}		&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="85.0" LaneId="_BQQeIZX6Eeq6TotfzIL_Ew" Width="157.0">
              <xpdl2:Coordinates XCoordinate="1674.0" YCoordinate="171.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
