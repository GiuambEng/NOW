        <xpdl2:Activity Id="_OskF4eDYEeeQMMA_2K-WjA" Name="Scarto" xpdExt:Visibility="Private" xpdExt:DisplayName="Scarto">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Trigger="Link">
              <xpdl2:TriggerResultLink CatchThrow="CATCH" Name="0"/>
            </xpdl2:IntermediateEvent>
