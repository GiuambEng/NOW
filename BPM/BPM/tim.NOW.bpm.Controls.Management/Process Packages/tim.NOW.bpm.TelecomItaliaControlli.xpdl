					foundTIPONUMERO = true;&#xD;
					indexTIPONUMERO = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TOTALEAGGIUNTIVI)&#xD;
				{&#xD;
					foundTOTALEAGGIUNTIVI = true;&#xD;
					indexTOTALEAGGIUNTIVI = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO)&#xD;
				{&#xD;
					foundTIPOSERVIZIO = true;&#xD;
					indexTIPOSERVIZIO = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
