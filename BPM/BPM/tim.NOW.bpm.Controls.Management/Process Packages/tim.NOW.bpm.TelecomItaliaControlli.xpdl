        <xpdl2:Activity Id="_Q94ZYFeWEei-kYa-z1WVIA" Name="PostEnrichmentVCUSERVLANperEASYIP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Post-Enrichment VC/USERVLAN per EASYIP">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if (String(localRequest.offerta).slice(0,6)==&quot;EASYIP&quot;&#xD;
    ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)   //RU_1164: aggiunta SEMI***&#xD;
{	&#xD;
	for (var i=0; i&lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		// ARRICCHIMENTO PCR E MCR PER EASYIP XSDL &#xD;
		if (currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
		&amp;&amp; EnrichmentPCRMCR!= null )&#xD;
		&#xD;
		{&#xD;
			Process.auditLog(&quot;Inizio arricchimento PCR - MCR per ATMVC EASYIP XDSL - Valori da inserire: PCRup &quot;+EnrichmentPCRMCR.PCR_UP+&quot; PCRdown &quot;+EnrichmentPCRMCR.PCR_DOWN&#xD;
			+&quot; MCRup &quot;+ EnrichmentPCRMCR.MCR_UP+ &quot; MCRdown &quot; + EnrichmentPCRMCR.MCR_DOWN );&#xD;
			&#xD;
			var foundPCRup = false;&#xD;
			var foundPCRdown = false;&#xD;
			var foundMCRup = false;&#xD;
			var foundMCRdown = false;&#xD;
			&#xD;
			&#xD;
			var j=0;&#xD;
			&#xD;
			while ((!foundMCRdown || !foundMCRup || !foundPCRup || !foundPCRdown) &amp;&amp; j&lt; currentComponente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRUP)&#xD;
				{&#xD;
					foundPCRup= true;&#xD;
					if(currentAttributo.valoreAttributo != null &amp;&amp; currentAttributo.valoreAttributo !=&quot;&quot; &amp;&amp; currentAttributo.valoreAttributo != EnrichmentPCRMCR.PCR_UP)&#xD;
					{&#xD;
						currentAttributo.valoreAttributoOLD = currentAttributo.valoreAttributo;&#xD;
						currentAttributo.valoreAttributo = EnrichmentPCRMCR.PCR_UP;&#xD;
						if(currentComponente.azione ==null || currentComponente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)&#xD;
						{&#xD;
							currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;	&#xD;
						}&#xD;
					}&#xD;
&#xD;
				}&#xD;
				else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRDOWN)&#xD;
				{&#xD;
					foundPCRdown= true;&#xD;
					if(currentAttributo.valoreAttributo != null &amp;&amp; currentAttributo.valoreAttributo !=&quot;&quot; &amp;&amp; currentAttributo.valoreAttributo != EnrichmentPCRMCR.PCR_DOWN)&#xD;
					{&#xD;
						currentAttributo.valoreAttributoOLD = currentAttributo.valoreAttributo;&#xD;
						currentAttributo.valoreAttributo = EnrichmentPCRMCR.PCR_DOWN;&#xD;
						if(currentComponente.azione ==null || currentComponente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)&#xD;
						{&#xD;
							currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
						}&#xD;
					}&#xD;
&#xD;
				}&#xD;
				else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRUP)&#xD;
				{&#xD;
					foundMCRup= true;&#xD;
					if(currentAttributo.valoreAttributo != null &amp;&amp; currentAttributo.valoreAttributo !=&quot;&quot; &amp;&amp; currentAttributo.valoreAttributo != EnrichmentPCRMCR.MCR_UP)&#xD;
					{&#xD;
						currentAttributo.valoreAttributoOLD = currentAttributo.valoreAttributo;&#xD;
						currentAttributo.valoreAttributo = EnrichmentPCRMCR.MCR_UP;&#xD;
						if(currentComponente.azione ==null || currentComponente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)&#xD;
						{&#xD;
							currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
						}&#xD;
					}&#xD;
&#xD;
				}&#xD;
				else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRDOWN)&#xD;
				{&#xD;
					foundMCRdown= true;&#xD;
					if(currentAttributo.valoreAttributo != null &amp;&amp; currentAttributo.valoreAttributo !=&quot;&quot; &amp;&amp; currentAttributo.valoreAttributo != EnrichmentPCRMCR.MCR_DOWN)&#xD;
					{&#xD;
						currentAttributo.valoreAttributoOLD = currentAttributo.valoreAttributo;&#xD;
						currentAttributo.valoreAttributo = EnrichmentPCRMCR.MCR_DOWN;&#xD;
						if(currentComponente.azione ==null || currentComponente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)&#xD;
						{&#xD;
							currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
				}&#xD;
			&#xD;
			j++;&#xD;
			}&#xD;
				&#xD;
				&#xD;
			// CREO GLI ATTRIBUTI SE NON ESISTONO	&#xD;
			if (!foundMCRdown || !foundMCRup || !foundPCRup || !foundPCRdown)&#xD;
			{&#xD;
				var AttributoBande = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				&#xD;
				AttributoBande.IDDettaglioOrdine = currentComponente.IDDettaglioOrdine;&#xD;
				AttributoBande.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				AttributoBande.created = DateTimeUtil.createDatetime();&#xD;
				AttributoBande.lastUpdate = DateTimeUtil.createDatetime();&#xD;
				AttributoBande.operatore = &quot;BPM&quot;;&#xD;
				AttributoBande.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				if (!foundPCRup)&#xD;
				{&#xD;
					AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRUP;&#xD;
					AttributoBande.valoreAttributo = EnrichmentPCRMCR.PCR_UP;&#xD;
					currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
					Process.auditLog(&quot;Creato attributo PCRUP &quot; + EnrichmentPCRMCR.PCR_UP);&#xD;
					if(currentComponente.azione ==null || currentComponente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)&#xD;
						{&#xD;
							currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
						}&#xD;
				}&#xD;
				if (!foundPCRdown)&#xD;
				{&#xD;
					AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRDOWN;&#xD;
					AttributoBande.valoreAttributo = EnrichmentPCRMCR.PCR_DOWN;&#xD;
					currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
					Process.auditLog(&quot;Creato attributo PCRDOWN &quot; + EnrichmentPCRMCR.PCR_DOWN);&#xD;
					if(currentComponente.azione ==null || currentComponente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)&#xD;
						{&#xD;
							currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
						}&#xD;
				}&#xD;
				if (!foundMCRup)&#xD;
				{&#xD;
					AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRUP;&#xD;
					AttributoBande.valoreAttributo = EnrichmentPCRMCR.MCR_UP;&#xD;
					currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
					Process.auditLog(&quot;Creato attributo MCRUP &quot; + EnrichmentPCRMCR.MCR_UP);&#xD;
					if(currentComponente.azione ==null || currentComponente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)&#xD;
						{&#xD;
							currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
						}&#xD;
				}&#xD;
				if (!foundMCRdown)&#xD;
				{&#xD;
					AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRDOWN;&#xD;
					AttributoBande.valoreAttributo = EnrichmentPCRMCR.MCR_DOWN;&#xD;
					currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
					Process.auditLog(&quot;Creato attributo MCRDOWN &quot; + EnrichmentPCRMCR.MCR_DOWN);&#xD;
					if(currentComponente.azione ==null || currentComponente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)&#xD;
						{&#xD;
							currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
						}&#xD;
				}&#xD;
			}&#xD;
&#xD;
			&#xD;
		}&#xD;
			&#xD;
		// ARRICCHIMENTO BANDEPICCO PER EASYIP NGA&#xD;
		else if (currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp; EnrichmentBandeOut!= null)&#xD;
		{&#xD;
			Process.auditLog(&quot;Inizio arricchimento BANDEPICCO per USERVLAN EASYIP NGA - Valori da inserire: BANDAPICCOUP &quot;+EnrichmentBandeOut.bandaPiccoUp+&quot; BANDAPICCODOWN &quot;+EnrichmentBandeOut.bandaPiccoDown);&#xD;
			&#xD;
			var foundBANDAPICCOup = false;&#xD;
			var foundBANDAPICCOdown = false;&#xD;
			var j=0;&#xD;
			&#xD;
			while ((!foundBANDAPICCOup || !foundBANDAPICCOdown) &amp;&amp;  j&lt; currentComponente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
				{&#xD;
					foundBANDAPICCOup=true;&#xD;
					if(currentAttributo.valoreAttributo != null &amp;&amp; currentAttributo.valoreAttributo !=&quot;&quot; &amp;&amp; currentAttributo.valoreAttributo != EnrichmentBandeOut.bandaPiccoUp)&#xD;
					{&#xD;
						currentAttributo.valoreAttributoOLD = currentAttributo.valoreAttributo;&#xD;
						currentAttributo.valoreAttributo = EnrichmentBandeOut.bandaPiccoUp;&#xD;
						if(currentComponente.azione ==null || currentComponente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)&#xD;
						{&#xD;
							currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
				}&#xD;
				&#xD;
				else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
				{&#xD;
					foundBANDAPICCOdown=true;&#xD;
					if(currentAttributo.valoreAttributo != null &amp;&amp; currentAttributo.valoreAttributo !=&quot;&quot; &amp;&amp; currentAttributo.valoreAttributo != EnrichmentBandeOut.bandaPiccoDown)&#xD;
					{&#xD;
						currentAttributo.valoreAttributoOLD = currentAttributo.valoreAttributo;&#xD;
						currentAttributo.valoreAttributo = EnrichmentBandeOut.bandaPiccoDown;&#xD;
						if(currentComponente.azione ==null || currentComponente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)&#xD;
						{&#xD;
							currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
				}&#xD;
				&#xD;
				&#xD;
			j++;&#xD;
			}&#xD;
			&#xD;
			// CREO GLI ATTRIBUTI SE NON ESISTONO&#xD;
			if (!foundBANDAPICCOup || !foundBANDAPICCOdown)&#xD;
			{&#xD;
				var AttributoBande = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				&#xD;
				AttributoBande.IDDettaglioOrdine = currentComponente.IDDettaglioOrdine;&#xD;
				AttributoBande.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				AttributoBande.created = DateTimeUtil.createDatetime();&#xD;
				AttributoBande.lastUpdate = DateTimeUtil.createDatetime();&#xD;
				AttributoBande.operatore = &quot;BPM&quot;;&#xD;
				AttributoBande.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				if (!foundBANDAPICCOup)&#xD;
				{&#xD;
					AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP;&#xD;
					AttributoBande.valoreAttributo = EnrichmentBandeOut.bandaPiccoUp;&#xD;
					currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
					Process.auditLog(&quot;Creato attributo BANDAPICCOUP &quot; + EnrichmentBandeOut.bandaPiccoUp);&#xD;
					if(currentComponente.azione ==null || currentComponente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)&#xD;
						{&#xD;
							currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
						}&#xD;
					&#xD;
				}&#xD;
				if (!foundBANDAPICCOdown)&#xD;
				{&#xD;
					AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN;&#xD;
					AttributoBande.valoreAttributo = EnrichmentBandeOut.bandaPiccoDown;&#xD;
					currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
					Process.auditLog(&quot;Creato attributo BANDAPICCODOWN &quot; + EnrichmentBandeOut.bandaPiccoDown);&#xD;
					if(currentComponente.azione ==null || currentComponente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N)&#xD;
						{&#xD;
							currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
						}&#xD;
				}&#xD;
&#xD;
			}&#xD;
		&#xD;
		}&#xD;
	&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
