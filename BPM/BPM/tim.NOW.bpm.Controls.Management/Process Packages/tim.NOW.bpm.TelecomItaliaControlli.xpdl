              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:Priority></xpdl2:Priority>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="95.0" LaneId="_6pqwISv5EeyVBMucdpSJQg" Width="141.0">
              <xpdl2:Coordinates XCoordinate="250.0" YCoordinate="482.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier = &quot;/tim.NOW.bpm.Controls/Process Packages/tim.NOW.bpm.Controls.xpdl.RecuperaAnagraficaCausale&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_SJIrQiv6EeyVBMucdpSJQg" Name="Scarto" xpdExt:Visibility="Private" xpdExt:DisplayName="Scarto">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Trigger="Link">
              <xpdl2:TriggerResultLink CatchThrow="CATCH" Name="0"/>
            </xpdl2:IntermediateEvent>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="57.0" LaneId="_6pqwISv5EeyVBMucdpSJQg" Width="52.0">
              <xpdl2:Coordinates XCoordinate="71.0" YCoordinate="482.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_T-rQkSv6EeyVBMucdpSJQg" Name="ArricchimentoDettaglioOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Script inserito con RU_1215&#xD;
var data = DateTimeUtil.createDatetime();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; ConsistenzaDati != null)&#xD;
{	&#xD;
	//AGGIORNAMENTO/CREAZIONE COMPONENTE ACCESSO&#xD;
	var foundACCESSO = false;&#xD;
	var i=0;&#xD;
	&#xD;
	var foundTIPOLOGIACPE = false;&#xD;
	var foundFLAGINTERVENTO = false;&#xD;
	var foundIMSI = false;&#xD;
	var foundIMEI = false;&#xD;
	var foundMSISDN = false;&#xD;
	var foundPROFILO = false;	&#xD;
	var foundSTATORESTITUZIONEPRODOTTI = false;&#xD;
	var foundDATARESTITUZIONEPRODOTTI = false;&#xD;
	&#xD;
	//SE TROVIAMO LA COMPONENTE ACCESSO&#xD;
	while(!foundACCESSO &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			foundACCESSO = true;&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;  &#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				//TIPOLOGIACPE&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACPE&#xD;
				   &amp;&amp; ConsistenzaDati.tipologiaCpe != null)&#xD;
				{&#xD;
					foundTIPOLOGIACPE = true;&#xD;
					attributo.valoreAttributo = ConsistenzaDati.tipologiaCpe;&#xD;
					Process.auditLog(&quot;Aggiornato attributo TIPOLOGIACPE&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//FLAGINTERVENTO&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGINTERVENTO&#xD;
				        &amp;&amp; ConsistenzaDati.flagIntervento != null)&#xD;
				{&#xD;
					foundFLAGINTERVENTO = true;&#xD;
					attributo.valoreAttributo = ConsistenzaDati.flagIntervento;&#xD;
					Process.auditLog(&quot;Aggiornato attributo FLAGINTERVENTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//IMSI&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IMSI&#xD;
				        &amp;&amp; ConsistenzaDati.imsi != null)&#xD;
				{&#xD;
					foundIMSI = true;&#xD;
					attributo.valoreAttributo = ConsistenzaDati.imsi;&#xD;
					Process.auditLog(&quot;Aggiornato attributo IMSI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//IMEI&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IMEI&#xD;
				        &amp;&amp; ConsistenzaDati.imei != null)&#xD;
				{&#xD;
					foundIMEI = true;&#xD;
					attributo.valoreAttributo = ConsistenzaDati.imei;&#xD;
					Process.auditLog(&quot;Aggiornato attributo IMEI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//MSISDN&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MSISDN&#xD;
				        &amp;&amp; ConsistenzaDati.msisdn != null)&#xD;
				{&#xD;
					foundMSISDN = true;&#xD;
					attributo.valoreAttributo = ConsistenzaDati.msisdn;&#xD;
					Process.auditLog(&quot;Aggiornato attributo MSISDN&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//PROFILO&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILO&#xD;
				        &amp;&amp; ConsistenzaDati.profilo != null)&#xD;
				{&#xD;
					foundPROFILO= true;&#xD;
					attributo.valoreAttributo = ConsistenzaDati.profilo;&#xD;
					Process.auditLog(&quot;Aggiornato attributo PROFILO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//STATORESTITUZIONEPRODOTTI&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATORESTITUZIONEPRODOTTI&#xD;
				        &amp;&amp; LavorazioneRichiesta.statoRestituzioneProdotti != null)&#xD;
				{&#xD;
					foundSTATORESTITUZIONEPRODOTTI = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.statoRestituzioneProdotti;&#xD;
					Process.auditLog(&quot;Aggiornato attributo STATORESTITUZIONEPRODOTTI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//DATARESTITUZIONEPRODOTTI&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATARESTITUZIONEPRODOTTI&#xD;
				        &amp;&amp; LavorazioneRichiesta.statoRestituzioneProdotti != null)&#xD;
				{&#xD;
					foundDATARESTITUZIONEPRODOTTI = true;&#xD;
					attributo.valoreAttributo = &quot;01-01-1900&quot;;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.DATE;&#xD;
					Process.auditLog(&quot;Aggiornato attributo DATARESTITUZIONEPRODOTTI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}			&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	//SE NON TROVIAMO LA COMPONENTE ACCESSO&#xD;
	if(!foundACCESSO)&#xD;
	{&#xD;
		var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
		componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componente.IDRisorsa= ConsistenzaDati.IDRisorsa;&#xD;
		componente.IDRisorsaNOW = ConsistenzaDati.IDRisorsaNOW;&#xD;
		componente.created = data;&#xD;
		componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
		componente.lastUpdate = data;&#xD;
		componente.operatore = &quot;BPM&quot;;&#xD;
		componente.progressivo = 1;&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOFWA;	&#xD;
	}&#xD;
&#xD;
	//SE NON TROVIAMO GLI ATTRIBUTI&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
	attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
	attributo.created = data;&#xD;
	attributo.lastUpdate = data;&#xD;
	attributo.operatore = &quot;BPM&quot;;&#xD;
	&#xD;
	//TIPOLOGIACPE&#xD;
	if(!foundTIPOLOGIACPE &amp;&amp; ConsistenzaDati.tipologiaCpe != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACPE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.tipologiaCpe;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//FLAGINTERVENTO&#xD;
	if(!foundFLAGINTERVENTO &amp;&amp; ConsistenzaDati.flagIntervento != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGINTERVENTO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.flagIntervento;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//IMSI&#xD;
	if(!foundIMSI &amp;&amp; ConsistenzaDati.imsi != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IMSI;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.imsi;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//IMEI&#xD;
	if(!foundIMEI &amp;&amp; ConsistenzaDati.imei != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IMEI;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.imei;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//MSISDN&#xD;
	if(!foundMSISDN &amp;&amp; ConsistenzaDati.msisdn != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MSISDN;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.msisdn;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//PROFILO&#xD;
	if(!foundPROFILO &amp;&amp; ConsistenzaDati.profilo != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.profilo;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//STATORESTITUZIONEPRODOTTI&#xD;
	if(!foundSTATORESTITUZIONEPRODOTTI &amp;&amp; LavorazioneRichiesta.statoRestituzioneProdotti != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATORESTITUZIONEPRODOTTI;&#xD;
		attrTemp.valoreAttributo = LavorazioneRichiesta.statoRestituzioneProdotti;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//DATARESTITUZIONEPRODOTTI&#xD;
	if(!foundDATARESTITUZIONEPRODOTTI &amp;&amp; LavorazioneRichiesta.statoRestituzioneProdotti != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATARESTITUZIONEPRODOTTI;&#xD;
		attrTemp.valoreAttributo = &quot;01-01-1900&quot;;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.DATE;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	&#xD;
	//Se non ha trovato la componente ACCESSO, allora va aggiunta quella che abbiamo creato&#xD;
	if(!foundACCESSO)&#xD;
	{&#xD;
		localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
	}&#xD;
}&#xD;
&#xD;
//Aggiunto con SM_10916: Recupero DISTRETTO/IDCONTRATTO/CLIENTE/NUMEROFITTIZIO/IDOPERATORERETE DA ASSET -> C01M02F12&#xD;
if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaDati.IDAsset));&#xD;
	Asset = AssetRef.readAsset();&#xD;
}&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	if(Asset != null)&#xD;
	{	&#xD;
		if (Asset.distretto != null &amp;&amp; Asset.distretto.length > 0)&#xD;
		{&#xD;
			localRequest.ordine.distretto = Asset.distretto;&#xD;
		}&#xD;
		if (Asset.IDContratto != null)&#xD;
		{&#xD;
			localRequest.IDContratto = Asset.IDContratto;&#xD;
		}&#xD;
		if (Asset.numeroFittizio != null &amp;&amp; Asset.numeroFittizio.length > 0)&#xD;
		{&#xD;
			localRequest.ordine.numeroFittizio = Asset.numeroFittizio;&#xD;
		}		&#xD;
		&#xD;
		if(Asset.cliente != null 									&#xD;
			&amp;&amp; localRequest.ordine.nome == null &#xD;
			&amp;&amp; localRequest.ordine.cognomeRagioneSociale == null &#xD;
			&amp;&amp; localRequest.ordine.CF == null&#xD;
			&amp;&amp; localRequest.ordine.PIVA == null) &#xD;
		{&#xD;
			if (Asset.cliente.nome != null &amp;&amp; (localRequest.ordine.nome == null || localRequest.ordine.nome == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.nome = Asset.cliente.nome;&#xD;
			}		&#xD;
			if (Asset.cliente.cognomeRagioneSociale != null &amp;&amp; (localRequest.ordine.cognomeRagioneSociale == null || localRequest.ordine.cognomeRagioneSociale == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.cognomeRagioneSociale = Asset.cliente.cognomeRagioneSociale;&#xD;
			}&#xD;
			&#xD;
			//CF e PIVA sono mutuamente esclusivi e non vanno arricchiti se uno dei due è indicato in input dall'OLO&#xD;
			if(localRequest.ordine.CF == null &amp;&amp; localRequest.ordine.PIVA == null)&#xD;
			{				&#xD;
				localRequest.ordine.CF = Asset.cliente.codiceFiscale;&#xD;
				localRequest.ordine.PIVA = Asset.cliente.partitaIVA;			&#xD;
			}&#xD;
		}&#xD;
		if(Asset.numeroTelefonico != null)&#xD;
		{&#xD;
			localRequest.ordine.numeroTelefonico = Asset.numeroTelefonico;&#xD;
		}&#xD;
		if(Asset.operatoreRete != null)&#xD;
		{&#xD;
			localRequest.operatoreRete = Asset.operatoreRete;&#xD;
			localRequest.ordine.operatoreRete = Asset.operatoreRete;&#xD;
			&#xD;
			if(localRequest.operatoreRete == 'FF' &amp;&amp; localRequest.idProgressivoNotificheFF == null)&#xD;
			{&#xD;
				localRequest.idProgressivoNotificheFF = 1;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="87.0" LaneId="_6pqwISv5EeyVBMucdpSJQg" Width="158.0">
              <xpdl2:Coordinates XCoordinate="1489.0" YCoordinate="164.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
