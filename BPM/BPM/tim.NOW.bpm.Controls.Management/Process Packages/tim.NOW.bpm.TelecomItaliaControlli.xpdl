        <xpdl2:Activity Id="_nm-3AMoZEfCIveTxDSdc_w" Name="ArricchimentoOrdineRientriDel82" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Ordine Rientri Del82">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Script inserito con la RU RIENTRI FIBERSTREAM DEL82 - C01 2026&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{ &#xD;
	//CONFIGURAZIONE AZIONE&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOFIBERSTREAM&#xD;
		    ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
		    ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOAGGIUNTIVO&#xD;
		    ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPARATO)   &#xD;
		{ &#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;   &#xD;
		}  &#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	var foundAmbito = false;&#xD;
	&#xD;
	//Arricchimento AMBITO - SM_11878&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOAGGIUNTIVO)&#xD;
		{&#xD;
			var ambito = &quot;&quot;;&#xD;
			ambito = null;&#xD;
			&#xD;
			foundAmbito = false; &#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributoJ = componente.attributiDettaglioOrdine.get(j);&#xD;
&#xD;
				if(attributoJ.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMESERVIZIO)&#xD;
				{&#xD;
					for(var k=0; k&lt;VerificaServizioAggiuntivoResponse.servizio.size(); k++)&#xD;
					{&#xD;
						var servizioNow = VerificaServizioAggiuntivoResponse.servizio.get(k);&#xD;
						&#xD;
						if(attributoJ.valoreAttributo == servizioNow.nomeServizio)&#xD;
						{&#xD;
							ambito = servizioNow.ambito;&#xD;
							Process.auditLog(&quot;recuperato struttura servizio valorizzato con Ambito:&quot;+ servizioNow.ambito +&quot; NomeServizio &quot; + servizioNow.nomeServizio);&#xD;
						}&#xD;
					} &#xD;
				}&#xD;
			}&#xD;
			&#xD;
			for(var k=0; k&lt;componente.attributiDettaglioOrdine.size(); k++)&#xD;
			{&#xD;
				var attributoK = componente.attributiDettaglioOrdine.get(k);&#xD;
	&#xD;
				if(attributoK.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AMBITO&#xD;
				   &amp;&amp; ambito != null)&#xD;
				{&#xD;
					foundAmbito = true;&#xD;
					attributoK.valoreAttributo = ambito;&#xD;
					Process.auditLog(&quot;Aggiornato attributo AMBITO con valore: &quot;+ ambito);&#xD;
				}&#xD;
			}&#xD;
				&#xD;
			if (!foundAmbito &amp;&amp; ambito != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributoJ = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributoJ.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributoJ.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributoJ.created = ora;&#xD;
				attributoJ.lastUpdate = ora;&#xD;
				attributoJ.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AMBITO;&#xD;
				attributoJ.operatore = componente.operatore;&#xD;
				attributoJ.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoJ.valoreAttributo = ambito;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoJ));&#xD;
				foundAmbito = true;&#xD;
				Process.auditLog('Creato attributo AMBITO con valore: '+ ambito);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	//Arricchimento APPARATO - RU RIENTRI FIBERSTREAM DEL82&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i); &#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPARATO)&#xD;
		{&#xD;
			for(var j=0; j&lt;Response_C04M01F509.apparato.size(); j++)&#xD;
			{ &#xD;
				var apparato = Response_C04M01F509.apparato.get(j);&#xD;
				&#xD;
				if(apparato.idDettaglioOrdine == componente.IDDettaglioOrdine)&#xD;
				{ &#xD;
					for(var k=0; k&lt;componente.attributiDettaglioOrdine.size(); k++)&#xD;
					{&#xD;
						var foundNmuFittizio = false;&#xD;
						var attributoK = componente.attributiDettaglioOrdine.get(k);&#xD;
						&#xD;
						if(attributoK.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NMUFITTIZIO)&#xD;
						{ &#xD;
							attributoK.valoreAttributo = apparato.nmuFittizio;&#xD;
							foundNmuFittizio = true;&#xD;
						}&#xD;
					}&#xD;
&#xD;
					if (!foundNmuFittizio &amp;&amp; apparato.nmuFittizio != null)&#xD;
					{&#xD;
						var ora = DateTimeUtil.createDatetime();&#xD;
						var attributoNew = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						attributoNew.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
						attributoNew.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
						attributoNew.created = ora;&#xD;
						attributoNew.lastUpdate = ora;&#xD;
						attributoNew.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NMUFITTIZIO;&#xD;
						attributoNew.operatore = componente.operatore;&#xD;
						attributoNew.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						attributoNew.valoreAttributo = apparato.nmuFittizio;&#xD;
&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoNew));&#xD;
						foundNmuFittizio = true;&#xD;
						Process.auditLog('Creato attributo NMUFITTIZIO con valore: '+ apparato.nmuFittizio);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//Arricchimento ORDINE - SM_11878&#xD;
	if(LavorazioneRichiesta !=null &amp;&amp; LavorazioneRichiesta.flagIU != null)&#xD;
	{&#xD;
		localRequest.ordine.flagIU = LavorazioneRichiesta.flagIU;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_asJlEcb0EfCciLHaqSMNiA" Width="96.0">
              <xpdl2:Coordinates XCoordinate="3062.0" YCoordinate="352.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
