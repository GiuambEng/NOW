		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETI;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.codiceOrdineTI;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.codiceOrdineOLO!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.codiceOrdineOLO;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.tipoLinea!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.tipoLinea;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.strutturaLinea!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.strutturaLinea;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.numeroTelefonico!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.numeroTelefonico;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.numeroTelefonicoPrincipale!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.numeroTelefonicoPrincipale;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.destinazioneUso!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.destinazioneUso;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.codiceTrasformazione!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETRASFORMAZIONE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.codiceTrasformazione;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	&#xD;
	localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
&#xD;
&#xD;
	//NUMBERPORTABILITY&#xD;
	if(ConsistenzaFonia.numeroTelefonico!= null &amp;&amp; ConsistenzaFonia.numeroTelefonico != &quot;&quot;){&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico = :DN&quot;);&#xD;
		c.setQueryParameter(&quot;DN&quot;,ConsistenzaFonia.numeroTelefonico);&#xD;
		var AssetNPref = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		AssetNP = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
		AssetNP=null;&#xD;
		var i=0;&#xD;
		while(i&lt;AssetNPref.size()){&#xD;
				var assetTemp = AssetNPref.get(i).readAsset();&#xD;
			if(assetTemp.statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO &amp;&amp; assetTemp.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP){&#xD;
				AssetNP = ScriptUtil.copy(assetTemp);&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		if(AssetNP != null){&#xD;
			Process.auditLog(&quot;Asset NP recuperato: &quot;+AssetNP.IDAsset);&#xD;
			var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
			componente.IDDettaglioOrdineParent = 1;&#xD;
			componente.IDDettaglioOrdineRoot =1;&#xD;
			componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		&#xD;
			componente.created = data;&#xD;
			componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
			componente.lastUpdate = data;&#xD;
			componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY;&#xD;
			componente.operatore = &quot;BPM&quot;;&#xD;
			componente.progressivo = 1;&#xD;
			&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(azioneComponenteNP);&#xD;
			&#xD;
			&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = data;&#xD;
			attributo.lastUpdate = data;&#xD;
			attributo.operatore = &quot;BPM&quot;;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		&#xD;
		&#xD;
			var NUMBERPORTABILITYTrovata = false;&#xD;
			var i=0;&#xD;
			while(!NUMBERPORTABILITYTrovata &amp;&amp; i&lt;AssetNP.dettaglioasset.size()){&#xD;
				var compAsset = AssetNP.dettaglioasset.get(i);	&#xD;
				if(compAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
					NUMBERPORTABILITYTrovata = true;&#xD;
					var trovatoCODICEPIATTAFORMA = false;&#xD;
					var j=0;&#xD;
					while(j&lt;compAsset.attributidettaglioasset.size()){&#xD;
						var attr = compAsset.attributidettaglioasset.get(j);&#xD;
						var attributoTemp = ScriptUtil.copy(attributo);&#xD;
						attributoTemp.nomeAttributo = attr.nomeAttributo;&#xD;
						attributoTemp.tipologiaDato = attr.tipologiaDato;&#xD;
						if(attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA){&#xD;
							trovatoCODICEPIATTAFORMA = true;&#xD;
							if(CodicePiattaforma!=null &amp;&amp; CodicePiattaforma!= &quot;&quot;){&#xD;
								attributoTemp.valoreAttributo =  CodicePiattaforma;&#xD;
								componente.attributiDettaglioOrdine.add(attributoTemp);&#xD;
							}&#xD;
						}&#xD;
						else if(attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RIENTROTI&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PORTABILITASUCCESSIVA&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICERO&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER&#xD;
							 || attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA&#xD;
							 ){&#xD;
							attributoTemp.valoreAttributo =  attr.valoreAttributo;&#xD;
							componente.attributiDettaglioOrdine.add(attributoTemp);&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
					if(!trovatoCODICEPIATTAFORMA &amp;&amp; (CodicePiattaforma!=null &amp;&amp; CodicePiattaforma!= &quot;&quot;)){&#xD;
						var attributoTemp = ScriptUtil.copy(attributo);&#xD;
						attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA;&#xD;
						attributoTemp.valoreAttributo =  CodicePiattaforma;&#xD;
						componente.attributiDettaglioOrdine.add(attributoTemp);&#xD;
					}&#xD;
						&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
			//aggiungoIDAsset&#xD;
			&#xD;
			attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
			attributo.valoreAttributo =  AssetNP.IDAsset;&#xD;
			componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
			&#xD;
		&#xD;
		&#xD;
		}&#xD;
		else{	&#xD;
			Process.auditLog(&quot;Nessun asset con offerta NP recuperato per NumeroTelefonico: &quot;+ConsistenzaFonia.numeroTelefonico);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	&#xD;
	&#xD;
	&#xD;
	//C01M02F12 Recupero DISTRETTO/IDCONTRATTO/CLIENTE/CLLI DA ASSET&#xD;
	if (assetFonia.distretto != null &amp;&amp; assetFonia.distretto.length > 0){&#xD;
		localRequest.ordine.distretto = assetFonia.distretto;&#xD;
	}&#xD;
	if (assetFonia.CLLI != null &amp;&amp; assetFonia.CLLI.length > 0){&#xD;
		localRequest.ordine.CLLI = assetFonia.CLLI;&#xD;
	}&#xD;
	if (assetFonia.IDContratto != null){&#xD;
		localRequest.IDContratto = assetFonia.IDContratto;&#xD;
	}&#xD;
	if (assetFonia.cliente != null){&#xD;
		localRequest.ordine.nome = assetFonia.cliente.nome;&#xD;
		localRequest.ordine.cognomeRagioneSociale = assetFonia.cliente.cognomeRagioneSociale;&#xD;
		// gestione particolare per C01M02F05 – Crea-Aggiorna Case Ordine relativa a CF e PIVA in caso di PRESTAZIONE WLR 20&#xD;
		if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR20){&#xD;
			if((localRequest.ordine.PIVA == null || localRequest.ordine.PIVA == &quot;&quot;)&#xD;
			&amp;&amp; (localRequest.ordine.CF == null || localRequest.ordine.CF == &quot;&quot;)){&#xD;
				localRequest.ordine.PIVA = assetFonia.cliente.partitaIVA;&#xD;
				localRequest.ordine.CF = assetFonia.cliente.codiceFiscale;&#xD;
			}&#xD;
		}	&#xD;
		else {&#xD;
			if(localRequest.ordine.PIVA == null || localRequest.ordine.PIVA == &quot;&quot;){&#xD;
				localRequest.ordine.PIVA = assetFonia.cliente.partitaIVA;&#xD;
			}&#xD;
			if(localRequest.ordine.CF ==null || localRequest.ordine.CF==&quot;&quot;){&#xD;
				localRequest.ordine.CF = assetFonia.cliente.codiceFiscale;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	// VALORIZZAZIONE OPERATORE RETE - Modifica per FF&#xD;
	if(assetFonia.operatoreRete != null)&#xD;
	{&#xD;
		localRequest.operatoreRete = assetFonia.operatoreRete;&#xD;
		localRequest.ordine.operatoreRete = assetFonia.operatoreRete;&#xD;
	}		&#xD;
}&#xD;
else{&#xD;
	Process.auditLog(&quot;ConsistenzaFonia null&quot;);&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
