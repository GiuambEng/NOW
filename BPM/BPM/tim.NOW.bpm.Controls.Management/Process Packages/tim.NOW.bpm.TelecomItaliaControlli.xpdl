        <xpdl2:Activity Id="_iApCQHLeEeiHvo80-cwAeA" Name="AggiornamentoReferenti" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Aggiornamento Referenti">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">	if (localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
	{&#xD;
		// Inizio SM_8759&#xD;
		var foundReferenti = false;&#xD;
		if (localRequest.ordine.referente != null &amp;&amp; localRequest.ordine.referente.size() > 0) &#xD;
		{&#xD;
			foundReferenti = true;&#xD;
		}&#xD;
&#xD;
		if (!foundReferenti) // fine SM_8759&#xD;
		{	&#xD;
&#xD;
		var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
&#xD;
		if (Asset != null)&#xD;
		{&#xD;
			// Recupero Referenti dall' Ordine di attivazione&#xD;
			if( Asset.IDPrimoOrdine!= null &amp;&amp; Asset.IDPrimoOrdine.slice(0,3)== &quot;pvm&quot;)&#xD;
			{&#xD;
				Process.auditLog(&quot;Recuperato IDPrimoOrdine = &quot; + Asset.IDPrimoOrdine);&#xD;
				var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria( &quot;IDRichiestaOLO =: pvm&quot;);&#xD;
				criteria.setQueryParameter(&quot;pvm&quot;,Asset.IDPrimoOrdine);&#xD;
&#xD;
				var result = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
				if (result != null &amp;&amp; result.size() > 0)&#xD;
				{&#xD;
					RequestRef = result.get(0);&#xD;
					var RequestOld= ScriptUtil.copy(RequestRef.readRichiesta());&#xD;
&#xD;
				}&#xD;
&#xD;
				if (RequestOld!= null &amp;&amp; RequestOld.ordine!=null &amp;&amp; RequestOld.ordine.referente!=null)&#xD;
				{&#xD;
&#xD;
					for (var i=0; i&lt; RequestOld.ordine.referente.size(); i++)&#xD;
					{&#xD;
						var currentReferenteOld =RequestOld.ordine.referente.get(i);&#xD;
&#xD;
						var Referente = it_telecomitalia_it_NOW_casedata_Factory.createReferente();&#xD;
&#xD;
						Referente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						Referente.operatore = 'BPM';&#xD;
						Referente.created= date;&#xD;
						Referente.lastUpdate= date;&#xD;
						Referente.cognomeReferente= currentReferenteOld.cognomeReferente;&#xD;
						Referente.emailReferente = currentReferenteOld.emailReferente;&#xD;
						Referente.nomeReferente = currentReferenteOld.nomeReferente;&#xD;
						Referente.progressivoReferente = currentReferenteOld.progressivoReferente;&#xD;
						Referente.qualificaReferente = currentReferenteOld.qualificaReferente;&#xD;
						Referente.telefonoFissoReferente = currentReferenteOld.telefonoFissoReferente;&#xD;
						Referente.telefonoMobileReferente = currentReferenteOld.telefonoMobileReferente;&#xD;
						Referente.tipoReferenteOrdine = currentReferenteOld.tipoReferenteOrdine;&#xD;
&#xD;
						localRequest.ordine.referente.add(Referente);&#xD;
&#xD;
&#xD;
					}&#xD;
&#xD;
				}&#xD;
&#xD;
			}&#xD;
&#xD;
			else &#xD;
			{&#xD;
				// Recupero Referenti dal servizio di arricchimento&#xD;
				if ( EnrichmentReferenti!= null &amp;&amp; EnrichmentReferenti.referenti.size()>0 )&#xD;
				{&#xD;
					for (var i=0; i&lt; EnrichmentReferenti.referenti.size(); i++)&#xD;
					{&#xD;
&#xD;
&#xD;
						var Referente = it_telecomitalia_it_NOW_casedata_Factory.createReferente();&#xD;
&#xD;
						Referente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						Referente.operatore = 'BPM';&#xD;
						Referente.created= date;&#xD;
						Referente.lastUpdate= date;&#xD;
						Referente.cognomeReferente= EnrichmentReferenti.referenti.get(i).cognomeReferente;&#xD;
						Referente.emailReferente = EnrichmentReferenti.referenti.get(i).emailReferente;&#xD;
						Referente.nomeReferente = EnrichmentReferenti.referenti.get(i).nomeReferente;&#xD;
						Referente.progressivoReferente = EnrichmentReferenti.referenti.get(i).progressivoReferente;&#xD;
						Referente.qualificaReferente = it_telecomitalia_it_NOW_casedata_QualificaReferenteEnumeration.get(String(EnrichmentReferenti.referenti.get(i).qualificaReferente));&#xD;
						Referente.telefonoFissoReferente = EnrichmentReferenti.referenti.get(i).telefonoFissoReferente;&#xD;
						Referente.telefonoMobileReferente = EnrichmentReferenti.referenti.get(i).telefonoMobileReferente;&#xD;
						Referente.tipoReferenteOrdine = it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.get(String(EnrichmentReferenti.referenti.get(i).tipoReferenteOrdine));&#xD;
&#xD;
						localRequest.ordine.referente.add(Referente);&#xD;
&#xD;
					}&#xD;
&#xD;
				}&#xD;
&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
&#xD;
}&#xD;
			</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
