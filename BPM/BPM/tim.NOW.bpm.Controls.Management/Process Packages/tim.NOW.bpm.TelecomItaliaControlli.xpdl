        <xpdl2:Activity Id="_NC7qkk0oEeeB6fnWJqm8Lg" Name="ArricchimentoDettaglioOrdine" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest!= null &amp;&amp; localRequest.ordine!=null){&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		&#xD;
		//BitstreamATMAsimmetricoFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMASIMFLAT || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;	&#xD;
			}&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA) {&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//BitstreamATMAsimmetricoHL&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMASIMHL || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;	&#xD;
				}&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA) {&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;		&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//BitstreamATMAsimmetricoLite&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMASIMLITE || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
				}&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA) {&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//BitstreamGBEAsimmetricoFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOGBEASIMFLAT || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
				}&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA) {&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//EasyIPBasePlusLite&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPBASEPLUSLITE || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
				}&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA) {&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;		&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//EasyIPBasePlusFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPBASEPLUSFLAT || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
					}&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA) {&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;		&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//EasyIPSpecialProfileLite&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPSPECIALPROFILELITE || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;	&#xD;
				}&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA) {&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;		&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//EasyIPSpecialProfileFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPSPECIALPROFILEFLAT || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;		&#xD;
				}&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA) {&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;	&#xD;
			}&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
		&#xD;
		&#xD;
	}&#xD;
	&#xD;
	//RU_1317: ARRICCHIMENTO GENERICO COMPONENTE ACCESSO -> attributo PROPRIETAMATERIALE&#xD;
	if(LavorazioneRichiesta != null)&#xD;
	{&#xD;
		var foundProprietaMateriale = false;&#xD;
&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{		&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE&#xD;
					   &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
					{&#xD;
						foundProprietaMateriale = true;&#xD;
						attr.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
						Process.auditLog(&quot;Aggiornato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
					}&#xD;
				}&#xD;
							&#xD;
				if(!foundProprietaMateriale &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
				{&#xD;
					var ora = DateTimeUtil.createDatetime();&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
					attributo.created = ora;&#xD;
					attributo.lastUpdate = ora;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE;&#xD;
					attributo.operatore = componente.operatore;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
					&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					foundProprietaMateriale = true;&#xD;
					Process.auditLog(&quot;Creato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
				}&#xD;
			}		&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//AttributoDettaglioRodine Protocollo Pila&#xD;
var trovatoPila = false;&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT)&#xD;
		{&#xD;
			if(currentDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
			{	&#xD;
				var j=0;&#xD;
				while(!trovatoPila &amp;&amp; j &lt; currentDettOrd.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrd = currentDettOrd.attributiDettaglioOrdine.get(j);&#xD;
					if(currentAttDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA)&#xD;
					{&#xD;
						trovatoPila = true;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
					j++;&#xD;
					}&#xD;
				}&#xD;
				if(trovatoPila)&#xD;
				{&#xD;
					Process.auditLog(&quot;Attributo ProtocolloPila già presente in input da xml&quot;);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
						var Attdettaglio = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						for (var k = 0; k &lt; ProtocolloPila.size(); k++)&#xD;
						{&#xD;
							if(currentDettOrd.IDDettaglioOrdine == ProtocolloPila.get(k).IDDettaglioOrdine)&#xD;
							{						&#xD;
							var currentProtPilaElement = ProtocolloPila.get(k);					&#xD;
							Attdettaglio.IDDettaglioOrdine = currentProtPilaElement.IDDettaglioOrdine;&#xD;
							Attdettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							Attdettaglio.created = DateTimeUtil.createDatetime();&#xD;
							Attdettaglio.lastUpdate = DateTimeUtil.createDatetime();&#xD;
							Attdettaglio.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA;&#xD;
							Attdettaglio.operatore = &quot;BPM&quot;;&#xD;
							Attdettaglio.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							Attdettaglio.valoreAttributo = currentProtPilaElement.protocolloPilaDefault;&#xD;
							localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(Attdettaglio));&#xD;
							}&#xD;
						}			&#xD;
				}				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}	&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Nessun Ordine presente nella Richiesta&quot;);&#xD;
}&#xD;
	&#xD;
//C01M02F12 Recupero DISTRETTO/IDCONTRATTO/CLIENTE/NUMEROFITTIZIO&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.IDAsset != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaFonia.IDAsset, 10));&#xD;
	}&#xD;
	else if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
	}&#xD;
	&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		var asset = AssetRef.readAsset();&#xD;
		if(asset.distretto != null &amp;&amp; asset.distretto.length > 0 &amp;&amp; &#xD;
			!((localRequest.ordine.tipologiaLinea==it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN &#xD;
			|| localRequest.ordine.tipologiaLinea==it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS)&#xD;
			&amp;&amp;(localRequest.strutturaRichiesta==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA &#xD;
			|| localRequest.strutturaRichiesta==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)))&#xD;
		{&#xD;
			localRequest.ordine.distretto = asset.distretto;&#xD;
		}&#xD;
		if(asset.IDContratto != null &amp;&amp; localRequest.IDContratto == null)&#xD;
		{&#xD;
			localRequest.IDContratto = asset.IDContratto;&#xD;
		}&#xD;
		if (asset.numeroFittizio != null &amp;&amp; asset.numeroFittizio.length > 0)&#xD;
		{&#xD;
			localRequest.ordine.numeroFittizio = asset.numeroFittizio;&#xD;
		}	&#xD;
		&#xD;
		if(asset.cliente != null 									&#xD;
			&amp;&amp; localRequest.ordine.nome == null &#xD;
			&amp;&amp; localRequest.ordine.cognomeRagioneSociale == null &#xD;
			&amp;&amp; localRequest.ordine.CF == null&#xD;
			&amp;&amp; localRequest.ordine.PIVA == null)  //Task #38239&#xD;
		{&#xD;
			if (asset.cliente.nome != null &amp;&amp; (localRequest.ordine.nome == null || localRequest.ordine.nome == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.nome = asset.cliente.nome;&#xD;
			}		&#xD;
			if (asset.cliente.cognomeRagioneSociale != null &amp;&amp; (localRequest.ordine.cognomeRagioneSociale == null || localRequest.ordine.cognomeRagioneSociale == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.cognomeRagioneSociale = asset.cliente.cognomeRagioneSociale;&#xD;
			}&#xD;
			&#xD;
			//SM_10686: Spostato arricchimento dei due campi qui invece che negli arricchimenti comuni&#xD;
			//CF e PIVA sono mutuamente esclusivi e non vanno arricchiti se uno dei due è indicato in input dall'OLO&#xD;
			if(localRequest.ordine.CF == null &amp;&amp; localRequest.ordine.PIVA == null)&#xD;
			{				&#xD;
				localRequest.ordine.CF = asset.cliente.codiceFiscale;&#xD;
				localRequest.ordine.PIVA = asset.cliente.partitaIVA;			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Consistenza Fonia o Dati non trovata.&quot;);&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
