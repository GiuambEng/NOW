        <xpdl2:Activity Id="_aSyUxA8nEeeXv8RtwyZtwQ" Name="RecuperaDettaglioSTS" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupera Dettaglio STS">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_5JLdtO-4EeaEEa7piwcrUw" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="CodiceSTS">
                  <xpdl2:Actual ScriptGrammar="JavaScript">listaCodiceSTS</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="STS">
                  <xpdl2:Actual ScriptGrammar="JavaScript">STS</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="79.0" LaneId="_7Zu7gfwjEeapT_T8svBRzg" Width="105.0">
              <xpdl2:Coordinates XCoordinate="3518.0" YCoordinate="1100.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">listaCodiceSTS.add(STSDaAggiungere);&#xD;
&#xD;
&#xD;
subprocessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.EnrichmentSTS&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">var data = DateTimeUtil.createDatetime();&#xD;
var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
componente.IDDettaglioOrdineParent = 1;&#xD;
componente.IDDettaglioOrdineRoot = 1;&#xD;
componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
componente.created = data;&#xD;
componente.integrationID = localRequest.IDRichiestaOLO + componente.IDDettaglioOrdine;&#xD;
componente.lastUpdate = data;&#xD;
componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS;&#xD;
componente.operatore = &quot;BPM&quot;;&#xD;
var conta = 0;&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine; i++){&#xD;
	if(localRequest.ordine.dettaglioordine.get(i).nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS){&#xD;
		conta++;&#xD;
	}&#xD;
}&#xD;
componente.progressivo = conta+1;&#xD;
//aggiungiAttributi&#xD;
var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
attributo.created = data;&#xD;
attributo.lastUpdate =data;&#xD;
attributo.operatore = &quot;BPM&quot;;&#xD;
attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
//CODICE&#xD;
attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE;&#xD;
attributo.valoreAttributo = STS.get(0).CODICESTS;&#xD;
componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
//DESCRIZIONE&#xD;
attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONE;&#xD;
attributo.valoreAttributo = STS.get(0).descrizione;&#xD;
componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
//CODICEDTU&#xD;
attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEDTU;&#xD;
attributo.valoreAttributo = STS.get(0).CODICEDTU;&#xD;
componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
//STATO&#xD;
attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
attributo.valoreAttributo = &quot;ATTIVO&quot;;&#xD;
componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
&#xD;
localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_vCJBlCsnEeekDfW79LFRAg" Name="Verificalavorazioniindotte" xpdExt:DisplayName="Verifica lavorazioni indotte">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_WsALoHyoEe-xEKVvWa3TXQ"/>
                  <xpdl2:TransitionRef Id="_wyp5sT8UEe2Ai61ig9Kg3A"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="76.0" LaneId="_7Zu7gfwjEeapT_T8svBRzg" Width="100.0">
              <xpdl2:Coordinates XCoordinate="2059.0" YCoordinate="1100.0"/>
