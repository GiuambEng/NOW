        <xpdl2:Activity Id="_-U0uQqt9Ee24JI2fFDerRA" Name="RecuperoAsset" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupero Asset">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var idAsset = &quot;&quot;;&#xD;
idAsset = null;&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
while(idAsset == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(idAsset == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				idAsset = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(idAsset != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(idAsset));&#xD;
	Asset = AssetRef.readAsset();&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_6pqwISv5EeyVBMucdpSJQg" Width="120.0">
              <xpdl2:Coordinates XCoordinate="812.0" YCoordinate="164.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_-U0uQ6t9Ee24JI2fFDerRA" Name="AggiornamentoSede" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiornamento Sede">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest != null &amp;&amp; localRequest.ordine != null&#xD;
	&amp;&amp; localRequest.ordine.sede.size() == 0)//SM_10972&#xD;
{&#xD;
	if(Asset != null)&#xD;
	{&#xD;
		var sedeCliente = it_telecomitalia_it_NOW_casedata_Factory.createSede();&#xD;
		sedeCliente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		sedeCliente.operatore = 'BPM';&#xD;
		sedeCliente.IDSede = localRequest.ordine.sede.size()+1;&#xD;
		sedeCliente.tipologiaSede = it_telecomitalia_it_NOW_casedata_TipologiaSedeEnumeration.SEDECLIENTE;//SM_10916&#xD;
		&#xD;
		if (Asset.codiceToponomastica != null &amp;&amp; Asset.codiceToponomastica != &quot;&quot;)&#xD;
		{	&#xD;
			sedeCliente.codiceToponomastica = Asset.codiceToponomastica;	&#xD;
			sedeCliente.CAP = EnrichmentSedeOutput.CAP;&#xD;
			sedeCliente.codiceISTATComune = EnrichmentSedeOutput.codISTATComune;&#xD;
			//sedeCliente.codiceISTATProvincia = asset.codiceISTATProvincia;&#xD;
			sedeCliente.complesso = Asset.complesso;&#xD;
			sedeCliente.comune = EnrichmentSedeOutput.descrComune;&#xD;
			sedeCliente.particellaToponomastica = EnrichmentSedeOutput.descrParticellaToponomastica;&#xD;
			sedeCliente.via = EnrichmentSedeOutput.descrVia;&#xD;
			sedeCliente.interno = Asset.interno;&#xD;
			sedeCliente.civico = EnrichmentSedeOutput.numeroCivico;&#xD;
			sedeCliente.piano = Asset.piano;&#xD;
			sedeCliente.scala = Asset.scala;&#xD;
			sedeCliente.siglaProvincia = EnrichmentSedeOutput.siglaProvincia;&#xD;
			sedeCliente.codiceISTATProvincia = EnrichmentSedeOutput.codiceISTATProvincia;&#xD;
			sedeCliente.provincia = EnrichmentSedeOutput.descrProvincia;&#xD;
			sedeCliente.codiceVia = EnrichmentSedeOutput.codVia;			&#xD;
			sedeCliente.localita = Asset.localita;		&#xD;
		}&#xD;
		else&#xD;
		{			&#xD;
			sedeCliente.CAP = Asset.CAP;&#xD;
			sedeCliente.codiceISTATComune = Asset.codiceISTATComune;&#xD;
			sedeCliente.codiceISTATProvincia = Asset.codiceISTATProvincia;&#xD;
			sedeCliente.complesso = Asset.complesso;&#xD;
			sedeCliente.comune = Asset.comune;&#xD;
			sedeCliente.particellaToponomastica = Asset.descrPartToponomastica;&#xD;
			sedeCliente.via = Asset.descrizioneVia;&#xD;
			sedeCliente.interno = Asset.interno;&#xD;
			sedeCliente.localita = Asset.localita;&#xD;
			sedeCliente.civico = Asset.numeroCivico;&#xD;
			sedeCliente.piano = Asset.piano;&#xD;
			sedeCliente.provincia = Asset.provincia;&#xD;
			sedeCliente.scala = Asset.scala;&#xD;
			sedeCliente.siglaProvincia = Asset.siglaProvincia;					&#xD;
		}&#xD;
		localRequest.ordine.sede.add(sedeCliente);	&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
