			}&#xD;
			if(!foundCODICEMACROAREA &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceMacroArea != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA;&#xD;
