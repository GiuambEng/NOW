        </xpdl2:Activity>
        <xpdl2:Activity Id="_ZuJf8lJtEfChJ7SO1zde6A" Name="ArricchimentoOrdineMigDel82" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Ordine Mig Del82" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Script inserito con la RU_1546 - MIG DEL82 - C07 2025&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	&#xD;
//CONFIGURAZIONE AZIONE&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTH&#xD;
	   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONGAFTTH&#xD;
	   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTH&#xD;
	   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
	   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)   &#xD;
	{&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;   &#xD;
	}  &#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//RU_1550 - Check per arricchimento INTERMEDIATEAGENTFULL&#xD;
var valoreINTERMEDIATEAGENTFULL = &quot;&quot;;&#xD;
valoreINTERMEDIATEAGENTFULL = null;&#xD;
&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH      //RU_1558&#xD;
      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS)&#xD;
   &amp;&amp; EsistenzaVLANMigDel82Response != null &amp;&amp; EsistenzaVLANMigDel82Response.vlan.size()>0)&#xD;
{&#xD;
	valoreINTERMEDIATEAGENTFULL = &quot;NO&quot;;&#xD;
	&#xD;
	for(var k=0; k&lt;EsistenzaVLANMigDel82Response.vlan.size(); k++)&#xD;
	{		&#xD;
		if(EsistenzaVLANMigDel82Response.vlan.get(k).INTERMEDIATE_AGENT == &quot;SI&quot;)&#xD;
		{&#xD;
			valoreINTERMEDIATEAGENTFULL = &quot;SI&quot;;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
        || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)&#xD;
{&#xD;
	valoreINTERMEDIATEAGENTFULL = &quot;NO&quot;;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{		&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION&#xD;
				   &amp;&amp; attr.valoreAttributo == &quot;SINGLETAG&quot;)&#xD;
				{&#xD;
					valoreINTERMEDIATEAGENTFULL = &quot;SI&quot;;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//ARRICCHIMENTO GENERICO&#xD;
var foundProprietaMateriale = false;&#xD;
var foundFlagEquivalenzaProdotti = false; &#xD;
var foundMigrazioneIntraOlo = false;&#xD;
var foundMigrCommercialeIntraOlo = false;&#xD;
var foundIntermediateagentfull = false;   //RU_1550&#xD;
var foundCluster = false;  //SM_11881&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{		&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE&#xD;
			   &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
			{&#xD;
				foundProprietaMateriale = true;&#xD;
				attr.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
				Process.auditLog(&quot;Aggiornato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
			}&#xD;
			else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI&#xD;
			   &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null) &#xD;
			{&#xD;
				foundFlagEquivalenzaProdotti = true;&#xD;
				attr.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
				Process.auditLog(&quot;Aggiornato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
			}&#xD;
			else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MIGRAZIONEINTRAOLO&#xD;
			   &amp;&amp; LavorazioneRichiesta.migrazioneIntraOlo != null) &#xD;
			{&#xD;
				foundMigrazioneIntraOlo = true;&#xD;
				attr.valoreAttributo = LavorazioneRichiesta.migrazioneIntraOlo;&#xD;
				Process.auditLog(&quot;Aggiornato attributo MIGRAZIONEINTRAOLO con valore: &quot;+ LavorazioneRichiesta.migrazioneIntraOlo);&#xD;
			}&#xD;
			else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MIGRCOMMERCIALEINTRAOLO&#xD;
			   &amp;&amp; LavorazioneRichiesta.migrCommercialeIntraOlo != null) &#xD;
			{&#xD;
				foundMigrCommercialeIntraOlo = true;&#xD;
				attr.valoreAttributo = LavorazioneRichiesta.migrCommercialeIntraOlo;&#xD;
				Process.auditLog(&quot;Aggiornato attributo MIGRCOMMERCIALEINTRAOLO con valore: &quot;+ LavorazioneRichiesta.migrCommercialeIntraOlo);&#xD;
			}&#xD;
			else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INTERMEDIATEAGENTFULL&#xD;
			   &amp;&amp; valoreINTERMEDIATEAGENTFULL != null) //RU_1550&#xD;
			{&#xD;
				foundIntermediateagentfull = true;&#xD;
				attr.valoreAttributo = valoreINTERMEDIATEAGENTFULL;&#xD;
				Process.auditLog(&quot;Aggiornato attributo INTERMEDIATEAGENTFULL con valore: &quot;+ valoreINTERMEDIATEAGENTFULL);&#xD;
			}&#xD;
			else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLUSTER    //Radius SM_11881&#xD;
			   &amp;&amp; LavorazioneRichiesta.cluster != null)&#xD;
			{&#xD;
				foundCluster = true;&#xD;
				attr.valoreAttributo = LavorazioneRichiesta.cluster;&#xD;
				Process.auditLog(&quot;Aggiornato attributo Cluster con valore: &quot;+ LavorazioneRichiesta.cluster);&#xD;
			}&#xD;
		}&#xD;
					&#xD;
		if(!foundProprietaMateriale &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
		{&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = ora;&#xD;
			attributo.lastUpdate = ora;&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE;&#xD;
			attributo.operatore = componente.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			attributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;			&#xD;
			componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			foundProprietaMateriale = true;&#xD;
			Process.auditLog(&quot;Creato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
		}&#xD;
		if(!foundFlagEquivalenzaProdotti &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
		{&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = ora;&#xD;
			attributo.lastUpdate = ora;&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI;&#xD;
			attributo.operatore = componente.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			attributo.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;			&#xD;
			componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			foundFlagEquivalenzaProdotti = true;&#xD;
			Process.auditLog(&quot;Creato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
		}&#xD;
		if(!foundMigrazioneIntraOlo &amp;&amp; LavorazioneRichiesta.migrazioneIntraOlo != null)&#xD;
		{&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = ora;&#xD;
			attributo.lastUpdate = ora;&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MIGRAZIONEINTRAOLO;&#xD;
			attributo.operatore = componente.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			attributo.valoreAttributo = LavorazioneRichiesta.migrazioneIntraOlo;			&#xD;
			componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			foundMigrazioneIntraOlo = true;&#xD;
			Process.auditLog(&quot;Creato attributo MIGRAZIONEINTRAOLO con valore: &quot;+ LavorazioneRichiesta.migrazioneIntraOlo);&#xD;
		}	&#xD;
		if(!foundMigrCommercialeIntraOlo &amp;&amp; LavorazioneRichiesta.migrCommercialeIntraOlo != null)&#xD;
		{&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = ora;&#xD;
			attributo.lastUpdate = ora;&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MIGRCOMMERCIALEINTRAOLO;&#xD;
			attributo.operatore = componente.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			attributo.valoreAttributo = LavorazioneRichiesta.migrCommercialeIntraOlo;			&#xD;
			componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			foundMigrCommercialeIntraOlo = true;&#xD;
			Process.auditLog(&quot;Creato attributo MIGRCOMMERCIALEINTRAOLO con valore: &quot;+ LavorazioneRichiesta.migrCommercialeIntraOlo);&#xD;
		}&#xD;
		if(!foundIntermediateagentfull &amp;&amp; valoreINTERMEDIATEAGENTFULL != null)  //RU_1550&#xD;
		{&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
