        <xpdl2:Activity Id="_LfHiQeb9Eeaqr96OWxgQ0w" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_yIM9U-b8Eeaqr96OWxgQ0w" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_hXWFsebwEeaqr96OWxgQ0w" Width="58.0">
