            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">//RU_1463: costruzione array ListaDNScartati dalle uscite per cui Inventory ha dato KO&#xD;
if(ArrayInventoryOutput != null &amp;&amp; ArrayInventoryOutput.size()>0)&#xD;
{&#xD;
	for(var i=0; i&lt;ArrayInventoryOutput.size(); i++)&#xD;
	{&#xD;
