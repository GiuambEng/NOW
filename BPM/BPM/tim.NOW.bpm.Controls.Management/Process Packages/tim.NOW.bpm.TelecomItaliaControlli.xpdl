		listaValoreOrdine.add(&quot;&quot;);&#xD;
		listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		listaLavorazioneRichiesta.add(&quot;&quot;);&#xD;
	}&#xD;
	&#xD;
	// ================= FILLING ARRAY LISTALAVORAZIONERICHIESTA SULLA CONFIGURAZIONE =================&#xD;
	if(LavorazioneRichiesta != null)&#xD;
	{&#xD;
		for(var i=0; i&lt;listaAttributiOrdine.size();i++)&#xD;
		{&#xD;
			if(listaAttributiOrdine.get(i) == &quot;NOMECLLI&quot; &amp;&amp; LavorazioneRichiesta.nomeClli != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.nomeClli);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;TRASPORTO&quot; &amp;&amp; LavorazioneRichiesta.trasporto != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.trasporto);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;CODICEAREARACCOLTA&quot; &amp;&amp; LavorazioneRichiesta.codiceAreaRaccolta != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.codiceAreaRaccolta);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;NOMEAREARACCOLTA&quot; &amp;&amp; LavorazioneRichiesta.nomeAreaRaccolta != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.nomeAreaRaccolta);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;PUNTOCONSEGNA&quot; &amp;&amp; LavorazioneRichiesta.puntoConsegna != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.puntoConsegna);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;MODELLOVLAN&quot; &amp;&amp; LavorazioneRichiesta.modelloVlan != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.modelloVlan);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;IDKITAREACAR&quot; &amp;&amp; LavorazioneRichiesta.idKitAreaCar != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.idKitAreaCar);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;IDMADRCRMWS&quot; &amp;&amp; LavorazioneRichiesta.idMadrCrmws != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.idMadrCrmws);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;NOMEMACROAREA&quot; &amp;&amp; LavorazioneRichiesta.nomeMacroArea != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.nomeMacroArea);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;CODICEMACROAREA&quot; &amp;&amp; LavorazioneRichiesta.codiceMacroArea != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.codiceMacroArea);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;FTTHONLY&quot; &amp;&amp; LavorazioneRichiesta.ftthOnly != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.ftthOnly);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;IDMADRCRMWSCOMM&quot; &amp;&amp; LavorazioneRichiesta.idMadrCrmwsComm != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.idMadrCrmwsComm);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;CODICEMACROAREACOMM&quot; &amp;&amp; LavorazioneRichiesta.codiceMacroAreaComm != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.codiceMacroAreaComm);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;NOMEMACROAREACOMM&quot; &amp;&amp; LavorazioneRichiesta.nomeMacroAreaComm != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.nomeMacroAreaComm);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;DSLAMTYPE&quot; &amp;&amp; LavorazioneRichiesta.dslamType != null){&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.dslamType);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;TIPOLOGIACLUSTERVLAN&quot; &amp;&amp; LavorazioneRichiesta.tipologiaClusterVlan != null){    //SM_9935&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.tipologiaClusterVlan);&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;CARATTERISTICAVLAN&quot; &amp;&amp; LavorazioneRichiesta.caratteristicaVlan != null){    //RU_1502&#xD;
				listaLavorazioneRichiesta.set(i,LavorazioneRichiesta.caratteristicaVlan);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//RECUPERO ASSET&#xD;
	if(AssetRef != null){&#xD;
		Asset = AssetRef.readAsset();&#xD;
	}&#xD;
&#xD;
	//------------------------------------  Recupero informazioni da ASSET ------------------------------------&#xD;
	// rispetto alla configurazione si recuperano gli attributi su asset e si salvano nella lista &quot;listaValore&quot;, se non trovato il valore rimarrà &quot;&quot;&#xD;
	for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var compAsset = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
		if(String(compAsset.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;compAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var attributoAsset = compAsset.attributidettaglioasset.get(j);&#xD;
				&#xD;
				for(var k =0; k&lt;listaValoreAsset.size();k++)&#xD;
				{&#xD;
					if(listaComponenti.get(k) == &quot;RACCOLTA&quot; &amp;&amp; listaValoreAsset.get(k) == &quot;&quot; &amp;&amp; attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiAsset.get(k)))&#xD;
					{&#xD;
						listaValoreAsset.set(k,attributoAsset.valoreAttributo);&#xD;
					}&#xD;
				}&#xD;
			}			&#xD;
		}&#xD;
		else if(compAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
		{&#xD;
			for(var j=0; j&lt;compAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var attributoAsset = compAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
				if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS){&#xD;
					IdentificativoCOSAsset.add(attributoAsset.valoreAttributo);&#xD;
					Process.auditLog(&quot;IDENTIFICATIVOCOS Asset: &quot;+attributoAsset.valoreAttributo);&#xD;
				}&#xD;
				else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDA){&#xD;
					TipoBandaAsset.add(attributoAsset.valoreAttributo);&#xD;
					Process.auditLog(&quot;TIPOBANDA Asset: &quot;+attributoAsset.valoreAttributo);&#xD;
				}&#xD;
				else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA){&#xD;
					BandaAsset.add(attributoAsset.valoreAttributo);&#xD;
					Process.auditLog(&quot;BANDA Asset: &quot;+attributoAsset.valoreAttributo);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//------------------------------------  Recupero informazioni da ORDINE ------------------------------------ &#xD;
	var SUPERMACROAREA = &quot;&quot;;&#xD;
	SUPERMACROAREA = null;&#xD;
	var TIPOLOGIACLUSTERVLAN = &quot;&quot;;&#xD;
	TIPOLOGIACLUSTERVLAN = null;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componenteOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componenteOrdine.nomeComponente).slice(0,8)==&quot;RACCOLTA&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componenteOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributoOrdine = componenteOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				for(var k =0; k&lt;listaAttributiOrdine.size();k++)&#xD;
				{&#xD;
					if(listaComponenti.get(k) == &quot;RACCOLTA&quot; &amp;&amp; listaValoreOrdine.get(k)==&quot;&quot; &amp;&amp; attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine.get(k)))&#xD;
					{&#xD;
						listaValoreOrdine.set(k,attributoOrdine.valoreAttributo);&#xD;
						&#xD;
						// Attributi dell'ordine che servono per logiche particolari (vedi LOGICHE ARRICCHIMENTO)&#xD;
						if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA){&#xD;
							SUPERMACROAREA = attributoOrdine.valoreAttributo;		&#xD;
						}&#xD;
						else if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN){&#xD;
							TIPOLOGIACLUSTERVLAN = attributoOrdine.valoreAttributo;	&#xD;
						}&#xD;
					}&#xD;
				}				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//	========================================== LOGICHE ARRICCHIMENTO ==========================================&#xD;
	// Tipo di variazione&#xD;
	var VARIAZIONETDKIT_CAR = false;&#xD;
	&#xD;
	if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT&#xD;
		|| localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONECAR){&#xD;
		VARIAZIONETDKIT_CAR = true;&#xD;
	}&#xD;
	&#xD;
	// Check logica particolare per arricchimento MACROAREA&#xD;
	var MacroAreaDaConsistenza = false;&#xD;
	var MacroAreaDaConsistenzaEliminata = false;&#xD;
	&#xD;
	if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONEBANDA&#xD;
	|| localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONENUMEROCONDIVISORI)&#xD;
	{&#xD;
		MacroAreaDaConsistenza = true;&#xD;
	}&#xD;
	if((localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT&#xD;
     || localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONECAR)&#xD;
     &amp;&amp; ((SUPERMACROAREA == &quot;1&quot; || SUPERMACROAREA == &quot;2&quot; || SUPERMACROAREA == &quot;3&quot;)&#xD;
	  ||((SUPERMACROAREA == &quot;0&quot; || SUPERMACROAREA == null) &amp;&amp; TIPOLOGIACLUSTERVLAN == null)))&#xD;
	{&#xD;
		MacroAreaDaConsistenzaEliminata = true;&#xD;
		Process.auditLog(&quot;eliminare MacroArea da Consistenza, SUPERMACROAREA: &quot;+SUPERMACROAREA+&quot;, TIPOLOGIACLUSTERVLAN: &quot;+TIPOLOGIACLUSTERVLAN);&#xD;
	}&#xD;
	&#xD;
	for(var i=0; i&lt;listaAttributiOrdine.size(); i++)&#xD;
	{&#xD;
		// ATTRIBUTI PER CUI GESTIRE LA VARIAZIONE DA LAV RICHIESTA&#xD;
		if(VARIAZIONETDKIT_CAR &amp;&amp; listaAttributiOrdine.get(i) == &quot;CARATTERISTICAVLAN&quot;) //RU_1502: va creato sempre e non solo per &quot;DRG OPZIONE ZERO&quot;&#xD;
		{&#xD;
			if(listaLavorazioneRichiesta.get(i) != &quot;&quot;)&#xD;
			{&#xD;
				listaValoreOrdine.set(i,listaLavorazioneRichiesta.get(i));&#xD;
				listaValoreOrdineOld.set(i,listaValoreAsset.get(i));&#xD;
			}&#xD;
			else if(listaValoreAsset.get(i) != &quot;&quot; &amp;&amp; listaLavorazioneRichiesta.get(i) == &quot;&quot;)&#xD;
			{&#xD;
				listaValoreOrdine.set(i,&quot;ATTRIBUTO IN ELIMINAZIONE&quot;);&#xD;
				listaValoreOrdineOld.set(i,listaValoreAsset.get(i));&#xD;
			}&#xD;
		}&#xD;
		else if(VARIAZIONETDKIT_CAR&#xD;
		&amp;&amp; (listaAttributiOrdine.get(i) == &quot;FTTHONLY&quot;&#xD;
		 || listaAttributiOrdine.get(i) == &quot;TIPOLOGIACLUSTERVLAN&quot;))&#xD;
		{&#xD;
			if((ConsistenzaRaccolta.famigliaVlan == &quot;1&quot; &amp;&amp; IdentificativoCOSAsset != null &amp;&amp; IdentificativoCOSAsset.size()>0&#xD;
														&amp;&amp; IdentificativoCOSAsset.get(0) != &quot;3&quot; &amp;&amp; IdentificativoCOSAsset.get(0) != &quot;5&quot;)&#xD;
					|| ConsistenzaRaccolta.famigliaVlan == &quot;2&quot;&#xD;
					|| ConsistenzaRaccolta.famigliaVlan == &quot;3&quot;)&#xD;
			{&#xD;
				if(listaLavorazioneRichiesta.get(i) != &quot;&quot;)&#xD;
				{&#xD;
					listaValoreOrdine.set(i,listaLavorazioneRichiesta.get(i));&#xD;
					&#xD;
					//SM_9962: Old va messo quando sono diversi, il valoreAttributo va comunque messo&#xD;
					if(listaLavorazioneRichiesta.get(i) != listaValoreAsset.get(i))&#xD;
					{&#xD;
						listaValoreOrdineOld.set(i,listaValoreAsset.get(i));&#xD;
					}&#xD;
				}&#xD;
				else if(listaValoreAsset.get(i) != &quot;&quot; &amp;&amp; listaLavorazioneRichiesta.get(i) == &quot;&quot;)&#xD;
				{&#xD;
					listaValoreOrdine.set(i,&quot;ATTRIBUTO IN ELIMINAZIONE&quot;);&#xD;
					listaValoreOrdineOld.set(i,listaValoreAsset.get(i));&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(listaAttributiOrdine.get(i) == &quot;TRASPORTO&quot; &#xD;
		|| listaAttributiOrdine.get(i) == &quot;CODICEAREARACCOLTA&quot; &#xD;
		|| listaAttributiOrdine.get(i) == &quot;NOMEAREARACCOLTA&quot; &#xD;
		|| listaAttributiOrdine.get(i) == &quot;PUNTOCONSEGNA&quot;&#xD;
		|| listaAttributiOrdine.get(i) == &quot;MODELLOVLAN&quot;&#xD;
		|| listaAttributiOrdine.get(i) == &quot;NOMEMACROAREA&quot;&#xD;
		|| listaAttributiOrdine.get(i) == &quot;CODICEMACROAREA&quot;)	&#xD;
		{&#xD;
			if(VARIAZIONETDKIT_CAR &amp;&amp; listaLavorazioneRichiesta.get(i) != &quot;&quot;){&#xD;
				listaValoreOrdine.set(i,listaLavorazioneRichiesta.get(i));&#xD;
				listaValoreOrdineOld.set(i,listaValoreAsset.get(i));&#xD;
			}&#xD;
			else{&#xD;
				listaValoreOrdine.set(i,listaValoreAsset.get(i));&#xD;
			}&#xD;
		}&#xD;
		else if(listaAttributiOrdine.get(i) == &quot;IDKITAREACAR&quot;&#xD;
			 || listaAttributiOrdine.get(i) == &quot;IDMADRCRMWSCOMM&quot;)&#xD;
		{&#xD;
			if(listaLavorazioneRichiesta.get(i) != &quot;&quot;){&#xD;
				listaValoreOrdine.set(i,listaLavorazioneRichiesta.get(i));&#xD;
				listaValoreOrdineOld.set(i,listaValoreAsset.get(i));&#xD;
			}&#xD;
			else{&#xD;
				listaValoreOrdine.set(i,listaValoreAsset.get(i));&#xD;
			}&#xD;
		}&#xD;
		// ATTRIBUTI CABLATI&#xD;
		else if(listaAttributiOrdine.get(i) == &quot;FLAGMULTICOS&quot;&#xD;
			 || listaAttributiOrdine.get(i) == &quot;QINQFLAG&quot;)&#xD;
		{&#xD;
			if(listaAttributiOrdine.get(i) == &quot;FLAGMULTICOS&quot;)&#xD;
			{&#xD;
				if(ConsistenzaRaccolta.famigliaVlan == &quot;1&quot;){&#xD;
					listaValoreOrdine.set(i,&quot;N&quot;);&#xD;
				}&#xD;
				else if(ConsistenzaRaccolta.famigliaVlan == &quot;2&quot; || ConsistenzaRaccolta.famigliaVlan == &quot;3&quot;){&#xD;
					listaValoreOrdine.set(i,&quot;Y&quot;);&#xD;
				}&#xD;
			}&#xD;
			else if(listaAttributiOrdine.get(i) == &quot;QINQFLAG&quot;)   //Task #34120: controlliamo tipoVlan&#xD;
			{&#xD;
				if(ConsistenzaRaccolta.tipoVlan == &quot;1&quot;){&#xD;
					listaValoreOrdine.set(i,&quot;N&quot;);&#xD;
				}&#xD;
				else if(ConsistenzaRaccolta.tipoVlan == &quot;2&quot;){&#xD;
					listaValoreOrdine.set(i,&quot;Y&quot;);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		// LOGICHE PARTICOLARI&#xD;
		else if(listaAttributiOrdine.get(i) == &quot;FTTHONLY&quot;)&#xD;
		{&#xD;
			if(ConsistenzaRaccolta.famigliaVlan == &quot;1&quot; &#xD;
			&amp;&amp; IdentificativoCOSAsset != null &#xD;
			&amp;&amp; IdentificativoCOSAsset.size()>0&#xD;
			&amp;&amp; (IdentificativoCOSAsset.get(0) == &quot;3&quot; || IdentificativoCOSAsset.get(0) == &quot;5&quot;))&#xD;
			{&#xD;
				listaValoreOrdine.set(i,listaValoreAsset.get(i));&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				listaValoreOrdine.set(i,listaLavorazioneRichiesta.get(i));&#xD;
			}&#xD;
		}&#xD;
		else if(listaAttributiOrdine.get(i) == &quot;NOMEMACROAREACOMM&quot;&#xD;
			 || listaAttributiOrdine.get(i) == &quot;CODICEMACROAREACOMM&quot;)&#xD;
		{&#xD;
			if(listaLavorazioneRichiesta.get(i) != &quot;&quot;){&#xD;
				listaValoreOrdine.set(i,listaLavorazioneRichiesta.get(i));&#xD;
				listaValoreOrdineOld.set(i,listaValoreAsset.get(i));&#xD;
			}&#xD;
			else if(MacroAreaDaConsistenza){&#xD;
				listaValoreOrdine.set(i,listaValoreAsset.get(i));&#xD;
			}&#xD;
			else if(MacroAreaDaConsistenzaEliminata &amp;&amp; listaValoreAsset.get(i) != &quot;&quot;){   //SM_9971: aggiunta condizione valoreAsset != &quot;&quot;&#xD;
				listaValoreOrdine.set(i,&quot;ATTRIBUTO IN ELIMINAZIONE&quot;);&#xD;
				listaValoreOrdineOld.set(i,listaValoreAsset.get(i));&#xD;
			}&#xD;
		}&#xD;
		// ATTRIBUTI CHE POSSONO ARRIVARE IN INPUT e POSSONO VARIARE&#xD;
		else if(listaAttributiOrdine.get(i) == &quot;CODICETDKIT&quot;&#xD;
		     || listaAttributiOrdine.get(i) == &quot;IDENTIFICATIVOCAR&quot;&#xD;
			 || listaAttributiOrdine.get(i) == &quot;SUPERMACROAREA&quot;&#xD;
			 || listaAttributiOrdine.get(i) == &quot;PROFILOBMC&quot;&#xD;
			 || listaAttributiOrdine.get(i) == &quot;FLAGVLANTRANSLATION&quot;&#xD;
			 || listaAttributiOrdine.get(i) == &quot;IDENTIFICATIVOVLANOLO&quot;)&#xD;
		{&#xD;
			if(listaValoreOrdine.get(i) != &quot;&quot;)&#xD;
			{&#xD;
				listaValoreOrdineOld.set(i,listaValoreAsset.get(i));&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				listaValoreOrdine.set(i,listaValoreAsset.get(i));&#xD;
			}&#xD;
		}&#xD;
		// TUTTI GLI ALTRI&#xD;
		else&#xD;
		{&#xD;
			listaValoreOrdine.set(i,listaValoreAsset.get(i));&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	// ========================================== AGGIORNAMENTO ORDINE ==========================================&#xD;
	// rispetto alla configurazione si arricchisce l'ordine della richiesta&#xD;
	var attrCampione = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attrCampione.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	attrCampione.created = data;&#xD;
	attrCampione.lastUpdate = data;&#xD;
	attrCampione.operatore = localRequest.operatore;&#xD;
	attrCampione.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2; //DI DEFAULT VARCHAR 2&#xD;
	&#xD;
	var foundTIPOCOS = false;   &#xD;
	var foundTIPOBANDA = false;&#xD;
	var foundIDENTIFICATIVOCOS = false;&#xD;
	var foundBANDA = false;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var compOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		//------- RACCOLTA -------&#xD;
		if(String(compOrdine.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;)&#xD;
		{	&#xD;
			//Si cerca di aggiornare il valore se present in input&#xD;
			for(var j=0; j&lt;compOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributoOrdine = compOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				//---------- Modifica attributi presenti ----------&#xD;
				for(var k =0; k&lt;listaAttributiOrdine.size();k++)&#xD;
				{&#xD;
					if(listaComponenti.get(k) == &quot;RACCOLTA&quot; &amp;&amp; listaAttributiDaAggiungere.get(k) == true &amp;&amp; attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine.get(k)))&#xD;
					{&#xD;
						if(listaValoreOrdine.get(k)!= &quot;&quot;)&#xD;
						{&#xD;
							attributoOrdine.lastUpdate = data;&#xD;
							&#xD;
							if(listaAttributiDaAggiungere.get(k) == true)&#xD;
							{&#xD;
								attributoOrdine.valoreAttributo = listaValoreOrdine.get(k);&#xD;
								&#xD;
								if(listaValoreOrdineOld.get(k)!=&quot;&quot;&#xD;
								&amp;&amp; listaValoreOrdineOld.get(k)!= listaValoreOrdine.get(k)){&#xD;
									attributoOrdine.valoreAttributoOLD = listaValoreOrdineOld.get(k);&#xD;
								}&#xD;
							}&#xD;
							else{&#xD;
								attributoOrdine.valoreAttributo = listaValoreAsset.get(k);&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						listaAttributiDaAggiungere.set(k, false);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			// Se non presente in input si aggiungono tutti gli attributi, previsti dalla configurazione, per i quali è stato recuperato un valore ammissibile&#xD;
			for(var k =0; k&lt;listaAttributiOrdine.size();k++)&#xD;
			{&#xD;
				if(listaComponenti.get(k) == &quot;RACCOLTA&quot; &amp;&amp; listaAttributiDaAggiungere.get(k) == true)&#xD;
				{&#xD;
					if(listaValoreOrdine.get(k) != &quot;&quot;)&#xD;
					{&#xD;
						var attrtemp = ScriptUtil.copy(attrCampione);&#xD;
						attrtemp.IDDettaglioOrdine = compOrdine.IDDettaglioOrdine;&#xD;
						attrtemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine.get(k));&#xD;
						&#xD;
						// NON VARCHAR2, ma ALTRA TIPOLOGIADATO&#xD;
						if(listaAttributiOrdine.get(k) == &quot;IDKITAREACAR&quot;){&#xD;
							attrtemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.NUMBER;&#xD;
						}&#xD;
						&#xD;
						attrtemp.valoreAttributo = listaValoreOrdine.get(k);&#xD;
						&#xD;
						if(listaValoreOrdineOld.get(k)!=&quot;&quot;&#xD;
						&amp;&amp; listaValoreOrdineOld.get(k)!= listaValoreOrdine.get(k)){&#xD;
							attrtemp.valoreAttributoOLD = listaValoreOrdineOld.get(k);&#xD;
						}&#xD;
						&#xD;
						compOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attrtemp));&#xD;
					}&#xD;
					else{&#xD;
						Process.auditLog(&quot;Impossibile arricchire l'ordine con l'elemento &quot;+listaAttributiOrdine.get(k)+&quot; perchè non presente in consistenza&quot;);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			// configura Azione&#xD;
			compOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
		}&#xD;
		else if(compOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
		{&#xD;
			if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONEBANDA){  //SM_9894&#xD;
				compOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
			}&#xD;
			else{&#xD;
				compOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
			}&#xD;
			&#xD;
			foundTIPOCOS = true;&#xD;
			var IdentificativoCosRichiesta = &quot;&quot;;&#xD;
			IdentificativoCosRichiesta = null;&#xD;
			&#xD;
			for(var j=0; j&lt;compOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = compOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				//TIPOBANDA&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDA){&#xD;
					foundTIPOBANDA = true;&#xD;
				}&#xD;
				//IDENTIFICATIVOCOS&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS){&#xD;
					foundIDENTIFICATIVOCOS = true;&#xD;
					IdentificativoCosRichiesta = attributo.valoreAttributo;	&#xD;
				}&#xD;
				//BANDA&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA){&#xD;
					foundBANDA = true;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//SM_9888: spostato tutto questo if prima della creazione del valore Old (quando ci arriva solo banda, IdentificativoCosRichiesta non ci sta ancora)&#xD;
			//Task #33217: SE TROVIAMO TIPOCOS ma PARZIALMENTE VALORIZZATA vanno messi i valori mancanti (FamigliaVLAN 2 e 3 è gestita lato input)&#xD;
			if(ConsistenzaRaccolta.famigliaVlan == &quot;1&quot;)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributoTemp = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributoTemp.IDDettaglioOrdine = compOrdine.IDDettaglioOrdine;&#xD;
				attributoTemp.IDRichiestaOLO = compOrdine.IDRichiestaOLO;&#xD;
				attributoTemp.created = ora;&#xD;
				attributoTemp.lastUpdate = ora;&#xD;
				attributoTemp.operatore = compOrdine.operatore;&#xD;
				&#xD;
				//IDENTIFICATIVOCOS&#xD;
				if(IdentificativoCOSAsset != null &amp;&amp; IdentificativoCOSAsset.size()>0 &amp;&amp; !foundIDENTIFICATIVOCOS)&#xD;
				{&#xD;
					attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS;&#xD;
					attributoTemp.valoreAttributo = IdentificativoCOSAsset.get(0);&#xD;
					attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.NUMBER;&#xD;
					compOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
					Process.auditLog(&quot;Creato attributo IDENTIFICATIVOCOS&quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+compOrdine.IDDettaglioOrdine);&#xD;
					&#xD;
					IdentificativoCosRichiesta = attributoTemp.valoreAttributo;    //SM_9888&#xD;
				}&#xD;
				//TIPOBANDA&#xD;
				if(TipoBandaAsset != null &amp;&amp; TipoBandaAsset.size()>0 &amp;&amp; !foundTIPOBANDA)&#xD;
				{&#xD;
					attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDA;&#xD;
					attributoTemp.valoreAttributo = TipoBandaAsset.get(0);&#xD;
					attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					compOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
					Process.auditLog(&quot;Creato attributo TIPOBANDA&quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+compOrdine.IDDettaglioOrdine);&#xD;
				}&#xD;
				//BANDA&#xD;
				if(BandaAsset != null &amp;&amp; BandaAsset.size()>0 &amp;&amp; !foundBANDA)&#xD;
				{&#xD;
					attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA;&#xD;
					attributoTemp.valoreAttributo = BandaAsset.get(0);&#xD;
					attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					compOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
					Process.auditLog(&quot;Creato attributo BANDA&quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+compOrdine.IDDettaglioOrdine);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//Creazione valoreAttributoOLD di BANDA&#xD;
			if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONEBANDA)&#xD;
			{&#xD;
				var exit = false;&#xD;
				var index = 0;&#xD;
				&#xD;
				while(index&lt;IdentificativoCOSAsset.size() &amp;&amp; !exit)&#xD;
				{&#xD;
					if(IdentificativoCosRichiesta == IdentificativoCOSAsset.get(index))&#xD;
					{&#xD;
						Process.auditLog(&quot;IdentificativoCosRichiesta trovato tra quelli in Asset: &quot;+IdentificativoCosRichiesta);&#xD;
						&#xD;
						for(var j2=0; j2&lt;compOrdine.attributiDettaglioOrdine.size(); j2++)&#xD;
						{&#xD;
							var attributo = compOrdine.attributiDettaglioOrdine.get(j2);&#xD;
							&#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA&#xD;
							   &amp;&amp; BandaAsset != null &amp;&amp; BandaAsset.size()>0 &#xD;
							   &amp;&amp; BandaAsset.get(index) != attributo.valoreAttributo)&#xD;
							{&#xD;
								attributo.valoreAttributoOLD = BandaAsset.get(index);&#xD;
								Process.auditLog(&quot;Impostato valoreOLD Banda: &quot;+BandaAsset.get(index));&#xD;
							}&#xD;
						}&#xD;
						exit = true;&#xD;
					}&#xD;
					index++;&#xD;
				}&#xD;
			}	&#xD;
		}&#xD;
		else if(compOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OLOVLAN&#xD;
		&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONENUMEROCONDIVISORI)&#xD;
		{&#xD;
			for(var j=0; j&lt;compOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = compOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AZIONE)&#xD;
				{&#xD;
					if(attributo.valoreAttributo == &quot;A&quot;){&#xD;
						compOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
					}&#xD;
					else {// Se arriva C (Delete) viene messo D&#xD;
						compOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	//Task #33217: SE NON TROVIAMO TIPOCOS va creata (Task #33853: STESSA COSA PER FAMIGLIAVLAN 2 o 3 -> ne creo due, quindi resa ciclica la creazione delle componenti)&#xD;
	if(!foundTIPOCOS)&#xD;
	{&#xD;
		//CREAZIONE COMPONENTE TIPOCOS &#xD;
		var data = DateTimeUtil.createDatetime();&#xD;
		var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
		componente.IDDettaglioOrdineParent = 1;&#xD;
		componente.IDDettaglioOrdineRoot =1;&#xD;
		componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componente.IDRisorsa= ConsistenzaRaccolta.IDRisorsa;&#xD;
		componente.IDRisorsaNOW = ConsistenzaRaccolta.IDRisorsaNOW;&#xD;
		componente.created = data;&#xD;
		componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
		componente.lastUpdate = data;&#xD;
		componente.operatore = &quot;BPM&quot;;&#xD;
		componente.progressivo = 1;&#xD;
		&#xD;
		//SM_9894&#xD;
		if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONEBANDA){&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
		}&#xD;
		else{&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
		}&#xD;
		componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS;&#xD;
&#xD;
		var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
		attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
		attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
		attributo.created = data;&#xD;
		attributo.lastUpdate = data;&#xD;
		attributo.operatore = &quot;BPM&quot;;&#xD;
		&#xD;
		for(var indice=0; indice&lt;TipoBandaAsset.size(); indice++)&#xD;
		{&#xD;
			var compTemp = ScriptUtil.copy(componente);&#xD;
			&#xD;
			if(TipoBandaAsset != null &amp;&amp; TipoBandaAsset.size()>0){&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDA;&#xD;
				attrTemp.valoreAttributo = TipoBandaAsset.get(indice);&#xD;
				attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				compTemp.attributiDettaglioOrdine.add(attrTemp);&#xD;
			}&#xD;
			&#xD;
			if(IdentificativoCOSAsset != null &amp;&amp; IdentificativoCOSAsset.size()>0){&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS;&#xD;
				attrTemp.valoreAttributo = IdentificativoCOSAsset.get(indice);&#xD;
				attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.NUMBER;&#xD;
				compTemp.attributiDettaglioOrdine.add(attrTemp);&#xD;
			}&#xD;
			&#xD;
			if(BandaAsset != null &amp;&amp; BandaAsset.size()>0){&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA;&#xD;
				attrTemp.valoreAttributo = BandaAsset.get(indice);&#xD;
				attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				compTemp.attributiDettaglioOrdine.add(attrTemp);&#xD;
			}&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(compTemp));&#xD;
		}&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
