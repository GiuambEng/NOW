        <xpdl2:Activity Id="_A51wsGArEeiiDp-z90jthw" Name="AggiornaDettaglioOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna Dettaglio Ordine" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//SET AZIONE - ARRICCHIMENTO&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
  	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
  	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DATIRICARICA)&#xD;
	{&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
&#xD;
		//RU_1531 - sovrascrivo/creo attributo NUMEROTELEFONICO&#xD;
		var foundNumeroTelefonico = false;&#xD;
&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO&#xD;
			   &amp;&amp; NumeroTelefonico != null &amp;&amp; NumeroTelefonico != &quot;&quot;)&#xD;
			{&#xD;
				attributo.valoreAttributo = NumeroTelefonico;&#xD;
				foundNumeroTelefonico = true;&#xD;
				Process.auditLog(&quot;Sovrascritto attributo NUMEROTELEFONICO &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
&#xD;
		if(!foundNumeroTelefonico &amp;&amp; NumeroTelefonico != null &amp;&amp; NumeroTelefonico != &quot;&quot;)&#xD;
		{&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = ora;&#xD;
			attributo.lastUpdate = ora;&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
			attributo.operatore = componente.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			attributo.valoreAttributo = NumeroTelefonico;&#xD;
			&#xD;
			componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			&#xD;
			Process.auditLog(&quot;Creato attributo NUMEROTELEFONICO &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
		}&#xD;
	}&#xD;
}  </xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_9t_7QULoEei-QJMtaSYnsg" Width="96.0">
              <xpdl2:Coordinates XCoordinate="1516.0" YCoordinate="100.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
