            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="118.0" LaneId="_ozwgwQAGEee456EGJ3IudA" Width="133.0">
              <xpdl2:Coordinates XCoordinate="3552.0" YCoordinate="903.0"/>
