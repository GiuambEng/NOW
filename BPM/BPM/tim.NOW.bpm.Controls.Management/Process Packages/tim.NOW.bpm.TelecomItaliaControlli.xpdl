        <xpdl2:Activity Id="_0KKuMJrCEe-8fre997-Uew" Name="ArricchimentoOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Ordine" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//RU_1502: Arricchimento attributo CARATTERISTICAVLAN della componente USERVLAN&#xD;
//Se in C04M01F36 per quella USERVLAN CARATTERISTICAVLAN = null oppure !(CARATTERISTICAVLAN == &quot;DRG OPZIONE ZERO&quot; e BMD = Y), ovvero una delle due non è verificata allora devo eliminare l'attributo se presente in consistenza&#xD;
//Se in C04M01F36 per quella USERVLAN CARATTERISTICAVLAN = &quot;DRG OPZIONE ZERO&quot; con BMD = Y e in consistenza non c'era prima, allora lo creo&#xD;
//Se in C04M01F36 per quella USERVLAN CARATTERISTICAVLAN = &quot;DRG OPZIONE ZERO&quot; con BMD = Y e in consistenza c'era già, allora non devo fare nulla (resta quello e lo metto nell'ordine)&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
   &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
       ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
	   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
	   || localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)			//RU_1555&#xD;
   &amp;&amp; (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC&#xD;
       ||localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
	   ||localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN))&#xD;
{&#xD;
	if(EsistenzaVLANOutputArricchimento!=null &amp;&amp; EsistenzaVLANOutputArricchimento.size()>0)&#xD;
	{&#xD;
		var foundCaratterizzazioneDRG = false;  //SM_11484&#xD;
		&#xD;
		for(var j=0; j&lt;EsistenzaVLANOutputArricchimento.size(); j++)&#xD;
		{&#xD;
			var currentEsistenzaVLAN = EsistenzaVLANOutputArricchimento.get(j);&#xD;
			Process.auditLog(&quot;Inizio variazione attributo CARATTERISTICAVLAN della componente USERVLAN con IDDettaglioOrdine &quot; +currentEsistenzaVLAN.IDDettaglioOrdine);&#xD;
			&#xD;
			//SM_11484 - mi serve per valorizzare il campo nell'ordine caratterizzazionAccesso&#xD;
			if(currentEsistenzaVLAN.CARATTERISTICAVLAN == &quot;DRG OPZIONE ZERO&quot;)&#xD;
			{&#xD;
				foundCaratterizzazioneDRG = true;&#xD;
			}&#xD;
			&#xD;
			for(var k=0; k&lt;localRequest.ordine.dettaglioordine.size(); k++)&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(k);&#xD;
				&#xD;
				//Individuo la USERVLAN corrispondente nell'ordine&#xD;
				if(currentEsistenzaVLAN.IDDettaglioOrdine == currentDettOrdine.IDDettaglioOrdine)&#xD;
				{											&#xD;
					var USERVLANIDordine = &quot;&quot;; USERVLANIDordine = null;&#xD;
					var USERVLANIDasset = &quot;&quot;; USERVLANIDasset = null;&#xD;
					var CARATTERISTICAVLANasset = &quot;&quot;; CARATTERISTICAVLANasset = null;&#xD;
					var trovataUSERVLANasset = false;&#xD;
							&#xD;
					for(var z=0; z&lt;currentDettOrdine.attributiDettaglioOrdine.size(); z++)&#xD;
					{&#xD;
						var currentAttributoDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
						&#xD;
						if(currentAttributoDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
						{&#xD;
							USERVLANIDordine = currentAttributoDettOrdine.valoreAttributo;&#xD;
							Process.auditLog(&quot;Ciclo su USERVLAN dell'ordine con USERVLANID: &quot; +USERVLANIDordine);&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					if(Asset != null)&#xD;
					{	&#xD;
						for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
						{&#xD;
							var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
							&#xD;
							if(currentDettAsset.statoDettaglioAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO)&#xD;
							{&#xD;
								for(var x=0; x&lt;currentDettAsset.attributidettaglioasset.size(); x++)&#xD;
								{&#xD;
									var currentAttributoDettAsset = currentDettAsset.attributidettaglioasset.get(x);&#xD;
									&#xD;
									if(currentAttributoDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
									{&#xD;
										USERVLANIDasset = currentAttributoDettAsset.valoreAttributo;&#xD;
										Process.auditLog(&quot;Ciclo su USERVLAN dell'asset con USERVLANID: &quot; +USERVLANIDasset);&#xD;
									}&#xD;
									else if(currentAttributoDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVLAN)&#xD;
									{&#xD;
										CARATTERISTICAVLANasset = currentAttributoDettAsset.valoreAttributo;&#xD;
										Process.auditLog(&quot;Ciclo su USERVLAN dell'asset con CARATTERISTICAVLAN: &quot; +CARATTERISTICAVLANasset);&#xD;
									}&#xD;
								}&#xD;
								&#xD;
								//Individuo la USERVLAN corrispondente nell'asset&#xD;
								if(USERVLANIDasset == USERVLANIDordine)&#xD;
								{&#xD;
									trovataUSERVLANasset = true;&#xD;
									&#xD;
									//Caso di caratterizzazione DRG OPZIONE ZERO&#xD;
									if(currentEsistenzaVLAN.CARATTERISTICAVLAN == &quot;DRG OPZIONE ZERO&quot; &amp;&amp; currentEsistenzaVLAN.BMD == &quot;Y&quot;)&#xD;
									{&#xD;
										//Asset già caratterizzato -> salvo comunque il valore nell'ordine per non sbiancarlo&#xD;
										//Asset non caratterizzato -> lo caratterizzo										&#xD;
										var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
										nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
										nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
										nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
										nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
										nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVLAN;&#xD;
										nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
										nuovoAttributo.valoreAttributo = currentEsistenzaVLAN.CARATTERISTICAVLAN;&#xD;
										nuovoAttributo.operatore = localRequest.operatore;&#xD;
										currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));									&#xD;
										Process.auditLog(&quot;Aggiungo attributo CARATTERISTICAVLAN con DRG OPZIONE ZERO sulla componente con IDDettaglioOrdine: &quot; +currentDettOrdine.IDDettaglioOrdine);									&#xD;
									}&#xD;
									//Se una delle due condizioni sopra non è soddisfatta non siamo in caratterizzazione DRG OPZIONE ZERO&#xD;
									else&#xD;
									{&#xD;
										//Asset già caratterizzato -> elimino l'attributo&#xD;
										if(CARATTERISTICAVLANasset == &quot;DRG OPZIONE ZERO&quot;)&#xD;
										{											&#xD;
											var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
											nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
											nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
											nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
											nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
											nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVLAN;&#xD;
											nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
											nuovoAttributo.valoreAttributo = &quot;ATTRIBUTO IN ELIMINAZIONE&quot;;&#xD;
											nuovoAttributo.valoreAttributoOLD = CARATTERISTICAVLANasset;&#xD;
											nuovoAttributo.operatore = localRequest.operatore;&#xD;
											currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));										&#xD;
											Process.auditLog(&quot;Attributo CARATTERISTICAVLAN va eliminato sulla componente con IDDettaglioOrdine: &quot; +currentDettOrdine.IDDettaglioOrdine);&#xD;
										}&#xD;
										else //Asset non caratterizzato (o c'è DRG OPZIONE ZERO o null) -> non faccio nulla&#xD;
										{&#xD;
											Process.auditLog(&quot;L'asset NON è caratterizzato con DRG OPZIONE ZERO&quot;);&#xD;
										}&#xD;
									}&#xD;
								}&#xD;
							}&#xD;
						}		&#xD;
					}&#xD;
&#xD;
					//Se non c'è proprio la USERVLAN in asset perchè la stiamo aggiungendo con la richiesta (incremento) e siamo in caratterizzazion DRG, allora creiamo l'attributo&#xD;
					if(!trovataUSERVLANasset&#xD;
					   &amp;&amp; currentEsistenzaVLAN.CARATTERISTICAVLAN == &quot;DRG OPZIONE ZERO&quot; &amp;&amp; currentEsistenzaVLAN.BMD == &quot;Y&quot;)&#xD;
					{&#xD;
						var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
						nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVLAN;&#xD;
						nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						nuovoAttributo.valoreAttributo = currentEsistenzaVLAN.CARATTERISTICAVLAN;&#xD;
						nuovoAttributo.operatore = localRequest.operatore;&#xD;
						currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
						Process.auditLog(&quot;Aggiungo attributo CARATTERISTICAVLAN con DRG OPZIONE ZERO sulla componente con IDDettaglioOrdine: &quot; +currentDettOrdine.IDDettaglioOrdine);&#xD;
					}&#xD;
				}&#xD;
			}	&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//Campo in chiaro CARATTERIZZAZIONEACCESSO nell'ordine - SM_11484&#xD;
	//Va sbiancato se stiamo passando ad una caratterizzazione NON DRG&#xD;
	if(!foundCaratterizzazioneDRG)&#xD;
	{&#xD;
	   localRequest.ordine.caratterizzazioneAccesso = null;&#xD;
	}&#xD;
	//Va valorizzato se stiamo passando ad una caratterizzazione DRG&#xD;
	else&#xD;
	{&#xD;
		localRequest.ordine.caratterizzazioneAccesso = &quot;DRG OPZIONE ZERO&quot;;&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
//RU_1558: ARRICCHIMENTO ORDINE &#xD;
if(LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.modelServPerValidazioni != null)&#xD;
{&#xD;
	localRequest.ordine.modelServPerValidazioni = LavorazioneRichiesta.modelServPerValidazioni;&#xD;
}&#xD;
//SM_11801&#xD;
if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.modelloServizioPerValidazioni != null)&#xD;
{&#xD;
	localRequest.ordine.modelServPerValidOld = ConsistenzaDati.modelloServizioPerValidazioni;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
