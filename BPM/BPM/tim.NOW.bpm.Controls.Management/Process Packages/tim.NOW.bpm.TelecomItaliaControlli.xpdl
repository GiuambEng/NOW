			}&#xD;
			//SM_10239&#xD;
			if(!foundIPMULTICAST &amp;&amp; ConsistenzaCanale != null &amp;&amp; ConsistenzaCanale.IPMulticast != null&#xD;
			   &amp;&amp; (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CANALEESISTENTEFEEDER&#xD;
