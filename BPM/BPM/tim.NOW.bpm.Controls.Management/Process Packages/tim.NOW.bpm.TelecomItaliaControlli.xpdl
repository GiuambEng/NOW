        <xpdl2:Activity Id="_yS41cuAlEeeAvej_yWbZRA" Name="LinkToScarto12" xpdExt:Visibility="Private" xpdExt:DisplayName="Link To: Scarto 12">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Trigger="Link">
              <xpdl2:TriggerResultLink CatchThrow="THROW" Name="_7NayYuAjEeeAvej_yWbZRA"/>
            </xpdl2:IntermediateEvent>
