			if(InventoryResponse != null &amp;&amp; InventoryResponse.CRMWSResponse != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea.principale != null)&#xD;
			{&#xD;
				if(foundNUMEROTELEFONICOPRINCIPALE)&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexNUMEROTELEFONICOPRINCIPALE).valoreAttributo = InventoryResponse.CRMWSResponse.tipo_Linea.principale;&#xD;
