        <xpdl2:Activity Id="_kFdWELrTEeqyvPkdQ7jobw" Name="ArricchimentoOrdineNew" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Ordine New">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;Inizio Arricchimento Ordine&quot;); //Debug&#xD;
&#xD;
if(localRequest!= null &amp;&amp; localRequest.ordine!=null)&#xD;
{&#xD;
	//Aggiungi Azione ad A per NUMBERPORTABILITY presenti nell'ordine&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		Process.auditLog(&quot;Valorizzazione Azione componente &quot;+componente.IDDettaglioOrdine); //Debug&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY) &#xD;
		{&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
		} &#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot;+ componente.nomeComponente);&#xD;
		}	&#xD;
	}&#xD;
&#xD;
	//Arricchimento di NUMBERPORTABILITY con azione ad A&#xD;
	for(var i2=0; i2&lt;localRequest.ordine.dettaglioordine.size(); i2++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i2);&#xD;
		&#xD;
		Process.auditLog(&quot;Arricchimento Componente &quot;+componente.IDDettaglioOrdine); //Debug&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			var NumeroTelefonicoOrdine = &quot;&quot;;&#xD;
			var NumeroTelefonicoAsset = &quot;&quot;;&#xD;
			var TIPOLINEANP = &quot;&quot;;&#xD;
			var TIPOSERVIZIO = &quot;&quot;;&#xD;
			var RADICALE = &quot;&quot;;&#xD;
			var CAPOSERIE = &quot;&quot;;&#xD;
			var CODICERO = &quot;&quot;;&#xD;
			var CODICEOPERATOREDONATING = &quot;&quot;;&#xD;
			var IDASSET = &quot;&quot;;&#xD;
			var DISTRETTO = &quot;&quot;;&#xD;
			var TIPONUMERO = &quot;&quot;;   &#xD;
			&#xD;
			NumeroTelefonicoOrdine = null;&#xD;
			NumeroTelefonicoAsset = null;&#xD;
			TIPOLINEANP = null;&#xD;
			TIPOSERVIZIO = null;&#xD;
			RADICALE = null;&#xD;
			CAPOSERIE = null;&#xD;
			CODICERO = null;&#xD;
			CODICEOPERATOREDONATING = null;&#xD;
			IDASSET = null;&#xD;
			DISTRETTO = null;&#xD;
			TIPONUMERO = null;    &#xD;
			&#xD;
			var foundTIPOLINEANP = false;&#xD;
			var foundTIPONUMERO = false;&#xD;
			var foundTIPOSERVIZIO = false;&#xD;
			var foundRADICALE = false;&#xD;
			var foundCAPOSERIE = false;&#xD;
			var foundCODICERO = false;&#xD;
			var foundCODICEOPERATOREDONATING = false;&#xD;
			&#xD;
			&#xD;
			//RECUPERO NUMEROTELEFONICO DELLA NUMBERPORTABILITY DALL'ORDINE&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					NumeroTelefonicoOrdine = attributo.valoreAttributo; &#xD;
					Process.auditLog(&quot;NP dell'ordine in arricchimento: &quot;+NumeroTelefonicoOrdine); //Debug&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//RU_1030: recupero il valore di TIPONUMERO da ARRAYINVENTORYOUTPUT, in particolare da DATIUNICA&#xD;
			if(ArrayInventoryOutput != null &amp;&amp; ArrayInventoryOutput.size() > 0)&#xD;
			{&#xD;
				for (var m=0; m&lt;ArrayInventoryOutput.size(); m++)&#xD;
				{&#xD;
					var currentInventoryOutput = ArrayInventoryOutput.get(m);&#xD;
					&#xD;
					if(currentInventoryOutput.datiUnica != null &amp;&amp; currentInventoryOutput.datiUnica.tipoNumero != null&#xD;
					   &amp;&amp; currentInventoryOutput.numero_Telefonico != null &amp;&amp; NumeroTelefonicoOrdine == currentInventoryOutput.numero_Telefonico)&#xD;
					{&#xD;
						TIPONUMERO = currentInventoryOutput.datiUnica.tipoNumero;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			&#xD;
			//RECUPERO I VALORI DA CONSISTENZA/ASSET PER ARRICCHIMENTO &#xD;
			if(AssetTarget != null &amp;&amp; AssetTarget.size() > 0)&#xD;
			{&#xD;
				for(var j2=0; j2&lt;AssetTarget.size(); j2++)&#xD;
				{&#xD;
					var currentAsset = AssetTarget.get(j2);&#xD;
					Process.auditLog(&quot;Asset Target su cui si sta ciclando: &quot;+AssetTarget.get(j2).IDAsset); //Debug&#xD;
					&#xD;
					if(NumeroTelefonicoOrdine == currentAsset.numeroTelefonico)&#xD;
					{&#xD;
						Process.auditLog(&quot;Trovato Asset con Numero Telefonico: &quot;+NumeroTelefonicoOrdine); //Debug&#xD;
						&#xD;
						CODICEOPERATOREDONATING = currentAsset.codificaOLOAGCOM;  //SM_9419&#xD;
						&#xD;
						for(var k=0; k&lt;currentAsset.dettaglioasset.size(); k++)&#xD;
						{&#xD;
							var componenteAsset = currentAsset.dettaglioasset.get(k);&#xD;
							&#xD;
							if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
							{&#xD;
								for(var h=0; h&lt;componenteAsset.attributidettaglioasset.size(); h++)&#xD;
								{&#xD;
									var attributoAsset = componenteAsset.attributidettaglioasset.get(h);&#xD;
									&#xD;
									if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP)&#xD;
									{&#xD;
										TIPOLINEANP = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO)&#xD;
									{&#xD;
										TIPOSERVIZIO = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
									{&#xD;
										RADICALE = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE)&#xD;
									{&#xD;
										CAPOSERIE = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICERO)&#xD;
									{&#xD;
										CODICERO = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO)&#xD;
									{&#xD;
										DISTRETTO = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
								}	&#xD;
							}&#xD;
						}					&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
				&#xD;
			//Arricchimento di NUMBERPORTABILITY con azione ad A&#xD;
			for(var j3=0; j3&lt;componente.attributiDettaglioOrdine.size(); j3++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j3);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP&#xD;
				   &amp;&amp; TIPOLINEANP != null)&#xD;
				{	&#xD;
					attributo.valoreAttributo = TIPOLINEANP;&#xD;
					foundTIPOLINEANP = true;&#xD;
					&#xD;
					Process.auditLog(&quot;Trovato TIPOLINEANP nell'ordine&quot; + attributo.valoreAttributo);&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO&#xD;
				       &amp;&amp; TIPONUMERO != null)&#xD;
				{	&#xD;
					attributo.valoreAttributo = TIPONUMERO;&#xD;
					foundTIPONUMERO = true;&#xD;
					&#xD;
					Process.auditLog(&quot;Trovato TIPONUMERO nell'ordine&quot; + attributo.valoreAttributo);&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO&#xD;
					   &amp;&amp; TIPOSERVIZIO != null)&#xD;
				{&#xD;
					attributo.valoreAttributo = TIPOSERVIZIO;&#xD;
					foundTIPOSERVIZIO = true;&#xD;
					&#xD;
					Process.auditLog(&quot;Trovato TIPOSERVIZIO nell'ordine&quot; + attributo.valoreAttributo);&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE&#xD;
					   &amp;&amp; RADICALE != null)&#xD;
				{	&#xD;
					attributo.valoreAttributo = RADICALE;&#xD;
					foundRADICALE = true;&#xD;
					&#xD;
					Process.auditLog(&quot;Trovato RADICALE nell'ordine&quot; + attributo.valoreAttributo);&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE&#xD;
					   &amp;&amp; CAPOSERIE != null)&#xD;
				{&#xD;
					attributo.valoreAttributo = CAPOSERIE;&#xD;
					foundCAPOSERIE = true;&#xD;
					&#xD;
					Process.auditLog(&quot;Trovato CAPOSERIE nell'ordine&quot; + attributo.valoreAttributo);&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICERO&#xD;
					   &amp;&amp; CODICERO != null)&#xD;
				{&#xD;
					attributo.valoreAttributo = CODICERO;&#xD;
					foundCODICERO = true;&#xD;
					&#xD;
					Process.auditLog(&quot;Trovato CODICERO nell'ordine&quot; + attributo.valoreAttributo);&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING&#xD;
					   &amp;&amp; CODICEOPERATOREDONATING != null)&#xD;
				{&#xD;
					attributo.valoreAttributo = CODICEOPERATOREDONATING;&#xD;
					foundCODICEOPERATOREDONATING = true;&#xD;
					&#xD;
					Process.auditLog(&quot;Trovato CODICEOPERATOREDONATING nell'ordine&quot; + attributo.valoreAttributo);&#xD;
				}&#xD;
			}&#xD;
&#xD;
			if(!foundTIPOLINEANP &amp;&amp; TIPOLINEANP != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate =ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = TIPOLINEANP;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Aggiunto TIPOLINEANP nell'ordine&quot; + attributo.valoreAttributo);&#xD;
			}&#xD;
			&#xD;
			if(!foundTIPONUMERO &amp;&amp; TIPONUMERO != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate =ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = TIPONUMERO;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Aggiunto TIPONUMERO nell'ordine&quot; + attributo.valoreAttributo);&#xD;
			}&#xD;
			&#xD;
			if(!foundTIPOSERVIZIO &amp;&amp; TIPOSERVIZIO != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate =ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = TIPOSERVIZIO;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Aggiunto TIPOSERVIZIO nell'ordine&quot; + attributo.valoreAttributo);&#xD;
			}&#xD;
			&#xD;
			if(!foundRADICALE &amp;&amp; RADICALE != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate =ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = RADICALE;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Aggiunto RADICALE nell'ordine&quot; + attributo.valoreAttributo);&#xD;
			}&#xD;
			&#xD;
			if(!foundCAPOSERIE &amp;&amp; CAPOSERIE != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate =ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = CAPOSERIE;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Aggiunto CAPOSERIE nell'ordine&quot; + attributo.valoreAttributo);&#xD;
			}&#xD;
			&#xD;
			if(!foundCODICERO &amp;&amp; CODICERO != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate =ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICERO;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = CODICERO;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Aggiunto CODICERO nell'ordine&quot; + attributo.valoreAttributo);&#xD;
			}&#xD;
			&#xD;
			if(!foundCODICEOPERATOREDONATING &amp;&amp; CODICEOPERATOREDONATING != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate =ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = CODICEOPERATOREDONATING;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Aggiunto CODICEOPERATOREDONATING nell'ordine&quot; + attributo.valoreAttributo);&#xD;
			}&#xD;
			&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//Creazione e arricchimento di NUMBERPORTABILITY con azione a D&#xD;
	if(NumberPortability != null &amp;&amp; NumberPortability.size() > 0)&#xD;
	{&#xD;
		Process.auditLog(&quot;Creazione componenti NUMBERPORTABILITY con azione a D&quot;); // DEBUG&#xD;
		&#xD;
		for(var z=0; z&lt;NumberPortability.size(); z++)&#xD;
		{	&#xD;
			var currentNP = NumberPortability.get(z);&#xD;
	&#xD;
			Process.auditLog(&quot;Ciclo su componente NP con numero &quot; + currentNP.numeroTelefonico); // DEBUG&#xD;
	&#xD;
			var RADICALE = &quot;&quot;;&#xD;
			var CAPOSERIE = &quot;&quot;;&#xD;
			var DISTRETTO = &quot;&quot;;&#xD;
			&#xD;
			RADICALE = null;&#xD;
			CAPOSERIE = null;&#xD;
			DISTRETTO = null;&#xD;
	&#xD;
			//RECUPERO I VALORI DA CONSISTENZA/ASSET PER ARRICCHIMENTO &#xD;
			if(AssetTarget != null &amp;&amp; AssetTarget.size() > 0)&#xD;
			{&#xD;
				for(var j2=0; j2&lt;AssetTarget.size(); j2++)&#xD;
				{&#xD;
					var currentAsset = AssetTarget.get(j2);&#xD;
					Process.auditLog(&quot;Asset Target su cui si sta ciclando: &quot;+AssetTarget.get(j2).IDAsset); //Debug&#xD;
					&#xD;
					if(currentNP.numeroTelefonico == currentAsset.numeroTelefonico)&#xD;
					{&#xD;
						Process.auditLog(&quot;Trovato Asset con Numero Telefonico: &quot;+NumeroTelefonicoOrdine); //Debug&#xD;
						&#xD;
						for(var k=0; k&lt;currentAsset.dettaglioasset.size(); k++)&#xD;
						{&#xD;
							var componenteAsset = currentAsset.dettaglioasset.get(k);&#xD;
							&#xD;
							if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
							{&#xD;
								for(var h=0; h&lt;componenteAsset.attributidettaglioasset.size(); h++)&#xD;
								{&#xD;
									var attributoAsset = componenteAsset.attributidettaglioasset.get(h);&#xD;
									&#xD;
									if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
									{&#xD;
										RADICALE = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE)&#xD;
									{&#xD;
										CAPOSERIE = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO)&#xD;
									{&#xD;
										DISTRETTO = attributoAsset.valoreAttributo;&#xD;
									}&#xD;
								}	&#xD;
							}&#xD;
						}					&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
	&#xD;
&#xD;
			var data = DateTimeUtil.createDatetime();&#xD;
			var dettaglio = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			dettaglio.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
			dettaglio.IDDettaglioOrdineParent = 1;&#xD;
			dettaglio.IDDettaglioOrdineRoot = 1;&#xD;
			dettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			dettaglio.IDRisorsa = localRequest.IDRisorsa;&#xD;
			dettaglio.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
			dettaglio.created = data;&#xD;
			dettaglio.integrationID = localRequest.IDRichiestaOLO + localRequest.ordine.dettaglioordine.size();&#xD;
			dettaglio.lastUpdate = data;&#xD;
			dettaglio.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY;&#xD;
			dettaglio.operatore = localRequest.operatore;&#xD;
			dettaglio.progressivo = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
			dettaglio.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
			&#xD;
			//SM_9419&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = dettaglio.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = dettaglio.IDRichiestaOLO;&#xD;
			attributo.created = data;&#xD;
			attributo.lastUpdate = data;&#xD;
			attributo.operatore = dettaglio.operatore;&#xD;
			&#xD;
			//NUMEROTELEFONICO&#xD;
			if(currentNP.numeroTelefonico != null &amp;&amp; currentNP.numeroTelefonico != &quot;&quot;)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = currentNP.numeroTelefonico;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
			//DISTRETTO&#xD;
			if(DISTRETTO != null &amp;&amp; DISTRETTO != &quot;&quot;)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = DISTRETTO;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
			//NUMEROTELEFONICOPRINCIPALE&#xD;
			if(currentNP.numeroTelefonicoPrincipale != null &amp;&amp; currentNP.numeroTelefonicoPrincipale != &quot;&quot;)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = currentNP.numeroTelefonicoPrincipale;;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		&#xD;
			//IDENTIFICATIVOASSET&#xD;
			if(currentNP.IDAsset != null &amp;&amp; currentNP.IDAsset != &quot;&quot;)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = currentNP.IDAsset;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
			//INVIOADTU&#xD;
			if(currentNP.invioaDTU != null &amp;&amp; currentNP.invioaDTU != &quot;&quot;)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = currentNP.invioaDTU;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
			//TIPOSERVIZIO&#xD;
			if(currentNP.tipoServizio != null &amp;&amp; currentNP.tipoServizio != &quot;&quot;)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = currentNP.tipoServizio;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
			//TIPONUMERO&#xD;
			if(currentNP.tipoNumero != null &amp;&amp; currentNP.tipoNumero != &quot;&quot;)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = currentNP.tipoNumero;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
			//RADICALE&#xD;
			if(RADICALE != null &amp;&amp; RADICALE != &quot;&quot;)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = RADICALE;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
			//CAPOSERIE&#xD;
			if(CAPOSERIE != null &amp;&amp; CAPOSERIE != &quot;&quot;)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = CAPOSERIE;	&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
			//CODICEOPERATOREDONATING&#xD;
			if(currentNP.codiceOperatoreDonating != null &amp;&amp; currentNP.codiceOperatoreDonating != &quot;&quot;)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = currentNP.codiceOperatoreDonating;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
			//CODICEOPERATOREDONOR&#xD;
			if(currentNP.codiceOperatoreDonor != null &amp;&amp; currentNP.codiceOperatoreDonor != &quot;&quot;)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = currentNP.codiceOperatoreDonor;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
			//ASSETBTWHITELIST //R1E-21-0325&#xD;
			if(currentNP.assetBTWhiteList != null &amp;&amp; currentNP.assetBTWhiteList != &quot;&quot;)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.WHITELIST;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = currentNP.assetBTWhiteList;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettaglio));&#xD;
			&#xD;
			Process.auditLog(&quot;Aggiunta NumberPortability all'ordine &quot;+currentNP.numeroTelefonico); // DEBUG&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Impossibile completare la funzione di arricchimento: Ordine o DettagliOrdine inesistenti&quot;);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
