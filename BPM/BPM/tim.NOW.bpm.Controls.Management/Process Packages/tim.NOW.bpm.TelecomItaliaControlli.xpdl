        <xpdl2:Activity Id="_04QkwFeQEei-kYa-z1WVIA" Name="CallEnrichmentPCR_MCREASYIPXDSL" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Call EnrichmentPCR_MCR EASYIP XDSL">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_BYOMwFeOEei-kYa-z1WVIA" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
              <xpdExt:InputMappings MapperContext="ProcessToSubProcess" MappingDirection="IN">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="IDRichiestaOLO">
                    <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="Offerta">
                    <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.offerta</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="TipologiaProfilo">
                    <xpdExt:ScriptInformation Id="_M9nbMFeREei-kYa-z1WVIA" Name="ABR">
                      <xpdExt:Expression ScriptGrammar="JavaScript">var Tipologiaprofilo = 'ABR';&#xD;
return Tipologiaprofilo;</xpdExt:Expression>
                    </xpdExt:ScriptInformation>
                    <xpdl2:Actual ScriptGrammar="JavaScript">__SCRIPT__</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="ProfiloTecnicoLinea">
                    <xpdExt:ScriptInformation Id="_qd5CMFeREei-kYa-z1WVIA" Name="ProfiloTecnicoLinea">
                      <xpdExt:Expression ScriptGrammar="JavaScript">var ProfiloTecnicoLinea = &quot;&quot;;&#xD;
ProfiloTecnicoLinea = null;&#xD;
&#xD;
var i=0;&#xD;
while (ProfiloTecnicoLinea== null &amp;&amp; i&lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
&#xD;
	var currentDettaglio = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if (String(currentDettaglio.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j=0;&#xD;
		 while (ProfiloTecnicoLinea == null &amp;&amp; j&lt; currentDettaglio.attributiDettaglioOrdine.size())&#xD;
		 {&#xD;
		 	var currentAttributo = currentDettaglio.attributiDettaglioOrdine.get(j);&#xD;
		 	if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
		 	{&#xD;
		 		ProfiloTecnicoLinea = currentAttributo.valoreAttributo;&#xD;
		 		&#xD;
		 	}&#xD;
		 j++;&#xD;
		 }&#xD;
	&#xD;
	}&#xD;
i++;&#xD;
}&#xD;
&#xD;
return ProfiloTecnicoLinea;</xpdExt:Expression>
                    </xpdExt:ScriptInformation>
                    <xpdl2:Actual ScriptGrammar="JavaScript">__SCRIPT__</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:InputMappings>
              <xpdExt:OutputMappings MapperContext="SubProcessToProcess" MappingDirection="OUT">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="SubProcessToProcess.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="EnrichmentPCRMCR">
                    <xpdl2:Actual ScriptGrammar="JavaScript">EnrichmentBande_ResponseType</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:OutputMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="72.0" LaneId="_ozwgwQAGEee456EGJ3IudA" Width="141.0">
