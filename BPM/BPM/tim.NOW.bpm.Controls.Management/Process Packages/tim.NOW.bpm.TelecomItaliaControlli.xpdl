				Process.auditLog(&quot;Creato attributo CODICEMACROAREA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}			&#xD;
			if(!foundNOMEMACROAREA &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.nomeMacroArea != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.nomeMacroArea;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo NOMEMACROAREA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}			&#xD;
