        <xpdl2:Activity Id="_jZA10BvQEe6rOZaeNaeBJQ" Name="CTRLESISTIMPRSEMIGPONDELIVERYSTANDARD_C04M01F497" xpdExt:Visibility="Private" xpdExt:DisplayName="CTRL ESIST IMPR SEMIGPON DELIVERY STANDARD_C04M01F497">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_5a5UwBp0Ee6hqewwkIYA9Q" PackageRef="tim.NOW.bpm.ProcesService.Interfaces" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
              <xpdExt:InputMappings MapperContext="ProcessToSubProcess" MappingDirection="IN">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="LavorazioneRichiesta">
                    <xpdl2:Actual ScriptGrammar="JavaScript">LavorazioneRichiesta</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="localRequest">
                    <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:InputMappings>
