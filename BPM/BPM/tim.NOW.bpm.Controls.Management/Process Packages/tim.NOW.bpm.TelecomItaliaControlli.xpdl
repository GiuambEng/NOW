        <xpdl2:Activity Id="_ePrSUN1QEe6bX58n68cYEA" Name="ArricchimentoOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var foundIdRisorsa = false;&#xD;
var foundProfiloTecnicoLinea = false;&#xD;
var foundAccesso = false;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			foundAccesso = true;&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA&#xD;
				   &amp;&amp; localRequest.IDRisorsa != null)&#xD;
				{&#xD;
					foundIdRisorsa = true;&#xD;
					attr.valoreAttributo = localRequest.IDRisorsa;&#xD;
					Process.auditLog(&quot;Aggiornato attributo IDRisorsa con valore: &quot;+ localRequest.IDRisorsa);&#xD;
				}&#xD;
				//PROFILOTECNICOLINEA&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA &#xD;
						&amp;&amp; ConsistenzaDati.profiloTecnicoLinea != null)&#xD;
				{&#xD;
					foundProfiloTecnicoLinea = true;&#xD;
					attr.valoreAttributo = ConsistenzaDati.profiloTecnicoLinea;&#xD;
					Process.auditLog(&quot;Aggiornato attributo ProfiloTecnicoLinea con valore: &quot;+ ConsistenzaDati.profiloTecnicoLinea);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	if(!foundAccesso)&#xD;
	{&#xD;
		var data = DateTimeUtil.createDatetime();&#xD;
		var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		&#xD;
		componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
		componente.IDDettaglioOrdineParent = 1;&#xD;
		componente.IDDettaglioOrdineRoot = 1;&#xD;
		componente.IDRisorsa = localRequest.IDRisorsa;&#xD;
		componente.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
		componente.operatore = &quot;BPM&quot;;&#xD;
		componente.progressivo = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
		componente.created = data;&#xD;
		componente.integrationID = localRequest.IDRichiestaOLO + localRequest.ordine.dettaglioordine.size() + 1;&#xD;
		componente.lastUpdate = data;&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOFIBERSTREAM;&#xD;
	}&#xD;
	&#xD;
	if(!foundIdRisorsa &amp;&amp; localRequest != null &amp;&amp; localRequest.IDRisorsa != null)&#xD;
	{&#xD;
		var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
		&#xD;
		attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
		attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
		attributo.created = data;&#xD;
		attributo.lastUpdate = data;&#xD;
		attributo.operatore = &quot;BPM&quot;;&#xD;
		attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
		attributo.valoreAttributo = localRequest.IDRisorsa;&#xD;
		attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
	}&#xD;
	&#xD;
	//PROFILOTECNICOLINEA&#xD;
	if(!foundProfiloTecnicoLinea &amp;&amp; ConsistenzaDati != null &amp;&amp; ConsistenzaDati.profiloTecnicoLinea != null)&#xD;
	{&#xD;
		var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
		&#xD;
		attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
		attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
		attributo.created = data;&#xD;
		attributo.lastUpdate = data;&#xD;
		attributo.operatore = &quot;BPM&quot;;&#xD;
		attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA;&#xD;
		attributo.valoreAttributo = ConsistenzaDati.profiloTecnicoLinea;&#xD;
		attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
	}&#xD;
			&#xD;
	//Se non ha trovato la componente ACCESSO, allora va aggiunta quella che abbiamo creato&#xD;
	if(!foundAccesso)&#xD;
	{&#xD;
		localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
	}&#xD;
		&#xD;
	//C01M02F12 Recupero DISTRETTO/IDCONTRATTO/CLIENTE/NUMEROFITTIZIO DA ASSET - SM_11292&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		var asset = AssetRef.readAsset();&#xD;
		if (asset.distretto != null &amp;&amp; asset.distretto.length > 0)&#xD;
		{&#xD;
			localRequest.ordine.distretto = asset.distretto;&#xD;
		}&#xD;
		if (asset.IDContratto != null)&#xD;
		{&#xD;
			localRequest.IDContratto = asset.IDContratto;&#xD;
		}&#xD;
		if (asset.numeroFittizio != null &amp;&amp; asset.numeroFittizio.length > 0)&#xD;
		{&#xD;
			localRequest.ordine.numeroFittizio = asset.numeroFittizio;&#xD;
		}		&#xD;
		if(asset.numeroTelefonico != null)&#xD;
		{&#xD;
			localRequest.ordine.numeroTelefonico = asset.numeroTelefonico;&#xD;
		}&#xD;
		&#xD;
		if(asset.cliente != null 									&#xD;
			&amp;&amp; localRequest.ordine.nome == null &#xD;
			&amp;&amp; localRequest.ordine.cognomeRagioneSociale == null &#xD;
			&amp;&amp; localRequest.ordine.CF == null&#xD;
			&amp;&amp; localRequest.ordine.PIVA == null)&#xD;
		{&#xD;
			if (asset.cliente.nome != null &amp;&amp; (localRequest.ordine.nome == null || localRequest.ordine.nome == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.nome = asset.cliente.nome;&#xD;
			}		&#xD;
			if (asset.cliente.cognomeRagioneSociale != null &amp;&amp; (localRequest.ordine.cognomeRagioneSociale == null || localRequest.ordine.cognomeRagioneSociale == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.cognomeRagioneSociale = asset.cliente.cognomeRagioneSociale;&#xD;
			}&#xD;
			&#xD;
			//CF e PIVA sono mutuamente esclusivi e non vanno arricchiti se uno dei due è indicato in input dall'OLO&#xD;
			if(localRequest.ordine.CF == null &amp;&amp; localRequest.ordine.PIVA == null)&#xD;
			{				&#xD;
				localRequest.ordine.CF = Asset.cliente.codiceFiscale;&#xD;
				localRequest.ordine.PIVA = Asset.cliente.partitaIVA;			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
