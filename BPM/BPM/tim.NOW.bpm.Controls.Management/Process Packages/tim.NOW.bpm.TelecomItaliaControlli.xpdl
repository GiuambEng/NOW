            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier=&quot;/tim.NOW.bpm.Controls/Process Packages/tim.NOW.bpm.Controls_2.xpdl.CTRLCONTRATTOCOMUNESEMIVULAMIGRDEL82_C04M01F558&quot;;</xpdExt:Information>
