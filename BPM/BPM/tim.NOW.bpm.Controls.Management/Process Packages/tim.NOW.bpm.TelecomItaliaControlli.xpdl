        <xpdl2:Activity Id="_6Sob4uIwEeqeRbNUQWBXYw" Name="ArricchimentoDettaglioOrdineVLANNGA" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Dettaglio Ordine VLAN NGA">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	//CONFIGURAZIONE AZIONE&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVLANNGA&#xD;
		   || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
		{&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;   &#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
&#xD;
	//ARRICCHIMENTO&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		//Componente RACCOLTAVLANNGA&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVLANNGA)&#xD;
		{&#xD;
			var FAMIGLIAVLAN = &quot;&quot;;&#xD;
			FAMIGLIAVLAN = null;&#xD;
			&#xD;
			var foundTIPOLOGIAVLAN = false;&#xD;
			var foundTRASPORTO = false;&#xD;
			var foundMODELLOVLAN = false;&#xD;
			var foundIDKITAREACAR = false;&#xD;
			var foundCODICEAREARACCOLTA = false;&#xD;
			var foundNOMEAREARACCOLTA = false;&#xD;
			var foundPUNTOCONSEGNA = false;&#xD;
			var foundIDBRE = false;&#xD;
			var foundNOMECLLI = false;&#xD;
			var foundCODICEMACROAREA = false;&#xD;
			var foundNOMEMACROAREA = false;&#xD;
			var foundTIPOOFFERTA = false;&#xD;
			var foundIDADRCRMWS = false;&#xD;
			var foundIDMADRCRMWS = false;&#xD;
			&#xD;
			//RU_1099&#xD;
			var foundIDMADRCRMWSCOMM = false;&#xD;
			var foundCODICEMACROAREACOMM = false;&#xD;
			var foundNOMEMACROAREACOMM = false;&#xD;
			var foundCARATTERISTICAVLAN = false; &#xD;
			&#xD;
			//Arricchimento attributi se presenti nell'ordine&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
				{&#xD;
					//Mi serve per l'arricchimento di FTTHONLY e TIPOLOGIACLUSTERVLAN&#xD;
					FAMIGLIAVLAN = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo FAMIGLIAVLAN&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIAVLAN)&#xD;
				{&#xD;
					foundTIPOLOGIAVLAN = true;&#xD;
					attributo.valoreAttributo = &quot;NGA&quot;;&#xD;
					Process.auditLog(&quot;Trovato attributo TIPOLOGIAVLAN&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TRASPORTO&#xD;
				   &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.trasporto != null)&#xD;
				{&#xD;
					foundTRASPORTO = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.trasporto;&#xD;
					Process.auditLog(&quot;Trovato attributo TRASPORTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MODELLOVLAN&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.modelloVlan != null)&#xD;
				{&#xD;
					foundMODELLOVLAN = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.modelloVlan;&#xD;
					Process.auditLog(&quot;Trovato attributo MODELLOVLAN&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDKITAREACAR&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.idKitAreaCar != null)&#xD;
				{&#xD;
					foundIDKITAREACAR = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.idKitAreaCar;&#xD;
					Process.auditLog(&quot;Trovato attributo IDKITAREACAR&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEAREARACCOLTA&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceAreaRaccolta != null)&#xD;
				{&#xD;
					foundCODICEAREARACCOLTA = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.codiceAreaRaccolta;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICEAREARACCOLTA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEAREARACCOLTA&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.nomeAreaRaccolta != null)&#xD;
				{&#xD;
					foundNOMEAREARACCOLTA = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.nomeAreaRaccolta;&#xD;
					Process.auditLog(&quot;Trovato attributo NOMEAREARACCOLTA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PUNTOCONSEGNA&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.puntoConsegna != null)&#xD;
				{&#xD;
					foundPUNTOCONSEGNA = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.puntoConsegna;&#xD;
					Process.auditLog(&quot;Trovato attributo PUNTOCONSEGNA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDBRE&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.idBre != null)&#xD;
				{&#xD;
					foundIDBRE = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.idBre;&#xD;
					Process.auditLog(&quot;Trovato attributo IDBRE&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMECLLI&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.nomeClli != null)&#xD;
				{&#xD;
					foundNOMECLLI = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.nomeClli;&#xD;
					Process.auditLog(&quot;Trovato attributo NOMECLLI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceMacroArea != null)&#xD;
				{&#xD;
					foundCODICEMACROAREA = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.codiceMacroArea;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICEMACROAREA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.nomeMacroArea != null)&#xD;
				{&#xD;
					foundNOMEMACROAREA = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.nomeMacroArea;&#xD;
					Process.auditLog(&quot;Trovato attributo NOMEMACROAREA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOOFFERTA&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.tipoOfferta != null)&#xD;
				{&#xD;
					foundTIPOOFFERTA = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.tipoOfferta;&#xD;
					Process.auditLog(&quot;Trovato attributo TIPOOFFERTA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDADRCRMWS&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.idAdrCrmws != null)&#xD;
				{&#xD;
					foundIDADRCRMWS = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.idAdrCrmws;&#xD;
					Process.auditLog(&quot;Trovato attributo IDADRCRMWS&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.idMadrCrmws != null)&#xD;
				{&#xD;
					foundIDMADRCRMWS = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.idMadrCrmws;&#xD;
					Process.auditLog(&quot;Trovato attributo IDMADRCRMWS&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				//RU_1099&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWSCOMM&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.idMadrCrmwsComm != null)&#xD;
				{&#xD;
					foundIDMADRCRMWSCOMM = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.idMadrCrmwsComm;&#xD;
					Process.auditLog(&quot;Trovato attributo IDMADRCRMWSCOMM&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREACOMM&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceMacroAreaComm != null)&#xD;
				{&#xD;
					foundCODICEMACROAREACOMM = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.codiceMacroAreaComm;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICEMACROAREACOMM&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
