				else&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AGGIUNTIVOWLR;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = 'Y';				&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
			}&#xD;
		}		&#xD;
		&#xD;
		//NUMERIAGGIUNTIVIOLO&#xD;
		else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMERIAGGIUNTIVIOLO)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			attributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
			var numeroTelefonicoAggiuntiviOLO = &quot;&quot;;&#xD;
			numeroTelefonicoAggiuntiviOLO = null;&#xD;
			var foundDistrettoAggiuntiviOLO = false;&#xD;
			&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDttOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDttOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					numeroTelefonicoAggiuntiviOLO = currentAttDttOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDttOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO)&#xD;
				{&#xD;
					foundDistrettoAggiuntiviOLO = true;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if(!foundDistrettoAggiuntiviOLO &amp;&amp; numeroTelefonicoAggiuntiviOLO != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				if(numeroTelefonicoAggiuntiviOLO.charAt(1) == &quot;2&quot;&#xD;
					|| numeroTelefonicoAggiuntiviOLO.charAt(1) == &quot;6&quot;)&#xD;
				{&#xD;
					attributo.valoreAttributo = numeroTelefonicoAggiuntiviOLO.slice(0,2);&#xD;
				}&#xD;
				else if(numeroTelefonicoAggiuntiviOLO.charAt(2) == &quot;0&quot;&#xD;
					|| numeroTelefonicoAggiuntiviOLO.charAt(2) == &quot;1&quot;&#xD;
					|| numeroTelefonicoAggiuntiviOLO.charAt(2) == &quot;5&quot;&#xD;
					|| numeroTelefonicoAggiuntiviOLO.charAt(2) == &quot;9&quot;)&#xD;
				{&#xD;
					attributo.valoreAttributo = numeroTelefonicoAggiuntiviOLO.slice(0,3);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					attributo.valoreAttributo = numeroTelefonicoAggiuntiviOLO.slice(0,4);&#xD;
				}				&#xD;
				localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//NUMERIAGGIUNTIVI&#xD;
	if(InventoryResponse != null &amp;&amp; InventoryResponse.CRMWSResponse != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea != null &amp;&amp; InventoryResponse.aggiuntiviUnica != null &amp;&amp; InventoryResponse.aggiuntiviUnica.size() > 0)&#xD;
	{&#xD;
		for(var z = 0; z &lt; InventoryResponse.aggiuntiviUnica.size(); z++)&#xD;
		{&#xD;
			var currentLinea = InventoryResponse.aggiuntiviUnica.get(z);&#xD;
			&#xD;
			if(currentLinea.stato.toUpperCase() == &quot;ATTIVO&quot;)&#xD;
			{&#xD;
				var dettaglio = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
				dettaglio.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
				dettaglio.IDDettaglioOrdineParent = 1;&#xD;
				dettaglio.IDDettaglioOrdineRoot = 1;&#xD;
				dettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				dettaglio.IDRisorsa = localRequest.IDRisorsa;&#xD;
				dettaglio.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
				dettaglio.created = data;&#xD;
				dettaglio.integrationID = localRequest.IDRisorsa + dettaglio.IDDettaglioOrdine;&#xD;
				dettaglio.lastUpdate = data;&#xD;
				dettaglio.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMERIAGGIUNTIVI;&#xD;
				dettaglio.operatore = localRequest.operatore;&#xD;
				dettaglio.progressivo = z + 1;&#xD;
				&#xD;
				attributo.IDDettaglioOrdine = dettaglio.IDDettaglioOrdine;&#xD;
				&#xD;
				//NUMERIAGGIUNTIVI.NUMEROTELEFONICO&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = currentLinea.numeroTelefonico;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				&#xD;
				//NUMERIAGGIUNTIVI.DISTRETTO&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = currentLinea.distretto;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				&#xD;
				//NUMERIAGGIUNTIVI.STATO&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = currentLinea.stato;&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				&#xD;
				//NUMERIAGGIUNTIVI.RADICALE&#xD;
				if(InventoryResponse.CRMWSResponse.tipo_Linea.radicale != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = InventoryResponse.CRMWSResponse.tipo_Linea.radicale;&#xD;
						&#xD;
					dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//NUMERIAGGIUNTIVI.CAPOSERIE&#xD;
				if(InventoryResponse.CRMWSResponse.tipo_Linea.caposerie != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = InventoryResponse.CRMWSResponse.tipo_Linea.caposerie;&#xD;
						&#xD;
					dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//NUMERIAGGIUNTIVI.NUMEROTELEFONICOPRINCIPALE&#xD;
				if(currentLinea.numeroTelefonicoPrincipale != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = currentLinea.numeroTelefonicoPrincipale;&#xD;
						&#xD;
					dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//NUMERIAGGIUNTIVI.TIPOLINEAOLO&#xD;
				if(tipoLineaOLO != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAOLO;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = tipoLineaOLO;&#xD;
					&#xD;
					dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//NUMERIAGGIUNTIVI.TIPOLINEANP&#xD;
				if(tipoLineaNP != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = tipoLineaNP;&#xD;
					&#xD;
					dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//NUMERIAGGIUNTIVI.CODICEPIATTAFORMA&#xD;
				if(CODICEPIATTAFORMA!= null &amp;&amp; CODICEPIATTAFORMA !=&quot;&quot;){&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = CODICEPIATTAFORMA;&#xD;
					dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
								&#xD;
				// RU_813 REWORKING - VERIFICA SE AGGIUNTIVO ARRIVATO DA UNICA è GIA PRESENTE NELL'ORDINE (arrivato anche da STOP N GO - CRM)&#xD;
				var index1 = 0;&#xD;
				var index2 = 0;&#xD;
				var AggiuntivoTrovato = false;&#xD;
				var posizione = 0;&#xD;
				var numAgg = &quot;&quot;;&#xD;
				numAgg = null;&#xD;
&#xD;
				while(!AggiuntivoTrovato &amp;&amp; index1&lt;localRequest.ordine.dettaglioordine.size())&#xD;
				{&#xD;
					var componente = localRequest.ordine.dettaglioordine.get(index1);&#xD;
					&#xD;
					if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMERIAGGIUNTIVI)&#xD;
					{&#xD;
						index2 = 0;&#xD;
						&#xD;
						while(!AggiuntivoTrovato &amp;&amp; index2&lt;componente.attributiDettaglioOrdine.size())&#xD;
						{&#xD;
							var attributo = componente.attributiDettaglioOrdine.get(index2);&#xD;
							&#xD;
							//SM_10992: corretto refuso&#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO &amp;&amp;&#xD;
								attributo.valoreAttributo == currentLinea.numeroTelefonico)&#xD;
							{&#xD;
								AggiuntivoTrovato = true;&#xD;
								posizione = index1;&#xD;
								numAgg = attributo.valoreAttributo;&#xD;
							}&#xD;
							index2++;&#xD;
						}&#xD;
					}&#xD;
					index1++;&#xD;
				}&#xD;
				&#xD;
				if(!AggiuntivoTrovato) //Aggiunge se non presente&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettaglio));&#xD;
					Process.auditLog(&quot;Aggiuntivo &quot;+numAgg+&quot; non presente nell'ordine&quot;);&#xD;
				}&#xD;
				else //Sostituisce se presente&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.set(posizione,ScriptUtil.copy(dettaglio));&#xD;
					Process.auditLog(&quot;Aggiuntivo &quot;+numAgg+&quot; presente nell'ordine, sostituito alla posizione &quot;+posizione);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Impossibile completare la funzione di arricchimento: Ordine o DettagliOrdine inesistenti&quot;);&#xD;
}&#xD;
&#xD;
//Aggiungi Azione &#xD;
if(localRequest!= null &amp;&amp; localRequest.ordine!=null){&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
		//NP&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY) {&#xD;
				&#xD;
				if (localRequest.codificaOLOAGCOM == 'TLC'){&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;	&#xD;
				}&#xD;
				else {&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
				}&#xD;
			} &#xD;
			else if (componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMERIAGGIUNTIVI){&#xD;
			&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
			}&#xD;
			else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMERIAGGIUNTIVIOLO){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;			&#xD;
			}&#xD;
		}&#xD;
		 else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot;+ componente.nomeComponente );&#xD;
		}				&#xD;
	}&#xD;
}&#xD;
&#xD;
if(localRequest.numeroTelefonico != null)&#xD;
{&#xD;
	var tel = localRequest.numeroTelefonico;&#xD;
	&#xD;
	if(tel.charAt(1) == &quot;2&quot;&#xD;
		|| tel.charAt(1) == &quot;6&quot;)&#xD;
	{&#xD;
		localRequest.ordine.distretto = &quot;0&quot; + tel.slice(0,2);&#xD;
	}&#xD;
	else if(tel.charAt(2) == &quot;0&quot;&#xD;
			|| tel.charAt(2) == &quot;1&quot;&#xD;
			|| tel.charAt(2) == &quot;5&quot;&#xD;
			|| tel.charAt(2) == &quot;9&quot;)&#xD;
	{&#xD;
		localRequest.ordine.distretto = tel.slice(0,3);&#xD;
	}&#xD;
	else{&#xD;
		localRequest.ordine.distretto = tel.slice(1,4);&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
