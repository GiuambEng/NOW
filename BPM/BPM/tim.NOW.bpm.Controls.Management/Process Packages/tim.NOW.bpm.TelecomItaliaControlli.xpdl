		listaAttributiAsset.add(&quot;CODICEMACROAREACOMM&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;RACCOLTA&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);&#xD;
		listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		listaLavorazioneRichiesta.add(&quot;&quot;);&#xD;
	&#xD;
		listaAttributiOrdine.add(&quot;NOMEMACROAREACOMM&quot;);&#xD;
