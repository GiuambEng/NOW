        <xpdl2:Activity Id="_xvO0QLf5EeipQZDAOAsu7w" Name="CTRLCONTRATTOOLO" xpdExt:Visibility="Private" xpdExt:DisplayName="CTRL CONTRATTO OLO">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_nM2BMFJKEeafMOVsQ226Vw" PackageRef="tim.NOW.bpm.ProcesService.Interfaces" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
              <xpdExt:InputMappings MapperContext="ProcessToSubProcess" MappingDirection="IN">
                <xpdExt:DataMappings>
