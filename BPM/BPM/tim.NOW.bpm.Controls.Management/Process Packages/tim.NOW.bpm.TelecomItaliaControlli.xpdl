        <xpdl2:Activity Id="_XIlLYFqnEei0N_oeSW1YIQ" Name="CallEnrichmentBandeEASYIPNGA" xpdExt:Visibility="Private" xpdExt:DisplayName="Call EnrichmentBande EASYIP NGA">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_Vr1C4EcGEeiOJdo8PSTN1w" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
              <xpdExt:InputMappings MapperContext="ProcessToSubProcess" MappingDirection="IN">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="ProfiloTecnicoLinea">
                    <xpdExt:ScriptInformation Id="_XIlLYVqnEei0N_oeSW1YIQ" Name="ProfiloTecnicoLinea">
                      <xpdExt:Expression ScriptGrammar="JavaScript">var ProfiloTecnicoLinea = &quot;&quot;;&#xD;
ProfiloTecnicoLinea = null;&#xD;
&#xD;
var i=0;&#xD;
while (ProfiloTecnicoLinea== null &amp;&amp; i&lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
&#xD;
	var currentDettaglio = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if (String(currentDettaglio.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j=0;&#xD;
		 while (ProfiloTecnicoLinea == null &amp;&amp; j&lt; currentDettaglio.attributiDettaglioOrdine.size())&#xD;
		 {&#xD;
		 	var currentAttributo = currentDettaglio.attributiDettaglioOrdine.get(j);&#xD;
		 	if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
		 	{&#xD;
		 		ProfiloTecnicoLinea = currentAttributo.valoreAttributo;&#xD;
		 		&#xD;
		 	}&#xD;
		 j++;&#xD;
		 }&#xD;
	&#xD;
	}&#xD;
i++;&#xD;
}&#xD;
&#xD;
return ProfiloTecnicoLinea;</xpdExt:Expression>
