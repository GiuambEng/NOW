        <xpdl2:Activity Id="_86lbknn-Ee2s0-70O8vQWA" Name="ArricchimentoDettaglioOrdine" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine.size() > 0)&#xD;
{&#xD;
	var data = DateTimeUtil.createDatetime();&#xD;
	&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	attributo.created = data;&#xD;
	attributo.lastUpdate = data;&#xD;
	attributo.operatore = localRequest.operatore;&#xD;
	&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		attributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
		&#xD;
		//NUMBERPORTABILITY&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			var numeroTelefonicoNumberPortability = &quot;&quot;;&#xD;
			numeroTelefonicoNumberPortability = null;&#xD;
			var foundDistrettoNumberPortability = false;&#xD;
			&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDttOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDttOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					numeroTelefonicoNumberPortability = currentAttDttOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDttOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO)&#xD;
				{&#xD;
					foundDistrettoNumberPortability = true;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//NUMBERPORTABILITY.DISTRETTO&#xD;
			if(!foundDistrettoNumberPortability &amp;&amp; numeroTelefonicoNumberPortability != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				if(numeroTelefonicoNumberPortability.charAt(1) == &quot;2&quot;&#xD;
					|| numeroTelefonicoNumberPortability.charAt(1) == &quot;6&quot;)&#xD;
				{&#xD;
					attributo.valoreAttributo = numeroTelefonicoNumberPortability.slice(0,2);&#xD;
				}&#xD;
				else if(numeroTelefonicoNumberPortability.charAt(2) == &quot;0&quot;&#xD;
					|| numeroTelefonicoNumberPortability.charAt(2) == &quot;1&quot;&#xD;
					|| numeroTelefonicoNumberPortability.charAt(2) == &quot;5&quot;&#xD;
					|| numeroTelefonicoNumberPortability.charAt(2) == &quot;9&quot;)&#xD;
				{&#xD;
					attributo.valoreAttributo = numeroTelefonicoNumberPortability.slice(0,3);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					attributo.valoreAttributo = numeroTelefonicoNumberPortability.slice(0,4);&#xD;
				}&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			attributo.valoreAttributo = &quot;Y&quot;;&#xD;
			&#xD;
			localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
		}&#xD;
		&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Impossibile completare la funzione di arricchimento: Ordine o DettagliOrdine inesistenti&quot;);&#xD;
}&#xD;
&#xD;
&#xD;
//Aggiungi Azione &#xD;
if(localRequest!= null &amp;&amp; localRequest.ordine!=null){&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		&#xD;
		//NP&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMERIAGGIUNTIVIOLO){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;			&#xD;
			} &#xD;
		}&#xD;
		 else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot;+ componente.nomeComponente );&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(localRequest.numeroTelefonico != null)&#xD;
{&#xD;
	var tel = localRequest.numeroTelefonico;&#xD;
	&#xD;
	if(tel.charAt(1) == &quot;2&quot;&#xD;
		|| tel.charAt(1) == &quot;6&quot;)&#xD;
	{&#xD;
		localRequest.ordine.distretto = &quot;0&quot; + tel.slice(0,2);&#xD;
	}&#xD;
	else if(tel.charAt(2) == &quot;0&quot;&#xD;
			|| tel.charAt(2) == &quot;1&quot;&#xD;
			|| tel.charAt(2) == &quot;5&quot;&#xD;
			|| tel.charAt(2) == &quot;9&quot;)&#xD;
	{&#xD;
		localRequest.ordine.distretto = tel.slice(0,3);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		localRequest.ordine.distretto = tel.slice(1,4);&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
