        <xpdl2:Activity Id="_OTJJYAo5Eeeu3aeX_vEnIg" Name="ArricchimentoDettaglioOrdineMigOLO2OLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Dettaglio Ordine Mig OLO2OLO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest!= null &amp;&amp; localRequest.ordine!=null){&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		&#xD;
		//BitstreamATMAsimmetricoFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMASIMFLAT &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//BitstreamATMAsimmetricoHL&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMASIMHL &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//BitstreamATMAsimmetricoLite&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMASIMLITE &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//BitstreamGBEAsimmetricoFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOGBEASIMFLAT &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//EasyIPBasePlusLite&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPBASEPLUSLITE &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//EasyIPBasePlusFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPBASEPLUSFLAT &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//EasyIPSpecialProfileLite&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPSPECIALPROFILELITE &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//EasyIPSpecialProfileFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPSPECIALPROFILEFLAT &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
		&#xD;
		&#xD;
	}&#xD;
	&#xD;
	//RU_1317: ARRICCHIMENTO GENERICO COMPONENTE ACCESSO -> attributo PROPRIETAMATERIALE&#xD;
	if(LavorazioneRichiesta != null)&#xD;
	{&#xD;
		var foundProprietaMateriale = false;&#xD;
		var trovatoFlagEquivalenzaProdotti = false; //RU_1390&#xD;
		&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{		&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE&#xD;
					   &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
					{&#xD;
						foundProprietaMateriale = true;&#xD;
						attr.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
						Process.auditLog(&quot;Aggiornato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
					}&#xD;
					//RU_1390&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI&#xD;
					   &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
					{&#xD;
						trovatoFlagEquivalenzaProdotti = true;&#xD;
						attr.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
						Process.auditLog(&quot;Aggiornato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
					}&#xD;
				}&#xD;
							&#xD;
				if(!foundProprietaMateriale &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
				{&#xD;
					var ora = DateTimeUtil.createDatetime();&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
					attributo.created = ora;&#xD;
					attributo.lastUpdate = ora;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE;&#xD;
					attributo.operatore = componente.operatore;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
					&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					foundProprietaMateriale = true;&#xD;
					Process.auditLog(&quot;Creato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
				}&#xD;
				//RU_1390&#xD;
					if(!trovatoFlagEquivalenzaProdotti &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
				{&#xD;
					var ora = DateTimeUtil.createDatetime();&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
					attributo.created = ora;&#xD;
					attributo.lastUpdate = ora;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI;&#xD;
					attributo.operatore = componente.operatore;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					trovatoFlagEquivalenzaProdotti = true;&#xD;
					Process.auditLog(&quot;Creato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
				}&#xD;
			}		&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//AttributoDettaglioRodine Protocollo Pila&#xD;
var trovatoPila = false;&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT)&#xD;
		{&#xD;
			if(currentDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
			{	&#xD;
				var j=0;&#xD;
				while(!trovatoPila &amp;&amp; j &lt; currentDettOrd.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrd = currentDettOrd.attributiDettaglioOrdine.get(j);&#xD;
					if(currentAttDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA)&#xD;
					{&#xD;
						trovatoPila = true;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
					j++;&#xD;
					}&#xD;
				}&#xD;
				if(trovatoPila)&#xD;
				{&#xD;
					Process.auditLog(&quot;Attributo ProtocolloPila già presente in input da xml&quot;);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
						var Attdettaglio = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						for (var k = 0; k &lt; ProtocolloPila.size(); k++)&#xD;
						{&#xD;
							if(currentDettOrd.IDDettaglioOrdine == ProtocolloPila.get(k).IDDettaglioOrdine)&#xD;
							{						&#xD;
							var currentProtPilaElement = ProtocolloPila.get(k);					&#xD;
							Attdettaglio.IDDettaglioOrdine = currentProtPilaElement.IDDettaglioOrdine;&#xD;
							Attdettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							Attdettaglio.created = DateTimeUtil.createDatetime();&#xD;
							Attdettaglio.lastUpdate = DateTimeUtil.createDatetime();&#xD;
							Attdettaglio.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA;&#xD;
							Attdettaglio.operatore = &quot;BPM&quot;;&#xD;
							Attdettaglio.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							Attdettaglio.valoreAttributo = currentProtPilaElement.protocolloPilaDefault;&#xD;
							localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(Attdettaglio));&#xD;
							}&#xD;
						}			&#xD;
				}				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}	&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Nessun Ordine presente nella Richiesta&quot;);&#xD;
}&#xD;
	&#xD;
//RU_1066: creazione componente SERVIZIOPZIONALI con CODICESERVIZIO e DESCRIZIONESERVIZIO in uscita dal controllo C01M02F35 per EASYIPNGAFTTH e EASYIPNGAFTTCAB&#xD;
//RU_1081: stravolta logica di arricchimento per SERVIZIOPZIONALI autogenerati in uscita dal controllo C01M02F35&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; String(localRequest.offerta).slice(0,6) == &quot;EASYIP&quot;&#xD;
    &amp;&amp; ServiziOpzAutogenerati != null &amp;&amp; ServiziOpzAutogenerati.size() > 0)&#xD;
{&#xD;
	for(var m=0; m&lt;ServiziOpzAutogenerati.size(); m++)&#xD;
	{&#xD;
		currentServiziOpzAutogenerati = ServiziOpzAutogenerati.get(m);&#xD;
		var ServiziOpzionaliAGGIORNATI = false;&#xD;
		&#xD;
		//SE TROVO SERVIZIOPZIONALI CON QUEL CODICESERVIZIO NELLA RICHIESTA -> ARRICCHISCO SERVIZIOPZIONALI DELLA RICHIESTA PER NON CREARE DUPLICATI&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
			{&#xD;
				var CodiceServizioRichiesta = &quot;&quot;;&#xD;
				CodiceServizioRichiesta = null;&#xD;
				&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO)&#xD;
					{&#xD;
						CodiceServizioRichiesta = attributo.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo CODICESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//Se sono uguali i CODICISERVIZIO&#xD;
				if(currentServiziOpzAutogenerati.codiceServizio != null &amp;&amp; CodiceServizioRichiesta != null&#xD;
				   &amp;&amp; currentServiziOpzAutogenerati.codiceServizio == CodiceServizioRichiesta)&#xD;
				{&#xD;
					//Aggiorno campi della componente&#xD;
					var data = DateTimeUtil.createDatetime();&#xD;
					componente.operatore = &quot;BPM&quot;;       //mi serve per arricchimento dei SERVIZIOPZIONALI nel CalcoloRemoteID&#xD;
					componente.lastUpdate = data;&#xD;
					&#xD;
					//Arricchimento&#xD;
					ServiziOpzionaliAGGIORNATI = true;&#xD;
					&#xD;
					for(var k=0; k&lt;componente.attributiDettaglioOrdine.size(); k++)&#xD;
					{&#xD;
						var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONESERVIZIO&#xD;
						   &amp;&amp; currentServiziOpzAutogenerati.descrizioneServizio != null)&#xD;
						{&#xD;
							attributo.valoreAttributo = currentServiziOpzAutogenerati.descrizioneServizio;&#xD;
							Process.auditLog(&quot;Aggiornato attributo DESCRIZIONESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
						}&#xD;
						//Se CODICESERVIZIO = A001, allora in DATITECNICI viene messo il REALM usato poi nel complete script del CalcoloRemoteID, altrimenti viene messo il valore definitivo&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI&#xD;
								&amp;&amp; currentServiziOpzAutogenerati.datiTecnici != null)&#xD;
						{&#xD;
							attributo.valoreAttributo = currentServiziOpzAutogenerati.datiTecnici;&#xD;
							Process.auditLog(&quot;Aggiornato attributo DATITECNICI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO&#xD;
								&amp;&amp; currentServiziOpzAutogenerati.vincolantePerEspletamento != null&#xD;
								&amp;&amp; currentServiziOpzAutogenerati.codiceServizio != &quot;A001&quot;)  //Se è A001, va lasciato quello in input&#xD;
						{&#xD;
							attributo.valoreAttributo = currentServiziOpzAutogenerati.vincolantePerEspletamento;&#xD;
							Process.auditLog(&quot;Aggiornato attributo VINCOLANTEPERESPLETAMENTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
						}&#xD;
					}&#xD;
				}	&#xD;
			}	&#xD;
		}&#xD;
		&#xD;
		//SE NON TROVO SERVIZIOPZIONALI CON QUEL CODICESERVIZIO NELLA RICHIESTA -> CREO LA COMPONENTE SERVIZIOPZIONALI&#xD;
		if(!ServiziOpzionaliAGGIORNATI)&#xD;
		{&#xD;
			var data = DateTimeUtil.createDatetime();&#xD;
			var componenteServiziOpzionali = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			componenteServiziOpzionali.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			componenteServiziOpzionali.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
			componenteServiziOpzionali.IDDettaglioOrdineParent = 1;&#xD;
			componenteServiziOpzionali.IDDettaglioOrdineRoot = 1;&#xD;
			componenteServiziOpzionali.IDRisorsa = localRequest.IDRisorsa;&#xD;
			componenteServiziOpzionali.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
			componenteServiziOpzionali.operatore = &quot;BPM&quot;;&#xD;
			componenteServiziOpzionali.progressivo = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
			componenteServiziOpzionali.created = data;&#xD;
			componenteServiziOpzionali.integrationID = localRequest.IDRichiestaOLO + localRequest.ordine.dettaglioordine.size() + 1;&#xD;
			componenteServiziOpzionali.lastUpdate = data;&#xD;
			componenteServiziOpzionali.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
			componenteServiziOpzionali.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI; &#xD;
			&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componenteServiziOpzionali.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componenteServiziOpzionali.IDRichiestaOLO;&#xD;
			attributo.created = data;&#xD;
			attributo.lastUpdate = data;&#xD;
			attributo.operatore = componenteServiziOpzionali.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			&#xD;
			//CODICESERVIZIO&#xD;
			if(currentServiziOpzAutogenerati.codiceServizio != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO;&#xD;
				attributo.valoreAttributo = currentServiziOpzAutogenerati.codiceServizio;&#xD;
				componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo CODICESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			//DESCRIZIONESERVIZIO&#xD;
			if(currentServiziOpzAutogenerati.descrizioneServizio != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONESERVIZIO;&#xD;
				attributo.valoreAttributo = currentServiziOpzAutogenerati.descrizioneServizio;&#xD;
				componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo DESCRIZIONESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			//Se CODICESERVIZIO = A001, allora in DATITECNICI viene messo il REALM usato poi nel complete script del CalcoloRemoteID, altrimenti viene messo il valore definitivo&#xD;
			if(currentServiziOpzAutogenerati.datiTecnici != null) &#xD;
			{&#xD;
				//DATITECNICI&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI;&#xD;
				attributo.valoreAttributo = currentServiziOpzAutogenerati.datiTecnici;&#xD;
				componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo DATITECNICI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
			}&#xD;
&#xD;
			//VINCOLANTEPERESPLETAMENTO&#xD;
			if(currentServiziOpzAutogenerati.vincolantePerEspletamento != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO;&#xD;
				attributo.valoreAttributo = currentServiziOpzAutogenerati.vincolantePerEspletamento;&#xD;
				componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo VINCOLANTEPERESPLETAMENTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			//Aggiungo componente all'ordine&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componenteServiziOpzionali));&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_yNFWgfOjEeaXdvPXpqOd8g" Width="139.0">
              <xpdl2:Coordinates XCoordinate="2696.0" YCoordinate="248.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_ZASGoA1cEeeRv6xWIpo7fw" Name="ArricchimentoDettaglioOrdineMigTIM2OLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine Mig TIM2OLO" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest!= null &amp;&amp; localRequest.ordine!=null){&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		&#xD;
		//BitstreamATMAsimmetricoFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMASIMFLAT &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY&#xD;
			){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//BitstreamATMAsimmetricoHL&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMASIMHL &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//BitstreamATMAsimmetricoLite&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMASIMLITE &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//BitstreamGBEAsimmetricoFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOGBEASIMFLAT &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//EasyIPBasePlusLite&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPBASEPLUSLITE &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//EasyIPBasePlusFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPBASEPLUSFLAT &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//EasyIPSpecialProfileLite&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPSPECIALPROFILELITE &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//EasyIPSpecialProfileFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPSPECIALPROFILEFLAT &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
		&#xD;
		&#xD;
	}&#xD;
	&#xD;
	//RU_1317: ARRICCHIMENTO GENERICO COMPONENTE ACCESSO -> attributo PROPRIETAMATERIALE&#xD;
	if(LavorazioneRichiesta != null)&#xD;
	{&#xD;
		var foundProprietaMateriale = false;&#xD;
		var trovatoFlagEquivalenzaProdotti = false; //RU_1390&#xD;
&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{		&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE&#xD;
					   &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
					{&#xD;
						foundProprietaMateriale = true;&#xD;
						attr.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
						Process.auditLog(&quot;Aggiornato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
					}&#xD;
					//RU_1390&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI&#xD;
					   &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
					{&#xD;
						trovatoFlagEquivalenzaProdotti = true;&#xD;
						attr.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
						Process.auditLog(&quot;Aggiornato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
					}&#xD;
				}&#xD;
							&#xD;
				if(!foundProprietaMateriale &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
				{&#xD;
					var ora = DateTimeUtil.createDatetime();&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
					attributo.created = ora;&#xD;
					attributo.lastUpdate = ora;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE;&#xD;
					attributo.operatore = componente.operatore;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					foundProprietaMateriale = true;&#xD;
					Process.auditLog(&quot;Creato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
				}&#xD;
				//RU_1390&#xD;
					if(!trovatoFlagEquivalenzaProdotti &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
				{&#xD;
					var ora = DateTimeUtil.createDatetime();&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
					attributo.created = ora;&#xD;
					attributo.lastUpdate = ora;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI;&#xD;
					attributo.operatore = componente.operatore;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
					&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					trovatoFlagEquivalenzaProdotti = true;&#xD;
					Process.auditLog(&quot;Creato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
				}&#xD;
			}		&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//AttributoDettaglioRodine Protocollo Pila&#xD;
var trovatoPila = false;&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT)&#xD;
		{&#xD;
			if(currentDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
			{	&#xD;
				var j=0;&#xD;
				while(!trovatoPila &amp;&amp; j &lt; currentDettOrd.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrd = currentDettOrd.attributiDettaglioOrdine.get(j);&#xD;
					if(currentAttDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA)&#xD;
					{&#xD;
						trovatoPila = true;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
					j++;&#xD;
					}&#xD;
				}&#xD;
				if(trovatoPila)&#xD;
				{&#xD;
					Process.auditLog(&quot;Attributo ProtocolloPila già presente in input da xml&quot;);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
						var Attdettaglio = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						for (var k = 0; k &lt; ProtocolloPila.size(); k++)&#xD;
						{&#xD;
							if(currentDettOrd.IDDettaglioOrdine == ProtocolloPila.get(k).IDDettaglioOrdine)&#xD;
							{						&#xD;
							var currentProtPilaElement = ProtocolloPila.get(k);					&#xD;
							Attdettaglio.IDDettaglioOrdine = currentProtPilaElement.IDDettaglioOrdine;&#xD;
							Attdettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							Attdettaglio.created = DateTimeUtil.createDatetime();&#xD;
							Attdettaglio.lastUpdate = DateTimeUtil.createDatetime();&#xD;
							Attdettaglio.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA;&#xD;
							Attdettaglio.operatore = &quot;BPM&quot;;&#xD;
							Attdettaglio.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							Attdettaglio.valoreAttributo = currentProtPilaElement.protocolloPilaDefault;&#xD;
							localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(Attdettaglio));&#xD;
							}&#xD;
						}			&#xD;
				}				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}	&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Nessun Ordine presente nella Richiesta&quot;);&#xD;
}&#xD;
&#xD;
//RU_1066: creazione componente SERVIZIOPZIONALI con CODICESERVIZIO e DESCRIZIONESERVIZIO in uscita dal controllo C01M02F35 per EASYIPNGAFTTH e EASYIPNGAFTTCAB&#xD;
//RU_1081: stravolta logica di arricchimento per SERVIZIOPZIONALI autogenerati in uscita dal controllo C01M02F35&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; String(localRequest.offerta).slice(0,6) == &quot;EASYIP&quot;&#xD;
    &amp;&amp; ServiziOpzAutogenerati != null &amp;&amp; ServiziOpzAutogenerati.size() > 0)&#xD;
{&#xD;
	for(var m=0; m&lt;ServiziOpzAutogenerati.size(); m++)&#xD;
	{&#xD;
		currentServiziOpzAutogenerati = ServiziOpzAutogenerati.get(m);&#xD;
		var ServiziOpzionaliAGGIORNATI = false;&#xD;
		&#xD;
		//SE TROVO SERVIZIOPZIONALI CON QUEL CODICESERVIZIO NELLA RICHIESTA -> ARRICCHISCO SERVIZIOPZIONALI DELLA RICHIESTA PER NON CREARE DUPLICATI&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
			{&#xD;
				var CodiceServizioRichiesta = &quot;&quot;;&#xD;
				CodiceServizioRichiesta = null;&#xD;
				&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO)&#xD;
					{&#xD;
						CodiceServizioRichiesta = attributo.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo CODICESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//Se sono uguali i CODICISERVIZIO&#xD;
				if(currentServiziOpzAutogenerati.codiceServizio != null &amp;&amp; CodiceServizioRichiesta != null&#xD;
				   &amp;&amp; currentServiziOpzAutogenerati.codiceServizio == CodiceServizioRichiesta)&#xD;
				{&#xD;
					//Aggiorno campi della componente&#xD;
					var data = DateTimeUtil.createDatetime();&#xD;
					componente.operatore = &quot;BPM&quot;;       //mi serve per arricchimento dei SERVIZIOPZIONALI nel CalcoloRemoteID&#xD;
					componente.lastUpdate = data;&#xD;
					&#xD;
					//Arricchimento&#xD;
					ServiziOpzionaliAGGIORNATI = true;&#xD;
					&#xD;
					for(var k=0; k&lt;componente.attributiDettaglioOrdine.size(); k++)&#xD;
					{&#xD;
						var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONESERVIZIO&#xD;
						   &amp;&amp; currentServiziOpzAutogenerati.descrizioneServizio != null)&#xD;
						{&#xD;
							attributo.valoreAttributo = currentServiziOpzAutogenerati.descrizioneServizio;&#xD;
							Process.auditLog(&quot;Aggiornato attributo DESCRIZIONESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
						}&#xD;
						//Se CODICESERVIZIO = A001, allora in DATITECNICI viene messo il REALM usato poi nel complete script del CalcoloRemoteID, altrimenti viene messo il valore definitivo&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI&#xD;
								&amp;&amp; currentServiziOpzAutogenerati.datiTecnici != null) &#xD;
						{&#xD;
							attributo.valoreAttributo = currentServiziOpzAutogenerati.datiTecnici;&#xD;
							Process.auditLog(&quot;Aggiornato attributo DATITECNICI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO&#xD;
								&amp;&amp; currentServiziOpzAutogenerati.vincolantePerEspletamento != null&#xD;
								&amp;&amp; currentServiziOpzAutogenerati.codiceServizio != &quot;A001&quot;)  //Se è A001, va lasciato quello in input&#xD;
						{&#xD;
							attributo.valoreAttributo = currentServiziOpzAutogenerati.vincolantePerEspletamento;&#xD;
							Process.auditLog(&quot;Aggiornato attributo VINCOLANTEPERESPLETAMENTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
						}&#xD;
					}&#xD;
				}	&#xD;
			}	&#xD;
		}&#xD;
		&#xD;
		//SE NON TROVO SERVIZIOPZIONALI CON QUEL CODICESERVIZIO NELLA RICHIESTA -> CREO LA COMPONENTE SERVIZIOPZIONALI&#xD;
		if(!ServiziOpzionaliAGGIORNATI)&#xD;
		{&#xD;
			var data = DateTimeUtil.createDatetime();&#xD;
			var componenteServiziOpzionali = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			componenteServiziOpzionali.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			componenteServiziOpzionali.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
			componenteServiziOpzionali.IDDettaglioOrdineParent = 1;&#xD;
			componenteServiziOpzionali.IDDettaglioOrdineRoot = 1;&#xD;
			componenteServiziOpzionali.IDRisorsa = localRequest.IDRisorsa;&#xD;
			componenteServiziOpzionali.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
			componenteServiziOpzionali.operatore = &quot;BPM&quot;;&#xD;
			componenteServiziOpzionali.progressivo = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
			componenteServiziOpzionali.created = data;&#xD;
			componenteServiziOpzionali.integrationID = localRequest.IDRichiestaOLO + localRequest.ordine.dettaglioordine.size() + 1;&#xD;
			componenteServiziOpzionali.lastUpdate = data;&#xD;
			componenteServiziOpzionali.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
			componenteServiziOpzionali.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI; &#xD;
			&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componenteServiziOpzionali.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componenteServiziOpzionali.IDRichiestaOLO;&#xD;
			attributo.created = data;&#xD;
			attributo.lastUpdate = data;&#xD;
			attributo.operatore = componenteServiziOpzionali.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			&#xD;
			//CODICESERVIZIO&#xD;
			if(currentServiziOpzAutogenerati.codiceServizio != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO;&#xD;
				attributo.valoreAttributo = currentServiziOpzAutogenerati.codiceServizio;&#xD;
				componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo CODICESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			//DESCRIZIONESERVIZIO&#xD;
			if(currentServiziOpzAutogenerati.descrizioneServizio != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONESERVIZIO;&#xD;
				attributo.valoreAttributo = currentServiziOpzAutogenerati.descrizioneServizio;&#xD;
				componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo DESCRIZIONESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			//Se CODICESERVIZIO = A001, allora in DATITECNICI viene messo il REALM usato poi nel complete script del CalcoloRemoteID, altrimenti viene messo il valore definitivo&#xD;
			if(currentServiziOpzAutogenerati.datiTecnici != null)&#xD;
			{&#xD;
				//DATITECNICI&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI;&#xD;
				attributo.valoreAttributo = currentServiziOpzAutogenerati.datiTecnici;&#xD;
				componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo DATITECNICI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
			}&#xD;
&#xD;
			//VINCOLANTEPERESPLETAMENTO&#xD;
			if(currentServiziOpzAutogenerati.vincolantePerEspletamento != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO;&#xD;
				attributo.valoreAttributo = currentServiziOpzAutogenerati.vincolantePerEspletamento;&#xD;
				componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo VINCOLANTEPERESPLETAMENTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			//Aggiungo componente all'ordine&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componenteServiziOpzionali));&#xD;
		}&#xD;
	}		&#xD;
}&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
