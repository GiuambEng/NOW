        <xpdl2:Transition Id="_Gb8Ao8kbEeuGzq6XLg3PUg" Name="" From="_Gb8AoMkbEeuGzq6XLg3PUg" To="_Gb8AockbEeuGzq6XLg3PUg">
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.LabelAnchorPosition">
              <xpdl2:Coordinates XCoordinate="49.122807017543856" YCoordinate="0.0"/>
