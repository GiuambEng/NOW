	}&#xD;
	if(ConsistenzaDati.codiceTrasformazione!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETRASFORMAZIONE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codiceTrasformazione;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.opzioneDinamica!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONEDINAMICA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.opzioneDinamica;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.tipologiaClusterComune!=null){ //RU_964&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.tipologiaClusterComune;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//OPERATORERETE - RU_1142&#xD;
	if(ConsistenzaDati.operatoreRete!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPERATORERETE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.operatoreRete;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//ASSETBTWHITELIST - R1E-21-0325&#xD;
	if(ConsistenzaDati.assetBTWhiteList != null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.WHITELIST;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.assetBTWhiteList;&#xD;
		&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
&#xD;
		componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attrTemp));&#xD;
	}&#xD;
	&#xD;
	localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
}&#xD;
&#xD;
//NUMBERPORTABILITY&#xD;
if(NumberPortability != null &amp;&amp; NumberPortability.size() > 0){&#xD;
	var n  = 0;&#xD;
	while(n &lt; NumberPortability.size()){&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta ='NP'&quot;);&#xD;
		c.setQueryParameter(&quot;idr&quot;,NumberPortability.get(n).numeroTelefonico);&#xD;
		var AssetNPref = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		AssetNP = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
		AssetNP=null;&#xD;
		&#xD;
		Process.auditLog(&quot;AssetNPref&quot;+AssetNPref.size());&#xD;
		&#xD;
		if(AssetNPref.size()>0){&#xD;
			AssetNP = AssetNPref.get(0).readAsset();			&#xD;
		}&#xD;
		if(AssetNP != null){&#xD;
			Process.auditLog(&quot;Asset NP recuperato: &quot;+AssetNP.IDAsset);&#xD;
			var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
			componente.IDDettaglioOrdineParent = 1;&#xD;
			componente.IDDettaglioOrdineRoot =1;&#xD;
			componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		&#xD;
			componente.created = data;&#xD;
			componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
			componente.lastUpdate = data;&#xD;
			componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY;&#xD;
			componente.operatore = &quot;BPM&quot;;&#xD;
			componente.progressivo = 1;&#xD;
			if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTONP){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
			}&#xD;
			else{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
			}&#xD;
		&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = data;&#xD;
			attributo.lastUpdate = data;&#xD;
			attributo.operatore = &quot;BPM&quot;;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		&#xD;
		&#xD;
			var NUMBERPORTABILITYTrovata = false;&#xD;
			var i=0;&#xD;
			while(!NUMBERPORTABILITYTrovata &amp;&amp; i&lt;AssetNP.dettaglioasset.size()){&#xD;
				var compAsset =AssetNP.dettaglioasset.get(i);&#xD;
				if(compAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
					NUMBERPORTABILITYTrovata = true;&#xD;
					var trovatoNumeroTelefonico = false;&#xD;
					var trovatoCODICEPIATTAFORMA = false;&#xD;
					var j=0;&#xD;
					while(j&lt;compAsset.attributidettaglioasset.size()){&#xD;
						var attr = compAsset.attributidettaglioasset.get(j);&#xD;
						var attributoTemp = ScriptUtil.copy(attributo);&#xD;
						attributoTemp.nomeAttributo = attr.nomeAttributo;&#xD;
						if(attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA){&#xD;
							trovatoCODICEPIATTAFORMA = true;&#xD;
							if(CodicePiattaforma!=null &amp;&amp; CodicePiattaforma!= &quot;&quot;){&#xD;
								attributoTemp.valoreAttributo =  CodicePiattaforma;&#xD;
								componente.attributiDettaglioOrdine.add(attributoTemp);&#xD;
							}&#xD;
						}&#xD;
						else{&#xD;
							if(attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO){&#xD;
								trovatoNumeroTelefonico = true;&#xD;
							}&#xD;
							attributoTemp.valoreAttributo =  attr.valoreAttributo;&#xD;
							componente.attributiDettaglioOrdine.add(attributoTemp);&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
					//SM_7678&#xD;
					if(!trovatoNumeroTelefonico &amp;&amp; AssetNP.numeroTelefonico != null &amp;&amp; AssetNP.numeroTelefonico != &quot;&quot;)&#xD;
					{&#xD;
						var attributoTemp = ScriptUtil.copy(attributo);&#xD;
						attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
						attributoTemp.valoreAttributo =  AssetNP.numeroTelefonico;&#xD;
						componente.attributiDettaglioOrdine.add(attributoTemp);&#xD;
					}&#xD;
					if(!trovatoCODICEPIATTAFORMA &amp;&amp; (CodicePiattaforma!=null &amp;&amp; CodicePiattaforma!= &quot;&quot;)){&#xD;
						var attributoTemp = ScriptUtil.copy(attributo);&#xD;
						attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA;&#xD;
						attributoTemp.valoreAttributo =  CodicePiattaforma;&#xD;
						componente.attributiDettaglioOrdine.add(attributoTemp);&#xD;
					}&#xD;
					&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
			//aggiungoIDAsset&#xD;
		&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
			attributo.valoreAttributo =  AssetNP.IDAsset;&#xD;
			componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
			&#xD;
		&#xD;
		&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Nessun asset con offerta NP recuperato per NumeroTelefonico: &quot;+ConsistenzaFonia.numeroTelefonico);&#xD;
		}&#xD;
		&#xD;
		n++;	&#xD;
	}		&#xD;
		&#xD;
}	&#xD;
	&#xD;
	for(var i=0 ; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
	&#xD;
	if(localRequest.ordine.dettaglioordine.get(i).azione == null){&#xD;
		localRequest.ordine.dettaglioordine.get(i).azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
		&#xD;
	}&#xD;
}&#xD;
	</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="118.0" LaneId="_7Zu7gfwjEeapT_T8svBRzg" Width="133.0">
              <xpdl2:Coordinates XCoordinate="3704.0" YCoordinate="1100.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
