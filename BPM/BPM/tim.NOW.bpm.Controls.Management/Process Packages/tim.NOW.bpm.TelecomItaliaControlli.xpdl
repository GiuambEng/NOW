				Process.auditLog(&quot;Creato attributo CODICEMACROAREA&quot;+ LavorazioneRichiesta.codiceMacroArea +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			if(!foundNOMEMACROAREA &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.nomeMacroArea != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.nomeMacroArea;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
