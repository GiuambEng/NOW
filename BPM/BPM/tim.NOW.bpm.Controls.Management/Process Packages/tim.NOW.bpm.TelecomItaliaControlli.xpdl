              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier=&quot;/tim.NOW.bpm.Controls/Process Packages/tim.NOW.bpm.Controls.xpdl.CTRLBANDEPICCO_C04M01F94&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_JY_4AfLFEeamP7Malp741w" Name="CallCTRLVALORIBANDEPICCO" FinishMode="Automatic" IsATransaction="false" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Call CTRL VALORI BANDE PICCO">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_jFLNENmVEeack7ej6Yci5Q" PackageRef="tim.NOW.bpm.ProcesService.Interfaces" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="false">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="EsistenzaVLANOutput">
                  <xpdl2:Actual ScriptGrammar="JavaScript">EsistenzaVLANOutput</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="EsitoResponse">
                  <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:Priority></xpdl2:Priority>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_JY-psfLFEeamP7Malp741w" Width="96.0">
              <xpdl2:Coordinates XCoordinate="2966.0" YCoordinate="101.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier=&quot;/tim.NOW.bpm.Controls/Process Packages/tim.NOW.bpm.Controls.xpdl.CTRLVALORIBANDEPICCO_C04M01F148&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_JY_4AvLFEeamP7Malp741w" Name="EsitoResponse31" xpdExt:DisplayName="EsitoResponse?">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_JZAfbPLFEeamP7Malp741w"/>
                  <xpdl2:TransitionRef Id="_KnxnUODDEeeQMMA_2K-WjA"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="66.0" LaneId="_JY-psfLFEeamP7Malp741w" Width="104.0">
              <xpdl2:Coordinates XCoordinate="3072.0" YCoordinate="101.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_JY_4BfLFEeamP7Malp741w" Name="ArricchimentoDettaglioOrdineAtt" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine Att">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest!= null &amp;&amp; localRequest.ordine!=null)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
		//VULAFTTH BitstreamNGAFTTH EASYIPNGAFTTH&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTH &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONGAFTTH &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTH&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
			 &#xD;
			 componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//VULAFTTCAB BitstreamNGAFTTCAB EASYIPNGAFTTCAB&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONGAFTTCAB &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTCAB&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTCAB&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{&#xD;
			&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			&#xD;
			}&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	&#xD;
	//RU_1317: ARRICCHIMENTO GENERICO COMPONENTE ACCESSO -> attributo PROPRIETAMATERIALE&#xD;
	var foundProprietaMateriale = false;&#xD;
	//RU_1390: ARRICCHIMENTO GENERICO COMPONENTE ACCESSO -> attributo FLAGEQUIVALENZAPRODOTTI&#xD;
	var trovatoFlagEquivalenzaProdotti = false;&#xD;
	//RU_1353: ARRICCHIMENTO CARATTERIZZAZIONEGEO NELL'ACCESSO DA CONSISTENZADATI&#xD;
	var foundCaratterizzazioneGeo = false;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{		&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE&#xD;
				   &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
				{&#xD;
					foundProprietaMateriale = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
					Process.auditLog(&quot;Aggiornato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO &#xD;
				   &amp;&amp; ConsistenzaDati != null &amp;&amp; ConsistenzaDati.caratterizzazioneGEO != null)//RU_1353&#xD;
				{&#xD;
					foundCaratterizzazioneGeo = true;&#xD;
					attr.valoreAttributo = ConsistenzaDati.caratterizzazioneGEO;&#xD;
					Process.auditLog(&quot;Aggiornato attributo CARATTERIZZAZIONEGEO con valore: &quot;+ ConsistenzaDati.caratterizzazioneGEO);&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI&#xD;
					   &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
				{&#xD;
					trovatoFlagEquivalenzaProdotti = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
					Process.auditLog(&quot;Aggiornato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
				}&#xD;
			}&#xD;
						&#xD;
			if(!foundProprietaMateriale &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundProprietaMateriale = true;&#xD;
				Process.auditLog(&quot;Creato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
			}&#xD;
			&#xD;
			if(!foundCaratterizzazioneGeo &amp;&amp; ConsistenzaDati != null &amp;&amp; ConsistenzaDati.caratterizzazioneGEO != null)//RU_1353&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaDati.caratterizzazioneGEO;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundProprietaMateriale = true;&#xD;
				Process.auditLog(&quot;Creato attributo CARATTERIZZAZIONEGEO con valore: &quot;+ ConsistenzaDati.caratterizzazioneGEO);&#xD;
			}&#xD;
			if(!trovatoFlagEquivalenzaProdotti &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				trovatoFlagEquivalenzaProdotti = true;&#xD;
				Process.auditLog(&quot;Creato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
			}&#xD;
		}		&#xD;
	}&#xD;
			&#xD;
	 //ARRICCHIMENTO BANDE PICCO PER EASYIPUBB&#xD;
 if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH)&#xD;
 {&#xD;
  for (var i=0; i&lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
  {   &#xD;
   var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
   &#xD;
   if (currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp; EnrichmentBandeOut!= null)&#xD;
   {&#xD;
    Process.auditLog(&quot;Inizio arricchimento BANDEPICCO per USERVLAN EASYIP NGA - Valori da inserire: BANDAPICCOUP &quot;+EnrichmentBandeOut.bandaPiccoUp+&quot; BANDAPICCODOWN &quot;+EnrichmentBandeOut.bandaPiccoDown);&#xD;
    &#xD;
    var foundBANDAPICCOup = false;&#xD;
    var foundBANDAPICCOdown = false;&#xD;
    var j=0;&#xD;
    &#xD;
    while ((!foundBANDAPICCOup || !foundBANDAPICCOdown) &amp;&amp;  j&lt; currentComponente.attributiDettaglioOrdine.size())&#xD;
    {&#xD;
     var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
     &#xD;
     if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
     {&#xD;
      foundBANDAPICCOup=true;&#xD;
      currentAttributo.valoreAttributo = EnrichmentBandeOut.bandaPiccoUp;&#xD;
     }&#xD;
     &#xD;
     else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
     {&#xD;
      foundBANDAPICCOdown=true;&#xD;
      currentAttributo.valoreAttributo = EnrichmentBandeOut.bandaPiccoDown;&#xD;
     }&#xD;
     &#xD;
     &#xD;
    j++;&#xD;
    }&#xD;
    &#xD;
    // CREO GLI ATTRIBUTI SE NON ESISTONO&#xD;
    if (!foundBANDAPICCOup || !foundBANDAPICCOdown)&#xD;
    {&#xD;
     var AttributoBande = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
     &#xD;
     AttributoBande.IDDettaglioOrdine = currentComponente.IDDettaglioOrdine;&#xD;
     AttributoBande.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
     AttributoBande.created = DateTimeUtil.createDatetime();&#xD;
     AttributoBande.lastUpdate = DateTimeUtil.createDatetime();&#xD;
     AttributoBande.operatore = &quot;BPM&quot;;&#xD;
     AttributoBande.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
     &#xD;
     if (!foundBANDAPICCOup)&#xD;
     {&#xD;
      AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP;&#xD;
      AttributoBande.valoreAttributo = EnrichmentBandeOut.bandaPiccoUp;&#xD;
      currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
      Process.auditLog(&quot;Creato attributo BANDAPICCOUP &quot; + EnrichmentBandeOut.bandaPiccoUp);&#xD;
      &#xD;
     }&#xD;
     if (!foundBANDAPICCOdown)&#xD;
     {&#xD;
      AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN;&#xD;
      AttributoBande.valoreAttributo = EnrichmentBandeOut.bandaPiccoDown;&#xD;
      currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
      Process.auditLog(&quot;Creato attributo BANDAPICCODOWN &quot; + EnrichmentBandeOut.bandaPiccoDown);&#xD;
     }&#xD;
 &#xD;
    }&#xD;
  &#xD;
   &#xD;
   }&#xD;
  }&#xD;
 }&#xD;
&#xD;
//RU_1502 - ARRICCHIMENTO CARATTERISTICAVLAN in uscita C04M01F36&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH     &#xD;
   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH &#xD;
   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
			var trovatoCaratteristicaVlan = false;&#xD;
			&#xD;
			for(var k=0; k&lt;EsistenzaVLANOutput.size(); k++)&#xD;
			{&#xD;
				var vlanOut = EsistenzaVLANOutput.get(k);&#xD;
				&#xD;
				if(vlanOut.IDDettaglioOrdine == componente.IDDettaglioOrdine&#xD;
				   &amp;&amp; vlanOut.CARATTERISTICAVLAN == &quot;DRG OPZIONE ZERO&quot; &amp;&amp; vlanOut.BMD == &quot;Y&quot;)&#xD;
				{&#xD;
				    localRequest.ordine.caratterizzazioneAccesso = &quot;DRG OPZIONE ZERO&quot;;   //SM_11484&#xD;
				&#xD;
					for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++){&#xD;
						var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVLAN)&#xD;
						{&#xD;
							trovatoCaratteristicaVlan = true;&#xD;
							attr.valoreAttributo = vlanOut.CARATTERISTICAVLAN;&#xD;
							Process.auditLog(&quot;Sovrascritto CARATTERISTICAVLAN &quot;+ vlanOut.CARATTERISTICAVLAN +&quot; dal CTRL ESISTENZA VLAN_C04M01F36&quot;);&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					if(!trovatoCaratteristicaVlan){&#xD;
						var ora = DateTimeUtil.createDatetime();&#xD;
						var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
						attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
						attributo.created = ora;&#xD;
						attributo.lastUpdate =ora;&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVLAN;&#xD;
						attributo.operatore = componente.operatore;&#xD;
						attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						attributo.valoreAttributo = vlanOut.CARATTERISTICAVLAN;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));						&#xD;
						trovatoCaratteristicaVlan = true;&#xD;
						Process.auditLog(&quot;Valorizzato CARATTERISTICAVLAN &quot;+ vlanOut.CARATTERISTICAVLAN +&quot; dal CTRL ESISTENZA VLAN_C04M01F36&quot;);&#xD;
					}&#xD;
				}&#xD;
				//SM_11484 - indipendentemente da BMD marchiamo l'ordine con DRG OPZIONE ZERO se c'è almeno una USERVLAN DRG OPZIONE ZERO&#xD;
				else if(vlanOut.IDDettaglioOrdine == componente.IDDettaglioOrdine &#xD;
						&amp;&amp; vlanOut.CARATTERISTICAVLAN == &quot;DRG OPZIONE ZERO&quot;)&#xD;
				{&#xD;
					localRequest.ordine.caratterizzazioneAccesso = &quot;DRG OPZIONE ZERO&quot;;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
} &#xD;
 &#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" LaneId="_JY-psfLFEeamP7Malp741w" Width="142.0">
              <xpdl2:Coordinates XCoordinate="5323.0" YCoordinate="2455.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_JY_4BvLFEeamP7Malp741w" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_pYhX4OMAEeaoOL-mvUhWhw" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="52.0" LaneId="_JY-psfLFEeamP7Malp741w" Width="73.0">
              <xpdl2:Coordinates XCoordinate="57.0" YCoordinate="101.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_ytrDMQotEeeu3aeX_vEnIg" Name="ArricchimentoDettaglioOrdineMig" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Dettaglio Ordine Mig">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest!= null &amp;&amp; localRequest.ordine!=null)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
		//VULAFTTH BitstreamNGAFTTH EASYIPNGAFTTH&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH            //RU_1164&#xD;
        || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
        || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)&#xD;
		{&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTH &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONGAFTTH &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTH&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{			 &#xD;
			 componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;						&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		&#xD;
		//VULAFTTCAB BitstreamNGAFTTCAB EASYIPNGAFTTCAB&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB)&#xD;
		{&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONGAFTTCAB &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTCAB &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTCAB&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)  //RU_980&#xD;
			{&#xD;
			&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			&#xD;
			}&#xD;
			//RU_980&#xD;
			else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;			&#xD;
			}&#xD;
			&#xD;
			//R1I-20-0131: solo per VULAFTTCAB&#xD;
		    else if((componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTODISAGGREGAZIONE&#xD;
					  || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PRESTAZIONIAGGIUNTIVE&#xD;
					  || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SLAPLUSSU)&#xD;
				   &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
		    {&#xD;
			   componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
		    }&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//RU_1317: ARRICCHIMENTO GENERICO COMPONENTE ACCESSO -> attributo PROPRIETAMATERIALE&#xD;
	var foundProprietaMateriale = false;&#xD;
	//RU_1390: ARRICCHIMENTO GENERICO COMPONENTE ACCESSO -> attributo FLAGEQUIVALENZAPRODOTTI&#xD;
	var trovatoFlagEquivalenzaProdotti = false;&#xD;
	//RU_1353: ARRICCHIMENTO CARATTERIZZAZIONEGEO NELL'ACCESSO DA CONSISTENZADATI&#xD;
	var foundCaratterizzazioneGeo = false;&#xD;
	//Radius&#xD;
	var foundCluster = false;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{		&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE&#xD;
				   &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
				{&#xD;
					foundProprietaMateriale = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
					Process.auditLog(&quot;Aggiornato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO &#xD;
				   &amp;&amp; ConsistenzaDati != null &amp;&amp; ConsistenzaDati.caratterizzazioneGEO != null)//RU_1353&#xD;
				{&#xD;
					foundCaratterizzazioneGeo = true;&#xD;
					attr.valoreAttributo = ConsistenzaDati.caratterizzazioneGEO;&#xD;
					Process.auditLog(&quot;Aggiornato attributo CARATTERIZZAZIONEGEO con valore: &quot;+ ConsistenzaDati.caratterizzazioneGEO);&#xD;
				}&#xD;
				//RU_1390&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI&#xD;
					   &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
				{&#xD;
					trovatoFlagEquivalenzaProdotti = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
					Process.auditLog(&quot;Aggiornato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
				}&#xD;
				//Radius&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLUSTER&#xD;
					   &amp;&amp; LavorazioneRichiesta.cluster != null)&#xD;
				{&#xD;
					foundCluster = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.cluster;&#xD;
					Process.auditLog(&quot;Aggiornato attributo Cluster con valore: &quot;+ LavorazioneRichiesta.cluster);&#xD;
				}&#xD;
			}&#xD;
						&#xD;
			if(!foundProprietaMateriale &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundProprietaMateriale = true;&#xD;
				Process.auditLog(&quot;Creato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
			}&#xD;
			//RU_1353&#xD;
			if(!foundCaratterizzazioneGeo &amp;&amp; ConsistenzaDati != null &amp;&amp; ConsistenzaDati.caratterizzazioneGEO != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaDati.caratterizzazioneGEO;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundProprietaMateriale = true;&#xD;
				Process.auditLog(&quot;Creato attributo CARATTERIZZAZIONEGEO con valore: &quot;+ ConsistenzaDati.caratterizzazioneGEO);&#xD;
			}&#xD;
			//RU_1390&#xD;
			if(!trovatoFlagEquivalenzaProdotti &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				trovatoFlagEquivalenzaProdotti = true;&#xD;
				Process.auditLog(&quot;Creato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
			}&#xD;
			//Radius&#xD;
			if(!foundCluster &amp;&amp; LavorazioneRichiesta.cluster != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLUSTER;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.cluster;			&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundCluster = true;&#xD;
				Process.auditLog(&quot;Creato attributo CLUSTER con valore: &quot;+ LavorazioneRichiesta.cluster);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
//FEA_32918: ARRICCHIMENTO MERCATO PER VULAFTTH e VULAFTTCAB&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
{&#xD;
	var foundMercato = false;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{		&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MERCATO&#xD;
				&amp;&amp; LavorazioneRichiesta.mercato != null)&#xD;
				{&#xD;
					foundMercato = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.mercato;&#xD;
					Process.auditLog(&quot;Aggiornato attributo MERCATO con valore: &quot;+ LavorazioneRichiesta.mercato);&#xD;
				}&#xD;
			}&#xD;
						&#xD;
			if(!foundMercato &amp;&amp; LavorazioneRichiesta.mercato != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MERCATO;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.mercato;			&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundMercato = true;&#xD;
				Process.auditLog(&quot;Creato attributo MERCATO con valore: &quot;+ LavorazioneRichiesta.mercato);&#xD;
			}&#xD;
	&#xD;
	&#xD;
		}		&#xD;
	}&#xD;
}	&#xD;
	 //ARRICCHIMENTO BANDE PICCO PER EASYIPUBB&#xD;
 if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)   //RU_1164&#xD;
 {&#xD;
  for (var i=0; i&lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
  {   &#xD;
   var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
   &#xD;
   if (currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp; EnrichmentBandeOut!= null)&#xD;
   {&#xD;
    Process.auditLog(&quot;Inizio arricchimento BANDEPICCO per USERVLAN EASYIP NGA - Valori da inserire: BANDAPICCOUP &quot;+EnrichmentBandeOut.bandaPiccoUp+&quot; BANDAPICCODOWN &quot;+EnrichmentBandeOut.bandaPiccoDown);&#xD;
    &#xD;
    var foundBANDAPICCOup = false;&#xD;
    var foundBANDAPICCOdown = false;&#xD;
    var j=0;&#xD;
    &#xD;
    while ((!foundBANDAPICCOup || !foundBANDAPICCOdown) &amp;&amp;  j&lt; currentComponente.attributiDettaglioOrdine.size())&#xD;
    {&#xD;
     var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
     &#xD;
     if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
     {&#xD;
      foundBANDAPICCOup=true;&#xD;
      currentAttributo.valoreAttributo = EnrichmentBandeOut.bandaPiccoUp;&#xD;
     }&#xD;
     &#xD;
     else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
     {&#xD;
      foundBANDAPICCOdown=true;&#xD;
      currentAttributo.valoreAttributo = EnrichmentBandeOut.bandaPiccoDown;&#xD;
     }&#xD;
     &#xD;
     &#xD;
    j++;&#xD;
    }&#xD;
    &#xD;
    // CREO GLI ATTRIBUTI SE NON ESISTONO&#xD;
    if (!foundBANDAPICCOup || !foundBANDAPICCOdown)&#xD;
    {&#xD;
     var AttributoBande = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
     &#xD;
     AttributoBande.IDDettaglioOrdine = currentComponente.IDDettaglioOrdine;&#xD;
     AttributoBande.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
     AttributoBande.created = DateTimeUtil.createDatetime();&#xD;
     AttributoBande.lastUpdate = DateTimeUtil.createDatetime();&#xD;
     AttributoBande.operatore = &quot;BPM&quot;;&#xD;
     AttributoBande.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
     &#xD;
     if (!foundBANDAPICCOup)&#xD;
     {&#xD;
      AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP;&#xD;
      AttributoBande.valoreAttributo = EnrichmentBandeOut.bandaPiccoUp;&#xD;
      currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
      Process.auditLog(&quot;Creato attributo BANDAPICCOUP &quot; + EnrichmentBandeOut.bandaPiccoUp);&#xD;
      &#xD;
     }&#xD;
     if (!foundBANDAPICCOdown)&#xD;
     {&#xD;
      AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN;&#xD;
      AttributoBande.valoreAttributo = EnrichmentBandeOut.bandaPiccoDown;&#xD;
      currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
      Process.auditLog(&quot;Creato attributo BANDAPICCODOWN &quot; + EnrichmentBandeOut.bandaPiccoDown);&#xD;
     }&#xD;
 &#xD;
    }&#xD;
  &#xD;
   &#xD;
   }&#xD;
  }&#xD;
 }&#xD;
 &#xD;
 &#xD;
//RU_980: Arricchimento AREADICANTIERE per offerte VULAFTTCAB, BITSTREAMNGAFTTCAB, EASYIPNGAFTTCAB&#xD;
//R1I-20-0131: aggiunto arricchimento ATI e IMPRESAADCENTRALE solo per VULAFTTCAB&#xD;
//RU_1036: aggiunto arricchimento di TEST2 e QUALIFICA solo per EASYIPNGAFTTCAB&#xD;
//Modifica conseguente al Bug #31805 di GUI: messo a commento l'arricchimento per QUALIFICA E TEST2. In tutte le casistiche questi attributi scenderanno da FM/GUI.&#xD;
var trovataAreaDiCantiere = false;&#xD;
var trovataAti = false;                   //R1I-20-0131&#xD;
var trovataImpresaAdCentrale = false;     //R1I-20-0131&#xD;
//var trovatoTest2 = false;            //RU_1036&#xD;
//var trovataQualifica = false;        //RU_1036&#xD;
&#xD;
//SM_9486&#xD;
var trovataDisaggregazione = false;&#xD;
var trovataAppuntamentoDisaggregazione = false;&#xD;
var trovataPrestazioniAggiuntive = false;&#xD;
var OwnerPresaAppuntamento = &quot;&quot;; &#xD;
var FlagPrestazioneAggiuntiva = &quot;&quot;;&#xD;
OwnerPresaAppuntamento = null;  &#xD;
FlagPrestazioneAggiuntiva = null;&#xD;
&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
      || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
	  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB)&#xD;
{&#xD;
	for(var i=0; i&lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		//Componente ACCESSO&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTCAB&#xD;
		   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONGAFTTCAB&#xD;
		   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTCAB)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AREADICANTIERE&#xD;
				   &amp;&amp; LavorazioneRichiesta.areaDiCantiere!=null)&#xD;
				{&#xD;
					trovataAreaDiCantiere = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.areaDiCantiere;&#xD;
					Process.auditLog(&quot;Valorizzato AREADICANTIERE &quot;+ LavorazioneRichiesta.areaDiCantiere +&quot; della componente ACCESSO&quot;);&#xD;
				}&#xD;
				//RU_1036: aggiunto arricchimento di TEST2 e QUALIFICA solo per EASYIPNGAFTTCAB&#xD;
				//Modifica conseguente al Bug #31805 di GUI: messo a commento l'arricchimento per QUALIFICA E TEST2. In tutte le casistiche questi attributi scenderanno da FM/GUI.&#xD;
				/*else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TEST2&#xD;
				        &amp;&amp; componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTCAB)&#xD;
				{&#xD;
					trovatoTest2 = true;&#xD;
					attr.valoreAttributo = &quot;SI&quot;;&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUALIFICA&#xD;
				        &amp;&amp; componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTCAB)&#xD;
				{&#xD;
					trovataQualifica = true;&#xD;
					attr.valoreAttributo = &quot;SI&quot;;&#xD;
				}*/&#xD;
			}&#xD;
						&#xD;
			if(!trovataAreaDiCantiere &amp;&amp; LavorazioneRichiesta.areaDiCantiere!=null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate =ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AREADICANTIERE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.areaDiCantiere;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				trovataAreaDiCantiere = true;&#xD;
				Process.auditLog(&quot;Creato AREADICANTIERE &quot;+ LavorazioneRichiesta.areaDiCantiere +&quot; della componente ACCESSO&quot;);&#xD;
			}&#xD;
			&#xD;
			//RU_1036: aggiunto arricchimento di TEST2 solo per EASYIPNGAFTTCAB&#xD;
			//Modifica conseguente al Bug #31805 di GUI: messo a commento l'arricchimento per QUALIFICA E TEST2. In tutte le casistiche questi attributi scenderanno da FM/GUI.&#xD;
			/*if(!trovatoTest2 &amp;&amp; componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTCAB)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate =ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TEST2;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = &quot;SI&quot;;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				&#xD;
				trovatoTest2 = true;&#xD;
				Process.auditLog(&quot;Creato TEST2 &quot;+ attributo.valoreAttributo +&quot; della componente ACCESSO&quot;);&#xD;
			}&#xD;
			&#xD;
			if(!trovataQualifica &amp;&amp; componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTCAB)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate =ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUALIFICA;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = &quot;SI&quot;;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				&#xD;
				trovataQualifica = true;&#xD;
				Process.auditLog(&quot;Creata QUALIFICA &quot;+ attributo.valoreAttributo +&quot; della componente ACCESSO&quot;);&#xD;
			}*/&#xD;
		}&#xD;
		&#xD;
		//R1I-20-0131: arricchimento ATI e IMPRESAADCENTRALE per VULAFTTCAB&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE&#xD;
		        &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
		{&#xD;
			trovataDisaggregazione = true;   //SM_9486&#xD;
			var j=0;&#xD;
			&#xD;
			while((!trovataAti || !trovataImpresaAdCentrale) &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ATI&#xD;
				   &amp;&amp; Ati != null)&#xD;
				{&#xD;
					attributo.valoreAttributo = Ati;&#xD;
					trovataAti = true; &#xD;
					&#xD;
					Process.auditLog(&quot;Trovato attributo ATI &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IMPRESAADCENTRALE&#xD;
				        &amp;&amp; ImpresaAdCentrale != null)&#xD;
				{&#xD;
					attributo.valoreAttributo = ImpresaAdCentrale;&#xD;
					trovataImpresaAdCentrale = true; &#xD;
					&#xD;
					Process.auditLog(&quot;Trovato attributo IMPRESAADCENTRALE &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
&#xD;
			if(!trovataAti &amp;&amp; Ati != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ATI;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = Ati;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				&#xD;
				Process.auditLog(&quot;Creato attributo ATI &quot;+ Ati +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			if(!trovataImpresaAdCentrale &amp;&amp; ImpresaAdCentrale != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IMPRESAADCENTRALE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ImpresaAdCentrale;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				&#xD;
				Process.auditLog(&quot;Creato attributo IMPRESAADCENTRALE &quot;+ ImpresaAdCentrale +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		&#xD;
		}&#xD;
		&#xD;
		//SM_9486: componente APPUNTAMENTODISAGGREGAZIONE per VULAFTTCAB&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTODISAGGREGAZIONE&#xD;
		        &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
		{&#xD;
			trovataAppuntamentoDisaggregazione = true;&#xD;
			var j=0;&#xD;
			&#xD;
			while(OwnerPresaAppuntamento == null &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OWNERPRESAAPPUNTAMENTO)&#xD;
				{&#xD;
					OwnerPresaAppuntamento = attr.valoreAttributo; &#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//SM_9486: componente PRESTAZIONIAGGIUNTIVE per VULAFTTCAB&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PRESTAZIONIAGGIUNTIVE&#xD;
		        &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
		{&#xD;
			trovataPrestazioniAggiuntive = true;&#xD;
			var j=0;&#xD;
			&#xD;
			while(FlagPrestazioneAggiuntiva == null &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGPRESTAZIONEAGGIUNTIVA)&#xD;
				{&#xD;
					FlagPrestazioneAggiuntiva = attr.valoreAttributo; &#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
	}	&#xD;
}&#xD;
 &#xD;
&#xD;
//SM_9486: arricchimento TIPODISAGGREGAZIONE e PRESTAZIONIAGGIUNTIVE della componente DISAGGREGAZIONE solo per VULAFTTCAB&#xD;
//LOGICA PER ARRICCHIMENTO&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
   &amp;&amp; localRequest.disaggregato == &quot;S&quot;)&#xD;
{&#xD;
	var TIPODISAGGREGAZIONE = &quot;&quot;;&#xD;
	var PRESTAZIONIAGGIUNTIVE = &quot;&quot;;&#xD;
	TIPODISAGGREGAZIONE = null;&#xD;
	PRESTAZIONIAGGIUNTIVE = null;&#xD;
&#xD;
	var foundTIPODISAGGREGAZIONE = false;&#xD;
	var foundPRESTAZIONIAGGIUNTIVE = false;&#xD;
&#xD;
	//SM_9551: Ricerca del REFERENTEONFIELD&#xD;
	var foundREFERENTEONFIELD = false;&#xD;
&#xD;
	if(localRequest.ordine != null &amp;&amp; localRequest.ordine.referente != null &amp;&amp; localRequest.ordine.referente.size() > 0) &#xD;
	{	&#xD;
		for(var m=0; m&lt;localRequest.ordine.referente.size(); m++)&#xD;
		{&#xD;
			var currentreferente = localRequest.ordine.referente.get(m);&#xD;
			&#xD;
			if(currentreferente.tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTEONFIELD)&#xD;
			{&#xD;
				foundREFERENTEONFIELD = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	//Logica di arricchimento&#xD;
	if(localRequest.exDisaggregato == &quot;S&quot;)&#xD;
	{&#xD;
		TIPODISAGGREGAZIONE = &quot;OL richiesto come disaggregato ma lavorato da TIM&quot;;&#xD;
		PRESTAZIONIAGGIUNTIVE = &quot;NO&quot;;&#xD;
	}&#xD;
	else if((OwnerPresaAppuntamento != null &amp;&amp; (OwnerPresaAppuntamento == &quot;OP&quot; || OwnerPresaAppuntamento == &quot;SU&quot;))&#xD;
			|| foundREFERENTEONFIELD                        //SM_9551: aggiunta condizione sul REFERENTEONFIELD&#xD;
			|| FlagPrestazioneAggiuntiva != null)&#xD;
	{&#xD;
		TIPODISAGGREGAZIONE = &quot;OL disaggregato con prestazioni aggiuntive&quot;;&#xD;
		PRESTAZIONIAGGIUNTIVE = &quot;SI&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		TIPODISAGGREGAZIONE = &quot;OL disaggregato senza prestazioni aggiuntive&quot;;&#xD;
		PRESTAZIONIAGGIUNTIVE = &quot;NO&quot;;&#xD;
	}&#xD;
&#xD;
&#xD;
	//ARRICCHIMENTO&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE)&#xD;
		{&#xD;
			var j=0;&#xD;
			&#xD;
			while((!foundTIPODISAGGREGAZIONE || !foundPRESTAZIONIAGGIUNTIVE) &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODISAGGREGAZIONE&#xD;
				   &amp;&amp; TIPODISAGGREGAZIONE != null)&#xD;
				{&#xD;
					foundTIPODISAGGREGAZIONE = true;&#xD;
					attr.valoreAttributo = TIPODISAGGREGAZIONE;&#xD;
					Process.auditLog(&quot;Valorizzato TIPODISAGGREGAZIONE: &quot;+ TIPODISAGGREGAZIONE +&quot; della componente DISAGGREGAZIONE&quot;);&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PRESTAZIONIAGGIUNTIVE&#xD;
						&amp;&amp; PRESTAZIONIAGGIUNTIVE != null)&#xD;
				{&#xD;
					foundPRESTAZIONIAGGIUNTIVE = true;&#xD;
					attr.valoreAttributo = PRESTAZIONIAGGIUNTIVE;&#xD;
					Process.auditLog(&quot;Valorizzato PRESTAZIONIAGGIUNTIVE: &quot;+ PRESTAZIONIAGGIUNTIVE +&quot; della componente DISAGGREGAZIONE&quot;);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
						&#xD;
			if(!foundTIPODISAGGREGAZIONE &amp;&amp; TIPODISAGGREGAZIONE != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODISAGGREGAZIONE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = TIPODISAGGREGAZIONE;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundTIPODISAGGREGAZIONE = true;&#xD;
			}&#xD;
			&#xD;
			if(!foundPRESTAZIONIAGGIUNTIVE &amp;&amp; PRESTAZIONIAGGIUNTIVE != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PRESTAZIONIAGGIUNTIVE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = PRESTAZIONIAGGIUNTIVE;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundPRESTAZIONIAGGIUNTIVE = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
 &#xD;
} &#xD;
&#xD;
//RU_1066: creazione componente SERVIZIOPZIONALI con CODICESERVIZIO e DESCRIZIONESERVIZIO in uscita dal controllo C01M02F35 per EASYIPNGAFTTH e EASYIPNGAFTTCAB&#xD;
//RU_1081: stravolta logica di arricchimento per SERVIZIOPZIONALI autogenerati in uscita dal controllo C01M02F35&#xD;
//RU_1116: l'arricchimento dei SERVIZIOPZIONALI non va fatto più solo per EASYIPNGAFTTH e EASYIPNGAFTTCAB (quindi eliminato if su queste offerte nell'arricchimento), ma per tutte le offerte del serpentone:&#xD;
//l'unica differenza è che per le offerte VULAH/NGA FTTH e VULAC/NGA FTTCab la logica di arricchimento di DATITECNICI non usa il REMOTEID (di CalcolaRemoteID), ma va preso il valore direttamente in uscita dal controllo C01M02F35&#xD;
&#xD;
if(ServiziOpzAutogenerati != null &amp;&amp; ServiziOpzAutogenerati.size() > 0)&#xD;
{&#xD;
	for(var m=0; m&lt;ServiziOpzAutogenerati.size(); m++)&#xD;
	{&#xD;
		currentServiziOpzAutogenerati = ServiziOpzAutogenerati.get(m);&#xD;
		var ServiziOpzionaliAGGIORNATI = false;&#xD;
		&#xD;
		//RU_1128: A parità di CODICESERVIZIO, bisogna inserire una sola volta SERVIZIOPZIONALI, quindi ciascun ServizioOpzionale in uscita da C01M02F35 lo confronto con i precedenti elementi dell'array per fare in modo che sia inserito una sola volta&#xD;
		var ServiziOpzINSERIMENTO = true;&#xD;
		var s=0;&#xD;
		&#xD;
		while(ServiziOpzINSERIMENTO &amp;&amp; s&lt;m)&#xD;
		{&#xD;
			ServiziOpzAutogeneratiPREC = ServiziOpzAutogenerati.get(s);&#xD;
			&#xD;
			if(ServiziOpzAutogeneratiPREC.codiceServizio == currentServiziOpzAutogenerati.codiceServizio)&#xD;
			{&#xD;
				ServiziOpzINSERIMENTO = false;&#xD;
			}&#xD;
			s++;&#xD;
		}&#xD;
		//------------------------------------------------------------------------------------------------------------------------------------&#xD;
		&#xD;
		//RU_1128: AGGIUNTO IF, CIASCUN SERVIZIOPZIONALE VA INSERITO UNA SOLA VOLTA A PARITà DI CODICESERVIZIO&#xD;
		if(ServiziOpzINSERIMENTO)&#xD;
		{&#xD;
		&#xD;
			//SE TROVO SERVIZIOPZIONALI CON QUEL CODICESERVIZIO NELLA RICHIESTA -> ARRICCHISCO SERVIZIOPZIONALI DELLA RICHIESTA PER NON CREARE DUPLICATI&#xD;
			for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
			{&#xD;
				var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
				{&#xD;
					var CodiceServizioRichiesta = &quot;&quot;;&#xD;
					CodiceServizioRichiesta = null;&#xD;
					&#xD;
					for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
					{&#xD;
						var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO)&#xD;
						{&#xD;
							CodiceServizioRichiesta = attributo.valoreAttributo;&#xD;
							Process.auditLog(&quot;Trovato attributo CODICESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					//Se sono uguali i CODICISERVIZIO&#xD;
					if(currentServiziOpzAutogenerati.codiceServizio != null &amp;&amp; CodiceServizioRichiesta != null&#xD;
					   &amp;&amp; currentServiziOpzAutogenerati.codiceServizio == CodiceServizioRichiesta)&#xD;
					{&#xD;
						//Aggiorno campi della componente&#xD;
						var data = DateTimeUtil.createDatetime();&#xD;
						componente.operatore = &quot;BPM&quot;;       //mi serve per arricchimento dei SERVIZIOPZIONALI nel CalcoloRemoteID&#xD;
						componente.lastUpdate = data;&#xD;
						&#xD;
						//Arricchimento&#xD;
						ServiziOpzionaliAGGIORNATI = true;&#xD;
						&#xD;
						for(var k=0; k&lt;componente.attributiDettaglioOrdine.size(); k++)&#xD;
						{&#xD;
							var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
							&#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONESERVIZIO&#xD;
							   &amp;&amp; currentServiziOpzAutogenerati.descrizioneServizio != null)&#xD;
							{&#xD;
								attributo.valoreAttributo = currentServiziOpzAutogenerati.descrizioneServizio;&#xD;
								Process.auditLog(&quot;Aggiornato attributo DESCRIZIONESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
							}&#xD;
							//Se CODICESERVIZIO = A001 allora in DATITECNICI viene messo il REALM (questo solo per EASYIPNGAFTTH e EASYIPNGAFTTCAB) usato poi nel complete script del CalcoloRemoteID, altrimenti viene messo il valore definitivo &#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI&#xD;
									&amp;&amp; currentServiziOpzAutogenerati.datiTecnici != null)&#xD;
							{&#xD;
								attributo.valoreAttributo = currentServiziOpzAutogenerati.datiTecnici;&#xD;
								Process.auditLog(&quot;Aggiornato attributo DATITECNICI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO&#xD;
									&amp;&amp; currentServiziOpzAutogenerati.vincolantePerEspletamento != null&#xD;
									&amp;&amp; currentServiziOpzAutogenerati.codiceServizio != &quot;A001&quot;)  //Se è A001, va lasciato quello in input&#xD;
							{&#xD;
								attributo.valoreAttributo = currentServiziOpzAutogenerati.vincolantePerEspletamento;&#xD;
								Process.auditLog(&quot;Aggiornato attributo VINCOLANTEPERESPLETAMENTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
							}&#xD;
						}&#xD;
					}	&#xD;
				}	&#xD;
			}&#xD;
			&#xD;
			//SE NON TROVO SERVIZIOPZIONALI CON QUEL CODICESERVIZIO NELLA RICHIESTA -> CREO LA COMPONENTE SERVIZIOPZIONALI&#xD;
			if(!ServiziOpzionaliAGGIORNATI)&#xD;
			{&#xD;
				var data = DateTimeUtil.createDatetime();&#xD;
				var componenteServiziOpzionali = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
				componenteServiziOpzionali.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				componenteServiziOpzionali.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
				componenteServiziOpzionali.IDDettaglioOrdineParent = 1;&#xD;
				componenteServiziOpzionali.IDDettaglioOrdineRoot = 1;&#xD;
				componenteServiziOpzionali.IDRisorsa = localRequest.IDRisorsa;&#xD;
				componenteServiziOpzionali.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
				componenteServiziOpzionali.operatore = &quot;BPM&quot;;&#xD;
				componenteServiziOpzionali.progressivo = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
				componenteServiziOpzionali.created = data;&#xD;
				componenteServiziOpzionali.integrationID = localRequest.IDRichiestaOLO + localRequest.ordine.dettaglioordine.size() + 1;&#xD;
				componenteServiziOpzionali.lastUpdate = data;&#xD;
				componenteServiziOpzionali.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
				componenteServiziOpzionali.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI; &#xD;
				&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componenteServiziOpzionali.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componenteServiziOpzionali.IDRichiestaOLO;&#xD;
				attributo.created = data;&#xD;
				attributo.lastUpdate = data;&#xD;
				attributo.operatore = componenteServiziOpzionali.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				//CODICESERVIZIO&#xD;
				if(currentServiziOpzAutogenerati.codiceServizio != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO;&#xD;
					attributo.valoreAttributo = currentServiziOpzAutogenerati.codiceServizio;&#xD;
					componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Creato attributo CODICESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
				}&#xD;
				&#xD;
				//DESCRIZIONESERVIZIO&#xD;
				if(currentServiziOpzAutogenerati.descrizioneServizio != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONESERVIZIO;&#xD;
					attributo.valoreAttributo = currentServiziOpzAutogenerati.descrizioneServizio;&#xD;
					componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Creato attributo DESCRIZIONESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
				}&#xD;
				&#xD;
				//Se CODICESERVIZIO = A001 allora in DATITECNICI viene messo il REALM (questo solo per EASYIPNGAFTTH e EASYIPNGAFTTCAB) usato poi nel complete script del CalcoloRemoteID, altrimenti viene messo il valore definitivo &#xD;
				if(currentServiziOpzAutogenerati.datiTecnici != null)&#xD;
				{&#xD;
					//DATITECNICI&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI;&#xD;
					attributo.valoreAttributo = currentServiziOpzAutogenerati.datiTecnici;&#xD;
					componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Creato attributo DATITECNICI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
				}&#xD;
&#xD;
				//VINCOLANTEPERESPLETAMENTO&#xD;
				if(currentServiziOpzAutogenerati.vincolantePerEspletamento != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO;&#xD;
					attributo.valoreAttributo = currentServiziOpzAutogenerati.vincolantePerEspletamento;&#xD;
					componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Creato attributo VINCOLANTEPERESPLETAMENTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
				}&#xD;
				&#xD;
				//Aggiungo componente all'ordine&#xD;
				localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componenteServiziOpzionali));&#xD;
			}&#xD;
		}&#xD;
		&#xD;
	}	&#xD;
}&#xD;
&#xD;
//RU_1502 - ARRICCHIMENTO CARATTERISTICAVLAN in uscita C04M01F36&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH     &#xD;
   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH &#xD;
   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
			var trovatoCaratteristicaVlan = false;&#xD;
			&#xD;
			for(var k=0; k&lt;EsistenzaVLANOutput.size(); k++)&#xD;
			{&#xD;
				var vlanOut = EsistenzaVLANOutput.get(k);&#xD;
				&#xD;
				if(vlanOut.IDDettaglioOrdine == componente.IDDettaglioOrdine&#xD;
				   &amp;&amp; vlanOut.CARATTERISTICAVLAN == &quot;DRG OPZIONE ZERO&quot; &amp;&amp; vlanOut.BMD == &quot;Y&quot;)&#xD;
				{&#xD;
				    localRequest.ordine.caratterizzazioneAccesso = &quot;DRG OPZIONE ZERO&quot;;   //SM_11484&#xD;
				&#xD;
					for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++){&#xD;
						var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVLAN)&#xD;
						{&#xD;
							trovatoCaratteristicaVlan = true;&#xD;
							attr.valoreAttributo = vlanOut.CARATTERISTICAVLAN;&#xD;
							Process.auditLog(&quot;Sovrascritto CARATTERISTICAVLAN &quot;+ vlanOut.CARATTERISTICAVLAN +&quot; dal CTRL ESISTENZA VLAN_C04M01F36&quot;);&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					if(!trovatoCaratteristicaVlan){&#xD;
						var ora = DateTimeUtil.createDatetime();&#xD;
						var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
						attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
						attributo.created = ora;&#xD;
						attributo.lastUpdate =ora;&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVLAN;&#xD;
						attributo.operatore = componente.operatore;&#xD;
						attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						attributo.valoreAttributo = vlanOut.CARATTERISTICAVLAN;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));						&#xD;
						trovatoCaratteristicaVlan = true;&#xD;
						Process.auditLog(&quot;Valorizzato CARATTERISTICAVLAN &quot;+ vlanOut.CARATTERISTICAVLAN +&quot; dal CTRL ESISTENZA VLAN_C04M01F36&quot;);&#xD;
					}&#xD;
				}&#xD;
				//SM_11484 - indipendentemente da BMD marchiamo l'ordine con DRG OPZIONE ZERO se c'è almeno una USERVLAN DRG OPZIONE ZERO&#xD;
				else if(vlanOut.IDDettaglioOrdine == componente.IDDettaglioOrdine &#xD;
						&amp;&amp; vlanOut.CARATTERISTICAVLAN == &quot;DRG OPZIONE ZERO&quot;)&#xD;
				{&#xD;
					localRequest.ordine.caratterizzazioneAccesso = &quot;DRG OPZIONE ZERO&quot;;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="95.0" LaneId="_JY-psfLFEeamP7Malp741w" Width="142.0">
              <xpdl2:Coordinates XCoordinate="5323.0" YCoordinate="2571.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_oMhD0As5Eee1qP88Gy0zbg" Name="ArricchimentoComponenteTIM2OLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Componente TIM2OLO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest!= null &amp;&amp; localRequest.ordine!=null){&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		&#xD;
		//VULAFTTH BitstreamNGAFTTH EASYIPNGAFTTH&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH            //RU_1164&#xD;
        || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
        || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTH &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONGAFTTH &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTH&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
			 &#xD;
			 componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//VULAFTTCAB BitstreamNGAFTTCAB EASYIPNGAFTTCAB&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB)&#xD;
		{&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONGAFTTCAB &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTCAB &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTCAB&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
			&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			&#xD;
			}&#xD;
			&#xD;
			//R1I-20-0131: solo per VULAFTTCAB&#xD;
			else if((componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE&#xD;
					  || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTODISAGGREGAZIONE&#xD;
					  || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PRESTAZIONIAGGIUNTIVE&#xD;
					  || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SLAPLUSSU)&#xD;
				   &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
			{&#xD;
			   componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
			}&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
	 &#xD;
	&#xD;
	//RU_1317: ARRICCHIMENTO GENERICO COMPONENTE ACCESSO -> attributo PROPRIETAMATERIALE&#xD;
	var foundProprietaMateriale = false;&#xD;
	//RU_1390: ARRICCHIMENTO GENERICO COMPONENTE ACCESSO -> attributo FLAGEQUIVALENZAPRODOTTI&#xD;
	var trovatoFlagEquivalenzaProdotti = false;&#xD;
	//RU_1353: ARRICCHIMENTO CARATTERIZZAZIONEGEO NELL'ACCESSO DA CONSISTENZADATI&#xD;
	var foundCaratterizzazioneGeo = false;&#xD;
	//Radius&#xD;
	var foundCluster = false;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{		&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE&#xD;
				   &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
				{&#xD;
					foundProprietaMateriale = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
					Process.auditLog(&quot;Aggiornato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
				}&#xD;
				else if (attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO &#xD;
				   &amp;&amp; ConsistenzaDati != null &amp;&amp; ConsistenzaDati.caratterizzazioneGEO != null)//RU_1353&#xD;
				{&#xD;
					foundCaratterizzazioneGeo = true;&#xD;
					attr.valoreAttributo = ConsistenzaDati.caratterizzazioneGEO;&#xD;
					Process.auditLog(&quot;Aggiornato attributo CARATTERIZZAZIONEGEO con valore: &quot;+ ConsistenzaDati.caratterizzazioneGEO);&#xD;
				}&#xD;
				//RU_1390&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI&#xD;
					   &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
				{&#xD;
					trovatoFlagEquivalenzaProdotti = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
					Process.auditLog(&quot;Aggiornato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
				}&#xD;
				//Radius&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLUSTER&#xD;
					   &amp;&amp; LavorazioneRichiesta.cluster != null)&#xD;
				{&#xD;
					foundCluster = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.cluster;&#xD;
					Process.auditLog(&quot;Aggiornato attributo Cluster con valore: &quot;+ LavorazioneRichiesta.cluster);&#xD;
				}&#xD;
			}&#xD;
						&#xD;
			if(!foundProprietaMateriale &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundProprietaMateriale = true;&#xD;
				Process.auditLog(&quot;Creato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
			}&#xD;
			//RU_1353&#xD;
			if(!foundCaratterizzazioneGeo &amp;&amp; ConsistenzaDati != null &amp;&amp; ConsistenzaDati.caratterizzazioneGEO != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaDati.caratterizzazioneGEO;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundProprietaMateriale = true;&#xD;
				Process.auditLog(&quot;Creato attributo CARATTERIZZAZIONEGEO con valore: &quot;+ ConsistenzaDati.caratterizzazioneGEO);&#xD;
			}&#xD;
			//RU_1390&#xD;
			if(!trovatoFlagEquivalenzaProdotti &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				trovatoFlagEquivalenzaProdotti = true;&#xD;
				Process.auditLog(&quot;Creato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
			}&#xD;
			//Radius&#xD;
			if(!foundCluster &amp;&amp; LavorazioneRichiesta.cluster != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLUSTER;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.cluster;			&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundCluster = true;&#xD;
				Process.auditLog(&quot;Creato attributo CLUSTER con valore: &quot;+ LavorazioneRichiesta.cluster);&#xD;
			}&#xD;
		}		&#xD;
	}&#xD;
&#xD;
//FEA_32918: ARRICCHIMENTO MERCATO PER VULAFTTH e VULAFTTCAB&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
{&#xD;
	var foundMercato = false;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{		&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MERCATO&#xD;
				&amp;&amp; LavorazioneRichiesta.mercato != null)&#xD;
				{&#xD;
					foundMercato = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.mercato;&#xD;
					Process.auditLog(&quot;Aggiornato attributo MERCATO con valore: &quot;+ LavorazioneRichiesta.mercato);&#xD;
				}&#xD;
			}&#xD;
						&#xD;
			if(!foundMercato &amp;&amp; LavorazioneRichiesta.mercato != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MERCATO;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.mercato;			&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundMercato = true;&#xD;
				Process.auditLog(&quot;Creato attributo MERCATO con valore: &quot;+ LavorazioneRichiesta.mercato);&#xD;
			}&#xD;
	&#xD;
	&#xD;
		}		&#xD;
	}&#xD;
}&#xD;
	 	 &#xD;
	 //ARRICCHIMENTO BANDE PICCO PER EASYIPUBB&#xD;
 if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)   //RU_1164&#xD;
 {&#xD;
  for (var i=0; i&lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
  {   &#xD;
   var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
   &#xD;
   if (currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp; EnrichmentBandeOut!= null)&#xD;
   {&#xD;
    Process.auditLog(&quot;Inizio arricchimento BANDEPICCO per USERVLAN EASYIP NGA - Valori da inserire: BANDAPICCOUP &quot;+EnrichmentBandeOut.bandaPiccoUp+&quot; BANDAPICCODOWN &quot;+EnrichmentBandeOut.bandaPiccoDown);&#xD;
    &#xD;
    var foundBANDAPICCOup = false;&#xD;
    var foundBANDAPICCOdown = false;&#xD;
    var j=0;&#xD;
    &#xD;
    while ((!foundBANDAPICCOup || !foundBANDAPICCOdown) &amp;&amp;  j&lt; currentComponente.attributiDettaglioOrdine.size())&#xD;
    {&#xD;
     var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
     &#xD;
     if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
     {&#xD;
      foundBANDAPICCOup=true;&#xD;
      currentAttributo.valoreAttributo = EnrichmentBandeOut.bandaPiccoUp;&#xD;
     }&#xD;
     &#xD;
     else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
     {&#xD;
      foundBANDAPICCOdown=true;&#xD;
      currentAttributo.valoreAttributo = EnrichmentBandeOut.bandaPiccoDown;&#xD;
     }&#xD;
     &#xD;
     &#xD;
    j++;&#xD;
    }&#xD;
    &#xD;
    // CREO GLI ATTRIBUTI SE NON ESISTONO&#xD;
    if (!foundBANDAPICCOup || !foundBANDAPICCOdown)&#xD;
    {&#xD;
     var AttributoBande = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
     &#xD;
     AttributoBande.IDDettaglioOrdine = currentComponente.IDDettaglioOrdine;&#xD;
     AttributoBande.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
     AttributoBande.created = DateTimeUtil.createDatetime();&#xD;
     AttributoBande.lastUpdate = DateTimeUtil.createDatetime();&#xD;
     AttributoBande.operatore = &quot;BPM&quot;;&#xD;
     AttributoBande.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
     &#xD;
     if (!foundBANDAPICCOup)&#xD;
     {&#xD;
      AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP;&#xD;
      AttributoBande.valoreAttributo = EnrichmentBandeOut.bandaPiccoUp;&#xD;
      currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
      Process.auditLog(&quot;Creato attributo BANDAPICCOUP &quot; + EnrichmentBandeOut.bandaPiccoUp);&#xD;
      &#xD;
     }&#xD;
     if (!foundBANDAPICCOdown)&#xD;
     {&#xD;
      AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN;&#xD;
      AttributoBande.valoreAttributo = EnrichmentBandeOut.bandaPiccoDown;&#xD;
      currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
      Process.auditLog(&quot;Creato attributo BANDAPICCODOWN &quot; + EnrichmentBandeOut.bandaPiccoDown);&#xD;
     }&#xD;
 &#xD;
    }&#xD;
  &#xD;
   &#xD;
   }&#xD;
  }&#xD;
 }&#xD;
&#xD;
&#xD;
&#xD;
//R1I-20-0131: aggiunto arricchimento ATI e IMPRESAADCENTRALE solo per VULAFTTCAB&#xD;
var trovataAti = false;                   &#xD;
var trovataImpresaAdCentrale = false; &#xD;
&#xD;
//SM_9486&#xD;
var trovataDisaggregazione = false;&#xD;
var trovataAppuntamentoDisaggregazione = false;&#xD;
var trovataPrestazioniAggiuntive = false;&#xD;
var OwnerPresaAppuntamento = &quot;&quot;; &#xD;
var FlagPrestazioneAggiuntiva = &quot;&quot;;&#xD;
OwnerPresaAppuntamento = null;  &#xD;
FlagPrestazioneAggiuntiva = null;    &#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
{&#xD;
	for(var i= 0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE)&#xD;
		{&#xD;
			trovataDisaggregazione = true;   //SM_9486&#xD;
			var j=0;&#xD;
			&#xD;
			while((!trovataAti || !trovataImpresaAdCentrale) &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ATI&#xD;
				   &amp;&amp; Ati != null)&#xD;
				{&#xD;
					attributo.valoreAttributo = Ati;&#xD;
					trovataAti = true; &#xD;
					&#xD;
					Process.auditLog(&quot;Trovato attributo ATI &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IMPRESAADCENTRALE&#xD;
				        &amp;&amp; ImpresaAdCentrale != null)&#xD;
				{&#xD;
					attributo.valoreAttributo = ImpresaAdCentrale;&#xD;
					trovataImpresaAdCentrale = true; &#xD;
					&#xD;
					Process.auditLog(&quot;Trovato attributo IMPRESAADCENTRALE &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
&#xD;
			if(!trovataAti &amp;&amp; Ati != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ATI;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = Ati;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				&#xD;
				Process.auditLog(&quot;Creato attributo ATI &quot;+ Ati +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			if(!trovataImpresaAdCentrale &amp;&amp; ImpresaAdCentrale != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IMPRESAADCENTRALE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ImpresaAdCentrale;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				&#xD;
				Process.auditLog(&quot;Creato attributo IMPRESAADCENTRALE &quot;+ ImpresaAdCentrale +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		&#xD;
		}&#xD;
		&#xD;
		//SM_9486: componente APPUNTAMENTODISAGGREGAZIONE per VULAFTTCAB&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTODISAGGREGAZIONE&#xD;
		        &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
		{&#xD;
			trovataAppuntamentoDisaggregazione = true;&#xD;
			var j=0;&#xD;
			&#xD;
			while(OwnerPresaAppuntamento == null &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OWNERPRESAAPPUNTAMENTO)&#xD;
				{&#xD;
					OwnerPresaAppuntamento = attr.valoreAttributo; &#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//SM_9486: componente PRESTAZIONIAGGIUNTIVE per VULAFTTCAB&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PRESTAZIONIAGGIUNTIVE&#xD;
		        &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
		{&#xD;
			trovataPrestazioniAggiuntive = true;&#xD;
			var j=0;&#xD;
			&#xD;
			while(FlagPrestazioneAggiuntiva == null &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGPRESTAZIONEAGGIUNTIVA)&#xD;
				{&#xD;
					FlagPrestazioneAggiuntiva = attr.valoreAttributo; &#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
&#xD;
//SM_9486: arricchimento TIPODISAGGREGAZIONE e PRESTAZIONIAGGIUNTIVE della componente DISAGGREGAZIONE solo per VULAFTTCAB&#xD;
//LOGICA PER ARRICCHIMENTO&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
   &amp;&amp; localRequest.disaggregato == &quot;S&quot;)&#xD;
{&#xD;
	var TIPODISAGGREGAZIONE = &quot;&quot;;&#xD;
	var PRESTAZIONIAGGIUNTIVE = &quot;&quot;;&#xD;
	TIPODISAGGREGAZIONE = null;&#xD;
	PRESTAZIONIAGGIUNTIVE = null;&#xD;
&#xD;
	var foundTIPODISAGGREGAZIONE = false;&#xD;
	var foundPRESTAZIONIAGGIUNTIVE = false;&#xD;
&#xD;
	//SM_9551: Ricerca del REFERENTEONFIELD&#xD;
	var foundREFERENTEONFIELD = false;&#xD;
&#xD;
	if(localRequest.ordine != null &amp;&amp; localRequest.ordine.referente != null &amp;&amp; localRequest.ordine.referente.size() > 0) &#xD;
	{	&#xD;
		for(var m=0; m&lt;localRequest.ordine.referente.size(); m++)&#xD;
		{&#xD;
			var currentreferente = localRequest.ordine.referente.get(m);&#xD;
			&#xD;
			if(currentreferente.tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTEONFIELD)&#xD;
			{&#xD;
				foundREFERENTEONFIELD = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	//Logica di arricchimento&#xD;
	if(localRequest.exDisaggregato == &quot;S&quot;)&#xD;
	{&#xD;
		TIPODISAGGREGAZIONE = &quot;OL richiesto come disaggregato ma lavorato da TIM&quot;;&#xD;
		PRESTAZIONIAGGIUNTIVE = &quot;NO&quot;;&#xD;
	}&#xD;
	else if((OwnerPresaAppuntamento != null &amp;&amp; (OwnerPresaAppuntamento == &quot;OP&quot; || OwnerPresaAppuntamento == &quot;SU&quot;))&#xD;
			|| foundREFERENTEONFIELD                        //SM_9551: aggiunta condizione sul REFERENTEONFIELD&#xD;
			|| FlagPrestazioneAggiuntiva != null)&#xD;
	{&#xD;
		TIPODISAGGREGAZIONE = &quot;OL disaggregato con prestazioni aggiuntive&quot;;&#xD;
		PRESTAZIONIAGGIUNTIVE = &quot;SI&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		TIPODISAGGREGAZIONE = &quot;OL disaggregato senza prestazioni aggiuntive&quot;;&#xD;
		PRESTAZIONIAGGIUNTIVE = &quot;NO&quot;;&#xD;
	}&#xD;
&#xD;
&#xD;
	//ARRICCHIMENTO&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE)&#xD;
		{&#xD;
			var j=0;&#xD;
			&#xD;
			while((!foundTIPODISAGGREGAZIONE || !foundPRESTAZIONIAGGIUNTIVE) &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODISAGGREGAZIONE&#xD;
				   &amp;&amp; TIPODISAGGREGAZIONE != null)&#xD;
				{&#xD;
					foundTIPODISAGGREGAZIONE = true;&#xD;
					attr.valoreAttributo = TIPODISAGGREGAZIONE;&#xD;
					Process.auditLog(&quot;Valorizzato TIPODISAGGREGAZIONE: &quot;+ TIPODISAGGREGAZIONE +&quot; della componente DISAGGREGAZIONE&quot;);&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PRESTAZIONIAGGIUNTIVE&#xD;
						&amp;&amp; PRESTAZIONIAGGIUNTIVE != null)&#xD;
				{&#xD;
					foundPRESTAZIONIAGGIUNTIVE = true;&#xD;
					attr.valoreAttributo = PRESTAZIONIAGGIUNTIVE;&#xD;
					Process.auditLog(&quot;Valorizzato PRESTAZIONIAGGIUNTIVE: &quot;+ PRESTAZIONIAGGIUNTIVE +&quot; della componente DISAGGREGAZIONE&quot;);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
						&#xD;
			if(!foundTIPODISAGGREGAZIONE &amp;&amp; TIPODISAGGREGAZIONE != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODISAGGREGAZIONE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = TIPODISAGGREGAZIONE;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundTIPODISAGGREGAZIONE = true;&#xD;
			}&#xD;
			&#xD;
			if(!foundPRESTAZIONIAGGIUNTIVE &amp;&amp; PRESTAZIONIAGGIUNTIVE != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PRESTAZIONIAGGIUNTIVE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = PRESTAZIONIAGGIUNTIVE;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundPRESTAZIONIAGGIUNTIVE = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
 &#xD;
} &#xD;
&#xD;
&#xD;
