        <xpdl2:Activity Id="_UHqQQTutEeeZ39LxwlPLcQ" Name="AggiornaComponenteAttivazione" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna Componente Attivazione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var ora = DateTimeUtil.createDatetime();&#xD;
&#xD;
if(localRequest!= null &amp;&amp; localRequest.ordine!=null)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		//BitstreamATMSimmetricoFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMSIMFLAT || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PROTOCOLLO){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//BitstreamATMSimmetricoHL&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMSIMHL || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PROTOCOLLO){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//BitstreamGBESimmetricoFlat&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOGBESIMFLAT || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN )&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
			if (componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM)&#xD;
			{&#xD;
				var foundCodiceModem = false;&#xD;
				var j=0;&#xD;
				while( !foundCodiceModem &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attributo= componente.attributiDettaglioOrdine.get(j);&#xD;
					if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE)&#xD;
					{&#xD;
						foundCodiceModem=true;&#xD;
						if( attributo.valoreAttributo == &quot;M00&quot;)&#xD;
						{&#xD;
							componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
				j++;	&#xD;
				}&#xD;
				&#xD;
				if (!foundCodiceModem)&#xD;
				{&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
				}&#xD;
				&#xD;
			}&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//RU_1317: ARRICCHIMENTO GENERICO COMPONENTE ACCESSO -> attributo PROPRIETAMATERIALE&#xD;
	if(LavorazioneRichiesta != null)&#xD;
	{&#xD;
		var foundProprietaMateriale = false;&#xD;
		var trovatoFlagEquivalenzaProdotti = false; //RU_1390&#xD;
		&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{		&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE&#xD;
					   &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
					{&#xD;
						foundProprietaMateriale = true;&#xD;
						attr.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
						Process.auditLog(&quot;Aggiornato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
					}&#xD;
					&#xD;
					//RU_1390&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI&#xD;
					   &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
					{&#xD;
						trovatoFlagEquivalenzaProdotti = true;&#xD;
						attr.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
						Process.auditLog(&quot;Aggiornato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
					}&#xD;
				}&#xD;
							&#xD;
				if(!foundProprietaMateriale &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
				{&#xD;
					var ora = DateTimeUtil.createDatetime();&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
					attributo.created = ora;&#xD;
					attributo.lastUpdate = ora;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE;&#xD;
					attributo.operatore = componente.operatore;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
					&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					foundProprietaMateriale = true;&#xD;
					Process.auditLog(&quot;Creato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
				}&#xD;
				&#xD;
				//RU_1390&#xD;
				if(!trovatoFlagEquivalenzaProdotti &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
				{&#xD;
					var ora = DateTimeUtil.createDatetime();&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
					attributo.created = ora;&#xD;
					attributo.lastUpdate = ora;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI;&#xD;
					attributo.operatore = componente.operatore;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
					&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					foundProprietaMateriale = true;&#xD;
					Process.auditLog(&quot;Creato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
				}&#xD;
			}		&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			var foundProtocolloPila = false;&#xD;
			var j = 0;&#xD;
			&#xD;
			while(!foundProtocolloPila &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA)&#xD;
				{&#xD;
					foundProtocolloPila = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
						&#xD;
			&#xD;
			if(!foundProtocolloPila)&#xD;
			{&#xD;
				var updated = false;&#xD;
				var j = 0;&#xD;
				&#xD;
				while(!updated &amp;&amp; j &lt; protocolloPila.size())&#xD;
				{&#xD;
					var currentProtocollo = protocolloPila.get(j);&#xD;
					&#xD;
					if(currentProtocollo.IDDettaglioOrdine == currentDettOrdine.IDDettaglioOrdine)&#xD;
					{&#xD;
						var att = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						&#xD;
						att.IDDettaglioOrdine = currentProtocollo.IDDettaglioOrdine;&#xD;
						att.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						att.created = ora;&#xD;
						att.lastUpdate = ora;&#xD;
						att.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA;&#xD;
						att.operatore = &quot;BPM&quot;;&#xD;
						att.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						att.valoreAttributo = currentProtocollo.protocolloPilaDefault;&#xD;
						&#xD;
						currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(att));&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
