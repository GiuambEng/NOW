        <xpdl2:Activity Id="_oVrkwtwDEeadQ_2wWDDNtA" Name="ArricchimentoDettaglioOrdine" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">/*Funzione C02M10F03 C02M08F03 C02M09F03  S6*/&#xD;
if(AssetRef != null)&#xD;
{&#xD;
	var TECNOLOGIADELIVERY=&quot;&quot;;&#xD;
	var asset = AssetRef.readAsset();&#xD;
	var date = DateTimeUtil.createDatetime();&#xD;
	var idDettOrdineL1 = 0;&#xD;
	var y = 0;&#xD;
	&#xD;
	var OpzioneDinamica= asset.opzioneDinamica;&#xD;
	&#xD;
	&#xD;
	//controllo esistenza asset in input&#xD;
	if(asset.dettaglioasset !=null &amp;&amp; asset.dettaglioasset.size() > 0)&#xD;
	{&#xD;
	 //controllo esistenza ordine nella richiesta&#xD;
		if(localRequest.ordine == null)&#xD;
		{&#xD;
			//creo ordine se non c'è&#xD;
			var ordine = it_telecomitalia_it_NOW_casedata_Factory.createOrdine();&#xD;
			&#xD;
			ordine.created = date;&#xD;
			ordine.codificaOLONOW = localRequest.codificaOLONOW;&#xD;
			ordine.codificaOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
			ordine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			ordine.tipologiaLavorazione = localRequest.lavorazione;&#xD;
			ordine.offerta = localRequest.offerta;&#xD;
			localRequest.ordine = ScriptUtil.copy(ordine);&#xD;
		}&#xD;
		&#xD;
		for(var i = 0; i &lt; asset.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			//arricchimento del dettaglio dell'ordine con il dettaglio dell'Asset&#xD;
			var currentDettAsset = asset.dettaglioasset.get(i);&#xD;
			&#xD;
			// Controllo OFFERTA e COMPONENTI come da SF&#xD;
			if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMASIMFLAT ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)|| //RU_1373&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)) &#xD;
			  &#xD;
			  ||&#xD;
			  &#xD;
			  (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMASIMHL ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)|| //RU_1373			 &#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA))&#xD;
			  &#xD;
			  ||&#xD;
			  &#xD;
			  (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMASIMLITE ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)|| //RU_1373&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA))&#xD;
			  &#xD;
			  ||&#xD;
			  &#xD;
			  (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOGBEASIMFLAT ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)|| //RU_1373&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA))	  &#xD;
			  &#xD;
			  ||&#xD;
			  &#xD;
			  (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPBASEPLUSLITE ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)|| //RU_1373&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA))&#xD;
			  &#xD;
			  ||&#xD;
			  &#xD;
			  (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPBASEPLUSFLAT ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)|| //RU_1373&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA))&#xD;
			  &#xD;
			  ||&#xD;
			  &#xD;
			  (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPSPECIALPROFILELITE ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)|| //RU_1373&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA))&#xD;
				 &#xD;
			  ||&#xD;
			  &#xD;
			  ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
			      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
				  ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA) &amp;&amp;    //RU_1543&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONGAFTTH ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO))) //RU_1373&#xD;
				&#xD;
			  &#xD;
			  ||&#xD;
			  &#xD;
			  ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
			     ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
				 ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS) &amp;&amp;      //RU_1543&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTH ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO))) //RU_1373&#xD;
			  &#xD;
			  ||&#xD;
			  &#xD;
			  (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTCAB ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO) || //RU_1373&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA))&#xD;
			  &#xD;
			  ||&#xD;
			  &#xD;
			  (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONGAFTTCAB ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO) || //RU_1373&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA))&#xD;
			  &#xD;
			  ||&#xD;
			  &#xD;
			  (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPSPECIALPROFILEFLAT ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)|| //RU_1373&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA))&#xD;
				 &#xD;
			  ||&#xD;
			  &#xD;
			  (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMSIMFLAT ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)|| //RU_1373&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PROTOCOLLO))&#xD;
				 &#xD;
			  ||&#xD;
			  &#xD;
			  (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMSIMHL ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)|| //RU_1373&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM ||&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PROTOCOLLO))&#xD;
			||&#xD;
				 &#xD;
			(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTCAB ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO))) //RU_1373&#xD;
				 &#xD;
			||&#xD;
				 &#xD;
			((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
			   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH) &amp;&amp;    //RU_1164&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTH ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO))) //RU_1373 &#xD;
				 &#xD;
			||&#xD;
			  &#xD;
			  (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT &amp;&amp;&#xD;
				(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOGBESIMFLAT ||&#xD;
				 (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO) || //RU_1373&#xD;
				 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM))) &#xD;
			&#xD;
			{&#xD;
				var dettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
				&#xD;
				dettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				dettOrdine.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
				dettOrdine.created = date;&#xD;
				dettOrdine.lastUpdate = date;&#xD;
				dettOrdine.operatore = &quot;BPM&quot;;&#xD;
				dettOrdine.IDRisorsa = currentDettAsset.IDRisorsa;&#xD;
				dettOrdine.nomeComponente = currentDettAsset.nomeComponente;&#xD;
				dettOrdine.integrationID = localRequest.IDRichiestaOLO + dettOrdine.IDDettaglioOrdine;&#xD;
				dettOrdine.progressivo = currentDettAsset.progressivo;&#xD;
				dettOrdine.IDRisorsaNOW = currentDettAsset.IDRisorsaNOW;&#xD;
				&#xD;
				if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
				{&#xD;
					dettOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
				}else&#xD;
				{&#xD;
					dettOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
				}&#xD;
				&#xD;
				if((String(currentDettAsset.nomeComponente).slice(0,7)) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					&#xD;
					idDettOrdineL1 = dettOrdine.IDDettaglioOrdine;&#xD;
					&#xD;
					if(y > 0){&#xD;
						for(var k = 0; k &lt; y; k++){&#xD;
							//Inserire nei dettagli ordini delle componenti di livello 2 l'id dettaglio parent e root&#xD;
							localRequest.ordine.dettaglioordine.get(localRequest.ordine.dettaglioordine.size()-k).IDDettaglioOrdineParent = idDettOrdineL1;&#xD;
							localRequest.ordine.dettaglioordine.get(localRequest.ordine.dettaglioordine.size()-k).IDDettaglioOrdineRoot = idDettOrdineL1;&#xD;
						}&#xD;
						y = 0;&#xD;
					}&#xD;
				&#xD;
				}else&#xD;
				{&#xD;
					&#xD;
					if(idDettOrdineL1 != 0 &amp;&amp; y == 0){&#xD;
						&#xD;
						dettOrdine.IDDettaglioOrdineParent = idDettOrdineL1;&#xD;
						dettOrdine.IDDettaglioOrdineRoot = idDettOrdineL1;&#xD;
					&#xD;
					}else{&#xD;
						&#xD;
						y = y + 1;&#xD;
						&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//inserisco in accesso opzione dinamica se esiste&#xD;
				&#xD;
				&#xD;
&#xD;
				&#xD;
				for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
				{&#xD;
				&#xD;
					var currentAttribDettAss = currentDettAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					//Solo gli attributi come da SFN&#xD;
					if&#xD;
					(	&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEVP ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAUSERVLAN ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUOVOMODELLO ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING ||						&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIA ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIADELIVERY ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MODULAZIONE ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.GESTIONEPRODOTTO ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDPROFILOVC ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDACONSEGNA ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TRASPORTO ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETD ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAVC ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INTERFACCIA ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPDSLAM ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOTRASPORTO ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPKIT ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MODALITACONSEGNA ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPRODOTTOMODEM ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONE ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROTOCOLLO ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLMI ||&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SEMIFIBRAFTTH ||   //SM_10080&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST ||     //SM_10350&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVLAN ||  //RU_1502&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FULLGPONPLUS ||   //SM_11616&#xD;
						currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AREA)&#xD;
					{&#xD;
						&#xD;
						&#xD;
						var attribDettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						&#xD;
							&#xD;
							&#xD;
							if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
								|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL&#xD;
								|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)&#xD;
							{&#xD;
									if(currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIADELIVERY)&#xD;
									{&#xD;
										TECNOLOGIADELIVERY = currentAttribDettAss.valoreAttributo;&#xD;
										&#xD;
										Process.auditLog(&quot;Trovato in asset TECNOLOGIADELIVERY = &quot;+ TECNOLOGIADELIVERY);&#xD;
									}&#xD;
									&#xD;
									else&#xD;
									{&#xD;
										&#xD;
										attribDettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
										attribDettOrdine.IDDettaglioOrdine = dettOrdine.IDDettaglioOrdine;&#xD;
										attribDettOrdine.tipologiaDato = currentAttribDettAss.tipologiaDato;&#xD;
										attribDettOrdine.created = date;&#xD;
										attribDettOrdine.lastUpdate = date;&#xD;
										attribDettOrdine.operatore = &quot;BPM&quot;;&#xD;
										&#xD;
										attribDettOrdine.nomeAttributo = currentAttribDettAss.nomeAttributo;&#xD;
										attribDettOrdine.valoreAttributo = currentAttribDettAss.valoreAttributo;&#xD;
										dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
									}&#xD;
									&#xD;
									&#xD;
							}&#xD;
							&#xD;
							&#xD;
							&#xD;
							else&#xD;
							{&#xD;
								attribDettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
								attribDettOrdine.IDDettaglioOrdine = dettOrdine.IDDettaglioOrdine;&#xD;
								attribDettOrdine.tipologiaDato = currentAttribDettAss.tipologiaDato;&#xD;
								attribDettOrdine.created = date;&#xD;
								attribDettOrdine.lastUpdate = date;&#xD;
								attribDettOrdine.operatore = &quot;BPM&quot;;&#xD;
								&#xD;
								attribDettOrdine.nomeAttributo = currentAttribDettAss.nomeAttributo;&#xD;
								attribDettOrdine.valoreAttributo = currentAttribDettAss.valoreAttributo;&#xD;
								dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
							}&#xD;
						&#xD;
						&#xD;
					}//end if&#xD;
						&#xD;
				}//end for j&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettOrdine));&#xD;
&#xD;
				&#xD;
			}//end if&#xD;
			else{&#xD;
				Process.auditLog(&quot;Nessuna Offerta o Componente da cessare per IDRichiesta&quot; + localRequest.IDRichiestaOLO + &quot; ed Asset: &quot; + asset.IDAsset);&#xD;
			}&#xD;
		}//end for i&#xD;
		&#xD;
		&#xD;
		//SM 6755 - SOLO SIMMETRICI  -  attributo TECNOLOGIA nell'ordine= Valorizzato con TECNOLOGIADELIVERY in asset se presente, altrimenti con TECNOLOGIA &#xD;
				&#xD;
					&#xD;
		if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT) &#xD;
			&amp;&amp; TECNOLOGIADELIVERY!= &quot;&quot;)&#xD;
		{&#xD;
				var foundTECNOLOGIA = false;&#xD;
			&#xD;
				for(var h = 0; h &lt; localRequest.ordine.dettaglioordine.size(); h++)&#xD;
				{&#xD;
					var currentComponente = localRequest.ordine.dettaglioordine.get(h);&#xD;
					&#xD;
					if (String(currentComponente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						var k=0;&#xD;
						&#xD;
						while ( !foundTECNOLOGIA &amp;&amp; k &lt; currentComponente.attributiDettaglioOrdine.size())&#xD;
						{&#xD;
							var currentAttributo = currentComponente.attributiDettaglioOrdine.get(k);&#xD;
						&#xD;
							if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIA)&#xD;
							{&#xD;
								//assegno a TECNOLOGIA il valore di TECNOCLOGIADELIVERY&#xD;
								&#xD;
								currentAttributo.valoreAttributo=TECNOLOGIADELIVERY;&#xD;
								&#xD;
								Process.auditLog(&quot;Modificato valore di TECNOLOGIA con quello di TECNOLOGIADELIVERY in asset = &quot;+ TECNOLOGIADELIVERY);&#xD;
								&#xD;
								foundTECNOLOGIA = true;&#xD;
							}&#xD;
							&#xD;
						k++;&#xD;
						}&#xD;
						&#xD;
						&#xD;
						if (!foundTECNOLOGIA)&#xD;
						{&#xD;
						&#xD;
							//creo TECNOLOGIA con il valore di TECNOLOGIADELIVERY&#xD;
							&#xD;
							var attribDettaglioOrdine = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
							&#xD;
							attribDettaglioOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							attribDettaglioOrdine.IDDettaglioOrdine = currentComponente.IDDettaglioOrdine;&#xD;
							attribDettaglioOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							attribDettaglioOrdine.created = date;&#xD;
							attribDettaglioOrdine.lastUpdate = date;&#xD;
							attribDettaglioOrdine.operatore = &quot;BPM&quot;;&#xD;
							attribDettaglioOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIA;&#xD;
							attribDettaglioOrdine.valoreAttributo = TECNOLOGIADELIVERY;&#xD;
							&#xD;
							localRequest.ordine.dettaglioordine.get(h).attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettaglioOrdine));&#xD;
							&#xD;
							Process.auditLog(&quot;Creato attributo TECNOLOGIA con il valore di TECNOLOGIADELIVERY in asset &quot; + TECNOLOGIADELIVERY);&#xD;
						}&#xD;
					&#xD;
						&#xD;
					}&#xD;
					&#xD;
				}&#xD;
				&#xD;
		}&#xD;
			&#xD;
				&#xD;
			&#xD;
			&#xD;
	&#xD;
		&#xD;
		//PROTOCOLLO PILA PER CESSAZIONI GBE ASIMM FLAT (SM_6577)&#xD;
		&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT)&#xD;
		{&#xD;
			var trovatoPila=false;&#xD;
			&#xD;
			for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
			{&#xD;
				var currentDettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
				if(currentDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
				{&#xD;
					&#xD;
					var j=0;&#xD;
					while(!trovatoPila &amp;&amp; j &lt; currentDettOrd.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currentAttDettOrd = currentDettOrd.attributiDettaglioOrdine.get(j);&#xD;
						if(currentAttDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA)&#xD;
						{&#xD;
							trovatoPila = true;&#xD;
							&#xD;
							if(currentAttDettOrd.valoreAttributo == null || currentAttDettOrd.valoreAttributo == &quot;&quot;)&#xD;
							{&#xD;
								currentAttDettOrd.valoreAttributo='IPoE'; //se l'attributo è presente ma non valorizzato si stabilisce il valore di defaul IPoE&#xD;
							}&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					// se non viene reperito il protocollo pila dalla consistenza si crea con valore IPoE&#xD;
					if(!trovatoPila)&#xD;
					{&#xD;
					&#xD;
							var Attdettaglio = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
							&#xD;
																		&#xD;
									Attdettaglio.IDDettaglioOrdine = currentDettOrd.IDDettaglioOrdine;&#xD;
									Attdettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
									Attdettaglio.created = DateTimeUtil.createDatetime();&#xD;
									Attdettaglio.lastUpdate = DateTimeUtil.createDatetime();&#xD;
									Attdettaglio.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA;&#xD;
									Attdettaglio.operatore = &quot;BPM&quot;;&#xD;
									Attdettaglio.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
									Attdettaglio.valoreAttributo = &quot;IPoE&quot;;&#xD;
									&#xD;
									localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(Attdettaglio));&#xD;
								&#xD;
										&#xD;
					}				&#xD;
				}&#xD;
			&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		// CREO IN ACCESSO OPZIONE DINAMICA&#xD;
		if ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB || &#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT) &amp;&amp; OpzioneDinamica != null)&#xD;
		{&#xD;
			for(var h = 0; h &lt; localRequest.ordine.dettaglioordine.size(); h++)&#xD;
			{&#xD;
					var currentComponente = localRequest.ordine.dettaglioordine.get(h);&#xD;
					&#xD;
					if (String(currentComponente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
							var attribDettaglioOrdine = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
							&#xD;
							attribDettaglioOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							attribDettaglioOrdine.IDDettaglioOrdine = currentComponente.IDDettaglioOrdine;&#xD;
							attribDettaglioOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							attribDettaglioOrdine.created = date;&#xD;
							attribDettaglioOrdine.lastUpdate = date;&#xD;
							attribDettaglioOrdine.operatore = &quot;BPM&quot;;&#xD;
							attribDettaglioOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONEDINAMICA;&#xD;
							attribDettaglioOrdine.valoreAttributo = OpzioneDinamica;&#xD;
							&#xD;
							localRequest.ordine.dettaglioordine.get(h).attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettaglioOrdine));&#xD;
							&#xD;
							Process.auditLog(&quot;Creato attributo OPZIONEDINAMICA con il valore in asset &quot; + OpzioneDinamica);&#xD;
					}&#xD;
			}&#xD;
			&#xD;
		}&#xD;
		&#xD;
		&#xD;
		&#xD;
	}&#xD;
	else{&#xD;
		Process.auditLog(&quot;Impossibile completare la funzione di arricchimento: Asset o DettagliAsset inesistenti per IDRichiesta &quot; + localRequest.IDRichiestaOLO + &quot; ed Asset: &quot; + asset.IDAsset);&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Impossibile completare la funzione di arricchimento: Impossibile trovare l'Asset di riferimento per IDRichiesta &quot; + localRequest.IDRichiestaOLO);&#xD;
}&#xD;
&#xD;
&#xD;
//C01M02F12 Recupero DISTRETTO/IDCONTRATTO/CLIENTE/NUMEROFITTIZIO/IDOPERATORERETE DA ASSET&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		var asset = AssetRef.readAsset();&#xD;
		if (asset.distretto != null &amp;&amp; asset.distretto.length > 0)&#xD;
		{&#xD;
			localRequest.ordine.distretto = asset.distretto;&#xD;
		}&#xD;
		if (asset.IDContratto != null)&#xD;
		{&#xD;
			localRequest.IDContratto = asset.IDContratto;&#xD;
		}&#xD;
		if (asset.numeroFittizio != null &amp;&amp; asset.numeroFittizio.length > 0)&#xD;
		{&#xD;
			localRequest.ordine.numeroFittizio = asset.numeroFittizio;&#xD;
		}		&#xD;
		&#xD;
		if(asset.cliente != null 									&#xD;
			&amp;&amp; localRequest.ordine.nome == null &#xD;
			&amp;&amp; localRequest.ordine.cognomeRagioneSociale == null &#xD;
			&amp;&amp; localRequest.ordine.CF == null&#xD;
			&amp;&amp; localRequest.ordine.PIVA == null)  //Task #38239&#xD;
		{&#xD;
			if (asset.cliente.nome != null &amp;&amp; (localRequest.ordine.nome == null || localRequest.ordine.nome == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.nome = asset.cliente.nome;&#xD;
			}		&#xD;
			if (asset.cliente.cognomeRagioneSociale != null &amp;&amp; (localRequest.ordine.cognomeRagioneSociale == null || localRequest.ordine.cognomeRagioneSociale == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.cognomeRagioneSociale = asset.cliente.cognomeRagioneSociale;&#xD;
			}&#xD;
			&#xD;
			//SM_10686: Spostato arricchimento dei due campi qui invece che negli arricchimenti comuni&#xD;
			//CF e PIVA sono mutuamente esclusivi e non vanno arricchiti se uno dei due è indicato in input dall'OLO&#xD;
			if(localRequest.ordine.CF == null &amp;&amp; localRequest.ordine.PIVA == null)&#xD;
			{				&#xD;
				localRequest.ordine.CF = Asset.cliente.codiceFiscale;&#xD;
				localRequest.ordine.PIVA = Asset.cliente.partitaIVA;			&#xD;
			}&#xD;
		}&#xD;
		if(asset.numeroTelefonico != null)&#xD;
		{&#xD;
			localRequest.ordine.numeroTelefonico = asset.numeroTelefonico;&#xD;
		}&#xD;
		if(asset.operatoreRete != null)&#xD;
		{&#xD;
			localRequest.operatoreRete = asset.operatoreRete;&#xD;
			localRequest.ordine.operatoreRete = asset.operatoreRete;&#xD;
			&#xD;
			if(localRequest.operatoreRete == 'FF' &amp;&amp; localRequest.idProgressivoNotificheFF == null)&#xD;
			{&#xD;
				localRequest.idProgressivoNotificheFF = 1;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
// Arricchimento da LavorazioneRichiesta, introdotto con Agesp R1I-19-0179 per attributo RITIROPRODOTTI&#xD;
if(LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.ritiroProdotti != null)&#xD;
{&#xD;
	Process.auditLog(&quot;Arricchimento Ritiro prodotti: &quot;+LavorazioneRichiesta.ritiroProdotti);&#xD;
	&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		var foundRitiroProdotti = false;&#xD;
		&#xD;
		if(currentDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMSIMFLAT&#xD;
		|| currentDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOATMSIMHL&#xD;
		|| currentDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOGBESIMFLAT)&#xD;
		{&#xD;
			var j = 0;&#xD;
			&#xD;
			// Se presente RITIROPRODOTTI lo sostituisco&#xD;
			while(!foundRitiroProdotti &amp;&amp; j &lt; currentDettOrd.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrd = currentDettOrd.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RITIROPRODOTTI)&#xD;
				{&#xD;
					foundRitiroProdotti = true;&#xD;
					&#xD;
					currentAttDettOrd.valoreAttributo = LavorazioneRichiesta.ritiroProdotti;&#xD;
					Process.auditLog(&quot;Sostituito Ritiro prodotti: &quot;+LavorazioneRichiesta.ritiroProdotti);&#xD;
				}&#xD;
				&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			// Se non presente RITIROPRODOTTI lo aggiungo&#xD;
			if(!foundRitiroProdotti)&#xD;
			{&#xD;
				var Attdettaglio = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
										&#xD;
				Attdettaglio.IDDettaglioOrdine = currentDettOrd.IDDettaglioOrdine;&#xD;
				Attdettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				Attdettaglio.created = DateTimeUtil.createDatetime();&#xD;
				Attdettaglio.lastUpdate = DateTimeUtil.createDatetime();&#xD;
				Attdettaglio.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RITIROPRODOTTI;&#xD;
				Attdettaglio.operatore = &quot;BPM&quot;;&#xD;
				Attdettaglio.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				Attdettaglio.valoreAttributo = LavorazioneRichiesta.ritiroProdotti;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(Attdettaglio));	&#xD;
				Process.auditLog(&quot;Aggiunto Ritiro prodotti: &quot;+LavorazioneRichiesta.ritiroProdotti);		&#xD;
			}	&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//RU_1317: aggiunto arricchimento di PROPRIETAMATERIALE&#xD;
&#xD;
//SM_9499: per alcune CESSAZIONI, nel momento in cui chiamiamo DETERMINACLUSTER non abbiamo ancora l'accesso, quindi ci perderemmo l'arricchimento di TIPOLOGIACLUSTERCOMUNE&#xD;
// Per quelle Cessazioni facciamo qui l'arricchimento e non nel complete script del controllo DETERMINA CLUSTER_C01M02F26&#xD;
//verifico se DeterminaCluster ha restituito tipologia cluster&#xD;
var foundTipologiaCluster = false;&#xD;
var foundProprietaMateriale = false;&#xD;
var trovatoFlagEquivalenzaProdotti = false; //RU_1390&#xD;
var foundClusterRadius = false; //RU_1614&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		//se già presente nell'ordine lo sovrascrivo&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var x = 0;&#xD;
			&#xD;
			while((!foundTipologiaCluster || !foundProprietaMateriale || !trovatoFlagEquivalenzaProdotti || !foundClusterRadius) &amp;&amp; x&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(x);&#xD;
				&#xD;
				if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE&#xD;
				  &amp;&amp; TipologiaClusterComune != null &amp;&amp; TipologiaClusterComune != &quot;&quot;)&#xD;
				{&#xD;
					foundTipologiaCluster = true;&#xD;
					currentAttributo.valoreAttributo = TipologiaClusterComune;&#xD;
				}&#xD;
				//RU_1317&#xD;
				else if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE&#xD;
				  &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
				{&#xD;
					foundProprietaMateriale = true;&#xD;
					currentAttributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
				}&#xD;
				//RU_1390&#xD;
				else if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI&#xD;
				  &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
				{&#xD;
					trovatoFlagEquivalenzaProdotti = true;&#xD;
					currentAttributo.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
				}&#xD;
				//RU_1614&#xD;
				else if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLUSTER&#xD;
				  &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.cluster != null)&#xD;
				{&#xD;
					foundClusterRadius = true;&#xD;
					currentAttributo.valoreAttributo = LavorazioneRichiesta.cluster;&#xD;
				}&#xD;
				x++;&#xD;
			}&#xD;
			&#xD;
			// se non presente nell'ordine lo aggiungo&#xD;
			if(!foundTipologiaCluster &amp;&amp; TipologiaClusterComune != null &amp;&amp; TipologiaClusterComune != &quot;&quot;)&#xD;
			{&#xD;
				var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE;&#xD;
				nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				nuovoAttributo.valoreAttributo = TipologiaClusterComune;&#xD;
				nuovoAttributo.operatore = localRequest.operatore;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
				Process.auditLog(&quot;Aggiunto TIPOLOGIACLUSTERCOMUNE post controllo&quot;);&#xD;
			}&#xD;
			&#xD;
			//RU_1317&#xD;
			if(!foundProprietaMateriale &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
			{&#xD;
				var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE;&#xD;
				nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				nuovoAttributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
				nuovoAttributo.operatore = localRequest.operatore;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
				Process.auditLog(&quot;Aggiunto PROPRIETAMATERIALE con valore: &quot; + LavorazioneRichiesta.proprietaMateriale);&#xD;
			}&#xD;
			&#xD;
			//RU_1390&#xD;
			if(!trovatoFlagEquivalenzaProdotti &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
			{&#xD;
				var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI;&#xD;
				nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				nuovoAttributo.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
				nuovoAttributo.operatore = localRequest.operatore;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
				Process.auditLog(&quot;Aggiunto FLAGEQUIVALENZAPRODOTTI con valore: &quot; + LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
			}&#xD;
			//RU_1614&#xD;
			if(!foundClusterRadius &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.cluster != null)&#xD;
			{&#xD;
				var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLUSTER;&#xD;
				nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				nuovoAttributo.valoreAttributo = LavorazioneRichiesta.cluster;&#xD;
				nuovoAttributo.operatore = localRequest.operatore;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
				Process.auditLog(&quot;Aggiunto CLUSTER con valore: &quot; + LavorazioneRichiesta.cluster);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
