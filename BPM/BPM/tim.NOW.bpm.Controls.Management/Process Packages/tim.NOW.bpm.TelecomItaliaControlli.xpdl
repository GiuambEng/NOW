        <xpdl2:Activity Id="_18vMINwKEeadQ_2wWDDNtA" Name="ArricchimentoDettaglioOrdine" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var foundCODIFICAOLOAGCOMDONOR = false;&#xD;
var foundFLAGDNDONOROLO = false;&#xD;
&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
var dettaglio = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
dettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
dettaglio.created = date;&#xD;
dettaglio.lastUpdate = date;&#xD;
dettaglio.operatore = &quot;BPM&quot;;&#xD;
dettaglio.IDRisorsa = localRequest.IDRisorsa;&#xD;
&#xD;
var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
attributo.created = date;&#xD;
attributo.lastUpdate = date;&#xD;
attributo.operatore = localRequest.operatore;&#xD;
attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
&#xD;
if(localRequest.ordine == null)&#xD;
{&#xD;
	localRequest.ordine = it_telecomitalia_it_NOW_casedata_Factory.createOrdine();&#xD;
	localRequest.ordine.created = date;&#xD;
	localRequest.ordine.lastUpdate = date;&#xD;
	localRequest.ordine.codificaOLONOW = localRequest.codificaOLONOW;&#xD;
	localRequest.ordine.codificaOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
	localRequest.ordine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	localRequest.ordine.tipologiaLavorazione = localRequest.lavorazione;&#xD;
	localRequest.ordine.offerta = localRequest.offerta;&#xD;
}&#xD;
&#xD;
var asset = AssetRef.readAsset();&#xD;
&#xD;
for(var i = 0; i &lt; asset.dettaglioasset.size(); i++)&#xD;
{&#xD;
	var currentDettAsset = asset.dettaglioasset.get(i);&#xD;
	&#xD;
	if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
	{&#xD;
		dettaglio.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
		dettaglio.nomeComponente = currentDettAsset.nomeComponente;&#xD;
		dettaglio.integrationID = localRequest.IDRichiestaOLO + dettaglio.IDDettaglioOrdine;&#xD;
		dettaglio.progressivo = 1;&#xD;
		dettaglio.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		dettaglio.IDDettaglioOrdineParent = null;&#xD;
		dettaglio.IDDettaglioOrdineRoot = null;&#xD;
		&#xD;
		attributo.IDDettaglioOrdine = dettaglio.IDDettaglioOrdine;&#xD;
		&#xD;
		for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
		{&#xD;
			var currentAtttDettOrdine = currentDettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
			if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA&#xD;
				|| currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA&#xD;
				|| currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO&#xD;
				|| currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDASERVIZIO 	//RU_778 - aggiunto BANDASERVIZIO&#xD;
				|| currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEFATTURAZIONE)	// SM_8428 - aggiunto CODICEFATTURAZIONE&#xD;
			{&#xD;
				attributo.nomeAttributo = currentAtttDettOrdine.nomeAttributo;&#xD;
				attributo.valoreAttributo = currentAtttDettOrdine.valoreAttributo;&#xD;
				attributo.tipologiaDato = currentAtttDettOrdine.tipologiaDato;&#xD;
				&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			else if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONOR)&#xD;
			{&#xD;
				foundCODIFICAOLOAGCOMDONOR = true;&#xD;
				&#xD;
				attributo.nomeAttributo = currentAtttDettOrdine.nomeAttributo;&#xD;
				attributo.valoreAttributo = currentAtttDettOrdine.valoreAttributo;&#xD;
				attributo.tipologiaDato = currentAtttDettOrdine.tipologiaDato;&#xD;
				&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			else if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGDNDONOROLO)&#xD;
			{&#xD;
				foundFLAGDNDONOROLO = true;&#xD;
				&#xD;
				attributo.nomeAttributo = currentAtttDettOrdine.nomeAttributo;&#xD;
				attributo.valoreAttributo = currentAtttDettOrdine.valoreAttributo;&#xD;
				attributo.tipologiaDato = currentAtttDettOrdine.tipologiaDato;&#xD;
				&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(!foundCODIFICAOLOAGCOMDONOR &amp;&amp; CodificaOlo != null)&#xD;
		{&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONOR;&#xD;
			attributo.valoreAttributo = CodificaOlo;&#xD;
			&#xD;
			dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
		}&#xD;
		&#xD;
		if(!foundFLAGDNDONOROLO &amp;&amp; FlagDnOlo != null)&#xD;
		{&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGDNDONOROLO;&#xD;
			attributo.valoreAttributo = FlagDnOlo;&#xD;
			&#xD;
			dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
		}&#xD;
		&#xD;
		//CODEPRESTAGG&#xD;
		attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEPRESTAGG;&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA)&#xD;
		{&#xD;
			attributo.valoreAttributo = &quot;42&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			attributo.valoreAttributo = &quot;43&quot;;&#xD;
		}&#xD;
		dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
		&#xD;
		localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettaglio));&#xD;
		dettaglio.attributiDettaglioOrdine.clear();&#xD;
	}&#xD;
	else if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS)&#xD;
	{&#xD;
		dettaglio.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
		dettaglio.nomeComponente = currentDettAsset.nomeComponente;&#xD;
		dettaglio.integrationID = localRequest.IDRichiestaOLO + dettaglio.IDDettaglioOrdine;&#xD;
		dettaglio.progressivo = currentDettAsset.progressivo;&#xD;
		dettaglio.IDDettaglioOrdineParent = 1;&#xD;
		dettaglio.IDDettaglioOrdineRoot = 1;&#xD;
		dettaglio.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		&#xD;
		attributo.IDDettaglioOrdine = dettaglio.IDDettaglioOrdine;&#xD;
		&#xD;
		for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
		{&#xD;
			var currentAtttDettOrdine = currentDettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
			if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE&#xD;
				|| currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONE&#xD;
				|| currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEDTU&#xD;
				|| currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO)&#xD;
			{&#xD;
				attributo.nomeAttributo = currentAtttDettOrdine.nomeAttributo;&#xD;
				attributo.valoreAttributo = currentAtttDettOrdine.valoreAttributo;&#xD;
				attributo.tipologiaDato = currentAtttDettOrdine.tipologiaDato;&#xD;
				&#xD;
				dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettaglio));&#xD;
		dettaglio.attributiDettaglioOrdine.clear();&#xD;
	}&#xD;
	else if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
	{&#xD;
		dettaglio.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
		dettaglio.nomeComponente = currentDettAsset.nomeComponente;&#xD;
		dettaglio.integrationID = localRequest.IDRichiestaOLO + dettaglio.IDDettaglioOrdine;&#xD;
		dettaglio.progressivo = currentDettAsset.progressivo;&#xD;
		dettaglio.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		dettaglio.IDDettaglioOrdineParent = 1;&#xD;
		dettaglio.IDDettaglioOrdineRoot = 1;&#xD;
		&#xD;
		attributo.IDDettaglioOrdine = dettaglio.IDDettaglioOrdine;&#xD;
		&#xD;
		for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
		{&#xD;
			var currentAtttDettOrdine = currentDettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
			attributo.nomeAttributo = currentAtttDettOrdine.nomeAttributo;&#xD;
			attributo.valoreAttributo = currentAtttDettOrdine.valoreAttributo;&#xD;
			attributo.tipologiaDato = currentAtttDettOrdine.tipologiaDato;&#xD;
				&#xD;
			dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
		}&#xD;
		&#xD;
		localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettaglio));&#xD;
		dettaglio.attributiDettaglioOrdine.clear();&#xD;
	}&#xD;
}&#xD;
&#xD;
//C01M02F12 Recupero DISTRETTO/IDCONTRATTO/CLIENTE/NUMEROFITTIZIO DA ASSET&#xD;
if(asset != null)&#xD;
{&#xD;
	if(asset.distretto != null &amp;&amp; asset.distretto.length > 0)&#xD;
	{&#xD;
		localRequest.ordine.distretto = asset.distretto;&#xD;
	}&#xD;
	if(asset.IDContratto != null)&#xD;
	{&#xD;
		localRequest.IDContratto = asset.IDContratto;&#xD;
	}&#xD;
	if (asset.numeroFittizio != null &amp;&amp; asset.numeroFittizio.length > 0)&#xD;
	{&#xD;
		localRequest.ordine.numeroFittizio = asset.numeroFittizio;&#xD;
	}	&#xD;
&#xD;
	if(asset.IDRisorsa != null)&#xD;
	{&#xD;
		localRequest.ordine.numeroTelefonico = asset.IDRisorsa;&#xD;
	}&#xD;
		&#xD;
	if(asset.cliente != null 									&#xD;
		&amp;&amp; localRequest.ordine.nome == null &#xD;
		&amp;&amp; localRequest.ordine.cognomeRagioneSociale == null &#xD;
		&amp;&amp; localRequest.ordine.CF == null&#xD;
		&amp;&amp; localRequest.ordine.PIVA == null)  //Task #38239&#xD;
	{&#xD;
		if (asset.cliente.nome != null &amp;&amp; (localRequest.ordine.nome == null || localRequest.ordine.nome == &quot;&quot;))&#xD;
		{&#xD;
			localRequest.ordine.nome = asset.cliente.nome;&#xD;
		}		&#xD;
		if (asset.cliente.cognomeRagioneSociale != null &amp;&amp; (localRequest.ordine.cognomeRagioneSociale == null || localRequest.ordine.cognomeRagioneSociale == &quot;&quot;))&#xD;
		{&#xD;
			localRequest.ordine.cognomeRagioneSociale = asset.cliente.cognomeRagioneSociale;&#xD;
		}&#xD;
		&#xD;
		//SM_10686: Spostato arricchimento dei due campi qui invece che negli arricchimenti comuni&#xD;
		//CF e PIVA sono mutuamente esclusivi e non vanno arricchiti se uno dei due è indicato in input dall'OLO&#xD;
		if(localRequest.ordine.CF == null &amp;&amp; localRequest.ordine.PIVA == null)&#xD;
		{				&#xD;
			localRequest.ordine.CF = asset.cliente.codiceFiscale;&#xD;
			localRequest.ordine.PIVA = asset.cliente.partitaIVA;			&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//SM_9499: per alcune CESSAZIONI, nel momento in cui chiamiamo DETERMINACLUSTER non abbiamo ancora l'accesso, quindi ci perderemmo l'arricchimento di TIPOLOGIACLUSTERCOMUNE&#xD;
// Per quelle Cessazioni facciamo qui l'arricchimento e non nel complete script del controllo DETERMINA CLUSTER_C01M02F26&#xD;
//verifico se DeterminaCluster ha restituito tipologia cluster&#xD;
var foundTipologiaCluster = false;&#xD;
&#xD;
if (TipologiaClusterComune != null &amp;&amp; TipologiaClusterComune != &quot;&quot; &amp;&amp; localRequest != null &amp;&amp; localRequest.ordine !=null)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		//se già presente nell'ordine lo sovrascrivo&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var x = 0;&#xD;
			while(!foundTipologiaCluster &amp;&amp; x&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(x);&#xD;
				if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE)&#xD;
				{&#xD;
					foundTipologiaCluster = true;&#xD;
					currentAttributo.valoreAttributo = TipologiaClusterComune;&#xD;
				}&#xD;
				x++;&#xD;
			}&#xD;
			// se non presente nell'ordine lo aggiungo&#xD;
			if(!foundTipologiaCluster)&#xD;
			{&#xD;
				var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE;&#xD;
				nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				nuovoAttributo.valoreAttributo = TipologiaClusterComune;&#xD;
				nuovoAttributo.operatore = localRequest.operatore;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
				Process.auditLog(&quot;Aggiunto TIPOLOGIACLUSTERCOMUNE post controllo&quot;);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
