        <xpdl2:Activity Id="_yNF-E_OjEeaXdvPXpqOd8g" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_d8wNQOMCEeaE1NNf6Xmj2A" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="52.0" LaneId="_yNFWgfOjEeaXdvPXpqOd8g" Width="73.0">
