              <xpdl2:Coordinates XCoordinate="2743.0" YCoordinate="458.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_2eUPkeOnEeaiKuQ_iqaH6A" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_zs_-gOOnEeaiKuQ_iqaH6A" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_VIu4kZYDEeaCwZ8KxVhtAw" Width="58.0">
              <xpdl2:Coordinates XCoordinate="124.0" YCoordinate="100.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_8c19EO4nEeaA9fJij4lI6w" Name="RecuperaAssetTarget" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupera AssetTarget">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_DstQoOLxEeaoOL-mvUhWhw" PackageRef="tim.NOW.bpm.TelecomItaliaMainProject.Interfaces" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="action">
                  <xpdExt:ScriptInformation Id="_8c19Ee4nEeaA9fJij4lI6w" Name="action">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;UNLOCK&quot;;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="Ref">
                  <xpdl2:Actual ScriptGrammar="JavaScript">AssetRef</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="89.0" LaneId="_VIu4kZYDEeaCwZ8KxVhtAw" Width="127.0">
              <xpdl2:Coordinates XCoordinate="2558.0" YCoordinate="458.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier = &quot;/tim.NOW.bpm.TelecomItaliaMainProject/Process Packages/tim.NOW.bpm.TelecomItaliaSupporting.xpdl.TIMNOWRecuperaAssetTarget&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(AssetRef != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest != null)&#xD;
{&#xD;
	var asset = AssetRef.readAsset();&#xD;
	localRequest.ordine.IDRisorsaNOW = asset.IDRisorsaNOW;&#xD;
	localRequest.ordine.numeroFittizio = asset.numeroFittizio;&#xD;
	&#xD;
}else{&#xD;
&#xD;
	Process.auditLog(&quot;Impossibile completare l'aggiornamento Ordine.IdRisorsaNow e Ordine.NumeroFittizio per IDRichiesta&quot; + localRequest.IDRichiestaOLO);&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
