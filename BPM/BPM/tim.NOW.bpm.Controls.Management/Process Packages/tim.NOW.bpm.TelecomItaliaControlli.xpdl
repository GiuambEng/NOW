			&#xD;
		}&#xD;
		//Componente TIPOCOS: mi serve per l'arricchimento di FTTHONLY e TIPOLOGIACLUSTERVLAN&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
		{&#xD;
			var foundIdentificativoCos3o5 = false; &#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS&#xD;
				    &amp;&amp; (attributo.valoreAttributo == &quot;3&quot; || attributo.valoreAttributo == &quot;5&quot;))&#xD;
				{&#xD;
					foundIdentificativoCos3o5 = true;&#xD;
				}	&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//ARRICCHIMENTO FTTHONLY e TIPOLOGIACLUSTERVLAN&#xD;
	//Escluso solo il caso di FAMIGLIAVLAN = 1 e CoS in input = 3 o 5&#xD;
	if(!(FAMIGLIAVLAN == &quot;1&quot; &amp;&amp; foundIdentificativoCos3o5))     &#xD;
	{&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			//Componente RACCOLTAVLANNGA&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVLANNGA)&#xD;
			{&#xD;
				var foundFTTHONLY = false;&#xD;
				var foundTIPOLOGIACLUSTERVLAN = false;&#xD;
				&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FTTHONLY&#xD;
					   &amp;&amp; LavorazioneRichiesta.ftthOnly != null)&#xD;
					{&#xD;
						foundFTTHONLY = true;&#xD;
						attributo.valoreAttributo = LavorazioneRichiesta.ftthOnly;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN&#xD;
					        &amp;&amp; LavorazioneRichiesta.tipologiaClusterVlan != null)&#xD;
					{&#xD;
						foundTIPOLOGIACLUSTERVLAN = true;&#xD;
						attributo.valoreAttributo = LavorazioneRichiesta.tipologiaClusterVlan;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//SM_9788: Creo attributi se non presenti nell'ordine&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.operatore = componente.operatore;&#xD;
&#xD;
				if(!foundFTTHONLY &amp;&amp; LavorazioneRichiesta.ftthOnly != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FTTHONLY;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.ftthOnly;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Creato attributo FTTHONLY&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
				}&#xD;
				&#xD;
				if(!foundTIPOLOGIACLUSTERVLAN &amp;&amp; LavorazioneRichiesta.tipologiaClusterVlan != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.tipologiaClusterVlan;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Creato attributo TIPOLOGIACLUSTERVLAN&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
				}&#xD;
				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
