            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_7_bgM-biEeaqr96OWxgQ0w" Name="CallREFERENTEQUALIFICA" FinishMode="Automatic" IsATransaction="false" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Call REFERENTE QUALIFICA">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_k2AMAFJSEeafMOVsQ226Vw" PackageRef="tim.NOW.bpm.ProcesService.Interfaces" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="OUT" Formal="EsitoResponse">
                  <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
