                  <xpdl2:TransitionRef Id="_Z_wvcApjEeevZJC0hSwGLg"/>
                  <xpdl2:TransitionRef Id="_OZe7gA1mEeeRv6xWIpo7fw"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="45.0" LaneId="_7_bf8ebiEeaqr96OWxgQ0w" Width="43.0">
