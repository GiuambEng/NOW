        <xpdl2:Activity Id="_Kls0cBh1Eee0AeSBFsoXVA" Name="AggiornaComponente" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna Componente">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest!= null &amp;&amp; localRequest.ordine!=null){&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		&#xD;
		//WLR lna&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
			&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			} else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.T;		&#xD;
			}&#xD;
		} &#xD;
		&#xD;
		//VULL lna&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA&#xD;
			&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE){&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULL){&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} &#xD;
		else{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
flagGenericEnr = false;&#xD;
//C02M15F04 &#xD;
if(localRequest!= null &amp;&amp; localRequest.ordine!=null){&#xD;
	var idRisorsaNaked = &quot;&quot;;&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA)&#xD;
	{&#xD;
		&#xD;
		for(var k = 0; k &lt; localRequest.ordine.dettaglioordine.size(); k++)&#xD;
		{&#xD;
			&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(k);&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
			{&#xD;
				var flagCodePrestAgg = false;&#xD;
				var selezionePassanteTrovato = false;&#xD;
				&#xD;
				for(var z = 0; z &lt; componente.attributiDettaglioOrdine.size(); z++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(z);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSABTSNAKED)&#xD;
					{&#xD;
						idRisorsaNaked = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEPRESTAGG)&#xD;
					{&#xD;
						flagCodePrestAgg = true;&#xD;
						attributo.valoreAttributo = &quot;43&quot;;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SELEZIONEPASSANTE&#xD;
						 &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.selezionePassante != null) // SM_8475/SM_8498&#xD;
					{&#xD;
						selezionePassanteTrovato = true;&#xD;
						attributo.valoreAttributo = LavorazioneRichiesta.selezionePassante;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
&#xD;
				if(!flagCodePrestAgg)&#xD;
				{&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEPRESTAGG;&#xD;
					attributo.valoreAttributo = &quot;43&quot;;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				// SELEZIONE PASSANTE - SM_8475 e SM_8498&#xD;
				if(!selezionePassanteTrovato &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.selezionePassante != null)&#xD;
				{&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SELEZIONEPASSANTE;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.selezionePassante;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				//Cerco la componente CLIRPERMANENTE e imposto codice sts a 06&#xD;
				var h = 0;&#xD;
				while(h &lt; componente.attributiDettaglioOrdine.size() &amp;&amp; !flagGenericEnr){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(h);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLIRPERMANENTE){&#xD;
						if(attributo.valoreAttributo == 1){&#xD;
							flagGenericEnr = true;&#xD;
							localRequest.codiceSTS = &quot;06&quot;;&#xD;
						}&#xD;
					}	&#xD;
				h++;		&#xD;
				}&#xD;
&#xD;
			}&#xD;
			else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI){&#xD;
				var flagIdRisorsa = false;&#xD;
				var flagCodiceTrasformazione = false;&#xD;
				var y = 0;&#xD;
				while(y &lt; componente.attributiDettaglioOrdine.size() &amp;&amp; !flagIdRisorsa){&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA){&#xD;
						flagCodePrestAgg = true;&#xD;
						attributo.valoreAttributo = idRisorsaNaked;&#xD;
					}	&#xD;
				y++;	&#xD;
					&#xD;
				}&#xD;
				var u = 0;&#xD;
				while(u &lt; componente.attributiDettaglioOrdine.size() &amp;&amp; !flagCodiceTrasformazione){&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETRASFORMAZIONE){&#xD;
						flagCodiceTrasformazione = true;&#xD;
						attributo.valoreAttributo = localRequest.codiceTrasformazione;&#xD;
					}	&#xD;
				u++;	&#xD;
				}&#xD;
				if(!flagIdRisorsa &amp;&amp; idRisorsaNaked != null &amp;&amp; idRisorsaNaked != &quot;&quot;){&#xD;
					&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
					attributo.valoreAttributo = idRisorsaNaked;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				if(!flagCodiceTrasformazione &amp;&amp; localRequest.codiceTrasformazione != null &amp;&amp; localRequest.codiceTrasformazione != &quot;&quot;){&#xD;
					&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETRASFORMAZIONE;&#xD;
					attributo.valoreAttributo = localRequest.codiceTrasformazione;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Offerta WLR/VULL Lna non trovata&quot;);&#xD;
	}&#xD;
	&#xD;
	&#xD;
}//end main if&#xD;
else{&#xD;
	Process.auditLog(&quot;Request null oppure l'ordine non è stato trovato&quot;);&#xD;
}	&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" LaneId="_KlsNYRh1Eee0AeSBFsoXVA" Width="142.0">
              <xpdl2:Coordinates XCoordinate="1899.0" YCoordinate="1005.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
