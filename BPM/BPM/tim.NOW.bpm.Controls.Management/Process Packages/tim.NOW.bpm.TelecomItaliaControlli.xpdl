&#xD;
	//---------------------------------------------DECREMENTOULL e DECREMENTOSLU------------------------------------------&#xD;
	// SM_9076 - DECREMENTO ULL - TRANSCODIFICA DESTINAZIONE USO&#xD;
	// Bug #27827 - DECREMENTO SLU - TRANSCODIFICA DESTINAZIONE USO&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOULL&#xD;
	   || localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOSLU)&#xD;
	{&#xD;
		Process.auditLog(&quot;DECREMENTO ULL SLU - Check per TRASCODIFICA DEST USO&quot;);&#xD;
&#xD;
		var trovatoAccesso = false;&#xD;
		var w = 0;&#xD;
		&#xD;
		while(!trovatoAccesso &amp;&amp; w&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var comp = localRequest.ordine.dettaglioordine.get(w);&#xD;
			&#xD;
			if(String(comp.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)   &#xD;
			{&#xD;
				trovatoAccesso = true;&#xD;
				&#xD;
				var TIPOLINEA = &quot;&quot;;&#xD;
				TIPOLINEA = null;&#xD;
				var DESTINAZIONEUSO = &quot;&quot;;&#xD;
				DESTINAZIONEUSO = null;&#xD;
				&#xD;
				for(var z = 0; z &lt; comp.attributiDettaglioOrdine.size(); z++)&#xD;
				{&#xD;
					var attr = comp.attributiDettaglioOrdine.get(z);&#xD;
					&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						TIPOLINEA = attr.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato TIPOLINEA nella richiesta: &quot;+TIPOLINEA);&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
					{&#xD;
						DESTINAZIONEUSO = attr.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovata DEST USO nella richiesta: &quot;+DESTINAZIONEUSO);&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				if(TIPOLINEA == null &amp;&amp; DESTINAZIONEUSO != null &amp;&amp; DESTINAZIONEUSO != &quot;&quot;)&#xD;
				{&#xD;
					attributo.IDDettaglioOrdine = comp.IDDettaglioOrdine;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
					&#xD;
					if(DESTINAZIONEUSO.slice(0,1) == '1' &amp;&amp; DESTINAZIONEUSO != '10'){&#xD;
						TIPOLINEA = 'POTS';&#xD;
					}&#xD;
					else if(DESTINAZIONEUSO.slice(0,1) == '2' || DESTINAZIONEUSO.slice(0,1) == '3'){&#xD;
						TIPOLINEA = 'ISDN';&#xD;
					}&#xD;
					else if(DESTINAZIONEUSO.slice(0,1) == '4' || DESTINAZIONEUSO.slice(0,2) == '10'){&#xD;
						TIPOLINEA = 'ADSL';&#xD;
					}&#xD;
					&#xD;
					if(TIPOLINEA!=null)&#xD;
					{&#xD;
						attributo.valoreAttributo = TIPOLINEA;&#xD;
						comp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						Process.auditLog(&quot;Aggiunto nuovo Attributo TIPOLINEA: &quot;+TIPOLINEA+&quot; trascodificato da DU: &quot;+DESTINAZIONEUSO);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			w++;&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;ConsistenzaFonia null&quot;);&#xD;
}</xpdl2:Script>
