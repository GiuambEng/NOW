        <xpdl2:Activity Id="_HLUHseMAEeaoOL-mvUhWhw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_CORl8OMAEeaoOL-mvUhWhw" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="52.0" LaneId="_15yb0eFaEeamd-KFdR7bqA" Width="73.0">
