        <xpdl2:Activity Id="_tJYckMYcEeeVnsYgpXKnrQ" Name="ArricchimentoComponenteOLO2TIM" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Componente OLO2TIM">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest!= null &amp;&amp; localRequest.ordine!=null)&#xD;
{&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		&#xD;
		//VULAFTTH BitstreamNGAFTTH&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH)  //RU_1164&#xD;
		{&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTH &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
			 &#xD;
			 componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			&#xD;
			}&#xD;
		}&#xD;
		//SM_11510&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
		{&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTCAB &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{ &#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;						&#xD;
			}&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
	 &#xD;
	&#xD;
	//RU_1317: ARRICCHIMENTO GENERICO COMPONENTE ACCESSO -> attributo PROPRIETAMATERIALE&#xD;
	var foundProprietaMateriale = false;&#xD;
	//RU_1390: ARRICCHIMENTO GENERICO COMPONENTE ACCESSO -> attributo FLAGEQUIVALENZAPRODOTTI&#xD;
	var trovatoFlagEquivalenzaProdotti = false;&#xD;
	//RU_1353: ARRICCHIMENTO CARATTERIZZAZIONEGEO NELL'ACCESSO DA CONSISTENZADATI&#xD;
	var foundCaratterizzazioneGeo = false;&#xD;
	//Radius&#xD;
	var foundCluster = false;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{		&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE&#xD;
				   &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
				{&#xD;
					foundProprietaMateriale = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
					Process.auditLog(&quot;Aggiornato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO &#xD;
				   &amp;&amp; ConsistenzaDati != null &amp;&amp; ConsistenzaDati.caratterizzazioneGEO != null)//RU_1353&#xD;
				{&#xD;
					foundCaratterizzazioneGeo = true;&#xD;
					attr.valoreAttributo = ConsistenzaDati.caratterizzazioneGEO;&#xD;
					Process.auditLog(&quot;Aggiornato attributo CARATTERIZZAZIONEGEO con valore: &quot;+ ConsistenzaDati.caratterizzazioneGEO);&#xD;
				}&#xD;
				//RU_1390&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI&#xD;
					   &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
				{&#xD;
					trovatoFlagEquivalenzaProdotti = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
					Process.auditLog(&quot;Aggiornato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
				}&#xD;
				//Radius&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLUSTER&#xD;
					   &amp;&amp; LavorazioneRichiesta.cluster != null)&#xD;
				{&#xD;
					foundCluster = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.cluster;&#xD;
					Process.auditLog(&quot;Aggiornato attributo Cluster con valore: &quot;+ LavorazioneRichiesta.cluster);&#xD;
				}&#xD;
			}&#xD;
						&#xD;
			if(!foundProprietaMateriale &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundProprietaMateriale = true;&#xD;
				Process.auditLog(&quot;Creato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
			}&#xD;
			//RU_1353&#xD;
			if(!foundCaratterizzazioneGeo &amp;&amp; ConsistenzaDati != null &amp;&amp; ConsistenzaDati.caratterizzazioneGEO != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaDati.caratterizzazioneGEO;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundProprietaMateriale = true;&#xD;
				Process.auditLog(&quot;Creato attributo CARATTERIZZAZIONEGEO con valore: &quot;+ ConsistenzaDati.caratterizzazioneGEO);&#xD;
			}&#xD;
			//RU_1390&#xD;
			if(!trovatoFlagEquivalenzaProdotti &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				trovatoFlagEquivalenzaProdotti = true;&#xD;
				Process.auditLog(&quot;Creato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
			}&#xD;
			//Radius&#xD;
			if(!foundCluster &amp;&amp; LavorazioneRichiesta.cluster != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLUSTER;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.cluster;			&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundCluster = true;&#xD;
				Process.auditLog(&quot;Creato attributo CLUSTER con valore: &quot;+ LavorazioneRichiesta.cluster);&#xD;
			}&#xD;
		}		&#xD;
	}&#xD;
&#xD;
//FEA_32918: ARRICCHIMENTO MERCATO PER VULAFTTH e VULAFTTCAB&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
{&#xD;
	var foundMercato = false;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{		&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MERCATO&#xD;
				&amp;&amp; LavorazioneRichiesta.mercato != null)&#xD;
				{&#xD;
					foundMercato = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.mercato;&#xD;
					Process.auditLog(&quot;Aggiornato attributo MERCATO con valore: &quot;+ LavorazioneRichiesta.mercato);&#xD;
				}&#xD;
			}&#xD;
						&#xD;
			if(!foundMercato &amp;&amp; LavorazioneRichiesta.mercato != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MERCATO;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.mercato;			&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundMercato = true;&#xD;
				Process.auditLog(&quot;Creato attributo MERCATO con valore: &quot;+ LavorazioneRichiesta.mercato);&#xD;
			}&#xD;
	&#xD;
	&#xD;
		}		&#xD;
	}&#xD;
}&#xD;
&#xD;
	 //ARRICCHIMENTO BANDE PICCO PER EASYIPUBB&#xD;
 if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)   //RU_1164&#xD;
 {&#xD;
  for (var i=0; i&lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
  {   &#xD;
   var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
   &#xD;
   if (currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp; EnrichmentBandeOut!= null)&#xD;
   {&#xD;
    Process.auditLog(&quot;Inizio arricchimento BANDEPICCO per USERVLAN EASYIP NGA - Valori da inserire: BANDAPICCOUP &quot;+EnrichmentBandeOut.bandaPiccoUp+&quot; BANDAPICCODOWN &quot;+EnrichmentBandeOut.bandaPiccoDown);&#xD;
    &#xD;
    var foundBANDAPICCOup = false;&#xD;
    var foundBANDAPICCOdown = false;&#xD;
    var j=0;&#xD;
    &#xD;
    while ((!foundBANDAPICCOup || !foundBANDAPICCOdown) &amp;&amp;  j&lt; currentComponente.attributiDettaglioOrdine.size())&#xD;
    {&#xD;
     var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
     &#xD;
     if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
     {&#xD;
      foundBANDAPICCOup=true;&#xD;
      currentAttributo.valoreAttributo = EnrichmentBandeOut.bandaPiccoUp;&#xD;
     }&#xD;
     &#xD;
     else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
     {&#xD;
      foundBANDAPICCOdown=true;&#xD;
      currentAttributo.valoreAttributo = EnrichmentBandeOut.bandaPiccoDown;&#xD;
     }&#xD;
     &#xD;
     &#xD;
    j++;&#xD;
    }&#xD;
    &#xD;
    // CREO GLI ATTRIBUTI SE NON ESISTONO&#xD;
    if (!foundBANDAPICCOup || !foundBANDAPICCOdown)&#xD;
    {&#xD;
     var AttributoBande = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
     &#xD;
     AttributoBande.IDDettaglioOrdine = currentComponente.IDDettaglioOrdine;&#xD;
     AttributoBande.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
     AttributoBande.created = DateTimeUtil.createDatetime();&#xD;
     AttributoBande.lastUpdate = DateTimeUtil.createDatetime();&#xD;
     AttributoBande.operatore = &quot;BPM&quot;;&#xD;
     AttributoBande.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
     &#xD;
     if (!foundBANDAPICCOup)&#xD;
     {&#xD;
      AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP;&#xD;
      AttributoBande.valoreAttributo = EnrichmentBandeOut.bandaPiccoUp;&#xD;
      currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
      Process.auditLog(&quot;Creato attributo BANDAPICCOUP &quot; + EnrichmentBandeOut.bandaPiccoUp);&#xD;
      &#xD;
     }&#xD;
     if (!foundBANDAPICCOdown)&#xD;
     {&#xD;
      AttributoBande.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN;&#xD;
      AttributoBande.valoreAttributo = EnrichmentBandeOut.bandaPiccoDown;&#xD;
      currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoBande));&#xD;
      Process.auditLog(&quot;Creato attributo BANDAPICCODOWN &quot; + EnrichmentBandeOut.bandaPiccoDown);&#xD;
     }&#xD;
 &#xD;
    }&#xD;
  &#xD;
   &#xD;
   }&#xD;
  }&#xD;
 }&#xD;
