          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var flagCodOloAgDon = false;&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA)&#xD;
{&#xD;
	if(AssetRef != null &amp;&amp; localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
	{&#xD;
		var asset = AssetRef.readAsset();&#xD;
		localRequest.ordine.IDRisorsaNOW = asset.IDRisorsaNOW;&#xD;
		localRequest.ordine.numeroFittizio = asset.numeroFittizio;&#xD;
		&#xD;
		var i = 0;&#xD;
		var foundAccesso = false;&#xD;
		while(!foundAccesso &amp;&amp; i &lt; asset.dettaglioasset.size())&#xD;
		{&#xD;
			var currentDettAsset = asset.dettaglioasset.get(i);&#xD;
		&#xD;
			if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
			{&#xD;
				foundAccesso = true;&#xD;
				var j = 0;&#xD;
				while(!flagCodOloAgDon &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
				{&#xD;
					var currentAttribDettAss = currentDettAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONOR)&#xD;
					{&#xD;
						flagCodOloAgDon = true;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	flagCodOloAgDon = true;&#xD;
}&#xD;
&#xD;
!flagCodOloAgDon;</xpdl2:Expression>
</xpdl2:Condition>
