        <xpdl2:Activity Id="_Jm4OwgpeEeeu3aeX_vEnIg" Name="AggiornamentoComponenti" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiornamento Componenti">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var tipoLineaOrdine = &quot;&quot;;&#xD;
var tipoLineaAsset = &quot;&quot;;&#xD;
&#xD;
tipoLineaOrdine =  null;&#xD;
tipoLineaAsset = null;&#xD;
&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
var indexAccessoOrdine = 0;&#xD;
indexAccessoOrdine = null;&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(tipoLineaOrdine == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			indexAccessoOrdine = i;&#xD;
			&#xD;
			var j = 0;&#xD;
			while(tipoLineaOrdine == null &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					tipoLineaOrdine = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato TIPOLINEA in ORDINE: &quot; + tipoLineaOrdine);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
//C01M02F12 Recupero DISTRETTO/IDCONTRATTO/CLIENTE/NUMEROFITTIZIO/CLLI DA ASSET&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
	}&#xD;
	else if (ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.IDAsset != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaFonia.IDAsset, 10));&#xD;
	}&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		Asset = AssetRef.readAsset();&#xD;
		if (Asset.distretto != null &amp;&amp; Asset.distretto.length > 0 &amp;&amp; &#xD;
			!((localRequest.ordine.tipologiaLinea==it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN || localRequest.ordine.tipologiaLinea==it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS)&#xD;
			&amp;&amp; (localRequest.strutturaRichiesta==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA || localRequest.strutturaRichiesta==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)))&#xD;
		{&#xD;
			localRequest.ordine.distretto = Asset.distretto;&#xD;
		}&#xD;
		if (Asset.IDContratto != null)&#xD;
		{&#xD;
			if(localRequest.IDContratto == null)&#xD;
			{&#xD;
				localRequest.IDContratto = Asset.IDContratto;&#xD;
			}&#xD;
		}&#xD;
		if (Asset.numeroFittizio != null &amp;&amp; Asset.numeroFittizio.length > 0 &amp;&amp; localRequest.strutturaRichiesta != it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO) //C01M02F03 - SF 6.51&#xD;
		{&#xD;
			localRequest.ordine.numeroFittizio = Asset.numeroFittizio;&#xD;
		}&#xD;
		if (Asset.CLLI != null &amp;&amp; String(localRequest.offerta) == &quot;WLR&quot;)&#xD;
		{&#xD;
			localRequest.ordine.CLLI = Asset.CLLI;&#xD;
		}&#xD;
	&#xD;
		if(Asset.cliente != null 									&#xD;
			&amp;&amp; localRequest.ordine.nome == null &#xD;
			&amp;&amp; localRequest.ordine.cognomeRagioneSociale == null &#xD;
			&amp;&amp; localRequest.ordine.CF == null&#xD;
			&amp;&amp; localRequest.ordine.PIVA == null)  //Task #38239&#xD;
		{&#xD;
			if (Asset.cliente.nome != null &amp;&amp; (localRequest.ordine.nome == null || localRequest.ordine.nome == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.nome = Asset.cliente.nome;&#xD;
			}		&#xD;
			if (Asset.cliente.cognomeRagioneSociale != null &amp;&amp; (localRequest.ordine.cognomeRagioneSociale == null || localRequest.ordine.cognomeRagioneSociale == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.cognomeRagioneSociale = Asset.cliente.cognomeRagioneSociale;&#xD;
			}&#xD;
			&#xD;
			//SM_10686: Spostato arricchimento dei due campi qui invece che negli arricchimenti comuni&#xD;
			//CF e PIVA sono mutuamente esclusivi e non vanno arricchiti se uno dei due è indicato in input dall'OLO&#xD;
			if(localRequest.ordine.CF == null &amp;&amp; localRequest.ordine.PIVA == null)&#xD;
			{				&#xD;
				localRequest.ordine.CF = Asset.cliente.codiceFiscale;&#xD;
				localRequest.ordine.PIVA = Asset.cliente.partitaIVA;			&#xD;
			}&#xD;
		}&#xD;
			&#xD;
		//Bug #38459: commentato poichè spostato nell'arricchimento dei controlli di ammissibilità&#xD;
		// VALORIZZAZIONE OPERATORE RETE - Modifica per FF&#xD;
		/*if(Asset.operatoreRete != null)&#xD;
		{&#xD;
			localRequest.operatoreRete = Asset.operatoreRete;&#xD;
			localRequest.ordine.operatoreRete = Asset.operatoreRete;&#xD;
		}*/&#xD;
			&#xD;
		if(tipoLineaOrdine == null &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA &#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL))&#xD;
		{&#xD;
			var i = 0;&#xD;
			while(tipoLineaAsset == null &amp;&amp; i &lt; Asset.dettaglioasset.size())&#xD;
			{&#xD;
				var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
				&#xD;
				if(String(currentDettAsset.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var j = 0;&#xD;
					while(tipoLineaAsset == null &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
					{&#xD;
						var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
						{&#xD;
							tipoLineaAsset = currentAttDettAsset.valoreAttributo;&#xD;
							Process.auditLog(&quot;Trovato TIPOLINEA in ASSET: &quot; + tipoLineaAsset);&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
			&#xD;
			if(tipoLineaAsset != null)&#xD;
			{&#xD;
				var componenteAccesso = localRequest.ordine.dettaglioordine.get(indexAccessoOrdine);&#xD;
				&#xD;
				var attTemp = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attTemp.IDDettaglioOrdine = componenteAccesso.IDDettaglioOrdine;&#xD;
				attTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attTemp.created = date;&#xD;
				attTemp.lastUpdate = date;&#xD;
				attTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
				attTemp.operatore = &quot;BPM&quot;;&#xD;
				attTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attTemp.valoreAttributo = tipoLineaAsset;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexAccessoOrdine).attributiDettaglioOrdine.add(ScriptUtil.copy(attTemp));&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Consistenza Dati/Fonia non trovata&quot;);&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
// calcolo codice piattaforma&#xD;
&#xD;
var codicePiattaforma= &quot;&quot;;&#xD;
codicePiattaforma = null;&#xD;
&#xD;
//recupero direzionalita e struttura Linea&#xD;
var DIREZIONALITA = &quot;&quot;;&#xD;
DIREZIONALITA = null;&#xD;
var STRUTTURALINEA = &quot;&quot;;&#xD;
STRUTTURALINEA = null;&#xD;
var TIPOLINEA = &quot;&quot;;&#xD;
TIPOLINEA = null;&#xD;
&#xD;
var i=0;&#xD;
var accessoTrovato = false;&#xD;
while(!accessoTrovato &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
		var j=0;&#xD;
		accessoTrovato=true;&#xD;
		while((DIREZIONALITA== null || STRUTTURALINEA==null || TIPOLINEA==null) &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size()){&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA){&#xD;
				DIREZIONALITA = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA){&#xD;
				STRUTTURALINEA = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
				TIPOLINEA = attributo.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
{&#xD;
&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA){&#xD;
	&#xD;
		if((localRequest.ordine.CF!= null &amp;&amp; localRequest.ordine.CF!= &quot;&quot;)&#xD;
			||  (localRequest.ordine.PIVA!= null &amp;&amp; localRequest.ordine.PIVA!= &quot;&quot;))&#xD;
			{&#xD;
			&#xD;
			if(localRequest.ordine.PIVA!= null &amp;&amp; localRequest.ordine.PIVA!= &quot;&quot;)&#xD;
			{&#xD;
				codicePiattaforma = &quot;SBL&quot;;&#xD;
			}&#xD;
			if((localRequest.ordine.CF!= null &amp;&amp; localRequest.ordine.CF!= &quot;&quot;)&#xD;
			&amp;&amp; (TIPOLINEA!=null)&#xD;
			&amp;&amp; ((TIPOLINEA.toUpperCase() == &quot;POTS&quot; &amp;&amp; DIREZIONALITA==null)&#xD;
				|| (TIPOLINEA.toUpperCase() == &quot;ISDN&quot; &amp;&amp; STRUTTURALINEA==&quot;BraMono&quot; &amp;&amp; DIREZIONALITA==null)&#xD;
				|| (TIPOLINEA.toUpperCase() == &quot;POTS&quot; &amp;&amp; STRUTTURALINEA==&quot;Simplex&quot; &amp;&amp; DIREZIONALITA!=null)))&#xD;
			{&#xD;
				codicePiattaforma = &quot;SBR&quot;;&#xD;
				}&#xD;
		}&#xD;
		else if(Asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
			|| Asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
			|| Asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
			|| Asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA)&#xD;
		{&#xD;
			codicePiattaforma = &quot;SBR&quot;;&#xD;
		}&#xD;
		else if(ConsistenzaDati != null &amp;&amp; (ConsistenzaFonia == null || (ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.offerta != it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEAATTIVA&#xD;
					&amp;&amp; ConsistenzaFonia.offerta != it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
					&amp;&amp; ConsistenzaFonia.offerta != it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULL&#xD;
					&amp;&amp; ConsistenzaFonia.offerta != it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULLLINEANONATTIVA)))&#xD;
		{&#xD;
			codicePiattaforma = &quot;SBR&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			if(Asset!=null){&#xD;
				var i=0;&#xD;
				var accessoTrovato = false;&#xD;
				while(!accessoTrovato &amp;&amp; i&lt;Asset.dettaglioasset.size()){&#xD;
					var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
					if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
						accessoTrovato=true;&#xD;
						var j=0;&#xD;
						while(codicePiattaforma==null &amp;&amp; j&lt;currentDettAsset.attributidettaglioasset.size()){&#xD;
							if(currentDettAsset.attributidettaglioasset.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA){&#xD;
								codicePiattaforma = currentDettAsset.attributidettaglioasset.get(j).valoreAttributo;&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					i++;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//salvo CODICEPIATTAFORMA&#xD;
	if(codicePiattaforma!= null &amp;&amp; codicePiattaforma!=&quot;&quot;){&#xD;
		var i=0;&#xD;
		while(i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot; || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				var j=0;&#xD;
				var CODICEPIATTAFORMATrovato=false;&#xD;
				while(!CODICEPIATTAFORMATrovato &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size()){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA){&#xD;
						CODICEPIATTAFORMATrovato = true;&#xD;
						attributo.valoreAttributo = codicePiattaforma;&#xD;
					}	&#xD;
					&#xD;
					j++;&#xD;
				}&#xD;
				if(!CODICEPIATTAFORMATrovato){&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA;&#xD;
					attributo.valoreAttributo = codicePiattaforma;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
// NUMERO TELEFONICO&#xD;
//SM_4867 &#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP)&#xD;
{&#xD;
	var dn = &quot;&quot;;&#xD;
	dn = null;&#xD;
	&#xD;
	var i = 0;&#xD;
	while(dn == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(dn == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN)&#xD;
				{&#xD;
					dn = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(dn != null)&#xD;
	{&#xD;
		localRequest.ordine.numeroTelefonico = dn;&#xD;
	}&#xD;
}&#xD;
//SM_5256&#xD;
else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA)&#xD;
&amp;&amp; ConsistenzaFonia!= null &amp;&amp; ConsistenzaFonia.numeroTelefonico != null &amp;&amp; String(ConsistenzaFonia.IDRisorsa).slice(0,2) != 'U6') // RU_813: aggiunta slice con U6&#xD;
{&#xD;
	localRequest.numeroTelefonico = ConsistenzaFonia.numeroTelefonico;&#xD;
	localRequest.ordine.numeroTelefonico = ConsistenzaFonia.numeroTelefonico;&#xD;
}&#xD;
else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA)&#xD;
&amp;&amp; ConsistenzaFonia!= null &amp;&amp; ConsistenzaFonia.numeroTelefonico != null)&#xD;
{&#xD;
	localRequest.numeroTelefonico = ConsistenzaFonia.numeroTelefonico;&#xD;
	localRequest.ordine.numeroTelefonico = ConsistenzaFonia.numeroTelefonico;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
