        <xpdl2:Activity Id="_1XR2Qj8mEe2Ai61ig9Kg3A" Name="ValorizzazioneCostantidaAssetACCESSO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Valorizzazione Costanti da Asset ACCESSO" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Task #39819: Unico script diviso in due, &quot;Valorizzazione Costanti da Asset ACCESSO&quot; e &quot;Arricchimento Ordine da Asset ACCESSO&quot;&#xD;
listaAttributiOrdine_ARR = DataUtil.createList();&#xD;
listaAttributiAsset_ARR = DataUtil.createList();&#xD;
listaAttributiDaAggiungere_ARR = DataUtil.createList();&#xD;
listaValoreOrdine_ARR = DataUtil.createList();&#xD;
listaValoreAsset_ARR = DataUtil.createList();&#xD;
listaValoreOrdine_ARROld = DataUtil.createList();&#xD;
listaComponenti_ARR =DataUtil.createList();&#xD;
listaDaSovrascrivere_ARR  = DataUtil.createList();&#xD;
&#xD;
nomeComponenteAccesso_ARR = &quot;&quot;;&#xD;
&#xD;
if(ConsistenzaDati!= null){&#xD;
	Process.auditLog(&quot;Arricchimento per Consistenza dati, asset: &quot;+ ConsistenzaDati.IDAsset);&#xD;
	Process.auditLog(&quot;Offerta: &quot;+String(localRequest.offerta)+&quot; , tipologiaSottolav: &quot;+localRequest.ordine.tipologiaSottolav);&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaDati.IDAsset));&#xD;
	Asset = AssetRef.readAsset();&#xD;
	&#xD;
	//------------------Calcola Configurazioni&#xD;
&#xD;
	if(localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT){&#xD;
		nomeComponenteAccesso_ARR = &quot;ACCESSOATMASIMFLAT&quot;;&#xD;
		listaAttributiOrdine_ARR.add(&quot;PROFILOTECNICOLINEA&quot;);&#xD;
		listaAttributiAsset_ARR.add(&quot;PROFILOTECNICOLINEA&quot;);&#xD;
		listaAttributiDaAggiungere_ARR.add(true);listaComponenti_ARR.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine_ARR.add(&quot;&quot;);&#xD;
		listaValoreAsset_ARR.add(&quot;&quot;);listaValoreOrdine_ARROld.add(&quot;&quot;);&#xD;
		listaDaSovrascrivere_ARR.add(false);&#xD;
		&#xD;
		listaAttributiOrdine_ARR.add(&quot;MODULAZIONE&quot;);&#xD;
		listaAttributiAsset_ARR.add(&quot;MODULAZIONE&quot;);&#xD;
		listaAttributiDaAggiungere_ARR.add(true);listaComponenti_ARR.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine_ARR.add(&quot;&quot;);&#xD;
		listaValoreAsset_ARR.add(&quot;&quot;);listaValoreOrdine_ARROld.add(&quot;&quot;);&#xD;
		listaDaSovrascrivere_ARR.add(false);&#xD;
		&#xD;
		listaAttributiOrdine_ARR.add(&quot;FLAGORDINEUNICO&quot;);&#xD;
		listaAttributiAsset_ARR.add(&quot;FLAGORDINEUNICO&quot;);&#xD;
		listaAttributiDaAggiungere_ARR.add(true);listaComponenti_ARR.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine_ARR.add(&quot;&quot;);&#xD;
		listaValoreAsset_ARR.add(&quot;&quot;);listaValoreOrdine_ARROld.add(&quot;&quot;);&#xD;
		listaDaSovrascrivere_ARR.add(false);&#xD;
		&#xD;
		listaAttributiOrdine_ARR.add(&quot;TECNOLOGIA&quot;);&#xD;
		listaAttributiAsset_ARR.add(&quot;TECNOLOGIA&quot;);&#xD;
		listaAttributiDaAggiungere_ARR.add(true);listaComponenti_ARR.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine_ARR.add(&quot;&quot;);&#xD;
		listaValoreAsset_ARR.add(&quot;&quot;);listaValoreOrdine_ARROld.add(&quot;&quot;);&#xD;
		listaDaSovrascrivere_ARR.add(false);&#xD;
		&#xD;
		listaAttributiOrdine_ARR.add(&quot;TIPOLINEA&quot;);&#xD;
		listaAttributiAsset_ARR.add(&quot;TIPOLINEA&quot;);&#xD;
		listaAttributiDaAggiungere_ARR.add(true);listaComponenti_ARR.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine_ARR.add(&quot;&quot;);&#xD;
		listaValoreAsset_ARR.add(&quot;&quot;);listaValoreOrdine_ARROld.add(&quot;&quot;);&#xD;
		listaDaSovrascrivere_ARR.add(false);&#xD;
		&#xD;
		listaAttributiOrdine_ARR.add(&quot;GESTIONEPRODOTTO&quot;);&#xD;
		listaAttributiAsset_ARR.add(&quot;GESTIONEPRODOTTO&quot;);&#xD;
		listaAttributiDaAggiungere_ARR.add(true);listaComponenti_ARR.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine_ARR.add(&quot;&quot;);&#xD;
		listaValoreAsset_ARR.add(&quot;&quot;);listaValoreOrdine_ARROld.add(&quot;&quot;);&#xD;
		listaDaSovrascrivere_ARR.add(false);&#xD;
		&#xD;
		listaAttributiOrdine_ARR.add(&quot;CAMPOSERVIZIOIT&quot;);&#xD;
