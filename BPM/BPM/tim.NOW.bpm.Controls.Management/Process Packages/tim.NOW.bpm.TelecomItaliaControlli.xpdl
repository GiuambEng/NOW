              <xpdl2:TriggerResultLink CatchThrow="CATCH" Name="0"/>
            </xpdl2:IntermediateEvent>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="57.0" LaneId="_Uw3k0kbAEfCMDcWUZCLvNA" Width="52.0">
