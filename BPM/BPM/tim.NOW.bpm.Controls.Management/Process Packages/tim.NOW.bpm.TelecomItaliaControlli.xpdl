        <xpdl2:Activity Id="_Q89AsAAnEeeCQM27nOa8Ag" Name="ArricchimentoDettaglioOrdine" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">/*Funzione C02M02F03 per SM_2596*/&#xD;
if(AssetRef != null)&#xD;
{&#xD;
		var asset = AssetRef.readAsset();&#xD;
		var date = DateTimeUtil.createDatetime();&#xD;
		&#xD;
		//controllo esistenza asset in input&#xD;
		if(asset.dettaglioasset !=null &amp;&amp; asset.dettaglioasset.size() > 0)&#xD;
		{&#xD;
		 //controllo esistenza ordine nella richiesta&#xD;
			if(localRequest.ordine == null)&#xD;
			{&#xD;
				//creo ordine se non c'è&#xD;
				var ordine = it_telecomitalia_it_NOW_casedata_Factory.createOrdine();&#xD;
				&#xD;
				ordine.created = date;&#xD;
				ordine.codificaOLONOW = localRequest.codificaOLONOW;&#xD;
				ordine.codificaOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
				ordine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				ordine.tipologiaLavorazione = localRequest.lavorazione;&#xD;
				ordine.offerta = localRequest.offerta;&#xD;
				localRequest.ordine = ScriptUtil.copy(ordine);&#xD;
			}&#xD;
			&#xD;
			for(var i = 0; i &lt; asset.dettaglioasset.size(); i++)&#xD;
			{&#xD;
				//arricchimento del dettaglio dell'ordine con il dettaglio dell'Asset&#xD;
				var currentDettAsset = asset.dettaglioasset.get(i);&#xD;
				&#xD;
				// Controllo OFFERTA e COMPONENTI come da SF&#xD;
				if(((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULL					&#xD;
					||&#xD;
					localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
					||&#xD;
					localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
					||&#xD;
					localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA) &#xD;
					&amp;&amp;&#xD;
					currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULL) &#xD;
				  ||				  &#xD;
				  ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATI				&#xD;
					||&#xD;
					localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
					||&#xD;
					localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
					||&#xD;
					localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA)&#xD;
				   	&amp;&amp;&#xD;
					currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULLDATI)&#xD;
				  ||&#xD;
				  ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLU&#xD;
				  	||&#xD;
				  	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
				  	||&#xD;
				  	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
				  	||&#xD;
				  	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA)&#xD;
				   	&amp;&amp;&#xD;
					currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU)&#xD;
				  ||&#xD;
				  ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA&#xD;
				  	||&#xD;
				  	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA)&#xD;
				   	&amp;&amp;&#xD;
					currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSHA))&#xD;
				  {&#xD;
					var dettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
					&#xD;
					dettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					dettOrdine.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
					dettOrdine.created = date;&#xD;
					dettOrdine.lastUpdate = date;&#xD;
					dettOrdine.operatore = &quot;BPM&quot;;&#xD;
					dettOrdine.IDRisorsa = currentDettAsset.IDRisorsa;&#xD;
					dettOrdine.nomeComponente = currentDettAsset.nomeComponente;&#xD;
					dettOrdine.integrationID = localRequest.IDRichiestaOLO + dettOrdine.IDDettaglioOrdine;&#xD;
					dettOrdine.progressivo = currentDettAsset.progressivo;&#xD;
					dettOrdine.IDRisorsaNOW = currentDettAsset.IDRisorsaNOW;&#xD;
					&#xD;
					var foundFATTURAZIONELA = false;&#xD;
					&#xD;
					for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
					&#xD;
						var currentAttribDettAss = currentDettAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
						//Solo gli attributi come da SFN&#xD;
						if(((currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULL&#xD;
								|| currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULLDATI)&#xD;
							&amp;&amp;&#xD;
							(currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDULLCO ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEPERMUTATORE1 ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEPERMUTATORE2 ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BITRATE ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURAZIONELA ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA&#xD;
							))&#xD;
						||&#xD;
							(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU&#xD;
							&amp;&amp;&#xD;
							(currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDSLUCO ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEPERMUTATORE1 ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEPERMUTATORE2 ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BITRATE ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURAZIONELA ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDASERVIZIO)) //RU_778 - aggiunto BANDASERVIZIO&#xD;
						||&#xD;
							(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSHA&#xD;
							&amp;&amp;&#xD;
							(currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDULLCO ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEPERMUTATORE1 ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA ||&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BITRATE)))&#xD;
							{&#xD;
								var attribDettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
								attribDettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
								attribDettOrdine.IDDettaglioOrdine = dettOrdine.IDDettaglioOrdine;&#xD;
								attribDettOrdine.tipologiaDato = currentAttribDettAss.tipologiaDato;&#xD;
								attribDettOrdine.created = date;&#xD;
								attribDettOrdine.lastUpdate = date;&#xD;
								attribDettOrdine.operatore = &quot;BPM&quot;;&#xD;
								attribDettOrdine.nomeAttributo = currentAttribDettAss.nomeAttributo;&#xD;
								attribDettOrdine.valoreAttributo = currentAttribDettAss.valoreAttributo;&#xD;
								&#xD;
								dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
							&#xD;
								if(currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURAZIONELA)&#xD;
								{&#xD;
									foundFATTURAZIONELA = true;&#xD;
								}&#xD;
							}//End if&#xD;
							&#xD;
					}//End for j&#xD;
					&#xD;
					//Aggiungo FATTURAZIONELA in caso non presente in ASSET per OFFERTE ULL / ULLDATI / SLU&#xD;
					if(!foundFATTURAZIONELA)&#xD;
					{&#xD;
						var offertaSliced = String(localRequest.offerta).slice(0, 3);&#xD;
			&#xD;
						if(offertaSliced == &quot;ULL&quot; || offertaSliced == &quot;SLU&quot;)&#xD;
						{&#xD;
							var attribDettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
							attribDettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							attribDettOrdine.IDDettaglioOrdine = dettOrdine.IDDettaglioOrdine;&#xD;
							attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							attribDettOrdine.created = date;&#xD;
							attribDettOrdine.lastUpdate = date;&#xD;
							attribDettOrdine.operatore = &quot;BPM&quot;;&#xD;
							attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURAZIONELA;&#xD;
							attribDettOrdine.valoreAttributo = &quot;N&quot;;&#xD;
							dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
						}&#xD;
					}&#xD;
&#xD;
					&#xD;
					localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettOrdine));&#xD;
				}//End if&#xD;
				else&#xD;
				{&#xD;
					Process.auditLog(&quot;Nessuna Offerta o Componente da Cessare per IDRichiesta&quot; + localRequest.IDRichiestaOLO + &quot; ed Asset: &quot; + asset.IDAsset);&#xD;
				}&#xD;
			}//end for i		&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Impossibile completare la funzione di Arricchimento: Asset o DettagliAsset inesistenti per IDRichiesta &quot; + localRequest.IDRichiestaOLO + &quot; ed Asset: &quot; + asset.IDAsset);&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Impossibile completare la funzione di Arricchimento: Impossibile trovare l'Asset di riferimento per IDRichiesta &quot; + localRequest.IDRichiestaOLO);&#xD;
	}&#xD;
&#xD;
	&#xD;
//SM_2713 Arricchimento dettaglio per VULL&#xD;
if(asset != null &amp;&amp; &#xD;
	(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA))&#xD;
	{&#xD;
		//controllo esistenza asset in input&#xD;
		if(asset.dettaglioasset !=null &amp;&amp; asset.dettaglioasset.size() > 0)&#xD;
		{&#xD;
			var CODIFICAOLOAGCOMDONORtrovato = false;&#xD;
			var FLAGDNDONOROLOtrovato = false;&#xD;
			for(var i = 0; i &lt; asset.dettaglioasset.size(); i++)&#xD;
			{&#xD;
				//arricchimento del dettaglio dell'ordine con il dettaglio dell'Asset&#xD;
				var currentDettAsset = asset.dettaglioasset.get(i);&#xD;
				&#xD;
				// Controllo OFFERTA e COMPONENTI come da SF&#xD;
				if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULL) &#xD;
				{&#xD;
					var dettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();					&#xD;
					dettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					dettOrdine.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
					dettOrdine.created = date;&#xD;
					dettOrdine.lastUpdate = date;&#xD;
					dettOrdine.operatore = &quot;BPM&quot;;&#xD;
					dettOrdine.IDRisorsa = currentDettAsset.IDRisorsa;&#xD;
					dettOrdine.nomeComponente = currentDettAsset.nomeComponente;&#xD;
					dettOrdine.integrationID = localRequest.IDRichiestaOLO + dettOrdine.IDDettaglioOrdine;&#xD;
					dettOrdine.progressivo = currentDettAsset.progressivo;&#xD;
					dettOrdine.IDRisorsaNOW = currentDettAsset.IDRisorsaNOW;&#xD;
					&#xD;
					var attribDettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
					attribDettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attribDettOrdine.IDDettaglioOrdine = dettOrdine.IDDettaglioOrdine;&#xD;
					attribDettOrdine.created = date;&#xD;
					attribDettOrdine.lastUpdate = date;&#xD;
					attribDettOrdine.operatore = &quot;BPM&quot;;&#xD;
					&#xD;
							&#xD;
					for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
					&#xD;
						var currentAttribDettAss = currentDettAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
						//Solo gli attributi come da SFN&#xD;
						if(	&#xD;
							currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA &#xD;
							||	currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA&#xD;
							||	currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONOR &#xD;
							||	currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGDNDONOROLO)&#xD;
						{						&#xD;
							&#xD;
							attribDettOrdine.nomeAttributo = currentAttribDettAss.nomeAttributo;&#xD;
							attribDettOrdine.valoreAttributo = currentAttribDettAss.valoreAttributo;&#xD;
							attribDettOrdine.tipologiaDato = currentAttribDettAss.tipologiaDato;&#xD;
							&#xD;
							dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
							if(currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONOR){&#xD;
								CODIFICAOLOAGCOMDONORtrovato = true;&#xD;
							}&#xD;
							else if(currentAttribDettAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGDNDONOROLO){&#xD;
								FLAGDNDONOROLOtrovato = true;&#xD;
							}&#xD;
						}&#xD;
							//End if&#xD;
						&#xD;
							&#xD;
					}//End for j&#xD;
					&#xD;
					if(!FLAGDNDONOROLOtrovato){&#xD;
						if(FlagDnOlo!= null &amp;&amp; FlagDnOlo!= &quot;&quot;){&#xD;
							attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGDNDONOROLO;&#xD;
							attribDettOrdine.valoreAttributo = FlagDnOlo;&#xD;
							attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
						}&#xD;
						else {&#xD;
							Process.auditLog(&quot;FLAGDNDONOROLO non aggiunto in quanto non presente inn asset e non recuperato con (C02M16F05 – Verifica Numerazione Donor OLO)&quot;);&#xD;
						}&#xD;
					}&#xD;
					if(!CODIFICAOLOAGCOMDONORtrovato){&#xD;
						if(CodificaOLOAGCOMDonor != null &amp;&amp; CodificaOLOAGCOMDonor!= &quot;&quot;){&#xD;
							attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONOR;&#xD;
							attribDettOrdine.valoreAttributo = CodificaOLOAGCOMDonor;&#xD;
							attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
						}&#xD;
						else{&#xD;
							Process.auditLog(&quot;CODIFICAOLOAGCOMDONOR non aggiunto in quanto non presente inn asset e non recuperato con (C02M16F05 – Verifica Numerazione Donor OLO)&quot;);&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					&#xD;
					localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettOrdine));&#xD;
				}//End if&#xD;
				else&#xD;
				{&#xD;
					Process.auditLog(&quot;Nessuna Offerta o Componente da Cessare per IDRichiesta&quot; + localRequest.IDRichiestaOLO + &quot; ed Asset: &quot; + asset.IDAsset);&#xD;
				}&#xD;
			}//end for i		&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Impossibile completare la funzione di Arricchimento: Asset o DettagliAsset inesistenti per IDRichiesta &quot; + localRequest.IDRichiestaOLO + &quot; ed Asset: &quot; + asset.IDAsset);&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Impossibile completare la funzione di Arricchimento: Impossibile trovare l'Asset di riferimento per IDRichiesta &quot; + localRequest.IDRichiestaOLO);&#xD;
	}&#xD;
&#xD;
//C02M02F03 Valorizzazione Azione&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i = 0 ; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULL ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATI ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLU ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
		)&#xD;
		{&#xD;
			&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULL &#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULLDATI&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSHA&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULL)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;			&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//C01M02F12 Recupero DISTRETTO/IDCONTRATTO/CLIENTE/NUMEROFITTIZIO DA ASSET&#xD;
if(asset != null)&#xD;
{&#xD;
	if (asset.distretto != null &amp;&amp; asset.distretto.length > 0)&#xD;
	{&#xD;
		localRequest.ordine.distretto = asset.distretto;&#xD;
	}&#xD;
	if (asset.IDContratto != null)&#xD;
	{&#xD;
		localRequest.IDContratto = asset.IDContratto;&#xD;
	}&#xD;
	if (asset.numeroFittizio != null &amp;&amp; asset.numeroFittizio.length > 0)&#xD;
	{&#xD;
		localRequest.ordine.numeroFittizio = asset.numeroFittizio;&#xD;
	}	&#xD;
		&#xD;
	if(asset.cliente != null 									&#xD;
		&amp;&amp; localRequest.ordine.nome == null &#xD;
		&amp;&amp; localRequest.ordine.cognomeRagioneSociale == null &#xD;
		&amp;&amp; localRequest.ordine.CF == null&#xD;
		&amp;&amp; localRequest.ordine.PIVA == null)  //Task #38239&#xD;
	{&#xD;
		if (asset.cliente.nome != null &amp;&amp; (localRequest.ordine.nome == null || localRequest.ordine.nome == &quot;&quot;))&#xD;
		{&#xD;
			localRequest.ordine.nome = asset.cliente.nome;&#xD;
		}		&#xD;
		if (asset.cliente.cognomeRagioneSociale != null &amp;&amp; (localRequest.ordine.cognomeRagioneSociale == null || localRequest.ordine.cognomeRagioneSociale == &quot;&quot;))&#xD;
		{&#xD;
			localRequest.ordine.cognomeRagioneSociale = asset.cliente.cognomeRagioneSociale;&#xD;
		}&#xD;
		&#xD;
		//SM_10686: Spostato arricchimento dei due campi qui invece che negli arricchimenti comuni&#xD;
		//CF e PIVA sono mutuamente esclusivi e non vanno arricchiti se uno dei due è indicato in input dall'OLO&#xD;
		if(localRequest.ordine.CF == null &amp;&amp; localRequest.ordine.PIVA == null)&#xD;
		{				&#xD;
			localRequest.ordine.CF = asset.cliente.codiceFiscale;&#xD;
			localRequest.ordine.PIVA = asset.cliente.partitaIVA;			&#xD;
		}&#xD;
	}&#xD;
	if (localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
		&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA&#xD;
		&amp;&amp; asset.numeroTelefonico != null)&#xD;
	{&#xD;
		localRequest.ordine.numeroTelefonico = asset.numeroTelefonico;&#xD;
	}&#xD;
	else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA)&#xD;
			&amp;&amp; asset.IDRisorsa != null)&#xD;
	{&#xD;
		localRequest.ordine.numeroTelefonico = asset.IDRisorsa;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//RU_1317: aggiunto arricchimento di PROPRIETAMATERIALE&#xD;
&#xD;
//SM_9499: per alcune CESSAZIONI, nel momento in cui chiamiamo DETERMINACLUSTER non abbiamo ancora l'accesso, quindi ci perderemmo l'arricchimento di TIPOLOGIACLUSTERCOMUNE&#xD;
// Per quelle Cessazioni facciamo qui l'arricchimento e non nel complete script del controllo DETERMINA CLUSTER_C01M02F26&#xD;
//verifico se DeterminaCluster ha restituito tipologia cluster&#xD;
var foundTipologiaCluster = false;&#xD;
var foundProprietaMateriale = false;&#xD;
var trovatoFlagEquivalenzaProdotti = false; //RU_1390&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine !=null)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		//se già presente nell'ordine lo sovrascrivo&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var x = 0;&#xD;
			&#xD;
			while((!foundTipologiaCluster || !foundProprietaMateriale || !trovatoFlagEquivalenzaProdotti) &amp;&amp; x&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(x);&#xD;
				&#xD;
				if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE&#xD;
				   &amp;&amp; TipologiaClusterComune != null &amp;&amp; TipologiaClusterComune != &quot;&quot;)&#xD;
				{&#xD;
					foundTipologiaCluster = true;&#xD;
					currentAttributo.valoreAttributo = TipologiaClusterComune;&#xD;
				}&#xD;
				//RU_1317&#xD;
				else if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE&#xD;
				   &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
				{&#xD;
					foundProprietaMateriale = true;&#xD;
					currentAttributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
				}&#xD;
				//RU_1390&#xD;
				else if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI&#xD;
					   &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
				{&#xD;
					trovatoFlagEquivalenzaProdotti = true;&#xD;
					currentAttributo.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
					Process.auditLog(&quot;Aggiornato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
				}&#xD;
				x++;&#xD;
			}&#xD;
			// se non presente nell'ordine lo aggiungo&#xD;
			if(!foundTipologiaCluster &amp;&amp; TipologiaClusterComune != null &amp;&amp; TipologiaClusterComune != &quot;&quot;)&#xD;
			{&#xD;
				var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE;&#xD;
				nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				nuovoAttributo.valoreAttributo = TipologiaClusterComune;&#xD;
				nuovoAttributo.operatore = localRequest.operatore;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
				Process.auditLog(&quot;Aggiunto TIPOLOGIACLUSTERCOMUNE post controllo&quot;);&#xD;
			}&#xD;
			&#xD;
			//RU_1317&#xD;
			if(!foundProprietaMateriale &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
			{&#xD;
				var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
				nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE;&#xD;
				nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				nuovoAttributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
				nuovoAttributo.operatore = localRequest.operatore;&#xD;
				currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
				Process.auditLog(&quot;Aggiunto PROPRIETAMATERIALE con valore: &quot; + LavorazioneRichiesta.proprietaMateriale);&#xD;
			}&#xD;
			//RU_1390&#xD;
			if(!trovatoFlagEquivalenzaProdotti &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				trovatoFlagEquivalenzaProdotti = true;&#xD;
				Process.auditLog(&quot;Creato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
