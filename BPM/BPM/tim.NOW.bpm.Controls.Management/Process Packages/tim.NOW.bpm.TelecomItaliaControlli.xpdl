        <xpdl2:Activity Id="_Fn94cjSrEfCGg_2k9MqMyQ" Name="Arricchimentoazioniecomponenti" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento azioni e componenti" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//SCRIPT DI ARRICCHIMENTO PER LE OFFERTE FULLGPONPLUS e FULLGPONPLUSNGA&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{	&#xD;
	if(VerificaContrattoOutput != null &amp;&amp; VerificaContrattoOutput.codiceOperatoreRete != null &amp;&amp; VerificaContrattoOutput.codiceOperatoreRete != '')&#xD;
	{&#xD;
		localRequest.operatoreRete == VerificaContrattoOutput.codiceOperatoreRete;&#xD;
		localRequest.ordine.operatoreRete == VerificaContrattoOutput.codiceOperatoreRete;&#xD;
	}&#xD;
&#xD;
	//CONFIGURAZIONE AZIONE&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTH&#xD;
		   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONGAFTTH&#xD;
		   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
		   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
		{&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;   &#xD;
		}  &#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
 &#xD;
	//ARRICCHIMENTO GENERICO - ACCESSO&#xD;
	var foundProprietaMateriale = false;&#xD;
	var foundFlagEquivalenzaProdotti = false; &#xD;
	var foundcomuneAbilitatoCU = false; &#xD;
	var foundStatoTokenAppuntamento = false;&#xD;
&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{		&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE&#xD;
				   &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
				{&#xD;
					foundProprietaMateriale = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;&#xD;
					Process.auditLog(&quot;Aggiornato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI&#xD;
				   &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null) //RU_1390&#xD;
				{&#xD;
					foundFlagEquivalenzaProdotti = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;&#xD;
					Process.auditLog(&quot;Aggiornato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COMUNEABILITATOCU&#xD;
				   &amp;&amp; LavorazioneRichiesta.comuneAbilitatoCU != null)&#xD;
				{&#xD;
					foundcomuneAbilitatoCU = true;&#xD;
					attr.valoreAttributo = LavorazioneRichiesta.comuneAbilitatoCU;&#xD;
					Process.auditLog(&quot;Aggiornato attributo COMUNEABILITATOCU con valore: &quot;+ LavorazioneRichiesta.comuneAbilitatoCU);&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATOTOKENAPPUNTAMENTO)&#xD;
				{&#xD;
					foundStatoTokenAppuntamento = true;&#xD;
					attr.valoreAttributo = &quot;VALIDO&quot;;&#xD;
					Process.auditLog(&quot;Aggiornato attributo STATOTOKENAPPUNTAMENTO con valore: &quot;+ attr.valoreAttributo);	&#xD;
				}&#xD;
			}&#xD;
						&#xD;
			if(!foundProprietaMateriale &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROPRIETAMATERIALE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.proprietaMateriale;			&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundProprietaMateriale = true;&#xD;
				Process.auditLog(&quot;Creato attributo PROPRIETAMATERIALE con valore: &quot;+ LavorazioneRichiesta.proprietaMateriale);&#xD;
			}&#xD;
			if(!foundFlagEquivalenzaProdotti &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGEQUIVALENZAPRODOTTI;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.flagEquivalenzaProdotti;			&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundFlagEquivalenzaProdotti = true;&#xD;
				Process.auditLog(&quot;Creato attributo FLAGEQUIVALENZAPRODOTTI con valore: &quot;+ LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
			}&#xD;
			if(!foundcomuneAbilitatoCU &amp;&amp; LavorazioneRichiesta.comuneAbilitatoCU != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COMUNEABILITATOCU;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.comuneAbilitatoCU;			&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundcomuneAbilitatoCU = true;&#xD;
				Process.auditLog(&quot;Creato attributo COMUNEABILITATOCU con valore: &quot;+ LavorazioneRichiesta.comuneAbilitatoCU);&#xD;
			}&#xD;
			if(!foundStatoTokenAppuntamento)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATOTOKENAPPUNTAMENTO;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = &quot;VALIDO&quot;;			&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundStatoTokenAppuntamento = true;&#xD;
				Process.auditLog(&quot;Creato attributo STATOTOKENAPPUNTAMENTO con valore: &quot;+ attributo.valoreAttributo);&#xD;
			}			&#xD;
		}		&#xD;
	}&#xD;
&#xD;
	//RU_1066: creazione componente SERVIZIOPZIONALI con CODICESERVIZIO e DESCRIZIONESERVIZIO in uscita dal controllo C01M02F35 per EASYIPNGAFTTH e EASYIPNGAFTTCAB&#xD;
	//RU_1081: stravolta logica di arricchimento per SERVIZIOPZIONALI autogenerati in uscita dal controllo C01M02F35&#xD;
	//RU_1116: l'arricchimento dei SERVIZIOPZIONALI non va fatto più solo per EASYIPNGAFTTH e EASYIPNGAFTTCAB (quindi eliminato if su queste offerte nell'arricchimento), ma per tutte le offerte del serpentone:&#xD;
	//l'unica differenza è che per le offerte VULAH/NGA FTTH e VULAC/NGA FTTCab la logica di arricchimento di DATITECNICI non usa il REMOTEID (di CalcolaRemoteID), ma va preso il valore direttamente in uscita dal controllo C01M02F35&#xD;
	if(ServiziOpzAutogenerati != null &amp;&amp; ServiziOpzAutogenerati.size() > 0)&#xD;
	{&#xD;
		Process.auditLog(&quot;Inizio arricchimento servizi opzionali AUTOGENERATI&quot;);&#xD;
		&#xD;
		for(var m=0; m&lt;ServiziOpzAutogenerati.size(); m++)&#xD;
		{&#xD;
			currentServiziOpzAutogenerati = ServiziOpzAutogenerati.get(m);&#xD;
			var ServiziOpzionaliAGGIORNATI = false;&#xD;
			&#xD;
			//RU_1128: A parità di CODICESERVIZIO, bisogna inserire una sola volta SERVIZIOPZIONALI, quindi ciascun ServizioOpzionale in uscita da C01M02F35 lo confronto con i precedenti elementi dell'array per fare in modo che sia inserito una sola volta&#xD;
			var ServiziOpzINSERIMENTO = true;&#xD;
			var s=0;&#xD;
			&#xD;
			while(ServiziOpzINSERIMENTO &amp;&amp; s&lt;m){&#xD;
				ServiziOpzAutogeneratiPREC = ServiziOpzAutogenerati.get(s);&#xD;
				&#xD;
				if(ServiziOpzAutogeneratiPREC.codiceServizio == currentServiziOpzAutogenerati.codiceServizio){&#xD;
					ServiziOpzINSERIMENTO = false;&#xD;
				}&#xD;
				s++;&#xD;
			}&#xD;
			&#xD;
			//RU_1128: AGGIUNTO IF, CIASCUN SERVIZIOPZIONALE VA INSERITO UNA SOLA VOLTA A PARITà DI CODICESERVIZIO&#xD;
			if(ServiziOpzINSERIMENTO)&#xD;
			{		&#xD;
				//SE TROVO SERVIZIOPZIONALI CON QUEL CODICESERVIZIO NELLA RICHIESTA -> ARRICCHISCO SERVIZIOPZIONALI DELLA RICHIESTA PER NON CREARE DUPLICATI&#xD;
				for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
				{&#xD;
					var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
					&#xD;
					if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
					{&#xD;
						var CodiceServizioRichiesta = &quot;&quot;;&#xD;
						CodiceServizioRichiesta = null;&#xD;
						&#xD;
						for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++){&#xD;
							var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
							&#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO){&#xD;
								CodiceServizioRichiesta = attributo.valoreAttributo;&#xD;
								Process.auditLog(&quot;Trovato attributo CODICESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						//Se sono uguali i CODICISERVIZIO&#xD;
						if(currentServiziOpzAutogenerati.codiceServizio != null &amp;&amp; CodiceServizioRichiesta != null&#xD;
						   &amp;&amp; currentServiziOpzAutogenerati.codiceServizio == CodiceServizioRichiesta)&#xD;
						{&#xD;
							//Aggiorno campi della componente&#xD;
							var data = DateTimeUtil.createDatetime();&#xD;
							componente.operatore = &quot;BPM&quot;;       //mi serve per arricchimento dei SERVIZIOPZIONALI nel CalcoloRemoteID&#xD;
							componente.lastUpdate = data;&#xD;
							&#xD;
							ServiziOpzionaliAGGIORNATI = true;   //Arricchimento&#xD;
							&#xD;
							var trovatoDescrizioneServizioAuto = false;  //SM_11482&#xD;
							var trovatoDatiTecniciAuto = false;&#xD;
							var trovatoVincolanteAuto = false;&#xD;
							&#xD;
							for(var k=0; k&lt;componente.attributiDettaglioOrdine.size(); k++)&#xD;
							{&#xD;
								var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
								&#xD;
								if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONESERVIZIO&#xD;
								   &amp;&amp; currentServiziOpzAutogenerati.descrizioneServizio != null)&#xD;
								{&#xD;
									trovatoDescrizioneServizioAuto = true; &#xD;
									attributo.valoreAttributo = currentServiziOpzAutogenerati.descrizioneServizio;&#xD;
									Process.auditLog(&quot;Aggiornato attributo DESCRIZIONESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
								}&#xD;
								//Se CODICESERVIZIO = A001 allora in DATITECNICI viene messo il REALM (questo solo per EASYIPNGAFTTH e EASYIPNGAFTTCAB) usato poi nel complete script del CalcoloRemoteID, altrimenti viene messo il valore definitivo &#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI&#xD;
										&amp;&amp; currentServiziOpzAutogenerati.datiTecnici != null)  &#xD;
								{&#xD;
									trovatoDatiTecniciAuto = true;&#xD;
									attributo.valoreAttributo = currentServiziOpzAutogenerati.datiTecnici;&#xD;
									Process.auditLog(&quot;Aggiornato attributo DATITECNICI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
								}&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO&#xD;
										&amp;&amp; currentServiziOpzAutogenerati.vincolantePerEspletamento != null&#xD;
										&amp;&amp; currentServiziOpzAutogenerati.codiceServizio != &quot;A001&quot;)  //Se è A001, va lasciato quello in input&#xD;
								{&#xD;
									trovatoVincolanteAuto = true;&#xD;
									attributo.valoreAttributo = currentServiziOpzAutogenerati.vincolantePerEspletamento;&#xD;
									Process.auditLog(&quot;Aggiornato attributo VINCOLANTEPERESPLETAMENTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
								}&#xD;
							}&#xD;
							&#xD;
							//SM_11482&#xD;
							var attributoSrvz = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
							attributoSrvz.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
							attributoSrvz.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
							attributoSrvz.created = data;&#xD;
							attributoSrvz.lastUpdate = data;&#xD;
							attributoSrvz.operatore = componente.operatore;&#xD;
							attributoSrvz.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							&#xD;
							if(!trovatoDescrizioneServizioAuto &amp;&amp; currentServiziOpzAutogenerati.descrizioneServizio != null){&#xD;
								attributoSrvz.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONESERVIZIO;&#xD;
								attributoSrvz.valoreAttributo = currentServiziOpzAutogenerati.descrizioneServizio;&#xD;
								componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoSrvz));&#xD;
								Process.auditLog(&quot;Creato attributo DESCRIZIONESERVIZIO&quot;+ attributoSrvz.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
							}						&#xD;
							if(!trovatoDatiTecniciAuto &amp;&amp; currentServiziOpzAutogenerati.datiTecnici != null){&#xD;
								attributoSrvz.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI;&#xD;
								attributoSrvz.valoreAttributo = currentServiziOpzAutogenerati.datiTecnici;&#xD;
								componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoSrvz));&#xD;
								Process.auditLog(&quot;Creato attributo DATITECNICI&quot;+ attributoSrvz.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
							}						&#xD;
							if(!trovatoVincolanteAuto &amp;&amp; currentServiziOpzAutogenerati.vincolantePerEspletamento != null){&#xD;
								attributoSrvz.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO;&#xD;
								attributoSrvz.valoreAttributo = currentServiziOpzAutogenerati.vincolantePerEspletamento;&#xD;
								componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoSrvz));&#xD;
								Process.auditLog(&quot;Creato attributo VINCOLANTEPERESPLETAMENTO&quot;+ attributoSrvz.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
							}&#xD;
						}	&#xD;
					}	&#xD;
				}&#xD;
				&#xD;
				//SE NON TROVO SERVIZIOPZIONALI CON QUEL CODICESERVIZIO NELLA RICHIESTA -> CREO LA COMPONENTE SERVIZIOPZIONALI&#xD;
				if(!ServiziOpzionaliAGGIORNATI)&#xD;
				{&#xD;
					var data = DateTimeUtil.createDatetime();&#xD;
					var componenteServiziOpzionali = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
					componenteServiziOpzionali.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					componenteServiziOpzionali.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
					componenteServiziOpzionali.IDDettaglioOrdineParent = 1;&#xD;
					componenteServiziOpzionali.IDDettaglioOrdineRoot = 1;&#xD;
					componenteServiziOpzionali.IDRisorsa = localRequest.IDRisorsa;&#xD;
					componenteServiziOpzionali.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
					componenteServiziOpzionali.operatore = &quot;BPM&quot;;&#xD;
					componenteServiziOpzionali.progressivo = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
					componenteServiziOpzionali.created = data;&#xD;
					componenteServiziOpzionali.integrationID = localRequest.IDRichiestaOLO + localRequest.ordine.dettaglioordine.size() + 1;&#xD;
					componenteServiziOpzionali.lastUpdate = data;&#xD;
					componenteServiziOpzionali.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
					componenteServiziOpzionali.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI; &#xD;
					&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attributo.IDDettaglioOrdine = componenteServiziOpzionali.IDDettaglioOrdine;&#xD;
					attributo.IDRichiestaOLO = componenteServiziOpzionali.IDRichiestaOLO;&#xD;
					attributo.created = data;&#xD;
					attributo.lastUpdate = data;&#xD;
					attributo.operatore = componenteServiziOpzionali.operatore;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					&#xD;
					//CODICESERVIZIO&#xD;
					if(currentServiziOpzAutogenerati.codiceServizio != null){&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO;&#xD;
						attributo.valoreAttributo = currentServiziOpzAutogenerati.codiceServizio;&#xD;
						componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						Process.auditLog(&quot;Creato attributo CODICESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
					}				&#xD;
					//DESCRIZIONESERVIZIO&#xD;
					if(currentServiziOpzAutogenerati.descrizioneServizio != null){&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONESERVIZIO;&#xD;
						attributo.valoreAttributo = currentServiziOpzAutogenerati.descrizioneServizio;&#xD;
						componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						Process.auditLog(&quot;Creato attributo DESCRIZIONESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
					}				&#xD;
					//DATITECNICI - Se CODICESERVIZIO = A001 allora in DATITECNICI viene messo il REALM (questo solo per EASYIPNGAFTTH e EASYIPNGAFTTCAB) usato poi nel complete script del CalcoloRemoteID, altrimenti viene messo il valore definitivo &#xD;
					if(currentServiziOpzAutogenerati.datiTecnici != null){&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI;&#xD;
						attributo.valoreAttributo = currentServiziOpzAutogenerati.datiTecnici;&#xD;
						componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						Process.auditLog(&quot;Creato attributo DATITECNICI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
					}&#xD;
					//VINCOLANTEPERESPLETAMENTO&#xD;
					if(currentServiziOpzAutogenerati.vincolantePerEspletamento != null){&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO;&#xD;
						attributo.valoreAttributo = currentServiziOpzAutogenerati.vincolantePerEspletamento;&#xD;
						componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						Process.auditLog(&quot;Creato attributo VINCOLANTEPERESPLETAMENTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
					}				&#xD;
					//Aggiungo componente all'ordine&#xD;
					localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componenteServiziOpzionali));&#xD;
				}			&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
&#xD;
	//RU_1485: arricchimento SERVIZIOPZIONALI in uscita da C01M02F42&#xD;
	if(ServiziOpzAlternativi != null &amp;&amp; ServiziOpzAlternativi.size() > 0)&#xD;
	{&#xD;
		Process.auditLog(&quot;Inizio arricchimento servizi opzionali ALTERNATIVI&quot;);&#xD;
		&#xD;
		for(var m=0; m&lt;ServiziOpzAlternativi.size(); m++)&#xD;
		{&#xD;
			currentServiziOpzAlternativi = ServiziOpzAlternativi.get(m);&#xD;
			var ServiziOpzionaliAGGIORNATI = false;&#xD;
			&#xD;
			//A parità di CODICESERVIZIO, bisogna inserire una sola volta SERVIZIOPZIONALI, quindi ciascun ServizioOpzionale in uscita da C01M02F42 lo confronto con i precedenti elementi dell'array per fare in modo che sia inserito una sola volta&#xD;
			var ServiziOpzINSERIMENTO = true;&#xD;
			var s=0;&#xD;
			&#xD;
			while(ServiziOpzINSERIMENTO &amp;&amp; s&lt;m){&#xD;
				ServiziOpzAlternativiPREC = ServiziOpzAlternativi.get(s);&#xD;
				&#xD;
				if(ServiziOpzAlternativiPREC.codiceServizio == currentServiziOpzAlternativi.codiceServizio){&#xD;
					ServiziOpzINSERIMENTO = false;&#xD;
				}&#xD;
				s++;&#xD;
			}&#xD;
			&#xD;
			//CIASCUN SERVIZIOPZIONALE VA INSERITO UNA SOLA VOLTA A PARITà DI CODICESERVIZIO&#xD;
			if(ServiziOpzINSERIMENTO)&#xD;
			{	&#xD;
				//SE TROVO SERVIZIOPZIONALI CON QUEL CODICESERVIZIO NELLA RICHIESTA -> ARRICCHISCO SERVIZIOPZIONALI DELLA RICHIESTA PER NON CREARE DUPLICATI&#xD;
				for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
				{&#xD;
					var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
					&#xD;
					if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
					{&#xD;
						var CodiceServizioRichiesta = &quot;&quot;;&#xD;
						CodiceServizioRichiesta = null;&#xD;
						&#xD;
						for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++){&#xD;
							var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
							&#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO){&#xD;
								CodiceServizioRichiesta = attributo.valoreAttributo;&#xD;
								Process.auditLog(&quot;Trovato attributo CODICESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						//Se sono uguali i CODICISERVIZIO&#xD;
						if(currentServiziOpzAlternativi.codiceServizio != null &amp;&amp; CodiceServizioRichiesta != null&#xD;
						   &amp;&amp; currentServiziOpzAlternativi.codiceServizio == CodiceServizioRichiesta)&#xD;
						{&#xD;
							//Aggiorno campi della componente&#xD;
							var data = DateTimeUtil.createDatetime();&#xD;
							componente.operatore = &quot;BPM&quot;;       //mi serve per arricchimento dei SERVIZIOPZIONALI nel CalcoloRemoteID&#xD;
							componente.lastUpdate = data;&#xD;
							&#xD;
							ServiziOpzionaliAGGIORNATI = true;  //Arricchimento&#xD;
							&#xD;
							var trovatoDescrizioneServizio = false;  //SM_11447&#xD;
							var trovatoDatiTecnici = false;&#xD;
							var trovatoVincolante = false;&#xD;
							var trovatoProdottoCatalogo = false;&#xD;
							&#xD;
							for(var k=0; k&lt;componente.attributiDettaglioOrdine.size(); k++)&#xD;
							{&#xD;
								var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
								&#xD;
								if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONESERVIZIO&#xD;
								   &amp;&amp; currentServiziOpzAlternativi.descrizioneServizio != null)&#xD;
								{&#xD;
									attributo.valoreAttributo = currentServiziOpzAlternativi.descrizioneServizio;&#xD;
									trovatoDescrizioneServizio = true;&#xD;
									Process.auditLog(&quot;Aggiornato attributo DESCRIZIONESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
								}&#xD;
								//Se CODICESERVIZIO = A001 allora in DATITECNICI viene messo il REALM (questo solo per EASYIPNGAFTTH e EASYIPNGAFTTCAB) usato poi nel complete script del CalcoloRemoteID, altrimenti viene messo il valore definitivo &#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI&#xD;
										&amp;&amp; currentServiziOpzAlternativi.datiTecnici != null)  &#xD;
								{&#xD;
									attributo.valoreAttributo = currentServiziOpzAlternativi.datiTecnici;&#xD;
									trovatoDatiTecnici = true;&#xD;
									Process.auditLog(&quot;Aggiornato attributo DATITECNICI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
								}&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO&#xD;
										&amp;&amp; currentServiziOpzAlternativi.vincolantePerEspletamento != null&#xD;
										&amp;&amp; currentServiziOpzAlternativi.codiceServizio != &quot;A001&quot;)  //Se è A001, va lasciato quello in input&#xD;
								{&#xD;
									attributo.valoreAttributo = currentServiziOpzAlternativi.vincolantePerEspletamento;&#xD;
									trovatoVincolante = true;&#xD;
									Process.auditLog(&quot;Aggiornato attributo VINCOLANTEPERESPLETAMENTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
								}&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PRODOTTOCATALOGO&#xD;
										&amp;&amp; currentServiziOpzAlternativi.prodottoCatalogo != null)  &#xD;
								{&#xD;
									attributo.valoreAttributo = currentServiziOpzAlternativi.prodottoCatalogo;&#xD;
									trovatoProdottoCatalogo = true;&#xD;
									Process.auditLog(&quot;Aggiornato attributo PRODOTTOCATALOGO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
								}&#xD;
							}&#xD;
							&#xD;
							var attributoSrvz = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
							attributoSrvz.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
							attributoSrvz.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
							attributoSrvz.created = data;&#xD;
							attributoSrvz.lastUpdate = data;&#xD;
							attributoSrvz.operatore = componente.operatore;&#xD;
							attributoSrvz.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							&#xD;
							if(!trovatoDescrizioneServizio &amp;&amp; currentServiziOpzAlternativi.descrizioneServizio != null){&#xD;
								attributoSrvz.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONESERVIZIO;&#xD;
								attributoSrvz.valoreAttributo = currentServiziOpzAlternativi.descrizioneServizio;&#xD;
								componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoSrvz));&#xD;
								Process.auditLog(&quot;Creato attributo DESCRIZIONESERVIZIO&quot;+ attributoSrvz.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
							}						&#xD;
							if(!trovatoDatiTecnici &amp;&amp; currentServiziOpzAlternativi.datiTecnici != null){&#xD;
								attributoSrvz.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI;&#xD;
								attributoSrvz.valoreAttributo = currentServiziOpzAlternativi.datiTecnici;&#xD;
								componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoSrvz));&#xD;
								Process.auditLog(&quot;Creato attributo DATITECNICI&quot;+ attributoSrvz.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
							}						&#xD;
							if(!trovatoVincolante &amp;&amp; currentServiziOpzAlternativi.vincolantePerEspletamento != null){&#xD;
								attributoSrvz.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO;&#xD;
								attributoSrvz.valoreAttributo = currentServiziOpzAlternativi.vincolantePerEspletamento;&#xD;
								componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoSrvz));&#xD;
								Process.auditLog(&quot;Creato attributo VINCOLANTEPERESPLETAMENTO&quot;+ attributoSrvz.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
							}						&#xD;
							if(!trovatoProdottoCatalogo &amp;&amp; currentServiziOpzAlternativi.prodottoCatalogo != null){&#xD;
								attributoSrvz.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PRODOTTOCATALOGO;&#xD;
								attributoSrvz.valoreAttributo = currentServiziOpzAlternativi.prodottoCatalogo;&#xD;
								componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoSrvz));&#xD;
								Process.auditLog(&quot;Creato attributo PRODOTTOCATALOGO&quot;+ attributoSrvz.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
							}&#xD;
						}	&#xD;
					}	&#xD;
				}&#xD;
				&#xD;
				//SE NON TROVO SERVIZIOPZIONALI CON QUEL CODICESERVIZIO NELLA RICHIESTA -> CREO LA COMPONENTE SERVIZIOPZIONALI&#xD;
				if(!ServiziOpzionaliAGGIORNATI)&#xD;
				{&#xD;
					var data = DateTimeUtil.createDatetime();&#xD;
					var componenteServiziOpzionali = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
					componenteServiziOpzionali.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					componenteServiziOpzionali.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
					componenteServiziOpzionali.IDDettaglioOrdineParent = 1;&#xD;
					componenteServiziOpzionali.IDDettaglioOrdineRoot = 1;&#xD;
					componenteServiziOpzionali.IDRisorsa = localRequest.IDRisorsa;&#xD;
					componenteServiziOpzionali.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
					componenteServiziOpzionali.operatore = &quot;BPM&quot;;&#xD;
					componenteServiziOpzionali.progressivo = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
					componenteServiziOpzionali.created = data;&#xD;
					componenteServiziOpzionali.integrationID = localRequest.IDRichiestaOLO + localRequest.ordine.dettaglioordine.size() + 1;&#xD;
					componenteServiziOpzionali.lastUpdate = data;&#xD;
					componenteServiziOpzionali.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
					componenteServiziOpzionali.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI; &#xD;
					&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attributo.IDDettaglioOrdine = componenteServiziOpzionali.IDDettaglioOrdine;&#xD;
					attributo.IDRichiestaOLO = componenteServiziOpzionali.IDRichiestaOLO;&#xD;
					attributo.created = data;&#xD;
					attributo.lastUpdate = data;&#xD;
					attributo.operatore = componenteServiziOpzionali.operatore;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					&#xD;
					//CODICESERVIZIO&#xD;
					if(currentServiziOpzAlternativi.codiceServizio != null){&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO;&#xD;
						attributo.valoreAttributo = currentServiziOpzAlternativi.codiceServizio;&#xD;
						componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						Process.auditLog(&quot;Creato attributo CODICESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
					}				&#xD;
					//DESCRIZIONESERVIZIO&#xD;
					if(currentServiziOpzAlternativi.descrizioneServizio != null){&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONESERVIZIO;&#xD;
						attributo.valoreAttributo = currentServiziOpzAlternativi.descrizioneServizio;&#xD;
						componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						Process.auditLog(&quot;Creato attributo DESCRIZIONESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
					}				&#xD;
					//Se CODICESERVIZIO = A001 allora in DATITECNICI viene messo il REALM (questo solo per EASYIPNGAFTTH e EASYIPNGAFTTCAB) usato poi nel complete script del CalcoloRemoteID, altrimenti viene messo il valore definitivo &#xD;
					if(currentServiziOpzAlternativi.datiTecnici != null){&#xD;
						//DATITECNICI&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI;&#xD;
						attributo.valoreAttributo = currentServiziOpzAlternativi.datiTecnici;&#xD;
						componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						Process.auditLog(&quot;Creato attributo DATITECNICI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
					}&#xD;
					//VINCOLANTEPERESPLETAMENTO&#xD;
					if(currentServiziOpzAlternativi.vincolantePerEspletamento != null){&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO;&#xD;
						attributo.valoreAttributo = currentServiziOpzAlternativi.vincolantePerEspletamento;&#xD;
						componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						Process.auditLog(&quot;Creato attributo VINCOLANTEPERESPLETAMENTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
					}				&#xD;
					//PRODOTTOCATALOGO&#xD;
					if(currentServiziOpzAlternativi.prodottoCatalogo != null){&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PRODOTTOCATALOGO;&#xD;
						attributo.valoreAttributo = currentServiziOpzAlternativi.prodottoCatalogo;&#xD;
						componenteServiziOpzionali.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						Process.auditLog(&quot;Creato attributo PRODOTTOCATALOGO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componenteServiziOpzionali.IDDettaglioOrdine);&#xD;
					}			&#xD;
					//Aggiungo componente all'ordine&#xD;
					localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componenteServiziOpzionali));&#xD;
				}		&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
&#xD;
	&#xD;
	//ARRICCHIMENTO CARATTERISTICAVLAN delle componenti USERVLAN in uscita C04M01F36&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)&#xD;
	{&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{&#xD;
				var trovatoCaratteristicaVlan = false;&#xD;
				&#xD;
				for(var k=0; k&lt;EsistenzaVLANOutput.size(); k++)&#xD;
				{&#xD;
					var vlanOut = EsistenzaVLANOutput.get(k);&#xD;
					&#xD;
					if(vlanOut.IDDettaglioOrdine == componente.IDDettaglioOrdine&#xD;
					   &amp;&amp; vlanOut.CARATTERISTICAVLAN == &quot;DRG OPZIONE ZERO&quot; &amp;&amp; vlanOut.BMD == &quot;Y&quot;)&#xD;
					{&#xD;
						localRequest.ordine.caratterizzazioneAccesso = &quot;DRG OPZIONE ZERO&quot;;   &#xD;
					&#xD;
						for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++){&#xD;
							var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
							&#xD;
							if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVLAN)&#xD;
							{&#xD;
								trovatoCaratteristicaVlan = true;&#xD;
								attr.valoreAttributo = vlanOut.CARATTERISTICAVLAN;&#xD;
								Process.auditLog(&quot;Sovrascritto CARATTERISTICAVLAN &quot;+ vlanOut.CARATTERISTICAVLAN +&quot; dal CTRL ESISTENZA VLAN_C04M01F36&quot;);&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						if(!trovatoCaratteristicaVlan){&#xD;
							var ora = DateTimeUtil.createDatetime();&#xD;
							var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
							attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
							attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
							attributo.created = ora;&#xD;
							attributo.lastUpdate =ora;&#xD;
							attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVLAN;&#xD;
							attributo.operatore = componente.operatore;&#xD;
							attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							attributo.valoreAttributo = vlanOut.CARATTERISTICAVLAN;&#xD;
							componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));						&#xD;
							trovatoCaratteristicaVlan = true;&#xD;
							Process.auditLog(&quot;Valorizzato CARATTERISTICAVLAN &quot;+ vlanOut.CARATTERISTICAVLAN +&quot; dal CTRL ESISTENZA VLAN_C04M01F36&quot;);&#xD;
						}&#xD;
					}&#xD;
					//Indipendentemente da BMD marchiamo l'ordine con DRG OPZIONE ZERO se c'è almeno una USERVLAN DRG OPZIONE ZERO&#xD;
					else if(vlanOut.IDDettaglioOrdine == componente.IDDettaglioOrdine &#xD;
							&amp;&amp; vlanOut.CARATTERISTICAVLAN == &quot;DRG OPZIONE ZERO&quot;)&#xD;
					{&#xD;
						localRequest.ordine.caratterizzazioneAccesso = &quot;DRG OPZIONE ZERO&quot;;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
