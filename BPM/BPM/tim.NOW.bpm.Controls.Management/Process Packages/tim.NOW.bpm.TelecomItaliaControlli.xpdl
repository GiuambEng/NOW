			&#xD;
			//NUMBERPORTABILITY.TOTALEAGGIUNTIVI&#xD;
			if(InventoryResponse != null &amp;&amp; InventoryResponse.CRMWSResponse != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea.aggiuntivi != null)&#xD;
			{&#xD;
				if(foundTOTALEAGGIUNTIVI)&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexTOTALEAGGIUNTIVI).valoreAttributo = InventoryResponse.CRMWSResponse.tipo_Linea.aggiuntivi.qta_Aggiuntivi;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TOTALEAGGIUNTIVI;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.NUMBER;&#xD;
					attributo.valoreAttributo = InventoryResponse.CRMWSResponse.tipo_Linea.aggiuntivi.qta_Aggiuntivi;&#xD;
					&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
