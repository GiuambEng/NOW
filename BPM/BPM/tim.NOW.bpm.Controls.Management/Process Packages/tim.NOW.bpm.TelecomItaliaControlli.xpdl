        <xpdl2:Activity Id="_ywq9kDjNEeit3_kHndDDWw" Name="AggiornamentoAttributi" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Aggiornamento Attributi">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">// SM_7060 - ELIMINO DALL'ORDINE IPDSLAM - IPKIT se PROTOCOLLOPILA &lt;> IPOA&#xD;
if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
{&#xD;
	for(var i=0 ; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var dettaglio = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if (dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC&#xD;
			&amp;&amp; dettaglio.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
		{&#xD;
			&#xD;
			var ProtocolloPilaNONIPoA = false;&#xD;
			&#xD;
			var k=0;&#xD;
			&#xD;
			var indexIPKIT=-1;&#xD;
			var indexIPDSLAM=-1;&#xD;
			&#xD;
			while ( (!ProtocolloPilaNONIPoA || indexIPDSLAM== -1 ) &amp;&amp; k&lt; dettaglio.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = dettaglio.attributiDettaglioOrdine.get(k);&#xD;
				if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA &#xD;
				&amp;&amp; attributo.valoreAttributo != &quot;IPoA&quot;)&#xD;
				{&#xD;
					 ProtocolloPilaNONIPoA= true;&#xD;
					 Process.auditLog(&quot;Protocollo PILA diverso da IPoA per GBE con azione ad A&quot;);&#xD;
					 &#xD;
				}&#xD;
				&#xD;
				else if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPDSLAM)&#xD;
				{&#xD;
					 indexIPDSLAM=k;&#xD;
					 Process.auditLog(&quot;Trovato IPDSLAM= &quot; + attributo.valoreAttributo);&#xD;
					 &#xD;
				}&#xD;
			k++;&#xD;
			}&#xD;
			&#xD;
			if (ProtocolloPilaNONIPoA)&#xD;
			{&#xD;
				if (indexIPDSLAM != -1)&#xD;
				{&#xD;
					dettaglio.attributiDettaglioOrdine.remove(indexIPDSLAM);&#xD;
					Process.auditLog(&quot;Rimosso IPDLSAM in posizione &quot;+indexIPDSLAM.toString());&#xD;
					&#xD;
					var x=0;&#xD;
					&#xD;
					while ( indexIPKIT== -1  &amp;&amp; x&lt; dettaglio.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var attributo = dettaglio.attributiDettaglioOrdine.get(x);&#xD;
				&#xD;
						if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPKIT)&#xD;
						{&#xD;
							 indexIPKIT=x;&#xD;
							 Process.auditLog(&quot;Trovato IPKIT= &quot; + attributo.valoreAttributo);&#xD;
							 dettaglio.attributiDettaglioOrdine.remove(indexIPKIT);&#xD;
							Process.auditLog(&quot;Rimosso IPKIT in posizione &quot;+indexIPKIT.toString());&#xD;
					 &#xD;
						}&#xD;
					x++;&#xD;
					}&#xD;
&#xD;
				}&#xD;
				&#xD;
			}&#xD;
&#xD;
			&#xD;
		}&#xD;
	}&#xD;
		&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
