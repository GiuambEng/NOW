        <xpdl2:Activity Id="_YE7mMiv4EeyVBMucdpSJQg" Name="ArricchimentoDettaglioOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Script inserito con RU_1215&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{	&#xD;
	//CONFIGURAZIONE AZIONE&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOFWA)&#xD;
		{&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
			Process.auditLog(&quot;Inserita Azione ad &quot;+componente.azione+&quot; per componente &quot;+componente.nomeComponente);			&#xD;
		}		&#xD;
	}&#xD;
&#xD;
	//ARRICCHIMENTO&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		//Componente ACCESSO&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{			&#xD;
			var foundVELUP = false;&#xD;
			var foundVELDOWN = false;&#xD;
			var foundCODICENMU = false;&#xD;
&#xD;
			//Arricchimento attributi se presenti nell'ordine&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VELUP&#xD;
				   &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.velUp != null)&#xD;
				{&#xD;
					foundVELUP = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.velUp;&#xD;
					Process.auditLog(&quot;Trovato attributo VELUP&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VELDOWN&#xD;
				   &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.velDown != null)&#xD;
				{&#xD;
					foundVELDOWN = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.velDown;&#xD;
					Process.auditLog(&quot;Trovato attributo VELDOWN&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICENMU&#xD;
						&amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceNMU != null)&#xD;
				{&#xD;
					foundCODICENMU = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.codiceNMU;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICENMU&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
&#xD;
			//Creo attributi se non presenti nell'ordine&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = ora;&#xD;
			attributo.lastUpdate = ora;&#xD;
			attributo.operatore = componente.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
&#xD;
			if(!foundVELUP &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.velUp != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VELUP;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.velUp;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo VELUP&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
&#xD;
			if(!foundVELDOWN &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.velDown != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VELDOWN;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.velDown;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo VELDOWN&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			if(!foundCODICENMU &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceNMU != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICENMU;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.codiceNMU;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo CODICENMU&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}		&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="87.0" LaneId="_zQqpoCv2EeyVBMucdpSJQg" Width="158.0">
              <xpdl2:Coordinates XCoordinate="1965.0" YCoordinate="180.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
