        <xpdl2:Activity Id="_jlIz4hB2Eeyx1J_VnXlGew" Name="CTRLFORMALITRACCIATONPNG_C04M01F484" xpdExt:Visibility="Private" xpdExt:DisplayName="CTRL FORMALI TRACCIATO NPNG_C04M01F484">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_GpmfcA-3Eeyv0vptZh267A" PackageRef="tim.NOW.bpm.ProcesService.Interfaces" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
              <xpdExt:InputMappings MapperContext="ProcessToSubProcess" MappingDirection="IN">
                <xpdExt:DataMappings>
