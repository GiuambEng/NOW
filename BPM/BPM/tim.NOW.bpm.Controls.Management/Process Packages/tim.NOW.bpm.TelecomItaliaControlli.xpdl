        <xpdl2:Activity Id="_Kls0cxh1Eee0AeSBFsoXVA" Name="EnrichmentSTS" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Enrichment STS">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_5JLdtO-4EeaEEa7piwcrUw" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="OUT" Formal="STS">
                  <xpdl2:Actual ScriptGrammar="JavaScript">EnrichmentSTSResposnse</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="CodiceSTS">
                  <xpdExt:ScriptInformation Id="_Kls0dBh1Eee0AeSBFsoXVA" Name="CodiceSTS">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var CodiceSTS = DataUtil.createList();&#xD;
&#xD;
CodiceSTS.add(localRequest.codiceSTS);&#xD;
&#xD;
CodiceSTS;</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="101.0" LaneId="_KlsNYRh1Eee0AeSBFsoXVA" Width="151.0">
              <xpdl2:Coordinates XCoordinate="2220.0" YCoordinate="1005.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.EnrichmentSTS&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(EnrichmentSTSResposnse != null &amp;&amp; EnrichmentSTSResposnse.size() > 0)&#xD;
{&#xD;
	var data = DateTimeUtil.createDatetime();&#xD;
	&#xD;
	var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
	componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS;&#xD;
	componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
	componente.IDDettaglioOrdineParent = 1;&#xD;
	componente.IDDettaglioOrdineRoot = 1;&#xD;
	componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	componente.IDRisorsa = localRequest.numeroTelefonico;&#xD;
	componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
	componente.created = data;&#xD;
	componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
	componente.lastUpdate = data;&#xD;
	componente.operatore = localRequest.operatore;&#xD;
	componente.progressivo = 1;&#xD;
&#xD;
	//CODICE&#xD;
	var attributoOrdine = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributoOrdine.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
	attributoOrdine.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
	attributoOrdine.created = data;&#xD;
	attributoOrdine.lastUpdate = data;&#xD;
	attributoOrdine.operatore = componente.operatore;&#xD;
	attributoOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE;&#xD;
	attributoOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
	attributoOrdine.valoreAttributo = EnrichmentSTSResposnse.get(0).CODICESTS;&#xD;
	componente.attributiDettaglioOrdine.add(ScriptUtil.copy((attributoOrdine)));&#xD;
&#xD;
	//CODICEDTU&#xD;
	attributoOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEDTU;&#xD;
	attributoOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
	attributoOrdine.valoreAttributo = EnrichmentSTSResposnse.get(0).CODICEDTU;&#xD;
	componente.attributiDettaglioOrdine.add(ScriptUtil.copy((attributoOrdine)));&#xD;
&#xD;
	//DESCRIZIONE&#xD;
	attributoOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONE;&#xD;
	attributoOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
	attributoOrdine.valoreAttributo = EnrichmentSTSResposnse.get(0).descrizione;&#xD;
	componente.attributiDettaglioOrdine.add(ScriptUtil.copy((attributoOrdine)));&#xD;
&#xD;
	//STATO&#xD;
	attributoOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
	attributoOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
	attributoOrdine.valoreAttributo = &quot;ATTIVO&quot;;&#xD;
	componente.attributiDettaglioOrdine.add(ScriptUtil.copy((attributoOrdine)));&#xD;
&#xD;
	localRequest.ordine.dettaglioordine.add(componente);&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
