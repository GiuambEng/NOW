        <xpdl2:Activity Id="_r68ByQ8oEeeXv8RtwyZtwQ" Name="ArricchimentoOrdineDaAssetACCESSO" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Ordine Da Asset ACCESSO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Task #39819: Unico script diviso in due, &quot;Valorizzazione Costanti da Asset ACCESSO&quot; e &quot;Arricchimento Ordine da Asset ACCESSO&quot;&#xD;
var data = DateTimeUtil.createDatetime();&#xD;
var attributoMovimentato = false;&#xD;
&#xD;
//------------------------------------------------CONSISTENZA DATI----------------------------------------------------------------------&#xD;
if(ConsistenzaDati!= null){&#xD;
	&#xD;
	//------------------Recupero informazioni da Asset------------------&#xD;
	// rispetto alla configurazione si recuperano gli attributi su asset e si salvano nella lista &quot;listaValore&quot;, se non trovato il valore rimarrà &quot;&quot;&#xD;
	for(var i=0; i&lt;Asset.dettaglioasset.size(); i++){&#xD;
		var compAsset = Asset.dettaglioasset.get(i);&#xD;
		if(String(compAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
			for(var j=0; j&lt;compAsset.attributidettaglioasset.size(); j++){&#xD;
				var attributoAsset = compAsset.attributidettaglioasset.get(j);&#xD;
				for(var k =0; k&lt;listaValoreAsset_ARR.size();k++){&#xD;
					if(listaComponenti_ARR. get(k) == &quot;ACCESSO&quot; &amp;&amp; listaValoreAsset_ARR.get(k) == &quot;&quot; &amp;&amp; attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiAsset_ARR.get(k))){&#xD;
						listaValoreAsset_ARR.set(k,attributoAsset.valoreAttributo);&#xD;
					}&#xD;
				}&#xD;
			}			&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//------------------Recupera informazioni da ordine-----------------------&#xD;
	var accessoTrovato = false;&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
		var componenteOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(String(componenteOrdine.nomeComponente).slice(0,7)==&quot;ACCESSO&quot;){&#xD;
			accessoTrovato = true;&#xD;
			for(var j=0; j&lt;componenteOrdine.attributiDettaglioOrdine.size(); j++){&#xD;
				var attributoOrdine = componenteOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				for(var k =0; k&lt;listaAttributiOrdine_ARR.size();k++){&#xD;
					if(listaComponenti_ARR.get(k) == &quot;ACCESSO&quot; &amp;&amp; listaValoreOrdine_ARR.get(k)==&quot;&quot; &amp;&amp; attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine_ARR.get(k))){&#xD;
						listaValoreOrdine_ARR.set(k,attributoOrdine.valoreAttributo);&#xD;
					}&#xD;
				}				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	//crea Accesso se non esiste&#xD;
	if(!accessoTrovato){&#xD;
		var componenteAccessoTemp = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componenteAccessoTemp.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
		componenteAccessoTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componenteAccessoTemp.created = data;&#xD;
		componenteAccessoTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
		componenteAccessoTemp.integrationID = localRequest.IDRichiestaOLO + localRequest.ordine.dettaglioordine.size();&#xD;
		componenteAccessoTemp.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.get(nomeComponenteAccesso_ARR);&#xD;
		componenteAccessoTemp.operatore = &quot;BPM&quot;;&#xD;
		componenteAccessoTemp.progressivo = 1;&#xD;
		Process.auditLog(&quot;Aggiunto ACCESSO in quanto non presente in input&quot;);&#xD;
		localRequest.ordine.dettaglioordine.add(componenteAccessoTemp);&#xD;
	}&#xD;
		&#xD;
	//-----------------------------Logiche di arricchimento-----------------------------------------&#xD;
	for(var i=0; i&lt;listaAttributiOrdine_ARR.size();i++)&#xD;
	{&#xD;
		//RU_1317: PROPRIETAMATERIALE da arricchire a prescindere da offerta e sottolavorazione&#xD;
		if(LavorazioneRichiesta != null &amp;&amp; &#xD;
		    (listaAttributiOrdine_ARR.get(i) == &quot;PROPRIETAMATERIALE&quot; || listaAttributiOrdine_ARR.get(i) == &quot;FLAGEQUIVALENZAPRODOTTI&quot; || listaAttributiOrdine_ARR.get(i) == &quot;CLUSTER&quot;)) //RU_1614: aggiunto CLUSTER&#xD;
		{&#xD;
			//Se non c'è in LavorazioneRichiesta non deve arricchire dall'asset, quindi lo faccio entrare in questo if dell'attributo così non va nell'else finale&#xD;
			if(LavorazioneRichiesta.proprietaMateriale != null &amp;&amp; listaAttributiOrdine_ARR.get(i) == &quot;PROPRIETAMATERIALE&quot;)&#xD;
			{&#xD;
				listaValoreOrdine_ARR.set(i,LavorazioneRichiesta.proprietaMateriale);&#xD;
			}			&#xD;
			//RU_1390: FLAGEQUIVALENZAPRODOTTI&#xD;
			else if(LavorazioneRichiesta.flagEquivalenzaProdotti != null &amp;&amp; listaAttributiOrdine_ARR.get(i) == &quot;FLAGEQUIVALENZAPRODOTTI&quot;)&#xD;
			{&#xD;
				listaValoreOrdine_ARR.set(i,LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
			}&#xD;
			//RU_1614: CLUSTER&#xD;
			else if(listaAttributiOrdine_ARR.get(i) == &quot;CLUSTER&quot;)&#xD;
			{&#xD;
				if(LavorazioneRichiesta.cluster != null)&#xD;
				{&#xD;
					listaValoreOrdine_ARR.set(i,LavorazioneRichiesta.cluster);&#xD;
					listaValoreOrdine_ARROld.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		//BITSTREAMATMASIMMETRICOFLAT&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
		||localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT)&#xD;
		{&#xD;
			//RiconfigurazioneAccesso (VARIAZIONECARATTERISTICA, RICONFIGURAZIONEVC)&#xD;
			if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONECARATTERISTICA&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
			{	&#xD;
				if((listaAttributiOrdine_ARR.get(i) == &quot;PROFILOTECNICOLINEA&quot; || listaAttributiOrdine_ARR.get(i) == &quot;MODULAZIONE&quot; || listaAttributiOrdine_ARR.get(i) == &quot;CAMPOSERVIZIOIT&quot; || listaAttributiOrdine_ARR.get(i) == &quot;INTERMEDIATEAGENTFULL&quot;)&#xD;
				&amp;&amp; listaValoreOrdine_ARR.get(i) != &quot;&quot; )&#xD;
				{&#xD;
					attributoMovimentato= true;&#xD;
					listaValoreOrdine_ARROld.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}&#xD;
				else if(listaAttributiOrdine_ARR.get(i) == &quot;FLAGORDINEUNICO&quot;){&#xD;
					listaAttributiDaAggiungere_ARR.set(i,false);&#xD;
				}&#xD;
				else{&#xD;
					listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}&#xD;
			}&#xD;
			//CambioSLA&#xD;
			else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOSLA){&#xD;
				if((listaAttributiOrdine_ARR.get(i) == &quot;GESTIONEPRODOTTO&quot; )&#xD;
				&amp;&amp; listaValoreOrdine_ARR.get(i) != &quot;&quot; ){&#xD;
					attributoMovimentato= true;&#xD;
					listaValoreOrdine_ARROld.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}&#xD;
				else{&#xD;
					listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}&#xD;
			}&#xD;
			//IncrementoDecrementoVC&#xD;
			else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC){&#xD;
				if(listaAttributiOrdine_ARR.get(i) == &quot;FLAGORDINEUNICO&quot;){&#xD;
					listaAttributiDaAggiungere_ARR.set(i,false);&#xD;
				}&#xD;
				else{&#xD;
					&#xD;
					listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}&#xD;
			}&#xD;
			else{&#xD;
			// In assenza di altre logiche, si aggiunge il valore presente in consistenza			&#xD;
				listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));			&#xD;
			}			&#xD;
		}&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL)&#xD;
		{&#xD;
			if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONECARATTERISTICA&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC&#xD;
				||	localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
			{					&#xD;
				if(listaAttributiOrdine_ARR.get(i) == &quot;PROFILOTECNICOLINEA&quot;)&#xD;
				{&#xD;
					// da C02M20F07 – Ricalcola Profilo Tecnico Linea&#xD;
					if(ProfiloTecnicoCalcolato != null &amp;&amp; ProfiloTecnicoCalcolato != listaValoreAsset_ARR.get(i))&#xD;
					{&#xD;
						attributoMovimentato= true;&#xD;
						listaValoreOrdine_ARROld.set(i,listaValoreAsset_ARR.get(i));&#xD;
						listaValoreOrdine_ARR.set(i,ProfiloTecnicoCalcolato);&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));&#xD;
					}&#xD;
				}&#xD;
				//Da input&#xD;
				else if(listaAttributiOrdine_ARR.get(i) == &quot;CAMPOSERVIZIOIT&quot; &amp;&amp; listaValoreOrdine_ARR.get(i)!= &quot;&quot;){&#xD;
					listaValoreOrdine_ARROld.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}&#xD;
				else {&#xD;
					listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}				&#xD;
			}&#xD;
			else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOSLA){&#xD;
				//Da input&#xD;
				if((listaAttributiOrdine_ARR.get(i) == &quot;GESTIONEPRODOTTO&quot; &#xD;
						|| 	listaAttributiOrdine_ARR.get(i) == &quot;CAMPOSERVIZIOIT&quot;) &#xD;
					&amp;&amp; listaValoreOrdine_ARR.get(i)!= &quot;&quot;){&#xD;
					&#xD;
					listaValoreOrdine_ARROld.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}&#xD;
				else {&#xD;
					listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			else{&#xD;
				listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));&#xD;
			}&#xD;
		}&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)&#xD;
		{&#xD;
			if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONECARATTERISTICA&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC&#xD;
				||	localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC){&#xD;
				//Da input&#xD;
				if(listaAttributiOrdine_ARR.get(i) == &quot;CAMPOSERVIZIOIT&quot; &amp;&amp; listaValoreOrdine_ARR.get(i)!= &quot;&quot;){&#xD;
					listaValoreOrdine_ARROld.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}&#xD;
				else {&#xD;
					listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}				&#xD;
			}&#xD;
			else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOSLA){&#xD;
				//Da input&#xD;
				if((listaAttributiOrdine_ARR.get(i) == &quot;GESTIONEPRODOTTO&quot; &#xD;
						|| 	listaAttributiOrdine_ARR.get(i) == &quot;CAMPOSERVIZIOIT&quot;) &#xD;
					&amp;&amp; listaValoreOrdine_ARR.get(i)!= &quot;&quot;){&#xD;
					&#xD;
					listaValoreOrdine_ARROld.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}&#xD;
				else {&#xD;
					listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));&#xD;
				}				&#xD;
			}&#xD;
			else{&#xD;
				listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));&#xD;
			}&#xD;
		}&#xD;
		else if(localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
				|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
				|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
				|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
				|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
				|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
				|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
				|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
				|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
				|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
				|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH                 //RU_1164: aggiunte SEMI***&#xD;
                || localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
                || localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
				|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA				//RU_1555&#xD;
				|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS)&#xD;
		{&#xD;
			if(listaValoreOrdine_ARR.get(i)!= &quot;&quot;)&#xD;
			{&#xD;
				listaValoreOrdine_ARROld.set(i,listaValoreAsset_ARR.get(i));&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));&#xD;
			}&#xD;
		}&#xD;
		else{&#xD;
			listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));&#xD;
		}	&#xD;
	}&#xD;
	&#xD;
	LavorazioneAutoespletante = false; //RU_966: Lavorazione Autoespletante se INTERMEDIATEAGENTFULL è l'unico valore modificato&#xD;
	&#xD;
	//------------------Aggiornamento Ordine-------------------&#xD;
	// rispetto alla configurazione si arricchisce l'ordine della richiesta&#xD;
	var attrCampione = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attrCampione.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	attrCampione.created = data;&#xD;
	attrCampione.lastUpdate = data;&#xD;
	attrCampione.operatore = localRequest.operatore;&#xD;
	attrCampione.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
		var compOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		attributoMovimentato = false;&#xD;
		&#xD;
		//-------ACCESSO----&#xD;
		if(String(compOrdine.nomeComponente).slice(0,7)==&quot;ACCESSO&quot;){&#xD;
			&#xD;
			//RU_966: Lavorazione Autoespletante se INTERMEDIATEAGENTFULL è l'unico valore modificato&#xD;
			var numValoriModificati = 0; &#xD;
			var INTERMEDIATEAGENTFULLmodificato = false;&#xD;
			&#xD;
			//Si cerca di aggiornare il valore se present in input&#xD;
			for(var j=0; j&lt;compOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{	&#xD;
				var attributoOrdine = compOrdine.attributiDettaglioOrdine.get(j);&#xD;
				//----------Modifica attributi presenti&#xD;
				for(var k =0; k&lt;listaAttributiOrdine_ARR.size();k++)&#xD;
				{&#xD;
					if(listaComponenti_ARR.get(k) == &quot;ACCESSO&quot; &amp;&amp; (listaAttributiDaAggiungere_ARR.get(k) == true || listaDaSovrascrivere_ARR.get(k) == true) &amp;&amp; attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine_ARR.get(k))){&#xD;
						&#xD;
						if(listaValoreOrdine_ARR.get(k)!=&quot;&quot;){&#xD;
							attributoOrdine.lastUpdate = data;&#xD;
							if(listaAttributiDaAggiungere_ARR.get(k) == true)&#xD;
							{&#xD;
								attributoOrdine.valoreAttributo = listaValoreOrdine_ARR.get(k);&#xD;
								&#xD;
								if(listaValoreOrdine_ARROld.get(k)!=&quot;&quot;){&#xD;
									&#xD;
									if(listaValoreOrdine_ARROld.get(k)!= listaValoreOrdine_ARR.get(k)){&#xD;
										attributoMovimentato= true;&#xD;
										attributoOrdine.valoreAttributoOLD = listaValoreOrdine_ARROld.get(k);&#xD;
									}&#xD;
								}&#xD;
								&#xD;
								//RU_966: Lavorazione Autoespletante se INTERMEDIATEAGENTFULL è l'unico valore modificato&#xD;
								if((listaValoreOrdine_ARROld.get(k)==&quot;&quot; &amp;&amp; listaValoreAsset_ARR.get(k)==&quot;&quot;) // c'è un valore nuovo che non c'era in asset -> modificato - SM_9526: aggiunto AND con listaValoreAsset_ARR&#xD;
									|| attributoMovimentato 										// attributo variato rispetto a ciò che c'è in asset -> modificato&#xD;
									|| listaAttributiOrdine_ARR.get(k)==&quot;INTERMEDIATEAGENTFULL&quot;) 		// qualsiasi sia il valore di INTERMEDIATEAGENTFULL specificato nell'ordine di una variazione è da considerare come una modifica&#xD;
								{&#xD;
									numValoriModificati++;&#xD;
									Process.auditLog(&quot;numValoriModificati: &quot;+numValoriModificati);&#xD;
										&#xD;
									if(listaAttributiOrdine_ARR.get(k)==&quot;INTERMEDIATEAGENTFULL&quot;)&#xD;
									{&#xD;
										INTERMEDIATEAGENTFULLmodificato = true;&#xD;
										Process.auditLog(&quot;INTERMEDIATEAGENTFULLmodificato, Ordine: &quot;+listaValoreOrdine_ARR.get(k)+&quot;, OLD: &quot;+listaValoreOrdine_ARROld.get(k));&#xD;
									}&#xD;
									else{&#xD;
										attributoMovimentato = true;&#xD;
									}&#xD;
								}&#xD;
							}&#xD;
							else{&#xD;
								attributoOrdine.valoreAttributo =listaValoreAsset_ARR.get(k);&#xD;
							}&#xD;
						}&#xD;
						listaAttributiDaAggiungere_ARR.set(k, false);&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				// configura Azione&#xD;
				if(attributoMovimentato || localRequest.caratteristica != null){&#xD;
					compOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
				}&#xD;
				else{&#xD;
					compOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//RU_966: Lavorazione Autoespletante se INTERMEDIATEAGENTFULL è l'unico valore modificato&#xD;
			if(INTERMEDIATEAGENTFULLmodificato &amp;&amp; numValoriModificati == 1)&#xD;
			{&#xD;
				LavorazioneAutoespletante = true;&#xD;
				Process.auditLog(&quot;La lavorazione viene considerata Autoespletante&quot;);&#xD;
			}	&#xD;
			&#xD;
			// Se non presente in input si aggiungono tutti gli attributi, previsti dalla configurazione, per i quali è stato recuperato un valore ammissibile&#xD;
			//aggiungi attributi&#xD;
			for(var k =0; k&lt;listaAttributiOrdine_ARR.size();k++){&#xD;
				if(listaComponenti_ARR.get(k) == &quot;ACCESSO&quot; &amp;&amp; listaAttributiDaAggiungere_ARR.get(k) == true){&#xD;
					if(listaValoreOrdine_ARR.get(k)!=&quot;&quot;){&#xD;
						var attrtemp = ScriptUtil.copy(attrCampione);&#xD;
						attrtemp.IDDettaglioOrdine = compOrdine.IDDettaglioOrdine;&#xD;
						attrtemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine_ARR.get(k));&#xD;
						attrtemp.valoreAttributo = listaValoreOrdine_ARR.get(k);&#xD;
						compOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attrtemp));&#xD;
					}&#xD;
					else{&#xD;
						Process.auditLog(&quot;Impossibile arricchire l'ordine con l'elemento &quot;+listaAttributiOrdine_ARR.get(k)+&quot; perchè non presente in consistenza&quot;);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//C01M02F12 Recupero DISTRETTO/IDCONTRATTO/CLIENTE/CLLI DA ASSET&#xD;
	if (Asset.distretto != null &amp;&amp; Asset.distretto.length > 0){&#xD;
		localRequest.ordine.distretto = Asset.distretto;&#xD;
	}&#xD;
	if (Asset.CLLI != null &amp;&amp; Asset.CLLI.length > 0){&#xD;
		localRequest.ordine.CLLI = Asset.CLLI;&#xD;
	}&#xD;
	if (Asset.IDContratto != null){&#xD;
		localRequest.IDContratto = Asset.IDContratto;&#xD;
	}&#xD;
	&#xD;
	//SM_9263&#xD;
	if(Asset.numeroFittizio != null &amp;&amp; Asset.numeroFittizio.length > 0){&#xD;
		localRequest.ordine.numeroFittizio = Asset.numeroFittizio;&#xD;
	}&#xD;
	&#xD;
	if(Asset.cliente != null &#xD;
		&amp;&amp; localRequest.ordine.nome == null &#xD;
		&amp;&amp; localRequest.ordine.cognomeRagioneSociale == null &#xD;
		&amp;&amp; localRequest.ordine.CF == null&#xD;
		&amp;&amp; localRequest.ordine.PIVA == null)   //Task #38239&#xD;
	{&#xD;
		if (Asset.cliente.nome != null &amp;&amp; (localRequest.ordine.nome == null || localRequest.ordine.nome == &quot;&quot;))&#xD;
		{&#xD;
			localRequest.ordine.nome = Asset.cliente.nome;&#xD;
		}		&#xD;
		if (Asset.cliente.cognomeRagioneSociale != null &amp;&amp; (localRequest.ordine.cognomeRagioneSociale == null || localRequest.ordine.cognomeRagioneSociale == &quot;&quot;))&#xD;
		{&#xD;
			localRequest.ordine.cognomeRagioneSociale = Asset.cliente.cognomeRagioneSociale;&#xD;
		}&#xD;
		&#xD;
		//SM_10686: Spostato arricchimento dei due campi qui invece che negli arricchimenti comuni&#xD;
		//CF e PIVA sono mutuamente esclusivi e non vanno arricchiti se uno dei due è indicato in input dall'OLO&#xD;
		if(localRequest.ordine.CF == null &amp;&amp; localRequest.ordine.PIVA == null)&#xD;
		{				&#xD;
			localRequest.ordine.CF = Asset.cliente.codiceFiscale;&#xD;
			localRequest.ordine.PIVA = Asset.cliente.partitaIVA;			&#xD;
		}&#xD;
	}		&#xD;
	&#xD;
	//NUMERO TELEFONICO PER CONDIVISI -- SM_6579	&#xD;
	if (Asset.numeroTelefonico != null &amp;&amp; (ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;))&#xD;
	{&#xD;
		localRequest.ordine.numeroTelefonico = Asset.numeroTelefonico;&#xD;
	}&#xD;
	&#xD;
	// VALORIZZAZIONE OPERATORE RETE - Modifica per FF&#xD;
	if(Asset.operatoreRete != null)&#xD;
	{&#xD;
		localRequest.operatoreRete = Asset.operatoreRete;&#xD;
		localRequest.ordine.operatoreRete = Asset.operatoreRete;&#xD;
	}		&#xD;
}&#xD;
else{&#xD;
	Process.auditLog(&quot;ConsistenzaDati null&quot;);&#xD;
}&#xD;
&#xD;
//IdProfiloVCAsset&#xD;
for(var i=0; i&lt;Asset.dettaglioasset.size(); i++){&#xD;
	var componenteAsset = Asset.dettaglioasset.get(i);&#xD;
	var IdProfiloVCAsset = &quot;&quot;;&#xD;
	IdProfiloVCAsset = null;&#xD;
	var j=0;&#xD;
	if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &#xD;
		|| componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC){&#xD;
		while(IdProfiloVCAsset==null &amp;&amp; j&lt;componenteAsset.attributidettaglioasset.size()){&#xD;
			if(componenteAsset.attributidettaglioasset.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDPROFILOVC){&#xD;
				IdProfiloVCAsset = componenteAsset.attributidettaglioasset.get(j).valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
		if(IdProfiloVCAsset!= null){&#xD;
			IdProfiloVCAssetList.add(IdProfiloVCAsset);&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="75.0" LaneId="_ozwgwQAGEee456EGJ3IudA" Width="139.0">
              <xpdl2:Coordinates XCoordinate="1338.0" YCoordinate="872.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_r68Byg8oEeeXv8RtwyZtwQ" Name="ArricchimentoVCUSERVLAN" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento VC/USERVLAN">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var listaAttributiOrdine = DataUtil.createList();&#xD;
var listaComponenti = DataUtil.createList();&#xD;
var listaDaAggiornare = DataUtil.createList();&#xD;
var listaDaAggiungere = DataUtil.createList();&#xD;
var listaValoriAsset = DataUtil.createList();&#xD;
var listaDaEliminare  = DataUtil.createList();&#xD;
var listaValoriOrdine = DataUtil.createList();&#xD;
var listaAttributiSPLITTER = DataUtil.createList();&#xD;
var listaAttributiMODEM = DataUtil.createList();&#xD;
var listaDaSovrascrivere = DataUtil.createList();&#xD;
var listaAttributiPROTOCOLLO = DataUtil.createList();&#xD;
&#xD;
//AttributoDettaglioOrdine Protocollo Pila&#xD;
var trovatoPila = false;&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrd = localRequest.ordine.dettaglioordine.get(i);		&#xD;
		if(currentDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
		{	&#xD;
			var j=0;&#xD;
			while(!trovatoPila &amp;&amp; j &lt; currentDettOrd.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrd = currentDettOrd.attributiDettaglioOrdine.get(j);&#xD;
				if(currentAttDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA)&#xD;
				{&#xD;
					trovatoPila = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			if(trovatoPila)&#xD;
			{&#xD;
				Process.auditLog(&quot;Attributo ProtocolloPila già presente in input da xml&quot;);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				var Attdettaglio = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				for (var k = 0; k &lt; ProtocolloPila.size(); k++)&#xD;
				{&#xD;
					if(currentDettOrd.IDDettaglioOrdine == ProtocolloPila.get(k).IDDettaglioOrdine)&#xD;
					{						&#xD;
						var currentProtPilaElement = ProtocolloPila.get(k);					&#xD;
						Attdettaglio.IDDettaglioOrdine = currentProtPilaElement.IDDettaglioOrdine;&#xD;
						Attdettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						Attdettaglio.created = DateTimeUtil.createDatetime();&#xD;
						Attdettaglio.lastUpdate = DateTimeUtil.createDatetime();&#xD;
						Attdettaglio.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA;&#xD;
						Attdettaglio.operatore = &quot;BPM&quot;;&#xD;
						Attdettaglio.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						Attdettaglio.valoreAttributo = currentProtPilaElement.protocolloPilaDefault;&#xD;
						localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(Attdettaglio));&#xD;
					}&#xD;
				}			&#xD;
			}			&#xD;
		}		&#xD;
	}&#xD;
}   &#xD;
&#xD;
&#xD;
var data = DateTimeUtil.createDatetime();&#xD;
&#xD;
//------------------------------calcola logiche--------------&#xD;
var IDRISORSAVCMax = 0;&#xD;
var IDRISORSAUSERVLANMax = 0;&#xD;
var UserVLAN_1_TAGGINGAsset = &quot;&quot;;&#xD;
UserVLAN_1_TAGGINGAsset = null;&#xD;
var UserVLAN_1_TAGGINGOrdine = &quot;&quot;;&#xD;
UserVLAN_1_TAGGINGOrdine = null;&#xD;
var USERVLANIDOrdine = &quot;&quot;;&#xD;
USERVLANIDOrdine = null;&#xD;
&#xD;
//SM_9250&#xD;
var EncapsulationAsset = &quot;&quot;;&#xD;
EncapsulationAsset = null;&#xD;
var EncapsulationOrdine = &quot;&quot;;&#xD;
EncapsulationOrdine = null;&#xD;
&#xD;
// Cerca IDRISORSAVCMax e UserVLAN_1_TAGGING da asset&#xD;
//SM_9250: aggiunta ricerca di ENCAPSULATION da asset&#xD;
if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC || &#xD;
localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING ||&#xD;
localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN)&#xD;
{&#xD;
	for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var componente = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
		for(var j=0; j&lt;componente.attributidettaglioasset.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributidettaglioasset.get(j);&#xD;
			&#xD;
			if((attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAVC&#xD;
				|| attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAUSERVLAN) &amp;&amp;&#xD;
			(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC ||&#xD;
			 localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING)) // SM_8609 - Aggiunto VARIAZIONETAGGING&#xD;
			{&#xD;
				var indice = 4;&#xD;
				var valoreString = attributo.valoreAttributo;&#xD;
				&#xD;
				if(valoreString.charAt(valoreString.length - 4)==&quot;0&quot;)&#xD;
				{&#xD;
					if(valoreString.charAt(valoreString.length - 3)==&quot;0&quot;)&#xD;
					{&#xD;
						if(valoreString.charAt(valoreString.length - 2)==&quot;0&quot;)&#xD;
						{&#xD;
							indice =1;&#xD;
						}&#xD;
						else &#xD;
						{&#xD;
							indice =2;&#xD;
						}&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						indice=3;&#xD;
					}&#xD;
				}&#xD;
				valoreString = valoreString.slice(valoreString.length - indice ,valoreString.length);&#xD;
				var valoreInt = parseInt(valoreString,10);&#xD;
				&#xD;
				if(valoreInt>IDRISORSAVCMax)&#xD;
				{&#xD;
					IDRISORSAVCMax = valoreInt;&#xD;
				}&#xD;
			}&#xD;
			else if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot; &amp;&amp; attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING)&#xD;
			{&#xD;
				UserVLAN_1_TAGGINGAsset = attributo.valoreAttributo.toUpperCase();&#xD;
			}&#xD;
			//SM_9250&#xD;
			else if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot; &amp;&amp; attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
			{&#xD;
				EncapsulationAsset = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//UserVLAN_1_TAGGINGOrdine  e USERVLANIDOrdine nell'accesso da ordine&#xD;
//SM_9250: aggiunta ricerca di ENCAPSULATION da ordine&#xD;
var i=0;&#xD;
var accessoTrovato = false;&#xD;
while(!accessoTrovato &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{	&#xD;
	var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(comp.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		accessoTrovato = true;&#xD;
		var j=0;&#xD;
		&#xD;
		while((USERVLANIDOrdine == null || UserVLAN_1_TAGGINGOrdine == null || EncapsulationOrdine == null) &amp;&amp; j &lt; comp.attributiDettaglioOrdine.size()){&#xD;
			&#xD;
			var attributoOrdine = comp.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING){&#xD;
				UserVLAN_1_TAGGINGOrdine = attributoOrdine.valoreAttributo.toUpperCase();&#xD;
			}&#xD;
			else if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID){&#xD;
				USERVLANIDOrdine = attributoOrdine.valoreAttributo;&#xD;
			}&#xD;
			//SM_9250&#xD;
			else if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
			{&#xD;
				EncapsulationOrdine = attributoOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
Process.auditLog(&quot;Inizio arricchimento VC e VLAN&quot;);&#xD;
&#xD;
//per ogni dettaglio nell'asset&#xD;
for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
{&#xD;
	listaAttributiOrdine.clear();&#xD;
	listaComponenti.clear();&#xD;
	listaDaAggiornare.clear();&#xD;
	listaDaAggiungere.clear();&#xD;
	listaValoriAsset.clear();&#xD;
	listaDaEliminare.clear();&#xD;
	listaValoriOrdine.clear();&#xD;
	listaAttributiSPLITTER.clear();&#xD;
	listaAttributiMODEM.clear();&#xD;
	listaDaSovrascrivere.clear();&#xD;
	listaAttributiPROTOCOLLO.clear();&#xD;
&#xD;
	listaAttributiOrdine.addAll(listaAttributiOrdine_CONS);&#xD;
	listaComponenti.addAll(listaComponenti_CONS);&#xD;
	listaDaAggiornare.addAll(listaDaAggiornare_CONS);&#xD;
	listaDaAggiungere.addAll(listaDaAggiungere_CONS);&#xD;
	listaValoriAsset.addAll(listaValoriAsset_CONS);&#xD;
	listaDaEliminare.addAll(listaDaEliminare_CONS);&#xD;
	listaValoriOrdine.addAll(listaValoriOrdine_CONS);&#xD;
	listaAttributiSPLITTER.addAll(listaAttributiSPLITTER_CONS);&#xD;
	listaAttributiMODEM.addAll(listaAttributiMODEM_CONS);&#xD;
	listaDaSovrascrivere.addAll(listaDaSovrascrivere_CONS);&#xD;
	listaAttributiPROTOCOLLO.addAll(listaAttributiPROTOCOLLO_CONS);&#xD;
	&#xD;
	var componenteAsset = Asset.dettaglioasset.get(i);&#xD;
	var Azione = &quot;&quot;;&#xD;
	&#xD;
	if(componenteAsset.statoDettaglioAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO)&#xD;
	{&#xD;
		if(listaComponenti.contains(String(componenteAsset.nomeComponente)))&#xD;
		{&#xD;
			//recupera VPI VCI da Asset&#xD;
			var VPIAsset = &quot;&quot;;&#xD;
			VPIAsset = null;&#xD;
			var VCIAsset = &quot;&quot;;&#xD;
			VCIAsset = null;&#xD;
			var DLCIAsset = &quot;&quot;;&#xD;
			DLCIAsset = null;&#xD;
			var uservlanAsset = &quot;&quot;;&#xD;
			uservlanAsset = null;&#xD;
			var IdProfiloVCAsset = &quot;&quot;;&#xD;
			IdProfiloVCAsset = null;&#xD;
			var CODICEVPAsset = &quot;&quot;;&#xD;
			CODICEVPAsset = null;&#xD;
			var CODICETDAsset = &quot;&quot;;&#xD;
			CODICETDAsset = null;&#xD;
			var TIPOPROFILOVCAsset = &quot;&quot;;&#xD;
			TIPOPROFILOVCAsset = null;&#xD;
			&#xD;
			//RU_1180&#xD;
			var FLAGMULTICASTAsset = &quot;&quot;;&#xD;
			FLAGMULTICASTAsset = null;&#xD;
			&#xD;
			var CODICEVPOrdine = &quot;&quot;;&#xD;
			CODICEVPOrdine = null;&#xD;
			var CODICETDOrdine = &quot;&quot;;&#xD;
			CODICETDOrdine = null;&#xD;
		&#xD;
			var j=0;&#xD;
			while((((VPIAsset==null || VCIAsset==null || IdProfiloVCAsset==null || DLCIAsset == null) &amp;&amp; (componenteAsset.nomeComponente== it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || componenteAsset.nomeComponente== it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)) &#xD;
			|| ((uservlanAsset == null || DLCIAsset == null )&amp;&amp; componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN))&#xD;
			&amp;&amp; j&lt;componenteAsset.attributidettaglioasset.size())&#xD;
			{&#xD;
				if(componenteAsset.attributidettaglioasset.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
				{&#xD;
					VPIAsset = componenteAsset.attributidettaglioasset.get(j).valoreAttributo;&#xD;
				}&#xD;
				else if(componenteAsset.attributidettaglioasset.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
				{&#xD;
					VCIAsset = componenteAsset.attributidettaglioasset.get(j).valoreAttributo;&#xD;
				}&#xD;
				else if(componenteAsset.attributidettaglioasset.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI)&#xD;
				{&#xD;
					DLCIAsset = componenteAsset.attributidettaglioasset.get(j).valoreAttributo;&#xD;
				}&#xD;
				else if(componenteAsset.attributidettaglioasset.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
				{&#xD;
					uservlanAsset = componenteAsset.attributidettaglioasset.get(j).valoreAttributo;&#xD;
				}&#xD;
				else if(componenteAsset.attributidettaglioasset.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDPROFILOVC)&#xD;
				{&#xD;
					IdProfiloVCAsset = componenteAsset.attributidettaglioasset.get(j).valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			Process.auditLog(&quot;Lavorazione componente Asset: VPIAsset:&quot;+VPIAsset + &quot;, VCIAsset:&quot;+VCIAsset+&quot;, uservlanAsset:&quot;+uservlanAsset+&quot;, IdProfiloVCAsset:&quot;+IdProfiloVCAsset);&#xD;
		&#xD;
			//Identifica VC in anagrafe&#xD;
			var VCDaAnagrafe = com_tim_NOW_xsd_GenericEnrichment_Factory.createEnrichmentVCResponse();&#xD;
			VCDaAnagrafe = null;&#xD;
			if(IdProfiloVCAsset!= null &amp;&amp; EnricmentVC_ResponseType!= null)&#xD;
			{&#xD;
				var t =0;&#xD;
				while(VCDaAnagrafe== null &amp;&amp; t&lt;EnricmentVC_ResponseType.enrichmentVCResponse.size()){&#xD;
					if(EnricmentVC_ResponseType.enrichmentVCResponse.get(t).idProfiloVC == IdProfiloVCAsset){&#xD;
						VCDaAnagrafe = ScriptUtil.copy(EnricmentVC_ResponseType.enrichmentVCResponse.get(t));&#xD;
					}&#xD;
					t++;&#xD;
				}&#xD;
			}&#xD;
		&#xD;
		//Cerca componente in Ordine&#xD;
		var componenteOrdine = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componenteOrdine = null;&#xD;
		&#xD;
		var VPIOrdine = &quot;&quot;;&#xD;
		VPIOrdine = null;&#xD;
		var VCIOrdine = &quot;&quot;;&#xD;
		VCIOrdine = null;&#xD;
		var uservlanOrdine = &quot;&quot;;&#xD;
		uservlanOrdine = null;&#xD;
		&#xD;
		var j=0;&#xD;
		while(componenteOrdine==null &amp;&amp; j&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var compOrdineTemp = localRequest.ordine.dettaglioordine.get(j);&#xD;
			var VPIOrdine = &quot;&quot;;&#xD;
			VPIOrdine = null;&#xD;
			var VCIOrdine = &quot;&quot;;&#xD;
			VCIOrdine = null;&#xD;
			var uservlanOrdine = &quot;&quot;;&#xD;
			uservlanOrdine = null;&#xD;
			var DLCIOrdine = &quot;&quot;;&#xD;
			DLCIOrdine = null;&#xD;
			if(compOrdineTemp.nomeComponente == componenteAsset.nomeComponente)&#xD;
			{&#xD;
				var k=0;&#xD;
				while((((VPIOrdine==null || VCIOrdine==null)&amp;&amp; (compOrdineTemp.nomeComponente== it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || compOrdineTemp.nomeComponente== it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC))&#xD;
						|| ( uservlanOrdine == null &amp;&amp; compOrdineTemp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN))&#xD;
					&amp;&amp; k&lt;compOrdineTemp.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					if(compOrdineTemp.attributiDettaglioOrdine.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
					{&#xD;
						VPIOrdine= compOrdineTemp.attributiDettaglioOrdine.get(k).valoreAttributo;&#xD;
					}&#xD;
					else if(compOrdineTemp.attributiDettaglioOrdine.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
					{&#xD;
						VCIOrdine= compOrdineTemp.attributiDettaglioOrdine.get(k).valoreAttributo;&#xD;
					}&#xD;
					else if(compOrdineTemp.attributiDettaglioOrdine.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
					{&#xD;
						uservlanOrdine= compOrdineTemp.attributiDettaglioOrdine.get(k).valoreAttributo;&#xD;
					}&#xD;
					else if(compOrdineTemp.attributiDettaglioOrdine.get(k).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI)&#xD;
					{&#xD;
						DLCIOrdine= compOrdineTemp.attributiDettaglioOrdine.get(k).valoreAttributo;&#xD;
					}&#xD;
					k++;&#xD;
				}&#xD;
				&#xD;
				if(compOrdineTemp.nomeComponente== it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || compOrdineTemp.nomeComponente== it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
				{&#xD;
					if((VPIAsset!= null &amp;&amp; VPIOrdine!=null &amp;&amp; VCIAsset!= null &amp;&amp; VCIOrdine!= null &amp;&amp; VPIAsset == VPIOrdine &amp;&amp; VCIAsset==VCIOrdine)&#xD;
						|| (DLCIOrdine != null &amp;&amp; DLCIAsset != null &amp;&amp; DLCIOrdine==DLCIAsset))&#xD;
					{&#xD;
						componenteOrdine = compOrdineTemp;&#xD;
					}&#xD;
				}&#xD;
				else if(compOrdineTemp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
				{&#xD;
					if(uservlanAsset != null &amp;&amp; uservlanOrdine != null &amp;&amp; uservlanAsset == uservlanOrdine){&#xD;
						componenteOrdine = compOrdineTemp;	&#xD;
					}&#xD;
					else if(uservlanAsset== null &amp;&amp; uservlanOrdine== null){&#xD;
						componenteOrdine = compOrdineTemp;&#xD;
						Process.auditLog(&quot;Correlazione uservlan untagged, USERVLANID non valorizzato&quot;);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
		TIPOPROFILOVCAsset = null;&#xD;
		CODICEVPAsset = null;&#xD;
		CODICETDAsset = null;&#xD;
		FLAGMULTICASTAsset = null;  //RU_1180&#xD;
&#xD;
		//Recupera Dati dall'asset&#xD;
		for(var k=0; k&lt;listaAttributiOrdine.size(); k++)&#xD;
		{&#xD;
			//Cerco le informazioni da anagrafica PROFILO VC&#xD;
			if((listaAttributiOrdine.get(k) == &quot;MCRDOWN&quot; || listaAttributiOrdine.get(k) == &quot;MCRUP&quot;&#xD;
				|| listaAttributiOrdine.get(k) == &quot;PCRDOWN&quot; || listaAttributiOrdine.get(k) == &quot;PCRUP&quot;&#xD;
				|| listaAttributiOrdine.get(k) == &quot;SCRDOWN&quot; || listaAttributiOrdine.get(k) == &quot;SCRUP&quot;) &amp;&amp; VCDaAnagrafe!= null)&#xD;
			{&#xD;
				if(listaAttributiOrdine.get(k) == &quot;MCRDOWN&quot; &amp;&amp; VCDaAnagrafe.MCRDOWN!= null)&#xD;
				{&#xD;
					listaValoriAsset.set(k,VCDaAnagrafe.MCRDOWN);&#xD;
				}&#xD;
				else if(listaAttributiOrdine.get(k) == &quot;MCRUP&quot; &amp;&amp; VCDaAnagrafe.MCRUP!= null)&#xD;
				{&#xD;
					listaValoriAsset.set(k,VCDaAnagrafe.MCRUP);&#xD;
				}&#xD;
				else if(listaAttributiOrdine.get(k) == &quot;PCRDOWN&quot; &amp;&amp; VCDaAnagrafe.PCRDOWN!= null)&#xD;
				{&#xD;
					listaValoriAsset.set(k,VCDaAnagrafe.PCRDOWN);&#xD;
				}&#xD;
				else if(listaAttributiOrdine.get(k) == &quot;PCRUP&quot; &amp;&amp; VCDaAnagrafe.PCRUP!= null)&#xD;
				{&#xD;
					listaValoriAsset.set(k,VCDaAnagrafe.PCRUP);&#xD;
				}&#xD;
				else if(listaAttributiOrdine.get(k) == &quot;SCRDOWN&quot; &amp;&amp; VCDaAnagrafe.SCRDOWN!= null)&#xD;
				{&#xD;
					listaValoriAsset.set(k,VCDaAnagrafe.SCRDOWN);&#xD;
				}&#xD;
				else if(listaAttributiOrdine.get(k) == &quot;SCRUP&quot; &amp;&amp; VCDaAnagrafe.SCRUP!= null)&#xD;
				{&#xD;
					listaValoriAsset.set(k,VCDaAnagrafe.SCRUP);&#xD;
				}	&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				//Ciclo su attributi dell'asset&#xD;
				for(var j=0; j&lt;componenteAsset.attributidettaglioasset.size();j++){&#xD;
					var attributoAsset = componenteAsset.attributidettaglioasset.get(j);&#xD;
					if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine.get(k))){&#xD;
						listaValoriAsset.set(k,attributoAsset.valoreAttributo);&#xD;
					}&#xD;
					&#xD;
					if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEVP){&#xD;
						CODICEVPAsset = attributoAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETD){&#xD;
						CODICETDAsset = attributoAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC){&#xD;
						TIPOPROFILOVCAsset = attributoAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID){&#xD;
						uservlanAsset = attributoAsset.valoreAttributo;&#xD;
					}&#xD;
					//RU_1180&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST){&#xD;
						FLAGMULTICASTAsset = attributoAsset.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}		&#xD;
		}&#xD;
		&#xD;
		//modifica componente rispetto alla sotto lavorazione&#xD;
		if(componenteOrdine != null){&#xD;
				Process.auditLog(&quot;Lavorazione componente Ordine: VPIOrdine:&quot;+VPIOrdine + &quot;, VCIOrdine:&quot;+VCIOrdine+&quot;, uservlanOrdine:&quot;+uservlanOrdine+&quot;, DLCIOrdine:&quot;+DLCIOrdine);&#xD;
				//Recupero dati ordine &#xD;
				var TIPOPROFILOVCOrdine = &quot;&quot;;&#xD;
				TIPOPROFILOVCOrdine = null;&#xD;
				&#xD;
				//RU_1180&#xD;
				var FLAGMULTICASTordine = &quot;&quot;;&#xD;
				FLAGMULTICASTordine = null;&#xD;
				var SVLANCODEordine = &quot;&quot;;&#xD;
				SVLANCODEordine = null;&#xD;
				var CODEVLANSINGLETAGordine = &quot;&quot;;&#xD;
				CODEVLANSINGLETAGordine = null;&#xD;
&#xD;
				for(var l=0; l&lt;componenteOrdine.attributiDettaglioOrdine.size();l++){&#xD;
					var attr = componenteOrdine.attributiDettaglioOrdine.get(l);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEVP){&#xD;
						CODICEVPOrdine = attr.valoreAttributo;&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETD){&#xD;
						CODICETDOrdine = attr.valoreAttributo;&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC){&#xD;
						TIPOPROFILOVCOrdine = attr.valoreAttributo;&#xD;
					}&#xD;
					//RU_1180&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST){&#xD;
						FLAGMULTICASTordine = attr.valoreAttributo;&#xD;
					}&#xD;
					//RU_1180&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE){&#xD;
						SVLANCODEordine = attr.valoreAttributo;&#xD;
					}&#xD;
					//RU_1180&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG){&#xD;
						CODEVLANSINGLETAGordine = attr.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					var trovatoAttrOrdine = false;&#xD;
					for(var p=0; p&lt;listaAttributiOrdine.size(); p++){&#xD;
						if(listaAttributiOrdine.get(p) == String(attr.nomeAttributo)){&#xD;
							trovatoAttrOrdine=true;&#xD;
							listaValoriOrdine.set(p,attr.valoreAttributo);&#xD;
							&#xD;
							//Task #36094&#xD;
							//Quando abbiamo una USERVLAN con azione a D deve essere soltanto CESSATA, quindi se in input l'utente inserisce un valore diverso da quello in asset,&#xD;
							//questo deve essere ignorato. Quindi non va creato il valore OLD e il valore dell'attributo va sovrascritto con quello dell'asset.&#xD;
							if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
							   &amp;&amp; componenteOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
							{&#xD;
								listaDaSovrascrivere.set(p,true);&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//-------------elaborazione logiche particolari&#xD;
				//RiconfigurazioneAccesso (VARIAZIONECARATTERISTICA, RICONFIGURAZIONEVC) - BITSTREAMATMASIMMETRICOFLAT&#xD;
				if((localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONECARATTERISTICA&#xD;
					|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)){&#xD;
					//CODICEVP id 8&#xD;
					//CODICETD id 9&#xD;
					if(listaAttributiOrdine.contains(&quot;CODICEVP&quot;) &amp;&amp; listaAttributiOrdine.contains(&quot;CODICETD&quot;)){&#xD;
						if(CODICEVPOrdine!= null &amp;&amp; CODICETDOrdine!= null){&#xD;
							Process.auditLog(&quot;Presenti in ingresso entrambi gli elementi: CODICETD, CODICEVP. Casistica non ammessa&quot;);&#xD;
						}&#xD;
						else if(CODICEVPOrdine!= null){&#xD;
							if(CODICETDAsset!=null){&#xD;
								//elimino CODICETD&#xD;
								var trovatoUSERVLANID = false;&#xD;
								var p =0;&#xD;
								while(!trovatoUSERVLANID &amp;&amp; p&lt;listaAttributiOrdine.size()){&#xD;
									if(listaAttributiOrdine.get(p) == &quot;CODICETD&quot;){&#xD;
										listaDaEliminare.set(p, true);&#xD;
										trovatoUSERVLANID = true;&#xD;
									}&#xD;
									p++;&#xD;
								}&#xD;
								if(!trovatoUSERVLANID){&#xD;
									Process.auditLog(&quot;TipologiaSottolavorazione VARIAZIONETAGGING senza CODICETD&quot;);&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
						else if(CODICETDOrdine!= null){&#xD;
							if(CODICEVPAsset!=null){&#xD;
								//elimino CODICEVP&#xD;
								var trovatoUSERVLANID = false;&#xD;
								var p =0;&#xD;
								while(!trovatoUSERVLANID &amp;&amp; p&lt;listaAttributiOrdine.size()){&#xD;
									if(listaAttributiOrdine.get(p) == &quot;CODICEVP&quot;){&#xD;
										listaDaEliminare.set(p, true);&#xD;
										trovatoUSERVLANID = true;&#xD;
									}&#xD;
									p++;&#xD;
								}&#xD;
								if(!trovatoUSERVLANID){&#xD;
									Process.auditLog(&quot;TipologiaSottolavorazione VARIAZIONETAGGING senza CODICEVP&quot;);&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					//RU_1180: C'è FLAGMULTICAST in input -> eliminiamo SVLANCODE/CVLANID in asset&#xD;
					//SM_10355, Task #36311: dobbiamo eliminare anche PROFILOBMD e TIPOTRASPORTO&#xD;
					if(listaAttributiOrdine.contains(&quot;FLAGMULTICAST&quot;) &amp;&amp; FLAGMULTICASTordine != null)&#xD;
					{&#xD;
						Process.auditLog(&quot;Trovato FLAGMULTICAST nell'ordine: &quot; +FLAGMULTICASTordine);&#xD;
						&#xD;
						for(var p=0; p&lt;listaAttributiOrdine.size(); p++)&#xD;
						{&#xD;
							if(listaValoriAsset.get(p) != &quot;&quot;&#xD;
								&amp;&amp;(listaAttributiOrdine.get(p) == &quot;SVLANCODE&quot;&#xD;
								|| listaAttributiOrdine.get(p) == &quot;CVLANID&quot;     	//SM_10283&#xD;
								|| listaAttributiOrdine.get(p) == &quot;PROFILOBMD&quot; 		//SM_10355&#xD;
								|| listaAttributiOrdine.get(p) == &quot;TIPOTRASPORTO&quot;)) //Task #36311&#xD;
							{&#xD;
								listaDaEliminare.set(p, true);&#xD;
								listaDaAggiungere.set(p, false);&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
					//RU_1180: C'è SVLANCODE/CODEVLANSINGLETAG in input -> eliminiamo FLAGMULTICAST in asset&#xD;
					else if(((listaAttributiOrdine.contains(&quot;CODEVLANSINGLETAG&quot;) &amp;&amp; CODEVLANSINGLETAGordine != null)&#xD;
						        ||(listaAttributiOrdine.contains(&quot;SVLANCODE&quot;) &amp;&amp; SVLANCODEordine != null))&#xD;
						     &amp;&amp; listaAttributiOrdine.contains(&quot;FLAGMULTICAST&quot;) &amp;&amp; FLAGMULTICASTAsset != null)&#xD;
					{&#xD;
						Process.auditLog(&quot;Trovato nell'ordine SVLANCODE: &quot; +SVLANCODEordine+ &quot;, CODEVLANSINGLETAG&quot; +CODEVLANSINGLETAGordine+ &quot;e in asset FLAGMULTICAST&quot; +FLAGMULTICASTAsset);&#xD;
						&#xD;
						for(var p=0; p&lt;listaAttributiOrdine.size(); p++)&#xD;
						{&#xD;
							if(listaAttributiOrdine.get(p) == &quot;FLAGMULTICAST&quot;)&#xD;
							{&#xD;
								listaDaEliminare.set(p, true);&#xD;
								listaDaAggiungere.set(p, false);  //SM_10283&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					//Le condizioni di compatibilità tra attributi (Esempio MCRUP) e TIPOPROFILOVC è relativo alla tipologia ABR o VBR o CBR)&#xD;
					// non tutti gli attributi sono previsti per tutte le tipologie.&#xD;
					if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL){&#xD;
						// verifica compatibiltà tra TIPOPROFILOVC e MCRDOWN MCRUP SCRDOWN SCRUP&#xD;
						var compatibilitaProficoVC=DataUtil.createList();&#xD;
						var attributiDaGestire = DataUtil.createList();&#xD;
						// da aggiungere&#xD;
						attributiDaGestire.add(&quot;MCRDOWN&quot;);&#xD;
						attributiDaGestire.add(&quot;MCRUP&quot;);&#xD;
						attributiDaGestire.add(&quot;SCRDOWN&quot;);&#xD;
						attributiDaGestire.add(&quot;SCRUP&quot;);&#xD;
						&#xD;
						if(TIPOPROFILOVCOrdine == &quot;ABR&quot;){&#xD;
							compatibilitaProficoVC.add(&quot;MCRDOWN&quot;);compatibilitaProficoVC.add(&quot;MCRUP&quot;);compatibilitaProficoVC.add(&quot;PCRDOWN&quot;);compatibilitaProficoVC.add(&quot;PCRUP&quot;);&#xD;
						}&#xD;
						else if(TIPOPROFILOVCOrdine == &quot;VBR&quot;){&#xD;
							compatibilitaProficoVC.add(&quot;PCRDOWN&quot;);compatibilitaProficoVC.add(&quot;PCRUP&quot;);compatibilitaProficoVC.add(&quot;SCRDOWN&quot;);compatibilitaProficoVC.add(&quot;SCRUP&quot;);&#xD;
						}&#xD;
						else if(TIPOPROFILOVCOrdine == &quot;CBR&quot;){&#xD;
							compatibilitaProficoVC.add(&quot;PCRDOWN&quot;);compatibilitaProficoVC.add(&quot;PCRUP&quot;);&#xD;
						}&#xD;
							&#xD;
						for(var p=0; p&lt;listaAttributiOrdine.size(); p++){&#xD;
							if(!attributiDaGestire.contains(listaAttributiOrdine.get(p))){&#xD;
								if(compatibilitaProficoVC.contains(listaValoriAsset.get(p))){&#xD;
									listaDaEliminare.set(p,true);&#xD;
									listaDaAggiungere.set(p,false);&#xD;
									listaDaAggiornare.set(p,false);&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				//VARIAZIONETAGGING&#xD;
				else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING){&#xD;
					//CASO 1) Da Tagged ad Untagged: caso in cui UserVLAN_1_TAGGING in input è UNTAGGED e in consistenza è TAGGED&#xD;
					if(UserVLAN_1_TAGGINGOrdine.toUpperCase() == &quot;UNTAGGED&quot; &amp;&amp; UserVLAN_1_TAGGINGAsset.toUpperCase() == &quot;TAGGED&quot; ){&#xD;
						//elimino USERVLANID&#xD;
						var trovatoUSERVLANID = false;&#xD;
						var p =0;&#xD;
						while (!trovatoUSERVLANID &amp;&amp; p&lt;listaAttributiOrdine.size()){&#xD;
							if(listaAttributiOrdine.get(p) == &quot;USERVLANID&quot;){&#xD;
								listaDaEliminare.set(p, true);&#xD;
								trovatoUSERVLANID = true;&#xD;
							}&#xD;
							p++;&#xD;
						}&#xD;
						if(!trovatoUSERVLANID){&#xD;
							Process.auditLog(&quot;TipologiaSottolavorazione VARIAZIONETAGGING senza USERVLANID&quot;);&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				//CAMBIOTIPOVLAN&#xD;
				//SM_9250: aggiunto if per verifica di ENCAPSULATION&#xD;
				else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN)&#xD;
				{&#xD;
					if(EncapsulationOrdine.toUpperCase() == &quot;SINGLETAG&quot; &amp;&amp; EncapsulationAsset.toUpperCase() == &quot;DOUBLETAG&quot;)&#xD;
					{&#xD;
						//USERVLANID id da eliminare&#xD;
						var trovatoUSERVLANID = false;&#xD;
						var p =0;&#xD;
						while (!trovatoUSERVLANID &amp;&amp; p&lt;listaAttributiOrdine.size()){&#xD;
							if(listaAttributiOrdine.get(p) == &quot;CVLANID&quot;){&#xD;
								listaDaEliminare.set(p, true);&#xD;
								trovatoUSERVLANID = true;&#xD;
							}&#xD;
							p++;&#xD;
						}&#xD;
						if(!trovatoUSERVLANID){&#xD;
							Process.auditLog(&quot;TipologiaSottolavorazione CAMBIOTIPOVLAN senza CVLANID&quot;);&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			&#xD;
				//ciclo su attributi configurati per cercare componenti nell'ordine:&#xD;
				for(var k=0; k&lt;listaAttributiOrdine.size(); k++)&#xD;
				{&#xD;
					//Process.auditLog(&quot;Ciclo per la configurazione listaAttributiOrdine: &quot; + listaAttributiOrdine.get(k) + &quot; listaDaAggiornare: &quot; + listaDaAggiornare.get(k) + &quot; listaDaEliminare: &quot; + listaDaEliminare.get(k) + &quot; listaDaSovrascrivere: &quot; + listaDaSovrascrivere.get(k) + &quot; listaValoriAsset: &quot; + listaValoriAsset.get(k));&#xD;
					//Ciclo su attributi ordine&#xD;
					for(var j=0; j&lt;componenteOrdine.attributiDettaglioOrdine.size();j++)&#xD;
					{&#xD;
						var attributoOrdine = componenteOrdine.attributiDettaglioOrdine.get(j);&#xD;
						//Process.auditLog(&quot;Ciclo Attributo Ordine: &quot; + attributoOrdine.nomeAttributo + &quot; con valore: &quot; + attributoOrdine.valoreAttributo);&#xD;
						// se l'attributo K-esimo è da aggiornare&#xD;
						if(listaDaAggiornare.get(k) == true &amp;&amp; listaDaEliminare.get(k)== false &amp;&amp; (attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine.get(k))&#xD;
									|| (attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG&#xD;
												&amp;&amp; listaAttributiOrdine.get(k) == &quot;SVLANCODE&quot;)))&#xD;
						{&#xD;
							// se se l'asset è diverso da &quot;&quot;&#xD;
							if(listaValoriAsset.get(k) != &quot;&quot;)&#xD;
							{&#xD;
								// se è da sovrascrivere con il valore da Asset&#xD;
								if(listaDaSovrascrivere.get(k) == true)&#xD;
								{&#xD;
									attributoOrdine.valoreAttributo = listaValoriAsset.get(k);&#xD;
								}&#xD;
								// se è da aggiornare ed i valori in ordine ed asset sono diversi&#xD;
								else if(listaValoriAsset.get(k)!= attributoOrdine.valoreAttributo)&#xD;
								{	&#xD;
									//SM_8886 + SM_9033 corretto 'attributo' in 'attributoOrdine'&#xD;
									if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN ||&#xD;
									   attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
									{&#xD;
										var BandaPiccoNew = listaValoriOrdine.get(k);&#xD;
										var BandaPiccoOld = listaValoriAsset.get(k);&#xD;
										&#xD;
										//per evitare casi 0.13/0,13 riconosciuti come variazioni di banda&#xD;
										var numBandaPiccoNew = ScriptUtil.NUM(String(BandaPiccoNew).replace(&quot;,&quot;,&quot;.&quot;));&#xD;
										Process.auditLog(&quot;numBandaPiccoNew: &quot; +numBandaPiccoNew);&#xD;
										var numBandaPiccoOld = ScriptUtil.NUM(String(BandaPiccoOld).replace(&quot;,&quot;,&quot;.&quot;));&#xD;
										Process.auditLog(&quot;numBandaPiccoOld: &quot; +numBandaPiccoOld);&#xD;
										&#xD;
										if(numBandaPiccoNew == numBandaPiccoOld)&#xD;
										{&#xD;
											Process.auditLog(&quot;Valore di BANDAPICCO nell'ordine uguale a quello in asset&quot;);&#xD;
										}&#xD;
										else&#xD;
										{&#xD;
											Azione = &quot;M&quot;;&#xD;
											attributoOrdine.valoreAttributoOLD = listaValoriAsset.get(k);&#xD;
											Process.auditLog(&quot;Valore di BANDAPICCO nell'ordine diverso da quello in asset&quot;);&#xD;
										}&#xD;
									}&#xD;
									//SM_8886 end&#xD;
									else&#xD;
									{&#xD;
										Azione = &quot;M&quot;;&#xD;
										attributoOrdine.valoreAttributoOLD = listaValoriAsset.get(k);&#xD;
									}&#xD;
								}&#xD;
								// se è da aggiornare ed i valori in ordine ed asset sono uguali&#xD;
								else&#xD;
								{&#xD;
									Process.auditLog(&quot;Il valore di &quot;+listaAttributiOrdine.get(k)+&quot; presente in asset coincide con il valore nella richiesta, nessuna modifica richiesta: VPIOrdine=&quot;+VPIOrdine+&quot;, VCIOrdine=&quot;+VCIOrdine+&quot;, uservlanOrdine=&quot;+uservlanOrdine);&#xD;
								}&#xD;
							}&#xD;
							else&#xD;
							{&#xD;
								Process.auditLog(&quot;Nessun valore recuperato in asset per &quot;+listaAttributiOrdine.get(k)+&quot; VPIOrdine=&quot;+VPIOrdine+&quot;, VCIOrdine=&quot;+VCIOrdine+&quot;, uservlanOrdine=&quot;+uservlanOrdine);&#xD;
							}&#xD;
							listaDaAggiornare.set(k,false);&#xD;
							listaDaAggiungere.set(k,false);&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//ciclo su attributi configurati per aggiungere/eliminare componente non presenti nell'ordine:&#xD;
				var attrCampione = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attrCampione.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attrCampione.created = data;&#xD;
				attrCampione.lastUpdate = data;&#xD;
				attrCampione.operatore = &quot;BPM&quot;;&#xD;
				attrCampione.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				for(var k=0; k&lt;listaAttributiOrdine.size(); k++){&#xD;
					// Se l'attributo è da aggiungere&#xD;
					if(listaDaAggiungere.get(k)== true &amp;&amp; listaDaEliminare.get(k)==false)&#xD;
					{&#xD;
						if(listaValoriAsset.get(k) != &quot;&quot;){&#xD;
							var attrtemp = ScriptUtil.copy(attrCampione);&#xD;
							attrtemp.IDDettaglioOrdine = componenteOrdine.IDDettaglioOrdine;&#xD;
							attrtemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine.get(k));&#xD;
							attrtemp.valoreAttributo = listaValoriAsset.get(k);&#xD;
							componenteOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attrtemp));&#xD;
						}&#xD;
						else{&#xD;
							Process.auditLog(&quot;Nessun valore recuperato in asset per &quot;+listaAttributiOrdine.get(k)+&quot; VPIOrdine=&quot;+VPIOrdine+&quot;, VCIOrdine=&quot;+VCIOrdine+&quot;, uservlanOrdine=&quot;+uservlanOrdine);&#xD;
						}&#xD;
					}&#xD;
					// Se l'attributo è da eliminare&#xD;
					else if(listaDaAggiungere.get(k)== false &amp;&amp; listaDaEliminare.get(k)==true)&#xD;
					{&#xD;
						//Se era presente qualcosa nell'ordine (RU_1180 e Task #36311)&#xD;
						if(listaValoriOrdine.get(k)!=&quot;&quot;)&#xD;
						{&#xD;
							var index = 0;&#xD;
							var attributoSostituito = false;&#xD;
							&#xD;
							while(!attributoSostituito &amp;&amp; index&lt;componenteOrdine.attributiDettaglioOrdine.size())&#xD;
							{&#xD;
								var attributoDaSost = componenteOrdine.attributiDettaglioOrdine.get(index);&#xD;
								if(String(attributoDaSost.nomeAttributo)==listaAttributiOrdine.get(k))&#xD;
								{&#xD;
									attributoDaSost.valoreAttributo = &quot;ATTRIBUTO IN ELIMINAZIONE&quot;;&#xD;
									attributoDaSost.valoreAttributoOLD = listaValoriAsset.get(k);&#xD;
									Azione = &quot;M&quot;; //SM_11006: Aggiunta azione ad M (va interpretata come una modifica): valorizzazione utile a settare il flag LavorazioneAutoespletante alla riga 788&#xD;
								}&#xD;
								index++;&#xD;
							}&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							var attrtemp = ScriptUtil.copy(attrCampione);&#xD;
							attrtemp.IDDettaglioOrdine = componenteOrdine.IDDettaglioOrdine;&#xD;
							attrtemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine.get(k));&#xD;
							Azione = &quot;M&quot;;&#xD;
							attrtemp.valoreAttributo = &quot;ATTRIBUTO IN ELIMINAZIONE&quot;;&#xD;
							attrtemp.valoreAttributoOLD = listaValoriAsset.get(k);&#xD;
							componenteOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attrtemp));&#xD;
						}&#xD;
					}&#xD;
					if(listaDaAggiungere.get(k)== true &amp;&amp; listaDaEliminare.get(k)==true)&#xD;
					{&#xD;
						Process.auditLog(&quot;Configurazione non coerente per l'attributo&quot;+listaAttributiOrdine.get(k));&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING&#xD;
					&amp;&amp; UserVLAN_1_TAGGINGOrdine.toUpperCase() == &quot;UNTAGGED&quot; &amp;&amp; UserVLAN_1_TAGGINGAsset.toUpperCase() == &quot;TAGGED&quot; )&#xD;
				{&#xD;
					if(USERVLANIDOrdine == uservlanOrdine)&#xD;
					{&#xD;
						componenteOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						componenteOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
					}&#xD;
				}&#xD;
				else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING&#xD;
					&amp;&amp; UserVLAN_1_TAGGINGOrdine.toUpperCase() == &quot;TAGGED&quot; &amp;&amp; UserVLAN_1_TAGGINGAsset.toUpperCase() == &quot;UNTAGGED&quot; )&#xD;
				{&#xD;
					if(USERVLANIDOrdine == uservlanOrdine)&#xD;
					{&#xD;
						componenteOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
					}&#xD;
				}&#xD;
				else if(componenteOrdine.azione != it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
				{&#xD;
					if(Azione == &quot;M&quot;)&#xD;
					{		&#xD;
						componenteOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
						LavorazioneAutoespletante = false; //SM_11006: se viene variato oltre ad attributo INTERMEDIATEAGENTFULL anche attributi della componente USERVLAN/GBEVC, allora l'ordine NON deve essere autoespletante.&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						componenteOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
					}&#xD;
				}&#xD;
		}&#xD;
		else{&#xD;
			var componenteTemp = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			componenteTemp.IDDettaglioOrdineParent = 1;&#xD;
			componenteTemp.IDDettaglioOrdineRoot = 1;&#xD;
			componenteTemp.operatore = &quot;BPM&quot;;&#xD;
			componenteTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			componenteTemp.created = data;&#xD;
			componenteTemp.lastUpdate = data;&#xD;
			Process.auditLog(&quot;USERVLANIDOrdine:&quot;+USERVLANIDOrdine+&quot;uservlanAsset:&quot;+uservlanAsset);&#xD;
			if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING&#xD;
				&amp;&amp; UserVLAN_1_TAGGINGOrdine.toUpperCase() == &quot;UNTAGGED&quot; &amp;&amp; UserVLAN_1_TAGGINGAsset.toUpperCase()== &quot;TAGGED&quot; )&#xD;
			{&#xD;
				if(USERVLANIDOrdine == uservlanAsset)&#xD;
				{&#xD;
					componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
					//prevedi eliminazione dell'attributo USERVLANID&#xD;
					var indiceAttributi =0;&#xD;
					var USERVLANIDAttributiTrovato = false;&#xD;
					while(!USERVLANIDAttributiTrovato &amp;&amp; indiceAttributi&lt;listaAttributiOrdine.size()){&#xD;
						if(listaAttributiOrdine.get(indiceAttributi)==&quot;USERVLANID&quot;){&#xD;
							listaValoriOrdine.set(indiceAttributi, &quot;ATTRIBUTO IN ELIMINAZIONE&quot;);&#xD;
							USERVLANIDAttributiTrovato = true;&#xD;
						}&#xD;
						indiceAttributi++;&#xD;
					}&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
				}&#xD;
			}&#xD;
			else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING&#xD;
				&amp;&amp; UserVLAN_1_TAGGINGOrdine.toUpperCase() == &quot;TAGGED&quot; &amp;&amp; UserVLAN_1_TAGGINGAsset.toUpperCase()== &quot;UNTAGGED&quot;)&#xD;
			{&#xD;
				//caso particolare per variazione  da UNTAGGED a TAGGED&#xD;
				//cerco l'attributo USERVLANID e modifico il valore&#xD;
				var trovatoUSERVLANID = false;&#xD;
				var p =0;&#xD;
				while (!trovatoUSERVLANID &amp;&amp; p&lt;listaAttributiOrdine.size())&#xD;
				{&#xD;
					if(listaAttributiOrdine.get(p) == &quot;USERVLANID&quot;)&#xD;
					{&#xD;
						listaValoriOrdine.set(p,USERVLANIDOrdine);&#xD;
						trovatoUSERVLANID = true;&#xD;
					}&#xD;
					p++;&#xD;
				}&#xD;
				if(!trovatoUSERVLANID)&#xD;
				{&#xD;
					Process.auditLog(&quot;TipologiaSottolavorazione VARIAZIONETAGGING senza USERVLANID&quot;);&#xD;
				}			&#xD;
				componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
			}&#xD;
			var contaVC =0;&#xD;
			for(var n=0; n&lt;localRequest.ordine.dettaglioordine.size(); n++){&#xD;
				if(localRequest.ordine.dettaglioordine.get(n).nomeComponente == componenteAsset.nomeComponente){&#xD;
					contaVC++;&#xD;
				}&#xD;
			}&#xD;
			componenteTemp.progressivo = contaVC+1;&#xD;
			componenteTemp.integrationID = localRequest.IDRichiestaOLO + componenteTemp.IDDettaglioOrdine;&#xD;
			&#xD;
			componenteTemp.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() +1;&#xD;
			componenteTemp.nomeComponente = componenteAsset.nomeComponente;&#xD;
			&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			attributo.IDDettaglioOrdine = componenteTemp.IDDettaglioOrdine;&#xD;
			attributo.created = data;&#xD;
			attributo.lastUpdate =data;&#xD;
			attributo.operatore = &quot;BPM&quot;;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			&#xD;
			for(var k=0; k&lt;listaAttributiOrdine.size(); k++)&#xD;
			{	&#xD;
				attributo.valoreAttributoOLD = null;	&#xD;
				if(listaValoriAsset.get(k) != &quot;&quot; &amp;&amp; (listaValoriOrdine.get(k) == &quot;&quot; || listaValoriOrdine.get(k) == listaValoriAsset.get(k) )){&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine.get(k));&#xD;
					attributo.valoreAttributo = listaValoriAsset.get(k);&#xD;
					componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				else if(listaValoriAsset.get(k) != &quot;&quot; &amp;&amp; listaValoriOrdine.get(k) != &quot;&quot; &amp;&amp; listaValoriOrdine.get(k) != listaValoriAsset.get(k) ){&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine.get(k));&#xD;
					attributo.valoreAttributo = listaValoriOrdine.get(k);&#xD;
					//SM_8886 start&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN ||&#xD;
					   attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
					{&#xD;
						var BandaPiccoNew = listaValoriOrdine.get(k);&#xD;
						var BandaPiccoOld = listaValoriAsset.get(k);&#xD;
						&#xD;
						var numBandaPiccoNew = ScriptUtil.NUM(String(BandaPiccoNew).replace(&quot;,&quot;,&quot;.&quot;));&#xD;
						Process.auditLog(&quot;numBandaPiccoNew: &quot; +numBandaPiccoNew);&#xD;
						var numBandaPiccoOld = ScriptUtil.NUM(String(BandaPiccoOld).replace(&quot;,&quot;,&quot;.&quot;));&#xD;
						Process.auditLog(&quot;numBandaPiccoOld: &quot; +numBandaPiccoOld);&#xD;
						var isEqual = numBandaPiccoNew == numBandaPiccoOld ? true : false;&#xD;
						if(!isEqual)&#xD;
						{&#xD;
							attributo.valoreAttributoOLD = listaValoriAsset.get(k);&#xD;
						}&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						attributo.valoreAttributoOLD = listaValoriAsset.get(k);&#xD;
					}&#xD;
					//SM_8886 end&#xD;
					componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));		&#xD;
				}&#xD;
				else if(listaValoriAsset.get(k) == &quot;&quot; &amp;&amp; listaValoriOrdine.get(k) != &quot;&quot;){&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine.get(k));&#xD;
					attributo.valoreAttributo = listaValoriOrdine.get(k);&#xD;
					componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				else{&#xD;
					Process.auditLog(&quot;Attributo &quot;+listaAttributiOrdine.get(k) +&quot; non presente in consistenza per: VPIAsset=&quot;+VPIAsset+&quot;, VCIAsset=&quot;+VCIAsset+&quot;, uservlanAsset=&quot;+uservlanAsset);&#xD;
				}&#xD;
			}&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componenteTemp));&#xD;
		}&#xD;
	}&#xD;
	else if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER){&#xD;
		var componenteTemp = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componenteTemp.IDDettaglioOrdineParent = 1;&#xD;
		componenteTemp.IDDettaglioOrdineRoot = 1;&#xD;
		componenteTemp.created = data;&#xD;
		componenteTemp.operatore = &quot;BPM&quot;;&#xD;
		componenteTemp.lastUpdate = data;&#xD;
		componenteTemp.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() +1;&#xD;
		//conta SPLITTER&#xD;
		var contaSPLITTER =0;&#xD;
		for(var n=0; n&lt;localRequest.ordine.dettaglioordine.size(); n++){&#xD;
			if(localRequest.ordine.dettaglioordine.get(n).nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SPLITTER){&#xD;
				contaSPLITTER++;&#xD;
			}&#xD;
		}&#xD;
		componenteTemp.progressivo = contaSPLITTER+1;&#xD;
		componenteTemp.integrationID = localRequest.IDRichiestaOLO + componenteTemp.IDDettaglioOrdine;&#xD;
		&#xD;
		componenteTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
		&#xD;
		componenteTemp.nomeComponente = componenteAsset.nomeComponente;&#xD;
		&#xD;
		var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
		attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		attributo.created = data;&#xD;
		attributo.lastUpdate =data;&#xD;
		attributo.operatore = &quot;BPM&quot;;&#xD;
		attributo.IDDettaglioOrdine = componenteTemp.IDDettaglioOrdine;&#xD;
		attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		&#xD;
		for(var k=0; k&lt;componenteAsset.attributidettaglioasset.size(); k++){&#xD;
			var attributoAsset = componenteAsset.attributidettaglioasset.get(k);&#xD;
			if(listaAttributiSPLITTER.contains(String(attributoAsset.nomeAttributo))){&#xD;
				attributo.nomeAttributo = attributoAsset.nomeAttributo;&#xD;
				attributo.valoreAttributo = attributoAsset.valoreAttributo;&#xD;
				componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
		}&#xD;
		if(componenteTemp.attributiDettaglioOrdine.size()>0){&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componenteTemp));&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Componente SPLITTER in asset non aggiunto a causa della mancanza degli attributi previsti&quot;);&#xD;
		}&#xD;
	}&#xD;
	else if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM){&#xD;
		var componenteTemp = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componenteTemp.IDDettaglioOrdineParent = 1;&#xD;
		componenteTemp.IDDettaglioOrdineRoot = 1;&#xD;
		componenteTemp.operatore = &quot;BPM&quot;;&#xD;
		componenteTemp.created = data;&#xD;
		componenteTemp.lastUpdate = data;&#xD;
		componenteTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
		componenteTemp.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() +1;&#xD;
		componenteTemp.nomeComponente = componenteAsset.nomeComponente;&#xD;
		componenteTemp.integrationID = localRequest.IDRichiestaOLO + componenteTemp.IDDettaglioOrdine;&#xD;
		//conta MODEM&#xD;
		var contaMODEM =0;&#xD;
		for(var n=0; n&lt;localRequest.ordine.dettaglioordine.size();n++){&#xD;
			if(localRequest.ordine.dettaglioordine.get(n).nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM){&#xD;
