        <xpdl2:Activity Id="_7_bgMebiEeaqr96OWxgQ0w" Name="AggiornaComponenteAttivazioneLA" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna Componente Attivazione LA">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var tipoLineaOrdine = &quot;&quot;;&#xD;
var tipoLineaAsset = &quot;&quot;;&#xD;
&#xD;
tipoLineaOrdine =  null;&#xD;
tipoLineaAsset = null;&#xD;
&#xD;
var strutturaLineaOrdine = &quot;&quot;;&#xD;
var strutturaLineaAsset = &quot;&quot;;&#xD;
&#xD;
strutturaLineaOrdine =  null;&#xD;
strutturaLineaAsset = null;&#xD;
&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
var indexAccessoOrdine = 0;&#xD;
indexAccessoOrdine = null;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
		//SLU LA	&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP)&#xD;
		{&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU&#xD;
			|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
			//SM_11563&#xD;
			/*else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;			&#xD;
			}&#xD;
			else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;			&#xD;
			}*/&#xD;
			else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;			&#xD;
			}&#xD;
			//RU_980: valorizzazione azione per SERVIZIOPZIONALI&#xD;
			else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} &#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
		&#xD;
		//FLAGDNDONOROLO&#xD;
		if(DatiDiogene != null&#xD;
			&amp;&amp; DatiDiogene.flagDnDonorOlo != null&#xD;
			&amp;&amp; componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU&#xD;
			&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP)&#xD;
		{&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = ora;&#xD;
			attributo.lastUpdate =ora;&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGDNDONOROLO;&#xD;
			attributo.operatore = componente.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			attributo.valoreAttributo = DatiDiogene.flagDnDonorOlo;&#xD;
			componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
		}&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			indexAccessoOrdine = i;&#xD;
			&#xD;
			var j = 0;&#xD;
			while((tipoLineaOrdine == null || strutturaLineaOrdine == null) &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					tipoLineaOrdine = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato TIPOLINEA in ORDINE: &quot; + tipoLineaOrdine);&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
				{&#xD;
					strutturaLineaOrdine = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato STRUTTURALINEA in ORDINE: &quot; + strutturaLineaOrdine);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//C01M02F12 Recupero DISTRETTO/NUMEROFITTIZIO/IDCONTRATTO/CLIENTE&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.IDAsset != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaFonia.IDAsset, 10));&#xD;
	}&#xD;
	else if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
	}&#xD;
	&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		Asset = AssetRef.readAsset();&#xD;
		if(Asset.distretto != null &amp;&amp; Asset.distretto.length > 0)&#xD;
		{&#xD;
			localRequest.ordine.distretto = Asset.distretto;&#xD;
		}&#xD;
		/*if (Asset.numeroFittizio != null &amp;&amp; Asset.numeroFittizio.length > 0)&#xD;
		{&#xD;
			localRequest.ordine.numeroFittizio = Asset.numeroFittizio;&#xD;
		}*/	&#xD;
		if(Asset.IDContratto != null &amp;&amp; localRequest.IDContratto == null)&#xD;
		{&#xD;
			localRequest.IDContratto = Asset.IDContratto;&#xD;
		}&#xD;
		&#xD;
		if(Asset.cliente != null 									&#xD;
			&amp;&amp; localRequest.ordine.nome == null &#xD;
			&amp;&amp; localRequest.ordine.cognomeRagioneSociale == null &#xD;
			&amp;&amp; localRequest.ordine.CF == null&#xD;
			&amp;&amp; localRequest.ordine.PIVA == null)  //Task #38239&#xD;
		{&#xD;
			if (Asset.cliente.nome != null &amp;&amp; (localRequest.ordine.nome == null || localRequest.ordine.nome == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.nome = Asset.cliente.nome;&#xD;
			}		&#xD;
			if (Asset.cliente.cognomeRagioneSociale != null &amp;&amp; (localRequest.ordine.cognomeRagioneSociale == null || localRequest.ordine.cognomeRagioneSociale == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.cognomeRagioneSociale = Asset.cliente.cognomeRagioneSociale;&#xD;
			}&#xD;
			&#xD;
			//SM_10686: Spostato arricchimento dei due campi qui invece che negli arricchimenti comuni&#xD;
			//CF e PIVA sono mutuamente esclusivi e non vanno arricchiti se uno dei due è indicato in input dall'OLO&#xD;
			if(localRequest.ordine.CF == null &amp;&amp; localRequest.ordine.PIVA == null)&#xD;
			{				&#xD;
				localRequest.ordine.CF = Asset.cliente.codiceFiscale;&#xD;
				localRequest.ordine.PIVA = Asset.cliente.partitaIVA;			&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(tipoLineaOrdine == null || strutturaLineaOrdine == null)&#xD;
		{&#xD;
			var i = 0;&#xD;
			while(((tipoLineaAsset == null &amp;&amp; tipoLineaOrdine == null) || (strutturaLineaAsset == null &amp;&amp; strutturaLineaOrdine == null)) &amp;&amp; i &lt; Asset.dettaglioasset.size())&#xD;
			{&#xD;
				var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
				&#xD;
				if(String(currentDettAsset.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var j = 0;&#xD;
					while(((tipoLineaAsset == null &amp;&amp; tipoLineaOrdine == null) || (strutturaLineaAsset == null &amp;&amp; strutturaLineaOrdine == null))  &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
					{&#xD;
						var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
						{&#xD;
							tipoLineaAsset = currentAttDettAsset.valoreAttributo;&#xD;
							Process.auditLog(&quot;Trovato TIPOLINEA in ASSET: &quot; + tipoLineaAsset);&#xD;
						}&#xD;
						else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
						{&#xD;
							strutturaLineaAsset = currentAttDettAsset.valoreAttributo;&#xD;
							Process.auditLog(&quot;Trovato STRUTTURA in ASSET: &quot; + tipoLineaAsset);&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
			&#xD;
			if(tipoLineaAsset != null &amp;&amp; tipoLineaOrdine == null)&#xD;
			{&#xD;
				var componenteAccesso = localRequest.ordine.dettaglioordine.get(indexAccessoOrdine);&#xD;
				&#xD;
				var attTemp = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attTemp.IDDettaglioOrdine = componenteAccesso.IDDettaglioOrdine;&#xD;
				attTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attTemp.created = date;&#xD;
				attTemp.lastUpdate = date;&#xD;
				attTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
				attTemp.operatore = &quot;BPM&quot;;&#xD;
				attTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attTemp.valoreAttributo = tipoLineaAsset;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexAccessoOrdine).attributiDettaglioOrdine.add(ScriptUtil.copy(attTemp));&#xD;
			}&#xD;
			&#xD;
			if(strutturaLineaAsset != null &amp;&amp; strutturaLineaOrdine == null)&#xD;
			{&#xD;
				var componenteAccesso = localRequest.ordine.dettaglioordine.get(indexAccessoOrdine);&#xD;
				&#xD;
				var attTemp = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attTemp.IDDettaglioOrdine = componenteAccesso.IDDettaglioOrdine;&#xD;
				attTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attTemp.created = date;&#xD;
				attTemp.lastUpdate = date;&#xD;
				attTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA;&#xD;
				attTemp.operatore = &quot;BPM&quot;;&#xD;
				attTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attTemp.valoreAttributo = strutturaLineaAsset;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexAccessoOrdine).attributiDettaglioOrdine.add(ScriptUtil.copy(attTemp));&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Consistenza Fonia o Dati non trovata.&quot;);&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
var indexInventory=0;&#xD;
var progr=1;&#xD;
while(indexInventory&lt;InventoryDBCFXResponse.size())&#xD;
{&#xD;
	var currentInventory=InventoryDBCFXResponse.get(indexInventory);&#xD;
	var aggiuntivoISDN = (currentInventory.datiUnica.tipoNumero!=&quot;NATIVO VOIP IMS&quot; &amp;&amp; (currentInventory.datiUnica.tipoServizio==&quot;ISDN BMO&quot; || currentInventory.datiUnica.tipoServizio==&quot;ISDN BMU&quot;&#xD;
		|| ((currentInventory.datiUnica.tipoServizio==&quot;CAPOSERIE&quot; || currentInventory.datiUnica.tipoServizio==&quot;LINEA PBX&quot;) &#xD;
		&amp;&amp; currentInventory.CRMWSResponse.tipo_Linea.banda_Servizio==&quot;ISDN BRA&quot;)&#xD;
		|| ((currentInventory.datiUnica.tipoServizio==&quot;RADICALE&quot; || currentInventory.datiUnica.tipoServizio==&quot;SPE&quot; || currentInventory.datiUnica.tipoServizio==&quot;SPU&quot;) &#xD;
		&amp;&amp; (currentInventory.CRMWSResponse.tipo_Linea.banda_Servizio==&quot;ISDN BRA&quot; || currentInventory.CRMWSResponse.tipo_Linea.banda_Servizio==&quot;ISDN PRA&quot;))));&#xD;
	&#xD;
	if(localRequest.tipologiaSottolav==it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274&#xD;
		&amp;&amp; currentInventory.datiUnica.numeroTelefonicoPrincipale!=null&#xD;
		&amp;&amp; currentInventory.datiUnica.numeroTelefonicoPrincipale!=currentInventory.numero_Telefonico&#xD;
		&amp;&amp; aggiuntivoISDN&#xD;
		&amp;&amp; currentInventory.datiUnica.flagAttivo==&quot;Y&quot;)&#xD;
		{&#xD;
			//creazione componente NUMERIAGGIUNTIVI&#xD;
			var dettaglio = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			dettaglio.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
			dettaglio.IDDettaglioOrdineParent = 1;&#xD;
			dettaglio.IDDettaglioOrdineRoot = 1;&#xD;
			dettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			dettaglio.IDRisorsa = localRequest.IDRisorsa;&#xD;
			dettaglio.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
			dettaglio.created = date;&#xD;
			dettaglio.integrationID = localRequest.IDRichiestaOLO + dettaglio.IDDettaglioOrdine;&#xD;
			dettaglio.lastUpdate = date;&#xD;
			dettaglio.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMERIAGGIUNTIVI;&#xD;
			dettaglio.operatore = &quot;BPM&quot;;&#xD;
			dettaglio.progressivo = progr;&#xD;
			 &#xD;
			 // creazione attributi&#xD;
 			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
 			attributo.IDDettaglioOrdine = dettaglio.IDDettaglioOrdine;&#xD;
 			attributo.IDRichiestaOLO = dettaglio.IDRichiestaOLO;&#xD;
			attributo.created = date;&#xD;
			attributo.lastUpdate = date;&#xD;
			attributo.operatore = &quot;BPM&quot;;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
&#xD;
			var listaAttributi=DataUtil.createList();&#xD;
			listaAttributi.add(it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO);&#xD;
			listaAttributi.add(it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO);&#xD;
			listaAttributi.add(it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO);&#xD;
			listaAttributi.add(it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE);&#xD;
			listaAttributi.add(it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE);&#xD;
			listaAttributi.add(it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE);&#xD;
			listaAttributi.add(it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAOLO);&#xD;
			listaAttributi.add(it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP);&#xD;
			/*listaAttributi.add(it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA);*/&#xD;
&#xD;
			var indexAttributo=0;&#xD;
			while(indexAttributo&lt;listaAttributi.size())&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo=listaAttributi.get(indexAttributo);&#xD;
				if(attrTemp.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					attrTemp.valoreAttributo=currentInventory.numero_Telefonico;&#xD;
				}&#xD;
				else if(attrTemp.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO)&#xD;
				{&#xD;
					attrTemp.valoreAttributo=currentInventory.datiUnica.distretto;&#xD;
				}&#xD;
				else if(attrTemp.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO)&#xD;
				{&#xD;
					attrTemp.valoreAttributo=&quot;Attivo&quot;;&#xD;
				}&#xD;
				else if(attrTemp.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE)&#xD;
				{&#xD;
					attrTemp.valoreAttributo=currentInventory.datiUnica.numeroTelefonicoPrincipale;&#xD;
				}&#xD;
				else if(attrTemp.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
				{&#xD;
					attrTemp.valoreAttributo=currentInventory.datiUnica.radicale;&#xD;
				}&#xD;
				else if(attrTemp.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE)&#xD;
				{&#xD;
					attrTemp.valoreAttributo=currentInventory.datiUnica.caposerie;&#xD;
				}&#xD;
				else if(attrTemp.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAOLO)&#xD;
				{&#xD;
					attrTemp.valoreAttributo=tipoLineaOrdine;&#xD;
				}&#xD;
				else if(attrTemp.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP)&#xD;
				{&#xD;
					var tipoLineaNP=&quot;&quot;;&#xD;
					if(currentInventory.datiUnica.tipoNumero == &quot;GNR RADICALE&quot;&#xD;
						|| currentInventory.datiUnica.tipoNumero == &quot;RADICALE ACCORPATO&quot;)&#xD;
					{&#xD;
						tipoLineaNP = &quot;1&quot;;&#xD;
					}&#xD;
					else if(currentInventory.datiUnica.tipoNumero == &quot;GNR LINEE&quot;)&#xD;
					{&#xD;
						tipoLineaNP = &quot;2&quot;;&#xD;
					}&#xD;
					else if((currentInventory.datiUnica.tipoServizio == &quot;ISDN&quot;&#xD;
							|| currentInventory.datiUnica.tipoServizio == &quot;ISDN BMO&quot;&#xD;
							|| currentInventory.datiUnica.tipoServizio == &quot;ISDN BMU&quot;&#xD;
							|| currentInventory.datiUnica.tipoServizio == &quot;ISDN PRA&quot;)&#xD;
							&amp;&amp; currentInventory.datiUnica.tipoNumero == &quot;AGGIUNTIVI&quot;)&#xD;
					{&#xD;
						tipoLineaNP = &quot;3&quot;;&#xD;
					}&#xD;
								&#xD;
					attrTemp.valoreAttributo=tipoLineaNP;&#xD;
				}&#xD;
				/*else if(attrTemp.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA)&#xD;
				{&#xD;
					attrTemp.valoreAttributo=;&#xD;
				}*/&#xD;
				if(attrTemp.valoreAttributo!=null &amp;&amp; attrTemp.valoreAttributo!=&quot;&quot;)&#xD;
				{&#xD;
					dettaglio.attributiDettaglioOrdine.add(ScriptUtil.copy(attrTemp));&#xD;
				}&#xD;
				indexAttributo++;&#xD;
			}&#xD;
			&#xD;
			&#xD;
			&#xD;
			if(dettaglio.attributiDettaglioOrdine.size()>0)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettaglio));&#xD;
				progr++;&#xD;
			}&#xD;
			&#xD;
		}&#xD;
	indexInventory++;&#xD;
}&#xD;
&#xD;
//Bug #31796: arricchimento TIPODISAGGREGAZIONE e PRESTAZIONIAGGIUNTIVE della componente DISAGGREGAZIONE&#xD;
//LOGICA PER ARRICCHIMENTO&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.disaggregato == &quot;S&quot;)&#xD;
{&#xD;
	//Recupero condizioni per arricchimento&#xD;
	var trovataDisaggregazione = false;&#xD;
	var trovataAppuntamentoDisaggregazione = false;&#xD;
	var trovataPrestazioniAggiuntive = false;&#xD;
	var OwnerPresaAppuntamento = &quot;&quot;; &#xD;
	var FlagPrestazioneAggiuntiva = &quot;&quot;;&#xD;
	OwnerPresaAppuntamento = null;  &#xD;
	FlagPrestazioneAggiuntiva = null;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE)&#xD;
		{&#xD;
			trovataDisaggregazione = true; &#xD;
			Process.auditLog(&quot;Trovata componente DISAGGREGAZIONE&quot;);&#xD;
		}&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTODISAGGREGAZIONE)&#xD;
		{&#xD;
			trovataAppuntamentoDisaggregazione = true;&#xD;
			var j=0;&#xD;
			&#xD;
			while(OwnerPresaAppuntamento == null &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OWNERPRESAAPPUNTAMENTO)&#xD;
				{&#xD;
					OwnerPresaAppuntamento = attr.valoreAttributo; &#xD;
					Process.auditLog(&quot;Trovato OWNERPRESAAPPUNTAMENTO: &quot;+ attr.valoreAttributo +&quot; della componente APPUNTAMENTODISAGGREGAZIONE&quot;);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PRESTAZIONIAGGIUNTIVE)&#xD;
		{&#xD;
			trovataPrestazioniAggiuntive = true;&#xD;
			var j=0;&#xD;
			&#xD;
			while(FlagPrestazioneAggiuntiva == null &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGPRESTAZIONEAGGIUNTIVA)&#xD;
				{&#xD;
					FlagPrestazioneAggiuntiva = attr.valoreAttributo; &#xD;
					Process.auditLog(&quot;Trovato FLAGPRESTAZIONEAGGIUNTIVA: &quot;+ attr.valoreAttributo +&quot; della componente PRESTAZIONIAGGIUNTIVE&quot;);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}	&#xD;
	}	&#xD;
	&#xD;
	&#xD;
	var TIPODISAGGREGAZIONE = &quot;&quot;;&#xD;
	var PRESTAZIONIAGGIUNTIVE = &quot;&quot;;&#xD;
	TIPODISAGGREGAZIONE = null;&#xD;
	PRESTAZIONIAGGIUNTIVE = null;&#xD;
	&#xD;
	var foundTIPODISAGGREGAZIONE = false;&#xD;
	var foundPRESTAZIONIAGGIUNTIVE = false;&#xD;
&#xD;
&#xD;
	//SM_9551: Ricerca del REFERENTEONFIELD&#xD;
	var foundREFERENTEONFIELD = false;&#xD;
&#xD;
	if(localRequest.ordine != null &amp;&amp; localRequest.ordine.referente != null &amp;&amp; localRequest.ordine.referente.size() > 0) &#xD;
	{	&#xD;
		for(var m=0; m&lt;localRequest.ordine.referente.size(); m++)&#xD;
		{&#xD;
			var currentreferente = localRequest.ordine.referente.get(m);&#xD;
			&#xD;
			if(currentreferente.tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTEONFIELD)&#xD;
			{&#xD;
				foundREFERENTEONFIELD = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	//Logica di arricchimento&#xD;
	if(localRequest.exDisaggregato == &quot;S&quot;)&#xD;
	{&#xD;
		TIPODISAGGREGAZIONE = &quot;OL richiesto come disaggregato ma lavorato da TIM&quot;;&#xD;
		PRESTAZIONIAGGIUNTIVE = &quot;NO&quot;;&#xD;
	}&#xD;
	else if((OwnerPresaAppuntamento != null &amp;&amp; (OwnerPresaAppuntamento == &quot;OP&quot; || OwnerPresaAppuntamento == &quot;SU&quot;))&#xD;
			|| foundREFERENTEONFIELD                        //SM_9551: aggiunta condizione sul REFERENTEONFIELD&#xD;
			|| FlagPrestazioneAggiuntiva != null)&#xD;
	{&#xD;
		TIPODISAGGREGAZIONE = &quot;OL disaggregato con prestazioni aggiuntive&quot;;&#xD;
		PRESTAZIONIAGGIUNTIVE = &quot;SI&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		TIPODISAGGREGAZIONE = &quot;OL disaggregato senza prestazioni aggiuntive&quot;;&#xD;
		PRESTAZIONIAGGIUNTIVE = &quot;NO&quot;;&#xD;
	}&#xD;
	&#xD;
&#xD;
	//ARRICCHIMENTO&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE)&#xD;
		{&#xD;
			var j=0;&#xD;
			&#xD;
			while((!foundTIPODISAGGREGAZIONE || !foundPRESTAZIONIAGGIUNTIVE) &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODISAGGREGAZIONE&#xD;
				   &amp;&amp; TIPODISAGGREGAZIONE != null)&#xD;
				{&#xD;
					foundTIPODISAGGREGAZIONE = true;&#xD;
					attr.valoreAttributo = TIPODISAGGREGAZIONE;&#xD;
					Process.auditLog(&quot;Valorizzato TIPODISAGGREGAZIONE: &quot;+ TIPODISAGGREGAZIONE +&quot; della componente DISAGGREGAZIONE&quot;);&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PRESTAZIONIAGGIUNTIVE&#xD;
						&amp;&amp; PRESTAZIONIAGGIUNTIVE != null)&#xD;
				{&#xD;
					foundPRESTAZIONIAGGIUNTIVE = true;&#xD;
					attr.valoreAttributo = PRESTAZIONIAGGIUNTIVE;&#xD;
					Process.auditLog(&quot;Valorizzato PRESTAZIONIAGGIUNTIVE: &quot;+ PRESTAZIONIAGGIUNTIVE +&quot; della componente DISAGGREGAZIONE&quot;);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
						&#xD;
			if(!foundTIPODISAGGREGAZIONE &amp;&amp; TIPODISAGGREGAZIONE != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODISAGGREGAZIONE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = TIPODISAGGREGAZIONE;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundTIPODISAGGREGAZIONE = true;&#xD;
			}&#xD;
			&#xD;
			if(!foundPRESTAZIONIAGGIUNTIVE &amp;&amp; PRESTAZIONIAGGIUNTIVE != null)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PRESTAZIONIAGGIUNTIVE;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = PRESTAZIONIAGGIUNTIVE;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				foundPRESTAZIONIAGGIUNTIVE = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
 &#xD;
} &#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
