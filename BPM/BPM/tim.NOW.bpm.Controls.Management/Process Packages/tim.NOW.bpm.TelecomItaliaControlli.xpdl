        <xpdl2:Activity Id="_cwyBkM9DEeuiTvC7jzwBcg" Name="ArricchimentoOrdineFeederSuccessivo" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Ordine FeederSuccessivo" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Aggiunto script con RU_1180&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	//CONFIGURAZIONE AZIONE&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;&#xD;
		|| componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.FEEDERSUCCESSIVO) //RU_1205&#xD;
		{&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
&#xD;
	//ARRICCHIMENTO&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		//Componente ACCESSO&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{		&#xD;
			var foundCODICEMACROAREA = false;&#xD;
			var foundIDMADRCRMWS = false;&#xD;
			var foundCODICETDKIT = false;&#xD;
			var foundABILITATOMC = false;&#xD;
			var foundIDRISORSAFEEDER = false;&#xD;
		&#xD;
		&#xD;
			//Arricchimento attributi se presenti nell'ordine&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA&#xD;
				    &amp;&amp; ConsistenzaFeeder != null &amp;&amp; ConsistenzaFeeder.codiceMacroArea != null)&#xD;
				{&#xD;
					foundCODICEMACROAREA = true;&#xD;
					attributo.valoreAttributo = ConsistenzaFeeder.codiceMacroArea;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICEMACROAREA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS&#xD;
				   &amp;&amp; ConsistenzaFeeder != null &amp;&amp; ConsistenzaFeeder.IDMadrCRMWS != null)&#xD;
				{&#xD;
					foundIDMADRCRMWS = true;&#xD;
					attributo.valoreAttributo = ConsistenzaFeeder.IDMadrCRMWS;&#xD;
					Process.auditLog(&quot;Trovato attributo IDMADRCRMWS&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT&#xD;
				        &amp;&amp; ConsistenzaFeeder != null &amp;&amp; ConsistenzaFeeder.codiceTdKit != null)&#xD;
				{&#xD;
					foundCODICETDKIT = true;&#xD;
					attributo.valoreAttributo = ConsistenzaFeeder.codiceTdKit;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICETDKIT&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ABILITATOMC)&#xD;
				{&#xD;
					foundABILITATOMC = true;&#xD;
					attributo.valoreAttributo = &quot;SI&quot;;&#xD;
					Process.auditLog(&quot;Trovato attributo ABILITATOMC&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAFEEDER&#xD;
				        &amp;&amp; ConsistenzaFeeder != null &amp;&amp; ConsistenzaFeeder.IDRisorsa != null)&#xD;
				{&#xD;
					foundIDRISORSAFEEDER = true;&#xD;
					attributo.valoreAttributo = ConsistenzaFeeder.IDRisorsa;&#xD;
					Process.auditLog(&quot;Trovato attributo IDRISORSAFEEDER&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
&#xD;
			//Creo attributi se non presenti nell'ordine&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = ora;&#xD;
			attributo.lastUpdate = ora;&#xD;
			attributo.operatore = componente.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
&#xD;
			if(!foundCODICEMACROAREA &amp;&amp; ConsistenzaFeeder != null &amp;&amp; ConsistenzaFeeder.codiceMacroArea != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA;&#xD;
				attributo.valoreAttributo = ConsistenzaFeeder.codiceMacroArea;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo CODICEMACROAREA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
&#xD;
			if(!foundIDMADRCRMWS &amp;&amp; ConsistenzaFeeder != null &amp;&amp; ConsistenzaFeeder.IDMadrCRMWS != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS;&#xD;
				attributo.valoreAttributo = ConsistenzaFeeder.IDMadrCRMWS;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo IDMADRCRMWS&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			if(!foundCODICETDKIT &amp;&amp; ConsistenzaFeeder != null &amp;&amp; ConsistenzaFeeder.codiceTdKit != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT;&#xD;
				attributo.valoreAttributo = ConsistenzaFeeder.codiceTdKit;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo CODICETDKIT&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			if(!foundABILITATOMC)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ABILITATOMC;&#xD;
				attributo.valoreAttributo = &quot;SI&quot;;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo ABILITATOMC&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			if(!foundIDRISORSAFEEDER &amp;&amp; ConsistenzaFeeder != null &amp;&amp; ConsistenzaFeeder.IDRisorsa != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAFEEDER;&#xD;
				attributo.valoreAttributo = ConsistenzaFeeder.IDRisorsa;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo IDRISORSAFEEDER&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="90.0" LaneId="_0EugAc0QEeu34e6uXeS8kw" Width="157.0">
              <xpdl2:Coordinates XCoordinate="1549.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_p-A34s9DEeuiTvC7jzwBcg" Name="ArricchimentoOrdinePrimoFeeder" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Ordine PrimoFeeder" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//LOG PER CHECK SU LAVORAZIONERICHIESTA&#xD;
if(LavorazioneRichiesta != null)&#xD;
{&#xD;
	Process.auditLog(&quot;CODICEMACROAREA: &quot; + LavorazioneRichiesta.codiceMacroArea + &quot;; IDMADRCRMWS: &quot; + LavorazioneRichiesta.idMadrCrmws + &quot;; NOMECLLI: &quot; + LavorazioneRichiesta.nomeClli + &quot;; TIPOOFFERTA: &quot; + LavorazioneRichiesta.tipoOfferta + &quot;; SOTTOLAVORAZIONE: &quot; + LavorazioneRichiesta.sottoLavorazione);&#xD;
}&#xD;
&#xD;
//Aggiunto script con RU_1180&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	//CONFIGURAZIONE AZIONE&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;&#xD;
		   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVLANMULTICAST&#xD;
		   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
		{&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
&#xD;
	//ARRICCHIMENTO&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		//Componente ACCESSO&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{		&#xD;
			var foundCODICEMACROAREA = false;&#xD;
			var foundIDMADRCRMWS = false;&#xD;
			var foundNOMEBOUQUET = false;&#xD;
			&#xD;
			//Arricchimento attributi se presenti nell'ordine&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA&#xD;
				    &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceMacroArea != null)&#xD;
				{&#xD;
					foundCODICEMACROAREA = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.codiceMacroArea;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICEMACROAREA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS&#xD;
				   &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.idMadrCrmws != null)&#xD;
				{&#xD;
					foundIDMADRCRMWS = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.idMadrCrmws;&#xD;
					Process.auditLog(&quot;Trovato attributo IDMADRCRMWS&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEBOUQUET&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.nomeBouquet != null)&#xD;
				{&#xD;
					foundNOMEBOUQUET = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.nomeBouquet;&#xD;
					Process.auditLog(&quot;Trovato attributo NOMEBOUQUET&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
&#xD;
			//Creo attributi se non presenti nell'ordine&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = ora;&#xD;
			attributo.lastUpdate = ora;&#xD;
			attributo.operatore = componente.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
&#xD;
			if(!foundCODICEMACROAREA &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceMacroArea != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.codiceMacroArea;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo CODICEMACROAREA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
&#xD;
			if(!foundIDMADRCRMWS &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.idMadrCrmws != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.idMadrCrmws;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo IDMADRCRMWS&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			if(!foundNOMEBOUQUET &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.nomeBouquet != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEBOUQUET;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.nomeBouquet;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo NOMEBOUQUET&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//Componente RACCOLTAVLANMULTCAST&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVLANMULTICAST)&#xD;
		{&#xD;
			var foundNOMECLLI = false;&#xD;
			var foundCODICEMACROAREA = false;&#xD;
			var foundTIPOOFFERTA = false;&#xD;
			var foundIDMADRCRMWS = false;&#xD;
			&#xD;
			//Arricchimento attributi se presenti nell'ordine&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMECLLI&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.nomeClli != null)&#xD;
				{&#xD;
					foundNOMECLLI = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.nomeClli;&#xD;
					Process.auditLog(&quot;Trovato attributo NOMECLLI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceMacroArea != null)&#xD;
				{&#xD;
					foundCODICEMACROAREA = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.codiceMacroArea;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICEMACROAREA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOOFFERTA&#xD;
				        &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.tipoOfferta != null)&#xD;
				{&#xD;
					foundTIPOOFFERTA = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.tipoOfferta;&#xD;
					Process.auditLog(&quot;Trovato attributo TIPOOFFERTA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS&#xD;
				   &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.idMadrCrmws != null)&#xD;
				{&#xD;
					foundIDMADRCRMWS = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.idMadrCrmws;&#xD;
					Process.auditLog(&quot;Trovato attributo IDMADRCRMWS&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//Creo attributi se non presenti nell'ordine&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = ora;&#xD;
			attributo.lastUpdate = ora;&#xD;
			attributo.operatore = componente.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			&#xD;
			if(!foundNOMECLLI &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.nomeClli != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMECLLI;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.nomeClli;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo NOMECLLI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			if(!foundCODICEMACROAREA &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceMacroArea != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.codiceMacroArea;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo CODICEMACROAREA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			if(!foundTIPOOFFERTA &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.tipoOfferta != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOOFFERTA;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.tipoOfferta;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo TIPOOFFERTA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			if(!foundIDMADRCRMWS &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.idMadrCrmws != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.idMadrCrmws;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo IDMADRCRMWS&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
