        <xpdl2:Activity Id="_KCc5QhB1Eeyx1J_VnXlGew" Name="ArricchimentoDettaglioOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Script inserito con RU_1203&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	//CONFIGURAZIONE AZIONE&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			//ATTIVAZIONE NPNG con sottolav PORTABILITASUCCESSIVA -> va trattata come una Variazione&#xD;
			if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PORTABILITASUCCESSIVA)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;   &#xD;
			}&#xD;
			//ATTIVAZIONE NPNG con sottolav NORMALE -> va trattata come una normale Attivazione&#xD;
			else&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;  &#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//ARRICCHIMENTO&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		//Componente ACCESSO&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{		&#xD;
			var foundUO = false;&#xD;
			var foundTIPOMOVIMENTAZIONE = false;&#xD;
			var foundCODICEULTIMAFATTURA = false;&#xD;
			var foundCODICEPENULTIMAFATTURA = false;&#xD;
&#xD;
&#xD;
			//Arricchimento attributi se presenti nell'ordine&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.UO&#xD;
				   &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.UO != null)&#xD;
				{&#xD;
					foundUO = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.UO;&#xD;
					Process.auditLog(&quot;Trovato attributo UO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOMOVIMENTAZIONE&#xD;
				   &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.tipoMovimentazione != null)&#xD;
				{&#xD;
					foundTIPOMOVIMENTAZIONE = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.tipoMovimentazione;&#xD;
					Process.auditLog(&quot;Trovato attributo TIPOMOVIMENTAZIONE&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEULTIMAFATTURA&#xD;
						&amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceUltimaFattura != null)&#xD;
				{&#xD;
					foundCODICEULTIMAFATTURA = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.codiceUltimaFattura;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICEULTIMAFATTURA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPENULTIMAFATTURA&#xD;
						&amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codicePenultimaFattura != null)&#xD;
				{&#xD;
					foundCODICEPENULTIMAFATTURA = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.codicePenultimaFattura;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICEPENULTIMAFATTURA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}	&#xD;
			}&#xD;
&#xD;
			//Creo attributi se non presenti nell'ordine&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = ora;&#xD;
			attributo.lastUpdate = ora;&#xD;
			attributo.operatore = componente.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
&#xD;
			if(!foundUO &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.UO != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.UO;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.UO;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo UO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
&#xD;
			if(!foundTIPOMOVIMENTAZIONE &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.tipoMovimentazione != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOMOVIMENTAZIONE;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.tipoMovimentazione;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo TIPOMOVIMENTAZIONE&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			if(!foundCODICEULTIMAFATTURA &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceUltimaFattura != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEULTIMAFATTURA;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.codiceUltimaFattura;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo CODICEULTIMAFATTURA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			if(!foundCODICEPENULTIMAFATTURA &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codicePenultimaFattura != null)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPENULTIMAFATTURA;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.codicePenultimaFattura;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo CODICEPENULTIMAFATTURA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}			&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//SM_10459&#xD;
	if(localRequest.numeroTelefonico != null &amp;&amp; localRequest.numeroTelefonico != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordine.distretto = localRequest.numeroTelefonico.slice(0,3);&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="93.0" LaneId="_TCLfQRBzEeyx1J_VnXlGew" Width="133.0">
              <xpdl2:Coordinates XCoordinate="2161.0" YCoordinate="507.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
