        <xpdl2:Activity Id="_MYeOALf0Eeet0ppHnI5jAQ" Name="RecuperoAsset" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupero Asset">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var idAsset = &quot;&quot;;&#xD;
idAsset = null;&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
if (String(localRequest.offerta).slice(0,3)== &quot;SHA&quot;)&#xD;
{&#xD;
	while(idAsset == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
		{&#xD;
	 		var j = 0;&#xD;
			while(idAsset == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
		&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					idAsset = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			j++;&#xD;
			}&#xD;
	 &#xD;
		}&#xD;
	i++;&#xD;
	}&#xD;
}&#xD;
	&#xD;
	&#xD;
else &#xD;
{&#xD;
	while(idAsset == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA ||&#xD;
			   currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(idAsset == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
					{&#xD;
						idAsset = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
				j++;&#xD;
				}&#xD;
		&#xD;
			}&#xD;
		i++;&#xD;
		}&#xD;
}&#xD;
&#xD;
if(idAsset != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(idAsset));&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
