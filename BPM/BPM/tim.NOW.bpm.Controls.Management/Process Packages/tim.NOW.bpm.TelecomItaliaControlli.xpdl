        <xpdl2:Activity Id="_YE2zELV3EeeP7LPxhQQYgg" Name="ValorizzazioneCostanti" xpdExt:Visibility="Private" xpdExt:DisplayName="Valorizzazione Costanti">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">listaAttributiOrdine_CONS = DataUtil.createList();&#xD;
listaComponenti_CONS = DataUtil.createList();&#xD;
listaDaAggiornare_CONS  = DataUtil.createList();&#xD;
listaDaAggiungere_CONS  = DataUtil.createList();&#xD;
listaValoriAsset_CONS = DataUtil.createList();&#xD;
listaValoriOrdine_CONS = DataUtil.createList();&#xD;
listaDaEliminare_CONS  = DataUtil.createList();&#xD;
listaAttributiSPLITTER_CONS = DataUtil.createList();&#xD;
listaAttributiMODEM_CONS = DataUtil.createList();&#xD;
listaDaSovrascrivere_CONS = DataUtil.createList();&#xD;
listaAttributiPROTOCOLLO_CONS = DataUtil.createList();&#xD;
&#xD;
&#xD;
//Modifica per segnalazione Variazioni dati Bitstream ATM Asimmetrico Flat (E) EVO C10. Viene verificato se c'è un VC in decremento&#xD;
var decremento = false;&#xD;
&#xD;
for (var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if (currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
			&amp;&amp; currentDettaglioOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
			{&#xD;
				decremento = true;&#xD;
			} &#xD;
	}&#xD;
&#xD;
//BITSTREAMATMASIMMETRICOFLAT&#xD;
if(localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
	||localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
	|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE)&#xD;
	{&#xD;
		//ATMVC&#xD;
		if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &amp;&amp; decremento == false){&#xD;
			listaComponenti_CONS.add(&quot;ATMVC&quot;);&#xD;
			listaAttributiOrdine_CONS.add(&quot;VPI&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;VCI&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;TIPOPROFILOVC&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;MCRDOWN&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;MCRUP&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;PCRDOWN&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;PCRUP&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;SCRDOWN&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;SCRUP&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;TIPOBANDACONSEGNA&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;CODICEVP&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;CODICETD&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;IDPROFILOVC&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;RICHIESTAMONITORAGGIO&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;TRASPORTO&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;IDRISORSAVC&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(true);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
		}&#xD;
		else{&#xD;
			listaComponenti_CONS.add(&quot;ATMVC&quot;);&#xD;
			listaAttributiOrdine_CONS.add(&quot;VPI&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;VCI&quot;);listaDaAggiornare_CONS.add(false);listaDaAggiungere_CONS.add(false);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
			listaAttributiOrdine_CONS.add(&quot;TIPOPROFILOVC&quot;);listaDaAggiornare_CONS.add(true);listaDaAggiungere_CONS.add(true);listaValoriAsset_CONS.add(&quot;&quot;);listaValoriOrdine_CONS.add(&quot;&quot;);listaDaEliminare_CONS.add(false);listaDaSovrascrivere_CONS.add(false);&#xD;
