ProfiloTecnicoLinea = null;&#xD;
&#xD;
var i=0;&#xD;
while (ProfiloTecnicoLinea== null &amp;&amp; i&lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
&#xD;
	var currentDettaglio = localRequest.ordine.dettaglioordine.get(i);&#xD;
