		componenteTemp.IDDettaglioOrdineParent = 1;&#xD;
		componenteTemp.IDDettaglioOrdineRoot = 1;&#xD;
		componenteTemp.operatore = &quot;BPM&quot;;&#xD;
		componenteTemp.created = data;&#xD;
		componenteTemp.lastUpdate = data;&#xD;
		componenteTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
		componenteTemp.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() +1;&#xD;
		componenteTemp.nomeComponente = componenteAsset.nomeComponente;&#xD;
		componenteTemp.integrationID = localRequest.IDRichiestaOLO + componenteTemp.IDDettaglioOrdine;&#xD;
		//conta MODEM&#xD;
		var contaPROTOCOLLO =0;&#xD;
		for(var n=0; n&lt;localRequest.ordine.dettaglioordine.size();n++){&#xD;
			if(localRequest.ordine.dettaglioordine.get(n).nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PROTOCOLLO){&#xD;
				contaPROTOCOLLO++;&#xD;
			}&#xD;
		}&#xD;
		componenteTemp.progressivo = contaPROTOCOLLO+1;&#xD;
		&#xD;
		var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
		attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		attributo.created = data;&#xD;
		attributo.lastUpdate =data;&#xD;
		attributo.operatore = &quot;BPM&quot;;&#xD;
		attributo.IDDettaglioOrdine = componenteTemp.IDDettaglioOrdine;&#xD;
		attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		&#xD;
		for(var k=0; k&lt;componenteAsset.attributidettaglioasset.size(); k++){&#xD;
			var attributoAsset = componenteAsset.attributidettaglioasset.get(k);&#xD;
			if(listaAttributiPROTOCOLLO.contains(String(attributoAsset.nomeAttributo))){&#xD;
				attributo.nomeAttributo = attributoAsset.nomeAttributo;&#xD;
				attributo.valoreAttributo = attributoAsset.valoreAttributo;&#xD;
				componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
		}&#xD;
		if(componenteTemp.attributiDettaglioOrdine.size()>0){&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componenteTemp));&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Componente MODEM in asset non aggiunto a causa della mancanza degli attributi previsti&quot;);&#xD;
		}&#xD;
	}&#xD;
	}	&#xD;
}&#xD;
&#xD;
//Gestione Azioni su VC e VLAN e IDRISORSAVC/IDRISORSAUSERVLAN per componenti con azione A&#xD;
for(var i=0 ; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var dettaglioTemp = localRequest.ordine.dettaglioordine.get(i);&#xD;
	if(dettaglioTemp.azione == null){&#xD;
		if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
			&amp;&amp; (dettaglioTemp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC || dettaglioTemp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || dettaglioTemp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)){&#xD;
				localRequest.ordine.dettaglioordine.get(i).azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
			}&#xD;
			else{&#xD;
				localRequest.ordine.dettaglioordine.get(i).azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
		}	&#xD;
	}&#xD;
	//SM_8609 aggiunta nella condizione la tipologiaSottoLav VARIAZIONETAGGING.&#xD;
	if((localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC || localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING)&#xD;
		&amp;&amp; (listaAttributiOrdine.contains(&quot;IDRISORSAVC&quot;) || listaAttributiOrdine.contains(&quot;IDRISORSAUSERVLAN&quot;))&#xD;
		&amp;&amp; dettaglioTemp.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
	{&#xD;
		var attrtemp = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
		attrtemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		attrtemp.created = data;&#xD;
		attrtemp.lastUpdate = data;&#xD;
		attrtemp.operatore = &quot;BPM&quot;;&#xD;
		attrtemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		&#xD;
		attrtemp.IDDettaglioOrdine = dettaglioTemp.IDDettaglioOrdine;&#xD;
		if(listaAttributiOrdine.contains(&quot;IDRISORSAVC&quot;))&#xD;
		{&#xD;
			attrtemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAVC;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			attrtemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAUSERVLAN;&#xD;
		}&#xD;
		IDRISORSAVCMax++;&#xD;
		var idr = IDRISORSAVCMax.toString();&#xD;
		if(idr.length==1)&#xD;
		{&#xD;
			idr = &quot;000&quot;+idr;&#xD;
		}&#xD;
		else if(idr.length==2)&#xD;
		{&#xD;
			idr = &quot;00&quot;+idr;&#xD;
		}&#xD;
		else if(idr.length==3)&#xD;
		{&#xD;
			idr = &quot;0&quot;+idr;&#xD;
		}&#xD;
		attrtemp.valoreAttributo = localRequest.ordine.IDRisorsa+&quot;/&quot;+idr;&#xD;
		dettaglioTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attrtemp));&#xD;
		Process.auditLog(&quot;Arrichito attributo IDRISORSAVC/IDRISORSAUSERVLAN per componenti con azione A&quot;);&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
