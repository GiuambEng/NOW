        <xpdl2:Activity Id="_dGTm0ipmEee3gaJ5qPn7rw" Name="arricchimentodettaglioordine" xpdExt:Visibility="Private" xpdExt:DisplayName="arricchimento dettaglio ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var listaAttributiAccessoULL = DataUtil.createList();&#xD;
var listaAttributiAccessoULLDATI = DataUtil.createList();&#xD;
var listaAttributiAccessoSLU = DataUtil.createList();&#xD;
&#xD;
//Attributi ammissibili per offerte ULL&#xD;
listaAttributiAccessoULL.add(&quot;INDICATOREDISCAFFALE&quot;);&#xD;
listaAttributiAccessoULL.add(&quot;INDICATOREDIASSURANCE&quot;);&#xD;
listaAttributiAccessoULL.add(&quot;PERMUTATORE1&quot;);&#xD;
listaAttributiAccessoULL.add(&quot;PERMUTATORE2&quot;);&#xD;
listaAttributiAccessoULL.add(&quot;DESTINAZIONEUSO&quot;);&#xD;
listaAttributiAccessoULL.add(&quot;BITRATE&quot;);&#xD;
listaAttributiAccessoULL.add(&quot;IDULLCO&quot;);&#xD;
listaAttributiAccessoULL.add(&quot;CAPOSTIPITE&quot;);&#xD;
listaAttributiAccessoULL.add(&quot;QUANTITALINEE&quot;);&#xD;
listaAttributiAccessoULL.add(&quot;TIPOLINEA&quot;);&#xD;
listaAttributiAccessoULL.add(&quot;STRUTTURALINEA&quot;);&#xD;
listaAttributiAccessoULL.add(&quot;IDRISORSAORIGINARIO&quot;);&#xD;
listaAttributiAccessoULL.add(&quot;CAMPOSERVIZIOIT&quot;);&#xD;
listaAttributiAccessoULL.add(&quot;FATTURAZIONELA&quot;);&#xD;
&#xD;
//Attributi ammissibili per offerte ULLDATI&#xD;
listaAttributiAccessoULLDATI.add(&quot;INDICATOREDISCAFFALE&quot;);&#xD;
listaAttributiAccessoULLDATI.add(&quot;INDICATOREDIASSURANCE&quot;);&#xD;
listaAttributiAccessoULLDATI.add(&quot;PERMUTATORE1&quot;);&#xD;
listaAttributiAccessoULLDATI.add(&quot;PERMUTATORE2&quot;);&#xD;
listaAttributiAccessoULLDATI.add(&quot;DESTINAZIONEUSO&quot;);&#xD;
listaAttributiAccessoULLDATI.add(&quot;BITRATE&quot;);&#xD;
listaAttributiAccessoULLDATI.add(&quot;IDULLCO&quot;);&#xD;
listaAttributiAccessoULLDATI.add(&quot;IDRISORSAORIGINARIO&quot;);&#xD;
listaAttributiAccessoULLDATI.add(&quot;CAPOSTIPITE&quot;);&#xD;
listaAttributiAccessoULLDATI.add(&quot;QUANTITALINEE&quot;);&#xD;
listaAttributiAccessoULLDATI.add(&quot;TIPOLINEA&quot;);&#xD;
listaAttributiAccessoULLDATI.add(&quot;STRUTTURALINEA&quot;);&#xD;
listaAttributiAccessoULLDATI.add(&quot;CAMPOSERVIZIOIT&quot;);&#xD;
listaAttributiAccessoULLDATI.add(&quot;FATTURAZIONELA&quot;);&#xD;
&#xD;
//Attributi ammissibili per offerte SLU&#xD;
listaAttributiAccessoSLU.add(&quot;DESTINAZIONEUSO&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;BITRATE&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;IDARLOLO&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;POSIZIONEARLOLO1&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;POSIZIONEARLOLO2&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;POSIZIONEARLTI1&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;POSIZIONEARLTI2&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;IDSLUCO&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;IDRISORSAORIGINARIO&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;CAPOSTIPITE&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;QUANTITALINEE&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;TIPOLINEA&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;STRUTTURALINEA&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;CAMPOSERVIZIOIT&quot;);&#xD;
listaAttributiAccessoSLU.add(&quot;FATTURAZIONELA&quot;);&#xD;
&#xD;
var idAsset = 0;&#xD;
idAsset = null;&#xD;
var idRisorsaConsistenza = &quot;&quot;;&#xD;
idRisorsaConsistenza = null;&#xD;
var tipoLinea = &quot;&quot;;&#xD;
tipoLinea = null;&#xD;
GeneraIDRisorsa = false;&#xD;
&#xD;
var consistenza = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
consistenza = null;&#xD;
&#xD;
esitoCheckCalcoloRemoteID = false; //RU_966;&#xD;
&#xD;
// Recupera ID Asset &#xD;
// Aggiunta RU_966: recupero di INTERMEDIATEAGENTFULL dalla componente ACCESSO&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI&#xD;
	   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA&#xD;
	   ||((localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot; || localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;)        //RU_966&#xD;
          &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
              || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
              || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
              || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
			  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT) //RU_982: aggiunta offerta BITSTREAMGBEASIMMETRICOFLAT&#xD;
		  &amp;&amp; String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;))&#xD;
	{&#xD;
		var j=0;&#xD;
		while((!esitoCheckCalcoloRemoteID || idAsset == null || idRisorsaConsistenza == null) &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			if(componente.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				consistenza = ScriptUtil.copy(componente);&#xD;
				idAssetOut = componente.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
				idAsset = ScriptUtil.createBigInteger(idAssetOut);&#xD;
			}&#xD;
			else if(componente.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
			{&#xD;
				idRisorsaConsistenza = componente.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
			}&#xD;
			else if(componente.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INTERMEDIATEAGENTFULL&#xD;
			        &amp;&amp; componente.attributiDettaglioOrdine.get(j).valoreAttributo == &quot;SI&quot;) //RU_966&#xD;
			{&#xD;
				esitoCheckCalcoloRemoteID = true;&#xD;
				Process.auditLog(&quot;IntermediateAgent dell'accesso a SI, calcolare remote ID&quot;);&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}	&#xD;
	}&#xD;
}&#xD;
&#xD;
// Rimuovi componente Consistenza&#xD;
localRequest.ordine.dettaglioordine.clear();&#xD;
&#xD;
// Recupera Asset&#xD;
if(idAsset!= null)&#xD;
{&#xD;
	//SM_11135: aggiunto codice TCOND_NAKED&#xD;
	if(localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot; || localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot;) // Task allineamento BDS_1_CASEDATA_ASSETTARGET su Autoindotti - C05 2019&#xD;
	{&#xD;
		var assetTarget = it_telecomitalia_it_NOW_casedata_Factory.createAssetTarget();&#xD;
&#xD;
		assetTarget.IDAsset = idAsset;&#xD;
		assetTarget.flagInLavorazione = true;&#xD;
&#xD;
		localRequest.assetTarget.add(assetTarget);&#xD;
		Process.auditLog(&quot;Aggiunto Asset Target con ID &quot;+assetTarget.IDAsset);	&#xD;
	}&#xD;
&#xD;
	&#xD;
	var data = DateTimeUtil.createDatetime();&#xD;
	Process.auditLog(&quot;IDENTIFICATIVOASSET: &quot;+idAsset);&#xD;
			&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	attributo.created = data;&#xD;
	attributo.lastUpdate = data;&#xD;
	attributo.operatore = &quot;BPM&quot;;&#xD;
	&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(idAsset);&#xD;
	&#xD;
	var tipoLineaAsset = &quot;&quot;;&#xD;
	tipoLineaAsset = null;&#xD;
&#xD;
	Asset = AssetRef.readAsset();&#xD;
	&#xD;
	// C02M35F05 ----------- Aggiorna TipoLinea e IDRisorsa -----------&#xD;
	&#xD;
	if(Asset != null)&#xD;
	{	&#xD;
		i=0;&#xD;
		while(tipoLineaAsset == null &amp;&amp; i &lt; Asset.dettaglioasset.size())&#xD;
		{&#xD;
			var comp = Asset.dettaglioasset.get(i);&#xD;
			if(String(comp.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j=0;&#xD;
				while(tipoLineaAsset == null &amp;&amp; j &lt; comp.attributidettaglioasset.size())&#xD;
				{&#xD;
					if(comp.attributidettaglioasset.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						tipoLineaAsset = comp.attributidettaglioasset.get(j).valoreAttributo;&#xD;
						Process.auditLog(&quot;tipoLineaAsset recuperato: &quot;+tipoLineaAsset);&#xD;
					}&#xD;
					&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}	&#xD;
	&#xD;
	// In caso di TNAKED_COND uso il TipoLineaFonia che mi sono passato dentro l'ordine perché non ho la CONSISTENZAFONIA qui&#xD;
	if(localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;)&#xD;
	{&#xD;
		tipoLineaAsset = String(localRequest.ordine.tipologiaLinea);&#xD;
	}&#xD;
	&#xD;
	if(tipoLineaAsset!= null)&#xD;
	{&#xD;
		tipoLinea = tipoLineaAsset;&#xD;
		localRequest.ordine.tipologiaLinea = it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.get(tipoLinea.toUpperCase());&#xD;
		&#xD;
		if(localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;)&#xD;
		{&#xD;
			if(tipoLineaAsset == &quot;POTS&quot;)&#xD;
			{	&#xD;
				GeneraIDRisorsa=true;&#xD;
				&#xD;
				localRequest.flagNaked = null; // SM_8325&#xD;
			}&#xD;
			else if(tipoLineaAsset == &quot;ISDN&quot;)&#xD;
			{&#xD;
				localRequest.flagNaked = null; // SM_8325&#xD;
			}&#xD;
		}&#xD;
		else if(localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot;)&#xD;
		{&#xD;
			if(tipoLineaAsset == &quot;ISDN&quot;)&#xD;
			{&#xD;
				localRequest.ordine.tipologiaLinea = it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.LINEANONFONIA;&#xD;
				tipoLinea = &quot;LineaNonFonia&quot;;&#xD;
				&#xD;
				localRequest.flagNaked = 'S'; // SM_8325&#xD;
			}&#xD;
			else if(tipoLineaAsset == &quot;POTS&quot;)&#xD;
			{&#xD;
				localRequest.ordine.tipologiaLinea = it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.LINEANONFONIA;&#xD;
				GeneraIDRisorsa=true;&#xD;
				tipoLinea = &quot;LineaNonFonia&quot;;&#xD;
				&#xD;
				// SM_8325&#xD;
				localRequest.flagNaked = 'S';&#xD;
				localRequest.ordine.numeroTelefonico = null;&#xD;
			}&#xD;
		}&#xD;
		else if(localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;)&#xD;
		{&#xD;
				GeneraIDRisorsa=true;&#xD;
				&#xD;
				localRequest.ordine.numeroTelefonico = null; // SM_8325	&#xD;
		}&#xD;
	}	&#xD;
	if(localRequest.codiceTrasformazione == &quot;TBUNDLE&quot;)&#xD;
	{&#xD;
		GeneraIDRisorsa = true;&#xD;
	}&#xD;
	&#xD;
	//FINE -------------C02M35F05 – Aggiorna TipoLinea e IDRisorsa---------------------&#xD;
	&#xD;
	var data = DateTimeUtil.createDatetime();	&#xD;
	var idDettaglioOrdine = 2;&#xD;
	&#xD;
	//---- TNAKED_COND --- TCOND_NAKED -----&#xD;
	//Componente Accesso&#xD;
	for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
	{					&#xD;
		var assetComp = Asset.dettaglioasset.get(i);&#xD;
		if(String(assetComp.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			Process.auditLog(&quot;ACCESSO trovato: &quot;+assetComp.nomeComponente);&#xD;
			&#xD;
			var componenteTemp = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			componenteTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			componenteTemp.created = data;&#xD;
			componenteTemp.lastUpdate = data;&#xD;
			componenteTemp.operatore = &quot;BPM&quot;;&#xD;
			componenteTemp.IDDettaglioOrdine = 1;&#xD;
			componenteTemp.integrationID = localRequest.IDRichiestaOLO+componenteTemp.IDDettaglioOrdine;&#xD;
			&#xD;
			// SM_8325 - in una TSHA_ULLD l'accesso da creare è ACCESSOULLD a partire dall'asset&#xD;
			if(localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;)&#xD;
			{&#xD;
				componenteTemp.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULLDATI;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				componenteTemp.nomeComponente = assetComp.nomeComponente;&#xD;
			}&#xD;
			&#xD;
			componenteTemp.progressivo = 1;&#xD;
						&#xD;
			attributo.IDDettaglioOrdine = componenteTemp.IDDettaglioOrdine;&#xD;
			&#xD;
			var TECNOLOGIADELIVERYTrovatoInAsset = false;&#xD;
			var FATTURAZIONELATrovatoInAsset = false;&#xD;
			&#xD;
			&#xD;
			for(var j=0; j&lt;assetComp.attributidettaglioasset.size(); j++)&#xD;
			{	&#xD;
				var assetAttr = assetComp.attributidettaglioasset.get(j);&#xD;
				attributo.nomeAttributo = assetAttr.nomeAttributo;&#xD;
				attributo.tipologiaDato = assetAttr.tipologiaDato;&#xD;
				attributo.valoreAttributo = null;&#xD;
				attributo.valoreAttributoOLD = null;&#xD;
&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURAZIONELA)&#xD;
				{&#xD;
					FATTURAZIONELATrovatoInAsset = true;&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					attributo.valoreAttributo = tipoLinea;&#xD;
					if(tipoLineaAsset!=null &amp;&amp; tipoLineaAsset!=&quot;&quot; &amp;&amp; localRequest.codiceTrasformazione==&quot;TCOND_NAKED&quot;)&#xD;
					{&#xD;
						attributo.valoreAttributoOLD = tipoLineaAsset;&#xD;
					}&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					//RU_685 - SF 5.71&#xD;
					if((localRequest.codiceTrasformazione == &quot;CBTSATMSIMM&quot; || localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;) &amp;&amp; //RU_1109: aggiunto CCAMBIOTECNOLOGIA&#xD;
					   (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIADELIVERY ||&#xD;
					    attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIA))&#xD;
					{&#xD;
						// valorizza ATTRIBUTO TECNOLOGIA con TECNOLOGIADELIVERY dell'asset se c'è, altrimenti con TECNOLOGIA&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIADELIVERY &amp;&amp; assetAttr.valoreAttributo != null)&#xD;
						{&#xD;
							attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIA;&#xD;
							attributo.valoreAttributo = assetAttr.valoreAttributo;&#xD;
							TECNOLOGIADELIVERYTrovatoInAsset = true;&#xD;
						}&#xD;
						else if(TECNOLOGIADELIVERYTrovatoInAsset == false &amp;&amp; attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIA)&#xD;
						{&#xD;
							attributo.valoreAttributo = assetAttr.valoreAttributo;&#xD;
						}&#xD;
					}&#xD;
					else if(localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot; || (localRequest.codiceTrasformazione==&quot;TCOND_NAKED&quot; &amp;&amp; tipoLineaAsset == &quot;POTS&quot;)) // SM_8325 + SM_8570 e SM_8574&#xD;
					{&#xD;
						if((listaAttributiAccessoULLDATI.contains(String(attributo.nomeAttributo)) ||  localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot;)&#xD;
							&amp;&amp; assetAttr.nomeAttributo != it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
						{&#xD;
							attributo.valoreAttributo = assetAttr.valoreAttributo;&#xD;
						}&#xD;
					}&#xD;
					else if(localRequest.codiceTrasformazione == &quot;TBUNDLE&quot;)&#xD;
					{&#xD;
						if(((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA &#xD;
						|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA) &amp;&amp; listaAttributiAccessoULLDATI.contains(String(attributo.nomeAttributo)))&#xD;
						|| ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA &#xD;
						|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA) &amp;&amp; listaAttributiAccessoULL.contains(String(attributo.nomeAttributo)))&#xD;
						|| ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA &#xD;
						|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA) &amp;&amp; listaAttributiAccessoSLU.contains(String(attributo.nomeAttributo))))&#xD;
						{&#xD;
							if(attributo.nomeAttributo != it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSTIPITE) // SM_9076 - CAPOSTIPITE in caso di TBUNDLE non va messo nell'ACCESSO&#xD;
							{&#xD;
								attributo.valoreAttributo = assetAttr.valoreAttributo;&#xD;
							}&#xD;
	   &#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PERMUTATORE1)&#xD;
							{&#xD;
								attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEPERMUTATORE1;&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PERMUTATORE2)&#xD;
							{&#xD;
								attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEPERMUTATORE2;&#xD;
							}&#xD;
						}					&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						attributo.valoreAttributo = assetAttr.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
				if(attributo.valoreAttributo != null &amp;&amp; attributo.valoreAttributo != &quot;&quot;)&#xD;
				{&#xD;
					componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					Process.auditLog(&quot;attributo &quot;+attributo.nomeAttributo+&quot; non inserito in quanto il valore non è presente&quot;);&#xD;
				}&#xD;
			}&#xD;
			//Aggiungo FATTURAZIONELA se non trovato&#xD;
			if(!FATTURAZIONELATrovatoInAsset &amp;&amp; (localRequest.codiceTrasformazione == &quot;TBUNDLE&quot; || localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;))&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURAZIONELA;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.CHAR;&#xD;
				attributo.valoreAttributo = &quot;N&quot;;&#xD;
				componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
			//RU_685 - SF 5.71&#xD;
			if(localRequest.codiceTrasformazione == &quot;CBTSATMSIMM&quot;&#xD;
			|| localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;) //RU_1109&#xD;
			{&#xD;
				componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				if(GeneraIDRisorsa || localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot; || localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot; || localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;) // SM_8325&#xD;
				{&#xD;
					componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
				}&#xD;
			}&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componenteTemp));&#xD;
		}&#xD;
		else if((&#xD;
			localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot; &#xD;
		 || localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot; &#xD;
		 || localRequest.codiceTrasformazione == &quot;CBTSATMSIMM&quot;&#xD;
		 || localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;) //RU_1109&#xD;
					&amp;&amp;&#xD;
					(assetComp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
					|| assetComp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC&#xD;
					|| assetComp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
					&amp;&amp;&#xD;
					assetComp.statoDettaglioAsset == &quot;ATTIVO&quot;)  //Prop Bug #30638&#xD;
		{&#xD;
			var componenteTemp = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			componenteTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			componenteTemp.created = data;&#xD;
			componenteTemp.lastUpdate = data;&#xD;
			componenteTemp.operatore = &quot;BPM&quot;;&#xD;
			componenteTemp.IDDettaglioOrdine = idDettaglioOrdine;&#xD;
			componenteTemp.integrationID = localRequest.IDRichiestaOLO+componenteTemp.IDDettaglioOrdine;&#xD;
			componenteTemp.nomeComponente = assetComp.nomeComponente;&#xD;
			componenteTemp.progressivo = assetComp.progressivo;&#xD;
			componenteTemp.IDDettaglioOrdineParent = 1;&#xD;
			componenteTemp.IDDettaglioOrdineRoot = 1;&#xD;
			&#xD;
			attributo.IDDettaglioOrdine = componenteTemp.IDDettaglioOrdine;&#xD;
			&#xD;
			for(var j=0; j&lt;assetComp.attributidettaglioasset.size(); j++)&#xD;
			{	&#xD;
				var assetAttr = assetComp.attributidettaglioasset.get(j);&#xD;
				attributo.nomeAttributo = assetAttr.nomeAttributo;&#xD;
				attributo.tipologiaDato = assetAttr.tipologiaDato;&#xD;
				attributo.valoreAttributo = assetAttr.valoreAttributo;&#xD;
				&#xD;
				componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			&#xD;
			//RU_685 - SF 5.71&#xD;
			if(localRequest.codiceTrasformazione == &quot;CBTSATMSIMM&quot;&#xD;
			|| localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;) //RU_1109&#xD;
			{&#xD;
				componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				if(GeneraIDRisorsa || localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot; || localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;)&#xD;
				{&#xD;
					componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
				}&#xD;
			}	&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componenteTemp));&#xD;
			idDettaglioOrdine++;&#xD;
		}&#xD;
		else if((localRequest.codiceTrasformazione == &quot;CBTSATMSIMM&quot; || localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;) &amp;&amp;  //RU_1109: aggiunto CCAMBIOTECNOLOGIA&#xD;
					(assetComp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM ||&#xD;
					 assetComp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PROTOCOLLO)&#xD;
				&amp;&amp; assetComp.statoDettaglioAsset == &quot;ATTIVO&quot;)  //Prop Bug #30638&#xD;
		{&#xD;
			&#xD;
			//SM_7911 - RU_685 - SF 5.91&#xD;
			var componenteTemp = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			componenteTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			componenteTemp.created = data;&#xD;
			componenteTemp.lastUpdate = data;&#xD;
			componenteTemp.operatore = &quot;BPM&quot;;&#xD;
			componenteTemp.IDDettaglioOrdine = idDettaglioOrdine;&#xD;
			componenteTemp.integrationID = localRequest.IDRichiestaOLO+componenteTemp.IDDettaglioOrdine;&#xD;
			componenteTemp.nomeComponente = assetComp.nomeComponente;&#xD;
			componenteTemp.progressivo = assetComp.progressivo;&#xD;
			componenteTemp.IDDettaglioOrdineParent = 1;&#xD;
			componenteTemp.IDDettaglioOrdineRoot = 1;&#xD;
			&#xD;
			attributo.IDDettaglioOrdine = componenteTemp.IDDettaglioOrdine;&#xD;
			&#xD;
			for(var j=0; j&lt;assetComp.attributidettaglioasset.size(); j++)&#xD;
			{	&#xD;
				var assetAttr = assetComp.attributidettaglioasset.get(j);&#xD;
				attributo.nomeAttributo = assetAttr.nomeAttributo;&#xD;
				attributo.tipologiaDato = assetAttr.tipologiaDato;&#xD;
				attributo.valoreAttributo = assetAttr.valoreAttributo;&#xD;
				&#xD;
				componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
			componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componenteTemp));&#xD;
			&#xD;
			idDettaglioOrdine++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	// Arricchimento Accesso separato da asset - Dest USO e IDRISORSA ORIGINARIO&#xD;
	var destUsoTrovata = false;&#xD;
	var idRisorsaOriginarioTrovato = false;&#xD;
	&#xD;
	for(var x = 0; x &lt; localRequest.ordine.dettaglioordine.size(); x++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(x);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var y = 0; y &lt; componente.attributiDettaglioOrdine.size(); y++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(y);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO &amp;&amp;&#xD;
					localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;)&#xD;
				{&#xD;
					attributo.valoreAttributo = '4';&#xD;
					destUsoTrovata = true;&#xD;
					Process.auditLog(&quot;TSHA_ULLD, Sostituitita DEST USO in &quot;+componente.nomeComponente+&quot; con valore: &quot;+attributo.valoreAttributo);&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAORIGINARIO&#xD;
						&amp;&amp; idRisorsaConsistenza != null) // RU_815&#xD;
				{&#xD;
					attributo.valoreAttributo = idRisorsaConsistenza;&#xD;
					idRisorsaOriginarioTrovato = true;&#xD;
					Process.auditLog(&quot;Aggiornato valore IDRISORSAORIGINARIO con valore IDRISORSA di &quot;+componente.nomeComponente);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			&#xD;
			attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			attributoACC.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			attributoACC.created = data;&#xD;
			attributoACC.lastUpdate = data;&#xD;
			attributoACC.operatore = &quot;BPM&quot;;&#xD;
			&#xD;
			// Arricchimento Dest USO per TSHA_ULLD&#xD;
			if(!destUsoTrovata &amp;&amp; localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;)&#xD;
			{&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO;&#xD;
				attributoACC.valoreAttributo = '4';&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;TSHA_ULLD, Aggiunto DEST USO in &quot;+componente.nomeComponente+&quot; con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}&#xD;
			&#xD;
			// RU_815 - valorizzazione IDRISORSAORIGINARIO, prima assente&#xD;
			if(!idRisorsaOriginarioTrovato &amp;&amp; idRisorsaConsistenza != null)&#xD;
			{&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAORIGINARIO;&#xD;
				attributoACC.valoreAttributo = idRisorsaConsistenza;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto valore IDRISORSAORIGINARIO da valore IDRISORSA di &quot;+componente.nomeComponente);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	// Aggiungi componente consistenza&#xD;
	if((GeneraIDRisorsa &#xD;
	|| localRequest.codiceTrasformazione == &quot;CBTSATMSIMM&quot; &#xD;
	|| localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot; //RU_1109&#xD;
	|| localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot; &#xD;
	|| localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot; &#xD;
	|| localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;) &amp;&amp; consistenza!= null)&#xD;
	{&#xD;
		Process.auditLog(&quot;Fase di aggiunta della componente &quot;+String(consistenza.nomeComponente));&#xD;
		&#xD;
		consistenza.IDDettaglioOrdine = 2;&#xD;
		consistenza.IDDettaglioOrdineParent = 1;&#xD;
		consistenza.IDDettaglioOrdineRoot = 1;&#xD;
		consistenza.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		consistenza.created = data;&#xD;
		consistenza.lastUpdate = data;&#xD;
		consistenza.integrationID = localRequest.IDRichiestaOLO+consistenza.IDDettaglioOrdine;&#xD;
		consistenza.operatore = &quot;BPM&quot;;&#xD;
		consistenza.progressivo = 1;&#xD;
&#xD;
		if(localRequest.codiceTrasformazione == &quot;CCAMBIOTECNOLOGIA&quot;) //RU_1109&#xD;
		{&#xD;
			consistenza.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
			Process.auditLog(&quot;Assegnata azione &quot;+String(consistenza.azione)+&quot; alla componente &quot;+String(consistenza.nomeComponente));&#xD;
		}&#xD;
		else if(localRequest.codiceTrasformazione != &quot;CBTSATMSIMM&quot;)&#xD;
		{&#xD;
			consistenza.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
			Process.auditLog(&quot;Assegnata azione &quot;+String(consistenza.azione)+&quot; alla componente &quot;+String(consistenza.nomeComponente));&#xD;
		}&#xD;
		&#xD;
		if((localRequest.codiceTrasformazione == &quot;TBUNDLE&quot;) &amp;&amp; consistenza.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			Process.auditLog(&quot;Aggiungo INVIOADTU ad N per CONSISTENZAFONIA in TBUNDLE&quot;);&#xD;
			var att = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			&#xD;
			att.IDDettaglioOrdine = consistenza.IDDettaglioOrdine;&#xD;
			att.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			att.created = data;&#xD;
			att.lastUpdate = data;&#xD;
			att.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU;&#xD;
			att.operatore = &quot;BPM&quot;;&#xD;
			att.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			att.valoreAttributo = &quot;N&quot;;&#xD;
			&#xD;
			consistenza.attributiDettaglioOrdine.add(ScriptUtil.copy(att));&#xD;
		}&#xD;
		&#xD;
		if((localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot; || localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot; || localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;) // RU_815 - aggiunto TSHA_ULLD&#xD;
			&amp;&amp; consistenza.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
		{&#xD;
			var foundInvioDTU=false;&#xD;
			var k=0;&#xD;
			&#xD;
			while(!foundInvioDTU &amp;&amp; k&lt;consistenza.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var att = consistenza.attributiDettaglioOrdine.get(k);&#xD;
				&#xD;
				if(att.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU)&#xD;
				{&#xD;
					foundInvioDTU=true;&#xD;
					att.IDDettaglioOrdine = consistenza.IDDettaglioOrdine;&#xD;
					att.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					att.created = data;&#xD;
					att.lastUpdate = data;&#xD;
					att.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU;&#xD;
					att.operatore = &quot;BPM&quot;;&#xD;
					att.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					att.valoreAttributo = &quot;N&quot;;&#xD;
					Process.auditLog(&quot;Aggiornato INVIOADTU ad N per CONSISTENZADATI&quot;);&#xD;
				}&#xD;
				&#xD;
				k++;&#xD;
			}&#xD;
			&#xD;
			if(!foundInvioDTU)&#xD;
			{&#xD;
				Process.auditLog(&quot;Aggiunto INVIOADTU ad N per CONSISTENZADATI&quot;);&#xD;
				var att = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			&#xD;
				att.IDDettaglioOrdine = consistenza.IDDettaglioOrdine;&#xD;
				att.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				att.created = data;&#xD;
				att.lastUpdate = data;&#xD;
				att.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU;&#xD;
				att.operatore = &quot;BPM&quot;;&#xD;
				att.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				att.valoreAttributo = &quot;N&quot;;&#xD;
			&#xD;
				consistenza.attributiDettaglioOrdine.add(ScriptUtil.copy(att));&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		// RU_685 - SF 5.71, per CBTSATMSIMM copiare la Consistenza Dati con AZIONE=”T” dell’Ordine di Migrazione che ha generato l’Indotto e modifica AZIONE = ”M”&#xD;
		if(localRequest.codiceTrasformazione == &quot;CBTSATMSIMM&quot; &amp;&amp; consistenza.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
		{&#xD;
			if(consistenza.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.T)&#xD;
			{&#xD;
				consistenza.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
				localRequest.ordine.dettaglioordine.add(consistenza);&#xD;
				Process.auditLog(&quot;Aggiunta &quot;+String(consistenza.nomeComponente)+ &quot; con azione &quot;+String(consistenza.azione));	&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				Process.auditLog(&quot;Nessuna aggiunta. Trovata componente &quot;+String(consistenza.nomeComponente)+ &quot; con azione &quot;+String(consistenza.azione));&#xD;
			}&#xD;
		}&#xD;
		else // In tutti gli altri casi&#xD;
		{&#xD;
			localRequest.ordine.dettaglioordine.add(consistenza);&#xD;
			Process.auditLog(&quot;aggiunta &quot;+String(consistenza.nomeComponente)+ &quot; con azione &quot;+String(consistenza.azione));	&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;IDENTIFICATIVOASSET non trovato nella componente consistenza&quot;);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
