          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_RsFC4FJUEeafMOVsQ226Vw" PackageRef="tim.NOW.bpm.ProcesService.Interfaces" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="false">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="EsistenzaVLANOutput">
                  <xpdl2:Actual ScriptGrammar="JavaScript">EsistenzaVLANOutput</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="EsitoResponse">
                  <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="idAnagraficaCausale">
