        <xpdl2:Activity Id="_MSkIoLrTEeqkHYJrGhp0Mw" Name="Log" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Log">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
