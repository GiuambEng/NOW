        <xpdl2:Activity Id="_GDJSIU0hEeeB6fnWJqm8Lg" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_auWLV00gEeeB6fnWJqm8Lg" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_2UDpgUxkEeeB6fnWJqm8Lg" Width="58.0">
