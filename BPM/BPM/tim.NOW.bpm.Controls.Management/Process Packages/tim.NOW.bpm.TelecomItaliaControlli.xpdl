        <xpdl2:Activity Id="_8jLBod0yEe6bX58n68cYEA" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_p6--gN0yEe6bX58n68cYEA" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_8Me1Yd0xEe6bX58n68cYEA" Width="58.0">
              <xpdl2:Coordinates XCoordinate="44.0" YCoordinate="155.0"/>
