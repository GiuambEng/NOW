        <xpdl2:Activity Id="_L67F-OAuEeeAvej_yWbZRA" Name="Scarto" xpdExt:Visibility="Private" xpdExt:DisplayName="Scarto">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Trigger="Link">
              <xpdl2:TriggerResultLink CatchThrow="CATCH" Name="0"/>
            </xpdl2:IntermediateEvent>
          </xpdl2:Event>
