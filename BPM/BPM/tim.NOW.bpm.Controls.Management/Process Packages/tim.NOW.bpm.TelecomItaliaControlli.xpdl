            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier=&quot;/tim.NOW.bpm.Controls/Process Packages/tim.NOW.bpm.Controls.xpdl.CTRLORDINEOLO&quot;;</xpdExt:Information>
