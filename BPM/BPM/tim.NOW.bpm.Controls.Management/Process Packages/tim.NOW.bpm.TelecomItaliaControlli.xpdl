        <xpdl2:Activity Id="_mqTh4LfaEeet0ppHnI5jAQ" Name="AggiornamentoSede" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiornamento Sede">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if (localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	if(Asset != null)&#xD;
		{&#xD;
			var sedeCliente = it_telecomitalia_it_NOW_casedata_Factory.createSede();&#xD;
			sedeCliente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			sedeCliente.operatore = 'BPM';&#xD;
			sedeCliente.IDSede = localRequest.ordine.sede.size()+1;&#xD;
			sedeCliente.tipologiaSede = it_telecomitalia_it_NOW_casedata_TipologiaSedeEnumeration.SEDECLIENTEOLD;&#xD;
			if (Asset.codiceToponomastica != null &amp;&amp; Asset.codiceToponomastica != &quot;&quot;)&#xD;
			{	&#xD;
				sedeCliente.codiceToponomastica = Asset.codiceToponomastica;	&#xD;
				sedeCliente.CAP = EnrichmentSedeOutput.CAP;&#xD;
				sedeCliente.codiceISTATComune = EnrichmentSedeOutput.codISTATComune;&#xD;
				//sedeCliente.codiceISTATProvincia = asset.codiceISTATProvincia;&#xD;
				sedeCliente.complesso = Asset.complesso;&#xD;
				sedeCliente.comune = EnrichmentSedeOutput.descrComune;&#xD;
				sedeCliente.particellaToponomastica = EnrichmentSedeOutput.descrParticellaToponomastica;&#xD;
				sedeCliente.via = EnrichmentSedeOutput.descrVia;&#xD;
				sedeCliente.interno = Asset.interno;&#xD;
				sedeCliente.civico = EnrichmentSedeOutput.numeroCivico;&#xD;
				sedeCliente.piano = Asset.piano;&#xD;
				sedeCliente.scala = Asset.scala;&#xD;
				sedeCliente.siglaProvincia = EnrichmentSedeOutput.siglaProvincia;&#xD;
				sedeCliente.codiceISTATProvincia = EnrichmentSedeOutput.codiceISTATProvincia;&#xD;
				sedeCliente.provincia = EnrichmentSedeOutput.descrProvincia;&#xD;
				sedeCliente.codiceVia = EnrichmentSedeOutput.codVia;					&#xD;
			}&#xD;
			else&#xD;
			{			&#xD;
				sedeCliente.CAP = Asset.CAP;&#xD;
				sedeCliente.codiceISTATComune = Asset.codiceISTATComune;&#xD;
				sedeCliente.codiceISTATProvincia = Asset.codiceISTATProvincia;&#xD;
				sedeCliente.complesso = Asset.complesso;&#xD;
				sedeCliente.comune = Asset.comune;&#xD;
				sedeCliente.particellaToponomastica = Asset.descrPartToponomastica;&#xD;
				sedeCliente.via = Asset.descrizioneVia;&#xD;
				sedeCliente.interno = Asset.interno;&#xD;
				sedeCliente.localita = Asset.localita;&#xD;
				sedeCliente.codiceNumeroCivico = Asset.numeroCivico;&#xD;
				sedeCliente.piano = Asset.piano;&#xD;
				sedeCliente.provincia = Asset.provincia;&#xD;
				sedeCliente.scala = Asset.scala;&#xD;
				sedeCliente.siglaProvincia = Asset.siglaProvincia;					&#xD;
			}&#xD;
		localRequest.ordine.sede.add(sedeCliente);	&#xD;
		}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
