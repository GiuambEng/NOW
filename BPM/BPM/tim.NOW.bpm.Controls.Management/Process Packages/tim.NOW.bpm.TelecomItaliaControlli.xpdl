        <xpdl2:Activity Id="_xbEn0CsnEeekDfW79LFRAg" Name="ArricchimentoordineVariazioneIndotte" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento ordine Variazione Indotte">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var data = DateTimeUtil.createDatetime();&#xD;
var listaAttributiOrdine = DataUtil.createList();&#xD;
var listaAttributiAsset = DataUtil.createList();&#xD;
var listaAttributiDaAggiungere = DataUtil.createList();&#xD;
var listaValoreOrdine = DataUtil.createList();&#xD;
var listaValoreAsset = DataUtil.createList();&#xD;
var listaValoreOrdineOld = DataUtil.createList();&#xD;
var listaComponenti =DataUtil.createList();&#xD;
var nomeComponenteAccesso =&quot;&quot;;&#xD;
var azioneComponenteAccesso =&quot;N&quot;;&#xD;
var azioneComponenteNP =&quot;N&quot;;&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
//------------------------------------------------CONSISTENZA FONIA----------------------------------------------------------------------&#xD;
if(ConsistenzaFonia!= null){&#xD;
	Process.auditLog(&quot;Arricchimento per Consistenza Fonia, asset: &quot;+ ConsistenzaFonia.IDAsset);&#xD;
	Process.auditLog(&quot;Offerta: &quot;+String(localRequest.offerta)+&quot; , tipologiaSottolav: &quot;+localRequest.ordine.tipologiaSottolav);&#xD;
	assetFoniaRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaFonia.IDAsset,10));&#xD;
	assetFonia = assetFoniaRef.readAsset();&#xD;
&#xD;
	//------------------Calcola Configurazioni&#xD;
	&#xD;
	//ULL&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULL &#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA &#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP &#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA){&#xD;
		nomeComponenteAccesso = &quot;ACCESSOULL&quot;;&#xD;
		if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTONP){&#xD;
			azioneComponenteAccesso = &quot;A&quot;;&#xD;
			azioneComponenteNP = &quot;D&quot;;&#xD;
		}&#xD;
		else if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOULL){&#xD;
			azioneComponenteAccesso = &quot;D&quot;;&#xD;
			azioneComponenteNP = &quot;N&quot;;&#xD;
		}&#xD;
		else{&#xD;
			azioneComponenteAccesso = &quot;N&quot;;&#xD;
			azioneComponenteNP = &quot;N&quot;;&#xD;
			Process.auditLog(&quot;Configurazione non trovata per il campo azione in: offerta=&quot;+localRequest.offerta+&quot;, codiceTrasformazione=&quot;+localRequest.codiceTrasformazione+ &quot;,tipologiaSottolav=&quot;+String(localRequest.ordine.tipologiaSottolav));&#xD;
		}&#xD;
				&#xD;
		listaAttributiOrdine.add(&quot;POSIZIONEPERMUTATORE1&quot;);&#xD;
		listaAttributiAsset.add(&quot;POSIZIONEPERMUTATORE1&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;POSIZIONEPERMUTATORE2&quot;);&#xD;
		listaAttributiAsset.add(&quot;POSIZIONEPERMUTATORE2&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;DESTINAZIONEUSO&quot;);&#xD;
		listaAttributiAsset.add(&quot;DESTINAZIONEUSO&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;BITRATE&quot;);&#xD;
		listaAttributiAsset.add(&quot;BITRATE&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;IDRISORSAORIGINARIO&quot;);&#xD;
		listaAttributiAsset.add(&quot;IDRISORSAORIGINARIO&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(assetFonia.IDRisorsa);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;IDULLCO&quot;);&#xD;
		listaAttributiAsset.add(&quot;IDULLCO&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
	}&#xD;
	// ULLDati&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATI || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA){&#xD;
		nomeComponenteAccesso = &quot;ACCESSOULLDATI&quot;;&#xD;
		if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTONP){&#xD;
			azioneComponenteAccesso = &quot;A&quot;;&#xD;
			azioneComponenteNP = &quot;D&quot;;&#xD;
		}&#xD;
		else if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOULL){&#xD;
			azioneComponenteAccesso = &quot;D&quot;;&#xD;
			azioneComponenteNP = &quot;N&quot;;&#xD;
		}&#xD;
		else{&#xD;
			azioneComponenteAccesso = &quot;N&quot;;&#xD;
			azioneComponenteNP = &quot;N&quot;;&#xD;
			Process.auditLog(&quot;Configurazione non trovata per il campo azione in: offerta=&quot;+localRequest.offerta+&quot;, codiceTrasformazione=&quot;+localRequest.codiceTrasformazione+ &quot;,tipologiaSottolav=&quot;+String(localRequest.ordine.tipologiaSottolav));&#xD;
		}&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;POSIZIONEPERMUTATORE1&quot;);&#xD;
		listaAttributiAsset.add(&quot;POSIZIONEPERMUTATORE1&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;POSIZIONEPERMUTATORE2&quot;);&#xD;
		listaAttributiAsset.add(&quot;POSIZIONEPERMUTATORE2&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;BITRATE&quot;);&#xD;
		listaAttributiAsset.add(&quot;BITRATE&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
				&#xD;
		listaAttributiOrdine.add(&quot;IDRISORSAORIGINARIO&quot;);&#xD;
		listaAttributiAsset.add(&quot;IDRISORSAORIGINARIO&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(assetFonia.IDRisorsa);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;IDULLCO&quot;);&#xD;
		listaAttributiAsset.add(&quot;IDULLCO&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
	}&#xD;
	// SLU&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLU || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA){&#xD;
		nomeComponenteAccesso = &quot;ACCESSOSLU&quot;;&#xD;
		if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTONP){&#xD;
			azioneComponenteAccesso = &quot;A&quot;;&#xD;
			azioneComponenteNP = &quot;D&quot;;&#xD;
		}&#xD;
		else if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOSLU){&#xD;
			azioneComponenteAccesso = &quot;D&quot;;&#xD;
			azioneComponenteNP = &quot;N&quot;;&#xD;
		}&#xD;
		else{&#xD;
			azioneComponenteAccesso = &quot;N&quot;;&#xD;
			azioneComponenteNP = &quot;N&quot;;&#xD;
			Process.auditLog(&quot;Configurazione non trovata per il campo azione in: offerta=&quot;+localRequest.offerta+&quot;, codiceTrasformazione=&quot;+localRequest.codiceTrasformazione+ &quot;,tipologiaSottolav=&quot;+String(localRequest.ordine.tipologiaSottolav));&#xD;
		}&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;POSIZIONEPERMUTATORE1&quot;);&#xD;
		listaAttributiAsset.add(&quot;POSIZIONEPERMUTATORE1&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;POSIZIONEPERMUTATORE2&quot;);&#xD;
		listaAttributiAsset.add(&quot;POSIZIONEPERMUTATORE2&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;DESTINAZIONEUSO&quot;);&#xD;
		listaAttributiAsset.add(&quot;DESTINAZIONEUSO&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;BITRATE&quot;);&#xD;
		listaAttributiAsset.add(&quot;BITRATE&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;IDARLOLO&quot;);&#xD;
		listaAttributiAsset.add(&quot;IDARLOLO&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
&#xD;
		listaAttributiOrdine.add(&quot;POSIZIONEARLOLO1&quot;);&#xD;
		listaAttributiAsset.add(&quot;POSIZIONEARLOLO1&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
&#xD;
		listaAttributiOrdine.add(&quot;POSIZIONEARLOLO2&quot;);&#xD;
		listaAttributiAsset.add(&quot;POSIZIONEARLOLO2&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
&#xD;
		listaAttributiOrdine.add(&quot;POSIZIONEARLTI1&quot;);&#xD;
		listaAttributiAsset.add(&quot;POSIZIONEARLTI1&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
&#xD;
		listaAttributiOrdine.add(&quot;POSIZIONEARLTI2&quot;);&#xD;
		listaAttributiAsset.add(&quot;POSIZIONEARLTI2&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(&quot;&quot;);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
		listaAttributiOrdine.add(&quot;IDRISORSAORIGINARIO&quot;);&#xD;
		listaAttributiAsset.add(&quot;IDRISORSAORIGINARIO&quot;);&#xD;
		listaAttributiDaAggiungere.add(true);listaComponenti.add(&quot;ACCESSO&quot;);&#xD;
		listaValoreOrdine.add(assetFonia.IDRisorsa);listaValoreAsset.add(&quot;&quot;);listaValoreOrdineOld.add(&quot;&quot;);&#xD;
		&#xD;
