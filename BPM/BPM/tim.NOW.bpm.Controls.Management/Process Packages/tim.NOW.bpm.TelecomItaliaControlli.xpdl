        <xpdl2:Activity Id="_aSyUwA8nEeeXv8RtwyZtwQ" Name="ArricchimentoOrdineDaAsset" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Ordine Da Asset">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//SM_10770, Installazione KIT C10 2022: Unico script diviso in due, &quot;Valorizzazione Costanti da Asset&quot; e &quot;Arricchimento Ordine da Asset&quot;&#xD;
var data = DateTimeUtil.createDatetime();&#xD;
&#xD;
//Richiesta-------------------&#xD;
var AggiuntiviISDN =0;&#xD;
AggiuntiviISDN = null;&#xD;
var STRUTTURALINEA = &quot;&quot;;&#xD;
STRUTTURALINEA = null;&#xD;
var QUANTITALINEE = &quot;&quot;;&#xD;
QUANTITALINEE = null;&#xD;
var CODICECAMBIOTIPOLOGIA = &quot;&quot;;&#xD;
CODICECAMBIOTIPOLOGIA = null;&#xD;
var DIREZIONALITA =&quot;&quot;;&#xD;
DIREZIONALITA = null;&#xD;
var CODICECAMBIOTIPOLOGIA = &quot;&quot;;&#xD;
CODICECAMBIOTIPOLOGIA = null;&#xD;
var TIPOLINEA = &quot;&quot;;&#xD;
TIPOLINEA = null;&#xD;
&#xD;
//consistenza --------------------&#xD;
var STRUTTURALINEAConsistenza = &quot;&quot;;&#xD;
STRUTTURALINEAConsistenza = null;&#xD;
var DIREZIONALITAConsistenza = &quot;&quot;;&#xD;
DIREZIONALITAConsistenza = null;&#xD;
var TIPOLINEAConsistenza = &quot;&quot;;&#xD;
TIPOLINEAConsistenza = null;&#xD;
var CODICEPIATTAFORMAConsistenza = &quot;&quot;;&#xD;
CODICEPIATTAFORMAConsistenza = null;&#xD;
&#xD;
//Zozzata colossale per gestire lo SHA che entra come VariazioneFonia, ma di fatto é Dati&#xD;
//Questo if sta anche nello script precedente poichè, essendo ConsistenzaFoniaTemp una volta Fonia e una volta Dati, non posso definirla come data field specificando il BOM &#xD;
if(String(localRequest.offerta).slice(0, 3) == &quot;SHA&quot;){&#xD;
	var ConsistenzaFoniaTemp = ConsistenzaDati;&#xD;
}&#xD;
else{&#xD;
	var ConsistenzaFoniaTemp = ConsistenzaFonia;&#xD;
}&#xD;
&#xD;
if(ConsistenzaFoniaTemp!= null){&#xD;
	&#xD;
	//------------------Recupero informazioni da Asset------------------&#xD;
	// rispetto alla configurazione si recuperano gli attributi su asset e si salvano nella lista &quot;listaValore&quot;, se non trovato il valore rimarrà &quot;&quot;&#xD;
	for(var i=0; i&lt;assetFonia.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var compAsset = assetFonia.dettaglioasset.get(i);&#xD;
		if(String(compAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;compAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var attributoAsset = compAsset.attributidettaglioasset.get(j);&#xD;
				&#xD;
				for(var k =0; k&lt;listaValoreAsset_ARR.size();k++)&#xD;
				{&#xD;
					if(listaComponenti_ARR. get(k) == &quot;ACCESSO&quot; &amp;&amp; listaValoreAsset_ARR.get(k) == &quot;&quot; &amp;&amp; attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiAsset_ARR.get(k)))&#xD;
					{&#xD;
						listaValoreAsset_ARR.set(k,attributoAsset.valoreAttributo);&#xD;
					}&#xD;
				}&#xD;
				if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
					TIPOLINEAConsistenza = attributoAsset.valoreAttributo;&#xD;
				}&#xD;
				else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA){&#xD;
					STRUTTURALINEAConsistenza = attributoAsset.valoreAttributo;&#xD;
				}&#xD;
				else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA){&#xD;
					DIREZIONALITAConsistenza = attributoAsset.valoreAttributo;&#xD;
				}&#xD;
				else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA){&#xD;
					CODICEPIATTAFORMAConsistenza == attributoAsset.valoreAttributo;&#xD;
				}&#xD;
			}			&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	// VALORIZZAZIONE OPERATORE RETE - Modifica per FF&#xD;
	if(assetFonia.operatoreRete != null){&#xD;
		localRequest.operatoreRete = assetFonia.operatoreRete;&#xD;
		localRequest.ordine.operatoreRete = assetFonia.operatoreRete;&#xD;
	}&#xD;
	&#xD;
	//------------------Recupera informazioni da ordine-----------------------&#xD;
	var accessoTrovato = false;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componenteOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componenteOrdine.nomeComponente).slice(0,7)==&quot;ACCESSO&quot;)&#xD;
		{			&#xD;
			// SM_8530 - se in precedenza e' stata cambiata l'offerta ma l'accesso e' rimasto col nome originale bisogna cambiarlo&#xD;
			if(String(componenteOrdine.nomeComponente) != nomeComponenteAccesso_ARR){&#xD;
				Process.auditLog(&quot;Nome dell'accesso cambiato da &quot;+String(componenteOrdine.nomeComponente)+&quot; a &quot;+nomeComponenteAccesso_ARR+&quot;, offerta &quot;+String(localRequest.offerta));				&#xD;
				componenteOrdine.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.get(nomeComponenteAccesso_ARR);&#xD;
			}&#xD;
			&#xD;
			for(var j=0; j&lt;componenteOrdine.attributiDettaglioOrdine.size(); j++){&#xD;
				var attributoOrdine = componenteOrdine.attributiDettaglioOrdine.get(j);&#xD;
				accessoTrovato = true;&#xD;
				&#xD;
				for(var k =0; k&lt;listaAttributiOrdine_ARR.size();k++){&#xD;
					if(listaComponenti_ARR.get(k) == &quot;ACCESSO&quot; &amp;&amp; listaValoreOrdine_ARR.get(k) == &quot;&quot; &amp;&amp; attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine_ARR.get(k)))&#xD;
					{&#xD;
						listaValoreOrdine_ARR.set(k,attributoOrdine.valoreAttributo);&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AGGIUNTIVIISDN){&#xD;
					AggiuntiviISDN = parseInt(attributoOrdine.valoreAttributo, 10);&#xD;
				}&#xD;
				else if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA){&#xD;
					STRUTTURALINEA = attributoOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITALINEE){&#xD;
					QUANTITALINEE = attributoOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECAMBIOTIPOLOGIA){&#xD;
					CODICECAMBIOTIPOLOGIA = attributoOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA){&#xD;
					DIREZIONALITA= attributoOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECAMBIOTIPOLOGIA){&#xD;
					CODICECAMBIOTIPOLOGIA= attributoOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){ //SM_8910 aggiunta valorizzazione variabile TIPOLINEA con attributo.&#xD;
					TIPOLINEA = attributoOrdine.valoreAttributo;&#xD;
					Process.auditLog(&quot;Aggiunto variabile TIPOLINEA valorizzata con valore attributo.&quot;);&#xD;
				}				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//crea Accesso se non esiste&#xD;
	if(!accessoTrovato){&#xD;
		var componenteAccessoTemp = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componenteAccessoTemp.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
		componenteAccessoTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componenteAccessoTemp.created = data;&#xD;
		componenteAccessoTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
		componenteAccessoTemp.integrationID = localRequest.IDRichiestaOLO + localRequest.ordine.dettaglioordine.size();&#xD;
		componenteAccessoTemp.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.get(nomeComponenteAccesso_ARR);&#xD;
		componenteAccessoTemp.operatore = localRequest.operatore;&#xD;
		componenteAccessoTemp.progressivo = 1;&#xD;
		Process.auditLog(&quot;Aggiunto ACCESSO in quanto non presente in input&quot;);&#xD;
		localRequest.ordine.dettaglioordine.add(componenteAccessoTemp);&#xD;
	}&#xD;
		&#xD;
	//-----------------------------Logiche di arricchimento-----------------------------------------&#xD;
	for(var i=0; i&lt;listaAttributiOrdine_ARR.size();i++)&#xD;
	{	&#xD;
		//WLR&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA){&#xD;
		&#xD;
			//ATTIVAZIONE/CESSAZIONE STSMULTINUMERO&#xD;
			if(listaAttributiOrdine_ARR.get(i) == &quot;NUMAGGIUNTIVI&quot; &#xD;
			&amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTSMULTINUMERO){&#xD;
				listaValoreOrdine_ARROld.set(i, listaValoreAsset_ARR.get(i));	&#xD;
				listaValoreOrdine_ARR.set(i,(parseInt(listaValoreAsset_ARR.get(i),10) + AggiuntiviISDN));					&#xD;
			}&#xD;
			else if(listaAttributiOrdine_ARR.get(i) == &quot;NUMAGGIUNTIVI&quot; &#xD;
				&amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CESSAZIONESTSMULTINUMERO){&#xD;
				listaValoreOrdine_ARROld.set(i, listaValoreAsset_ARR.get(i));	&#xD;
				listaValoreOrdine_ARR.set(i,(parseInt(listaValoreAsset_ARR.get(i),10) - AggiuntiviISDN));&#xD;
			}	&#xD;
			//INCREMENTO/DECREMENTO CANALI&#xD;
			//SM_8910&#xD;
			else if(listaAttributiOrdine_ARR.get(i) == &quot;NUMAGGIUNTIVI&quot;&#xD;
				&amp;&amp; (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOCANALI&#xD;
					|| localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOCANALI)&#xD;
				&amp;&amp; (STRUTTURALINEA == &quot;PBX&quot; || STRUTTURALINEA == &quot;GNR&quot;))&#xD;
			{&#xD;
				listaValoreOrdine_ARROld.set(i, listaValoreAsset_ARR.get(i));	&#xD;
				listaValoreOrdine_ARR.set(i,(parseInt(listaValoreAsset_ARR.get(i),10) - AggiuntiviISDN));&#xD;
			}&#xD;
			else if(listaAttributiOrdine_ARR.get(i) == &quot;QUANTITALINEE&quot;&#xD;
				&amp;&amp; (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOCANALI&#xD;
					|| localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOCANALI)&#xD;
				&amp;&amp; ((localRequest.ordine.tipologiaLinea != null &amp;&amp; localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS) &#xD;
					|| (TIPOLINEA != null &amp;&amp; TIPOLINEA == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS))&#xD;
				&amp;&amp; (STRUTTURALINEA == &quot;PBX&quot; || STRUTTURALINEA == &quot;GNR&quot;))&#xD;
			{&#xD;
				listaValoreOrdine_ARROld.set(i, listaValoreAsset_ARR.get(i));&#xD;
				listaValoreOrdine_ARR.set(i,QUANTITALINEE);&#xD;
			}			&#xD;
			else if((localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOCANALI&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOCANALI)&#xD;
				&amp;&amp; (listaAttributiOrdine_ARR.get(i) == &quot;QUANTITACANALI&quot; &#xD;
				&amp;&amp; ((localRequest.ordine.tipologiaLinea != null &amp;&amp; localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN) &#xD;
					|| (TIPOLINEA != null &amp;&amp; TIPOLINEA == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN))&#xD;
				&amp;&amp; (STRUTTURALINEA == &quot;PBX&quot; || STRUTTURALINEA == &quot;GNR&quot;)))&#xD;
			{&#xD;
				listaValoreOrdine_ARROld.set(i, listaValoreAsset_ARR.get(i));&#xD;
				listaValoreOrdine_ARR.set(i,QUANTITALINEE);&#xD;
			}&#xD;
			&#xD;
			//INCREMENTO/DECREMENTO BORCHIA&#xD;
			else if(listaAttributiOrdine_ARR.get(i) == &quot;BORCHIANT1PLUS&quot; &#xD;
					&amp;&amp; (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOBORCHIA&#xD;
						|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOBORCHIA)){&#xD;
										&#xD;
					if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOBORCHIA){&#xD;
						listaValoreOrdine_ARR.set(i,&quot;W+&quot;);&#xD;
					}&#xD;
					else{&#xD;
						listaValoreOrdine_ARR.set(i,&quot;W-&quot;);&#xD;
					}&#xD;
					if(listaValoreAsset_ARR.get(i)!=&quot;&quot;){&#xD;
						listaValoreOrdine_ARROld.set(i, listaValoreAsset_ARR.get(i));&#xD;
					}&#xD;
				}&#xD;
			&#xD;
			//PRESTAZIONI WLR&#xD;
			else if((localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR5&#xD;
					|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR6&#xD;
					|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR7&#xD;
					|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR18&#xD;
					|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR19)&#xD;
					&amp;&amp; listaAttributiOrdine_ARR.get(i) == &quot;CODICEPRESTAZIONE&quot;){&#xD;
						listaValoreOrdine_ARROld.set(i, listaValoreAsset_ARR.get(i));							&#xD;
				}&#xD;
			&#xD;
			//CAMBIO TIPOLOGIA &#xD;
			else if((localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR10&#xD;
					|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR11&#xD;
					|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR8&#xD;
					|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR9)&#xD;
				&amp;&amp; (listaAttributiOrdine_ARR.get(i) == &quot;TIPOLINEA&quot;&#xD;
					|| listaAttributiOrdine_ARR.get(i) == &quot;STRUTTURALINEA&quot;&#xD;
					|| listaAttributiOrdine_ARR.get(i) == &quot;BANDASERVIZIO&quot;)) // RU_778 - aggiunta tutta la gestione per BANDASERVIZIO e modificata logica codici&#xD;
			{&#xD;
				if(CODICECAMBIOTIPOLOGIA!= null){&#xD;
					&#xD;
					if(CODICECAMBIOTIPOLOGIA==&quot;8&quot;)&#xD;
					{&#xD;
						if(listaAttributiOrdine_ARR.get(i) == &quot;TIPOLINEA&quot;){&#xD;
							listaValoreOrdine_ARR.set(i,&quot;ISDN&quot;);&#xD;
						}&#xD;
						else if(listaAttributiOrdine_ARR.get(i) == &quot;STRUTTURALINEA&quot;){&#xD;
							listaValoreOrdine_ARR.set(i,&quot;BRA Mono&quot;);&#xD;
						}&#xD;
					}&#xD;
					else if(CODICECAMBIOTIPOLOGIA==&quot;11&quot;)&#xD;
					{&#xD;
						if(listaAttributiOrdine_ARR.get(i) == &quot;TIPOLINEA&quot;){&#xD;
							listaValoreOrdine_ARR.set(i,&quot;ISDN&quot;);&#xD;
						}&#xD;
						else if(listaAttributiOrdine_ARR.get(i) == &quot;STRUTTURALINEA&quot;){&#xD;
							listaValoreOrdine_ARR.set(i,&quot;PBX&quot;);&#xD;
						}&#xD;
						else if(listaAttributiOrdine_ARR.get(i) == &quot;BANDASERVIZIO&quot;){&#xD;
							listaValoreOrdine_ARR.set(i,&quot;ISDN PRA&quot;);&#xD;
						}&#xD;
					}&#xD;
					else if(CODICECAMBIOTIPOLOGIA==&quot;10&quot; || CODICECAMBIOTIPOLOGIA==&quot;9&quot;)&#xD;
					{		&#xD;
						if(listaAttributiOrdine_ARR.get(i) == &quot;STRUTTURALINEA&quot;){&#xD;
							listaValoreOrdine_ARR.set(i,&quot;Simplex&quot;);&#xD;
						}&#xD;
						else if(listaAttributiOrdine_ARR.get(i) == &quot;TIPOLINEA&quot;){&#xD;
							listaValoreOrdine_ARR.set(i,&quot;POTS&quot;);&#xD;
						}&#xD;
					}&#xD;
							&#xD;
					if(listaValoreAsset_ARR.get(i)!=&quot;&quot;){&#xD;
						listaValoreOrdine_ARROld.set(i, listaValoreAsset_ARR.get(i));&#xD;
					}&#xD;
				}&#xD;
				else{&#xD;
					Process.auditLog(&quot;CODICECAMBIOTIPOLOGIA non trovata nella richiesta&quot;);&#xD;
				}												&#xD;
			}&#xD;
				&#xD;
			//TRASLOCOWLR - CODICEPIATTAFORMA&#xD;
			else if(listaAttributiOrdine_ARR.get(i) == &quot;CODICEPIATTAFORMA&quot;){&#xD;
&#xD;
				CodicePiattaforma = listaValoreAsset_ARR.get(i);&#xD;
			&#xD;
				if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR12&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR13&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR14&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR15&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR16				&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTS&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CESSAZIONESTS&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTSMULTINUMERO&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CESSAZIONESTSMULTINUMERO){&#xD;
					&#xD;
					if((localRequest.ordine.CF!= null &amp;&amp;localRequest.ordine.CF!= &quot;&quot; || (assetFonia.cliente != null &amp;&amp; assetFonia.cliente.codiceFiscale!= null &amp;&amp; assetFonia.cliente.codiceFiscale!=&quot;&quot;))&#xD;
						||(localRequest.ordine.PIVA!= null &amp;&amp; localRequest.ordine.PIVA!=&quot;&quot;|| (assetFonia.cliente != null &amp;&amp; assetFonia.cliente.partitaIVA!= null &amp;&amp; assetFonia.cliente.partitaIVA!=&quot;&quot;))){&#xD;
						if(localRequest.ordine.CF!= null &amp;&amp;localRequest.ordine.CF!= &quot;&quot; || (assetFonia.cliente != null &amp;&amp; assetFonia.cliente.codiceFiscale!= null &amp;&amp; assetFonia.cliente.codiceFiscale!=&quot;&quot;)){&#xD;
							if(TIPOLINEAConsistenza != null &amp;&amp; TIPOLINEAConsistenza.toUpperCase() == &quot;POTS&quot; &amp;&amp; DIREZIONALITAConsistenza == null ){&#xD;
								CodicePiattaforma=&quot;SBR&quot;;&#xD;
							}&#xD;
							else if(TIPOLINEAConsistenza != null &amp;&amp; TIPOLINEAConsistenza.toUpperCase() == &quot;ISDN&quot; &amp;&amp; STRUTTURALINEAConsistenza == &quot;BraMono&quot; &amp;&amp; DIREZIONALITA == null){&#xD;
								CodicePiattaforma=&quot;SBR&quot;;&#xD;
							}&#xD;
							else if(TIPOLINEAConsistenza != null &amp;&amp; TIPOLINEAConsistenza.toUpperCase() == &quot;POTS&quot; &amp;&amp; STRUTTURALINEAConsistenza == &quot;Simplex&quot; &amp;&amp; DIREZIONALITA != null){&#xD;
								CodicePiattaforma=&quot;SBR&quot;;&#xD;
							}&#xD;
						}&#xD;
						else{&#xD;
							CodicePiattaforma=&quot;SBL&quot;;&#xD;
						}&#xD;
						if(localRequest.ordine.PIVA!= null &amp;&amp; localRequest.ordine.PIVA!=&quot;&quot;|| (assetFonia.cliente != null &amp;&amp; assetFonia.cliente.partitaIVA!= null &amp;&amp; assetFonia.cliente.partitaIVA!=&quot;&quot;)){&#xD;
							CodicePiattaforma=&quot;SBL&quot;;&#xD;
						}					&#xD;
					}															&#xD;
				}&#xD;
				//Variazione Cambio Tecnologia/ tipologia &#xD;
				else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR10&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR11&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR8&#xD;
				|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR9){&#xD;
					if((localRequest.ordine.CF!= null &amp;&amp;localRequest.ordine.CF!= &quot;&quot; || (assetFonia.cliente != null &amp;&amp; assetFonia.cliente.codiceFiscale!= null &amp;&amp; assetFonia.cliente.codiceFiscale!=&quot;&quot;))&#xD;
						||(localRequest.ordine.PIVA!= null &amp;&amp; localRequest.ordine.PIVA!=&quot;&quot;|| (assetFonia.cliente != null &amp;&amp; assetFonia.cliente.partitaIVA!= null &amp;&amp; assetFonia.cliente.partitaIVA!=&quot;&quot;))){&#xD;
						if(localRequest.ordine.CF!= null &amp;&amp;localRequest.ordine.CF!= &quot;&quot; || (assetFonia.cliente != null &amp;&amp; assetFonia.cliente.codiceFiscale!= null &amp;&amp; assetFonia.cliente.codiceFiscale!=&quot;&quot;)){&#xD;
							if((CODICECAMBIOTIPOLOGIA == &quot;10&quot; || CODICECAMBIOTIPOLOGIA == &quot;8&quot;) &amp;&amp; DIREZIONALITAConsistenza == null ){&#xD;
								CodicePiattaforma=&quot;SBR&quot;;&#xD;
							}&#xD;
							else if((CODICECAMBIOTIPOLOGIA == &quot;10&quot; || (TIPOLINEAConsistenza != null &amp;&amp; TIPOLINEAConsistenza.toUpperCase() == &quot;POTS&quot; &amp;&amp; STRUTTURALINEAConsistenza == &quot;Simplex&quot;))&#xD;
							&amp;&amp; DIREZIONALITA != null){&#xD;
								CodicePiattaforma=&quot;SBR&quot;;&#xD;
							}&#xD;
						}&#xD;
						else{&#xD;
							CodicePiattaforma=&quot;SBL&quot;;&#xD;
						}&#xD;
						if(localRequest.ordine.PIVA!= null &amp;&amp; localRequest.ordine.PIVA!=&quot;&quot;|| (assetFonia.cliente != null &amp;&amp; assetFonia.cliente.partitaIVA!= null &amp;&amp; assetFonia.cliente.partitaIVA!=&quot;&quot;)){&#xD;
							CodicePiattaforma=&quot;SBL&quot;;&#xD;
						}						&#xD;
					}					&#xD;
				}								&#xD;
				listaValoreOrdine_ARR.set(i, CodicePiattaforma);							&#xD;
			}&#xD;
			else if(listaAttributiOrdine_ARR.get(i) ==&quot;IDRISORSAORIGINARIO&quot;){&#xD;
				//nessuna modifica è necessaria&#xD;
				listaValoreOrdine_ARR.set(i, ConsistenzaFoniaTemp.IDRisorsa);&#xD;
			}&#xD;
			&#xD;
			//fine logiche ---------------------------------------&#xD;
			else if(listaAttributiOrdine_ARR.get(i) == &quot;NUMLINEEMOV&quot;){&#xD;
				listaValoreOrdine_ARR.set(i, LavorazioneRichiesta.numeroLineeMov);&#xD;
			}&#xD;
			else{&#xD;
				// se non esistono casistiche esplicite, sono riportati nell'ordine i valori presenti in asset&#xD;
				listaValoreOrdine_ARR.set(i, listaValoreAsset_ARR.get(i));&#xD;
			}			&#xD;
		}&#xD;
		&#xD;
		//CAMBIO COPPIA&#xD;
		else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULL || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATI || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA)&#xD;
			&amp;&amp;&#xD;
			localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOCOPPIA &#xD;
			&amp;&amp; (listaAttributiOrdine_ARR.get(i) == &quot;POSIZIONEPERMUTATORE1&quot;&#xD;
				|| listaAttributiOrdine_ARR.get(i) == &quot;POSIZIONEPERMUTATORE2&quot;)){&#xD;
			&#xD;
			listaValoreOrdine_ARROld.set(i, listaValoreAsset_ARR.get(i));						&#xD;
		}&#xD;
													&#xD;
		//VARIAZIONE DESTINAZIONE USO&#xD;
		else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULL || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLU || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA)&#xD;
			&amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONEDESTINAZIONEUSO&#xD;
			&amp;&amp; listaAttributiOrdine_ARR.get(i) == &quot;DESTINAZIONEUSO&quot;){&#xD;
								&#xD;
				listaValoreOrdine_ARROld.set(i, listaValoreAsset_ARR.get(i));&#xD;
		}&#xD;
		else if(listaAttributiOrdine_ARR.get(i) ==&quot;IDRISORSAORIGINARIO&quot;){&#xD;
				//nessuna modifica è necessaria&#xD;
				listaValoreOrdine_ARR.set(i, ConsistenzaFoniaTemp.IDRisorsa);&#xD;
		}&#xD;
		else if(listaAttributiOrdine_ARR.get(i) == &quot;BITRATE&quot; &amp;&amp; listaValoreOrdine_ARR.get(i) == &quot;ATTRIBUTO IN ELIMINAZIONE&quot;){&#xD;
			listaValoreOrdine_ARROld.set(i, listaValoreAsset_ARR.get(i));&#xD;
			Process.auditLog(&quot;BITRATE in ELIMINAZIONE - assegnato valoreOLD = &quot; + listaValoreAsset_ARR.get(i));&#xD;
		}&#xD;
		//RU_1317: PROPRIETAMATERIALE &#xD;
		else if(listaAttributiOrdine_ARR.get(i) == &quot;PROPRIETAMATERIALE&quot;){&#xD;
			//Se non c'è in LavorazioneRichiesta non deve arricchire dall'asset, quindi lo faccio entrare in questo else if così non va nell'else finale &#xD;
			if(LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.proprietaMateriale != null){&#xD;
				listaValoreOrdine_ARR.set(i,LavorazioneRichiesta.proprietaMateriale);&#xD;
			}&#xD;
		}&#xD;
		//RU_1390: FLAGEQUIVALENZAPRODOTTI &#xD;
		else if(listaAttributiOrdine_ARR.get(i) == &quot;FLAGEQUIVALENZAPRODOTTI&quot;){&#xD;
			//Se non c'è in LavorazioneRichiesta non deve arricchire dall'asset&#xD;
			if(LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.flagEquivalenzaProdotti != null){&#xD;
				listaValoreOrdine_ARR.set(i,LavorazioneRichiesta.flagEquivalenzaProdotti);&#xD;
			}&#xD;
		}&#xD;
		else{&#xD;
			// In assenza di altre logiche, si aggiunge il valore presente nella consistenza sono nel caso in cui l'attributo non è presente in input	&#xD;
			listaValoreOrdine_ARR.set(i,listaValoreAsset_ARR.get(i));	&#xD;
		}	&#xD;
	}	&#xD;
	&#xD;
	//------------------Aggiornamento Ordine-------------------&#xD;
	// rispetto alla configurazione si arricchisce l'ordine della richiesta&#xD;
	var attrCampione = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attrCampione.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	attrCampione.created = data;&#xD;
	attrCampione.lastUpdate = data;&#xD;
	attrCampione.operatore = localRequest.operatore;&#xD;
	attrCampione.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
		var compOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		//-------ACCESSOWLR----&#xD;
		if(String(compOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;){&#xD;
			//Si cerca di aggiornare il valore se present in input&#xD;
			for(var j=0; j&lt;compOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributoOrdine = compOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				//----------Modifica attributi presenti&#xD;
				for(var k =0; k&lt;listaAttributiOrdine_ARR.size();k++){&#xD;
					if(listaComponenti_ARR.get(k) == &quot;ACCESSO&quot; &amp;&amp; listaAttributiDaAggiungere_ARR.get(k) == true &amp;&amp; attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine_ARR.get(k)))&#xD;
					{	&#xD;
						if(listaValoreOrdine_ARR.get(k)!=&quot;&quot;){&#xD;
							attributoOrdine.lastUpdate = data;&#xD;
							attributoOrdine.valoreAttributo = listaValoreOrdine_ARR.get(k);&#xD;
							&#xD;
							if(listaValoreOrdine_ARROld.get(k)!=&quot;&quot;){&#xD;
								attributoOrdine.valoreAttributoOLD = listaValoreOrdine_ARROld.get(k);&#xD;
							}&#xD;
						}&#xD;
						listaAttributiDaAggiungere_ARR.set(k, false);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			// Se non presente in input si aggiungono tutti gli attributi, previsti dalla configurazione, per i quali è stato recuperato un valore ammissibile&#xD;
			for(var k =0; k&lt;listaAttributiOrdine_ARR.size();k++)&#xD;
			{&#xD;
				if(listaComponenti_ARR.get(k) == &quot;ACCESSO&quot; &amp;&amp; listaAttributiDaAggiungere_ARR.get(k) == true)&#xD;
				{&#xD;
					if(listaValoreOrdine_ARR.get(k)!=&quot;&quot;){&#xD;
						var attrtemp = ScriptUtil.copy(attrCampione);&#xD;
						attrtemp.IDDettaglioOrdine = compOrdine.IDDettaglioOrdine;&#xD;
						attrtemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(listaAttributiOrdine_ARR.get(k));&#xD;
						attrtemp.valoreAttributo = listaValoreOrdine_ARR.get(k);&#xD;
						compOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attrtemp));&#xD;
					}&#xD;
					else{&#xD;
						Process.auditLog(&quot;Impossibile arricchire l'ordine con l'elemento &quot;+listaAttributiOrdine_ARR.get(k)+&quot; perchè non presente in consistenza&quot;);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//C01M02F12 Recupero DISTRETTO/IDCONTRATTO/CLIENTE/CLLI DA ASSET&#xD;
	if (assetFonia.distretto != null &amp;&amp; assetFonia.distretto.length > 0){&#xD;
		localRequest.ordine.distretto = assetFonia.distretto;&#xD;
	}&#xD;
	if (assetFonia.CLLI != null &amp;&amp; assetFonia.CLLI.length > 0 &amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCO){&#xD;
		localRequest.ordine.CLLI = assetFonia.CLLI;&#xD;
	}&#xD;
	if (assetFonia.IDContratto != null){&#xD;
		localRequest.IDContratto = assetFonia.IDContratto;&#xD;
	}&#xD;
	&#xD;
	if(assetFonia.cliente != null &amp;&amp; localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR20&#xD;
	    &amp;&amp; localRequest.ordine.nome == null &#xD;
		&amp;&amp; localRequest.ordine.cognomeRagioneSociale == null &#xD;
		&amp;&amp; localRequest.ordine.CF == null&#xD;
		&amp;&amp; localRequest.ordine.PIVA == null)   //Task #38239&#xD;
	{&#xD;
		if (assetFonia.cliente.nome != null &amp;&amp; (localRequest.ordine.nome == null || localRequest.ordine.nome == &quot;&quot;)){&#xD;
			localRequest.ordine.nome = assetFonia.cliente.nome;&#xD;
		}		&#xD;
		if (assetFonia.cliente.cognomeRagioneSociale != null &amp;&amp; (localRequest.ordine.cognomeRagioneSociale == null || localRequest.ordine.cognomeRagioneSociale == &quot;&quot;)){&#xD;
			localRequest.ordine.cognomeRagioneSociale = assetFonia.cliente.cognomeRagioneSociale;&#xD;
		}&#xD;
		&#xD;
		//SM_10686: Spostato arricchimento dei due campi qui invece che negli arricchimenti comuni&#xD;
		//CF e PIVA sono mutuamente esclusivi e non vanno arricchiti se uno dei due è indicato in input dall'OLO&#xD;
		if(localRequest.ordine.CF == null &amp;&amp; localRequest.ordine.PIVA == null){				&#xD;
			localRequest.ordine.CF = assetFonia.cliente.codiceFiscale;&#xD;
			localRequest.ordine.PIVA = assetFonia.cliente.partitaIVA;			&#xD;
		}&#xD;
	}		&#xD;
}&#xD;
else{&#xD;
	Process.auditLog(&quot;Nessun Asset Recuperato&quot;);&#xD;
}&#xD;
&#xD;
//SM_8910: cancellazione attributo QUANTITALINEE&#xD;
if((localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOCANALI || localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOCANALI) &#xD;
	&amp;&amp; ((localRequest.ordine.tipologiaLinea != null &amp;&amp; localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN) || (TIPOLINEA != null &amp;&amp; TIPOLINEA == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN))&#xD;
	&amp;&amp; (STRUTTURALINEA == &quot;PBX&quot; || STRUTTURALINEA == &quot;GNR&quot;))&#xD;
	{&#xD;
	for(var i=0; i &lt; localRequest.ordine.dettaglioordine.size(); i++){&#xD;
		var compOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(compOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
		{&#xD;
			for(var j=0; j&lt;compOrdine.attributiDettaglioOrdine.size(); j++){&#xD;
				var attributoOrdine = compOrdine.attributiDettaglioOrdine.get(j);&#xD;
				if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITALINEE)&#xD;
				{&#xD;
					compOrdine.attributiDettaglioOrdine.remove(j);&#xD;
					Process.auditLog(&quot;Cancellato attributo QUANTITALINEE per VAR ACCESSOWLR LNA ISDN.&quot;);&#xD;
				}		&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}	 </xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="77.0" LaneId="_7Zu7gfwjEeapT_T8svBRzg" Width="127.0">
              <xpdl2:Coordinates XCoordinate="3080.0" YCoordinate="1100.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_aSyUwQ8nEeeXv8RtwyZtwQ" Name="ArricchimentoperSottoLavorazione" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento per Sotto Lavorazione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var data = DateTimeUtil.createDatetime();&#xD;
&#xD;
//Valorizza ACCESSO&#xD;
var i=0;&#xD;
while(i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
	var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
	if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR){&#xD;
		&#xD;
		if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR20&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR12&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR5 // SM_8501 (WLR5/6/7 messa azione ad N)&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR6&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR7){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
		}&#xD;
		else if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTSMULTINUMERO&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CESSAZIONESTSMULTINUMERO&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOCANALI&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOCANALI&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOBORCHIA&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOBORCHIA&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR10&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR11&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR8&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR9&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR18&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR19&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTS&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CESSAZIONESTS&#xD;
		){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
		}&#xD;
		else if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIONUMERO3&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIONUMERO4&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR13&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR14&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR15&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR16&#xD;
		){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
		}&#xD;
		&#xD;
	}&#xD;
	else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULL){&#xD;
		&#xD;
		if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOCOPPIA&#xD;
		|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONEDESTINAZIONEUSO){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
		}&#xD;
		else if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCO ){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
		}&#xD;
		//RU_914 cambiata azione ad A per DECREMENTONP&#xD;
		else if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTONP){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
		}&#xD;
		else if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOULL){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		}&#xD;
	}&#xD;
	else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSHA){&#xD;
		&#xD;
		if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOCOPPIA){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
		}		&#xD;
	}&#xD;
	else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULLDATI){&#xD;
		&#xD;
		if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOCOPPIA){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
		}&#xD;
		else if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCO ){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
		}&#xD;
		//RU_914 cambiata azione ad A per DECREMENTONP&#xD;
		else if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTONP){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
		}&#xD;
		else if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOULL){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		}&#xD;
	}&#xD;
	else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU){&#xD;
		if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONEDESTINAZIONEUSO){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
		}&#xD;
		//RU_914 cambiata azione ad A per DECREMENTONP&#xD;
		else if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTONP){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
		}&#xD;
		else if(localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOSLU){&#xD;
			comp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		}	&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
&#xD;
// recupera Asset&#xD;
if(ConsistenzaFonia != null &amp;&amp; assetFonia!= null){&#xD;
	Process.auditLog(&quot;Arricchimento per SottoLavorazione, asset: &quot;+ ConsistenzaFonia.IDAsset);&#xD;
	&#xD;
	//-----------------------------------&#xD;
	var componenteTemp = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
	componenteTemp.IDDettaglioOrdineParent = 1;&#xD;
	componenteTemp.IDDettaglioOrdineRoot = 1;&#xD;
	componenteTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	componenteTemp.created = data;&#xD;
	componenteTemp.lastUpdate = data;&#xD;
	componenteTemp.operatore = &quot;BPM&quot;;&#xD;
	&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	attributo.created = data;&#xD;
	attributo.lastUpdate =data;&#xD;
	attributo.operatore = &quot;BPM&quot;;&#xD;
	attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
	&#xD;
	//-------------------------------------------ATTIVAZIONESTS - CESSAZIONESTS--------------------------------------&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTS&#xD;
	|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CESSAZIONESTS)&#xD;
	{&#xD;
		&#xD;
		for(var i=0; i&lt;assetFonia.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var compAsset = assetFonia.dettaglioasset.get(i);&#xD;
			&#xD;
			if(compAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS &amp;&amp; compAsset.statoDettaglioAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO)&#xD;
			{&#xD;
				var componente = ScriptUtil.copy(componenteTemp);&#xD;
				componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS;&#xD;
				componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
				componente.integrationID = localRequest.IDRichiestaOLO + componente.IDDettaglioOrdine;&#xD;
				componente.progressivo = compAsset.progressivo;				&#xD;
				&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				&#xD;
				var codiceSTSpresente = false; //SM_8871&#xD;
				var j = 0;&#xD;
				while(j&lt;compAsset.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attr = compAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE)&#xD;
					{&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						//SM_8871&#xD;
						codiceSTSpresente = (localRequest.codiceSTS == attr.valoreAttributo);&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONE)&#xD;
					{&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONE;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEDTU)&#xD;
					{&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEDTU;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO)&#xD;
					{&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
				&#xD;
				//SM_8871 modificata condizione per aggiungere codiceSTSpresente&#xD;
				if(codiceSTSpresente &amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CESSAZIONESTS){&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
				} else {&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
				}&#xD;
				&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
			}&#xD;
			if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA)&#xD;
			&amp;&amp; compAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
			{		&#xD;
				var componente = ScriptUtil.copy(componenteTemp);&#xD;
				componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO;&#xD;
				componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
				componente.IDRisorsa = comp.IDRisorsa;&#xD;
				componente.IDRisorsaNOW = comp.IDRisorsaNOW;&#xD;
				&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
				componente.integrationID = localRequest.IDRichiestaOLO + componente.IDDettaglioOrdine;&#xD;
				componente.progressivo = compAsset.progressivo;&#xD;
&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				&#xD;
				var j=0;&#xD;
				var statoAggiuntivo = &quot;&quot;;&#xD;
				statoAggiuntivo = null;&#xD;
				&#xD;
				var numAggiuntivo = &quot;&quot;;&#xD;
                numAggiuntivo = null;&#xD;
				&#xD;
				while(j&lt;compAsset.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attr = compAsset.attributidettaglioasset.get(j);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
					{&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						numAggiuntivo = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE)&#xD;
					{&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO)&#xD;
					{&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						statoAggiuntivo = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}					&#xD;
					j++;&#xD;
				}&#xD;
				&#xD;
				if(statoAggiuntivo == &quot;ATTIVO&quot;) //SM_8701&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
				}&#xD;
				else&#xD;
                {&#xD;
                    Process.auditLog(&quot;AGGIUNTIVO &quot;+numAggiuntivo+&quot; non arricchito, stato &quot;+statoAggiuntivo);&#xD;
                }&#xD;
			}		&#xD;
		}&#xD;
		&#xD;
		&#xD;
	}&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTS){&#xD;
		STSDaAggiungere = localRequest.codiceSTS;&#xD;
	}&#xD;
	&#xD;
	&#xD;
		&#xD;
	// -----------------------------------ATTIVAZIONE/CESSAZIONE STSMULTINUMERO --------------------------------------------------------------&#xD;
	//-------------------------------------------INCREMENTO/DECREMENTO CANALI----------------------------------------&#xD;
&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTSMULTINUMERO&#xD;
	|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CESSAZIONESTSMULTINUMERO&#xD;
	|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOCANALI&#xD;
	|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOCANALI)&#xD;
	{&#xD;
	&#xD;
		for(var i=0; i&lt;assetFonia.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var compAsset = assetFonia.dettaglioasset.get(i);&#xD;
			&#xD;
			if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA)&#xD;
			&amp;&amp; compAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
			{		&#xD;
				var componente = ScriptUtil.copy(componenteTemp);&#xD;
				componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO;&#xD;
				componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
				componente.IDRisorsa = comp.IDRisorsa;&#xD;
				componente.IDRisorsaNOW = comp.IDRisorsaNOW;&#xD;
				componente.integrationID = localRequest.IDRichiestaOLO + componente.IDDettaglioOrdine;&#xD;
				componente.progressivo = compAsset.progressivo;&#xD;
				&#xD;
				var numeroTelefonico =&quot;&quot;;&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;	&#xD;
				&#xD;
				var j=0;&#xD;
				var statoAggiuntivo = &quot;&quot;;&#xD;
				statoAggiuntivo = null;&#xD;
				&#xD;
				while(j&lt;compAsset.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attr = compAsset.attributidettaglioasset.get(j);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
					{&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						numeroTelefonico = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE)&#xD;
					{&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO)&#xD;
					{&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						statoAggiuntivo = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}					&#xD;
					j++;&#xD;
				}&#xD;
				&#xD;
				if(localRequest.DNAggiuntivo.contains(numeroTelefonico) &amp;&amp;  localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CESSAZIONESTSMULTINUMERO){&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
				}&#xD;
				else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOCANALI &amp;&amp; compAsset.statoDettaglioAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO){&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
				}			&#xD;
				&#xD;
				if(statoAggiuntivo == &quot;ATTIVO&quot;) //SM_8701&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					Process.auditLog(&quot;AGGIUNTIVO &quot;+numeroTelefonico+&quot; non arricchito, stato &quot;+statoAggiuntivo);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA)&#xD;
			&amp;&amp; compAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS)&#xD;
			{&#xD;
				var componente = ScriptUtil.copy(componenteTemp);&#xD;
				componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS;&#xD;
				componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
				componente.integrationID = localRequest.IDRichiestaOLO + componente.IDDettaglioOrdine;&#xD;
				componente.progressivo = compAsset.progressivo;&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				&#xD;
				var j = 0;&#xD;
				while(j&lt;compAsset.attributidettaglioasset.size()){&#xD;
					var attr = compAsset.attributidettaglioasset.get(j);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE){&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONE){&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONE;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEDTU){&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEDTU;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO){&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}&#xD;
					&#xD;
					j++;&#xD;
				}&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
	&#xD;
	//---------------------------------------------INCREMENTO/DECREMENTO BORCHIA----------------------------&#xD;
	//----------------------------------------------PRESTAZIONI WLR-----------------------------------------&#xD;
	//----------------------------------------------PRESTAZIONI WLR 20 --------------------------------------&#xD;
	//----------------------------------------------CAMBIO TIPOLOGIA----------------------------&#xD;
	//----------------------------------------------TRASLOCO WLR --------TRASLOCOWLR12--------------------------&#xD;
	//Si copiano le componenti STS e AGGIUNTIVO con azione N  nessuna logica specifica&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOBORCHIA&#xD;
	|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOBORCHIA&#xD;
	|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR5&#xD;
	|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR6&#xD;
	|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR7&#xD;
	|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR18&#xD;
	|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR19&#xD;
	|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRESTAZIONEWLR20&#xD;
	|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR10&#xD;
	|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR11&#xD;
	|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR8&#xD;
	|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOLOGIAWLR9&#xD;
	|| localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR12)&#xD;
	{&#xD;
	&#xD;
		for(var i=0; i&lt;assetFonia.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var compAsset = assetFonia.dettaglioasset.get(i);&#xD;
			if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA)&#xD;
			&amp;&amp; compAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
			{		&#xD;
				var componente = ScriptUtil.copy(componenteTemp);&#xD;
				componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO;&#xD;
				componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
				componente.integrationID = localRequest.IDRichiestaOLO + componente.IDDettaglioOrdine;&#xD;
				componente.IDRisorsa = comp.IDRisorsa;&#xD;
				componente.IDRisorsaNOW = comp.IDRisorsaNOW;&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;			&#xD;
				componente.progressivo = compAsset.progressivo;&#xD;
				&#xD;
				var j=0;&#xD;
				var statoAggiuntivo = &quot;&quot;;&#xD;
				statoAggiuntivo = null;&#xD;
				&#xD;
				var numAggiuntivo = &quot;&quot;;&#xD;
				numAggiuntivo = null;&#xD;
				&#xD;
				while(j&lt;compAsset.attributidettaglioasset.size()){&#xD;
					var attr = compAsset.attributidettaglioasset.get(j);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
					{&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
						attributo.valoreAttributo = attr.valoreAttributo;&#xD;
