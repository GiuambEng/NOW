        <xpdl2:Activity Id="_wj-98s9REeuiTvC7jzwBcg" Name="ArricchimentoDettaglioOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Aggiunto script con RU_1180&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	//SM_10232: per CANALEESISTENTEOLT, CODICETDKIT va recuperato dalla ConsistenzaCanale&#xD;
	var CODICETDKIT = &quot;&quot;;&#xD;
	CODICETDKIT = null;&#xD;
&#xD;
	if(ConsistenzaCanale != null &amp;&amp; ConsistenzaCanale.IDAsset != null&#xD;
	   &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CANALEESISTENTEOLT)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaCanale.IDAsset));&#xD;
		&#xD;
		if(AssetRef != null)&#xD;
		{&#xD;
			Asset = AssetRef.readAsset();&#xD;
		}&#xD;
&#xD;
		if(Asset != null)&#xD;
		{&#xD;
			for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
			{&#xD;
				var dettaglioAsset = Asset.dettaglioasset.get(i);&#xD;
				&#xD;
				if(String(dettaglioAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					for(var j=0; j&lt;dettaglioAsset.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var attributoDettaglioAsset = dettaglioAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(attributoDettaglioAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
						{&#xD;
							CODICETDKIT = attributoDettaglioAsset.valoreAttributo;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	//solito (altre sottolav con offerta CANALE)&#xD;
	else if(ConsistenzaFeeder != null &amp;&amp; ConsistenzaFeeder.codiceTdKit != null)&#xD;
	{&#xD;
		CODICETDKIT = ConsistenzaFeeder.codiceTdKit;&#xD;
	}&#xD;
	&#xD;
	//CONFIGURAZIONE AZIONE&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CREAZIONECANALEFEEDER&#xD;
			   ||localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
			}	&#xD;
			else if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CANALEESISTENTEFEEDER&#xD;
			        ||localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CANALEESISTENTEOLT)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
			}				&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
&#xD;
	//ARRICCHIMENTO&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		//Componente ACCESSO&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{		&#xD;
			var foundCODICETDKIT = false;&#xD;
			var foundIDMADRCRMWS = false;&#xD;
			var foundCODICEMACROAREA = false;&#xD;
			var foundNOMEMACROAREA = false;&#xD;
			var foundIDRISORSAFEEDER = false;&#xD;
			var foundIDRISORSASEDEOLT = false;&#xD;
			var foundIPMULTICAST = false;  //SM_10239&#xD;
			var foundIPSORGENTE = false;   //SM_10239&#xD;
&#xD;
			&#xD;
			//Arricchimento attributi se presenti nell'ordine&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT&#xD;
				   &amp;&amp; CODICETDKIT != null)&#xD;
				{&#xD;
					foundCODICETDKIT = true;&#xD;
					attributo.valoreAttributo = CODICETDKIT;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICETDKIT&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS&#xD;
				   &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.idMadrCrmws != null)&#xD;
				{&#xD;
					foundIDMADRCRMWS = true;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.idMadrCrmws;&#xD;
