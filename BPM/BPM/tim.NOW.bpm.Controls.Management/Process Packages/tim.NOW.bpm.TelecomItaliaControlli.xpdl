            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_0ucp4Kt9Ee24JI2fFDerRA" Name="AssetLock" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Asset Lock">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_Jh44IOLtEeaoOL-mvUhWhw" PackageRef="tim.NOW.bpm.TelecomItaliaMainProject.Interfaces" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="action">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;LOCK&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_6pqwISv5EeyVBMucdpSJQg" Width="128.0">
              <xpdl2:Coordinates XCoordinate="587.0" YCoordinate="164.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier = &quot;/tim.NOW.bpm.TelecomItaliaMainProject/Process Packages/tim.NOW.bpm.TelecomItaliaSupporting.xpdl.TINOWAssetLockUnlock&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_-U0uQKt9Ee24JI2fFDerRA" Name="CallEnrichmentSede" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Call EnrichmentSede">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_h5UAUDV-Eee1ULNyFeCSXQ" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="Asset">
                  <xpdl2:Actual ScriptGrammar="JavaScript">AssetRef</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="EnrichmentSedeOutput">
                  <xpdl2:Actual ScriptGrammar="JavaScript">EnrichmentSedeOutput</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_6pqwISv5EeyVBMucdpSJQg" Width="128.0">
              <xpdl2:Coordinates XCoordinate="1147.0" YCoordinate="318.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier=&quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.EnrichmentSede&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
