        <xpdl2:Activity Id="_yAwBlxB5Eeyx1J_VnXlGew" Name="ArricchimentoDettaglioOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Script inserito con RU_1203&#xD;
var data = DateTimeUtil.createDatetime();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; ConsistenzaNPNG != null)&#xD;
{&#xD;
	//SM_10459&#xD;
	if(ConsistenzaNPNG.IDAsset != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaNPNG.IDAsset, 10));&#xD;
	}&#xD;
&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		var asset = AssetRef.readAsset();&#xD;
		&#xD;
		if (asset.distretto != null &amp;&amp; asset.distretto.length > 0)&#xD;
		{&#xD;
			localRequest.ordine.distretto = asset.distretto;&#xD;
		}&#xD;
	}	&#xD;
	&#xD;
	//AGGIORNAMENTO/CREAZIONE COMPONENTE ACCESSO&#xD;
	var foundACCESSO = false;&#xD;
	var i=0;&#xD;
	&#xD;
	var foundUO = false;&#xD;
	var foundTIPOMOVIMENTAZIONE = false;&#xD;
	var foundCODICEULTIMAFATTURA = false;&#xD;
	var foundCODICEPENULTIMAFATTURA = false;&#xD;
	&#xD;
	//SE TROVIAMO LA COMPONENTE ACCESSO&#xD;
	while(!foundACCESSO &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			foundACCESSO = true;&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;  &#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				//UO&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.UO&#xD;
				   &amp;&amp; ConsistenzaNPNG.UO != null)&#xD;
				{&#xD;
					foundUO = true;&#xD;
					attributo.valoreAttributo = ConsistenzaNPNG.UO;&#xD;
					Process.auditLog(&quot;Aggiornato attributo UO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//TIPOMOVIMENTAZIONE&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOMOVIMENTAZIONE&#xD;
				        &amp;&amp; ConsistenzaNPNG.tipoMovimentazione != null)&#xD;
				{&#xD;
					foundTIPOMOVIMENTAZIONE = true;&#xD;
					attributo.valoreAttributo = ConsistenzaNPNG.tipoMovimentazione;&#xD;
					Process.auditLog(&quot;Aggiornato attributo TIPOMOVIMENTAZIONE&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//CODICEULTIMAFATTURA&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEULTIMAFATTURA&#xD;
				        &amp;&amp; ConsistenzaNPNG.codiceUltimaFattura != null)&#xD;
				{&#xD;
					foundCODICEULTIMAFATTURA = true;&#xD;
					attributo.valoreAttributo = ConsistenzaNPNG.codiceUltimaFattura;&#xD;
					Process.auditLog(&quot;Aggiornato attributo CODICEULTIMAFATTURA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//CODICEPENULTIMAFATTURA&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPENULTIMAFATTURA&#xD;
				        &amp;&amp; ConsistenzaNPNG.codicePenultimaFattura != null)&#xD;
				{&#xD;
					foundCODICEPENULTIMAFATTURA = true;&#xD;
					attributo.valoreAttributo = ConsistenzaNPNG.codicePenultimaFattura;&#xD;
					Process.auditLog(&quot;Aggiornato attributo CODICEPENULTIMAFATTURA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}			&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	//SE NON TROVIAMO LA COMPONENTE ACCESSO&#xD;
	if(!foundACCESSO)&#xD;
	{&#xD;
		var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
		componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componente.IDRisorsa= ConsistenzaNPNG.IDRisorsa;&#xD;
		componente.IDRisorsaNOW = ConsistenzaNPNG.IDRisorsaNOW;&#xD;
		componente.created = data;&#xD;
		componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
		componente.lastUpdate = data;&#xD;
		componente.operatore = &quot;BPM&quot;;&#xD;
		componente.progressivo = 1;&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONPNG;	&#xD;
	}&#xD;
&#xD;
	//SE NON TROVIAMO GLI ATTRIBUTI&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
	attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
	attributo.created = data;&#xD;
	attributo.lastUpdate = data;&#xD;
	attributo.operatore = &quot;BPM&quot;;&#xD;
	&#xD;
	//UO&#xD;
	if(!foundUO &amp;&amp; ConsistenzaNPNG.UO != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.UO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaNPNG.UO;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//TIPOMOVIMENTAZIONE&#xD;
	if(!foundTIPOMOVIMENTAZIONE &amp;&amp; ConsistenzaNPNG.tipoMovimentazione != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOMOVIMENTAZIONE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaNPNG.tipoMovimentazione;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//CODICEULTIMAFATTURA&#xD;
	if(!foundCODICEULTIMAFATTURA &amp;&amp; ConsistenzaNPNG.codiceUltimaFattura != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEULTIMAFATTURA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaNPNG.codiceUltimaFattura;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//CODICEPENULTIMAFATTURA&#xD;
	if(!foundCODICEPENULTIMAFATTURA &amp;&amp; ConsistenzaNPNG.codicePenultimaFattura != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPENULTIMAFATTURA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaNPNG.codicePenultimaFattura;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	&#xD;
	//Se non ha trovato la componente ACCESSO, allora va aggiunta quella che abbiamo creato&#xD;
	if(!foundACCESSO)&#xD;
	{&#xD;
		localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
