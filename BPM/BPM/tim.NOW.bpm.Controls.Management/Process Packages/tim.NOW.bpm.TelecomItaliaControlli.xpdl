				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICERO;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = InventoryResponse.CRMWSResponse.tipo_Linea.codice_RO;&#xD;
					&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//NUMBERPORTABILITY.TOTALELINEE&#xD;
			if(InventoryResponse != null &amp;&amp; InventoryResponse.CRMWSResponse != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea != null &amp;&amp; InventoryResponse.CRMWSResponse.tipo_Linea.qta_linee != null)&#xD;
			{&#xD;
				if(foundTOTALELINEE)&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexTOTALELINEE).valoreAttributo = InventoryResponse.CRMWSResponse.tipo_Linea.qta_linee;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TOTALELINEE;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.NUMBER;&#xD;
					attributo.valoreAttributo = InventoryResponse.CRMWSResponse.tipo_Linea.qta_linee;&#xD;
					&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//NUMBERPORTABILITY.OLORETAILER&#xD;
			if(OLORETAILER != null &amp;&amp; OLORETAILER != &quot;&quot; &#xD;
			&amp;&amp; (OLORETAILER != localRequest.codificaOLOAGCOM || (OLORETAILER == 'INF' &amp;&amp; localRequest.codificaOLOAGCOM == 'WIN'))) // Task 25392&#xD;
			{&#xD;
				if(foundOLORETAILER)&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexOLORETAILER).valoreAttributo = OLORETAILER;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = OLORETAILER;&#xD;
				&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//NUMBERPORTABILITY.CODICEOPERATOREDONATING&#xD;
			if(CODICEOPERATOREDONATING != null &amp;&amp; CODICEOPERATOREDONATING != &quot;&quot;) // SM_8493 - se in seconda portabilità valorizzare con OLORETAILER (vedi parte iniziale dello script)&#xD;
			{&#xD;
				if(foundCODICEOPERATOREDONATING)&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexCODICEOPERATOREDONATING).valoreAttributo = CODICEOPERATOREDONATING;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = CODICEOPERATOREDONATING;&#xD;
				&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}				&#xD;
				&#xD;
			}&#xD;
			else if(InventoryResponse != null &amp;&amp; InventoryResponse.CRMWSResponse != null &amp;&amp; InventoryResponse.CRMWSResponse.donating != null)&#xD;
			{&#xD;
				if(foundCODICEOPERATOREDONATING)&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexCODICEOPERATOREDONATING).valoreAttributo = InventoryResponse.CRMWSResponse.donating;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = InventoryResponse.CRMWSResponse.donating;&#xD;
					&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
			}&#xD;
			// SM_6662 - se non presente da UNICA si reperisce il CODICEOPERATOREDONATING dalla consistenza -nel caso in cui non sia presente in consistenza valorizzo a TLC&#xD;
			else if (ConsistenzaFonia != null)&#xD;
			{&#xD;
				AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaFonia.IDAsset));&#xD;
				&#xD;
				var CodiceOperatoreDonatingAsset = &quot;&quot;;&#xD;
				&#xD;
				if (AssetRef!=null)&#xD;
				{&#xD;
					Asset = AssetRef.readAsset();&#xD;
					&#xD;
					var k=0;&#xD;
					&#xD;
					while(CodiceOperatoreDonatingAsset == &quot;&quot; &amp;&amp; k &lt; Asset.dettaglioasset.size())&#xD;
					{&#xD;
						var currentComponenteAsset = Asset.dettaglioasset.get(k);&#xD;
						&#xD;
						if (currentComponenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
						{&#xD;
							for (var h=0; h&lt;currentComponenteAsset.attributidettaglioasset.size(); h++)&#xD;
							{&#xD;
								var currentAttribAsset = currentComponenteAsset.attributidettaglioasset.get(h);&#xD;
								&#xD;
								if (currentAttribAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING)&#xD;
								{&#xD;
									CodiceOperatoreDonatingAsset = currentAttribAsset.valoreAttributo;&#xD;
									&#xD;
								}&#xD;
							}&#xD;
							&#xD;
						}&#xD;
					&#xD;
						k++;&#xD;
					}&#xD;
					&#xD;
					//Bug #39254: se non è stato ancora trovato, il CODICEOPERATOREDONATING va recuperato dalla CODIFICAOLOAGCOM in chiaro nell'asset FONIA per questi scenari&#xD;
					if(CodiceOperatoreDonatingAsset == &quot;&quot;&#xD;
					   &amp;&amp; (localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUWLR&#xD;
					       ||localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUVULL&#xD;
						   ||localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUAGGWLR))&#xD;
					{&#xD;
						CodiceOperatoreDonatingAsset = Asset.codificaOLOAGCOM;&#xD;
					}&#xD;
					&#xD;
					&#xD;
					if(foundCODICEOPERATOREDONATING)&#xD;
					{&#xD;
						if (CodiceOperatoreDonatingAsset!= null &amp;&amp; CodiceOperatoreDonatingAsset!= '')&#xD;
						{&#xD;
							localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexCODICEOPERATOREDONATING).valoreAttributo = CodiceOperatoreDonatingAsset;&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexCODICEOPERATOREDONATING).valoreAttributo = &quot;TLC&quot;;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					else&#xD;
					{&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING;&#xD;
						attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						&#xD;
						&#xD;
						if (CodiceOperatoreDonatingAsset!= null &amp;&amp; CodiceOperatoreDonatingAsset!= '')&#xD;
						{	&#xD;
							attributo.valoreAttributo = CodiceOperatoreDonatingAsset;&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							attributo.valoreAttributo = &quot;TLC&quot;;&#xD;
						}&#xD;
						&#xD;
						localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));						&#xD;
					}&#xD;
&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			else &#xD;
			{&#xD;
				&#xD;
				if(foundCODICEOPERATOREDONATING)&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexCODICEOPERATOREDONATING).valoreAttributo = &quot;TLC&quot;;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = &quot;TLC&quot;;&#xD;
					&#xD;
