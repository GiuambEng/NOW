					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//valorizza valoreOldEncapsulation dalla componente ACCESSO dell'Asset&#xD;
			if(!foundIntermediateagentfull &amp;&amp; !foundEncapsulation)&#xD;
