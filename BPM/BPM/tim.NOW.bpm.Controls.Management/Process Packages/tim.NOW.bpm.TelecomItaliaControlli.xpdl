            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(AssetRef != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest != null)&#xD;
{&#xD;
	var asset = AssetRef.readAsset();&#xD;
	localRequest.ordine.IDRisorsaNOW = asset.IDRisorsaNOW;&#xD;
	localRequest.ordine.numeroFittizio = asset.numeroFittizio;&#xD;
	&#xD;
}else{&#xD;
&#xD;
	Process.auditLog(&quot;Impossibile completare l'aggiornamento Ordine.IdRisorsaNow e Ordine.NumeroFittizio per IDRichiesta&quot; + localRequest.IDRichiestaOLO);&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
