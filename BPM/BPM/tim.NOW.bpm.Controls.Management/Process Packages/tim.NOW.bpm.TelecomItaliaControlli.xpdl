        <xpdl2:Activity Id="_JC6fsApWEeeu3aeX_vEnIg" Name="ArricchimentoOrdineMig" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Ordine Mig">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//AZIONE&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		//SHA&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA)&#xD;
		{&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSHA)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
		} &#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}		&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="93.0" LaneId="_5b_JBMaqEeaMptCxZGAaZg" Width="96.0">
              <xpdl2:Coordinates XCoordinate="602.0" YCoordinate="1599.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_Kf4v8krAEee2P7XNvAqwmg" Name="ArricchimentoOrdineAtt" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Ordine Att">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//C01M02F12 Recupero DISTRETTO/NUMEROFITTIZIO/IDCONTRATTO/CLIENTE&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.IDAsset != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaFonia.IDAsset, 10));&#xD;
	}&#xD;
	else if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
	}&#xD;
	&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		var asset = AssetRef.readAsset();&#xD;
		if(asset.distretto != null &amp;&amp; asset.distretto.length > 0)&#xD;
		{&#xD;
			localRequest.ordine.distretto = asset.distretto;&#xD;
		}&#xD;
		if(asset.IDContratto != null &amp;&amp; localRequest.IDContratto == null)&#xD;
		{&#xD;
			localRequest.IDContratto = asset.IDContratto;&#xD;
		}&#xD;
		if (asset.numeroFittizio != null &amp;&amp; asset.numeroFittizio.length > 0)&#xD;
		{&#xD;
			localRequest.ordine.numeroFittizio = asset.numeroFittizio;&#xD;
		}&#xD;
		if(asset.cliente !=null &#xD;
		&amp;&amp; (localRequest.ordine.nome == null || String(localRequest.ordine.nome).slice(0,2) != &quot;dk&quot;) &#xD;
		&amp;&amp; (localRequest.ordine.cognomeRagioneSociale == null || String(localRequest.ordine.cognomeRagioneSociale).slice(0,2) != &quot;dk&quot;))&#xD;
		{&#xD;
			if (asset.cliente.nome != null &amp;&amp; (localRequest.ordine.nome == null || localRequest.ordine.nome == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.nome = asset.cliente.nome;&#xD;
			}		&#xD;
			if (asset.cliente.cognomeRagioneSociale != null &amp;&amp; (localRequest.ordine.cognomeRagioneSociale == null || localRequest.ordine.cognomeRagioneSociale == &quot;&quot;))&#xD;
			{&#xD;
				localRequest.ordine.cognomeRagioneSociale = asset.cliente.cognomeRagioneSociale;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Consistenza Fonia o Dati non trovata.&quot;);&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="93.0" LaneId="_5b_JBMaqEeaMptCxZGAaZg" Width="96.0">
              <xpdl2:Coordinates XCoordinate="602.0" YCoordinate="1450.0"/>
            </xpdl2:NodeGraphicsInfo>
