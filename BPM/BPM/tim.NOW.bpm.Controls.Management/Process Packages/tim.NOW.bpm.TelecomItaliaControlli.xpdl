        <xpdl2:Activity Id="_K0yWsAo6Eeeu3aeX_vEnIg" Name="AggiornaComponenteMigrazioneOLO2OLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Aggiorna Componente Migrazione OLO2OLO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//C02M26F05 &#xD;
&#xD;
if(localRequest!= null &amp;&amp; localRequest.ordine!=null){&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		&#xD;
		//WLR LA&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA)&#xD;
		{&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR ||&#xD;
			componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS ||&#xD;
			componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			} &#xD;
			&#xD;
		} else&#xD;
		&#xD;
		//VULL LA&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL)&#xD;
		{&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULL ||&#xD;
			componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
			&#xD;
		}&#xD;
		 &#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
		&#xD;
		&#xD;
	}&#xD;
}&#xD;
//cerdo direzionalita strutturaLinea e tipolinea&#xD;
var valoredirezionalita = &quot;&quot;;&#xD;
valoredirezionalita = null;&#xD;
var valorestrutturaLinea = &quot;&quot;;&#xD;
valorestrutturaLinea = null;&#xD;
var valoretipolinea = &quot;&quot;;&#xD;
valoretipolinea = null;&#xD;
var accessoTrovato = false;&#xD;
var IDAccesso = 0;&#xD;
IDAccesso = null;&#xD;
var idRisorsaNaked = &quot;&quot;;&#xD;
idRisorsaNaked = null;&#xD;
&#xD;
&#xD;
var i=0;&#xD;
while(!accessoTrovato &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
	var component = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(component.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR&#xD;
		||component.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULL){&#xD;
		accessoTrovato = true;&#xD;
		IDAccesso = i;&#xD;
		var j=0;&#xD;
		while((valoredirezionalita==null || valorestrutturaLinea== null || valoretipolinea == null) &amp;&amp; j&lt;component.attributiDettaglioOrdine.size()){&#xD;
			if(component.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA){&#xD;
				valoredirezionalita = component.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
			}&#xD;
			else if(component.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA){&#xD;
				valorestrutturaLinea= component.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
			}&#xD;
			else if(component.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
				valoretipolinea= component.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
			}&#xD;
			else if(component.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSABTSNAKED){&#xD;
				idRisorsaNaked= component.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
// recupero tipolinea e strutturalinea da consistenza fonia se non present in input per offerte WLR&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA)&#xD;
&amp;&amp; (valorestrutturaLinea == null || valoretipolinea == null))&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaFonia.IDAsset));&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		Asset = AssetRef.readAsset();&#xD;
		var i=0;&#xD;
		while(i &lt; Asset.dettaglioasset.size())&#xD;
		{&#xD;
			var dettaglioAsset = Asset.dettaglioasset.get(i);&#xD;
			if(String(dettaglioAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
				var j=0;&#xD;
				&#xD;
				while((valorestrutturaLinea== null || valoretipolinea == null) &amp;&amp; j&lt;dettaglioAsset.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributoDettaglioAsset = dettaglioAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributoDettaglioAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA&#xD;
					&amp;&amp; valorestrutturaLinea== null)&#xD;
					{&#xD;
						valorestrutturaLinea = attributoDettaglioAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(attributoDettaglioAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA&#xD;
					&amp;&amp; valoretipolinea == null)&#xD;
					{&#xD;
						valoretipolinea = attributoDettaglioAsset.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
var valoreCodicePiattaforma = &quot;SBL&quot;;&#xD;
if(localRequest.ordine.CF != null &amp;&amp; localRequest.ordine.CF!= &quot;&quot;){&#xD;
&#xD;
	if(localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS&#xD;
		&amp;&amp; valoredirezionalita== null){&#xD;
		valoreCodicePiattaforma = &quot;SBR&quot;;&#xD;
	}&#xD;
	else if(localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN&#xD;
		&amp;&amp; valorestrutturaLinea == &quot;BraMono&quot;&#xD;
		&amp;&amp; valoredirezionalita== null){&#xD;
		valoreCodicePiattaforma = &quot;SBR&quot;;&#xD;
	}&#xD;
	else if(localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS&#xD;
		&amp;&amp; valorestrutturaLinea == &quot;Simplex&quot;&#xD;
		&amp;&amp; valoredirezionalita!= null){&#xD;
		valoreCodicePiattaforma = &quot;SBR&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
//Per ACCESSOWLR LA seguire C02M15F04 &#xD;
&#xD;
if(localRequest!= null &amp;&amp; localRequest.ordine!=null){&#xD;
	&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA){&#xD;
		&#xD;
		for(var k = 0; k &lt; localRequest.ordine.dettaglioordine.size(); k++){&#xD;
			&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(k);&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
			{&#xD;
				var flagCodePrestAgg = false;&#xD;
				var CODICEPIATTAFORMA = false;&#xD;
				var tipolineaTrovato = false;&#xD;
				var strutturaLineaTrovato = false;&#xD;
				var selezionePassanteTrovato = false;&#xD;
				&#xD;
				for(var z = 0; z &lt; componente.attributiDettaglioOrdine.size(); z++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(z);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEPRESTAGG)&#xD;
					{&#xD;
						flagCodePrestAgg = true;&#xD;
						attributo.valoreAttributo = &quot;43&quot;;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA)&#xD;
					{&#xD;
						CODICEPIATTAFORMA = true;&#xD;
						attributo.valoreAttributo = valoreCodicePiattaforma;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						tipolineaTrovato = true;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
					{&#xD;
						strutturaLineaTrovato = true;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SELEZIONEPASSANTE&#xD;
						 &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.selezionePassante != null)&#xD;
					{&#xD;
						selezionePassanteTrovato = true;&#xD;
						attributo.valoreAttributo = LavorazioneRichiesta.selezionePassante;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				if(!flagCodePrestAgg)&#xD;
				{&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEPRESTAGG;&#xD;
					attributo.valoreAttributo = &quot;43&quot;;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				if(!CODICEPIATTAFORMA)&#xD;
				{&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA;&#xD;
					attributo.valoreAttributo = valoreCodicePiattaforma;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				if(!tipolineaTrovato &amp;&amp; valoretipolinea != null)&#xD;
				{&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
					attributo.valoreAttributo = valoretipolinea;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					localRequest.ordine.tipologiaLinea = it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.get(valoretipolinea.toUpperCase());&#xD;
					&#xD;
				}&#xD;
				&#xD;
				if(!strutturaLineaTrovato &amp;&amp; valorestrutturaLinea != null)&#xD;
				{&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA;&#xD;
					attributo.valoreAttributo = valorestrutturaLinea;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				// SELEZIONE PASSANTE - SM_8475 e SM_8498&#xD;
				if(!selezionePassanteTrovato &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.selezionePassante != null)&#xD;
				{&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SELEZIONEPASSANTE;&#xD;
					attributo.valoreAttributo = LavorazioneRichiesta.selezionePassante;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
			}&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI){&#xD;
				var flagIdRisorsa = false;&#xD;
				var flagCodiceTrasformazione = false;&#xD;
				var y = 0;&#xD;
				while(y &lt; componente.attributiDettaglioOrdine.size() &amp;&amp; !flagIdRisorsa){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(y);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA&#xD;
						&amp;&amp; idRisorsaNaked!= null &amp;&amp; idRisorsaNaked!= &quot;&quot;){&#xD;
						flagCodePrestAgg = true;&#xD;
						attributo.valoreAttributo = idRisorsaNaked;&#xD;
					}	&#xD;
				y++;	&#xD;
					&#xD;
				}&#xD;
				var u = 0;&#xD;
				while(u &lt; componente.attributiDettaglioOrdine.size() &amp;&amp; !flagCodiceTrasformazione &amp;&amp; localRequest.codiceTrasformazione != null){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(u);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETRASFORMAZIONE){&#xD;
						flagCodiceTrasformazione = true;&#xD;
						attributo.valoreAttributo = localRequest.codiceTrasformazione;&#xD;
					}	&#xD;
				u++;	&#xD;
				}&#xD;
				if(!flagIdRisorsa &amp;&amp; idRisorsaNaked!= null &amp;&amp; idRisorsaNaked!= &quot;&quot;){&#xD;
					&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
					attributo.valoreAttributo = idRisorsaNaked;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				if(!flagCodiceTrasformazione &amp;&amp; localRequest.codiceTrasformazione != null){&#xD;
					&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETRASFORMAZIONE;&#xD;
					attributo.valoreAttributo = localRequest.codiceTrasformazione;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL)&#xD;
	{	&#xD;
		for(var k = 0; k &lt; localRequest.ordine.dettaglioordine.size(); k++){&#xD;
			&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(k);&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULL){&#xD;
								&#xD;
				var CODICEPIATTAFORMA = false;&#xD;
				var j = 0;&#xD;
				while(j &lt; componente.attributiDettaglioOrdine.size() &amp;&amp; !CODICEPIATTAFORMA){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA){&#xD;
						CODICEPIATTAFORMA = true;&#xD;
						attributo.valoreAttributo = valoreCodicePiattaforma;&#xD;
					}	&#xD;
				j++;			&#xD;
				}&#xD;
				if(!CODICEPIATTAFORMA){&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA;&#xD;
					attributo.valoreAttributo = valoreCodicePiattaforma;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else {&#xD;
		Process.auditLog(&quot;Offerta WLR La non trovata&quot;);&#xD;
	}&#xD;
	&#xD;
	&#xD;
}//end main if&#xD;
else{&#xD;
	Process.auditLog(&quot;Request null oppure l'ordine non è stato trovato&quot;);&#xD;
}	&#xD;
&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="85.0" LaneId="_hXWFsebwEeaqr96OWxgQ0w" Width="142.0">
              <xpdl2:Coordinates XCoordinate="1530.0" YCoordinate="1251.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_I-UyQApkEeevZJC0hSwGLg" Name="AggiornaComponenteMigrazioneOLO2TIM" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Aggiorna Componente Migrazione OLO2TIM">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest!= null &amp;&amp; localRequest.ordine!=null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);	&#xD;
		&#xD;
//AZIONE ULL LA&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU)&#xD;
		{				&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
		}&#xD;
		else if (componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY&#xD;
		||&#xD;
		componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI&#xD;
		||&#xD;
		componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		} 				&#xD;
		else&#xD;
		{		&#xD;
		Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//Gestione default DESTINAZIONEUSO&#xD;
&#xD;
if(localRequest!= null &amp;&amp; localRequest.ordine!=null){&#xD;
	var i=0;&#xD;
	var trovato=false;&#xD;
	var trovataComponente=false;&#xD;
	while(!trovato &amp;&amp; !trovataComponente &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
	&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(componente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULLDATI)&#xD;
		{&#xD;
			var j=0;&#xD;
			while(!trovato &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO){&#xD;
					trovato= true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			trovataComponente=true;&#xD;
			&#xD;
			if(!trovato)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate =ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.NUMBER;&#xD;
				attributo.valoreAttributo = &quot;4&quot;;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="86.0" LaneId="_hXWFsebwEeaqr96OWxgQ0w" Width="142.0">
              <xpdl2:Coordinates XCoordinate="1530.0" YCoordinate="1367.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_8heO8AsyEee1qP88Gy0zbg" Name="AggiornaComponenteMigrazioneTIM2OLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Aggiorna Componente Migrazione TIM2OLO" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//C02M26F05 &#xD;
&#xD;
if(localRequest!= null &amp;&amp; localRequest.ordine!=null){&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		&#xD;
		//WLR LA&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA)&#xD;
		{&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR ||&#xD;
			componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS ||&#xD;
			componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;			&#xD;
			}&#xD;
		} else&#xD;
		&#xD;
		//VULL LA&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL)&#xD;
		{&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULL ||&#xD;
			componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;			&#xD;
			}&#xD;
&#xD;
		}&#xD;
		 &#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
		&#xD;
		&#xD;
	}&#xD;
}&#xD;
&#xD;
//cerdo direzionalita strutturaLinea e tipolinea&#xD;
var direzionalita = &quot;&quot;;&#xD;
direzionalita = null;&#xD;
var strutturaLinea = &quot;&quot;;&#xD;
strutturaLinea = null;&#xD;
var tipolinea = &quot;&quot;;&#xD;
tipolinea = null;&#xD;
var accessoTrovato = false;&#xD;
var IDAccesso = 0;&#xD;
IDAccesso = null;&#xD;
var idRisorsaNaked = &quot;&quot;;&#xD;
idRisorsaNaked = null;&#xD;
&#xD;
&#xD;
var i=0;&#xD;
while(!accessoTrovato &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
	var component = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(component.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR&#xD;
		||component.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULL){&#xD;
		accessoTrovato = true;&#xD;
		IDAccesso = i;&#xD;
		var j=0;&#xD;
		while((direzionalita==null || strutturaLinea== null || tipolinea == null) &amp;&amp; j&lt;component.attributiDettaglioOrdine.size()){&#xD;
			if(component.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA){&#xD;
				direzionalita = component.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
			}&#xD;
			else if(component.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA){&#xD;
				strutturaLinea= component.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
			}&#xD;
			else if(component.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
				tipolinea= component.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
			}&#xD;
			else if(component.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSABTSNAKED){&#xD;
				idRisorsaNaked= component.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
// recupero tipolinea e strutturalinea da consistenza fonia se non present in input per offerte WLR&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA)&#xD;
&amp;&amp; (strutturaLinea == null || tipolinea == null)&#xD;
&amp;&amp; ConsistenzaFonia != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaFonia.IDAsset));&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		Asset = AssetRef.readAsset();&#xD;
		var i=0;&#xD;
		while(i &lt; Asset.dettaglioasset.size())&#xD;
		{&#xD;
			var dettaglioAsset = Asset.dettaglioasset.get(i);&#xD;
			if(String(dettaglioAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
				var j=0;&#xD;
				&#xD;
				while((strutturaLinea== null || tipolinea == null) &amp;&amp; j&lt;dettaglioAsset.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributoDettaglioAsset = dettaglioAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributoDettaglioAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA&#xD;
					&amp;&amp; strutturaLinea== null)&#xD;
					{&#xD;
						strutturaLinea = attributoDettaglioAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(attributoDettaglioAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA&#xD;
					&amp;&amp; tipolinea == null)&#xD;
					{&#xD;
						tipolinea = attributoDettaglioAsset.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
var valoreCodicePiattaforma = &quot;SBL&quot;;&#xD;
if(localRequest.ordine.CF != null &amp;&amp; localRequest.ordine.CF!= &quot;&quot;){&#xD;
&#xD;
	if(localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS&#xD;
		&amp;&amp; direzionalita== null){&#xD;
		valoreCodicePiattaforma = &quot;SBR&quot;;&#xD;
	}&#xD;
	else if(localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN&#xD;
		&amp;&amp; strutturaLinea == &quot;BraMono&quot;&#xD;
		&amp;&amp; direzionalita== null){&#xD;
		valoreCodicePiattaforma = &quot;SBR&quot;;&#xD;
	}&#xD;
	else if(localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS&#xD;
		&amp;&amp; strutturaLinea == &quot;Simplex&quot;&#xD;
		&amp;&amp; direzionalita!= null){&#xD;
		valoreCodicePiattaforma = &quot;SBR&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
//Per ACCESSOWLR LA seguire C02M15F04 &#xD;
&#xD;
if(localRequest!= null &amp;&amp; localRequest.ordine!=null){&#xD;
	&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA){&#xD;
		&#xD;
		for(var k = 0; k &lt; localRequest.ordine.dettaglioordine.size(); k++){&#xD;
			&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(k);&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR){&#xD;
				&#xD;
				var flagCodePrestAgg = false;&#xD;
				var CODICEPIATTAFORMA = false;&#xD;
				var tipolineaTrovato = false;&#xD;
				var strutturaLineaTrovato = false;&#xD;
				&#xD;
				for(var z = 0; z &lt; componente.attributiDettaglioOrdine.size(); z++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(z);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEPRESTAGG)&#xD;
					{&#xD;
						flagCodePrestAgg = true;&#xD;
						attributo.valoreAttributo = &quot;43&quot;;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA){&#xD;
						CODICEPIATTAFORMA = true;&#xD;
						attributo.valoreAttributo = valoreCodicePiattaforma;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
						tipolineaTrovato = true;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA){&#xD;
						strutturaLineaTrovato = true;&#xD;
					}			&#xD;
				}&#xD;
				&#xD;
				if(!flagCodePrestAgg)&#xD;
				{&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEPRESTAGG;&#xD;
					attributo.valoreAttributo = &quot;43&quot;;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				if(!CODICEPIATTAFORMA){&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA;&#xD;
					attributo.valoreAttributo = valoreCodicePiattaforma;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				if(!tipolineaTrovato &amp;&amp; tipolinea != null){&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
					attributo.valoreAttributo = valoreCodicePiattaforma;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					localRequest.ordine.tipologiaLinea = it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.get(tipolinea.toUpperCase());&#xD;
					&#xD;
				}&#xD;
				if(!strutturaLineaTrovato &amp;&amp; strutturaLinea != null){&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA;&#xD;
					attributo.valoreAttributo = strutturaLinea;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
&#xD;
			}&#xD;
			else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI){&#xD;
				var flagIdRisorsa = false;&#xD;
				var flagCodiceTrasformazione = false;&#xD;
				var y = 0;&#xD;
				while(y &lt; componente.attributiDettaglioOrdine.size() &amp;&amp; !flagIdRisorsa){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(y);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA&#xD;
					&amp;&amp; idRisorsaNaked!= null &amp;&amp; idRisorsaNaked!= &quot;&quot;){&#xD;
						flagCodePrestAgg = true;&#xD;
						attributo.valoreAttributo = idRisorsaNaked;&#xD;
					}	&#xD;
				y++;	&#xD;
					&#xD;
				}&#xD;
				var u = 0;&#xD;
				while(u &lt; componente.attributiDettaglioOrdine.size() &amp;&amp; !flagCodiceTrasformazione &amp;&amp; localRequest.codiceTrasformazione != null){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(u);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETRASFORMAZIONE){&#xD;
						flagCodiceTrasformazione = true;&#xD;
						attributo.valoreAttributo = localRequest.codiceTrasformazione;&#xD;
					}	&#xD;
				u++;	&#xD;
				}&#xD;
				if(!flagIdRisorsa &amp;&amp; idRisorsaNaked!= null &amp;&amp; idRisorsaNaked!= &quot;&quot;){&#xD;
					&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
					attributo.valoreAttributo = idRisorsaNaked;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
				if(!flagCodiceTrasformazione &amp;&amp; localRequest.codiceTrasformazione != null){&#xD;
					&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETRASFORMAZIONE;&#xD;
					attributo.valoreAttributo = localRequest.codiceTrasformazione;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA){&#xD;
		for(var k = 0; k &lt; localRequest.ordine.dettaglioordine.size(); k++){&#xD;
			&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(k);&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULL){&#xD;
								&#xD;
				var CODICEPIATTAFORMA = false;&#xD;
				var j = 0;&#xD;
				while(j &lt; componente.attributiDettaglioOrdine.size() &amp;&amp; !CODICEPIATTAFORMA){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA){&#xD;
						CODICEPIATTAFORMA = true;&#xD;
						attributo.valoreAttributo = valoreCodicePiattaforma;&#xD;
					}	&#xD;
				j++;			&#xD;
				}&#xD;
				if(!CODICEPIATTAFORMA){&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					var date = DateTimeUtil.createDatetime();&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA;&#xD;
					attributo.valoreAttributo = valoreCodicePiattaforma;&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else {&#xD;
		Process.auditLog(&quot;Offerta WLR La non trovata&quot;);&#xD;
	}&#xD;
	&#xD;
	&#xD;
}//end main if&#xD;
else{&#xD;
	Process.auditLog(&quot;Request null oppure l'ordine non è stato trovato&quot;);&#xD;
}	&#xD;
&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="83.0" LaneId="_hXWFsebwEeaqr96OWxgQ0w" Width="142.0">
              <xpdl2:Coordinates XCoordinate="1530.0" YCoordinate="1483.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_vac1H3IOEeetBZdKlhIs_w" Name="CallCTRLVOIPWLRVULLRECIPIENT" FinishMode="Automatic" IsATransaction="false" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Call CTRL VOIP WLR VULL RECIPIENT" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_gB_pkPRoEeazKYdqUBpQKA" PackageRef="tim.NOW.bpm.ProcesService.Interfaces" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="OUT" Formal="EsitoResponse">
                  <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="InventoryOut">
                  <xpdl2:Actual ScriptGrammar="JavaScript">InventoryOut</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="ConsistenzaFonia">
