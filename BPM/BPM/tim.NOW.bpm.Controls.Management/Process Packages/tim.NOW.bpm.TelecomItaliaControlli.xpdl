var distretto = &quot;&quot;;&#xD;
distretto = null;&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine.size() > 0)&#xD;
{&#xD;
	var tipoLineaOLO = &quot;&quot;;&#xD;
	tipoLineaOLO = null;&#xD;
	&#xD;
	var tipoLineaNP = &quot;&quot;;&#xD;
	tipoLineaNP = null;&#xD;
&#xD;
	var data = DateTimeUtil.createDatetime();&#xD;
	&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
