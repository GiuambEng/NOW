				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPMULTICAST&#xD;
				        &amp;&amp; ConsistenzaCanale != null &amp;&amp; ConsistenzaCanale.IPMulticast != null&#xD;
						&amp;&amp; (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CANALEESISTENTEFEEDER&#xD;
						    ||localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CANALEESISTENTEOLT))   //SM_10232&#xD;
				{&#xD;
					foundIPMULTICAST = true;&#xD;
					attributo.valoreAttributo = ConsistenzaCanale.IPMulticast;&#xD;
