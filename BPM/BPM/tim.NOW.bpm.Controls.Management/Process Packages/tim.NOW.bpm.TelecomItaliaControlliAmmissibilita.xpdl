				&#xD;
				//TIPOLINEANP&#xD;
				if(np.tipoLineaNP != null)&#xD;
				{&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP;&#xD;
