						}&#xD;
						else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
						{&#xD;
							var attrTemp = ScriptUtil.copy(attributo);&#xD;
