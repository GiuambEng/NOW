        <xpdl2:Activity Id="_mqFa4CjwEeub9unkJKPbBQ" Name="ArricchimentoOrdineVP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Ordine VP" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var data = DateTimeUtil.createDatetime();&#xD;
&#xD;
if(ConsistenzaRaccolta != null)&#xD;
{&#xD;
	var assetTarget = it_telecomitalia_it_NOW_casedata_Factory.createAssetTarget();&#xD;
	assetTarget.IDAsset = ScriptUtil.createBigInteger(ConsistenzaRaccolta.IDAsset);&#xD;
	assetTarget.flagInLavorazione = true;&#xD;
	localRequest.assetTarget.add(ScriptUtil.copy(assetTarget));&#xD;
&#xD;
	//RECUPERO VALORI DA ASSET&#xD;
	var CARATTERISTICAVPasset = &quot;&quot;;&#xD;
	CARATTERISTICAVPasset = null;&#xD;
	var BANDAMCRasset = &quot;&quot;;&#xD;
	BANDAMCRasset = null;&#xD;
	var BANDAPCRasset = &quot;&quot;;&#xD;
	BANDAPCRasset = null;&#xD;
	var VPIasset = &quot;&quot;;&#xD;
	VPIasset = null;&#xD;
	var IDVLANRETEasset = &quot;&quot;;&#xD;
	IDVLANRETEasset = null;&#xD;
	&#xD;
	//SM_9803&#xD;
	var IDMADRCRMWSasset = &quot;&quot;;&#xD;
	IDMADRCRMWSasset = null;&#xD;
	&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		Asset = AssetRef.readAsset();&#xD;
	}&#xD;
	&#xD;
	if(Asset != null &amp;&amp; Asset.dettaglioasset != null)&#xD;
	{&#xD;
		for(var m=0; m&lt;Asset.dettaglioasset.size(); m++)&#xD;
		{&#xD;
			var componenteAsset = Asset.dettaglioasset.get(m); &#xD;
			&#xD;
			if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVP)&#xD;
			{&#xD;
				for(var k=0; k&lt;componenteAsset.attributidettaglioasset.size(); k++)&#xD;
				{&#xD;
					var attributoAsset = componenteAsset.attributidettaglioasset.get(k);&#xD;
					&#xD;
					if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVP)&#xD;
					{&#xD;
						CARATTERISTICAVPasset = attributoAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo CARATTERISTICAVP:&quot; +CARATTERISTICAVPasset+ &quot;in asset&quot;);&#xD;
					}&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAMCR)&#xD;
					{&#xD;
						BANDAMCRasset = attributoAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo BANDAMCR:&quot; +BANDAMCRasset+ &quot;in asset&quot;);&#xD;
					}&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPCR)&#xD;
					{&#xD;
						BANDAPCRasset = attributoAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo BANDAPCR:&quot; +BANDAPCRasset+ &quot;in asset&quot;);&#xD;
					}&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
					{&#xD;
						VPIasset = attributoAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo VPI:&quot; +VPIasset+ &quot;in asset&quot;);&#xD;
					}&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDVLANRETE)&#xD;
					{&#xD;
						IDVLANRETEasset = attributoAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo IDVLANRETE:&quot; +IDVLANRETEasset+ &quot;in asset&quot;);&#xD;
					}&#xD;
					//SM_9803&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS)&#xD;
					{&#xD;
						IDMADRCRMWSasset = attributoAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo IDMADRCRMWS:&quot; +IDMADRCRMWSasset+ &quot;in asset&quot;);&#xD;
					}&#xD;
					&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//CODICECLLI&#xD;
	if(ConsistenzaRaccolta.codiceClli != null)&#xD;
	{&#xD;
		localRequest.ordine.CLLI = ConsistenzaRaccolta.codiceClli;&#xD;
	}&#xD;
	&#xD;
	//--------------------------------------AGGIORNAMENTO/CREAZIONE COMPONENTE RACCOLTAVP--------------------------------------------&#xD;
	var foundRACCOLTAVP = false;&#xD;
	var i=0;&#xD;
	&#xD;
	//RACCOLTAVP presente nella richiesta -> va aggiornata&#xD;
	while(!foundRACCOLTAVP &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVP)&#xD;
		{&#xD;
			foundRACCOLTAVP = true;&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	//RACCOLTAVP assente nella richiesta -> va creata &#xD;
	if(!foundRACCOLTAVP)&#xD;
	{&#xD;
		var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
		componente.IDDettaglioOrdineParent = 1;&#xD;
		componente.IDDettaglioOrdineRoot =1;&#xD;
		componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componente.IDRisorsa= ConsistenzaRaccolta.IDRisorsa;&#xD;
		componente.IDRisorsaNOW = ConsistenzaRaccolta.IDRisorsaNOW;&#xD;
		componente.created = data;&#xD;
		componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
		componente.lastUpdate = data;&#xD;
		componente.operatore = &quot;BPM&quot;;&#xD;
		componente.progressivo = 1;&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVP;&#xD;
	}&#xD;
	&#xD;
	//ATTRIBUTI&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
	attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
	attributo.created = data;&#xD;
	attributo.lastUpdate = data;&#xD;
	attributo.operatore = &quot;BPM&quot;;&#xD;
	&#xD;
	//IDRISORSA&#xD;
	if(ConsistenzaRaccolta.IDRisorsa != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.IDRisorsa;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//CODICETDKIT&#xD;
	if(ConsistenzaRaccolta.codiceTdKit != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.codiceTdKit;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//BANDAMCR&#xD;
	if(BANDAMCRasset != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAMCR;&#xD;
		attrTemp.valoreAttributo = BANDAMCRasset;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.NUMBER;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//BANDAPCR&#xD;
	if(BANDAPCRasset != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPCR;&#xD;
		attrTemp.valoreAttributo = BANDAPCRasset;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.NUMBER;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//VPI&#xD;
	if(VPIasset != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI;&#xD;
		attrTemp.valoreAttributo = VPIasset;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//CARATTERISTICAVP&#xD;
	if(CARATTERISTICAVPasset != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVP;&#xD;
		attrTemp.valoreAttributo = CARATTERISTICAVPasset;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//SM_9733: TRASPORTO&#xD;
	if(ConsistenzaRaccolta.trasporto != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TRASPORTO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.trasporto;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//CODICECLLI - aggiunto con SM_9792, insieme a NOMECLLI, CODICE e NOME MACROAREA&#xD;
	if(ConsistenzaRaccolta.codiceClli != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLLI;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.codiceClli;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//NOMECLLI&#xD;
	if(ConsistenzaRaccolta.nomeClli != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMECLLI;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.nomeClli;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//CODICEMACROAREA&#xD;
	if(ConsistenzaRaccolta.codiceMacroArea != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.codiceMacroArea;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//NOMEMACROAREA&#xD;
	if(ConsistenzaRaccolta.nomeMacroArea!=null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
