        <xpdl2:Activity Id="_7kHCQB7PEeeTWdKq7RJQDQ" Name="ArricchimentoCONSISTENZA" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento CONSISTENZA">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var data = DateTimeUtil.createDatetime();&#xD;
&#xD;
&#xD;
	&#xD;
// CONSISTENZA DATI&#xD;
if(ConsistenzaDati!= null &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA){&#xD;
	var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
	componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
	componente.IDDettaglioOrdineParent = 1;&#xD;
	componente.IDDettaglioOrdineRoot =1;&#xD;
	componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	componente.IDRisorsa= ConsistenzaDati.IDRisorsa;&#xD;
	componente.IDRisorsaNOW = ConsistenzaDati.IDRisorsaNOW;&#xD;
	&#xD;
	componente.created = data;&#xD;
	componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
	componente.lastUpdate = data;&#xD;
	componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI;&#xD;
	componente.operatore = &quot;BPM&quot;;&#xD;
	componente.progressivo = 1;&#xD;
	&#xD;
	componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.T;&#xD;
		&#xD;
	&#xD;
	&#xD;
	//attributi&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
	attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
	attributo.created = data;&#xD;
	attributo.lastUpdate = data;&#xD;
	attributo.operatore = &quot;BPM&quot;;&#xD;
	attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
	&#xD;
	if(ConsistenzaDati.IDAsset!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.IDAsset;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.IDRisorsa!=null){&#xD;
		localRequest.IDRisorsaCorrelato = ConsistenzaDati.IDRisorsa;&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.IDRisorsa;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.IDRisorsaCorrelato!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSACORRELATO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.IDRisorsaCorrelato;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.IDRisorsaNOW!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSANOW;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.IDRisorsaNOW;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.offerta!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA;&#xD;
		attrTemp.valoreAttributo = String(ConsistenzaDati.offerta);&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.codificaOLOAGCOMDonating!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codificaOLOAGCOMDonating;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.codificaOLOAGCOMDonor!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONOR;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codificaOLOAGCOMDonor;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.cowCode!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COWCODE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.cowCode;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.codiceSessione!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESESSIONE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codiceSessione;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.codiceOrdineTI!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETI;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codiceOrdineTI;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.codiceOrdineOLO!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codiceOrdineOLO;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.tipoLinea!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.tipoLinea;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.strutturaLinea!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.strutturaLinea;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.numeroTelefonico!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.numeroTelefonico;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.numeroTelefonicoPrincipale!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.numeroTelefonicoPrincipale;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.destinazioneUso!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.destinazioneUso;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.codiceTrasformazione!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETRASFORMAZIONE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codiceTrasformazione;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.opzioneDinamica!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONEDINAMICA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.opzioneDinamica;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.tipologiaClusterComune!=null){ //RU_964&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.tipologiaClusterComune;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//OPERATORERETE - RU_1142&#xD;
	if(ConsistenzaDati.operatoreRete!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPERATORERETE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.operatoreRete;&#xD;
		&#xD;
		localRequest.operatoreRete = ConsistenzaDati.operatoreRete;&#xD;
		localRequest.ordine.operatoreRete = ConsistenzaDati.operatoreRete;&#xD;
		&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//ASSETBTWHITELIST - R1E-21-0325&#xD;
	if(ConsistenzaDati.assetBTWhiteList != null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.WHITELIST;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.assetBTWhiteList;&#xD;
		&#xD;
