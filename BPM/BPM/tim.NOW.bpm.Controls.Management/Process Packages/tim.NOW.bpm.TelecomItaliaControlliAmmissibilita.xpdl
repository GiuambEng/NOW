			}&#xD;
		}&#xD;
		&#xD;
		//Logica Aggiunta attributi recuperati dall'asset&#xD;
		if(!foundTIPODNREALE)&#xD;
		{&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNREALE;&#xD;
			&#xD;
			//RU_1121&#xD;
			if(SottoLav8 &amp;&amp; TIPODNRICHIESTOinput != null)&#xD;
			{&#xD;
				attributo.valoreAttributo = TIPODNRICHIESTOinput;&#xD;
			}&#xD;
			else if(TIPODNREALE != null)&#xD;
			{&#xD;
				attributo.valoreAttributo = TIPODNREALE;&#xD;
			}&#xD;
			&#xD;
			currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			Process.auditLog(&quot;Aggiunto attributo &quot; + attributo.nomeAttributo + &quot; all'ACCESSOCPS&quot;);&#xD;
		}&#xD;
		if(!foundTIPOLINEAREALE)&#xD;
		{&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAREALE;&#xD;
