                  <xpdl2:Actual ScriptGrammar="JavaScript">LavorazioneRichiesta</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="VerificaIDRisorsaResponse">
                  <xpdl2:Actual ScriptGrammar="JavaScript">VerificaIdRisorsaResponse</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="IDRisorsaDIN">
                  <xpdl2:Actual ScriptGrammar="JavaScript">IDRisorsaDIN</xpdl2:Actual>
                </xpdl2:DataMapping>
