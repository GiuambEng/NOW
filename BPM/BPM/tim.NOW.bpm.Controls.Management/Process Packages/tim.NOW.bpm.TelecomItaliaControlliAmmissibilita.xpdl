        <xpdl2:Activity Id="_i1Bjgh0sEeu4uZ7mI5jbNA" Name="ArricchimentoOrdineVP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Ordine VP" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(ConsistenzaRaccolta == null)&#xD;
{&#xD;
	Process.auditLog(&quot;Impossibile arricchire, ConsistenzaRaccolta non presente&quot;);&#xD;
}&#xD;
else if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	Process.auditLog(&quot;INIZIO ARRICCHIMENTO VARIAZIONE da Asset &quot;+ConsistenzaRaccolta.IDAsset);&#xD;
&#xD;
	var attributoVariato = false;&#xD;
&#xD;
	var CARATTERISTICAVPasset = &quot;&quot;;&#xD;
	CARATTERISTICAVPasset = null;&#xD;
	var BANDAMCRasset = &quot;&quot;;&#xD;
	BANDAMCRasset = null;&#xD;
	var BANDAPCRasset = &quot;&quot;;&#xD;
	BANDAPCRasset = null;&#xD;
	var VPIasset = &quot;&quot;;&#xD;
	VPIasset = null;&#xD;
	var IDVLANRETEasset = &quot;&quot;;&#xD;
	IDVLANRETEasset = null;&#xD;
	&#xD;
	//SM_9803&#xD;
	var IDMADRCRMWSasset = &quot;&quot;;&#xD;
	IDMADRCRMWSasset = null;&#xD;
	&#xD;
	//RECUPERO VALORI DA ASSET&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		Asset = AssetRef.readAsset();&#xD;
	}&#xD;
	&#xD;
	if(Asset != null &amp;&amp; Asset.dettaglioasset != null)&#xD;
	{&#xD;
		for(var m=0; m&lt;Asset.dettaglioasset.size(); m++)&#xD;
		{&#xD;
			var componenteAsset = Asset.dettaglioasset.get(m); &#xD;
			&#xD;
			if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVP)&#xD;
			{&#xD;
				for(var k=0; k&lt;componenteAsset.attributidettaglioasset.size(); k++)&#xD;
				{&#xD;
					var attributoAsset = componenteAsset.attributidettaglioasset.get(k);&#xD;
					&#xD;
					if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVP)&#xD;
					{&#xD;
						CARATTERISTICAVPasset = attributoAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo CARATTERISTICAVP:&quot; +CARATTERISTICAVPasset+ &quot;in asset&quot;);&#xD;
					}&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAMCR)&#xD;
					{&#xD;
						BANDAMCRasset = attributoAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo BANDAMCR:&quot; +BANDAMCRasset+ &quot;in asset&quot;);&#xD;
					}&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPCR)&#xD;
					{&#xD;
						BANDAPCRasset = attributoAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo BANDAPCR:&quot; +BANDAPCRasset+ &quot;in asset&quot;);&#xD;
					}&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
					{&#xD;
						VPIasset = attributoAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo VPI:&quot; +VPIasset+ &quot;in asset&quot;);&#xD;
					}&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDVLANRETE)&#xD;
					{&#xD;
						IDVLANRETEasset = attributoAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo IDVLANRETE:&quot; +IDVLANRETEasset+ &quot;in asset&quot;);&#xD;
					}&#xD;
					//SM_9803&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS)&#xD;
					{&#xD;
						IDMADRCRMWSasset = attributoAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo IDMADRCRMWS:&quot; +IDMADRCRMWSasset+ &quot;in asset&quot;);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	var foundCODICETDKIT = false;&#xD;
	var foundCARATTERISTICAVP = false;&#xD;
	var foundBANDAMCR = false;&#xD;
	var foundBANDAPCR = false;&#xD;
	var foundVPI = false;&#xD;
	&#xD;
	//CODICECLLI&#xD;
	if(ConsistenzaRaccolta.codiceClli != null)&#xD;
	{&#xD;
		localRequest.ordine.CLLI = ConsistenzaRaccolta.codiceClli;&#xD;
	}&#xD;
	&#xD;
	//ARRICCHIMENTO ORDINE&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		//Componente RACCOLTAVP&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVP)&#xD;
		{&#xD;
			//Creo attributi se non presenti nell'ordine&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributoTemp = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributoTemp.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributoTemp.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributoTemp.operatore = componente.operatore;&#xD;
			attributoTemp.created = ora;&#xD;
			attributoTemp.lastUpdate = ora;&#xD;
			&#xD;
			&#xD;
			// ==================================== ARRICCHIMENTO STATICO ================================================&#xD;
			//Inserito con SM_9733 per arricchimento di TRASPORTO&#xD;
			//SM_9792: aggiunti CODICEMACROAREA, NOMEMACROAREA, IDRISORSA, CODICECLLI e NOMECLLI all'arricchimento&#xD;
			var TRASPORTO = &quot;&quot;;&#xD;
			TRASPORTO = null;&#xD;
			var CODICEMACROAREA = &quot;&quot;;&#xD;
			CODICEMACROAREA = null;&#xD;
			var NOMEMACROAREA = &quot;&quot;;&#xD;
			NOMEMACROAREA = null;&#xD;
			var foundTRASPORTO = false;&#xD;
			var foundCODICECLLI = false;&#xD;
			var foundNOMECLLI = false;&#xD;
			var foundIDRISORSA = false;&#xD;
			var foundCODICEMACROAREA = false;&#xD;
			var foundNOMEMACROAREA = false;&#xD;
			&#xD;
			//SM_9803&#xD;
			var foundIDMADRCRMWS = false;&#xD;
			&#xD;
			&#xD;
			//SM_9813: nel caso di VARIAZIONETDKIT bisogna fare arricchimento statico per BANDAMCR e BANDAPCR dall'asset, mentre per VARIAZIONECARATTERISTICA possono variare&#xD;
			var foundBANDAMCRstatica = false;&#xD;
			var foundBANDAPCRstatica = false;&#xD;
			&#xD;
			//Task #33690&#xD;
			var foundCODICETDKITstatico = false;&#xD;
			&#xD;
			&#xD;
			//SM_9813: quando è VARIAZIONETDKIT, ma non ci sono in LavorazioneRichiesta vanno presi dalla ConsistenzaRaccolta -------------------&#xD;
			//TRASPORTO&#xD;
			if(LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.trasporto != null&#xD;
			   &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT)&#xD;
			{&#xD;
				TRASPORTO = LavorazioneRichiesta.trasporto;&#xD;
			}&#xD;
			else &#xD;
			{&#xD;
				TRASPORTO = ConsistenzaRaccolta.trasporto;&#xD;
			}&#xD;
			&#xD;
			//CODICEMACROAREA&#xD;
			if(LavorazioneRichiesta != null &amp;&amp;  LavorazioneRichiesta.codiceMacroArea != null&#xD;
			   &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT)&#xD;
			{&#xD;
				CODICEMACROAREA = LavorazioneRichiesta.codiceMacroArea;&#xD;
			}&#xD;
			else &#xD;
			{&#xD;
				CODICEMACROAREA = ConsistenzaRaccolta.codiceMacroArea;&#xD;
			}&#xD;
			&#xD;
			//NOMEMACROAREA&#xD;
			if(LavorazioneRichiesta != null &amp;&amp;  LavorazioneRichiesta.nomeMacroArea != null&#xD;
			   &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT)&#xD;
			{&#xD;
				NOMEMACROAREA = LavorazioneRichiesta.nomeMacroArea;&#xD;
			}&#xD;
			else &#xD;
			{&#xD;
				NOMEMACROAREA = ConsistenzaRaccolta.nomeMacroArea;&#xD;
			}&#xD;
			//----------------------------------------------------------------------------------------------------------------------------------&#xD;
			&#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TRASPORTO&#xD;
				&amp;&amp; TRASPORTO != null)&#xD;
				{&#xD;
					foundTRASPORTO = true;&#xD;
					attributo.valoreAttributo = TRASPORTO;&#xD;
					Process.auditLog(&quot;Trovato attributo TRASPORTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA&#xD;
				&amp;&amp; ConsistenzaRaccolta.IDRisorsa != null)&#xD;
				{&#xD;
					foundIDRISORSA = true;&#xD;
					attributo.valoreAttributo = ConsistenzaRaccolta.IDRisorsa;&#xD;
					Process.auditLog(&quot;Trovato attributo IDRISORSA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA&#xD;
				&amp;&amp; CODICEMACROAREA != null)&#xD;
				{&#xD;
					foundCODICEMACROAREA = true;&#xD;
					attributo.valoreAttributo = CODICEMACROAREA;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICEMACROAREA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA&#xD;
				&amp;&amp; NOMEMACROAREA != null)&#xD;
				{&#xD;
					foundNOMEMACROAREA = true;&#xD;
					attributo.valoreAttributo = NOMEMACROAREA;&#xD;
					Process.auditLog(&quot;Trovato attributo NOMEMACROAREA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLLI&#xD;
				&amp;&amp; ConsistenzaRaccolta.codiceClli != null)&#xD;
				{&#xD;
					foundCODICECLLI = true;&#xD;
					attributo.valoreAttributo = ConsistenzaRaccolta.codiceClli;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICECLLI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMECLLI&#xD;
				&amp;&amp; ConsistenzaRaccolta.nomeClli != null)&#xD;
				{&#xD;
					foundNOMECLLI = true;&#xD;
					attributo.valoreAttributo = ConsistenzaRaccolta.nomeClli;&#xD;
					Process.auditLog(&quot;Trovato attributo NOMECLLI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//SM_9813: nel caso di VARIAZIONETDKIT bisogna fare arricchimento statico per BANDAMCR e BANDAPCR dall'asset, mentre per VARIAZIONECARATTERISTICA possono variare&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAMCR&#xD;
				&amp;&amp; BANDAMCRasset != null &#xD;
				&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT)&#xD;
				{&#xD;
					foundBANDAMCRstatica = true;&#xD;
					attributo.valoreAttributo = BANDAMCRasset;&#xD;
					Process.auditLog(&quot;Trovato attributo BANDAMCR&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPCR&#xD;
				&amp;&amp; BANDAPCRasset != null&#xD;
				&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT)&#xD;
				{&#xD;
					foundBANDAPCRstatica = true;&#xD;
					attributo.valoreAttributo = BANDAPCRasset;&#xD;
					Process.auditLog(&quot;Trovato attributo BANDAPCR&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//SM_9803&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS&#xD;
				&amp;&amp; IDMADRCRMWSasset != null)&#xD;
				{&#xD;
					foundIDMADRCRMWS = true;&#xD;
					attributo.valoreAttributo = IDMADRCRMWSasset;&#xD;
					Process.auditLog(&quot;Trovato attributo IDMADRCRMWS &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//Task #33690&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT&#xD;
				         &amp;&amp; ConsistenzaRaccolta.codiceTdKit != null&#xD;
						 &amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT)&#xD;
				{&#xD;
					foundCODICETDKITstatico = true;&#xD;
					attributo.valoreAttributo = ConsistenzaRaccolta.codiceTdKit;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICETDKIT &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}	&#xD;
			}&#xD;
			&#xD;
			if(!foundTRASPORTO &amp;&amp; TRASPORTO != null)&#xD;
			{&#xD;
				attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TRASPORTO;&#xD;
				attributoTemp.valoreAttributo = TRASPORTO;&#xD;
				attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
				Process.auditLog(&quot;Creato attributo TRASPORTO&quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			if(!foundIDRISORSA &amp;&amp; ConsistenzaRaccolta.IDRisorsa != null)&#xD;
			{&#xD;
				attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
				attributoTemp.valoreAttributo = ConsistenzaRaccolta.IDRisorsa;&#xD;
				attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
				Process.auditLog(&quot;Creato attributo IDRISORSA&quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			if(!foundCODICEMACROAREA &amp;&amp; CODICEMACROAREA != null)&#xD;
			{&#xD;
				attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA;&#xD;
				attributoTemp.valoreAttributo = CODICEMACROAREA;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
				Process.auditLog(&quot;Creato attributo CODICEMACROAREA &quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			if(!foundNOMEMACROAREA &amp;&amp; NOMEMACROAREA != null)&#xD;
			{&#xD;
				attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA;&#xD;
				attributoTemp.valoreAttributo = NOMEMACROAREA;&#xD;
				attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
				Process.auditLog(&quot;Creato attributo NOMEMACROAREA &quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			if(!foundCODICECLLI &amp;&amp; ConsistenzaRaccolta.codiceClli != null)&#xD;
			{&#xD;
				attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLLI;&#xD;
				attributoTemp.valoreAttributo = ConsistenzaRaccolta.codiceClli;&#xD;
				attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
				Process.auditLog(&quot;Creato attributo CODICECLLI&quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			if(!foundNOMECLLI &amp;&amp; ConsistenzaRaccolta.nomeClli != null)&#xD;
			{&#xD;
				attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMECLLI;&#xD;
				attributoTemp.valoreAttributo = ConsistenzaRaccolta.nomeClli;&#xD;
				attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
				Process.auditLog(&quot;Creato attributo NOMECLLI&quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			//SM_9813: nel caso di VARIAZIONETDKIT bisogna fare arricchimento statico per BANDAMCR e BANDAPCR dall'asset, mentre per VARIAZIONECARATTERISTICA possono variare&#xD;
			if(!foundBANDAMCRstatica &amp;&amp; BANDAMCRasset != null&#xD;
			   &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT)&#xD;
			{&#xD;
				attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAMCR;&#xD;
				attributoTemp.valoreAttributo = BANDAMCRasset;&#xD;
				attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
				Process.auditLog(&quot;Creato attributo BANDAMRC&quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			if(!foundBANDAPCRstatica &amp;&amp; BANDAPCRasset != null&#xD;
			   &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT)&#xD;
			{&#xD;
				attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPCR;&#xD;
				attributoTemp.valoreAttributo = BANDAPCRasset;&#xD;
				attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
				Process.auditLog(&quot;Creato attributo BANDAPRC&quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			//SM_9803&#xD;
			if(!foundIDMADRCRMWS &amp;&amp; IDMADRCRMWSasset != null)&#xD;
			{&#xD;
				attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS;&#xD;
				attributoTemp.valoreAttributo = IDMADRCRMWSasset;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
				Process.auditLog(&quot;Creato attributo IDMADRCRMWS &quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			//Task #33690&#xD;
			if(!foundCODICETDKITstatico &amp;&amp; ConsistenzaRaccolta.codiceTdKit != null&#xD;
			    &amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT)&#xD;
			{&#xD;
				attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT;&#xD;
				attributoTemp.valoreAttributo = ConsistenzaRaccolta.codiceTdKit;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
				Process.auditLog(&quot;Creato attributo CODICETDKIT &quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			//=======================================================================================================&#xD;
			&#xD;
			&#xD;
			// ============================ ATTRIBUTI CHE POSSONO VARIARE =================================&#xD;
			//Sottolavorazione VARIAZIONETDKIT&#xD;
			if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
					{&#xD;
						foundCODICETDKIT = true;&#xD;
						&#xD;
						//SM_9761: spostato if dopo il found a true dell'attributo&#xD;
						if(ConsistenzaRaccolta.codiceTdKit != null &amp;&amp; ConsistenzaRaccolta.codiceTdKit != attributo.valoreAttributo)&#xD;
						{&#xD;
							attributoVariato = true;&#xD;
							attributo.valoreAttributoOLD = ConsistenzaRaccolta.codiceTdKit;&#xD;
							Process.auditLog(&quot;Trovato attributo CODICETDKIT e aggiornato valore OLD &quot;+ attributo.valoreAttributoOLD +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
						}&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVP)&#xD;
					{&#xD;
						foundCARATTERISTICAVP = true;&#xD;
						&#xD;
						//SM_9761: spostato if dopo il found a true dell'attributo&#xD;
						if(CARATTERISTICAVPasset != null &amp;&amp; CARATTERISTICAVPasset != attributo.valoreAttributo)&#xD;
						{&#xD;
							attributoVariato = true;&#xD;
							attributo.valoreAttributoOLD = CARATTERISTICAVPasset;&#xD;
							Process.auditLog(&quot;Trovato attributo CARATTERISTICAVP e aggiornato valore OLD &quot;+ attributo.valoreAttributoOLD +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
&#xD;
				if(!foundCODICETDKIT &amp;&amp; ConsistenzaRaccolta.codiceTdKit != null)&#xD;
				{&#xD;
					attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT;&#xD;
					attributoTemp.valoreAttributo = ConsistenzaRaccolta.codiceTdKit;&#xD;
					attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
					Process.auditLog(&quot;Creato attributo CODICETDKIT &quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
				}&#xD;
				if(!foundCARATTERISTICAVP &amp;&amp; CARATTERISTICAVPasset != null)&#xD;
				{&#xD;
					attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVP;&#xD;
					attributoTemp.valoreAttributo = CARATTERISTICAVPasset;&#xD;
					attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					&#xD;
					componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
					Process.auditLog(&quot;Creato attributo CARATTERISTICAVP &quot;+ attributoTemp.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
				}&#xD;
			}&#xD;
			//Sottolavorazione VARIAZIONECARATTERISTICA&#xD;
			else if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONECARATTERISTICA)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVP)&#xD;
					{&#xD;
						foundCARATTERISTICAVP = true;&#xD;
						&#xD;
						//SM_9761: spostato if dopo il found a true dell'attributo&#xD;
						if(CARATTERISTICAVPasset != null &amp;&amp; CARATTERISTICAVPasset != attributo.valoreAttributo)&#xD;
						{&#xD;
							attributoVariato = true;&#xD;
							attributo.valoreAttributoOLD = CARATTERISTICAVPasset;&#xD;
							Process.auditLog(&quot;Trovato attributo CARATTERISTICAVP e aggiornato valore OLD &quot;+ attributo.valoreAttributoOLD +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
						}&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAMCR)&#xD;
					{&#xD;
						foundBANDAMCR = true;&#xD;
						&#xD;
						//SM_9761: spostato if dopo il found a true dell'attributo&#xD;
						if(BANDAMCRasset != null &amp;&amp; BANDAMCRasset != attributo.valoreAttributo)&#xD;
						{&#xD;
							attributoVariato = true;&#xD;
							attributo.valoreAttributoOLD = BANDAMCRasset;&#xD;
							Process.auditLog(&quot;Trovato attributo BANDAMCR e aggiornato valore OLD &quot;+ attributo.valoreAttributoOLD +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
						}&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPCR)&#xD;
