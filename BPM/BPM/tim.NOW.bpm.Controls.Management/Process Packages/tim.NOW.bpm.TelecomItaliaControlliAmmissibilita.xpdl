			&#xD;
				}&#xD;
				&#xD;
				//codicePiattaforma&#xD;
				if(np.codicePiattaforma != null)&#xD;
				{&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = np.codicePiattaforma;&#xD;
					&#xD;
					dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
				&#xD;
			&#xD;
				}&#xD;
				&#xD;
				//ASSETBTWHITELIST - R1E-21-0325&#xD;
				if(np.assetBTWhiteList != null)&#xD;
				{&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.WHITELIST;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = np.assetBTWhiteList;&#xD;
					&#xD;
					dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
					localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
			&#xD;
				}&#xD;
				&#xD;
				//portabilitaSuccessiva&#xD;
				attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PORTABILITASUCCESSIVA;&#xD;
				attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				if(np.portabilitaSuccessiva != null)&#xD;
				{&#xD;
					attribDettOrdine.valoreAttributo = np.portabilitaSuccessiva;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					attribDettOrdine.valoreAttributo = &quot;N&quot;;&#xD;
				}&#xD;
				dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettOrdineTemp));&#xD;
			}&#xD;
			&#xD;
			for(var ki = 0; ki &lt; idToUpdate.size(); ki++)&#xD;
			{&#xD;
				var currentidToUpdate = parseInt(idToUpdate.get(ki), 10);&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(currentidToUpdate - 1).IDDettaglioOrdineParent = idDettNPPrincipale;&#xD;
				localRequest.ordine.dettaglioordine.get(currentidToUpdate - 1).IDDettaglioOrdineRoot = idDettNPPrincipale;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		&#xD;
		//Arriccimento del tipo line per offerta SHA&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA){&#xD;
			var TipoLineaTemp = &quot;&quot;;&#xD;
			&#xD;
			if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA){&#xD;
				TipoLineaTemp = &quot;ISDN&quot;;&#xD;
			}&#xD;
			else{&#xD;
				TipoLineaTemp = &quot;POTS&quot;;&#xD;
			}&#xD;
			localRequest.ordine.tipologiaLinea = it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.get(TipoLineaTemp);&#xD;
			&#xD;
			var accessoTrovato = false;&#xD;
			var i=0;&#xD;
			while(!accessoTrovato &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
				var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
				if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSHA){&#xD;
					accessoTrovato = true;&#xD;
					var j=0;&#xD;
					var TipoLineaTrovato = false;&#xD;
					&#xD;
					while(!TipoLineaTrovato &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size()){&#xD;
						var attributoTemp = componente.attributiDettaglioOrdine.get(j);&#xD;
						if(attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
							attributoTemp.valoreAttributo = TipoLineaTemp;&#xD;
							TipoLineaTrovato = true;&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
					&#xD;
					if(!TipoLineaTrovato){&#xD;
						&#xD;
						var attr = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						attr.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
						attr.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						attr.created = DateTimeUtil.createDatetime();&#xD;
						attr.lastUpdate = DateTimeUtil.createDatetime();&#xD;
						attr.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
						attr.operatore = &quot;BPM&quot;;&#xD;
						attr.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						attr.valoreAttributo = TipoLineaTemp;&#xD;
						&#xD;
						componente.attributiDettaglioOrdine.add(attr);&#xD;
					}&#xD;
					&#xD;
				}&#xD;
				&#xD;
				i++;&#xD;
			}&#xD;
			&#xD;
		}&#xD;
		else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA)&#xD;
				&amp;&amp; LavorazioneRichiesta != null)&#xD;
		{&#xD;
			var foundAccesso = false;&#xD;
			var accessoIndex = -1;&#xD;
			var tipoLineaIndex = -1;&#xD;
			var strutturaLineaIndex = -1;&#xD;
			var i = 0;&#xD;
			&#xD;
			while(!foundAccesso &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					foundAccesso = true;&#xD;
					accessoIndex = i;&#xD;
					&#xD;
					for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
					{&#xD;
						var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
						{&#xD;
							tipoLineaIndex = j;&#xD;
						}&#xD;
						else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
						{&#xD;
							strutturaLineaIndex = j;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
			&#xD;
			if(LavorazioneRichiesta.tipoLinea != null &amp;&amp; LavorazioneRichiesta.tipoLinea != &quot;&quot;)&#xD;
			{&#xD;
				if(tipoLineaIndex != -1)&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.get(accessoIndex).attributiDettaglioOrdine.get(tipoLineaIndex).valoreAttributo = LavorazioneRichiesta.tipoLinea;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					var dettOrdine = localRequest.ordine.dettaglioordine.get(accessoIndex);&#xD;
					&#xD;
					var attTemp = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attTemp.IDDettaglioOrdine = dettOrdine.IDDettaglioOrdine;&#xD;
					attTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attTemp.created = date;&#xD;
					attTemp.lastUpdate = date;&#xD;
					attTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
					attTemp.operatore = &quot;BPM&quot;;&#xD;
					attTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attTemp.valoreAttributo = LavorazioneRichiesta.tipoLinea;&#xD;
					&#xD;
					localRequest.ordine.dettaglioordine.get(accessoIndex).attributiDettaglioOrdine.add(ScriptUtil.copy(attTemp));&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if(LavorazioneRichiesta.strutturaLinea != null &amp;&amp; LavorazioneRichiesta.strutturaLinea != &quot;&quot;)&#xD;
			{&#xD;
				if(strutturaLineaIndex != -1)&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.get(accessoIndex).attributiDettaglioOrdine.get(strutturaLineaIndex).valoreAttributo = LavorazioneRichiesta.strutturaLinea;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					var dettOrdine = localRequest.ordine.dettaglioordine.get(accessoIndex);&#xD;
					&#xD;
					var attTemp = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attTemp.IDDettaglioOrdine = dettOrdine.IDDettaglioOrdine;&#xD;
					attTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attTemp.created = date;&#xD;
					attTemp.lastUpdate = date;&#xD;
					attTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA;&#xD;
					attTemp.operatore = &quot;BPM&quot;;&#xD;
					attTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attTemp.valoreAttributo = LavorazioneRichiesta.strutturaLinea;&#xD;
					&#xD;
					localRequest.ordine.dettaglioordine.get(accessoIndex).attributiDettaglioOrdine.add(ScriptUtil.copy(attTemp));&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.migrazioneIntraOlo != null)&#xD;
		{&#xD;
			Process.auditLog(&quot;Logiche di arricchimento MIGRAZIONEINTRAOLO: &quot; + LavorazioneRichiesta.migrazioneIntraOlo);&#xD;
			var added = false;&#xD;
			var i = 0;&#xD;
			&#xD;
			while(!added &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var attTemp = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attTemp.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
					attTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attTemp.created = date;&#xD;
					attTemp.lastUpdate = date;&#xD;
					attTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MIGRAZIONEINTRAOLO;&#xD;
					attTemp.operatore = &quot;BPM&quot;;&#xD;
					attTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attTemp.valoreAttributo = LavorazioneRichiesta.migrazioneIntraOlo;&#xD;
					&#xD;
					currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attTemp));&#xD;
					&#xD;
					added = true;&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		&#xD;
		//ACCESSO.FATTURAZIONELA&#xD;
		if(String(localRequest.offerta).slice(0,3)==&quot;ULL&quot; || String(localRequest.offerta).slice(0,3)==&quot;SLU&quot;)&#xD;
		{&#xD;
			var added = false;&#xD;
			var i = 0;&#xD;
			&#xD;
			while(!added &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var attTemp = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attTemp.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
					attTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attTemp.created = date;&#xD;
					attTemp.lastUpdate = date;&#xD;
					attTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURAZIONELA;&#xD;
					attTemp.operatore = &quot;BPM&quot;;&#xD;
					attTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attTemp.valoreAttributo = &quot;Y&quot;;&#xD;
					&#xD;
					currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attTemp));&#xD;
					&#xD;
					added = true;&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
				&#xD;
		// SM_8232 - Creazione componente Aggiuntivo restituito da NP Sincronizzata&#xD;
		if(Aggiuntivo != null &amp;&amp; String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;)&#xD;
		{&#xD;
			for(var z=0; z&lt;Aggiuntivo.size(); z++)&#xD;
			{&#xD;
				var dettOrdineTemp = ScriptUtil.copy(dettOrdine);&#xD;
				&#xD;
				dettOrdineTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
				dettOrdineTemp.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO;&#xD;
				dettOrdineTemp.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
				dettOrdineTemp.integrationID = localRequest.IDRichiestaOLO + dettOrdine.IDDettaglioOrdine;&#xD;
				attribDettOrdine.IDDettaglioOrdine = dettOrdineTemp.IDDettaglioOrdine;&#xD;
				&#xD;
				//aggiuntivoWLR&#xD;
				if(Aggiuntivo.get(z).aggiuntivoWLR != null)&#xD;
				{&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AGGIUNTIVOWLR;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = Aggiuntivo.get(z).aggiuntivoWLR;&#xD;
						&#xD;
					dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
				}&#xD;
				&#xD;
				//direzionalita&#xD;
				if(Aggiuntivo.get(z).direzionalita != null)&#xD;
				{&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = Aggiuntivo.get(z).direzionalita;&#xD;
						&#xD;
					dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
				}&#xD;
				&#xD;
				//numeroTelefonico&#xD;
				if(Aggiuntivo.get(z).numeroTelefonico != null)&#xD;
				{&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = Aggiuntivo.get(z).numeroTelefonico;&#xD;
						&#xD;
					dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
				}&#xD;
				&#xD;
				//numeroTelefonicoPrincipale&#xD;
				if(Aggiuntivo.get(z).numeroTelefonicoPrincipale != null)&#xD;
				{&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = Aggiuntivo.get(z).numeroTelefonicoPrincipale;&#xD;
						&#xD;
					dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
				}&#xD;
				&#xD;
				//stato&#xD;
				if(Aggiuntivo.get(z).stato != null)&#xD;
				{&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = Aggiuntivo.get(z).stato;&#xD;
						&#xD;
					dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
				}&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.add(dettOrdineTemp);&#xD;
			}&#xD;
		}&#xD;
	&#xD;
		// SM_8383: arricchimento STS recuperato in CTRL SERVIZIO CONSISTENZA&#xD;
		if(String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;&#xD;
		   &amp;&amp; STS != null &amp;&amp; (STS.codice != null || STS.descrizione != null || STS.codiceDTU != null || STS.stato != null))&#xD;
		{&#xD;
			Process.auditLog(&quot;Arricchimento componente STS, aggiunta nell'ordine con codice: &quot;+STS.codice+&quot;, descrizione&quot;+STS.descrizione+&quot;, codiceDTU &quot;+STS.codiceDTU+&quot;, stato:&quot;+STS.stato);&#xD;
			&#xD;
			var dettaglio = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			dettaglio.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
				&#xD;
			attribDettOrdine.IDDettaglioOrdine = dettaglio.IDDettaglioOrdine;&#xD;
				&#xD;
			dettaglio.IDDettaglioOrdineParent = 1;&#xD;
			dettaglio.IDDettaglioOrdineRoot = 1;&#xD;
			dettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			dettaglio.IDRisorsa = localRequest.IDRisorsa;&#xD;
			dettaglio.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
			dettaglio.created = date;&#xD;
			dettaglio.integrationID = localRequest.IDRichiestaOLO + dettaglio.IDDettaglioOrdine;&#xD;
			dettaglio.lastUpdate = date;&#xD;
			&#xD;
			dettaglio.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS;&#xD;
			&#xD;
			dettaglio.operatore = &quot;BPM&quot;;&#xD;
			dettaglio.progressivo = 1;&#xD;
				&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettaglio));&#xD;
			var index = localRequest.ordine.dettaglioordine.size() - 1;&#xD;
			&#xD;
			//STS.CODICE&#xD;
			if(STS.codice != null)&#xD;
			{&#xD;
				attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE;&#xD;
				attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attribDettOrdine.valoreAttributo = STS.codice;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(index).attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
			}&#xD;
		&#xD;
			if(STS.descrizione != null)&#xD;
			{&#xD;
				attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONE;&#xD;
				attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attribDettOrdine.valoreAttributo = STS.descrizione;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(index).attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
			}&#xD;
			&#xD;
			if(STS.codiceDTU != null)&#xD;
			{&#xD;
				attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEDTU;&#xD;
				attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attribDettOrdine.valoreAttributo = STS.codiceDTU;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(index).attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
			}&#xD;
			&#xD;
			if(STS.stato != null)&#xD;
			{&#xD;
				attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
				attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attribDettOrdine.valoreAttributo = STS.stato;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(index).attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Impossibile completare la funzione di arricchimento: componente ACCESSO inesistenti per IDRichiesta &quot; + localRequest.IDRichiestaOLO);&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
		Process.auditLog(&quot;Impossibile completare la funzione di arricchimento: Ordine inesistenti per IDRichiesta &quot; + localRequest.IDRichiestaOLO);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
