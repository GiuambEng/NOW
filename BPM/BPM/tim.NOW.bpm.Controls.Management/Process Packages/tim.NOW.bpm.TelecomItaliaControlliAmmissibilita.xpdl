				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.get(indexCODIFICAOLOAGCOMDONATING).valoreAttributo = ConsistenzaDati.codificaOLOAGCOMDonating;&#xD;
