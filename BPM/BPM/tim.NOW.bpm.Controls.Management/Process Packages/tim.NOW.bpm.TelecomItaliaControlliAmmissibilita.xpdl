                  <xpdl2:Actual ScriptGrammar="JavaScript">var listDN = DataUtil.createList();&#xD;
for(var i=0; i&lt;DATIDBCFX.size(); i++){&#xD;
	listDN.add(DATIDBCFX.get(i).DN);&#xD;
}&#xD;
