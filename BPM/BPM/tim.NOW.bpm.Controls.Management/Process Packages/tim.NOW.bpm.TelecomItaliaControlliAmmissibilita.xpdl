		}&#xD;
		if(!foundFATTURANTE &amp;&amp; FATTURANTE != null)&#xD;
		{&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURANTE;&#xD;
			attributo.valoreAttributo = FATTURANTE;&#xD;
			&#xD;
			currentComponente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			Process.auditLog(&quot;Aggiunto attributo &quot; + attributo.nomeAttributo + &quot; all'ACCESSOCPS&quot;);&#xD;
		}&#xD;
		&#xD;
		//SM_9069: valorizzo distretto&#xD;
		if(numeroTelefonico != null)&#xD;
		{&#xD;
			var tel = numeroTelefonico;&#xD;
			if(tel.charAt(1) == &quot;2&quot; || tel.charAt(1) == &quot;6&quot;)&#xD;
			{&#xD;
				localRequest.ordine.distretto = &quot;0&quot; + tel.slice(0,2);&#xD;
			}&#xD;
			else if(tel.charAt(2) == &quot;0&quot; || tel.charAt(2) == &quot;1&quot; || tel.charAt(2) == &quot;5&quot; || tel.charAt(2) == &quot;9&quot;)&#xD;
			{&#xD;
				localRequest.ordine.distretto = tel.slice(0,3);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				localRequest.ordine.distretto = tel.slice(1,4);&#xD;
			}&#xD;
		}&#xD;
	&#xD;
		//SM_9599 - valorizzazione campi in chiaro della richiesta&#xD;
		if(SottoLav5678)&#xD;
		{&#xD;
			if(numeroTelefonico != null){&#xD;
			localRequest.numeroTelefonico = numeroTelefonico;&#xD;
			localRequest.ordine.numeroTelefonico = numeroTelefonico;&#xD;
			localRequest.ordine.numTelPrincipale = numeroTelefonico;&#xD;
			}&#xD;
			localRequest.IDContratto = AssetCPS.IDContratto;&#xD;
			localRequest.ordine.DEC = AssetCPS.DEC;&#xD;
		}&#xD;
	}&#xD;
	// AGGIUNTIVO già presente nell'ordine se sottolav 5-6-7-8 bisogna metterlo ad A perché arriva in input&#xD;
	else if(currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO&#xD;
	&amp;&amp; SottoLav5678)&#xD;
	{&#xD;
		currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
		Process.auditLog(&quot;Impostata azione ad A - AGGIUNTIVO&quot;);&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
// ARRICCHIMENTO CONSISTENZA&#xD;
//SM_9676: in tutto lo script sostituito consistenzaCPS (che è diventato un array) con consistenzaCPStemp&#xD;
if(consistenzaCPStemp != null)&#xD;
{&#xD;
	var codiceCarrierOloAsset = &quot;&quot;;&#xD;
	codiceCarrierOloAsset = null;&#xD;
	var tipoDNRichiestoAsset = &quot;&quot;;&#xD;
	tipoDNRichiestoAsset = null;&#xD;
	var tipoLineaRichiestoAsset = &quot;&quot;;&#xD;
	tipoLineaRichiestoAsset = null;&#xD;
	var radicaleAsset = &quot;&quot;;&#xD;
	radicaleAsset = null;&#xD;
	&#xD;
	// Recupero informazioni da ASSET&#xD;
	if(AssetCPS!=null)&#xD;
	{&#xD;
		for(var i=0; i &lt; AssetCPS.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var currentDettAsset = AssetCPS.dettaglioasset.get(i);&#xD;
			if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
			{&#xD;
				for(var j=0; j &lt; currentDettAsset.attributidettaglioasset.size() > 0; j++)&#xD;
				{&#xD;
					var attribDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
					if(attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECARRIEROLO)&#xD;
					{&#xD;
						codiceCarrierOloAsset = attribDettAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Recuperato codiceCarrierOlo: &quot;+codiceCarrierOloAsset);&#xD;
					}&#xD;
					else if(attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNRICHIESTO)&#xD;
					{&#xD;
						tipoDNRichiestoAsset = attribDettAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Recuperato tipoDNRichiesto: &quot;+tipoDNRichiestoAsset);&#xD;
					}&#xD;
					else if(attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEARICHIESTO)&#xD;
					{&#xD;
						tipoLineaRichiestoAsset = attribDettAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Recuperato tipoLineaRichiesto: &quot;+tipoLineaRichiestoAsset);&#xD;
					}&#xD;
					else if(attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
					{&#xD;
						radicaleAsset = attribDettAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Recuperato radicale: &quot;+radicaleAsset);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
	&#xD;
	//Creo componente consistenzaCPStemp.&#xD;
	var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
	componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
	componente.IDDettaglioOrdineParent = 1;&#xD;
	componente.IDDettaglioOrdineRoot =1;&#xD;
	componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	componente.IDRisorsa = consistenzaCPStemp.IDRisorsa;&#xD;
	componente.IDRisorsaNOW = consistenzaCPStemp.IDRisorsaNOW;&#xD;
	&#xD;
	componente.created = date;&#xD;
	componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
	componente.lastUpdate = date;&#xD;
	componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS;&#xD;
	componente.operatore = &quot;BPM&quot;;&#xD;
	componente.progressivo = 1;&#xD;
	&#xD;
	componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(consistenzaCPStemp.azione);&#xD;
	&#xD;
	//attributi&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
	attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
	attributo.created = date;&#xD;
	attributo.lastUpdate = date;&#xD;
	attributo.operatore = &quot;BPM&quot;;&#xD;
	attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
	&#xD;
	if(consistenzaCPStemp.IDAsset != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.IDAsset;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(consistenzaCPStemp.IDRisorsa != null)&#xD;
	{&#xD;
