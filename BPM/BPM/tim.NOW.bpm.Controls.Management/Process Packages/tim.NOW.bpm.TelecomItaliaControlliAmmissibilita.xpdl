            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier = &quot;/tim.NOW.bpm.Controls/Process Packages/tim.NOW.bpm.Controls_Ammissibilita.xpdl.CTRLCOMPATIBILITALAVORAZIONE_C04M03F05&quot;;&#xD;
&#xD;
var DestinazioneUso = ConsistenzaFonia.destinazioneUso;&#xD;
&#xD;
if(DestinazioneUso.length == 1)&#xD;
{&#xD;
	ConsistenzaFonia.destinazioneUso = DestinazioneUso + &quot;|4&quot;;&#xD;
	localRequest.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274;&#xD;
	localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274;&#xD;
	Process.auditLog(&quot;Aggiornata Destinazione uso con &quot;+ConsistenzaFonia.destinazioneUso+&quot; e sottolavorazione con &quot;+localRequest.tipologiaSottolav);&#xD;
}&#xD;
else&#xD;
{&#xD;
	ConsistenzaFonia.destinazioneUso = DestinazioneUso.slice(0,1) + &quot;|4&quot;;&#xD;
	Process.auditLog(&quot;Aggiornata Destinazione uso con &quot;+ConsistenzaFonia.destinazioneUso);&#xD;
}&#xD;
</xpdExt:Information>
