        <xpdl2:Activity Id="_CRUewDrbEeu6ZJ3x4S9yVQ" Name="ArricchimentoCPSNPealtro" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento CPS NP e altro">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
var idDettNPPrincipale = 0;&#xD;
idDettNPPrincipale = null;&#xD;
&#xD;
var idToUpdate = DataUtil.createList();&#xD;
&#xD;
//C02M30F05 &#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	if(localRequest.ordine.dettaglioordine.size() > 0)&#xD;
	{&#xD;
		var dettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
				&#xD;
		dettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		&#xD;
		dettOrdine.created = date;&#xD;
		dettOrdine.lastUpdate = date;&#xD;
		dettOrdine.operatore = &quot;BPM&quot;;&#xD;
		dettOrdine.IDRisorsa = localRequest.IDRisorsa;&#xD;
		//dettOrdine.nomeComponente = currentDettAsset.nomeComponente;&#xD;
		&#xD;
		dettOrdine.progressivo = 1;&#xD;
		dettOrdine.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
		dettOrdine.IDDettaglioOrdineParent = 1;&#xD;
		dettOrdine.IDDettaglioOrdineRoot = 1;&#xD;
		&#xD;
		var attribDettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
		attribDettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		&#xD;
		attribDettOrdine.created = date;&#xD;
		attribDettOrdine.lastUpdate = date;&#xD;
		attribDettOrdine.operatore = &quot;BPM&quot;;&#xD;
		&#xD;
		//CONSISTENZACPS&#xD;
		//SM_9676: inserita tutta la logica di arricchimento di CONSISTENZACPS&#xD;
		//ConsistenzaCPS in uscita dal servizio in consistenza è un array e bisogna creare tante componenti CONSISTENZACPS quanti sono gli elementi dell'array&#xD;
		if(ConsistenzaCPS != null &amp;&amp; ConsistenzaCPS.size()>0)&#xD;
		{&#xD;
			for(var c=0; c&lt;ConsistenzaCPS.size(); c++)&#xD;
			{&#xD;
				currentConsistenzaCPS = ConsistenzaCPS.get(c);&#xD;
&#xD;
				if(currentConsistenzaCPS != null)&#xD;
				{&#xD;
					var dettOrdineTemp = ScriptUtil.copy(dettOrdine);&#xD;
					&#xD;
					//AZIONE&#xD;
					if (currentConsistenzaCPS.azione != null)&#xD;
					{&#xD;
						dettOrdineTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(currentConsistenzaCPS.azione);&#xD;
					}&#xD;
					&#xD;
					dettOrdineTemp.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS;&#xD;
					dettOrdineTemp.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
					dettOrdineTemp.integrationID = localRequest.IDRichiestaOLO + dettOrdineTemp.IDDettaglioOrdine;&#xD;
					attribDettOrdine.IDDettaglioOrdine = dettOrdineTemp.IDDettaglioOrdine;&#xD;
					&#xD;
					//IDRISORSA&#xD;
					if(currentConsistenzaCPS.IDRisorsa != null)&#xD;
					{&#xD;
