        <xpdl2:Activity Id="_hJDLYJ8HEemSIcjmnU0c2Q" Name="CheckLavorazione" xpdExt:DisplayName="Check Lavorazione">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
