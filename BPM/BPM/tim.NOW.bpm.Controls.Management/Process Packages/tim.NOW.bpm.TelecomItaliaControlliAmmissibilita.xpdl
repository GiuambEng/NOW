					dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
					localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
				}&#xD;
				/*&#xD;
				//codiceOperatoreRecipient&#xD;
				if(np.codiceOperatoreRecipient != null)&#xD;
				{&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATORERECIPIENT;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = np.codiceOperatoreRecipient;&#xD;
					&#xD;
					dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
				&#xD;
			&#xD;
				}&#xD;
				*/&#xD;
				&#xD;
				//Eliminato con SM_SM_9299&#xD;
				//oloretailer&#xD;
				/*if(np.OLORetailer != null)&#xD;
				{&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = np.OLORetailer;&#xD;
					&#xD;
					dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
				}*/			&#xD;
				&#xD;
				//portabilitaSuccessiva&#xD;
				attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PORTABILITASUCCESSIVA;&#xD;
				attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				if(np.portabilitaSuccessiva != null)&#xD;
				{&#xD;
					attribDettOrdine.valoreAttributo = np.portabilitaSuccessiva;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					attribDettOrdine.valoreAttributo = &quot;N&quot;;&#xD;
				}&#xD;
				dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettOrdineTemp));&#xD;
			}&#xD;
			&#xD;
			for(var ki = 0; ki &lt; idToUpdate.size(); ki++)&#xD;
			{&#xD;
				var currentidToUpdate = parseInt(idToUpdate.get(ki), 10);&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(currentidToUpdate - 1).IDDettaglioOrdineParent = idDettNPPrincipale;&#xD;
				localRequest.ordine.dettaglioordine.get(currentidToUpdate - 1).IDDettaglioOrdineRoot = idDettNPPrincipale;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//Arricchimento del tipolinea per offerta SHA e sovrascrittura tipolinea per DATI CONDIVISI Con TipoLinea da LavorazioneRichiesta --> (SM_6316)&#xD;
		if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA)&#xD;
		&amp;&amp;&#xD;
		LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.tipoLinea != null &amp;&amp; LavorazioneRichiesta.tipoLinea != &quot;&quot;)&#xD;
		{&#xD;
&#xD;
			var TipoLineaTemp = &quot;&quot;;&#xD;
			&#xD;
			if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA)&#xD;
			{&#xD;
				TipoLineaTemp = &quot;ISDN&quot;;&#xD;
			}&#xD;
			else if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA)&#xD;
			{&#xD;
				TipoLineaTemp = &quot;POTS&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				TipoLineaTemp = LavorazioneRichiesta.tipoLinea;&#xD;
			}&#xD;
			&#xD;
			localRequest.ordine.tipologiaLinea = it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.get(TipoLineaTemp);&#xD;
			&#xD;
			var accessoTrovato = false;&#xD;
			var i=0;&#xD;
			while(!accessoTrovato &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
				if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					accessoTrovato = true;&#xD;
					var j=0;&#xD;
					var TipoLineaTrovato = false;&#xD;
					&#xD;
					while(!TipoLineaTrovato &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size()){&#xD;
						var attributoTemp = componente.attributiDettaglioOrdine.get(j);&#xD;
						if(attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
						{&#xD;
							attributoTemp.valoreAttributo = TipoLineaTemp;&#xD;
							TipoLineaTrovato = true;&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
					&#xD;
					if(!TipoLineaTrovato){&#xD;
						&#xD;
						var attr = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						attr.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
						attr.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						attr.created = DateTimeUtil.createDatetime();&#xD;
						attr.lastUpdate = DateTimeUtil.createDatetime();&#xD;
						attr.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
						attr.operatore = &quot;BPM&quot;;&#xD;
						attr.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						attr.valoreAttributo = TipoLineaTemp;&#xD;
						&#xD;
						componente.attributiDettaglioOrdine.add(attr);&#xD;
					}&#xD;
					&#xD;
				}&#xD;
				&#xD;
				i++;&#xD;
			}&#xD;
			&#xD;
		}&#xD;
	&#xD;
		if(LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.migrazioneIntraOlo != null)&#xD;
		{&#xD;
			Process.auditLog(&quot;Logiche di arricchimento MIGRAZIONEINTRAOLO: &quot; + LavorazioneRichiesta.migrazioneIntraOlo);&#xD;
			var added = false;&#xD;
			var i = 0;&#xD;
			&#xD;
			while(!added &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var j = 0;&#xD;
					var MigrazioneIntraOLO = false;&#xD;
					&#xD;
					while(!MigrazioneIntraOLO &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size()) // SM_8420 - Aggiunta anche valorizzazione per sostituzione, se attributo è già presente&#xD;
					{&#xD;
						var attributoTemp = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if(attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MIGRAZIONEINTRAOLO)&#xD;
						{&#xD;
							attributoTemp.valoreAttributo = LavorazioneRichiesta.migrazioneIntraOlo;&#xD;
							MigrazioneIntraOLO = true;&#xD;
						}&#xD;
						&#xD;
						j++;&#xD;
					}&#xD;
					&#xD;
					if(!MigrazioneIntraOLO)&#xD;
					{	&#xD;
						var attTemp = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						attTemp.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
						attTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						attTemp.created = date;&#xD;
						attTemp.lastUpdate = date;&#xD;
						attTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MIGRAZIONEINTRAOLO;&#xD;
						attTemp.operatore = &quot;BPM&quot;;&#xD;
						attTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						attTemp.valoreAttributo = LavorazioneRichiesta.migrazioneIntraOlo;&#xD;
						&#xD;
						currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attTemp));&#xD;
					}&#xD;
					&#xD;
					added = true;&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
	&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Impossibile completare la funzione di arricchimento: componente ACCESSO inesistenti per IDRichiesta &quot; + localRequest.IDRichiestaOLO);&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Impossibile completare la funzione di arricchimento: Ordine inesistenti per IDRichiesta &quot; + localRequest.IDRichiestaOLO);&#xD;
}&#xD;
	&#xD;
//Arricchimento Numero telefonico per ULL/ULLD/SLU SM_5585&#xD;
&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA)){&#xD;
	if(ConsistenzaFonia!= null &amp;&amp; ConsistenzaFonia.numeroTelefonico != null &amp;&amp; ConsistenzaFonia.numeroTelefonico != &quot;&quot;){&#xD;
		localRequest.ordine.numeroTelefonico = ConsistenzaFonia.numeroTelefonico;&#xD;
	}&#xD;
	else{&#xD;
		Process.auditLog(&quot;Impossibile arricchire il numero telefonico dalla componente ConsistenzaFonia&quot;);&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
