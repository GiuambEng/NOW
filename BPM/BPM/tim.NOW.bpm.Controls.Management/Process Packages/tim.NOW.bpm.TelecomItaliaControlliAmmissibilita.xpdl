				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaDati.codiceOrdineTI;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		//CONSISTENZADATI.CODICEORDINEOLO&#xD;
		if(ConsistenzaDati.codiceOrdineOLO != null)&#xD;
		{&#xD;
			if(foundCODICEORDINEOLO)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.get(indexCODICEORDINEOLO).valoreAttributo = ConsistenzaDati.codiceOrdineOLO;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaDati.codiceOrdineOLO;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}	&#xD;
		//CONSISTENZADATI.IDENTIFICATIVOASSET&#xD;
		if(ConsistenzaDati.IDAsset != null)&#xD;
		{&#xD;
			if(foundIDENTIFICATIVOASSET)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.get(indexIDENTIFICATIVOASSET).valoreAttributo = ConsistenzaDati.IDAsset;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
