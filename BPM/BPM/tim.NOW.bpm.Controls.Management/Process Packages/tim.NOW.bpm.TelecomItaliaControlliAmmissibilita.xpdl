        <xpdl2:Activity Id="_cVet8pLwEeuu8rvfxCUX4A" Name="ArricchimentoDettaglioOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Script inserito con R1F-21-0014&#xD;
var data = DateTimeUtil.createDatetime();&#xD;
&#xD;
if(ConsistenzaDati != null)&#xD;
{&#xD;
	var assetTarget = it_telecomitalia_it_NOW_casedata_Factory.createAssetTarget();&#xD;
	assetTarget.IDAsset = ScriptUtil.createBigInteger(ConsistenzaDati.IDAsset);&#xD;
	assetTarget.flagInLavorazione = true;&#xD;
	localRequest.assetTarget.add(ScriptUtil.copy(assetTarget));&#xD;
&#xD;
&#xD;
	//-------------------------------------- AGGIORNAMENTO/CREAZIONE COMPONENTE ACCESSOGPON --------------------------------------------&#xD;
	var foundACCESSO = false;&#xD;
	var i=0;&#xD;
	&#xD;
	var foundCODICEDELIVERY = false;&#xD;
	var foundIDGPON = false;&#xD;
	var foundCOINVESTIMENTO = false;&#xD;
	var foundTIPOLOGIAACCESSOUBB = false;&#xD;
	var foundIDARMADIO = false;&#xD;
	var foundCODICEEGON = false;&#xD;
	var foundIDRISORSA = false;&#xD;
	&#xD;
	//SE TROVIAMO LA COMPONENTE ACCESSO&#xD;
	while(!foundACCESSO &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			foundACCESSO = true;&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				//CODICEDELIVERY&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEDELIVERY&#xD;
				   &amp;&amp; ConsistenzaDati.codiceDelivery != null)&#xD;
				{&#xD;
					foundCODICEDELIVERY = true;&#xD;
					attributo.valoreAttributo = ConsistenzaDati.codiceDelivery;&#xD;
					Process.auditLog(&quot;Aggiornato attributo CODICEDELIVERY&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//IDGPON&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDGPON&#xD;
				        &amp;&amp; ConsistenzaDati.idGpon != null)&#xD;
				{&#xD;
					foundIDGPON = true;&#xD;
					attributo.valoreAttributo = ConsistenzaDati.idGpon;&#xD;
					Process.auditLog(&quot;Aggiornato attributo IDGPON&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//COINVESTIMENTO&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COINVESTIMENTO&#xD;
				        &amp;&amp; ConsistenzaDati.coinvestimento != null)&#xD;
				{&#xD;
					foundCOINVESTIMENTO = true;&#xD;
					attributo.valoreAttributo = ConsistenzaDati.coinvestimento;&#xD;
					Process.auditLog(&quot;Aggiornato attributo COINVESTIMENTO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//TIPOLOGIAACCESSOUBB&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIAACCESSOUBB&#xD;
				        &amp;&amp; ConsistenzaDati.tipologiaAccessoUBB != null)&#xD;
				{&#xD;
