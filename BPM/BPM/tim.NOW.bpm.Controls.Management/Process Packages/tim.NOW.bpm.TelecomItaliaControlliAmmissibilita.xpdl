        <xpdl2:Activity Id="_hD7vU8CBEeaRHo7WrpRbeg" Name="CallCTRLNPSINCRONIZZATA" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Call CTRL NP SINCRONIZZATA">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_1tw0oNcrEeawK-VRC_DmUQ" PackageRef="tim.NOW.bpm.ProcesService.Interfaces" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
