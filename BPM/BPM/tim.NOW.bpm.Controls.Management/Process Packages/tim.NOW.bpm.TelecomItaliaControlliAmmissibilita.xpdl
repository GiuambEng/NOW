		}&#xD;
		&#xD;
		//CONSISTENZADATI.CODICEOPERATOREDONATING&#xD;
		if(ConsistenzaDati.codificaOLOAGCOMDonating != null)&#xD;
		{&#xD;
			if(foundCODIFICAOLOAGCOMDONATING)&#xD;
