					CODEPRESTAGGDaAggiungere = true;&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEPRESTAGG;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = &quot;42&quot;;&#xD;
				}&#xD;
				//WLR su WLR LnA&#xD;
				if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA)	&#xD;
				{&#xD;
					CODEPRESTAGGDaAggiungere = true;&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEPRESTAGG;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = &quot;45&quot;;&#xD;
				}&#xD;
				//WLR su VULL Linea POTS&#xD;
				if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL &amp;&amp;&#xD;
				ConsistenzaFonia.tipoLinea == it_telecomitalia_it_NOW_casedata_v1_TipologiaLineaEnumeration.POTS)	&#xD;
				{&#xD;
					CODEPRESTAGGDaAggiungere = true;&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEPRESTAGG;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = &quot;42&quot;;&#xD;
				}&#xD;
				//WLR su VULL EIP&#xD;
				if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL &amp;&amp;&#xD;
				ConsistenzaDati.tipoLinea == it_telecomitalia_it_NOW_casedata_v1_TipologiaLineaEnumeration.POTS &amp;&amp;&#xD;
				ConsistenzaDati.strutturaLinea == it_telecomitalia_it_NOW_casedata_v1_TipologiaLineaEnumeration.SIMPLEX &amp;&amp;&#xD;
				String(ConsistenzaDati.offerta).slice(0,4) == &quot;EASY&quot;)	&#xD;
				{&#xD;
					CODEPRESTAGGDaAggiungere = true;&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEPRESTAGG;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
