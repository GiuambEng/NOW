        <xpdl2:Activity Id="_jcg_cP0KEeanIs22FMtH7w" Name="ArricchimentoDettaglioOrdine" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Dettaglio Ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">/*Valorizzazione Ordine BTS ATM GBE EASYIP Condiviso*/&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine.size() > 0)&#xD;
{&#xD;
	if(ConsistenzaFonia != null)&#xD;
	{&#xD;
		var data = DateTimeUtil.createDatetime();&#xD;
		&#xD;
