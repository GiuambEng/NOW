        <xpdl2:Activity Id="_3mA-ABqVEeqm15UrkFEWng" Name="ArricchimentoDettaglioOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Dettaglio Ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
var TipoServizioUnica = '';		//datiUnica&#xD;
var TipoNumeroUnica = '';	//datiUnica&#xD;
TipoServizioUnica = null;&#xD;
TipoNumeroUnica = null;&#xD;
&#xD;
if(InterrogazioneInventory != null &amp;&amp; InterrogazioneInventory.CRMWSResponse != null &amp;&amp; InterrogazioneInventory.CRMWSResponse.tipo_Linea != null)&#xD;
{&#xD;
	//Valori da UNica	&#xD;
	if(InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio != null)&#xD;
	{&#xD;
		TipoServizioUnica = InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio;&#xD;
		Process.auditLog(&quot;Recuperato TipoServizioUnica: &quot;+TipoServizioUnica);&#xD;
	}&#xD;
	if(InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Numero != null)&#xD;
	{&#xD;
		TipoNumeroUnica = InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Numero;&#xD;
		Process.auditLog(&quot;Recuperato TipoNumeroUnica: &quot;+TipoNumeroUnica);&#xD;
	}&#xD;
}&#xD;
&#xD;
if(localRequest.ordine.dettaglioordine.size() > 0)&#xD;
{&#xD;
	var foundTipoDNReale = false;&#xD;
	var foundTipoLineaReale = false;&#xD;
	var foundTipoLinea = false;&#xD;
	var foundStrutturaLinea = false;&#xD;
	var foundTipoServizio = false;&#xD;
	var foundTipoNumero = false;&#xD;
	var foundFatturante = false;&#xD;
&#xD;
	var foundInvioADtu = false;&#xD;
	&#xD;
	var StrutturaLineaGNR = false;&#xD;
	&#xD;
	//Aggiorno Componente ACCESSOCPS.&#xD;
	for(var k=0; k &lt; localRequest.ordine.dettaglioordine.size(); k++)&#xD;
	{&#xD;
		var currDettOrd	= localRequest.ordine.dettaglioordine.get(k);&#xD;
		&#xD;
		if(currDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
		{&#xD;
			currDettOrd.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
			&#xD;
			for(var z=0; z &lt; currDettOrd.attributiDettaglioOrdine.size(); z++)&#xD;
			{&#xD;
				var currAttrDettOrd = currDettOrd.attributiDettaglioOrdine.get(z);&#xD;
				&#xD;
				if(currAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNREALE&#xD;
				&amp;&amp; TipoLineaUnica != null)&#xD;
				{&#xD;
					currAttrDettOrd.valoreAttributo = TipoLineaUnica;&#xD;
					foundTipoDNReale = true;							&#xD;
				}&#xD;
				else if(currAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAREALE&#xD;
				&amp;&amp; StrutturaLineaUnica != null)&#xD;
				{&#xD;
					currAttrDettOrd.valoreAttributo = StrutturaLineaUnica;&#xD;
					foundTipoLineaReale = true;&#xD;
				}&#xD;
				else if(currAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU)&#xD;
				{&#xD;
					currAttrDettOrd.valoreAttributo = &quot;Y&quot;;&#xD;
					foundInvioADtu = true;							&#xD;
				}&#xD;
				else if(currAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA&#xD;
				&amp;&amp; TipoLineaUnica != null)&#xD;
				{&#xD;
					currAttrDettOrd.valoreAttributo = TipoLineaUnica;&#xD;
					foundTipoLinea = true;					&#xD;
				}&#xD;
				else if(currAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA&#xD;
				&amp;&amp; StrutturaLineaUnica != null)&#xD;
				{&#xD;
					currAttrDettOrd.valoreAttributo = StrutturaLineaUnica;&#xD;
					foundStrutturaLinea = true;					&#xD;
				}&#xD;
				else if(currAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO&#xD;
				&amp;&amp; TipoServizioUnica != null)&#xD;
				{&#xD;
					currAttrDettOrd.valoreAttributo = TipoServizioUnica;&#xD;
					foundTipoServizio = true;					&#xD;
				}&#xD;
				else if(currAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO&#xD;
				&amp;&amp; TipoNumeroUnica != null)&#xD;
				{&#xD;
					currAttrDettOrd.valoreAttributo = TipoNumeroUnica;&#xD;
					foundTipoNumero = true;					&#xD;
				}				&#xD;
				//sm9068 -- valorizzazione numTelPrincipale.&#xD;
				else if(currAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN)&#xD;
				{&#xD;
					localRequest.ordine.numTelPrincipale = currAttrDettOrd.valoreAttributo;&#xD;
				}&#xD;
				// RU_990&#xD;
				else if(currAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURANTE&#xD;
					 &amp;&amp; DatiRetailOutput != null &amp;&amp; DatiRetailOutput.fatturante != null)&#xD;
				{&#xD;
					foundFatturante = true;&#xD;
					currAttrDettOrd.valoreAttributo = DatiRetailOutput.fatturante; // SM_9294: prima veniva valorizzato con il DN&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			&#xD;
			&#xD;
			if(!foundTipoDNReale || !foundTipoLineaReale || !foundInvioADtu || !foundTipoLinea || !foundStrutturaLinea || !foundTipoServizio || !foundTipoNumero || !foundFatturante)&#xD;
			{&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributo.created = date;&#xD;
				attributo.lastUpdate = date;&#xD;
				attributo.operatore = localRequest.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.IDDettaglioOrdine = currDettOrd.IDDettaglioOrdine;&#xD;
				&#xD;
				if(!foundTipoDNReale &amp;&amp; TipoLineaUnica != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNREALE;&#xD;
					attributo.valoreAttributo = TipoLineaUnica;&#xD;
					currDettOrd.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Aggiunto attributo: &quot;+attributo.nomeAttributo+&quot; con valore &quot;+attributo.valoreAttributo+&quot; all'accesso&quot;);&#xD;
				}&#xD;
				if(!foundTipoLineaReale &amp;&amp; StrutturaLineaUnica != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAREALE;&#xD;
					attributo.valoreAttributo = StrutturaLineaUnica;&#xD;
					currDettOrd.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Aggiunto attributo: &quot;+attributo.nomeAttributo+&quot; con valore &quot;+attributo.valoreAttributo+&quot; all'accesso&quot;);&#xD;
				}&#xD;
				if(!foundTipoLinea &amp;&amp; TipoLineaUnica != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
					attributo.valoreAttributo = TipoLineaUnica;&#xD;
					currDettOrd.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Aggiunto attributo: &quot;+attributo.nomeAttributo+&quot; con valore &quot;+attributo.valoreAttributo+&quot; all'accesso&quot;);					&#xD;
				}&#xD;
				if(!foundStrutturaLinea &amp;&amp; StrutturaLineaUnica != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA;&#xD;
					attributo.valoreAttributo = StrutturaLineaUnica;&#xD;
					currDettOrd.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Aggiunto attributo: &quot;+attributo.nomeAttributo+&quot; con valore &quot;+attributo.valoreAttributo+&quot; all'accesso&quot;);&#xD;
				}&#xD;
				if(!foundTipoServizio &amp;&amp; TipoServizioUnica != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO;&#xD;
					attributo.valoreAttributo = TipoServizioUnica;&#xD;
					currDettOrd.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Aggiunto attributo: &quot;+attributo.nomeAttributo+&quot; con valore &quot;+attributo.valoreAttributo+&quot; all'accesso&quot;);					&#xD;
				}				&#xD;
				if(!foundTipoNumero &amp;&amp; TipoNumeroUnica != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO;&#xD;
					attributo.valoreAttributo = TipoNumeroUnica;&#xD;
					currDettOrd.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Aggiunto attributo: &quot;+attributo.nomeAttributo+&quot; con valore &quot;+attributo.valoreAttributo+&quot; all'accesso&quot;);					&#xD;
				}&#xD;
				if(!foundInvioADtu)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU;&#xD;
					attributo.valoreAttributo = &quot;Y&quot;;&#xD;
					currDettOrd.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Aggiunto attributo: &quot;+attributo.nomeAttributo+&quot; con valore &quot;+attributo.valoreAttributo+&quot; all'accesso&quot;);&#xD;
				}&#xD;
				//RU_990&#xD;
				if(!foundFatturante &amp;&amp; DatiRetailOutput != null &amp;&amp; DatiRetailOutput.fatturante != null)&#xD;
				{&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURANTE;&#xD;
					attributo.valoreAttributo = DatiRetailOutput.fatturante; // SM_9294: prima veniva valorizzato con il DN&#xD;
					currDettOrd.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Aggiunto attributo: &quot;+attributo.nomeAttributo+&quot; con valore &quot;+attributo.valoreAttributo+&quot; all'accesso&quot;);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;ACCESSO non presente nell'ordine&quot;);&#xD;
}&#xD;
&#xD;
&#xD;
//SM_9053: valorizzazione distretto&#xD;
if(localRequest.numeroTelefonico != null)&#xD;
{&#xD;
	var tel = localRequest.numeroTelefonico;&#xD;
	if(tel.charAt(1) == &quot;2&quot; || tel.charAt(1) == &quot;6&quot;)&#xD;
	{&#xD;
		localRequest.ordine.distretto = &quot;0&quot; + tel.slice(0,2);&#xD;
	}&#xD;
	else if(tel.charAt(2) == &quot;0&quot; || tel.charAt(2) == &quot;1&quot; || tel.charAt(2) == &quot;5&quot; || tel.charAt(2) == &quot;9&quot;)&#xD;
	{&#xD;
		localRequest.ordine.distretto = tel.slice(0,3);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		localRequest.ordine.distretto = tel.slice(1,4);&#xD;
	}&#xD;
}&#xD;
&#xD;
// CONSISTENZA CPS&#xD;
//SM_9676: in tutto lo script sostituito consistenzaCPS (che è diventato un array) con consistenzaCPStemp&#xD;
if(consistenzaCPS != null &amp;&amp; consistenzaCPS.size()>0)&#xD;
{&#xD;
	consistenzaCPStemp = consistenzaCPS.get(0);&#xD;
}&#xD;
&#xD;
if(consistenzaCPStemp != null)&#xD;
{&#xD;
	//Creo componente consistenzaCPStemp.&#xD;
	var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
	componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
	componente.IDDettaglioOrdineParent = 1;&#xD;
	componente.IDDettaglioOrdineRoot =1;&#xD;
	componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	componente.IDRisorsa = consistenzaCPStemp.IDRisorsa;&#xD;
	componente.IDRisorsaNOW = consistenzaCPStemp.IDRisorsaNOW;&#xD;
	&#xD;
	componente.created = date;&#xD;
	componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
	componente.lastUpdate = date;&#xD;
	componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS;&#xD;
	componente.operatore = &quot;BPM&quot;;&#xD;
	componente.progressivo = 1;&#xD;
	&#xD;
	componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(consistenzaCPStemp.azione);&#xD;
	&#xD;
	//attributi&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
	attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
	attributo.created = date;&#xD;
	attributo.lastUpdate = date;&#xD;
	attributo.operatore = &quot;BPM&quot;;&#xD;
	attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
	&#xD;
	if(consistenzaCPStemp.IDAsset != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.IDAsset;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(consistenzaCPStemp.IDRisorsa != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.IDRisorsa;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
	}&#xD;
	if(consistenzaCPStemp.IDRisorsaNOW != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSANOW;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.IDRisorsaNOW;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
	}&#xD;
	if(consistenzaCPStemp.codiceOrdineOLO != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLO;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.codiceOrdineOLO;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);				&#xD;
	}&#xD;
	if(consistenzaCPStemp.codiceOrdineTI != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETI;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.codiceOrdineTI;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(consistenzaCPStemp.invioADtu != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU;&#xD;
		attrTemp.valoreAttributo = &quot;N&quot;;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
	}&#xD;
	if(consistenzaCPStemp.numeroFittizio != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROFITTIZIO;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.numeroFittizio;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
	}&#xD;
	if(consistenzaCPStemp.numeroTelefonico != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.numeroTelefonico;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);				&#xD;
	}&#xD;
	if(consistenzaCPStemp.numeroTelefonicoPrincipale != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.numeroTelefonicoPrincipale;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(consistenzaCPStemp.offerta != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA;&#xD;
		attrTemp.valoreAttributo = String(consistenzaCPStemp.offerta);&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
	}&#xD;
	if(consistenzaCPStemp.opzioneTraffico != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.opzioneTraffico;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
	}&#xD;
	if(consistenzaCPStemp.tipoDnReale != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNREALE;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.tipoDnReale;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);				&#xD;
	}&#xD;
	if(consistenzaCPStemp.tipoLineaReale != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAREALE;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.tipoLineaReale;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}			&#xD;
	if(consistenzaCPStemp.quantitaLinee != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITALINEE;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.quantitaLinee;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(consistenzaCPStemp.dnPrimario != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DNPRIMARIO;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.dnPrimario;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
	}&#xD;
	if(consistenzaCPStemp.dsc != null)		&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.DATE; 		//sm9068	&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.dsc;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
	}&#xD;
	if(consistenzaCPStemp.codificaOLOAGCOMDonating != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.codificaOLOAGCOMDonating;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);				&#xD;
	}&#xD;
	if(consistenzaCPStemp.assetBTWhiteList != null) //R1E-21-0325&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.WHITELIST;&#xD;
		attrTemp.valoreAttributo = consistenzaCPStemp.assetBTWhiteList;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);				&#xD;
	}&#xD;
	&#xD;
	localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
	Process.auditLog(&quot;Aggiunta Consistenza CPS all'ordine&quot;);&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;consistenzaCPStemp inesistente, non aggiunta all'ordine.&quot;);&#xD;
}&#xD;
&#xD;
// AGGIUNTIVI RETAIL - nuovi AGGIUNTIVI da assettizzare&#xD;
//RU_990: la componente AGGIUNTIVO viene creata se è presente AGGIUNTIVIRETAIL in uscita dal controllo CTRL INTERROGA CONSISTENZE CRM RETAIL_C04M01F338&#xD;
//e non più se è presente AGGIUNTIVIUNICA in uscita dal controllo CTRL INVENTORY_C04M01F79&#xD;
&#xD;
//SM_9315: aggiunto TipoLineaUnica = POTS per PBX e GNR&#xD;
if(((StrutturaLineaUnica == 'BRA MULTI' &amp;&amp; TipoLineaUnica == 'ISDN') &#xD;
   ||((StrutturaLineaUnica == 'PBX' || StrutturaLineaUnica == 'GNR') &amp;&amp; (TipoLineaUnica == 'ISDN' || TipoLineaUnica == 'POTS'))) &#xD;
&amp;&amp; (AggiuntiviRetailOutput != null &amp;&amp; AggiuntiviRetailOutput.size()>0))&#xD;
{&#xD;
	for(var k = 0; k &lt; AggiuntiviRetailOutput.size(); k++)&#xD;
	{&#xD;
		if(AggiuntiviRetailOutput.get(k).stato.toUpperCase() == 'ATTIVO')&#xD;
		{&#xD;
			//Creo componente AGGIUNTIVO.&#xD;
			var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
			componente.IDDettaglioOrdineParent = 1;&#xD;
			componente.IDDettaglioOrdineRoot =1;&#xD;
			componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			componente.IDRisorsa = localRequest.IDRisorsa;&#xD;
			componente.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
			&#xD;
			componente.created = date;&#xD;
			componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
			componente.lastUpdate = date;&#xD;
			componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO;&#xD;
			componente.operatore = &quot;BPM&quot;;&#xD;
			componente.progressivo = 1;&#xD;
			&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
			&#xD;
			//attributi&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = date;&#xD;
			attributo.lastUpdate = date;&#xD;
			attributo.operatore = &quot;BPM&quot;;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			&#xD;
			if(localRequest.ordine != null &amp;&amp; localRequest.ordine.numTelPrincipale != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
				attrTemp.valoreAttributo = localRequest.ordine.numTelPrincipale;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
			}&#xD;
			if(AggiuntiviRetailOutput.get(k).numeroTelefonico != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
				attrTemp.valoreAttributo = AggiuntiviRetailOutput.get(k).numeroTelefonico;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);	&#xD;
			}&#xD;
			if(AggiuntiviRetailOutput.get(k).stato != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
				attrTemp.valoreAttributo = AggiuntiviRetailOutput.get(k).stato;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);	&#xD;
			}		&#xD;
			if(DatiRetailOutput != null &amp;&amp; DatiRetailOutput.caposerie != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE;&#xD;
				attrTemp.valoreAttributo = DatiRetailOutput.caposerie;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
			}&#xD;
			if(DatiRetailOutput != null &amp;&amp; DatiRetailOutput.radicale != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE;&#xD;
				attrTemp.valoreAttributo = DatiRetailOutput.radicale;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
			}&#xD;
			&#xD;
			&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
			Process.auditLog(&quot;Aggiunto AGGIUNTIVO &quot;+AggiuntiviRetailOutput.get(k).numeroTelefonico+&quot; all'ordine&quot;);&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;AGGIUNTIVO &quot;+AggiuntiviRetailOutput.get(k).numeroTelefonico+&quot; con stato &quot;+AggiuntiviRetailOutput.get(k).stato+&quot; non aggiunto all'ordine&quot;);&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Nessun Aggiuntivo aggiunto all'ordine, TipoLinea: &quot;+TipoLineaUnica);&#xD;
}&#xD;
&#xD;
&#xD;
// RU_975 - AGGIUNTIVI eventualmente da cessare (prelevati da singoli asset, caso PBX)&#xD;
if(consistenzaCPStemp != null &#xD;
&amp;&amp; String(consistenzaCPStemp.azione) == 'D' &#xD;
&amp;&amp; consistenzaCPStemp.tipoLineaReale == 'PBX')&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numTelPrincipale = :DNprincipale AND numeroTelefonico &lt;> :numeroTelefonico AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND offerta IN ('CPS')&quot;);&#xD;
&#xD;
	c.setQueryParameter(&quot;DNprincipale&quot;,consistenzaCPStemp.numeroTelefonico);&#xD;
	c.setQueryParameter(&quot;numeroTelefonico&quot;,consistenzaCPStemp.numeroTelefonico);	&#xD;
	var assetReference = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
&#xD;
	Process.auditLog(&quot;Trovati &quot;+String(assetReference.size())+&quot; aggiuntivi legati alla CPS cessata &quot;+consistenzaCPStemp.numeroTelefonico);&#xD;
&#xD;
&#xD;
	if(assetReference.size()>0)&#xD;
	{&#xD;
		var IDAssetCPS = &quot;&quot;;&#xD;
		IDAssetCPS = null;&#xD;
		&#xD;
		for(var z = 0; z &lt; assetReference.size(); z++)&#xD;
		{&#xD;
			assetRef = assetReference.get(z);&#xD;
			var assetTemp = assetRef.readAsset();&#xD;
			&#xD;
			for(var i=0; i &lt; assetTemp.dettaglioasset.size(); i++) //Recupero informazioni dal singolo asset AGGIUNTIVO.&#xD;
			{&#xD;
				var currentDettAsset = assetTemp.dettaglioasset.get(i);&#xD;
				&#xD;
				if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
				{&#xD;
					var compAggiuntivo = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
					compAggiuntivo.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
					compAggiuntivo.IDDettaglioOrdineParent = 1;&#xD;
					compAggiuntivo.IDDettaglioOrdineRoot =1;&#xD;
					compAggiuntivo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					compAggiuntivo.IDRisorsa = localRequest.IDRisorsa;&#xD;
					compAggiuntivo.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
					&#xD;
					compAggiuntivo.created = date;&#xD;
					compAggiuntivo.integrationID = localRequest.IDRichiestaOLO+compAggiuntivo.IDDettaglioOrdine;&#xD;
					compAggiuntivo.lastUpdate = date;&#xD;
					compAggiuntivo.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO;&#xD;
					compAggiuntivo.operatore = &quot;BPM&quot;;&#xD;
					compAggiuntivo.progressivo = 1;&#xD;
					&#xD;
					compAggiuntivo.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
					&#xD;
					//attributi&#xD;
					var attributoAgg = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attributoAgg.IDDettaglioOrdine = compAggiuntivo.IDDettaglioOrdine;&#xD;
					attributoAgg.IDRichiestaOLO = compAggiuntivo.IDRichiestaOLO;&#xD;
					attributoAgg.created = date;&#xD;
					attributoAgg.lastUpdate = date;&#xD;
					attributoAgg.operatore = &quot;BPM&quot;;&#xD;
					attributoAgg.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					&#xD;
					for(var j=0; j &lt; currentDettAsset.attributidettaglioasset.size() > 0; j++)&#xD;
					{&#xD;
						var attribDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN)&#xD;
						{&#xD;
							var attrTemp = ScriptUtil.copy(attributoAgg);&#xD;
							attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
							attrTemp.valoreAttributo = attribDettAsset.valoreAttributo;&#xD;
							compAggiuntivo.attributiDettaglioOrdine.add(attrTemp);&#xD;
							Process.auditLog(&quot;Aggiunto attributo &quot;+attrTemp.nomeAttributo+&quot; alla componente Aggiuntivo, con valore &quot;+attrTemp.valoreAttributo);&#xD;
							&#xD;
							var attrTemp2 = ScriptUtil.copy(attributoAgg);&#xD;
							attrTemp2.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
							attrTemp2.valoreAttributo = consistenzaCPStemp.numeroTelefonico;&#xD;
							compAggiuntivo.attributiDettaglioOrdine.add(attrTemp2);&#xD;
							Process.auditLog(&quot;Aggiunto attributo &quot;+attrTemp2.nomeAttributo+&quot; alla componente Aggiuntivo, con valore &quot;+attrTemp2.valoreAttributo);&#xD;
							&#xD;
							var attrTemp3 = ScriptUtil.copy(attributoAgg);&#xD;
							attrTemp3.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
							attrTemp3.valoreAttributo = &quot;ATTIVO&quot;;&#xD;
							compAggiuntivo.attributiDettaglioOrdine.add(attrTemp3);&#xD;
							Process.auditLog(&quot;Aggiunto attributo &quot;+attrTemp3.nomeAttributo+&quot; alla componente Aggiuntivo, con valore &quot;+attrTemp3.valoreAttributo);&#xD;
						}&#xD;
						else if(attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE&#xD;
							 || attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
						{&#xD;
							var attrTemp = ScriptUtil.copy(attributoAgg);&#xD;
							attrTemp.nomeAttributo = attribDettAsset.nomeAttributo;&#xD;
							attrTemp.valoreAttributo = attribDettAsset.valoreAttributo;&#xD;
							compAggiuntivo.attributiDettaglioOrdine.add(attrTemp);&#xD;
							Process.auditLog(&quot;Aggiunto attributo &quot;+attrTemp.nomeAttributo+&quot; alla componente Aggiuntivo, con valore &quot;+attrTemp.valoreAttributo);&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(compAggiuntivo));&#xD;
					Process.auditLog(&quot;Aggiunta Componente Aggiuntivo PBX all'ordine&quot;);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Nessun asset recuperato per offerta: &quot;+localRequest.offerta+&quot; numeroTelefonico: &quot;+consistenzaCPStemp.numeroTelefonico);&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
