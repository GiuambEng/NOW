        <xpdl2:Activity Id="_N2QhWQ_hEeyv0vptZh267A" Name="Scarto" xpdExt:Visibility="Private" xpdExt:DisplayName="Scarto">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Trigger="Link">
              <xpdl2:TriggerResultLink CatchThrow="CATCH" Name="0"/>
            </xpdl2:IntermediateEvent>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="57.0" LaneId="_yZMIMQ_gEeyv0vptZh267A" Width="52.0">
              <xpdl2:Coordinates XCoordinate="112.0" YCoordinate="492.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_VxKiYg_hEeyv0vptZh267A" Name="ArricchimentoConsistenzaNPNGeDettaglioOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento ConsistenzaNPNG e Dettaglio Ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Script inserito con RU_1203&#xD;
var data = DateTimeUtil.createDatetime();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; ConsistenzaNPNG != null)&#xD;
{&#xD;
	&#xD;
	//AGGIORNAMENTO/CREAZIONE COMPONENTE ACCESSO&#xD;
	var foundACCESSO = false;&#xD;
	var i=0;&#xD;
	&#xD;
	var foundOPZIONETRAFFICO = false;&#xD;
	var foundTIPOPROVISIONING = false;&#xD;
	var foundROUTINGNUMBER= false;&#xD;
	var foundDSC = false;&#xD;
	var foundCODICEOPERATOREDONOR = false;&#xD;
	&#xD;
	//SE TROVIAMO LA COMPONENTE ACCESSO&#xD;
	while(!foundACCESSO &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			foundACCESSO = true;&#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				//OPZIONETRAFFICO&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO&#xD;
				   &amp;&amp; ConsistenzaNPNG.opzioneTraffico != null)&#xD;
				{&#xD;
					foundOPZIONETRAFFICO = true;&#xD;
					attributo.valoreAttributo = ConsistenzaNPNG.opzioneTraffico;&#xD;
					Process.auditLog(&quot;Aggiornato attributo OPZIONETRAFFICO&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//TIPOPROVISIONING&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROVISIONING&#xD;
				        &amp;&amp; ConsistenzaNPNG.tipoProvisioning != null)&#xD;
				{&#xD;
					foundTIPOPROVISIONING = true;&#xD;
					attributo.valoreAttributo = ConsistenzaNPNG.tipoProvisioning;&#xD;
					Process.auditLog(&quot;Aggiornato attributo TIPOPROVISIONING&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//ROUTINGNUMBER&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER&#xD;
				        &amp;&amp; ConsistenzaNPNG.routingNumber != null)&#xD;
				{&#xD;
					foundROUTINGNUMBER = true;&#xD;
					attributo.valoreAttributo = ConsistenzaNPNG.routingNumber;&#xD;
					Process.auditLog(&quot;Aggiornato attributo ROUTINGNUMBER&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//DSC&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC&#xD;
				        &amp;&amp; ConsistenzaNPNG.DSC != null)&#xD;
				{&#xD;
					foundDSC = true;&#xD;
					attributo.valoreAttributo = ConsistenzaNPNG.DSC;&#xD;
					Process.auditLog(&quot;Aggiornato attributo DSC&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//CODICEOPERATOREDONOR&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR&#xD;
				        &amp;&amp; ConsistenzaNPNG.codiceOperatoreDonor != null)&#xD;
				{&#xD;
					foundCODICEOPERATOREDONOR = true;&#xD;
					attributo.valoreAttributo = ConsistenzaNPNG.codiceOperatoreDonor;&#xD;
					Process.auditLog(&quot;Aggiornato attributo CODICEOPERATOREDONOR&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}			&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	//SE NON TROVIAMO LA COMPONENTE ACCESSO&#xD;
	if(!foundACCESSO)&#xD;
	{&#xD;
		var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
		componente.IDDettaglioOrdineParent = 1;&#xD;
		componente.IDDettaglioOrdineRoot =1;&#xD;
		componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componente.IDRisorsa= ConsistenzaNPNG.IDRisorsa;&#xD;
		componente.IDRisorsaNOW = ConsistenzaNPNG.IDRisorsaNOW;&#xD;
		componente.created = data;&#xD;
		componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
		componente.lastUpdate = data;&#xD;
		componente.operatore = &quot;BPM&quot;;&#xD;
		componente.progressivo = 1;&#xD;
		componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONPNG;	&#xD;
	}&#xD;
&#xD;
	//SE NON TROVIAMO GLI ATTRIBUTI&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
	attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
	attributo.created = data;&#xD;
	attributo.lastUpdate = data;&#xD;
	attributo.operatore = &quot;BPM&quot;;&#xD;
	&#xD;
	//OPZIONETRAFFICO&#xD;
	if(!foundOPZIONETRAFFICO &amp;&amp; ConsistenzaNPNG.opzioneTraffico != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaNPNG.opzioneTraffico;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//TIPOPROVISIONING&#xD;
	if(!foundTIPOPROVISIONING &amp;&amp; ConsistenzaNPNG.tipoProvisioning != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROVISIONING;&#xD;
		attrTemp.valoreAttributo = ConsistenzaNPNG.tipoProvisioning;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//ROUTINGNUMBER&#xD;
	if(!foundROUTINGNUMBER &amp;&amp; ConsistenzaNPNG.routingNumber != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER;&#xD;
		attrTemp.valoreAttributo = ConsistenzaNPNG.routingNumber;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//DSC&#xD;
	if(!foundDSC &amp;&amp; ConsistenzaNPNG.DSC != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC;&#xD;
		attrTemp.valoreAttributo = ConsistenzaNPNG.DSC;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//CODICEOPERATOREDONOR&#xD;
	if(!foundCODICEOPERATOREDONOR &amp;&amp; ConsistenzaNPNG.codiceOperatoreDonor != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR;&#xD;
		attrTemp.valoreAttributo = ConsistenzaNPNG.codiceOperatoreDonor;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	&#xD;
	//Se non ha trovato la componente ACCESSO, allora va aggiunta quella che abbiamo creato&#xD;
	if(!foundACCESSO)&#xD;
	{&#xD;
		localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
	}&#xD;
	&#xD;
	&#xD;
	//CONFIGURAZIONE AZIONE&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			//ATTIVAZIONE CAMBIOOLO -> va cessata la consistenza e creata una nuova (funziona come una migrazione)&#xD;
			if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;   &#xD;
			}&#xD;
			//CESSAZIONE CAMBIOOLO -> va cessata la consistenza e va cambiato l'OLO della consistenza&#xD;
			else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
			{&#xD;
				componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;  &#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Azione non configurata per la componente: &quot; + componente.nomeComponente);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	&#xD;
	//ARRICCHIMENTO CONSISTENZANPNG&#xD;
	var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
	if(ConsistenzaNPNG != null)&#xD;
	{&#xD;
		var assetTarget = it_telecomitalia_it_NOW_casedata_Factory.createAssetTarget();&#xD;
		assetTarget.IDAsset = ScriptUtil.createBigInteger(ConsistenzaNPNG.IDAsset);&#xD;
		assetTarget.flagInLavorazione = true;&#xD;
		localRequest.assetTarget.add(ScriptUtil.copy(assetTarget));&#xD;
&#xD;
		//-------------------------------------- CREAZIONE COMPONENTE CONSISTENZANPNG --------------------------------------------&#xD;
		&#xD;
		Process.auditLog(&quot;Arricchimento CONSISTENZA DATI nell'ordine&quot;);&#xD;
		&#xD;
		var dettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		dettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		dettOrdine.created = date;&#xD;
		dettOrdine.lastUpdate = date;&#xD;
		dettOrdine.operatore = &quot;BPM&quot;;&#xD;
		dettOrdine.IDRisorsa = localRequest.IDRisorsa;&#xD;
