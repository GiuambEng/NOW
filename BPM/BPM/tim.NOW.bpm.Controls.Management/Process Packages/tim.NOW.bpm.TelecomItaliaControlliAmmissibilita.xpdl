        <xpdl2:Activity Id="__lTTckB3Eeuk4Y22K_3PZA" Name="ArricchimentoCONSISTENZEVLAN" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento CONSISTENZE VLAN">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	var IDVLANRETEasset = &quot;&quot;;&#xD;
	IDVLANRETEasset = null;&#xD;
&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		Asset = AssetRef.readAsset();&#xD;
	}&#xD;
	&#xD;
	if(Asset != null &amp;&amp; Asset.dettaglioasset != null)&#xD;
	{&#xD;
		for(var m=0; m&lt;Asset.dettaglioasset.size(); m++)&#xD;
		{&#xD;
			var componenteAsset = Asset.dettaglioasset.get(m); &#xD;
			&#xD;
			if(String(componenteAsset.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;)&#xD;
			{&#xD;
				for(var k=0; k&lt;componenteAsset.attributidettaglioasset.size(); k++)&#xD;
				{&#xD;
					var attributoAsset = componenteAsset.attributidettaglioasset.get(k);&#xD;
					&#xD;
					if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDVLANRETE)&#xD;
					{&#xD;
						IDVLANRETEasset = attributoAsset.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo IDVLANRETE:&quot; +IDVLANRETEasset+ &quot;in asset&quot;);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//CODICECLLI&#xD;
	if(ConsistenzaRaccolta.codiceClli != null)&#xD;
	{&#xD;
		localRequest.ordine.CLLI = ConsistenzaRaccolta.codiceClli;&#xD;
	}&#xD;
	&#xD;
	&#xD;
	//ARRICCHIMENTO CONSISTENZA RACCOLTA&#xD;
	Process.auditLog(&quot;Arricchimento CONSISTENZA RACCOLTA nell'ordine&quot;);&#xD;
	var date = DateTimeUtil.createDatetime();&#xD;
	var dettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
&#xD;
	dettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
&#xD;
	dettOrdine.created = date;&#xD;
	dettOrdine.lastUpdate = date;&#xD;
	dettOrdine.operatore = &quot;BPM&quot;;&#xD;
	dettOrdine.IDRisorsa = localRequest.IDRisorsa;&#xD;
&#xD;
	dettOrdine.progressivo = 1;&#xD;
	dettOrdine.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
	dettOrdine.IDDettaglioOrdineParent = 1;&#xD;
	dettOrdine.IDDettaglioOrdineRoot = 1;&#xD;
&#xD;
	var attribDettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attribDettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
&#xD;
	attribDettOrdine.created = date;&#xD;
	attribDettOrdine.lastUpdate = date;&#xD;
	attribDettOrdine.operatore = &quot;BPM&quot;;&#xD;
		&#xD;
	if(ConsistenzaRaccolta.azione != null)&#xD;
	{&#xD;
		dettOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(ConsistenzaRaccolta.azione);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		dettOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
	}&#xD;
	&#xD;
	dettOrdine.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZARACCOLTA;&#xD;
	dettOrdine.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
	dettOrdine.integrationID = localRequest.IDRichiestaOLO + dettOrdine.IDDettaglioOrdine;&#xD;
	attribDettOrdine.IDDettaglioOrdine = dettOrdine.IDDettaglioOrdine;&#xD;
	&#xD;
	//IDRISORSA&#xD;
	if(ConsistenzaRaccolta.IDRisorsa != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.IDRisorsa;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//IDRISORSANOW&#xD;
	if(ConsistenzaRaccolta.IDRisorsaNOW != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSANOW;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.IDRisorsaNOW;&#xD;
		&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));					&#xD;
	}&#xD;
	//CODIFICAOLOAGCOMDONATING&#xD;
	if(ConsistenzaRaccolta.codificaOLOAGCOMDonating != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.codificaOLOAGCOMDonating;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//OFFERTA&#xD;
	if(ConsistenzaRaccolta.offerta != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = String(ConsistenzaRaccolta.offerta);&#xD;
		&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));		&#xD;
	}&#xD;
	//CODICEORDINETI&#xD;
	if(ConsistenzaRaccolta.codiceOrdineTI != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETI;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.codiceOrdineTI;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//CODICEORDINEOLO&#xD;
	if(ConsistenzaRaccolta.codiceOrdineOLO != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLO;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.codiceOrdineOLO;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//IDENTIFICATIVOASSET&#xD;
	if(ConsistenzaRaccolta.IDAsset != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.IDAsset;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//TIPOLOGIACLUSTERVLAN&#xD;
	if(ConsistenzaRaccolta.tipologiaClusterVlan != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.tipologiaClusterVlan;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//FTTHONLY&#xD;
	if(ConsistenzaRaccolta.ftthOnly != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FTTHONLY;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.ftthOnly;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//CODICETDKIT&#xD;
	if(ConsistenzaRaccolta.codiceTdKit != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.codiceTdKit;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//PROFILOBMC&#xD;
	if(ConsistenzaRaccolta.profiloBmc != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMC;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.NUMBER;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.profiloBmc;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//FAMIGLIAVLAN&#xD;
	if(ConsistenzaRaccolta.famigliaVlan != null)&#xD;
