                <xpdl2:DataMapping Direction="IN" Formal="DN">
                  <xpdExt:ScriptInformation Id="_LIWtsAH-EemGCZFZxfagyQ" Name="DN"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.DNAggiuntivo.get(ContaDATIDBCFX);</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
