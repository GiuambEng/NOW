        <xpdl2:Transition Id="_Fa2V2XEcEeeQ697QNmH5aw" xpdExt:DisplayName="" Name="" From="_Fa2VynEcEeeQ697QNmH5aw" To="_Fa2VxnEcEeeQ697QNmH5aw">
          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var result = EsitoResponse.codice;&#xD;
&#xD;
var num = &quot;&quot;;&#xD;
//num = null;&#xD;
&#xD;
//if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
//{&#xD;
	num = localRequest.numeroTelefonico;&#xD;
/*}&#xD;
else&#xD;
{&#xD;
	num = localRequest.DNAggiuntivo.get(0);&#xD;
}&#xD;
*/&#xD;
&#xD;
//if(result){&#xD;
if(result &amp;&amp; num!=null &amp;&amp; num!=&quot;&quot;){&#xD;
	if(InventoryOutTemp != null &amp;&amp; InventoryOutTemp.datiUnica!=null){&#xD;
		if(InventoryOutTemp.datiUnica.numeroTelefonicoPrincipale != num){&#xD;
			result = false;&#xD;
			Process.auditLog(&quot;Numero di telefono della richiesta: &quot;+num+&quot; differente dal principale di DATIDBCFX: &quot;+DATIDBCFX.get(ContaDATIDBCFX-1).DN);&#xD;
		}&#xD;
	}&#xD;
	else{&#xD;
		result = false;&#xD;
		Process.auditLog(&quot;Informazioni di InventoryOut insufficienti per DATIDBCFX: &quot;+DATIDBCFX.get(ContaDATIDBCFX-1).DN);&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
result;</xpdl2:Expression>
</xpdl2:Condition>
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
          </xpdl2:ConnectorGraphicsInfos>
        </xpdl2:Transition>
        <xpdl2:Transition Id="_Fa2V2nEcEeeQ697QNmH5aw" xpdExt:DisplayName="" Name="" From="_C8iqAJZqEeiuWrZsFOblaA" To="_Fa2Vx3EcEeeQ697QNmH5aw">
          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">var intersect=true;&#xD;
&#xD;
if(localRequest.DNAggiuntivo.contains(DATIDBCFX.get(ContaDATIDBCFX).DN))&#xD;
{&#xD;
	intersect= true;&#xD;
}&#xD;
else&#xD;
{&#xD;
	ContaDATIDBCFX++;&#xD;
	intersect= false;&#xD;
}&#xD;
&#xD;
intersect;</xpdl2:Expression></xpdl2:Condition>
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.LabelAnchorPosition"/>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.StartAnchorPosition"/>
