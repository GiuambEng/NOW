		&#xD;
		//CONSISTENZACPS&#xD;
		//SM_9676: inserita tutta la logica di arricchimento di CONSISTENZACPS&#xD;
		//ConsistenzaCPS in uscita dal servizio in consistenza è un array e bisogna creare tante componenti CONSISTENZACPS quanti sono gli elementi dell'array&#xD;
		if(ConsistenzaCPS != null &amp;&amp; ConsistenzaCPS.size()>0)&#xD;
		{&#xD;
			for(var c=0; c&lt;ConsistenzaCPS.size(); c++)&#xD;
			{&#xD;
				currentConsistenzaCPS = ConsistenzaCPS.get(c);&#xD;
&#xD;
				if(currentConsistenzaCPS != null)&#xD;
				{&#xD;
					var dettOrdineTemp = ScriptUtil.copy(dettOrdine);&#xD;
					&#xD;
					//AZIONE&#xD;
					if (currentConsistenzaCPS.azione != null)&#xD;
					{&#xD;
						dettOrdineTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(currentConsistenzaCPS.azione);&#xD;
					}&#xD;
					&#xD;
					dettOrdineTemp.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS;&#xD;
					dettOrdineTemp.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
					dettOrdineTemp.integrationID = localRequest.IDRichiestaOLO + dettOrdineTemp.IDDettaglioOrdine;&#xD;
					attribDettOrdine.IDDettaglioOrdine = dettOrdineTemp.IDDettaglioOrdine;&#xD;
					&#xD;
					//IDRISORSA&#xD;
					if(currentConsistenzaCPS.IDRisorsa != null)&#xD;
					{&#xD;
						attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
						attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						attribDettOrdine.valoreAttributo = currentConsistenzaCPS.IDRisorsa;&#xD;
								&#xD;
						dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
					}&#xD;
					//IDRISORSANOW&#xD;
					if(currentConsistenzaCPS.IDRisorsaNOW != null)&#xD;
					{&#xD;
						attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSANOW;&#xD;
						attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						attribDettOrdine.valoreAttributo = currentConsistenzaCPS.IDRisorsaNOW;&#xD;
						&#xD;
						dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));					&#xD;
					}&#xD;
					//OFFERTA&#xD;
					if(currentConsistenzaCPS.offerta != null)&#xD;
					{&#xD;
						attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA;&#xD;
						attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						attribDettOrdine.valoreAttributo = String(currentConsistenzaCPS.offerta);&#xD;
						&#xD;
						dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
					}&#xD;
					//CODICEORDINETI&#xD;
					if(currentConsistenzaCPS.codiceOrdineTI != null)&#xD;
					{&#xD;
						attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETI;&#xD;
						attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						attribDettOrdine.valoreAttributo = currentConsistenzaCPS.codiceOrdineTI;&#xD;
							&#xD;
						dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));		&#xD;
					}&#xD;
					//CODICEORDINEOLO&#xD;
					if(currentConsistenzaCPS.codiceOrdineOLO != null)&#xD;
					{&#xD;
						attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLO;&#xD;
						attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
