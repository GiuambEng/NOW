						localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexSTATO).valoreAttributo = String(ConsistenzaDati.stato);&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
						attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						attributo.valoreAttributo = String(ConsistenzaDati.stato);&#xD;
						&#xD;
						localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}&#xD;
				}&#xD;
				&#xD;
			}&#xD;
		}&#xD;
	}else{&#xD;
	Process.auditLog(&quot;Impossibile completare la funzione di arricchimento: Consistenza Dati non trovata&quot;);&#xD;
	}	*/					&#xD;
}else{&#xD;
	Process.auditLog(&quot;Impossibile completare la funzione di arricchimento: Ordine o DettagliOrdine inesistenti&quot;);&#xD;
}&#xD;
&#xD;
if(LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.tipoLinea != null &amp;&amp; LavorazioneRichiesta.tipoLinea != &quot;&quot;)&#xD;
&#xD;
{&#xD;
	localRequest.ordine.tipologiaLinea = it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.get(LavorazioneRichiesta.tipoLinea);&#xD;
	&#xD;
	if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
	{&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
			if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB ||&#xD;
				localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB ||&#xD;
				localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB) &#xD;
				&amp;&amp;&#xD;
				(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTCAB ||&#xD;
				componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSONGAFTTCAB ||&#xD;
				componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOEASYIPFTTCAB&#xD;
				))&#xD;
			{&#xD;
				for(var j = 0; j &lt; componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
						attributo.valoreAttributo = LavorazioneRichiesta.tipoLinea;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
