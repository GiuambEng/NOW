			}&#xD;
			else if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURANTE&#xD;
			&amp;&amp; FATTURANTE != null)&#xD;
			{&#xD;
				foundFATTURANTE = true;&#xD;
				currentAtttDettOrdine.valoreAttributo = FATTURANTE;&#xD;
