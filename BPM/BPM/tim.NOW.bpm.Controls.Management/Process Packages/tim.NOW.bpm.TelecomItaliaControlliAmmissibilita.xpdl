            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="87.0" LaneId="_WgcM8eFWEeqCP_tvVex8aA" Width="137.0">
              <xpdl2:Coordinates XCoordinate="1866.0" YCoordinate="607.0"/>
