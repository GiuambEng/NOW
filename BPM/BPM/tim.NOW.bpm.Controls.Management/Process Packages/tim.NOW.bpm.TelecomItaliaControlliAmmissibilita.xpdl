			}&#xD;
			else if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNRICHIESTO&#xD;
			&amp;&amp; TIPODNRICHIESTO != null)&#xD;
			{&#xD;
				foundTIPODNRICHIESTO = true;&#xD;
				currentAtttDettOrdine.valoreAttributo = TIPODNRICHIESTO;&#xD;
				Process.auditLog(&quot;Modificato attributo &quot;+currentAtttDettOrdine.nomeAttributo+&quot; in ACCESSOCPS, nuovo valore: &quot;+currentAtttDettOrdine.valoreAttributo);&#xD;
			}&#xD;
			else if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEARICHIESTO&#xD;
			&amp;&amp; TIPOLINEARICHIESTO != null)&#xD;
			{&#xD;
