        <xpdl2:Activity Id="_mnISog_UEeeaIZv9zy7nmA" Name="ArricchimentoOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//DIVISO IN DUE SCRIPT (QUESTO E QUELLO SUCCESSIVO) CON INSTALLAZIONE KIT C9 2021&#xD;
&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
if(localRequest.ordine == null)&#xD;
{&#xD;
	localRequest.ordine = it_telecomitalia_it_NOW_casedata_Factory.createOrdine();&#xD;
	localRequest.ordine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	localRequest.ordine.codificaOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
	localRequest.ordine.codificaOLONOW = localRequest.codificaOLONOW;&#xD;
	localRequest.ordine.created = date;&#xD;
	localRequest.ordine.lastUpdate = date;&#xD;
	localRequest.ordine.operatore = &quot;BPM&quot;;&#xD;
	localRequest.ordine.offerta = localRequest.offerta;&#xD;
	localRequest.ordine.tipologiaLavorazione = localRequest.lavorazione;&#xD;
}&#xD;
&#xD;
//SM_3258&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL)&#xD;
{&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	attributo.created = date;&#xD;
	attributo.lastUpdate = date;&#xD;
	attributo.operatore = localRequest.operatore;&#xD;
	&#xD;
	var foundAccesso = false;&#xD;
	var indexAccesso = -1;&#xD;
	&#xD;
	var foundNumeroTelefonico = false;&#xD;
	var foundStrutturaLinea = false;&#xD;
	var foundTipoLinea = false;&#xD;
	var foundBandaServizio = false;	&#xD;
	&#xD;
	var indexNumeroTelefonico = -1;&#xD;
	var indexStrutturaLinea = -1;&#xD;
	var indexTipoLinea = -1;&#xD;
	var indexBandaServizio = -1;	&#xD;
	&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			foundAccesso = true;&#xD;
			indexAccesso = i;&#xD;
			attributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
			&#xD;
			//In caso di ACCESSO creato esternamente setto l'AZIONE ad A&#xD;
			currentDettOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
			&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					foundNumeroTelefonico = true;&#xD;
					indexNumeroTelefonico = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
				{&#xD;
					foundStrutturaLinea = true;&#xD;
					indexStrutturaLinea = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					foundTipoLinea = true;&#xD;
					indexTipoLinea = j;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(LavorazioneRichiesta != null &amp;&amp; (LavorazioneRichiesta.numeroTelefonico != null || LavorazioneRichiesta.strutturaLinea != null || LavorazioneRichiesta.tipoLinea != null))&#xD;
	{&#xD;
		if(!foundAccesso)&#xD;
		{&#xD;
			var dettaglio = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			dettaglio.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
			&#xD;
			attributo.IDDettaglioOrdine = dettaglio.IDDettaglioOrdine;&#xD;
			&#xD;
			dettaglio.IDDettaglioOrdineParent = 1;&#xD;
			dettaglio.IDDettaglioOrdineRoot = 1;&#xD;
			dettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			dettaglio.IDRisorsa = localRequest.IDRisorsa;&#xD;
			dettaglio.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
			dettaglio.created = date;&#xD;
			dettaglio.integrationID = localRequest.IDRichiestaOLO + dettaglio.IDDettaglioOrdine;&#xD;
			dettaglio.lastUpdate = date;&#xD;
			if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA)&#xD;
			{&#xD;
				dettaglio.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				dettaglio.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULL;&#xD;
			}&#xD;
			dettaglio.operatore = &quot;BPM&quot;;&#xD;
			dettaglio.progressivo = 1;&#xD;
			&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettaglio));&#xD;
			indexAccesso = localRequest.ordine.dettaglioordine.size() - 1;&#xD;
		}&#xD;
	&#xD;
		//ACCESSO.NUMEROTELEFONICO&#xD;
		if(LavorazioneRichiesta.numeroTelefonico != null)&#xD;
		{&#xD;
			if(foundNumeroTelefonico)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexAccesso).attributiDettaglioOrdine.get(indexNumeroTelefonico).valoreAttributo = LavorazioneRichiesta.numeroTelefonico;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.numeroTelefonico;&#xD;
			&#xD;
				localRequest.ordine.dettaglioordine.get(indexAccesso).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
	&#xD;
		//ACCESSO.STRUTTURALINEA&#xD;
		if(LavorazioneRichiesta.strutturaLinea != null)&#xD;
		{&#xD;
			if(foundStrutturaLinea)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexAccesso).attributiDettaglioOrdine.get(indexStrutturaLinea).valoreAttributo = LavorazioneRichiesta.strutturaLinea;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.strutturaLinea;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexAccesso).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
	&#xD;
		//ACCESSO.TIPOLINEA&#xD;
		if(LavorazioneRichiesta.tipoLinea != null)&#xD;
		{&#xD;
			if(foundTipoLinea)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexAccesso).attributiDettaglioOrdine.get(indexTipoLinea).valoreAttributo = LavorazioneRichiesta.tipoLinea;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.tipoLinea;&#xD;
			&#xD;
				localRequest.ordine.dettaglioordine.get(indexAccesso).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
	&#xD;
		//ACCESSO.FATTURAZIONELA&#xD;
		var componenteAccesso = localRequest.ordine.dettaglioordine.get(indexAccesso).nomeComponente;&#xD;
		if(componenteAccesso == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULL&#xD;
			|| componenteAccesso == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULLDATI&#xD;
			|| componenteAccesso == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU)&#xD;
		{&#xD;
			attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURAZIONELA;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			attributo.valoreAttributo = &quot;Y&quot;;&#xD;
			&#xD;
			localRequest.ordine.dettaglioordine.get(indexAccesso).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
		}&#xD;
		&#xD;
		//ACCESSO.BANDASERVIZIO&#xD;
		if(LavorazioneRichiesta.bandaServizio != null)&#xD;
		{&#xD;
			if(foundBandaServizio)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexAccesso).attributiDettaglioOrdine.get(indexBandaServizio).valoreAttributo = LavorazioneRichiesta.bandaServizio;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDASERVIZIO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = LavorazioneRichiesta.bandaServizio;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexAccesso).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
