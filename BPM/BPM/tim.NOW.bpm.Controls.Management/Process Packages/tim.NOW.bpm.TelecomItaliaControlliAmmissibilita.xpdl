		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//RU_1502&#xD;
	if(ConsistenzaRaccolta.caratteristicaVlan != null)&#xD;
