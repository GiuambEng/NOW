        <xpdl2:Activity Id="_nk41MAH9EemGCZFZxfagyQ" Name="VerificaNumerazioneDonorOLO2" xpdExt:Visibility="Private" xpdExt:DisplayName="VerificaNumerazioneDonorOLO">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_mULsEPQ2EeazKYdqUBpQKA" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdExt:OutputMappings MapperContext="SubProcessToProcess" MappingDirection="OUT">
