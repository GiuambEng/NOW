          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">ContaDATIDBCFX &lt; DATIDBCFX.size();</xpdl2:Expression>
</xpdl2:Condition>
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo">
              <xpdl2:Coordinates XCoordinate="-14.0" YCoordinate="-146.0"/>
              <xpdl2:Coordinates XCoordinate="413.0" YCoordinate="-146.0"/>
              <xpdl2:Coordinates XCoordinate="-432.0" YCoordinate="-146.0"/>
              <xpdl2:Coordinates XCoordinate="-5.0" YCoordinate="-146.0"/>
            </xpdl2:ConnectorGraphicsInfo>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.LabelAnchorPosition">
              <xpdl2:Coordinates XCoordinate="50.0" YCoordinate="0.0"/>
              <xpdl2:Coordinates XCoordinate="0.0" YCoordinate="0.0"/>
            </xpdl2:ConnectorGraphicsInfo>
