				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//CONSISTENZADATI.STRUTTURALINEA&#xD;
		if(ConsistenzaDati.strutturaLinea != null)&#xD;
		{&#xD;
			if(foundSTRUTTURALINEA)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.get(indexSTRUTTURALINEA).valoreAttributo = ConsistenzaDati.strutturaLinea;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaDati.strutturaLinea;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//CONSISTENZADATI.STATO&#xD;
		if(ConsistenzaDati.stato != null)&#xD;
		{&#xD;
			if(foundSTATO)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.get(indexSTATO).valoreAttributo = String(ConsistenzaDati.stato);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = String(ConsistenzaDati.stato);&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		//CONSISTENZADATI.OPZIONEDINAMICA&#xD;
		if(ConsistenzaDati.stato != null)&#xD;
		{&#xD;
			if(foundOPZIONEDINAMICA)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.get(indexOPZIONEDINAMICA).valoreAttributo = String(ConsistenzaDati.opzioneDinamica);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONEDINAMICA;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = String(ConsistenzaDati.opzioneDinamica);&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//CONSISTENZADATI.TIPOLOGIACLUSTERCOMUNE - RU_964&#xD;
		if(ConsistenzaDati.tipologiaClusterComune != null)&#xD;
		{&#xD;
			if(foundTIPOLOGIACLUSTERCOMUNE)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.get(indexTIPOLOGIACLUSTERCOMUNE).valoreAttributo = ConsistenzaDati.tipologiaClusterComune;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaDati.tipologiaClusterComune;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//CONSISTENZAFONIA.WHITELIST //R1E-21-0325&#xD;
		if(ConsistenzaDati.assetBTWhiteList != null)&#xD;
		{&#xD;
			if(foundWHITELIST)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.get(indexWHITELIST).valoreAttributo = ConsistenzaDati.assetBTWhiteList;&#xD;
				localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.WHITELIST;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaDati.assetBTWhiteList;&#xD;
				localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Consistenza Dati non trovata&quot;);&#xD;
	}&#xD;
	&#xD;
	//SM_6316 - sovrascrittura TIPOLINEA per DATI XDSL CONDIVISI Con TipoLinea da LavorazioneRichiesta &#xD;
	&#xD;
	if (LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.tipoLinea != null &amp;&amp; LavorazioneRichiesta.tipoLinea != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordine.tipologiaLinea = it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.get(LavorazioneRichiesta.tipoLinea);&#xD;
		&#xD;
		var accessoTrovato = false;&#xD;
		var i=0;&#xD;
		while(!accessoTrovato &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j=0;&#xD;
				var TipoLineaTrovato = false;&#xD;
				&#xD;
				while(!TipoLineaTrovato &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size()){&#xD;
					var attributoTemp = componente.attributiDettaglioOrdine.get(j);&#xD;
					if(attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						attributoTemp.valoreAttributo = LavorazioneRichiesta.tipoLinea;&#xD;
						TipoLineaTrovato = true;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			&#xD;
		i++;&#xD;
		}&#xD;
		&#xD;
	}&#xD;
&#xD;
	&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Impossibile completare la funzione di arricchimento: Ordine o DettagliOrdine inesistenti&quot;);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
