            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_NCUKMcB4EeaRHo7WrpRbeg" Width="163.0">
              <xpdl2:Coordinates XCoordinate="754.0" YCoordinate="1537.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier =  &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.xpdl.VerificaNumerazioneDonorOLO&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if (FlagDonorOLO == &quot;Y&quot;) //Skip Interrogazione Inventory&#xD;
{&#xD;
	&#xD;
	ContaDATIDBCFX++; //Incremento qui perche in questo caso skippo interrogazione inventory e quindi non passo dal complete script.&#xD;
	&#xD;
	EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Esito Positivo- skip controlli fase2&quot;;&#xD;
&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
