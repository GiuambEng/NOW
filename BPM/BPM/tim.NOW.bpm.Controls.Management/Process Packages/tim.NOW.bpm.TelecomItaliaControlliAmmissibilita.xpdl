          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" LaneId="_cKxQUZ8DEemSIcjmnU0c2Q" Width="123.0">
              <xpdl2:Coordinates XCoordinate="813.0" YCoordinate="166.0"/>
