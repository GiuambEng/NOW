            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier = &quot;/tim.NOW.bpm.Controls/Process Packages/tim.NOW.bpm.Controls_Ammissibilita.xpdl.CTRLSERVIZIOCONSISTENZA_C04M03F04&quot;;&#xD;
&#xD;
// Check Causale 52 e conseguente elmininazione consistenza da ordine&#xD;
if(Causale52 != null &amp;&amp; Causale52 == true)&#xD;
{&#xD;
	Process.auditLog(&quot;Chiamata a Servizio in consistenza per Causale 52, eliminazione consistenze pre-esistenti&quot;);&#xD;
&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI ||&#xD;
		   currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			localRequest.ordine.dettaglioordine.remove(i);&#xD;
			Process.auditLog(&quot;Eliminata componente &quot;+currentDettOrdine.nomeComponente);	&#xD;
		}&#xD;
	}&#xD;
	&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
