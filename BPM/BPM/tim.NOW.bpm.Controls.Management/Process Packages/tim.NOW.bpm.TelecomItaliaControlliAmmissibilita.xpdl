			//cerca ROUTINGNUMBER e rimuovi NUMBERPORTABILITY se esiste&#xD;
			var k=0;&#xD;
			while((ROUTINGNUMBER==null) &amp;&amp; k&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
				var componenteOrdine = localRequest.ordine.dettaglioordine.get(k);&#xD;
				if(componenteOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
					var l=0;&#xD;
					while((ROUTINGNUMBER == null) &amp;&amp; l&lt;componenteOrdine.attributiDettaglioOrdine.size()){&#xD;
						if(componenteOrdine.attributiDettaglioOrdine.get(l).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER){&#xD;
							ROUTINGNUMBER=componenteOrdine.attributiDettaglioOrdine.get(l).valoreAttributo;&#xD;
						}&#xD;
						l++;&#xD;
					}&#xD;
					&#xD;
					localRequest.ordine.dettaglioordine.remove(k);&#xD;
					k--;&#xD;
				}&#xD;
				k++;&#xD;
			}&#xD;
			&#xD;
			for(var k = 0; k &lt; NumberPortability.size(); k++)&#xD;
			{&#xD;
				var np = NumberPortability.get(k);&#xD;
				&#xD;
				var dettOrdineTemp = ScriptUtil.copy(dettOrdine);&#xD;
				dettOrdineTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
				dettOrdineTemp.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY;&#xD;
				dettOrdineTemp.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
				dettOrdineTemp.progressivo = k+1;&#xD;
				&#xD;
				if(np.numeroTelefonico == np.numeroTelefonicoPrincipale)&#xD;
				{&#xD;
					idDettNPPrincipale = dettOrdineTemp.IDDettaglioOrdine;&#xD;
				}&#xD;
				&#xD;
				if(idDettNPPrincipale != null)&#xD;
				{&#xD;
					dettOrdineTemp.IDDettaglioOrdineParent = idDettNPPrincipale;&#xD;
					dettOrdineTemp.IDDettaglioOrdineRoot = idDettNPPrincipale;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					idToUpdate.add(dettOrdineTemp.IDDettaglioOrdine);&#xD;
				}&#xD;
				&#xD;
				dettOrdineTemp.integrationID = localRequest.IDRichiestaOLO + dettOrdine.IDDettaglioOrdine;&#xD;
				attribDettOrdine.IDDettaglioOrdine = dettOrdineTemp.IDDettaglioOrdine;&#xD;
				&#xD;
				//InviatoDTU&#xD;
				if(np.invioaDTU != null)&#xD;
				{&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = np.invioaDTU;&#xD;
					&#xD;
					dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
				&#xD;
			&#xD;
				}&#xD;
				&#xD;
				//CodiceOperatoreDonor&#xD;
				if(np.codiceOperatoreDonor != null)&#xD;
				{&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = np.codiceOperatoreDonor;&#xD;
					&#xD;
					dettOrdineTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
				&#xD;
			&#xD;
				}&#xD;
				&#xD;
				//CODICEORDINETI&#xD;
				if(np.codiceOrdineTI != null)&#xD;
				{&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETI;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
