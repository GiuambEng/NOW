							componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
						}&#xD;
						else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
						{&#xD;
							var attrTemp = ScriptUtil.copy(attributo);&#xD;
							attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS;&#xD;
