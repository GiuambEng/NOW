		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COINVESTIMENTO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.coinvestimento;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//TIPOLOGIAACCESSOUBB&#xD;
	if(!foundTIPOLOGIAACCESSOUBB &amp;&amp; ConsistenzaDati.tipologiaAccessoUBB != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIAACCESSOUBB;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.tipologiaAccessoUBB;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//IDARMADIO&#xD;
	if(!foundIDARMADIO &amp;&amp; ConsistenzaDati.idArmadio != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDARMADIO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.idArmadio;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//CODICEEGON&#xD;
	if(!foundCODICEEGON &amp;&amp; ConsistenzaDati.codiceEgon != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEEGON;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codiceEgon;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//IDRISORSA&#xD;
	if(!foundIDRISORSA &amp;&amp; ConsistenzaDati.IDRisorsa != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.IDRisorsa;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	&#xD;
	//Se non ha trovato la componente ACCESSO, allora va aggiunta quella che abbiamo creato&#xD;
	if(!foundACCESSO)&#xD;
	{&#xD;
		localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
	}&#xD;
	&#xD;
	&#xD;
	//-------------------------------------- CREAZIONE COMPONENTE CONSISTENZADATI --------------------------------------------&#xD;
	Process.auditLog(&quot;Arricchimento CONSISTENZA DATI nell'ordine&quot;);&#xD;
	var date = DateTimeUtil.createDatetime();&#xD;
	&#xD;
	var dettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
	dettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	dettOrdine.created = date;&#xD;
	dettOrdine.lastUpdate = date;&#xD;
	dettOrdine.operatore = &quot;BPM&quot;;&#xD;
	dettOrdine.IDRisorsa = localRequest.IDRisorsa;&#xD;
	dettOrdine.progressivo = 1;&#xD;
	dettOrdine.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
	dettOrdine.IDDettaglioOrdineParent = 1;&#xD;
	dettOrdine.IDDettaglioOrdineRoot = 1;&#xD;
&#xD;
	var attribDettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attribDettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	attribDettOrdine.created = date;&#xD;
	attribDettOrdine.lastUpdate = date;&#xD;
	attribDettOrdine.operatore = &quot;BPM&quot;;&#xD;
	&#xD;
	dettOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(String(ConsistenzaDati.azione));&#xD;
	dettOrdine.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI;&#xD;
	dettOrdine.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
	dettOrdine.integrationID = localRequest.IDRichiestaOLO + dettOrdine.IDDettaglioOrdine;&#xD;
	attribDettOrdine.IDDettaglioOrdine = dettOrdine.IDDettaglioOrdine;&#xD;
	&#xD;
	//CODICEDELIVERY&#xD;
	if(ConsistenzaDati.codiceDelivery != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEDELIVERY;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaDati.codiceDelivery;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//IDGPON&#xD;
	if(ConsistenzaDati.idGpon != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDGPON;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaDati.idGpon;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//COINVESTIMENTO&#xD;
	if(ConsistenzaDati.coinvestimento != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COINVESTIMENTO;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaDati.coinvestimento;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//TIPOLOGIAACCESSOUBB&#xD;
	if(ConsistenzaDati.tipologiaAccessoUBB != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIAACCESSOUBB;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaDati.tipologiaAccessoUBB;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//IDARMADIO&#xD;
	if(ConsistenzaDati.idArmadio != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDARMADIO;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaDati.idArmadio;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//CODICEEGON&#xD;
	if(ConsistenzaDati.codiceEgon != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEEGON;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
