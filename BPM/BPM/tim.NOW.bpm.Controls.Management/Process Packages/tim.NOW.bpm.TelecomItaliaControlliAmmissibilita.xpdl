		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.identificativoCar;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//IDBRE&#xD;
	if(ConsistenzaRaccolta.idBre != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDBRE;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.idBre;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//QINQFLAG&#xD;
	if(ConsistenzaRaccolta.qinqFlag != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QINQFLAG;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.qinqFlag;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//NOMEMACROAREA&#xD;
	if(ConsistenzaRaccolta.nomeMacroArea != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.nomeMacroArea;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//CODICEMACROAREA&#xD;
	if(ConsistenzaRaccolta.codiceMacroArea != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.codiceMacroArea;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//ASSETBTWHITELIST - R1E-21-0325&#xD;
	if(ConsistenzaRaccolta.assetBTWhiteList != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.WHITELIST;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaRaccolta.assetBTWhiteList;&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
	&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//IDVLANRETE&#xD;
	if(IDVLANRETEasset != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDVLANRETE;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = IDVLANRETEasset;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//SM_9813: aggiunto arricchimento di BANDAMCR e BANDAPCR della CONSISTENZARACCOLTA&#xD;
	//BANDAMCR&#xD;
	if(BANDAMCRasset != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAMCR;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = BANDAMCRasset;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	//BANDAPCR&#xD;
	if(BANDAPCRasset != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPCR;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = BANDAPCRasset;&#xD;
			&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));&#xD;
	}&#xD;
	&#xD;
	localRequest.ordine.dettaglioordine.add(dettOrdine);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
