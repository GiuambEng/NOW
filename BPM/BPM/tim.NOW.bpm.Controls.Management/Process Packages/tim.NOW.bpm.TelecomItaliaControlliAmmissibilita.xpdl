        <xpdl2:DataField Id="_puTizm_nEe2rCYN0lhMjoA" xpdExt:DisplayName="ConsistenzaDati" Name="ConsistenzaDati">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="com.tim.NOW.xsd.StoricoDatiVerificaControlli.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.StoricoDatiVerificaControlliConsistenzaDatiType"/>
