            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_F-LEQeOyEeaiKuQ_iqaH6A" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_DT7rkOOyEeaiKuQ_iqaH6A" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="52.0" LaneId="_-_5-YbugEeayht8qLs45Yw" Width="73.0">
              <xpdl2:Coordinates XCoordinate="71.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_HPKk8B3wEeePjeQ_8Ysh9A" Name="CreaNPeCONSISTENZE" xpdExt:Visibility="Private" xpdExt:DisplayName="Crea NP e CONSISTENZE">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var data = DateTimeUtil.createDatetime();&#xD;
&#xD;
//CONSISTENZAFONIA&#xD;
if(ConsistenzaFonia!= null)&#xD;
{&#xD;
	var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
	componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
	componente.IDDettaglioOrdineParent = 1;&#xD;
	componente.IDDettaglioOrdineRoot =1;&#xD;
	componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	componente.IDRisorsa= ConsistenzaFonia.IDRisorsa;&#xD;
	componente.IDRisorsaNOW = ConsistenzaFonia.IDRisorsaNOW;&#xD;
	&#xD;
	componente.created = data;&#xD;
	componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
	componente.lastUpdate = data;&#xD;
	componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA;&#xD;
	componente.operatore = &quot;BPM&quot;;&#xD;
	componente.progressivo = 1;&#xD;
	&#xD;
	if(ConsistenzaFonia.codificaOLOAGCOMDonating==&quot;TLC&quot; &amp;&amp; ConsistenzaDati!=null &amp;&amp; ConsistenzaDati.codificaOLOAGCOMDonating==&quot;TLC&quot; &amp;&amp; ConsistenzaFonia.azione!=null&#xD;
	&amp;&amp; ((String(ConsistenzaFonia.offerta).slice(0,3) == &quot;ULL&quot; &amp;&amp; String(ConsistenzaDati.offerta).slice(0,3) == &quot;ULL&quot;)||&#xD;
		(String(ConsistenzaFonia.offerta).slice(0,3) == &quot;SLU&quot; &amp;&amp; String(ConsistenzaDati.offerta).slice(0,3) == &quot;SLU&quot;))) //RU_632&#xD;
	{&#xD;
		componente.azione=it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(ConsistenzaFonia.azione);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
	}&#xD;
	&#xD;
	&#xD;
	//attributi&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
	attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
	attributo.created = data;&#xD;
	attributo.lastUpdate = data;&#xD;
	attributo.operatore = &quot;BPM&quot;;&#xD;
	attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
	&#xD;
	if(ConsistenzaFonia.IDAsset!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.IDAsset;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.IDRisorsa!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.IDRisorsa;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.IDRisorsaCorrelato!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSACORRELATO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.IDRisorsaCorrelato;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.IDRisorsaNOW!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSANOW;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.IDRisorsaNOW;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.offerta!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA;&#xD;
		attrTemp.valoreAttributo = String(ConsistenzaFonia.offerta);&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.codificaOLOAGCOMDonating!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.codificaOLOAGCOMDonating;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.codificaOLOAGCOMDonor!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONOR;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.codificaOLOAGCOMDonor;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.cowCode!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COWCODE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.cowCode;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.codiceSessione!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESESSIONE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.codiceSessione;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.codiceOrdineTI!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETI;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.codiceOrdineTI;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.codiceOrdineOLO!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.codiceOrdineOLO;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.tipoLinea!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.tipoLinea;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.strutturaLinea!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.strutturaLinea;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.numeroTelefonico!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.numeroTelefonico;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.numeroTelefonicoPrincipale!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.numeroTelefonicoPrincipale;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.destinazioneUso!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.destinazioneUso;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaFonia.codiceTrasformazione!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETRASFORMAZIONE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.codiceTrasformazione;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//OPERATORERETE - RU_1142&#xD;
	if(ConsistenzaFonia.operatoreRete != null) &#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPERATORERETE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.operatoreRete;&#xD;
		&#xD;
		//SM_11220: nel caso di CESSAZIONE SHA va ribaltato operatoreRete della CONSISTENZADATI (SHA è DATI)&#xD;
		if(String(localRequest.offerta).slice(0,3) != &quot;SHA&quot;)&#xD;
		{&#xD;
			localRequest.operatoreRete = ConsistenzaFonia.operatoreRete;&#xD;
			localRequest.ordine.operatoreRete = ConsistenzaFonia.operatoreRete;	&#xD;
		}&#xD;
		&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//ASSETBTWHITELIST - R1E-21-0325&#xD;
	if(ConsistenzaFonia.assetBTWhiteList != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.WHITELIST;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attrTemp.valoreAttributo = ConsistenzaFonia.assetBTWhiteList;&#xD;
		&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
&#xD;
		componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attrTemp));&#xD;
	}&#xD;
	&#xD;
	localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
}&#xD;
&#xD;
//NUMBERPORTABILITY&#xD;
if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.numeroTelefonico!= null &amp;&amp; ConsistenzaFonia.numeroTelefonico != &quot;&quot;&#xD;
&amp;&amp; (String(localRequest.offerta).slice(0,3) == &quot;ULL&quot; || String(localRequest.offerta).slice(0,3) ==&quot;SLU&quot;)&#xD;
&amp;&amp; (localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA &amp;&amp;&#xD;
	localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA &amp;&amp;	&#xD;
	localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA))&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico = :DN AND codificaOLOAGCOM = :OLO&quot;);&#xD;
	c.setQueryParameter(&quot;DN&quot;,ConsistenzaFonia.numeroTelefonico);&#xD;
	c.setQueryParameter(&quot;OLO&quot;,localRequest.codificaOLOAGCOM);&#xD;
	var AssetNPref = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	var AssetNP = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
	AssetNP=null;&#xD;
	var i=0;&#xD;
	while(i&lt;AssetNPref.size()){&#xD;
		var assetTemp = AssetNPref.get(i).readAsset();&#xD;
		if((assetTemp.statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO  &#xD;
			|| assetTemp.statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE)&#xD;
		&amp;&amp; assetTemp.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP)&#xD;
		&#xD;
		{&#xD;
			AssetNP = ScriptUtil.copy(assetTemp);&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	if(AssetNP != null){&#xD;
		Process.auditLog(&quot;Asset NP recuperato: &quot;+AssetNP.IDAsset);&#xD;
		var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
		componente.IDDettaglioOrdineParent = 1;&#xD;
		componente.IDDettaglioOrdineRoot =1;&#xD;
		componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	&#xD;
		componente.created = data;&#xD;
		componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
		componente.lastUpdate = data;&#xD;
		componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY;&#xD;
		componente.operatore = &quot;BPM&quot;;&#xD;
		componente.progressivo = 1;&#xD;
		&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		&#xD;
		&#xD;
		var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = data;&#xD;
			attributo.lastUpdate = data;&#xD;
			attributo.operatore = &quot;BPM&quot;;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		&#xD;
		&#xD;
		var OLORETAILER =&quot;&quot;;&#xD;
		OLORETAILER = null;&#xD;
		var NUMBERPORTABILITYTrovata = false;&#xD;
		var i=0;&#xD;
		while(!NUMBERPORTABILITYTrovata &amp;&amp; i&lt;AssetNP.dettaglioasset.size()){&#xD;
			var compAsset =AssetNP.dettaglioasset.get(i);&#xD;
			if(compAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
				NUMBERPORTABILITYTrovata = true;&#xD;
				var trovatoCODICEPIATTAFORMA = false;&#xD;
				var j=0;&#xD;
				while(j&lt;compAsset.attributidettaglioasset.size()){&#xD;
					var attr = compAsset.attributidettaglioasset.get(j);&#xD;
					var attributoTemp = ScriptUtil.copy(attributo);&#xD;
					attributoTemp.nomeAttributo = attr.nomeAttributo;&#xD;
					&#xD;
					attributoTemp.valoreAttributo =  attr.valoreAttributo;&#xD;
					componente.attributiDettaglioOrdine.add(attributoTemp);&#xD;
					&#xD;
					//SM_9160&#xD;
					if(attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER)&#xD;
					{&#xD;
						OLORETAILER = attributoTemp.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					j++;&#xD;
				}&#xD;
				&#xD;
				&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		//aggiungoIDAsset&#xD;
&#xD;
		attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
		attributo.valoreAttributo =  AssetNP.IDAsset;&#xD;
		componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
		&#xD;
		if(OLORETAILER == null || OLORETAILER == localRequest.codificaOLOAGCOM) //SM_9160&#xD;
		{&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
		}&#xD;
		Process.auditLog(&quot;OLORETAILER della NP recuperata: &quot;+String(OLORETAILER)+&quot;, OLO ric: &quot;+localRequest.codificaOLOAGCOM);&#xD;
	&#xD;
	}&#xD;
	else{&#xD;
		Process.auditLog(&quot;Nessun asset con offerta NP recuperato per NumeroTelefonico: &quot;+ConsistenzaFonia.numeroTelefonico);&#xD;
	}&#xD;
		&#xD;
	&#xD;
	&#xD;
}&#xD;
	&#xD;
// CONSISTENZA DATI&#xD;
if(ConsistenzaDati != null &amp;&amp; &#xD;
localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATI &amp;&amp;&#xD;
localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA &amp;&amp;&#xD;
localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP &amp;&amp;&#xD;
localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA)&#xD;
{&#xD;
	var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
	componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
	componente.IDDettaglioOrdineParent = 1;&#xD;
	componente.IDDettaglioOrdineRoot =1;&#xD;
	componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	componente.IDRisorsa= ConsistenzaDati.IDRisorsa;&#xD;
	componente.IDRisorsaNOW = ConsistenzaDati.IDRisorsaNOW;&#xD;
	&#xD;
	componente.created = data;&#xD;
	componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
	componente.lastUpdate = data;&#xD;
	componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI;&#xD;
	componente.operatore = &quot;BPM&quot;;&#xD;
	componente.progressivo = 1;&#xD;
	&#xD;
	&#xD;
	if(ConsistenzaFonia!=null &amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating==&quot;TLC&quot; &amp;&amp; ConsistenzaDati.codificaOLOAGCOMDonating==&quot;TLC&quot; &amp;&amp; ConsistenzaDati.azione!=null&#xD;
	&amp;&amp;((String(ConsistenzaFonia.offerta).slice(0,3) == &quot;ULL&quot; &amp;&amp; String(ConsistenzaDati.offerta).slice(0,3) == &quot;ULL&quot;)||&#xD;
	   (String(ConsistenzaFonia.offerta).slice(0,3) == &quot;SLU&quot; &amp;&amp; String(ConsistenzaDati.offerta).slice(0,3) == &quot;SLU&quot;))) // RU_632&#xD;
	{&#xD;
		componente.azione=it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(ConsistenzaDati.azione);&#xD;
	}&#xD;
	else if(String(localRequest.offerta).slice(0,3) == &quot;SHA&quot;)&#xD;
	{&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.T;&#xD;
	}&#xD;
	&#xD;
	//attributi&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
	attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
	attributo.created = data;&#xD;
	attributo.lastUpdate = data;&#xD;
	attributo.operatore = &quot;BPM&quot;;&#xD;
	attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
	&#xD;
	if(ConsistenzaDati.IDAsset!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.IDAsset;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.IDRisorsa!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.IDRisorsa;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.IDRisorsaCorrelato!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSACORRELATO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.IDRisorsaCorrelato;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.IDRisorsaNOW!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSANOW;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.IDRisorsaNOW;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.offerta!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA;&#xD;
		attrTemp.valoreAttributo = String(ConsistenzaDati.offerta);&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.codificaOLOAGCOMDonating!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codificaOLOAGCOMDonating;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.codificaOLOAGCOMDonor!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONOR;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codificaOLOAGCOMDonor;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.cowCode!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COWCODE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.cowCode;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.codiceSessione!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESESSIONE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codiceSessione;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.codiceOrdineTI!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETI;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codiceOrdineTI;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.codiceOrdineOLO!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codiceOrdineOLO;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.tipoLinea!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.tipoLinea;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.strutturaLinea!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.strutturaLinea;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.numeroTelefonico!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.numeroTelefonico;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.numeroTelefonicoPrincipale!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.numeroTelefonicoPrincipale;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.destinazioneUso!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.destinazioneUso;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.codiceTrasformazione!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETRASFORMAZIONE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.codiceTrasformazione;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(ConsistenzaDati.opzioneDinamica!=null){&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONEDINAMICA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.opzioneDinamica;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//OPERATORERETE - RU_1142&#xD;
	if(ConsistenzaDati.operatoreRete != null) &#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPERATORERETE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.operatoreRete;&#xD;
		&#xD;
		//SM_10656: commentato ribaltamento&#xD;
		//Bug #39213: nel caso di CESSAZIONE di REGOLATORIO, possiamo avere casi in cui ci sono sia la CONSISTENZAFONIA (con azione N) che la CONSISTENZADATI (con azione M) che hanno stessa offerta (ULLLINEANONATTIVA o SLULINEANONATTIVA)&#xD;
		//Si tratta di una casistica in cui andiamo a cessare la CONSISTENZADATI e non la quella FONIA, quindi va ribaltato operatoreRete dalla CONSISTENZADATI		&#xD;
		if((ConsistenzaDati.azione == &quot;M&quot; &amp;&amp; ConsistenzaFonia.azione == &quot;N&quot; &amp;&amp; ConsistenzaDati.offerta == ConsistenzaFonia.offerta&#xD;
		        &amp;&amp; (ConsistenzaDati.offerta == &quot;ULLLINEANONATTIVA&quot;&#xD;
		           || ConsistenzaDati.offerta == &quot;SLULINEANONATTIVA&quot;))&#xD;
		   || String(localRequest.offerta).slice(0,3) == &quot;SHA&quot;)        //SM_11220: Per Cessazione SHA ribaltiamo operatoreRete della DATI (SHA è DATI)&#xD;
		{	&#xD;
			//Sovrascrivo quello ribaltato dalla ConsistenzaFonia&#xD;
			localRequest.operatoreRete = ConsistenzaDati.operatoreRete;&#xD;
			localRequest.ordine.operatoreRete = ConsistenzaDati.operatoreRete;		&#xD;
		}&#xD;
		&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//ASSETBTWHITELIST - R1E-21-0325&#xD;
	if(ConsistenzaDati.assetBTWhiteList != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.WHITELIST;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.assetBTWhiteList;&#xD;
		&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
&#xD;
		componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attrTemp));&#xD;
	}&#xD;
	//ROEFFIB - RU_1275&#xD;
	if(ConsistenzaDati.roeFFIB != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROEFFIB;&#xD;
		attrTemp.valoreAttributo = ConsistenzaDati.roeFFIB;&#xD;
		componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attrTemp));&#xD;
	}&#xD;
	&#xD;
	localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
