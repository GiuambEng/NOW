            <xpdl2:SubFlow Id="_9Y3vwFJQEeafMOVsQ226Vw" PackageRef="tim.NOW.bpm.ProcesService.Interfaces" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
              <xpdExt:InputMappings MapperContext="ProcessToSubProcess" MappingDirection="IN">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="localRequest">
                    <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="DatiAccesso">
                    <xpdl2:Actual ScriptGrammar="JavaScript">datiAccesso</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:InputMappings>
              <xpdExt:OutputMappings MapperContext="SubProcessToProcess" MappingDirection="OUT">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="SubProcessToProcess.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="EsitoResponse">
                    <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse</xpdl2:Actual>
                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="SubProcessToProcess.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="localRequest">
                    <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:OutputMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:Priority></xpdl2:Priority>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_k-OcEBtcEeqbld_aeYTIaw" Width="128.0">
              <xpdl2:Coordinates XCoordinate="836.0" YCoordinate="106.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier=&quot;/tim.NOW.bpm.Controls/Process Packages/tim.NOW.bpm.Controls.xpdl.CTRLOLINCORSO&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_1WRBgRtcEeqbld_aeYTIaw" Name="EsitoResponse3" xpdExt:DisplayName="Esito Response?">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_1WRBnRtcEeqbld_aeYTIaw"/>
                  <xpdl2:TransitionRef Id="_1WRBnhtcEeqbld_aeYTIaw"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="86.0" LaneId="_k-OcEBtcEeqbld_aeYTIaw" Width="72.0">
              <xpdl2:Coordinates XCoordinate="1573.0" YCoordinate="106.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_1WRBghtcEeqbld_aeYTIaw" Name="ArricchimentoConsistenzaeOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Consistenza e Ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
//SM_9676: consistenza cps ora è un array in uscita dal servizio in consistenza, ma per cessazione cps è sempre unica&#xD;
if(consistenzaCPS != null &amp;&amp; consistenzaCPS.size()>0)&#xD;
{&#xD;
	consistenzaCPStemp = consistenzaCPS.get(0);&#xD;
}&#xD;
&#xD;
if(consistenzaCPStemp!= null &amp;&amp; consistenzaCPStemp.IDAsset != null)&#xD;
{&#xD;
	Process.auditLog(&quot;Cerco AssetCPS per IDAsset = &quot; + consistenzaCPStemp.IDAsset);&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset=:SearchIDAsset&quot;);&#xD;
	criteria.setQueryParameter(&quot;SearchIDAsset&quot;, consistenzaCPStemp.IDAsset);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		AssetCPS = ScriptUtil.copy(AssetRef.readAsset());&#xD;
	}&#xD;
}&#xD;
&#xD;
//RU_1121&#xD;
var SottoLav8 = false;&#xD;
&#xD;
//SM_9560: recupero SOTTOLAV per logiche successive in caso di SDR&#xD;
var SottoLav5678 = false;&#xD;
var trovatoRADICALE = false;&#xD;
&#xD;
if(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR&#xD;
   &amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributoTemp = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SOTTOLAVORAZIONESDR)&#xD;
				{&#xD;
					Process.auditLog(&quot;SOTTOLAVORAZIONE SDR: &quot;+attributoTemp.valoreAttributo);&#xD;
					&#xD;
					if(attributoTemp.valoreAttributo == &quot;05&quot;&#xD;
					|| attributoTemp.valoreAttributo == &quot;06&quot;&#xD;
					|| attributoTemp.valoreAttributo == &quot;07&quot;&#xD;
					|| attributoTemp.valoreAttributo == &quot;08&quot;)&#xD;
					{&#xD;
						SottoLav5678 = true;&#xD;
					}&#xD;
					&#xD;
					//RU_1121&#xD;
					if(attributoTemp.valoreAttributo == &quot;08&quot;)&#xD;
					{&#xD;
						SottoLav8 = true;&#xD;
					}&#xD;
				}&#xD;
				else if(attributoTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
				{&#xD;
					trovatoRADICALE = true;&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//RU_1121: recupero TIPODNRICHIESTO e TIPOLINEARICHIESTO dalla richiesta nel caso di SOTTOLAVORAZIONESDR 08 &#xD;
var TIPODNRICHIESTOinput = &quot;&quot;;&#xD;
TIPODNRICHIESTOinput = null;&#xD;
var TIPOLINEARICHIESTOinput = &quot;&quot;;&#xD;
TIPOLINEARICHIESTOinput = null;&#xD;
&#xD;
if(SottoLav8)&#xD;
{	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
		{&#xD;
			for(var j=0; j&lt;comp.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNRICHIESTO)&#xD;
				{&#xD;
					TIPODNRICHIESTOinput = attr.valoreAttributo;&#xD;
					&#xD;
					Process.auditLog(&quot;Trovato attributo TIPODNRICHIESTO&quot;+ attr.valoreAttributo +&quot; su componente con IDDett &quot;+comp.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEARICHIESTO)&#xD;
				{&#xD;
					TIPOLINEARICHIESTOinput = attr.valoreAttributo;&#xD;
					&#xD;
					Process.auditLog(&quot;Trovato attributo TIPOLINEARICHIESTO&quot;+ attr.valoreAttributo +&quot; su componente con IDDett &quot;+comp.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//SM_9069 per valorizzazione distretto.&#xD;
var numeroTelefonico = '';&#xD;
numeroTelefonico = null;&#xD;
&#xD;
// RU_975&#xD;
var codiceOloCess = '';&#xD;
codiceOloCess = null;&#xD;
&#xD;
var dettaglio = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
dettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
dettaglio.created = date;&#xD;
dettaglio.lastUpdate = date;&#xD;
dettaglio.operatore = &quot;BPM&quot;;&#xD;
dettaglio.IDRisorsa = localRequest.IDRisorsa;&#xD;
&#xD;
var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
attributo.created = date;&#xD;
attributo.lastUpdate = date;&#xD;
attributo.operatore = localRequest.operatore;&#xD;
attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
&#xD;
// ARRICCHIMENTO ACCESSO&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
	{&#xD;
		if(SottoLav5678) //SM_9560: aggiunto if per impostare azione ad A&#xD;
		{&#xD;
			currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
			Process.auditLog(&quot;Impostata azione ad A - ACCESSOCPS&quot;);&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			currentComponente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
			Process.auditLog(&quot;Impostata azione a D - ACCESSOCPS&quot;);&#xD;
		}&#xD;
		&#xD;
		//Recupero Attributi dall'asset&#xD;
		var TIPODNREALE = '';&#xD;
		TIPODNREALE = null;&#xD;
		var TIPOLINEAREALE = '';&#xD;
		TIPOLINEAREALE = null;&#xD;
		var OPZIONETRAFFICO = '';&#xD;
		OPZIONETRAFFICO = null;&#xD;
		var CODICECARRIEROLO = '';&#xD;
		CODICECARRIEROLO = null;&#xD;
		var RADICALE = '';&#xD;
		RADICALE = null;&#xD;
		var DSC = '';&#xD;
		DSC = null;&#xD;
		var DNPRIMARIO = '';&#xD;
		DNPRIMARIO = null;&#xD;
		var TIPODNRICHIESTO = '';&#xD;
		TIPODNRICHIESTO = null;&#xD;
		var TIPOLINEARICHIESTO = '';&#xD;
		TIPOLINEARICHIESTO = null;&#xD;
		var FATTURANTE = '';&#xD;
		FATTURANTE = null;&#xD;
		&#xD;
		var foundTIPODNREALE = false;&#xD;
		var foundTIPOLINEAREALE = false;&#xD;
		var foundOPZIONETRAFFICO = false;&#xD;
		var foundCODICECARRIEROLO = false;&#xD;
		var foundRADICALE = false;&#xD;
		var foundDSC = false;&#xD;
		var foundDNPRIMARIO = false;&#xD;
		var foundTIPODNRICHIESTO = false;&#xD;
		var foundTIPOLINEARICHIESTO = false;&#xD;
		var foundFATTURANTE = false;&#xD;
		&#xD;
		for(var k = 0; k &lt; AssetCPS.dettaglioasset.size(); k++)&#xD;
		{&#xD;
			var currentDettAsset = AssetCPS.dettaglioasset.get(k);&#xD;
			&#xD;
			if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
			{			&#xD;
				attributo.IDDettaglioOrdine = currentComponente.IDDettaglioOrdine;&#xD;
				&#xD;
				for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
				{&#xD;
					var currentAtttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					//PER QUALSIASI CESSAZIONE&#xD;
					if(currentAtttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNREALE)&#xD;
					{&#xD;
						TIPODNREALE = currentAtttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAtttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAREALE)&#xD;
					{&#xD;
						TIPOLINEAREALE = currentAtttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					//SOLO IN CASO DI SOTTOLAVSDR 5, 6, 7, 8 - SM_9599&#xD;
					else if(currentAtttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO&#xD;
					&amp;&amp; SottoLav5678)&#xD;
					{&#xD;
						OPZIONETRAFFICO = currentAtttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAtttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECARRIEROLO&#xD;
					&amp;&amp; SottoLav5678)&#xD;
					{&#xD;
						CODICECARRIEROLO = currentAtttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAtttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE &amp;&amp; !trovatoRADICALE&#xD;
					&amp;&amp; SottoLav5678)&#xD;
					{&#xD;
						RADICALE = currentAtttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAtttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC&#xD;
					&amp;&amp; SottoLav5678)&#xD;
					{&#xD;
						DSC = currentAtttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAtttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DNPRIMARIO&#xD;
					&amp;&amp; SottoLav5678)&#xD;
					{&#xD;
						DNPRIMARIO = currentAtttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAtttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNRICHIESTO&#xD;
					&amp;&amp; SottoLav5678)&#xD;
					{&#xD;
						TIPODNRICHIESTO = currentAtttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAtttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEARICHIESTO&#xD;
					&amp;&amp; SottoLav5678)&#xD;
					{&#xD;
						TIPOLINEARICHIESTO = currentAtttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					//PER TUTTE LE CESSAZIONI STANDARD, NON SDR - SM_9367&#xD;
					else if(currentAtttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURANTE&#xD;
					&amp;&amp; localRequest.canaleRichiesta != it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR)&#xD;
					{&#xD;
						FATTURANTE = currentAtttDettAsset.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	&#xD;
		//Logica Sostituzione attributi recuperati dall'asset&#xD;
		for(var j = 0; j &lt; currentComponente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAtttDettOrdine = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOLOCESS) //RU_975: Recupero CodiceOloCess&#xD;
			{&#xD;
				codiceOloCess = currentAtttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;recuperato codiceOloCess &quot;+codiceOloCess+&quot; dall'ACCESSOCPS&quot;);&#xD;
			}&#xD;
			else if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN) // SM_9069: Recupero Numero Telefonico, logica successiva per distretto&#xD;
			{&#xD;
				numeroTelefonico = currentAtttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;recuperato numeroTelefonico &quot;+numeroTelefonico+&quot; dall'ACCESSOCPS&quot;);&#xD;
			}&#xD;
			else if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNREALE)&#xD;
			{&#xD;
				//RU_1121: per SOTTOLAVORAZIONESDR 08 si arricchisce con TIPODNRICHIESTO della richiesta in input&#xD;
				if(SottoLav8 &amp;&amp; TIPODNRICHIESTOinput != null)&#xD;
				{&#xD;
					currentAtttDettOrdine.valoreAttributo = TIPODNRICHIESTOinput;&#xD;
				}&#xD;
				//solito&#xD;
				else if(TIPODNREALE != null)&#xD;
				{&#xD;
					currentAtttDettOrdine.valoreAttributo = TIPODNREALE;&#xD;
				}&#xD;
				&#xD;
				foundTIPODNREALE = true;&#xD;
				Process.auditLog(&quot;Modificato attributo &quot;+currentAtttDettOrdine.nomeAttributo+&quot; in ACCESSOCPS, nuovo valore: &quot;+currentAtttDettOrdine.valoreAttributo);&#xD;
			}&#xD;
			else if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAREALE)&#xD;
			{&#xD;
				//RU_1121: per SOTTOLAVORAZIONESDR 08 si arricchisce con TIPODNRICHIESTO della richiesta in input&#xD;
				if(SottoLav8 &amp;&amp; TIPOLINEARICHIESTOinput != null)&#xD;
				{&#xD;
					currentAtttDettOrdine.valoreAttributo = TIPOLINEARICHIESTOinput;&#xD;
				}&#xD;
				//solito&#xD;
				else if(TIPOLINEAREALE != null)&#xD;
				{&#xD;
					currentAtttDettOrdine.valoreAttributo = TIPOLINEAREALE;&#xD;
				}&#xD;
				&#xD;
				foundTIPOLINEAREALE = true;&#xD;
				Process.auditLog(&quot;Modificato attributo &quot;+currentAtttDettOrdine.nomeAttributo+&quot; in ACCESSOCPS, nuovo valore: &quot;+currentAtttDettOrdine.valoreAttributo);&#xD;
			}&#xD;
			else if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO&#xD;
			&amp;&amp; OPZIONETRAFFICO != null)&#xD;
			{&#xD;
				foundOPZIONETRAFFICO = true;&#xD;
				currentAtttDettOrdine.valoreAttributo = OPZIONETRAFFICO;&#xD;
				Process.auditLog(&quot;Modificato attributo &quot;+currentAtttDettOrdine.nomeAttributo+&quot; in ACCESSOCPS, nuovo valore: &quot;+currentAtttDettOrdine.valoreAttributo);&#xD;
			}&#xD;
			else if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECARRIEROLO&#xD;
			&amp;&amp; CODICECARRIEROLO != null)&#xD;
			{&#xD;
				foundCODICECARRIEROLO = true;&#xD;
				currentAtttDettOrdine.valoreAttributo = CODICECARRIEROLO;&#xD;
				Process.auditLog(&quot;Modificato attributo &quot;+currentAtttDettOrdine.nomeAttributo+&quot; in ACCESSOCPS, nuovo valore: &quot;+currentAtttDettOrdine.valoreAttributo);&#xD;
			}&#xD;
			else if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE&#xD;
			&amp;&amp; RADICALE != null)&#xD;
			{&#xD;
				foundRADICALE = true;&#xD;
				currentAtttDettOrdine.valoreAttributo = RADICALE;&#xD;
				Process.auditLog(&quot;Modificato attributo &quot;+currentAtttDettOrdine.nomeAttributo+&quot; in ACCESSOCPS, nuovo valore: &quot;+currentAtttDettOrdine.valoreAttributo);&#xD;
			}&#xD;
			else if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC&#xD;
			&amp;&amp; DSC != null)&#xD;
			{&#xD;
				foundDSC = true;&#xD;
				currentAtttDettOrdine.valoreAttributo = DSC;&#xD;
				Process.auditLog(&quot;Modificato attributo &quot;+currentAtttDettOrdine.nomeAttributo+&quot; in ACCESSOCPS, nuovo valore: &quot;+currentAtttDettOrdine.valoreAttributo);&#xD;
			}&#xD;
			else if(currentAtttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DNPRIMARIO&#xD;
			&amp;&amp; DNPRIMARIO != null)&#xD;
			{&#xD;
