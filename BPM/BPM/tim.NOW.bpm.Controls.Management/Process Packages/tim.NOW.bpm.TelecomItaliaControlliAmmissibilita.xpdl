            <xpdl2:ExternalReference location="com.tim.NOW.xsd.StoricoDatiVerificaControlli.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.StoricoDatiVerificaControlliConsistenzaCPSType"/>
