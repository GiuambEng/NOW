&#xD;
//SM_9116: CONSISTENZA CPS&#xD;
//SM_9676: ConsistenzaCPS in uscita dal servizio in consistenza ora è un array e bisogna create tante componenti CONSISTENZACPS quanti sono gli elementi dell'array&#xD;
if(ConsistenzaCPS != null &amp;&amp; ConsistenzaCPS.size()>0)&#xD;
{&#xD;
	for(var c=0; c&lt;ConsistenzaCPS.size(); c++)&#xD;
	{&#xD;
		currentConsistenzaCPS = ConsistenzaCPS.get(c);&#xD;
&#xD;
		if(currentConsistenzaCPS != null)&#xD;
		{&#xD;
			var codiceCarrierOloAsset = &quot;&quot;;&#xD;
			codiceCarrierOloAsset = null;&#xD;
			var tipoDNRichiestoAsset = &quot;&quot;;&#xD;
			tipoDNRichiestoAsset = null;&#xD;
			var tipoLineaRichiestoAsset = &quot;&quot;;&#xD;
			tipoLineaRichiestoAsset = null;&#xD;
			var radicaleAsset = &quot;&quot;;&#xD;
			radicaleAsset = null;&#xD;
			&#xD;
			//Recupero assetCPS&#xD;
			if(currentConsistenzaCPS.IDAsset != null)&#xD;
			{&#xD;
				Process.auditLog(&quot;Cerco AssetCPS per IDAsset = &quot; + currentConsistenzaCPS.IDAsset);&#xD;
				var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset=:SearchIDAsset&quot;);&#xD;
				criteria.setQueryParameter(&quot;SearchIDAsset&quot;, currentConsistenzaCPS.IDAsset);&#xD;
				var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
				&#xD;
				if(result != null &amp;&amp; result.size() > 0)&#xD;
				{&#xD;
					AssetCPSRef = result.get(0);&#xD;
					AssetCPS = ScriptUtil.copy(AssetCPSRef.readAsset());&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			&#xD;
			if(AssetCPS!=null)&#xD;
			{&#xD;
				for(var i=0; i &lt; AssetCPS.dettaglioasset.size(); i++) //Recupero informazioni asset.&#xD;
				{&#xD;
					var currentDettAsset = AssetCPS.dettaglioasset.get(i);&#xD;
					if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
					{&#xD;
						for(var j=0; j &lt; currentDettAsset.attributidettaglioasset.size() > 0; j++)&#xD;
						{&#xD;
							var attribDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
							if(attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECARRIEROLO)&#xD;
							{&#xD;
								codiceCarrierOloAsset = attribDettAsset.valoreAttributo;&#xD;
								Process.auditLog(&quot;Recuperato codiceCarrierOlo: &quot;+codiceCarrierOloAsset);&#xD;
							}&#xD;
							else if(attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNRICHIESTO)&#xD;
							{&#xD;
								tipoDNRichiestoAsset = attribDettAsset.valoreAttributo;&#xD;
								Process.auditLog(&quot;Recuperato tipoDNRichiesto: &quot;+tipoDNRichiestoAsset);&#xD;
							}&#xD;
							else if(attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEARICHIESTO)&#xD;
							{&#xD;
								tipoLineaRichiestoAsset = attribDettAsset.valoreAttributo;&#xD;
								Process.auditLog(&quot;Recuperato tipoLineaRichiesto: &quot;+tipoLineaRichiestoAsset);&#xD;
							}&#xD;
							else if(attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
							{&#xD;
								radicaleAsset = attribDettAsset.valoreAttributo;&#xD;
								Process.auditLog(&quot;Recuperato radicale: &quot;+radicaleAsset);&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				}	&#xD;
			}&#xD;
			&#xD;
			//Creo componente ConsistenzaCPS.&#xD;
			var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
			componente.IDDettaglioOrdineParent = 1;&#xD;
			componente.IDDettaglioOrdineRoot =1;&#xD;
			componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			componente.IDRisorsa = currentConsistenzaCPS.IDRisorsa;&#xD;
			componente.IDRisorsaNOW = currentConsistenzaCPS.IDRisorsaNOW;&#xD;
			&#xD;
			componente.created = data;&#xD;
			componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
			componente.lastUpdate = data;&#xD;
			componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS;&#xD;
			componente.operatore = &quot;BPM&quot;;&#xD;
			componente.progressivo = 1;&#xD;
			&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(currentConsistenzaCPS.azione);&#xD;
			&#xD;
			//attributi&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = data;&#xD;
			attributo.lastUpdate = data;&#xD;
			attributo.operatore = &quot;BPM&quot;;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			&#xD;
			if(currentConsistenzaCPS.IDAsset != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.IDAsset;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
			}&#xD;
			if(currentConsistenzaCPS.IDRisorsa != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.IDRisorsa;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
			}&#xD;
			if(currentConsistenzaCPS.IDRisorsaNOW != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSANOW;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.IDRisorsaNOW;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
			}&#xD;
			if(currentConsistenzaCPS.codiceOrdineOLO != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLO;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.codiceOrdineOLO;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);				&#xD;
			}&#xD;
			if(currentConsistenzaCPS.codiceOrdineTI != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETI;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.codiceOrdineTI;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
			}&#xD;
			if(currentConsistenzaCPS.invioADtu != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU;&#xD;
				attrTemp.valoreAttributo = &quot;N&quot;;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
			}&#xD;
			if(currentConsistenzaCPS.numeroFittizio != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROFITTIZIO;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.numeroFittizio;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
			}&#xD;
			if(currentConsistenzaCPS.numeroTelefonico != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.numeroTelefonico;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);				&#xD;
			}&#xD;
			if(currentConsistenzaCPS.numeroTelefonicoPrincipale != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.numeroTelefonicoPrincipale;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
			}&#xD;
			if(currentConsistenzaCPS.offerta != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA;&#xD;
				attrTemp.valoreAttributo = String(currentConsistenzaCPS.offerta);&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
			}&#xD;
			if(currentConsistenzaCPS.opzioneTraffico != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.opzioneTraffico;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
			}&#xD;
			if(currentConsistenzaCPS.tipoDnReale != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNREALE;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.tipoDnReale;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);				&#xD;
			}&#xD;
			if(currentConsistenzaCPS.tipoLineaReale != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAREALE;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.tipoLineaReale;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
			}			&#xD;
			if(currentConsistenzaCPS.quantitaLinee != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITALINEE;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.quantitaLinee;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
			}&#xD;
			if(currentConsistenzaCPS.dnPrimario != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DNPRIMARIO;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.dnPrimario;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
			}&#xD;
			if(currentConsistenzaCPS.dsc != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.dsc;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
			}&#xD;
			if(currentConsistenzaCPS.codificaOLOAGCOMDonating != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.codificaOLOAGCOMDonating;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
			}&#xD;
			if(currentConsistenzaCPS.assetBTWhiteList != null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.WHITELIST;&#xD;
				attrTemp.valoreAttributo = currentConsistenzaCPS.assetBTWhiteList;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
				localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;				&#xD;
			}&#xD;
			if(codiceCarrierOloAsset!=null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECARRIEROLO;&#xD;
				attrTemp.valoreAttributo = codiceCarrierOloAsset;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);				&#xD;
			}&#xD;
			if(tipoDNRichiestoAsset!=null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNRICHIESTO;&#xD;
				attrTemp.valoreAttributo = tipoDNRichiestoAsset;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
			}&#xD;
			if(tipoLineaRichiestoAsset!=null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEARICHIESTO;&#xD;
				attrTemp.valoreAttributo = tipoLineaRichiestoAsset;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
			}&#xD;
			if(radicaleAsset!=null)&#xD;
			{&#xD;
				var attrTemp = ScriptUtil.copy(attributo);&#xD;
				attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE;&#xD;
				attrTemp.valoreAttributo = radicaleAsset;&#xD;
				componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
			}&#xD;
			&#xD;
			&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
			Process.auditLog(&quot;Aggiunta Consistenza CPS all'ordine&quot;);&#xD;
			&#xD;
			// SM_9105 - AGGIUNTIVI&#xD;
			if(AssetCPS != null &amp;&amp; currentConsistenzaCPS.tipoDnReale == 'ISDN' &amp;&amp; (currentConsistenzaCPS.tipoLineaReale == 'BRA MULTI' || currentConsistenzaCPS.tipoLineaReale == 'PBX' || currentConsistenzaCPS.tipoLineaReale == 'GNR'))&#xD;
			{&#xD;
				for(var i=0; i &lt; AssetCPS.dettaglioasset.size(); i++) //Recupero informazioni asset.&#xD;
				{&#xD;
					var currentDettAsset = AssetCPS.dettaglioasset.get(i);&#xD;
					&#xD;
					if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
					{&#xD;
						var compAggiuntivo = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
						compAggiuntivo.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
						compAggiuntivo.IDDettaglioOrdineParent = 1;&#xD;
						compAggiuntivo.IDDettaglioOrdineRoot =1;&#xD;
						compAggiuntivo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						compAggiuntivo.IDRisorsa = localRequest.IDRisorsa;&#xD;
						compAggiuntivo.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
						&#xD;
						compAggiuntivo.created = data;&#xD;
						compAggiuntivo.integrationID = localRequest.IDRichiestaOLO+compAggiuntivo.IDDettaglioOrdine;&#xD;
						compAggiuntivo.lastUpdate = data;&#xD;
						compAggiuntivo.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO;&#xD;
						compAggiuntivo.operatore = &quot;BPM&quot;;&#xD;
						compAggiuntivo.progressivo = 1;&#xD;
						&#xD;
						compAggiuntivo.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
						&#xD;
						//attributi&#xD;
						var attributoAgg = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						attributoAgg.IDDettaglioOrdine = compAggiuntivo.IDDettaglioOrdine;&#xD;
						attributoAgg.IDRichiestaOLO = compAggiuntivo.IDRichiestaOLO;&#xD;
						attributoAgg.created = data;&#xD;
						attributoAgg.lastUpdate = data;&#xD;
						attributoAgg.operatore = &quot;BPM&quot;;&#xD;
						attributoAgg.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						&#xD;
						for(var j=0; j &lt; currentDettAsset.attributidettaglioasset.size() > 0; j++)&#xD;
						{&#xD;
							var attribDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
							if(attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE&#xD;
							|| attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO&#xD;
							|| attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO&#xD;
							|| attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE&#xD;
							|| attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
							{&#xD;
								var attrTemp = ScriptUtil.copy(attributo);&#xD;
								attrTemp.nomeAttributo = attribDettAsset.nomeAttributo;&#xD;
								attrTemp.valoreAttributo = attribDettAsset.valoreAttributo;&#xD;
								compAggiuntivo.attributiDettaglioOrdine.add(attrTemp);&#xD;
								Process.auditLog(&quot;Aggiunto attributo &quot;+attrTemp.nomeAttributo+&quot; alla componente Aggiuntivo, con valore &quot;+attrTemp.valoreAttributo);&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(compAggiuntivo));&#xD;
						Process.auditLog(&quot;Aggiunta Componente Aggiuntivo all'ordine&quot;);&#xD;
					}&#xD;
				}&#xD;
				&#xD;
			}&#xD;
		}&#xD;
	&#xD;
	}&#xD;
&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;ConsistenzaCPS inesistente, non aggiunta all'ordine.&quot;);&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
//ACCESSO WLR&#xD;
if(localRequest != null &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
&amp;&amp; (ConsistenzaFonia != null&#xD;
&amp;&amp; ((ConsistenzaFonia.tipoLinea != null &amp;&amp; ConsistenzaFonia.tipoLinea != &quot;&quot;) &#xD;
	|| (ConsistenzaFonia.strutturaLinea != null &amp;&amp; ConsistenzaFonia.strutturaLinea != &quot;&quot;))))&#xD;
{&#xD;
	var accesso = false;&#xD;
	Process.auditLog(&quot;Inizio arricchimento ACCESSO con Consistenza&quot; + ConsistenzaFonia.strutturaLinea + &quot;,&quot; + ConsistenzaFonia.tipoLinea);&#xD;
	&#xD;
	if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine.size() > 0)&#xD;
	{&#xD;
		var i = 0;&#xD;
		accesso = false;&#xD;
	&#xD;
		while(!accesso &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var dettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(dettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
			{&#xD;
				accesso = true;&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
		&#xD;
	if(!accesso)&#xD;
	{&#xD;
		var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
		componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componente.created = data;&#xD;
		componente.integrationID = localRequest.IDRichiestaOLO + componente.IDDettaglioOrdine;&#xD;
		componente.lastUpdate = data;&#xD;
		componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR;&#xD;
		componente.operatore = &quot;BPM&quot;;&#xD;
		componente.progressivo = 1;	&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A;&#xD;
		&#xD;
		localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
	}&#xD;
		&#xD;
	var i = 0;&#xD;
	accesso = false;&#xD;
	&#xD;
	while(!accesso &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var dettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(dettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
		{&#xD;
			accesso = true;&#xD;
			var tipoLinea = false;&#xD;
			var strutturaLinea = false;&#xD;
			var j = 0;&#xD;
				&#xD;
			while(j &lt; dettOrd.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attrDettOrd = dettOrd.attributiDettaglioOrdine.get(j);&#xD;
				if(attrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					tipoLinea = true;&#xD;
					if(ConsistenzaFonia.tipoLinea != null &amp;&amp; ConsistenzaFonia.tipoLinea != &quot;&quot;)&#xD;
					{&#xD;
						attrDettOrd.valoreAttributo = ConsistenzaFonia.tipoLinea;&#xD;
					}&#xD;
				}&#xD;
				else if(attrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
				{&#xD;
					strutturaLinea = true;&#xD;
					if(ConsistenzaFonia.strutturaLinea != null &amp;&amp; ConsistenzaFonia.strutturaLinea != &quot;&quot;)&#xD;
					{&#xD;
						attrDettOrd.valoreAttributo = ConsistenzaFonia.strutturaLinea;&#xD;
					}&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(!tipoLinea || !strutturaLinea)&#xD;
			{&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributo.IDDettaglioOrdine = dettOrd.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = dettOrd.IDRichiestaOLO;&#xD;
				attributo.created = data;&#xD;
				attributo.lastUpdate = data;&#xD;
				attributo.operatore = &quot;BPM&quot;;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				&#xD;
				if(!tipoLinea &amp;&amp; ConsistenzaFonia.tipoLinea != null &amp;&amp; ConsistenzaFonia.tipoLinea != &quot;&quot;)&#xD;
				{&#xD;
					var attrTemp = ScriptUtil.copy(attributo);&#xD;
					attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA;&#xD;
					attrTemp.valoreAttributo = ConsistenzaFonia.tipoLinea;&#xD;
					dettOrd.attributiDettaglioOrdine.add(attrTemp);&#xD;
				}&#xD;
							&#xD;
				if(!strutturaLinea &amp;&amp; ConsistenzaFonia.strutturaLinea != null &amp;&amp; ConsistenzaFonia.strutturaLinea != &quot;&quot;)&#xD;
				{&#xD;
					var attrTemp = ScriptUtil.copy(attributo);&#xD;
					attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA;&#xD;
					attrTemp.valoreAttributo = ConsistenzaFonia.strutturaLinea;&#xD;
					dettOrd.attributiDettaglioOrdine.add(attrTemp);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
//FATTURAZIONELA&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULL&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU)&#xD;
	{&#xD;
		var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
		attributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
		attributo.IDRichiestaOLO = currentDettOrdine.IDRichiestaOLO;&#xD;
		attributo.created = data;&#xD;
		attributo.lastUpdate = data;&#xD;
		attributo.operatore = &quot;BPM&quot;;&#xD;
		attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURAZIONELA;&#xD;
		attributo.valoreAttributo = &quot;Y&quot;;&#xD;
		&#xD;
		currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));		&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
// RU_975 - AGGIUNTIVI eventualmente da cessare poiché legati a una ConsistenzaCPS da cessare (prelevati da singoli asset, caso PBX)&#xD;
//SM_9676: ConsistenzaCPS in uscita dal servizio in consistenza ora è un array e bisogna create tante componenti CONSISTENZACPS quanti sono gli elementi dell'array&#xD;
if(ConsistenzaCPS != null &amp;&amp; ConsistenzaCPS.size()>0)&#xD;
{&#xD;
	for(var c=0; c&lt;ConsistenzaCPS.size(); c++)&#xD;
	{&#xD;
		currentConsistenzaCPS = ConsistenzaCPS.get(c);&#xD;
&#xD;
		if(currentConsistenzaCPS != null &#xD;
		&amp;&amp; String(currentConsistenzaCPS.azione) == 'D' &#xD;
		&amp;&amp; currentConsistenzaCPS.tipoLineaReale == 'PBX')&#xD;
		{&#xD;
			var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numTelPrincipale = :DNprincipale AND numeroTelefonico &lt;> :numeroTelefonico AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND offerta IN ('CPS')&quot;);&#xD;
&#xD;
			c.setQueryParameter(&quot;DNprincipale&quot;,currentConsistenzaCPS.numeroTelefonico);&#xD;
			c.setQueryParameter(&quot;numeroTelefonico&quot;,currentConsistenzaCPS.numeroTelefonico);	&#xD;
			var assetReference = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
&#xD;
			Process.auditLog(&quot;Trovati &quot;+String(assetReference.size())+&quot; aggiuntivi legati alla CPS cessata &quot;+currentConsistenzaCPS.numeroTelefonico);&#xD;
&#xD;
&#xD;
			if(assetReference.size()>0)&#xD;
			{&#xD;
				var IDAssetCPS = &quot;&quot;;&#xD;
				IDAssetCPS = null;&#xD;
				&#xD;
				for(var i = 0; i &lt; assetReference.size(); i++)&#xD;
				{&#xD;
					var assetRef = assetReference.get(i);&#xD;
					var assetTemp = assetRef.readAsset();&#xD;
					&#xD;
					for(var i=0; i &lt; assetTemp.dettaglioasset.size(); i++) //Recupero informazioni dal singolo asset AGGIUNTIVO.&#xD;
					{&#xD;
						var currentDettAsset = assetTemp.dettaglioasset.get(i);&#xD;
						&#xD;
						if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
						{&#xD;
							var compAggiuntivo = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
							compAggiuntivo.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
							compAggiuntivo.IDDettaglioOrdineParent = 1;&#xD;
							compAggiuntivo.IDDettaglioOrdineRoot =1;&#xD;
							compAggiuntivo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							compAggiuntivo.IDRisorsa = localRequest.IDRisorsa;&#xD;
							compAggiuntivo.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
							&#xD;
							compAggiuntivo.created = data;&#xD;
							compAggiuntivo.integrationID = localRequest.IDRichiestaOLO+compAggiuntivo.IDDettaglioOrdine;&#xD;
							compAggiuntivo.lastUpdate = data;&#xD;
							compAggiuntivo.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO;&#xD;
							compAggiuntivo.operatore = &quot;BPM&quot;;&#xD;
							compAggiuntivo.progressivo = 1;&#xD;
							&#xD;
							compAggiuntivo.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
							&#xD;
							//attributi&#xD;
							var attributoAgg = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
							attributoAgg.IDDettaglioOrdine = compAggiuntivo.IDDettaglioOrdine;&#xD;
							attributoAgg.IDRichiestaOLO = compAggiuntivo.IDRichiestaOLO;&#xD;
							attributoAgg.created = data;&#xD;
							attributoAgg.lastUpdate = data;&#xD;
							attributoAgg.operatore = &quot;BPM&quot;;&#xD;
							attributoAgg.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							&#xD;
							for(var j=0; j &lt; currentDettAsset.attributidettaglioasset.size() > 0; j++)&#xD;
							{&#xD;
								var attribDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
								&#xD;
								if(attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN)&#xD;
								{&#xD;
									var attrTemp = ScriptUtil.copy(attributo);&#xD;
									attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
									attrTemp.valoreAttributo = attribDettAsset.valoreAttributo;&#xD;
									compAggiuntivo.attributiDettaglioOrdine.add(attrTemp);&#xD;
									Process.auditLog(&quot;Aggiunto attributo &quot;+attrTemp.nomeAttributo+&quot; alla componente Aggiuntivo, con valore &quot;+attrTemp.valoreAttributo);&#xD;
									&#xD;
									attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
									attrTemp.valoreAttributo = currentConsistenzaCPS.numeroTelefonico;&#xD;
									compAggiuntivo.attributiDettaglioOrdine.add(attrTemp);&#xD;
									Process.auditLog(&quot;Aggiunto attributo &quot;+attrTemp.nomeAttributo+&quot; alla componente Aggiuntivo, con valore &quot;+attrTemp.valoreAttributo);&#xD;
									&#xD;
									attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO;&#xD;
									attrTemp.valoreAttributo = &quot;ATTIVO&quot;;&#xD;
									compAggiuntivo.attributiDettaglioOrdine.add(attrTemp);&#xD;
									Process.auditLog(&quot;Aggiunto attributo &quot;+attrTemp.nomeAttributo+&quot; alla componente Aggiuntivo, con valore &quot;+attrTemp.valoreAttributo);&#xD;
								}&#xD;
								else if(attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE&#xD;
									 || attribDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE)&#xD;
								{&#xD;
									var attrTemp = ScriptUtil.copy(attributo);&#xD;
									attrTemp.nomeAttributo = attribDettAsset.nomeAttributo;&#xD;
									attrTemp.valoreAttributo = attribDettAsset.valoreAttributo;&#xD;
									compAggiuntivo.attributiDettaglioOrdine.add(attrTemp);&#xD;
									Process.auditLog(&quot;Aggiunto attributo &quot;+attrTemp.nomeAttributo+&quot; alla componente Aggiuntivo, con valore &quot;+attrTemp.valoreAttributo);&#xD;
								}&#xD;
							}&#xD;
							&#xD;
							localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(compAggiuntivo));&#xD;
							Process.auditLog(&quot;Aggiunta Componente Aggiuntivo PBX all'ordine&quot;);&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				Process.auditLog(&quot;Nessun asset recuperato per offerta: &quot;+localRequest.offerta+&quot; numeroTelefonico: &quot;+currentConsistenzaCPS.numeroTelefonico);&#xD;
			}&#xD;
		}&#xD;
&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
