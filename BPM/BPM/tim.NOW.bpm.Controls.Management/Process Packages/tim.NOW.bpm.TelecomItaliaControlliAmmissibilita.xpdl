        <xpdl2:Activity Id="_EbIHseOzEeaiKuQ_iqaH6A" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_CFDBIOOzEeaiKuQ_iqaH6A" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_Gahr8cB6EeaRHo7WrpRbeg" Width="58.0">
