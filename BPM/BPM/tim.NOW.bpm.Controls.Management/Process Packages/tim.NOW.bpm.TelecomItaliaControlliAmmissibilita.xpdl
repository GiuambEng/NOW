        <xpdl2:Activity Id="_YLucKw_oEeyv0vptZh267A" Name="ArricchimentoConsistenzaNPNG" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento ConsistenzaNPNG">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Script inserito con RU_1203&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
if(ConsistenzaNPNG != null)&#xD;
{&#xD;
	var assetTarget = it_telecomitalia_it_NOW_casedata_Factory.createAssetTarget();&#xD;
	assetTarget.IDAsset = ScriptUtil.createBigInteger(ConsistenzaNPNG.IDAsset);&#xD;
	assetTarget.flagInLavorazione = true;&#xD;
	localRequest.assetTarget.add(ScriptUtil.copy(assetTarget));&#xD;
&#xD;
	//-------------------------------------- CREAZIONE COMPONENTE CONSISTENZANPNG --------------------------------------------&#xD;
	&#xD;
	Process.auditLog(&quot;Arricchimento CONSISTENZA DATI nell'ordine&quot;);&#xD;
	&#xD;
	var dettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
	dettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	dettOrdine.created = date;&#xD;
	dettOrdine.lastUpdate = date;&#xD;
	dettOrdine.operatore = &quot;BPM&quot;;&#xD;
	dettOrdine.IDRisorsa = localRequest.IDRisorsa;&#xD;
	dettOrdine.progressivo = 1;&#xD;
	dettOrdine.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
	dettOrdine.IDDettaglioOrdineParent = 1;&#xD;
	dettOrdine.IDDettaglioOrdineRoot = 1;&#xD;
&#xD;
	var attribDettOrdine = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attribDettOrdine.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	attribDettOrdine.created = date;&#xD;
	attribDettOrdine.lastUpdate = date;&#xD;
	attribDettOrdine.operatore = &quot;BPM&quot;;&#xD;
	&#xD;
	dettOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(String(ConsistenzaNPNG.azione));&#xD;
	dettOrdine.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZANPNG;&#xD;
	dettOrdine.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
	dettOrdine.integrationID = localRequest.IDRichiestaOLO + dettOrdine.IDDettaglioOrdine;&#xD;
	attribDettOrdine.IDDettaglioOrdine = dettOrdine.IDDettaglioOrdine;&#xD;
	&#xD;
	&#xD;
	//IDRISORSA&#xD;
	if(ConsistenzaNPNG.IDRisorsa != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.IDRisorsa;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//IDRISORSANOW&#xD;
	if(ConsistenzaNPNG.IDRisorsaNOW != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSANOW;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.IDRisorsaNOW;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//OFFERTA&#xD;
	if(ConsistenzaNPNG.offerta != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = String(ConsistenzaNPNG.offerta);&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//CODIFICAOLOAGCOMDONATING&#xD;
	if(ConsistenzaNPNG.codificaOLOAGCOMDonating != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.codificaOLOAGCOMDonating;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//CODICEOPERATOREDONOR&#xD;
	if(ConsistenzaNPNG.codiceOperatoreDonor != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.codiceOperatoreDonor;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//CODICEORDINETI&#xD;
	if(ConsistenzaNPNG.codiceOrdineTI != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETI;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.codiceOrdineTI;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//CODICEORDINEOLO&#xD;
	if(ConsistenzaNPNG.codiceOrdineOLO != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLO;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.codiceOrdineOLO;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//IDENTIFICATIVOASSET&#xD;
	if(ConsistenzaNPNG.IDAsset != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.IDAsset;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//OPZIONETRAFFICO&#xD;
	if(ConsistenzaNPNG.opzioneTraffico != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.opzioneTraffico;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//TIPOPROVISIONING&#xD;
	if(ConsistenzaNPNG.tipoProvisioning != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROVISIONING;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.tipoProvisioning;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//ROUTINGNUMBER&#xD;
	if(ConsistenzaNPNG.routingNumber != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.routingNumber;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//UO&#xD;
	if(ConsistenzaNPNG.UO != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.UO;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.UO;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//TIPOMOVIMENTAZIONE&#xD;
	if(ConsistenzaNPNG.tipoMovimentazione != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOMOVIMENTAZIONE;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.tipoMovimentazione;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//CODICEULTIMAFATTURA&#xD;
	if(ConsistenzaNPNG.codiceUltimaFattura != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEULTIMAFATTURA;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.codiceUltimaFattura;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//CODICEPENULTIMAFATTURA&#xD;
	if(ConsistenzaNPNG.codicePenultimaFattura != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPENULTIMAFATTURA;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.codicePenultimaFattura;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	//INVIOADTU&#xD;
	if(ConsistenzaNPNG.invioaDTU != null)&#xD;
	{&#xD;
		attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INVIOADTU;&#xD;
		attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		attribDettOrdine.valoreAttributo = ConsistenzaNPNG.invioaDTU;&#xD;
				&#xD;
		dettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attribDettOrdine));	&#xD;
	}&#xD;
	&#xD;
	localRequest.ordine.dettaglioordine.add(dettOrdine);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
