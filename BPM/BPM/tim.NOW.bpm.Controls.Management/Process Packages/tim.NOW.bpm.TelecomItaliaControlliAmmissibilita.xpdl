		attrTemp.valoreAttributo = consistenzaCPStemp.numeroTelefonicoPrincipale;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	if(consistenzaCPStemp.offerta != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA;&#xD;
		attrTemp.valoreAttributo = String(consistenzaCPStemp.offerta);&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);			&#xD;
	}&#xD;
	if(consistenzaCPStemp.opzioneTraffico != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO;&#xD;
