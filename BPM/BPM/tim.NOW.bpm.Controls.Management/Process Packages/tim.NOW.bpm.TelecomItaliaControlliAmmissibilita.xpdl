                  <xpdl2:Actual ScriptGrammar="JavaScript">ConsistenzaFonia</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="ConsistenzaDati">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ConsistenzaDati</xpdl2:Actual>
                </xpdl2:DataMapping>
