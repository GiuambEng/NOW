      <xpdl2:Activities>
        <xpdl2:Activity Id="_iIu4YG_nEe2rCYN0lhMjoA" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_GK6ioG_nEe2rCYN0lhMjoA" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="82.0" LaneId="_I20vQW_nEe2rCYN0lhMjoA" Width="45.0">
              <xpdl2:Coordinates XCoordinate="54.0" YCoordinate="139.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_puTioG_nEe2rCYN0lhMjoA" Name="ArricchimentoDettaglioOrdine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Arricchimento Dettaglio Ordine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine.size() > 0)&#xD;
{&#xD;
	var data = DateTimeUtil.createDatetime();&#xD;
	&#xD;
	if(ConsistenzaFonia != null)&#xD;
	{&#xD;
		var data = DateTimeUtil.createDatetime();&#xD;
		&#xD;
		var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
		attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		attributo.created = data;&#xD;
		attributo.lastUpdate = data;&#xD;
		attributo.operatore = localRequest.operatore;&#xD;
		&#xD;
		var foundConsistenzaFonia = false;&#xD;
		var indexConsistenzaFonia = -1;&#xD;
		&#xD;
		var foundIDRISORSA = false;&#xD;
		var foundIDRISORSACORRELATO = false;&#xD;
		var foundOFFERTA = false;&#xD;
		var foundCODICEOPERATOREDONATING = false;&#xD;
		var foundCODICEORDINETI = false;&#xD;
		var foundCODICEORDINEOLO = false;&#xD;
		var foundIDENTIFICATIVOASSET = false;&#xD;
		var foundIDENTIFICATIVODETTAGLIOASSET = false;&#xD;
		var foundTIPOLINEA = false;&#xD;
		var foundSTRUTTURALINEA = false;&#xD;
		var foundSTATO = false;&#xD;
		var foundNUMEROTELEFONICO = false;&#xD;
		var foundNUMEROTELEFONICOPRINCIPALE = false;&#xD;
		var foundNUMEROFITTIZIO = false;&#xD;
		var foundCODEPRESTAGG = false;&#xD;
		var foundAGGLWR = false;&#xD;
		var foundWHITELIST = false;&#xD;
		var foundOPERATORERETE = false;   &#xD;
		&#xD;
		var indexIDRISORSA = -1;&#xD;
		var indexIDRISORSACORRELATO = -1;&#xD;
		var indexOFFERTA = -1;&#xD;
		var indexCODICEOPERATOREDONATING= -1;&#xD;
		var indexCODICEORDINETI= -1;&#xD;
		var indexCODICEORDINEOLO = -1;&#xD;
		var indexIDENTIFICATIVOASSET = -1;&#xD;
		var indexIDENTIFICATIVODETTAGLIOASSET = -1;&#xD;
		var indexTIPOLINEA = -1;&#xD;
		var indexSTRUTTURALINEA = -1;&#xD;
		var indexSTATO = -1;&#xD;
		var indexNUMEROTELEFONICO = -1;&#xD;
		var indexNUMEROTELEFONICOPRINCIPALE = -1;&#xD;
		var indexNUMEROFITTIZIO = -1;&#xD;
		var indexCODEPRESTAGG = -1;&#xD;
		var indexAGGWLR = -1;&#xD;
		var indexWHITELIST = -1;	&#xD;
		var indexOPERATORERETE = -1;   &#xD;
		&#xD;
		for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			attributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
			&#xD;
			//CONSISTENZAFONIA&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
			{&#xD;
				foundConsistenzaFonia = true;&#xD;
				indexConsistenzaFonia = i;&#xD;
				&#xD;
				attributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				currentDettOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(ConsistenzaFonia.azione);&#xD;
				&#xD;
				for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
					{&#xD;
						foundIDRISORSA = true;&#xD;
						indexIDRISORSA = j;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSACORRELATO)&#xD;
					{&#xD;
						foundIDRISORSACORRELATO = true;&#xD;
						indexIDRISORSACORRELATO = j;&#xD;
					}&#xD;
					&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
					{&#xD;
						foundOFFERTA = true;&#xD;
						indexOFFERTA = j;&#xD;
					}&#xD;
					&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING)&#xD;
					{&#xD;
						foundCODICEOPERATOREDONATING = true;&#xD;
						indexCODICEOPERATOREDONATING = j;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETI)&#xD;
					{&#xD;
						foundCODICEORDINETI = true;&#xD;
						indexCODICEORDINETI = j;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLO)&#xD;
					{&#xD;
						foundCODICEORDINEOLO = true;&#xD;
						indexCODICEORDINEOLO = j;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
					{&#xD;
						foundIDENTIFICATIVOASSET = true;&#xD;
						indexIDENTIFICATIVOASSET = j;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVODETTAGLIOASSET) // RU_778&#xD;
					{&#xD;
						foundIDENTIFICATIVODETTAGLIOASSET = true;&#xD;
						indexIDENTIFICATIVODETTAGLIOASSET = j;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						foundTIPOLINEA = true;&#xD;
						indexTIPOLINEA = j;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
					{&#xD;
						foundSTRUTTURALINEA = true;&#xD;
						indexSTRUTTURALINEA = j;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO)&#xD;
					{&#xD;
						foundSTATO = true;&#xD;
						indexSTATO = j;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
					{&#xD;
						foundNUMEROTELEFONICO = true;&#xD;
						indexNUMEROTELEFONICO = j;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE)&#xD;
					{&#xD;
						foundNUMEROTELEFONICOPRINCIPALE = true;&#xD;
						indexNUMEROTELEFONICOPRINCIPALE = j;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEPRESTAGG)&#xD;
					{&#xD;
						foundCODEPRESTAGG = true;&#xD;
						indexCODEPRESTAGG = j;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AGGIUNTIVOWLR)&#xD;
					{&#xD;
						foundAGGLWR = true;&#xD;
						indexAGGWLR = j;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.WHITELIST)&#xD;
					{&#xD;
						foundWHITELIST = true;&#xD;
						indexWHITELIST = j;&#xD;
					}&#xD;
					//SM_10667&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPERATORERETE)&#xD;
					{&#xD;
						foundOPERATORERETE = true;&#xD;
						indexOPERATORERETE = j;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(!foundConsistenzaFonia)&#xD;
		{&#xD;
			var dettaglio = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
			dettaglio.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
			&#xD;
			attributo.IDDettaglioOrdine = dettaglio.IDDettaglioOrdine;&#xD;
			&#xD;
			dettaglio.IDDettaglioOrdineParent = 1;&#xD;
			dettaglio.IDDettaglioOrdineRoot = 1;&#xD;
			dettaglio.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			dettaglio.IDRisorsa = localRequest.IDRisorsa;&#xD;
			dettaglio.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.get(ConsistenzaFonia.azione);&#xD;
			dettaglio.created = data;&#xD;
			dettaglio.integrationID = localRequest.IDRichiestaOLO + dettaglio.IDDettaglioOrdine;&#xD;
			dettaglio.lastUpdate = data;&#xD;
			dettaglio.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA;&#xD;
			dettaglio.operatore = &quot;BPM&quot;;&#xD;
			dettaglio.progressivo = 1;&#xD;
			&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettaglio));&#xD;
			indexConsistenzaFonia = localRequest.ordine.dettaglioordine.size() - 1;&#xD;
		}&#xD;
		&#xD;
		//CONSISTENZAFONIA.IDRISORSA&#xD;
		if(ConsistenzaFonia.IDRisorsa != null)&#xD;
		{&#xD;
			if(foundIDRISORSA)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.get(indexIDRISORSA).valoreAttributo = ConsistenzaFonia.IDRisorsa;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaFonia.IDRisorsa;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//CONSISTENZAFONIA.IDRISORSACORRELATO&#xD;
		if(ConsistenzaFonia.IDRisorsaCorrelato != null)&#xD;
		{&#xD;
			if(foundIDRISORSACORRELATO)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.get(indexIDRISORSACORRELATO).valoreAttributo = ConsistenzaFonia.IDRisorsaCorrelato;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSACORRELATO;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaFonia.IDRisorsaCorrelato;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//CONSISTENZAFONIA.OFFERTA&#xD;
		if(ConsistenzaFonia.offerta != null)&#xD;
		{&#xD;
			if(foundOFFERTA)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.get(indexOFFERTA).valoreAttributo = String(ConsistenzaFonia.offerta);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = String(ConsistenzaFonia.offerta);&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//CONSISTENZAFONIA.CODICEOPERATOREDONATING&#xD;
		if(ConsistenzaFonia.codificaOLOAGCOMDonating != null)&#xD;
		{&#xD;
			if(foundCODICEOPERATOREDONATING)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.get(indexCODICEOPERATOREDONATING).valoreAttributo = ConsistenzaFonia.codificaOLOAGCOMDonating;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaFonia.codificaOLOAGCOMDonating;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaFonia).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}		&#xD;
		&#xD;
		//CONSISTENZAFONIA.CODICEORDINETI&#xD;
		if(ConsistenzaFonia.codiceOrdineTI != null)&#xD;
		{&#xD;
