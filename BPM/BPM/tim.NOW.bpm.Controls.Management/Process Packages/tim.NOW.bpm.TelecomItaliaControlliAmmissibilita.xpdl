        <xpdl2:Activity Id="_321UEIEkEeiS-cjwsXJnlQ" Name="CallCTRLVOIPWLRVULLRECIPIENT" FinishMode="Automatic" IsATransaction="false" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Call CTRL VOIP WLR VULL RECIPIENT" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_gB_pkPRoEeazKYdqUBpQKA" PackageRef="tim.NOW.bpm.ProcesService.Interfaces" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
