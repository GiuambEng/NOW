			{&#xD;
				&#xD;
				//WLR su NGA NAKED&#xD;
				if(ConsistenzaDati != null &amp;&amp; (ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB ||&#xD;
				ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB) &amp;&amp; ConsistenzaDati.flagBTSNaked == &quot;Y&quot;)	&#xD;
				{	&#xD;
					CODEPRESTAGGDaAggiungere = true;&#xD;
					attribDettOrdine.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEPRESTAGG;&#xD;
					attribDettOrdine.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attribDettOrdine.valoreAttributo = &quot;44&quot;;&#xD;
				}&#xD;
