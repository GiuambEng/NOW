	{&#xD;
		if(Asset != null &amp;&amp; Asset.dettaglioasset != null)&#xD;
		{&#xD;
			for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
			{&#xD;
				var componenteAsset = Asset.dettaglioasset.get(i); &#xD;
				&#xD;
				if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
				{	&#xD;
					//SM_9889: spostata creazione componente e attributo all'interno del for&#xD;
					var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
					componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
					componente.IDDettaglioOrdineParent = 1;&#xD;
					componente.IDDettaglioOrdineRoot =1;&#xD;
