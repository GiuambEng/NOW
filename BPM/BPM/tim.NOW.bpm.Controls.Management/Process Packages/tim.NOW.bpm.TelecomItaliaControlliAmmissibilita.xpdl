        <xpdl2:Activity Id="_BUJoAb4JEeakMeVZXnJfqg" Name="CallCTRLOLINCORSOALTROOLO" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Call CTRL OL IN CORSO ALTRO OLO">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_KpOhgN75EeacQOrD1dy-hA" PackageRef="tim.NOW.bpm.ProcesService.Interfaces" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
