        <xpdl2:Activity Id="_hOLy4CjwEeub9unkJKPbBQ" Name="ArricchimentoOrdineVLAN" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Arricchimento Ordine VLAN" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var data = DateTimeUtil.createDatetime();&#xD;
&#xD;
if(ConsistenzaRaccolta != null)&#xD;
{&#xD;
	var assetTarget = it_telecomitalia_it_NOW_casedata_Factory.createAssetTarget();&#xD;
	assetTarget.IDAsset = ScriptUtil.createBigInteger(ConsistenzaRaccolta.IDAsset);&#xD;
	assetTarget.flagInLavorazione = true;&#xD;
	localRequest.assetTarget.add(ScriptUtil.copy(assetTarget));&#xD;
&#xD;
	//RECUPERO ASSET&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		Asset = AssetRef.readAsset();&#xD;
	}&#xD;
	&#xD;
	var IDVLANRETE = &quot;&quot;;&#xD;
	IDVLANRETE = null;&#xD;
	var IDMADRCRMWS  = &quot;&quot;;        //SM_9803&#xD;
	IDMADRCRMWS = null;&#xD;
	var DSLAMTYPE = &quot;&quot;;           //SM_9803&#xD;
	DSLAMTYPE = null;&#xD;
	var MULTICAST = &quot;&quot;;           //Task #33950&#xD;
	MULTICAST = null;&#xD;
	&#xD;
	&#xD;
	// RECUPERO ATTRIBUTI DALL'ASSET CHE NON SONO IN CONSISTENZARACCOLTA&#xD;
	if(Asset != null &amp;&amp; Asset.dettaglioasset != null)&#xD;
	{&#xD;
		for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var componenteAsset = Asset.dettaglioasset.get(i); &#xD;
			&#xD;
			if(String(componenteAsset.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
			{				&#xD;
				for(var j=0; j&lt;componenteAsset.attributidettaglioasset.size(); j++)&#xD;
				{&#xD;
					var attributoAsset = componenteAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDVLANRETE)&#xD;
					{&#xD;
						IDVLANRETE = attributoAsset.valoreAttributo;&#xD;
					}&#xD;
					//SM_9803&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS)&#xD;
					{&#xD;
						IDMADRCRMWS = attributoAsset.valoreAttributo;&#xD;
					}&#xD;
					//SM_9803&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSLAMTYPE)&#xD;
					{&#xD;
						DSLAMTYPE = attributoAsset.valoreAttributo;&#xD;
					}&#xD;
					//Task #33950&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MULTICAST)&#xD;
					{&#xD;
						MULTICAST = attributoAsset.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
&#xD;
	//--------------------------------------AGGIORNAMENTO/CREAZIONE COMPONENTE RACCOLTAVLAN (NGA,GBE,VULA)--------------------------------------------&#xD;
	var foundRACCOLTAVLAN = false;&#xD;
	var i=0;&#xD;
	&#xD;
	//RACCOLTAVLAN presente nella richiesta -> va aggiornata&#xD;
	while(!foundRACCOLTAVLAN &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
		{&#xD;
			foundRACCOLTAVLAN = true;&#xD;
			componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	//RACCOLTAVLAN assente nella richiesta -> va creata &#xD;
	if(!foundRACCOLTAVLAN)&#xD;
	{&#xD;
		var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
		componente.IDDettaglioOrdineParent = 1;&#xD;
		componente.IDDettaglioOrdineRoot =1;&#xD;
		componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componente.IDRisorsa= ConsistenzaRaccolta.IDRisorsa;&#xD;
		componente.IDRisorsaNOW = ConsistenzaRaccolta.IDRisorsaNOW;&#xD;
		componente.created = data;&#xD;
		componente.integrationID = localRequest.IDRichiestaOLO+componente.IDDettaglioOrdine;&#xD;
		componente.lastUpdate = data;&#xD;
		componente.operatore = &quot;BPM&quot;;&#xD;
		componente.progressivo = 1;&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
		&#xD;
		//VLANNGA&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA)&#xD;
		{&#xD;
			componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVLANNGA;&#xD;
		}&#xD;
		//VLANGBE&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN)&#xD;
		{&#xD;
			componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVLANGBE;&#xD;
		}&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANVULA)&#xD;
		{&#xD;
			componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVLANVULA;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//CODICECLLI&#xD;
	if(ConsistenzaRaccolta.codiceClli != null)&#xD;
	{&#xD;
		localRequest.ordine.CLLI = ConsistenzaRaccolta.codiceClli;&#xD;
	}&#xD;
	&#xD;
	//ATTRIBUTI COMUNI A TUTTE E 3 LE OFFERTE&#xD;
	var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
	attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
	attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
	attributo.created = data;&#xD;
	attributo.lastUpdate = data;&#xD;
	attributo.operatore = &quot;BPM&quot;;&#xD;
	&#xD;
	//CODICETDKIT&#xD;
	if(ConsistenzaRaccolta.codiceTdKit != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.codiceTdKit;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//CODICECLLI&#xD;
	if(ConsistenzaRaccolta.codiceClli != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLLI;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.codiceClli;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//NOMECLLI - aggiunto con SM_9792&#xD;
	if(ConsistenzaRaccolta.nomeClli != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMECLLI;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.nomeClli;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//IDENTIFICATIVOVLANOLO&#xD;
	if(ConsistenzaRaccolta.identificativoVlanOlo != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOVLANOLO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.identificativoVlanOlo;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//TRASPORTO&#xD;
	if(ConsistenzaRaccolta.trasporto != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TRASPORTO;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.trasporto;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//CODICEAREARACCOLTA&#xD;
	if(ConsistenzaRaccolta.codiceAreaRaccolta!=null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEAREARACCOLTA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.codiceAreaRaccolta;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//QINQFLAG&#xD;
	if(ConsistenzaRaccolta.qinqFlag != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QINQFLAG;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.qinqFlag;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//IDBRE&#xD;
	if(ConsistenzaRaccolta.idBre != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDBRE;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.idBre;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//CODICEMACROAREA&#xD;
	if(ConsistenzaRaccolta.codiceMacroArea != null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.codiceMacroArea;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//TIPOVLAN&#xD;
	if(ConsistenzaRaccolta.tipoVlan!=null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOVLAN;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.tipoVlan;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//IDRISORSA&#xD;
	if(ConsistenzaRaccolta.IDRisorsa!=null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.IDRisorsa;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//NOMEMACROAREA&#xD;
	if(ConsistenzaRaccolta.nomeMacroArea!=null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.nomeMacroArea;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//NOMEAREARACCOLTA&#xD;
	if(ConsistenzaRaccolta.nomeAreaRaccolta!=null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEAREARACCOLTA;&#xD;
		attrTemp.valoreAttributo = ConsistenzaRaccolta.nomeAreaRaccolta;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	//IDMADRCRMWS - Aggiunto con SM_9803&#xD;
	if(IDMADRCRMWS!=null)&#xD;
	{&#xD;
		var attrTemp = ScriptUtil.copy(attributo);&#xD;
		attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS;&#xD;
		attrTemp.valoreAttributo = IDMADRCRMWS;&#xD;
		attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
		componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
	}&#xD;
	&#xD;
		&#xD;
	//ATTRIBUTI PER LE OFFERTE VLANNGA E VLANGBE&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
	   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN)&#xD;
	{&#xD;
		//FAMIGLIAVLAN&#xD;
		if(ConsistenzaRaccolta.famigliaVlan != null)&#xD;
		{&#xD;
			var attrTemp = ScriptUtil.copy(attributo);&#xD;
			attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN;&#xD;
			attrTemp.valoreAttributo = ConsistenzaRaccolta.famigliaVlan;&#xD;
			attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.NUMBER;&#xD;
			componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
		}&#xD;
		//IDENTIFICATIVOCAR&#xD;
		if(ConsistenzaRaccolta.identificativoCar != null)&#xD;
		{&#xD;
			var attrTemp = ScriptUtil.copy(attributo);&#xD;
			attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCAR;&#xD;
			attrTemp.valoreAttributo = ConsistenzaRaccolta.identificativoCar;&#xD;
			attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
		}&#xD;
		//SUPERMACROAREA&#xD;
		if(ConsistenzaRaccolta.superMacroArea != null)&#xD;
		{&#xD;
			var attrTemp = ScriptUtil.copy(attributo);&#xD;
			attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA;&#xD;
			attrTemp.valoreAttributo = ConsistenzaRaccolta.superMacroArea;&#xD;
			attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
		}&#xD;
		//DSLAMTYPE - Aggiunto con SM_9803&#xD;
		if(DSLAMTYPE != null &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN)&#xD;
		{&#xD;
			var attrTemp = ScriptUtil.copy(attributo);&#xD;
			attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSLAMTYPE;&#xD;
			attrTemp.valoreAttributo = DSLAMTYPE;&#xD;
			attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
		}&#xD;
		//MULTICAST - Task #33950&#xD;
		if(MULTICAST != null &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN)&#xD;
		{&#xD;
			var attrTemp = ScriptUtil.copy(attributo);&#xD;
			attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MULTICAST;&#xD;
			attrTemp.valoreAttributo = MULTICAST;&#xD;
			attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//ATTRIBUTI SOLO PER L'OFFERTA VLANNGA&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA)&#xD;
	{&#xD;
		//BMCLIGHT&#xD;
		if(ConsistenzaRaccolta.bmcLight != null)&#xD;
		{&#xD;
			var attrTemp = ScriptUtil.copy(attributo);&#xD;
			attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BMCLIGHT;&#xD;
			attrTemp.valoreAttributo = ConsistenzaRaccolta.bmcLight;&#xD;
			attrTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			componente.attributiDettaglioOrdine.add(attrTemp);&#xD;
		}&#xD;
		//TIPOLOGIACLUSTERVLAN&#xD;
		if(ConsistenzaRaccolta.tipologiaClusterVlan != null)&#xD;
		{&#xD;
			var attrTemp = ScriptUtil.copy(attributo);&#xD;
			attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN;&#xD;
			attrTemp.valoreAttributo = ConsistenzaRaccolta.tipologiaClusterVlan;&#xD;
