				}&#xD;
				//IDRISORSA&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA&#xD;
				        &amp;&amp; ConsistenzaDati.IDRisorsa != null)&#xD;
				{&#xD;
					foundIDRISORSA = true;&#xD;
					attributo.valoreAttributo = ConsistenzaDati.IDRisorsa;&#xD;
