				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE)&#xD;
			{&#xD;
				dettaglio.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D;&#xD;
			}&#xD;
			&#xD;
			dettaglio.created = data;&#xD;
			dettaglio.integrationID = localRequest.IDRichiestaOLO + dettaglio.IDDettaglioOrdine;&#xD;
			dettaglio.lastUpdate = data;&#xD;
			dettaglio.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI;&#xD;
			dettaglio.operatore = &quot;BPM&quot;;&#xD;
			dettaglio.progressivo = 1;&#xD;
			&#xD;
			localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(dettaglio));&#xD;
			indexConsistenzaDati = localRequest.ordine.dettaglioordine.size() - 1;&#xD;
		}&#xD;
&#xD;
		//CONSISTENZADATI.IDRISORSA&#xD;
		if(ConsistenzaDati.IDRisorsa != null)&#xD;
		{&#xD;
			if(foundIDRISORSA)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.get(indexIDRISORSA).valoreAttributo = ConsistenzaDati.IDRisorsa;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaDati.IDRisorsa;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
			&#xD;
		//CONSISTENZADATI.IDRISORSANOW&#xD;
		if(ConsistenzaDati.IDRisorsaNOW != null)&#xD;
		{&#xD;
			if(foundIDRISORSANOW)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.get(indexIDRISORSANOW).valoreAttributo = ConsistenzaDati.IDRisorsaNOW;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSANOW;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = ConsistenzaDati.IDRisorsaNOW;&#xD;
				&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//CONSISTENZADATI.OFFERTA&#xD;
		if(ConsistenzaDati.offerta != null)&#xD;
		{&#xD;
			if(foundOFFERTA)&#xD;
			{&#xD;
				localRequest.ordine.dettaglioordine.get(indexConsistenzaDati).attributiDettaglioOrdine.get(indexOFFERTA).valoreAttributo = String(ConsistenzaDati.offerta);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA;&#xD;
