       else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
                    || localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)&#xD;
       {&#xD;
             if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICO)&#xD;
             {&#xD;
                    if(localRequest.caratteristica == null)&#xD;
                    {&#xD;
                          localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.get(String(ConsistenzaDati.offerta));&#xD;
                          offertaUpdated = true;&#xD;
                    }&#xD;
                    else&#xD;
                    {&#xD;
                          if(localRequest.caratteristica == &quot;0&quot;)&#xD;
                          {&#xD;
                                 localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT;&#xD;
                                 offertaUpdated = true;&#xD;
                          }&#xD;
                          else if(localRequest.caratteristica == &quot;1&quot;)&#xD;
                          {&#xD;
                                 localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE;&#xD;
                                 offertaUpdated = true;&#xD;
                          }&#xD;
                          else if(localRequest.caratteristica == &quot;2&quot;)&#xD;
                          {&#xD;
                                 localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL;&#xD;
                                 offertaUpdated = true;&#xD;
                          }&#xD;
                    }&#xD;
             }&#xD;
             else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICO)&#xD;
             {&#xD;
                    if(localRequest.caratteristica == null)&#xD;
                    {&#xD;
                          localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.get(String(ConsistenzaDati.offerta));&#xD;
                          offertaUpdated = true;&#xD;
                    }&#xD;
                    else&#xD;
                    {&#xD;
                          if(localRequest.caratteristica == &quot;0&quot;)&#xD;
                          {&#xD;
                                 localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT;&#xD;
                                 offertaUpdated = true;&#xD;
                          }&#xD;
                          else if(localRequest.caratteristica == &quot;2&quot;)&#xD;
                          {&#xD;
                                 localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL;&#xD;
                                 offertaUpdated = true;&#xD;
                          }&#xD;
                    }&#xD;
             }&#xD;
             else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUS)&#xD;
             {&#xD;
                    if(localRequest.caratteristica == null)&#xD;
                    {&#xD;
                          localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.get(String(ConsistenzaDati.offerta));&#xD;
                          offertaUpdated = true;&#xD;
                    }&#xD;
                    else&#xD;
                    {&#xD;
                          if(localRequest.caratteristica == &quot;0&quot;)&#xD;
                          {&#xD;
                                 localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT;&#xD;
                                 offertaUpdated = true;&#xD;
                          }&#xD;
                          else if(localRequest.caratteristica == &quot;1&quot;)&#xD;
                          {&#xD;
                                 localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE;&#xD;
                                 offertaUpdated = true;&#xD;
                          }&#xD;
                          else&#xD;
                          {&#xD;
                                 localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.get(String(ConsistenzaDati.offerta));&#xD;
                                 offertaUpdated = true;&#xD;
                          }&#xD;
                    }&#xD;
             }&#xD;
             else if(String(localRequest.offerta).slice(0,20) == &quot;EASYIPSPECIALPROFILE&quot;) //== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILE) SM_8139&#xD;
             {&#xD;
                    if(localRequest.caratteristica == null)&#xD;
                    {&#xD;
                          localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.get(String(ConsistenzaDati.offerta));&#xD;
                          offertaUpdated = true;&#xD;
                    }&#xD;
                    else&#xD;
                    {&#xD;
                          if(localRequest.caratteristica == &quot;0&quot;)&#xD;
                          {&#xD;
                                 localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT;&#xD;
                                 offertaUpdated = true;&#xD;
                          }&#xD;
                          else if(localRequest.caratteristica == &quot;1&quot;)&#xD;
                          {&#xD;
                                 localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE;&#xD;
                                 offertaUpdated = true;&#xD;
                          }&#xD;
                          else&#xD;
                          {&#xD;
                                 localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.get(String(ConsistenzaDati.offerta));&#xD;
                                 offertaUpdated = true;&#xD;
                          }&#xD;
                    }&#xD;
             }&#xD;
             else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICO)&#xD;
             {&#xD;
                    localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT;&#xD;
                    offertaUpdated = true;&#xD;
             }&#xD;
       }&#xD;
}&#xD;
// CESSAZIONI&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
{&#xD;
	&#xD;
	//RU_1058: DATI -> VLANNGA, VLANGBE, VLANVULA, VP&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN         &#xD;
       || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
       || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANVULA&#xD;
       || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VP)&#xD;
	{&#xD;
		localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.get(String(ConsistenzaRaccolta.offerta));&#xD;
		offertaUpdated = true;&#xD;
	}&#xD;
	//DATI&#xD;
	else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
		 || localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
		 || String(localRequest.offerta).slice(0,3) == &quot;SHA&quot;)&#xD;
	{&#xD;
		localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.get(String(ConsistenzaDati.offerta));&#xD;
		offertaUpdated = true;&#xD;
	}&#xD;
    //FONIA&#xD;
    else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO&#xD;
            &amp;&amp; String(localRequest.offerta).slice(0,3) != &quot;SHA&quot; &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS) //RU_915 - da escludere CPS, tanto resta sempre la stessa offerta&#xD;
    {&#xD;
		localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.get(String(ConsistenzaFonia.offerta));&#xD;
        offertaUpdated = true;&#xD;
    }&#xD;
 &#xD;
}&#xD;
//ATTIVAZIONI&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
{&#xD;
	//LA + NP //RU_736&#xD;
	if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP) &#xD;
	&amp;&amp; VerificaNumerazioneDonoOLOResponse.codificaOLOAgcomDonor != &quot;TLC&quot;)&#xD;
	{&#xD;
		 if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP)&#xD;
		 {&#xD;
				localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA;&#xD;
				offertaUpdated = true;&#xD;
		 }&#xD;
		 else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP)&#xD;
		 {&#xD;
				localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA;&#xD;
				offertaUpdated = true;&#xD;
		 }&#xD;
		 else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP)&#xD;
		 {&#xD;
				localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA;&#xD;
				offertaUpdated = true;&#xD;
		 }&#xD;
	}&#xD;
	// SHA - C02M26F06&#xD;
	else if (String(localRequest.offerta).slice(0,3) == 'SHA' &amp;&amp; ConsistenzaFonia != null)&#xD;
	{&#xD;
		if ((ConsistenzaFonia.tipoLinea != null &amp;&amp; ConsistenzaFonia.tipoLinea == &quot;POTS&quot;) || (ConsistenzaFonia.destinazioneUso != null &amp;&amp; ConsistenzaFonia.destinazioneUso=='1'))&#xD;
		{&#xD;
			localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA;&#xD;
			offertaUpdated = true;&#xD;
		}&#xD;
		else if ((ConsistenzaFonia.tipoLinea != null &amp;&amp; ConsistenzaFonia.tipoLinea == &quot;ISDN&quot;) || (ConsistenzaFonia.destinazioneUso != null &amp;&amp; ConsistenzaFonia.destinazioneUso=='2'))&#xD;
		{&#xD;
			localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA;&#xD;
			offertaUpdated = true;&#xD;
		}	&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
if(offertaUpdated)&#xD;
{&#xD;
       if(localRequest.ordine != null)&#xD;
       {&#xD;
             localRequest.ordine.offerta = localRequest.offerta;&#xD;
       }&#xD;
       &#xD;
       var offertaAccesso = &quot;&quot;;&#xD;
       offertaAccesso = null;&#xD;
       &#xD;
       if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
             || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
             || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
             || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE)&#xD;
       {&#xD;
             offertaAccesso = String(localRequest.offerta);&#xD;
       }&#xD;
       else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT)&#xD;
       {&#xD;
             offertaAccesso = &quot;ATMASIMFLAT&quot;;&#xD;
       }&#xD;
       else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL)&#xD;
       {&#xD;
             offertaAccesso = &quot;ATMASIMHL&quot;;&#xD;
       }&#xD;
       else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE)&#xD;
       {&#xD;
             offertaAccesso = &quot;ATMASIMLITE&quot;;&#xD;
       }&#xD;
       else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT)&#xD;
       {&#xD;
             offertaAccesso = &quot;ATMSIMFLAT&quot;;&#xD;
       }&#xD;
       else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL)&#xD;
       {&#xD;
             offertaAccesso = &quot;ATMSIMHL&quot;;&#xD;
       }&#xD;
       &#xD;
       if(offertaAccesso != null)&#xD;
       {&#xD;
             var updated = false;&#xD;
             var i = 0;&#xD;
             &#xD;
             while(!updated &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
             {&#xD;
                    var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
                    &#xD;
                    if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
                    {&#xD;
                          currentDettOrdine.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.get(&quot;ACCESSO&quot; + offertaAccesso);&#xD;
                          updated = true;&#xD;
                    }&#xD;
                    i++;&#xD;
             }&#xD;
       }&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
