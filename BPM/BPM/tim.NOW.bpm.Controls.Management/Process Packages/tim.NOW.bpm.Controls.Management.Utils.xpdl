if(ConsistenzaFonia!=null){&#xD;
	Process.auditLog(&quot;ConsistenzaFonia: &quot;+ ConsistenzaFonia.IDAsset);&#xD;
}&#xD;
&#xD;
if(NumberPortability != null &amp;&amp; NumberPortability.size() > 0){&#xD;
