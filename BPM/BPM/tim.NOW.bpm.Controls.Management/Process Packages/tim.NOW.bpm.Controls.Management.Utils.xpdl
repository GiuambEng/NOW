        <xpdl2:Activity Id="_kiM8cv4iEe6-1odsg2oA1w" Name="IdentificaservizioinconsistenzaperUsciteinDel82" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Identifica servizio in consistenza per Uscite in  Del 82">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Identifica servizio in consistenza per uscite in Del 82 superato&quot;;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; &#xD;
   localRequest.ordine.idRisorsaOpenFiber != null &amp;&amp; localRequest.ordine.idRisorsaOpenFiber != &quot;&quot;)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;idRisorsaOpenFiber =: idRisorsaOF AND statoAsset IN ('ATTIVO','INLAVORAZIONE') AND offerta = 'FIBERSTREAM' AND tipologiaAccesso = 'DATI'&quot;);&#xD;
	c.setQueryParameter(&quot;idRisorsaOF&quot;, localRequest.ordine.idRisorsaOpenFiber);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		assetDati = ScriptUtil.copy(AssetRef.readAsset());&#xD;
	}&#xD;
	Process.auditLog(&quot;Identifica servizio in consistenza  [&quot;+localRequest.IDRichiestaOLO+&quot;] |   Uscite in Del 82 | Trovato Asset per idRisorsaOf=&quot;+localRequest.ordine.idRisorsaOpenFiber);&#xD;
}&#xD;
&#xD;
if(result != null &amp;&amp; result.size() > 1)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;ServizioConsistenza fallito: asset recuperato non univoco.&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	if(assetDati != null)&#xD;
	{&#xD;
		Process.auditLog(&quot;Identifica servizio in consistenza  [&quot;+localRequest.ordine.idRisorsaOpenFiber+&quot;] |   Uscite in Del 82 | Creazione componente ConsistenzaDati: &quot;+assetDati.IDAsset);&#xD;
		&#xD;
		ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();		&#xD;
		//AZIONE&#xD;
		ConsistenzaDati.azione = &quot;M&quot;;		&#xD;
		//IDRISORSA&#xD;
		ConsistenzaDati.IDRisorsa = assetDati.IDRisorsa;		&#xD;
		//IDRISORSANOW&#xD;
		ConsistenzaDati.IDRisorsaNOW = assetDati.IDRisorsaNOW;	&#xD;
		//IDRISORSAOF&#xD;
		ConsistenzaDati.idRisorsaOpenFiber = assetDati.idRisorsaOpenFiber;	&#xD;
		//OFFERTA&#xD;
		ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetDati.offerta));		&#xD;
		//CODIFICAOLOAGCOMDONATING&#xD;
		ConsistenzaDati.codificaOLOAGCOMDonating = assetDati.codificaOLOAGCOM;&#xD;
		//CODICEORDINETI&#xD;
		ConsistenzaDati.codiceOrdineTI = assetDati.codiceOrdineTI;		&#xD;
		//CODICEORDINEOLO&#xD;
		ConsistenzaDati.codiceOrdineOLO = assetDati.codiceOrdineOLO;		&#xD;
		//IDENTIFICATIVOASSET&#xD;
		ConsistenzaDati.IDAsset = assetDati.IDAsset;	&#xD;
&#xD;
		//SM_11526&#xD;
		ConsistenzaDati.caratterizzazioneArea = assetDati.caratterizzazioneArea;&#xD;
		localRequest.caratterizzazioneArea = assetDati.caratterizzazioneArea;&#xD;
		localRequest.ordine.caratterizzazioneArea = assetDati.caratterizzazioneArea;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Process.auditLog(&quot;Identifica servizio in consistenza  [&quot;+localRequest.IDRichiestaOLO+&quot;] |   Uscite in Del 82 | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;);&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
