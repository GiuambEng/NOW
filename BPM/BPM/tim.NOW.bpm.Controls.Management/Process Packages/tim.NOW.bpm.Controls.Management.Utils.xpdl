        <xpdl2:Activity Id="_-7lV4-LuEeaoOL-mvUhWhw" Name="IdentificaservizioinconsistenzaperNP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Identifica servizio in consistenza per NP">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Identifica servizio in consistenza superato&quot;;&#xD;
&#xD;
//Lista Offerte Accettate&#xD;
var Offertelist= DataUtil.createList();&#xD;
Offertelist.add(&quot;BITSTREAMATMASIMMETRICOFLAT&quot;);&#xD;
Offertelist.add(&quot;BITSTREAMATMASIMMETRICOHL&quot;);&#xD;
Offertelist.add(&quot;BITSTREAMATMASIMMETRICOLITE&quot;);&#xD;
Offertelist.add(&quot;BITSTREAMGBEASIMMETRICOFLAT&quot;);&#xD;
Offertelist.add(&quot;BITSTREAMNGAFTTCAB&quot;);&#xD;
Offertelist.add(&quot;BITSTREAMNGAFTTH&quot;);&#xD;
Offertelist.add(&quot;SEMIBITSTREAMNGAFTTH&quot;);&#xD;
Offertelist.add(&quot;EASYIPBASEPLUSFLAT&quot;);&#xD;
Offertelist.add(&quot;EASYIPBASEPLUSLITE&quot;);&#xD;
Offertelist.add(&quot;EASYIPSPECIALPROFILEFLAT&quot;);&#xD;
Offertelist.add(&quot;EASYIPSPECIALPROFILELITE&quot;);&#xD;
Offertelist.add(&quot;VULAFTTCAB&quot;);&#xD;
Offertelist.add(&quot;VULAFTTH&quot;);&#xD;
Offertelist.add(&quot;SEMIVULAFTTH&quot;);&#xD;
Offertelist.add(&quot;WLRLINEAATTIVA&quot;);&#xD;
Offertelist.add(&quot;WLRLINEANONATTIVA&quot;);&#xD;
Offertelist.add(&quot;VULL&quot;);&#xD;
Offertelist.add(&quot;VULLLINEANONATTIVA&quot;);&#xD;
Offertelist.add(&quot;ULLDATILINEAATTIVANP&quot;);&#xD;
Offertelist.add(&quot;ULLLINEAATTIVANP&quot;);&#xD;
Offertelist.add(&quot;SLULINEAATTIVANP&quot;);&#xD;
Offertelist.add(&quot;NP&quot;);&#xD;
&#xD;
//recupera lista asset NumeroTelefonico.&#xD;
var assetIDList = DataUtil.createList();&#xD;
var AggiuntivoWLRTrovato = false;&#xD;
var IDAggiuntivoWLR = &quot;&quot;;&#xD;
IDAggiuntivoWLR = null;&#xD;
var casoOLORetailerOK = false;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	if(localRequest.ordine.numeroTelefonico!= null &amp;&amp; localRequest.ordine.numeroTelefonico!=&quot;&quot;)&#xD;
	{&#xD;
		var c=cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico = :NT AND statoAsset &lt;> 'CESSATO' AND tipologiaAccesso = 'FONIA' AND offerta &lt;> 'CPS'&quot;);&#xD;
		c.setQueryParameter(&quot;NT&quot;,localRequest.ordine.numeroTelefonico);&#xD;
		var assetList = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		var i=0;&#xD;
		&#xD;
		if(assetList.size()>0)&#xD;
		{&#xD;
			while(i&lt;assetList.size())&#xD;
			{&#xD;
				var assetRefTemp= assetList.get(i);&#xD;
				var assetTemp = assetRefTemp.readAsset();&#xD;
				&#xD;
				if(assetTemp.offerta!= null &amp;&amp; Offertelist.contains(String(assetTemp.offerta)))&#xD;
				{&#xD;
					AssetRecuperatiRef.add(assetRefTemp);&#xD;
					AssetRecuperati.add(ScriptUtil.copy(assetTemp));&#xD;
					assetIDList.add(assetTemp.IDAsset.toString());&#xD;
					&#xD;
					if(assetTemp.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP &amp;&amp; assetTemp.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA)&#xD;
					{&#xD;
						AssetNP = ScriptUtil.copy(assetTemp);&#xD;
						AssetNPRef = assetRefTemp;&#xD;
						Process.auditLog(&quot;Trovato asset (offerta NP e Accesso FONIA) relativo al numero telefonico della richiesta&quot;);&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Nessun asset recuperato con numeroTelefonico: &quot;+ localRequest.ordine.numeroTelefonico);&#xD;
		}&#xD;
	}&#xD;
	else{&#xD;
		Process.auditLog(&quot;numeroTelefonico non presente nell'ordine&quot;);&#xD;
	}&#xD;
&#xD;
	//recupera lista asset IDRisorsa.&#xD;
	if(localRequest.ordine.IDRisorsa!= null &amp;&amp; localRequest.ordine.IDRisorsa!=&quot;&quot;)&#xD;
	{&#xD;
		var c=cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa = :IDR AND statoAsset &lt;> 'CESSATO' AND tipologiaAccesso = 'FONIA' AND offerta &lt;> 'CPS'&quot;);&#xD;
		c.setQueryParameter(&quot;IDR&quot;,localRequest.ordine.IDRisorsa);&#xD;
		var assetList = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		&#xD;
		//Se non trovo nulla per IDRisorsa cerco per RADICALE (RU_522)&#xD;
		if(assetList.size() == 0)&#xD;
		{&#xD;
			var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;dettaglioasset.attributidettaglioasset.nomeAttributo = 'RADICALE' AND dettaglioasset.attributidettaglioasset.valoreAttributo=:DN AND statoAsset &lt;> 'CESSATO' AND tipologiaAccesso = 'FONIA' AND offerta &lt;> 'CPS'&quot;);&#xD;
			c.setQueryParameter(&quot;DN&quot;,localRequest.numeroTelefonico);&#xD;
			var assetList = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		}&#xD;
		&#xD;
		//Se non trovo nulla per RADICALE provo per NUMERO TELEFONICO di una componente AGGIUNTIVO - SM_8454 (RU_778)&#xD;
		if(assetList.size() == 0)&#xD;
		{&#xD;
			var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;(offerta = 'WLRLINEAATTIVA' OR offerta = 'WLRLINEANONATTIVA') AND dettaglioasset.nomeComponente = 'AGGIUNTIVO' AND dettaglioasset.statoDettaglioAsset = 'ATTIVO' AND dettaglioasset.attributidettaglioasset.nomeAttributo = 'NUMEROTELEFONICO' AND dettaglioasset.attributidettaglioasset.valoreAttributo=:DN AND statoAsset = 'ATTIVO' AND tipologiaAccesso = 'FONIA' AND offerta &lt;> 'CPS'&quot;);&#xD;
			c.setQueryParameter(&quot;DN&quot;,localRequest.numeroTelefonico);&#xD;
			var assetList = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			&#xD;
			if(assetList.size()>0)&#xD;
			{&#xD;
				AggiuntivoWLRTrovato = true;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		var i=0;&#xD;
		if(assetList.size()>0)&#xD;
		{&#xD;
			while(i&lt;assetList.size())&#xD;
			{&#xD;
				var assetRefTemp= assetList.get(i);&#xD;
				var assetTemp = assetRefTemp.readAsset();&#xD;
				if(!assetIDList.contains(assetTemp.IDAsset.toString()) &amp;&amp; Offertelist.contains(String(assetTemp.offerta)))&#xD;
				{&#xD;
					AssetRecuperatiRef.add(assetRefTemp);&#xD;
					AssetRecuperati.add(assetTemp);&#xD;
					assetIDList.add(assetTemp.IDAsset.toString());&#xD;
				}&#xD;
				&#xD;
				if(assetTemp.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP &amp;&amp; assetTemp.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA)&#xD;
				{&#xD;
					AssetNP = ScriptUtil.copy(assetTemp);&#xD;
					AssetNPRef = assetRefTemp;&#xD;
					Process.auditLog(&quot;Trovato asset (offerta NP e Accesso FONIA) relativo al numero telefonico della richiesta&quot;);&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Nessun asset recuperato con IDRisorsa: &quot;+ localRequest.ordine.IDRisorsa);&#xD;
		}&#xD;
	}&#xD;
	else{&#xD;
		Process.auditLog(&quot;IDRisorsa non presente nell'ordine&quot;);&#xD;
	}&#xD;
	&#xD;
	if(AssetRecuperati!= null &amp;&amp; AssetRecuperati.size()>0)&#xD;
	{&#xD;
	&#xD;
		if(AssetRecuperati.size()>2)&#xD;
		{&#xD;
			Process.auditLog(&quot;Piu di 2 asset attivi recuperati&quot;);&#xD;
		}&#xD;
		var data = DateTimeUtil.createDatetime();&#xD;
		&#xD;
		var DESTINAZIONEDUSO = &quot;&quot;;&#xD;
		var TIPOLINEA = &quot;&quot;;&#xD;
		var STRUTTURALINEA =&quot;&quot;;&#xD;
		var RADICALE = &quot;&quot;;&#xD;
		&#xD;
		for(var k=0; k&lt;AssetRecuperati.size();k++)&#xD;
		{&#xD;
			var Asset = AssetRecuperati.get(k);&#xD;
			var AssetRef = AssetRecuperatiRef.get(k);&#xD;
			&#xD;
			var trovataAccesso = false;&#xD;
			var i=0;&#xD;
			&#xD;
			while(i&lt;Asset.dettaglioasset.size())&#xD;
			{&#xD;
				var compTemp = Asset.dettaglioasset.get(i);&#xD;
				&#xD;
				if(String(compTemp.nomeComponente).slice(0,7)==&quot;ACCESSO&quot;)&#xD;
				{&#xD;
					trovataAccesso=true;&#xD;
					&#xD;
					for(var j=0; j&lt;compTemp.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var attrTemp = compTemp.attributidettaglioasset.get(j);&#xD;
						&#xD;
						//DESTINAZIONEDUSO&#xD;
						if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO){&#xD;
							DESTINAZIONEDUSO = attrTemp.valoreAttributo;&#xD;
						}						&#xD;
						//TIPOLINEA&#xD;
						if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
							TIPOLINEA = attrTemp.valoreAttributo;&#xD;
						}					&#xD;
						//STRUTTURATIPOLINEA&#xD;
						if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA){&#xD;
							STRUTTURALINEA = attrTemp.valoreAttributo;&#xD;
						}						&#xD;
						//RADICALE&#xD;
						if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE){&#xD;
							RADICALE = attrTemp.valoreAttributo;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				else if(compTemp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO &amp;&amp; AggiuntivoWLRTrovato) // RU_778 salva IDAggiuntivoWLR se lo ha trovato con la CAC&#xD;
				{&#xD;
					var k2 = 0;&#xD;
					&#xD;
					while(IDAggiuntivoWLR == null &amp;&amp; k2 &lt; compTemp.attributidettaglioasset.size())&#xD;
					{&#xD;
						var attrTemp = compTemp.attributidettaglioasset.get(k2);&#xD;
						&#xD;
						//RADICALE&#xD;
						if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO&#xD;
						&amp;&amp; attrTemp.valoreAttributo == localRequest.numeroTelefonico)&#xD;
						{&#xD;
							IDAggiuntivoWLR = String(compTemp.IDDettaglioAsset);&#xD;
							Process.auditLog(&quot;Salvato ID Aggiuntivo WLR: &quot;+IDAggiuntivoWLR);&#xD;
						}						&#xD;
						k2++;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				// salva aggiuntivi se esiste AssetNP&#xD;
				if(AssetNP!= null &amp;&amp; compTemp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
				{&#xD;
					var numeroTelefonico = &quot;&quot;;&#xD;
					var numeroTelefonicoTrovato = false;&#xD;
					var l =0;&#xD;
					&#xD;
					while(!numeroTelefonicoTrovato &amp;&amp; l&lt;compTemp.attributidettaglioasset.size())&#xD;
					{&#xD;
						var attr = compTemp.attributidettaglioasset.get(l);&#xD;
						var TIPOLINEAAGGIUNTIVOTemp =&quot;&quot;;&#xD;
						&#xD;
						if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
						{&#xD;
							numeroTelefonico = attr.valoreAttributo;&#xD;
						}&#xD;
						&#xD;
						l++;&#xD;
					}&#xD;
					&#xD;
					if(numeroTelefonico == AssetNP.numeroTelefonico){&#xD;
						ListaAggiuntivi.add(ScriptUtil.copy(compTemp));&#xD;
						Process.auditLog(&quot;Trovata componente AGGIUNTIVO con numero telefonico uguale alla richiesta: &quot;+ numeroTelefonico);&#xD;
					}&#xD;
					else{&#xD;
						Process.auditLog(&quot;Trovata componente AGGIUNTIVO con numero telefonico diferente dalla richiesta: &quot;+ numeroTelefonico);&#xD;
					}					&#xD;
				}				&#xD;
				i++;&#xD;
			}&#xD;
			&#xD;
			if(trovataAccesso){&#xD;
				AssetAccesso = ScriptUtil.copy(Asset);&#xD;
				AssetAccessoRef = AssetRef;&#xD;
			}			&#xD;
		}		&#xD;
		&#xD;
		//Inizio creazione ConsistenzaFonia----------------------------------------------------------------------------&#xD;
		if(AssetAccesso!= null)&#xD;
		{&#xD;
			if(!(AssetAccesso.codificaOLOAGCOM == &quot;TLC&quot; &amp;&amp; (AssetAccesso.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULL&#xD;
															|| AssetAccesso.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLU&#xD;
															|| AssetAccesso.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATI&#xD;
															|| AssetAccesso.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
															|| AssetAccesso.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
															|| AssetAccesso.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
															|| AssetAccesso.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
															|| AssetAccesso.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
															|| AssetAccesso.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
															|| AssetAccesso.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
															|| AssetAccesso.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
															|| AssetAccesso.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA))){&#xD;
															&#xD;
			ConsistenzaFonia = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFoniaType();&#xD;
			&#xD;
			//ID RISORSA&#xD;
			ConsistenzaFonia.IDRisorsa = AssetAccesso.IDRisorsa;		&#xD;
			ConsistenzaFonia.assetBTWhiteList = AssetAccesso.assetBTWhiteList; //R1E-21-0325&#xD;
			&#xD;
			//ID RISORSA CORRELATO&#xD;
			if(AssetAccesso.IDRisorsaCorrelato!= null &amp;&amp; AssetAccesso.IDRisorsaCorrelato!= &quot;&quot;){&#xD;
				ConsistenzaFonia.IDRisorsaCorrelato = AssetAccesso.IDRisorsaCorrelato;&#xD;
			}&#xD;
			&#xD;
			//OFFERTA&#xD;
			if(AssetAccesso.offerta != null &amp;&amp; AssetAccesso.offerta != &quot;&quot;){&#xD;
				ConsistenzaFonia.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(AssetAccesso.offerta));&#xD;
			}	&#xD;
					&#xD;
			//CODICEOPERATOREDONATING&#xD;
			ConsistenzaFonia.codificaOLOAGCOMDonating = AssetAccesso.codificaOLOAGCOM;&#xD;
			&#xD;
			//CODICEORDINETI&#xD;
			if(AssetAccesso.codiceOrdineTI != null &amp;&amp; AssetAccesso.codiceOrdineTI !=&quot;&quot;){&#xD;
				ConsistenzaFonia.codiceOrdineTI = AssetAccesso.codiceOrdineTI;&#xD;
			}&#xD;
			&#xD;
			//CODICEORDINEOLO&#xD;
			if(AssetAccesso.codiceOrdineOLO != null &amp;&amp; AssetAccesso.codiceOrdineOLO !=&quot;&quot;){&#xD;
				ConsistenzaFonia.codiceOrdineOLO = AssetAccesso.codiceOrdineOLO;&#xD;
			}&#xD;
			&#xD;
			//IDENTIFICATIVOASSET&#xD;
			if(AssetAccesso.IDAsset != null){&#xD;
				ConsistenzaFonia.IDAsset = AssetAccesso.IDAsset;&#xD;
			}&#xD;
			&#xD;
			//TIPOLINEA&#xD;
			if(TIPOLINEA != null &amp;&amp; TIPOLINEA!= &quot;&quot;){&#xD;
				ConsistenzaFonia.tipoLinea = TIPOLINEA;&#xD;
			}&#xD;
			&#xD;
			//STRUTTURALINEA&#xD;
			if(STRUTTURALINEA!= null &amp;&amp; STRUTTURALINEA!=&quot;&quot;){&#xD;
				ConsistenzaFonia.strutturaLinea = STRUTTURALINEA;&#xD;
			}&#xD;
			&#xD;
			//STATO&#xD;
			ConsistenzaFonia.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(AssetAccesso.statoAsset));&#xD;
			&#xD;
			//NUMERO TELEFONICO&#xD;
			if(AggiuntivoWLRTrovato &amp;&amp; localRequest.ordine.numeroTelefonico != null) // RU_778 - o dalla componente AGGIUNTIVO di riferimento&#xD;
			{&#xD;
				ConsistenzaFonia.numeroTelefonico = localRequest.ordine.numeroTelefonico;&#xD;
			}&#xD;
			else if(AssetAccesso.numeroTelefonico != null &amp;&amp; AssetAccesso.numeroTelefonico != &quot;&quot;)&#xD;
			{&#xD;
				ConsistenzaFonia.numeroTelefonico = AssetAccesso.numeroTelefonico;&#xD;
			}&#xD;
			&#xD;
			//NUMERO TELEFONICO PRINCIPALE&#xD;
			if(AssetAccesso.numTelPrincipale!= null &amp;&amp; AssetAccesso.numTelPrincipale!= &quot;&quot;){&#xD;
				ConsistenzaFonia.numeroTelefonicoPrincipale = AssetAccesso.numTelPrincipale;&#xD;
			}&#xD;
			&#xD;
			//NUMERO FITTIZIO&#xD;
			if(AssetAccesso.numeroFittizio!= null &amp;&amp; AssetAccesso.numeroFittizio != &quot;&quot;){&#xD;
				ConsistenzaFonia.numeroFittizio = AssetAccesso.numeroFittizio;&#xD;
			}&#xD;
			&#xD;
			//SM_10667: OPERATORE RETE&#xD;
			if(AssetAccesso.operatoreRete!= null &amp;&amp; AssetAccesso.operatoreRete != &quot;&quot;){&#xD;
				ConsistenzaFonia.operatoreRete = AssetAccesso.operatoreRete;&#xD;
			}&#xD;
			&#xD;
			//AGGIUNTIVO WLR - RU_778&#xD;
			if(String(ConsistenzaFonia.offerta).slice(0,3) == 'WLR' &amp;&amp; AggiuntivoWLRTrovato &amp;&amp; localRequest.ordine.numeroTelefonico != RADICALE)&#xD;
			{&#xD;
				ConsistenzaFonia.aggiuntivoWLR = 'Y';&#xD;
			}&#xD;
			&#xD;
			//IDENTIFICATIVOASSET - RU_778&#xD;
			if(IDAggiuntivoWLR != null)&#xD;
			{&#xD;
				ConsistenzaFonia.idDettaglioAsset = IDAggiuntivoWLR;&#xD;
			}&#xD;
			&#xD;
			//Azione&#xD;
			// Destinzione d'uso FONIA non correlata ad una &#xD;
			if(localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PORTIN&#xD;
			|| localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.CESSAZIONE)&#xD;
			{&#xD;
				if(AssetAccesso.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA&#xD;
					&amp;&amp; (String(AssetAccesso.offerta).slice(0, 3) == &quot;WLR&quot; || String(AssetAccesso.offerta).slice(0, 4) == &quot;VULL&quot; || AggiuntivoWLRTrovato))&#xD;
				{&#xD;
					ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
				}&#xD;
				else if(AssetAccesso.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP &#xD;
						|| AssetAccesso.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
						|| AssetAccesso.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP)&#xD;
				{&#xD;
					ConsistenzaFonia.azione = &quot;T&quot;;&#xD;
				}&#xD;
				else if(AssetAccesso.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA&#xD;
						&amp;&amp; AssetAccesso.IDRisorsaCorrelato == null)&#xD;
				{&#xD;
					ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					ConsistenzaFonia.azione = &quot;N&quot;;&#xD;
				}&#xD;
			}&#xD;
			else if(localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PRENOTIFICADONATING)&#xD;
			{&#xD;
				if(AssetAccesso.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA  &#xD;
				&amp;&amp; (String(AssetAccesso.offerta).slice(0, 3) == &quot;WLR&quot; || String(AssetAccesso.offerta).slice(0, 4) == &quot;VULL&quot; || AggiuntivoWLRTrovato))&#xD;
				{&#xD;
					ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
				}&#xD;
				else if(AssetAccesso.offerta==it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
						|| AssetAccesso.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
						|| AssetAccesso.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP) // RU_736, aggiunto caso ULLDATI + NP - C02M12F07&#xD;
				{&#xD;
					ConsistenzaFonia.azione = &quot;M&quot;;&#xD;
				}&#xD;
				else if(AssetAccesso.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA  &#xD;
				&amp;&amp; AssetAccesso.IDRisorsaCorrelato == null)&#xD;
				{&#xD;
					ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
				}&#xD;
				//N su CONSISTENZA FONIA (Atributo TIPOLOGIA ACCESSO dell’Asset pari a “FONIA” ) in caso di Accesso ULL/ SLU/ ULLDati - RU_736, già presente&#xD;
				else&#xD;
				{&#xD;
					ConsistenzaFonia.azione = &quot;N&quot;;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//Cerco il CORRELATO&#xD;
			if(ConsistenzaFonia.IDRisorsaCorrelato != null &amp;&amp; ConsistenzaFonia.IDRisorsaCorrelato != &quot;&quot;)&#xD;
			{&#xD;
				Process.auditLog(&quot;Cerco ASSET CORRELATO con IDRisorsa: &quot; + ConsistenzaFonia.IDRisorsaCorrelato);&#xD;
				var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa = :IDRC AND statoAsset = 'ATTIVO' AND IDAsset &lt;> :IDA&quot;);&#xD;
				criteria.setQueryParameter(&quot;IDRC&quot;,ConsistenzaFonia.IDRisorsaCorrelato);&#xD;
				criteria.setQueryParameter(&quot;IDA&quot;,ConsistenzaFonia.IDAsset);&#xD;
&#xD;
				var assetCorrelatorefs = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
				&#xD;
				if(assetCorrelatorefs != null &amp;&amp; assetCorrelatorefs.size() > 0)&#xD;
				{&#xD;
					var assetCorrelato = assetCorrelatorefs.get(0).readAsset();&#xD;
					Process.auditLog(&quot;Trovato ASSET CORRELATO con ID: &quot; + assetCorrelato.IDAsset);&#xD;
				}&#xD;
				&#xD;
				if(assetCorrelato != null)&#xD;
				{&#xD;
					ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();&#xD;
&#xD;
					//ID RISORSA&#xD;
					ConsistenzaDati.IDRisorsa = assetCorrelato.IDRisorsa;&#xD;
			&#xD;
					ConsistenzaDati.assetBTWhiteList = assetCorrelato.assetBTWhiteList; //R1E-21-0325&#xD;
			&#xD;
					//ID RISORSA CORRELATO&#xD;
					if(assetCorrelato.IDRisorsaCorrelato!= null &amp;&amp; assetCorrelato.IDRisorsaCorrelato!= &quot;&quot;){&#xD;
						ConsistenzaDati.IDRisorsaCorrelato = assetCorrelato.IDRisorsaCorrelato;&#xD;
					}&#xD;
					&#xD;
					//OFFERTA&#xD;
					if(assetCorrelato.offerta != null &amp;&amp; assetCorrelato.offerta != &quot;&quot;){&#xD;
						ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetCorrelato.offerta));&#xD;
					}	&#xD;
					&#xD;
					//CODICEOPERATOREDONATING&#xD;
					ConsistenzaDati.codificaOLOAGCOMDonating = assetCorrelato.codificaOLOAGCOM;&#xD;
			&#xD;
					//CODICEORDINETI&#xD;
					if(assetCorrelato.codiceOrdineTI != null &amp;&amp; assetCorrelato.codiceOrdineTI !=&quot;&quot;){&#xD;
						ConsistenzaDati.codiceOrdineTI = assetCorrelato.codiceOrdineTI;&#xD;
					}&#xD;
			&#xD;
					//CODICEORDINEOLO&#xD;
					if(assetCorrelato.codiceOrdineOLO != null &amp;&amp; assetCorrelato.codiceOrdineOLO !=&quot;&quot;){&#xD;
						ConsistenzaDati.codiceOrdineOLO = assetCorrelato.codiceOrdineOLO;&#xD;
					}&#xD;
			&#xD;
					//IDENTIFICATIVOASSET&#xD;
					if(assetCorrelato.IDAsset != null){&#xD;
						ConsistenzaDati.IDAsset = assetCorrelato.IDAsset;&#xD;
					}&#xD;
			&#xD;
					var TIPOLINEAACORR = &quot;&quot;;&#xD;
					TIPOLINEAACORR = null;&#xD;
					var STRUTTURALINEACORR = &quot;&quot;;&#xD;
					STRUTTURALINEACORR = null;&#xD;
					var i = 0;&#xD;
					while(i&lt;assetCorrelato.dettaglioasset.size()){&#xD;
						var compTemp = assetCorrelato.dettaglioasset.get(i);&#xD;
				&#xD;
						if(String(compTemp.nomeComponente).slice(0,7)==&quot;ACCESSO&quot;){&#xD;
							trovataAccesso=true;&#xD;
					&#xD;
							for(var j=0; j&lt;compTemp.attributidettaglioasset.size(); j++){&#xD;
								var attrTemp = compTemp.attributidettaglioasset.get(j);&#xD;
							&#xD;
								//TIPOLINEA&#xD;
								if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
									TIPOLINEAACORR = attrTemp.valoreAttributo;&#xD;
								}&#xD;
							&#xD;
								//STRUTTURATIPOLINEA&#xD;
								if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA){&#xD;
									STRUTTURALINEACORR = attrTemp.valoreAttributo;&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
						i++;&#xD;
					}&#xD;
			&#xD;
					//TIPOLINEA&#xD;
					if(TIPOLINEAACORR != null &amp;&amp; TIPOLINEAACORR!= &quot;&quot;){&#xD;
						ConsistenzaDati.tipoLinea = TIPOLINEAACORR;&#xD;
					}&#xD;
			&#xD;
					//STRUTTURALINEA&#xD;
					if(STRUTTURALINEACORR!= null &amp;&amp; STRUTTURALINEACORR!=&quot;&quot;){&#xD;
						ConsistenzaDati.strutturaLinea = STRUTTURALINEACORR;&#xD;
					}&#xD;
			&#xD;
					//STATO&#xD;
					ConsistenzaDati.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(assetCorrelato.statoAsset));&#xD;
			&#xD;
					//NUMERO TELEFONICO&#xD;
					if(AggiuntivoWLRTrovato &amp;&amp; localRequest.ordine.numeroTelefonico != null) // RU_778 - o dalla componente AGGIUNTIVO di riferimento&#xD;
					{&#xD;
						ConsistenzaDati.numeroTelefonico = localRequest.ordine.numeroTelefonico;&#xD;
					}	&#xD;
					else if(assetCorrelato.numeroTelefonico != null &amp;&amp; assetCorrelato.numeroTelefonico != &quot;&quot;)&#xD;
					{&#xD;
						ConsistenzaDati.numeroTelefonico = assetCorrelato.numeroTelefonico;&#xD;
					}&#xD;
			&#xD;
					//NUMERO TELEFONICO PRINCIPALE&#xD;
					if(assetCorrelato.numTelPrincipale!= null &amp;&amp; assetCorrelato.numTelPrincipale!= &quot;&quot;){&#xD;
						ConsistenzaDati.numeroTelefonicoPrincipale = assetCorrelato.numTelPrincipale;&#xD;
					}&#xD;
			&#xD;
					//NUMERO FITTIZIO&#xD;
					if(assetCorrelato.numeroFittizio!= null &amp;&amp; assetCorrelato.numeroFittizio != &quot;&quot;){&#xD;
						ConsistenzaDati.numeroFittizio = assetCorrelato.numeroFittizio;&#xD;
					}&#xD;
					&#xD;
					//OPERATORERETE - Bug #39487&#xD;
					if(assetCorrelato.operatoreRete != null &amp;&amp; assetCorrelato.operatoreRete != &quot;&quot;)&#xD;
					{&#xD;
						ConsistenzaDati.operatoreRete = assetCorrelato.operatoreRete;&#xD;
					}					&#xD;
					ConsistenzaDati.azione = &quot;T&quot;;&#xD;
				}&#xD;
				else{&#xD;
					Process.auditLog(&quot;Nessun ASSET recuperato per IDRisorsaCorrelato&quot;);&#xD;
				}&#xD;
			}&#xD;
			else{&#xD;
				Process.auditLog(&quot;Nessun IDRisorsaCorrelato trovato per CONSISTENZAFONIA&quot;);&#xD;
			}&#xD;
			&#xD;
			}&#xD;
			else{&#xD;
				Process.auditLog(&quot;Consistenza fonia non creata in quanto offerta asset ULL/SLU e OLO TLC&quot;);&#xD;
			}&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Nessuna componente Accesso recuperata&quot;);&#xD;
		}&#xD;
		//Fine creazione ConsistenzaFonia-------------------------------------------------------------------------------&#xD;
		&#xD;
		//Inizio creazione NumberPortability----------------------------------------------------------------------------&#xD;
		if(AssetNP!= null &amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
		{&#xD;
&#xD;
			var CODICEOPERATOREDONOR = &quot;&quot;;&#xD;
			CODICEOPERATOREDONOR=null;&#xD;
			var TIPOLINEANP = &quot;&quot;;&#xD;
			TIPOLINEANP =null;&#xD;
			var ROUTINGNUMBER = &quot;&quot;;&#xD;
			ROUTINGNUMBER=null;&#xD;
			var AGGIUNTIVOWLR = &quot;&quot;;&#xD;
			AGGIUNTIVOWLR = null;&#xD;
			var NUMEROTELEFONICO = &quot;&quot;;&#xD;
			NUMEROTELEFONICO = null;&#xD;
			var NUMEROTELEFONICOPRINCIPALE =&quot;&quot;;&#xD;
			NUMEROTELEFONICOPRINCIPALE = null;&#xD;
			var CODICEOPERATOREDONATING = &quot;&quot;;&#xD;
			CODICEOPERATOREDONATING = null;&#xD;
			var CODICEOPERATORERECIPIENT =&quot;&quot;;&#xD;
			CODICEOPERATORERECIPIENT = null;&#xD;
			var OLORETAILER = &quot;&quot;;&#xD;
			OLORETAILER = null;&#xD;
			var CODICEPIATTAFORMA = &quot;&quot;;&#xD;
			CODICEPIATTAFORMA = null;&#xD;
			&#xD;
			var TIPONUMERO = &quot;&quot;;  //SM_10949 - Aggiunti TIPONUMERO e TIPOSERVIZIO&#xD;
			TIPONUMERO = null;&#xD;
			var TIPOSERVIZIO = &quot;&quot;;&#xD;
			TIPOSERVIZIO = null;&#xD;
			&#xD;
			var CAPOSERIE = &quot;&quot;; //RU_1434 - Aggiunti CAPOSERIE e RADICALE&#xD;
			CAPOSERIE = null;&#xD;
			var RADICALE = &quot;&quot;;&#xD;
			RADICALE = null;&#xD;
						&#xD;
			CODICEOPERATOREDONATING = AssetNP.codificaOLOAGCOM;&#xD;
			&#xD;
			var i = 0;&#xD;
			while(i&lt;AssetNP.dettaglioasset.size()){&#xD;
				var compTemp = AssetNP.dettaglioasset.get(i);&#xD;
				&#xD;
				if(compTemp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
					&#xD;
					for(var j=0; j&lt;compTemp.attributidettaglioasset.size(); j++){&#xD;
						var attrTemp = compTemp.attributidettaglioasset.get(j);&#xD;
&#xD;
						//CODICEOPERATOREDONOR&#xD;
						if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR){&#xD;
							CODICEOPERATOREDONOR = attrTemp.valoreAttributo;&#xD;
						}						&#xD;
						//TIPOLINEANP&#xD;
						else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP){&#xD;
							TIPOLINEANP = attrTemp.valoreAttributo;&#xD;
						}						&#xD;
						//ROUTINGNUMBER&#xD;
						else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER){&#xD;
							ROUTINGNUMBER = attrTemp.valoreAttributo;&#xD;
						}						&#xD;
						//AGGIUNTIVOWLR&#xD;
						else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AGGIUNTIVOWLR){&#xD;
							AGGIUNTIVOWLR = attrTemp.valoreAttributo;&#xD;
						}						&#xD;
						//NUMEROTELEFONICO&#xD;
						else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO){&#xD;
							NUMEROTELEFONICO = attrTemp.valoreAttributo;&#xD;
						}						&#xD;
						//NUMEROTELEFONICOPRINCIPALE&#xD;
						else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE){&#xD;
							NUMEROTELEFONICOPRINCIPALE = attrTemp.valoreAttributo;&#xD;
						}						&#xD;
						//CODICEOPERATORERECIPIENT&#xD;
						else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATORERECIPIENT){&#xD;
							CODICEOPERATORERECIPIENT = attrTemp.valoreAttributo;&#xD;
						}						&#xD;
						//OLORETAILER&#xD;
						else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER){&#xD;
							OLORETAILER = attrTemp.valoreAttributo;&#xD;
						}						&#xD;
						//CODICEPIATTAFORMA&#xD;
						else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA){&#xD;
							CODICEPIATTAFORMA = attrTemp.valoreAttributo;&#xD;
						}						&#xD;
						//TIPONUMERO&#xD;
						else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO){//SM_10949&#xD;
							TIPONUMERO = attrTemp.valoreAttributo;&#xD;
						}						&#xD;
						//TIPOSERVIZIO&#xD;
						else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO){//SM_10949&#xD;
							TIPOSERVIZIO = attrTemp.valoreAttributo;&#xD;
						}&#xD;
						//CAPOSERIE&#xD;
						else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE){//RU_1434&#xD;
							CAPOSERIE = attrTemp.valoreAttributo;&#xD;
						}&#xD;
						//RADICALE&#xD;
						else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE){//RU_1434&#xD;
							RADICALE = attrTemp.valoreAttributo;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
			&#xD;
			var NP = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createNumberPortabilityType();&#xD;
			NP.invioaDTU = &quot;Y&quot;;&#xD;
			&#xD;
			if(AggiuntivoWLRTrovato) // SM_8907&#xD;
			{	&#xD;
				NP.aggiuntivoWLR = &quot;Y&quot;;&#xD;
			}&#xD;
			&#xD;
			if(ListaAggiuntivi.size()>0)&#xD;
			{&#xD;
				//NP.aggiuntivoWLR = &quot;Y&quot;; SM_8907, spostata valorizzazione poco sopra&#xD;
				&#xD;
				var compTemp = ListaAggiuntivi.get(0);&#xD;
				&#xD;
				if(ListaAggiuntivi.size()>1)&#xD;
				{&#xD;
					Process.auditLog(&quot;Piu di un aggiuntivo afferente all'asset NP&quot;);&#xD;
				}&#xD;
				var TIPOLINEAAGGIUNTIVO = &quot;&quot;;&#xD;
				var TIPOLINEAAGGIUNTIVOtrovato = false;&#xD;
				var t =0;&#xD;
				while(!TIPOLINEAAGGIUNTIVOtrovato &amp;&amp; t&lt;compTemp.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attr = compTemp.attributidettaglioasset.get(t);&#xD;
					&#xD;
					if(attr.nomeAttributo ==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						TIPOLINEAAGGIUNTIVO = attr.valoreAttributo;&#xD;
					}&#xD;
					t++;&#xD;
				}&#xD;
				if(TIPOLINEAAGGIUNTIVOtrovato){&#xD;
					NP.tipoLinea = TIPOLINEAAGGIUNTIVO;&#xD;
				}								&#xD;
			}&#xD;
			NP.codiceOperatoreDonor = CODICEOPERATOREDONOR;&#xD;
			NP.codiceOrdineTI = AssetNP.codiceOrdineTI;&#xD;
			NP.tipoLineaNP = TIPOLINEANP;&#xD;
			NP.routingNumber = ROUTINGNUMBER;&#xD;
			NP.numeroTelefonico = NUMEROTELEFONICO;&#xD;
			NP.numeroTelefonicoPrincipale = NUMEROTELEFONICOPRINCIPALE;&#xD;
			NP.codiceOperatoreDonating = CODICEOPERATOREDONATING;&#xD;
			NP.codiceOperatoreRecipient = CODICEOPERATORERECIPIENT;&#xD;
			NP.OLORetailer = OLORETAILER;&#xD;
			NP.codicePiattaforma = CODICEPIATTAFORMA;&#xD;
			NP.tipoNumero = TIPONUMERO;//SM_10949&#xD;
			NP.tipoServizio = TIPOSERVIZIO;//SM_10949&#xD;
			NP.caposerie = CAPOSERIE; //RU_1434&#xD;
			NP.radicale = RADICALE; //RU_1434&#xD;
			NP.IDAsset = AssetNP.IDAsset;			&#xD;
			NP.assetBTWhiteList = AssetNP.assetBTWhiteList; //R1E-21-0325&#xD;
			&#xD;
			NumberPortability.add(ScriptUtil.copy(NP));&#xD;
		}&#xD;
		// Aggiunto con RU_890 per scarto KO_01 in caso NP.OloRetailer != OLO richiedente &#xD;
		else if(AssetNP!= null &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
		{&#xD;
			OLORetailerCessante = null;&#xD;
			&#xD;
			var i = 0;&#xD;
			while(i&lt;AssetNP.dettaglioasset.size())&#xD;
			{&#xD;
				var compTemp = AssetNP.dettaglioasset.get(i);&#xD;
				&#xD;
				if(compTemp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
				{&#xD;
					for(var j=0; j&lt;compTemp.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var attrTemp = compTemp.attributidettaglioasset.get(j);&#xD;
&#xD;
						if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER)&#xD;
						{&#xD;
							OLORetailerCessante = attrTemp.valoreAttributo;&#xD;
							Process.auditLog(&quot;OLORETAILER consisentza: &quot;+OLORetailerCessante);&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
&#xD;
			if(OLORetailerCessante != null &amp;&amp; localRequest.codificaOLOAGCOM != null &amp;&amp; &#xD;
				(OLORetailerCessante != localRequest.codificaOLOAGCOM&#xD;
			&amp;&amp; !(OLORetailerCessante == &quot;WIN&quot; &amp;&amp; localRequest.codificaOLOAGCOM == &quot;INF&quot;)&#xD;
			&amp;&amp; !(OLORetailerCessante == &quot;INF&quot; &amp;&amp; localRequest.codificaOLOAGCOM == &quot;WIN&quot;))) //Bug #31758: due condizioni inserite per evitare lo scarto con OLORETAILER WIN e OLO RICHIEDENTE INF&#xD;
			{&#xD;
				CodiceEsito = 'KO_02';&#xD;
				EsitoResponse.codice=false;&#xD;
				EsitoResponse.descrizione = &quot;Identifica servizio in consistenza fallito per Cessazione NP: OLORETAILER: &quot;+OLORetailerCessante+&quot;, non coincide con OLO richiedente: &quot;+localRequest.codificaOLOAGCOM;&#xD;
				Process.auditLog(EsitoResponse.descrizione);&#xD;
			}&#xD;
			else if((OLORetailerCessante != null &amp;&amp; localRequest.codificaOLOAGCOM != null &amp;&amp; OLORetailerCessante == localRequest.codificaOLOAGCOM)&#xD;
			     || (OLORetailerCessante == &quot;WIN&quot; &amp;&amp; localRequest.codificaOLOAGCOM == &quot;INF&quot;)&#xD;
			     || (OLORetailerCessante == &quot;INF&quot; &amp;&amp; localRequest.codificaOLOAGCOM == &quot;WIN&quot;)) //Bug #31758: due condizioni inserite per evitare lo scarto con OLORETAILER WIN e OLO &#xD;
			{&#xD;
				// Prioritario rispetto al caso particolare della RU_545, se OLORETAILER valorizzato e non scarta, allora va avanti anche se è senza rientro su bundle ecc ecc&#xD;
				casoOLORetailerOK = true;&#xD;
			}&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;Nessuna componente NUMBERPORTABILITY creata in quanto non presente  in asset recuperato, oppure per lavorazione CESSAZIONE&quot;); &#xD;
		}&#xD;
		//Fine creazione NumberPortability----------------------------------------------------------------------------&#xD;
	}&#xD;
	else&#xD;
	{	&#xD;
		Process.auditLog(&quot;Nessun asset Attivo e con Offerta richiesta recuperato per lavorazione di Attivazione&quot;);&#xD;
		&#xD;
		if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
		{&#xD;
			CodiceEsito = 'KO_03';&#xD;
			EsitoResponse.codice=false;&#xD;
			EsitoResponse.descrizione = &quot;Identifica servizio in consistenza fallito per Cessazione NP: Nessun asset attivo recuperato&quot;;&#xD;
			Process.auditLog(EsitoResponse.descrizione);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	// =========== RU_915 == CONSISTENZA CPS ===========&#xD;
	if(EsitoResponse.codice)&#xD;
	{&#xD;
		if(localRequest.ordine != null &amp;&amp; localRequest.ordine.numeroTelefonico != null)&#xD;
		{&#xD;
			var c=cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico = :NT AND statoAsset &lt;> 'CESSATO' AND tipologiaAccesso = 'FONIA' AND offerta = 'CPS'&quot;);&#xD;
			c.setQueryParameter(&quot;NT&quot;,localRequest.ordine.numeroTelefonico);&#xD;
			var assetList = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			Process.auditLog(&quot;Trovato Asset CPS con NumeroTelefonico: &quot;+localRequest.ordine.numeroTelefonico);&#xD;
		}&#xD;
		&#xD;
		if(assetList.size() == 0 &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.IDRisorsa != null)&#xD;
		{&#xD;
			var c=cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa = :IDR AND statoAsset &lt;> 'CESSATO' AND tipologiaAccesso = 'FONIA' AND offerta = 'CPS'&quot;);&#xD;
			c.setQueryParameter(&quot;IDR&quot;,localRequest.ordine.IDRisorsa);&#xD;
			var assetList = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			Process.auditLog(&quot;Trovato Asset CPS con IDRisorsa: &quot;+localRequest.ordine.IDRisorsa);&#xD;
		}&#xD;
		&#xD;
		if(assetList.size() > 0)&#xD;
		{&#xD;
			var assetRefTemp= assetList.get(0);&#xD;
			var assetCPS = assetRefTemp.readAsset();&#xD;
			assetCPSMulti.add(assetCPS);   //SM_9676 &#xD;
		}&#xD;
		&#xD;
		//SM_9676: per ogni DNAggiuntivo va controllato se esiste un AssetCPS&#xD;
		var i = 0;&#xD;
&#xD;
		while(i&lt;localRequest.DNAggiuntivo.size())&#xD;
		{&#xD;
			if(assetCPS != null) //Se abbiamo trovato già un AssetCPS bisogna, ovviamente, escluderlo dalla ricerca&#xD;
			{&#xD;
				var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO') AND offerta IN ('CPS') AND IDAsset &lt;>: ida&quot;);&#xD;
				c.setQueryParameter(&quot;idr&quot;, localRequest.DNAggiuntivo.get(i));&#xD;
				c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(assetCPS.IDAsset));&#xD;
				var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO') AND offerta IN ('CPS')&quot;);&#xD;
				c.setQueryParameter(&quot;idr&quot;, localRequest.DNAggiuntivo.get(i));&#xD;
				var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			}&#xD;
			&#xD;
			if(result != null &amp;&amp; result.size()>0)&#xD;
			{&#xD;
				AssetRefCPS = result.get(0);&#xD;
				assetCPSMulti.add(AssetRefCPS.readAsset());&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa AssetCPS tramite DNAggiuntivo (&quot;+localRequest.DNAggiuntivo.get(i)+&quot;): &quot;+String(AssetRefCPS.readAsset().IDAsset));&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Nessun Asset CPS trovato con DNAggiuntivo: &quot;+localRequest.DNAggiuntivo.get(i));&#xD;
			}&#xD;
&#xD;
			i++;&#xD;
		}&#xD;
			&#xD;
		//Inizio creazione ConsistenzaCPS----------------------------------------------------------------------------&#xD;
		//SM_9676: ConsistenzaCPS ora è un array, quindi modificata la logica &quot;creazione ConsistenzaCPS&quot; per gestire array&#xD;
		var indiceCPS = 0;&#xD;
				&#xD;
		while(indiceCPS &lt; assetCPSMulti.size()) //SM_9676: trasformato in ciclo per CPS Multiple&#xD;
		{&#xD;
			assetCPS = ScriptUtil.copy(assetCPSMulti.get(indiceCPS)); //Sostituisco l'assetCPS principale con quello corrente da scorrere nell'array&#xD;
					&#xD;
			Process.auditLog(&quot;Creazione componente Consistenza CPS: &quot;+String(assetCPS.IDAsset));&#xD;
			&#xD;
			ConsistenzaCPStemp = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaCPSType();			&#xD;
			ConsistenzaCPStemp.azione = &quot;D&quot;;			&#xD;
			ConsistenzaCPStemp.IDRisorsa = assetCPS.IDRisorsa;&#xD;
			ConsistenzaCPStemp.IDRisorsaNOW = assetCPS.IDRisorsaNOW;&#xD;
			ConsistenzaCPStemp.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetCPS.offerta));			&#xD;
			ConsistenzaCPStemp.codificaOLOAGCOMDonating = assetCPS.codificaOLOAGCOM;			&#xD;
			ConsistenzaCPStemp.codiceOrdineTI = assetCPS.codiceOrdineTI;&#xD;
			ConsistenzaCPStemp.codiceOrdineOLO = assetCPS.codiceOrdineOLO;&#xD;
			ConsistenzaCPStemp.IDAsset = assetCPS.IDAsset;&#xD;
			ConsistenzaCPStemp.numeroTelefonico = assetCPS.numeroTelefonico;&#xD;
			ConsistenzaCPStemp.numeroTelefonicoPrincipale = assetCPS.numTelPrincipale;&#xD;
			ConsistenzaCPStemp.numeroFittizio = assetCPS.numeroFittizio;			&#xD;
			ConsistenzaCPStemp.assetBTWhiteList = assetCPS.assetBTWhiteList; //R1E-21-0325&#xD;
			&#xD;
			var OPZIONETRAFFICO = false;&#xD;
			var TIPODNREALE = false;&#xD;
			var TIPOLINEAREALE = false;&#xD;
			var DSC = false;			&#xD;
			var i = 0;			&#xD;
			var accessoTrovato = false;&#xD;
			&#xD;
			// Recupero Dati dall'asset&#xD;
			while(!accessoTrovato &amp;&amp; i &lt; assetCPS.dettaglioasset.size())&#xD;
			{&#xD;
				var componente = assetCPS.dettaglioasset.get(i);&#xD;
				&#xD;
				if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					accessoTrovato = true;&#xD;
					var j = 0;&#xD;
					while((!OPZIONETRAFFICO || !TIPODNREALE || !TIPOLINEAREALE ||!DSC) &#xD;
						&amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
					{&#xD;
						var attributo = componente.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO)&#xD;
						{&#xD;
							OPZIONETRAFFICO = true;&#xD;
							ConsistenzaCPStemp.opzioneTraffico = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNREALE)&#xD;
						{&#xD;
							TIPODNREALE = true;&#xD;
							ConsistenzaCPStemp.tipoDnReale = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAREALE)&#xD;
						{&#xD;
							TIPOLINEAREALE = true;&#xD;
							ConsistenzaCPStemp.tipoLineaReale = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC)&#xD;
						{&#xD;
							DSC = true;&#xD;
							ConsistenzaCPStemp.dsc = attributo.valoreAttributo;&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}			&#xD;
			ConsistenzaCPStemp.invioADtu = 'N';			&#xD;
			ConsistenzaCPS.add(ConsistenzaCPStemp);&#xD;
			indiceCPS++;&#xD;
		}&#xD;
	}&#xD;
	//Fine creazione ConsistenzaCPS------------------------------------------------------------------------------				&#xD;
	&#xD;
	// RU 545 - ECCEZIONE CESSAZIONE NP SENZA RIENTRO su un bundle ULL+NP/ULLD+NP/SLU+NP&#xD;
	if (!casoOLORetailerOK &amp;&amp; ConsistenzaFonia != null &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp;&#xD;
		(ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVANP||&#xD;
		ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVANP ||&#xD;
		ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEAATTIVANP))&#xD;
	//VERIFICA RIENTRO IN TI	&#xD;
	{&#xD;
		var Rientro = false;&#xD;
		var i=0;&#xD;
		while (!Rientro &amp;&amp; i&lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			Process.auditLog(&quot;Trovata componente &quot;+currentComponente.nomeComponente);&#xD;
			&#xD;
			if (currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
				for (var j=0; j&lt; currentComponente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RIENTROTI)	&#xD;
					{&#xD;
						Rientro = true;&#xD;
						Process.auditLog(&quot;Trovato RIENTROTI con valore: &quot;+currentAttributo.valoreAttributo);&#xD;
					}&#xD;
				}&#xD;
			}		&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		if(!Rientro){&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Identifica servizio in consistenza fallito per Eccezione: Cessazione NP senza rientro su bundle ULL+NP/ULLD+NP/SLU+NP&quot;;&#xD;
			Process.auditLog(EsitoResponse.descrizione);&#xD;
		}		&#xD;
		Process.auditLog(&quot;Rientro: &quot;+Rientro+&quot;, ConsistenzaFonia.offerta: &quot;+ConsistenzaFonia.offerta+&quot;, localRequest.lavorazione: &quot;+localRequest.lavorazione);&#xD;
	}&#xD;
}&#xD;
else{&#xD;
	Process.auditLog(&quot;Ordine non presente nella richiesta&quot;);&#xD;
	CodiceEsito='KO_0 2';&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Identifica servizio in consistenza fallito - Ordine non presente nella richiesta&quot;;&#xD;
	Process.auditLog(EsitoResponse.descrizione);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
