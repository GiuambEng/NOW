        <xpdl2:Activity Id="_EaYg5eLvEeaoOL-mvUhWhw" Name="DeterminaSottoLavorazioneRichiesta" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Determina Sotto Lavorazione Richiesta">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(LavorazioneRichiesta == null) //Inserito IF con RU_1058, poiché altrimenti veniva cancellato tutto lavorazione Richiesta sempre e in ogni caso&#xD;
{&#xD;
	LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
}&#xD;
&#xD;
//Variazione Fonia&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	/*//Variazione WLR&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA)&#xD;
	{&#xD;
		&#xD;
	}&#xD;
	//Variazione ULL&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA)&#xD;
	{&#xD;
		&#xD;
	}&#xD;
	//Variazione SHA&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA)&#xD;
	{&#xD;
		&#xD;
	}&#xD;
	//Variazione SLU&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA)&#xD;
	{&#xD;
&#xD;
	}*/&#xD;
	if(localRequest.ordine.tipologiaSottolav ==it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTSMULTINUMERO&#xD;
		|| localRequest.ordine.tipologiaSottolav ==it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CESSAZIONESTSMULTINUMERO)&#xD;
	{&#xD;
		//Crea l'attributo NUM_LINEE_MOV&#xD;
		for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AGGIUNTIVIISDN)&#xD;
					{&#xD;
						LavorazioneRichiesta.numeroLineeMov = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	//CAMBIOCANALIWLR é un placeholder impostato da filemanager/GUI per indicare che devo sovrascrivere la sottolavorazione&#xD;
	else if(localRequest.ordine.tipologiaSottolav ==it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOCANALIWLR)&#xD;
	{&#xD;
		var quantitaLineeRichiesta = 0;&#xD;
		quantitaLineeRichiesta = null;&#xD;
		var numAggiuntiviRichiesta = 0;&#xD;
		numAggiuntiviRichiesta = null;&#xD;
		&#xD;
		var quantitaLineeAsset = 0;&#xD;
		quantitaLineeAsset = null;&#xD;
		var quantitaCanaliAsset = 0;&#xD;
		quantitaCanaliAsset = null;&#xD;
		var numAggiuntiviAsset = 0;&#xD;
		numAggiuntiviAsset = null;&#xD;
		&#xD;
		for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITALINEE)&#xD;
					{&#xD;
						quantitaLineeRichiesta = parseInt(currentAttDettOrdine.valoreAttributo, 10);&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMAGGIUNTIVI)&#xD;
					{&#xD;
						numAggiuntiviRichiesta = parseInt(currentAttDettOrdine.valoreAttributo, 10);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		// Bug #24414 - per GNR/PBX NUMAGGIUNTIVI invece di QUANTITALINEE per la logica del calcolo linee movimentate&#xD;
		if(quantitaLineeRichiesta == null)&#xD;
		{&#xD;
			quantitaLineeRichiesta = numAggiuntiviRichiesta;&#xD;
		}&#xD;
		&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaFonia.IDAsset, 10));&#xD;
		Asset = AssetRef.readAsset();&#xD;
		&#xD;
		for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
			&#xD;
			if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
				{&#xD;
					var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITALINEE)&#xD;
					{&#xD;
						quantitaLineeAsset = parseInt(currentAttDettAsset.valoreAttributo, 10);&#xD;
					}&#xD;
					else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITACANALI)&#xD;
					{&#xD;
						quantitaCanaliAsset = parseInt(currentAttDettAsset.valoreAttributo, 10);&#xD;
					}&#xD;
					else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMAGGIUNTIVI)&#xD;
					{&#xD;
						numAggiuntiviAsset = parseInt(currentAttDettAsset.valoreAttributo, 10);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		// Bug #24414 - per GNR/PBX NUMAGGIUNTIVI invece di QUANTITALINEE per la logica del calcolo linee movimentate		&#xD;
		if(quantitaLineeAsset == null)&#xD;
		{&#xD;
			quantitaLineeAsset = numAggiuntiviAsset;&#xD;
		}&#xD;
		&#xD;
		if(ConsistenzaFonia.tipoLinea == &quot;POTS&quot;&#xD;
			&amp;&amp; (ConsistenzaFonia.strutturaLinea == &quot;PBX&quot;&#xD;
				|| ConsistenzaFonia.strutturaLinea == &quot;GNR&quot;))&#xD;
		{&#xD;
			if(quantitaLineeAsset &lt; quantitaLineeRichiesta)&#xD;
			{&#xD;
				localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOCANALI;&#xD;
				LavorazioneRichiesta.numeroLineeMov = quantitaLineeRichiesta - quantitaLineeAsset;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOCANALI;&#xD;
				LavorazioneRichiesta.numeroLineeMov = quantitaLineeAsset - quantitaLineeRichiesta;&#xD;
			}&#xD;
		}&#xD;
		else if(ConsistenzaFonia.tipoLinea == &quot;ISDN&quot;&#xD;
			&amp;&amp; (ConsistenzaFonia.strutturaLinea == &quot;PBX&quot;&#xD;
				|| ConsistenzaFonia.strutturaLinea == &quot;GNR&quot;))&#xD;
		{&#xD;
			if(quantitaCanaliAsset &lt; quantitaLineeRichiesta)&#xD;
			{&#xD;
				localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOCANALI;&#xD;
				LavorazioneRichiesta.numeroLineeMov = quantitaLineeRichiesta - quantitaCanaliAsset; 	//SM_8910: sostituito quantitaLineeAsset con quantitaCanaliAsset&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOCANALI;&#xD;
				LavorazioneRichiesta.numeroLineeMov = quantitaCanaliAsset - quantitaLineeRichiesta; 	//SM_8910: sostituito quantitaLineeAsset con quantitaCanaliAsset&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Calcolo SottoLavorazione non gestito. Tipolinea ConsistenzaFonia: &quot; + ConsistenzaFonia.tipoLinea + &quot; StrtturaLinea ConsistenzaFonia: &quot; + ConsistenzaFonia.strutturaLinea);&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Calcolo SottoLavorazione anticipata. Lavorazione: &quot; + localRequest.lavorazione + &quot; Offerta: &quot; + localRequest.offerta + &quot; Sottolavorazione: &quot; + localRequest.ordine.tipologiaSottolav);&#xD;
	}&#xD;
}&#xD;
//Attivazione&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
{&#xD;
	//Attivazione NGA XDSL&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH                //RU_1164: aggiunte SEMI***&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM				//SM_11229&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)         //KIT C06 2025&#xD;
	{&#xD;
		if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.destinazioneUso != null &amp;&amp; ConsistenzaFonia.destinazioneUso.length > 1)&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274;&#xD;
		}&#xD;
		else if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.codificaOLOAGCOMDonating == &quot;TLC&quot;)&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
		}&#xD;
		&#xD;
		// RU_918 - Caso particolare IDRISORSAOLD&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH               //RU_1109: aggiunte VULAFTTH, BITSTREAMNGAFTTH e EASYIPNGAFTTH&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH           //RU_1164: aggiunte SEMI***&#xD;
         || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
         || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)    //KIT C06 2025&#xD;
		{&#xD;
			var IDRISORSAOLD = false;&#xD;
			&#xD;
			//Cerca IDRISORSAOLD&#xD;
			for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
					{&#xD;
						var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAOLD)&#xD;
						{&#xD;
							IDRISORSAOLD = true;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if(IDRISORSAOLD)&#xD;
			{&#xD;
				localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	//Attivazione ULL SLU WLR VULL LNA SHA&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA)&#xD;
	{&#xD;
		localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
		&#xD;
		// RU_918 - Caso particolare IDRISORSAOLD&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA)&#xD;
		{&#xD;
			var IDRISORSAOLD = false;&#xD;
			&#xD;
			//Cerca IDRISORSAOLD&#xD;
			for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
					{&#xD;
						var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAOLD)&#xD;
						{&#xD;
							IDRISORSAOLD = true;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if(IDRISORSAOLD)&#xD;
			{&#xD;
				localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	//Attivazione ULL SLU WLR VULL LA&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA)&#xD;
	{&#xD;
		localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.USCITADATI;&#xD;
		&#xD;
		//SM_1042 (post SM_10116) USCITADATI è come se fosse una MIGRAZIONE TIM2OLO, quindi anche in questo caso deve diventare MIGRAZIONE OLO2OLO&#xD;
		//se è presente ASSETBTWHITELIST in consistenza&#xD;
		//Task #39332: aggiunto controllo sull'azione a D&#xD;
		if((ConsistenzaDati != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != null &amp;&amp; ConsistenzaDati.azione == &quot;D&quot;) &#xD;
		|| (ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.assetBTWhiteList != null &amp;&amp; ConsistenzaFonia.azione == &quot;D&quot;))&#xD;
		{&#xD;
			localRequest.lavorazione = it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE;&#xD;
			localRequest.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO;&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO;&#xD;
		}&#xD;
	}&#xD;
	//Attivazione NP&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP&#xD;
			&amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG)&#xD;
	{&#xD;
		//RU_989: aggiunta sottolavorazione per NP DEL82&#xD;
		if(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.B2B)&#xD;
		{&#xD;
			//RU_1463: inserita logica per distinguere le sottolavorazioni (PRIMAPORTABILITADEL82 è nuova)&#xD;
			if(NumberPortability != null &amp;&amp; NumberPortability.size()>0)    //sono quelle che creiamo con azione a D recuperate dal servizio in consistenza&#xD;
			{&#xD;
				localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PORTABILITASUCCESSIVADEL82;&#xD;
			}&#xD;
			else&#xD;
			{				&#xD;
				localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRIMAPORTABILITADEL82;&#xD;
			}&#xD;
		}&#xD;
		else if(localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PRENOTIFICADONATING)&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DONOROLO;&#xD;
		}&#xD;
		else if(NumberPortability != null &amp;&amp; NumberPortability.size() > 0)&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PORTABILITASUCCESSIVA;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			if(ConsistenzaFonia != null &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEAATTIVA&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULL&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULLLINEANONATTIVA))&#xD;
			{&#xD;
				localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PORTABILITASUCCESSIVA;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	//Attivazione ATM SIMMETRICO&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL)&#xD;
	{&#xD;
		var tecnologiaRichiesta = &quot;&quot;;&#xD;
		tecnologiaRichiesta= null;&#xD;
		var i = 0;&#xD;
		&#xD;
		while(tecnologiaRichiesta == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(tecnologiaRichiesta == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIA)&#xD;
					{&#xD;
						tecnologiaRichiesta = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		if(tecnologiaRichiesta == &quot;D&quot;)&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESDH;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
		}&#xD;
	}&#xD;
	//Attivazione GBE SIMMETRICO&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)&#xD;
	{&#xD;
		localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
	}&#xD;
	// Attivazione FWA (RU_716) + SM_8999 per CPS.&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIXEDWIRELESSACCESS&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FWAITALIA1GIGASARDEGNA)   //RU_1475&#xD;
	{&#xD;
		localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
	}&#xD;
	//R1I-20-0150&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANVULA&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VP)&#xD;
	{&#xD;
		localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
	}&#xD;
	//RU_1150&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON&#xD;
            ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIGPON1BPNRR //SM_11886&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPON1BPNRR)//SM_11886&#xD;
	{&#xD;
		localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
	}&#xD;
	//RU_1203: NPNG&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NPNG&#xD;
	        &amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.FILE)&#xD;
	{&#xD;
		if(ConsistenzaNPNG != null)&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PORTABILITASUCCESSIVA;&#xD;
		}&#xD;
		else &#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;ERRORE calcolo SottoLavorazione per offerta non gestita. Lavorazione: &quot; + localRequest.lavorazione + &quot; Offerta: &quot; + localRequest.offerta);&#xD;
	}&#xD;
}&#xD;
//Cessazione&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
{&#xD;
	//Cessazione NP&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP&#xD;
		&amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG)&#xD;
	{&#xD;
		var foundRientroTI = false;&#xD;
		var i = 0;&#xD;
		while(!foundRientroTI &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(!foundRientroTI &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RIENTROTI)&#xD;
					{&#xD;
						foundRientroTI = true;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		if(foundRientroTI)&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIENTRONP;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
		}&#xD;
	}&#xD;
	// Cessazione CPS: SM_8999 e RU_975 per CPS.&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
	{&#xD;
		if(localRequest.codificaOLOAGCOM != 'TLC'&#xD;
		   || (localRequest.codificaOLOAGCOM == 'TLC' &amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR))  //aggiunta con SM_9405&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIENTROCPS;&#xD;
			localRequest.lavorazione = it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE;&#xD;
		}&#xD;
	}&#xD;
	//R1I-20-0150&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANVULA&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VP)&#xD;
	{&#xD;
		localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
	}&#xD;
	//RU_1150&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON&#xD;
            ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIGPON1BPNRR //SM_11886&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPON1BPNRR)//SM_11886)&#xD;
	{&#xD;
		localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
	}&#xD;
	//Cessazione ULL/WLR/VULL/SLU&#xD;
	else if(/*localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CESSAZIONEWLRLINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CESSAZIONEWLRLINEANONATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CESSAZIONEULL&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CESSAZIONESLU*/&#xD;
			(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO&#xD;
			 &amp;&amp; localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIENTROINTI)  //SM_10378: RIENTROINTI ci arriva in input &#xD;
			|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
			|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
			|| (localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FIBERSTREAM&#xD;
			    &amp;&amp; localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.USCITEDEL82)) //SM_11343: in questo caso arriva in input&#xD;
	{&#xD;
		localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
	}&#xD;
	// Cessazione FWA (RU_833)&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIXEDWIRELESSACCESS)&#xD;
	{&#xD;
		localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
	}&#xD;
	//Cessazione NGA/XDSL&#xD;
	/*else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CESSAZIONEWLRLINEANONATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
			)&#xD;
	{&#xD;
		localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE;&#xD;
	}*/&#xD;
}&#xD;
//Migrazione&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
{&#xD;
	//SM_10116 - MIGRAZIONE TIM2OLO che diventa OLO2OLO&#xD;
	if(localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIENTROINTI //SM_10210 - escluso RIENTROINTI&#xD;
	 &amp;&amp;((ConsistenzaDati != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != null) &#xD;
	    || (ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.assetBTWhiteList != null)))&#xD;
	{&#xD;
		localRequest.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO;&#xD;
		localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO;&#xD;
	}&#xD;
	&#xD;
	/*//Migrazione Regolamentate&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULL&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATI&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHAREDACCESS&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLU)&#xD;
	{&#xD;
		if(localRequest.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIENTROINTI;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO;&#xD;
		}&#xD;
	}&#xD;
	//Migrazione XDSL/NGA&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE)&#xD;
	{&#xD;
		//Se ATTIVAZIONE274 arriva giá valorizzato da FileManager&#xD;
		if(localRequest.ordine.tipologiaSottolav == null)&#xD;
		{&#xD;
			localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO;&#xD;
		}&#xD;
	}*/&#xD;
}&#xD;
&#xD;
localRequest.tipologiaSottolav = localRequest.ordine.tipologiaSottolav;&#xD;
LavorazioneRichiesta.sottoLavorazione = String(localRequest.ordine.tipologiaSottolav);&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="106.0" LaneId="_EaYg4eLvEeaoOL-mvUhWhw" Width="175.0">
              <xpdl2:Coordinates XCoordinate="2066.0" YCoordinate="186.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_pTX5UgAkEeeCcNWKDtDUdA" Name="DatiVerificaControlli" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Dati Verifica Controlli">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_Aa1wkMIeEeaIJ-AnJ3AotA" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="Azione">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;INSERT&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="IDRichiestaOLO">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="Operatore">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.operatore</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="LavorazioneRichiesta">
                  <xpdl2:Actual ScriptGrammar="JavaScript">LavorazioneRichiesta</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="80.0" LaneId="_EaYg4eLvEeaoOL-mvUhWhw" Width="128.0">
              <xpdl2:Coordinates XCoordinate="2639.0" YCoordinate="186.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.utils.xpdl.DatiVerificaControlliStorico&quot;;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_KEXqMAAlEeeCcNWKDtDUdA" Name="DeterminaOfferta" xpdExt:Visibility="Private" xpdExt:DisplayName="Determina Offerta">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//MIGRAZIONI&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
{&#xD;
	//OLO2OLO&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO)&#xD;
	{&#xD;
		if(ConsistenzaFonia == null &amp;&amp; LNA_LA == null)&#xD;
		{&#xD;
			LNA_LA = &quot;LNA&quot;;&#xD;
		}&#xD;
		var foundNP = false;&#xD;
		var i = 0;&#xD;
		var dnNP = &quot;&quot;;&#xD;
		dnNP = null;&#xD;
		while(!foundNP &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(!foundNP &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN)&#xD;
					{&#xD;
						foundNP = true;&#xD;
						dnNP = currentAttDettOrdine.valoreAttributo;&#xD;
                    }&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULL)&#xD;
		{&#xD;
			if(!foundNP)&#xD;
			{&#xD;
				if(LNA_LA == &quot;LNA&quot;)&#xD;
				{&#xD;
					localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA;&#xD;
					localRequest.ordine.LNA_LA = it_telecomitalia_it_NOW_casedata_LNA_LAEnumeration.LNA;&#xD;
					offertaUpdated = true;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA;&#xD;
					localRequest.ordine.LNA_LA = it_telecomitalia_it_NOW_casedata_LNA_LAEnumeration.LA;&#xD;
					offertaUpdated = true;&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				var dnMatched = false;&#xD;
				var dn = DataUtil.createList();&#xD;
				dn.add(dnNP);&#xD;
				dn.addAll(localRequest.DNAggiuntivo);&#xD;
				var i = 0;&#xD;
				while(!dnMatched &amp;&amp; i &lt; dn.size() &amp;&amp; ConsistenzaFonia != null)&#xD;
				{&#xD;
