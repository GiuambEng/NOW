        <xpdl2:Activity Id="_uPPpwAwrEeiuHqlfsrN1jg" Name="CalcoloOLOAccorpante" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="CalcoloOLOAccorpante">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_uPPpwQwrEeiuHqlfsrN1jg">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="false" Direction="IN" Formal="parameters">
                      <xpdl2:Actual ScriptGrammar="JavaScript">CalcolaOLOAccorpanteInput</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageIn>
                <xpdl2:MessageOut Id="_uPPpwgwrEeiuHqlfsrN1jg">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="false" Direction="OUT" Formal="parameters">
                      <xpdl2:Actual ScriptGrammar="JavaScript">CalcolaOLOAccorpanteOutput</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_uPPpxQwrEeiuHqlfsrN1jg" OperationName="CalcoloOLOAccorpante">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="CalcoloOLOAccorpantePortTypeSOAP" ServiceName="CalcoloOLOAccorpantePortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="CalcoloOLOAccorpante_gen1.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="CalcoloOLOAccorpantePortType" OperationName="CalcoloOLOAccorpante">
                  <xpdExt:ExternalReference location="CalcoloOLOAccorpante_gen1.wsdl"/>
                </xpdExt:PortTypeOperation>
              </xpdl2:TaskService>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:Performers>
            <xpdl2:Performer>_uPPpxQwrEeiuHqlfsrN1jg</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="77.0" LaneId="_-7lV7eLuEeaoOL-mvUhWhw" Width="111.0">
              <xpdl2:Coordinates XCoordinate="615.0" YCoordinate="483.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">CalcolaOLOAccorpanteInput = com_tim_NOW_xsd_CaclcoloOLOAccorpante_Factory.createCalcoloOLOAccorpanteInputType();&#xD;
CalcolaOLOAccorpanteInput.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
CalcolaOLOAccorpanteInput.calcoloOLOIn = com_tim_NOW_xsd_CaclcoloOLOAccorpante_Factory.createCalcoloOLOAccorpante();&#xD;
&#xD;
if(ConsistenzaFonia!=null &amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating!=null &amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating!= &quot;&quot;){&#xD;
	CalcolaOLOAccorpanteInput.calcoloOLOIn.CODFC_OLO_AGCOM.add(ConsistenzaFonia.codificaOLOAGCOMDonating);&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">&#xD;
&#xD;
if(ConsistenzaFonia!=null &amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating!= null &amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating!=&quot;&quot;){&#xD;
	var i=0;&#xD;
	var trovato=false;&#xD;
	while(!trovato &amp;&amp; i&lt;CalcolaOLOAccorpanteOutput.calcoloOLOOut.size())&#xD;
	{&#xD;
		var OLOAccorpante = CalcolaOLOAccorpanteOutput.calcoloOLOOut.get(i);&#xD;
		if(ConsistenzaFonia.codificaOLOAGCOMDonating == OLOAccorpante.COD_OLO_AGCOM){&#xD;
			ConsistenzaFonia.codificaOLOAGCOMDonating = OLOAccorpante.COD_OLO_ACCORPANTE;&#xD;
			trovato = true;&#xD;
		}&#xD;
		i++;	&#xD;
	}&#xD;
	&#xD;
	if (localRequest.codificaOLOAGCOM == ConsistenzaFonia.codificaOLOAGCOMDonating ||&#xD;
		(localRequest.codificaOLOAGCOM == 'WIN' &amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating == 'INF' ))&#xD;
	{&#xD;
		CodiceEsito='KO_01';&#xD;
	}&#xD;
	&#xD;
	else&#xD;
	{&#xD;
		CodiceEsito='KO_02';	&#xD;
	}&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
