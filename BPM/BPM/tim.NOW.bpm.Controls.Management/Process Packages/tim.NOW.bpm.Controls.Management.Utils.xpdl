    <xpdl2:Artifact Id="_ep6I4g_aEeyv0vptZh267A" ArtifactType="Annotation" TextAnnotation="In caso di Lavorazione = ATTIVAZIONE e Sottolavorazione = ATTIVAZIONE274, se non sono presenti né DAC né DAC RIMODULATA allora la DAC deve essere impostata al valore DRO + 3 gg lavorativi. La logica deve essere applicata quando in consistenza è presente un servizio dati condiviso appartenente a TIM Retail (con il filtro su ATTIVAZIONE e sottolav ATTIVAZIONE274 copriamo tutti i casi, perchè sono richieste di Attivazione di un condiviso per cui viene ricalcolata la sottolavorazione da NORMALE ad ATTIVAZIONE274 per presenza di un servizio tim in consistenza). Paragrafo delle SF di riferimento: C01M02F03 – Crea-Aggiorna Case Richiesta.&#xD;&#xA;">
      <xpdl2:NodeGraphicsInfos>
        <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" Height="329.0" LaneId="_EaYg4eLvEeaoOL-mvUhWhw" Width="565.0">
          <xpdl2:Coordinates XCoordinate="2310.0" YCoordinate="544.0"/>
        </xpdl2:NodeGraphicsInfo>
      </xpdl2:NodeGraphicsInfos>
    </xpdl2:Artifact>
