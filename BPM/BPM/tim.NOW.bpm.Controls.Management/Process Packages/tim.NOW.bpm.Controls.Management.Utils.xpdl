            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_2Y1K_erUEeWg_qPSKmWaWg"/>
          </xpdl2:DataType>
        </xpdl2:FormalParameter>
        <xpdl2:FormalParameter Id="_eAHPYZkcEeqCA4JgoJw_Bg" Name="EsitoResponse" ReadOnly="false" Mode="OUT" Required="false" xpdExt:DisplayName="EsitoResponse">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="com.tim.NOW.xsd.ControlliAmmessi.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.ControlliAmmessiEsitoType"/>
          </xpdl2:DataType>
        </xpdl2:FormalParameter>
        <xpdl2:FormalParameter Id="_c3RCsJtmEeqx6_acRk-1Yg" Name="NumerazioniScartate" IsArray="true" ReadOnly="false" Mode="OUT" Required="false" xpdExt:DisplayName="NumerazioniScartate">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
        </xpdl2:FormalParameter>
      </xpdl2:FormalParameters>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_aSdOuZkYEeqCA4JgoJw_Bg" xpdExt:DisplayName="AssetNP" Name="AssetNP">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_aSdOvZkYEeqCA4JgoJw_Bg" xpdExt:DisplayName="AssetRecuperati" Name="AssetRecuperati" IsArray="true">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_aSdOvpkYEeqCA4JgoJw_Bg" xpdExt:DisplayName="AssetRecuperatiRef" Name="AssetRecuperatiRef" IsArray="true">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_aSdOv5kYEeqCA4JgoJw_Bg" xpdExt:DisplayName="AssetNPRef" Name="AssetNPRef">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_7wVTuZkYEeqCA4JgoJw_Bg" xpdExt:DisplayName="subprocessIdentifier" Name="subprocessIdentifier">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>500</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_3iZBsJkaEeqCA4JgoJw_Bg" xpdExt:DisplayName="Numerazioni" Name="Numerazioni" IsArray="true" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_M2VAwpkYEeqCA4JgoJw_Bg" Name="StartEvent" xpdExt:DisplayName="Start Event">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="27.0" LaneId="_M2VAwZkYEeqCA4JgoJw_Bg" Width="27.0">
              <xpdl2:Coordinates XCoordinate="55.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_M2VAw5kYEeqCA4JgoJw_Bg" Name="EndEvent" xpdExt:DisplayName="End Event">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_M2VAwZkYEeqCA4JgoJw_Bg" Width="67.0">
              <xpdl2:Coordinates XCoordinate="1084.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_aSdOsJkYEeqCA4JgoJw_Bg" Name="IdentificaservizioinconsistenzaperNPDel82" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Identifica servizio in consistenza per NP Del 82">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Identifica servizio in consistenza NP per Del 82 superato&quot;;&#xD;
&#xD;
if(localRequest!= null &amp;&amp; localRequest.ordine!=null)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)  &#xD;
		{&#xD;
			for(var k=0; k&lt;componente.attributiDettaglioOrdine.size(); k++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(k);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					Numerazioni.add(attr.valoreAttributo);&#xD;
					Process.auditLog(&quot;Trovata numerazione &quot;+attr.valoreAttributo);&#xD;
				}&#xD;
			}		&#xD;
		}		&#xD;
	}&#xD;
}&#xD;
&#xD;
if(Numerazioni != null &amp;&amp; Numerazioni.size()>0)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(i&lt;Numerazioni.size())&#xD;
	{&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa = :IDR AND statoAsset IN ('ATTIVO','INLAVORAZIONE') AND offerta = 'NP'&quot;);     //SM_11380 - aggiunto INLAVORAZIONE&#xD;
		c.setQueryParameter(&quot;IDR&quot;,Numerazioni.get(i));&#xD;
		var assetList = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		&#xD;
		if(assetList.size() == 0)&#xD;
		{&#xD;
			/*EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Asset NP con numerazione &quot;+Numerazioni.get(i)+&quot; non trovato&quot;;*/&#xD;
			NumerazioniScartate.add(Numerazioni.get(i));&#xD;
			Process.auditLog(&quot;Scartata la numerazione per assenza di asset NP: &quot; +Numerazioni.get(i));&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			AssetNPRef = assetList.get(0);&#xD;
			AssetNP = AssetNPRef.readAsset();&#xD;
			&#xD;
			//SM_11380 - se l'asset è INLAVORAZIONE vado in scarto&#xD;
			if(AssetNP.statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Trovato asset con statoAsset INLAVORAZIONE&quot;;&#xD;
				NumerazioniScartate.add(Numerazioni.get(i));	&#xD;
			}&#xD;
			else //Entra qua se statoAsset = ATTIVO e controllo se è un BUNDLE&#xD;
			{			&#xD;
				var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa = :IDR AND numeroTelefonico =: num AND statoAsset = 'ATTIVO' AND offerta IN ('ULLLINEAATTIVANP','ULLDATILINEAATTIVANP', 'SLULINEAATTIVANP')&quot;);&#xD;
				c.setQueryParameter(&quot;IDR&quot;,Numerazioni.get(i));&#xD;
				c.setQueryParameter(&quot;num&quot;,Numerazioni.get(i));&#xD;
				var assetList = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
				&#xD;
				//SM_11380 - se è un BUNDLE vado in scarto&#xD;
				if(assetList.size() > 0)&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;Asset NP con numerazione &quot;+Numerazioni.get(i)+&quot; fa parte di un BUNDLE&quot;;&#xD;
					NumerazioniScartate.add(Numerazioni.get(i));&#xD;
					Process.auditLog(&quot;Scartata la numerazione poichè Bundle: &quot; +Numerazioni.get(i));&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					AssetRecuperati.add(AssetNP);&#xD;
					AssetRecuperatiRef.add(AssetNPRef);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		i++;&#xD;
	}		&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Nessuna numerazione recuperata&quot;;&#xD;
	NumerazioniScartate.addAll(Numerazioni);	&#xD;
}&#xD;
&#xD;
//RU_1463&#xD;
if(EsitoResponse.codice &amp;&amp; Numerazioni != null &amp;&amp; Numerazioni.size() > 0)&#xD;
{&#xD;
	//Abbiamo scartato tutte le numerazioni quindi per ciascun DN non c'è l'asset NP &#xD;
	if(NumerazioniScartate != null &amp;&amp; NumerazioniScartate.size()>0 &amp;&amp; Numerazioni.size() == NumerazioniScartate.size())&#xD;
	{&#xD;
		//RU_1554&#xD;
		if(localRequest.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Controllo non superato - la codificaOLOAGCOM è TLC&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Controllo superato - siamo nel caso di PRIMAPORTABILITADEL82&quot;;&#xD;
		}&#xD;
	}&#xD;
	//Nessuna numerazione scartata - per ciascuna è stato trovato un asset NP (non INLAVORAZIONE e non BUNDLE)&#xD;
	else if(NumerazioniScartate == null || NumerazioniScartate.size() == 0)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Controllo superato - siamo nel caso di PORTABILITASUCCESSIVADEL82&quot;;&#xD;
	}&#xD;
	//Soluzione mista - Alcune NP hanno asset, altri no&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Soluzione mista - alcune NP sono in consistenza e altre no&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);&#xD;
&#xD;
//Inizio creazione NumberPortability ----------------------------------------------------------------------------&#xD;
if(EsitoResponse.codice &amp;&amp; AssetRecuperati != null &amp;&amp; AssetRecuperati.size()>0)&#xD;
{&#xD;
	for(var z = 0; z&lt;AssetRecuperati.size(); z++)&#xD;
	{&#xD;
		AssetNP = AssetRecuperati.get(z);&#xD;
		&#xD;
		//CODICEOPERATOREDONOR&#xD;
		var CODICEOPERATOREDONOR = &quot;&quot;;&#xD;
		CODICEOPERATOREDONOR=null;&#xD;
		&#xD;
		//TIPOLINEANP&#xD;
		var TIPOLINEANP = &quot;&quot;;&#xD;
		TIPOLINEANP =null;&#xD;
		&#xD;
		//ROUTINGNUMBER&#xD;
		var ROUTINGNUMBER = &quot;&quot;;&#xD;
		ROUTINGNUMBER=null;&#xD;
		&#xD;
		//AGGIUNTIVOWLR&#xD;
		var AGGIUNTIVOWLR = &quot;&quot;;&#xD;
		AGGIUNTIVOWLR = null;&#xD;
		&#xD;
		//NUMEROTELEFONICO&#xD;
		var NUMEROTELEFONICO = &quot;&quot;;&#xD;
		NUMEROTELEFONICO = null;&#xD;
		&#xD;
		//NUMEROTELEFONICOPRINCIPALE&#xD;
		var NUMEROTELEFONICOPRINCIPALE =&quot;&quot;;&#xD;
		NUMEROTELEFONICOPRINCIPALE = null;&#xD;
		&#xD;
		//CODICEOPERATOREDONATING&#xD;
		var CODICEOPERATOREDONATING = &quot;&quot;;&#xD;
		CODICEOPERATOREDONATING = null;&#xD;
		&#xD;
		// CODICEOPERATORERECIPIENT&#xD;
		var CODICEOPERATORERECIPIENT =&quot;&quot;;&#xD;
		CODICEOPERATORERECIPIENT = null;&#xD;
		&#xD;
		//OLORETAILER&#xD;
		var OLORETAILER = &quot;&quot;;&#xD;
		OLORETAILER = null;&#xD;
		&#xD;
		//CODICEPIATTAFORMA&#xD;
		var CODICEPIATTAFORMA = &quot;&quot;;&#xD;
		CODICEPIATTAFORMA = null;&#xD;
		&#xD;
		//TIPOSERVIZIO&#xD;
		var TIPOSERVIZIO = &quot;&quot;;&#xD;
		TIPOSERVIZIO = null;&#xD;
		&#xD;
		//TIPONUMERO&#xD;
		var TIPONUMERO = &quot;&quot;;&#xD;
		TIPONUMERO = null;&#xD;
		&#xD;
		CODICEOPERATOREDONATING = AssetNP.codificaOLOAGCOM;&#xD;
		&#xD;
		var i = 0;&#xD;
		while(i&lt;AssetNP.dettaglioasset.size())&#xD;
		{&#xD;
			var compTemp = AssetNP.dettaglioasset.get(i);&#xD;
			&#xD;
			if(compTemp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
				&#xD;
				for(var j=0; j&lt;compTemp.attributidettaglioasset.size(); j++){&#xD;
					var attrTemp = compTemp.attributidettaglioasset.get(j);&#xD;
&#xD;
					//CODICEOPERATOREDONOR&#xD;
					if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR){&#xD;
						CODICEOPERATOREDONOR = attrTemp.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					//TIPOLINEANP&#xD;
					else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEANP){&#xD;
						TIPOLINEANP = attrTemp.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					//ROUTINGNUMBER&#xD;
					else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER){&#xD;
						ROUTINGNUMBER = attrTemp.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					//AGGIUNTIVOWLR&#xD;
					else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AGGIUNTIVOWLR){&#xD;
						AGGIUNTIVOWLR = attrTemp.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					//NUMEROTELEFONICO&#xD;
					else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO){&#xD;
						NUMEROTELEFONICO = attrTemp.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					//NUMEROTELEFONICOPRINCIPALE&#xD;
					else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE){&#xD;
						NUMEROTELEFONICOPRINCIPALE = attrTemp.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					//CODICEOPERATORERECIPIENT&#xD;
					else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATORERECIPIENT){&#xD;
						CODICEOPERATORERECIPIENT = attrTemp.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					//OLORETAILER&#xD;
					else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER){&#xD;
						OLORETAILER = attrTemp.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					//CODICEPIATTAFORMA&#xD;
					else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA){&#xD;
						CODICEPIATTAFORMA = attrTemp.valoreAttributo;&#xD;
					}&#xD;
					//TIPOSERVIZIO&#xD;
					else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO){&#xD;
						TIPOSERVIZIO = attrTemp.valoreAttributo;&#xD;
					}&#xD;
					//TIPONUMERO&#xD;
					else if(attrTemp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO){&#xD;
						TIPONUMERO = attrTemp.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		var NP = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createNumberPortabilityType();&#xD;
		NP.invioaDTU = &quot;N&quot;;&#xD;
		NP.codiceOperatoreDonor = CODICEOPERATOREDONOR;&#xD;
		NP.codiceOrdineTI = AssetNP.codiceOrdineTI;&#xD;
		NP.tipoLineaNP = TIPOLINEANP;&#xD;
		NP.routingNumber = ROUTINGNUMBER;&#xD;
		NP.numeroTelefonico = NUMEROTELEFONICO;&#xD;
		NP.numeroTelefonicoPrincipale = NUMEROTELEFONICOPRINCIPALE;&#xD;
		NP.codiceOperatoreDonating = CODICEOPERATOREDONATING;&#xD;
		NP.codiceOperatoreRecipient = CODICEOPERATORERECIPIENT;&#xD;
		NP.OLORetailer = OLORETAILER;&#xD;
		NP.codicePiattaforma = CODICEPIATTAFORMA;&#xD;
		NP.IDAsset = AssetNP.IDAsset;&#xD;
		NP.tipoServizio = TIPOSERVIZIO;&#xD;
		NP.tipoNumero = TIPONUMERO;&#xD;
		&#xD;
		NP.assetBTWhiteList = AssetNP.assetBTWhiteList; //R1E-21-0325&#xD;
		&#xD;
		NumberPortability.add(ScriptUtil.copy(NP));&#xD;
	}&#xD;
}&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="128.0" LaneId="_M2VAwZkYEeqCA4JgoJw_Bg" Width="223.0">
              <xpdl2:Coordinates XCoordinate="342.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_7wVTuJkYEeqCA4JgoJw_Bg" Name="DatiVerificaControlli" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Dati Verifica Controlli">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_Aa1wkMIeEeaIJ-AnJ3AotA" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="subprocessIdentifier" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="false">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="Azione">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;INSERT&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="IDRichiestaOLO">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="Operatore">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.operatore</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="NumberPortability">
                  <xpdl2:Actual ScriptGrammar="JavaScript">NumberPortability</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:Priority></xpdl2:Priority>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="104.0" LaneId="_M2VAwZkYEeqCA4JgoJw_Bg" Width="187.0">
              <xpdl2:Coordinates XCoordinate="754.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">subprocessIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.utils.xpdl.DatiVerificaControlliStorico&quot;;&#xD;
&#xD;
if(NumberPortability != null &amp;&amp; NumberPortability.size() > 0){&#xD;
	Process.auditLog(&quot;NumberPortability trovata&quot;);&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
