        <xpdl2:Activity Id="_rf6IAYFoEeadKbLiJN36tQ" Name="RequestTypeforTESTDATA" xpdExt:Visibility="Private" xpdExt:DisplayName="RequestType for TESTDATA">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Testata = com_tim_NOW_xsd_SendDTU_Factory.createTestata();&#xD;
&#xD;
var lavorazione = &quot;&quot;;&#xD;
if(AltreLavorazioni != null &amp;&amp; AltreLavorazioni != 'RIMUOVIRDACAUTOMATICA') // SM_8667: pezza, quando arriva la RIMUOVIRDAC sulla master (cautelare RU_813) non deve inviare questa lavorazione&#xD;
{&#xD;
	lavorazione = AltreLavorazioni;&#xD;
}&#xD;
else&#xD;
{&#xD;
	lavorazione = String(localRequest.lavorazione);&#xD;
}&#xD;
&#xD;
//RU_1550 - MIG DEL82&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.sbloccoDTU == &quot;SI&quot;&#xD;
   &amp;&amp; localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CODICESESSIONEOKD82)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.SBLOCCO;&#xD;
}&#xD;
//SM_11702 - SM_11744 - MIG DEL82&#xD;
else if(localRequest.ordine != null &amp;&amp; localRequest.ordine.sbloccoDTU == &quot;SI&quot;&#xD;
   &amp;&amp; localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDELIVERYD82)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.ANNULLAMENTO;&#xD;
}&#xD;
//RU_1450: SECONDA EMISSIONE A DTU POST INTERAZIONE CON OF - RICHIESTE FIBERSTREAM&#xD;
else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FIBERSTREAM&#xD;
   &amp;&amp; SecondaEmissioneDTUpostOF &#xD;
   &amp;&amp; (lavorazione == &quot;ATTIVAZIONE&quot; &#xD;
       || (lavorazione == &quot;MIGRAZIONE&quot; &amp;&amp; localRequest.flagRientriDel82 == &quot;SI&quot;)))   //RIENTRI DEL82 - C01 2026 - Riutilizzata logica per seconda emissione verso DTU nel caso delle MIG RIENTRI DEL82&#xD;
{&#xD;
	if(localRequest.statoRichiestaOF == it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.NRDEFINITIVO&#xD;
	   ||localRequest.statoRichiestaOF == it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.ESPLETATOKO&#xD;
	   ||localRequest.statoRichiestaOF == it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.ANNULLATOOF)&#xD;
	{&#xD;
		Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.ANNULLAMENTO;&#xD;
	}&#xD;
	else if(localRequest.statoRichiestaOF == it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.ESPLETATOOK)&#xD;
	{&#xD;
		Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.ATTIVATOOK;&#xD;
	}&#xD;
}&#xD;
&#xD;
//INVIO EVENTI A DTU MENTRE STIAMO RICEVENDO EVENTI DA OF&#xD;
&#xD;
//SM_11821: C35M02F02 (Evento di Acquisizione da OF) -> invio C05M01F20 (richiesta di Acquisito OK a DTU)&#xD;
else if(lavorazione == &quot;ATTIVAZIONE&quot; &#xD;
   &amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FIBERSTREAM&#xD;
   &amp;&amp; localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOINGAGGIOOF&#xD;
   &amp;&amp; localRequest.statoRichiestaOF == it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.ACQUISITOOK)&#xD;
{&#xD;
   Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.ACQUISITOOK;&#xD;
}&#xD;
&#xD;
//MIG RIENTRI DEL82 - C01 2026&#xD;
else if(lavorazione == &quot;MIGRAZIONE&quot; &amp;&amp; localRequest.flagRientriDel82 == &quot;SI&quot;&#xD;
   &amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FIBERSTREAM&#xD;
   &amp;&amp; localRequest.statoRichiestaOF == it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.ACQUISITOOK)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.ACQUISITOOK;&#xD;
}&#xD;
else if(lavorazione == &quot;MIGRAZIONE&quot; &amp;&amp; localRequest.flagRientriDel82 == &quot;SI&quot;&#xD;
   &amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FIBERSTREAM&#xD;
   &amp;&amp; localRequest.statoRichiestaOF == it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.ACCETTATOOK)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.ACCETTATO;&#xD;
}&#xD;
&#xD;
// GESTIONE POST NOTIFICHE FLASH FIBER&#xD;
// RU_690 - Verifica se è una notifica da inviare in seguito alla ricezione di notifica FF&#xD;
else if(DettOrdineFF != null &amp;&amp; DettOrdineFF.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.FFOL)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.NOTIFICAOLFF;&#xD;
}&#xD;
else if(DettOrdineFF != null &amp;&amp; DettOrdineFF.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.FFDESOSPESO)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.DESOSPENSIONE;&#xD;
}&#xD;
else if(DettOrdineFF != null &amp;&amp; DettOrdineFF.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.FFCHIUSO)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.ANNULLAMENTO;&#xD;
}&#xD;
else if(DettOrdineFF != null &#xD;
	&amp;&amp; (DettOrdineFF.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.FFRIFIUTOACQUISITO &#xD;
	 || DettOrdineFF.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.FFACQUISITO)) // Aggiunto con SM_8583&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.NOTIFICAAQFF; // RU_821 - aggiunto&#xD;
}&#xD;
&#xD;
// GESTIONE CLASSICA&#xD;
else if(lavorazione == &quot;ATTIVAZIONE&quot; ||&#xD;
   lavorazione == &quot;VARIAZIONE&quot; ||&#xD;
   lavorazione == &quot;CESSAZIONE&quot; ||&#xD;
   lavorazione == &quot;MIGRAZIONE&quot; ||&#xD;
   lavorazione == &quot;EMISSIONE&quot; ||&#xD;
   lavorazione == &quot;ACCENSIONE&quot; ||&#xD;
   lavorazione == &quot;SPEGNIMENTO&quot; ||&#xD;
   lavorazione == &quot;RIMODULAZIONEDACPREDELIVERY&quot;)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.EMISSIONE;&#xD;
}&#xD;
else if(lavorazione == &quot;RIMODULAZIONEDAD&quot;)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.RIMODULAZIONEDAD;&#xD;
}&#xD;
else if(lavorazione == &quot;ANNULLAMENTO&quot;&#xD;
		|| lavorazione == &quot;INTERRUZIONEMIGRAZIONE&quot;&#xD;
		|| lavorazione == &quot;RICHIESTAINTERRUZIONERECIPIENT&quot;&#xD;
		|| lavorazione == &quot;ACCETTAZIONEPREVENTIVOKO&quot;&#xD;
		|| lavorazione == &quot;ANNULLAMENTORECIPIENT&quot; //SM_10995&#xD;
		|| lavorazione == &quot;ANNULLAMENTO_FBS_DA_OLO&quot; //RU_1451&#xD;
		|| lavorazione == &quot;ConfermaScarto_C11M08F103&quot;) //RU_1492&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.ANNULLAMENTO;&#xD;
}&#xD;
else if(lavorazione == &quot;CANCELLAZIONEACCODAMENTO&quot;)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.CANCELLAZIONEACCODAMENTO;&#xD;
}&#xD;
else if(lavorazione == &quot;INTERRUZIONESOSPENSIONE&quot;)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.DESOSPENSIONE;&#xD;
}&#xD;
else if(lavorazione == &quot;RIMODULAZIONEDAC&quot;)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.RIMODULAZIONEDAC;&#xD;
}&#xD;
else if(lavorazione == &quot;RICHIESTAPREVENTIVO&quot;)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.RICHIESTAPREVENTIVO;&#xD;
}&#xD;
else if(lavorazione == &quot;ACCETTAZIONEPREVENTIVO&quot;)&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.ACCETTAZIONEPREVENTIVO;&#xD;
}&#xD;
//RU_1558&#xD;
else if(lavorazione == &quot;Desospensione_ACCETTATO&quot;&#xD;
        || lavorazione == &quot;RimodulazioneDAC_ACCETTATO&quot;&#xD;
        || lavorazione == &quot;AccettatoVsDTU&quot;) //SM_11804 - post NIPRESAAPPUNTAMENTO&#xD;
{&#xD;
	Testata.requestType = com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoRichiestaType.ACCETTATO;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_rf6H-YFoEeadKbLiJN36tQ" Width="140.0">
              <xpdl2:Coordinates XCoordinate="187.0" YCoordinate="154.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit/>
          <xpdExt:AssociatedParameters DisableImplicitAssociation="false"/>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_rf6IAoFoEeadKbLiJN36tQ" Name="RichiestatoXSD" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Richiesta to XSD">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_LnnqioAREeaImvbI8Xw6Gw" PackageRef="tim.NOW.bpm.invokeExternalService.utils" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="OUT" Formal="RichiestaXSD">
                  <xpdl2:Actual ScriptGrammar="JavaScript">RichiestaXSD</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="RichiestaBOM">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_rf6H-YFoEeadKbLiJN36tQ" Width="128.0">
              <xpdl2:Coordinates XCoordinate="366.0" YCoordinate="154.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_U2RWoIFqEeaG-Y7D3-yA8Q" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_MvOzgIFpEeadKbLiJN36tQ" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="52.0" LaneId="_rf6H-YFoEeadKbLiJN36tQ" Width="73.0">
              <xpdl2:Coordinates XCoordinate="43.0" YCoordinate="154.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
      </xpdl2:Activities>
      <xpdl2:Transitions>
        <xpdl2:Transition Id="_rf6IA4FoEeadKbLiJN36tQ" xpdExt:DisplayName="" From="_rf6IAoFoEeadKbLiJN36tQ" To="_rf6H_YFoEeadKbLiJN36tQ">
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.EndAnchorPosition"/>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.StartAnchorPosition"/>
          </xpdl2:ConnectorGraphicsInfos>
        </xpdl2:Transition>
        <xpdl2:Transition Id="_rf6IBIFoEeadKbLiJN36tQ" xpdExt:DisplayName="" Name="" From="_rf6H_YFoEeadKbLiJN36tQ" To="_rf6H_IFoEeadKbLiJN36tQ">
