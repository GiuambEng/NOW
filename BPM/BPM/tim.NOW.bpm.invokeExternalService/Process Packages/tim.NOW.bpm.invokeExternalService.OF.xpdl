        <xpdl2:Activity Id="_m-X7GsTWEe6uaO1lKvj96Q" Name="RequestTypeforTESTDATA" xpdExt:Visibility="Private" xpdExt:DisplayName="RequestType for TESTDATA">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Testata = com_tim_NOW_xsd_SendFBS_Factory.createTestata();&#xD;
&#xD;
var lavorazione = &quot;&quot;;&#xD;
&#xD;
if(AltreLavorazioniOF != null)&#xD;
{&#xD;
	lavorazione = AltreLavorazioniOF;&#xD;
}&#xD;
else&#xD;
{&#xD;
	lavorazione = String(localRequest.lavorazione);&#xD;
}&#xD;
&#xD;
//RU_1450&#xD;
//C35M01F01&#xD;
if(lavorazione == &quot;ATTIVAZIONE&quot;&#xD;
   || lavorazione == &quot;MIGRAZIONE&quot;)   //RIENTRI DEL82 - C01 2026&#xD;
{&#xD;
	Testata.requestType = &quot;EMISSIONEOF&quot;;&#xD;
	TipoEmissione = &quot;EMISSIONEOF&quot;;&#xD;
}&#xD;
//C35M01F02&#xD;
else if(lavorazione == &quot;ANNULLAMENTO&quot;)&#xD;
{&#xD;
	Testata.requestType = &quot;ANNULLAMENTO_AUTO_OF&quot;;&#xD;
	TipoEmissione = &quot;ANNULLAMENTO_AUTO_OF&quot;;&#xD;
}&#xD;
//RU_1451 &#xD;
//C35M01F03&#xD;
else if(lavorazione == &quot;CESSAZIONE&quot;)&#xD;
{&#xD;
	Testata.requestType = &quot;CESSAZIONE_OF&quot;;&#xD;
	TipoEmissione = &quot;CESSAZIONE_OF&quot;;&#xD;
}&#xD;
//&#xD;
else if(lavorazione == &quot;RIMODULAZIONEDAD&quot;)&#xD;
{&#xD;
	Testata.requestType = &quot;RDAD_OF&quot;;&#xD;
	TipoEmissione = &quot;RDAD_OF&quot;;&#xD;
}&#xD;
//C35M01F05&#xD;
else if(lavorazione == &quot;ANNULLAMENTO_FBS_DA_OLO&quot;)&#xD;
{&#xD;
	Testata.requestType = &quot;ANNULLAMENTO_OF&quot;;&#xD;
	TipoEmissione = &quot;ANNULLAMENTO_OF&quot;;&#xD;
}&#xD;
//C35M01F06&#xD;
else if(lavorazione == &quot;INTERRUZIONESOSPENSIONE&quot;)&#xD;
{&#xD;
	Testata.requestType = &quot;DESOSPENSIONE_OF&quot;;&#xD;
	TipoEmissione = &quot;DESOSPENSIONE_OF&quot;;&#xD;
}&#xD;
//C35M01F12 - RIENTRI DEL82 - C01 2026&#xD;
else if(lavorazione == &quot;RIMODULAZIONEDAC&quot;)&#xD;
{&#xD;
	Testata.requestType = &quot;RDAC_OF_OLO&quot;;&#xD;
	TipoEmissione = &quot;RDAC_OF_OLO&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_S4KayMTWEe6uaO1lKvj96Q" Width="140.0">
