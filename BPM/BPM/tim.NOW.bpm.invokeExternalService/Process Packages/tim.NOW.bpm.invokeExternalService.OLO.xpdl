        </xpdl2:Transition>
        <xpdl2:Transition Id="_1j08gYFrEeaG-Y7D3-yA8Q" Name="" From="_ombNcV0pEeqEfdvB03aFbw" To="_w_nnC4FqEeaG-Y7D3-yA8Q">
          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">// RU_965 - tutte le notifiche sono da saltare per ACCORPAMENTOOLO&#xD;
//Condition pre-SM esercizio dove non mandavamo notifiche per le altre lavorazioni: localRequest.ordine != null &amp;&amp; localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO;&#xD;
(localRequest.ordine == null &#xD;
  || (localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO&#xD;
&amp;&amp;localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOOLO))  //RU_1203: aggiunta CAMBIOOLO&#xD;
//RU_1180 (Task #34913): non vanno inviate notifiche a OAO per queste offerte&#xD;
&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT    &#xD;
&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE&#xD;
&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER&#xD;
&amp;&amp; !(localRequest.ordine != null&#xD;
&amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONEPARENTALCONTROL&#xD;
&amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.GUI);</xpdl2:Expression></xpdl2:Condition>
          <xpdl2:ConnectorGraphicsInfos>
