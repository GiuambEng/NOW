          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">NotificationRequest = com_tim_NOW_xsd_NotificationManager_Factory.createNotificationRequestType();&#xD;
&#xD;
NotificationRequest.richiestaElement = RichiestaXSD;&#xD;
NotificationRequest.tipologiaNotifica = TipologiaNotifica;&#xD;
&#xD;
if(IDAssetConsistenza != null &amp;&amp; IDAssetConsistenza != &quot;NULL&quot;)&#xD;
{&#xD;
	NotificationRequest.IDAssetConsistenza = ScriptUtil.createBigInteger(IDAssetConsistenza);&#xD;
}&#xD;
&#xD;
if(tipologiaOLODestinatario == &quot;DONATING&quot;){&#xD;
	if(CodificaOLOAGCOM != null &amp;&amp; CodificaOLOAGCOM != &quot;&quot;){&#xD;
		NotificationRequest.codificaOLOAGCOMDestinatario = CodificaOLOAGCOM;&#xD;
	}&#xD;
	else{&#xD;
		NotificationRequest.codificaOLOAGCOMDestinatario = localRequest.codificaOLOAGCOMDonating;&#xD;
		NotificationRequest.codificaOLONOWDestinatario = localRequest.codificaOLONOWDonating;&#xD;
	}&#xD;
	NotificationRequest.tipologiaOLODestinatario = com_tim_NOW_xsd_NotificationManager_TipologiaOLODestinatarioType.DONATING;&#xD;
} else if(tipologiaOLODestinatario == &quot;DONOR&quot;){&#xD;
	if(CodificaOLOAGCOM != null &amp;&amp; CodificaOLOAGCOM != &quot;&quot;){&#xD;
		NotificationRequest.codificaOLOAGCOMDestinatario = CodificaOLOAGCOM;&#xD;
	}&#xD;
	else{	&#xD;
		NotificationRequest.codificaOLOAGCOMDestinatario = localRequest.codificaOLOAGCOMDonor;&#xD;
		NotificationRequest.codificaOLONOWDestinatario = localRequest.codificaOLONOWDonor;&#xD;
	}&#xD;
	NotificationRequest.tipologiaOLODestinatario = com_tim_NOW_xsd_NotificationManager_TipologiaOLODestinatarioType.DONOR;&#xD;
} else if(tipologiaOLODestinatario == &quot;RECIPIENT&quot;){&#xD;
	if(CodificaOLOAGCOM != null &amp;&amp; CodificaOLOAGCOM != &quot;&quot;){&#xD;
		NotificationRequest.codificaOLOAGCOMDestinatario = CodificaOLOAGCOM;&#xD;
	}&#xD;
	else{&#xD;
		NotificationRequest.codificaOLOAGCOMDestinatario = localRequest.codificaOLOAGCOMRic;&#xD;
		NotificationRequest.codificaOLONOWDestinatario = localRequest.codificaOLONOW;&#xD;
	}&#xD;
	NotificationRequest.tipologiaOLODestinatario = com_tim_NOW_xsd_NotificationManager_TipologiaOLODestinatarioType.RECIPIENT;&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
if(IDEventoOrdineNOW!= null){&#xD;
	NotificationRequest.IDEventoOrdineNOW = IDEventoOrdineNOW;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">// in occasione della RU_965: spostato gateway+script nel complete script&#xD;
if(IDNotifica != null)&#xD;
{&#xD;
	IdNotificaUpdated='Y';&#xD;
&#xD;
	if(tipologiaOLODestinatario == &quot;DONATING&quot;){&#xD;
		localRequest.IDNotificaDonating = IDNotifica;&#xD;
	}&#xD;
	else if(tipologiaOLODestinatario==&quot;DONOR&quot;){&#xD;
		localRequest.IDNotificaDonor = IDNotifica;&#xD;
	}&#xD;
	else{&#xD;
		localRequest.IDNotifica = IDNotifica;&#xD;
	}&#xD;
}&#xD;
&#xD;
//SM_10668&#xD;
Process.auditLog(&quot;Valore di AnagraficaCausaleGUI restituito: &quot;+ IDAnagraficaCausaleGUI);&#xD;
&#xD;
if(IDAnagraficaCausaleGUI != null)&#xD;
{&#xD;
	localRequest.IDAnagraficaCausaleGUI = IDAnagraficaCausaleGUI;&#xD;
	&#xD;
}&#xD;
else &#xD;
{&#xD;
	localRequest.IDAnagraficaCausaleGUI = null;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
