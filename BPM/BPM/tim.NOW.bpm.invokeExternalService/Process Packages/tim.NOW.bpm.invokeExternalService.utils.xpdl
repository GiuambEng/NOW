        <xpdl2:Activity Id="_LnnqjYAREeaImvbI8Xw6Gw" Name="Convertitore" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Convertitore" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(RichiestaBOM != null){&#xD;
	var serialized = ScriptUtil.toXML(RichiestaBOM);&#xD;
	serialized = serialized.replace(&quot;http://NOW.it.telecomitalia.it/casedata&quot;,&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot;);&#xD;
	RichiestaXSD = ScriptUtil.fromXML(serialized);&#xD;
} else {&#xD;
	RichiestaXSD = null;&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_Lnnqk4AREeaImvbI8Xw6Gw" Width="96.0">
              <xpdl2:Coordinates XCoordinate="264.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
      </xpdl2:Activities>
