    <xpdl2:WorkflowProcess Id="_I8C_XYF1Eea1BcUITTCQOA" xpdExt:DisplayName="TIMNOW-RecuperaAssetTarget" Name="TIMNOWRecuperaAssetTarget">
      <xpdl2:ProcessHeader/>
      <xpdl2:FormalParameters>
        <xpdl2:FormalParameter Id="_I8C_Y4F1Eea1BcUITTCQOA" Name="Ref" Mode="OUT" Required="false" xpdExt:DisplayName="Ref">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
        </xpdl2:FormalParameter>
        <xpdl2:FormalParameter Id="_I8C_ZIF1Eea1BcUITTCQOA" Name="localRequest" Mode="IN" Required="true" xpdExt:DisplayName="localRequest">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_2Y1K_erUEeWg_qPSKmWaWg"/>
          </xpdl2:DataType>
        </xpdl2:FormalParameter>
        <xpdl2:FormalParameter Id="_I8C_ZYF1Eea1BcUITTCQOA" Name="action" Mode="IN" Required="true" xpdExt:DisplayName="action">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
        </xpdl2:FormalParameter>
      </xpdl2:FormalParameters>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_I8C_XoF1Eea1BcUITTCQOA" Name="Start" xpdExt:Visibility="Private" xpdExt:DisplayName="Start">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="27.0" LaneId="_I8C_XIF1Eea1BcUITTCQOA" Width="27.0">
              <xpdl2:Coordinates XCoordinate="53.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_I8C_X4F1Eea1BcUITTCQOA" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_I8C_XIF1Eea1BcUITTCQOA" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_I8C_YIF1Eea1BcUITTCQOA" Name="RecuperaAssetTarget" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="RecuperaAssetTarget">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">/*if(localRequest.IDRisorsa != null)&#xD;
{&#xD;
	if(action == &quot;LOCK&quot;)&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa=:SearchIDRisorsa AND statoAsset='ATTIVO'&quot;);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa=:SearchIDRisorsa AND statoAsset='INLAVORAZIONE'&quot;);&#xD;
	}&#xD;
	&#xD;
	criteria.setQueryParameter(&quot;SearchIDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
&#xD;
	var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
&#xD;
	if (list.size()>0)&#xD;
	{&#xD;
		Ref=list.get(0);&#xD;
	} &#xD;
}&#xD;
&#xD;
Log.write(&quot;Recupero Asset target, esito per richiesta:&quot;+localRequest.IDRichiestaOLO+&quot; -> &quot;+Ref);&#xD;
*/&#xD;
if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG)&#xD;
{&#xD;
	if(localRequest.IDRisorsa != null)&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa=:SearchIDRisorsa&quot;);&#xD;
&#xD;
		criteria.setQueryParameter(&quot;SearchIDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
&#xD;
		var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
&#xD;
		if (list.size()>0)&#xD;
		{&#xD;
			for(var i = 0; i &lt; list.size(); i++)&#xD;
			{&#xD;
				if(action == &quot;LOCK&quot;)&#xD;
				{&#xD;
					if(list.get(i).readAsset().statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO)&#xD;
					{&#xD;
						Ref=list.get(i);&#xD;
					}&#xD;
				}&#xD;
				else if(action == &quot;UNLOCK&quot;)&#xD;
				{&#xD;
					if(list.get(i).readAsset().statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE)&#xD;
					{&#xD;
						Ref=list.get(i);&#xD;
					}&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					Ref=list.get(0);&#xD;
				}&#xD;
			}&#xD;
		} &#xD;
		else&#xD;
		{&#xD;
				Process.auditLog(&quot;Nessun Asset Recuperato per IDRisorsa &quot;+ localRequest.IDRisorsa);&#xD;
		}&#xD;
	}&#xD;
&#xD;
	Log.write(&quot;Recupero Asset target, esito per richiesta:&quot;+localRequest.IDRichiestaOLO+&quot; -> &quot;+Ref);&#xD;
}&#xD;
&#xD;
//ricerca per IDASSET&#xD;
else &#xD;
{&#xD;
&#xD;
	var AssetID = &quot;&quot;;&#xD;
	AssetID =null;&#xD;
	var i=0;&#xD;
	&#xD;
	while(AssetID == null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		//MULTICAST (inserita sempre con la RU_1203 anche se non riguarda quella)&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER&#xD;
           || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE&#xD;
           || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT)&#xD;
		{&#xD;
			if((comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACANALE&#xD;
			       &amp;&amp;localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE)&#xD;
				||&#xD;
				(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFEEDER&#xD;
			       &amp;&amp;localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER)&#xD;
				||&#xD;
				(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZASEDEOLT&#xD;
			       &amp;&amp;localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT))&#xD;
			{&#xD;
				var j=0;&#xD;
				while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
					{&#xD;
						AssetID = attr.valoreAttributo;&#xD;
						Process.auditLog(&quot;Recuperato da Consistenza Raccolta IDENTIFICATTIVOASSET: &quot;+ AssetID);&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		//RU_1203: NPNG&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NPNG)&#xD;
		{&#xD;
			if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZANPNG)&#xD;
			{&#xD;
				var j=0;&#xD;
				while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
					{&#xD;
						AssetID = attr.valoreAttributo;&#xD;
						Process.auditLog(&quot;Recuperato da Consistenza Raccolta IDENTIFICATTIVOASSET: &quot;+ AssetID);&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		//Bug #32895 - CONSISTENZA RACCOLTA Aggiunta&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN&#xD;
		   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
		   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANVULA&#xD;
		   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VP)&#xD;
		{&#xD;
			if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZARACCOLTA)&#xD;
			{&#xD;
				var j=0;&#xD;
				while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
					{&#xD;
						AssetID = attr.valoreAttributo;&#xD;
						Process.auditLog(&quot;Recuperato da Consistenza Raccolta IDENTIFICATTIVOASSET: &quot;+ AssetID);&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(String(localRequest.offerta).slice(0, 3) == &quot;SHA&quot;&#xD;
		|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
		|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)&#xD;
		{&#xD;
			if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
			{&#xD;
				var j=0;&#xD;
				while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
					{&#xD;
						AssetID = attr.valoreAttributo;&#xD;
						Process.auditLog(&quot;Recuperato da Consistenza Dati IDENTIFICATTIVOASSET: &quot;+ AssetID);&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		// SM_9056 - CONSISTENZA CPS Aggiunta&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
		{&#xD;
			if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS)&#xD;
			{&#xD;
				var j=0;&#xD;
				while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
					{&#xD;
						AssetID = attr.valoreAttributo;&#xD;
						Process.auditLog(&quot;Recuperato da Consistenza CPS IDENTIFICATTIVOASSET: &quot;+ AssetID);&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			if (comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
			{&#xD;
				var j=0;&#xD;
				while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
					{&#xD;
						AssetID = attr.valoreAttributo;&#xD;
						Process.auditLog(&quot;Recuperato da Consistenza Fonia IDENTIFICATTIVOASSET: &quot;+ AssetID);&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			else if (comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
			{&#xD;
				var j=0;&#xD;
				while(AssetID== null &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
					{&#xD;
						AssetID = attr.valoreAttributo;&#xD;
						Process.auditLog(&quot;Recuperato da Consistenza Dati IDENTIFICATTIVOASSET: &quot;+ AssetID);&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
		&#xD;
		}&#xD;
	i++;&#xD;
	}&#xD;
	&#xD;
	if (AssetID != null &amp;&amp; AssetID != &quot;&quot;)&#xD;
	{&#xD;
		var c=cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset =:IDA&quot;);&#xD;
		c.setQueryParameter(&quot;IDA&quot;,ScriptUtil.createBigInteger(AssetID));&#xD;
		&#xD;
		var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		&#xD;
		if(list.size()>0)&#xD;
		{&#xD;
			for(var i = 0; i &lt; list.size(); i++)&#xD;
			{&#xD;
				if(action == &quot;LOCK&quot;)&#xD;
				{&#xD;
					if(list.get(i).readAsset().statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO)&#xD;
					{&#xD;
						Ref=list.get(i);&#xD;
					}&#xD;
				}&#xD;
				else if(action == &quot;UNLOCK&quot;)&#xD;
				{&#xD;
					if(list.get(i).readAsset().statoAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE)&#xD;
					{&#xD;
						Ref=list.get(i);&#xD;
					}&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					Ref=list.get(0);&#xD;
				}&#xD;
			}&#xD;
		&#xD;
			Log.write(&quot;Recupero Asset target, esito per richiesta:&quot;+ AssetID +&quot; -> &quot;+Ref);&#xD;
		}&#xD;
		&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Nessun Asset Recuperato per IDAsset &quot; + AssetID);&#xD;
		}&#xD;
		&#xD;
 	&#xD;
	}&#xD;
	&#xD;
	else &#xD;
	{&#xD;
		Process.auditLog(&quot;Nessun Asset Recuperato&quot;);&#xD;
	}&#xD;
	&#xD;
	&#xD;
	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
