        <xpdl2:Activity Id="_mRm40BiLEeeNiZULlC2Fiw" Name="SetInput" xpdExt:Visibility="Private" xpdExt:DisplayName="Set Input">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">BPMRequestType = com_tim_NOW_xsd_InvioJPUB_Factory.createBPMRequestType();&#xD;
&#xD;
if(Assetv1 != null)&#xD;
{&#xD;
	BPMRequestType.asset = Assetv1;&#xD;
}&#xD;
&#xD;
