{&#xD;
	BPMRequestType.assetRicarica= AssetRicaricav1;&#xD;
}&#xD;
&#xD;
BPMRequestType.richiesta = Richiestav1;&#xD;
	&#xD;
if(flag_OpereSpeciali != null)&#xD;
{&#xD;
	BPMRequestType.flag_OpereSpeciali = flag_OpereSpeciali;&#xD;
}&#xD;
&#xD;
&#xD;
if(AssetAggiuntivilistV1!= null &amp;&amp; AssetAggiuntivilistV1.size()>0){&#xD;
	BPMRequestType.assetCorrelatiAttivi.addAll(AssetAggiuntivilistV1);&#xD;
}&#xD;
if(AssetCessatilistV1!= null &amp;&amp; AssetCessatilistV1.size()>0){&#xD;
	BPMRequestType.assetCorrelatiCessati.addAll(AssetCessatilistV1);&#xD;
}&#xD;
if(AssetModificatilistV1!= null &amp;&amp; AssetModificatilistV1.size()>0){&#xD;
	BPMRequestType.assetCorrelatiVariati.addAll(AssetModificatilistV1);&#xD;
}</xpdl2:Script>
