          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(Assetv1 != null &amp;&amp; Assetv1.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
{&#xD;
	Assetv1 = null;&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; AssetAggiuntivilistV1.size(); i++)&#xD;
{&#xD;
	if(AssetAggiuntivilistV1.get(i).codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
	{&#xD;
		AssetAggiuntivilistV1.remove(i);&#xD;
		i--;&#xD;
	}&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; AssetCessatilistV1.size(); i++)&#xD;
{&#xD;
	if(AssetCessatilistV1.get(i).codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
