        <xpdl2:Activity Id="_VN4hhO3rEea8C7yzuYVf8A" Name="SetInput" xpdExt:Visibility="Private" xpdExt:DisplayName="Set Input">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Input = com_tibco_InterfacciaRichiestoVerificaEsitoFase2_Factory.createVerificaEsitoFase2RequestType();&#xD;
Input.request = dbcfx_SOA_RichiestaVerificaEsitoFase2__2016__09__15_Factory.createRequestType();&#xD;
Input.request.verificaNumerazione = dbcfx_SOA_RichiestaVerificaEsitoFase2__2016__09__15_Factory.createVerificaNumerazioneType();&#xD;
Input.request.verificaNumerazione.codiceOrdineTI = localRequest.codiceOrdineTI;&#xD;
&#xD;
Input.request.verificaNumerazione.identificativoRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
Input.request.verificaNumerazione.richiesta_Aggiuntivi = dbcfx_SOA_RichiestaVerificaEsitoFase2__2016__09__15_flagYNTYPE.Y;&#xD;
&#xD;
if(idLinea!= null){&#xD;
	&#xD;
		Input.request.verificaNumerazione.idLinea = idLinea;&#xD;
}&#xD;
else{&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274&#xD;
		&amp;&amp;&#xD;
		(localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICO&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH           //RU_1164: aggiunte offerte SEMI***&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUS&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILE&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
		|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB)){&#xD;
	&#xD;
	// Verifico valorizzazione dell'IDRISORSADIN	&#xD;
		if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
		{&#xD;
			Input.request.verificaNumerazione.idLinea = localRequest.numeroTelefonico;&#xD;
		}&#xD;
		else if(IDRisorsaFonia!= null)&#xD;
		{&#xD;
			Input.request.verificaNumerazione.idLinea = IDRisorsaFonia;&#xD;
			Process.auditLog(&quot;idLinea inviato relativo alla IDRisorsa recuperato dal Controllo C04M03F02&quot;);&#xD;
		}&#xD;
		else if(localRequest.codiceRisorsaDonating != null &amp;&amp; localRequest.cowCodeOLO==&quot;TLC&quot;)&#xD;
		{&#xD;
			Input.request.verificaNumerazione.idLinea = localRequest.codiceRisorsaDonating;&#xD;
		}	&#xD;
		else if(localRequest.codiceRisorsaDonating2 != null &amp;&amp; localRequest.cowCodeOLO2==&quot;TLC&quot;)&#xD;
		{&#xD;
			Input.request.verificaNumerazione.idLinea = localRequest.codiceRisorsaDonating2;&#xD;
		}		&#xD;
		&#xD;
	}&#xD;
	else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274&#xD;
			&amp;&amp; (localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA&#xD;
				|| localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA))&#xD;
	{&#xD;
		Input.request.verificaNumerazione.idLinea = localRequest.ordine.numeroTelefonico;&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
	{&#xD;
	&#xD;
	// modifica SM_5124&#xD;
	&#xD;
		var numeroTrovato = false;&#xD;
    	if(localRequest.codiceRisorsaDonating!= null &amp;&amp; localRequest.cowCodeOLO==&quot;TLC&quot;){&#xD;
			//cerco in asset&#xD;
			var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa = :CodiceRisorsa AND (statoAsset = 'ATTIVO' OR statoAsset = 'INLAVORAZIONE')&quot;);&#xD;
			c.setQueryParameter(&quot;CodiceRisorsa&quot;,localRequest.codiceRisorsaDonating);&#xD;
			var assetRefTemp = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			&#xD;
			if(assetRefTemp == null || assetRefTemp.size() == 0){&#xD;
				var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico = :CodiceRisorsa AND (statoAsset = 'ATTIVO' OR statoAsset = 'INLAVORAZIONE')&quot;);&#xD;
				c.setQueryParameter(&quot;CodiceRisorsa&quot;,localRequest.codiceRisorsaDonating);&#xD;
				assetRefTemp = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			}&#xD;
			&#xD;
			if(assetRefTemp != null &amp;&amp; assetRefTemp.size()>0){&#xD;
				Asset = assetRefTemp.get(0).readAsset();&#xD;
				Process.auditLog(&quot;Asset recuperato per codiceRisorsaDonating:&quot;+localRequest.codiceRisorsaDonating +&quot;  Asset: &quot;+Asset.IDAsset);&#xD;
				&#xD;
				if(Asset.numeroTelefonico != null &amp;&amp; Asset.numeroTelefonico != &quot;&quot;)&#xD;
				{&#xD;
					Input.request.verificaNumerazione.idLinea = Asset.numeroTelefonico;&#xD;
					numeroTrovato = true;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		if(localRequest.codiceRisorsaDonating2!= null &amp;&amp; localRequest.cowCodeOLO2==&quot;TLC&quot; &amp;&amp; !numeroTrovato){&#xD;
		&#xD;
		&#xD;
			//cerco in asset&#xD;
			var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa = :CodiceRisorsa AND (statoAsset = 'ATTIVO' OR statoAsset = 'INLAVORAZIONE')&quot;);&#xD;
			c.setQueryParameter(&quot;CodiceRisorsa&quot;,localRequest.codiceRisorsaDonating2);&#xD;
			var assetRefTemp = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			&#xD;
			if(assetRefTemp == null || assetRefTemp.size() == 0){&#xD;
				var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico = :CodiceRisorsa AND (statoAsset = 'ATTIVO' OR statoAsset = 'INLAVORAZIONE')&quot;);&#xD;
				c.setQueryParameter(&quot;CodiceRisorsa&quot;,localRequest.codiceRisorsaDonating2);&#xD;
				assetRefTemp = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			}&#xD;
			&#xD;
			if(assetRefTemp != null &amp;&amp; assetRefTemp.size()>0){&#xD;
				Asset = assetRefTemp.get(0).readAsset();&#xD;
				Process.auditLog(&quot;Asset recuperato per codiceRisorsaDonating2:&quot;+localRequest.codiceRisorsaDonating2 +&quot;  Asset: &quot;+Asset.IDAsset);&#xD;
				&#xD;
				if(Asset.numeroTelefonico != null &amp;&amp; Asset.numeroTelefonico != &quot;&quot;)&#xD;
				{&#xD;
					Input.request.verificaNumerazione.idLinea = Asset.numeroTelefonico;&#xD;
					numeroTrovato = true;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(!numeroTrovato)&#xD;
		{&#xD;
   				if(Asset!=null)&#xD;
 			  	{&#xD;
  				  	Input.request.verificaNumerazione.idLinea = Asset.IDRisorsa;&#xD;
   				 	Process.auditLog(&quot;NumeroTelefonico non trovato in asset, viene utilizzato l'IDRisorsa&quot;);&#xD;
  			  	}&#xD;
 				else&#xD;
   				{&#xD;
    				Input.request.verificaNumerazione.idLinea = localRequest.codiceRisorsaDonating;&#xD;
   			 		Process.auditLog(&quot;NumeroTelefonico non trovato in asset, viene utilizzato il CodiceRisorsaDonating&quot;);&#xD;
   				}&#xD;
  		}&#xD;
	}&#xD;
/*&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE){&#xD;
	if(ComponenteConsistenzaDati!= null &amp;&amp; CODIFICAOLOAGCOMDONATINGConsistenzaDati == &quot;TLC&quot;){&#xD;
		// cerco codice risorsa&#xD;
		var codiceRisorsaTrovato = false;&#xD;
		var i=0;&#xD;
		while(!codiceRisorsaTrovato &amp;&amp; i&lt;ComponenteConsistenzaDati.attributiDettaglioOrdine.size()){&#xD;
			if(ComponenteConsistenzaDati.attributiDettaglioOrdine.get(i).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA){&#xD;
				codiceRisorsaTrovato = true;&#xD;
				Input.request.verificaNumerazione.idLinea = ComponenteConsistenzaDati.attributiDettaglioOrdine.get(i).valoreAttributo;&#xD;
				Process.auditLog(&quot;idLinea inviato relativo alla IDRisorsa della componente ConsistenzaDati: &quot;+ComponenteConsistenzaDati.attributiDettaglioOrdine.get(i).valoreAttributo);&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		if(codiceRisorsaTrovato){&#xD;
			Process.auditLog(&quot;IDRISORSA non trovato&quot;);&#xD;
		}&#xD;
	}&#xD;
	else if(ComponenteConsistenzaFonia!= null &amp;&amp; CODIFICAOLOAGCOMDONATINGConsistenzaFonia == &quot;TLC&quot;){&#xD;
		// cerco codice risorsa&#xD;
		var codiceRisorsaTrovato = false;&#xD;
		var i=0;&#xD;
		while(!codiceRisorsaTrovato &amp;&amp; i&lt;ComponenteConsistenzaFonia.attributiDettaglioOrdine.size()){&#xD;
			if(ComponenteConsistenzaFonia.attributiDettaglioOrdine.get(i).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA){&#xD;
				codiceRisorsaTrovato = true;&#xD;
				Input.request.verificaNumerazione.idLinea = ComponenteConsistenzaFonia.attributiDettaglioOrdine.get(i).valoreAttributo;&#xD;
				Process.auditLog(&quot;idLinea inviato relativo alla IDRisorsa della componente ConsistenzaFonia: &quot;+ComponenteConsistenzaFonia.attributiDettaglioOrdine.get(i).valoreAttributo);&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		if(codiceRisorsaTrovato){&#xD;
			Process.auditLog(&quot;IDRISORSA non trovato&quot;);&#xD;
		}&#xD;
	}&#xD;
	else{&#xD;
		Process.auditLog(&quot;ComponenteConsistenza non trovato &quot;);&#xD;
	}&#xD;
	*/&#xD;
	else{&#xD;
		// Cerco Numero Linea &#xD;
		if(localRequest.numeroTelefonico != null){&#xD;
			Input.request.verificaNumerazione.idLinea =  localRequest.numeroTelefonico;&#xD;
		}&#xD;
		else{&#xD;
			Process.auditLog(&quot;numeroTelefonico non trovato &quot;);&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
NumeroPrincipale = Input.request.verificaNumerazione.idLinea;&#xD;
Process.auditLog(&quot;NumeroPrincipale calcolato: &quot; + NumeroPrincipale);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
