        <xpdl2:Activity Id="_T6mUse3rEea8C7yzuYVf8A" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_zbDgMO3qEea8C7yzuYVf8A" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="52.0" LaneId="_YG2vOO3qEea8C7yzuYVf8A" Width="73.0">
