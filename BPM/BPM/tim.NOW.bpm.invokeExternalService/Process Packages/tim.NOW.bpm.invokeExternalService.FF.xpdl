						&#xD;
						Process.auditLog(&quot;CASO 21&quot;);&#xD;
						Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
					}&#xD;
					else if(operatoreReteConsFonia == &quot;FC&quot;)&#xD;
					{&#xD;
						TipoRiscontro.add(&quot;CESSAZIONE_TX&quot;);&#xD;
						ConsistenzaDaInviare.add(&quot;CONSISTENZAFONIA&quot;);&#xD;
						FlagOscuramentoRu1142.add(&quot;R9F-22-0024&quot;);&#xD;
						casoGeneratoFC = true;&#xD;
						&#xD;
						Process.auditLog(&quot;CASO 21&quot;);&#xD;
						Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
					}					&#xD;
				}*/&#xD;
				//CASO 22 - 23 - RU_1315&#xD;
				else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
						&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO&#xD;
						&amp;&amp; azioneConsDati == 'D'&#xD;
						&amp;&amp; ((OffertaConsistenzaDati == &quot;VULAFTTH&quot;&#xD;
							||OffertaConsistenzaDati == &quot;SEMIVULAFTTH&quot;&#xD;
							||OffertaConsistenzaDati == &quot;BITSTREAMNGAFTTH&quot;&#xD;
							||OffertaConsistenzaDati == &quot;SEMIBITSTREAMNGAFTTH&quot;&#xD;
							||OffertaConsistenzaDati == &quot;EASYIPNGAFTTH&quot;&#xD;
							||OffertaConsistenzaDati == &quot;SEMIEASYIPNGAFTTH&quot;)&#xD;
							|| (TipoLineaConsDati != &quot;POTS&quot; &amp;&amp; //Task #40799&#xD;
								TipoLineaConsDati != &quot;ISDN&quot;))&#xD;
						&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
			                ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
							||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
							||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
							||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
							||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)						&#xD;
						&amp;&amp; localRequest.operatoreRete == &quot;FC&quot;)&#xD;
				{&#xD;
					if (MigrazIntraoloAccesso == &quot;SI&quot;)&#xD;
					{&#xD;
						TipoRiscontro.add(&quot;MIGRAZ_INTRA&quot;);&#xD;
						Process.auditLog(&quot;CASO 23&quot;);						&#xD;
					}else {&#xD;
						TipoRiscontro.add(&quot;MIGRAZIONE&quot;);&#xD;
						Process.auditLog(&quot;CASO 22&quot;);&#xD;
					}&#xD;
					ConsistenzaDaInviare.add(&quot;CONSISTENZADATI&quot;);&#xD;
					FlagOscuramentoRu1142.add(&quot;R9F-22-0024&quot;);&#xD;
					Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
					casoGeneratoFC = true;&#xD;
				}&#xD;
				// IN TUTTI GLI ALTRI CASI - Stiamo cessando asset FC - La lavorazione CESSAZIONE viene gestita a parte (vedi dopo)&#xD;
				// SM_10317 : aggiunte casistiche in cui NON dobbiamo inviare la cessazione: Migrazione, Attivazione USCITADATI/CAMBIOTECNOLOGIA, Variazione TRASLOCO&#xD;
				else if(&#xD;
				((operatoreReteConsDati == &quot;FC&quot; &amp;&amp; azioneConsDati == &quot;D&quot;) || (operatoreReteConsFonia == &quot;FC&quot; &amp;&amp; azioneConsFonia == &quot;D&quot;))&#xD;
				&amp;&amp; &#xD;
				(localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
				&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
				&amp;&amp; !(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
				  &amp;&amp; (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.USCITADATI&#xD;
				   || localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA))&#xD;
				&amp;&amp; !(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
				  &amp;&amp; String(localRequest.tipologiaSottolav).slice(0,8) == &quot;TRASLOCO&quot;))&#xD;
				)&#xD;
				{&#xD;
					if(operatoreReteConsDati == &quot;FC&quot; &amp;&amp; azioneConsDati == &quot;D&quot;)&#xD;
					{&#xD;
						TipoRiscontro.add(&quot;CESSAZIONE&quot;);&#xD;
						ConsistenzaDaInviare.add(&quot;CONSISTENZADATI&quot;);&#xD;
						FlagOscuramentoRu1142.add(&quot;R1F-20-0321&quot;);&#xD;
						casoGeneratoFC = true;&#xD;
						&#xD;
						Process.auditLog(&quot;IN TUTTI GLI ALTRI CASI - CONS DATI FC con azione a D&quot;);&#xD;
						Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
					}&#xD;
					&#xD;
					if(operatoreReteConsFonia == &quot;FC&quot; &amp;&amp; azioneConsFonia == &quot;D&quot;)&#xD;
					{&#xD;
						TipoRiscontro.add(&quot;CESSAZIONE&quot;);&#xD;
						ConsistenzaDaInviare.add(&quot;CONSISTENZAFONIA&quot;);&#xD;
						&#xD;
						//SM_11222&#xD;
						if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
						  &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP&#xD;
						  &amp;&amp;(localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot; || localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;)&#xD;
						  &amp;&amp; TipoLineaConsFonia == &quot;POTS&quot;&#xD;
						  &amp;&amp;(String(OffertaConsistenzaFonia).slice(0,3) == &quot;ULL&quot; || String(OffertaConsistenzaFonia).slice(0,3) == &quot;SLU&quot;&#xD;
						  || String(OffertaConsistenzaFonia).slice(0,3) == &quot;WLR&quot; || String(OffertaConsistenzaFonia).slice(0,4) == &quot;VULL&quot;))&#xD;
						{&#xD;
							FlagOscuramentoRu1142.add(&quot;R58-23-0910&quot;);&#xD;
						}&#xD;
						else&#xD;
						{ &#xD;
							FlagOscuramentoRu1142.add(&quot;R1F-20-0321&quot;);&#xD;
						}&#xD;
						casoGeneratoFC = true;&#xD;
						&#xD;
						Process.auditLog(&quot;IN TUTTI GLI ALTRI CASI - CONS FONIA FC con azione a D&quot;);&#xD;
						Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			// ===================== LOGICA STANDARD - GENERATI DA ORDINE FC o FF =====================&#xD;
			if(&#xD;
			// In caso di ESITO OK controllo che non sia uno dei 16 casi e che sia marchiato FF/FC&#xD;
			(!casoGeneratoFC&#xD;
			&amp;&amp; (localRequest.operatoreRete == &quot;FF&quot; || localRequest.operatoreRete == &quot;FC&quot;)&#xD;
			&amp;&amp; (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CODICE_ESITO == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_CodiceEsitoType._015))&#xD;
			||&#xD;
			// SM_10797: Commentata condizione -> &quot;In caso di Esito KO controllo, se si parte da un asset FC a Fibercop non serve notificare nulla&quot; e aggiunta lavorazione ATTIVAZIONE come da C05M02F19 per ESPLETAMENTO KO&#xD;
			(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CODICE_ESITO != com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_CodiceEsitoType._015&#xD;
			//&amp;&amp; !(operatoreReteConsDati == &quot;FC&quot; || operatoreReteConsFonia == &quot;FC&quot;)&#xD;
			&amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
			)&#xD;
			{&#xD;
				Process.auditLog(&quot;LOGICA STANDARD - GENERATI DA ORDINE FC o FF&quot;);&#xD;
				&#xD;
				if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
				{&#xD;
					//SM_11087&#xD;
					if((localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot; || localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;)&#xD;
					   &amp;&amp; TipoLineaConsDati == &quot;POTS&quot;  //Bug #48814&#xD;
					   &amp;&amp; (String(localRequest.offerta).slice(0,3) == &quot;ULL&quot; || String(localRequest.offerta).slice(0,3) == &quot;SLU&quot;&#xD;
				           || String(localRequest.offerta).slice(0,3) == &quot;WLR&quot; || String(localRequest.offerta).slice(0,4) == &quot;VULL&quot;))&#xD;
					{&#xD;
						TipoRiscontro.add(&quot;CESSAZIONE&quot;);&#xD;
						FlagOscuramentoRu1142.add(&quot;R58-23-0910&quot;);&#xD;
						ConsistenzaDaInviare.add(&quot;CONSISTENZAFONIA&quot;);&#xD;
					}&#xD;
					//solito&#xD;
					else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
					|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL     //SM_10656&#xD;
					|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FWA&#xD;
					|| String(localRequest.offerta).slice(0,3) == &quot;SHA&quot;   //SM_11220: SHA è DATI&#xD;
					|| (localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO   //Bug #39213&#xD;
					    &amp;&amp; azioneConsDati == &quot;M&quot; &amp;&amp; azioneConsFonia == &quot;N&quot; &amp;&amp; OffertaConsistenzaDati == OffertaConsistenzaFonia&#xD;
						&amp;&amp; (OffertaConsistenzaDati == &quot;ULLLINEANONATTIVA&quot; || OffertaConsistenzaDati == &quot;SLULINEANONATTIVA&quot;)))&#xD;
					{&#xD;
						TipoRiscontro.add(&quot;CESSAZIONE&quot;);&#xD;
						FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
						ConsistenzaDaInviare.add(&quot;CONSISTENZADATI&quot;);&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						TipoRiscontro.add(&quot;CESSAZIONE&quot;);&#xD;
						FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
						ConsistenzaDaInviare.add(&quot;CONSISTENZAFONIA&quot;);&#xD;
					}&#xD;
					&#xD;
					Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
				}&#xD;
				else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
				&amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.USCITADATI) //escluso USCITADATI post mail &quot;RE: Evento FC - Espletamento fermo in da elaborare&quot;&#xD;
				{&#xD;
					TipoRiscontro.add(&quot;ESPLETAMENTO&quot;);&#xD;
					ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
					FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
					&#xD;
					Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	// CASO 13 (particolare) - Invio a FC Generated post Espletamento (il booleano viene valorizzato in CalcolaMappingAsset)&#xD;
	else if(sendVARIAZIONEAGGIUNTIVI != null &amp;&amp; sendVARIAZIONEAGGIUNTIVI == true)&#xD;
	{&#xD;
		TipoRiscontro.add(&quot;VARIAZIONEAGGIUNTIVI&quot;);&#xD;
		ConsistenzaDaInviare.add(&quot;CONSISTENZAFONIA&quot;);&#xD;
		FlagOscuramentoRu1142.add(&quot;R1F-20-0321&quot;);&#xD;
		casoGeneratoFC = true;&#xD;
		&#xD;
		Process.auditLog(&quot;CASO 13&quot;);&#xD;
		Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
	}&#xD;
	//CASO 21 - spostato qui con Task #41282 (solo OL AUTOESPLETANTI, quindi non c'è evento NFESPLETAMENTO)&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
			&amp;&amp; localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.CCAMBIOTECNOLOGIA&#xD;
			&amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL&#xD;
			&amp;&amp; localRequest.operatoreRete == &quot;FC&quot;)&#xD;
	{					&#xD;
		if(operatoreReteConsDati == &quot;FC&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;CESSAZIONE_TX&quot;);&#xD;
			ConsistenzaDaInviare.add(&quot;CONSISTENZADATI&quot;);&#xD;
			FlagOscuramentoRu1142.add(&quot;R9F-22-0024&quot;);&#xD;
			casoGeneratoFC = true;&#xD;
			&#xD;
			Process.auditLog(&quot;CASO 21&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
		}&#xD;
		else if(operatoreReteConsFonia == &quot;FC&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;CESSAZIONE_TX&quot;);&#xD;
			ConsistenzaDaInviare.add(&quot;CONSISTENZAFONIA&quot;);&#xD;
			FlagOscuramentoRu1142.add(&quot;R9F-22-0024&quot;);&#xD;
			casoGeneratoFC = true;&#xD;
			&#xD;
			Process.auditLog(&quot;CASO 21&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
		}					&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		TipoRiscontro.add(&quot;DESOSPENSIONE&quot;);&#xD;
		ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
		FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
		&#xD;
		Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="113.0" LaneId="_nS7DocJQEei7SMWCZ1uuwQ" Width="149.0">
              <xpdl2:Coordinates XCoordinate="995.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_zFYnoJ1WEe2xJ_9femLilw" Name="ValorizzazioneRiscontroversoFFFCGenerico" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Valorizzazione Riscontro verso FF/FC Generico" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//PRE-RU_1150 - C4 - OFFERTE CHE NON SIANO GPON&#xD;
if(!(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON&#xD;
     ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON&#xD;
     ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIGPON1BPNRR     //SM_11985&#xD;
     ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPON1BPNRR))&#xD;
{&#xD;
&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++){&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
			for(var j=0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
				{&#xD;
					StrutturaLinea = currentAttDettOrdine.valoreAttributo;						&#xD;
					Process.auditLog(&quot;StrutturaLinea ACCESSO: &quot;+StrutturaLinea);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI){&#xD;
			for(var j=0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
				{&#xD;
					OffertaConsistenzaDati = currentAttDettOrdine.valoreAttributo;						&#xD;
					Process.auditLog(&quot;Offerta della CONSISTENZADATI: &quot;+OffertaConsistenzaDati);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA){&#xD;
			for(var j=0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
				{&#xD;
					OffertaConsistenzaFonia = currentAttDettOrdine.valoreAttributo;						&#xD;
					Process.auditLog(&quot;Offerta della CONSISTENZAFONIA: &quot;+OffertaConsistenzaFonia);&#xD;
				}&#xD;
			}&#xD;
		}			&#xD;
	}&#xD;
	&#xD;
	//Aggiunta condizione post SM_10891&#xD;
	if(ManageNotificationDTU != null)&#xD;
	{&#xD;
		&#xD;
		if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPRENOTAZIONENUMERO)&#xD;
		{&#xD;
			if(OLnewMarchiatoFC)&#xD;
			{&#xD;
				TipoRiscontro.add(&quot;ATTIVAZIONE&quot;);&#xD;
				ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
				FlagOscuramentoRu1142.add(&quot;N&quot;);				&#xD;
				Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
			}			&#xD;
		}&#xD;
		// FF - ACCODAMENTO, CONFIG LOGICA&#xD;
		else if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIACCODAMENTO&#xD;
		&amp;&amp; localRequest.operatoreRete == &quot;FF&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;SOSPENSIONE&quot;);&#xD;
			ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
			FlagOscuramentoRu1142.add(&quot;N&quot;);			&#xD;
			Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));		&#xD;
		}&#xD;
		else if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NICONFIGURAZIONELOGICA&#xD;
		&amp;&amp; localRequest.operatoreRete == &quot;FF&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;ATTIVAZIONE&quot;);&#xD;
			ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
			FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
			Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));	&#xD;
		}&#xD;
		// FC - ACCODAMENTO, CONFIG LOGICA&#xD;
		else if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIACCODAMENTO&#xD;
			 || ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NICONFIGURAZIONELOGICA)&#xD;
		{&#xD;
			//SM_10648: per CAMBIOTECNOLOGIA con richiesta e offerta della consistenza like FTHH, va inviata a prescindere ATTIVAZIONE&#xD;
			/*if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NICONFIGURAZIONELOGICA&#xD;
			   &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
			   &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA&#xD;
			   &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
					||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
					||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
					||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
					||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
					||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)&#xD;
				&amp;&amp; (OffertaConsistenzaDati == &quot;VULAFTTH&quot;&#xD;
					||OffertaConsistenzaDati == &quot;SEMIVULAFTTH&quot;&#xD;
					||OffertaConsistenzaDati == &quot;BITSTREAMNGAFTTH&quot;&#xD;
					||OffertaConsistenzaDati == &quot;SEMIBITSTREAMNGAFTTH&quot;&#xD;
					||OffertaConsistenzaDati == &quot;EASYIPNGAFTTH&quot;&#xD;
					||OffertaConsistenzaDati == &quot;SEMIEASYIPNGAFTTH&quot;))&#xD;
			{&#xD;
				TipoRiscontro.add(&quot;ATTIVAZIONE&quot;);&#xD;
				ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
				FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
				Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));	&#xD;
			}&#xD;
			//solito&#xD;
			else COMMENTATO CON SM_10891*/&#xD;
			&#xD;
			//SM_10891: inserito IF per ATT CAMBIO TECNOLOGIA, per usare booleano che ci assicura venga inviata attivazione, invece di OLpremarchiato&#xD;
			if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
			&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA&#xD;
			&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
				||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
				||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
				||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
				||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
				||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH))&#xD;
			{&#xD;
				if(inviatoATT_FC)&#xD;
				{&#xD;
					TipoRiscontro.add(&quot;SOSPENSIONE&quot;);&#xD;
					ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
					FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
					Process.auditLog(&quot;OLpreMarchiatoFC&quot;);&#xD;
					Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));	&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					TipoRiscontro.add(&quot;ATTIVAZIONE&quot;);&#xD;
					ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
					FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
					Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));	&#xD;
				}&#xD;
			}&#xD;
			else if(OLpreMarchiatoFC)&#xD;
			{&#xD;
				TipoRiscontro.add(&quot;SOSPENSIONE&quot;);&#xD;
				ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
				FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
				Process.auditLog(&quot;OLpreMarchiatoFC&quot;);&#xD;
				Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));	&#xD;
			}&#xD;
			else if(OLnewMarchiatoFC)&#xD;
			{&#xD;
				TipoRiscontro.add(&quot;ATTIVAZIONE&quot;);&#xD;
				ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
				FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
				Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));	&#xD;
			}	&#xD;
		}&#xD;
		else if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPRESAAPPUNTAMENTO)&#xD;
		{&#xD;
			if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
			&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE) //SM_9987 - solo per ATT NORMALE&#xD;
			{&#xD;
				TipoRiscontro.add(&quot;DESOSPENSIONE&quot;);&#xD;
				ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
				FlagOscuramentoRu1142.add(&quot;N&quot;);				&#xD;
				Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));	&#xD;
			}&#xD;
			else{&#xD;
				Process.auditLog(&quot;DESOSPENSIONE da non inviare perché lavorazione: &quot;+String(localRequest.lavorazione)+&quot; e sottolav: &quot;+String(localRequest.tipologiaSottolav));&#xD;
			}			&#xD;
		}&#xD;
		if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NISOSPENSIONE ||&#xD;
				ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NITENTATIVOCONTATTO ||&#xD;
				ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIFINETENTATIVOCONTATTO ||&#xD;
				ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIASSEGNAZIONESUPPORTO) // aggiunto con RU_1063&#xD;
		{&#xD;
			if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
			&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE) //SM_9987 - solo per ATT NORMALE&#xD;
			{&#xD;
				TipoRiscontro.add(&quot;SOSPENSIONE&quot;);&#xD;
				ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
				FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
				&#xD;
				Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
			}&#xD;
			else{&#xD;
				Process.auditLog(&quot;SOSPENSIONE da non inviare perché lavorazione: &quot;+String(localRequest.lavorazione)+&quot; e sottolav: &quot;+String(localRequest.tipologiaSottolav));&#xD;
			}&#xD;
		}&#xD;
		else if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFCONFERMAANNULLAMENTO)&#xD;
		{	&#xD;
			if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
			   &amp;&amp;(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE      //SM_9987 - ATT NORMALE&#xD;
					 ||(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA     //SM_10797 - ATT CAMBIOTECNOLOGIA&#xD;
						&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
							||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
							||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
							||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
							||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
							||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)))) &#xD;
			{&#xD;
				TipoRiscontro.add(&quot;ANNULLAMENTO&quot;);&#xD;
				ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
				FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
				&#xD;
				Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
			}&#xD;
			else{&#xD;
				Process.auditLog(&quot;SOSPENSIONE da non inviare perché lavorazione: &quot;+String(localRequest.lavorazione)+&quot; e sottolav: &quot;+String(localRequest.tipologiaSottolav));&#xD;
			}&#xD;
		}&#xD;
		else if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIFINEACCODAMENTO)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;DESOSPENSIONE&quot;);&#xD;
			ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
			FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
			&#xD;
			Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
		}&#xD;
		else if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPROGETTAZIONEPERCORSODIRETE)&#xD;
		{&#xD;
			if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
			{&#xD;
				if(String(localRequest.tipologiaSottolav).slice(0,8) ==&quot;TRASLOCO&quot;&#xD;
				&amp;&amp; (String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;&#xD;
				 || String(localRequest.offerta).slice(0,4) == &quot;VULL&quot;)&#xD;
				&amp;&amp; (StrutturaLinea != &quot;PBX&quot; &amp;&amp; StrutturaLinea != &quot;GNR&quot;)&#xD;
				&amp;&amp; OLpreMarchiatoFC) //SM_9994 - se questo booleano è a TRUE vuol dire che è risalito DTUDATIOPERATORERETE (con ordine già FC)&#xD;
				{&#xD;
					TipoRiscontro.add(&quot;TRASLOCO&quot;);&#xD;
					ConsistenzaDaInviare.add(&quot;CONSISTENZAFONIA&quot;);&#xD;
					FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
					inviatoTraslocoFC = true; //Ci serve per capire se è già stato inviato un trasloco (vedi caso 17 espletamento)&#xD;
					&#xD;
					Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
				}&#xD;
				else if(OLnewMarchiatoFC)&#xD;
				{&#xD;
					TipoRiscontro.add(&quot;ATTIVAZIONE&quot;);&#xD;
					ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
					FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
					&#xD;
					Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
				}&#xD;
				else{&#xD;
					Process.auditLog(&quot;Si tratta di una variazione senza trasloco. Skip.&quot;);&#xD;
				}&#xD;
			}&#xD;
			else if(OLnewMarchiatoFC)&#xD;
			{&#xD;
				TipoRiscontro.add(&quot;ATTIVAZIONE&quot;);&#xD;
				ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
				FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
				&#xD;
				Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
			}&#xD;
		}&#xD;
		else if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIVERIFICATECNICAETOPONOMASTICA)&#xD;
		{&#xD;
			if(String(localRequest.tipologiaSottolav).slice(0,8) ==&quot;TRASLOCO&quot;&#xD;
				&amp;&amp; (String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;&#xD;
				 || String(localRequest.offerta).slice(0,4) == &quot;VULL&quot;)&#xD;
				&amp;&amp; (StrutturaLinea == &quot;PBX&quot; || StrutturaLinea == &quot;GNR&quot;)&#xD;
				&amp;&amp; OLpreMarchiatoFC) //SM_9994&#xD;
			{&#xD;
				TipoRiscontro.add(&quot;TRASLOCO&quot;);&#xD;
				ConsistenzaDaInviare.add(&quot;CONSISTENZAFONIA&quot;);&#xD;
				FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
				inviatoTraslocoFC = true;&#xD;
				&#xD;
				Process.auditLog(&quot;Notifica: &quot;+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+&quot;, TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
