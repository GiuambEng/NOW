        </xpdl2:Activity>
        <xpdl2:Activity Id="_fXGQwHECEeuyGLlrrQafyQ" Name="ValorizzazioneRiscontroversoFFFCperGPON" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Valorizzazione Riscontro verso FF/FC per GPON">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//RU_1150 - C4 - OFFERTE GPON&#xD;
//RU_1563 Inserito controllo su FLAGNEWGPON&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON&#xD;
   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON)&#xD;
   &amp;&amp; localRequest.flagNewGpon != &quot;SI&quot;)&#xD;
{&#xD;
	Process.auditLog(&quot;Gestione Offerta GPON, TipologiaNotificaOLO: &quot;+TipologiaNotificaOLO);&#xD;
	&#xD;
	//Questi due sono da inviare a prescindere così (servono per le altre offerte, RU_1142)&#xD;
	ConsistenzaDaInviare.add(&quot;&quot;);&#xD;
	FlagOscuramentoRu1142.add(&quot;N&quot;);&#xD;
	&#xD;
	&#xD;
	//SOLITA GESTIONE PRE-RU_1393&#xD;
	//Se siamo in Gestione DTU inviamo evento in base a ciò che risale dalla MS&#xD;
	if(ManageNotificationDTU != null)&#xD;
	{&#xD;
		//C06M08F08 (OAO) -> C34M01F17 – Notifica di Sospensione (FC)&#xD;
		if(TipologiaNotificaOLO == &quot;SC&quot; || TipologiaNotificaOLO == &quot;SP&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;GPON_SOSPENSIONE&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
		}&#xD;
		//C06M08F06 (OAO) -> C34M01F18 – Notifica di Accodamento (FC)&#xD;
		else if(TipologiaNotificaOLO == &quot;CO&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;GPON_ACCODAMENTO&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
		}&#xD;
		//C06M08F04 (OAO) -> C34M01F20 – Notifica di Rimodulazione DPS (FC)&#xD;
		else if(TipologiaNotificaOLO == &quot;DP&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;GPON_RIMODULAZIONEDPS&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
		}&#xD;
		//C06M08F09 (OAO) -> C34M01F21 – Notifica di Tentativo Contatto (FC)&#xD;
		else if(TipologiaNotificaOLO == &quot;TC&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;GPON_TENTATIVICONTATTO&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
		}&#xD;
		//C06M08F05 (OAO) -> C34M01F22 – Notifica di In Carico A Delivery (FC)&#xD;
		else if(TipologiaNotificaOLO == &quot;ID&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;GPON_INCARICOADELIVERY&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
		}&#xD;
		//C06M08F07 (OAO) -> C34M01F23 – Notifica di Ragione Sociale Unico (FC)&#xD;
		else if(TipologiaNotificaOLO == &quot;SU&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;GPON_RAGIONESOCIALESU&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
		}&#xD;
		//C06M08F10 (OAO) -> C34M01F24 – Notifica di Presa Appuntamento (FC)&#xD;
		else if(TipologiaNotificaOLO == &quot;PA&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;GPON_DATAAPPUNTAMENTO&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
		}&#xD;
		//C06M08F02 (OAO) -> C34M01F26 – Notifica di Accettato (FC)&#xD;
		else if(TipologiaNotificaOLO == &quot;AC&quot; || TipologiaNotificaOLO == &quot;KC&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;GPON_ACCETTAZIONE&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
		}&#xD;
		//C06M08F15 (OAO) ->C34M01F28 – Notifica di Preventivo Opere Speciali (FC)&#xD;
		else if(TipologiaNotificaOLO == &quot;OS&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;GPON_PREVENTIVOOPERESPECIALI&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
		}&#xD;
		//C06M08F11 (OAO) -> C34M01F27 – Notifica di Espletamento (FC)&#xD;
		else if(TipologiaNotificaOLO == &quot;OK&quot; || TipologiaNotificaOLO == &quot;KD&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;GPON_ESPLETAMENTO&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
		}&#xD;
		//C06M08F03 (OAO) -> C34M01F30 - Notifica di Rimodulazione DAI (FC)&#xD;
		else if(TipologiaNotificaOLO == &quot;RD&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;GPON_RIMODULAZIONEDAI&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
		}&#xD;
		//RU_1393 - C06M08F16 (OAO) -> C34M01F34 – Inizio Attività  (FC)&#xD;
		else if(TipologiaNotificaOLO == &quot;IA&quot;)&#xD;
		{&#xD;
			TipoRiscontro.add(&quot;GPON_INIZIOATTIVITA&quot;);&#xD;
			Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
		}	&#xD;
	}&#xD;
	&#xD;
	//GESTIONI PARTICOLARI - CHIAMATE A FC NON LEGATE ALLA MS O ALLA LAVORAZIONE	&#xD;
	//RU_1393 - Gestione invio notifica INFO tramite batch + logica BPM (siamo in Gestione DTU, ma la IN non è da MS)&#xD;
	else if(TipologiaNotificaOLO != null &amp;&amp; TipologiaNotificaOLO != &quot;&quot; &amp;&amp; TipologiaNotificaOLO == &quot;IN&quot;)&#xD;
	{&#xD;
		TipoRiscontro.add(&quot;GPON_INFO&quot;);&#xD;
		Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
	}&#xD;
	//SM_11163 - inviata in TINOW-Gestione Notifiche da DTU, post &quot;Storicizza Preventivo e JPUB&quot; (quindi non da MS)&#xD;
	else if(TipologiaNotificaOLO != null &amp;&amp; TipologiaNotificaOLO != &quot;&quot; &amp;&amp; TipologiaNotificaOLO == &quot;OS&quot;)&#xD;
	{&#xD;
		TipoRiscontro.add(&quot;GPON_PREVENTIVOOPERESPECIALI&quot;);&#xD;
		Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
	}&#xD;
	//SM_11163 - inviata in TINOW-Acquisizione Richiesta Master, post &quot;Aggiorna Richiesta DAC Rimodulata da ACCETTAZIONEOPERESPECIALI&quot; (quindi non da MS)&#xD;
	else if(TipologiaNotificaOLO != null &amp;&amp; TipologiaNotificaOLO != &quot;&quot; &amp;&amp; TipologiaNotificaOLO == &quot;RD&quot;)&#xD;
	{&#xD;
		TipoRiscontro.add(&quot;GPON_RIMODULAZIONEDAI&quot;);&#xD;
		Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));&#xD;
	}&#xD;
	&#xD;
	//GESTIONE SULLA BASE DELLA LAVORAZIONE	&#xD;
	//C02M55 - Richiesta Attivazione UBB GPON (LAV) -> C34M01F11 – Ordine di Attivazione GPON (FC)&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
	{&#xD;
		TipoRiscontro.add(&quot;GPON_ATTIVAZIONE&quot;);&#xD;
		Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));		&#xD;
	}&#xD;
	//C02M56 - Richiesta di Cessazione UBB GPON (LAV) -> CC34M01F12 – Ordine di Cessazione GPON (FC)&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
	{&#xD;
		TipoRiscontro.add(&quot;GPON_CESSAZIONE&quot;);&#xD;
		Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));		&#xD;
	}&#xD;
	//C03M01 - Richiesta di Annullamento (LAV) -> C34M01F15 – Richiesta di Annullamento Ordine GPON (FC)&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTO)&#xD;
	{&#xD;
		TipoRiscontro.add(&quot;GPON_ANNULLAMENTO&quot;);&#xD;
		Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));		&#xD;
	}&#xD;
	//C03M03 - Richiesta di Cancellazione Accodamento (LAV) -> C34M01F14 – Richiesta di Cancellazione Accodamento GPON (FC)&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CANCELLAZIONEACCODAMENTO)&#xD;
	{&#xD;
		TipoRiscontro.add(&quot;GPON_CANCELLAZIONEACCODAMENTO&quot;);&#xD;
		Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));		&#xD;
	}&#xD;
	//C03M02 – Richiesta di Desospensione (LAV) -> C34M01F13 – Richiesta di Interruzione Sospensione GPON (FC)&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.INTERRUZIONESOSPENSIONE)&#xD;
	{&#xD;
		TipoRiscontro.add(&quot;GPON_INTERRUZIONESOSPENSIONE&quot;);&#xD;
		Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));	&#xD;
	}&#xD;
	//C03M04 - Richiesta di Rimodulazione DAD (LAV) -> C34M01F16 – Richiesta di Rimodulazione Appuntamento Ordine GPON (FC)&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDAD)&#xD;
	{&#xD;
		TipoRiscontro.add(&quot;GPON_RIMODULAZIONEAPPUNTAMENTO&quot;);&#xD;
		Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));		&#xD;
	}&#xD;
	//C03M10 – Richiesta di ACCETTAZIONE OPERE SPECIALI (LAV) -> C34M01F29 – Richiesta di Accettazione Preventivo Opere Speciali GPON (FC&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ACCETTAZIONEOPERESPECIALI)&#xD;
	{&#xD;
		TipoRiscontro.add(&quot;GPON_ACCETTAZIONEOPERESPECIALI&quot;);&#xD;
		Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1));	&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="107.0" LaneId="_nS7DocJQEei7SMWCZ1uuwQ" Width="151.0">
              <xpdl2:Coordinates XCoordinate="491.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_A-0t8HEGEeuyGLlrrQafyQ" Name="EmbeddedSubProcess" xpdExt:DisplayName="Embedded Sub-Process">
          <xpdl2:BlockActivity xpdExt:IsEventSubProcess="false" ActivitySetId="_A-0t8XEGEeuyGLlrrQafyQ" View="EXPANDED"/>
          <xpdl2:Loop LoopType="MultiInstance">
            <xpdl2:LoopMultiInstance MI_FlowCondition="All" MI_Ordering="Parallel">
              <xpdl2:MI_Condition ScriptGrammar="JavaScript">TipoRiscontro.size();</xpdl2:MI_Condition>
              <xpdExt:MultiInstanceScripts/>
            </xpdl2:LoopMultiInstance>
          </xpdl2:Loop>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,230,138" Height="231.0" LaneId="_nS7DocJQEei7SMWCZ1uuwQ" Width="465.0">
              <xpdl2:Coordinates XCoordinate="1401.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_u1VlwGp0Ee2kW_Rra2d6Ug" Name="ValorizzazioneRiscontroversoFFFCEspletamento" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Valorizzazione Riscontro verso FF/FC Espletamento">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//PRE-RU_1150 - C4 - OFFERTE CHE NON SIANO GPON&#xD;
if(!(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON&#xD;
     ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON&#xD;
     ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIGPON1BPNRR    //SM_11985&#xD;
     ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPON1BPNRR))&#xD;
{&#xD;
	// RU_1142: questo flag dovrà stare ad Y solo per i nuovi casi aggiunti (generati da Asset FC), in cui dovrà essere controllato l'oscuramento su BW prima di inviare a FC&#xD;
	if(ManageNotificationDTU != null)&#xD;
	{&#xD;
		if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO)&#xD;
		{&#xD;
			// Booleano che uso per capire se sono entrato in uno dei casi&#xD;
			var casoGeneratoFC = false;&#xD;
			&#xD;
			// ===================== NUOVI CASI - GENERATI DA ASSET FC =====================&#xD;
			if((operatoreReteConsDati == &quot;FC&quot; || operatoreReteConsFonia == &quot;FC&quot;&#xD;
			    || ((localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot; || localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot;)&#xD;
				    &amp;&amp; localRequest.operatoreRete == &quot;FC&quot;))  //SM_11087: per queste indotte va controllato operatoreRete in chiaro&#xD;
			&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CODICE_ESITO == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_CodiceEsitoType._015) //ESPLETAMENTO OK&#xD;
			{&#xD;
				Process.auditLog(&quot;NUOVI CASI - GENERATI DA ASSET FC - Notifica ESPLETAMENTO&quot;);&#xD;
				&#xD;
				var azioneConsDati = &quot;&quot;;&#xD;
				azioneConsDati = null;&#xD;
				var azioneConsFonia = &quot;&quot;;&#xD;
				azioneConsFonia = null;&#xD;
				var IDRisorsaConsDati = &quot;&quot;;&#xD;
				IDRisorsaConsDati = null;&#xD;
				var IDRisorsaConsFonia = &quot;&quot;;&#xD;
				IDRisorsaConsFonia = null;&#xD;
				var TipoLineaConsDati = &quot;&quot;;&#xD;
				TipoLineaConsDati = null;&#xD;
				var TipoLineaConsFonia = &quot;&quot;;&#xD;
				TipoLineaConsFonia = null;&#xD;
				var MigrazIntraoloAccesso = &quot;&quot;;&#xD;
				MigrazIntraoloAccesso = null;&#xD;
				&#xD;
				for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
				{&#xD;
					var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
					&#xD;
					if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI&#xD;
						|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
					{&#xD;
						for(var j=0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
						{&#xD;
							var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
							&#xD;
							if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
							{&#xD;
								if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
								{&#xD;
									IDRisorsaConsFonia = currentAttDettOrdine.valoreAttributo;&#xD;
									azioneConsFonia = String(currentDettOrdine.azione);								&#xD;
									Process.auditLog(&quot;IDRisorsaConsFonia: &quot;+IDRisorsaConsFonia+&quot;, azioneConsFonia: &quot;+azioneConsFonia);&#xD;
								}&#xD;
								else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
								{&#xD;
									IDRisorsaConsDati = currentAttDettOrdine.valoreAttributo;&#xD;
									azioneConsDati = String(currentDettOrdine.azione);									&#xD;
									Process.auditLog(&quot;IDRisorsaConsDati: &quot;+IDRisorsaConsDati+&quot;, azioneConsDati: &quot;+azioneConsDati);&#xD;
								}&#xD;
							}&#xD;
							else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
							{&#xD;
								if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
								{&#xD;
									TipoLineaConsFonia = currentAttDettOrdine.valoreAttributo;									&#xD;
									Process.auditLog(&quot;TipoLineaConsFonia: &quot;+TipoLineaConsFonia);&#xD;
								}&#xD;
								else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
								{&#xD;
									TipoLineaConsDati = currentAttDettOrdine.valoreAttributo;									&#xD;
									Process.auditLog(&quot;TipoLineaConsDati: &quot;+TipoLineaConsDati);&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
					}else if (String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						var foundMigIntraolo = false;&#xD;
						var  j=0;&#xD;
						while (j&lt; currentDettOrdine.attributiDettaglioOrdine.size() &amp;&amp; !foundMigIntraolo)&#xD;
						{&#xD;
							var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
							if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MIGRAZIONEINTRAOLO)&#xD;
							{&#xD;
								MigrazIntraoloAccesso = currentAttDettOrdine.valoreAttributo;									&#xD;
								Process.auditLog(&quot;MigrazIntraoloAccesso: &quot;+MigrazIntraoloAccesso);&#xD;
								foundMigIntraolo = true;&#xD;
							}&#xD;
							j++;&#xD;
						}						&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//RU_1266: modificati i 19 casi per inviare MIGRAZIONE (sia quando varia sia quando non varia IDRISORSA) invece di VARIAZIONEIDRISORSA&#xD;
				&#xD;
				//CASO 1&#xD;
				if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
				&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA&#xD;
				&amp;&amp; ((azioneConsFonia == &quot;D&quot; &amp;&amp; operatoreReteConsFonia == &quot;FC&quot;)&#xD;
				    ||(azioneConsDati == &quot;D&quot; &amp;&amp; operatoreReteConsDati == &quot;FC&quot;))    //RU_1266 (Task #37297)&#xD;
				&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
				 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
				 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
				 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
				 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
				 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
				 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
				 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
				 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
				 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB))&#xD;
				{&#xD;
					TipoRiscontro.add(&quot;MIGRAZIONE&quot;);&#xD;
					&#xD;
					if(azioneConsFonia == &quot;D&quot;)&#xD;
					{					&#xD;
						ConsistenzaDaInviare.add(&quot;CONSISTENZAFONIA&quot;);&#xD;
					}&#xD;
					else  //RU_1266 (Task #37297)&#xD;
					{&#xD;
						ConsistenzaDaInviare.add(&quot;CONSISTENZADATI&quot;);&#xD;
					}&#xD;
					&#xD;
					FlagOscuramentoRu1142.add(&quot;R1F-20-0321&quot;);&#xD;
					casoGeneratoFC = true;					&#xD;
					Process.auditLog(&quot;CASO 1&quot;);&#xD;
					Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));						&#xD;
				}&#xD;
				//CASO 2&#xD;
				else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
				&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA&#xD;
				&amp;&amp; azioneConsDati == &quot;D&quot;&#xD;
				&amp;&amp; operatoreReteConsDati == &quot;FC&quot;&#xD;
				&amp;&amp; (String(localRequest.offerta).slice(0,3) == &quot;ULL&quot;&#xD;
				 || String(localRequest.offerta).slice(0,3) == &quot;SLU&quot;&#xD;
				 || String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;&#xD;
				 || String(localRequest.offerta).slice(0,4) == &quot;VULL&quot;))&#xD;
				{&#xD;
					TipoRiscontro.add(&quot;MIGRAZIONE&quot;);&#xD;
					ConsistenzaDaInviare.add(&quot;CONSISTENZADATI&quot;);&#xD;
					FlagOscuramentoRu1142.add(&quot;R1F-20-0321&quot;);&#xD;
					casoGeneratoFC = true;&#xD;
					&#xD;
					Process.auditLog(&quot;CASO 2&quot;);&#xD;
					Process.auditLog(&quot;TipoRiscontro: &quot;+TipoRiscontro.get(TipoRiscontro.size()-1)+&quot;, ConsistenzaDaInviare: &quot;+ConsistenzaDaInviare.get(ConsistenzaDaInviare.size()-1)+&quot;, FlagOscuramentoRu1142: &quot;+FlagOscuramentoRu1142.get(FlagOscuramentoRu1142.size()-1));	&#xD;
				}&#xD;
				//CASO 3&#xD;
				else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
				&amp;&amp; (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO&#xD;
				 || localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274&#xD;
