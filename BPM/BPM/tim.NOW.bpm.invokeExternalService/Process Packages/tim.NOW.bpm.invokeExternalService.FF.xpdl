              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="95.0" Width="173.0">
                  <xpdl2:Coordinates XCoordinate="210.0" YCoordinate="78.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:ActivityResourcePatterns>
                <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
              </xpdExt:ActivityResourcePatterns>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Initiated">
                  <xpdExt:Information ScriptGrammar="JavaScript">BPM2FFRequest = com_tim_NOW_xsd_BPM2FF_Factory.createBPM2FFRequestType();&#xD;
&#xD;
BPM2FFRequest.richiestaElement = ScriptUtil.copy(RichiestaXSD);&#xD;
BPM2FFRequest.codiceOrdineOperatore = String(localRequest.IDRichiestaOLO);&#xD;
&#xD;
BPM2FFRequest.tipoRiscontro	= com_tim_NOW_xsd_BPM2FF_TipoRiscontroType.get(TipoRiscontro.get(Process.getActivityLoopIndex()));&#xD;
&#xD;
BPM2FFRequest.consistenzaDaInviare = ConsistenzaDaInviare.get(Process.getActivityLoopIndex());&#xD;
BPM2FFRequest.flagOscuramentoRu1142 = FlagOscuramentoRu1142.get(Process.getActivityLoopIndex());&#xD;
&#xD;
Process.auditLog('Invio notifica di '+TipoRiscontro.get(Process.getActivityLoopIndex())+' a FF/FC');&#xD;
&#xD;
if(ManageNotificationDTU != null&#xD;
&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA != null&#xD;
&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null)&#xD;
{&#xD;
	BPM2FFRequest.esitoDTU = String(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CODICE_ESITO);&#xD;
	BPM2FFRequest.causaleEsitoDTU = ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO;&#xD;
	BPM2FFRequest.tipologiaEventoDTU = String(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA);&#xD;
	&#xD;
	if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CODICE_ESITO != com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_CodiceEsitoType._015)&#xD;
	{&#xD;
		BPM2FFRequest.OK_KO = com_tim_NOW_xsd_BPM2FF_OK_KOType.KO;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		BPM2FFRequest.OK_KO = com_tim_NOW_xsd_BPM2FF_OK_KOType.OK;  &#xD;
	}&#xD;
&#xD;
	//RU_801 - mapping verso FF 	&#xD;
	BPM2FFRequest.idRichiestaDTU = ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TRANSACTION_ID;&#xD;
	Process.auditLog('Invio a FF/FC IdRichiestaDTU : '+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TRANSACTION_ID);&#xD;
}&#xD;
&#xD;
//SM_9608&#xD;
if(AnnullamentoAutomatico != null &amp;&amp; AnnullamentoAutomatico)&#xD;
{&#xD;
	BPM2FFRequest.annullamentoAutomatico = AnnullamentoAutomatico;&#xD;
}&#xD;
else&#xD;
{&#xD;
	BPM2FFRequest.annullamentoAutomatico = false;&#xD;
}</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
