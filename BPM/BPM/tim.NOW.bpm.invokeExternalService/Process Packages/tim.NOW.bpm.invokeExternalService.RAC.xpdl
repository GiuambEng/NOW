          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">Esito = String(output.esito);&#xD;
TransactionId = output.transaction_id;&#xD;
ResponseDate = output.response_date;</xpdExt:Information>
