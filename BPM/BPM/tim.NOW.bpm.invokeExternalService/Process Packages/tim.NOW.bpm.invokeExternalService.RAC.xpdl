//input.transactionInfo = wsracweb_type_definitions_RACSendOLOFromNOW_Factory.createTransactionInfoType();&#xD;
//input.transactionInfo.transaction_date&#xD;
//input.transactionInfo.transaction_id</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
