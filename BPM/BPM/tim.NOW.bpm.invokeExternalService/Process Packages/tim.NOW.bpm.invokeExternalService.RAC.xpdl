        <xpdl2:Activity Id="_QjPNEDDjEeeh2o6CuLZHEQ" Name="SetInput" xpdExt:Visibility="Private" xpdExt:DisplayName="Set Input">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">input = com_tim_NOW_xsd_NowToRacService_Factory.createNowToRacRequestType();&#xD;
&#xD;
input.idRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
&#xD;
input.NOWRequest = com_tim_NOW_xsd_NowToRacService_Factory.createNowToRacServiceRequestType();&#xD;
&#xD;
input.NOWRequest.DATA_ESPLETAMENTO = localRequest.ordine.DES;&#xD;
&#xD;
//SM_9883&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIXEDWIRELESSACCESS)&#xD;
{&#xD;
	input.NOWRequest.NUMERO_LINEA = localRequest.IDRisorsa;&#xD;
}&#xD;
else //solito&#xD;
{&#xD;
	input.NOWRequest.NUMERO_LINEA = localRequest.numeroTelefonico;//prefisso e numeto telefonico&#xD;
}&#xD;
&#xD;
input.NOWRequest.SIGLA_OLO = localRequest.codificaOLOAGCOM;// codice olo&#xD;
input.NOWRequest.SERVIZIO = String(localRequest.ordine.offerta);&#xD;
&#xD;
&#xD;
//RU_1111&#xD;
input.NOWRequest.LAVORAZIONE = String(localRequest.lavorazione);&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIXEDWIRELESSACCESS)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOFWA&#xD;
		   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUDATIACCESSO)   //SM_9883&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IMSI)&#xD;
				{&#xD;
					input.NOWRequest.IMSI = attr.valoreAttributo;&#xD;
					Process.auditLog(&quot;IMSI: &quot;+ attr.valoreAttributo +&quot; della componente ACCESSOFWA&quot;);&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MSISDN)&#xD;
				{&#xD;
					input.NOWRequest.MSISDN = attr.valoreAttributo;&#xD;
					Process.auditLog(&quot;MSISDN: &quot;+ attr.valoreAttributo +&quot; della componente ACCESSOFWA&quot;);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//---&#xD;
&#xD;
