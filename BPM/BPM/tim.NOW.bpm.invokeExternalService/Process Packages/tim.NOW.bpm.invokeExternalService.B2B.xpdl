          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">Process.auditLog(&quot;Esito: &quot;+Esito);</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">//Mail Prod: RE: HALTED - TINOWB2BNPDel82FastData/InvioB2BFastData&#xD;
if(ListaDNScartati == null || ListaDNScartati.size()==0)&#xD;
{&#xD;
	var i = 0;&#xD;
&#xD;
	Process.auditLog(&quot;ListaDNScartati VUOTO, inserimento di TUTTI i DN&quot;);&#xD;
&#xD;
	while(i&lt;localRequest.ordine.dettaglioordine.size()) &#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			var j=0;&#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					ListaDNScartati.add(attributo.valoreAttributo);&#xD;
					Process.auditLog(&quot;Inserimento DN Scartato: &quot;+attributo.valoreAttributo);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
