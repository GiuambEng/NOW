        <xpdl2:Activity Id="_xY58RG_qEeiHvo80-cwAeA" Name="OscuramentoCVLANID" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Oscuramento CVLAN ID">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo superato&quot;;&#xD;
&#xD;
&#xD;
if ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB ||&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH ||&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH) &amp;&amp;        //RU_1164&#xD;
localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &amp;&amp;&#xD;
localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
{&#xD;
		var failed = false;&#xD;
		var i=0;&#xD;
		while (!failed &amp;&amp; i&lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettaglio = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if (currentDettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{&#xD;
				var j=0;&#xD;
				while (!failed &amp;&amp; j&lt;currentDettaglio.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
				&#xD;
					var currentAttributo = currentDettaglio.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
					{&#xD;
						failed = true;&#xD;
					&#xD;
					}&#xD;
				j++;&#xD;
				}&#xD;
			}&#xD;
		i++;&#xD;
		}&#xD;
		&#xD;
	if (failed)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Controllo Fallito - trovata variazione CVLANID&quot;;&#xD;
	&#xD;
	}&#xD;
&#xD;
}&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
