			{&#xD;
				consistenzaDativc.IDRISORSAVC = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC)&#xD;
			{&#xD;
				consistenzaDativc.TIPOPROFILOVC = currentAttDettAsset.valoreAttributo;&#xD;
