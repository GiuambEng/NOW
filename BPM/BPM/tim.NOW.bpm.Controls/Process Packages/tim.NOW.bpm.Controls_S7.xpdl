    <xpdl2:WorkflowProcess Id="_AwayQmC_EeeWg8ZMNt0upg" xpdExt:DisplayName="CTRL CONGR VLAN CONTR_C04M01F203" Name="CTRLCONGRVLANCONTR_C04M01F203">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_AwayQ2C_EeeWg8ZMNt0upg" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_AwayQWC_EeeWg8ZMNt0upg" Width="31.0">
              <xpdl2:Coordinates XCoordinate="573.0" YCoordinate="170.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_AwayRWC_EeeWg8ZMNt0upg" Name="VerificacongruenzaVLANCONTRATTO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica congruenza VLAN CONTRATTO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per eseguire il controllo&quot;;&#xD;
&#xD;
var operatore = &quot;&quot;;&#xD;
operatore = null;&#xD;
&#xD;
//SM_9613&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;MIGRAZIONE ACCORPAMENTOOLO - controllo saltato&quot;;&#xD;
}&#xD;
else if(EsistenzaVLANOutput != null &amp;&amp; EsistenzaVLANOutput.size() > 0)&#xD;
{&#xD;
	var match = true;&#xD;
	var i = 0;&#xD;
	while(match &amp;&amp; i &lt; EsistenzaVLANOutput.size())&#xD;
	{&#xD;
		var currentVLAN = EsistenzaVLANOutput.get(i);&#xD;
	  	&#xD;
	  	Process.auditLog(&quot;Operatore: &quot; + currentVLAN.codiceOperatoreRete);&#xD;
	  	&#xD;
	  	if(i == 0)&#xD;
	  	{&#xD;
	  		operatore = currentVLAN.codiceOperatoreRete;&#xD;
	  	}&#xD;
	  	else&#xD;
	  	{&#xD;
	  		if(operatore != currentVLAN.codiceOperatoreRete)&#xD;
	  		{&#xD;
	  			match = false;&#xD;
	  			Process.auditLog(&quot;Codice operatore differete&quot;);&#xD;
	  		}&#xD;
	  	}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(match)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Tutti gli ID OPERATORE DI RETE sono uguali&quot;;&#xD;
	}&#xD;
	&#xD;
	else &#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Gli OPERATORE DI RETE non sono uguali&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
