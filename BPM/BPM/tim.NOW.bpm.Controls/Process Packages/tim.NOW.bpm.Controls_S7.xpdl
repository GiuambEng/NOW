          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_QEE08T_CEee7YeExe1Se8g" Width="31.0">
              <xpdl2:Coordinates XCoordinate="767.0" YCoordinate="265.0"/>
