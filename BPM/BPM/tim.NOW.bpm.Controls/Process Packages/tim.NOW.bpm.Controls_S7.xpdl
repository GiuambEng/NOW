        <xpdl2:Activity Id="_VJgc5zsQEeeu6LtkoNtDtA" Name="VerificaEsistenzaDLCI" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Esistenza DLCI" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per eseguire il controllo&quot;;&#xD;
&#xD;
var dlciRichiesta = DataUtil.createList();&#xD;
var dlciAsset = DataUtil.createList();&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
	{&#xD;
		var add = false;&#xD;
		&#xD;
		if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
		{&#xD;
			if(currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
			{&#xD;
				add = true;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			add = true;&#xD;
		}&#xD;
		&#xD;
		if(add)&#xD;
		{&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI)&#xD;
				{&#xD;
					dlciRichiesta.add(currentAttDettOrdine.valoreAttributo);&#xD;
					Process.auditLog(&quot;Trovato DLCI in Richiesta: &quot; + currentAttDettOrdine.valoreAttributo);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: IDR AND statoAsset &lt;> 'CESSATO'&quot;);&#xD;
criteria.setQueryParameter(&quot;IDR&quot;,localRequest.IDRisorsa);&#xD;
&#xD;
var refs = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
&#xD;
if(refs!= null &amp;&amp; refs.size() > 0)&#xD;
{&#xD;
	AssetRef = refs.get(0);&#xD;
	Asset = AssetRef.readAsset();&#xD;
}&#xD;
&#xD;
if(Asset != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
		if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
		{&#xD;
			for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI)&#xD;
				{&#xD;
					dlciAsset.add(currentAttDettAsset.valoreAttributo);&#xD;
					Process.auditLog(&quot;Trovato DLCI in Asset: &quot; + currentAttDettAsset.valoreAttributo);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
var failed = false;&#xD;
var i = 0;&#xD;
&#xD;
while(!failed &amp;&amp; i &lt; dlciRichiesta.size())&#xD;
{&#xD;
	if(!dlciAsset.contains(dlciRichiesta.get(i)))&#xD;
	{&#xD;
		failed = true;&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ESISTENZA DLCI fallito. Trovato un DLCI nella richiesta assente in Asset&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ESISTENZA DLCI positivo. Tutti i DLCI nell richiesta presenti in Asset&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
