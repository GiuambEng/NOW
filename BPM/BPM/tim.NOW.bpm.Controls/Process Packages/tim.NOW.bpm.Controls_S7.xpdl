              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//SM_11255: nuovo controllo C04M01F510&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo skippato - Offerte diverse da EASYIPNGA&quot;;&#xD;
&#xD;
if(ConsistenzaDati != null &#xD;
	&amp;&amp; (ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPNGAFTTCAB &#xD;
	     || ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPNGAFTTH)  &#xD;
	&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)     &#xD;
{&#xD;
	if(LavorazioneRichiesta != null)&#xD;
	{	&#xD;
		if (LavorazioneRichiesta.migrazioneIntraOlo == &quot;NO&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Controllo migrazione EasyIP UBB superato&quot;;&#xD;
		}		&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Controllo migrazione EasyIP UBB NON superato - MigrazioneIntraOLO = SI&quot;;&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
