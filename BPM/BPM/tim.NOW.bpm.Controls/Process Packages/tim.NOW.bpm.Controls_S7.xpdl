                <xpdExt:PortTypeOperation PortTypeName="BPM_CheckServiceFormaliPortType" OperationName="VerificaOverbookingVCSimmetrico">
                  <xpdExt:ExternalReference location="BPM_CheckServiceFormali_v1.wsdl"/>
