          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo=true;&#xD;
&#xD;
&#xD;
if (localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT &amp;&amp;&#xD;
	localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL)&#xD;
{&#xD;
	EseguiControllo= false;&#xD;
}&#xD;
&#xD;
if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &amp;&amp; &#xD;
	EseguiControllo)&#xD;
{&#xD;
	&#xD;
		var trovatoDecremento = false;&#xD;
		var trovatoIncremento =false;&#xD;
		var i=0;&#xD;
		while((!trovatoDecremento || !trovatoIncremento) &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		 {&#xD;
		 	var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		 	&#xD;
		 	if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
		 		{&#xD;
		 			if(currentDettaglioOrdine.azione != it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		 			{&#xD;
		 				 trovatoIncremento=true;&#xD;
		 			}&#xD;
		 			&#xD;
		 			else &#xD;
		 			{&#xD;
		 				 trovatoDecremento = true;&#xD;
		 			}&#xD;
		 		}&#xD;
		 i++;&#xD;
		 }&#xD;
		 &#xD;
		 if (trovatoDecremento &amp;&amp; !trovatoIncremento)&#xD;
		 {&#xD;
		 	EseguiControllo= false;&#xD;
		 }&#xD;
	&#xD;
}</xpdl2:Script>
