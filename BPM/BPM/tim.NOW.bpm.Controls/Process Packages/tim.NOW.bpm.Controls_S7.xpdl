        <xpdl2:Transition Id="_4IP5kDyCEee0nvs4D2Etvw" xpdExt:DisplayName="" Name="" From="_1h8lsDyCEee0nvs4D2Etvw" To="_3b-pcTyCEee0nvs4D2Etvw">
          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var skip = false;&#xD;
var foundTipoBanda = false;&#xD;
var foundTipoBandaDedicata = false;&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	//While none TIPOBANDACONSEGNA equal to DEDICATA keep to loop&#xD;
	while(!foundTipoBandaDedicata &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		foundTipoBanda = false;&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(!foundTipoBanda &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDACONSEGNA)&#xD;
				{&#xD;
					foundTipoBanda = true;&#xD;
					&#xD;
					if(currentAttDettOrdine.valoreAttributo == &quot;DEDICATA&quot;)&#xD;
					{&#xD;
						//Found TIPOBANDACONSEGNA DEDICATA&#xD;
						foundTipoBandaDedicata = true;&#xD;
					}&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!foundTipoBandaDedicata)&#xD;
{&#xD;
	skip = true;&#xD;
}&#xD;
&#xD;
skip;</xpdl2:Expression>
</xpdl2:Condition>
