  <xpdl2:WorkflowProcesses>
    <xpdl2:WorkflowProcess Id="_OPYgMDsMEeeu6LtkoNtDtA" xpdExt:XpdModelType="ServiceProcess" xpdExt:DisplayName="CTRL INTERFACCIA MODEM_C04M01F150" Name="CTRLINTERFACCIAMODEM_C04M01F150">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_sgPksTsOEeeu6LtkoNtDtA" xpdExt:DisplayName="CodiceEsito" Name="CodiceEsito">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
