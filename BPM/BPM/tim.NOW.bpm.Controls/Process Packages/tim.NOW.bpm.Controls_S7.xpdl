    </xpdl2:WorkflowProcess>
    <xpdl2:WorkflowProcess Id="_k_V7cEBmEeeykrgPLWVm3g" xpdExt:DisplayName="CTRL RICHIESTA MONITORAGGIO_C04M01F161" Name="CTRLRICHIESTAMONITORAGGIO_C04M01F161">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_siHy82VeEeeFLuxKJU-nxw" xpdExt:DisplayName="EseguiControllo" Name="EseguiControllo" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="BOOLEAN"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_5hLQQFefEemPNOWwLbBBJg" xpdExt:DisplayName="Asset" Name="Asset" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_6Hx9QFefEemPNOWwLbBBJg" xpdExt:DisplayName="AssetRef" Name="AssetRef" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_k_XwpkBmEeeykrgPLWVm3g" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_k_V7ckBmEeeykrgPLWVm3g" Width="31.0">
              <xpdl2:Coordinates XCoordinate="872.0" YCoordinate="291.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_k_Xwp0BmEeeykrgPLWVm3g" Name="VerificaRichiestaMonitoraggio" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Richiesta Monitoraggio" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
if(localRequest.codiceProgetto == null)&#xD;
{&#xD;
	localRequest.codiceProgetto = &quot;OLO0909MON&quot;;&#xD;
	localRequest.ordine.codiceProgetto = localRequest.codiceProgetto;&#xD;
}&#xD;
&#xD;
//Recupero asset&#xD;
if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaDati.IDAsset));&#xD;
	Asset = AssetRef.readAsset();&#xD;
}&#xD;
&#xD;
var failed = false;&#xD;
var i=0;&#xD;
&#xD;
while(!failed &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
	{	&#xD;
		//Recupero valori degli attributi&#xD;
		var RichiestaMonitoraggio = &quot;&quot;;&#xD;
		RichiestaMonitoraggio = null;		&#xD;
		var foundMCR = false;&#xD;
		var foundPCR = false;&#xD;
		var foundSCR = false;		&#xD;
		var tipoBandaConsegna = &quot;&quot;;&#xD;
		tipoBandaConsegna = null;&#xD;
		var foundTDCode = false;&#xD;
		var foundVPCode = false;&#xD;
		var IDProfiloVCOrdine = &quot;&quot;;&#xD;
		IDProfiloVCOrdine = null;&#xD;
		var VCIOrdine = &quot;&quot;;&#xD;
		VCIOrdine = null;&#xD;
		var VPIOrdine = &quot;&quot;;&#xD;
		VPIOrdine = null;&#xD;
		var DLCIOrdine = &quot;&quot;;&#xD;
		DLCIOrdine = null;		&#xD;
	&#xD;
		for(var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRDOWN&#xD;
					|| currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRUP)&#xD;
			{&#xD;
				foundMCR = true;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRDOWN&#xD;
					|| currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRUP)&#xD;
			{&#xD;
				foundPCR = true;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SCRDOWN&#xD;
					|| currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SCRUP)&#xD;
			{&#xD;
				foundSCR = true;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDACONSEGNA)&#xD;
			{&#xD;
				tipoBandaConsegna = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETD)&#xD;
			{&#xD;
				foundTDCode = true;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEVP)&#xD;
			{&#xD;
				foundVPCode = true;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDPROFILOVC) &#xD;
			{&#xD;
				IDProfiloVCOrdine = currentAttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato ID Profilo VC da Ordine: &quot;+IDProfiloVCOrdine);&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI) &#xD;
			{&#xD;
				VCIOrdine = currentAttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato VCI da Ordine: &quot;+VCIOrdine);&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI) &#xD;
			{&#xD;
				VPIOrdine = currentAttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato VPI da Ordine: &quot;+VPIOrdine);&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI) &#xD;
			{&#xD;
				DLCIOrdine = currentAttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato DLCI da Ordine: &quot;+DLCIOrdine);&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RICHIESTAMONITORAGGIO)&#xD;
			{&#xD;
				RichiestaMonitoraggio = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//Ciclo solo su quelle con RichiestaMonitoraggio = SI&#xD;
		if(RichiestaMonitoraggio != null &amp;&amp; RichiestaMonitoraggio == &quot;SI&quot;)&#xD;
		{		&#xD;
			//Recupero ATMVC corrispondente in asset&#xD;
			if(Asset != null)&#xD;
			{&#xD;
				for(var m=0; m&lt;Asset.dettaglioasset.size(); m++)&#xD;
				{&#xD;
					var componenteAsset = Asset.dettaglioasset.get(m);&#xD;
					&#xD;
					if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
					{			&#xD;
						var IDProfiloVCAsset = &quot;&quot;;&#xD;
						IDProfiloVCAsset = null;&#xD;
						var VPIAsset = &quot;&quot;;&#xD;
						VPIAsset = null;&#xD;
						var VCIAsset = &quot;&quot;;&#xD;
						VCIAsset = null;&#xD;
						var DLCIAsset = &quot;&quot;;&#xD;
						DLCIAsset = null;					&#xD;
						&#xD;
						for(var t=0; t&lt;componenteAsset.attributidettaglioasset.size(); t++)&#xD;
						{&#xD;
							var attributoAsset = componenteAsset.attributidettaglioasset.get(t);&#xD;
							&#xD;
							if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDPROFILOVC)&#xD;
							{&#xD;
								IDProfiloVCAsset = attributoAsset.valoreAttributo;&#xD;
							}&#xD;
							else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
							{&#xD;
								VPIAsset = attributoAsset.valoreAttributo;&#xD;
								Process.auditLog(&quot;Trovato VPI da Asset: &quot;+VPIAsset);&#xD;
							}	&#xD;
							else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
							{&#xD;
								VCIAsset = attributoAsset.valoreAttributo;&#xD;
								Process.auditLog(&quot;Trovato VCI da Asset: &quot;+VCIAsset);&#xD;
							}&#xD;
							else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI)&#xD;
							{&#xD;
								DLCIAsset = attributoAsset.valoreAttributo;&#xD;
								Process.auditLog(&quot;Trovato DLCI da Asset: &quot;+DLCIAsset);&#xD;
							}							&#xD;
						}&#xD;
						&#xD;
						//Individuo la corrispondente componente in asset&#xD;
						if((VPIOrdine != null &amp;&amp; VCIOrdine != null &amp;&amp; VPIAsset != null &amp;&amp; VCIAsset != null&#xD;
									&amp;&amp; VPIOrdine == VPIAsset &amp;&amp; VCIOrdine == VCIAsset)&#xD;
							   ||&#xD;
							   (DLCIOrdine != null &amp;&amp; DLCIAsset != null &amp;&amp; DLCIOrdine == DLCIAsset))&#xD;
						{&#xD;
						   if((foundMCR || foundPCR || foundSCR) &amp;&amp; (IDProfiloVCAsset == null || IDProfiloVCOrdine != IDProfiloVCAsset)) // SM_8367: se il profilo VC non viene variato, non considero la presenza di MCR/PCR/SCR per scartare&#xD;
							{&#xD;
								failed = true;&#xD;
								EsitoResponse.descrizione = &quot;CTRL RICHIESTA MONITORAGGIO fallito per ATMVC con IDDettaglioOrdine: &quot; + i + &quot; Trovati MCR, PCR o SCR&quot;;&#xD;
							}&#xD;
							else if(tipoBandaConsegna == null)&#xD;
							{&#xD;
								failed = true;&#xD;
								EsitoResponse.descrizione = &quot;CTRL RICHIESTA MONITORAGGIO fallito per ATMVC con IDDettaglioOrdine: &quot; + i + &quot; TIPOBANDACONSEGNA non trovato&quot;;&#xD;
							}&#xD;
							else if(tipoBandaConsegna.toUpperCase() == &quot;DEDICATA&quot;)&#xD;
							{&#xD;
								if(!foundTDCode)&#xD;
								{&#xD;
									failed = true;&#xD;
									EsitoResponse.descrizione = &quot;CTRL RICHIESTA MONITORAGGIO fallito per ATMVC con IDDettaglioOrdine: &quot; + i + &quot; CODICETD non trovato per bandaconsegna DEDICATA&quot;;&#xD;
								}&#xD;
							}&#xD;
							else if(tipoBandaConsegna.toUpperCase() == &quot;CONDIVISA&quot;)&#xD;
							{&#xD;
								if(!foundVPCode)&#xD;
								{&#xD;
									failed = true;&#xD;
									EsitoResponse.descrizione = &quot;CTRL RICHIESTA MONITORAGGIO fallito per ATMVC con IDDettaglioOrdine: &quot; + i + &quot; CODICEVP non trovato per bandaconsegna CONDIVISA&quot;;&#xD;
								}&#xD;
							}&#xD;
							else&#xD;
							{&#xD;
								failed = true;&#xD;
								EsitoResponse.descrizione = &quot;CTRL RICHIESTA MONITORAGGIO fallito per ATMVC con IDDettaglioOrdine: &quot; + i + &quot; valore TIPOBANDACONSEGNA non riconosciuto: &quot; + tipoBandaConsegna;&#xD;
							}&#xD;
						}	&#xD;
					}	&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL RICHIESTA MONITORAGGIO positivo.&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="101.0" LaneId="_k_V7ckBmEeeykrgPLWVm3g" Width="147.0">
              <xpdl2:Coordinates XCoordinate="659.0" YCoordinate="291.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_QaGgUUBnEeeykrgPLWVm3g" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_n43GQEBmEeeykrgPLWVm3g" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="52.0" LaneId="_k_V7ckBmEeeykrgPLWVm3g" Width="73.0">
              <xpdl2:Coordinates XCoordinate="93.0" YCoordinate="291.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_siHy8mVeEeeFLuxKJU-nxw" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = false;&#xD;
&#xD;
// SM_8367: anticipata precondizione su RICHIESTAMONITORAGGIO (prima il check di questo attributo era nello script successivo&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT ||&#xD;
	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL) &amp;&amp;&#xD;
	localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	var i = 0;&#xD;
&#xD;
	var richiestaMonitoraggio = false;&#xD;
	&#xD;
	while(!richiestaMonitoraggio &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
		{&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RICHIESTAMONITORAGGIO)&#xD;
				{&#xD;
					richiestaMonitoraggio = true;&#xD;
					Process.auditLog(&quot;Trovata richiestaMonitoraggio con valore &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
					&#xD;
					if(currentAttDettOrdine.valoreAttributo == &quot;SI&quot;)&#xD;
					{&#xD;
						EseguiControllo = true;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_k_V7ckBmEeeykrgPLWVm3g" Width="96.0">
