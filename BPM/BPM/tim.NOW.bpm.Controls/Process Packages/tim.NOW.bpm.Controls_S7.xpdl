            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaCongruenzaProtocolloRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaCongruenzaProtocollo_ProfiloTecnicoLinea_RequestType();&#xD;
&#xD;
VerificaCongruenzaProtocolloRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaCongruenzaProtocolloRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
VerificaCongruenzaProtocolloRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
&#xD;
var i = 0;&#xD;
while((VerificaCongruenzaProtocolloRequest.tipoProtocollo == null || VerificaCongruenzaProtocolloRequest.profiloTecnicoLinea == null) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PROTOCOLLO)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(VerificaCongruenzaProtocolloRequest.tipoProtocollo == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROTOCOLLO)&#xD;
			{&#xD;
				VerificaCongruenzaProtocolloRequest.tipoProtocollo = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	else if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(VerificaCongruenzaProtocolloRequest.profiloTecnicoLinea == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
			{&#xD;
				VerificaCongruenzaProtocolloRequest.profiloTecnicoLinea = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE){&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaDati.IDAsset));&#xD;
	var asset = AssetRef.readAsset();&#xD;
	&#xD;
	var protocolloTrovato = false;&#xD;
	var i=0;&#xD;
	while(!protocolloTrovato &amp;&amp; i&lt;asset.dettaglioasset.size()){&#xD;
		var componenteAsset = asset.dettaglioasset.get(i);&#xD;
		if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PROTOCOLLO){&#xD;
			var j=0;&#xD;
			while(!protocolloTrovato &amp;&amp; j&lt;componenteAsset.attributidettaglioasset.size()){&#xD;
				var attrAsset = componenteAsset.attributidettaglioasset.get(j);&#xD;
				if(attrAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROTOCOLLO){&#xD;
					VerificaCongruenzaProtocolloRequest.tipoProtocollo = attrAsset.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}</xpdExt:Information>
