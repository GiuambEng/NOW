          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var foundCodiceProgetto = false;&#xD;
var foundDisaggregazione = false;&#xD;
&#xD;
if (localRequest.codiceProgetto!= null &amp;&amp; localRequest.codiceProgetto!= &quot;&quot;)&#xD;
{&#xD;
	foundCodiceProgetto= true;&#xD;
}&#xD;
&#xD;
var i=0;&#xD;
&#xD;
while (!foundDisaggregazione &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	if (currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE)&#xD;
	{&#xD;
		&#xD;
		for (var j=0; j&lt;currentComponente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAtt = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
			if (currentAtt.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SYSTEMUNICO)&#xD;
			{&#xD;
				SystemUnico = currentAtt.valoreAttributo;&#xD;
			}&#xD;
		&#xD;
		}&#xD;
		foundDisaggregazione = true;&#xD;
	&#xD;
	}&#xD;
&#xD;
i++;&#xD;
}&#xD;
&#xD;
// RU_968, aggiunto || localRequest.disaggregato == 'S'&#xD;
if (foundDisaggregazione &amp;&amp; (!foundCodiceProgetto || localRequest.disaggregato == 'S'))&#xD;
{&#xD;
	EseguiControllo = true;&#xD;
}&#xD;
else &#xD;
{&#xD;
	EseguiControllo = false;&#xD;
}</xpdl2:Script>
