    <xpdl2:WorkflowProcess Id="_yuAk8iLxEeia-6-9GtEeKw" xpdExt:DisplayName="CTRL TIPO SERVIZIO SG_C04M01F205" Name="CTRLTIPOSERVIZIOSG_C04M01F205">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_yuAk8yLxEeia-6-9GtEeKw" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_yuAk8SLxEeia-6-9GtEeKw" Width="31.0">
              <xpdl2:Coordinates XCoordinate="700.0" YCoordinate="166.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_yuAk9CLxEeia-6-9GtEeKw" Name="VerificaTipoServiziodaUNICA" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Tipo Servizio da UNICA">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice=true;&#xD;
EsitoResponse.descrizione = &quot;Controllo Verifica Tipo Servizio da Unica superato&quot; ;&#xD;
&#xD;
if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
|| localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274)&#xD;
{&#xD;
&#xD;
&#xD;
	if (RecuperaTipoNumeroResponse.recuperaTipoNumOutput!= null &amp;&amp; RecuperaTipoNumeroResponse.recuperaTipoNumOutput.size()>0)&#xD;
	{&#xD;
		var i=0;&#xD;
		var ControlloFallito = false;&#xD;
		while (!ControlloFallito &amp;&amp; i&lt;RecuperaTipoNumeroResponse.recuperaTipoNumOutput.size())&#xD;
		{&#xD;
			var currentLinea = RecuperaTipoNumeroResponse.recuperaTipoNumOutput.get(i);&#xD;
			&#xD;
			if ((currentLinea.flag_Attivo == &quot;N&quot; &amp;&amp; (currentLinea.tipo_Portabilita== &quot;DONOR&quot; || currentLinea.tipo_Portabilita== &quot;NAKED&quot;) &amp;&amp; currentLinea.tipoServizio == &quot;NULL&quot; )&#xD;
			|| currentLinea.tipoServizio != &quot;NULL&quot;)&#xD;
			{&#xD;
				ControlloFallito = false;&#xD;
				&#xD;
			}&#xD;
			else &#xD;
			{&#xD;
				ControlloFallito=true;&#xD;
				EsitoResponse.codice=false;&#xD;
				EsitoResponse.descrizione = &quot;Controllo Verifica Tipo Servizio da Unica fallito - RecuperaTipoNumeroResponse non valorizzato&quot; ;&#xD;
				&#xD;
			}&#xD;
		i++;&#xD;
		}&#xD;
		&#xD;
	}&#xD;
	&#xD;
	else &#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Controllo Verifica Tipo Servizio da UNICA fallito&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
