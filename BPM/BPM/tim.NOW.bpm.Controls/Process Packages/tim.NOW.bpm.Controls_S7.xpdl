        <xpdl2:Activity Id="_lgMrRzyAEee0nvs4D2Etvw" Name="VerificaKITSubcontractor" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica KIT Subcontractor" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per eseguire il controllo&quot;;&#xD;
&#xD;
var subcontractor = false;&#xD;
var i = 0;&#xD;
&#xD;
while(!subcontractor &amp;&amp; i &lt; EsistenzaKITOutput.size())&#xD;
{&#xD;
	var currentEsistenzaKIT = EsistenzaKITOutput.get(i);&#xD;
	&#xD;
	if(currentEsistenzaKIT.SUBCONTRACTOR == &quot;Y&quot;)&#xD;
	{&#xD;
		subcontractor = true;&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(subcontractor)&#xD;
{&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL KIT SUBCONTRACTOR positivo. SUBCONTRACTOR valorizzato ad Y ed OFFERTA FLAT&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL KIT SUBCONTRACTOR negativo. SUBCONTRACTOR valorizzato ad Y ed OFFERTA NON FLAT&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL KIT SUBCONTRACTOR positivo. Nessun SUBCONTRACTOR valorizzato ad Y trovato&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
