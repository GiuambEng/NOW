          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">MaxVCRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaNumeroMaxVCRequestType();&#xD;
&#xD;
MaxVCRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
MaxVCRequest.lavorazione = String(localRequest.lavorazione);&#xD;
&#xD;
if(localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE){&#xD;
	MaxVCRequest.offerta = String(localRequest.offerta);&#xD;
}&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &amp;&amp;&#xD;
	ConsistenzaDati != null)&#xD;
{	&#xD;
	MaxVCRequest.offerta = String(ConsistenzaDati.offerta);&#xD;
	MaxVCRequest.idAsset = ConsistenzaDati.IDAsset;&#xD;
	MaxVCRequest.profiloTecnocoLinea = ConsistenzaDati.profiloTecnicoLinea;&#xD;
	&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
		&amp;&amp; String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(MaxVCRequest.profiloTecnocoLinea == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
			{&#xD;
				MaxVCRequest.profiloTecnocoLinea = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
	{&#xD;
		var vc = com_tim_NOW_xsd_ControlliFormali_Factory.createVCType();&#xD;
		&#xD;
		vc.azioneVC = String(currentDettOrdine.azione);&#xD;
		&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
			{&#xD;
				vc.VCI = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
			{&#xD;
				vc.VPI = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI)&#xD;
			{&#xD;
				vc.DLCI = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRUP)&#xD;
			{&#xD;
				vc.MCR = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRUP)&#xD;
			{&#xD;
				vc.PCR = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SCRUP)&#xD;
			{&#xD;
				vc.SCR = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC)&#xD;
			{&#xD;
				vc.profiloVC = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		MaxVCRequest.VC.add(ScriptUtil.copy(vc));&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
