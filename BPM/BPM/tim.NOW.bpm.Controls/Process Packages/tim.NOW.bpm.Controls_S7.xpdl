		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL VERIFICA OPERATORE DI RETE positivo&quot;;&#xD;
		}&#xD;
	else &#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL VERIFICA OPERATORE DI RETE fallito - CodiceOperatoreRete valorizzato&quot;;&#xD;
		}&#xD;
}	</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
