        <xpdl2:Activity Id="_twVwlRCnEeiHrJD0ClRz7A" Name="VerificavariazioniEIPUBB" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica variazioni EIPUBB">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per eseguire il controllo&quot;;&#xD;
&#xD;
if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB || &#xD;
	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH ||&#xD;
	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)  //RU_1164&#xD;
{&#xD;
 	var i=0;&#xD;
 	var foundProfiloTecnicoLinea = false;&#xD;
 	var foundModalitaConsegna = false;&#xD;
 	&#xD;
 	while ((!foundModalitaConsegna || !foundProfiloTecnicoLinea) &amp;&amp; i&lt; localRequest.ordine.dettaglioordine.size())&#xD;
 	{&#xD;
 		var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
 		&#xD;
 		if (String(currentComponente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
 		{&#xD;
 			for (var j=0; j&lt; currentComponente.attributiDettaglioOrdine.size(); j++)&#xD;
 			{&#xD;
 				var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
 				&#xD;
 				if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
 				{	&#xD;
 					foundProfiloTecnicoLinea= true;&#xD;
 				}&#xD;
 				else if ( currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MODALITACONSEGNA)&#xD;
 				{&#xD;
 					foundModalitaConsegna= true;&#xD;
 				}&#xD;
 			&#xD;
 			}&#xD;
 		&#xD;
 		}&#xD;
 	&#xD;
 	i++;&#xD;
 	}&#xD;
 	&#xD;
 	if ((!foundModalitaConsegna &amp;&amp; foundProfiloTecnicoLinea) || (foundModalitaConsegna &amp;&amp; !foundProfiloTecnicoLinea))&#xD;
 	{&#xD;
 		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Controllo variazione EASYIPUBB superato&quot;;&#xD;
 	}&#xD;
 	&#xD;
 	else&#xD;
 	{&#xD;
 		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Controllo variazione EASYIPUBB fallito - presente doppia variazione&quot;;&#xD;
 	}&#xD;
 	&#xD;
&#xD;
}&#xD;
else&#xD;
{&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo skippato - Offerte diverse da EASYIPNGA&quot;;&#xD;
&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
