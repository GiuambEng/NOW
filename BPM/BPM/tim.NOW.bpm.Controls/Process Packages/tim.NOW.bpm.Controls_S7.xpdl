        <xpdl2:Activity Id="_SGjDUmVvEeeFLuxKJU-nxw" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo=true;&#xD;
&#xD;
&#xD;
if (localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)&#xD;
{&#xD;
	EseguiControllo= false;&#xD;
}&#xD;
&#xD;
if (EseguiControllo)&#xD;
{&#xD;
	&#xD;
		var trovato = false;&#xD;
		var i=0;&#xD;
		while (!trovato &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		 {&#xD;
		 	var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		 	&#xD;
		 	if( currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp;&#xD;
		 		currentDettaglioOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D )&#xD;
		 		{&#xD;
		 			trovato = true;&#xD;
		 		}&#xD;
		 i++;&#xD;
		 }&#xD;
		 &#xD;
		 if (!trovato)&#xD;
		 {&#xD;
		 	EseguiControllo= false;&#xD;
		 }&#xD;
	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
