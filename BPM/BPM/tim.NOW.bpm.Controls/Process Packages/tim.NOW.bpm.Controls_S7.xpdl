        <xpdl2:Transition Id="_a2YqkDyZEee0nvs4D2Etvw" xpdExt:DisplayName="" Name="" From="_LJ_YQDybEee0nvs4D2Etvw" To="_Suf9dzyZEee0nvs4D2Etvw">
          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var protocollo = &quot;&quot;;&#xD;
protocollo = null;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PROTOCOLLO)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROTOCOLLO)&#xD;
			{&#xD;
				protocollo = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(protocollo == &quot;FR&quot;)&#xD;
{&#xD;
	true;&#xD;
}&#xD;
else&#xD;
{&#xD;
	false;&#xD;
}</xpdl2:Expression>
</xpdl2:Condition>
