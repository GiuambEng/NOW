              <xpdExt:Information ScriptGrammar="JavaScript">VerificaVariazioneAttributoRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerifica_Var_Attributo_Caratt_SIM_RequestType();&#xD;
&#xD;
VerificaVariazioneAttributoRequest.CONSISTENZADATI = com_tim_NOW_xsd_ControlliFormali_Factory.createCONSISTENZADATIType();&#xD;
VerificaVariazioneAttributoRequest.CONSISTENZADATI.idAsset = ConsistenzaDati.IDAsset;&#xD;
VerificaVariazioneAttributoRequest.CONSISTENZADATI.offerta = String(ConsistenzaDati.offerta);&#xD;
VerificaVariazioneAttributoRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaVariazioneAttributoRequest.caratteristica = localRequest.caratteristica;&#xD;
&#xD;
var modulazioneRichiesta = &quot;&quot;;&#xD;
var profiloTecnicoLineaRichiesta = &quot;&quot;;&#xD;
modulazioneRichiesta = null;&#xD;
profiloTecnicoLineaRichiesta = null;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
