              <xpdl2:Length>500</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_OPf09DsMEeeu6LtkoNtDtA" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="52.0" LaneId="_OPYgMjsMEeeu6LtkoNtDtA" Width="31.0">
              <xpdl2:Coordinates XCoordinate="1082.0" YCoordinate="249.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_OPf09TsMEeeu6LtkoNtDtA" Name="VerificaInterfacciaModem" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Interfaccia Modem">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per eseguire il controllo&quot;;&#xD;
&#xD;
var profiloTecnicoLinea = &quot;&quot;;&#xD;
profiloTecnicoLinea = null;&#xD;
var interfaccia = &quot;&quot;;&#xD;
interfaccia = null;&#xD;
&#xD;
var i = 0;&#xD;
while((profiloTecnicoLinea == null || interfaccia == null) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while((profiloTecnicoLinea == null || interfaccia == null) &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
			{&#xD;
				profiloTecnicoLinea = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INTERFACCIA)&#xD;
			{&#xD;
				interfaccia = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
var failed = false;&#xD;
&#xD;
if((profiloTecnicoLinea == &quot;L5&quot; || profiloTecnicoLinea == &quot;L7&quot;) &amp;&amp; interfaccia == null)&#xD;
{&#xD;
	failed = true;&#xD;
	CodiceEsito = &quot;KO_01&quot;;&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL INTERFACCIA MODEM fallito. Interfaccia non valorizzata ma trovato profiloTecnicoLinea con valore: &quot; + profiloTecnicoLinea;&#xD;
}&#xD;
&#xD;
if(!failed &amp;&amp; interfaccia != null)&#xD;
{&#xD;
	if(profiloTecnicoLinea == &quot;L1&quot;&#xD;
		|| profiloTecnicoLinea == &quot;L3&quot;&#xD;
		|| profiloTecnicoLinea == &quot;L5&quot;&#xD;
		|| profiloTecnicoLinea == &quot;L7&quot;)&#xD;
	{&#xD;
		if(interfaccia != &quot;4&quot;)&#xD;
		{&#xD;
			failed = true;&#xD;
			CodiceEsito = &quot;KO_02&quot;;&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL INTERFACCIA MODEM fallito. Trovato profiloTecnicoLinea con valore: &quot; + profiloTecnicoLinea + &quot; e Interfaccia con valore: &quot; + interfaccia;&#xD;
		}&#xD;
	}&#xD;
	else if(profiloTecnicoLinea == &quot;L&quot;&#xD;
		|| profiloTecnicoLinea == &quot;L2&quot;&#xD;
		|| profiloTecnicoLinea == &quot;L4&quot;&#xD;
		|| profiloTecnicoLinea == &quot;L6&quot;&#xD;
		|| profiloTecnicoLinea == &quot;N&quot;&#xD;
		|| profiloTecnicoLinea == &quot;N1&quot;&#xD;
		|| profiloTecnicoLinea == &quot;N2&quot;&#xD;
		|| profiloTecnicoLinea == &quot;N3&quot;)&#xD;
	{&#xD;
		if(interfaccia != &quot;6&quot;)&#xD;
		{&#xD;
			failed = true;&#xD;
			CodiceEsito = &quot;KO_02&quot;;&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL INTERFACCIA MODEM fallito. Trovato profiloTecnicoLinea con valore: &quot; + profiloTecnicoLinea + &quot; e Interfaccia con valore: &quot; + interfaccia;&#xD;
		}&#xD;
	}&#xD;
	else if(profiloTecnicoLinea == &quot;O&quot;&#xD;
		|| profiloTecnicoLinea == &quot;O1&quot;)&#xD;
	{&#xD;
		if(interfaccia != &quot;7&quot;)&#xD;
		{&#xD;
			failed = true;&#xD;
			CodiceEsito = &quot;KO_02&quot;;&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL INTERFACCIA MODEM fallito. Trovato profiloTecnicoLinea con valore: &quot; + profiloTecnicoLinea + &quot; e Interfaccia con valore: &quot; + interfaccia;&#xD;
		}&#xD;
	}&#xD;
	else if(profiloTecnicoLinea == &quot;P&quot;&#xD;
		|| profiloTecnicoLinea == &quot;P1&quot;)&#xD;
	{&#xD;
		if(interfaccia != &quot;8&quot;)&#xD;
		{&#xD;
			failed = true;&#xD;
			CodiceEsito = &quot;KO_02&quot;;&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL INTERFACCIA MODEM fallito. Trovato profiloTecnicoLinea con valore: &quot; + profiloTecnicoLinea + &quot; e Interfaccia con valore: &quot; + interfaccia;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!failed)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL INTERFACCIA MODEM positivo. Trovato profiloTecnicoLinea con valore: &quot; + profiloTecnicoLinea + &quot; e Interfaccia con valore: &quot; + interfaccia;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
