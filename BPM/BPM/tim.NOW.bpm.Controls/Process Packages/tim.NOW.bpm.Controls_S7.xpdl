          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaCompatibilitaRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaCompatibilitaIntermediateAgent_RequestType();&#xD;
&#xD;
VerificaCompatibilitaRequest.idRichiesta = localRequest.IDRichiestaOLO;&#xD;
VerificaCompatibilitaRequest.lavorazione = String(localRequest.lavorazione);&#xD;
VerificaCompatibilitaRequest.offerta = String(localRequest.offerta);&#xD;
&#xD;
if(ConsistenzaDati != null)    &#xD;
{&#xD;
	VerificaCompatibilitaRequest.intermediateAgentFullConsistenza = ConsistenzaDati.intermediateAgentFull;&#xD;
	VerificaCompatibilitaRequest.idAsset = ConsistenzaDati.IDAsset;	&#xD;
}&#xD;
&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	//ACCESSO&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INTERMEDIATEAGENTFULL)&#xD;
			{&#xD;
				VerificaCompatibilitaRequest.intermediateAgentFullRichiesta = attributo.valoreAttributo;&#xD;
			}&#xD;
			&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
			{&#xD;
				VerificaCompatibilitaRequest.encapsulation = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
&#xD;
	//USERVLAN&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
	{	&#xD;
		var uservlan = com_tim_NOW_xsd_ControlliFormali_Factory.createVLAN_type();&#xD;
&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
			{&#xD;
				uservlan.svlanCode = attributo.valoreAttributo;&#xD;
			}	&#xD;
		}&#xD;
		&#xD;
		for(var k=0; k&lt;EsistenzaVLANOutput.size(); k++)&#xD;
		{&#xD;
			var currentEsistenzaVLAN = EsistenzaVLANOutput.get(k);&#xD;
			&#xD;
			if(currentEsistenzaVLAN.IDDettaglioOrdine == componente.IDDettaglioOrdine)&#xD;
			{&#xD;
				uservlan.intermediateAgent = currentEsistenzaVLAN.INTERMEDIATE_AGENT;&#xD;
			}	&#xD;
		}&#xD;
		&#xD;
		VerificaCompatibilitaRequest.VLAN.add(ScriptUtil.copy(uservlan));&#xD;
	}	&#xD;
	&#xD;
	//GBEVC&#xD;
	//SM_9259&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
	{&#xD;
		var gbevc = com_tim_NOW_xsd_ControlliFormali_Factory.createGBEVC_type();&#xD;
&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
			{&#xD;
				gbevc.svlanCodeRichiesta = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
			{&#xD;
				gbevc.cvlanCodeRichiesta = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		VerificaCompatibilitaRequest.GBEVC.add(ScriptUtil.copy(gbevc));&#xD;
	}&#xD;
}&#xD;
   &#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_nQqSMGH8EeqFHPmOgQtKzw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_BmVa4GH8EeqFHPmOgQtKzw" xpdExt:Visibility="Public">
