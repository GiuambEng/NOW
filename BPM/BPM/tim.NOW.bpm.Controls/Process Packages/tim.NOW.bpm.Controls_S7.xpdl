          <xpdl2:Performers>
            <xpdl2:Performer>_Zri4EDvpEee60_jcn4zoAQ</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="92.0" LaneId="_YBaXkj_FEee7YeExe1Se8g" Width="146.0">
              <xpdl2:Coordinates XCoordinate="542.0" YCoordinate="267.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaOverbookingRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaOverbookingVCSimmetricoRequestType();&#xD;
&#xD;
VerificaOverbookingRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaOverbookingRequest.lavorazione = String(localRequest.lavorazione);&#xD;
&#xD;
if(ConsistenzaDati != null)&#xD;
{&#xD;
	VerificaOverbookingRequest.idAsset = ConsistenzaDati.IDAsset;&#xD;
	VerificaOverbookingRequest.offerta = String(ConsistenzaDati.offerta);&#xD;
	VerificaOverbookingRequest.profiloTecnocoLinea = ConsistenzaDati.profiloTecnicoLinea;&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaDati.IDAsset));&#xD;
}&#xD;
else&#xD;
{&#xD;
	VerificaOverbookingRequest.offerta = String(localRequest.offerta);&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(ConsistenzaDati == null &amp;&amp; String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(VerificaOverbookingRequest.profiloTecnocoLinea == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
			{&#xD;
				VerificaOverbookingRequest.profiloTecnocoLinea = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
	{&#xD;
		var vc = com_tim_NOW_xsd_ControlliFormali_Factory.createVCType();&#xD;
		vc.azioneVC = String(currentDettOrdine.azione);&#xD;
		&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRDOWN&#xD;
				|| currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRUP)&#xD;
			{&#xD;
				vc.PCR = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRDOWN&#xD;
				|| currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRUP)&#xD;
			{&#xD;
				vc.MCR = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SCRDOWN&#xD;
				|| currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SCRUP)&#xD;
			{&#xD;
				vc.SCR = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI)&#xD;
			{&#xD;
				vc.DLCI = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
			{&#xD;
				vc.VCI = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
			{&#xD;
				vc.VPI = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC)&#xD;
			{&#xD;
				vc.profiloVC = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			&#xD;
		}&#xD;
		&#xD;
		VerificaOverbookingRequest.VC.add(ScriptUtil.copy(vc));&#xD;
	}&#xD;
}&#xD;
&#xD;
if(AssetRef != null)&#xD;
{&#xD;
	var asset = AssetRef.readAsset();&#xD;
	&#xD;
	for(var i = 0; i &lt; asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var currentDettAsset = asset.dettaglioasset.get(i);&#xD;
	&#xD;
		if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
		{&#xD;
			var vcAsset = com_tim_NOW_xsd_ControlliFormali_Factory.createVCConsistenzaType();&#xD;
		&#xD;
			for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI)&#xD;
				{&#xD;
					vcAsset.DLCI = currentAttDettAsset.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
				{&#xD;
					vcAsset.VCI = currentAttDettAsset.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
				{&#xD;
					vcAsset.VPI = currentAttDettAsset.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC)&#xD;
				{&#xD;
					vcAsset.profiloVC = currentAttDettAsset.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDPROFILOVC)&#xD;
				{&#xD;
					vcAsset.idProfiloVC = currentAttDettAsset.valoreAttributo;&#xD;
