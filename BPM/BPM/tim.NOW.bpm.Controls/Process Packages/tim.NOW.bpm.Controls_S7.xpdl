		 		}&#xD;
		 i++;&#xD;
		 }&#xD;
		 &#xD;
		 if (!trovato)&#xD;
		 {&#xD;
		 	EseguiControllo= false;&#xD;
		 }&#xD;
	&#xD;
}</xpdl2:Script>
