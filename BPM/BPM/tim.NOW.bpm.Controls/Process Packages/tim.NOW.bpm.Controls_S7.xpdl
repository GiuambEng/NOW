        <xpdl2:Activity Id="_oOcLV0B_EeeykrgPLWVm3g" Name="VerificaVariazionedecrementoUservlan" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Variazione decremento Uservlan" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset,10));&#xD;
Asset = AssetRef.readAsset();&#xD;
&#xD;
var countUserVlanAsset = 0;&#xD;
var countUserVlanIncrementoRichiesta = 0;&#xD;
var countUserVlanDecrementoRichiesta = 0;&#xD;
&#xD;
for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
{&#xD;
	var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
	&#xD;
	if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
	{&#xD;
		countUserVlanAsset++;&#xD;
	}&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
	{&#xD;
		if(currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
		{&#xD;
			countUserVlanIncrementoRichiesta++;&#xD;
		}&#xD;
		else if(currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		{&#xD;
			countUserVlanDecrementoRichiesta++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(countUserVlanAsset + countUserVlanIncrementoRichiesta - countUserVlanDecrementoRichiesta > 0)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL Decremento USERVLAN positivo: somma di UserVLAN maggiore di 0. UserVlan in Consistenza: &quot; + countUserVlanAsset + &quot; UserVlan in Incremento: &quot; + countUserVlanIncrementoRichiesta + &quot; UserVlan in Decremento: &quot; + countUserVlanDecrementoRichiesta;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL Decremento USERVLAN negativo: somma di UserVLAN pari a 0. UserVlan in Consistenza: &quot; + countUserVlanAsset + &quot; UserVlan in Incremento: &quot; + countUserVlanIncrementoRichiesta + &quot; UserVlan in Decremento: &quot; + countUserVlanDecrementoRichiesta;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
