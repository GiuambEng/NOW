        <xpdl2:Activity Id="_YBcMwj_FEee7YeExe1Se8g" Name="VerificaoverbookingVCperSimmetrici" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica overbooking VC per Simmetrici" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_j9Pu0kByEeeykrgPLWVm3g">
