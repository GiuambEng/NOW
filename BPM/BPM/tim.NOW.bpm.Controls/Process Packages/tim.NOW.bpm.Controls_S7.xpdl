        <xpdl2:Activity Id="_ILAGUjyVEee0nvs4D2Etvw" Name="VerificaobbligatorietModemInterfaccia" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica obbligatorietà Modem-Interfaccia" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per eseguire il controllo&quot;;&#xD;
&#xD;
var codice = &quot;&quot;;&#xD;
codice = null;&#xD;
var interfaccia = &quot;&quot;;&#xD;
interfaccia = null;&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
while((codice == null || interfaccia == null) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while((codice == null || interfaccia == null) &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE)&#xD;
			{&#xD;
				codice = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INTERFACCIA)&#xD;
			{&#xD;
				interfaccia = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(codice == null)&#xD;
{&#xD;
	CodiceEsito = &quot;KO_01&quot;;&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL OBBL MODEM-INTERFACCIA fallito. CODICE non trovato per la ocmponente MODEM&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	if(codice == &quot;M00&quot;)&#xD;
	{&#xD;
		if(interfaccia != null)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_02&quot;;&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL OBBL MODEM-INTERFACCIA fallito. Trovato CODICE con valore: &quot; + codice + &quot; ed INTERFACCIA con valore: &quot; + interfaccia;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL OBBL MODEM-INTERFACCIA positivo. Trovato CODICE con valore: &quot; + codice + &quot; ed INTERFACCIA NULL&quot;;&#xD;
		}&#xD;
	}&#xD;
	//M01&#xD;
	else&#xD;
	{&#xD;
		if(interfaccia != &quot;9&quot;)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_03&quot;;&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL OBBL MODEM-INTERFACCIA fallito. Trovato CODICE con valore: &quot; + codice + &quot; ed INTERFACCIA con valore: &quot; + interfaccia;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL OBBL MODEM-INTERFACCIA positivo. Trovato CODICE con valore: &quot; + codice + &quot; ed INTERFACCIA con valore: &quot; + interfaccia;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
