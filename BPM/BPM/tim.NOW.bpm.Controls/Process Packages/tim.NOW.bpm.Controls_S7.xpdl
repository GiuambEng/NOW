            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_SuevUjyZEee0nvs4D2Etvw" Width="31.0">
              <xpdl2:Coordinates XCoordinate="792.0" YCoordinate="270.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_Suf9dzyZEee0nvs4D2Etvw" Name="VerificaUnivocitDLCI" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Univocità DLCI" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per eseguire il controllo&quot;;&#xD;
&#xD;
var dlciRichiesta = DataUtil.createList();&#xD;
var failed = false;&#xD;
var dlciTotal = DataUtil.createList();&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
while(!failed &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
	{&#xD;
		var j = 0;&#xD;
		&#xD;
		while(!failed &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI)&#xD;
			{&#xD;
				Process.auditLog(&quot;Trovato DLCI in Richiesta: &quot; + currentAttDettOrdine.valoreAttributo);&#xD;
				if(dlciRichiesta.contains(currentAttDettOrdine.valoreAttributo))&#xD;
				{&#xD;
					failed = true;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					dlciRichiesta.add(currentAttDettOrdine.valoreAttributo);&#xD;
					if(localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC ||&#xD;
						(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
						&amp;&amp; currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A))&#xD;
					{&#xD;
						Process.auditLog(&quot;Caso non di DECREMENTO, lo salvo per verifica in ASSET&quot;);&#xD;
						dlciTotal.add(currentAttDettOrdine.valoreAttributo);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(!failed &amp;&amp; (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC))&#xD;
{&#xD;
	if(ConsistenzaDati != null)&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: IDR AND statoAsset &lt;> 'CESSATO'&quot;);&#xD;
		criteria.setQueryParameter(&quot;IDR&quot;,localRequest.IDRisorsa);&#xD;
&#xD;
		var refs = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
&#xD;
		if(refs!= null &amp;&amp; refs.size() > 0)&#xD;
		{&#xD;
			AssetRef = refs.get(0);&#xD;
			Asset = AssetRef.readAsset();&#xD;
			&#xD;
			var i = 0;&#xD;
			while(!failed &amp;&amp; i &lt; Asset.dettaglioasset.size())&#xD;
			{&#xD;
				var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
				&#xD;
				if(currentDettAsset.statoDettaglioAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO &amp;&amp;&#xD;
				currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
				{&#xD;
					var j = 0;&#xD;
					while(!failed &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
					{&#xD;
						var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DLCI)&#xD;
						{&#xD;
							Process.auditLog(&quot;Trovato DLCI in Asset: &quot; + currentAttDettAsset.valoreAttributo);&#xD;
							if(dlciTotal.contains(currentAttDettAsset.valoreAttributo))&#xD;
							{&#xD;
								failed = true;&#xD;
							}&#xD;
							else&#xD;
							{&#xD;
								dlciTotal.add(currentAttDettAsset.valoreAttributo);&#xD;
							}&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			failed = true;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		failed = true;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL UNIVOCITA DLCI fallito. Trovati DLCI non univoci&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL UNIVOCITA DLCI positivo. Tutte i DLCI univoci&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
