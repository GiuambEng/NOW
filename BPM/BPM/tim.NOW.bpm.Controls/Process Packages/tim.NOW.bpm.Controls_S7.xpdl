    <xpdl2:WorkflowProcess Id="_SuevUDyZEee0nvs4D2Etvw" xpdExt:DisplayName="CTRL UNIVOCITA DLCI_C04M01F151" Name="CTRLUNIVOCITADLCI_C04M01F151">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_uULtwjyeEee0nvs4D2Etvw" xpdExt:DisplayName="Asset" Name="Asset">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_uULtwzyeEee0nvs4D2Etvw" xpdExt:DisplayName="AssetRef" Name="AssetRef">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_Suf9djyZEee0nvs4D2Etvw" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
