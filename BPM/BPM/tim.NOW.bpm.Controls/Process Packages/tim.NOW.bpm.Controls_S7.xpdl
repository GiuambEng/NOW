    <xpdl2:WorkflowProcess Id="_LAp_gH2pEeeIJ8t_js-dKw" xpdExt:DisplayName="CTRL VAR ENCAPSULATION FITTIZIA_C04M01F164" Name="CTRLVARENCAPSULATIONFITTIZIA_C04M01F164">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_bDS_4X2tEeeIJ8t_js-dKw" xpdExt:DisplayName="Asset" Name="Asset">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_bt9GcH2tEeeIJ8t_js-dKw" xpdExt:DisplayName="AssetRef" Name="AssetRef">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_LA2MwH2pEeeIJ8t_js-dKw" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_LAqmkH2pEeeIJ8t_js-dKw" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_LA2MwX2pEeeIJ8t_js-dKw" Name="VerificaVariazioneEncapsulationFittizia" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Variazione Encapsulation Fittizia" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL Variazione Encapsulation Fittizia fallito: dati insufficienti per eseguire il controllo&quot;;&#xD;
&#xD;
if(ConsistenzaDati != null)&#xD;
{&#xD;
	var ENCAPSULATION = &quot;&quot;;&#xD;
	ENCAPSULATION = null;&#xD;
	var ENCAPSULATION_CONS = &quot;&quot;;&#xD;
	ENCAPSULATION_CONS = null;&#xD;
	&#xD;
	var i = 0;&#xD;
	var encapsulationFound = false;&#xD;
	while(!encapsulationFound &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var dettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(String(dettOrd.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(!encapsulationFound &amp;&amp; j &lt; dettOrd.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attrDettOrd = dettOrd.attributiDettaglioOrdine.get(j);&#xD;
				if(attrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
				{&#xD;
					encapsulationFound = true;&#xD;
					ENCAPSULATION = attrDettOrd.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
	Asset = AssetRef.readAsset();&#xD;
	&#xD;
	if(Asset != null)&#xD;
	{&#xD;
		var i = 0;&#xD;
		var encapsulationFound = false;&#xD;
		while(!encapsulationFound &amp;&amp; i &lt; Asset.dettaglioasset.size())&#xD;
		{&#xD;
			var dettAsset = Asset.dettaglioasset.get(i);&#xD;
			if(String(dettAsset.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(!encapsulationFound &amp;&amp; j &lt; dettAsset.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attrDettAsset = dettAsset.attributidettaglioasset.get(j);&#xD;
					if(attrDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
					{&#xD;
						encapsulationFound = true;&#xD;
						ENCAPSULATION_CONS = attrDettOrd.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	&#xD;
	if(ENCAPSULATION != null &amp;&amp; ENCAPSULATION != &quot;&quot; &amp;&amp; ENCAPSULATION_CONS != null &amp;&amp; ENCAPSULATION_CONS != &quot;&quot;)&#xD;
	{&#xD;
		&#xD;
		// SE LE ENACAPSULATION SONO UGUALI SI VERIFICANO LE CONGRUENZE DEI CODEVLANSINGLETAG/ SVLANCODE-CVLANID (NB: il codicevlansingltag in richiesta viene confrontato con SVLANCODE in consistenza in quanyo viene mappato qui il codicevlansingletag&#xD;
		&#xD;
		if(ENCAPSULATION == ENCAPSULATION_CONS)&#xD;
		{&#xD;
			Process.auditLog(&quot;ENCAPSULATION congruenti: &quot;+ ENCAPSULATION);&#xD;
			&#xD;
			var failed=false;&#xD;
			var uservalnIDRichiesta = &quot;&quot;;&#xD;
			uservalnIDRichiesta = null;&#xD;
			var uservlanIDAsset= &quot;&quot;;&#xD;
			uservlanIDAsset=null;&#xD;
			&#xD;
			//SINGLETAG - VERIFICA CONGRUENZA DEI CODEVLANSINGLETAG&#xD;
			if (ENCAPSULATION == &quot;SINGLETAG&quot;)&#xD;
			{	&#xD;
				&#xD;
				var CodVlanSingleTagRichiesta = &quot;&quot;;&#xD;
				CodVlanSingleTagRichiesta = null;&#xD;
				var CodVlanSingleTagAsset = &quot;&quot;;&#xD;
				CodVlanSingleTagAsset = null;&#xD;
			&#xD;
				var i = 0;&#xD;
				while(!failed &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
				{&#xD;
					var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
					if (currentComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
					{&#xD;
						for (j=0; j&lt;currentComponente.attributiDettaglioOrdine.size(); j++)&#xD;
						{&#xD;
							var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
				   	 &#xD;
							if (currentAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
							{&#xD;
								uservalnIDRichiesta = currentAttributo.valoreAttributo;&#xD;
							}&#xD;
							&#xD;
							else if (currentAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
							{&#xD;
								CodVlanSingleTagRichiesta = currentAttributo.valoreAttributo;&#xD;
							}&#xD;
				   	 &#xD;
							if (CodVlanSingleTagRichiesta != null &amp;&amp; uservalnIDRichiesta != null &amp;&amp; CodVlanSingleTagRichiesta != &quot;&quot; &amp;&amp; uservalnIDRichiesta != &quot;&quot;)&#xD;
							{&#xD;
								var match= false;&#xD;
								&#xD;
								var k=0;&#xD;
								while (!match &amp;&amp; k&lt;Asset.dettaglioasset.size())&#xD;
								{&#xD;
									var currentDettAsset =Asset.dettaglioasset.get(k);&#xD;
				   	 		&#xD;
									if (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
									{&#xD;
										for (var w=0; w&lt;currentDettAsset.attributidettaglioasset.size(); w++)&#xD;
										{&#xD;
											var currentAttributo = currentDettAsset.attributidettaglioasset.get(w);&#xD;
				   	 				&#xD;
											if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
											{&#xD;
												uservlanIDAsset=currentAttributo.valoreAttributo;&#xD;
											}&#xD;
				   	 				&#xD;
											else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
											{&#xD;
												CodVlanSingleTagAsset = currentAttributo.valoreAttributo;&#xD;
											}&#xD;
										}&#xD;
				   	 			&#xD;
										if (uservlanIDAsset==uservalnIDRichiesta)&#xD;
										{&#xD;
											match=true;&#xD;
											&#xD;
											if(CodVlanSingleTagAsset != CodVlanSingleTagRichiesta)&#xD;
											{&#xD;
												failed=true;&#xD;
												EsitoResponse.descrizione=&quot;CTRL Variazione Encapsulation Fallito - CodeVlanSingleTag Richiesta &quot;+ CodVlanSingleTagRichiesta + &quot; differente da CodeVlanSingleTag Asset &quot;+ CodVlanSingleTagAsset+ &quot; per UservlanId = &quot; + uservalnIDRichiesta;&#xD;
											}&#xD;
										}&#xD;
&#xD;
									}	&#xD;
								k++;&#xD;
								}&#xD;
								&#xD;
								if(!match)&#xD;
								{	&#xD;
									failed=true;&#xD;
									EsitoResponse.descrizione=&quot;CTRL Variazione Encapsulation Fittizia Fallito - Non trovate Uservlan con UservlanID congruenti per ENCAPSULATION SINGLETAG&quot;;&#xD;
								}&#xD;
							}&#xD;
				   	 &#xD;
							else&#xD;
							{&#xD;
								failed=true;&#xD;
								EsitoResponse.descrizione = &quot;CTRL Variazione Encapsulation Fittizia Fallito - CodeVlanSingleTag o UservlanId della richiesta non presenti o non valorizzati&quot;;&#xD;
							}&#xD;
				   	&#xD;
						}&#xD;
					}&#xD;
				 &#xD;
				i++;&#xD;
				}&#xD;
			}	&#xD;
			&#xD;
			//DOUBLETAG - VERIFICA CONGRUENZA DI SVLANCODE-CVLANID&#xD;
			else if (ENCAPSULATION == &quot;DOUBLETAG&quot;)&#xD;
			{	&#xD;
				&#xD;
				var CvlanIDRichiesta = &quot;&quot;;&#xD;
				CvlanIDRichiesta = null;&#xD;
				var CvlanIDAsset = &quot;&quot;;&#xD;
				CvlanIDAsset = null;&#xD;
				&#xD;
				var SvlanCodeRichiesta = &quot;&quot;;&#xD;
				SvlanCodeRichiesta = null;&#xD;
				var SvlanCodeAsset = &quot;&quot;;&#xD;
				SvlanCodeAsset = null;&#xD;
			&#xD;
				var i = 0;&#xD;
				while(!failed &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
				{&#xD;
					var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
					if (currentComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
					{&#xD;
						for (j=0; j&lt;currentComponente.attributiDettaglioOrdine.size(); j++)&#xD;
						{&#xD;
							var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
				   	 &#xD;
							if (currentAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
							{&#xD;
								uservalnIDRichiesta = currentAttributo.valoreAttributo;&#xD;
							}&#xD;
							&#xD;
							else if (currentAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
							{&#xD;
								SvlanCodeRichiesta = currentAttributo.valoreAttributo;&#xD;
							}&#xD;
							else if (currentAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
							{&#xD;
								CvlanIDRichiesta = currentAttributo.valoreAttributo;&#xD;
							}&#xD;
				   	 &#xD;
							if (CvlanIDRichiesta != null &amp;&amp; uservalnIDRichiesta != null &amp;&amp; SvlanCodeRichiesta !=null &#xD;
								&amp;&amp; CvlanIDRichiesta != &quot;&quot; &amp;&amp; uservalnIDRichiesta != &quot;&quot; &amp;&amp; SvlanCodeRichiesta != &quot;&quot;)&#xD;
							{&#xD;
								var match= false;&#xD;
								var k=0;&#xD;
								while (!match &amp;&amp; k&lt;Asset.dettaglioasset.size())&#xD;
								{&#xD;
									var currentDettAsset =Asset.dettaglioasset.get(k);&#xD;
				   	 		&#xD;
									if (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
									{&#xD;
										for (var w=0; w&lt;currentDettAsset.attributidettaglioasset.size(); w++)&#xD;
										{&#xD;
											var currentAttributo = currentDettAsset.attributidettaglioasset.get(w);&#xD;
				   	 				&#xD;
											if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
											{&#xD;
												uservlanIDAsset=currentAttributo.valoreAttributo;&#xD;
											}&#xD;
				   	 				&#xD;
											else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
											{&#xD;
												SvlanCodeAsset = currentAttributo.valoreAttributo;&#xD;
											}&#xD;
											&#xD;
											else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
											{&#xD;
												CvlanIDAsset = currentAttributo.valoreAttributo;&#xD;
											}&#xD;
										}&#xD;
				   	 			&#xD;
										if (uservlanIDAsset==uservalnIDRichiesta)&#xD;
										{&#xD;
											match=true;&#xD;
											&#xD;
											if(CvlanIDAsset != CvlanIDRichiesta)&#xD;
											{&#xD;
												failed=true;&#xD;
												EsitoResponse.descrizione=&quot;CTRL Variazione Encapsulation Fittizia Fallito - CVLANID Richiesta &quot;+ CvlanIDRichiesta + &quot; differente da CVLANID Asset &quot;+ CvlanIDAsset  + &quot; per UservlanId = &quot; + uservalnIDRichiesta;&#xD;
											}&#xD;
											&#xD;
											if(SvlanCodeAsset != SvlanCodeRichiesta)&#xD;
											{&#xD;
												failed=true;&#xD;
												EsitoResponse.descrizione=&quot;CTRL Variazione Encapsulation Fittizia Fallito - SVLANCODE Richiesta &quot;+ SvlanCodeRichiesta + &quot; differente da SVLANCODE Asset &quot;+ SvlanCodeAsset + &quot; per UservlanId = &quot; + uservalnIDRichiesta;&#xD;
											}&#xD;
											&#xD;
										}&#xD;
										&#xD;
				   	 		&#xD;
									}	&#xD;
								k++;&#xD;
								}&#xD;
								&#xD;
								if(!match)&#xD;
								{	&#xD;
									failed=true;&#xD;
									EsitoResponse.descrizione=&quot;CTRL Variazione Encapsulation Fittizia Fallito - Non trovate Uservlan con UservlanID congruenti per ENCAPSULATION DOUBLETAG&quot;;&#xD;
								}&#xD;
							}&#xD;
				   	 &#xD;
							else&#xD;
							{&#xD;
								failed=true;&#xD;
								EsitoResponse.descrizione = &quot;CTRL Variazione Encapsulation Fallito - Non valorizzato o non presente in richiesta uno degli attributi tra CVLANID - SVLANCODE - USERVLANID&quot;;&#xD;
							}&#xD;
				   	&#xD;
						}&#xD;
					}&#xD;
				 &#xD;
				i++;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if (!failed)&#xD;
			{&#xD;
				EsitoResponse.codice=true;&#xD;
				EsitoResponse.descrizione=&quot;CTRL Variazione Encapsulation Fittizia superato&quot;;&#xD;
			}&#xD;
			&#xD;
			&#xD;
		}&#xD;
		&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL Variazione Encapsulation Fittizia superato - ENCAPSULATION DIFFERENTI&quot;;&#xD;
		}&#xD;
		&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
