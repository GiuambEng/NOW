        <xpdl2:Transition Id="_Suf9eDyZEee0nvs4D2Etvw" xpdExt:DisplayName="" Name="" From="_Suf9dzyZEee0nvs4D2Etvw" To="_Suf9djyZEee0nvs4D2Etvw">
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
