                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="output.esito.descrizione">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.descrizione</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="output.IDRisorsaDIN">
                      <xpdl2:Actual ScriptGrammar="JavaScript">IDRisorsaDIN</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_5CTxoMegEea-PIfovU0abw" OperationName="RecuperoIDRisorsa">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckServiceAmmissibilitaPortTypeSOAP" ServiceName="BPM_CheckServiceAmmissibilitaPortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
