        <xpdl2:Activity Id="_11aOp7upEea-FqioYDGtog" Name="VerificaIDRisorsaNakedInput" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica ID Risorsa Naked Input">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">trovatoIdRisorsaBTSNaked = false;&#xD;
VerificaIDRisorsaNakedRequest = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createVerifica_IDRisorsa_Naked_RequestType();&#xD;
&#xD;
VerificaIDRisorsaNakedRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
if(localRequest.ordine.tipologiaLinea != null)&#xD;
{&#xD;
	VerificaIDRisorsaNakedRequest.tipoLineaWLR = it_telecomitalia_it_NOW_casedata_v1_TipologiaLineaEnumeration.get(String(localRequest.ordine.tipologiaLinea));&#xD;
}&#xD;
&#xD;
if(ConsistenzaDati != null)&#xD;
{&#xD;
	if(ConsistenzaDati.offerta != null)&#xD;
	{&#xD;
		VerificaIDRisorsaNakedRequest.offertaConsistenza = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(ConsistenzaDati.offerta));&#xD;
	}&#xD;
	&#xD;
	if(ConsistenzaDati.tipoLinea != null)&#xD;
	{&#xD;
		VerificaIDRisorsaNakedRequest.tipoLinea = it_telecomitalia_it_NOW_casedata_v1_TipologiaLineaEnumeration.get(String(ConsistenzaDati.tipoLinea.toUpperCase()));&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Verifica presenza IDRISORSABTSNAKED per WLR LNA&quot;);&#xD;
if ( localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
&amp;&amp;&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA) &#xD;
{&#xD;
//Attivazione WLR Linea Non Attiva	&#xD;
&#xD;
	if(localRequest.ordine != null)&#xD;
	{&#xD;
		var i = 0;&#xD;
		while(!trovatoIdRisorsaBTSNaked &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
			{&#xD;
				var j = 0;&#xD;
				for (j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSABTSNAKED)&#xD;
					{&#xD;
						trovatoIdRisorsaBTSNaked = true;						&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
}	</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
