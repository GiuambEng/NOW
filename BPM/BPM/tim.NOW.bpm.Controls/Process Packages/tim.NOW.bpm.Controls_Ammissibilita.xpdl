        <xpdl2:Activity Id="_cVAkMtdNEeawK-VRC_DmUQ" Name="VerificaCompatibilitTipoLineasuPOTS" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Compatibilità Tipo Linea su POTS">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA POTS fallito: dati insufficienti per eseguire il controllo&quot;;&#xD;
&#xD;
&#xD;
if(ConsistenzaFonia.tipoLinea == &quot;POTS&quot;&#xD;
	|| (ConsistenzaFonia.destinazioneUso!=null &amp;&amp; ConsistenzaFonia.destinazioneUso.slice(0,1)==&quot;1&quot; &amp;&amp; ConsistenzaFonia.destinazioneUso!=&quot;10&quot;))&#xD;
{&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
		&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO)&#xD;
	{&#xD;
		if(ConsistenzaDati != null)&#xD;
		{&#xD;
			if(ConsistenzaDati.tipoLinea == &quot;POTS&quot;)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA POTS passato: Sottolavorazione MIGRAZIONEOLO e tipoLinea della ConsistenzaDati: &quot; + ConsistenzaDati.tipoLinea;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA POTS fallito: Sottolavorazione MIGRAZIONEOLO e tipoLinea della ConsistenzaDati: &quot; + ConsistenzaDati.tipoLinea;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA POTS fallito: ConsistenzaDati mancante&quot;;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
					EsitoResponse.codice = true;&#xD;
					EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA POTS positivo: TipoLinea e Offerta in consistenza coerente. TipoLinea: &quot; + ConsistenzaFonia.tipoLinea + &quot; Offerta: &quot; + ConsistenzaFonia.offerta;&#xD;
					LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
					LavorazioneRichiesta.tipoLinea = &quot;POTS&quot;;&#xD;
					storicizza=true;&#xD;
				&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA POTS saltato per precondizione: TipoLinea non di tipo POTS&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
