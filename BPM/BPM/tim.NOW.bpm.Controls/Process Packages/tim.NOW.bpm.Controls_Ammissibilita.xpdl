		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: non è stata recuperata nessuna consistenza NPNG avente DN: &quot;+localRequest.IDRisorsa;&#xD;
		CodiceEsito = &quot;KO_40&quot;;&#xD;
	}&#xD;
&#xD;
	&#xD;
	if(assetNPNG != null)&#xD;
	{&#xD;
