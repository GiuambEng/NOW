        </xpdl2:Activity>
        <xpdl2:Activity Id="_vfp-spr3EeiD6dERz-jeXg" Name="VerificaPrecondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = false;&#xD;
&#xD;
if (ConsistenzaDati != null &amp;&amp; ConsistenzaDati.offerta != null &amp;&amp; &#xD;
    (ConsistenzaDati.offerta ==  it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICO ||&#xD;
	 ConsistenzaDati.offerta ==  it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT ||&#xD;
