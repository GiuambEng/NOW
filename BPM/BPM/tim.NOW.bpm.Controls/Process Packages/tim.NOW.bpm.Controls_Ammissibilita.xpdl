          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var eseguicontrollo = false;&#xD;
Process.auditLog(&quot;START Esegui controllo: &quot; + eseguicontrollo);&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
{&#xD;
 	Process.auditLog(&quot;Lavorazione MIGRAZIONE esegui controllo: &quot; + eseguicontrollo);&#xD;
 	if(localRequest.DNAggiuntivo.size() != 0)&#xD;
 	{&#xD;
  		eseguicontrollo = true;&#xD;
  		Process.auditLog(&quot;Trovati DNAggiuntivi in MIGRAZIONE: &quot; + localRequest.DNAggiuntivo.size() + &quot; esegui controllo: &quot; + eseguicontrollo);&#xD;
  	}&#xD;
}&#xD;
else if(DNAggiuntivi != null &amp;&amp; DNAggiuntivi.size() > 0)&#xD;
{&#xD;
	eseguicontrollo = true;&#xD;
	Process.auditLog(&quot;Trovati DNAggiuntivi esterni esegui controllo: &quot; + eseguicontrollo);&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Lavorazione != MIGRAZIONE esegui controllo: &quot; + eseguicontrollo);&#xD;
	if(localRequest.numeroTelefonico != null)&#xD;
	{&#xD;
		eseguicontrollo = true;&#xD;
		Process.auditLog(&quot;Trovato numeroTelefonico in lavorazione != MIGRAZIONE esegui controllo: &quot; + eseguicontrollo);&#xD;
	}&#xD;
}&#xD;
Process.auditLog(&quot;END Esegui controllo: &quot; + eseguicontrollo);&#xD;
eseguicontrollo;</xpdl2:Expression>
</xpdl2:Condition>
