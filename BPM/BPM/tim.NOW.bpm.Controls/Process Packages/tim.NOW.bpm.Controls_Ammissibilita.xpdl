					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER)&#xD;
					{&#xD;
						ROUTINGNUMBER = true;&#xD;
						ConsistenzaNPNG.routingNumber = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.UO)&#xD;
					{&#xD;
						UO = true;&#xD;
