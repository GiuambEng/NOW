}&#xD;
VerificaCompatibilitaLavorazioneRequest.strutturaRichiesta = it_telecomitalia_it_NOW_casedata_v1_TipoStrutturaRichiestaEnumeration.get(String(localRequest.strutturaRichiesta));&#xD;
