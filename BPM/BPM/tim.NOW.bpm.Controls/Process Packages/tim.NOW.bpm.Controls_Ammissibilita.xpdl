        </xpdl2:Activity>
        <xpdl2:Activity Id="_FXzl8KpyEeeHq-UnvISIqg" Name="LockUnlockRisorsa" xpdExt:Visibility="Private" xpdExt:DisplayName="Lock Unlock Risorsa">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_YNX9wKpyEeeHq-UnvISIqg">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="false" Direction="IN" Formal="parameters">
                      <xpdl2:Actual ScriptGrammar="JavaScript">LockUnlockRequest</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageIn>
                <xpdl2:MessageOut Id="_YNX9wapyEeeHq-UnvISIqg">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="parameters.esito.esito">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.codice</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="parameters.esito.descrizione">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.descrizione</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_5CTxoMegEea-PIfovU0abw" OperationName="Lock_UnlockRisorsa">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckServiceAmmissibilitaPortTypeSOAP" ServiceName="BPM_CheckServiceAmmissibilitaPortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="BPM_CheckServiceAmmissibilita.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="BPM_CheckServiceAmmissibilitaPortType" OperationName="Lock_UnlockRisorsa">
                  <xpdExt:ExternalReference location="BPM_CheckServiceAmmissibilita.wsdl"/>
                </xpdExt:PortTypeOperation>
              </xpdl2:TaskService>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:Performers>
            <xpdl2:Performer>_5CTxoMegEea-PIfovU0abw</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="75.0" LaneId="_ItUOcd75EeacQOrD1dy-hA" Width="117.0">
              <xpdl2:Coordinates XCoordinate="731.0" YCoordinate="239.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">Process.auditLog(&quot;Esito Lock: &quot; + EsitoResponse.codice + &quot; &quot; + EsitoResponse.descrizione);&#xD;
&#xD;
if(EsitoResponse.codice)&#xD;
{&#xD;
	var assetTarget = it_telecomitalia_it_NOW_casedata_Factory.createAssetTarget();&#xD;
	assetTarget.IDAsset = ScriptUtil.createBigInteger(LockUnlockRequest.idAsset);&#xD;
	assetTarget.flagInLavorazione = true;&#xD;
&#xD;
	localRequest.assetTarget.add(ScriptUtil.copy(assetTarget));&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">Process.auditLog(&quot;Chiamo il LOCK risorsa&quot;);&#xD;
&#xD;
LockUnlockRequest = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createLock_UnlockRisorsaRequestType();&#xD;
&#xD;
LockUnlockRequest.CODICE_OLO = localRequest.codificaOLONOW;&#xD;
LockUnlockRequest.CODIFICA_OLO_AGICOM = localRequest.codificaOLOAGCOM;&#xD;
LockUnlockRequest.ID_RICH_OLO = localRequest.IDRichiestaOLO;&#xD;
&#xD;
if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.codificaOLOAGCOMDonating == &quot;TLC&quot;)&#xD;
{&#xD;
	LockUnlockRequest.ID_Risorsa = ConsistenzaDati.IDRisorsa;&#xD;
	LockUnlockRequest.idAsset = ConsistenzaDati.IDAsset;&#xD;
}&#xD;
else&#xD;
{&#xD;
	LockUnlockRequest.ID_Risorsa = ConsistenzaFonia.IDRisorsa;&#xD;
	LockUnlockRequest.idAsset = ConsistenzaFonia.IDAsset;&#xD;
}&#xD;
&#xD;
if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.idDettaglioAsset != null) // RU_778&#xD;
{&#xD;
	LockUnlockRequest.idDettaglioAsset = ConsistenzaFonia.idDettaglioAsset;&#xD;
}&#xD;
&#xD;
if(localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PORTIN) // RU_778&#xD;
{&#xD;
	LockUnlockRequest.numeroTelefonico = localRequest.numeroTelefonico;&#xD;
}&#xD;
&#xD;
LockUnlockRequest.SERVIZIO = com_tim_NOW_xsd_CommonSchema_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
LockUnlockRequest.azione = com_tim_NOW_xsd_ControllidiAmmissibilita_AzioneType.LOCK;&#xD;
LockUnlockRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
LockUnlockRequest.lavorazione = String(localRequest.lavorazione);</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_FyBcwKpyEeeHq-UnvISIqg">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
