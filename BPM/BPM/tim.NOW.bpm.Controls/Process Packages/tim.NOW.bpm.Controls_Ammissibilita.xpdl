      </xpdl2:Activities>
      <xpdl2:Transitions>
        <xpdl2:Transition Id="_x8OSU3EeEee0o4pQ6mlIUQ" xpdExt:DisplayName="" Name="" From="_x8OSUnEeEee0o4pQ6mlIUQ" To="_x8OSUXEeEee0o4pQ6mlIUQ">
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.StartAnchorPosition"/>
          </xpdl2:ConnectorGraphicsInfos>
        </xpdl2:Transition>
        <xpdl2:Transition Id="_kdDiAHEfEee0o4pQ6mlIUQ" xpdExt:DisplayName="" Name="" From="_hzfpUHEgEee0o4pQ6mlIUQ" To="_x8OSUnEeEee0o4pQ6mlIUQ">
          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var result = false;&#xD;
&#xD;
//OLO2OLO&#xD;
if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO)&#xD;
{&#xD;
	if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.azione == &quot;D&quot;&#xD;
		&amp;&amp; ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.azione == &quot;D&quot; &amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot;)&#xD;
	{&#xD;
		if(localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.LINEANONFONIA&#xD;
			|| String(localRequest.offerta).slice(0,3) == &quot;ULL&quot;&#xD;
			|| String(localRequest.offerta).slice(0,3) == &quot;SLU&quot;)&#xD;
		{&#xD;
			if(localRequest.DNAggiuntivo != null &amp;&amp; localRequest.DNAggiuntivo.size() > 0)&#xD;
			{&#xD;
				result = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
//TIM2OLO&#xD;
else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274)&#xD;
{&#xD;
	if(localRequest.DNAggiuntivo != null &amp;&amp; localRequest.DNAggiuntivo.size() > 0 &amp;&amp; EsitoVerificaTIM == &quot;0&quot;) //SM_9402: aggiunta condition su Esito&#xD;
	{&#xD;
		result = true;&#xD;
	}&#xD;
}&#xD;
&#xD;
//DN AGGIUNTIVE NON IDENTIFICATE COME DONOR OLO2OLO - 8199&#xD;
if(localRequest.DNAggiuntivo != null &amp;&amp; localRequest.DNAggiuntivo.size() > 0 &amp;&amp; NumberPortability != null) &#xD;
{&#xD;
	var trovatoDN = false;&#xD;
	var i = 0;&#xD;
	 &#xD;
	while(trovatoDN == false &amp;&amp; i &lt; NumberPortability.size())&#xD;
	{&#xD;
		var CurrentNP = NumberPortability.get(i); 		&#xD;
			   &#xD;
		if (CurrentNP.numeroTelefonico == localRequest.DNAggiuntivo.get(0) &amp;&amp; CurrentNP.codiceOperatoreDonating != &quot;TLC&quot;)&#xD;
		{&#xD;
			result = false;&#xD;
			trovatoDN = true;&#xD;
		}&#xD;
