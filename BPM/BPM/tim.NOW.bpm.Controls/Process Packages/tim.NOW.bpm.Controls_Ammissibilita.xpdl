            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_5bRa4MnDEeu_FOvYkGKuIw" xpdExt:DisplayName="AssetVLANMULTICAST" Name="AssetVLANMULTICAST" ReadOnly="false">
