        <xpdl2:Activity Id="_CEpGYojgEey7dtvLAZapow" Name="VerificaTagMulticastNonCondizionati" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Tag Multicast Non Condizionati">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL TAG MULTICAST NON CONDIZIONATI_C04M03F33 saltato&quot;;&#xD;
&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE&#xD;
 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT))&#xD;
{&#xD;
	if(localRequest.codiceOrdineOLO != null &amp;&amp; localRequest.codiceOrdineOLO != &quot;&quot;)&#xD;
	{&#xD;
		var foundIDRISORSA = false; //IDCanale&#xD;
		var foundCLLICENTRALE = false;&#xD;
		&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
					{&#xD;
						foundIDRISORSA = true;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLICENTRALE)&#xD;
					{&#xD;
						foundCLLICENTRALE = true;&#xD;
					}&#xD;
				}&#xD;
			}	&#xD;
		}&#xD;
		&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT&#xD;
		&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE&#xD;
		&amp;&amp; foundCLLICENTRALE)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL TAG MULTICAST NON CONDIZIONATI_C04M03F33 superato: &quot;+String(localRequest.offerta)+&quot;, sottolav &quot;+String(localRequest.tipologiaSottolav)+&quot;, con CLLICentrale valorizzato&quot;;&#xD;
		}&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE&#xD;
			 &amp;&amp; (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CREAZIONECANALEFEEDER&#xD;
			  || localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CANALEESISTENTEFEEDER)&#xD;
			 &amp;&amp; foundCLLICENTRALE)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL TAG MULTICAST NON CONDIZIONATI_C04M03F33 superato: &quot;+String(localRequest.offerta)+&quot;, sottolav &quot;+String(localRequest.tipologiaSottolav)+&quot;, con CLLICentrale valorizzato&quot;;&#xD;
		}&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE&#xD;
			 &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CANALEESISTENTEOLT&#xD;
			 &amp;&amp; foundCLLICENTRALE&#xD;
			 &amp;&amp; foundIDRISORSA)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL TAG MULTICAST NON CONDIZIONATI_C04M03F33 superato: &quot;+String(localRequest.offerta)+&quot;, sottolav &quot;+String(localRequest.tipologiaSottolav)+&quot;, con CLLICentrale e IDCanale (IDRisorsa) valorizzato&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL TAG MULTICAST NON CONDIZIONATI_C04M03F33 fallito: &quot;+String(localRequest.offerta)+&quot;, sottolav &quot;+String(localRequest.tipologiaSottolav)+&quot;, CLLICentrale: &quot;+String(foundCLLICENTRALE)+&quot;, IDRisorsa: &quot;+String(foundIDRISORSA);&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL TAG MULTICAST NON CONDIZIONATI_C04M03F33 non superato: codiceOrdineOLO mancante&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
