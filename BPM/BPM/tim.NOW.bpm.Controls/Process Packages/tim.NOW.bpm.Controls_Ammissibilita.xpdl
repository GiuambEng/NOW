        <xpdl2:Activity Id="_hzfpUHEgEee0o4pQ6mlIUQ">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_kdDiAHEfEee0o4pQ6mlIUQ"/>
                  <xpdl2:TransitionRef Id="_h-6PIHEgEee0o4pQ6mlIUQ"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="43.0" LaneId="_x7_BwXEeEee0o4pQ6mlIUQ" Width="41.0">
              <xpdl2:Coordinates XCoordinate="284.0" YCoordinate="264.0"/>
