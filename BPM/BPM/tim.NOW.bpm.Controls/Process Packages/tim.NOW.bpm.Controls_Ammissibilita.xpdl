						{&#xD;
							var componente = assetDatiMig.dettaglioasset.get(i);&#xD;
							if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
							{&#xD;
								accessoTrovato = true;&#xD;
								var j = 0;&#xD;
								while((!DIREZIONALITA || !DESTINAZIONEUSO || !TIPOLINEA || !STRUTTURALINEA || !PROFILOTECNICOLINEA || !USERVLAN1TAGGING || !ENCAPSULATION || !TIPOLOGIACLUSTERCOMUNE || !SEMIFIBRAFTTH || !ROEFFIB || !CARATTERIZZAZIONEGEO || !FULLGPONPLUS) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
								{&#xD;
									var attributo = componente.attributidettaglioasset.get(j);&#xD;
									if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA)&#xD;
									{&#xD;
										DIREZIONALITA = true;&#xD;
										ConsistenzaDati.direzionalita = attributo.valoreAttributo;&#xD;
									}								&#xD;
									else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
									{&#xD;
										DESTINAZIONEUSO = true;&#xD;
										ConsistenzaDati.destinazioneUso = attributo.valoreAttributo;&#xD;
									}								&#xD;
									else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
									{&#xD;
										TIPOLINEA = true;&#xD;
										ConsistenzaDati.tipoLinea = attributo.valoreAttributo;&#xD;
									}								&#xD;
									else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
									{&#xD;
										STRUTTURALINEA = true;&#xD;
										ConsistenzaDati.strutturaLinea = attributo.valoreAttributo;&#xD;
									}&#xD;
									else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
									{&#xD;
										PROFILOTECNICOLINEA = true;&#xD;
										ConsistenzaDati.profiloTecnicoLinea = attributo.valoreAttributo;&#xD;
									}&#xD;
									else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING)&#xD;
									{&#xD;
										USERVLAN1TAGGING = true;&#xD;
										ConsistenzaDati.uservlan1Tagging = attributo.valoreAttributo;&#xD;
									}&#xD;
									else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
									{&#xD;
										ENCAPSULATION = true;&#xD;
										ConsistenzaDati.encapsulation = attributo.valoreAttributo;&#xD;
									}&#xD;
									else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE) //RU_964&#xD;
									{&#xD;
										TIPOLOGIACLUSTERCOMUNE = true;&#xD;
										ConsistenzaDati.tipologiaClusterComune = attributo.valoreAttributo;&#xD;
									}&#xD;
									//Task #34854&#xD;
									else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SEMIFIBRAFTTH) &#xD;
									{&#xD;
										SEMIFIBRAFTTH = true;&#xD;
										ConsistenzaDati.semiFibraFTTH = attributo.valoreAttributo;&#xD;
									}&#xD;
									//RU_1275&#xD;
									else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROEFFIB) &#xD;
									{&#xD;
										ROEFFIB = true;&#xD;
										ConsistenzaDati.roeFFIB = attributo.valoreAttributo;&#xD;
									}&#xD;
									//RU_1353&#xD;
									else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO) &#xD;
									{&#xD;
										CARATTERIZZAZIONEGEO = true;&#xD;
										ConsistenzaDati.caratterizzazioneGEO = attributo.valoreAttributo;&#xD;
									}&#xD;
									else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FULLGPONPLUS) &#xD;
									{&#xD;
										FULLGPONPLUS = true;&#xD;
										ConsistenzaDati.fullGponPlus = attributo.valoreAttributo;&#xD;
									}&#xD;
									j++;&#xD;
								}&#xD;
							}	&#xD;
							i++;&#xD;
						}&#xD;
&#xD;
&#xD;
						if (ConsistenzaDati.tipoLinea == &quot;LineaNonFonia&quot; ) &#xD;
						{&#xD;
							ConsistenzaDati.flagBTSNaked='Y';&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							ConsistenzaDati.flagBTSNaked='N';&#xD;
						}&#xD;
						&#xD;
&#xD;
						ConsistenzaDati.opzioneDinamica = assetDatiMig.opzioneDinamica;&#xD;
						&#xD;
&#xD;
						var cclionuTrovato=false;&#xD;
						var i=0;&#xD;
						while(!cclionuTrovato &amp;&amp; i &lt; assetDatiMig.dettaglioasset.size())&#xD;
						{&#xD;
							var currentComponente = assetDatiMig.dettaglioasset.get(i);&#xD;
							if ((String(currentComponente.nomeComponente) == &quot;ACCESSONGAFTTCAB&quot;) || (String(currentComponente.nomeComponente) == &quot;ACCESSOVULAFTTCAB&quot;))&#xD;
							{&#xD;
								var j = 0;&#xD;
								while (j &lt; currentComponente.attributidettaglioasset.size())&#xD;
								{&#xD;
									var currentAttributo = currentComponente.attributidettaglioasset.get(j);&#xD;
									if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CCLIONU)&#xD;
									{&#xD;
										ConsistenzaDati.cclionu = currentAttributo.valoreAttributo;&#xD;
										cclionuTrovato=true;&#xD;
									}&#xD;
									j++;&#xD;
								}&#xD;
							}&#xD;
							i++;&#xD;
						}&#xD;
						&#xD;
						&#xD;
					}&#xD;
&#xD;
					ExDoppioDonating = true; // ABILITA //---DOPPIO DONATING---// e //---ARRICCHIMENTO LAVORAZIONE RICHIESTA---// (script task successivo)&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Verifiche CowCode non superate.&quot;;&#xD;
					CodiceEsito = &quot;KO_02&quot;;&#xD;
					if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
					|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
					{&#xD;
						CodiceEsito = &quot;KO_10&quot;;&#xD;
					}&#xD;
					else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
					{&#xD;
						CodiceEsito = &quot;KO_11&quot;;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset recuperati: &quot; + String(Asset1.IDAsset) + &quot; e &quot; + String(Asset2.IDAsset) + &quot; non adeguati.&quot;;&#xD;
			CodiceEsito = &quot;KO_01&quot;;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
&#xD;
		if(FaultMigRecipientCondiviso)&#xD;
		{&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Caso particolare Recipient Condiviso e Donating Condiviso non superato.&quot;;&#xD;
			&#xD;
			if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL ||&#xD;
				localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
			{&#xD;
				if(Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB)&#xD;
				{&#xD;
					CodiceEsito = &quot;KO_07&quot;; //SM_8270&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					CodiceEsito = &quot;KO_08&quot;;&#xD;
				}&#xD;
			}&#xD;
			else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
			{&#xD;
				if(String(localRequest.offerta).slice(0,3)==&quot;SHA&quot; &amp;&amp; Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB)&#xD;
				{&#xD;
					CodiceEsito = &quot;KO_21&quot;; //SM_8270&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					CodiceEsito = &quot;KO_09&quot;;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			//RU_653 e SM_7935&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Caso particolare Vula FTTH o BitstreamNGAFTTH non superato.&quot;;&#xD;
			&#xD;
			if ((Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH &#xD;
			     || Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH &#xD;
				 || Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH &#xD;
				 || Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
				 || Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS         //RU_1544&#xD;
				 || Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)&#xD;
				&amp;&amp; (!OfferteFTTH.contains(String(localRequest.offerta))&#xD;
				    &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
					&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA))   //SM_11629&#xD;
			{&#xD;
				if(localRequest.strutturaRichiesta==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
				|| localRequest.strutturaRichiesta==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)&#xD;
				{&#xD;
					CodiceEsito = &quot;KO_19&quot;;&#xD;
				}&#xD;
				else if(String(localRequest.offerta).slice(0,3)==&quot;WLR&quot;)&#xD;
				{&#xD;
					CodiceEsito = &quot;KO_18&quot;;&#xD;
				}&#xD;
				else&#xD;
				{				&#xD;
					CodiceEsito = &quot;KO_17&quot;;&#xD;
				}&#xD;
			}&#xD;
			else if((Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH || Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)&#xD;
				&amp;&amp; !OfferteFTTH.contains(String(localRequest.offerta)))&#xD;
			{&#xD;
				if(localRequest.strutturaRichiesta==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
				|| localRequest.strutturaRichiesta==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)&#xD;
				{&#xD;
					CodiceEsito = &quot;KO_07&quot;;&#xD;
				}&#xD;
				else if(String(localRequest.offerta).slice(0,3)==&quot;WLR&quot;)&#xD;
				{&#xD;
					CodiceEsito = &quot;KO_18&quot;;&#xD;
				}&#xD;
				else&#xD;
				{				&#xD;
					CodiceEsito = &quot;KO_17&quot;;&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				// RU_685&#xD;
				if(Asset1 != null &amp;&amp;&#xD;
				   (((Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT ||&#xD;
					  Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL) &amp;&amp; &#xD;
						(Asset1.codificaOLOAGCOM != localRequest.codificaOLOAGCOM || &#xD;
						  ((localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB &amp;&amp; &#xD;
							localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB) ||&#xD;
							localRequest.flagNaked == 'N'))) ||&#xD;
					  Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)&#xD;
					  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
					  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH) //SM_8270&#xD;
				{&#xD;
					CodiceEsito = &quot;KO_07&quot;;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					CodiceEsito = &quot;KO_08&quot;;						  &#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	// RU_897 - logica su valorizzazione CAMBIOTECNOLOGIA&#xD;
	if(EsitoResponse.codice &amp;&amp; localRequest.cambioTecnologia == 'S') // SM_8936: eliminata logica su codiceSessione = CAMBIOTECNOLOGIA&#xD;
	{&#xD;
		var scarto = false;&#xD;
		&#xD;
		if(VerificaCowCodeOLOResponse != null&#xD;
		&amp;&amp; VerificaCowCodeOLOResponse.codiceOLOPadre1 != localRequest.codificaOLOAGCOM)&#xD;
		{&#xD;
			scarto = true;&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Migrazione | &quot;+localRequest.codiceSessione+&quot; | VerificaCowCodeOLOResponse.codiceOLOPadre1: &quot;+VerificaCowCodeOLOResponse.codiceOLOPadre1+&quot;, localRequest.codificaOLOAGCOM: &quot;+localRequest.codificaOLOAGCOM);&#xD;
		}&#xD;
		&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
		 || String(localRequest.offerta).slice(0,3) == &quot;SLU&quot;&#xD;
		 || String(localRequest.offerta).slice(0,3) == &quot;ULL&quot;)&#xD;
		{&#xD;
			if(ConsistenzaFonia != null &#xD;
				&amp;&amp;(ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEANONATTIVA ||&#xD;
				   ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEANONATTIVA)&#xD;
				&amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating == 'TLC'&#xD;
				&amp;&amp;(ConsistenzaFonia.destinazioneUso == '1' || ConsistenzaFonia.destinazioneUso == '2' || ConsistenzaFonia.destinazioneUso == '3')&#xD;
				&amp;&amp; ConsistenzaFonia.IDRisorsaCorrelato != null)&#xD;
			{&#xD;
				scarto = true;&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Migrazione | &quot;+localRequest.codiceSessione+&quot; | Offerta: &quot;+localRequest.offerta+&quot;, offertaCONS: &quot;+ConsistenzaFonia.offerta+&quot;, codificaOLOAGCOMDonatingCONS: &quot;+ConsistenzaFonia.codificaOLOAGCOMDonating+&quot;, destinazioneUsoCONS: &quot;+ConsistenzaFonia.destinazioneUso);&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			scarto = true;&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Migrazione | &quot;+localRequest.codiceSessione+&quot; | Offerta: &quot;+localRequest.offerta);&#xD;
		}&#xD;
		&#xD;
		if(localRequest.numeroTelefonico != null || (localRequest.DNAggiuntivo != null &amp;&amp; localRequest.DNAggiuntivo.size()>0))&#xD;
		{&#xD;
			scarto = true;&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Migrazione | &quot;+localRequest.codiceSessione+&quot; | localRequest.numeroTelefonico: &quot;+localRequest.numeroTelefonico+&quot;, localRequest.DNAggiuntivo: &quot;+localRequest.DNAggiuntivo);&#xD;
		}&#xD;
		&#xD;
		if(scarto)&#xD;
		{&#xD;
			if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
			|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: condizioni per CAMBIOTECNOLOGIA non verificate&quot;;&#xD;
				CodiceEsito = &quot;KO_12&quot;;&#xD;
			}&#xD;
			else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: condizioni per CAMBIOTECNOLOGIA non verificate&quot;;&#xD;
				CodiceEsito = &quot;KO_23&quot;;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Individuate Consistenze dello stesso tipo: Fonia/Fonia - Dati/dati o Consistenze di tipo Fonia/Dati+Fonia - Dati/Dati+Fonia&quot;;&#xD;
	CodiceEsito = &quot;KO_01&quot;;&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Migrazione | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="90.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="141.0">
              <xpdl2:Coordinates XCoordinate="818.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_7vE38e4CEeazSbn9P97FTQ" Name="AttivazioneBTSCondivisoSHA" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Attivazione BTS Condiviso/SHA">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
CodiceEsito = null;&#xD;
&#xD;
//--------------------------------------------------DEFINIZIONE ASSET--------------------------------------------------//&#xD;
var assetFonia = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetFonia = null;&#xD;
var assetDati = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetDati = null;&#xD;
var asset1 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset1 = null;&#xD;
var asset2 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset2 = null;&#xD;
&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione BTS Condiviso/SHA | Verifica servizio in consistenza Attivazione BTS Condiviso/SHA.&quot;);&#xD;
&#xD;
//--------------------------------------------------RECUPERA ASSET FONIA--------------------------------------------------//&#xD;
var idRisorsaFonia = &quot;&quot;;&#xD;
idRisorsaFonia = null;&#xD;
var i = 0;&#xD;
var j = 0;&#xD;
&#xD;
if(IDRisorsaDIN != null)&#xD;
{&#xD;
	idRisorsaFonia = IDRisorsaDIN;&#xD;
}&#xD;
else if(VerificaIDRisorsaResponse != null)&#xD;
{&#xD;
	idRisorsaFonia = VerificaIDRisorsaResponse.idRisorsaFonia;&#xD;
}&#xD;
&#xD;
if(idRisorsaFonia != null &amp;&amp; idRisorsaFonia != &quot;&quot;)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND offerta NOT IN ('CPS','NP')&quot;);&#xD;
	c.setQueryParameter(&quot;idr&quot;, idRisorsaFonia);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione BTS Condiviso/SHA | Recuperato asset FONIA con IDRisorsa=&quot;+idRisorsaFonia);&#xD;
	}&#xD;
}&#xD;
&#xD;
if(result != null &amp;&amp; result.size() > 1)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND offerta NOT IN ('CPS','NP') AND IDAsset &lt;>: ida&quot;);&#xD;
	c.setQueryParameter(&quot;idr&quot;, idRisorsaFonia);&#xD;
	c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(asset1.IDAsset));&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		asset2 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione BTS Condiviso/SHA | Recuperato ulteriore asset FONIA con IDRisorsa=&quot;+idRisorsaFonia);&#xD;
	}&#xD;
	&#xD;
	if(asset1.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
	&amp;&amp; asset2.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
	&amp;&amp; ((String(asset1.offerta).slice(0, 3) == &quot;ULL&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;ULL&quot;)&#xD;
		|| (String(asset1.offerta).slice(0, 3) == &quot;SLU&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;SLU&quot;)))&#xD;
	{&#xD;
		assetFonia = asset1;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: AssetFonia recuperato non univoco.&quot;;&#xD;
		CodiceEsito = &quot;KO_01&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	if(asset1 != null)&#xD;
	{&#xD;
		assetFonia = asset1;&#xD;
		//--------------------------------------------------VERIFICA COERENZA LAVORAZIONE--------------------------------------------------//&#xD;
		if(assetFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
			&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
				|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB))&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Cosistenza fonia non compatibile con la richiesta assetFonia.offerta: &quot; + assetFonia.offerta + &quot; &quot;;&#xD;
			CodiceEsito = &quot;KO_07&quot;;&#xD;
		}&#xD;
		else if(assetFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA ||&#xD;
				assetFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA) // RU_778 - aggiunto scarto su BANDASERVIZIO&#xD;
		{&#xD;
			var BANDASERVIZIO = false;&#xD;
			var i = 0;&#xD;
			var accessoTrovato = false;&#xD;
			&#xD;
			while(!accessoTrovato &amp;&amp; i &lt; assetFonia.dettaglioasset.size())&#xD;
			{&#xD;
				var componente = assetFonia.dettaglioasset.get(i);&#xD;
				if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					accessoTrovato = true;&#xD;
					var j = 0;&#xD;
					while(!BANDASERVIZIO &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
					{&#xD;
						var attributo = componente.attributidettaglioasset.get(j);&#xD;
&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDASERVIZIO)&#xD;
						{&#xD;
							BANDASERVIZIO = true;&#xD;
							&#xD;
							if(attributo.valoreAttributo == 'ISDN PRA')&#xD;
							{&#xD;
								if(String(localRequest.offerta).slice(0, 3) == &quot;SHA&quot;)&#xD;
								{&#xD;
									EsitoResponse.codice = false;&#xD;
									EsitoResponse.descrizione = &quot;Cosistenza fonia non compatibile con la richiesta assetFonia.offerta: &quot; + assetFonia.offerta + &quot; &quot;;&#xD;
									CodiceEsito = &quot;KO_23&quot;;&#xD;
								}&#xD;
								else&#xD;
								{&#xD;
									EsitoResponse.codice = false;&#xD;
									EsitoResponse.descrizione = &quot;Cosistenza fonia non compatibile con la richiesta assetFonia.offerta: &quot; + assetFonia.offerta + &quot; &quot;;&#xD;
									CodiceEsito = &quot;KO_24&quot;;&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
			&#xD;
		}&#xD;
		else if((assetFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
			|| assetFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
			|| assetFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
			|| assetFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
			|| assetFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
			|| assetFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA)&#xD;
			&amp;&amp; assetFonia.codificaOLOAGCOM != &quot;TLC&quot;)&#xD;
		{&#xD;
			if(String(localRequest.offerta).slice(0, 3) == &quot;SHA&quot;)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Cosistenza fonia non compatibile con la richiesta assetFonia.offerta: &quot; + assetFonia.offerta + &quot; &quot;;&#xD;
				CodiceEsito = &quot;KO_15&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Cosistenza fonia non compatibile con la richiesta assetFonia.offerta: &quot; + assetFonia.offerta + &quot; &quot;;&#xD;
				CodiceEsito = &quot;KO_07&quot;;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			//--------------------------------------------------RECUPERA ASSET DATI-------------------------------------------------//&#xD;
			if(assetFonia.IDRisorsaCorrelato != null &amp;&amp; assetFonia.IDRisorsaCorrelato != &quot;&quot;)&#xD;
			{&#xD;
				var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI'&quot;);&#xD;
				c.setQueryParameter(&quot;idr&quot;, assetFonia.IDRisorsaCorrelato);&#xD;
				var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
				if(result != null &amp;&amp; result.size() > 0)&#xD;
				{&#xD;
					AssetRef2 = result.get(0);&#xD;
					assetDati = ScriptUtil.copy(AssetRef2.readAsset());&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione BTS Condiviso/SHA | Recuperato asset DATI correlato con IDRisorsa=&quot;+assetFonia.IDRisorsaCorrelato);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND codificaOLOAGCOM = 'TLC' AND offerta &lt;> 'CPS'&quot;);&#xD;
					c.setQueryParameter(&quot;idr&quot;, assetFonia.IDRisorsaCorrelato);&#xD;
					var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
					if(result != null &amp;&amp; result.size() > 0)&#xD;
					{&#xD;
						AssetRef2 = result.get(0);&#xD;
						assetDati = ScriptUtil.copy(AssetRef2.readAsset());&#xD;
						Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione BTS Condiviso/SHA | Recuperato asset correlato di tipo FONIA con IDRisorsa=&quot;+assetFonia.IDRisorsaCorrelato);&#xD;
					}&#xD;
				}&#xD;
			&#xD;
				if(result != null &amp;&amp; result.size() > 1)&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: AssetDati recuperato non univoco.&quot;;&#xD;
					CodiceEsito = &quot;KO_01&quot;;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					if(assetDati != null)&#xD;
					{&#xD;
						if(assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
							|| assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
						{&#xD;
							EsitoResponse.codice = false;&#xD;
							EsitoResponse.descrizione = &quot;Cosistenza dati non compatibile con la richiesta assetDati.offerta: &quot; + assetDati.offerta + &quot; &quot;;&#xD;
							CodiceEsito = &quot;KO_13&quot;;&#xD;
						}&#xD;
						else if(assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
								|| assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
								|| assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
								|| assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
								|| assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
								|| assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
								|| assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
								|| assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE)&#xD;
						{&#xD;
							EsitoResponse.codice = false;&#xD;
							EsitoResponse.descrizione = &quot;Cosistenza dati non compatibile con la richiesta assetDati.offerta: &quot; + assetDati.offerta + &quot; &quot;;&#xD;
							CodiceEsito = &quot;KO_14&quot;;&#xD;
						}&#xD;
						else if(assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA&#xD;
								|| assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA)&#xD;
						{&#xD;
							EsitoResponse.codice = false;&#xD;
							EsitoResponse.descrizione = &quot;Cosistenza dati non compatibile con la richiesta assetDati.offerta: &quot; + assetDati.offerta + &quot; &quot;;&#xD;
							CodiceEsito = &quot;KO_15&quot;;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: consistenza non trovata per idRisorsaFonia: &quot; + idRisorsaFonia;&#xD;
		CodiceEsito = &quot;KO_02&quot;;&#xD;
	}&#xD;
}	&#xD;
&#xD;
//--------------------------------------------------ARRICCHIMENTO-------------------------------------------------//&#xD;
if(EsitoResponse.codice)&#xD;
{&#xD;
	//--------------------------------------------------CREA CONSISTENZA FONIA-------------------------------------------------//&#xD;
	if(assetFonia != null)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione BTS Condiviso/SHA | Creazione componente Consistenza Fonia: &quot;+assetFonia.IDAsset);&#xD;
		&#xD;
		ConsistenzaFonia = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFoniaType();&#xD;
		//IDRISORSA&#xD;
		ConsistenzaFonia.IDRisorsa = assetFonia.IDRisorsa;&#xD;
		//IDRISORSANOW&#xD;
		ConsistenzaFonia.IDRisorsaNOW = assetFonia.IDRisorsaNOW;&#xD;
		//OFFERTA&#xD;
		ConsistenzaFonia.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetFonia.offerta));&#xD;
		//CODIFICAOLOAGCOMDONATING&#xD;
		ConsistenzaFonia.codificaOLOAGCOMDonating = assetFonia.codificaOLOAGCOM;&#xD;
		//CODICEORDINETI&#xD;
		ConsistenzaFonia.codiceOrdineTI = assetFonia.codiceOrdineTI;&#xD;
		//CODICEORDINEOLO&#xD;
		ConsistenzaFonia.codiceOrdineOLO = assetFonia.codiceOrdineOLO;&#xD;
		//IDENTIFICATIVOASSET&#xD;
		ConsistenzaFonia.IDAsset = assetFonia.IDAsset;&#xD;
		//NUMERO TELEFONICO&#xD;
		ConsistenzaFonia.numeroTelefonico = assetFonia.numeroTelefonico;&#xD;
		//STATO&#xD;
		ConsistenzaFonia.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(assetFonia.statoAsset));		&#xD;
		//AZIONE INSERITA CON SM_7861&#xD;
		ConsistenzaFonia.azione=&quot;M&quot;;&#xD;
		//DESTINAZIONE USO&#xD;
		//STRUTTURALINEA&#xD;
		//TIPOLINEA&#xD;
		var DESTINAZIONEUSO = false;&#xD;
		var TIPOLINEA = false;&#xD;
		var STRUTTURALINEA = false;&#xD;
		var BANDASERVIZIO = false;&#xD;
		var TIPOLOGIACLUSTERCOMUNE = false; //RU_964&#xD;
		&#xD;
		ConsistenzaFonia.assetBTWhiteList = assetFonia.assetBTWhiteList; //R1E-21-0325&#xD;
		&#xD;
		//R1E-21-0325&#xD;
		if(ConsistenzaFonia.assetBTWhiteList != null &amp;&amp; ConsistenzaFonia.assetBTWhiteList != &quot;&quot;)&#xD;
		{&#xD;
			localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
		}&#xD;
		&#xD;
		var i = 0;&#xD;
		var accessoTrovato = false;&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; assetFonia.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetFonia.dettaglioasset.get(i);&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				while((!DESTINAZIONEUSO || !TIPOLINEA || !STRUTTURALINEA || !BANDASERVIZIO || !TIPOLOGIACLUSTERCOMUNE) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
					{&#xD;
						DESTINAZIONEUSO = true;&#xD;
						ConsistenzaFonia.destinazioneUso = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						TIPOLINEA = true;&#xD;
						ConsistenzaFonia.tipoLinea = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
					{&#xD;
						STRUTTURALINEA = true;&#xD;
						ConsistenzaFonia.strutturaLinea = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDASERVIZIO) // RU_778 - aggiunta valorizzazione BANDASERVIZIO in Consistenza Fonia&#xD;
					{&#xD;
						BANDASERVIZIO = true;&#xD;
						ConsistenzaFonia.bandaServizio = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE)&#xD;
					{&#xD;
						TIPOLOGIACLUSTERCOMUNE = true;&#xD;
						ConsistenzaFonia.tipologiaClusterComune = attributo.valoreAttributo;		&#xD;
					}&#xD;
					&#xD;
					j++;&#xD;
				}&#xD;
			}	&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//--------------------------------------------------CREA CONSISTENZA DATI-------------------------------------------------//&#xD;
	if(assetDati != null)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione BTS Condiviso/SHA | Creazione componente Consistenza Dati: &quot;+assetDati.IDAsset);&#xD;
		&#xD;
		ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();&#xD;
		//IDRISORSA&#xD;
		ConsistenzaDati.IDRisorsa = assetDati.IDRisorsa;&#xD;
		//IDRISORSANOW&#xD;
		ConsistenzaDati.IDRisorsaNOW = assetDati.IDRisorsaNOW;			&#xD;
		//OFFERTA&#xD;
		ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetDati.offerta));		&#xD;
		//CODIFICAOLOAGCOMDONATING&#xD;
		ConsistenzaDati.codificaOLOAGCOMDonating = assetDati.codificaOLOAGCOM;&#xD;
		//CODICEORDINETI&#xD;
		ConsistenzaDati.codiceOrdineTI = assetDati.codiceOrdineTI;		&#xD;
		//CODICEORDINEOLO&#xD;
		ConsistenzaDati.codiceOrdineOLO = assetDati.codiceOrdineOLO;		&#xD;
		//IDENTIFICATIVOASSET&#xD;
		ConsistenzaDati.IDAsset = assetDati.IDAsset;		&#xD;
		//NUMERO TELEFONICO&#xD;
		ConsistenzaDati.numeroTelefonico = assetDati.numeroTelefonico;		&#xD;
		//STATO&#xD;
		ConsistenzaDati.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(assetDati.statoAsset));		&#xD;
		//OPZIONEDINAMICA&#xD;
		ConsistenzaDati.opzioneDinamica=assetDati.opzioneDinamica;&#xD;
		//AZIONE INSERITA CON SM_7861&#xD;
		ConsistenzaDati.azione=&quot;D&quot;;&#xD;
		&#xD;
		ConsistenzaDati.assetBTWhiteList = assetDati.assetBTWhiteList; //R1E-21-0325&#xD;
		&#xD;
		//R1E-21-0325&#xD;
		if(ConsistenzaDati.assetBTWhiteList != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != &quot;&quot;)&#xD;
		{&#xD;
			localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
		}&#xD;
		&#xD;
		//RU_1275&#xD;
		if(assetDati.exOperatoreRete != null &amp;&amp; assetDati.exOperatoreRete != &quot;&quot;)&#xD;
		{&#xD;
			localRequest.exOperatoreRete = assetDati.exOperatoreRete;&#xD;
			localRequest.ordine.exOperatoreRete = assetDati.exOperatoreRete;&#xD;
		}&#xD;
&#xD;
		&#xD;
		//DESTINAZIONE USO&#xD;
		//STRUTTURALINEA&#xD;
		//TIPOLINEA&#xD;
		var DESTINAZIONEUSO = false;&#xD;
		var TIPOLINEA = false;&#xD;
		var STRUTTURALINEA = false;&#xD;
		var TIPOLOGIACLUSTERCOMUNE = false; //RU_964&#xD;
		&#xD;
		var i = 0;&#xD;
		var accessoTrovato = false;&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; assetDati.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetDati.dettaglioasset.get(i);&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				while((!DESTINAZIONEUSO || !TIPOLINEA || !STRUTTURALINEA || !TIPOLOGIACLUSTERCOMUNE) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
					{&#xD;
						DESTINAZIONEUSO = true;&#xD;
						ConsistenzaDati.destinazioneUso = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						TIPOLINEA = true;&#xD;
						ConsistenzaDati.tipoLinea = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
					{&#xD;
						STRUTTURALINEA = true;&#xD;
						ConsistenzaDati.strutturaLinea = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE)&#xD;
					{&#xD;
						TIPOLOGIACLUSTERCOMUNE = true;&#xD;
						ConsistenzaDati.tipologiaClusterComune = attributo.valoreAttributo;		&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}	&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//--------------------------------------------------ARRICCHIMENTO LAVORAZIONE RICHIESTA--------------------------------------------------//&#xD;
&#xD;
if(ConsistenzaFonia != null &amp;&amp; String(localRequest.offerta).slice(0,3) == 'SHA')&#xD;
{&#xD;
	&#xD;
	if (ConsistenzaFonia.offerta!= null &amp;&amp; (String(ConsistenzaFonia.offerta).slice(0,3) == &quot;WLR&quot; || String(ConsistenzaFonia.offerta).slice(0,4) == &quot;VULL&quot;))&#xD;
	{&#xD;
		LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
		LavorazioneRichiesta.tipoLinea = ConsistenzaFonia.tipoLinea;&#xD;
	}&#xD;
	else if (ConsistenzaFonia.offerta!= null &amp;&amp; (String(ConsistenzaFonia.offerta).slice(0,3) == &quot;ULL&quot; || String(ConsistenzaFonia.offerta).slice(0,3) == &quot;SLU&quot;))&#xD;
	{&#xD;
		LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
		&#xD;
		if (ConsistenzaFonia.destinazioneUso!= null &amp;&amp; (ConsistenzaFonia.destinazioneUso == '1' || ConsistenzaFonia.destinazioneUso.slice(0,2) == '1|'))&#xD;
		{&#xD;
			LavorazioneRichiesta.tipoLinea = &quot;POTS&quot;;&#xD;
		}&#xD;
		else if (ConsistenzaFonia.destinazioneUso!= null &amp;&amp; (ConsistenzaFonia.destinazioneUso == '2' || ConsistenzaFonia.destinazioneUso == '3'|| ConsistenzaFonia.destinazioneUso.slice(0,2) == '2|'|| ConsistenzaFonia.destinazioneUso.slice(0,2) == '3|'))&#xD;
		{&#xD;
			LavorazioneRichiesta.tipoLinea = &quot;ISDN&quot;;&#xD;
		}&#xD;
		else if (ConsistenzaFonia.destinazioneUso!= null &amp;&amp; (ConsistenzaFonia.destinazioneUso == '4' ||  ConsistenzaFonia.destinazioneUso == '10'|| ConsistenzaFonia.destinazioneUso.slice(0,2) == '4|'))&#xD;
		{&#xD;
			LavorazioneRichiesta.tipoLinea = &quot;ADSL&quot;;&#xD;
		}&#xD;
		&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione BTS Condiviso/SHA | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="89.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="168.0">
              <xpdl2:Coordinates XCoordinate="887.0" YCoordinate="850.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_jCYp0O4EEeazSbn9P97FTQ" Name="CessazioneULLULLDatiSLUNP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Cessazione ULL/ULLDati/SLU + NP">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
CodiceEsito = null;&#xD;
&#xD;
//--------------------------------------------------DEFINIZIONE ASSET--------------------------------------------------//&#xD;
var assetFonia = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetFonia = null;&#xD;
var assetNP= it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetNP = null;&#xD;
var asset1 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset1 = null;&#xD;
var asset2= it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset2 = null;&#xD;
&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione ULL/ULLDati/SLU + NP | Verifica servizio in consistenza Cessazione ULL/ULLDati/SLU + NP.&quot;);&#xD;
&#xD;
//--------------------------------------------------RECUPERA ASSET FONIA/DATI--------------------------------------------------//&#xD;
&#xD;
if(localRequest.IDRisorsa != null &amp;&amp; localRequest.IDRisorsa != &quot;&quot;)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: IDr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND offerta &lt;> 'CPS'&quot;);&#xD;
	c.setQueryParameter(&quot;IDr&quot;, localRequest.IDRisorsa);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione ULL/ULLDati/SLU + NP | Trovati asset per IDRisorsa =&quot;+localRequest.IDRisorsa);&#xD;
		&#xD;
		var i = 0;&#xD;
		while(i &lt; result.size())&#xD;
		{&#xD;
			var assetTempRef = result.get(i);&#xD;
			var assetTemp = assetTempRef.readAsset();&#xD;
			if(assetTemp.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP)&#xD;
			{&#xD;
				if(asset1 == null)&#xD;
				{&#xD;
					asset1 = ScriptUtil.copy(assetTemp);&#xD;
				}&#xD;
				else if(asset2 == null)&#xD;
				{&#xD;
					asset2 = ScriptUtil.copy(assetTemp);&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				assetNP = ScriptUtil.copy(assetTemp);&#xD;
			}&#xD;
			i++;	&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(asset1 != null)&#xD;
	{&#xD;
		if(asset2 != null)&#xD;
		{&#xD;
			if(!(asset1.codificaOLOAGCOM == &quot;TLC&quot; &amp;&amp; asset2.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
				 &amp;&amp; ((String(asset1.offerta).slice(0, 3) == &quot;ULL&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;ULL&quot;)||&#xD;
					 (String(asset1.offerta).slice(0, 3) == &quot;SLU&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;SLU&quot;)))) //RU_632&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: caso particolare ULL + ULL di TI non superato.&quot;;&#xD;
				CodiceEsito = &quot;KO_01&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				var DestinazioneUso1 = &quot;&quot;;&#xD;
				DestinazioneUso1 = null;&#xD;
				var destinazioneUso2 = &quot;&quot;;&#xD;
				destinazioneUso2 = null;&#xD;
				&#xD;
				var i = 0;&#xD;
				while(DestinazioneUso1 == null &amp;&amp; i &lt; asset1.dettaglioasset.size())&#xD;
				{&#xD;
					var DettAsset1 = asset1.dettaglioasset.get(i);&#xD;
					if(String(DettAsset1.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						var j = 0;&#xD;
						while(DestinazioneUso1 == null &amp;&amp; j &lt; DettAsset1.attributidettaglioasset.size())&#xD;
						{&#xD;
							var AttrDettAsset1 = DettAsset1.attributidettaglioasset.get(j);&#xD;
							if(AttrDettAsset1.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
							{&#xD;
								DestinazioneUso1 = AttrDettAsset1.valoreAttributo;&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					i++;&#xD;
				}&#xD;
	&#xD;
				var i = 0;&#xD;
				while(destinazioneUso2 == null &amp;&amp; i &lt; asset2.dettaglioasset.size())&#xD;
				{&#xD;
					var DettAsset2 = asset2.dettaglioasset.get(i);&#xD;
					if(String(DettAsset2.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						var j = 0;&#xD;
						while(destinazioneUso2 == null &amp;&amp; j &lt; DettAsset2.attributidettaglioasset.size())&#xD;
						{&#xD;
							var AttrDettAsset2 = DettAsset2.attributidettaglioasset.get(j);&#xD;
							if(AttrDettAsset2.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
							{&#xD;
								destinazioneUso2 = AttrDettAsset2.valoreAttributo;&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					i++;&#xD;
				}&#xD;
		&#xD;
				if(destinazioneUsoFonia.contains(DestinazioneUso1))&#xD;
				{&#xD;
					assetFonia = asset1;&#xD;
				}&#xD;
				else if(destinazioneUsoFonia.contains(destinazioneUso2))&#xD;
				{&#xD;
					assetFonia = asset2;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			assetFonia = asset1;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(assetFonia == null || assetNP == null )&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: consistenza non trovata per IDRisorsa: &quot; + localRequest.IDRisorsa;&#xD;
	CodiceEsito = &quot;KO_09&quot;;&#xD;
}&#xD;
&#xD;
//--------------------------------------------------ARRICCHIMENTO-------------------------------------------------//&#xD;
if(EsitoResponse.codice)&#xD;
{&#xD;
	//--------------------------------------------------CREA CONSISTENZA FONIA-------------------------------------------------//&#xD;
	if(assetFonia != null)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione ULL/ULLDati/SLU + NP | Creazione componente Consistenza Fonia: &quot;+assetFonia.IDAsset);&#xD;
		&#xD;
		ConsistenzaFonia = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFoniaType();&#xD;
		//AZIONE&#xD;
		ConsistenzaFonia.azione = &quot;M&quot;;		&#xD;
		//IDRISORSA&#xD;
		ConsistenzaFonia.IDRisorsa= assetFonia.IDRisorsa;			&#xD;
		//OFFERTA&#xD;
		ConsistenzaFonia.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetFonia.offerta));		&#xD;
		//CODIFICAOLOAGCOMDONATING&#xD;
		ConsistenzaFonia.codificaOLOAGCOMDonating = assetFonia.codificaOLOAGCOM;&#xD;
		//CODICEORDINETI&#xD;
		ConsistenzaFonia.codiceOrdineTI = assetFonia.codiceOrdineTI;		&#xD;
		//CODICEORDINEOLO&#xD;
		ConsistenzaFonia.codiceOrdineOLO = assetFonia.codiceOrdineOLO;		&#xD;
		//IDENTIFICATIVOASSET&#xD;
		ConsistenzaFonia.IDAsset = assetFonia.IDAsset;		&#xD;
		//NUMERO TELEFONICO&#xD;
		ConsistenzaFonia.numeroTelefonico = assetFonia.numeroTelefonico;		&#xD;
		//NUMERO TELEFONICO PRINCIPALE&#xD;
		ConsistenzaFonia.numeroTelefonicoPrincipale = assetFonia.numTelPrincipale;		&#xD;
		//STATO&#xD;
		ConsistenzaFonia.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(assetFonia.statoAsset));		&#xD;
		//FATTURAZIONELA&#xD;
		ConsistenzaFonia.fatturazioneLA = &quot;Y&quot;;&#xD;
		//OPERATORERETE - RU_1142&#xD;
		ConsistenzaFonia.operatoreRete = assetFonia.operatoreRete;&#xD;
		&#xD;
		ConsistenzaFonia.assetBTWhiteList = assetFonia.assetBTWhiteList; //R1E-21-0325&#xD;
		&#xD;
		//R1E-21-0325&#xD;
		if(ConsistenzaFonia.assetBTWhiteList != null &amp;&amp; ConsistenzaFonia.assetBTWhiteList != &quot;&quot;)&#xD;
		{&#xD;
			localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
		}&#xD;
		&#xD;
		//DESTINAZIONE USO&#xD;
		//STRUTTURALINEA&#xD;
		//TIPOLINEA&#xD;
		var DESTINAZIONEUSO = false;&#xD;
		var TIPOLINEA = false;&#xD;
		var STRUTTURALINEA = false;&#xD;
		var BANDASERVIZIO = false;&#xD;
		var i = 0;&#xD;
		var accessoTrovato = false;&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; assetFonia.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetFonia.dettaglioasset.get(i);&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				&#xD;
				while((!DESTINAZIONEUSO || !TIPOLINEA || !STRUTTURALINEA || !BANDASERVIZIO) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
					{&#xD;
						DESTINAZIONEUSO = true;&#xD;
						ConsistenzaFonia.destinazioneUso = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						TIPOLINEA = true;&#xD;
						ConsistenzaFonia.tipoLinea = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
					{&#xD;
						STRUTTURALINEA = true;&#xD;
						ConsistenzaFonia.strutturaLinea = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDASERVIZIO) // RU_778 - aggiunta valorizzazione BANDASERVIZIO in Consistenza Fonia&#xD;
					{&#xD;
						BANDASERVIZIO = true;&#xD;
						ConsistenzaFonia.bandaServizio = attributo.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					j++;&#xD;
				}&#xD;
			}	&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//--------------------------------------------------CREA NP-------------------------------------------------//&#xD;
	if(assetNP != null)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione ULL/ULLDati/SLU + NP | Creazione componente NP: &quot;+assetNP.IDAsset);&#xD;
		&#xD;
		var np = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createNumberPortabilityType();&#xD;
		//INVIOADTU&#xD;
		np.invioaDTU = &quot;Y&quot;;		&#xD;
		//AZIONE&#xD;
		ConsistenzaFonia.azione = &quot;D&quot;;	&#xD;
			&#xD;
		//CODICEOPERATOREDONOR&#xD;
		var w = 0;&#xD;
		var CODICEOPERATOREDONOR = false;&#xD;
		while( !CODICEOPERATOREDONOR  &amp;&amp; w &lt; assetNP.dettaglioasset.size())&#xD;
		{&#xD;
			var dettaglioNP = assetNP.dettaglioasset.get(w);&#xD;
				&#xD;
			for (var k=0; k &lt; dettaglioNP.attributidettaglioasset.size(); k++)&#xD;
			{&#xD;
				var attributoNP = dettaglioNP.attributidettaglioasset.get(k);&#xD;
					&#xD;
				if( attributoNP.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR)&#xD;
				{&#xD;
					np.codiceOperatoreDonor = attributoNP.valoreAttributo;&#xD;
					CODICEOPERATOREDONOR = true;&#xD;
				}&#xD;
					&#xD;
				}&#xD;
		w++;&#xD;
		}		&#xD;
		//CODICE ORDINE TI&#xD;
		np.codiceOrdineTI = assetNP.codiceOrdineTI;		&#xD;
		//NUMERO TELEFONICO&#xD;
		np.numeroTelefonico = assetNP.numeroTelefonico;&#xD;
		//NUMERO TELEFONICO PRINCIPALE&#xD;
		np.numeroTelefonicoPrincipale = assetNP.numTelPrincipale;		&#xD;
		//CODICEOPERATOREDONATING&#xD;
		np.codiceOperatoreDonating = assetNP.codificaOLOAGCOM;		&#xD;
		//CODICEOPERATORERECIPIENT&#xD;
		np.codiceOperatoreRecipient = localRequest.codificaOLOAGCOM;&#xD;
&#xD;
		np.assetBTWhiteList = assetNP.assetBTWhiteList; //R1E-21-0325&#xD;
		&#xD;
		//R1E-21-0325&#xD;
		if(np.assetBTWhiteList != null &amp;&amp; np.assetBTWhiteList != &quot;&quot;)&#xD;
		{&#xD;
			localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
		}&#xD;
		&#xD;
		//OLORETAILER&#xD;
		//TIPOLINEA&#xD;
		//ROUTINGNUMBER&#xD;
		//AGGIUNTIVOWLR&#xD;
		var OLORETAILER = false;&#xD;
		var TIPOLINEA = false;&#xD;
		var ROUTINGNUMBER = false;&#xD;
		var AGGIUNTIVOWLR = false;&#xD;
		var i = 0;&#xD;
		var accessoTrovato = false;&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; assetNP.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetNP.dettaglioasset.get(i);&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				while((!OLORETAILER || !ROUTINGNUMBER || !TIPOLINEA || !AGGIUNTIVOWLR) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER)&#xD;
					{&#xD;
						OLORETAILER = true;&#xD;
						np.OLORetailer = attributo.valoreAttributo;		&#xD;
					}&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						TIPOLINEA = true;&#xD;
						np.tipoLinea = attributo.valoreAttributo;		&#xD;
					}&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER)&#xD;
					{&#xD;
						ROUTINGNUMBER = true;&#xD;
						np.routingNumber = attributo.valoreAttributo;		&#xD;
					}&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AGGIUNTIVOWLR)&#xD;
					{&#xD;
						AGGIUNTIVOWLR = true;&#xD;
						np.aggiuntivoWLR = attributo.valoreAttributo;		&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}	&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		//SM_9160 - inserita logica per non creare componente NP quando OLORETAILER != RICHIEDENTE. Da creare solo se non ho l'OLORETAILER, oppure ce l'ho ed è uguale al richiedente&#xD;
		if(!OLORETAILER || np.OLORetailer == localRequest.codificaOLOAGCOM)&#xD;
		{&#xD;
			NumberPortability.add(ScriptUtil.copy(np));&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione ULL/ULLDati/SLU + NP | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="106.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="169.0">
              <xpdl2:Coordinates XCoordinate="889.0" YCoordinate="1791.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_USZf8O4HEeazSbn9P97FTQ" Name="AttivazioneWLRULLSLUVULLLA" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Attivazione WLR/ULL/SLU/VULL + LA">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
&#xD;
var assetFonia = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetFonia = null;&#xD;
var assetDati = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetDati = null;&#xD;
var assetCPS = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetCPS = null;&#xD;
&#xD;
var asset1 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset1 = null;&#xD;
var asset2 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset2 = null;&#xD;
stessaRisorsa = false;&#xD;
&#xD;
var check_KO20 = false;&#xD;
&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Verifica servizio in consistenza Attivazione WLR/ULL/SLU/VULL + LA&quot;);&#xD;
&#xD;
//--------------------------------------------------Calcolo TIPOLINEA e STRUTTURALINEA-------------------------------------------------//&#xD;
	&#xD;
var STRUTTURA_LINEA = &quot;&quot;;&#xD;
var TIPO_LINEA = &quot;&quot;;&#xD;
STRUTTURA_LINEA = null;&#xD;
TIPO_LINEA = null;&#xD;
	&#xD;
if(InventoryPrincipale != null &amp;&amp; InventoryPrincipale.CRMWSResponse != null)&#xD;
{&#xD;
	if(InventoryPrincipale.CRMWSResponse.tipo_Linea.tipo_Numero != &quot;NATIVO VOIP IMS&quot;)&#xD;
	{&#xD;
		if(InventoryPrincipale.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;RTG&quot;)&#xD;
		{&#xD;
			TIPO_LINEA = &quot;POTS&quot;;&#xD;
			STRUTTURA_LINEA = &quot;Simplex&quot;;&#xD;
		}&#xD;
	&#xD;
		else if(InventoryPrincipale.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;CAPOSERIE&quot; &#xD;
		|| InventoryPrincipale.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;LINEA PBX&quot;)&#xD;
		{&#xD;
			if(InventoryPrincipale.CRMWSResponse.tipo_Linea.banda_Servizio == &quot;SX&quot;)&#xD;
			{&#xD;
				TIPO_LINEA = &quot;POTS&quot;;&#xD;
				STRUTTURA_LINEA = &quot;PBX&quot;;&#xD;
			}&#xD;
			else if(InventoryPrincipale.CRMWSResponse.tipo_Linea.banda_Servizio == &quot;ISDN BRA&quot;)&#xD;
			{&#xD;
				TIPO_LINEA = &quot;ISDN&quot;;&#xD;
				STRUTTURA_LINEA = &quot;PBX&quot;;	&#xD;
			}&#xD;
		}&#xD;
		else if(InventoryPrincipale.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;RADICALE&quot;&#xD;
		|| InventoryPrincipale.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;SPE&quot;&#xD;
		|| InventoryPrincipale.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;SPU&quot;)&#xD;
		{&#xD;
			if(InventoryPrincipale.CRMWSResponse.tipo_Linea.banda_Servizio == &quot;SX&quot;)&#xD;
			{&#xD;
				TIPO_LINEA = &quot;POTS&quot;;&#xD;
				STRUTTURA_LINEA = &quot;GNR&quot;;&#xD;
			}&#xD;
			else if(InventoryPrincipale.CRMWSResponse.tipo_Linea.banda_Servizio == &quot;ISDN BRA&quot;)&#xD;
			{&#xD;
				TIPO_LINEA = &quot;ISDN&quot;;&#xD;
				STRUTTURA_LINEA = &quot;GNR&quot;;&#xD;
			}&#xD;
		}&#xD;
		else if(InventoryPrincipale.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;ISDN BMU&quot;)&#xD;
		{&#xD;
			TIPO_LINEA = &quot;ISDN&quot;;&#xD;
			STRUTTURA_LINEA = &quot;BRA MULTI&quot;;&#xD;
		}&#xD;
		else if(InventoryPrincipale.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;ISDN BMO&quot;)&#xD;
		{&#xD;
			TIPO_LINEA = &quot;ISDN&quot;;&#xD;
			STRUTTURA_LINEA = &quot;BRA MONO&quot;;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		var list_tipo_Servizio = DataUtil.createList();&#xD;
		list_tipo_Servizio.add(&quot;ALICE MIA&quot;);&#xD;
		list_tipo_Servizio.add(&quot;ALICE NAKED&quot;);&#xD;
		list_tipo_Servizio.add(&quot;BMO IP CENTREX&quot;);&#xD;
		list_tipo_Servizio.add(&quot;FONIA IP PBX&quot;);&#xD;
		list_tipo_Servizio.add(&quot;FONIA IP PBX P&quot;);&#xD;
		list_tipo_Servizio.add(&quot;FONIA VPBX TOP&quot;);&#xD;
		list_tipo_Servizio.add(&quot;GNR IP CENTREX&quot;);&#xD;
		list_tipo_Servizio.add(&quot;GNR IP PBX&quot;);&#xD;
		list_tipo_Servizio.add(&quot;GNR IP PBX P&quot;);&#xD;
		list_tipo_Servizio.add(&quot;GNR VPBX TOP&quot;);&#xD;
		list_tipo_Servizio.add(&quot;RTG IP CENTREX&quot;);&#xD;
		list_tipo_Servizio.add(&quot;VPBX BASIC&quot;);&#xD;
		list_tipo_Servizio.add(&quot;VPBX PLUS&quot;);&#xD;
	&#xD;
		if(list_tipo_Servizio.contains(InventoryPrincipale.CRMWSResponse.tipo_Linea.tipo_Servizio))&#xD;
		{&#xD;
			TIPO_LINEA = &quot;POTS&quot;;&#xD;
			STRUTTURA_LINEA = &quot;Simplex&quot;;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//SM_9604: recupero offerta recipient per capire se considerare le CPS&#xD;
var recipientCheckCPS = false;&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP //SM_9901: aggiunti Bundle&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP)&#xD;
{&#xD;
	recipientCheckCPS = true;&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | considerare anche eventuali CPS&quot;);&#xD;
}&#xD;
&#xD;
&#xD;
//--------------------------------------------------RECUPERO ASSET-------------------------------------------------//&#xD;
&#xD;
if(localRequest.numeroTelefonico != null &amp;&amp; localRequest.numeroTelefonico != &quot;&quot;)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND offerta &lt;> 'NP'&quot;);&#xD;
	c.setQueryParameter(&quot;idr&quot;, localRequest.numeroTelefonico);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{	&#xD;
		// RU_915 - Controllo se c'è un AssetCPS tra quelli recuperati&#xD;
		for(var i=0; i&lt;result.size(); i++)&#xD;
		{&#xD;
			assetAppoggio = ScriptUtil.copy(result.get(i).readAsset());&#xD;
			&#xD;
			if(assetAppoggio.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
			{&#xD;
				if(recipientCheckCPS) //SM_9604&#xD;
				{&#xD;
					assetCPS = ScriptUtil.copy(assetAppoggio);&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato per IDRisorsa Asset CPS trovato: &quot;+String(assetCPS.IDAsset)+&quot;, considerato: &quot;+recipientCheckCPS);&#xD;
				}&#xD;
				&#xD;
				result.remove(i);&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//Logica standard preesistente&#xD;
		if(result != null &amp;&amp; result.size()>0)&#xD;
		{&#xD;
			AssetRef = result.get(0);&#xD;
			asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato per IDRisorsa Asset: &quot;+asset1.IDAsset);&#xD;
		}		&#xD;
		&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato Asset con IDRisorsa=&quot;+localRequest.numeroTelefonico);&#xD;
	}&#xD;
	&#xD;
	if(asset1 == null)&#xD;
	{&#xD;
		var idRisorsaFonia = &quot;&quot;;&#xD;
		idRisorsaFonia = null;&#xD;
		if(IDRisorsaDIN != null)&#xD;
		{&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | IDRisorsaDIN:&quot;+ IDRisorsaDIN);&#xD;
			idRisorsaFonia = IDRisorsaDIN;&#xD;
		}&#xD;
		else if(VerificaIDRisorsaResponse != null)&#xD;
		{&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | VerificaIDRisorsaResponse.idRisorsaFonia:&quot;+ VerificaIDRisorsaResponse.idRisorsaFonia);&#xD;
			idRisorsaFonia = VerificaIDRisorsaResponse.idRisorsaFonia;&#xD;
		}&#xD;
		&#xD;
		if(idRisorsaFonia != null)&#xD;
		{&#xD;
			c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND offerta &lt;> 'NP'&quot;);&#xD;
			c.setQueryParameter(&quot;idr&quot;, idRisorsaFonia);&#xD;
			var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			if(result != null &amp;&amp; result.size() > 0)&#xD;
			{&#xD;
				// RU_915 - Controllo se c'è un AssetCPS tra quelli recuperati&#xD;
				for(var i=0; i&lt;result.size(); i++)&#xD;
				{&#xD;
					assetAppoggio = ScriptUtil.copy(result.get(i).readAsset());&#xD;
					&#xD;
					if(assetAppoggio.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
					{&#xD;
						if(recipientCheckCPS) //SM_9604&#xD;
						{&#xD;
							assetCPS = ScriptUtil.copy(assetAppoggio);&#xD;
							Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato per IDRisorsa Asset CPS trovato: &quot;+String(assetCPS.IDAsset)+&quot;, considerato: &quot;+recipientCheckCPS);&#xD;
						}&#xD;
						&#xD;
						result.remove(i);&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//Logica standard preesistente&#xD;
				if(result != null &amp;&amp; result.size()>0)&#xD;
				{&#xD;
					AssetRef = result.get(0);&#xD;
					asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato per IDRisorsa Asset: &quot;+asset1.IDAsset);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato Asset con IDRisorsa=&quot;+idRisorsaFonia);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//SM_11544: ricerca asset DATI con offerta VULAFTTCAB - nuova casistica&#xD;
	if(asset1 == null &amp;&amp; idRisorsaFonia != null)&#xD;
	{&#xD;
		c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroFittizio =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta &lt;> 'NP'&quot;);&#xD;
		c.setQueryParameter(&quot;idr&quot;, idRisorsaFonia);&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		if(result != null &amp;&amp; result.size() > 0)&#xD;
		{&#xD;
			//Controllo se c'è un AssetCPS tra quelli recuperati&#xD;
			for(var i=0; i&lt;result.size(); i++)&#xD;
			{&#xD;
				assetAppoggio = ScriptUtil.copy(result.get(i).readAsset());&#xD;
				&#xD;
				if(assetAppoggio.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
				{&#xD;
					if(recipientCheckCPS) //SM_9604&#xD;
					{&#xD;
						assetCPS = ScriptUtil.copy(assetAppoggio);&#xD;
						Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato per IDRisorsa Asset CPS trovato: &quot;+String(assetCPS.IDAsset)+&quot;, considerato: &quot;+recipientCheckCPS);&#xD;
					}					&#xD;
					result.remove(i);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//Logica standard preesistente&#xD;
			if(result != null &amp;&amp; result.size()>0)&#xD;
			{&#xD;
				AssetRef = result.get(0);&#xD;
				asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato per IDRisorsa Asset - trovato asset DATI: &quot;+asset1.IDAsset);&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//SM_11569 - per individuare gli asset con IDRisorsa del tipo Uxxxxx e tipologiaAccesso DATI&#xD;
		if(asset1 == null)&#xD;
		{&#xD;
			c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta &lt;> 'NP'&quot;);&#xD;
			c.setQueryParameter(&quot;idr&quot;, idRisorsaFonia);&#xD;
			var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			if(result != null &amp;&amp; result.size() > 0)&#xD;
			{&#xD;
				//Controllo se c'è un AssetCPS tra quelli recuperati&#xD;
				for(var i=0; i&lt;result.size(); i++)&#xD;
				{&#xD;
					assetAppoggio = ScriptUtil.copy(result.get(i).readAsset());&#xD;
					&#xD;
					if(assetAppoggio.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
					{&#xD;
						if(recipientCheckCPS) //SM_9604&#xD;
						{&#xD;
							assetCPS = ScriptUtil.copy(assetAppoggio);&#xD;
							Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato per IDRisorsa Asset CPS trovato: &quot;+String(assetCPS.IDAsset)+&quot;, considerato: &quot;+recipientCheckCPS);&#xD;
						}					&#xD;
						result.remove(i);&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//Logica standard preesistente&#xD;
				if(result != null &amp;&amp; result.size()>0)&#xD;
				{&#xD;
					AssetRef = result.get(0);&#xD;
					asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato per IDRisorsa Asset - trovato asset DATI: &quot;+asset1.IDAsset);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//SM_11544: asset DATI con offerta VULAFTTCAB - nuova casistica&#xD;
	if(asset1 != null &amp;&amp; asset1.tipologiaAccesso == &quot;DATI&quot;)&#xD;
	{&#xD;
		Log.write(&quot;Trovato asset Dati - non effettuiamo la ricerca di asset2 &quot;);&#xD;
	}&#xD;
	else if(asset1 != null)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Asset1 recuperato: &quot; + asset1.IDAsset);&#xD;
		&#xD;
		var dest = &quot;&quot;;&#xD;
		dest = null;&#xD;
		&#xD;
		//tipologia di asset recuperato&#xD;
		var i = 0;&#xD;
		while(dest == null &amp;&amp; i &lt; asset1.dettaglioasset.size())&#xD;
		{&#xD;
			var DettAsset1 = asset1.dettaglioasset.get(i);&#xD;
			if(String(DettAsset1.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(dest == null &amp;&amp; j &lt; DettAsset1.attributidettaglioasset.size())&#xD;
				{&#xD;
					var AttrDettAsset1 = DettAsset1.attributidettaglioasset.get(j);&#xD;
					if(AttrDettAsset1.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
					{&#xD;
						dest = AttrDettAsset1.valoreAttributo;&#xD;
					}&#xD;
					else if(AttrDettAsset1.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA &amp;&amp; TIPO_LINEA == null)&#xD;
					{&#xD;
						TIPO_LINEA = AttrDettAsset1.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		//SM_7887		&#xD;
		if(!destinazioneUsoFonia.contains(dest) &amp;&amp; // consistenza dati&#xD;
			asset1.codificaOLOAGCOM != localRequest.codificaOLOAGCOM &amp;&amp; &#xD;
			localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL &amp;&amp;&#xD;
			(TIPO_LINEA == &quot;POTS&quot; || TIPO_LINEA == &quot;ISDN&quot;)) // SM_8227: la consistenza dati deve essere di tipo condiviso&#xD;
		{&#xD;
			&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: è stato recuperato un asset dati condiviso con OLO RECIPIENT != OLO in consistenza&quot;;&#xD;
			CodiceEsito = &quot;KO_20&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			//--------------------------------------------------RECUPERA ASSET 2--------------------------------------------------//&#xD;
			if(result != null &amp;&amp; result.size() > 1)&#xD;
			{&#xD;
				//IDRisorsa&#xD;
				var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND IDAsset &lt;>: ida AND offerta &lt;> 'NP'&quot;);&#xD;
				c.setQueryParameter(&quot;idr&quot;, localRequest.numeroTelefonico);&#xD;
				c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(asset1.IDAsset));&#xD;
				var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
				if(result != null &amp;&amp; result.size() > 0)&#xD;
				{&#xD;
					// RU_915 - Controllo se c'è un AssetCPS tra quelli recuperati&#xD;
					for(var i=0; i&lt;result.size(); i++)&#xD;
					{&#xD;
						assetAppoggio = ScriptUtil.copy(result.get(i).readAsset());&#xD;
						&#xD;
						if(assetAppoggio.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
						{&#xD;
							if(recipientCheckCPS) //SM_9604&#xD;
							{&#xD;
								assetCPS = ScriptUtil.copy(assetAppoggio);&#xD;
								Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato per IDRisorsa Asset CPS trovato: &quot;+String(assetCPS.IDAsset)+&quot;, considerato: &quot;+recipientCheckCPS);&#xD;
							}&#xD;
				&#xD;
							result.remove(i);&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					//Logica standard preesistente&#xD;
					if(result != null &amp;&amp; result.size()>0)&#xD;
					{&#xD;
						AssetRef2 = result.get(0);&#xD;
						asset2 = ScriptUtil.copy(AssetRef2.readAsset());&#xD;
						Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato (Asset2) per IDRisorsa Asset: &quot;+asset2.IDAsset);&#xD;
					}					&#xD;
				}&#xD;
				&#xD;
				if(asset2 == null)&#xD;
				{&#xD;
					var idRisorsaFonia = &quot;&quot;;&#xD;
					idRisorsaFonia = null;&#xD;
					if(IDRisorsaDIN != null)&#xD;
					{&#xD;
						idRisorsaFonia = IDRisorsaDIN;&#xD;
					}&#xD;
					else if(VerificaIDRisorsaResponse != null)&#xD;
					{&#xD;
						idRisorsaFonia = VerificaIDRisorsaResponse.idRisorsaFonia;&#xD;
					}&#xD;
					&#xD;
					if(idRisorsaFonia != null)&#xD;
					{&#xD;
						c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND IDAsset &lt;>: ida AND offerta &lt;> 'NP'&quot;);&#xD;
						c.setQueryParameter(&quot;idr&quot;, idRisorsaFonia);&#xD;
						c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(asset1.IDAsset));&#xD;
						var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
						if(result != null &amp;&amp; result.size() > 0)&#xD;
						{&#xD;
							// RU_915 - Controllo se c'è un AssetCPS tra quelli recuperati&#xD;
							for(var i=0; i&lt;result.size(); i++)&#xD;
							{&#xD;
								assetAppoggio = ScriptUtil.copy(result.get(i).readAsset());&#xD;
								&#xD;
								if(assetAppoggio.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
								{&#xD;
									if(recipientCheckCPS) //SM_9604&#xD;
									{&#xD;
										assetCPS = ScriptUtil.copy(assetAppoggio);&#xD;
										Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato per IDRisorsa Asset CPS trovato: &quot;+String(assetCPS.IDAsset)+&quot;, considerato: &quot;+recipientCheckCPS);&#xD;
									}&#xD;
									&#xD;
									result.remove(i);&#xD;
								}&#xD;
							}&#xD;
							&#xD;
							//Logica standard preesistente&#xD;
							if(result != null &amp;&amp; result.size()>0)&#xD;
							{&#xD;
								AssetRef2 = result.get(0);&#xD;
								asset2 = ScriptUtil.copy(AssetRef2.readAsset());&#xD;
								Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato (Asset2) per IDRisorsaFonia Asset: &quot;+asset2.IDAsset);&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					&#xD;
				}&#xD;
&#xD;
				&#xD;
			}&#xD;
			// IDASSETCORRELATO&#xD;
			if (asset2 == null)&#xD;
			{&#xD;
				if(asset1.IDRisorsaCorrelato != null &amp;&amp; asset1.IDRisorsaCorrelato != &quot;&quot;)&#xD;
				{&#xD;
					c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta &lt;> 'NP' AND IDAsset &lt;>: ida&quot;);&#xD;
					c.setQueryParameter(&quot;idr&quot;, asset1.IDRisorsaCorrelato);&#xD;
					c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(asset1.IDAsset));&#xD;
					var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
					&#xD;
					if(result != null &amp;&amp; result.size() > 0)&#xD;
					{&#xD;
						// RU_915 - Controllo se c'è un AssetCPS tra quelli recuperati&#xD;
						for(var i=0; i&lt;result.size(); i++)&#xD;
						{&#xD;
							assetAppoggio = ScriptUtil.copy(result.get(i).readAsset());&#xD;
							&#xD;
							if(assetAppoggio.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
							{&#xD;
								if(recipientCheckCPS) //SM_9604&#xD;
								{&#xD;
									assetCPS = ScriptUtil.copy(assetAppoggio);&#xD;
									Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato per IDRisorsa Asset CPS trovato: &quot;+String(assetCPS.IDAsset)+&quot;, considerato: &quot;+recipientCheckCPS);&#xD;
								}&#xD;
								&#xD;
								result.remove(i);&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						//Logica standard preesistente&#xD;
						if(result != null &amp;&amp; result.size()>0)&#xD;
						{&#xD;
							AssetRef2 = result.get(0);&#xD;
							asset2 = ScriptUtil.copy(AssetRef2.readAsset());&#xD;
							Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Recuperato (Asset2) per IDRisorsa Asset: &quot;+asset2.IDAsset);&#xD;
						}&#xD;
					}&#xD;
		&#xD;
					if(asset2 == null)&#xD;
					{&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: nessun asset recuperato per IDRisorsaCorrelato: &quot; + asset1.IDRisorsaCorrelato;&#xD;
						CodiceEsito = &quot;KO_02&quot;;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			&#xD;
			if(asset2 != null)&#xD;
			{&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Asset2 recuperato: &quot; + asset2.IDAsset);&#xD;
				var DestinazioneUso1 = &quot;&quot;;&#xD;
				DestinazioneUso1 = null;&#xD;
				var destinazioneUso2 = &quot;&quot;;&#xD;
				destinazioneUso2 = null;&#xD;
			&#xD;
				var i = 0;&#xD;
				while(DestinazioneUso1 == null &amp;&amp; i &lt; asset1.dettaglioasset.size())&#xD;
				{&#xD;
					var DettAsset1 = asset1.dettaglioasset.get(i);&#xD;
					if(String(DettAsset1.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						var j = 0;&#xD;
						while(DestinazioneUso1 == null &amp;&amp; j &lt; DettAsset1.attributidettaglioasset.size())&#xD;
						{&#xD;
							var AttrDettAsset1 = DettAsset1.attributidettaglioasset.get(j);&#xD;
							if(AttrDettAsset1.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
							{&#xD;
								DestinazioneUso1 = AttrDettAsset1.valoreAttributo;&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					i++;&#xD;
				}&#xD;
			&#xD;
				var i = 0;&#xD;
				while(destinazioneUso2 == null &amp;&amp; i &lt; asset2.dettaglioasset.size())&#xD;
				{&#xD;
					var DettAsset2 = asset2.dettaglioasset.get(i);&#xD;
					if(String(DettAsset2.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						var j = 0;&#xD;
						while(destinazioneUso2 == null &amp;&amp; j &lt; DettAsset2.attributidettaglioasset.size())&#xD;
						{&#xD;
							var AttrDettAsset2 = DettAsset2.attributidettaglioasset.get(j);&#xD;
							if(AttrDettAsset2.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
							{&#xD;
								destinazioneUso2 = AttrDettAsset2.valoreAttributo;&#xD;
							}&#xD;
							else if(AttrDettAsset2.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA &amp;&amp; TIPO_LINEA == null)&#xD;
							{&#xD;
								TIPO_LINEA = AttrDettAsset2.valoreAttributo;&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					i++;&#xD;
				}			&#xD;
				&#xD;
				//SM_7887&#xD;
				if(!destinazioneUsoFonia.contains(destinazioneUso2) &amp;&amp; // consistenza dati&#xD;
					asset2.codificaOLOAGCOM != localRequest.codificaOLOAGCOM &amp;&amp; &#xD;
					localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL &amp;&amp;&#xD;
					(TIPO_LINEA == &quot;POTS&quot; || TIPO_LINEA == &quot;ISDN&quot;)) // SM_8227: la consistenza dati deve essere di tipo condiviso&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: è stato recuperato un asset dati con OLO RECIPIENT != OLO in consistenza&quot;;&#xD;
					CodiceEsito = &quot;KO_20&quot;;&#xD;
				}&#xD;
				else&#xD;
				{	&#xD;
					if ((asset1.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA &amp;&amp; asset2.tipologiaAccesso==it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA)&#xD;
						|| (asset1.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.DATI &amp;&amp; asset2.tipologiaAccesso==it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.DATI))&#xD;
					{&#xD;
					&#xD;
						if(asset1.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
						&amp;&amp; asset2.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
						&amp;&amp; ((String(asset1.offerta).slice(0, 3) == &quot;ULL&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;ULL&quot;)&#xD;
							|| (String(asset1.offerta).slice(0, 3) == &quot;SLU&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;SLU&quot;))&#xD;
						&amp;&amp; ((destinazioneUsoFonia.contains(DestinazioneUso1) &amp;&amp; destinazioneUsoDati.contains(destinazioneUso2))&#xD;
							|| (destinazioneUsoDati.contains(DestinazioneUso1) &amp;&amp; destinazioneUsoFonia.contains(destinazioneUso2))))&#xD;
						{&#xD;
							stessaRisorsa = true;&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							EsitoResponse.codice = false;&#xD;
							EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset recuperati: &quot; + asset1.IDAsset + &quot; e &quot; + asset2.IDAsset + &quot; non adeguati.&quot;;&#xD;
							CodiceEsito = &quot;KO_01&quot;;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: consistenza FONIA non trovata per numeroTelefonico: &quot; + localRequest.numeroTelefonico;&#xD;
		CodiceEsito = &quot;KO_02&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
//--------------------------------------------------ARRICCHIMENTO-------------------------------------------------//&#xD;
if(EsitoResponse.codice)&#xD;
{&#xD;
	//SM_11544: asset DATI con offerta VULAFTTCAB - nuova casistica&#xD;
	if(asset1.tipologiaAccesso == &quot;DATI&quot;)&#xD;
	{&#xD;
		assetDati = ScriptUtil.copy(asset1);&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | assetDati: &quot; + asset1.IDAsset);&#xD;
	}&#xD;
	else if(stessaRisorsa == true)&#xD;
	{&#xD;
		if(destinazioneUsoFonia.contains(DestinazioneUso1))&#xD;
		{&#xD;
			assetFonia = ScriptUtil.copy(asset1);&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | assetFonia: &quot; + asset1.IDAsset);&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			assetDati = ScriptUtil.copy(asset1);&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | assetDati: &quot; + asset1.IDAsset);&#xD;
		}&#xD;
		&#xD;
		if(asset2 != null)&#xD;
		{&#xD;
			if(destinazioneUsoFonia.contains(destinazioneUso2))&#xD;
			{&#xD;
				assetFonia = ScriptUtil.copy(asset2);&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | assetFoniaCorrelato: &quot; + asset2.IDAsset);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				assetDati = ScriptUtil.copy(asset2);&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | assetDatiCorrelato : &quot; + asset2.IDAsset);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		var i = 0;&#xD;
		var found = false;&#xD;
		var destUso = &quot;&quot;;&#xD;
		while(!found &amp;&amp; i &lt; asset1.dettaglioasset.size())&#xD;
		{&#xD;
			var currentDettAsset = asset1.dettaglioasset.get(i);&#xD;
			if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(!found &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
				{&#xD;
					var currentAttrDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
					if(currentAttrDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
					{&#xD;
						destUso = currentAttrDettAsset.valoreAttributo;&#xD;
						found = true;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	&#xD;
		if(destUso != &quot;D&quot;)&#xD;
		{&#xD;
			assetFonia = ScriptUtil.copy(asset1);&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | assetFonia: &quot; + asset1.IDAsset);&#xD;
			&#xD;
			if(asset2 != null)&#xD;
			{&#xD;
				assetDati = ScriptUtil.copy(asset2);&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | assetDatiCorrelato : &quot; + asset2.IDAsset);&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			assetDati = ScriptUtil.copy(asset1);&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | assetDati: &quot; + asset1.IDAsset);&#xD;
			&#xD;
			if(asset2 != null)&#xD;
			{&#xD;
				assetFonia = ScriptUtil.copy(asset2);&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | assetFoniaCorrelato: &quot; + asset2.IDAsset);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//--------------------------------------------------CREA CONSISTENZA FONIA-------------------------------------------------//&#xD;
	if(assetFonia != null)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Creazione componente ConsistenzaFonia: &quot;+assetFonia.IDAsset);&#xD;
		&#xD;
		ConsistenzaFonia = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFoniaType();&#xD;
		//AZIONE&#xD;
		ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
		//OFFERTA&#xD;
		ConsistenzaFonia.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetFonia.offerta));		&#xD;
		//CODIFICAOLOAGCOMDONATING&#xD;
		ConsistenzaFonia.codificaOLOAGCOMDonating = assetFonia.codificaOLOAGCOM;&#xD;
		//STATO	&#xD;
		ConsistenzaFonia.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(assetFonia.statoAsset));		&#xD;
		//IDRISORSA&#xD;
		ConsistenzaFonia.IDRisorsa = assetFonia.IDRisorsa;		&#xD;
		//IDRISORSANOW&#xD;
		ConsistenzaFonia.IDRisorsaNOW = assetFonia.IDRisorsaNOW;&#xD;
		//CODICEORDINETI&#xD;
		ConsistenzaFonia.codiceOrdineTI = assetFonia.codiceOrdineTI;		&#xD;
		//CODICEORDINEOLO&#xD;
		ConsistenzaFonia.codiceOrdineOLO = assetFonia.codiceOrdineOLO;		&#xD;
		//IDENTIFICATIVOASSET&#xD;
		ConsistenzaFonia.IDAsset = assetFonia.IDAsset;		&#xD;
		//NUMERO TELEFONICO&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL)&#xD;
		{&#xD;
			ConsistenzaFonia.numeroTelefonico = localRequest.numeroTelefonico;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			ConsistenzaFonia.numeroTelefonico = assetFonia.numeroTelefonico;&#xD;
		}&#xD;
		//NUMERO TELEFONICO PRINCIPALE&#xD;
		ConsistenzaFonia.numeroTelefonicoPrincipale = assetFonia.numTelPrincipale;		&#xD;
		//NUMERO FITTIZIO&#xD;
		ConsistenzaFonia.numeroFittizio = assetFonia.numeroFittizio;		&#xD;
		//ID RISORSA CORRELATO&#xD;
		if(assetDati != null)&#xD;
		{&#xD;
			ConsistenzaFonia.IDRisorsaCorrelato = assetDati.IDRisorsa;&#xD;
		}&#xD;
		&#xD;
		//OPERATORERETE - RU_1142 (Task #33985)&#xD;
		ConsistenzaFonia.operatoreRete = assetFonia.operatoreRete;&#xD;
		&#xD;
		ConsistenzaFonia.assetBTWhiteList = assetFonia.assetBTWhiteList; //R1E-21-0325&#xD;
		&#xD;
		//R1E-21-0325&#xD;
		if(ConsistenzaFonia.assetBTWhiteList != null &amp;&amp; ConsistenzaFonia.assetBTWhiteList != &quot;&quot;)&#xD;
		{&#xD;
			localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
		}&#xD;
		&#xD;
		//COWCODE&#xD;
		//CODICESESSIONE&#xD;
		//DIREZIONALITA&#xD;
		//DESTINAZIONE USO&#xD;
		//STRUTTURALINEA&#xD;
		//TIPOLINEA&#xD;
		var DIREZIONALITA = false;&#xD;
		var DESTINAZIONEUSO = false;&#xD;
		var TIPOLINEA = false;&#xD;
		var STRUTTURALINEA = false;&#xD;
		var COWCODE = false;&#xD;
		var CODICESESSIONE = false;&#xD;
		var foundFATTURAZIONELA = false;&#xD;
		var BANDASERVIZIO = false;&#xD;
		var TIPOLOGIACLUSTERCOMUNE = false; // RU_964&#xD;
&#xD;
		var i = 0;&#xD;
		var accessoTrovato = false;&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; assetFonia.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetFonia.dettaglioasset.get(i);&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				while((!CODICESESSIONE|| !COWCODE || !DIREZIONALITA || !DESTINAZIONEUSO || !TIPOLINEA || !STRUTTURALINEA || !foundFATTURAZIONELA || !BANDASERVIZIO || !TIPOLOGIACLUSTERCOMUNE) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA)&#xD;
					{&#xD;
						DIREZIONALITA = true;&#xD;
						ConsistenzaFonia.direzionalita = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
					{&#xD;
						DESTINAZIONEUSO = true;&#xD;
						ConsistenzaFonia.destinazioneUso = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						TIPOLINEA = true;&#xD;
						ConsistenzaFonia.tipoLinea = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
					{&#xD;
						STRUTTURALINEA = true;&#xD;
						ConsistenzaFonia.strutturaLinea = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COWCODE)&#xD;
					{&#xD;
						COWCODE = true;&#xD;
						ConsistenzaFonia.cowCode = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESESSIONE)&#xD;
					{&#xD;
						CODICESESSIONE = true;&#xD;
						ConsistenzaFonia.codiceSessione = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURAZIONELA)&#xD;
					{&#xD;
						foundFATTURAZIONELA = true;&#xD;
						ConsistenzaFonia.fatturazioneLA = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDASERVIZIO) // RU_778 - aggiunta valorizzazione BANDASERVIZIO in Consistenza Fonia&#xD;
					{&#xD;
						BANDASERVIZIO = true;&#xD;
						ConsistenzaFonia.bandaServizio = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE)&#xD;
					{&#xD;
						TIPOLOGIACLUSTERCOMUNE = true;&#xD;
						ConsistenzaFonia.tipologiaClusterComune = attributo.valoreAttributo;		&#xD;
					}&#xD;
					&#xD;
					j++;&#xD;
				}&#xD;
			}	&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		if(!foundFATTURAZIONELA)&#xD;
		{&#xD;
			var offertaConsistenzaFoniaSliced = String(ConsistenzaFonia.offerta).slice(0, 3);&#xD;
				&#xD;
			if(offertaConsistenzaFoniaSliced == &quot;ULL&quot; || offertaConsistenzaFoniaSliced == &quot;SLU&quot;)&#xD;
			{&#xD;
				ConsistenzaFonia.fatturazioneLA = &quot;N&quot;;&#xD;
			}&#xD;
		}&#xD;
	&#xD;
		//--------------------------------------------------SM_3238--------------------------------------------------//&#xD;
		if((localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA) // SM_8354 - Per tutte le offerte LA valorizzare da inventory e non da asset&#xD;
			&amp;&amp; (EsitoFase2 == '0' || (TIPO_LINEA != null &amp;&amp; STRUTTURA_LINEA != null &amp;&amp; EsitoFase2 == null))) //SM_8332 - se Fase 2 KO, i parametri non sono valorizzati, arricchire da asset. Se fase 2 non è stata fatta, arricchire se sono valorizzati i tipo e struttura linea&#xD;
		{&#xD;
			ConsistenzaFonia.tipoLinea = TIPO_LINEA;&#xD;
			ConsistenzaFonia.strutturaLinea = STRUTTURA_LINEA;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
&#xD;
	//SM_9676: per ogni DNAggiuntivo va controllato se esiste un AssetCPS&#xD;
	var i = 0;&#xD;
&#xD;
	while(i&lt;localRequest.DNAggiuntivo.size())&#xD;
	{&#xD;
		if(assetCPS != null) //Se abbiamo trovato già un AssetCPS bisogna, ovviamente, escluderlo dalla ricerca&#xD;
		{&#xD;
			var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO') AND offerta IN ('CPS') AND IDAsset &lt;>: ida&quot;);&#xD;
			c.setQueryParameter(&quot;idr&quot;, localRequest.DNAggiuntivo.get(i));&#xD;
			c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(assetCPS.IDAsset));&#xD;
			var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO') AND offerta IN ('CPS')&quot;);&#xD;
			c.setQueryParameter(&quot;idr&quot;, localRequest.DNAggiuntivo.get(i));&#xD;
			var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		}&#xD;
		&#xD;
		if(result != null &amp;&amp; result.size()>0)&#xD;
		{&#xD;
			AssetRef = result.get(0);&#xD;
			assetCPSMulti.add(AssetRef.readAsset());&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa AssetCPS tramite DNAggiuntivo (&quot;+localRequest.DNAggiuntivo.get(i)+&quot;): &quot;+String(AssetRef.readAsset().IDAsset));&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Nessun Asset CPS trovato con DNAggiuntivo: &quot;+localRequest.DNAggiuntivo.get(i));&#xD;
		}&#xD;
&#xD;
		i++;&#xD;
	}&#xD;
&#xD;
	i=0;&#xD;
	&#xD;
	if(assetCPS != null) //SM_9709&#xD;
	{&#xD;
		assetCPSMulti.add(assetCPS); //SM_9676&#xD;
	}&#xD;
	&#xD;
	//--------------------------------------------------CREA CONSISTENZA CPS-------------------------------------------------//&#xD;
	while(i&lt;assetCPSMulti.size()) //SM_9676&#xD;
	{&#xD;
		assetCPS = ScriptUtil.copy(assetCPSMulti.get(i)); //SM_9676&#xD;
		&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Creazione componente Consistenza CPS: &quot;+assetCPS.IDAsset);&#xD;
		&#xD;
		ConsistenzaCPStemp = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaCPSType();&#xD;
		&#xD;
		ConsistenzaCPStemp.azione = &quot;D&quot;;&#xD;
		&#xD;
		ConsistenzaCPStemp.IDRisorsa = assetCPS.IDRisorsa;&#xD;
&#xD;
		ConsistenzaCPStemp.IDRisorsaNOW = assetCPS.IDRisorsaNOW;&#xD;
&#xD;
		ConsistenzaCPStemp.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetCPS.offerta));&#xD;
		&#xD;
		ConsistenzaCPStemp.codificaOLOAGCOMDonating = assetCPS.codificaOLOAGCOM;&#xD;
		&#xD;
		ConsistenzaCPStemp.codiceOrdineTI = assetCPS.codiceOrdineTI;&#xD;
&#xD;
		ConsistenzaCPStemp.codiceOrdineOLO = assetCPS.codiceOrdineOLO;&#xD;
&#xD;
		ConsistenzaCPStemp.IDAsset = assetCPS.IDAsset;&#xD;
		&#xD;
		ConsistenzaCPStemp.numeroTelefonico = assetCPS.numeroTelefonico;&#xD;
&#xD;
		ConsistenzaCPStemp.numeroTelefonicoPrincipale = assetCPS.numTelPrincipale;&#xD;
&#xD;
		ConsistenzaCPStemp.numeroFittizio = assetCPS.numeroFittizio;&#xD;
		&#xD;
		ConsistenzaCPStemp.assetBTWhiteList = assetCPS.assetBTWhiteList; //R1E-21-0325&#xD;
		&#xD;
		//R1E-21-0325&#xD;
		if(ConsistenzaCPStemp.assetBTWhiteList != null &amp;&amp; ConsistenzaCPStemp.assetBTWhiteList != &quot;&quot;)&#xD;
		{&#xD;
			localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
		}&#xD;
		&#xD;
		var OPZIONETRAFFICO = false;&#xD;
		var TIPODNREALE = false;&#xD;
		var TIPOLINEAREALE = false;&#xD;
		var DSC = false; //SM_9174&#xD;
		var i = 0;&#xD;
		&#xD;
		var accessoTrovato = false;&#xD;
		&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; assetCPS.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetCPS.dettaglioasset.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				while((!OPZIONETRAFFICO || !TIPODNREALE || !TIPOLINEAREALE || !DSC) &#xD;
					&amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO)&#xD;
					{&#xD;
						OPZIONETRAFFICO = true;&#xD;
						ConsistenzaCPStemp.opzioneTraffico = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNREALE)&#xD;
					{&#xD;
						TIPODNREALE = true;&#xD;
						ConsistenzaCPStemp.tipoDnReale = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAREALE)&#xD;
					{&#xD;
						TIPOLINEAREALE = true;&#xD;
						ConsistenzaCPStemp.tipoLineaReale = attributo.valoreAttributo;&#xD;
					}&#xD;
					//SM_9174&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC)&#xD;
					{&#xD;
						DSC = true;&#xD;
						ConsistenzaCPStemp.dsc = attributo.valoreAttributo;&#xD;
					}&#xD;
&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		ConsistenzaCPStemp.invioADtu = 'N';&#xD;
		&#xD;
		ConsistenzaCPS.add(ConsistenzaCPStemp); //SM_9676: ConsistenzaCPS è diventato un array, ora le CPS possono essere multiple (vedi dopo)&#xD;
		i++;&#xD;
	}&#xD;
&#xD;
	//--------------------------------------------------CREA CONSISTENZA DATI-------------------------------------------------//&#xD;
	if(assetDati != null)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | Creazione componente ConsistenzaDati: &quot;+assetDati.IDAsset);&#xD;
		&#xD;
		ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();&#xD;
		//AZIONE&#xD;
		//SM_11544: asset DATI con offerta VULAFTTCAB - nuova casistica&#xD;
		//SM_11563: aggiunto TLC&#xD;
		if(assetDati.tipologiaAccesso == &quot;DATI&quot; &amp;&amp; assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
		   &amp;&amp; assetDati.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
		{&#xD;
			ConsistenzaDati.azione = &quot;D&quot;;&#xD;
		}&#xD;
		else if(stessaRisorsa)&#xD;
		{&#xD;
			ConsistenzaDati.azione = &quot;N&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			ConsistenzaDati.azione = &quot;M&quot;;&#xD;
		}		&#xD;
		//OFFERTA&#xD;
		ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetDati.offerta));		&#xD;
		//CODIFICAOLOAGCOMDONATING&#xD;
		ConsistenzaDati.codificaOLOAGCOMDonating = assetDati.codificaOLOAGCOM;&#xD;
		//STATO	&#xD;
		ConsistenzaDati.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(assetDati.statoAsset));		&#xD;
		//IDRISORSA&#xD;
		ConsistenzaDati.IDRisorsa = assetDati.IDRisorsa;		&#xD;
		//IDRISORSANOW&#xD;
		ConsistenzaDati.IDRisorsaNOW = assetDati.IDRisorsaNOW;			&#xD;
		//CODICEORDINETI&#xD;
		ConsistenzaDati.codiceOrdineTI = assetDati.codiceOrdineTI;		&#xD;
		//CODICEORDINEOLO&#xD;
		ConsistenzaDati.codiceOrdineOLO = assetDati.codiceOrdineOLO;		&#xD;
		//IDENTIFICATIVOASSET&#xD;
		ConsistenzaDati.IDAsset = assetDati.IDAsset;		&#xD;
		//NUMERO TELEFONICO&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL)&#xD;
		{&#xD;
			ConsistenzaDati.numeroTelefonico = localRequest.numeroTelefonico;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			ConsistenzaDati.numeroTelefonico = assetDati.numeroTelefonico;&#xD;
		}		&#xD;
		//NUMERO TELEFONICO PRINCIPALE&#xD;
		ConsistenzaDati.numeroTelefonicoPrincipale = assetDati.numTelPrincipale;		&#xD;
		//NUMERO FITTIZIO&#xD;
		ConsistenzaDati.numeroFittizio = assetDati.numeroFittizio;		&#xD;
		//ID RISORSA CORRELATO&#xD;
		if(assetFonia != null)&#xD;
		{&#xD;
			ConsistenzaDati.IDRisorsaCorrelato = assetFonia.IDRisorsa;&#xD;
		}	&#xD;
		&#xD;
		//OPERATORERETE - RU_1142 (Task #33985)&#xD;
		ConsistenzaDati.operatoreRete = assetDati.operatoreRete;&#xD;
		&#xD;
		ConsistenzaDati.assetBTWhiteList = assetDati.assetBTWhiteList; //R1E-21-0325&#xD;
		&#xD;
		//R1E-21-0325&#xD;
		if(ConsistenzaDati.assetBTWhiteList != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != &quot;&quot;)&#xD;
		{&#xD;
			localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
		}&#xD;
		&#xD;
		//RU_1275&#xD;
		if(assetDati.exOperatoreRete != null &amp;&amp; assetDati.exOperatoreRete != &quot;&quot;)&#xD;
		{&#xD;
			localRequest.exOperatoreRete = assetDati.exOperatoreRete;&#xD;
			localRequest.ordine.exOperatoreRete = assetDati.exOperatoreRete;&#xD;
		}&#xD;
		&#xD;
		//COWCODE&#xD;
		//CODICESESSIONE&#xD;
		//DIREZIONALITA&#xD;
		//DESTINAZIONE USO&#xD;
		//STRUTTURALINEA&#xD;
		//TIPOLINEA&#xD;
		var DIREZIONALITA = false;&#xD;
		var DESTINAZIONEUSO = false;&#xD;
		var TIPOLINEA = false;&#xD;
		var STRUTTURALINEA = false;&#xD;
		var COWCODE = false;&#xD;
		var CODICESESSIONE = false;&#xD;
		var FLAGBTSNAKED = false;&#xD;
		var TIPOLOGIACLUSTERCOMUNE = false; // RU_964&#xD;
		&#xD;
		var i = 0;&#xD;
		var accessoTrovato = false;&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; assetDati.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetDati.dettaglioasset.get(i);&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				while((!CODICESESSIONE|| !COWCODE || !DIREZIONALITA || !DESTINAZIONEUSO || !TIPOLINEA || !STRUTTURALINEA || !FLAGBTSNAKED || !TIPOLOGIACLUSTERCOMUNE) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA)&#xD;
					{&#xD;
						DIREZIONALITA = true;&#xD;
						ConsistenzaDati.direzionalita = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
					{&#xD;
						DESTINAZIONEUSO = true;&#xD;
						ConsistenzaDati.destinazioneUso = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						TIPOLINEA = true;&#xD;
						ConsistenzaDati.tipoLinea = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
					{&#xD;
						STRUTTURALINEA = true;&#xD;
						ConsistenzaDati.strutturaLinea = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COWCODE)&#xD;
					{&#xD;
						COWCODE = true;&#xD;
						ConsistenzaDati.cowCode = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESESSIONE)&#xD;
					{&#xD;
						CODICESESSIONE = true;&#xD;
						ConsistenzaDati.codiceSessione = attributo.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA &amp;&amp; attributo.valoreAttributo == &quot;LineaNonFonia&quot;)&#xD;
					{&#xD;
						FLAGBTSNAKED = true;&#xD;
						ConsistenzaDati.flagBTSNaked = &quot;Y&quot;;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE)&#xD;
					{&#xD;
						TIPOLOGIACLUSTERCOMUNE = true;&#xD;
						ConsistenzaDati.tipologiaClusterComune = attributo.valoreAttributo;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						FLAGBTSNAKED = true;&#xD;
						ConsistenzaDati.flagBTSNaked = &quot;N&quot;;&#xD;
					}&#xD;
					&#xD;
					j++;&#xD;
				}&#xD;
			}	&#xD;
			i++;&#xD;
		}&#xD;
	&#xD;
		//--------------------------------------------------SM_3238--------------------------------------------------//&#xD;
		if((localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA) // SM_8354 - Per tutte le offerte LA valorizzare da inventory e non da asset&#xD;
			&amp;&amp; (EsitoFase2 == '0' || (TIPO_LINEA != null &amp;&amp; STRUTTURA_LINEA != null &amp;&amp; EsitoFase2 == null))) // SM_8332 - se Fase 2 KO, i parametri non sono valorizzati, arricchire da asset. Se fase 2 non è stata fatta, arricchire se sono valorizzati i tipo e struttura linea&#xD;
		{&#xD;
			ConsistenzaDati.tipoLinea = TIPO_LINEA;&#xD;
			ConsistenzaDati.strutturaLinea = STRUTTURA_LINEA;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	/*//--------------------------------------------------ARRICCHIMENTO LAVORAZIONE RICHIESTA--------------------------------------------------//&#xD;
      &#xD;
 	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR)&#xD;
 	{&#xD;
  		Log.write(&quot;Inizio Valorizzazione LavorazioneRichiesta.&quot;);&#xD;
  		LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
  		LavorazioneRichiesta.tipoLinea = &quot;POTS&quot;;&#xD;
  		LavorazioneRichiesta.strutturaLinea = &quot;Simplex&quot;;&#xD;
  		LavorazioneRichiesta.numeroTelefonico = localRequest.numeroTelefonico;&#xD;
 	}*/&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR/ULL/SLU/VULL + LA | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="111.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="176.0">
              <xpdl2:Coordinates XCoordinate="889.0" YCoordinate="975.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_wHZbcO4IEeazSbn9P97FTQ" Name="CessazioneULLSLUWLRVULL" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Cessazione ULL/SLU/ WLR/VULL">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
CodiceEsito = null;&#xD;
&#xD;
var assetDati = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetDati = null;&#xD;
var assetFonia = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetFonia = null;&#xD;
var asset1 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset1 = null;&#xD;
var asset2 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset2 = null;&#xD;
&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione ULL/SLU/ WLR/VULL | Verifica servizio in consistenza Cessazione ULL/SLU/VULL e WLR LineaAttiva/LineaNonAttiva.&quot;);&#xD;
&#xD;
if(VerificaIDRisorsaResponse.datiAccesso.idAsset != null &amp;&amp; VerificaIDRisorsaResponse.datiAccesso.idAsset != &quot;&quot;)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset =: ida AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta &lt;> 'CPS'&quot;);&#xD;
	c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(VerificaIDRisorsaResponse.datiAccesso.idAsset));&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione ULL/SLU/ WLR/VULL | Trovato Asset per IDAsset=&quot;+VerificaIDRisorsaResponse.datiAccesso.idAsset);&#xD;
	}&#xD;
}&#xD;
&#xD;
if(asset1 != null)&#xD;
{&#xD;
	if(asset1.IDRisorsaCorrelato != null &amp;&amp; asset1.IDRisorsaCorrelato != &quot;&quot;)&#xD;
	{&#xD;
		c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND IDAsset &lt;> :ida AND offerta &lt;> 'CPS'&quot;);&#xD;
		c.setQueryParameter(&quot;idr&quot;, asset1.IDRisorsaCorrelato);&#xD;
		c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(asset1.IDAsset));&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		if(result != null &amp;&amp; result.size() > 0)&#xD;
		{&#xD;
			AssetRef2 = result.get(0);&#xD;
			asset2 = ScriptUtil.copy(AssetRef2.readAsset());&#xD;
		}&#xD;
		&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione ULL/SLU/ WLR/VULL | Trovato Asset correlato per IDRisorsa=&quot;+asset1.IDRisorsaCorrelato);&#xD;
	}&#xD;
	&#xD;
	if(asset2 != null &amp;&amp; asset1.tipologiaAccesso == asset2.tipologiaAccesso)&#xD;
	{&#xD;
		var DestinazioneUso1 = &quot;&quot;;&#xD;
		DestinazioneUso1 = null;&#xD;
		var destinazioneUso2 = &quot;&quot;;&#xD;
		destinazioneUso2 = null;&#xD;
		&#xD;
		var i = 0;&#xD;
		while(DestinazioneUso1 == null &amp;&amp; i &lt; asset1.dettaglioasset.size())&#xD;
		{&#xD;
			var DettAsset1 = asset1.dettaglioasset.get(i);&#xD;
			if(String(DettAsset1.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(DestinazioneUso1 == null &amp;&amp; j &lt; DettAsset1.attributidettaglioasset.size())&#xD;
				{&#xD;
					var AttrDettAsset1 = DettAsset1.attributidettaglioasset.get(j);&#xD;
					if(AttrDettAsset1.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
					{&#xD;
						DestinazioneUso1 = AttrDettAsset1.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		var i = 0;&#xD;
		while(destinazioneUso2 == null &amp;&amp; i &lt; asset2.dettaglioasset.size())&#xD;
		{&#xD;
			var DettAsset2 = asset2.dettaglioasset.get(i);&#xD;
			if(String(DettAsset2.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(destinazioneUso2 == null &amp;&amp; j &lt; DettAsset2.attributidettaglioasset.size())&#xD;
				{&#xD;
					var AttrDettAsset2 = DettAsset2.attributidettaglioasset.get(j);&#xD;
					if(AttrDettAsset2.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
					{&#xD;
						destinazioneUso2 = AttrDettAsset2.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		if(asset1.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA&#xD;
		&amp;&amp; asset1.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
		&amp;&amp; asset2.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
		&amp;&amp; ((String(asset1.offerta).slice(0, 3) == &quot;ULL&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;ULL&quot;) || &#xD;
			(String(asset1.offerta).slice(0, 3) == &quot;SLU&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;SLU&quot;) )) //RU_632&#xD;
		{&#xD;
			if(destinazioneUsoFonia.contains(DestinazioneUso1))&#xD;
			{&#xD;
				assetFonia = ScriptUtil.copy(asset1);&#xD;
				assetDati = ScriptUtil.copy(asset2);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				assetFonia = ScriptUtil.copy(asset2);&#xD;
				assetDati = ScriptUtil.copy(asset1);&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: caso particolare di ULL + ULL TI non superato.&quot;;&#xD;
			CodiceEsito = &quot;KO_01&quot;;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		if(asset1.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA)&#xD;
		{&#xD;
			assetFonia = ScriptUtil.copy(asset1);&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			assetDati = ScriptUtil.copy(asset1);&#xD;
		}&#xD;
		&#xD;
		if(asset2 != null)&#xD;
		{&#xD;
			if(assetFonia != null)&#xD;
			{&#xD;
				assetDati = ScriptUtil.copy(asset2);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				assetFonia = ScriptUtil.copy(asset2);&#xD;
			}		&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: consistenza non trovata per IDAsset: &quot; + VerificaIDRisorsaResponse.datiAccesso.idAsset;&#xD;
	CodiceEsito = &quot;KO_09&quot;;&#xD;
}&#xD;
&#xD;
//--------------------------------------------------CREA CONSISTENZA FONIA-------------------------------------------------//&#xD;
if(assetFonia != null)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione ULL/SLU/ WLR/VULL | Creazione componente ConsistenzaFonia: &quot;+assetFonia.IDAsset);&#xD;
	&#xD;
	ConsistenzaFonia = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFoniaType();&#xD;
	//AZIONE&#xD;
	if(assetDati != null&#xD;
		&amp;&amp; assetFonia.codificaOLOAGCOM == &quot;TLC&quot; &amp;&amp; assetDati.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
		&amp;&amp; ((assetFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA &amp;&amp; assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA)||&#xD;
			(assetFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA &amp;&amp; assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA))) //RU_632&#xD;
	{&#xD;
		if(asset1.IDAsset == assetFonia.IDAsset)&#xD;
		{&#xD;
			ConsistenzaFonia.azione = &quot;M&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			ConsistenzaFonia.azione = &quot;N&quot;;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		ConsistenzaFonia.azione = &quot;M&quot;;&#xD;
	}&#xD;
	//IDRISORSA&#xD;
	ConsistenzaFonia.IDRisorsa = assetFonia.IDRisorsa;&#xD;
	//IDRISORSANOW&#xD;
	ConsistenzaFonia.IDRisorsaNOW = assetFonia.IDRisorsaNOW;&#xD;
	//OFFERTA&#xD;
	ConsistenzaFonia.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetFonia.offerta));&#xD;
	//CODIFICAOLOAGCOMDONATING&#xD;
	ConsistenzaFonia.codificaOLOAGCOMDonating = assetFonia.codificaOLOAGCOM;&#xD;
	//CODICEORDINETI&#xD;
	ConsistenzaFonia.codiceOrdineTI = assetFonia.codiceOrdineTI;&#xD;
	//CODICEORDINEOLO&#xD;
	ConsistenzaFonia.codiceOrdineOLO = assetFonia.codiceOrdineOLO;&#xD;
	//IDENTIFICATIVOASSET&#xD;
	ConsistenzaFonia.IDAsset = assetFonia.IDAsset;&#xD;
	//NUMERO TELEFONICO&#xD;
	ConsistenzaFonia.numeroTelefonico = assetFonia.numeroTelefonico;&#xD;
	//NUMERO TELEFONICO PRINCIPALE&#xD;
	ConsistenzaFonia.numeroTelefonicoPrincipale = assetFonia.numTelPrincipale;&#xD;
	//NUMERO FITTIZIO&#xD;
	ConsistenzaFonia.numeroFittizio = assetFonia.numeroFittizio;&#xD;
	//OPERATORERETE - RU_1142&#xD;
	ConsistenzaFonia.operatoreRete = assetFonia.operatoreRete;&#xD;
&#xD;
	ConsistenzaFonia.assetBTWhiteList = assetFonia.assetBTWhiteList; //R1E-21-0325&#xD;
	&#xD;
	//R1E-21-0325&#xD;
	if(ConsistenzaFonia.assetBTWhiteList != null &amp;&amp; ConsistenzaFonia.assetBTWhiteList != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
	}&#xD;
&#xD;
	//ID RISORSA CORRELATO&#xD;
	if(assetDati != null)&#xD;
	{&#xD;
		ConsistenzaFonia.IDRisorsaCorrelato = assetDati.IDRisorsa;&#xD;
	}&#xD;
	//COWCODE&#xD;
	//CODICESESSIONE&#xD;
	//DIREZIONALITA&#xD;
	//DESTINAZIONE USO&#xD;
	//STRUTTURALINEA&#xD;
	//TIPOLINEA&#xD;
	var DIREZIONALITA = false;&#xD;
	var DESTINAZIONEUSO = false;&#xD;
	var TIPOLINEA = false;&#xD;
	var STRUTTURALINEA = false;&#xD;
	var COWCODE = false;&#xD;
	var CODICESESSIONE = false;&#xD;
	var foundFATTURAZIONELA = false;&#xD;
	var BANDASERVIZIO = false;&#xD;
&#xD;
	var i = 0;&#xD;
	var accessoTrovato = false;&#xD;
	while(!accessoTrovato &amp;&amp; i &lt; assetFonia.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetFonia.dettaglioasset.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			accessoTrovato = true;&#xD;
			var j = 0;&#xD;
			while((!CODICESESSIONE|| !COWCODE || !DIREZIONALITA || !DESTINAZIONEUSO || !TIPOLINEA || !STRUTTURALINEA || !BANDASERVIZIO) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA)&#xD;
				{&#xD;
					DIREZIONALITA = true;&#xD;
					ConsistenzaFonia.direzionalita = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
				{&#xD;
					DESTINAZIONEUSO = true;&#xD;
					ConsistenzaFonia.destinazioneUso = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					TIPOLINEA = true;&#xD;
					ConsistenzaFonia.tipoLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
				{&#xD;
					STRUTTURALINEA = true;&#xD;
					ConsistenzaFonia.strutturaLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COWCODE)&#xD;
				{&#xD;
					COWCODE = true;&#xD;
					ConsistenzaFonia.cowCode = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESESSIONE)&#xD;
				{&#xD;
					CODICESESSIONE = true;&#xD;
					ConsistenzaFonia.codiceSessione = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURAZIONELA)&#xD;
				{&#xD;
					foundFATTURAZIONELA = true;&#xD;
					ConsistenzaFonia.fatturazioneLA = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDASERVIZIO) // RU_778 - aggiunta valorizzazione BANDASERVIZIO in Consistenza Fonia&#xD;
				{&#xD;
					BANDASERVIZIO = true;&#xD;
					ConsistenzaFonia.bandaServizio = attributo.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(!foundFATTURAZIONELA)&#xD;
	{&#xD;
		var offertaConsistenzaFoniaSliced = String(ConsistenzaFonia.offerta).slice(0, 3);&#xD;
			&#xD;
		if(offertaConsistenzaFoniaSliced == &quot;ULL&quot; || offertaConsistenzaFoniaSliced == &quot;SLU&quot;)&#xD;
		{&#xD;
			ConsistenzaFonia.fatturazioneLA = &quot;N&quot;;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//--------------------------------------------------CREA CONSISTENZA DATI-------------------------------------------------//&#xD;
if(assetDati != null)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione ULL/SLU/ WLR/VULL | Creazione componente ConsistenzaDati: &quot;+assetDati.IDAsset);&#xD;
	&#xD;
	ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();&#xD;
	//AZIONE&#xD;
	if(assetFonia != null&#xD;
		&amp;&amp; assetFonia.codificaOLOAGCOM == &quot;TLC&quot; &amp;&amp; assetDati.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
		&amp;&amp; ((assetFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA &amp;&amp; assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA)||&#xD;
			(assetFonia.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA &amp;&amp; assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA))) //RU_632&#xD;
	{&#xD;
		if(asset1.IDAsset == assetDati.IDAsset)&#xD;
		{&#xD;
			ConsistenzaDati.azione = &quot;M&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			ConsistenzaDati.azione = &quot;N&quot;;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		ConsistenzaDati.azione = &quot;T&quot;;&#xD;
	}&#xD;
	//IDRISORSA&#xD;
	ConsistenzaDati.IDRisorsa = assetDati.IDRisorsa;&#xD;
	//IDRISORSANOW&#xD;
	ConsistenzaDati.IDRisorsaNOW = assetDati.IDRisorsaNOW;&#xD;
	//OFFERTA&#xD;
	ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetDati.offerta));&#xD;
	//CODIFICAOLOAGCOMDONATING&#xD;
	ConsistenzaDati.codificaOLOAGCOMDonating = assetDati.codificaOLOAGCOM;&#xD;
	//CODICEORDINETI&#xD;
	ConsistenzaDati.codiceOrdineTI = assetDati.codiceOrdineTI;&#xD;
	//CODICEORDINEOLO&#xD;
	ConsistenzaDati.codiceOrdineOLO = assetDati.codiceOrdineOLO;&#xD;
	//IDENTIFICATIVOASSET&#xD;
	ConsistenzaDati.IDAsset = assetDati.IDAsset;&#xD;
	//NUMERO TELEFONICO&#xD;
	ConsistenzaDati.numeroTelefonico = assetDati.numeroTelefonico;&#xD;
	//NUMERO TELEFONICO PRINCIPALE&#xD;
	ConsistenzaDati.numeroTelefonicoPrincipale = assetDati.numTelPrincipale;&#xD;
	//NUMERO FITTIZIO&#xD;
	ConsistenzaDati.numeroFittizio = assetDati.numeroFittizio;&#xD;
	//ID RISORSA CORRELATO&#xD;
	if(assetFonia != null)&#xD;
	{&#xD;
		ConsistenzaDati.IDRisorsaCorrelato = assetFonia.IDRisorsa;&#xD;
	}&#xD;
	//OPZIONEDINAMICA&#xD;
	ConsistenzaDati.opzioneDinamica=assetDati.opzioneDinamica;&#xD;
	//OPERATORERETE - RU_1142&#xD;
	ConsistenzaDati.operatoreRete = assetDati.operatoreRete;&#xD;
	&#xD;
	ConsistenzaDati.assetBTWhiteList = assetDati.assetBTWhiteList; //R1E-21-0325&#xD;
	&#xD;
	//R1E-21-0325&#xD;
	if(ConsistenzaDati.assetBTWhiteList != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
	}&#xD;
	&#xD;
	//RU_1275&#xD;
	if(assetDati.exOperatoreRete != null &amp;&amp; assetDati.exOperatoreRete != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.exOperatoreRete = assetDati.exOperatoreRete;&#xD;
		localRequest.ordine.exOperatoreRete = assetDati.exOperatoreRete;&#xD;
	}&#xD;
	&#xD;
	//COWCODE&#xD;
	//CODICESESSIONE&#xD;
	//DIREZIONALITA&#xD;
	//DESTINAZIONE USO&#xD;
	//STRUTTURALINEA&#xD;
	//TIPOLINEA&#xD;
	var DIREZIONALITA = false;&#xD;
	var DESTINAZIONEUSO = false;&#xD;
	var TIPOLINEA = false;&#xD;
	var STRUTTURALINEA = false;&#xD;
	var COWCODE = false;&#xD;
	var CODICESESSIONE = false;&#xD;
	var i = 0;&#xD;
	var accessoTrovato = false;&#xD;
	while(!accessoTrovato &amp;&amp; i &lt; assetDati.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetDati.dettaglioasset.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			accessoTrovato = true;&#xD;
			var j = 0;&#xD;
			while((!CODICESESSIONE|| !COWCODE || !DIREZIONALITA || !DESTINAZIONEUSO || !TIPOLINEA || !STRUTTURALINEA) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA)&#xD;
				{&#xD;
					DIREZIONALITA = true;&#xD;
					ConsistenzaDati.direzionalita = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
				{&#xD;
					DESTINAZIONEUSO = true;&#xD;
					ConsistenzaDati.destinazioneUso = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					TIPOLINEA = true;&#xD;
					ConsistenzaDati.tipoLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
				{&#xD;
					STRUTTURALINEA = true;&#xD;
					ConsistenzaDati.strutturaLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COWCODE)&#xD;
				{&#xD;
					COWCODE = true;&#xD;
					ConsistenzaDati.cowCode = attributo.valoreAttributo;		&#xD;
				}&#xD;
					&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESESSIONE)&#xD;
				{&#xD;
					CODICESESSIONE = true;&#xD;
					ConsistenzaDati.codiceSessione = attributo.valoreAttributo;		&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione ULL/SLU/ WLR/VULL | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="109.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="168.0">
              <xpdl2:Coordinates XCoordinate="890.0" YCoordinate="1924.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
