          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="86.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="79.0">
