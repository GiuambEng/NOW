				{&#xD;
					//IDRisorsa&#xD;
					var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta &lt;> 'NP'&quot;);&#xD;
					c.setQueryParameter(&quot;idr&quot;, localRequest.codiceRisorsaDonating2);&#xD;
					var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
					if(result != null &amp;&amp; result.size() > 0)&#xD;
					{&#xD;
						// RU_915 - Controllo se c'è un AssetCPS tra quelli recuperati&#xD;
						for(var i=0; i&lt;result.size(); i++)&#xD;
						{&#xD;
							assetAppoggio = ScriptUtil.copy(result.get(i).readAsset());&#xD;
							&#xD;
							if(assetAppoggio.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
							{&#xD;
								if(recipientWLRVULL) //SM_9604&#xD;
								{&#xD;
									assetCPSMig = ScriptUtil.copy(assetAppoggio);&#xD;
									Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset CPS trovato: &quot;+String(assetCPSMig.IDAsset)+&quot;, considerato: &quot;+recipientWLRVULL);&#xD;
&#xD;
								}&#xD;
					&#xD;
								result.remove(i);&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						//Logica standard preesistente&#xD;
						if(result != null &amp;&amp; result.size()>0)&#xD;
						{&#xD;
							AssetRef2 = result.get(0);&#xD;
							Asset2 = ScriptUtil.copy(AssetRef2.readAsset());&#xD;
							Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset: &quot;+String(Asset2.IDAsset));&#xD;
						}&#xD;
					}	&#xD;
&#xD;
					//NumeroFittizio&#xD;
					if(Asset2 == null &amp;&amp; codiceRisorsaMod != &quot;&quot;)&#xD;
					{&#xD;
						Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Ricerca Asset2 per NUMERO FITTIZIO = codiceRisorsaDonating2: &quot; + codiceRisorsaMod + &quot; OR &quot; + codiceRisorsaDonating2);&#xD;
						c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;(numeroFittizio =: NF OR numeroFittizio =: NF1) AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta &lt;> 'NP'&quot;);&#xD;
						c.setQueryParameter(&quot;NF&quot;, codiceRisorsaMod);&#xD;
						c.setQueryParameter(&quot;NF1&quot;, codiceRisorsaDonating2);&#xD;
						result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
						if(result != null &amp;&amp; result.size() > 0)&#xD;
						{&#xD;
							// RU_915 - Controllo se c'è un AssetCPS tra quelli recuperati&#xD;
							for(var i=0; i&lt;result.size(); i++)&#xD;
							{&#xD;
								assetAppoggio = ScriptUtil.copy(result.get(i).readAsset());&#xD;
								&#xD;
								if(assetAppoggio.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
								{&#xD;
									if(recipientWLRVULL) //SM_9604&#xD;
									{&#xD;
										assetCPSMig = ScriptUtil.copy(assetAppoggio);&#xD;
										Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset CPS trovato: &quot;+String(assetCPSMig.IDAsset)+&quot;, considerato: &quot;+recipientWLRVULL);&#xD;
									}&#xD;
					&#xD;
									result.remove(i);&#xD;
								}&#xD;
							}&#xD;
							&#xD;
							//Logica standard preesistente&#xD;
							if(result != null &amp;&amp; result.size()>0)&#xD;
							{&#xD;
								AssetRef2 = result.get(0);&#xD;
								Asset2 = ScriptUtil.copy(AssetRef2.readAsset());&#xD;
								Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset: &quot;+String(Asset2.IDAsset));&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
					//NumeroTelefonico&#xD;
					if(Asset2 == null)&#xD;
					{&#xD;
						c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico =: NT AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta &lt;> 'NP'&quot;);&#xD;
						c.setQueryParameter(&quot;NT&quot;, localRequest.codiceRisorsaDonating2);&#xD;
						result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
						if(result != null &amp;&amp; result.size() > 0)&#xD;
						{&#xD;
							// RU_915 - Controllo se c'è un AssetCPS tra quelli recuperati&#xD;
							for(var i=0; i&lt;result.size(); i++)&#xD;
							{&#xD;
								assetAppoggio = ScriptUtil.copy(result.get(i).readAsset());&#xD;
								&#xD;
								if(assetAppoggio.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
								{&#xD;
									if(recipientWLRVULL) //SM_9604&#xD;
									{&#xD;
										assetCPSMig = ScriptUtil.copy(assetAppoggio);&#xD;
										Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset CPS trovato: &quot;+String(assetCPSMig.IDAsset)+&quot;, considerato: &quot;+recipientWLRVULL);&#xD;
									}&#xD;
					&#xD;
									result.remove(i);&#xD;
								}&#xD;
							}&#xD;
							&#xD;
							//Logica standard preesistente&#xD;
							if(result != null &amp;&amp; result.size()>0)&#xD;
							{&#xD;
								AssetRef2 = result.get(0);&#xD;
								Asset2 = ScriptUtil.copy(AssetRef2.readAsset());&#xD;
								Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset: &quot;+String(Asset2.IDAsset));&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			&#xD;
&#xD;
			//--------------------------------------------------RECUPERA/SET ASSET CORRELATO--------------------------------------------------//&#xD;
			AssetCorrelato = false;&#xD;
			if(Asset1 != null &amp;&amp; Asset1.IDRisorsaCorrelato != null &amp;&amp; Asset1.IDRisorsaCorrelato != &quot;&quot; &amp;&amp; Asset2 == null)&#xD;
			{&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recupero AssetCorrelato per codiceRisorsa: &quot; + Asset1.IDRisorsaCorrelato);&#xD;
				var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta &lt;> 'NP' AND IDAsset &lt;> :ida&quot;);&#xD;
				c.setQueryParameter(&quot;idr&quot;, Asset1.IDRisorsaCorrelato);&#xD;
				c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(Asset1.IDAsset));&#xD;
				var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
				if(result != null &amp;&amp; result.size() > 0)&#xD;
				{&#xD;
					AssetRef2 = result.get(0);&#xD;
					Asset2 = ScriptUtil.copy(AssetRef2.readAsset());&#xD;
					AssetCorrelato = true;&#xD;
				}&#xD;
			}&#xD;
			else if (Asset1 != null &amp;&amp; Asset2!= null &amp;&amp; Asset1.IDRisorsaCorrelato != null &amp;&amp; Asset1.IDRisorsaCorrelato != &quot;&quot; &amp;&amp; Asset2.IDRisorsaCorrelato != null &amp;&amp; Asset2.IDRisorsaCorrelato != &quot;&quot; &amp;&amp; Asset1.IDRisorsaCorrelato == Asset2.IDRisorsa &amp;&amp; Asset2.IDRisorsaCorrelato == Asset1.IDRisorsa)&#xD;
			{&#xD;
				AssetCorrelato = true;&#xD;
			}&#xD;
		}&#xD;
&#xD;
		//--------------------------------------------------SM_3712, CASO PARTICOLARE RISORSA1 = RISORSA2--------------------------------------------------//&#xD;
		if(Asset2 != null &amp;&amp; (stessaRisorsa || AssetCorrelato) &amp;&amp; Asset1.tipologiaAccesso == Asset2.tipologiaAccesso)&#xD;
		{&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Calcolo caso particolare ULL + ULL o SLU + SLU di TI per Asset recuperati: &quot; + String(Asset1.IDAsset) + &quot; e &quot; + String(Asset2.IDAsset));&#xD;
			destinazioneUso1 = null;&#xD;
			var destinazioneUso2 = &quot;&quot;;&#xD;
			destinazioneUso2 = null;&#xD;
&#xD;
			var i = 0;&#xD;
			while(destinazioneUso1 == null &amp;&amp; i &lt; Asset1.dettaglioasset.size())&#xD;
			{&#xD;
				var DettAsset1 = Asset1.dettaglioasset.get(i);&#xD;
				if(String(DettAsset1.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var j = 0;&#xD;
					while(destinazioneUso1 == null &amp;&amp; j &lt; DettAsset1.attributidettaglioasset.size())&#xD;
					{&#xD;
						var AttrDettAsset1 = DettAsset1.attributidettaglioasset.get(j);&#xD;
						if(AttrDettAsset1.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
						{&#xD;
							destinazioneUso1 = AttrDettAsset1.valoreAttributo;&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
&#xD;
			var i = 0;&#xD;
			while(destinazioneUso2 == null &amp;&amp; i &lt; Asset2.dettaglioasset.size())&#xD;
			{&#xD;
				var DettAsset2 = Asset2.dettaglioasset.get(i);&#xD;
				if(String(DettAsset2.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var j = 0;&#xD;
					while(destinazioneUso2 == null &amp;&amp; j &lt; DettAsset2.attributidettaglioasset.size())&#xD;
					{&#xD;
						var AttrDettAsset2 = DettAsset2.attributidettaglioasset.get(j);&#xD;
						if(AttrDettAsset2.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
						{&#xD;
							destinazioneUso2 = AttrDettAsset2.valoreAttributo;&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
&#xD;
			if(!(Asset1.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
			&amp;&amp; Asset2.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
			&amp;&amp; ((String(Asset1.offerta).slice(0, 3) == &quot;ULL&quot; &amp;&amp; String(Asset2.offerta).slice(0, 3) == &quot;ULL&quot;)&#xD;
				|| (String(Asset1.offerta).slice(0, 3) == &quot;SLU&quot; &amp;&amp; String(Asset2.offerta).slice(0, 3) == &quot;SLU&quot;))&#xD;
			&amp;&amp; ((destinazioneUsoFonia.contains(destinazioneUso1) &amp;&amp; destinazioneUsoDati.contains(destinazioneUso2))&#xD;
				|| (destinazioneUsoDati.contains(destinazioneUso1) &amp;&amp; destinazioneUsoFonia.contains(destinazioneUso2)))))&#xD;
			{&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Caso particolare ULL + ULL o SLU + SLU di TI fallito per Asset1: tipologiaAccesso: &quot; + Asset1.tipologiaAccesso + &quot;, codificaOLOAGCOM: &quot; + Asset1.codificaOLOAGCOM +&#xD;
				&quot;, offerta: &quot; + Asset1.offerta + &quot; e destianzioneUso: &quot; + destinazioneUso1 + &quot; e per Asset2: tipologiaAccesso: &quot; + Asset2.tipologiaAccesso + &quot;, codificaOLOAGCOM: &quot; + Asset2.codificaOLOAGCOM +&#xD;
				&quot;, offerta: &quot; + Asset2.offerta + &quot; e destianzioneUso: &quot; + destinazioneUso2);&#xD;
				stessaRisorsa = false;&#xD;
				AssetCorrelato = false;&#xD;
&#xD;
				ConsistenzeStessoTipo = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset non recuperato.&quot;;&#xD;
		CodiceEsito = &quot;KO_02&quot;;&#xD;
		&#xD;
		if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL ||&#xD;
			localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_08&quot;;&#xD;
		}&#xD;
		else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_09&quot;;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: dati insufficienti per eseguire il controllo.&quot;;&#xD;
	CodiceEsito = &quot;KO_0	2&quot;;&#xD;
}&#xD;
&#xD;
// ---------------- LOG ----------------&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}&#xD;
&#xD;
if(Asset1 != null)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset LOG FINALE | Recuperato Asset1: &quot;+String(Asset1.IDAsset));&#xD;
}&#xD;
&#xD;
if(Asset2 != null)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset LOG FINALE | Recuperato Asset1: &quot;+String(Asset2.IDAsset));&#xD;
}&#xD;
&#xD;
if(assetCPSMig != null)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset LOG FINALE | Recuperato Asset1: &quot;+String(assetCPSMig.IDAsset));&#xD;
	assetCPSMulti.add(assetCPSMig); //SM_9676&#xD;
}&#xD;
&#xD;
//SM_9676: per ogni DNAggiuntivo va controllato se esiste un AssetCPS&#xD;
var i = 0;&#xD;
&#xD;
while(i&lt;localRequest.DNAggiuntivo.size())&#xD;
{&#xD;
	if(assetCPSMig != null) //Se abbiamo trovato già un AssetCPS bisogna, ovviamente, escluderlo dalla ricerca&#xD;
	{&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO') AND offerta IN ('CPS') AND IDAsset &lt;>: ida&quot;);&#xD;
		c.setQueryParameter(&quot;idr&quot;, localRequest.DNAggiuntivo.get(i));&#xD;
		c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(assetCPSMig.IDAsset));&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO') AND offerta IN ('CPS')&quot;);&#xD;
		c.setQueryParameter(&quot;idr&quot;, localRequest.DNAggiuntivo.get(i));&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	}&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size()>0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		assetCPSMulti.add(AssetRef.readAsset());&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa AssetCPS tramite DNAggiuntivo (&quot;+localRequest.DNAggiuntivo.get(i)+&quot;): &quot;+String(AssetRef.readAsset().IDAsset));&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Nessun Asset CPS trovato con DNAggiuntivo: &quot;+localRequest.DNAggiuntivo.get(i));&#xD;
	}&#xD;
&#xD;
	i++;&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="96.0">
              <xpdl2:Coordinates XCoordinate="607.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_5oH1EAwAEeiuHqlfsrN1jg">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_JBdx0LJVEeeX0aGK7_oRrA"/>
                  <xpdl2:TransitionRef Id="_XfLkYAwBEeiuHqlfsrN1jg"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="45.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="43.0">
              <xpdl2:Coordinates XCoordinate="701.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_I0QYMDUDEem_W51iiw9Z1g" Name="DoppioDonating" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="DoppioDonating">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(ExDoppioDonating) //Check se eseguire o meno i controlli per Doppio Donating e Rich Lavorazione Richiesta (da eseguire SOLO se non ha scartato nello script precedente)&#xD;
{&#xD;
	//---DOPPIO DONATING---//&#xD;
	if(Asset2 != null)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | Caso DOPPIO DONATING&quot;);&#xD;
&#xD;
		//SM_9694 - per ACCORPAMENTOOLO gestione dedicata in caso siano state recuperate due consistenze &#xD;
		if(ConsistenzaFonia != null &amp;&amp; ConsistenzaDati != null&#xD;
		&amp;&amp; ConsistenzaFonia.IDRisorsaCorrelato == ConsistenzaDati.IDRisorsa&#xD;
		&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
		{&#xD;
			// AssetTarget che risale dal TOOL (per ACCORPAMENTOOLO) è quello da cessare&#xD;
			if(localRequest.assetTarget != null&#xD;
			&amp;&amp; localRequest.assetTarget.get(0).IDAsset == ConsistenzaDati.IDAsset){&#xD;
				ConsistenzaDati.azione = &quot;D&quot;;&#xD;
				ConsistenzaFonia.azione = &quot;M&quot;;&#xD;
			}&#xD;
			else if(localRequest.assetTarget != null&#xD;
			&amp;&amp; localRequest.assetTarget.get(0).IDAsset == ConsistenzaFonia.IDAsset){&#xD;
				ConsistenzaDati.azione = &quot;M&quot;;&#xD;
				ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
			}&#xD;
			&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | caso particolare ACCORPAMENTOOLO. AzioneDati: &quot;+ConsistenzaDati.azione+&quot;, AzioneFonia: &quot;+ConsistenzaFonia.azione);&#xD;
		}&#xD;
		//---RECIPIENT FULL LOOP o DATI NAKED (CASO 1)---//&#xD;
		else if(&#xD;
		(FullLoop.contains(String(localRequest.offerta)))&#xD;
		|| (localRequest.flagNaked == &quot;S&quot;&#xD;
			&amp;&amp; (localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
				|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)))&#xD;
		{&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | Recipient Full Loop o Dati Naked, caso 1&quot;);&#xD;
			&#xD;
			//calcolo destinazione uso del receipient:&#xD;
			var DestinazioneUsoRecipient=&quot;&quot;;&#xD;
			var h=0;&#xD;
			while(DestinazioneUsoRecipient == &quot;&quot; &amp;&amp; h &lt; localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var componenteOrdine = localRequest.ordine.dettaglioordine.get(h);&#xD;
				&#xD;
				if (String(componenteOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var k=0;&#xD;
					while(DestinazioneUsoRecipient==&quot;&quot; &amp;&amp; k&lt;componenteOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var attributoOrdine = componenteOrdine.attributiDettaglioOrdine.get(k);&#xD;
						&#xD;
						if ( attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
						{&#xD;
							&#xD;
							DestinazioneUsoRecipient = attributoOrdine.valoreAttributo;&#xD;
						}&#xD;
					&#xD;
					k++;&#xD;
					}&#xD;
				}&#xD;
			h++;&#xD;
			}&#xD;
			&#xD;
			&#xD;
			// RU_714 - SF 5.73 - questo blocco di codice è stato messo qui per non duplicarlo con SM_8340/41&#xD;
			var conditionDestUso = true;&#xD;
&#xD;
			&#xD;
			if((String(localRequest.offerta).slice(0,3)== &quot;SLU&quot; || String(localRequest.offerta).slice(0,3)== &quot;ULL&quot;) &amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
			{&#xD;
				//SM_8120 - SF 6.19 + SM_8682 aggiunta Consistenza.offerta == VULA&#xD;
				if(((String(ConsistenzaFonia.offerta).slice(0,3)==&quot;WLR&quot; || String(ConsistenzaFonia.offerta).slice(0,4)==&quot;VULL&quot;) &amp;&amp; (String(ConsistenzaDati.offerta).slice(0,9)==&quot;BITSTREAM&quot; || String(ConsistenzaDati.offerta).slice(0,4)==&quot;VULA&quot; || String(ConsistenzaDati.offerta).slice(0,3)==&quot;SHA&quot; || String(ConsistenzaDati.offerta).slice(0,6)==&quot;EASYIP&quot; || String(ConsistenzaDati.offerta).slice(0,4)==&quot;SEMI&quot;) &amp;&amp; ConsistenzaFonia.tipoLinea == 'POTS' &amp;&amp; (DestinazioneUsoRecipient == &quot;10&quot; || DestinazioneUsoRecipient == &quot;4&quot;))&#xD;
				   ||&#xD;
				   ((String(ConsistenzaFonia.offerta).slice(0,3)==&quot;WLR&quot; || String(ConsistenzaFonia.offerta).slice(0,4)==&quot;VULL&quot;) &amp;&amp; (String(ConsistenzaDati.offerta).slice(0,9)==&quot;BITSTREAM&quot; || String(ConsistenzaDati.offerta).slice(0,4)==&quot;VULA&quot; || String(ConsistenzaDati.offerta).slice(0,3)==&quot;SHA&quot; || String(ConsistenzaDati.offerta).slice(0,6)==&quot;EASYIP&quot; || String(ConsistenzaDati.offerta).slice(0,4)==&quot;SEMI&quot;) &amp;&amp; ConsistenzaFonia.tipoLinea == 'ISDN' &amp;&amp; (DestinazioneUsoRecipient == &quot;2&quot; || DestinazioneUsoRecipient == &quot;3&quot; || DestinazioneUsoRecipient == &quot;10&quot;))&#xD;
				   ||&#xD;
				   ((String(ConsistenzaFonia.offerta).slice(0,3)==&quot;WLR&quot; || String(ConsistenzaFonia.offerta).slice(0,4)==&quot;VULL&quot;) &amp;&amp; (String(ConsistenzaDati.offerta).slice(0,9)==&quot;BITSTREAM&quot; || String(ConsistenzaDati.offerta).slice(0,4)==&quot;VULA&quot; || String(ConsistenzaDati.offerta).slice(0,3)==&quot;SHA&quot; || String(ConsistenzaDati.offerta).slice(0,6)==&quot;EASYIP&quot; || String(ConsistenzaDati.offerta).slice(0,4)==&quot;SEMI&quot;) &amp;&amp; ConsistenzaFonia.tipoLinea == 'POTS' &amp;&amp; (DestinazioneUsoRecipient == &quot;1|4&quot; || DestinazioneUsoRecipient == &quot;1|10&quot;)) &#xD;
				   ||&#xD;
					(ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot; &amp;&amp; ConsistenzaDati.codificaOLOAGCOMDonating != &quot;TLC&quot;) //SM_8358&#xD;
				   ||									&#xD;
					(localRequest.codiceSessione2 != null &amp;&amp; String(localRequest.codiceSessione2) == 'EQ2SOVR274FTTC'))&#xD;
				{&#xD;
					conditionDestUso = true;&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | conditionDestUso: &quot;+conditionDestUso);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					conditionDestUso = false;&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | conditionDestUso: &quot;+conditionDestUso);&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				conditionDestUso = true;&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | conditionDestUso: &quot;+conditionDestUso);&#xD;
			}&#xD;
			&#xD;
			&#xD;
			//Consistenze Correlate ULL/SLU TIM O DATI CONDIVISO&#xD;
			if((((ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot; &amp;&amp; FullLoopTLC.contains(String(ConsistenzaFonia.offerta)))))&#xD;
			&amp;&amp; ((String(ConsistenzaDati.offerta).slice(0, 3) == &quot;SHA&quot;)&#xD;
				|| ((ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
					&amp;&amp; FullLoopDati.contains(String(ConsistenzaDati.offerta)))))&#xD;
			{&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | Consistenze Correlate ULL/SLU TIM O DATI CONDIVISO&quot;);&#xD;
				&#xD;
				// CASO 1 CON 2 CODICI RISORSADONATING&#xD;
				if (localRequest.codiceRisorsaDonating2 != null &amp;&amp; localRequest.codiceRisorsaDonating2 != &quot;&quot;)&#xD;
				{&#xD;
					Log.write(&quot;CASO 1 CON 2 CODICI RISORSADONATING&quot;);&#xD;
					if(conditionDestUso) //SM_8340/41&#xD;
					{&#xD;
						ConsistenzaDati.azione = &quot;D&quot;;&#xD;
						ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 1.&quot;;&#xD;
						CodiceEsito = &quot;KO_11&quot;;									&#xD;
					}			&#xD;
				}&#xD;
				else if(localRequest.codiceRisorsaDonating == ConsistenzaDati.IDRisorsa&#xD;
				|| localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio&#xD;
				|| localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroTelefonico&#xD;
				|| &quot;0&quot;+localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio //SM_8245&#xD;
				|| &quot;00&quot;+localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio&#xD;
				|| localRequest.codiceRisorsaDonating == &quot;0&quot;+ConsistenzaDati.numeroFittizio&#xD;
				|| localRequest.codiceRisorsaDonating == &quot;00&quot;+ConsistenzaDati.numeroFittizio)&#xD;
				{&#xD;
					if(ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
					{&#xD;
						//SM_8144 EVO C12 inserite condizioni su TIPOLOGIA SOTTOLAVORAZIONE&#xD;
						if(localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroTelefonico &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO)&#xD;
						{&#xD;
							ConsistenzaDati.azione = &quot;D&quot;;&#xD;
							ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
							ConsistenzaFonia.cowCode = null;&#xD;
							ConsistenzaFonia.codiceSessione = null;&#xD;
						}&#xD;
						else if(localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroTelefonico &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274)&#xD;
						{&#xD;
							ConsistenzaDati.azione = &quot;T&quot;;&#xD;
							ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
							ConsistenzaDati.cowCode = null;&#xD;
							ConsistenzaDati.codiceSessione = null;&#xD;
						}&#xD;
						else if((localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio || &#xD;
								&quot;0&quot;+localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio || &#xD;
								&quot;00&quot;+localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio ||&#xD;
								localRequest.codiceRisorsaDonating == &quot;0&quot;+ConsistenzaDati.numeroFittizio || &#xD;
								localRequest.codiceRisorsaDonating == &quot;00&quot;+ConsistenzaDati.numeroFittizio ||&#xD;
								(localRequest.codiceRisorsaDonating == ConsistenzaDati.IDRisorsa &amp;&amp; String(ConsistenzaDati.offerta).slice(0, 3) == &quot;SHA&quot;)) &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO)&#xD;
						{&#xD;
							ConsistenzaDati.azione = &quot;D&quot;;&#xD;
							ConsistenzaFonia.azione = &quot;M&quot;;&#xD;
							ConsistenzaFonia.cowCode = null;&#xD;
							ConsistenzaFonia.codiceSessione = null;&#xD;
						}&#xD;
					}&#xD;
					else if(ConsistenzaDati.tipoLinea == &quot;POTS&quot;)&#xD;
					{&#xD;
							ConsistenzaDati.azione = &quot;D&quot;;&#xD;
							ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
							ConsistenzaFonia.cowCode = null;&#xD;
							ConsistenzaFonia.codiceSessione = null;&#xD;
					}&#xD;
					&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 1.&quot;;&#xD;
&#xD;
					if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
						|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
					{&#xD;
						CodiceEsito = &quot;KO_08&quot;;&#xD;
					}&#xD;
					else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
					{&#xD;
						CodiceEsito = &quot;KO_09&quot;;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//Consistenze Correlate VULL/WLR O DATI CONDIVISO&#xD;
			else if(((String(ConsistenzaFonia.offerta).slice(0, 4) == &quot;VULL&quot; || String(ConsistenzaFonia.offerta).slice(0, 3) == &quot;WLR&quot;))&#xD;
				&amp;&amp; ((String(ConsistenzaDati.offerta).slice(0, 3) == &quot;SHA&quot;) || ((ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;) &amp;&amp; FullLoopDati.contains(String(ConsistenzaDati.offerta)))))&#xD;
			{&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | Consistenze Correlate VULL/WLR O DATI CONDIVISO&quot;);&#xD;
				&#xD;
				// CASO 1 CON 1 CODICE RISORSA&#xD;
				if (localRequest.codiceRisorsaDonating2 == null || localRequest.codiceRisorsaDonating2 == &quot;&quot;)&#xD;
				{&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | CASO 1 CON 1 CODICE RISORSA, ConsistenzaDati.tipoLinea: &quot;+ConsistenzaDati.tipoLinea);&#xD;
					&#xD;
					if(ConsistenzaDati.tipoLinea == &quot;POTS&quot;)&#xD;
					{&#xD;
						// SM_8306 - inserita gestione Casi A/B&#xD;
						//CASO A - Recipient ULL/SLU TIM con DestinazioneUso = Fonia POTS&#xD;
						if((String(localRequest.offerta).slice(0,3) == &quot;ULL&quot; || String(localRequest.offerta).slice(0,3)== &quot;SLU&quot;)&#xD;
							&amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
							&amp;&amp; localRequest.codiceRisorsaDonating == ConsistenzaFonia.IDRisorsa						&#xD;
							&amp;&amp;(DestinazioneUsoRecipient == &quot;1&quot; || &#xD;
								(String(ConsistenzaFonia.offerta).slice(0, 4) == &quot;VULL&quot; &#xD;
								 &amp;&amp;(DestinazioneUsoRecipient == &quot;4&quot;&#xD;
								 || DestinazioneUsoRecipient == &quot;10&quot;&#xD;
								 || DestinazioneUsoRecipient == &quot;1|10&quot;&#xD;
								 || DestinazioneUsoRecipient == &quot;1|4&quot;)))) // Contorlli su DU da 4 aggiunti con SM_8455/56&#xD;
						{&#xD;
							// Donating WLR&#xD;
							if(String(ConsistenzaFonia.offerta).slice(0, 3) == &quot;WLR&quot;)&#xD;
							{&#xD;
								ConsistenzaDati.azione = &quot;M&quot;;&#xD;
								ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
								ConsistenzaDati.cowCode = null;&#xD;
								ConsistenzaDati.codiceSessione = null;&#xD;
							}&#xD;
							// Donating VULL&#xD;
							else&#xD;
							{&#xD;
								ConsistenzaDati.azione = &quot;D&quot;;&#xD;
								ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
								ConsistenzaDati.cowCode = null;&#xD;
								ConsistenzaDati.codiceSessione = null;&#xD;
							}&#xD;
						}&#xD;
						else if (localRequest.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
						{&#xD;
							EsitoResponse.codice = false;&#xD;
							EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 1.&quot;;&#xD;
							CodiceEsito = &quot;KO_23&quot;;&#xD;
						}&#xD;
						//CASO B - Recipient Diverso da TLC&#xD;
						else&#xD;
						{&#xD;
							// Donating WLR&#xD;
							if (String(ConsistenzaFonia.offerta).slice(0,3) == &quot;WLR&quot; &amp;&amp; localRequest.codiceRisorsaDonating == ConsistenzaFonia.IDRisorsa)&#xD;
							{&#xD;
								ConsistenzaDati.azione = &quot;T&quot;;&#xD;
								ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
								ConsistenzaDati.cowCode = null;&#xD;
								ConsistenzaDati.codiceSessione = null;&#xD;
							}&#xD;
							// Donating VULL&#xD;
							else if (String(ConsistenzaFonia.offerta).slice(0,3) == &quot;VULL&quot; &amp;&amp; localRequest.codiceRisorsaDonating == ConsistenzaFonia.IDRisorsa)&#xD;
							{&#xD;
								ConsistenzaDati.azione = &quot;D&quot;;&#xD;
								ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
								ConsistenzaDati.cowCode = null;&#xD;
								ConsistenzaDati.codiceSessione = null;&#xD;
							}&#xD;
							// Donating dati SHA&#xD;
							else if((localRequest.codiceRisorsaDonating == ConsistenzaDati.IDRisorsa &amp;&amp; String(ConsistenzaDati.offerta).slice(0, 3) == &quot;SHA&quot;) &#xD;
								|| localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio&#xD;
								|| &quot;0&quot;+localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio&#xD;
								|| &quot;00&quot;+localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio&#xD;
								|| localRequest.codiceRisorsaDonating == &quot;0&quot;+ConsistenzaDati.numeroFittizio&#xD;
								|| localRequest.codiceRisorsaDonating == &quot;00&quot;+ConsistenzaDati.numeroFittizio)&#xD;
							{&#xD;
								ConsistenzaDati.azione = &quot;D&quot;;&#xD;
								ConsistenzaFonia.azione = &quot;M&quot;;&#xD;
								ConsistenzaFonia.cowCode = null;&#xD;
								ConsistenzaFonia.codiceSessione = null;&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
					else if(ConsistenzaDati.tipoLinea == &quot;ISDN&quot;) &#xD;
					{&#xD;
						// SM_8306 - inserita gestione Casi A/B/C/D/E&#xD;
						// CASO A - Recipient ULL/SLU TIM - DU = Fonia ISDN POTS&#xD;
						if (String(localRequest.offerta).slice(0,3) == &quot;ULL&quot; &amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot; &#xD;
							&amp;&amp; (DestinazioneUsoRecipient == &quot;2&quot; || DestinazioneUsoRecipient == &quot;3&quot;)&#xD;
							&amp;&amp; localRequest.codiceRisorsaDonating == ConsistenzaFonia.IDRisorsa)											&#xD;
						{&#xD;
							// Donating WLR&#xD;
							if(String(ConsistenzaFonia.offerta).slice(0, 3) == &quot;WLR&quot;)&#xD;
							{&#xD;
								ConsistenzaDati.azione = &quot;M&quot;;&#xD;
								ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
								ConsistenzaDati.cowCode = null;&#xD;
								ConsistenzaDati.codiceSessione = null;&#xD;
							}&#xD;
							// Donating VULL&#xD;
							else&#xD;
							{&#xD;
								ConsistenzaDati.azione = &quot;D&quot;;&#xD;
								ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
								ConsistenzaDati.cowCode = null;&#xD;
								ConsistenzaDati.codiceSessione = null;&#xD;
							}&#xD;
						}&#xD;
						// CASO B/CASO C - Recipient ULL TIM - DU = Fonia+Dati o Recipient SLU - DU Fonia+Dati POTS / Recipient ULL/SLU TIM - DU = Fonia ADSL POTS&#xD;
						else if(((String(localRequest.offerta).slice(0,3) == &quot;ULL&quot; &amp;&amp; DestinazioneUsoRecipient == &quot;1|4&quot;)&#xD;
								 || (String(localRequest.offerta).slice(0,3) == &quot;SLU&quot; &amp;&amp; DestinazioneUsoRecipient == &quot;1|10&quot;))&#xD;
								 || ((String(localRequest.offerta).slice(0,3) == &quot;ULL&quot; || String(localRequest.offerta).slice(0,3) == &quot;SLU&quot;) &amp;&amp; DestinazioneUsoRecipient == &quot;10&quot;)&#xD;
								 &amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot; &amp;&amp; localRequest.codiceRisorsaDonating == ConsistenzaFonia.IDRisorsa)&#xD;
						{		&#xD;
							// Donating WLR&#xD;
							if(String(ConsistenzaFonia.offerta).slice(0, 3) == &quot;WLR&quot;)&#xD;
							{&#xD;
								ConsistenzaDati.azione = &quot;T&quot;;&#xD;
								ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
								ConsistenzaDati.cowCode = null;&#xD;
								ConsistenzaDati.codiceSessione = null;&#xD;
							}&#xD;
							// Donating VULL&#xD;
							else&#xD;
							{&#xD;
								ConsistenzaDati.azione = &quot;D&quot;;&#xD;
								ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
								ConsistenzaDati.cowCode = null;&#xD;
								ConsistenzaDati.codiceSessione = null;&#xD;
							}&#xD;
						}&#xD;
						// CASO D - ULL/SLU TLC ma non rientra nei casi precedenti&#xD;
						else if((String(localRequest.offerta).slice(0,3) == &quot;ULL&quot; || String(localRequest.offerta).slice(0,3)== &quot;SLU&quot;) &amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
						{&#xD;
							EsitoResponse.codice = false;&#xD;
							EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 1.&quot;;&#xD;
							CodiceEsito = &quot;KO_23&quot;;&#xD;
						}&#xD;
						// CASO E - Recipient diverso da TLC&#xD;
						else if(localRequest.codificaOLOAGCOM != &quot;TLC&quot;)&#xD;
						{&#xD;
							if(localRequest.codiceRisorsaDonating == ConsistenzaFonia.IDRisorsa)&#xD;
							{&#xD;
								// Donating WLR&#xD;
								if (String(ConsistenzaFonia.offerta).slice(0,3) == &quot;WLR&quot;)&#xD;
								{&#xD;
									ConsistenzaDati.azione = &quot;T&quot;;&#xD;
									ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
									ConsistenzaDati.cowCode = null;&#xD;
									ConsistenzaDati.codiceSessione = null;&#xD;
								}&#xD;
								// Donating VULL&#xD;
								else &#xD;
								{&#xD;
									ConsistenzaDati.azione = &quot;D&quot;;&#xD;
									ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
									ConsistenzaDati.cowCode = null;&#xD;
									ConsistenzaDati.codiceSessione = null;&#xD;
								}&#xD;
							}&#xD;
							else if((localRequest.codiceRisorsaDonating == ConsistenzaDati.IDRisorsa &amp;&amp; String(ConsistenzaDati.offerta).slice(0, 3) == &quot;SHA&quot;) &#xD;
								|| localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio&#xD;
								|| &quot;0&quot;+localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio&#xD;
								|| &quot;00&quot;+localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio&#xD;
								|| localRequest.codiceRisorsaDonating == &quot;0&quot;+ConsistenzaDati.numeroFittizio&#xD;
								|| localRequest.codiceRisorsaDonating == &quot;00&quot;+ConsistenzaDati.numeroFittizio)&#xD;
							{&#xD;
								ConsistenzaDati.azione = &quot;D&quot;;&#xD;
								ConsistenzaFonia.azione = &quot;M&quot;;&#xD;
								ConsistenzaFonia.cowCode = null;&#xD;
								ConsistenzaFonia.codiceSessione = null;&#xD;
							}&#xD;
						}	&#xD;
					}&#xD;
				}&#xD;
				// CASO 1 CON 2 CODICIRISORSADONATING&#xD;
				else if (localRequest.codiceRisorsaDonating2 !=null &amp;&amp; localRequest.codiceRisorsaDonating2!= &quot;&quot; &amp;&amp; (ConsistenzaDati.tipoLinea == &quot;ISDN&quot; || ConsistenzaDati.tipoLinea == &quot;POTS&quot;))&#xD;
				{&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | CASO 1 CON 2 CODICIRISORSADONATING&quot;);&#xD;
					&#xD;
					if(conditionDestUso) //SM_8340/41&#xD;
					{&#xD;
						ConsistenzaDati.azione = &quot;D&quot;;&#xD;
						ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 1.&quot;;&#xD;
						CodiceEsito = &quot;KO_11&quot;;									&#xD;
					}	&#xD;
				}&#xD;
			}&#xD;
					&#xD;
			//Consistenze Correlate	ULL DestUso Dati + DestUso Fonia  o  SLU DestUso Dati + DestUso Fonia&#xD;
			else if(stessaRisorsa || AssetCorrelato)&#xD;
			{&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | Consistenze Correlate ULL DestUso Dati + DestUso Fonia o SLU DestUso Dati + DestUso Fonia&quot;);&#xD;
				&#xD;
				// SM_7026 - Consistenze correlate ULL + ULL e recipient = SLU o ULL &#xD;
				if ((String(ConsistenzaFonia.offerta).slice(0,3) == &quot;ULL&quot; &amp;&amp; String(ConsistenzaDati.offerta).slice(0,3) == &quot;ULL&quot;)&#xD;
					&amp;&amp; (destinazioneUsoFonia.contains(ConsistenzaFonia.destinazioneUso) &amp;&amp; destinazioneUsoDati.contains(ConsistenzaDati.destinazioneUso))&#xD;
					&amp;&amp; ((String(localRequest.offerta).slice(0,3)== &quot;SLU&quot; || String(localRequest.offerta).slice(0,3)== &quot;ULL&quot;) &amp;&amp; DestinazioneUsoRecipient == &quot;10&quot; &amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
					&amp;&amp; localRequest.codiceRisorsaDonating == ConsistenzaFonia.IDRisorsa)) // Aggiunto ULL con RU_764&#xD;
				{&#xD;
					ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
					ConsistenzaDati.azione = &quot;M&quot;;&#xD;
				}&#xD;
					&#xD;
				// consistenze correlate ULL+ULL || SLU+SLU e recipient FullLoop REGOLATORIO&#xD;
				else if(FullLoop.contains(String(localRequest.offerta)))&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 1.&quot;;&#xD;
					CodiceEsito = &quot;KO_09&quot;;&#xD;
				}&#xD;
				&#xD;
				//SM_8730 				&#xD;
				else if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274 &#xD;
					&amp;&amp; localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.LINEANONFONIA &#xD;
					&amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot; &amp;&amp; ConsistenzaDati.codificaOLOAGCOMDonating == &quot;TLC&quot; &#xD;
					&amp;&amp; destinazioneUsoFonia.contains(ConsistenzaFonia.destinazioneUso) &amp;&amp; destinazioneUsoDati.contains(ConsistenzaDati.destinazioneUso) &#xD;
					&amp;&amp; ConsistenzaFonia.IDRisorsa == assetDatiMig.IDRisorsaCorrelato)&#xD;
				{&#xD;
					ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
					ConsistenzaDati.azione = &quot;M&quot;;&#xD;
				}&#xD;
				//END&#xD;
				&#xD;
				//START SM_8730&#xD;
				else if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274 &amp;&amp; &#xD;
					ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot; &amp;&amp; ConsistenzaDati.codificaOLOAGCOMDonating == &quot;TLC&quot; &amp;&amp; ConsistenzaDati.IDRisorsaCorrelato == ConsistenzaFonia.IDRisorsa)&#xD;
				{&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | ATTIVAZIONE274, caso particolare con Consistenze TLC e correlate&quot;);&#xD;
					&#xD;
					var isLineaNonFonia = false;&#xD;
					var i=0;&#xD;
					while(!isLineaNonFonia &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
					{&#xD;
						var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
						if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
						{&#xD;
							var j=0;&#xD;
							while(!isLineaNonFonia &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
							{&#xD;
								var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
								if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA &amp;&amp; String(attributo.valoreAttributo) == &quot;LineaNonFonia&quot;)&#xD;
								{&#xD;
									isLineaNonFonia = true;&#xD;
								}&#xD;
								j++;&#xD;
							}&#xD;
						}&#xD;
						i++;&#xD;
					}&#xD;
				&#xD;
					if(isLineaNonFonia)&#xD;
					{&#xD;
						ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
						ConsistenzaDati.azione = &quot;M&quot;;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
						ConsistenzaDati.azione = &quot;D&quot;;&#xD;
					}&#xD;
					//END SM_8730&#xD;
				}&#xD;
				&#xD;
				// consistenze correlate ULL+ULL || SLU+SLU e recipient Dati Naked&#xD;
				else&#xD;
				{&#xD;
					ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
					ConsistenzaDati.azione = &quot;N&quot;;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		//---RECIPIENT WLR (CASO 2)---//&#xD;
		else if(String(localRequest.offerta).slice(0, 3) == &quot;WLR&quot;)&#xD;
		{&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | RECIPIENT WLR, caso 2&quot;);&#xD;
			&#xD;
			if (localRequest.codiceRisorsaDonating2 == null || localRequest.codiceRisorsaDonating2 == &quot;&quot;)&#xD;
			{&#xD;
				if((((ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot; &amp;&amp; FullLoopTLC.contains(String(ConsistenzaFonia.offerta)))))&#xD;
				&amp;&amp; ((String(ConsistenzaDati.offerta).slice(0, 3) == &quot;SHA&quot;)&#xD;
					|| ((ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
						&amp;&amp; FullLoopDati.contains(String(ConsistenzaDati.offerta)))))&#xD;
				{&#xD;
					if(ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
					{&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 2.&quot;;&#xD;
						CodiceEsito = &quot;KO_09&quot;;&#xD;
					}&#xD;
				}&#xD;
				// consistenze correlate WLR o VULL e Dati Condiviso&#xD;
				else if(((String(ConsistenzaFonia.offerta).slice(0, 4) == &quot;VULL&quot; || String(ConsistenzaFonia.offerta).slice(0, 3) == &quot;WLR&quot;))&#xD;
				&amp;&amp; ((String(ConsistenzaDati.offerta).slice(0, 3) == &quot;SHA&quot;)&#xD;
					|| ((ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
						&amp;&amp; FullLoopDati.contains(String(ConsistenzaDati.offerta)))))&#xD;
				{&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | Consistenze correlate WLR o VULL e Dati Condiviso, localRequest.codiceRisorsaDonating&quot;+localRequest.codiceRisorsaDonating+&quot;, ConsistenzaFonia.IDRisorsa: &quot;+ConsistenzaFonia.IDRisorsa);&#xD;
					&#xD;
					if(ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
					{&#xD;
						if(localRequest.codiceRisorsaDonating == ConsistenzaFonia.IDRisorsa)&#xD;
						{&#xD;
							//donating WLR&#xD;
							if (String(ConsistenzaFonia.offerta).slice(0,3) == &quot;WLR&quot;)&#xD;
							{&#xD;
								ConsistenzaDati.azione = &quot;M&quot;;&#xD;
								ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
								ConsistenzaDati.cowCode = null;&#xD;
								ConsistenzaDati.codiceSessione = null;&#xD;
							}&#xD;
							//donating VULL&#xD;
							else &#xD;
							{&#xD;
								ConsistenzaDati.azione = &quot;D&quot;;&#xD;
								ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
								ConsistenzaDati.cowCode = null;&#xD;
								ConsistenzaDati.codiceSessione = null;&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 2.&quot;;&#xD;
						CodiceEsito = &quot;KO_09&quot;;&#xD;
					}								&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//CASO 2 - DUE CODICI RISORSA&#xD;
			else &#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 2 - 2 codici risorsa&quot;;&#xD;
				CodiceEsito = &quot;KO_09&quot;;&#xD;
			}&#xD;
		}&#xD;
		//---RECIPIENT DATI CONDIVISO: BTS, NGA, SHA (CASO 3)---//&#xD;
		else if(String(localRequest.offerta).slice(0, 3) == &quot;SHA&quot;&#xD;
		|| ((localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS&#xD;
		|| localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN)&#xD;
		&amp;&amp; (localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
			|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)))&#xD;
		{&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | RECIPIENT DATI CONDIVISO: BTS, NGA, SHA, caso 3&quot;);&#xD;
			&#xD;
			if (localRequest.codiceRisorsaDonating2 == null || localRequest.codiceRisorsaDonating2 == &quot;&quot;)&#xD;
			{&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | codificaOLOAGCOMDonatingFoniaCONS: &quot;+ConsistenzaFonia.codificaOLOAGCOMDonating+&quot;, offertaFoniaCONS: &quot;+ConsistenzaFonia.offerta+&quot;, offertaDatiCONS: &quot;+ConsistenzaDati.offerta+&quot;, tipoLineaFonia: &quot;+ConsistenzaFonia.tipoLinea+&quot;, tipoLineaDati: &quot;+ConsistenzaDati.tipoLinea);&#xD;
				&#xD;
				if(((((ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot; &amp;&amp; FullLoopTLC.contains(String(ConsistenzaFonia.offerta)))))&#xD;
					|| (String(ConsistenzaFonia.offerta).slice(0, 3) == &quot;WLR&quot;))&#xD;
				&amp;&amp; ((String(ConsistenzaDati.offerta).slice(0, 3) == &quot;SHA&quot;)&#xD;
					|| ((ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
						&amp;&amp; FullLoopDati.contains(String(ConsistenzaDati.offerta)))))&#xD;
				{&#xD;
					if((ConsistenzaDati.tipoLinea == &quot;POTS&quot;&#xD;
						|| ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
						&amp;&amp; (DatiAccesso == null || (DatiAccesso != null &amp;&amp; DatiAccesso.idRisorsaPerNumeroLinea == null)&#xD;
						|| (DatiAccesso != null&#xD;
							&amp;&amp; DatiAccesso.idRisorsaPerNumeroLinea != null&#xD;
							&amp;&amp; DatiAccesso.idRisorsaPerNumeroLinea != &quot;&quot;&#xD;
							&amp;&amp; ConsistenzaFonia.IDRisorsa == DatiAccesso.idRisorsaPerNumeroLinea)))&#xD;
					{&#xD;
						ConsistenzaDati.azione = &quot;D&quot;;&#xD;
						ConsistenzaFonia.azione = &quot;M&quot;;&#xD;
						ConsistenzaFonia.cowCode = null;&#xD;
						ConsistenzaFonia.codiceSessione = null;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 3.&quot;;&#xD;
&#xD;
						if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
							|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
						{&#xD;
							CodiceEsito = &quot;KO_08&quot;;&#xD;
						}&#xD;
						else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
						{&#xD;
							CodiceEsito = &quot;KO_09&quot;;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					/* Commentato con SM_8616&#xD;
					// SM_7887&#xD;
					if(ConsistenzaFonia.azione != &quot;D&quot; &amp;&amp; String(localRequest.offerta).slice(0, 3) == &quot;SHA&quot; &amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating != localRequest.codificaOLOAGCOM)&#xD;
					{&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerta SHA e OLO Recipient diverso da OLO in consistenza fonia&quot;;&#xD;
						CodiceEsito = &quot;KO_20&quot;;&#xD;
					}*/&#xD;
				}&#xD;
				else if(String(ConsistenzaFonia.offerta).slice(0, 4) == &quot;VULL&quot;&#xD;
				&amp;&amp; (String(ConsistenzaDati.offerta).slice(0, 3) == &quot;SHA&quot;&#xD;
					|| ((ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
						&amp;&amp; FullLoopDati.contains(String(ConsistenzaDati.offerta)))))&#xD;
				{&#xD;
					if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
					|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB)&#xD;
					{&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 3.&quot;;&#xD;
						CodiceEsito = &quot;KO_08&quot;;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						if(localRequest.codiceRisorsaDonating == ConsistenzaDati.IDRisorsa&#xD;
							|| localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroTelefonico&#xD;
							|| localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio&#xD;
							|| &quot;0&quot;+localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio // aggiunta logica concat con zeri &#xD;
							|| &quot;00&quot;+localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroFittizio&#xD;
							|| localRequest.codiceRisorsaDonating == &quot;0&quot;+ConsistenzaDati.numeroFittizio&#xD;
							|| localRequest.codiceRisorsaDonating == &quot;00&quot;+ConsistenzaDati.numeroFittizio)&#xD;
						{&#xD;
							ConsistenzaDati.azione = &quot;D&quot;;&#xD;
							ConsistenzaFonia.azione = &quot;M&quot;;&#xD;
							ConsistenzaFonia.cowCode = null;&#xD;
							ConsistenzaFonia.codiceSessione = null;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				else if(stessaRisorsa || AssetCorrelato)&#xD;
				{&#xD;
					if(String(localRequest.offerta).slice(0, 3) == &quot;SHA&quot;)&#xD;
					{&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 3.&quot;;&#xD;
						CodiceEsito = &quot;KO_09&quot;;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						//RU_764&#xD;
						if(localRequest.codiceRisorsaDonating == ConsistenzaDati.numeroTelefonico)&#xD;
						{&#xD;
							ConsistenzaDati.azione = &quot;D&quot;;&#xD;
							ConsistenzaFonia.azione = &quot;M&quot;;&#xD;
							ConsistenzaFonia.cowCode = null;&#xD;
							ConsistenzaFonia.codiceSessione = null;&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							EsitoResponse.codice = false;&#xD;
							EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 3.&quot;;&#xD;
&#xD;
							if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
								|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
							{&#xD;
								CodiceEsito = &quot;KO_08&quot;;&#xD;
							}&#xD;
							else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
							{&#xD;
								CodiceEsito = &quot;KO_09&quot;;&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}	&#xD;
			&#xD;
			// CASO 3 - DUE CODICI RISORSA&#xD;
			else&#xD;
			{&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | CASO 3 - DUE CODICI RISORSA&quot;);&#xD;
				&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 3 - due codici risorsa&quot;;&#xD;
&#xD;
				if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
				|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
				{&#xD;
					CodiceEsito = &quot;KO_08&quot;;&#xD;
				}&#xD;
				else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
				{&#xD;
					CodiceEsito = &quot;KO_09&quot;;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		//---RECIPIENT VULL (CASO 4)---//&#xD;
		else if(String(localRequest.offerta).slice(0, 4) == &quot;VULL&quot;)&#xD;
		{&#xD;
			if((((ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot; &amp;&amp; FullLoopTLC.contains(String(ConsistenzaFonia.offerta)))))&#xD;
			&amp;&amp; ((String(ConsistenzaDati.offerta).slice(0, 3) == &quot;SHA&quot;)&#xD;
				|| ((ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
					&amp;&amp; FullLoopDati.contains(String(ConsistenzaDati.offerta)))))&#xD;
			{&#xD;
				if (localRequest.codiceRisorsaDonating2 == null || localRequest.codiceRisorsaDonating2 == &quot;&quot;)&#xD;
				{&#xD;
					if(ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
					{&#xD;
						if(localRequest.codiceRisorsaDonating == ConsistenzaFonia.IDRisorsa&#xD;
						|| localRequest.codiceRisorsaDonating == ConsistenzaFonia.numeroTelefonico&#xD;
						|| localRequest.codiceRisorsaDonating == ConsistenzaFonia.numeroFittizio&#xD;
						|| &quot;0&quot;+localRequest.codiceRisorsaDonating == ConsistenzaFonia.numeroFittizio //aggiunta logica concat con gli zeri&#xD;
						|| &quot;00&quot;+localRequest.codiceRisorsaDonating == ConsistenzaFonia.numeroFittizio&#xD;
						|| localRequest.codiceRisorsaDonating == &quot;0&quot;+ConsistenzaFonia.numeroFittizio&#xD;
						|| localRequest.codiceRisorsaDonating == &quot;00&quot;+ConsistenzaFonia.numeroFittizio)&#xD;
						{&#xD;
							ConsistenzaDati.azione = &quot;D&quot;;&#xD;
							ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
							ConsistenzaFonia.cowCode = null;&#xD;
							ConsistenzaFonia.codiceSessione = null;&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							EsitoResponse.codice = false;&#xD;
							EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 4.&quot;;&#xD;
							CodiceEsito = &quot;KO_09&quot;;&#xD;
						}&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 4.&quot;;&#xD;
						CodiceEsito = &quot;KO_02&quot;;&#xD;
					}&#xD;
					&#xD;
					//SM_7887&#xD;
					if(ConsistenzaDati.azione != &quot;D&quot; &amp;&amp; (ConsistenzaDati.codificaOLOAGCOMDonating != localRequest.codificaOLOAGCOM))&#xD;
					{&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: CASO 4 Recipient Vull, OLO Recipient diverso da OLO in consistenza dati&quot;;&#xD;
						CodiceEsito = &quot;KO_20&quot;;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//CASO 4 - DUE CODICI RISORSA&#xD;
				else&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 4 - 2 codici risorsa&quot;;&#xD;
					CodiceEsito = &quot;KO_09&quot;;&#xD;
				}&#xD;
			}&#xD;
			//consistenze correlate WLR o VULL + dati condiviso&#xD;
			else if(((String(ConsistenzaFonia.offerta).slice(0, 4) == &quot;VULL&quot; || String(ConsistenzaFonia.offerta).slice(0, 3) == &quot;WLR&quot;))&#xD;
			&amp;&amp; ((String(ConsistenzaDati.offerta).slice(0, 3) == &quot;SHA&quot;)&#xD;
				|| ((ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
					&amp;&amp; FullLoopDati.contains(String(ConsistenzaDati.offerta)))))&#xD;
			{&#xD;
				if (localRequest.codiceRisorsaDonating2 == null || localRequest.codiceRisorsaDonating2 == &quot;&quot;)&#xD;
				{&#xD;
					if(ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
					{&#xD;
						if(localRequest.codificaOLOAGCOM == ConsistenzaDati.codificaOLOAGCOMDonating)&#xD;
						{&#xD;
							if(localRequest.codiceRisorsaDonating == ConsistenzaFonia.IDRisorsa)&#xD;
							{&#xD;
								//donating WLR&#xD;
								if (String(ConsistenzaFonia.offerta).slice(0,3) == &quot;WLR&quot;)&#xD;
								{&#xD;
									ConsistenzaDati.azione = &quot;M&quot;;&#xD;
									ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
									ConsistenzaDati.cowCode = null;&#xD;
									ConsistenzaDati.codiceSessione = null;&#xD;
								}&#xD;
								//donating VULL&#xD;
								else &#xD;
								{&#xD;
									ConsistenzaDati.azione = &quot;D&quot;;&#xD;
									ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
									ConsistenzaDati.cowCode = null;&#xD;
									ConsistenzaDati.codiceSessione = null;&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							EsitoResponse.codice = false;&#xD;
							EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 4.&quot;;&#xD;
							CodiceEsito = &quot;KO_02&quot;;&#xD;
						}&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Offerte non previste per il caso DoppioDonating (ASSET CORRELATO RECUPERATO) - CASO 4.&quot;;&#xD;
						CodiceEsito = &quot;KO_02&quot;;&#xD;
					}&#xD;
				}&#xD;
				// CASO 4 - DUE CODICI RISORSA&#xD;
				else&#xD;
				{&#xD;
					ConsistenzaDati.azione = &quot;D&quot;;&#xD;
					ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
				&#xD;
	}&#xD;
&#xD;
&#xD;
	//---ARRICCHIMENTO LAVORAZIONE RICHIESTA---//&#xD;
	//CASO 1&#xD;
	if(ConsistenzaFonia != null &amp;&amp; (String(localRequest.offerta).slice(0,3) == 'WLR')&#xD;
	&amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEAATTIVA&#xD;
		|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
		|| String(ConsistenzaFonia.offerta).slice(0,4) == 'VULL'))&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | Arricchimento Lavorazione Richiesta, caso 1&quot;);&#xD;
		LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
		LavorazioneRichiesta.tipoLinea = ConsistenzaFonia.tipoLinea;&#xD;
		LavorazioneRichiesta.strutturaLinea = ConsistenzaFonia.strutturaLinea;&#xD;
		LavorazioneRichiesta.bandaServizio = ConsistenzaFonia.bandaServizio; // SM_8415&#xD;
		&#xD;
		if(String(ConsistenzaFonia.offerta).slice(0,4) != 'VULL') // SM_8383 arricchimento STS per WLR RECIPIENT e WLR DONATING&#xD;
		{&#xD;
			// CHECK FLAG MANTENIMENTO STS&#xD;
			var FlagMantenimentoSTS = false;&#xD;
			var z1 = 0;&#xD;
			&#xD;
			while(!FlagMantenimentoSTS &amp;&amp; z1 &lt; localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var componente = localRequest.ordine.dettaglioordine.get(z1);&#xD;
				&#xD;
				if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var z2 = 0;&#xD;
					while(!FlagMantenimentoSTS &amp;&amp; z2 &lt; componente.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var attributo = componente.attributiDettaglioOrdine.get(z2);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMANTENIMENTOSTS &amp;&amp; &#xD;
						   attributo.valoreAttributo == '1')&#xD;
						{&#xD;
							FlagMantenimentoSTS = true;&#xD;
						}&#xD;
					&#xD;
						z2++;&#xD;
					}&#xD;
				}&#xD;
				z1++;&#xD;
			}&#xD;
			&#xD;
			if(FlagMantenimentoSTS)&#xD;
			{&#xD;
				var k1 = 0;&#xD;
				var STSTrovato = false;&#xD;
				var CODICE = false;&#xD;
				var DESCRIZIONE = false;&#xD;
				var CODICEDTU = false;&#xD;
				var STATO = false;&#xD;
				&#xD;
				while(!STSTrovato &amp;&amp; k1 &lt; assetFoniaMig.dettaglioasset.size())&#xD;
				{&#xD;
					var componenteAsset = assetFoniaMig.dettaglioasset.get(k1);&#xD;
					&#xD;
					if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS)&#xD;
					{&#xD;
						STSTrovato = true;&#xD;
						STS = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createSTSType();&#xD;
&#xD;
						var k2 = 0;&#xD;
						&#xD;
						while((!CODICE || !DESCRIZIONE || !CODICEDTU || !STATO) &amp;&amp; k2 &lt; componenteAsset.attributidettaglioasset.size())&#xD;
						{&#xD;
							var attributoAsset = componenteAsset.attributidettaglioasset.get(k2);&#xD;
							&#xD;
							if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE)&#xD;
							{&#xD;
								CODICE = true;&#xD;
								STS.codice = attributoAsset.valoreAttributo;&#xD;
							}&#xD;
							else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONE)&#xD;
							{&#xD;
								DESCRIZIONE = true;&#xD;
								STS.descrizione = attributoAsset.valoreAttributo;&#xD;
							}&#xD;
							else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEDTU)&#xD;
							{&#xD;
								CODICEDTU = true;&#xD;
								STS.codiceDTU = attributoAsset.valoreAttributo;&#xD;
							}								&#xD;
							else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO)&#xD;
							{&#xD;
								STATO = true;&#xD;
								STS.stato = attributoAsset.valoreAttributo;&#xD;
							}&#xD;
							&#xD;
							k2++;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					k1++;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			// SELEZIONEPASSANTE - SM_8475 e SM_8498&#xD;
			var i2 = 0;&#xD;
			while(LavorazioneRichiesta.selezionePassante == null &amp;&amp; i2 &lt; assetFoniaMig.dettaglioasset.size())&#xD;
			{&#xD;
				var componenteAsset = assetFoniaMig.dettaglioasset.get(i2);&#xD;
					&#xD;
				if(String(componenteAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var j2 =0;&#xD;
					while(LavorazioneRichiesta.selezionePassante == null &amp;&amp; j2 &lt;componenteAsset.attributidettaglioasset.size())&#xD;
					{&#xD;
						var attributo = componenteAsset.attributidettaglioasset.get(j2);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SELEZIONEPASSANTE)&#xD;
						{&#xD;
							LavorazioneRichiesta.selezionePassante = attributo.valoreAttributo;&#xD;
						}&#xD;
						j2++;&#xD;
					}&#xD;
				}&#xD;
				i2++;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	// CASO 2&#xD;
	else if(ConsistenzaFonia != null &amp;&amp; (String(localRequest.offerta).slice(0,4) == 'VULL')&#xD;
		&amp;&amp; (String(ConsistenzaFonia.offerta).slice(0,4) == 'VULL'&#xD;
			|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEAATTIVA&#xD;
			|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
			|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLR))&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | Arricchimento Lavorazione Richiesta, caso 2&quot;);&#xD;
		LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
		LavorazioneRichiesta.tipoLinea = ConsistenzaFonia.tipoLinea;&#xD;
		&#xD;
		//STRUTTURALINEA&#xD;
		if (String(ConsistenzaFonia.strutturaLinea).toUpperCase().slice(0, 3) == &quot;BRA&quot;)&#xD;
		{&#xD;
			LavorazioneRichiesta.strutturaLinea = &quot;Simplex&quot;;&#xD;
		}&#xD;
		else &#xD;
		{&#xD;
			LavorazioneRichiesta.strutturaLinea = ConsistenzaFonia.strutturaLinea;&#xD;
		}&#xD;
		&#xD;
		var i=0;&#xD;
		while(LavorazioneRichiesta.codicePiattaforma == null &amp;&amp; i&lt; assetFoniaMig.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetFoniaMig.dettaglioasset.get(i);&#xD;
				&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j=0;&#xD;
				while(LavorazioneRichiesta.codicePiattaforma == null &amp;&amp; j&lt;componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEPIATTAFORMA)&#xD;
					{&#xD;
						LavorazioneRichiesta.codicePiattaforma = attributo.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
	// CASO 3&#xD;
	else if(ConsistenzaDati != null &amp;&amp; (String(localRequest.offerta).slice(0,3) == 'WLR' || String(localRequest.offerta).slice(0,4) == 'VULL')&#xD;
		&amp;&amp;	(String(ConsistenzaDati.offerta).slice(0,9) == 'BITSTREAM'&#xD;
			|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
			|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPBASEPLUS&#xD;
			|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
			|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
			|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPSPECIALPROFILE&#xD;
			|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
			|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
			|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPNGAFTTCAB //RU_697 - SM_8008&#xD;
			|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULAFTTH&#xD;
			|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIVULAFTTH&#xD;
			|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULAFTTCAB))&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | Arricchimento Lavorazione Richiesta, caso 3&quot;);&#xD;
		LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
		LavorazioneRichiesta.tipoLinea = &quot;POTS&quot;;&#xD;
		LavorazioneRichiesta.strutturaLinea = &quot;Simplex&quot;;&#xD;
		if (LavorazioneRichiesta.numeroTelefonico != null &amp;&amp; LavorazioneRichiesta.numeroTelefonico != &quot;&quot;)&#xD;
		{ &#xD;
			LavorazioneRichiesta.numeroTelefonico = localRequest.numeroTelefonico;&#xD;
		}&#xD;
	}&#xD;
	// CASO 4&#xD;
	else if(ConsistenzaFonia != null &amp;&amp; (String(localRequest.offerta).slice(0,3) == 'WLR'&#xD;
			|| String(localRequest.offerta).slice(0,4) == 'VULL')&#xD;
		&amp;&amp;	(ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEANONATTIVA&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEAATTIVA&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEAATTIVANP&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVA&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVANP))&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | Arricchimento Lavorazione Richiesta, caso 4&quot;);&#xD;
		&#xD;
		LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
		&#xD;
		if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.tipoLinea != null)&#xD;
		{&#xD;
			LavorazioneRichiesta.tipoLinea = ConsistenzaFonia.tipoLinea;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			LavorazioneRichiesta.tipoLinea = &quot;POTS&quot;;&#xD;
		}&#xD;
		&#xD;
		if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.strutturaLinea != null)&#xD;
		{&#xD;
			LavorazioneRichiesta.strutturaLinea = ConsistenzaFonia.strutturaLinea;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			LavorazioneRichiesta.strutturaLinea = &quot;Simplex&quot;;&#xD;
		}&#xD;
		&#xD;
		LavorazioneRichiesta.numeroTelefonico = localRequest.numeroTelefonico;&#xD;
	}&#xD;
	// CASO 5&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLU&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULL&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATI&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task DoppioDonating | Arricchimento Lavorazione Richiesta, caso 5&quot;);&#xD;
&#xD;
		var destinazioneUsoRichiesta = &quot;&quot;;&#xD;
		destinazioneUsoRichiesta = null;&#xD;
&#xD;
		var i = 0;&#xD;
		while(destinazioneUsoRichiesta == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(destinazioneUsoRichiesta == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
					{&#xD;
						destinazioneUsoRichiesta = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
&#xD;
		LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
&#xD;
		if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.tipoLinea != null)&#xD;
		{&#xD;
			LavorazioneRichiesta.tipoLinea = ConsistenzaFonia.tipoLinea;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			LavorazioneRichiesta.tipoLinea = &quot;POTS&quot;;&#xD;
		}		&#xD;
&#xD;
		if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.strutturaLinea != null)&#xD;
		{&#xD;
			LavorazioneRichiesta.strutturaLinea = ConsistenzaFonia.strutturaLinea;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			LavorazioneRichiesta.strutturaLinea = &quot;Simplex&quot;;&#xD;
		}		&#xD;
&#xD;
		/*&#xD;
		if(destinazioneUsoRichiesta!=null &amp;&amp; (destinazioneUsoRichiesta == &quot;1&quot; || destinazioneUsoRichiesta.slice(0,2) == &quot;1|&quot;))&#xD;
		{&#xD;
			LavorazioneRichiesta.tipoLinea = &quot;POTS&quot;;&#xD;
		}&#xD;
		else if(destinazioneUsoRichiesta!=null &amp;&amp; (destinazioneUsoRichiesta == &quot;2&quot;&#xD;
				|| destinazioneUsoRichiesta == &quot;3&quot;|| destinazioneUsoRichiesta.slice(0,2) == &quot;2|&quot;|| destinazioneUsoRichiesta.slice(0,2) == &quot;3|&quot;))&#xD;
		{&#xD;
			LavorazioneRichiesta.tipoLinea = &quot;ISDN&quot;;&#xD;
		}&#xD;
&#xD;
		LavorazioneRichiesta.strutturaLinea = &quot;Simplex&quot;;&#xD;
		*/&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | DoppioDonating | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="85.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="129.0">
              <xpdl2:Coordinates XCoordinate="991.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_jnZe8gVWEeqsOP2PgAIa2A" Name="AttivazioneVULLULLSLULNA" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Attivazione VULL/ULL/SLU + LNA">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Creato con RU_918&#xD;
&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: dati insufficienti per eseguire il controllo.&quot;;&#xD;
CodiceEsito = &quot;KO_02&quot;;&#xD;
&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Attivazione VULL/ULL/SLU LNA | Verifica servizio in consistenza VULL/ULL/SLU LNA.&quot;);&#xD;
&#xD;
//--------------------------------------------------ATTIVAZIONE VULL/ULL/SLU LINEA NON ATTIVA--------------------------------------------------//&#xD;
&#xD;
// Recupero IDRisorsaOLD&#xD;
var idRisorsaOLD = &quot;&quot;;&#xD;
idRisorsaOLD = null;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(idRisorsaOLD == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(idRisorsaOLD == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAOLD)&#xD;
				{&#xD;
					idRisorsaOLD = currentAttDettOrdine.valoreAttributo;&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione VULL/ULL/SLU LNA | IDRISORSAOLD: &quot;+idRisorsaOLD);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
var tipoLinea = &quot;&quot;;&#xD;
tipoLinea = null;&#xD;
&#xD;
if(idRisorsaOLD != null)&#xD;
{&#xD;
	if(localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: offerta non in ambito con IDRISORSAOLD: &quot; + idRisorsaOLD;&#xD;
		CodiceEsito = &quot;KO_23&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		//--------------------------------------------------RECUPERA ASSET PER NUMERO IDRISORSA--------------------------------------------------//&#xD;
		var asset = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
		asset = null;	&#xD;
		&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: SearchIDRisorsa AND codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE')&quot;);&#xD;
		criteria.setQueryParameter(&quot;SearchIDRisorsa&quot;, idRisorsaOLD);&#xD;
		criteria.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
		var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
		&#xD;
		&#xD;
		// Più di un asset trovato&#xD;
		if(list != null &amp;&amp; list.size() > 1)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: trovate piu consistenze attive per IDRISORSAOLD: &quot; + idRisorsaOLD;&#xD;
			CodiceEsito = &quot;KO_23&quot;;&#xD;
		}&#xD;
		// Nessun asset trovato&#xD;
		else if(list == null || list.size() == 0)&#xD;
		{&#xD;
			////SM_9114: Ricerca su numero fittizio secondo i criteri descritti&#xD;
			var IdRisorsaMod = &quot;&quot;;&#xD;
			IdRisorsaMod = null;&#xD;
&#xD;
			if(idRisorsaOLD.charAt(1)==&quot;2&quot; || idRisorsaOLD.charAt(1)==&quot;6&quot;)&#xD;
			{&#xD;
				IdRisorsaMod = &quot;0&quot;+idRisorsaOLD;&#xD;
			}&#xD;
			else if(idRisorsaOLD.charAt(2)==&quot;0&quot; || idRisorsaOLD.charAt(2)==&quot;1&quot; || idRisorsaOLD.charAt(2)==&quot;5&quot; || idRisorsaOLD.charAt(2)==&quot;9&quot;)&#xD;
			{&#xD;
				IdRisorsaMod = idRisorsaOLD;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				IdRisorsaMod = idRisorsaOLD.slice(1,idRisorsaOLD.length);&#xD;
			}&#xD;
			&#xD;
			criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;(numeroFittizio =: SearchIdRisorsaMod1 OR numeroFittizio =: SearchIdRisorsaMod2) AND codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE')&quot;); &#xD;
			criteria.setQueryParameter(&quot;SearchIdRisorsaMod1&quot;, IdRisorsaMod);&#xD;
			criteria.setQueryParameter(&quot;SearchIdRisorsaMod2&quot;,idRisorsaOLD);&#xD;
			criteria.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
			&#xD;
			list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
			&#xD;
			if(list != null &amp;&amp; list.size() > 1)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: trovate piu consistenze attive per IDRISORSAOLD: &quot; + idRisorsaOLD;&#xD;
				CodiceEsito = &quot;KO_23&quot;;&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] |CTRL ServizioConsistenza fallito: trovate piu consistenze attive &quot;);&#xD;
			}&#xD;
			//Ricerca su numero telefonico&#xD;
			else if(list == null || list.size() == 0)&#xD;
			{&#xD;
				criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico =: SearchnumeroTelefonico AND codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE')&quot;);&#xD;
				criteria.setQueryParameter(&quot;SearchnumeroTelefonico&quot;,idRisorsaOLD);&#xD;
				criteria.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
				&#xD;
				list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
				&#xD;
				if(list != null &amp;&amp; list.size() > 1)&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: trovate piu consistenze attive per IDRISORSAOLD: &quot; + idRisorsaOLD;&#xD;
					CodiceEsito = &quot;KO_23&quot;;&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] |CTRL ServizioConsistenza fallito: trovate piu consistenze attive &quot;);&#xD;
				}&#xD;
				else if(list == null || list.size() == 0)&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: nessuna consistenza attiva e con OLO &quot;+localRequest.codificaOLOAGCOM+&quot; trovata per IDRISORSAOLD: &quot;+idRisorsaOLD;&#xD;
					CodiceEsito = &quot;KO_23&quot;;&#xD;
				}&#xD;
			}&#xD;
			//SM_9114 end	&#xD;
		}&#xD;
		&#xD;
		if(list != null &amp;&amp; list.size() == 1)&#xD;
		{&#xD;
			AssetRef = list.get(0);&#xD;
			asset = AssetRef.readAsset();&#xD;
			&#xD;
			if(asset.IDRisorsaCorrelato != null)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: trovata consistenza correlata per IDRISORSAOLD: &quot; + idRisorsaOLD;&#xD;
				CodiceEsito = &quot;KO_23&quot;;&#xD;
			}&#xD;
			else&#xD;
			{	&#xD;
				if(asset.dettaglioasset != null)&#xD;
				{&#xD;
					var i = 0;&#xD;
					while(i &lt; asset.dettaglioasset.size())&#xD;
					{&#xD;
						var currentDettAsset = asset.dettaglioasset.get(i);&#xD;
					&#xD;
						if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
						{&#xD;
							var j = 0;&#xD;
							while((tipoLinea == null) &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
							{&#xD;
								var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
							&#xD;
								if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
								{&#xD;
									tipoLinea = currentAttDettAsset.valoreAttributo;&#xD;
									Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione VULL/ULL/SLU LNA | offerta in asset &quot;+asset.offerta+&quot; con tipo linea &quot;+tipoLinea);&#xD;
								}&#xD;
								j++;&#xD;
							}&#xD;
						}&#xD;
						i++;&#xD;
					}&#xD;
				}&#xD;
				//RU_914 rimossa offerta EASYIPNGAFTTCAB.&#xD;
				if(!(asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
				  || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA&#xD;
				  || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA)&#xD;
				&amp;&amp; (!((asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
					|| asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
					//|| asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
					|| asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
					|| asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
					|| asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
					|| asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
					|| asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL&#xD;
					|| asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
					|| asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
					|| asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
					|| asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
					|| asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
					|| asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT) //GBE aggiunti con SM_9123&#xD;
				   &amp;&amp; tipoLinea != null &amp;&amp; tipoLinea.toUpperCase() == &quot;LINEANONFONIA&quot;)))&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: offerta non in ambito &quot;+asset.offerta+&quot;, con tipoLinea: &quot;+tipoLinea;&#xD;
					CodiceEsito = &quot;KO_23&quot;;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					var strutturaLinea = &quot;&quot;;&#xD;
					strutturaLinea = null;&#xD;
					var destUso = &quot;&quot;;&#xD;
					destUso = null;&#xD;
					var bandaServizio = &quot;&quot;;&#xD;
					bandaServizio = null;&#xD;
					&#xD;
					// RECUPERO DATI ASSET&#xD;
					if(asset.dettaglioasset != null)&#xD;
					{&#xD;
						var i = 0;&#xD;
						while(i &lt; asset.dettaglioasset.size())&#xD;
						{&#xD;
							var currentDettAsset = asset.dettaglioasset.get(i);&#xD;
						&#xD;
							if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
							{&#xD;
								var j = 0;&#xD;
								while((strutturaLinea == null || destUso == null || bandaServizio == null) &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
								{&#xD;
									var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
								&#xD;
									if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
									{&#xD;
										strutturaLinea == currentAttDettAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
									{&#xD;
										destUso == currentAttDettAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDASERVIZIO)&#xD;
									{&#xD;
										bandaServizio == currentAttDettAsset.valoreAttributo;&#xD;
									}&#xD;
									j++;&#xD;
								}&#xD;
							}&#xD;
							i++;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					// CONSISTENZA DATI&#xD;
					if(asset.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.DATI)&#xD;
					{&#xD;
						ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();&#xD;
						Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione VULL/ULL/SLU LNA | Creazione componente ConsistenzaDati: &quot;+asset.IDAsset);&#xD;
						&#xD;
						ConsistenzaDati.azione = &quot;D&quot;;&#xD;
						ConsistenzaDati.IDRisorsa = asset.IDRisorsa;&#xD;
						ConsistenzaDati.IDRisorsaNOW = asset.IDRisorsaNOW;&#xD;
						&#xD;
						if(tipoLinea != null &amp;&amp; tipoLinea.toUpperCase() == &quot;LINEANONFONIA&quot;)&#xD;
						{&#xD;
							ConsistenzaDati.flagBTSNaked = 'Y';&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							ConsistenzaDati.flagBTSNaked = 'N';&#xD;
						}&#xD;
						&#xD;
						ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(asset.offerta));&#xD;
						ConsistenzaDati.codificaOLOAGCOMDonating = asset.codificaOLOAGCOM;&#xD;
						ConsistenzaDati.codiceOrdineTI = asset.codiceOrdineTI;&#xD;
						ConsistenzaDati.codiceOrdineOLO = asset.codiceOrdineOLO;&#xD;
						ConsistenzaDati.IDAsset = asset.IDAsset;&#xD;
						ConsistenzaDati.tipoLinea = tipoLinea;&#xD;
						ConsistenzaDati.strutturaLinea = strutturaLinea;&#xD;
						ConsistenzaDati.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(asset.statoAsset));&#xD;
						ConsistenzaDati.numeroTelefonico = asset.numeroTelefonico;&#xD;
						ConsistenzaDati.numeroTelefonicoPrincipale = asset.numTelPrincipale;&#xD;
						ConsistenzaDati.numeroFittizio = asset.numeroFittizio;&#xD;
						ConsistenzaDati.destinazioneUso = destUso;&#xD;
						&#xD;
						//OPERATORERETE - RU_1142&#xD;
						ConsistenzaDati.operatoreRete = asset.operatoreRete;&#xD;
						&#xD;
						ConsistenzaDati.assetBTWhiteList = asset.assetBTWhiteList; //R1E-21-0325&#xD;
						&#xD;
						//R1E-21-0325&#xD;
						if(ConsistenzaDati.assetBTWhiteList != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != &quot;&quot;)&#xD;
						{&#xD;
							localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
						}&#xD;
						&#xD;
						//RU_1275&#xD;
						if(asset.exOperatoreRete != null &amp;&amp; asset.exOperatoreRete != &quot;&quot;)&#xD;
						{&#xD;
							localRequest.exOperatoreRete = asset.exOperatoreRete;&#xD;
							localRequest.ordine.exOperatoreRete = asset.exOperatoreRete;&#xD;
						}&#xD;
						&#xD;
						var TIPOLOGIACLUSTERCOMUNE = false; //RU_964&#xD;
&#xD;
						var i = 0;&#xD;
						var accessoTrovato = false;&#xD;
						while(!accessoTrovato &amp;&amp; i &lt; asset.dettaglioasset.size())&#xD;
						{&#xD;
							var componente = asset.dettaglioasset.get(i);&#xD;
							if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
							{&#xD;
								accessoTrovato = true;&#xD;
								var j = 0;&#xD;
								while((!TIPOLOGIACLUSTERCOMUNE) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
								{&#xD;
									var attributo = componente.attributidettaglioasset.get(j);&#xD;
									&#xD;
									if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE)&#xD;
									{&#xD;
										TIPOLOGIACLUSTERCOMUNE = true;&#xD;
										ConsistenzaDati.tipologiaClusterComune = attributo.valoreAttributo;		&#xD;
									}&#xD;
									&#xD;
									j++;&#xD;
								}&#xD;
							}	&#xD;
							i++;&#xD;
						}						&#xD;
					}&#xD;
					// CONSISTENZA FONIA&#xD;
					else if(asset.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA)&#xD;
					{&#xD;
						ConsistenzaFonia = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFoniaType();&#xD;
						Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione VULL/ULL/SLU LNA | Creazione componente ConsistenzaFonia: &quot;+asset.IDAsset);&#xD;
						&#xD;
						ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
						ConsistenzaFonia.IDRisorsa = asset.IDRisorsa;&#xD;
						ConsistenzaFonia.IDRisorsaNOW = asset.IDRisorsaNOW;&#xD;
						&#xD;
						if(tipoLinea != null &amp;&amp; tipoLinea.toUpperCase() == &quot;LINEANONFONIA&quot;)&#xD;
						{&#xD;
							ConsistenzaFonia.flagBTSNaked = 'Y';&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							ConsistenzaFonia.flagBTSNaked = 'N';&#xD;
						}&#xD;
						&#xD;
						ConsistenzaFonia.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(asset.offerta));&#xD;
						ConsistenzaFonia.codificaOLOAGCOMDonating = asset.codificaOLOAGCOM;&#xD;
						ConsistenzaFonia.codiceOrdineTI = asset.codiceOrdineTI;&#xD;
						ConsistenzaFonia.codiceOrdineOLO = asset.codiceOrdineOLO;&#xD;
						ConsistenzaFonia.IDAsset = asset.IDAsset;&#xD;
						ConsistenzaFonia.tipoLinea = tipoLinea;&#xD;
						ConsistenzaFonia.strutturaLinea = strutturaLinea;&#xD;
						ConsistenzaFonia.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(asset.statoAsset));&#xD;
						ConsistenzaFonia.numeroTelefonico = asset.numeroTelefonico;&#xD;
						ConsistenzaFonia.numeroTelefonicoPrincipale = asset.numTelPrincipale;&#xD;
						ConsistenzaFonia.numeroFittizio = asset.numeroFittizio;&#xD;
						ConsistenzaFonia.destinazioneUso = destUso;&#xD;
						ConsistenzaFonia.bandaServizio = bandaServizio;&#xD;
						&#xD;
						//OPERATORERETE - RU_1142&#xD;
						ConsistenzaFonia.operatoreRete = asset.operatoreRete;&#xD;
						&#xD;
						ConsistenzaFonia.assetBTWhiteList = asset.assetBTWhiteList; //R1E-21-0325&#xD;
						&#xD;
						//R1E-21-0325&#xD;
						if(ConsistenzaFonia.assetBTWhiteList != null &amp;&amp; ConsistenzaFonia.assetBTWhiteList != &quot;&quot;)&#xD;
						{&#xD;
							localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
						}&#xD;
						&#xD;
						var TIPOLOGIACLUSTERCOMUNE = false; //RU_964&#xD;
&#xD;
						var i = 0;&#xD;
						var accessoTrovato = false;&#xD;
						while(!accessoTrovato &amp;&amp; i &lt; asset.dettaglioasset.size())&#xD;
						{&#xD;
							var componente = asset.dettaglioasset.get(i);&#xD;
							if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
							{&#xD;
								accessoTrovato = true;&#xD;
								var j = 0;&#xD;
								while((!TIPOLOGIACLUSTERCOMUNE) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
								{&#xD;
									var attributo = componente.attributidettaglioasset.get(j);&#xD;
									&#xD;
									if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE)&#xD;
									{&#xD;
										TIPOLOGIACLUSTERCOMUNE = true;&#xD;
										ConsistenzaFonia.tipologiaClusterComune = attributo.valoreAttributo;		&#xD;
									}&#xD;
									&#xD;
									j++;&#xD;
								}&#xD;
							}	&#xD;
							i++;&#xD;
						}						&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione VULL/ULL/SLU LNA  | Asset recuperato per IDRisorsa=&quot;+idRisorsaOLD+&quot;, IDAsset=&quot;+asset.IDAsset);&#xD;
		}&#xD;
	}&#xD;
&#xD;
	if(!EsitoResponse.codice)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione VULL/ULL/SLU LNA | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza saltato: IDRisorsaOLD non valorizzato&quot;;&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione VULL/ULL/SLU LNA | &quot;+EsitoResponse.descrizione);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="87.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="172.0">
              <xpdl2:Coordinates XCoordinate="885.0" YCoordinate="603.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_p1kRYgVWEeqsOP2PgAIa2A" Name="AttivazioneBTSVULAEASYIPNKD" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Attivazione BTS /VULA/EASYIP NKD">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Creato con RU_918 &#xD;
&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: dati insufficienti per eseguire il controllo.&quot;;&#xD;
CodiceEsito = &quot;KO_02&quot;;&#xD;
&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Attivazione BTS/VULA/EASYIP NKD | Verifica servizio in consistenza BTS/VULA/EASYIP NKD.&quot;);&#xD;
&#xD;
//--------------------------------------------------ATTIVAZIONE BTS/VULA/EASYIP NAKED--------------------------------------------------//&#xD;
&#xD;
// Recupero IDRisorsaOLD&#xD;
var idRisorsaOLD = &quot;&quot;;&#xD;
idRisorsaOLD = null;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(idRisorsaOLD == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(idRisorsaOLD == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAOLD)&#xD;
				{&#xD;
					idRisorsaOLD = currentAttDettOrdine.valoreAttributo;&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione BTS/VULA/EASYIP NKD | IDRISORSAOLD: &quot;+idRisorsaOLD);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
var tipoLinea = &quot;&quot;;&#xD;
tipoLinea = null;&#xD;
var destinazioneUso = &quot;&quot;;&#xD;
destinazioneUso = null;&#xD;
&#xD;
if(idRisorsaOLD != null)&#xD;
{&#xD;
	//RU_1053 - RU_1109: modificato contenuto degli IF, ora FTTH sono ammesse - ora questo IF probabilmente non ha senso, perché se siamo qui dentro l'offerta è già così&#xD;
	//RU_1263: modificato IF, elimando la verifica sulle FTTH &#xD;
	if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
	      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
	      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB)&#xD;
	    &amp;&amp; localRequest.ordine.tipologiaLinea != it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.LINEANONFONIA)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito. Offerta:&quot; +localRequest.offerta + &quot;e tipologiaLinea:&quot; + localRequest.ordine.tipologiaLinea;&#xD;
		CodiceEsito = &quot;KO_12&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		//--------------------------------------------------RECUPERA ASSET PER NUMERO IDRISORSA--------------------------------------------------//&#xD;
		var asset = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
		asset = null;	&#xD;
		&#xD;
		//SM_9828: escluse offerte NP e CPS&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: SearchIDRisorsa AND codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta NOT IN ('CPS', 'NP')&quot;);&#xD;
		criteria.setQueryParameter(&quot;SearchIDRisorsa&quot;, idRisorsaOLD);&#xD;
		criteria.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
		var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
		&#xD;
		// Più di un asset trovato&#xD;
		if(list != null &amp;&amp; list.size() > 1)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: trovate piu consistenze attive per IDRISORSAOLD: &quot; + idRisorsaOLD;&#xD;
			CodiceEsito = &quot;KO_12&quot;;&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] |CTRL ServizioConsistenza fallito: trovate piu consistenze attive &quot;);&#xD;
		}&#xD;
		// Nessun asset trovato&#xD;
		else if(list == null || list.size() == 0)&#xD;
		{&#xD;
			//SM_9114: Ricerca su numero fittizio secondo i criteri descritti&#xD;
			var IdRisorsaMod = &quot;&quot;;&#xD;
			IdRisorsaMod = null;&#xD;
&#xD;
			if(idRisorsaOLD.charAt(1)==&quot;2&quot; || idRisorsaOLD.charAt(1)==&quot;6&quot;)&#xD;
			{&#xD;
				IdRisorsaMod = &quot;0&quot;+idRisorsaOLD;&#xD;
			}&#xD;
			else if(idRisorsaOLD.charAt(2)==&quot;0&quot; || idRisorsaOLD.charAt(2)==&quot;1&quot; || idRisorsaOLD.charAt(2)==&quot;5&quot; || idRisorsaOLD.charAt(2)==&quot;9&quot;)&#xD;
			{&#xD;
				IdRisorsaMod = idRisorsaOLD;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				IdRisorsaMod = idRisorsaOLD.slice(1,idRisorsaOLD.length);&#xD;
			}&#xD;
			&#xD;
			//SM_9828: escluse offerte NP e CPS&#xD;
			criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;(numeroFittizio =: SearchIdRisorsaMod1 OR numeroFittizio =: SearchIdRisorsaMod2) AND codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta NOT IN ('CPS', 'NP')&quot;); &#xD;
			criteria.setQueryParameter(&quot;SearchIdRisorsaMod1&quot;, IdRisorsaMod);&#xD;
			criteria.setQueryParameter(&quot;SearchIdRisorsaMod2&quot;,idRisorsaOLD);&#xD;
			criteria.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
			&#xD;
			list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
			&#xD;
			if(list != null &amp;&amp; list.size() > 1)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: trovate piu consistenze attive per IDRISORSAOLD: &quot; + idRisorsaOLD;&#xD;
				CodiceEsito = &quot;KO_12&quot;;&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] |CTRL ServizioConsistenza fallito: trovate piu consistenze attive &quot;);&#xD;
			}&#xD;
			//Ricerca su numero telefonico&#xD;
			else if(list == null || list.size() == 0)&#xD;
			{&#xD;
				//SM_9828: escluse offerte NP e CPS&#xD;
				criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico =: SearchnumeroTelefonico AND codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta NOT IN ('CPS', 'NP')&quot;);&#xD;
				criteria.setQueryParameter(&quot;SearchnumeroTelefonico&quot;,idRisorsaOLD);&#xD;
				criteria.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
				&#xD;
				list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
				&#xD;
				if(list != null &amp;&amp; list.size() > 1)&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: trovate piu consistenze attive per IDRISORSAOLD: &quot; + idRisorsaOLD;&#xD;
					CodiceEsito = &quot;KO_12&quot;;&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] |CTRL ServizioConsistenza fallito: trovate piu consistenze attive &quot;);&#xD;
				}&#xD;
				else if(list == null || list.size() == 0)&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: nessuna consistenza attiva e con OLO &quot;+localRequest.codificaOLOAGCOM+&quot; trovata per IDRISORSAOLD: &quot;+idRisorsaOLD;&#xD;
					CodiceEsito = &quot;KO_12&quot;;&#xD;
				}&#xD;
			}&#xD;
			//SM_9114 end	&#xD;
		}&#xD;
		&#xD;
		if(list != null &amp;&amp; list.size() == 1)&#xD;
		{&#xD;
			AssetRef = list.get(0);&#xD;
			asset = AssetRef.readAsset();&#xD;
			&#xD;
			if(asset.dettaglioasset != null)&#xD;
			{&#xD;
				var i = 0;&#xD;
				while(i &lt; asset.dettaglioasset.size())&#xD;
				{&#xD;
					var currentDettAsset = asset.dettaglioasset.get(i);&#xD;
				&#xD;
					if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						var j = 0;&#xD;
						while((tipoLinea == null || destinazioneUso == null) &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
						{&#xD;
							var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
							if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
							{&#xD;
								tipoLinea = currentAttDettAsset.valoreAttributo.toUpperCase();&#xD;
								Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Attivazione BTS/VULA/EASYIP NKD | offerta in asset &quot;+asset.offerta+&quot; con tipo linea &quot;+tipoLinea);&#xD;
							}&#xD;
							else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
							{&#xD;
								destinazioneUso = currentAttDettAsset.valoreAttributo;&#xD;
								Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Attivazione BTS/VULA/EASYIP NKD | offerta in asset &quot;+asset.offerta+&quot; con DU &quot;+destinazioneUso);&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					i++;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//RU_1109: aggiunto IF come da SF&#xD;
			if((asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
			 || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA)&#xD;
			 &amp;&amp; asset.IDRisorsaCorrelato != null&#xD;
			 &amp;&amp; (destinazioneUso == &quot;1&quot; || destinazioneUso == &quot;2&quot; || destinazioneUso == &quot;3&quot;)&#xD;
			 &amp;&amp; asset.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: offerta non in ambito &quot;+asset.offerta+&quot;, con tipoLinea: &quot;+tipoLinea+&quot;, DU: &quot;+destinazioneUso;&#xD;
				CodiceEsito = &quot;KO_12&quot;;&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] |Tipo Linea: &quot;+tipoLinea);&#xD;
			}&#xD;
			//RU_1109: rifatta logica come da anticipazione via Mail (RE: RU_1109), verrà poi inserita sulle SF. TENERE D'OCCHIO per eventuali anomalie.&#xD;
			else if((OfferteFTTH.contains(String(localRequest.offerta)))&#xD;
			 &amp;&amp;&#xD;
			  !(String(asset.offerta).slice(0,9) == &quot;BITSTREAM&quot;&#xD;
			 || String(asset.offerta).slice(0,6) == &quot;EASYIP&quot;&#xD;
			 || String(asset.offerta).slice(0,3) == &quot;ULL&quot;&#xD;
			 || String(asset.offerta).slice(0,3) == &quot;SLU&quot;&#xD;
			 || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
			 || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA      //SM_11620&#xD;
			 || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
			 || ((asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH &#xD;
			         || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
					 || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS) //SM_11620&#xD;
			      &amp;&amp; tipoLinea == &quot;LINEANONFONIA&quot;)&#xD;
			 || (asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB &#xD;
			      &amp;&amp; tipoLinea != null &amp;&amp; tipoLinea.toUpperCase() == &quot;LINEANONFONIA&quot;)))&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: offerta non in ambito &quot;+asset.offerta+&quot;, con tipoLinea: &quot;+tipoLinea;&#xD;
				CodiceEsito = &quot;KO_12&quot;;&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] |Tipo Linea: &quot;+tipoLinea);&#xD;
			}&#xD;
			else if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
				  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
				  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB)&#xD;
			 &amp;&amp;&#xD;
			  !(String(asset.offerta).slice(0,9) == &quot;BITSTREAM&quot;&#xD;
			 || String(asset.offerta).slice(0,6) == &quot;EASYIP&quot;&#xD;
			 || String(asset.offerta).slice(0,3) == &quot;ULL&quot;&#xD;
			 || String(asset.offerta).slice(0,3) == &quot;SLU&quot;&#xD;
			 || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
			 || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
			 || ((asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH &#xD;
			        || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH) &#xD;
			     &amp;&amp; tipoLinea != null &amp;&amp; tipoLinea.toUpperCase() == &quot;LINEANONFONIA&quot;)))&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: offerta non in ambito &quot;+asset.offerta+&quot;, con tipoLinea: &quot;+tipoLinea;&#xD;
				CodiceEsito = &quot;KO_12&quot;;&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] |Tipo Linea: &quot;+tipoLinea);&#xD;
			}&#xD;
			//RU_1543 - aggiunta condizione per offerte FULLGPONPLUS e FULLGPONPLUSNGA&#xD;
			else if((OfferteFTTH.contains(String(asset.offerta))&#xD;
                     ||asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS &#xD;
                     ||asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)				 &#xD;
				     &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
						 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA))&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Offerta nella richiesta: &quot;+String(localRequest.offerta)+&quot;, offerta in consistenza: &quot;+String(asset.offerta);&#xD;
				CodiceEsito = &quot;KO_24&quot;;&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] fallito.&quot; +EsitoResponse.descrizione);&#xD;
			}&#xD;
			//SM_10550 - non ci entriamo mai, inserito solo per allineamento con SF&#xD;
			//RU_1543 - aggiunte offerte FULLGPONPLUS e FULLGPONPLUSNGA&#xD;
			else if((OfferteFTTH.contains(String(asset.offerta))&#xD;
                     ||asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS &#xD;
                     ||asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)				 &#xD;
				     &amp;&amp; (!OfferteFTTH.contains(String(localRequest.offerta))&#xD;
					     &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
						 &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA))&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Offerta nella richiesta: &quot;+String(localRequest.offerta)+&quot;, offerta in consistenza: &quot;+String(asset.offerta);&#xD;
				CodiceEsito = &quot;KO_12&quot;;&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] fallito.&quot; +EsitoResponse.descrizione);&#xD;
			}&#xD;
			//SM_10550 - inserito KO_24, prima scartavamo se la richiesta era SEMI e in asset c'era una qualsiasi FTTH, ora solo se in asset c'è un FTTH non SEMI&#xD;
			else if((asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
				  || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH &#xD;
				  || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH)&#xD;
				  &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
				   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
				   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH))&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Offerta nella richiesta: &quot;+String(localRequest.offerta)+&quot;, offerta in consistenza: &quot;+String(asset.offerta);&#xD;
				CodiceEsito = &quot;KO_24&quot;;&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] fallito.&quot; +EsitoResponse.descrizione);&#xD;
			}&#xD;
			//RU_1558 - logica da fare per agesp disoscurato&#xD;
			else if(FlagOscuramento == &quot;NO&quot;&#xD;
			        &amp;&amp; (asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
					      || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
				          || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
						  || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH 						&#xD;
				          || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
						  || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
						  || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
						  || asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)&#xD;
				    &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
					    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
						|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
				        || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
						|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
				        || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
						|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
						|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA))&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Offerta nella richiesta: &quot;+String(localRequest.offerta)+&quot;, offerta in consistenza: &quot;+String(asset.offerta);&#xD;
				CodiceEsito = &quot;KO_24&quot;;&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] fallito.&quot; +EsitoResponse.descrizione);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				var strutturaLinea = &quot;&quot;;&#xD;
				strutturaLinea = null;&#xD;
				var destUso = &quot;&quot;;&#xD;
				destUso = null;&#xD;
				var bandaServizio = &quot;&quot;;&#xD;
				bandaServizio = null;&#xD;
				var fatturazioneLA = &quot;&quot;;&#xD;
				fatturazioneLA = null;&#xD;
				&#xD;
				// RECUPERO DATI ASSET&#xD;
				if(asset.dettaglioasset != null)&#xD;
				{&#xD;
					var i = 0;&#xD;
					while(i &lt; asset.dettaglioasset.size())&#xD;
					{&#xD;
						var currentDettAsset = asset.dettaglioasset.get(i);&#xD;
					&#xD;
						if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
						{&#xD;
							var j = 0;&#xD;
							// Bug #44151 Aggiunto fatturazioneLA == null e corretto refuso per assegnazione degli attributi&#xD;
							while((strutturaLinea == null || destUso == null || bandaServizio == null || fatturazioneLA == null) &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
							{&#xD;
								var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
							&#xD;
								if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
								{&#xD;
									strutturaLinea = currentAttDettAsset.valoreAttributo;&#xD;
								}&#xD;
								else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
								{&#xD;
									destUso = currentAttDettAsset.valoreAttributo;&#xD;
								}&#xD;
								else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDASERVIZIO)&#xD;
								{&#xD;
									bandaServizio = currentAttDettAsset.valoreAttributo;&#xD;
								}&#xD;
								else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURAZIONELA)&#xD;
								{&#xD;
									fatturazioneLA = currentAttDettAsset.valoreAttributo;&#xD;
								}&#xD;
								j++;&#xD;
							}&#xD;
						}&#xD;
						i++;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				&#xD;
				//RU_1109: CASO IN CUI METTERE L'AZIONE A T DELLA CONSISTENZA&#xD;
				//RU_1269: aggiunta condizione sull'offerta dell'asset e spostato tutto l'if qui&#xD;
				var IndottaCAMBIOTECNOLOGIA = false;&#xD;
&#xD;
				if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
				   &amp;&amp; (OfferteFTTH.contains(String(localRequest.offerta))&#xD;
				       ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS      //SM_11643&#xD;
					   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)&#xD;
				   &amp;&amp; idRisorsaOLD != null&#xD;
				   &amp;&amp; !(OfferteFTTH.contains(String(asset.offerta)))&#xD;
				   &amp;&amp; asset.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
				   &amp;&amp; asset.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)    &#xD;
				{&#xD;
					IndottaCAMBIOTECNOLOGIA = true;&#xD;
				}&#xD;
				//-----------------------------------------------------------&#xD;
&#xD;
				&#xD;
				// CONSISTENZA DATI&#xD;
				if(asset.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.DATI)&#xD;
				{&#xD;
					ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Attivazione BTS/VULA/EASYIP NKD | Creazione componente ConsistenzaDati: &quot;+asset.IDAsset);&#xD;
					&#xD;
					//RU_1109&#xD;
					if(IndottaCAMBIOTECNOLOGIA)&#xD;
					{&#xD;
						ConsistenzaDati.azione = &quot;T&quot;;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						ConsistenzaDati.azione = &quot;D&quot;;&#xD;
					}&#xD;
					&#xD;
					ConsistenzaDati.IDRisorsa = asset.IDRisorsa;&#xD;
					ConsistenzaDati.IDRisorsaNOW = asset.IDRisorsaNOW;&#xD;
					&#xD;
					if(tipoLinea != null &amp;&amp; tipoLinea.toUpperCase() == &quot;LINEANONFONIA&quot;)&#xD;
					{&#xD;
						ConsistenzaDati.flagBTSNaked = 'Y';&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						ConsistenzaDati.flagBTSNaked = 'N';&#xD;
					}&#xD;
					&#xD;
					ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(asset.offerta));&#xD;
					ConsistenzaDati.codificaOLOAGCOMDonating = asset.codificaOLOAGCOM;&#xD;
					ConsistenzaDati.codiceOrdineTI = asset.codiceOrdineTI;&#xD;
					ConsistenzaDati.codiceOrdineOLO = asset.codiceOrdineOLO;&#xD;
					ConsistenzaDati.IDAsset = asset.IDAsset;&#xD;
					ConsistenzaDati.tipoLinea = tipoLinea;&#xD;
					ConsistenzaDati.strutturaLinea = strutturaLinea;&#xD;
					ConsistenzaDati.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(asset.statoAsset));&#xD;
					ConsistenzaDati.numeroTelefonico = asset.numeroTelefonico;&#xD;
					ConsistenzaDati.numeroTelefonicoPrincipale = asset.numTelPrincipale;&#xD;
					ConsistenzaDati.numeroFittizio = asset.numeroFittizio;&#xD;
					ConsistenzaDati.destinazioneUso = destUso;&#xD;
					&#xD;
					//OPERATORERETE - RU_1142&#xD;
					ConsistenzaDati.operatoreRete = asset.operatoreRete;&#xD;
					&#xD;
					ConsistenzaDati.assetBTWhiteList = asset.assetBTWhiteList; //R1E-21-0325&#xD;
					&#xD;
					//R1E-21-0325&#xD;
					if(ConsistenzaDati.assetBTWhiteList != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != &quot;&quot;)&#xD;
					{&#xD;
						localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
					}&#xD;
					&#xD;
					//RU_1275&#xD;
					if(asset.exOperatoreRete != null &amp;&amp; asset.exOperatoreRete != &quot;&quot;)&#xD;
					{&#xD;
						localRequest.exOperatoreRete = asset.exOperatoreRete;&#xD;
						localRequest.ordine.exOperatoreRete = asset.exOperatoreRete;&#xD;
					}&#xD;
					&#xD;
					var TIPOLOGIACLUSTERCOMUNE = false; //RU_964&#xD;
					var OPERATORERETE = false; 			//RU_1142&#xD;
					var SEMIFIBRAFTTH = false; &#xD;
					var IDRETESECONDARIAOAO = false; &#xD;
					var USERVLAN1TAGGING = false;      //Bug #36996&#xD;
					var ROEFFIB = false;   //RU_1275&#xD;
					var CARATTERIZZAZIONEGEO = false;   //SM_11028&#xD;
					&#xD;
					var i = 0;&#xD;
					var accessoTrovato = false;&#xD;
					while(!accessoTrovato &amp;&amp; i &lt; asset.dettaglioasset.size())&#xD;
					{&#xD;
						var componente = asset.dettaglioasset.get(i);&#xD;
						if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
						{&#xD;
							accessoTrovato = true;&#xD;
							var j = 0;&#xD;
							while((!TIPOLOGIACLUSTERCOMUNE || !OPERATORERETE || !SEMIFIBRAFTTH || !IDRETESECONDARIAOAO || !USERVLAN1TAGGING || !ROEFFIB || !CARATTERIZZAZIONEGEO) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
							{&#xD;
								var attributo = componente.attributidettaglioasset.get(j);&#xD;
								&#xD;
								if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE)&#xD;
								{&#xD;
									TIPOLOGIACLUSTERCOMUNE = true;&#xD;
									ConsistenzaDati.tipologiaClusterComune = attributo.valoreAttributo;		&#xD;
								}&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPERATORERETE)&#xD;
								{&#xD;
									OPERATORERETE = true;&#xD;
									ConsistenzaDati.operatoreRete = attributo.valoreAttributo;		&#xD;
								}&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SEMIFIBRAFTTH)&#xD;
								{&#xD;
									SEMIFIBRAFTTH = true;&#xD;
									ConsistenzaDati.semiFibraFTTH = attributo.valoreAttributo;		&#xD;
								}&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRETESECONDARIAOAO)&#xD;
								{&#xD;
									IDRETESECONDARIAOAO = true;&#xD;
									ConsistenzaDati.IDReteSecondariaOAO = attributo.valoreAttributo;		&#xD;
								}&#xD;
								//Bug #36996&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING)&#xD;
								{&#xD;
									USERVLAN1TAGGING = true;&#xD;
									ConsistenzaDati.uservlan1Tagging = attributo.valoreAttributo;		&#xD;
								}&#xD;
								//RU_1275&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROEFFIB)&#xD;
								{&#xD;
									ROEFFIB = true;&#xD;
									ConsistenzaDati.roeFFIB = attributo.valoreAttributo;		&#xD;
								}&#xD;
								//SM_11028&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO)&#xD;
								{&#xD;
									CARATTERIZZAZIONEGEO = true;&#xD;
									ConsistenzaDati.caratterizzazioneGEO = attributo.valoreAttributo;		&#xD;
								}&#xD;
								&#xD;
								j++;&#xD;
							}&#xD;
						}	&#xD;
						i++;&#xD;
					}							&#xD;
				}&#xD;
				// CONSISTENZA FONIA&#xD;
				else if(asset.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA)&#xD;
				{&#xD;
					ConsistenzaFonia = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFoniaType();&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Attivazione BTS/VULA/EASYIP NKD | Creazione componente ConsistenzaFonia: &quot;+asset.IDAsset);&#xD;
					&#xD;
					//RU_1109&#xD;
					if(IndottaCAMBIOTECNOLOGIA)&#xD;
					{&#xD;
						ConsistenzaFonia.azione = &quot;T&quot;;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
					}&#xD;
&#xD;
					ConsistenzaFonia.IDRisorsa = asset.IDRisorsa;&#xD;
					ConsistenzaFonia.IDRisorsaNOW = asset.IDRisorsaNOW;&#xD;
					&#xD;
					if(tipoLinea != null &amp;&amp; tipoLinea.toUpperCase() == &quot;LINEANONFONIA&quot;)&#xD;
					{&#xD;
						ConsistenzaFonia.flagBTSNaked = 'Y';&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						ConsistenzaFonia.flagBTSNaked = 'N';&#xD;
					}&#xD;
					&#xD;
					ConsistenzaFonia.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(asset.offerta));&#xD;
					ConsistenzaFonia.codificaOLOAGCOMDonating = asset.codificaOLOAGCOM;&#xD;
					ConsistenzaFonia.codiceOrdineTI = asset.codiceOrdineTI;&#xD;
					ConsistenzaFonia.codiceOrdineOLO = asset.codiceOrdineOLO;&#xD;
					ConsistenzaFonia.IDAsset = asset.IDAsset;&#xD;
					ConsistenzaFonia.tipoLinea = tipoLinea;&#xD;
					ConsistenzaFonia.strutturaLinea = strutturaLinea;&#xD;
					ConsistenzaFonia.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(asset.statoAsset));&#xD;
					ConsistenzaFonia.numeroTelefonico = asset.numeroTelefonico;&#xD;
					ConsistenzaFonia.numeroTelefonicoPrincipale = asset.numTelPrincipale;&#xD;
					ConsistenzaFonia.numeroFittizio = asset.numeroFittizio;&#xD;
					ConsistenzaFonia.destinazioneUso = destUso;&#xD;
					ConsistenzaFonia.bandaServizio = bandaServizio;&#xD;
					ConsistenzaFonia.fatturazioneLA = fatturazioneLA;&#xD;
					&#xD;
					//OPERATORERETE - RU_1142&#xD;
					ConsistenzaFonia.operatoreRete = asset.operatoreRete;&#xD;
					&#xD;
					ConsistenzaFonia.assetBTWhiteList = asset.assetBTWhiteList; //R1E-21-0325&#xD;
					&#xD;
					//R1E-21-0325&#xD;
					if(ConsistenzaFonia.assetBTWhiteList != null &amp;&amp; ConsistenzaFonia.assetBTWhiteList != &quot;&quot;)&#xD;
					{&#xD;
						localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
					}&#xD;
					&#xD;
					var TIPOLOGIACLUSTERCOMUNE = false; //RU_964&#xD;
					var OPERATORERETE = false; 			//RU_1142&#xD;
&#xD;
					var i = 0;&#xD;
					var accessoTrovato = false;&#xD;
					while(!accessoTrovato &amp;&amp; i &lt; asset.dettaglioasset.size())&#xD;
					{&#xD;
						var componente = asset.dettaglioasset.get(i);&#xD;
						if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
						{&#xD;
							accessoTrovato = true;&#xD;
							var j = 0;&#xD;
							while((!TIPOLOGIACLUSTERCOMUNE || !OPERATORERETE) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
							{&#xD;
								var attributo = componente.attributidettaglioasset.get(j);&#xD;
								&#xD;
								if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE)&#xD;
								{&#xD;
									TIPOLOGIACLUSTERCOMUNE = true;&#xD;
									ConsistenzaFonia.tipologiaClusterComune = attributo.valoreAttributo;		&#xD;
								}&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPERATORERETE)&#xD;
								{&#xD;
									OPERATORERETE = true;&#xD;
									ConsistenzaFonia.operatoreRete = attributo.valoreAttributo;		&#xD;
								}&#xD;
								&#xD;
								j++;&#xD;
							}&#xD;
						}	&#xD;
						i++;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Attivazione BTS/VULA/EASYIP NKD  | Asset recuperato per IDRisorsa=&quot;+idRisorsaOLD+&quot;, IDAsset=&quot;+asset.IDAsset);&#xD;
		}&#xD;
	}&#xD;
&#xD;
	if(!EsitoResponse.codice)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task BTS/VULA/EASYIP NKD | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza saltato: IDRisorsaOLD non valorizzato&quot;;&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione VULL/ULL/SLU LNA | &quot;+EsitoResponse.descrizione);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="88.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="166.0">
              <xpdl2:Coordinates XCoordinate="885.0" YCoordinate="728.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_bMbXAB_fEeqXuus3WsJtbw" Name="AttivazioneCPS" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Attivazione CPS" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">// Aggiunto con RU_915&#xD;
&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
&#xD;
var assetFonia = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetFonia = null;&#xD;
var assetDati = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetDati = null;&#xD;
var assetCPS = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetCPS = null;&#xD;
&#xD;
var asset1 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset1 = null;&#xD;
&#xD;
var LogString = &quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione CPS | &quot;;&#xD;
&#xD;
Log.write(LogString+&quot;Verifica servizio in consistenza Attivazione CPS&quot;);&#xD;
&#xD;
//--------------------------------------------------RECUPERO ASSET-------------------------------------------------//&#xD;
&#xD;
if(localRequest.numeroTelefonico != null &amp;&amp; localRequest.numeroTelefonico != &quot;&quot;)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND offerta &lt;> 'CPS'&quot;);&#xD;
	c.setQueryParameter(&quot;idr&quot;, localRequest.numeroTelefonico);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		Log.write(LogString+&quot;Recuperato per IDRisorsa Asset: &quot;+String(asset1.IDAsset));&#xD;
	}&#xD;
	&#xD;
	if(asset1 != null &#xD;
	&amp;&amp;(asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
	|| String(asset1.offerta).slice(0,4) == &quot;VULL&quot;&#xD;
	|| String(asset1.offerta).slice(0,3) == &quot;WLR&quot;&#xD;
	|| String(asset1.offerta).slice(0,3) == &quot;WLR&quot;&#xD;
	|| asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
	|| asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
	|| asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
	|| asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
	|| asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP))&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: è stato recuperato un fonia con offerta: &quot;+asset1.offerta;&#xD;
		CodiceEsito = &quot;KO_25&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		var c2 = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND offerta = 'CPS'&quot;);&#xD;
		c2.setQueryParameter(&quot;idr&quot;, localRequest.numeroTelefonico);&#xD;
		var result2 = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c2);&#xD;
		&#xD;
		if(result2 != null &amp;&amp; result2.size()>1)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: è stato recuperato più di un asset per DN: &quot;+localRequest.numeroTelefonico;&#xD;
			CodiceEsito = &quot;KO_01&quot;; // PER MANDARLO IN LAV HD&#xD;
		}&#xD;
		else if(result2 != null &amp;&amp; result2.size()>0)&#xD;
		{&#xD;
			AssetRef = result2.get(0);&#xD;
			assetCPS = ScriptUtil.copy(AssetRef.readAsset());&#xD;
			Log.write(LogString+&quot;Recuperato per IDRisorsa Asset: &quot;+String(assetCPS.IDAsset));			&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(assetCPS != null)&#xD;
	{	&#xD;
		Log.write(LogString+&quot;Creazione componente Consistenza CPS: &quot;+String(assetCPS.IDAsset));&#xD;
		&#xD;
		ConsistenzaCPStemp = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaCPSType();&#xD;
		&#xD;
		ConsistenzaCPStemp.azione = &quot;D&quot;;&#xD;
		&#xD;
		ConsistenzaCPStemp.IDRisorsa = assetCPS.IDRisorsa;&#xD;
&#xD;
		ConsistenzaCPStemp.IDRisorsaNOW = assetCPS.IDRisorsaNOW;&#xD;
&#xD;
		ConsistenzaCPStemp.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetCPS.offerta));&#xD;
		&#xD;
		ConsistenzaCPStemp.codificaOLOAGCOMDonating = assetCPS.codificaOLOAGCOM;&#xD;
		&#xD;
		ConsistenzaCPStemp.codiceOrdineTI = assetCPS.codiceOrdineTI;&#xD;
&#xD;
		ConsistenzaCPStemp.codiceOrdineOLO = assetCPS.codiceOrdineOLO;&#xD;
&#xD;
		ConsistenzaCPStemp.IDAsset = assetCPS.IDAsset;&#xD;
&#xD;
		ConsistenzaCPStemp.numeroTelefonico = assetCPS.numeroTelefonico;&#xD;
&#xD;
		ConsistenzaCPStemp.numeroTelefonicoPrincipale = assetCPS.numTelPrincipale;&#xD;
&#xD;
		ConsistenzaCPStemp.numeroFittizio = assetCPS.numeroFittizio;&#xD;
		&#xD;
		ConsistenzaCPStemp.assetBTWhiteList = assetCPS.assetBTWhiteList; //R1E-21-0325&#xD;
		&#xD;
		//R1E-21-0325&#xD;
		if(ConsistenzaCPStemp.assetBTWhiteList != null &amp;&amp; ConsistenzaCPStemp.assetBTWhiteList != &quot;&quot;)&#xD;
		{&#xD;
			localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
		}&#xD;
		&#xD;
		var OPZIONETRAFFICO = false;&#xD;
		var TIPODNREALE = false;&#xD;
		var TIPOLINEAREALE = false;&#xD;
		var QUANTITALINEE = false;&#xD;
		var DNPRIMARIO = false;&#xD;
		var DSC = false;&#xD;
		&#xD;
		var i = 0;&#xD;
		&#xD;
		var accessoTrovato = false;&#xD;
		&#xD;
		// Recupero Dati dall'asset&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; assetCPS.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetCPS.dettaglioasset.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				while((!OPZIONETRAFFICO || !TIPODNREALE || !TIPOLINEAREALE || !QUANTITALINEE || !DNPRIMARIO ||!DSC) &#xD;
					&amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO)&#xD;
					{&#xD;
						OPZIONETRAFFICO = true;&#xD;
						ConsistenzaCPStemp.opzioneTraffico = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNREALE)&#xD;
					{&#xD;
						TIPODNREALE = true;&#xD;
						ConsistenzaCPStemp.tipoDnReale = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAREALE)&#xD;
					{&#xD;
						TIPOLINEAREALE = true;&#xD;
						ConsistenzaCPStemp.tipoLineaReale = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITALINEE)&#xD;
					{&#xD;
						QUANTITALINEE = true;&#xD;
						ConsistenzaCPStemp.quantitaLinee = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DNPRIMARIO)&#xD;
					{&#xD;
						DNPRIMARIO = true;&#xD;
						ConsistenzaCPStemp.dnPrimario = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC)&#xD;
					{&#xD;
						DSC = true;&#xD;
						ConsistenzaCPStemp.dsc = attributo.valoreAttributo;&#xD;
					}&#xD;
&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		ConsistenzaCPStemp.invioADtu = 'N';&#xD;
		&#xD;
		// Recupero Dati dalla richiesta&#xD;
		accessoTrovato = false;&#xD;
		DSC = false;&#xD;
		OPZIONETRAFFICO = false;&#xD;
		&#xD;
		var DSCAccesso = &quot;&quot;;&#xD;
		DSCAccesso = null;&#xD;
		var OpzioneTrafficoAccesso = &quot;&quot;;&#xD;
		OpzioneTrafficoAccesso = null;&#xD;
		&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				while((!DSC || !OPZIONETRAFFICO) &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC)&#xD;
					{&#xD;
						DSC = true;&#xD;
						DSCAccesso = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO)&#xD;
					{&#xD;
						OPZIONETRAFFICO = true;&#xD;
						OpzioneTrafficoAccesso = attributo.valoreAttributo;&#xD;
					}&#xD;
&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		&#xD;
		if(ConsistenzaCPStemp.dsc != null &amp;&amp; ConsistenzaCPStemp.dsc != &quot;&quot; &amp;&amp; DSCAccesso != null &amp;&amp; DSCAccesso != &quot;&quot;)&#xD;
		{&#xD;
			var DSCAsset = DateTimeUtil.createDatetime(ConsistenzaCPStemp.dsc);&#xD;
			var DSCRic = DateTimeUtil.createDatetime(DSCAccesso);&#xD;
			&#xD;
			if(!(DSCRic>DSCAsset))&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: DSC Retroattiva, DSCAsset: &quot;+DSCAsset+&quot;, DSCRic: &quot;+DSCRic;&#xD;
				CodiceEsito = &quot;KO_26&quot;;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(ConsistenzaCPStemp.opzioneTraffico != null &amp;&amp; ConsistenzaCPStemp.opzioneTraffico != &quot;&quot; &amp;&amp; OpzioneTrafficoAccesso != null &amp;&amp; OpzioneTrafficoAccesso != &quot;&quot; &#xD;
		&amp;&amp; assetCPS.codificaOLOAGCOM == localRequest.codificaOLOAGCOM &amp;&amp; OpzioneTrafficoAccesso != ConsistenzaCPStemp.opzioneTraffico)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Opzione traffico non valida, OpzioneTrafficoAccesso: &quot;+OpzioneTrafficoAccesso+&quot;, OpzioneTrafficoConsistenza: &quot;+ConsistenzaCPStemp.opzioneTraffico;&#xD;
			CodiceEsito = &quot;KO_27&quot;;&#xD;
		}&#xD;
		&#xD;
		ConsistenzaCPS.add(ConsistenzaCPStemp); //SM_9676: ConsistenzaCPS ora è un array, ma in attivazione l'asset CPS è sempre singolo&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(LogString+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="78.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="176.0">
              <xpdl2:Coordinates XCoordinate="887.0" YCoordinate="373.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_iUPRwB_gEeqXuus3WsJtbw" Name="CessazioneCPS" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Cessazione CPS" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">// Aggiunto con RU_915&#xD;
&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
&#xD;
var assetFonia = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetFonia = null;&#xD;
var assetDati = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetDati = null;&#xD;
var assetCPS = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetCPS = null;&#xD;
&#xD;
var asset1 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset1 = null;&#xD;
&#xD;
var LogString = &quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione CPS | &quot;;&#xD;
&#xD;
Log.write(LogString+&quot;Verifica servizio in consistenza Cessazione CPS&quot;);&#xD;
&#xD;
//--------------------------------------------------RECUPERO ASSET-------------------------------------------------//&#xD;
&#xD;
if(localRequest.IDRisorsa != null &amp;&amp; localRequest.IDRisorsa != &quot;&quot;)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND offerta = 'CPS'&quot;);&#xD;
	c.setQueryParameter(&quot;idr&quot;, localRequest.IDRisorsa);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size() == 1)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		assetCPS = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		Log.write(LogString+&quot;Recuperato per IDRisorsa Asset: &quot;+String(assetCPS.IDAsset));&#xD;
	}&#xD;
	&#xD;
	//RU_975: introdotta verifica sulla presenza di CodiceOloCess&#xD;
	//SM_9638: eliminata verifica sulla presenza di CodiceOloCess e introdotto KO_31 (per LAVHD)&#xD;
	else if(result != null &amp;&amp; result.size() > 1)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: sono stati recuperati più risultati di Consistenza aventi DN: &quot;+localRequest.numeroTelefonico;&#xD;
		CodiceEsito = &quot;KO_31&quot;;	&#xD;
	}&#xD;
	&#xD;
	//SM_9638: spostato if qua (stava dopo l'if su assetCPS != null) &#xD;
	else //nessun risultato&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: non è stata recuperata nessuna consistenza CPS avente DN: &quot;+localRequest.numeroTelefonico;&#xD;
		CodiceEsito = &quot;KO_29&quot;;&#xD;
	}&#xD;
	&#xD;
	&#xD;
	if(assetCPS != null)&#xD;
	{&#xD;
		// ---- CONSISTENZA CPS ----&#xD;
		Log.write(LogString+&quot;Creazione componente Consistenza CPS: &quot;+String(assetCPS.IDAsset));&#xD;
		&#xD;
		ConsistenzaCPStemp = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaCPSType();&#xD;
		&#xD;
		ConsistenzaCPStemp.azione = &quot;D&quot;;&#xD;
		&#xD;
		ConsistenzaCPStemp.IDRisorsa = assetCPS.IDRisorsa;&#xD;
&#xD;
		ConsistenzaCPStemp.IDRisorsaNOW = assetCPS.IDRisorsaNOW;&#xD;
&#xD;
		ConsistenzaCPStemp.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetCPS.offerta));&#xD;
		&#xD;
		ConsistenzaCPStemp.codificaOLOAGCOMDonating = assetCPS.codificaOLOAGCOM;&#xD;
		&#xD;
		ConsistenzaCPStemp.codiceOrdineTI = assetCPS.codiceOrdineTI;&#xD;
&#xD;
		ConsistenzaCPStemp.codiceOrdineOLO = assetCPS.codiceOrdineOLO;&#xD;
&#xD;
		ConsistenzaCPStemp.IDAsset = assetCPS.IDAsset;&#xD;
&#xD;
		ConsistenzaCPStemp.numeroTelefonico = assetCPS.numeroTelefonico;&#xD;
&#xD;
		ConsistenzaCPStemp.numeroTelefonicoPrincipale = assetCPS.numTelPrincipale;&#xD;
&#xD;
		ConsistenzaCPStemp.numeroFittizio = assetCPS.numeroFittizio;&#xD;
		&#xD;
		ConsistenzaCPStemp.assetBTWhiteList = assetCPS.assetBTWhiteList; //R1E-21-0325&#xD;
		&#xD;
		//R1E-21-0325&#xD;
		if(ConsistenzaCPStemp.assetBTWhiteList != null &amp;&amp; ConsistenzaCPStemp.assetBTWhiteList != &quot;&quot;)&#xD;
		{&#xD;
			localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
		}&#xD;
		&#xD;
		var OPZIONETRAFFICO = false;&#xD;
		var TIPODNREALE = false;&#xD;
		var TIPOLINEAREALE = false;&#xD;
		var QUANTITALINEE = false;&#xD;
		var DNPRIMARIO = false;&#xD;
		var DSC = false;&#xD;
		&#xD;
		var i = 0;&#xD;
		&#xD;
		var accessoTrovato = false;&#xD;
		&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; assetCPS.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetCPS.dettaglioasset.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				while((!OPZIONETRAFFICO || !TIPODNREALE || !TIPOLINEAREALE || !QUANTITALINEE || !DNPRIMARIO ||!DSC) &#xD;
					&amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO)&#xD;
					{&#xD;
						OPZIONETRAFFICO = true;&#xD;
						ConsistenzaCPStemp.opzioneTraffico = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODNREALE)&#xD;
					{&#xD;
						TIPODNREALE = true;&#xD;
						ConsistenzaCPStemp.tipoDnReale = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAREALE)&#xD;
					{&#xD;
						TIPOLINEAREALE = true;&#xD;
						ConsistenzaCPStemp.tipoLineaReale = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITALINEE)&#xD;
					{&#xD;
						QUANTITALINEE = true;&#xD;
						ConsistenzaCPStemp.quantitaLinee = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DNPRIMARIO)&#xD;
					{&#xD;
						DNPRIMARIO = true;&#xD;
						ConsistenzaCPStemp.dnPrimario = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC)&#xD;
					{&#xD;
						DSC = true;&#xD;
						ConsistenzaCPStemp.dsc = attributo.valoreAttributo;&#xD;
					}&#xD;
&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		ConsistenzaCPStemp.invioADtu = 'N';&#xD;
		&#xD;
		&#xD;
		//SM_9345: per RIENTROCPS il test deve essere fatto con CODICEOLOCESS&#xD;
		if(localRequest.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
		{&#xD;
			//SM_9463: da non fare se canale richiesta = SDR&#xD;
			if(localRequest.canaleRichiesta != it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR)&#xD;
			{&#xD;
				CodiceOloCess = null;&#xD;
				var foundCodiceOloCess = false;&#xD;
				var k=0;&#xD;
&#xD;
				while(!foundCodiceOloCess &amp;&amp; k&lt;localRequest.ordine.dettaglioordine.size())&#xD;
				{&#xD;
					var componente = localRequest.ordine.dettaglioordine.get(k);&#xD;
					&#xD;
					if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
					{&#xD;
						var j=0; &#xD;
						&#xD;
						while(!foundCodiceOloCess &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
						{&#xD;
							var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
							&#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOLOCESS)&#xD;
							{&#xD;
								foundCodiceOloCess = true;&#xD;
								CodiceOloCess = attributo.valoreAttributo;&#xD;
								&#xD;
								Process.auditLog(&quot;Trovato attributo CODICEOLOCESS &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					k++;	&#xD;
				}&#xD;
				&#xD;
				//SCARTO NON DEFINITIVO, VEDI OLO ACCORPANTE&#xD;
				if(assetCPS.codificaOLOAGCOM != CodiceOloCess)&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Codice OLO richiesta diverso dal codice OLO della CPS in consistenza. SCARTO NON DEFINITIVO (vedi olo accorpante)&quot;;&#xD;
					CodiceEsito = &quot;KO_28&quot;;&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				Process.auditLog(&quot;Cessazione CPS con codificaOLOAGCOM TLC e canaleRichiesta:&quot; + localRequest.canaleRichiesta);&#xD;
			}	&#xD;
		}&#xD;
		//solito&#xD;
		else if(assetCPS.codificaOLOAGCOM != localRequest.codificaOLOAGCOM)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Codice OLO richiesta diverso dal codice OLO della CPS in consistenza. SCARTO NON DEFINITIVO (vedi olo accorpante)&quot;;&#xD;
			CodiceEsito = &quot;KO_28&quot;;&#xD;
		}&#xD;
		&#xD;
		ConsistenzaCPS.add(ConsistenzaCPStemp); //SM_9676: ConsistenzaCPS ora è un array, ma in attivazione l'asset CPS è sempre singolo&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(LogString+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="97.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="176.0">
              <xpdl2:Coordinates XCoordinate="889.0" YCoordinate="1641.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_PxGSkCDkEequ2uMSdR3yEw" Name="CheckConsistenzaCPS" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Check Consistenza CPS">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">// RU_915 - Qui viene replicata la logica di scarto in ATTIVAZIONE CPS e CESSAZIONE CPS, dopo il recupero (eventuale) dell'olo accorpante&#xD;
ConsistenzaCPStemp = null;&#xD;
&#xD;
if(ConsistenzaCPS!=null &amp;&amp; ConsistenzaCPS.size()>0) //SM_9676: ConsistenzaCPS è diventato un array, ma viene preso solo il primo elemento dell'array in questo caso, poiché tanto in Attivazione/Cessazione la consistenzaCPS è unica.&#xD;
{&#xD;
	ConsistenzaCPStemp = ScriptUtil.copy(ConsistenzaCPS.get(0));&#xD;
}&#xD;
&#xD;
if(ConsistenzaCPStemp!=null &amp;&amp; ConsistenzaCPStemp.codificaOLOAGCOMDonating!=null &amp;&amp; ConsistenzaCPStemp.codificaOLOAGCOMDonating!=&quot;&quot;&#xD;
&amp;&amp;(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
{&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
	{&#xD;
		var accessoTrovato = false;&#xD;
		var OPZIONETRAFFICO = false;&#xD;
		var OpzioneTrafficoAccesso = &quot;&quot;;&#xD;
		OpzioneTrafficoAccesso = null;&#xD;
		var i = 0;&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				while((!OPZIONETRAFFICO) &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO)&#xD;
					{&#xD;
						OPZIONETRAFFICO = true;&#xD;
						OpzioneTrafficoAccesso = attributo.valoreAttributo;&#xD;
					}&#xD;
&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
&#xD;
		if(ConsistenzaCPStemp.opzioneTraffico != null &amp;&amp; ConsistenzaCPStemp.opzioneTraffico != &quot;&quot; &amp;&amp; OpzioneTrafficoAccesso != null &amp;&amp; OpzioneTrafficoAccesso != &quot;&quot; &#xD;
		&amp;&amp; ConsistenzaCPStemp.codificaOLOAGCOMDonating == localRequest.codificaOLOAGCOM &amp;&amp; OpzioneTrafficoAccesso != ConsistenzaCPStemp.opzioneTraffico)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Opzione traffico non valida, OpzioneTrafficoAccesso: &quot;+OpzioneTrafficoAccesso+&quot;, OpzioneTrafficoConsistenza: &quot;+ConsistenzaCPStemp.opzioneTraffico;&#xD;
			CodiceEsito = &quot;KO_27&quot;;&#xD;
			Log.write(&quot;Check OLO ACCORPANTE CPS | &quot;+EsitoResponse.descrizione);&#xD;
		}&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
			&amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot; //SM_9748: se è TLC bisogna usare codice olo cess nel confronto con codifica olo agcom donating&#xD;
	        &amp;&amp; !(localRequest.codificaOLOAGCOM == &quot;TLC&quot; &amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR)) //SM_9714: per CESSAZIONE CPS da SDR, non bisogna effettuare lo scarto controllando codificaoloagcom&#xD;
	{&#xD;
		if(ConsistenzaCPStemp.codificaOLOAGCOMDonating != CodiceOloCess)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Codice OLO richiesta diverso dal codice OLO della CPS in consistenza&quot;;&#xD;
			CodiceEsito = &quot;KO_28&quot;;&#xD;
			Log.write(&quot;Check OLO ACCORPANTE CPS | &quot;+EsitoResponse.descrizione);&#xD;
		}&#xD;
		// Se aveva scartato in precedenza (CESSAZIONE CPS) per KO_28, ma dopo il calcolo dell'olo accorpante ora è uguale a quello della localRequest, allora torna in ESITO TRUE&#xD;
		else if(ConsistenzaCPStemp.codificaOLOAGCOMDonating == CodiceOloCess &amp;&amp; CodiceEsito == &quot;KO_28&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza riuscito: Codice OLO richiesta uguale dal codice OLO della CPS in consistenza dopo il calcolo dell'accorpante&quot;;&#xD;
			CodiceEsito = null;&#xD;
			Log.write(&quot;Check OLO ACCORPANTE CPS | &quot;+EsitoResponse.descrizione);&#xD;
		}&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
	        &amp;&amp; !(localRequest.codificaOLOAGCOM == &quot;TLC&quot; &amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR))    //SM_9714: per CESSAZIONE CPS da SDR, non bisogna effettuare lo scarto controllando codificaoloagcom&#xD;
	{&#xD;
		if(ConsistenzaCPStemp.codificaOLOAGCOMDonating != localRequest.codificaOLOAGCOM)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Codice OLO richiesta diverso dal codice OLO della CPS in consistenza&quot;;&#xD;
			CodiceEsito = &quot;KO_28&quot;;&#xD;
			Log.write(&quot;Check OLO ACCORPANTE CPS | &quot;+EsitoResponse.descrizione);&#xD;
		}&#xD;
		// Se aveva scartato in precedenza (CESSAZIONE CPS) per KO_28, ma dopo il calcolo dell'olo accorpante ora è uguale a quello della localRequest, allora torna in ESITO TRUE&#xD;
		else if(ConsistenzaCPStemp.codificaOLOAGCOMDonating == localRequest.codificaOLOAGCOM &amp;&amp; CodiceEsito == &quot;KO_28&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza riuscito: Codice OLO richiesta uguale dal codice OLO della CPS in consistenza dopo il calcolo dell'accorpante&quot;;&#xD;
			CodiceEsito = null;&#xD;
			Log.write(&quot;Check OLO ACCORPANTE CPS | &quot;+EsitoResponse.descrizione);&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="139.0">
              <xpdl2:Coordinates XCoordinate="1471.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_JnIzENMPEeq7la06MjxCkQ" Name="VariazioneeCessazioneVLANeVP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Variazione e Cessazione VLAN e VP">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
CodiceEsito = null;&#xD;
&#xD;
var assetDati = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetDati = null;&#xD;
&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione e Cessazione VLAN | Verifica servizio in consistenza Variazione e Cessazione VLAN&quot;);&#xD;
&#xD;
&#xD;
//Bug #32742: la ricerca della consistenza deve essere fatta usando CODICEORDINETIDAOLO e CODICEORDINEOLODAOLO di RACCOLTA&#xD;
var CODICEORDINETIDAOLO = &quot;&quot;;&#xD;
var CODICEORDINEOLODAOLO = &quot;&quot;;&#xD;
CODICEORDINETIDAOLO = null;&#xD;
CODICEORDINEOLODAOLO = null;&#xD;
&#xD;
//Vale sia per RACCOLTAVLAN che RACCOLTAVP&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETIDAOLO)&#xD;
			{&#xD;
				CODICEORDINETIDAOLO = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo CODICEORDINETIDAOLO &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLODAOLO)&#xD;
			{&#xD;
				CODICEORDINEOLODAOLO = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo CODICEORDINEOLODAOLO &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
if((CODICEORDINETIDAOLO != null &amp;&amp; CODICEORDINETIDAOLO != &quot;&quot;) || (CODICEORDINEOLODAOLO != null &amp;&amp; CODICEORDINEOLODAOLO != &quot;&quot;))&#xD;
{	&#xD;
&#xD;
	if(CODICEORDINETIDAOLO != null &amp;&amp; CODICEORDINETIDAOLO != &quot;&quot;)&#xD;
	{&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;codiceOrdineTI =: CODICEORDINETIrich AND codificaOLOAGCOM =: codificaOLOAGCOMRichiesta AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta =: OffertaRichiesta&quot;);&#xD;
		c.setQueryParameter(&quot;CODICEORDINETIrich&quot;, CODICEORDINETIDAOLO);&#xD;
		c.setQueryParameter(&quot;codificaOLOAGCOMRichiesta&quot;, localRequest.codificaOLOAGCOM);&#xD;
		c.setQueryParameter(&quot;OffertaRichiesta&quot;, localRequest.offerta);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;codiceOrdineOLO =: CODICEORDINEOLOrich AND codificaOLOAGCOM =: codificaOLOAGCOMRichiesta AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta =: OffertaRichiesta&quot;);&#xD;
		c.setQueryParameter(&quot;CODICEORDINEOLOrich&quot;, CODICEORDINEOLODAOLO);&#xD;
		c.setQueryParameter(&quot;codificaOLOAGCOMRichiesta&quot;, localRequest.codificaOLOAGCOM);&#xD;
		c.setQueryParameter(&quot;OffertaRichiesta&quot;, localRequest.offerta);&#xD;
	}&#xD;
	&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result.size() > 0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		assetDati = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione e Cessazione VLAN | Trovato asset con codiceOrdineTI =&quot;+CODICEORDINETIDAOLO+&quot;, e codiceOrdineOLO=&quot;+CODICEORDINEOLODAOLO);&#xD;
	}&#xD;
	&#xD;
	//SCARTO CON KO_01&#xD;
	if(CODICEORDINETIDAOLO != null &amp;&amp; CODICEORDINETIDAOLO != &quot;&quot;&#xD;
	   &amp;&amp; (result.size() > 1 || result.size() == 0))&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito, CodiceOrdineTIdaOlo:&quot; +CODICEORDINETIDAOLO+ &quot;, numero di consistenze trovate:&quot;+ String(result.size());&#xD;
		CodiceEsito = &quot;KO_32&quot;;	 //Task #34271&#xD;
	}&#xD;
	//SCARTO CON KO_02&#xD;
	else if(CODICEORDINEOLODAOLO != null &amp;&amp; CODICEORDINEOLODAOLO != &quot;&quot;&#xD;
	   &amp;&amp; (result.size() > 1 || result.size() == 0))&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito, CodiceOrdineOLOdaOLO: &quot;+CODICEORDINEOLODAOLO+ &quot;, numero di consistenze trovate:&quot;+ String(result.size());&#xD;
		CodiceEsito = &quot;KO_33&quot;;	 //Task #34271&#xD;
	}&#xD;
	//SCARTO CON KO_03&#xD;
	else if(assetDati.statoAsset == &quot;INLAVORAZIONE&quot;)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito, StatoAsset&quot; +String(assetDati.statoAsset)+ &quot;e numero di consistenze trovate:&quot;+ String(result.size());&#xD;
		CodiceEsito = &quot;KO_34&quot;;	 //Task #34271&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
//--------------------------------------------------CREA CONSISTENZA RACCOLTA-------------------------------------------------//&#xD;
if(EsitoResponse.codice &amp;&amp; assetDati != null)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione e Cessazione VLAN | Creazione componente ConsistenzaRaccolta: &quot;+assetDati.IDAsset);&#xD;
	&#xD;
	ConsistenzaRaccolta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaRaccoltaType();&#xD;
	//AZIONE&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
	{&#xD;
		ConsistenzaRaccolta.azione = &quot;M&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		ConsistenzaRaccolta.azione = &quot;N&quot;;&#xD;
	}&#xD;
	//CODIFICAOLOAGCOMDONATING&#xD;
	ConsistenzaRaccolta.codificaOLOAGCOMDonating = assetDati.codificaOLOAGCOM;&#xD;
	//IDRISORSA&#xD;
	ConsistenzaRaccolta.IDRisorsa = assetDati.IDRisorsa;&#xD;
	&#xD;
	localRequest.IDRisorsa = assetDati.IDRisorsa;   //SM_9764: serve per passarlo in ingresso al controllo successivo &quot;CTRL ID_RISORSA&quot;&#xD;
			&#xD;
	//IDRISORSANOW&#xD;
	ConsistenzaRaccolta.IDRisorsaNOW = assetDati.IDRisorsaNOW;		&#xD;
	//OFFERTA&#xD;
	ConsistenzaRaccolta.offerta = String(assetDati.offerta);&#xD;
	//CODICEORDINETI&#xD;
	ConsistenzaRaccolta.codiceOrdineTI = assetDati.codiceOrdineTI;		&#xD;
	//CODICEORDINEOLO&#xD;
	ConsistenzaRaccolta.codiceOrdineOLO = assetDati.codiceOrdineOLO;		&#xD;
	//IDENTIFICATIVOASSET&#xD;
	ConsistenzaRaccolta.IDAsset = assetDati.IDAsset;		&#xD;
	//STATO&#xD;
	ConsistenzaRaccolta.stato = String(assetDati.statoAsset);&#xD;
	&#xD;
	ConsistenzaRaccolta.assetBTWhiteList = assetDati.assetBTWhiteList; //R1E-21-0325&#xD;
	&#xD;
	//R1E-21-0325&#xD;
	if(ConsistenzaRaccolta.assetBTWhiteList != null &amp;&amp; ConsistenzaRaccolta.assetBTWhiteList != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
	}&#xD;
	&#xD;
	//ALTRI ATTRIBUTI&#xD;
	var TIPOLOGIACLUSTERVLAN = false;&#xD;
	var FTTHONLY = false;&#xD;
	var CODICETDKIT = false;&#xD;
	var PROFILOBMC = false;&#xD;
	var FAMIGLIAVLAN = false;&#xD;
	var IDKITAREACAR = false; //IDKITAREACAR&#xD;
	var CODICECLLI = false;&#xD;
	var BMCLIGHT = false;&#xD;
	var TIPOVLAN = false;&#xD;
	var TRASPORTO = false;&#xD;
	var CODICEAREARACCOLTA = false;&#xD;
	var NOMEAREARACCOLTA = false;&#xD;
	var PUNTOCONSEGNA = false;&#xD;
	var MODELLOVLAN = false;&#xD;
	var IDADRCRMWS = false;&#xD;
	var IDENTIFICATIVOCAR = false;&#xD;
	var IDBRE = false;&#xD;
	var QINQFLAG = false;&#xD;
	var NOMEMACROAREA = false;&#xD;
	var CODICEMACROAREA = false;&#xD;
	var IDENTIFICATIVOVLANOLO = false;&#xD;
	var SUPERMACROAREA = false; //SM_9841&#xD;
	var NOMECLLI = false;  //Task #33761&#xD;
	var NOMEMACROAREACOMM = false;  //Task #34310&#xD;
	var CODICEMACROAREACOMM = false;  //Task #34310&#xD;
	var CARATTERISTICAVLAN = false;    //RU_1502&#xD;
	&#xD;
	var i = 0;&#xD;
	var raccoltaTrovato = false;&#xD;
	&#xD;
	while(!raccoltaTrovato &amp;&amp; i&lt;assetDati.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetDati.dettaglioasset.get(i);&#xD;
		&#xD;
		//Vale sia per RACCOLTAVLAN che RACCOLTAVP&#xD;
		if(String(componente.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;)&#xD;
		{&#xD;
			raccoltaTrovato = true;&#xD;
&#xD;
			for(var j=0; j&lt;componente.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN)&#xD;
				{&#xD;
					TIPOLOGIACLUSTERVLAN = true;&#xD;
					ConsistenzaRaccolta.tipologiaClusterVlan = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FTTHONLY)&#xD;
				{&#xD;
					FTTHONLY = true;&#xD;
					ConsistenzaRaccolta.ftthOnly = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
				{&#xD;
					CODICETDKIT = true;&#xD;
					ConsistenzaRaccolta.codiceTdKit = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMC)&#xD;
				{&#xD;
					PROFILOBMC = true;&#xD;
					ConsistenzaRaccolta.profiloBmc = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
				{&#xD;
					FAMIGLIAVLAN = true;&#xD;
					ConsistenzaRaccolta.famigliaVlan = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDKITAREACAR)&#xD;
				{&#xD;
					IDKITAREACAR = true;&#xD;
					ConsistenzaRaccolta.idKitAreaCar = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLLI)&#xD;
				{&#xD;
					CODICECLLI = true;&#xD;
					ConsistenzaRaccolta.codiceClli = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BMCLIGHT)&#xD;
				{&#xD;
					BMCLIGHT = true;&#xD;
					ConsistenzaRaccolta.bmcLight = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOVLAN)&#xD;
				{&#xD;
					TIPOVLAN = true;&#xD;
					ConsistenzaRaccolta.tipoVlan = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TRASPORTO)&#xD;
				{&#xD;
					TRASPORTO = true;&#xD;
					ConsistenzaRaccolta.trasporto = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEAREARACCOLTA)&#xD;
				{&#xD;
					CODICEAREARACCOLTA = true;&#xD;
					ConsistenzaRaccolta.codiceAreaRaccolta = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEAREARACCOLTA)&#xD;
				{&#xD;
					NOMEAREARACCOLTA = true;&#xD;
					ConsistenzaRaccolta.nomeAreaRaccolta = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PUNTOCONSEGNA)&#xD;
				{&#xD;
					PUNTOCONSEGNA = true;&#xD;
					ConsistenzaRaccolta.puntoConsegna = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MODELLOVLAN)&#xD;
				{&#xD;
					MODELLOVLAN = true;&#xD;
					ConsistenzaRaccolta.modelloVlan = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDADRCRMWS)&#xD;
				{&#xD;
					IDADRCRMWS = true;&#xD;
					ConsistenzaRaccolta.idAdrCrmws = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCAR)&#xD;
				{&#xD;
					IDENTIFICATIVOCAR = true;&#xD;
					ConsistenzaRaccolta.identificativoCar = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDBRE)&#xD;
				{&#xD;
					IDBRE = true;&#xD;
					ConsistenzaRaccolta.idBre = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QINQFLAG)&#xD;
				{&#xD;
					QINQFLAG = true;&#xD;
					ConsistenzaRaccolta.qinqFlag = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA)&#xD;
				{&#xD;
					NOMEMACROAREA = true;&#xD;
					ConsistenzaRaccolta.nomeMacroArea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA)&#xD;
				{&#xD;
					CODICEMACROAREA = true;&#xD;
					ConsistenzaRaccolta.codiceMacroArea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOVLANOLO)&#xD;
				{&#xD;
					IDENTIFICATIVOVLANOLO = true;&#xD;
					ConsistenzaRaccolta.identificativoVlanOlo = attributo.valoreAttributo;&#xD;
				}&#xD;
				//SM_9841&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA)&#xD;
				{&#xD;
					SUPERMACROAREA = true;&#xD;
					ConsistenzaRaccolta.superMacroArea = attributo.valoreAttributo;&#xD;
				}&#xD;
				//Task #33761&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMECLLI)&#xD;
				{&#xD;
					NOMECLLI = true;&#xD;
					ConsistenzaRaccolta.nomeClli = attributo.valoreAttributo;		&#xD;
				}&#xD;
				//Task #34310&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREACOMM)&#xD;
				{&#xD;
					NOMEMACROAREACOMM = true;&#xD;
					ConsistenzaRaccolta.nomeMacroAreaComm = attributo.valoreAttributo;		&#xD;
				}&#xD;
				//Task #34310&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREACOMM)&#xD;
				{&#xD;
					CODICEMACROAREACOMM = true;&#xD;
					ConsistenzaRaccolta.codiceMacroAreaComm = attributo.valoreAttributo;		&#xD;
				}&#xD;
				//RU_1502&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERISTICAVLAN)&#xD;
				{&#xD;
					CARATTERISTICAVLAN = true;&#xD;
					ConsistenzaRaccolta.caratteristicaVlan = attributo.valoreAttributo;		&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione e Cessazione VLAN | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="94.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="167.0">
              <xpdl2:Coordinates XCoordinate="891.0" YCoordinate="2613.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_didJUJLuEeuu8rvfxCUX4A" Name="CessazioneGPON" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Cessazione GPON" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Script inserito con RU_1150&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
CodiceEsito = null;&#xD;
&#xD;
var assetDati = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetDati = null;&#xD;
&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione GPON | Verifica servizio in consistenza Cessazione GPON&quot;);&#xD;
&#xD;
&#xD;
if(VerificaIDRisorsaResponse != null &amp;&amp; VerificaIDRisorsaResponse.datiAccesso != null&#xD;
   &amp;&amp; VerificaIDRisorsaResponse.datiAccesso.idAsset != null &amp;&amp; VerificaIDRisorsaResponse.datiAccesso.idAsset != &quot;&quot;)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset =: ida AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta &lt;> 'NP'&quot;);&#xD;
	c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(VerificaIDRisorsaResponse.datiAccesso.idAsset));&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result.size() > 1 || result.size() == 0)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito, numero di consistenze trovate:&quot; + String(result.size());&#xD;
		CodiceEsito = &quot;KO_01&quot;;	&#xD;
	}&#xD;
	else &#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		assetDati = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione GPON | Trovato Asset per IDAsset=&quot;+VerificaIDRisorsaResponse.datiAccesso.idAsset);&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//--------------------------------------------------CREA CONSISTENZA DATI-------------------------------------------------//&#xD;
if(EsitoResponse.codice &amp;&amp; assetDati != null)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot; + localRequest.IDRichiestaOLO + &quot;] | Cessazione GPON | Creazione componente ConsistenzaDati: &quot; + String(assetDati.IDAsset));&#xD;
	&#xD;
	ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();&#xD;
	&#xD;
	//AZIONE&#xD;
	ConsistenzaDati.azione = &quot;M&quot;;&#xD;
	//IDRISORSA&#xD;
	ConsistenzaDati.IDRisorsa = assetDati.IDRisorsa;&#xD;
	//IDRISORSANOW&#xD;
	ConsistenzaDati.IDRisorsaNOW = assetDati.IDRisorsaNOW;		&#xD;
	//OFFERTA&#xD;
	ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetDati.offerta));&#xD;
	&#xD;
	//Pezza per mettere l'offerta giusta nella richiesta (DA FILE CI MANDANO SEMPRE UBBSEMIGPON PER LE CESSAZIONI)&#xD;
	localRequest.offerta = assetDati.offerta;&#xD;
	localRequest.ordine.offerta = assetDati.offerta;&#xD;
	//------------------------------------------------------------------------------------------------------------&#xD;
	&#xD;
	//CODIFICAOLOAGCOMDONATING&#xD;
	ConsistenzaDati.codificaOLOAGCOMDonating = assetDati.codificaOLOAGCOM;&#xD;
	//CODICEORDINETI&#xD;
	ConsistenzaDati.codiceOrdineTI = assetDati.codiceOrdineTI;		&#xD;
	//CODICEORDINEOLO&#xD;
	ConsistenzaDati.codiceOrdineOLO = assetDati.codiceOrdineOLO;		&#xD;
	//IDENTIFICATIVOASSET&#xD;
	ConsistenzaDati.IDAsset = assetDati.IDAsset;		&#xD;
&#xD;
	ConsistenzaDati.assetBTWhiteList = assetDati.assetBTWhiteList; //R1E-21-0325&#xD;
	&#xD;
	//R1E-21-0325&#xD;
	if(ConsistenzaDati.assetBTWhiteList != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
	}&#xD;
&#xD;
	//ALTRI ATTRIBUTI&#xD;
	var COINVESTIMENTO = false;&#xD;
	var TIPOLOGIAACCESSOUBB = false;&#xD;
	var IDGPON = false;&#xD;
	var IDARMADIO = false;&#xD;
	var CODICEEGON = false;&#xD;
	var CODICEDELIVERY = false;&#xD;
	var IDRISORSA = false;&#xD;
	&#xD;
	var i=0;&#xD;
	var AccessoTrovato = false;&#xD;
	&#xD;
	while(!AccessoTrovato &amp;&amp; i&lt;assetDati.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetDati.dettaglioasset.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			AccessoTrovato = true;&#xD;
			Log.write(&quot;Trovata componente ACCESSO sull'asset&quot;);&#xD;
&#xD;
			for(var j=0; j&lt;componente.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COINVESTIMENTO)&#xD;
				{&#xD;
					COINVESTIMENTO = true;&#xD;
					ConsistenzaDati.coinvestimento = attributo.valoreAttributo;				&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIAACCESSOUBB)&#xD;
				{&#xD;
					TIPOLOGIAACCESSOUBB = true;&#xD;
					ConsistenzaDati.tipologiaAccessoUBB = attributo.valoreAttributo;						&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDGPON)&#xD;
				{&#xD;
					IDGPON = true;&#xD;
					ConsistenzaDati.idGpon = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDARMADIO)&#xD;
				{&#xD;
					IDARMADIO = true;&#xD;
					ConsistenzaDati.idArmadio = attributo.valoreAttributo;	&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEEGON)&#xD;
				{&#xD;
					CODICEEGON = true;&#xD;
					ConsistenzaDati.codiceEgon = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEDELIVERY)&#xD;
				{&#xD;
					CODICEDELIVERY = true;&#xD;
					ConsistenzaDati.codiceDelivery = attributo.valoreAttributo;		&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione e Cessazione VLAN | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="77.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="165.0">
              <xpdl2:Coordinates XCoordinate="891.0" YCoordinate="2250.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_O--zMMkwEeuhVM0iUag8Cw" Name="AttivazioneCANALECANALEESISTENTEFEEDER" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Attivazione CANALE (CANALE ESISTENTE FEEDER)">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
&#xD;
var LogString = &quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione CANALE (CANALE ESISTENTE FEEDER) | &quot;;&#xD;
&#xD;
Log.write(LogString+&quot;Verifica servizio in consistenza Attivazione CANALE ESISTENTE FEEDER&quot;);&#xD;
&#xD;
var IDRISORSACANALE = &quot;&quot;;&#xD;
IDRISORSACANALE = null;&#xD;
var CLLICENTRALE = &quot;&quot;;&#xD;
CLLICENTRALE = null;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var k = 0; k &lt; componente.attributiDettaglioOrdine.size(); k++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
			{&#xD;
				IDRISORSACANALE = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLICENTRALE)&#xD;
			{&#xD;
				CLLICENTRALE = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
// ============================================== RICERCA CANALE ==============================================&#xD;
if(IDRISORSACANALE != null &#xD;
&amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceMacroArea != null)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta = 'CANALE' AND dettaglioasset.nomeComponente = 'ACCESSOCANALE' AND dettaglioasset.attributidettaglioasset.nomeAttributo = 'CODICEMACROAREA' AND dettaglioasset.attributidettaglioasset.valoreAttributo =: CodiceMacroArea&quot;);&#xD;
	&#xD;
	c.setQueryParameter(&quot;idr&quot;, IDRISORSACANALE);&#xD;
	c.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
	c.setQueryParameter(&quot;CodiceMacroArea&quot;, LavorazioneRichiesta.codiceMacroArea);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		AssetCanale = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		Log.write(LogString+&quot;Recuperato Asset: &quot;+String(AssetCanale.IDAsset)+&quot;con CodiceMacroarea: &quot;+LavorazioneRichiesta.codiceMacroArea+&quot;, IDRISORSACANALE: &quot;+IDRISORSACANALE+&quot; e OLO: &quot;+localRequest.codificaOLOAGCOM);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset Canale non trovato con CodiceMacroarea: &quot;+LavorazioneRichiesta.codiceMacroArea+&quot;, IDRISORSACANALE: &quot;+IDRISORSACANALE+&quot; e OLO: &quot;+localRequest.codificaOLOAGCOM;&#xD;
		CodiceEsito = &quot;KO_39&quot;;     //Task #35293: modificato KO_01 in KO_39&#xD;
	}&#xD;
	&#xD;
	if(AssetCanale != null)&#xD;
	{&#xD;
		Log.write(LogString+&quot;Creazione componente Consistenza Canale: &quot;+String(AssetCanale.IDAsset));&#xD;
		&#xD;
		ConsistenzaCanale = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaCanaleType();&#xD;
		&#xD;
		ConsistenzaCanale.azione = &quot;N&quot;;&#xD;
		&#xD;
		ConsistenzaCanale.IDRisorsa = AssetCanale.IDRisorsa;&#xD;
&#xD;
		ConsistenzaCanale.IDRisorsaNOW = AssetCanale.IDRisorsaNOW;&#xD;
&#xD;
		ConsistenzaCanale.offerta = String(AssetCanale.offerta);&#xD;
		&#xD;
		ConsistenzaCanale.codificaOLOAGCOMDonating = AssetCanale.codificaOLOAGCOM;&#xD;
		&#xD;
		ConsistenzaCanale.codiceOrdineTI = AssetCanale.codiceOrdineTI;&#xD;
&#xD;
		ConsistenzaCanale.codiceOrdineOLO = AssetCanale.codiceOrdineOLO;&#xD;
&#xD;
		ConsistenzaCanale.IDAsset = AssetCanale.IDAsset;&#xD;
		&#xD;
		var BANDA = false;&#xD;
		var IPSORGENTE = false;&#xD;
		var IPMULTICAST = false;&#xD;
		&#xD;
		var accessoTrovato = false;&#xD;
		var i = 0;&#xD;
		&#xD;
		// Recupero Dati dall'asset&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; AssetCanale.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = AssetCanale.dettaglioasset.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				while((!BANDA || !IPSORGENTE || !IPMULTICAST) &#xD;
					&amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
					{&#xD;
						BANDA = true;&#xD;
						ConsistenzaCanale.banda = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPSORGENTE)&#xD;
					{&#xD;
						IPSORGENTE = true;&#xD;
						ConsistenzaCanale.IPSorgente = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPMULTICAST)&#xD;
					{&#xD;
						IPMULTICAST = true;&#xD;
						ConsistenzaCanale.IPMulticast = attributo.valoreAttributo;&#xD;
					}&#xD;
&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset Canale non recuperato a causa di parametri mancanti.&quot;;&#xD;
	CodiceEsito = &quot;KO_39&quot;;   //Task #35293: modificato KO_01 in KO_39&#xD;
}&#xD;
&#xD;
// ============================================== RICERCA FEEDER ==============================================&#xD;
if(EsitoResponse.codice)&#xD;
{&#xD;
	if(CLLICENTRALE != null)&#xD;
	{&#xD;
		//Provo a recuperare AssetFeeder con CLLICENTRALE&#xD;
		//SM_10220: corretto CLLI nella cac&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta = 'FEEDER' AND dettaglioasset.nomeComponente = 'ACCESSOFEEDER' AND ((dettaglioasset.attributidettaglioasset.nomeAttributo = 'CLLIPRIMOFEEDER' AND dettaglioasset.attributidettaglioasset.valoreAttributo =: CLLI) OR (dettaglioasset.attributidettaglioasset.nomeAttributo = 'CLLIFEEDERSUCCESSIVO' AND dettaglioasset.attributidettaglioasset.valoreAttributo =: CLLI))&quot;);&#xD;
	&#xD;
		c.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
		c.setQueryParameter(&quot;CLLI&quot;, CLLICENTRALE);&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		&#xD;
		if(result != null &amp;&amp; result.size() > 0)&#xD;
		{&#xD;
			var i = 0;&#xD;
			&#xD;
			//Ciclo sugli Asset Restituiti&#xD;
			while(AssetFeeder == null &amp;&amp; i&lt;result.size())&#xD;
			{&#xD;
				assetAppoggio = result.get(i).readAsset();&#xD;
				var accessoTrovato = false;&#xD;
				var ABILITATOMC = false;&#xD;
				var k = 0;&#xD;
				Log.write(LogString+&quot;Ciclo su Asset appoggio (Recuperato): &quot;+String(assetAppoggio.IDAsset));&#xD;
				&#xD;
				//Ciclo sugli attributi del singolo Asset&#xD;
				while(!accessoTrovato &amp;&amp; k &lt; assetAppoggio.dettaglioasset.size())&#xD;
				{&#xD;
					var componente = assetAppoggio.dettaglioasset.get(k);&#xD;
					&#xD;
					if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						accessoTrovato = true;&#xD;
						var j = 0;&#xD;
						while(!ABILITATOMC &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
						{&#xD;
							var attributo = componente.attributidettaglioasset.get(j);&#xD;
							&#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ABILITATOMC)&#xD;
							{&#xD;
								//Se trovo ABILITATOMC = SI, allora lo uso come AssetFeeder ed esco&#xD;
								ABILITATOMC = true;&#xD;
								&#xD;
								if(attributo.valoreAttributo == &quot;SI&quot;)&#xD;
								{&#xD;
									AssetFeeder = ScriptUtil.copy(assetAppoggio);&#xD;
									Log.write(LogString+&quot;Recuperato Asset con ABILITATOMC a SI: &quot;+String(AssetFeeder.IDAsset));&#xD;
								}&#xD;
							}&#xD;
&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					k++;&#xD;
				}&#xD;
				&#xD;
				i++;&#xD;
			}&#xD;
&#xD;
			// Controllo su ASSOCIAZIONE CANALE FEEDER&#xD;
			if(AssetFeeder != null)&#xD;
			{&#xD;
				var c = cac_it_telecomitalia_it_NOW_casedata_AssociazioneCanaleFeederOLT.createCriteria(&quot;IDAssetCanale =: IDAC AND IDAssetFeeder =: IDAF AND codificaOLOAGCOM =: OLO&quot;);&#xD;
	&#xD;
				c.setQueryParameter(&quot;IDAC&quot;, ConsistenzaCanale.IDAsset);&#xD;
				c.setQueryParameter(&quot;IDAF&quot;, AssetFeeder.IDAsset);&#xD;
				c.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
				&#xD;
				var result = cac_it_telecomitalia_it_NOW_casedata_AssociazioneCanaleFeederOLT.findByCriteria(c);&#xD;
				&#xD;
				if(result != null &amp;&amp; result.size() > 0)&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Canale: &quot;+ConsistenzaCanale.IDAsset+&quot; già abilitato al Feeder recuperato &quot;+AssetFeeder.IDAsset;&#xD;
					CodiceEsito = &quot;KO_03&quot;;&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset Feeder non trovato con CLLI: &quot;+CLLICENTRALE+&quot; e OLO: &quot;+localRequest.codificaOLOAGCOM;&#xD;
				CodiceEsito = &quot;KO_02&quot;;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset Feeder non trovato con CLLI: &quot;+CLLICENTRALE+&quot; e OLO: &quot;+localRequest.codificaOLOAGCOM;&#xD;
			CodiceEsito = &quot;KO_02&quot;;&#xD;
		}&#xD;
		&#xD;
		// CREAZIONE CONSISTENZA FEEDER&#xD;
		if(AssetFeeder != null)&#xD;
		{&#xD;
			Log.write(LogString+&quot;Creazione componente Consistenza Feeder: &quot;+String(AssetFeeder.IDAsset));&#xD;
		&#xD;
			ConsistenzaFeeder = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFeederType();&#xD;
			&#xD;
			ConsistenzaFeeder.azione = &quot;N&quot;;&#xD;
			&#xD;
			ConsistenzaFeeder.IDRisorsa = AssetFeeder.IDRisorsa;&#xD;
&#xD;
			ConsistenzaFeeder.IDRisorsaNOW = AssetFeeder.IDRisorsaNOW;&#xD;
&#xD;
			ConsistenzaFeeder.offerta = String(AssetFeeder.offerta);&#xD;
			&#xD;
			ConsistenzaFeeder.codificaOLOAGCOMDonating = AssetFeeder.codificaOLOAGCOM;&#xD;
			&#xD;
			ConsistenzaFeeder.codiceOrdineTI = AssetFeeder.codiceOrdineTI;&#xD;
&#xD;
			ConsistenzaFeeder.codiceOrdineOLO = AssetFeeder.codiceOrdineOLO;&#xD;
&#xD;
			ConsistenzaFeeder.IDAsset = AssetFeeder.IDAsset;&#xD;
			&#xD;
			var BANDA = false;&#xD;
			var CODICETDKIT = false;&#xD;
			var CLLIPRIMOFEEDER = false;&#xD;
			var CLLIFEEDERSUCCESSIVO = false;&#xD;
			var ABILITATOMC = false;&#xD;
			var NOMEMACROAREA = false;&#xD;
			var ASNUMBER = false;&#xD;
			var IPSESSIONE = false;&#xD;
			var CODICEMACROAREA = false;&#xD;
			var IDMADRCRMWS = false;&#xD;
			var FLAGPRIMOFEEDER = false;&#xD;
			var NOMEBOUQUET = false;&#xD;
			&#xD;
			var accessoTrovato = false;&#xD;
			var i = 0;&#xD;
			&#xD;
			// Recupero Dati dall'asset&#xD;
			while(!accessoTrovato &amp;&amp; i &lt; AssetFeeder.dettaglioasset.size())&#xD;
			{&#xD;
				var componente = AssetFeeder.dettaglioasset.get(i);&#xD;
				&#xD;
				if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					accessoTrovato = true;&#xD;
					var j = 0;&#xD;
					&#xD;
					while((!BANDA || !CODICETDKIT || !CLLIPRIMOFEEDER || !CLLIFEEDERSUCCESSIVO || !ABILITATOMC || !NOMEMACROAREA || !ASNUMBER || !IPSESSIONE|| !CODICEMACROAREA|| !IDMADRCRMWS|| !FLAGPRIMOFEEDER|| !NOMEBOUQUET) &#xD;
						&amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
					{&#xD;
						var attributo = componente.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
						{&#xD;
							BANDA = true;&#xD;
							ConsistenzaFeeder.banda = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
						{&#xD;
							CODICETDKIT = true;&#xD;
							ConsistenzaFeeder.codiceTdKit = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIPRIMOFEEDER)&#xD;
						{&#xD;
							CLLIPRIMOFEEDER = true;&#xD;
							ConsistenzaFeeder.CLLIPrimoFeeder = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIFEEDERSUCCESSIVO)&#xD;
						{&#xD;
							CLLIFEEDERSUCCESSIVO = true;&#xD;
							ConsistenzaFeeder.CLLIFeederSuccessivo = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ABILITATOMC)&#xD;
						{&#xD;
							ABILITATOMC = true;&#xD;
							ConsistenzaFeeder.abilitatoMC = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA)&#xD;
						{&#xD;
							NOMEMACROAREA = true;&#xD;
							ConsistenzaFeeder.nomeMacroArea = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ASNUMBER)&#xD;
						{&#xD;
							ASNUMBER = true;&#xD;
							ConsistenzaFeeder.ASNumber = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPSESSIONE)&#xD;
						{&#xD;
							IPSESSIONE = true;&#xD;
							ConsistenzaFeeder.IPSessione = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA)&#xD;
						{&#xD;
							CODICEMACROAREA = true;&#xD;
							ConsistenzaFeeder.codiceMacroArea = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS)&#xD;
						{&#xD;
							IDMADRCRMWS = true;&#xD;
							ConsistenzaFeeder.IDMadrCRMWS = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGPRIMOFEEDER)&#xD;
						{&#xD;
							FLAGPRIMOFEEDER = true;&#xD;
							ConsistenzaFeeder.flagPrimoFeeder = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEBOUQUET)&#xD;
						{&#xD;
							NOMEBOUQUET = true;&#xD;
							ConsistenzaFeeder.nomeBouquet = attributo.valoreAttributo;&#xD;
						}&#xD;
&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset Feeder non recuperato a causa di parametri mancanti.&quot;;&#xD;
		CodiceEsito = &quot;KO_02&quot;;&#xD;
	}	&#xD;
}&#xD;
&#xD;
// ============================================== RICERCA VANNGAMULTICAST ==============================================&#xD;
if(EsitoResponse.codice&#xD;
&amp;&amp; ConsistenzaFeeder != null &amp;&amp; ConsistenzaFeeder.CLLIPrimoFeeder != null)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;offerta = 'VLANNGAMULTICAST' AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND dettaglioasset.nomeComponente = 'RACCOLTAVLANMULTICAST' AND dettaglioasset.attributidettaglioasset.nomeAttributo = 'IDRISORSAFEEDER' AND dettaglioasset.attributidettaglioasset.valoreAttributo =: CLLIPRIMOFEEDER&quot;);&#xD;
&#xD;
	c.setQueryParameter(&quot;CLLIPRIMOFEEDER&quot;, ConsistenzaFeeder.CLLIPrimoFeeder);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		AssetVLANMULTICAST = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		&#xD;
		Log.write(LogString+&quot;Recuperato per CLLIPRIMOFEEDER &quot;+ConsistenzaFeeder.CLLIPrimoFeeder+&quot;. Asset: &quot;+String(AssetVLANMULTICAST.IDAsset));&#xD;
		&#xD;
		Log.write(LogString+&quot;Creazione componente Consistenza VLANMULTICAST: &quot;+String(AssetVLANMULTICAST.IDAsset));&#xD;
	&#xD;
		ConsistenzaRaccoltaVLANMulticast = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaRaccoltaVLANMulticastType();&#xD;
		&#xD;
		ConsistenzaRaccoltaVLANMulticast.azione = &quot;N&quot;;&#xD;
		&#xD;
		ConsistenzaRaccoltaVLANMulticast.IDRisorsa = AssetVLANMULTICAST.IDRisorsa;&#xD;
&#xD;
		ConsistenzaRaccoltaVLANMulticast.IDRisorsaNOW = AssetVLANMULTICAST.IDRisorsaNOW;&#xD;
&#xD;
		ConsistenzaRaccoltaVLANMulticast.offerta = String(AssetVLANMULTICAST.offerta);&#xD;
		&#xD;
		ConsistenzaRaccoltaVLANMulticast.codificaOLOAGCOMDonating = AssetVLANMULTICAST.codificaOLOAGCOM;&#xD;
		&#xD;
		ConsistenzaRaccoltaVLANMulticast.codiceOrdineTI = AssetVLANMULTICAST.codiceOrdineTI;&#xD;
&#xD;
		ConsistenzaRaccoltaVLANMulticast.codiceOrdineOLO = AssetVLANMULTICAST.codiceOrdineOLO;&#xD;
&#xD;
		ConsistenzaRaccoltaVLANMulticast.IDAsset = AssetVLANMULTICAST.IDAsset;&#xD;
		&#xD;
		var IDENTIFICATIVOVLANOLO = false;&#xD;
		var IDRISORSAFEEDER = false;&#xD;
		var CODICETDKIT = false;&#xD;
		&#xD;
		var i = 0;&#xD;
		&#xD;
		var accessoTrovato = false;&#xD;
		&#xD;
		// Recupero Dati dall'asset&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; AssetVLANMULTICAST.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = AssetVLANMULTICAST.dettaglioasset.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				while((!IDENTIFICATIVOVLANOLO || !IDRISORSAFEEDER || !CODICETDKIT) &#xD;
					&amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOVLANOLO)&#xD;
					{&#xD;
						IDENTIFICATIVOVLANOLO = true;&#xD;
						ConsistenzaRaccoltaVLANMulticast.identificativoVLANOLO = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAFEEDER)&#xD;
					{&#xD;
						IDRISORSAFEEDER = true;&#xD;
						ConsistenzaRaccoltaVLANMulticast.IDRisorsaFeeder = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
					{&#xD;
						CODICETDKIT = true;&#xD;
						ConsistenzaRaccoltaVLANMulticast.codiceTDKIT = attributo.valoreAttributo;&#xD;
					}&#xD;
&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(LogString+EsitoResponse.descrizione);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="88.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="176.0">
              <xpdl2:Coordinates XCoordinate="887.0" YCoordinate="1110.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_08FAEckxEeuhVM0iUag8Cw" Name="AttivazioneCANALECANALEESISTENTESEDEOLT" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Attivazione CANALE (CANALE ESISTENTE SEDE OLT)">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
&#xD;
var LogString = &quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione CANALE (CANALE ESISTENTE SEDE OLT) | &quot;;&#xD;
&#xD;
Log.write(LogString+&quot;Verifica servizio in consistenza Attivazione CANALE ESISTENTE OLT&quot;);&#xD;
&#xD;
var IDRISORSACANALE = &quot;&quot;;&#xD;
IDRISORSACANALE = null;&#xD;
var CLLICENTRALE = &quot;&quot;;&#xD;
CLLICENTRALE = null;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var k = 0; k &lt; componente.attributiDettaglioOrdine.size(); k++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
			{&#xD;
				IDRISORSACANALE = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLICENTRALE)&#xD;
			{&#xD;
				CLLICENTRALE = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
// ============================================== RICERCA CANALE ==============================================&#xD;
if(IDRISORSACANALE != null &#xD;
&amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.codiceMacroArea != null)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta = 'CANALE' AND dettaglioasset.nomeComponente = 'ACCESSOCANALE' AND dettaglioasset.attributidettaglioasset.nomeAttributo = 'CODICEMACROAREA' AND dettaglioasset.attributidettaglioasset.valoreAttributo =: CodiceMacroArea&quot;);&#xD;
	&#xD;
	c.setQueryParameter(&quot;idr&quot;, IDRISORSACANALE);&#xD;
	c.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
	c.setQueryParameter(&quot;CodiceMacroArea&quot;, LavorazioneRichiesta.codiceMacroArea);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		AssetCanale = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		Log.write(LogString+&quot;Recuperato Asset: &quot;+String(AssetCanale.IDAsset)+&quot;con CodiceMacroarea: &quot;+LavorazioneRichiesta.codiceMacroArea+&quot;, IDRISORSACANALE: &quot;+IDRISORSACANALE+&quot; e OLO: &quot;+localRequest.codificaOLOAGCOM);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset Canale non trovato con CodiceMacroarea: &quot;+LavorazioneRichiesta.codiceMacroArea+&quot;, IDRISORSACANALE: &quot;+IDRISORSACANALE+&quot; e OLO: &quot;+localRequest.codificaOLOAGCOM;&#xD;
		CodiceEsito = &quot;KO_04&quot;;&#xD;
	}&#xD;
	&#xD;
	if(AssetCanale != null)&#xD;
	{&#xD;
		Log.write(LogString+&quot;Creazione componente Consistenza Canale: &quot;+String(AssetCanale.IDAsset));&#xD;
		&#xD;
		ConsistenzaCanale = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaCanaleType();&#xD;
		&#xD;
		ConsistenzaCanale.azione = &quot;N&quot;;&#xD;
		&#xD;
		ConsistenzaCanale.IDRisorsa = AssetCanale.IDRisorsa;&#xD;
&#xD;
		ConsistenzaCanale.IDRisorsaNOW = AssetCanale.IDRisorsaNOW;&#xD;
&#xD;
		ConsistenzaCanale.offerta = String(AssetCanale.offerta);&#xD;
		&#xD;
		ConsistenzaCanale.codificaOLOAGCOMDonating = AssetCanale.codificaOLOAGCOM;&#xD;
		&#xD;
		ConsistenzaCanale.codiceOrdineTI = AssetCanale.codiceOrdineTI;&#xD;
&#xD;
		ConsistenzaCanale.codiceOrdineOLO = AssetCanale.codiceOrdineOLO;&#xD;
&#xD;
		ConsistenzaCanale.IDAsset = AssetCanale.IDAsset;&#xD;
		&#xD;
		var BANDA = false;&#xD;
		var IPSORGENTE = false;&#xD;
		var IPMULTICAST = false;&#xD;
		&#xD;
		var accessoTrovato = false;&#xD;
		var i = 0;&#xD;
		&#xD;
		// Recupero Dati dall'asset&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; AssetCanale.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = AssetCanale.dettaglioasset.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				while((!BANDA || !IPSORGENTE || !IPMULTICAST) &#xD;
					&amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
					{&#xD;
						BANDA = true;&#xD;
						ConsistenzaCanale.banda = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPSORGENTE)&#xD;
					{&#xD;
						IPSORGENTE = true;&#xD;
						ConsistenzaCanale.IPSorgente = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPMULTICAST)&#xD;
					{&#xD;
						IPMULTICAST = true;&#xD;
						ConsistenzaCanale.IPMulticast = attributo.valoreAttributo;&#xD;
					}&#xD;
&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset Canale non recuperato a causa di parametri mancanti.&quot;;&#xD;
	CodiceEsito = &quot;KO_04&quot;;&#xD;
}&#xD;
&#xD;
// ============================================== RICERCA SEDEOLT ==============================================&#xD;
if(EsitoResponse.codice)&#xD;
{&#xD;
	if(CLLICENTRALE != null)&#xD;
	{&#xD;
		//Provo a recuperare AssetSedeOLT con CLLICENTRALE&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta = 'SEDEOLT' AND CLLI =: CLLIval&quot;);&#xD;
	&#xD;
		c.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
		c.setQueryParameter(&quot;CLLIval&quot;, CLLICENTRALE);&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		&#xD;
		if(result != null &amp;&amp; result.size() > 0)&#xD;
		{&#xD;
			AssetRef = result.get(0);&#xD;
			AssetSedeOLT = ScriptUtil.copy(AssetRef.readAsset());&#xD;
			Log.write(LogString+&quot;Recuperato Asset: &quot;+String(AssetSedeOLT.IDAsset)+&quot; con CLLI &quot;+CLLICENTRALE+&quot;, OLO &quot;+localRequest.codificaOLOAGCOM);&#xD;
&#xD;
			&#xD;
			// Controllo su ASSOCIAZIONE CANALE OLT&#xD;
			var c = cac_it_telecomitalia_it_NOW_casedata_AssociazioneCanaleFeederOLT.createCriteria(&quot;IDAssetCanale =: IDAC AND IDAssetOLT =: IDAO AND codificaOLOAGCOM =: OLO&quot;);&#xD;
&#xD;
			c.setQueryParameter(&quot;IDAC&quot;, ConsistenzaCanale.IDAsset);&#xD;
			c.setQueryParameter(&quot;IDAO&quot;, AssetSedeOLT.IDAsset);&#xD;
			c.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
			&#xD;
			var result = cac_it_telecomitalia_it_NOW_casedata_AssociazioneCanaleFeederOLT.findByCriteria(c);&#xD;
			&#xD;
			if(result != null &amp;&amp; result.size() > 0)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Canale: &quot;+ConsistenzaCanale.IDAsset+&quot; già abilitato al SEDE OLT recuperato &quot;+AssetSedeOLT.IDAsset;&#xD;
				CodiceEsito = &quot;KO_03&quot;;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset SedeOLT non trovato.&quot;;&#xD;
			CodiceEsito = &quot;KO_02&quot;;&#xD;
		}&#xD;
		&#xD;
		&#xD;
		if(AssetSedeOLT != null)&#xD;
		{&#xD;
			Log.write(LogString+&quot;Creazione componente Consistenza SedeOLT: &quot;+String(AssetSedeOLT.IDAsset));&#xD;
		&#xD;
			ConsistenzaSedeOLT = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaSedeOLTType();&#xD;
			&#xD;
			ConsistenzaSedeOLT.azione = &quot;N&quot;;&#xD;
			&#xD;
			ConsistenzaSedeOLT.IDRisorsa = AssetSedeOLT.IDRisorsa;&#xD;
&#xD;
			ConsistenzaSedeOLT.IDRisorsaNOW = AssetSedeOLT.IDRisorsaNOW;&#xD;
&#xD;
			ConsistenzaSedeOLT.offerta = String(AssetSedeOLT.offerta);&#xD;
			&#xD;
			ConsistenzaSedeOLT.codificaOLOAGCOMDonating = AssetSedeOLT.codificaOLOAGCOM;&#xD;
			&#xD;
			ConsistenzaSedeOLT.codiceOrdineTI = AssetSedeOLT.codiceOrdineTI;&#xD;
&#xD;
			ConsistenzaSedeOLT.codiceOrdineOLO = AssetSedeOLT.codiceOrdineOLO;&#xD;
&#xD;
			ConsistenzaSedeOLT.IDAsset = AssetSedeOLT.IDAsset;&#xD;
			&#xD;
			var BANDA = false;&#xD;
			var ABILITATOMC = false;&#xD;
			&#xD;
			var accessoTrovato = false;&#xD;
			var i = 0;&#xD;
			&#xD;
			// Recupero Dati dall'asset&#xD;
			while(!accessoTrovato &amp;&amp; i &lt; AssetSedeOLT.dettaglioasset.size())&#xD;
			{&#xD;
				var componente = AssetSedeOLT.dettaglioasset.get(i);&#xD;
				&#xD;
				if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					accessoTrovato = true;&#xD;
					var j = 0;&#xD;
					while((!BANDA || !ABILITATOMC) &#xD;
						&amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
					{&#xD;
						var attributo = componente.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
						{&#xD;
							BANDA = true;&#xD;
							ConsistenzaSedeOLT.banda = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ABILITATOMC)&#xD;
						{&#xD;
							ABILITATOMC = true;&#xD;
							ConsistenzaSedeOLT.abilitatoMC = attributo.valoreAttributo;&#xD;
						}&#xD;
&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
			&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset SedeOLT non recuperato a causa di CLLICENTRALE mancante.&quot;;&#xD;
		CodiceEsito = &quot;KO_05&quot;;&#xD;
	}	&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(LogString+EsitoResponse.descrizione);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="88.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="176.0">
              <xpdl2:Coordinates XCoordinate="887.0" YCoordinate="1236.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_6p3CQckxEeuhVM0iUag8Cw" Name="AttivazioneSEDEOLTeAttivazioneCANALECREAZIONECANALE" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Attivazione SEDE OLT e Attivazione CANALE (CREAZIONE CANALE)">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
&#xD;
var LogString = &quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione SEDE OLT e Attivazione CANALE (CREAZIONE CANALE) | &quot;;&#xD;
&#xD;
Log.write(LogString+&quot;Verifica servizio in consistenza Attivazione Sede OLT e Creazione Canale&quot;);&#xD;
&#xD;
var CLLICENTRALE = &quot;&quot;;&#xD;
CLLICENTRALE = null;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var k = 0; k &lt; componente.attributiDettaglioOrdine.size(); k++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLICENTRALE)&#xD;
			{&#xD;
				CLLICENTRALE = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
// ============================================== RICERCA FEEDER ==============================================&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT &amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.clliPrimoFeeder != null)&#xD;
|| (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE &amp;&amp; CLLICENTRALE != null))&#xD;
{&#xD;
	var AssetFeederTrovato = false;&#xD;
	&#xD;
	//PRIMO TENTATIVO&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta = 'FEEDER' AND dettaglioasset.nomeComponente = 'ACCESSOFEEDER' AND dettaglioasset.attributidettaglioasset.nomeAttributo = 'CLLIFEEDERSUCCESSIVO' AND dettaglioasset.attributidettaglioasset.valoreAttributo =: CLLI&quot;);&#xD;
	&#xD;
	c.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
	&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE)&#xD;
	{&#xD;
		c.setQueryParameter(&quot;CLLI&quot;, CLLICENTRALE);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		c.setQueryParameter(&quot;CLLI&quot;, LavorazioneRichiesta.clliPrimoFeeder);&#xD;
	}&#xD;
	&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{	&#xD;
		AssetFeederTrovato = true; //Mi serve per scarto KO_08&#xD;
		&#xD;
		var i = 0;&#xD;
		&#xD;
		//Ciclo sugli Asset Restituiti&#xD;
		while(AssetFeeder == null &amp;&amp; i&lt;result.size())&#xD;
		{&#xD;
			assetAppoggio = result.get(i).readAsset();&#xD;
			Log.write(LogString+&quot;Ciclo su Asset appoggio (Recuperato): &quot;+String(assetAppoggio.IDAsset));&#xD;
			&#xD;
			var accessoTrovato = false;&#xD;
			var foundABILITATOMC = false;&#xD;
			&#xD;
			var ABILITATOMC = &quot;&quot;;&#xD;
			ABILITATOMC = null;&#xD;
			var k = 0;&#xD;
&#xD;
			//Ciclo sugli attributi del singolo Asset&#xD;
			while(!accessoTrovato &amp;&amp; k &lt; assetAppoggio.dettaglioasset.size())&#xD;
			{&#xD;
				var componente = assetAppoggio.dettaglioasset.get(k);&#xD;
				&#xD;
				if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					accessoTrovato = true;&#xD;
					var j = 0;&#xD;
					&#xD;
					while((!foundABILITATOMC) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
					{&#xD;
						var attributo = componente.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ABILITATOMC)&#xD;
						{&#xD;
							foundABILITATOMC = true;&#xD;
							ABILITATOMC = attributo.valoreAttributo;&#xD;
						}&#xD;
						&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				k++;&#xD;
			}&#xD;
			&#xD;
			if(ABILITATOMC == &quot;SI&quot;)&#xD;
			{&#xD;
				AssetFeeder = ScriptUtil.copy(assetAppoggio);&#xD;
				Log.write(LogString+&quot;Recuperato Asset con ABILITATOMC a SI: &quot;+String(AssetFeeder.IDAsset));&#xD;
			}&#xD;
			&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Log.write(LogString+&quot; Primo Tentativo recupero Asset con CLLIFEEDERSUCCESSIVO fallito&quot;);&#xD;
	}&#xD;
	&#xD;
	//SECONDO TENTATIVO&#xD;
	if(AssetFeeder == null)&#xD;
	{&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta = 'FEEDER' AND dettaglioasset.nomeComponente = 'ACCESSOFEEDER' AND dettaglioasset.attributidettaglioasset.nomeAttributo = 'CLLIPRIMOFEEDER' AND dettaglioasset.attributidettaglioasset.valoreAttributo =: CLLI&quot;);&#xD;
	&#xD;
		c.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
		&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE)&#xD;
		{&#xD;
			c.setQueryParameter(&quot;CLLI&quot;, CLLICENTRALE);&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			c.setQueryParameter(&quot;CLLI&quot;, LavorazioneRichiesta.clliPrimoFeeder);&#xD;
		}&#xD;
		&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		&#xD;
		if(result != null &amp;&amp; result.size() > 0)&#xD;
		{	&#xD;
			var i = 0;&#xD;
			&#xD;
			//Ciclo sugli Asset Restituiti&#xD;
			while(AssetFeeder == null &amp;&amp; i&lt;result.size())&#xD;
			{&#xD;
				assetAppoggio = result.get(i).readAsset();&#xD;
				Log.write(LogString+&quot;Ciclo su Asset appoggio (Recuperato): &quot;+String(assetAppoggio.IDAsset));&#xD;
				&#xD;
				var accessoTrovato = false;&#xD;
				var foundFLAGPRIMOFEEDER = false;&#xD;
				var foundABILITATOMC = false;&#xD;
				&#xD;
				var FLAGPRIMOFEEDER = &quot;&quot;;&#xD;
				FLAGPRIMOFEEDER = null;&#xD;
				var ABILITATOMC = &quot;&quot;;&#xD;
				ABILITATOMC = null;&#xD;
				var k = 0;&#xD;
	&#xD;
				//Ciclo sugli attributi del singolo Asset&#xD;
				while(!accessoTrovato &amp;&amp; k &lt; assetAppoggio.dettaglioasset.size())&#xD;
				{&#xD;
					var componente = assetAppoggio.dettaglioasset.get(k);&#xD;
					&#xD;
					if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						accessoTrovato = true;&#xD;
						var j = 0;&#xD;
						&#xD;
						while((!foundFLAGPRIMOFEEDER || !foundABILITATOMC) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
						{&#xD;
							var attributo = componente.attributidettaglioasset.get(j);&#xD;
							&#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGPRIMOFEEDER)&#xD;
							{&#xD;
								foundFLAGPRIMOFEEDER = true;&#xD;
								FLAGPRIMOFEEDER = attributo.valoreAttributo;&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ABILITATOMC)&#xD;
							{&#xD;
								foundABILITATOMC = true;&#xD;
								ABILITATOMC = attributo.valoreAttributo;&#xD;
							}&#xD;
							&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					k++;&#xD;
				}&#xD;
				&#xD;
				if(FLAGPRIMOFEEDER == &quot;Y&quot;)&#xD;
				{&#xD;
					AssetFeederTrovato = true; //Mi serve per scarto KO_08&#xD;
					&#xD;
					if(ABILITATOMC == &quot;SI&quot;)&#xD;
					{&#xD;
						AssetFeeder = ScriptUtil.copy(assetAppoggio);&#xD;
						Log.write(LogString+&quot; Recuperato Asset: &quot;+String(AssetFeeder.IDAsset));&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Log.write(LogString+&quot; Secondo tentativo di recupero Fallito con CLLIPRIMOFEEDER&quot;);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(AssetFeeder != null)&#xD;
	{&#xD;
		Log.write(LogString+&quot;Creazione componente Consistenza Feeder: &quot;+String(AssetFeeder.IDAsset));&#xD;
	&#xD;
		ConsistenzaFeeder = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFeederType();&#xD;
		&#xD;
		ConsistenzaFeeder.azione = &quot;N&quot;;&#xD;
		&#xD;
		ConsistenzaFeeder.IDRisorsa = AssetFeeder.IDRisorsa;&#xD;
&#xD;
		ConsistenzaFeeder.IDRisorsaNOW = AssetFeeder.IDRisorsaNOW;&#xD;
&#xD;
		ConsistenzaFeeder.offerta = String(AssetFeeder.offerta);&#xD;
		&#xD;
		ConsistenzaFeeder.codificaOLOAGCOMDonating = AssetFeeder.codificaOLOAGCOM;&#xD;
		&#xD;
		ConsistenzaFeeder.codiceOrdineTI = AssetFeeder.codiceOrdineTI;&#xD;
&#xD;
		ConsistenzaFeeder.codiceOrdineOLO = AssetFeeder.codiceOrdineOLO;&#xD;
&#xD;
		ConsistenzaFeeder.IDAsset = AssetFeeder.IDAsset;&#xD;
		&#xD;
		var BANDA = false;&#xD;
		var CODICETDKIT = false;&#xD;
		var CLLIPRIMOFEEDER = false;&#xD;
		var CLLIFEEDERSUCCESSIVO = false;&#xD;
		var ABILITATOMC = false;&#xD;
		var NOMEMACROAREA = false;&#xD;
		var ASNUMBER = false;&#xD;
		var IPSESSIONE = false;&#xD;
		var CODICEMACROAREA = false;&#xD;
		var IDMADRCRMWS = false;&#xD;
		var FLAGPRIMOFEEDER = false;&#xD;
		var NOMEBOUQUET = false;&#xD;
		&#xD;
		var accessoTrovato = false;&#xD;
		var i = 0;&#xD;
		&#xD;
		// Recupero Dati dall'asset&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; AssetFeeder.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = AssetFeeder.dettaglioasset.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				&#xD;
				while((!BANDA || !CODICETDKIT || !CLLIPRIMOFEEDER || !CLLIFEEDERSUCCESSIVO || !ABILITATOMC || !NOMEMACROAREA || !ASNUMBER || !IPSESSIONE|| !CODICEMACROAREA|| !IDMADRCRMWS|| !FLAGPRIMOFEEDER|| !NOMEBOUQUET) &#xD;
					&amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
					{&#xD;
						BANDA = true;&#xD;
						ConsistenzaFeeder.banda = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
					{&#xD;
						CODICETDKIT = true;&#xD;
						ConsistenzaFeeder.codiceTdKit = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIPRIMOFEEDER)&#xD;
					{&#xD;
						CLLIPRIMOFEEDER = true;&#xD;
						ConsistenzaFeeder.CLLIPrimoFeeder = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIFEEDERSUCCESSIVO)&#xD;
					{&#xD;
						CLLIFEEDERSUCCESSIVO = true;&#xD;
						ConsistenzaFeeder.CLLIFeederSuccessivo = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ABILITATOMC)&#xD;
					{&#xD;
						ABILITATOMC = true;&#xD;
						ConsistenzaFeeder.abilitatoMC = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA)&#xD;
					{&#xD;
						NOMEMACROAREA = true;&#xD;
						ConsistenzaFeeder.nomeMacroArea = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ASNUMBER)&#xD;
					{&#xD;
						ASNUMBER = true;&#xD;
						ConsistenzaFeeder.ASNumber = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPSESSIONE)&#xD;
					{&#xD;
						IPSESSIONE = true;&#xD;
						ConsistenzaFeeder.IPSessione = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA)&#xD;
					{&#xD;
						CODICEMACROAREA = true;&#xD;
						ConsistenzaFeeder.codiceMacroArea = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS)&#xD;
					{&#xD;
						IDMADRCRMWS = true;&#xD;
						ConsistenzaFeeder.IDMadrCRMWS = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGPRIMOFEEDER)&#xD;
					{&#xD;
						FLAGPRIMOFEEDER = true;&#xD;
						ConsistenzaFeeder.flagPrimoFeeder = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEBOUQUET)&#xD;
					{&#xD;
						NOMEBOUQUET = true;&#xD;
						ConsistenzaFeeder.nomeBouquet = attributo.valoreAttributo;&#xD;
					}&#xD;
&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		// ============================================== RICERCA SEDE OLT (punto 4) ==============================================&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT&#xD;
		&amp;&amp; CLLICENTRALE != null)&#xD;
		{&#xD;
			//Provo a recuperare AssetSEDEOLT con CLLICENTRALE&#xD;
			var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta = 'SEDEOLT' AND dettaglioasset.nomeComponente = 'ACCESSOFEEDER' AND dettaglioasset.attributidettaglioasset.nomeAttributo = 'CLLICENTRALE' AND dettaglioasset.attributidettaglioasset.valoreAttributo =: CLLI&quot;);&#xD;
&#xD;
			c.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
			c.setQueryParameter(&quot;CLLI&quot;, CLLICENTRALE);&#xD;
			var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			&#xD;
			if(result != null &amp;&amp; result.size() > 0)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: offerta SEDEOLT, trovato Asset con stesso CLLICENTRALE: &quot;+CLLICENTRALE+&quot; e OLO: &quot;+localRequest.codificaOLOAGCOM;&#xD;
				CodiceEsito = &quot;KO_09&quot;;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(AssetFeederTrovato)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset Feeder trovato, ma senza ABILITATOMC a SI.&quot;;&#xD;
		CodiceEsito = &quot;KO_08&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: nessun Asset Feeder trovato.&quot;;&#xD;
		CodiceEsito = &quot;KO_38&quot;;     //SM_10217: KO_07 diventa KO_38&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset Feeder non recuperato a causa di CLLICENTRALE mancante.&quot;;&#xD;
	CodiceEsito = &quot;KO_02&quot;;&#xD;
}&#xD;
&#xD;
&#xD;
// ============================================== RICERCA VANNGAMULTICAST ==============================================&#xD;
if(EsitoResponse.codice&#xD;
&amp;&amp; ConsistenzaFeeder != null &amp;&amp; ConsistenzaFeeder.CLLIPrimoFeeder != null)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;offerta = 'VLANNGAMULTICAST' AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND dettaglioasset.nomeComponente = 'RACCOLTAVLANMULTICAST' AND dettaglioasset.attributidettaglioasset.nomeAttributo = 'IDRISORSAFEEDER' AND dettaglioasset.attributidettaglioasset.valoreAttributo =: CLLIPRIMOFEEDER&quot;);&#xD;
&#xD;
	c.setQueryParameter(&quot;CLLIPRIMOFEEDER&quot;, ConsistenzaFeeder.CLLIPrimoFeeder);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		AssetVLANMULTICAST = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		&#xD;
		Log.write(LogString+&quot; Recuperato per CLLIPRIMOFEEDER &quot;+ConsistenzaFeeder.CLLIPrimoFeeder+&quot;. Asset: &quot;+String(AssetVLANMULTICAST.IDAsset));&#xD;
		&#xD;
		Log.write(LogString+&quot; Creazione componente Consistenza VLANMULTICAST: &quot;+String(AssetVLANMULTICAST.IDAsset));&#xD;
	&#xD;
		ConsistenzaRaccoltaVLANMulticast = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaRaccoltaVLANMulticastType();&#xD;
		&#xD;
		ConsistenzaRaccoltaVLANMulticast.azione = &quot;N&quot;;&#xD;
		&#xD;
		ConsistenzaRaccoltaVLANMulticast.IDRisorsa = AssetVLANMULTICAST.IDRisorsa;&#xD;
&#xD;
		ConsistenzaRaccoltaVLANMulticast.IDRisorsaNOW = AssetVLANMULTICAST.IDRisorsaNOW;&#xD;
&#xD;
		ConsistenzaRaccoltaVLANMulticast.offerta = String(AssetVLANMULTICAST.offerta);&#xD;
		&#xD;
		ConsistenzaRaccoltaVLANMulticast.codificaOLOAGCOMDonating = AssetVLANMULTICAST.codificaOLOAGCOM;&#xD;
		&#xD;
		ConsistenzaRaccoltaVLANMulticast.codiceOrdineTI = AssetVLANMULTICAST.codiceOrdineTI;&#xD;
&#xD;
		ConsistenzaRaccoltaVLANMulticast.codiceOrdineOLO = AssetVLANMULTICAST.codiceOrdineOLO;&#xD;
&#xD;
		ConsistenzaRaccoltaVLANMulticast.IDAsset = AssetVLANMULTICAST.IDAsset;&#xD;
		&#xD;
		var IDENTIFICATIVOVLANOLO = false;&#xD;
		var IDRISORSAFEEDER = false;&#xD;
		var CODICETDKIT = false;&#xD;
		&#xD;
		var accessoTrovato = false;&#xD;
		var i = 0;&#xD;
		&#xD;
		// Recupero Dati dall'asset&#xD;
		while(!accessoTrovato &amp;&amp; i &lt; AssetVLANMULTICAST.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = AssetVLANMULTICAST.dettaglioasset.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j = 0;&#xD;
				&#xD;
				while((!IDENTIFICATIVOVLANOLO || !IDRISORSAFEEDER || !CODICETDKIT) &#xD;
					&amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOVLANOLO)&#xD;
					{&#xD;
						IDENTIFICATIVOVLANOLO = true;&#xD;
						ConsistenzaRaccoltaVLANMulticast.identificativoVLANOLO = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAFEEDER)&#xD;
					{&#xD;
						IDRISORSAFEEDER = true;&#xD;
						ConsistenzaRaccoltaVLANMulticast.IDRisorsaFeeder = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
					{&#xD;
						CODICETDKIT = true;&#xD;
						ConsistenzaRaccoltaVLANMulticast.codiceTDKIT = attributo.valoreAttributo;&#xD;
					}&#xD;
&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(LogString+EsitoResponse.descrizione+&quot;con CodiceEsito: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="88.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="176.0">
              <xpdl2:Coordinates XCoordinate="889.0" YCoordinate="1367.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_0lxuAMkzEeuhVM0iUag8Cw" Name="AttivazioneFEEDERPRIMOCANALEeFEEDERSUCCESSIVO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Attivazione FEEDER (PRIMO CANALE e FEEDER SUCCESSIVO)">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
&#xD;
var LogString = &quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione FEEDER (PRIMO CANALE e FEEDER SUCCESSIVO) | &quot;;&#xD;
&#xD;
Log.write(LogString+&quot;Verifica servizio in consistenza Attivazione Feeder&quot;);&#xD;
&#xD;
var CLLIPRIMOFEEDER = &quot;&quot;;&#xD;
CLLIPRIMOFEEDER = null;&#xD;
var CLLIFEEDERSUCCESSIVO = &quot;&quot;;&#xD;
CLLIFEEDERSUCCESSIVO = null;&#xD;
var NOMEMACROAREA = &quot;&quot;;&#xD;
NOMEMACROAREA = null;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var k = 0; k &lt; componente.attributiDettaglioOrdine.size(); k++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIPRIMOFEEDER)&#xD;
			{&#xD;
				CLLIPRIMOFEEDER = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIFEEDERSUCCESSIVO)&#xD;
			{&#xD;
				CLLIFEEDERSUCCESSIVO = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA)&#xD;
			{&#xD;
				NOMEMACROAREA = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//PRIMOFEEDER&#xD;
if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRIMOFEEDER&#xD;
&amp;&amp; CLLIPRIMOFEEDER != null&#xD;
&amp;&amp; LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.nomeMacroArea != null)&#xD;
{&#xD;
	//RICERCA FEEDER ESISTENTE per SOTTOLAV PRIMOFEEDER&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta = 'FEEDER' AND dettaglioasset.nomeComponente = 'ACCESSOFEEDER' AND dettaglioasset.attributidettaglioasset.nomeAttributo = 'CLLIPRIMOFEEDER' AND dettaglioasset.attributidettaglioasset.valoreAttributo =: CLLIPRIMOFEEDERval&quot;);&#xD;
	&#xD;
	c.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
	c.setQueryParameter(&quot;CLLIPRIMOFEEDERval&quot;, CLLIPRIMOFEEDER);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{	&#xD;
		var i = 0;&#xD;
		&#xD;
		//Ciclo sugli Asset Restituiti&#xD;
		while(AssetFeeder == null &amp;&amp; i&lt;result.size())&#xD;
		{&#xD;
			assetAppoggio = result.get(i).readAsset();&#xD;
			Log.write(LogString+&quot; Ciclo su Asset appoggio (Recuperato): &quot;+String(assetAppoggio.IDAsset));&#xD;
			&#xD;
			var accessoTrovato = false;&#xD;
			var foundFLAGPRIMOFEEDER = false;&#xD;
			var foundNOMEMACROAREA = false;&#xD;
			&#xD;
			var FLAGPRIMOFEEDERasset = &quot;&quot;;&#xD;
			FLAGPRIMOFEEDERasset = null;&#xD;
			var NOMEMACROAREAasset = &quot;&quot;;&#xD;
			NOMEMACROAREAasset = null;&#xD;
			var k = 0;&#xD;
&#xD;
			//Ciclo sugli attributi del singolo Asset&#xD;
			while(!accessoTrovato &amp;&amp; k &lt; assetAppoggio.dettaglioasset.size())&#xD;
			{&#xD;
				var componente = assetAppoggio.dettaglioasset.get(k);&#xD;
				&#xD;
				if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					accessoTrovato = true;&#xD;
					var j = 0;&#xD;
					&#xD;
					while((!foundFLAGPRIMOFEEDER || !foundNOMEMACROAREA) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
					{&#xD;
						var attributo = componente.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGPRIMOFEEDER)&#xD;
						{&#xD;
							foundFLAGPRIMOFEEDER = true;&#xD;
							FLAGPRIMOFEEDERasset = attributo.valoreAttributo;&#xD;
						}&#xD;
						else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA)&#xD;
						{&#xD;
							foundNOMEMACROAREA = true;&#xD;
							NOMEMACROAREAasset = attributo.valoreAttributo;&#xD;
						}&#xD;
						&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				k++;&#xD;
			}&#xD;
			&#xD;
			if(NOMEMACROAREAasset == LavorazioneRichiesta.nomeMacroArea &amp;&amp; FLAGPRIMOFEEDERasset == &quot;Y&quot;)&#xD;
			{&#xD;
				AssetFeeder = ScriptUtil.copy(assetAppoggio);&#xD;
				Log.write(LogString+&quot;Recuperato Asset: &quot;+String(AssetFeeder.IDAsset));&#xD;
				&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Trovato Asset Feeder &quot;+String(AssetFeeder.IDAsset)+&quot; con CLLIPRIMOFEEDER valorizzato con: &quot;+CLLIPRIMOFEEDER+&quot; sottolav FEEDER SUCCESSIVO.&quot;;;&#xD;
				CodiceEsito = &quot;KO_01&quot;;&#xD;
			}&#xD;
			&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
//FEEDERSUCCESSIVO&#xD;
else if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.FEEDERSUCCESSIVO&#xD;
&amp;&amp; NOMEMACROAREA == null)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: MacroArea non presente in input, non è possibile cercare i FEEDER per sottolav FEEDERSUCCESSIVO.&quot;;&#xD;
	CodiceEsito = &quot;KO_01&quot;;&#xD;
} &#xD;
else if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.FEEDERSUCCESSIVO)&#xD;
{&#xD;
	//RICERCA FEEDER SUCCESSIVO ESISTENTE per SOTTOLAV FEEDERSUCCESSIVO&#xD;
	if(CLLIFEEDERSUCCESSIVO != null)&#xD;
	{&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta = 'FEEDER' AND dettaglioasset.nomeComponente = 'ACCESSOFEEDER' AND dettaglioasset.attributidettaglioasset.nomeAttributo = 'CLLIFEEDERSUCCESSIVO' AND dettaglioasset.attributidettaglioasset.valoreAttributo =: CLLIFEEDERSUCCESSIVOval&quot;);&#xD;
		&#xD;
		c.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
		c.setQueryParameter(&quot;CLLIFEEDERSUCCESSIVOval&quot;, CLLIFEEDERSUCCESSIVO);&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		&#xD;
		if(result != null &amp;&amp; result.size() > 0)&#xD;
		{&#xD;
			var i = 0;&#xD;
			&#xD;
			//Ciclo sugli Asset Restituiti&#xD;
			while(AssetFeeder == null &amp;&amp; i&lt;result.size())&#xD;
			{&#xD;
				assetAppoggio = result.get(i).readAsset();&#xD;
				Log.write(LogString+&quot; Ciclo su Asset appoggio (Recuperato): &quot;+String(assetAppoggio.IDAsset));&#xD;
				&#xD;
				var accessoTrovato = false;&#xD;
				var foundNOMEMACROAREA = false;&#xD;
				&#xD;
				var NOMEMACROAREAasset = &quot;&quot;;&#xD;
				NOMEMACROAREAasset = null;&#xD;
				var k = 0;&#xD;
&#xD;
				//Ciclo sugli attributi del singolo Asset&#xD;
				while(!accessoTrovato &amp;&amp; k &lt; assetAppoggio.dettaglioasset.size())&#xD;
				{&#xD;
					var componente = assetAppoggio.dettaglioasset.get(k);&#xD;
					&#xD;
					if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						accessoTrovato = true;&#xD;
						var j = 0;&#xD;
						while((!foundNOMEMACROAREA) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
						{&#xD;
							var attributo = componente.attributidettaglioasset.get(j);&#xD;
							&#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA)&#xD;
							{&#xD;
								foundNOMEMACROAREA = true;&#xD;
								NOMEMACROAREAasset = attributo.valoreAttributo;&#xD;
							}&#xD;
							&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					k++;&#xD;
				}&#xD;
				&#xD;
				if(NOMEMACROAREAasset == NOMEMACROAREA)&#xD;
				{&#xD;
					AssetFeeder = ScriptUtil.copy(assetAppoggio);&#xD;
					Log.write(LogString+&quot;Recuperato Asset: &quot;+String(AssetFeeder.IDAsset));&#xD;
					&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Trovato Asset Feeder &quot;+String(AssetFeeder.IDAsset)+&quot; con CLLIFEEDERSUCCESSIVO valorizzato con: &quot;+CLLIFEEDERSUCCESSIVO+&quot; sottolav FEEDER SUCCESSIVO.&quot;;&#xD;
					CodiceEsito = &quot;KO_01&quot;;&#xD;
				}&#xD;
				&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Log.write(LogString+&quot; CLLIFEEDERSUCCESSIVO mancante, impossibile effettuare la ricerca&quot;);&#xD;
	}&#xD;
	&#xD;
	//RECUPERO CONSISTENZA FEEDER (PRIMOFEEDER) per SOTTOLAV FEEDER SUCCESSIVO&#xD;
	if(EsitoResponse.codice)&#xD;
	{&#xD;
		if(CLLIPRIMOFEEDER != null &amp;&amp; NOMEMACROAREA != null)&#xD;
		{&#xD;
			Log.write(LogString+&quot; recupero consistenza per sottolav FEEDER SUCCESSIVO&quot;);&#xD;
			&#xD;
			var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;codificaOLOAGCOM =: OLO AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'DATI' AND offerta = 'FEEDER' AND dettaglioasset.nomeComponente = 'ACCESSOFEEDER' AND dettaglioasset.attributidettaglioasset.nomeAttributo = 'CLLIPRIMOFEEDER' AND dettaglioasset.attributidettaglioasset.valoreAttributo =: CLLIPRIMOFEEDERval&quot;);&#xD;
		&#xD;
			c.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
			c.setQueryParameter(&quot;CLLIPRIMOFEEDERval&quot;, CLLIPRIMOFEEDER);&#xD;
			var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			&#xD;
			if(result != null &amp;&amp; result.size() > 0)&#xD;
			{	&#xD;
				var i = 0;&#xD;
			&#xD;
				//Ciclo sugli Asset Restituiti&#xD;
				while(AssetFeeder == null &amp;&amp; i&lt;result.size())&#xD;
				{&#xD;
					assetAppoggio = result.get(i).readAsset();&#xD;
					Log.write(LogString+&quot; Ciclo su Asset appoggio (Recuperato): &quot;+String(assetAppoggio.IDAsset));&#xD;
					&#xD;
					var accessoTrovato = false;&#xD;
					var foundFLAGPRIMOFEEDER = false;&#xD;
					var foundNOMEMACROAREA = false;&#xD;
					&#xD;
					var FLAGPRIMOFEEDERasset = &quot;&quot;;&#xD;
					FLAGPRIMOFEEDERasset = null;&#xD;
					var NOMEMACROAREAasset = &quot;&quot;;&#xD;
					NOMEMACROAREAasset = null;&#xD;
					var k = 0;&#xD;
&#xD;
					//Ciclo sugli attributi del singolo Asset&#xD;
					while(!accessoTrovato &amp;&amp; k &lt; assetAppoggio.dettaglioasset.size())&#xD;
					{&#xD;
						var componente = assetAppoggio.dettaglioasset.get(k);&#xD;
						&#xD;
						if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
						{&#xD;
							accessoTrovato = true;&#xD;
							var j = 0;&#xD;
							&#xD;
							while((!foundFLAGPRIMOFEEDER || !foundNOMEMACROAREA) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
							{&#xD;
								var attributo = componente.attributidettaglioasset.get(j);&#xD;
								&#xD;
								if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGPRIMOFEEDER)&#xD;
								{&#xD;
									foundFLAGPRIMOFEEDER = true;&#xD;
									FLAGPRIMOFEEDERasset = attributo.valoreAttributo;&#xD;
								}&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA)&#xD;
								{&#xD;
									foundNOMEMACROAREA = true;&#xD;
									NOMEMACROAREAasset = attributo.valoreAttributo;&#xD;
								}&#xD;
								&#xD;
								j++;&#xD;
							}&#xD;
						}&#xD;
						k++;&#xD;
					}&#xD;
					&#xD;
					if(NOMEMACROAREAasset == NOMEMACROAREA &amp;&amp; FLAGPRIMOFEEDERasset == &quot;Y&quot;)&#xD;
					{&#xD;
						AssetFeeder = ScriptUtil.copy(assetAppoggio);&#xD;
						Log.write(LogString+&quot;Recuperato Asset: &quot;+String(AssetFeeder.IDAsset));&#xD;
					}&#xD;
					&#xD;
					i++;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if(AssetFeeder != null)&#xD;
			{&#xD;
				Log.write(LogString+&quot;Creazione componente Consistenza Feeder: &quot;+String(AssetFeeder.IDAsset));&#xD;
			&#xD;
				ConsistenzaFeeder = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFeederType();&#xD;
				&#xD;
				ConsistenzaFeeder.azione = &quot;N&quot;;&#xD;
				&#xD;
				ConsistenzaFeeder.IDRisorsa = AssetFeeder.IDRisorsa;&#xD;
&#xD;
				ConsistenzaFeeder.IDRisorsaNOW = AssetFeeder.IDRisorsaNOW;&#xD;
&#xD;
				ConsistenzaFeeder.IDRisorsaFeeder = AssetFeeder.IDRisorsa;&#xD;
&#xD;
				ConsistenzaFeeder.offerta = String(AssetFeeder.offerta);&#xD;
				&#xD;
				ConsistenzaFeeder.codificaOLOAGCOMDonating = AssetFeeder.codificaOLOAGCOM;&#xD;
				&#xD;
				ConsistenzaFeeder.codiceOrdineTI = AssetFeeder.codiceOrdineTI;&#xD;
&#xD;
				ConsistenzaFeeder.codiceOrdineOLO = AssetFeeder.codiceOrdineOLO;&#xD;
&#xD;
				ConsistenzaFeeder.IDAsset = AssetFeeder.IDAsset;&#xD;
				&#xD;
				var BANDA = false;&#xD;
				var CODICETDKIT = false;&#xD;
				var CLLIPRIMOFEEDER = false;&#xD;
				var CLLIFEEDERSUCCESSIVO = false;&#xD;
				var ABILITATOMC = false;&#xD;
				var NOMEMACROAREA = false;&#xD;
				var ASNUMBER = false;&#xD;
				var IPSESSIONE = false;&#xD;
				var CODICEMACROAREA = false;&#xD;
				var IDMADRCRMWS = false;&#xD;
				var FLAGPRIMOFEEDER = false;&#xD;
				var NOMEBOUQUET = false;&#xD;
				&#xD;
				var accessoTrovato = false;&#xD;
				var i = 0;&#xD;
				&#xD;
				// Recupero Dati dall'asset&#xD;
				while(!accessoTrovato &amp;&amp; i &lt; AssetFeeder.dettaglioasset.size())&#xD;
				{&#xD;
					var componente = AssetFeeder.dettaglioasset.get(i);&#xD;
					&#xD;
					if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						accessoTrovato = true;&#xD;
						var j = 0;&#xD;
						while((!BANDA || !CODICETDKIT || !CLLIPRIMOFEEDER || !CLLIFEEDERSUCCESSIVO || !ABILITATOMC || !NOMEMACROAREA || !ASNUMBER || !IPSESSIONE|| !CODICEMACROAREA|| !IDMADRCRMWS|| !FLAGPRIMOFEEDER|| !NOMEBOUQUET) &#xD;
							&amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
						{&#xD;
							var attributo = componente.attributidettaglioasset.get(j);&#xD;
							&#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
							{&#xD;
								BANDA = true;&#xD;
								ConsistenzaFeeder.banda = attributo.valoreAttributo;&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
							{&#xD;
								CODICETDKIT = true;&#xD;
								ConsistenzaFeeder.codiceTdKit = attributo.valoreAttributo;&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIPRIMOFEEDER)&#xD;
							{&#xD;
								CLLIPRIMOFEEDER = true;&#xD;
								ConsistenzaFeeder.CLLIPrimoFeeder = attributo.valoreAttributo;&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIFEEDERSUCCESSIVO)&#xD;
							{&#xD;
								CLLIFEEDERSUCCESSIVO = true;&#xD;
								ConsistenzaFeeder.CLLIFeederSuccessivo = attributo.valoreAttributo;&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ABILITATOMC)&#xD;
							{&#xD;
								ABILITATOMC = true;&#xD;
								ConsistenzaFeeder.abilitatoMC = attributo.valoreAttributo;&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA)&#xD;
							{&#xD;
								NOMEMACROAREA = true;&#xD;
								ConsistenzaFeeder.nomeMacroArea = attributo.valoreAttributo;&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ASNUMBER)&#xD;
							{&#xD;
								ASNUMBER = true;&#xD;
								ConsistenzaFeeder.ASNumber = attributo.valoreAttributo;&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPSESSIONE)&#xD;
							{&#xD;
								IPSESSIONE = true;&#xD;
								ConsistenzaFeeder.IPSessione = attributo.valoreAttributo;&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEMACROAREA)&#xD;
							{&#xD;
								CODICEMACROAREA = true;&#xD;
								ConsistenzaFeeder.codiceMacroArea = attributo.valoreAttributo;&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDMADRCRMWS)&#xD;
							{&#xD;
								IDMADRCRMWS = true;&#xD;
								ConsistenzaFeeder.IDMadrCRMWS = attributo.valoreAttributo;&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGPRIMOFEEDER)&#xD;
							{&#xD;
								FLAGPRIMOFEEDER = true;&#xD;
								ConsistenzaFeeder.flagPrimoFeeder = attributo.valoreAttributo;&#xD;
							}&#xD;
							else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEBOUQUET)&#xD;
							{&#xD;
								NOMEBOUQUET = true;&#xD;
								ConsistenzaFeeder.nomeBouquet = attributo.valoreAttributo;&#xD;
							}&#xD;
&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					i++;&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset Feeder non trovato con CLLIPRIMOFEEDER: &quot;+CLLIPRIMOFEEDER+&quot; OLO: &quot;+localRequest.codificaOLOAGCOM+&quot;, NOMEMACROAREA: &quot;+LavorazioneRichiesta.nomeMacroArea;&#xD;
				CodiceEsito = &quot;KO_02&quot;;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: CLLIPRIMOFEEDER: &quot;+CLLIPRIMOFEEDER+&quot; o NOMEMACROAREA: &quot;+NOMEMACROAREA+&quot; non trovato per effettuare la ricerca di AssetFeeder&quot;;&#xD;
			CodiceEsito = &quot;KO_02&quot;;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(LogString+EsitoResponse.descrizione);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="88.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="176.0">
              <xpdl2:Coordinates XCoordinate="887.0" YCoordinate="1504.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_WMUhUBF2EeyN2L0yjoZgiA" Name="AutoespletanteNPNGCAMBIOOLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Autoespletante NPNG (CAMBIOOLO)" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Aggiunto con RU_1203&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
&#xD;
var assetNPNG = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetNPNG = null;&#xD;
&#xD;
var LogString = &quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task AutoEspletante NPNG CAMBIOOLO | &quot;;&#xD;
&#xD;
Log.write(LogString + &quot;Verifica servizio in consistenza AutoEspletante NPNG CAMBIOOLO&quot;);&#xD;
&#xD;
//--------------------------------------------------RECUPERO ASSET-------------------------------------------------//&#xD;
&#xD;
if(localRequest.IDRisorsa != null &amp;&amp; localRequest.IDRisorsa != &quot;&quot;)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta = 'NPNG'&quot;);&#xD;
	c.setQueryParameter(&quot;idr&quot;, localRequest.IDRisorsa);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	//Unica consistenza&#xD;
	if(result != null &amp;&amp; result.size() == 1)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		assetNPNG = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		Log.write(LogString+&quot;Recuperato per IDRisorsa Asset: &quot;+String(assetNPNG.IDAsset));&#xD;
	}&#xD;
	//Più consistenze&#xD;
	else if(result != null &amp;&amp; result.size() > 1)&#xD;
	{	&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: sono stati recuperati più risultati di Consistenza aventi DN: &quot;+localRequest.IDRisorsa;&#xD;
		CodiceEsito = &quot;KO_09&quot;;	&#xD;
	}	&#xD;
	//Nessuna consistenza&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: non è stata recuperata nessuna consistenza NPNG avente DN: &quot;+localRequest.IDRisorsa;&#xD;
		CodiceEsito = &quot;KO_40&quot;;&#xD;
	}&#xD;
&#xD;
	&#xD;
	if(assetNPNG != null)&#xD;
	{&#xD;
		// ---- CONSISTENZA NPNG ----&#xD;
		Log.write(LogString+&quot;Creazione componente Consistenza NPNG: &quot;+String(assetNPNG.IDAsset));&#xD;
		&#xD;
		ConsistenzaNPNG = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaNPNGType();&#xD;
		&#xD;
		ConsistenzaNPNG.azione = &quot;D&quot;;&#xD;
		&#xD;
		ConsistenzaNPNG.IDRisorsa = assetNPNG.IDRisorsa;&#xD;
&#xD;
		ConsistenzaNPNG.IDRisorsaNOW = assetNPNG.IDRisorsaNOW;&#xD;
&#xD;
		ConsistenzaNPNG.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetNPNG.offerta));&#xD;
		&#xD;
		ConsistenzaNPNG.codificaOLOAGCOMDonating = assetNPNG.codificaOLOAGCOM;&#xD;
		&#xD;
		ConsistenzaNPNG.codiceOrdineTI = assetNPNG.codiceOrdineTI;&#xD;
&#xD;
		ConsistenzaNPNG.codiceOrdineOLO = assetNPNG.codiceOrdineOLO;&#xD;
&#xD;
		ConsistenzaNPNG.IDAsset = assetNPNG.IDAsset;&#xD;
&#xD;
		ConsistenzaNPNG.numeroTelefonico = assetNPNG.numeroTelefonico;&#xD;
&#xD;
		ConsistenzaNPNG.numeroTelefonicoPrincipale = assetNPNG.numTelPrincipale;&#xD;
&#xD;
		ConsistenzaNPNG.numeroFittizio = assetNPNG.numeroFittizio;&#xD;
		&#xD;
		&#xD;
		var OPZIONETRAFFICO = false;&#xD;
		var TIPOPROVISIONING = false;&#xD;
		var ROUTINGNUMBER = false;&#xD;
		var UO = false;&#xD;
		var DSC = false;&#xD;
		var CODICEOPERATOREDONOR = false;&#xD;
		&#xD;
		var i=0;&#xD;
		var accessoTrovato = false;&#xD;
		&#xD;
		while(!accessoTrovato &amp;&amp; i&lt;assetNPNG.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetNPNG.dettaglioasset.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j=0;&#xD;
				&#xD;
				while((!OPZIONETRAFFICO || !TIPOPROVISIONING || !ROUTINGNUMBER || !UO || !DSC || !CODICEOPERATOREDONOR) &amp;&amp; j&lt;componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO)&#xD;
					{&#xD;
						OPZIONETRAFFICO = true;&#xD;
						ConsistenzaNPNG.opzioneTraffico = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROVISIONING)&#xD;
					{&#xD;
						TIPOPROVISIONING = true;&#xD;
						ConsistenzaNPNG.tipoProvisioning = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER)&#xD;
					{&#xD;
						ROUTINGNUMBER = true;&#xD;
						ConsistenzaNPNG.routingNumber = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.UO)&#xD;
					{&#xD;
						UO = true;&#xD;
						ConsistenzaNPNG.UO = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC)&#xD;
					{&#xD;
						DSC = true;&#xD;
						ConsistenzaNPNG.DSC = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR)&#xD;
					{&#xD;
						CODICEOPERATOREDONOR = true;&#xD;
						ConsistenzaNPNG.codiceOperatoreDonor = attributo.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		ConsistenzaNPNG.invioaDTU = 'N';&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(LogString+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
