        <xpdl2:Activity Id="_mUgRB9c-EeawK-VRC_DmUQ" Name="VerificaCompatibilitTipoLineasuISDN" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Compatibilità Tipo Linea su ISDN">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA ISDN fallito: dati insufficienti per eseguire il controllo&quot;;&#xD;
&#xD;
&#xD;
if(ConsistenzaFonia.tipoLinea == &quot;ISDN&quot;&#xD;
	|| (ConsistenzaFonia.destinazioneUso!=null &amp;&amp; (ConsistenzaFonia.destinazioneUso.slice(0,1)==&quot;2&quot; || ConsistenzaFonia.destinazioneUso.slice(0,1)==&quot;3&quot;)))&#xD;
{&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
		&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO)&#xD;
	{&#xD;
		if(ConsistenzaDati != null)&#xD;
		{&#xD;
			if(ConsistenzaDati.tipoLinea == &quot;ISDN&quot;)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA ISDN passato: Sottolavorazione MIGRAZIONEOLO e tipoLinea della ConsistenzaDati: &quot; + ConsistenzaDati.tipoLinea;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA ISDN fallito: Sottolavorazione MIGRAZIONEOLO e tipoLinea della ConsistenzaDati: &quot; + ConsistenzaDati.tipoLinea;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA ISDN fallito: ConsistenzaDati mancante&quot;;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA ISDN passato: Offerta Donating: &quot; + ConsistenzaFonia.offerta;&#xD;
				LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
				LavorazioneRichiesta.tipoLinea = &quot;ISDN&quot;;&#xD;
				storicizza=true;&#xD;
		&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA ISDN saltato per precondizione: TipoLinea non di tipo ISDN&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
