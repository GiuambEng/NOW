          </xpdl2:Implementation>
          <xpdl2:Performers>
            <xpdl2:Performer>_5CTxoMegEea-PIfovU0abw</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="75.0" LaneId="_lG1rIcbDEeatjZjsZIIi5Q" Width="125.0">
              <xpdl2:Coordinates XCoordinate="317.0" YCoordinate="231.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">RecuperoIDRisorsaRequest = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createRecupero_IDRisorsa_RequestType();&#xD;
&#xD;
RecuperoIDRisorsaRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
&#xD;
if((localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274&#xD;
 	||  localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO)&#xD;
	&amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
{&#xD;
if(localRequest.codiceRisorsaDonating != null &amp;&amp; localRequest.codiceRisorsaDonating != &quot;&quot; &amp;&amp; localRequest.cowCodeOLO == &quot;TLC&quot;)&#xD;
	{&#xD;
		RecuperoIDRisorsaRequest.numeroTelefonico = localRequest.codiceRisorsaDonating;&#xD;
	}&#xD;
	//SM_8130&#xD;
	else if(localRequest.codiceRisorsaDonating2 != null &amp;&amp; localRequest.codiceRisorsaDonating2 != &quot;&quot; &amp;&amp; localRequest.cowCodeOLO2 == &quot;TLC&quot;)&#xD;
		{&#xD;
			RecuperoIDRisorsaRequest.numeroTelefonico = localRequest.codiceRisorsaDonating2;&#xD;
		}	&#xD;
}&#xD;
else&#xD;
{&#xD;
	RecuperoIDRisorsaRequest.numeroTelefonico = localRequest.numeroTelefonico;&#xD;
}&#xD;
&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR)&#xD;
&amp;&amp;&#xD;
InventoryPrincipale!= null &amp;&amp; InventoryPrincipale.datiUnica!= null &amp;&amp; InventoryPrincipale.datiUnica.caposerie != null){// identifica se aggiuntivi PBX){&#xD;
	for(var i=0; i&lt;InventoryPrincipale.aggiuntiviUnica.size(); i++){&#xD;
		var numAgg = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createNumerazione_AggiuntivaType();&#xD;
		numAgg.numerazioneAggiuntiva = InventoryPrincipale.aggiuntiviUnica.get(i).numeroTelefonico;&#xD;
	&#xD;
		RecuperoIDRisorsaRequest.numerazione_Aggiuntiva.add(numAgg);&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
