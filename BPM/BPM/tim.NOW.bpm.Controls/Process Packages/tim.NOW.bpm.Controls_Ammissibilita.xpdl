&#xD;
		ConsistenzaDati.codiceOrdineOLO = assetFWA.codiceOrdineOLO;&#xD;
&#xD;
		ConsistenzaDati.IDAsset = assetFWA.IDAsset;&#xD;
&#xD;
		ConsistenzaDati.numeroTelefonico = assetFWA.numeroTelefonico;&#xD;
&#xD;
		ConsistenzaDati.numeroTelefonicoPrincipale = assetFWA.numTelPrincipale;&#xD;
&#xD;
		ConsistenzaDati.numeroFittizio = assetFWA.numeroFittizio;&#xD;
		&#xD;
		&#xD;
		var TIPOLOGIACPE = false;&#xD;
		var FLAGINTERVENTO = false;&#xD;
		var IMSI = false;&#xD;
		var IMEI = false;&#xD;
		var MSISDN = false;&#xD;
		var PROFILO = false;&#xD;
		&#xD;
		var i=0;&#xD;
		var accessoTrovato = false;&#xD;
		&#xD;
		while(!accessoTrovato &amp;&amp; i&lt;assetFWA.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetFWA.dettaglioasset.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j=0;&#xD;
				&#xD;
				while((!TIPOLOGIACPE || !FLAGINTERVENTO || !IMSI || !IMEI || !MSISDN || !PROFILO) &amp;&amp; j&lt;componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACPE)&#xD;
					{&#xD;
						TIPOLOGIACPE = true;&#xD;
						ConsistenzaDati.tipologiaCpe = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGINTERVENTO)&#xD;
					{&#xD;
						FLAGINTERVENTO = true;&#xD;
						ConsistenzaDati.flagIntervento = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IMSI)&#xD;
					{&#xD;
						IMSI = true;&#xD;
						ConsistenzaDati.imsi = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IMEI)&#xD;
					{&#xD;
						IMEI = true;&#xD;
						ConsistenzaDati.imei = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MSISDN)&#xD;
					{&#xD;
						MSISDN = true;&#xD;
						ConsistenzaDati.msisdn = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILO)&#xD;
					{&#xD;
						PROFILO = true;&#xD;
						ConsistenzaDati.profilo = attributo.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(LogString+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="165.0">
              <xpdl2:Coordinates XCoordinate="890.0" YCoordinate="2159.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_0iFkgNyMEe6ObbN4EiNagg" Name="CessazioneFIBERSTREAM" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Cessazione FIBERSTREAM" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">	EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;&quot;;&#xD;
	CodiceEsito = null;&#xD;
&#xD;
	var assetDati = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
	assetDati = null;&#xD;
&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione FIBER STREAM | Verifica servizio in consistenza Cessazione FIBER STREAM.&quot;);&#xD;
&#xD;
	if(localRequest.IDRisorsa != null &amp;&amp; localRequest.IDRisorsa != &quot;&quot;)&#xD;
	{&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset =: ida AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND codificaOLOAGCOM =: codificaOLOAGCOMRichiesta AND tipologiaAccesso = 'DATI'&quot;);&#xD;
		c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(VerificaIDRisorsaResponse.datiAccesso.idAsset));&#xD;
		c.setQueryParameter(&quot;codificaOLOAGCOMRichiesta&quot;, localRequest.codificaOLOAGCOM);&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		if(result != null &amp;&amp; result.size() > 0)&#xD;
		{&#xD;
			AssetRef = result.get(0);&#xD;
			assetDati = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		}&#xD;
		&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione FIBER STREAM | Trovato Asset per idAsset=&quot;+VerificaIDRisorsaResponse.datiAccesso.idAsset+&quot;, con OLOAGCOM=&quot;+localRequest.codificaOLOAGCOM);&#xD;
	}&#xD;
&#xD;
&#xD;
	if(result != null &amp;&amp; result.size() > 1 &amp;&amp; !(assetDati.offerta == 'NP'))&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: asset recuperato non univoco.&quot;;&#xD;
		CodiceEsito = &quot;KO_01&quot;;&#xD;
	}&#xD;
	else if(assetDati != null)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione FIBER STREAM | Creazione componente ConsistenzaDati: &quot;+assetDati.IDAsset);&#xD;
		&#xD;
		ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();		&#xD;
		//AZIONE&#xD;
		ConsistenzaDati.azione = &quot;M&quot;;		&#xD;
		//IDRISORSA&#xD;
		ConsistenzaDati.IDRisorsa = assetDati.IDRisorsa;		&#xD;
		//IDRISORSANOW&#xD;
		ConsistenzaDati.IDRisorsaNOW = assetDati.IDRisorsaNOW;	&#xD;
		//IDRISORSAOPENFIBER&#xD;
		ConsistenzaDati.idRisorsaOpenFiber = assetDati.idRisorsaOpenFiber;	&#xD;
		//OFFERTA&#xD;
		ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetDati.offerta));		&#xD;
		//CODIFICAOLOAGCOMDONATING&#xD;
		ConsistenzaDati.codificaOLOAGCOMDonating = assetDati.codificaOLOAGCOM;&#xD;
		//CODICEORDINETI&#xD;
		ConsistenzaDati.codiceOrdineTI = assetDati.codiceOrdineTI;		&#xD;
		//CODICEORDINEOLO&#xD;
		ConsistenzaDati.codiceOrdineOLO = assetDati.codiceOrdineOLO;		&#xD;
		//IDENTIFICATIVOASSET&#xD;
		ConsistenzaDati.IDAsset = assetDati.IDAsset;&#xD;
		&#xD;
		//CARATTERIZZAZIONEAREA - RU_1524&#xD;
		ConsistenzaDati.caratterizzazioneArea = assetDati.caratterizzazioneArea;&#xD;
		localRequest.caratterizzazioneArea = assetDati.caratterizzazioneArea;&#xD;
		localRequest.ordine.caratterizzazioneArea = assetDati.caratterizzazioneArea;&#xD;
		&#xD;
		&#xD;
		//PROFILOTECNICOLINEA SM_11292 &#xD;
		var PROFILOTECNICOLINEA = false;&#xD;
		&#xD;
		var i=0;&#xD;
		var accessoTrovato = false;&#xD;
			&#xD;
		while(!accessoTrovato &amp;&amp; i&lt;assetDati.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetDati.dettaglioasset.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j=0;&#xD;
				&#xD;
				while(!PROFILOTECNICOLINEA &amp;&amp; j&lt;componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
					{&#xD;
						PROFILOTECNICOLINEA = true;&#xD;
						ConsistenzaDati.profiloTecnicoLinea = attributo.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
&#xD;
	if(!EsitoResponse.codice)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione FIBER STREAM | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
	}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="154.0">
              <xpdl2:Coordinates XCoordinate="894.0" YCoordinate="2985.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_B5bZEkhSEfCLI8yfWP7Upw" Name="MigrazioneDEL82B2B" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Migrazione DEL82 B2B">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Script inserito con RU_1546 - MIGR DEL82 - C07 2025&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Recupera Asset Servizio in Consistenza Migrazione DEL82 OK&quot;;&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Verifica servizio in consistenza Migrazione DEL82.&quot;);&#xD;
&#xD;
if(localRequest.codiceRisorsaDonating != null &amp;&amp; localRequest.codiceRisorsaDonating != &quot;&quot;)&#xD;
{	&#xD;
	Asset1 = null;&#xD;
	codiceRisorsa = localRequest.codiceRisorsaDonating;&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | codiceRisorsa: &quot;+localRequest.codiceRisorsaDonating);&#xD;
&#xD;
&#xD;
	var SecondaCifraCodiceRisorsa = codiceRisorsa.charAt(1);&#xD;
	var TerzaCifraCodiceRisorsa = codiceRisorsa.charAt(2);&#xD;
	var codiceRisorsaMod = &quot;&quot;;&#xD;
&#xD;
	//calcolo codice risorsa&#xD;
	if(SecondaCifraCodiceRisorsa == &quot;2&quot; || SecondaCifraCodiceRisorsa == &quot;6&quot;)&#xD;
	{&#xD;
		codiceRisorsaMod = (&quot;0&quot;+codiceRisorsa);&#xD;
	}&#xD;
	else if(TerzaCifraCodiceRisorsa == &quot;0&quot; || TerzaCifraCodiceRisorsa == &quot;1&quot; ||&#xD;
			TerzaCifraCodiceRisorsa == &quot;5&quot; || TerzaCifraCodiceRisorsa == &quot;9&quot;)&#xD;
	{&#xD;
		codiceRisorsaMod = codiceRisorsa;&#xD;
	}&#xD;
	else &#xD;
	{&#xD;
		codiceRisorsaMod = codiceRisorsa.slice(1, codiceRisorsa.length);&#xD;
	}&#xD;
&#xD;
	//IDRisorsa&#xD;
	//SM_11964: Aggiunto statoAsset nella ricerca&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta IN ('VULAFTTH','BITSTREAMNGAFTTH','EASYIPNGAFTTH','SEMIVULAFTTH','FULLGPONPLUS','FULLGPONPLUSNGA')&quot;);&#xD;
	c.setQueryParameter(&quot;idr&quot;, codiceRisorsa);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size() == 1) //Se trova un solo asset, lo salvo in Asset1&#xD;
	{		&#xD;
		AssetRef = result.get(0);&#xD;
		Asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset: &quot;+String(Asset1.IDAsset));	&#xD;
	}&#xD;
&#xD;
&#xD;
	//NumeroFittizio: faccio la ricerca se quella precedente non ha trovato nulla&#xD;
	if((result == null || result.size() == 0) &amp;&amp; codiceRisorsa != &quot;&quot; &amp;&amp; codiceRisorsaMod != &quot;&quot;)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Ricerca Asset1 per NUMERO FITTIZIO = codiceRisorsa: &quot; + codiceRisorsaMod + &quot; or &quot; + codiceRisorsa);&#xD;
		c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;(numeroFittizio =: NF OR numeroFittizio =: NF1) AND offerta IN ('VULAFTTH','BITSTREAMNGAFTTH','EASYIPNGAFTTH','SEMIVULAFTTH','FULLGPONPLUS','FULLGPONPLUSNGA')&quot;);&#xD;
		c.setQueryParameter(&quot;NF&quot;, codiceRisorsaMod);&#xD;
		c.setQueryParameter(&quot;NF1&quot;, codiceRisorsa);&#xD;
		result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		&#xD;
		if(result!= null &amp;&amp; result.size() == 1) //Se trova un solo asset, lo salvo in Asset1&#xD;
		{&#xD;
			AssetRef = result.get(0);&#xD;
			Asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset: &quot;+String(Asset1.IDAsset));&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//SM_11661: trova più asset -> considera per priorità quello ATTIVO, altrimenti quello INLAVORAZIONE, altrimenti quello CESSATO&#xD;
	if(result != null &amp;&amp; result.size() > 1)&#xD;
	{&#xD;
		//ATTIVO&#xD;
		for(var m=0; m&lt;result.size(); m++)&#xD;
		{&#xD;
			var AssetRefM = result.get(m);&#xD;
			var AssetM = ScriptUtil.copy(AssetRefM.readAsset());&#xD;
			&#xD;
			if(AssetM.statoAsset == &quot;ATTIVO&quot;)&#xD;
			{&#xD;
				AssetRef = AssetRefM;&#xD;
				Asset1 = ScriptUtil.copy(AssetM);&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset: &quot;+String(Asset1.IDAsset));&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//INLAVORAZIONE&#xD;
		if(Asset1 == null)&#xD;
		{&#xD;
			for(var m=0; m&lt;result.size(); m++)&#xD;
			{&#xD;
				var AssetRefM = result.get(m);&#xD;
				var AssetM = ScriptUtil.copy(AssetRefM.readAsset());&#xD;
				&#xD;
				if(AssetM.statoAsset == &quot;INLAVORAZIONE&quot;)&#xD;
				{&#xD;
					AssetRef = AssetRefM;&#xD;
					Asset1 = ScriptUtil.copy(AssetM);&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset: &quot;+String(Asset1.IDAsset));&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//DIVERSO DA ATTIVO E INLAVORAZIONE&#xD;
		if(Asset1 == null)&#xD;
		{&#xD;
			AssetRef = result.get(0);&#xD;
			Asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset: &quot;+String(Asset1.IDAsset));&#xD;
		}&#xD;
	}&#xD;
&#xD;
    &#xD;
	//NON TROVA ALCUN ASSET - nè ATTIVO nè INLAVORAZIONE nè CESSATO&#xD;
	if(Asset1 == null)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: dati insufficienti per eseguire il controllo.&quot;;&#xD;
		CodiceEsito = &quot;KO_27&quot;;&#xD;
	}	&#xD;
	else&#xD;
	{&#xD;
		if(Asset1.statoAsset == &quot;ATTIVO&quot;)&#xD;
		{&#xD;
			assetDatiMig = ScriptUtil.copy(Asset1);&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato Asset1 in stato ATTIVO&quot;);&#xD;
		}&#xD;
		else if(Asset1.statoAsset == &quot;INLAVORAZIONE&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: dati insufficienti per eseguire il controllo.&quot;;&#xD;
			CodiceEsito = &quot;KO_25&quot;;&#xD;
		}&#xD;
		else //diverso da ATTIVO e INLAVORAZIONE&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: dati insufficienti per eseguire il controllo.&quot;;&#xD;
			CodiceEsito = &quot;KO_26&quot;;&#xD;
		}&#xD;
	}&#xD;
&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: dati insufficienti per eseguire il controllo.&quot;;&#xD;
	CodiceEsito = &quot;KO_27&quot;;&#xD;
}&#xD;
&#xD;
// ---------------- LOG ESITO KO ----------------&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}&#xD;
&#xD;
//Va solo per statoAsset = ATTIVO&#xD;
if(assetDatiMig != null)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato assetDatiMig: &quot;+String(assetDatiMig.IDAsset));&#xD;
&#xD;
	ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();&#xD;
&#xD;
	ConsistenzaDati.azione = &quot;D&quot;;&#xD;
	ConsistenzaDati.IDRisorsa = assetDatiMig.IDRisorsa;&#xD;
	ConsistenzaDati.IDRisorsaNOW = assetDatiMig.IDRisorsaNOW;&#xD;
	ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetDatiMig.offerta));&#xD;
	ConsistenzaDati.codificaOLOAGCOMDonating = assetDatiMig.codificaOLOAGCOM;&#xD;
	ConsistenzaDati.codificaOLOAGCOMDonor = assetDatiMig.codificaOLOAGCOMDonor;&#xD;
&#xD;
	if(localRequest.cowCodeOLO!= null &amp;&amp; localRequest.cowCodeOLO!= &quot;&quot;)&#xD;
	{&#xD;
		ConsistenzaDati.cowCode = localRequest.cowCodeOLO;&#xD;
	}&#xD;
	&#xD;
	if(localRequest.codiceSessione!= null &amp;&amp; localRequest.codiceSessione!= &quot;&quot;)&#xD;
	{&#xD;
		ConsistenzaDati.codiceSessione = localRequest.codiceSessione;&#xD;
	}&#xD;
	&#xD;
	if(ConsistenzaDati.tipoLinea == &quot;LineaNonFonia&quot;) &#xD;
	{&#xD;
		ConsistenzaDati.flagBTSNaked = 'Y';&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		ConsistenzaDati.flagBTSNaked = 'N';&#xD;
	}&#xD;
		&#xD;
	ConsistenzaDati.codiceOrdineTI = assetDatiMig.codiceOrdineTI;&#xD;
	ConsistenzaDati.codiceOrdineOLO = assetDatiMig.codiceOrdineOLO;&#xD;
	ConsistenzaDati.IDAsset = assetDatiMig.IDAsset;&#xD;
	ConsistenzaDati.numeroTelefonico = assetDatiMig.numeroTelefonico;&#xD;
	ConsistenzaDati.numeroTelefonicoPrincipale = assetDatiMig.numTelPrincipale;&#xD;
	ConsistenzaDati.numeroFittizio = assetDatiMig.numeroFittizio;&#xD;
	ConsistenzaDati.operatoreRete = assetDatiMig.operatoreRete;		&#xD;
	&#xD;
	ConsistenzaDati.assetBTWhiteList = assetDatiMig.assetBTWhiteList; &#xD;
						&#xD;
	if(ConsistenzaDati.assetBTWhiteList != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
	}&#xD;
	&#xD;
	ConsistenzaDati.statoDisabilitazioneAsset = assetDatiMig.statoDisAsset;&#xD;
	&#xD;
	//RU_1558&#xD;
	ConsistenzaDati.ontOperatore = assetDatiMig.ontOperatore;&#xD;
	ConsistenzaDati.modelloServizioPerValidazioni = assetDatiMig.modelServPerValidazioni;&#xD;
&#xD;
&#xD;
	var TIPOLINEA = false;&#xD;
	var STRUTTURALINEA = false;&#xD;
	var DESTINAZIONEUSO = false;&#xD;
	var DIREZIONALITA = false;&#xD;
	var PROFILOTECNICOLINEA = false;&#xD;
	var USERVLAN1TAGGING = false;&#xD;
	var ENCAPSULATION = false;&#xD;
	var TIPOLOGIACLUSTERCOMUNE = false;&#xD;
	var SEMIFIBRAFTTH = false; &#xD;
	var ROEFFIB = false; &#xD;
	var CARATTERIZZAZIONEGEO = false; &#xD;
	var FULLGPONPLUS = false;&#xD;
	var MODALITACONSEGNA = false; //RU_1614&#xD;
	&#xD;
	var i = 0;&#xD;
	var accessoTrovato = false;&#xD;
	while(!accessoTrovato &amp;&amp; i &lt; assetDatiMig.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetDatiMig.dettaglioasset.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			accessoTrovato = true;&#xD;
			var j = 0;&#xD;
			while((!DIREZIONALITA || !DESTINAZIONEUSO || !TIPOLINEA || !STRUTTURALINEA || !PROFILOTECNICOLINEA || !USERVLAN1TAGGING || !ENCAPSULATION || !TIPOLOGIACLUSTERCOMUNE || !SEMIFIBRAFTTH || !ROEFFIB || !CARATTERIZZAZIONEGEO || !FULLGPONPLUS || !MODALITACONSEGNA) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA)&#xD;
				{&#xD;
					DIREZIONALITA = true;&#xD;
					ConsistenzaDati.direzionalita = attributo.valoreAttributo;&#xD;
				}								&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
				{&#xD;
					DESTINAZIONEUSO = true;&#xD;
					ConsistenzaDati.destinazioneUso = attributo.valoreAttributo;&#xD;
				}								&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					TIPOLINEA = true;&#xD;
					ConsistenzaDati.tipoLinea = attributo.valoreAttributo;&#xD;
				}								&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
				{&#xD;
					STRUTTURALINEA = true;&#xD;
					ConsistenzaDati.strutturaLinea = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
				{&#xD;
					PROFILOTECNICOLINEA = true;&#xD;
					ConsistenzaDati.profiloTecnicoLinea = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING)&#xD;
				{&#xD;
					USERVLAN1TAGGING = true;&#xD;
					ConsistenzaDati.uservlan1Tagging = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
				{&#xD;
					ENCAPSULATION = true;&#xD;
					ConsistenzaDati.encapsulation = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE) &#xD;
				{&#xD;
					TIPOLOGIACLUSTERCOMUNE = true;&#xD;
					ConsistenzaDati.tipologiaClusterComune = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SEMIFIBRAFTTH) &#xD;
				{&#xD;
					SEMIFIBRAFTTH = true;&#xD;
					ConsistenzaDati.semiFibraFTTH = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROEFFIB) &#xD;
				{&#xD;
					ROEFFIB = true;&#xD;
					ConsistenzaDati.roeFFIB = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO) &#xD;
				{&#xD;
					CARATTERIZZAZIONEGEO = true;&#xD;
					ConsistenzaDati.caratterizzazioneGEO = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FULLGPONPLUS) &#xD;
				{&#xD;
					FULLGPONPLUS = true;&#xD;
					ConsistenzaDati.fullGponPlus = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MODALITACONSEGNA) //RU_1614&#xD;
				{&#xD;
					MODALITACONSEGNA = true;&#xD;
					ConsistenzaDati.modalitaConsegna = attributo.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}&#xD;
&#xD;
&#xD;
	ConsistenzaDati.opzioneDinamica = assetDatiMig.opzioneDinamica;&#xD;
&#xD;
	var cclionuTrovato = false;&#xD;
	var i=0;	&#xD;
	while(!cclionuTrovato &amp;&amp; i &lt; assetDatiMig.dettaglioasset.size())&#xD;
	{&#xD;
		var currentComponente = assetDatiMig.dettaglioasset.get(i);&#xD;
		&#xD;
		if (String(currentComponente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while (j &lt; currentComponente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var currentAttributo = currentComponente.attributidettaglioasset.get(j);&#xD;
				if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CCLIONU)&#xD;
				{&#xD;
					ConsistenzaDati.cclionu = currentAttributo.valoreAttributo;&#xD;
					cclionuTrovato = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
