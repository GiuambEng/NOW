        <xpdl2:Activity Id="_ahvCYBF2EeyN2L0yjoZgiA" Name="AttivazioneNPNG" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Attivazione NPNG" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Aggiunto con RU_1203&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
&#xD;
var assetNPNG = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetNPNG = null;&#xD;
&#xD;
var LogString = &quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione NPNG | &quot;;&#xD;
&#xD;
Log.write(LogString + &quot;Verifica servizio in consistenza Attivazione NPNG&quot;);&#xD;
&#xD;
//--------------------------------------------------RECUPERO ASSET-------------------------------------------------//&#xD;
&#xD;
if(localRequest.IDRisorsa != null &amp;&amp; localRequest.IDRisorsa != &quot;&quot;)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta = 'NPNG' AND codificaOLOAGCOM =: OLO&quot;);&#xD;
	c.setQueryParameter(&quot;idr&quot;, localRequest.IDRisorsa);&#xD;
	c.setQueryParameter(&quot;OLO&quot;, localRequest.codificaOLOAGCOM);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	//Unica consistenza&#xD;
	if(result != null &amp;&amp; result.size() == 1)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		assetNPNG = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		Log.write(LogString+&quot;Recuperato per IDRisorsa Asset: &quot;+String(assetNPNG.IDAsset));&#xD;
	}&#xD;
	//Più consistenze&#xD;
	else if(result != null &amp;&amp; result.size() > 1)&#xD;
	{	&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: sono stati recuperati più risultati di Consistenza aventi DN: &quot;+localRequest.IDRisorsa;&#xD;
		CodiceEsito = &quot;KO_01&quot;;	&#xD;
	}	&#xD;
&#xD;
	&#xD;
	if(assetNPNG != null)&#xD;
	{&#xD;
		// ---- CONSISTENZA NPNG ----&#xD;
		Log.write(LogString+&quot;Creazione componente Consistenza NPNG: &quot;+String(assetNPNG.IDAsset));&#xD;
		&#xD;
		ConsistenzaNPNG = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaNPNGType();&#xD;
		&#xD;
		ConsistenzaNPNG.azione = &quot;N&quot;;&#xD;
		&#xD;
		ConsistenzaNPNG.IDRisorsa = assetNPNG.IDRisorsa;&#xD;
&#xD;
		ConsistenzaNPNG.IDRisorsaNOW = assetNPNG.IDRisorsaNOW;&#xD;
&#xD;
		ConsistenzaNPNG.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetNPNG.offerta));&#xD;
		&#xD;
		ConsistenzaNPNG.codificaOLOAGCOMDonating = assetNPNG.codificaOLOAGCOM;&#xD;
		&#xD;
		ConsistenzaNPNG.codiceOrdineTI = assetNPNG.codiceOrdineTI;&#xD;
&#xD;
		ConsistenzaNPNG.codiceOrdineOLO = assetNPNG.codiceOrdineOLO;&#xD;
&#xD;
		ConsistenzaNPNG.IDAsset = assetNPNG.IDAsset;&#xD;
&#xD;
		ConsistenzaNPNG.numeroTelefonico = assetNPNG.numeroTelefonico;&#xD;
&#xD;
		ConsistenzaNPNG.numeroTelefonicoPrincipale = assetNPNG.numTelPrincipale;&#xD;
&#xD;
		ConsistenzaNPNG.numeroFittizio = assetNPNG.numeroFittizio;&#xD;
		&#xD;
		&#xD;
		var OPZIONETRAFFICO = false;&#xD;
		var TIPOPROVISIONING = false;&#xD;
		var ROUTINGNUMBER = false;&#xD;
		var UO = false;&#xD;
		&#xD;
		var i=0;&#xD;
		var accessoTrovato = false;&#xD;
		&#xD;
		while(!accessoTrovato &amp;&amp; i&lt;assetNPNG.dettaglioasset.size())&#xD;
		{&#xD;
			var componente = assetNPNG.dettaglioasset.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				accessoTrovato = true;&#xD;
				var j=0;&#xD;
				&#xD;
				while((!OPZIONETRAFFICO || !TIPOPROVISIONING || !ROUTINGNUMBER || !UO) &amp;&amp; j&lt;componente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO)&#xD;
					{&#xD;
						OPZIONETRAFFICO = true;&#xD;
						ConsistenzaNPNG.opzioneTraffico = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROVISIONING)&#xD;
					{&#xD;
						TIPOPROVISIONING = true;&#xD;
						ConsistenzaNPNG.tipoProvisioning = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER)&#xD;
					{&#xD;
						ROUTINGNUMBER = true;&#xD;
						ConsistenzaNPNG.routingNumber = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.UO)&#xD;
					{&#xD;
						UO = true;&#xD;
						ConsistenzaNPNG.UO = attributo.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		ConsistenzaNPNG.invioaDTU = 'N';&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(LogString+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="169.0">
              <xpdl2:Coordinates XCoordinate="889.0" YCoordinate="2802.0"/>
            </xpdl2:NodeGraphicsInfo>
