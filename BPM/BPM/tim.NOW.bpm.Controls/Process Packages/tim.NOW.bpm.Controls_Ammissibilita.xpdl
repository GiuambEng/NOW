      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_x-rOVsbFEeatjZjsZIIi5Q" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="47.0" LaneId="_x-qAMsbFEeatjZjsZIIi5Q" Width="31.0">
              <xpdl2:Coordinates XCoordinate="1015.0" YCoordinate="232.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_x-rOV8bFEeatjZjsZIIi5Q" Name="VerificaAltroOLincorsostessoOLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Altro OL in corso stesso OLO" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA&#xD;
																										|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA&#xD;
																										|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS  //SM_9345&#xD;
																										|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NPNG))   //RU_1203&#xD;
	|| (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
		&amp;&amp; localRequest.ordine.tipologiaLinea != it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.LINEANONFONIA&#xD;
		&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE)))&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;numeroTelefonico=:DN AND codificaOLOAGCOM=:AGCOM AND created&lt;:currentDate&quot;);&#xD;
&#xD;
	criteria.setQueryParameter(&quot;DN&quot;,localRequest.numeroTelefonico);&#xD;
	criteria.setQueryParameter(&quot;AGCOM&quot;,localRequest.codificaOLOAGCOM);&#xD;
	criteria.setQueryParameter(&quot;currentDate&quot;,localRequest.created);&#xD;
&#xD;
	var list = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
	if(list.size() > 0)&#xD;
	{&#xD;
		for(var i = 0; i &lt; list.size(); i++)&#xD;
		{&#xD;
			var currentRic = list.get(i).readRichiesta();&#xD;
		&#xD;
			//Prendo solo richieste di ATTIVAZIONE&#xD;
			if(currentRic.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
			{&#xD;
				Process.auditLog(&quot;Rimuovo dall'array la richiesta: &quot; + currentRic.IDRichiestaOLO + &quot; poiché non di ATTIVAZIONE&quot;);&#xD;
				list.remove(i);&#xD;
				i--;&#xD;
			}&#xD;
			//Prendo solo offerte SHA BITSTREAM e EASYIP&#xD;
			else if(currentRic.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA&#xD;
					&amp;&amp; currentRic.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA&#xD;
					&amp;&amp; currentRic.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
					&amp;&amp; currentRic.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
					&amp;&amp; currentRic.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
					&amp;&amp; currentRic.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
					&amp;&amp; currentRic.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
					&amp;&amp; currentRic.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
					&amp;&amp; currentRic.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
					&amp;&amp; currentRic.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
					&amp;&amp; currentRic.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
					&amp;&amp; currentRic.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE)&#xD;
			{&#xD;
				Process.auditLog(&quot;Rimuovo dall'array la richiesta: &quot; + currentRic.IDRichiestaOLO + &quot; poiché non SHA, BITSTREAM o EASYIP&quot;);&#xD;
				list.remove(i);&#xD;
				i--;&#xD;
			}&#xD;
			//Prendo solo stati non terminali&#xD;
			else if(currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO&#xD;
					|| currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATO&#xD;
					|| currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CHIUSO&#xD;
					|| currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO&#xD;
					|| currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICO&#xD;
					|| currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOAFATTURAZIONE&#xD;
					|| currentRic.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO)&#xD;
			{&#xD;
				Process.auditLog(&quot;Rimuovo dall'array la richiesta: &quot; + currentRic.IDRichiestaOLO + &quot; poiché in uno stato terminale&quot;);&#xD;
				list.remove(i);&#xD;
				i--;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(list.size() == 0)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL OL IN CORSO STESSO OLO positivo: nessuna richiesta trovata&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL OL IN CORSO STESSO OLO negativo: trovata almeno una richiesta in corso - es. &quot; + list.get(0).readRichiesta().IDRichiestaOLO;&#xD;
		idRichiestaBloccante = list.get(0).readRichiesta().IDRichiestaOLO; // SM_8143&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL OL IN CORSO STESSO OLO positivo: lavorazione o offerta non in ambito per il controllo&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
