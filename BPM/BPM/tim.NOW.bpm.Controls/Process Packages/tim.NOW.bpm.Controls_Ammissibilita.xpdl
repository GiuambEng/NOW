if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG)&#xD;
{&#xD;
	var RIENTROTITrovato = false;&#xD;
	var RIENTROTIValorizzato = false;&#xD;
	var RIENTROTI = &quot;&quot;;&#xD;
	var i = 0;&#xD;
	&#xD;
	while(!RIENTROTITrovato &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var dettaglio = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(!RIENTROTITrovato &amp;&amp; j &lt; dettaglio.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = dettaglio.attributiDettaglioOrdine.get(j);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RIENTROTI)&#xD;
				{&#xD;
					RIENTROTITrovato = true;&#xD;
					if(attributo.valoreAttributo != &quot;&quot;)&#xD;
					{&#xD;
						RIENTROTIValorizzato = true;&#xD;
					}&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(RIENTROTIValorizzato)&#xD;
	{&#xD;
		VerificaCompatibilitaLavorazioneRequest.flagRientro = &quot;Y&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		VerificaCompatibilitaLavorazioneRequest.flagRientro = &quot;N&quot;;&#xD;
	}&#xD;
}&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
		&amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO&#xD;
		&amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
		&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA))&#xD;
{&#xD;
	var foundNP = false;&#xD;
