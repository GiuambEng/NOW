            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(VerificaCompatibilitaLavorazioneResponse != null &amp;&amp; VerificaCompatibilitaLavorazioneResponse.scenario != null)&#xD;
{&#xD;
	localRequest.tipologiaScenario = it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.get(String(VerificaCompatibilitaLavorazioneResponse.scenario));&#xD;
	localRequest.ordine.tipologiaScenario = it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.get(String(VerificaCompatibilitaLavorazioneResponse.scenario));&#xD;
}&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP)&#xD;
{&#xD;
	if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG &amp;&amp; localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PORTIN)&#xD;
	{&#xD;
		if(localRequest.ordine != null &amp;&amp; localRequest.ordine.numeroTelefonico!= null)&#xD;
		{&#xD;
			var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND (IDRisorsa=:IDRisorsa OR numeroTelefonico =:IDRisorsa)&quot;);&#xD;
			c.setQueryParameter(&quot;IDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
			//c.setQueryParameter(&quot;offertaInput&quot;,localRequest.offerta);&#xD;
			var assetReference = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			&#xD;
			if (assetReference == null || assetReference.size()==0)&#xD;
			{&#xD;
				var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;dettaglioasset.attributidettaglioasset.nomeAttributo = 'RADICALE' AND dettaglioasset.attributidettaglioasset.valoreAttributo=:IDRisorsa AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE')&quot;);&#xD;
				criteria.setQueryParameter(&quot;IDRisorsa&quot;, localRequest.IDRisorsa);&#xD;
				&#xD;
				assetReference = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
			}&#xD;
			&#xD;
			// RU_857 - aggiunta ricerca per NPSUAGGWLR, in questo modo trovatoAssetNP = true e entriamo nel primo if per la valorizzazione dell'OLOAGCOM preso dall'asset&#xD;
			if(assetReference == null || assetReference.size()==0)&#xD;
			{&#xD;
				var criteria2 = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;(offerta = 'WLRLINEAATTIVA' OR offerta = 'WLRLINEANONATTIVA') AND dettaglioasset.nomeComponente = 'AGGIUNTIVO' AND dettaglioasset.statoDettaglioAsset = 'ATTIVO' AND dettaglioasset.attributidettaglioasset.nomeAttributo = 'NUMEROTELEFONICO' AND dettaglioasset.attributidettaglioasset.valoreAttributo=:DN AND statoAsset = 'ATTIVO' AND tipologiaAccesso = 'FONIA'&quot;);&#xD;
				criteria2.setQueryParameter(&quot;DN&quot;,localRequest.ordine.numeroTelefonico);&#xD;
				assetReference = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria2);&#xD;
			}&#xD;
			&#xD;
			var PORTABILITASUCCESSIVA=&quot;&quot;;&#xD;
			var trovatoAssetNP = false;&#xD;
			if(assetReference != null &amp;&amp; assetReference.size()>0)&#xD;
			{&#xD;
				for(var i=0; i&lt;assetReference.size(); i++)&#xD;
				{&#xD;
					var assetTemp = assetReference.get(i).readAsset();&#xD;
					if((assetTemp.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP &#xD;
					    || assetTemp.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
					    || assetTemp.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
					    || assetTemp.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR&#xD;
					    || assetTemp.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
					    || assetTemp.offerta== it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA) &#xD;
					    &amp;&amp; assetTemp.statoAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)&#xD;
					{&#xD;
						if(Asset==null)&#xD;
						{&#xD;
							trovatoAssetNP=true;&#xD;
							Asset = assetTemp;&#xD;
							AssetRef = assetReference.get(i);&#xD;
						} else if(Asset.created&lt;assetTemp.created)&#xD;
						{&#xD;
							Asset = assetTemp;&#xD;
							AssetRef = assetReference.get(i);&#xD;
						}&#xD;
						&#xD;
					}&#xD;
				}&#xD;
			}			&#xD;
			&#xD;
			//SM_9809: esclusi tutti gli NPSUTIF*** e non il solo NPSUTIF&#xD;
			if(trovatoAssetNP &#xD;
			&amp;&amp; String(localRequest.tipologiaScenario).slice(0,7) != &quot;NPSUTIF&quot;)&#xD;
			{&#xD;
				if(Asset.codificaOLOAGCOM==&quot;INF&quot;)&#xD;
				{&#xD;
					localRequest.codificaOLOAGCOMDonating=&quot;WIN&quot;;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					localRequest.codificaOLOAGCOMDonating = Asset.codificaOLOAGCOM;&#xD;
				}&#xD;
				localRequest.codificaOLONOWDonating = Asset.codificaOLONOWDonating;&#xD;
				localRequest.ordine.codificaOLOAGCOMDonating = Asset.codificaOLOAGCOM;&#xD;
				localRequest.ordine.codificaOLONOWDonating = Asset.codificaOLONOWDonating;&#xD;
				&#xD;
				PORTABILITASUCCESSIVA = &quot;1&quot;;&#xD;
				localRequest.lavorazione = it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE;&#xD;
				localRequest.ordine.tipologiaLavorazione = it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE;&#xD;
				//localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PORTABILITASUCCESSIVA;&#xD;
				//localRequest.tipologiaScenario =it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP;&#xD;
				//localRequest.ordine.tipologiaScenario =it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				localRequest.codificaOLOAGCOMDonating =&quot;TLC&quot;;&#xD;
				localRequest.ordine.codificaOLOAGCOMDonating = &quot;TLC&quot;;&#xD;
				localRequest.codificaOLONOWDonating =&quot;002&quot;;&#xD;
				localRequest.ordine.codificaOLONOWDonating =&quot;002&quot;;&#xD;
				&#xD;
				PORTABILITASUCCESSIVA = &quot;0&quot;;&#xD;
				localRequest.lavorazione = it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE;&#xD;
				localRequest.ordine.tipologiaLavorazione = it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE;&#xD;
				//localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE; &#xD;
				//localRequest.tipologiaScenario =it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUTIF;&#xD;
				//localRequest.ordine.tipologiaScenario =it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUTIF;				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
