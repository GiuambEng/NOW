            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_XjOtsZrqEeiD6dERz-jeXg" Width="54.0">
              <xpdl2:Coordinates XCoordinate="772.0" YCoordinate="197.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_rffU4Jr3EeiD6dERz-jeXg" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_OxRQMJrnEeiD6dERz-jeXg" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_XjOtsZrqEeiD6dERz-jeXg" Width="58.0">
              <xpdl2:Coordinates XCoordinate="51.0" YCoordinate="197.0"/>
