        <xpdl2:Activity Id="_TDqS8P0QEeawSun_Qeigjg" Name="VerificaOLInCorsoNumerazioniDonating" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica OL In Corso Numerazioni Donating">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var failed = false;&#xD;
var i = 0;&#xD;
&#xD;
while(!failed &amp;&amp; i &lt; PresenzeOrdinativiNOW.size())&#xD;
{&#xD;
	var currentPresenzeOrdinativiNOW = PresenzeOrdinativiNOW.get(i);&#xD;
	var currentPresenzeOrdinativiCRM = PresenzeOrdinativiCRM.get(i);&#xD;
	&#xD;
	if(currentPresenzeOrdinativiNOW != &quot;00&quot; || currentPresenzeOrdinativiCRM != &quot;00&quot;)&#xD;
	{&#xD;
		failed = true;&#xD;
		&#xD;
		if(currentPresenzeOrdinativiNOW == &quot;01&quot;)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_01&quot;;&#xD;
			idRichiestaDaStoricizzare = idRichiestaBloccanteNOW.get(i);&#xD;
		}&#xD;
		else if(currentPresenzeOrdinativiNOW == &quot;02&quot;)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_02&quot;;&#xD;
			idRichiestaDaStoricizzare = idRichiestaBloccanteNOW.get(i);&#xD;
		}&#xD;
		else if(currentPresenzeOrdinativiNOW == &quot;03&quot;)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_03&quot;;&#xD;
			idRichiestaDaStoricizzare = idRichiestaBloccanteNOW.get(i);&#xD;
		}&#xD;
		else if(currentPresenzeOrdinativiNOW == &quot;04&quot;)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_04&quot;;&#xD;
			idRichiestaDaStoricizzare = idRichiestaBloccanteNOW.get(i);&#xD;
		}&#xD;
		else if(currentPresenzeOrdinativiCRM == &quot;01&quot;)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_05&quot;;&#xD;
			idRichiestaDaStoricizzare = idRichiestaBloccanteCRM.get(i);&#xD;
		}&#xD;
		else if(currentPresenzeOrdinativiCRM == &quot;02&quot;)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_06&quot;;&#xD;
			idRichiestaDaStoricizzare = idRichiestaBloccanteCRM.get(i);&#xD;
		}&#xD;
		else if(currentPresenzeOrdinativiCRM == &quot;03&quot;)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_07&quot;;&#xD;
			idRichiestaDaStoricizzare = idRichiestaBloccanteCRM.get(i);&#xD;
		}&#xD;
		else if(currentPresenzeOrdinativiCRM == &quot;05&quot;)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_08&quot;;&#xD;
			idRichiestaDaStoricizzare = idRichiestaBloccanteCRM.get(i);&#xD;
		}&#xD;
		else if(currentPresenzeOrdinativiCRM == &quot;06&quot;)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_09&quot;;&#xD;
			idRichiestaDaStoricizzare = idRichiestaBloccanteCRM.get(i);&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL OL IN CORSO NP DONATING negativo&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	for(var i = 0; i &lt; DN.size(); i++)&#xD;
	{&#xD;
		Log.write(&quot;[CTRLOLINCORSONPDONATING] IDRichiesta: &quot; + localRequest.IDRichiestaOLO + &quot; DN: &quot; + DN.get(i));&#xD;
		&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;offerta = 'NP' AND statoAsset = 'ATTIVO' AND (IDRisorsa =: ID OR numeroTelefonico =: ID)&quot;);&#xD;
		criteria.setQueryParameter(&quot;ID&quot;,DN.get(i));&#xD;
&#xD;
		var assetRefs = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
		&#xD;
		if(assetRefs == null || assetRefs.size() == 0)&#xD;
		{&#xD;
			Log.write(&quot;[CTRLOLINCORSONPDONATING] IDRichiesta: &quot; + localRequest.IDRichiestaOLO + &quot; Looking for RADICALE&quot;);&#xD;
			var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;dettaglioasset.attributidettaglioasset.nomeAttributo = 'RADICALE' AND dettaglioasset.attributidettaglioasset.valoreAttributo=:DN AND statoAsset &lt;> 'CESSATO' AND offerta = 'NP'&quot;);&#xD;
			criteria.setQueryParameter(&quot;DN&quot;, DN.get(i));&#xD;
			&#xD;
			assetRefs = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
		}&#xD;
		&#xD;
		if(assetRefs != null &amp;&amp; assetRefs.size() > 0)&#xD;
		{&#xD;
			var tempRef = assetRefs.get(0);&#xD;
			Log.write(&quot;[CTRLOLINCORSONPDONATING] IDRichiesta: &quot; + localRequest.IDRichiestaOLO + &quot; Adding the ref: &quot; + tempRef);&#xD;
			AssetRef.add(tempRef);&#xD;
			&#xD;
			var tempAsset = tempRef.readAsset();&#xD;
			tempAsset.statoAsset = it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.INLAVORAZIONE;&#xD;
			Asset.add(ScriptUtil.copy(tempAsset));&#xD;
			&#xD;
			// aggiungo in assetTarget per gestire eventuale unlock&#xD;
			var assetTarget =it_telecomitalia_it_NOW_casedata_Factory.createAssetTarget();&#xD;
			assetTarget.IDAsset = tempAsset.IDAsset;&#xD;
			assetTarget.flagInLavorazione = true;&#xD;
			localRequest.assetTarget.add(ScriptUtil.copy(assetTarget));&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL OL IN CORSO NP DONATING positivo&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
