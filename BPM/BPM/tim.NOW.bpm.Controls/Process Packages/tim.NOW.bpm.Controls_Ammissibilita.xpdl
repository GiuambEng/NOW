    <xpdl2:WorkflowProcess Id="_k6hOYH3fEeioGKseHY4R3g" xpdExt:DisplayName="CTRL COMP TIPO LINEA DATI RICHIESTA_C04M03F27" xpdExt:ApiEndPointParticipant="_l-Yr4H3vEeioGKseHY4R3g" Name="CTRLCOMPTIPOLINEADATIRICHIESTA_C04M03F27">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_k6yUI33fEeioGKseHY4R3g" Name="EndEvent" xpdExt:DisplayName="End Event">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_k6yUIX3fEeioGKseHY4R3g" Width="30.0">
              <xpdl2:Coordinates XCoordinate="592.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_mxA18n3fEeioGKseHY4R3g" Name="VerificaCompatibilitaTipoLineaDatiRichiesta" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Compatibilita Tipo Linea Dati Richiesta" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA passato&quot;;&#xD;
&#xD;
var tipologiaLineaReq = &quot;&quot;;&#xD;
tipologiaLineaReq = null;&#xD;
&#xD;
var referente = false;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &#xD;
&amp;&amp; (localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL &#xD;
|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO))&#xD;
{&#xD;
	// recupera TIPO LINEA da XML&#xD;
	var i = 0;&#xD;
	&#xD;
	while(tipologiaLineaReq == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(tipologiaLineaReq == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					tipologiaLineaReq = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
&#xD;
	// controlla presenza Referente da XML&#xD;
	if (localRequest.ordine.referente.size() > 0)&#xD;
	{&#xD;
		referente = true;&#xD;
	}&#xD;
&#xD;
	// Attivazione Dati&#xD;
	if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)&#xD;
	{&#xD;
		&#xD;
		if (ConsistenzaFonia.tipoLinea != null)&#xD;
		{&#xD;
&#xD;
			if(tipologiaLineaReq == 'POTS' &amp;&amp; ConsistenzaFonia.tipoLinea == 'ISDN')&#xD;
			{&#xD;
				if(referente)&#xD;
				{&#xD;
					// EsitoOK&#xD;
					EsitoResponse.codice = true;&#xD;
					EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA passato: Attivazione Dati, tipo linea XML &quot;+tipologiaLineaReq+&quot;, Consistenza Fonia &quot;+ConsistenzaFonia.tipoLinea+&quot; Referente/i presenti&quot;;&#xD;
					Process.auditLog(EsitoResponse.descrizione);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					// EsitoKO&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA fallito: Attivazione Dati, tipo linea XML &quot;+tipologiaLineaReq+&quot;, Consistenza Fonia &quot;+ConsistenzaFonia.tipoLinea+&quot; Referente/i NON presenti&quot;;&#xD;
					Process.auditLog(EsitoResponse.descrizione);&#xD;
				}&#xD;
			}&#xD;
			else if((tipologiaLineaReq == 'ISDN' &amp;&amp; ConsistenzaFonia.tipoLinea == 'POTS') || (tipologiaLineaReq == ConsistenzaFonia.tipoLinea))&#xD;
			{&#xD;
				// EsitoOK&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA passato: Attivazione Dati, tipo linea XML &quot;+tipologiaLineaReq+&quot;, Consistenza Fonia &quot;+ConsistenzaFonia.tipoLinea;	&#xD;
				Process.auditLog(EsitoResponse.descrizione);&#xD;
			}&#xD;
			else //SM_8088 (prima ESITO KO)&#xD;
			{&#xD;
				// EsitoOK&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA passato (coinsistenza tipo linea valorizzato)&quot;;&#xD;
				Process.auditLog(EsitoResponse.descrizione);&#xD;
			}&#xD;
		&#xD;
		}&#xD;
		else //attributo tipo linea su consistenza fonia mancante&#xD;
		{&#xD;
			if(tipologiaLineaReq == 'POTS')&#xD;
			{&#xD;
				&#xD;
				if(ConsistenzaFonia.destinazioneUso == '2' || ConsistenzaFonia.destinazioneUso == '3' || ConsistenzaFonia.destinazioneUso.slice(0,2) == '2|' || ConsistenzaFonia.destinazioneUso.slice(0,2) == '3|')&#xD;
				{&#xD;
					if(referente)&#xD;
					{&#xD;
						// EsitoOK&#xD;
						EsitoResponse.codice = true;&#xD;
						EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA passato: Attivazione Dati, tipo linea XML &quot;+tipologiaLineaReq+&quot;, destinazioneUso &quot;+ConsistenzaFonia.destinazioneUso+&quot; Referente/i presenti&quot;;&#xD;
						Process.auditLog(EsitoResponse.descrizione);&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						// EsitoKO&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA fallito: Attivazione Dati, tipo linea XML &quot;+tipologiaLineaReq+&quot;, destinazioneUso &quot;+ConsistenzaFonia.destinazioneUso+&quot; Referente/i NON presenti&quot;;&#xD;
						Process.auditLog(EsitoResponse.descrizione);&#xD;
					}&#xD;
						&#xD;
				}&#xD;
				else if (ConsistenzaFonia.destinazioneUso == '1' || ConsistenzaFonia.destinazioneUso.slice(0,2) == '1|')&#xD;
				{&#xD;
					// EsitoOK&#xD;
					EsitoResponse.codice = true;&#xD;
					EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA passato: Attivazione Dati, tipo linea XML &quot;+tipologiaLineaReq+&quot;, destinazioneUso &quot;+ConsistenzaFonia.destinazioneUso;&#xD;
					Process.auditLog(EsitoResponse.descrizione);&#xD;
							&#xD;
				}&#xD;
				else //SM_8088 (prima ESITO KO)&#xD;
				{&#xD;
					// EsitoOK&#xD;
					EsitoResponse.codice = true;&#xD;
					EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA passato (coinsistenza tipo linea valorizzato)&quot;;&#xD;
					Process.auditLog(EsitoResponse.descrizione);&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			else if(tipologiaLineaReq == 'ISDN')&#xD;
			{&#xD;
				if(ConsistenzaFonia.destinazioneUso == '2' || ConsistenzaFonia.destinazioneUso == '3' || ConsistenzaFonia.destinazioneUso.slice(0,2) == '2|' || ConsistenzaFonia.destinazioneUso.slice(0,2) == '3|')&#xD;
				{&#xD;
					// EsitoOK&#xD;
					EsitoResponse.codice = true;&#xD;
					EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA passato: Attivazione Dati, tipo linea XML &quot;+tipologiaLineaReq+&quot;, destinazioneUso &quot;+ConsistenzaFonia.destinazioneUso;&#xD;
					Process.auditLog(EsitoResponse.descrizione);&#xD;
				}&#xD;
				else //SM_8088 (prima ESITO KO)&#xD;
				{&#xD;
					// EsitoOK&#xD;
					EsitoResponse.codice = true;&#xD;
					EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA passato: Attivazione Dati, tipo linea XML &quot;+tipologiaLineaReq+&quot;, destinazioneUso &quot;+ConsistenzaFonia.destinazioneUso;&#xD;
					Process.auditLog(EsitoResponse.descrizione);					&#xD;
				}&#xD;
			}&#xD;
			&#xD;
		}&#xD;
		&#xD;
		&#xD;
	}&#xD;
	else // Attivazione SHA&#xD;
	{&#xD;
&#xD;
		if(ConsistenzaFonia.tipoLinea == 'ISDN')&#xD;
		{&#xD;
			if(!referente)&#xD;
			{&#xD;
				// EsitoKO&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA fallito: Attivazione SHA, Consistenza Fonia ISDN, Referente/i NON presenti&quot;;	&#xD;
				Process.auditLog(EsitoResponse.descrizione);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				// EsitoOK&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA passato: Attivazione SHA, Consistenza Fonia ISDN, Referente/i presenti&quot;;	&#xD;
				Process.auditLog(EsitoResponse.descrizione);&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			// EsitoOK&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA DATI RICHIESTA passato: Attivazione SHA, Consistenza Fonia POTS&quot;;&#xD;
			Process.auditLog(EsitoResponse.descrizione);&#xD;
		}&#xD;
&#xD;
	}&#xD;
&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
