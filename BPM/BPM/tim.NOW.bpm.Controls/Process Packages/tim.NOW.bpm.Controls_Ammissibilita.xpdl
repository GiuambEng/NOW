			foundNP = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(foundNP)&#xD;
	{&#xD;
		VerificaCompatibilitaLavorazioneRequest.flagRientro = &quot;Y&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		VerificaCompatibilitaLavorazioneRequest.flagRientro = &quot;N&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	VerificaCompatibilitaLavorazioneRequest.flagRientro = &quot;N&quot;;&#xD;
}&#xD;
&#xD;
VerificaCompatibilitaLavorazioneRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
VerificaCompatibilitaLavorazioneRequest.offertaRichiesta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
&#xD;
if(localRequest.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
{&#xD;
