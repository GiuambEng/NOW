	ConsistenzaDati.tipoLinea != &quot;POTS&quot; &amp;&amp; ConsistenzaDati.tipoLinea != &quot;ISDN&quot; &amp;&amp;&#xD;
	(ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
	|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULAFTTCAB))&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL RISORSA NAKED DINAMICO fallito - Trovata opzione dinamica&quot;;&#xD;
}&#xD;
</xpdl2:Script>
