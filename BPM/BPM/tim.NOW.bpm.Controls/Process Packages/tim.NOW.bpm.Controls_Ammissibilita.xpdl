            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">RecuperaHASHrequest = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createRecuperaHASHconsistenza_RequestType();&#xD;
&#xD;
RecuperaHASHrequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
&#xD;
//SM_10704: modificato mapping IDAsset per strutturaRichiesta DATI/FONIA&#xD;
if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
   ||localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)&#xD;
{&#xD;
	if(ConsistenzaDati != null)       //Condiviso o Dati-Dati&#xD;
	{&#xD;
		RecuperaHASHrequest.idAsset = String(ConsistenzaDati.IDAsset);&#xD;
	}&#xD;
	else if(ConsistenzaFonia != null) //Da Fonia a Dati&#xD;
	{&#xD;
		RecuperaHASHrequest.idAsset = String(ConsistenzaFonia.IDAsset);&#xD;
	}&#xD;
}&#xD;
else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO&#xD;
        &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
{&#xD;
	if(ConsistenzaFonia != null)     //Condiviso o Fonia-Fonia&#xD;
	{&#xD;
		RecuperaHASHrequest.idAsset = String(ConsistenzaFonia.IDAsset);&#xD;
	}&#xD;
	else if(ConsistenzaDati != null) //Da Dati a Fonia&#xD;
	{&#xD;
		RecuperaHASHrequest.idAsset = String(ConsistenzaDati.IDAsset);&#xD;
	}&#xD;
}&#xD;
else if(ConsistenzaCPS != null &amp;&amp; ConsistenzaCPS.size()>0)&#xD;
{&#xD;
	RecuperaHASHrequest.idAsset = String(ConsistenzaCPS.get(0).IDAsset);&#xD;
}&#xD;
else if(NumberPortability != null &amp;&amp; NumberPortability.size()>0)&#xD;
{&#xD;
	RecuperaHASHrequest.idAsset = String(NumberPortability.get(0).IDAsset);&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
