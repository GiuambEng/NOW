        <xpdl2:Activity Id="_N8RKEFTuEeeCWsvSNu7fgw" Name="Precondizionefallita" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione fallita">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL COMP TIPO LINEA POTS saltato: precondizione fallita&quot;;&#xD;
storicizza = false;&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_cU-vAtdNEeawK-VRC_DmUQ" Width="96.0">
