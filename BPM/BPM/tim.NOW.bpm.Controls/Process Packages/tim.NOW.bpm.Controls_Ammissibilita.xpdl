          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaNPSincronizzataRequest = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createVerifica_NP_Sincronizzata_RequestType();&#xD;
&#xD;
if(localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
{&#xD;
               VerificaNPSincronizzataRequest.DN = localRequest.numeroTelefonico;&#xD;
}&#xD;
&#xD;
if(DNAggiuntivi != null &amp;&amp; DNAggiuntivi.size() > 0)&#xD;
{&#xD;
               VerificaNPSincronizzataRequest.DNAggiuntiveFase2.addAll(DNAggiuntivi);&#xD;
}&#xD;
&#xD;
if(localRequest.DNAggiuntivo.size() > 0)&#xD;
{&#xD;
               VerificaNPSincronizzataRequest.DNAggiuntive.addAll(localRequest.DNAggiuntivo);&#xD;
}&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.tipologiaScenario != null) // R1I-19-0365&#xD;
{&#xD;
	VerificaNPSincronizzataRequest.scenario = String(localRequest.ordine.tipologiaScenario);&#xD;
}&#xD;
&#xD;
if(localRequest.ordine.tipologiaSottolav!= null){&#xD;
               VerificaNPSincronizzataRequest.sottolavorazione = String(localRequest.ordine.tipologiaSottolav);&#xD;
}&#xD;
VerificaNPSincronizzataRequest.consistenzaFonia = ConsistenzaFonia;&#xD;
VerificaNPSincronizzataRequest.consistenzaDati = ConsistenzaDati;&#xD;
VerificaNPSincronizzataRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaNPSincronizzataRequest.codiceRisorsa1 = localRequest.codiceRisorsaDonating;&#xD;
VerificaNPSincronizzataRequest.codiceRisorsa2 = localRequest.codiceRisorsaDonating2;&#xD;
VerificaNPSincronizzataRequest.codificaOloAgcomRecepient = localRequest.codificaOLOAGCOM;&#xD;
VerificaNPSincronizzataRequest.data_Invio_Rich = localRequest.dataInvioRichiesta;&#xD;
VerificaNPSincronizzataRequest.flagNumerazioneAggiuntive = localRequest.flagNumAggiuntive;&#xD;
&#xD;
if(localRequest.lavorazione != null)&#xD;
{&#xD;
               VerificaNPSincronizzataRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
}&#xD;
if(localRequest.offerta != null)&#xD;
{&#xD;
               VerificaNPSincronizzataRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
}&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
while(VerificaNPSincronizzataRequest.routingNumber == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
               var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
               &#xD;
               if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
               {&#xD;
                              var j = 0;&#xD;
                              while(VerificaNPSincronizzataRequest.routingNumber == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
                              {&#xD;
                                            var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
                                            &#xD;
                                            if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER)&#xD;
                                            {&#xD;
                                                           VerificaNPSincronizzataRequest.routingNumber = currentAttDettOrdine.valoreAttributo;&#xD;
                                            }&#xD;
                                            j++;&#xD;
                              }&#xD;
               }&#xD;
               i++;&#xD;
}&#xD;
&#xD;
if(localRequest.lavorazione==it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &#xD;
               &amp;&amp; localRequest.tipologiaSottolav==it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274&#xD;
               &amp;&amp; InventoryDBCFXResponse!=null &amp;&amp; InventoryDBCFXResponse.size()>0)&#xD;
{&#xD;
               var indexInventory=0;&#xD;
               while(indexInventory&lt;InventoryDBCFXResponse.size())&#xD;
               {&#xD;
                              var currentInventory=InventoryDBCFXResponse.get(indexInventory);&#xD;
                              var aggiuntivoISDN = (currentInventory.datiUnica.tipoNumero!=&quot;NATIVO VOIP IMS&quot; &amp;&amp; (currentInventory.datiUnica.tipoServizio==&quot;ISDN BMO&quot; || currentInventory.datiUnica.tipoServizio==&quot;ISDN BMU&quot;&#xD;
                                            || ((currentInventory.datiUnica.tipoServizio==&quot;CAPOSERIE&quot; || currentInventory.datiUnica.tipoServizio==&quot;LINEA PBX&quot;) &#xD;
                                            &amp;&amp; currentInventory.CRMWSResponse.tipo_Linea.banda_Servizio==&quot;ISDN BRA&quot;)&#xD;
                                            || ((currentInventory.datiUnica.tipoServizio==&quot;RADICALE&quot; || currentInventory.datiUnica.tipoServizio==&quot;SPE&quot; || currentInventory.datiUnica.tipoServizio==&quot;SPU&quot;) &#xD;
                                            &amp;&amp; (currentInventory.CRMWSResponse.tipo_Linea.banda_Servizio==&quot;ISDN BRA&quot; || currentInventory.CRMWSResponse.tipo_Linea.banda_Servizio==&quot;ISDN PRA&quot;))));&#xD;
                              if(currentInventory.datiUnica.numeroTelefonicoPrincipale!=currentInventory.numero_Telefonico &amp;&amp; aggiuntivoISDN &amp;&amp; currentInventory.datiUnica.flagAttivo==&quot;Y&quot;)&#xD;
                              {&#xD;
                                             VerificaNPSincronizzataRequest.aggiuntivoISDNinventory.add(currentInventory.numero_Telefonico);&#xD;
                              }&#xD;
                              indexInventory++;&#xD;
               }&#xD;
                                            &#xD;
}             &#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
