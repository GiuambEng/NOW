          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.PORTIN)&#xD;
{&#xD;
	localRequest.lavorazione = it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE;&#xD;
	localRequest.ordine.tipologiaLavorazione = it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE;&#xD;
}&#xD;
&#xD;
VerificaCompatibilitaLavorazioneRequest = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createVerifica_Compatibilita_Lavorazione_RequestType();&#xD;
&#xD;
VerificaCompatibilitaLavorazioneRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
&#xD;
//RU_1180 - MULTICAST&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT)&#xD;
{&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE)&#xD;
	{&#xD;
		if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CANALEESISTENTEOLT&#xD;
		&amp;&amp; ConsistenzaSedeOLT != null)&#xD;
		{&#xD;
			if(ConsistenzaSedeOLT.codificaOLOAGCOMDonating == &quot;TLC&quot;)&#xD;
			{&#xD;
				VerificaCompatibilitaLavorazioneRequest.assetDatiStandard = &quot;Y&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				VerificaCompatibilitaLavorazioneRequest.assetDatiStandard = &quot;N&quot;;&#xD;
			}&#xD;
&#xD;
			VerificaCompatibilitaLavorazioneRequest.offertaAssetDati = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(ConsistenzaSedeOLT.offerta);&#xD;
			VerificaCompatibilitaLavorazioneRequest.azioneConsistenzaDati = ConsistenzaSedeOLT.azione;&#xD;
		}&#xD;
		else if((localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CANALEESISTENTEFEEDER&#xD;
			  || localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CREAZIONECANALEFEEDER)&#xD;
		&amp;&amp; ConsistenzaFeeder != null) &#xD;
		{&#xD;
			if(ConsistenzaFeeder.codificaOLOAGCOMDonating == &quot;TLC&quot;)&#xD;
			{&#xD;
				VerificaCompatibilitaLavorazioneRequest.assetDatiStandard = &quot;Y&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				VerificaCompatibilitaLavorazioneRequest.assetDatiStandard = &quot;N&quot;;&#xD;
			}&#xD;
&#xD;
			VerificaCompatibilitaLavorazioneRequest.offertaAssetDati = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(ConsistenzaFeeder.offerta);&#xD;
			VerificaCompatibilitaLavorazioneRequest.azioneConsistenzaDati = ConsistenzaFeeder.azione;&#xD;
		}&#xD;
	}&#xD;
	else if(ConsistenzaFeeder != null) &#xD;
	{&#xD;
		if(ConsistenzaFeeder.codificaOLOAGCOMDonating == &quot;TLC&quot;)&#xD;
		{&#xD;
			VerificaCompatibilitaLavorazioneRequest.assetDatiStandard = &quot;Y&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			VerificaCompatibilitaLavorazioneRequest.assetDatiStandard = &quot;N&quot;;&#xD;
		}&#xD;
&#xD;
		VerificaCompatibilitaLavorazioneRequest.offertaAssetDati = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(ConsistenzaFeeder.offerta);&#xD;
		VerificaCompatibilitaLavorazioneRequest.azioneConsistenzaDati = ConsistenzaFeeder.azione;&#xD;
	}&#xD;
}&#xD;
else if(ConsistenzaNPNG != null) //RU_1203&#xD;
{&#xD;
	if(ConsistenzaNPNG.codificaOLOAGCOMDonating == &quot;TLC&quot;)&#xD;
	{&#xD;
		VerificaCompatibilitaLavorazioneRequest.assetFoniaStandard = &quot;Y&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		VerificaCompatibilitaLavorazioneRequest.assetFoniaStandard = &quot;N&quot;;&#xD;
	}&#xD;
&#xD;
	VerificaCompatibilitaLavorazioneRequest.offertaAssetFonia = ConsistenzaNPNG.offerta;&#xD;
	VerificaCompatibilitaLavorazioneRequest.azioneConsistenzaFonia = ConsistenzaNPNG.azione;&#xD;
}&#xD;
else if(ConsistenzaRaccolta != null) //RU_1058&#xD;
{&#xD;
	if(ConsistenzaRaccolta.codificaOLOAGCOMDonating == &quot;TLC&quot;)&#xD;
	{&#xD;
		VerificaCompatibilitaLavorazioneRequest.assetDatiStandard = &quot;Y&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		VerificaCompatibilitaLavorazioneRequest.assetDatiStandard = &quot;N&quot;;&#xD;
	}&#xD;
&#xD;
	VerificaCompatibilitaLavorazioneRequest.offertaAssetDati = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(ConsistenzaRaccolta.offerta);&#xD;
	VerificaCompatibilitaLavorazioneRequest.azioneConsistenzaDati = ConsistenzaRaccolta.azione;&#xD;
}&#xD;
else if(ConsistenzaDati != null)&#xD;
{&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
	{&#xD;
		if(ConsistenzaFonia==null || (ConsistenzaFonia!=null &amp;&amp; (localRequest.strutturaRichiesta==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
		|| localRequest.strutturaRichiesta==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL || String(localRequest.offerta).slice(0,3)==&quot;SHA&quot;)))&#xD;
		{&#xD;
			if(ConsistenzaDati.codificaOLOAGCOMDonating == &quot;TLC&quot;)&#xD;
			{&#xD;
				VerificaCompatibilitaLavorazioneRequest.assetDatiStandard = &quot;Y&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				VerificaCompatibilitaLavorazioneRequest.assetDatiStandard = &quot;N&quot;;&#xD;
			}&#xD;
	&#xD;
			VerificaCompatibilitaLavorazioneRequest.destinazioneUsoAssetDati = ConsistenzaDati.destinazioneUso;&#xD;
			VerificaCompatibilitaLavorazioneRequest.offertaAssetDati = ConsistenzaDati.offerta;&#xD;
			VerificaCompatibilitaLavorazioneRequest.azioneConsistenzaDati = ConsistenzaDati.azione;&#xD;
			if(ConsistenzaDati.tipoLinea != null)&#xD;
			{&#xD;
				VerificaCompatibilitaLavorazioneRequest.tipologiaLineaAssetDati = it_telecomitalia_it_NOW_casedata_v1_TipologiaLineaEnumeration.get(String(ConsistenzaDati.tipoLinea).toUpperCase());&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		if(ConsistenzaDati.codificaOLOAGCOMDonating == &quot;TLC&quot;)&#xD;
		{&#xD;
			VerificaCompatibilitaLavorazioneRequest.assetDatiStandard = &quot;Y&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			VerificaCompatibilitaLavorazioneRequest.assetDatiStandard = &quot;N&quot;;&#xD;
		}&#xD;
	&#xD;
		VerificaCompatibilitaLavorazioneRequest.destinazioneUsoAssetDati = ConsistenzaDati.destinazioneUso;&#xD;
		VerificaCompatibilitaLavorazioneRequest.offertaAssetDati = ConsistenzaDati.offerta;&#xD;
		VerificaCompatibilitaLavorazioneRequest.azioneConsistenzaDati = ConsistenzaDati.azione;&#xD;
		if(ConsistenzaDati.tipoLinea != null)&#xD;
		{&#xD;
			VerificaCompatibilitaLavorazioneRequest.tipologiaLineaAssetDati = it_telecomitalia_it_NOW_casedata_v1_TipologiaLineaEnumeration.get(String(ConsistenzaDati.tipoLinea).toUpperCase());&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//SM_8883&#xD;
	VerificaCompatibilitaLavorazioneRequest.strutturaLineaDati = ConsistenzaDati.strutturaLinea;&#xD;
}&#xD;
&#xD;
if(ConsistenzaFonia != null)&#xD;
{&#xD;
	//RU_778 - aggiunti struttura Linea e banda servizio in input.&#xD;
	if(ConsistenzaFonia.strutturaLinea != null)&#xD;
	{&#xD;
		VerificaCompatibilitaLavorazioneRequest.strutturaLinea = ConsistenzaFonia.strutturaLinea;&#xD;
	}&#xD;
	if(ConsistenzaFonia.bandaServizio != null)&#xD;
	{&#xD;
		VerificaCompatibilitaLavorazioneRequest.bandaServizio = ConsistenzaFonia.bandaServizio;&#xD;
	}&#xD;
	&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
	{&#xD;
		if(ConsistenzaDati == null || (ConsistenzaDati!=null &amp;&amp; localRequest.strutturaRichiesta!=it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
		 &amp;&amp; localRequest.strutturaRichiesta!=it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL &amp;&amp; String(localRequest.offerta).slice(0,3)!=&quot;SHA&quot;))&#xD;
		{&#xD;
			if(ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot;)&#xD;
			{&#xD;
				VerificaCompatibilitaLavorazioneRequest.assetFoniaStandard = &quot;Y&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				VerificaCompatibilitaLavorazioneRequest.assetFoniaStandard = &quot;N&quot;;&#xD;
			}&#xD;
	&#xD;
			VerificaCompatibilitaLavorazioneRequest.destinazioneUsoAssetFonia = ConsistenzaFonia.destinazioneUso;&#xD;
			VerificaCompatibilitaLavorazioneRequest.offertaAssetFonia = ConsistenzaFonia.offerta;&#xD;
			VerificaCompatibilitaLavorazioneRequest.azioneConsistenzaFonia = ConsistenzaFonia.azione;&#xD;
			if(ConsistenzaFonia.tipoLinea != null)&#xD;
			{&#xD;
				VerificaCompatibilitaLavorazioneRequest.tipologiaLineaAssetFonia = it_telecomitalia_it_NOW_casedata_v1_TipologiaLineaEnumeration.get(String(ConsistenzaFonia.tipoLinea).toUpperCase());&#xD;
			}&#xD;
			&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		if(ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot;)&#xD;
		{&#xD;
			VerificaCompatibilitaLavorazioneRequest.assetFoniaStandard = &quot;Y&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			VerificaCompatibilitaLavorazioneRequest.assetFoniaStandard = &quot;N&quot;;&#xD;
		}&#xD;
	&#xD;
		VerificaCompatibilitaLavorazioneRequest.destinazioneUsoAssetFonia = ConsistenzaFonia.destinazioneUso;&#xD;
		VerificaCompatibilitaLavorazioneRequest.offertaAssetFonia = ConsistenzaFonia.offerta;&#xD;
		VerificaCompatibilitaLavorazioneRequest.azioneConsistenzaFonia = ConsistenzaFonia.azione;&#xD;
		//SM_8975 non valorizzare per MIGR + off Donating VULL LA/LNA isdn pra&#xD;
		if(ConsistenzaFonia.tipoLinea != null &#xD;
			&amp;&amp; !(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &#xD;
				 &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO&#xD;
				 &amp;&amp; ConsistenzaFonia.bandaServizio == &quot;ISDN PRA&quot;&#xD;
				 &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULLLINEANONATTIVA&#xD;
				 	|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULL)))&#xD;
		{&#xD;
			VerificaCompatibilitaLavorazioneRequest.tipologiaLineaAssetFonia = it_telecomitalia_it_NOW_casedata_v1_TipologiaLineaEnumeration.get(String(ConsistenzaFonia.tipoLinea).toUpperCase());&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//SM_8883&#xD;
	VerificaCompatibilitaLavorazioneRequest.strutturaLineaFonia = ConsistenzaFonia.strutturaLinea;&#xD;
}&#xD;
&#xD;
//RU_915&#xD;
//SM_9676: ConsistenzaCPS diventa un array e quindi aggiunta condizione sulla size&#xD;
if(ConsistenzaCPS != null &amp;&amp; ConsistenzaCPS.size()>0)&#xD;
{&#xD;
	//Eliminato da spf v.7.90&#xD;
	/*if(ConsistenzaCPS.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS&#xD;
		&amp;&amp; !(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &amp;&amp; localRequest.flagNaked != &quot;S&quot;&#xD;
			&amp;&amp; (localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA &#xD;
		 		|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)))&#xD;
	{&#xD;
		VerificaCompatibilitaLavorazioneRequest.offertaAssetCPS = String(ConsistenzaCPS.offerta);&#xD;
	}*/&#xD;
	&#xD;
	//Eliminato da SM_9151&#xD;
	/*if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp;&#xD;
	   localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE &amp;&amp;&#xD;
	   ConsistenzaCPS.codificaOLOAGCOMDonating != null &amp;&amp; localRequest.codificaOLOAGCOM == ConsistenzaCPS.codificaOLOAGCOMDonating)&#xD;
	{&#xD;
		VerificaCompatibilitaLavorazioneRequest.flagCPS = &quot;N&quot;;&#xD;
	}*/&#xD;
	&#xD;
	VerificaCompatibilitaLavorazioneRequest.flagCPS = &quot;Y&quot;;	&#xD;
	&#xD;
}&#xD;
else&#xD;
{&#xD;
	VerificaCompatibilitaLavorazioneRequest.flagCPS = &quot;N&quot;;&#xD;
}&#xD;
&#xD;
&#xD;
//SM_3164 SM_3081 SM_3225 SM_3240 SM_3272 SM_3285 SM_3299&#xD;
/*if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTONP)&#xD;
{&#xD;
	VerificaCompatibilitaLavorazioneRequest.offertaAssetFonia = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.NP;&#xD;
}&#xD;
else */if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOSLU&#xD;
		|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOULL)&#xD;
{&#xD;
	VerificaCompatibilitaLavorazioneRequest.offertaAssetFonia = ConsistenzaFonia.offerta;&#xD;
}&#xD;
&#xD;
if(localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
	&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA)&#xD;
{&#xD;
	var destinazioneUso = &quot;&quot;;&#xD;
	destinazioneUso = null;&#xD;
	&#xD;
	var i = 0;&#xD;
	&#xD;
	while(destinazioneUso == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			&#xD;
			while(destinazioneUso == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
				{&#xD;
					destinazioneUso = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(destinazioneUso != null)&#xD;
	{&#xD;
		VerificaCompatibilitaLavorazioneRequest.destinazioneUsoRichiestaOLO = destinazioneUso;&#xD;
		&#xD;
		//COMMENTATO IN QUANTO LA TRASCODIFICA VIENE EFFETTUATA DALLA PROCEDURA SQL&#xD;
		/*if(destinazioneUso.length == 1)&#xD;
