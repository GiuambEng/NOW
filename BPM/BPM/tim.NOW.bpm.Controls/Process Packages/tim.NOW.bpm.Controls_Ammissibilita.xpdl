                  <xpdExt:ScriptInformation Id="_wjvPEO4_EeibVPfqQpP7HA" Name="idRichiestaBloccante"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if(idRichiestaBloccante != null)&#xD;
{&#xD;
	idRichiestaBloccante;&#xD;
}&#xD;
else&#xD;
{&#xD;
	// Cosa sporchissima per assegnare id ordine CRMWS nel caso sia restituito da Lock Unlock Risorsa, da eliminare con C1 2019&#xD;
	EsitoResponse.descrizione;&#xD;
}</xpdl2:Actual>
