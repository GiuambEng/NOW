		&#xD;
		ConsistenzaDati.IDRisorsa = assetFWA.IDRisorsa;&#xD;
&#xD;
		ConsistenzaDati.IDRisorsaNOW = assetFWA.IDRisorsaNOW;&#xD;
&#xD;
