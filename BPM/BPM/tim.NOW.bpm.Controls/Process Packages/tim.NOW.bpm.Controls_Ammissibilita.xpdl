  <xpdl2:Artifacts>
    <xpdl2:Artifact Id="_EPCW4P2mEeaHdKJnxcWV6A" ArtifactType="Annotation" TextAnnotation="Quando crei la componente CONSISTENZAFONIA (che contiene i dati del servizio donating) a partire dall’ASSET, devi valorizzare il campo CODIFICAOLOAGCOMDONATING. Il campo viene valorizzato a partire dal campo CODIFICA OLO AGCOM dell’Asset, ma in modo differente a seconda del contenuto del campo. Devi verificare se sull’anagrafica OLO il valore corrisponde ad un olo accorpante o accorpato. Se risulta essere un accorpato, in CODIFICAOLOAGCOMDONATING inserisci il relativo accorpante, altrimenti il medesimo OLO presente in CODIFICA OLO AGCOM.">
      <xpdl2:NodeGraphicsInfos>
        <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" Height="64.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="1530.0">
          <xpdl2:Coordinates XCoordinate="1326.0" YCoordinate="601.0"/>
        </xpdl2:NodeGraphicsInfo>
      </xpdl2:NodeGraphicsInfos>
    </xpdl2:Artifact>
    <xpdl2:Artifact Id="_KpWo8MnvEeu_FOvYkGKuIw" ArtifactType="Annotation" TextAnnotation="Sulle SF fanno parte tutti e 3 &#xD;&#xA;dello stesso sottoparagrafo &#xD;&#xA;&quot;Canale Feeder e See OLT&quot;">
      <xpdl2:NodeGraphicsInfos>
        <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" Height="64.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="196.0">
          <xpdl2:Coordinates XCoordinate="1207.0" YCoordinate="1175.0"/>
        </xpdl2:NodeGraphicsInfo>
      </xpdl2:NodeGraphicsInfos>
    </xpdl2:Artifact>
  </xpdl2:Artifacts>
