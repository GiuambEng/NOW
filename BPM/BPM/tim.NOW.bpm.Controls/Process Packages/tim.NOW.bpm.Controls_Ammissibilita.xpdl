        <xpdl2:Activity Id="_5GhEMAv9EeiwxfCTQ56R9A" Name="RecuperaAsset" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Recupera Asset">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Recupera Asset Servizio in Consistenza Migrazione OK&quot;;&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Verifica servizio in consistenza Migrazione.&quot;);&#xD;
&#xD;
//SM_9604: recupero offerta recipient per capire se considerare le CPS&#xD;
var recipientWLRVULL = false;&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA)&#xD;
{&#xD;
	recipientWLRVULL = true;&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | considerare anche eventuali CPS&quot;);&#xD;
}&#xD;
&#xD;
if((localRequest.codiceRisorsaDonating != null &amp;&amp; localRequest.codiceRisorsaDonating != &quot;&quot;) || (IDRisorsaDIN != null &amp;&amp; IDRisorsaDIN != &quot;&quot;))&#xD;
{&#xD;
	&#xD;
	Asset1 = null;&#xD;
	assetCPSMig = null;&#xD;
	codiceRisorsa = &quot;&quot;;&#xD;
	var DIN = false;&#xD;
&#xD;
	if(IDRisorsaDIN != null &amp;&amp; IDRisorsaDIN != &quot;&quot;)&#xD;
	{&#xD;
		codiceRisorsa = IDRisorsaDIN;&#xD;
		DIN = true;&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | IDRISORSADIN: &quot;+IDRisorsaDIN);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		codiceRisorsa = localRequest.codiceRisorsaDonating;&#xD;
	}&#xD;
	&#xD;
	&#xD;
	var SecondaCifraCodiceRisorsa = codiceRisorsa.charAt(1);&#xD;
	var TerzaCifraCodiceRisorsa = codiceRisorsa.charAt(2);&#xD;
	var codiceRisorsaMod = &quot;&quot;;&#xD;
&#xD;
	//calcolo codice risorsa&#xD;
	if(SecondaCifraCodiceRisorsa == &quot;2&quot; || SecondaCifraCodiceRisorsa == &quot;6&quot;)&#xD;
	{&#xD;
		codiceRisorsaMod = (&quot;0&quot;+codiceRisorsa);&#xD;
	}&#xD;
	else if(TerzaCifraCodiceRisorsa == &quot;0&quot; || TerzaCifraCodiceRisorsa == &quot;1&quot; ||&#xD;
			TerzaCifraCodiceRisorsa == &quot;5&quot; || TerzaCifraCodiceRisorsa == &quot;9&quot; )&#xD;
	{&#xD;
		codiceRisorsaMod = codiceRisorsa;&#xD;
	}&#xD;
	else &#xD;
	{&#xD;
		codiceRisorsaMod = codiceRisorsa.slice(1, codiceRisorsa.length);&#xD;
	}&#xD;
&#xD;
	//IDRisorsa&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta &lt;> 'NP'&quot;);&#xD;
	c.setQueryParameter(&quot;idr&quot;, codiceRisorsa);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	if(result != null &amp;&amp; result.size()>0)&#xD;
	{&#xD;
		// RU_915 - Controllo se c'è un AssetCPS tra quelli recuperati&#xD;
		for(var i=0; i&lt;result.size(); i++)&#xD;
		{&#xD;
			assetAppoggio = ScriptUtil.copy(result.get(i).readAsset());&#xD;
			&#xD;
			if(assetAppoggio.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
			{&#xD;
				if(recipientWLRVULL) //SM_9604&#xD;
				{&#xD;
					assetCPSMig = ScriptUtil.copy(assetAppoggio);&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset CPS trovato: &quot;+String(assetCPSMig.IDAsset)+&quot;, considerato: &quot;+recipientWLRVULL);&#xD;
				}&#xD;
				&#xD;
				result.remove(i);&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//Logica standard preesistente&#xD;
		if(result != null &amp;&amp; result.size()>0)&#xD;
		{&#xD;
			AssetRef = result.get(0);&#xD;
			Asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset: &quot;+String(Asset1.IDAsset));&#xD;
		}&#xD;
	}&#xD;
&#xD;
&#xD;
	//NumeroFittizio &#xD;
	if(Asset1 == null &amp;&amp; codiceRisorsa != &quot;&quot; &amp;&amp; codiceRisorsaMod != &quot;&quot;)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Ricerca Asset1 per NUMERO FITTIZIO = codiceRisorsa: &quot; + codiceRisorsaMod + &quot; or &quot; + codiceRisorsa);&#xD;
		c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;(numeroFittizio =: NF OR numeroFittizio =: NF1) AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta &lt;> 'NP'&quot;);&#xD;
		c.setQueryParameter(&quot;NF&quot;, codiceRisorsaMod);&#xD;
		c.setQueryParameter(&quot;NF1&quot;, codiceRisorsa);&#xD;
		result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		if(result!= null &amp;&amp; result.size() > 0)&#xD;
		{&#xD;
			// RU_915 - Controllo se c'è un AssetCPS tra quelli recuperati&#xD;
			for(var i=0; i&lt;result.size(); i++)&#xD;
			{&#xD;
				assetAppoggio = ScriptUtil.copy(result.get(i).readAsset());&#xD;
				&#xD;
				if(assetAppoggio.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
				{&#xD;
					if(recipientWLRVULL) //SM_9604&#xD;
					{&#xD;
						assetCPSMig = ScriptUtil.copy(assetAppoggio);&#xD;
						Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset CPS trovato: &quot;+String(assetCPSMig.IDAsset)+&quot;, considerato: &quot;+recipientWLRVULL);&#xD;
					}&#xD;
				&#xD;
					result.remove(i);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//Logica standard preesistente&#xD;
			if(result != null &amp;&amp; result.size()>0)&#xD;
			{&#xD;
				AssetRef = result.get(0);&#xD;
				Asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset: &quot;+String(Asset1.IDAsset));&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
	//NumeroTelefonico&#xD;
	if(Asset1 == null)&#xD;
	{&#xD;
		c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico =: NT AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta &lt;> 'NP'&quot;);&#xD;
		c.setQueryParameter(&quot;NT&quot;, codiceRisorsa);&#xD;
		result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		if(result != null &amp;&amp; result.size() > 0)&#xD;
		{&#xD;
			// RU_915 - Controllo se c'è un AssetCPS tra quelli recuperati&#xD;
			for(var i=0; i&lt;result.size(); i++)&#xD;
			{&#xD;
				assetAppoggio = ScriptUtil.copy(result.get(i).readAsset());&#xD;
				&#xD;
				if(assetAppoggio.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
				{&#xD;
					if(recipientWLRVULL) //SM_9604&#xD;
					{&#xD;
						assetCPSMig = ScriptUtil.copy(assetAppoggio);&#xD;
						Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset CPS trovato: &quot;+String(assetCPSMig.IDAsset)+&quot;, considerato: &quot;+recipientWLRVULL);&#xD;
					}&#xD;
					&#xD;
					result.remove(i);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//Logica standard preesistente&#xD;
			if(result != null &amp;&amp; result.size()>0)&#xD;
			{&#xD;
				AssetRef = result.get(0);&#xD;
				Asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Recupera Asset | Recuperato per IDRisorsa Asset: &quot;+String(Asset1.IDAsset));&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	// SM_8730 &amp;&amp; SM_8765: aggiunta logica per riprovare le CAC nel caso in cui con IDRisorsaDIN non abbiamo trovato nulla &#xD;
	if(Asset1 == null &amp;&amp; DIN)&#xD;
	{&#xD;
		codiceRisorsa = localRequest.codiceRisorsaDonating;&#xD;
		&#xD;
		SecondaCifraCodiceRisorsa = codiceRisorsa.charAt(1);&#xD;
		TerzaCifraCodiceRisorsa = codiceRisorsa.charAt(2);&#xD;
		codiceRisorsaMod = &quot;&quot;;&#xD;
&#xD;
		//calcolo codice risorsa&#xD;
		if(SecondaCifraCodiceRisorsa == &quot;2&quot; || SecondaCifraCodiceRisorsa == &quot;6&quot;)&#xD;
		{&#xD;
			codiceRisorsaMod = (&quot;0&quot;+codiceRisorsa);&#xD;
		}&#xD;
		else if(TerzaCifraCodiceRisorsa == &quot;0&quot; || TerzaCifraCodiceRisorsa == &quot;1&quot; ||&#xD;
				TerzaCifraCodiceRisorsa == &quot;5&quot; || TerzaCifraCodiceRisorsa == &quot;9&quot; )&#xD;
		{&#xD;
			codiceRisorsaMod = codiceRisorsa;&#xD;
		}&#xD;
		else &#xD;
		{&#xD;
			codiceRisorsaMod = codiceRisorsa.slice(1, codiceRisorsa.length);&#xD;
		}&#xD;
&#xD;
		&#xD;
		var SecondaCifraCodiceRisorsa = codiceRisorsa.charAt(1);&#xD;
		var TerzaCifraCodiceRisorsa = codiceRisorsa.charAt(2);&#xD;
		var codiceRisorsaMod = &quot;&quot;;&#xD;
&#xD;
		//calcolo codice risorsa&#xD;
