        <xpdl2:Activity Id="_7oOj4tgbEeaY9voi_RiYAg" Name="VerificaTipoLineaNaked" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Tipo Linea Naked">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL TIPO LINEA NAKED fallito: dati insufficienti per eseguire il controllo&quot;;&#xD;
&#xD;
var tipologiaLinea = &quot;&quot;;&#xD;
tipologiaLinea = null;&#xD;
var i = 0;&#xD;
&#xD;
while(tipologiaLinea == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(tipologiaLinea == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
			{&#xD;
				tipologiaLinea = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(tipologiaLinea == &quot;POTS&quot; || tipologiaLinea == &quot;ISDN&quot;)&#xD;
{&#xD;
	if(ConsistenzaFonia != null)&#xD;
	{&#xD;
		if(ConsistenzaFonia.destinazioneUso != &quot;4&quot;&#xD;
			&amp;&amp; ConsistenzaFonia.destinazioneUso != &quot;5&quot;&#xD;
			&amp;&amp; ConsistenzaFonia.destinazioneUso != &quot;9&quot;&#xD;
			&amp;&amp; ConsistenzaFonia.destinazioneUso != &quot;10&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL TIPO LINEA NAKED positivo: DestinazioneUse in consistenza congruente: &quot; + ConsistenzaFonia.destinazioneUso;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL TIPO LINEA NAKED fallito: DestinazioneUse in consistenza non congruente: &quot; + ConsistenzaFonia.destinazioneUso;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL TIPO LINEA NAKED fallito: ConsistenzaFonia mancante&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL TIPO LINEA NAKED saltato per precondizione: TipoLinea non di tipo POTS o ISDN&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
