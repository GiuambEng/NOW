                  <xpdExt:ScriptInformation Id="_fbnKcOfyEei4xJsrh7TJpw" Name="SistemaCoinvolto"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if(idRichiestaBloccante != null)&#xD;
{&#xD;
	&quot;NOW&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	if(EsitoResponse.descrizione.slice(0,3) == 'pvm')&#xD;
	{&#xD;
		&quot;NOW&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		&quot;CRMWS&quot;;&#xD;
	}&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="IdRisorsaBloccata">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.numeroTelefonico</xpdl2:Actual>
                </xpdl2:DataMapping>
