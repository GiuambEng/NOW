        <xpdl2:Activity Id="_vyej0ef1Eei4xJsrh7TJpw" Name="StoricizzazioneOLBloccante_C19M23" xpdExt:Visibility="Private" xpdExt:DisplayName="StoricizzazioneOLBloccante_C19M23">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_upsxIOflEei4xJsrh7TJpw" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="SistemaCoinvolto">
                  <xpdExt:ScriptInformation Id="_rBCYoOf2Eei4xJsrh7TJpw" Name="SistemaCoinvolto"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">if(CodiceEsito == &quot;KO_01&quot; || CodiceEsito == &quot;KO_02&quot; || CodiceEsito == &quot;KO_03&quot; || CodiceEsito == &quot;KO_04&quot;)&#xD;
{&#xD;
	&quot;NOW&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;CRMWS&quot;;&#xD;
}</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="IdRisorsaBloccata">
                  <xpdExt:ScriptInformation Id="_LPDNYPMdEeiqV91Hyx3wHA" Name="IdRisorsaBloccata"/>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var IdRisBloccata = &quot;&quot;;&#xD;
&#xD;
//SM_8187: controlla per quale DN è stato restituito il KO facendo logica sull'indice di PresenzeOrdinativi&#xD;
if(CodiceEsito == &quot;KO_01&quot; || CodiceEsito == &quot;KO_02&quot; || CodiceEsito == &quot;KO_03&quot; || CodiceEsito == &quot;KO_04&quot;) //KO NOW&#xD;
{&#xD;
	var i=0;&#xD;
	var trovato = false;&#xD;
	&#xD;
	while(!trovato &amp;&amp; i&lt;PresenzeOrdinativiNOW.size())&#xD;
	{&#xD;
		if(PresenzeOrdinativiNOW.get(i) != '00')&#xD;
		{&#xD;
			IdRisBloccata = DN.get(i);&#xD;
			trovato = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
else //KO CRM&#xD;
{&#xD;
	var i=0;&#xD;
	var trovato = false;&#xD;
	&#xD;
	while(!trovato &amp;&amp; i&lt;PresenzeOrdinativiCRM.size())&#xD;
	{&#xD;
		if(PresenzeOrdinativiCRM.get(i) != '00')&#xD;
		{&#xD;
			IdRisBloccata = DN.get(i);&#xD;
			trovato = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
IdRisBloccata;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="IdOlBloccante">
                  <xpdl2:Actual ScriptGrammar="JavaScript">idRichiestaDaStoricizzare</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="80.0" LaneId="_UmMlUvUQEeaIvKeprhSP7w" Width="149.0">
