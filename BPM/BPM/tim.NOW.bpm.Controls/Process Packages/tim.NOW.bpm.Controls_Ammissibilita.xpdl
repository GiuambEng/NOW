	{&#xD;
		AssetRef = result.get(0);&#xD;
		assetFWA = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		Log.write(LogString+&quot;Recuperato per IDRisorsa Asset: &quot;+String(assetFWA.IDAsset));&#xD;
	}&#xD;
	//Più consistenze&#xD;
	else if(result != null &amp;&amp; result.size() > 1)&#xD;
	{	&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: sono stati recuperati più risultati di Consistenza aventi DN: &quot;+localRequest.IDRisorsa;&#xD;
		CodiceEsito = &quot;KO_09&quot;;	&#xD;
	}	&#xD;
	//Nessuna consistenza&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: non è stata recuperata nessuna consistenza FWA avente DN: &quot;+localRequest.IDRisorsa;&#xD;
