      <xpdl2:Activities>
        <xpdl2:Activity Id="_xRA0MbuaEea-FqioYDGtog" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="52.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="31.0">
              <xpdl2:Coordinates XCoordinate="2407.0" YCoordinate="234.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_xRA0MruaEea-FqioYDGtog" Name="AttivazioneWLRLNA_VerificaIDRisorsaNaked_C04M03F03" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Attivazione WLR LNA_Verifica ID Risorsa Naked_C04M03F03">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Il seguente script contiene sia la logica in C04M03F04 (Attivazione WLR LNA) che quella di Verifica ID Risorsa Naked C04M03F03&#xD;
&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: dati insufficienti per eseguire il controllo.&quot;;&#xD;
CodiceEsito = &quot;KO_02&quot;;&#xD;
&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR LNA | Verifica servizio in consistenza WLR LNA.&quot;);&#xD;
&#xD;
//--------------------------------------------------ATTIVAZIONE WLR LINEA NON ATTIVA--------------------------------------------------//&#xD;
&#xD;
// Recupero IDRisorsaBTSNaked e OLD&#xD;
var IdRisorsaBTSNaked = &quot;&quot;;&#xD;
IdRisorsaBTSNaked = null;&#xD;
	&#xD;
var idRisorsaOLD = &quot;&quot;;&#xD;
idRisorsaOLD = null;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while((IdRisorsaBTSNaked == null || idRisorsaOLD == null) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while((IdRisorsaBTSNaked == null || idRisorsaOLD == null) &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSABTSNAKED)&#xD;
				{&#xD;
					IdRisorsaBTSNaked = currentAttDettOrdine.valoreAttributo;&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR LNA | IDRISORSABTSNAKED: &quot;+IdRisorsaBTSNaked);&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAOLD)&#xD;
				{&#xD;
					idRisorsaOLD = currentAttDettOrdine.valoreAttributo;&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR LNA | IDRISORSAOLD: &quot;+idRisorsaOLD);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
// LOGICA DI C04M03F04 aggiunta con RU_918&#xD;
if(idRisorsaOLD != null)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: offerta non in ambito con IDRISORSAOLD: &quot; + idRisorsaOLD;&#xD;
	CodiceEsito = &quot;KO_23&quot;;&#xD;
}&#xD;
// LOGICA DI Verifica ID Risorsa Naked C04M03F03&#xD;
else&#xD;
{&#xD;
	var asset1 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
	asset1 = null;&#xD;
&#xD;
	if(IdRisorsaBTSNaked != null)&#xD;
	{&#xD;
		//--------------------------------------------------RECUPERA ASSET PER NUMERO FITTIZIO--------------------------------------------------//	&#xD;
		var SecondaCifraCodiceRisorsa = IdRisorsaBTSNaked.charAt(1); //SM_8270: aggiunta logica per IdRisorsaBTSNakedMod&#xD;
		var TerzaCifraCodiceRisorsa = IdRisorsaBTSNaked.charAt(2);&#xD;
		var IdRisorsaBTSNakedMod = &quot;&quot;;&#xD;
&#xD;
		//calcolo codice risorsa&#xD;
		if(SecondaCifraCodiceRisorsa == &quot;2&quot; || SecondaCifraCodiceRisorsa == &quot;6&quot;)&#xD;
		{&#xD;
			IdRisorsaBTSNakedMod = (&quot;0&quot;+IdRisorsaBTSNaked);&#xD;
		}&#xD;
		else if(TerzaCifraCodiceRisorsa == &quot;0&quot; || TerzaCifraCodiceRisorsa == &quot;1&quot; ||&#xD;
				TerzaCifraCodiceRisorsa == &quot;5&quot; || TerzaCifraCodiceRisorsa == &quot;9&quot; )&#xD;
		{&#xD;
			IdRisorsaBTSNakedMod = IdRisorsaBTSNaked;&#xD;
		}&#xD;
		else &#xD;
		{&#xD;
			IdRisorsaBTSNakedMod = IdRisorsaBTSNaked.slice(1, IdRisorsaBTSNaked.length);&#xD;
		}&#xD;
			&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;(numeroFittizio =: idr OR numeroFittizio =: idrMod) AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE')&quot;);&#xD;
		c.setQueryParameter(&quot;idrMod&quot;, IdRisorsaBTSNakedMod);&#xD;
		c.setQueryParameter(&quot;idr&quot;, IdRisorsaBTSNaked);&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		if(result != null &amp;&amp; result.size() > 0)&#xD;
		{&#xD;
			AssetRef = result.get(0);&#xD;
			asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR LNA | Asset recuperato per numeroFittizio=&quot;+IdRisorsaBTSNaked+&quot; o numeroFittizio=idRisorsaBTSNakedMod (&quot;+IdRisorsaBTSNakedMod+&quot;)&quot;);&#xD;
		}&#xD;
&#xD;
		if(asset1 == null)&#xD;
		{&#xD;
			//--------------------------------------------------RECUPERA ASSET PER NUMERO IDRISORSA--------------------------------------------------//&#xD;
			var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: SearchIDRisorsa AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE')&quot;);&#xD;
			criteria.setQueryParameter(&quot;SearchIDRisorsa&quot;, IdRisorsaBTSNaked);&#xD;
			var list = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
			if(list != null &amp;&amp; list.size() > 0)&#xD;
			{&#xD;
				AssetRef = list.get(0);&#xD;
				asset1 = AssetRef.readAsset();&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR LNA | Asset recuperato per IDRisorsa=&quot;+IdRisorsaBTSNaked);&#xD;
			}&#xD;
		}&#xD;
&#xD;
		if(result != null &amp;&amp; result.size() > 1)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: Asset recuperato non univoco.&quot;;&#xD;
			CodiceEsito = &quot;KO_01&quot;;&#xD;
		}&#xD;
		else&#xD;
		{	&#xD;
			if(asset1 != null)&#xD;
			{&#xD;
				if(asset1.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.DATI)&#xD;
				{&#xD;
					EsitoResponse.codice = true;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza positivo.&quot;;&#xD;
					CodiceEsito = null;&#xD;
					ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();&#xD;
					&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR LNA | Creazione componente ConsistenzaDati: &quot;+asset1.IDAsset);&#xD;
					&#xD;
					ConsistenzaDati.IDRisorsa = asset1.IDRisorsa;&#xD;
					ConsistenzaDati.IDRisorsaNOW = asset1.IDRisorsaNOW;&#xD;
					ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(asset1.offerta));&#xD;
					ConsistenzaDati.codificaOLOAGCOMDonating = asset1.codificaOLOAGCOMDonating;&#xD;
					ConsistenzaDati.codiceOrdineTI = asset1.codiceOrdineTI;&#xD;
					ConsistenzaDati.codiceOrdineOLO = asset1.codiceOrdineOLO;&#xD;
					ConsistenzaDati.IDAsset = asset1.IDAsset;&#xD;
					ConsistenzaDati.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(asset1.statoAsset));&#xD;
					ConsistenzaDati.numeroTelefonico = asset1.numeroTelefonico;&#xD;
					ConsistenzaDati.opzioneDinamica = asset1.opzioneDinamica;&#xD;
					&#xD;
					//OPERATORERETE - RU_1142&#xD;
					ConsistenzaDati.operatoreRete = asset1.operatoreRete;&#xD;
					&#xD;
					ConsistenzaDati.assetBTWhiteList = asset1.assetBTWhiteList; //R1E-21-0325&#xD;
					&#xD;
					//R1E-21-0325&#xD;
					if(ConsistenzaDati.assetBTWhiteList != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != &quot;&quot;)&#xD;
					{&#xD;
						localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
					}&#xD;
					&#xD;
					//RU_1275&#xD;
					if(asset1.exOperatoreRete != null &amp;&amp; asset1.exOperatoreRete != &quot;&quot;)&#xD;
					{&#xD;
						localRequest.exOperatoreRete = asset1.exOperatoreRete;&#xD;
						localRequest.ordine.exOperatoreRete = asset1.exOperatoreRete;&#xD;
					}&#xD;
					&#xD;
					var foundAccesso = false;&#xD;
					var i = 0;&#xD;
						&#xD;
					while(!foundAccesso &amp;&amp; i &lt; asset1.dettaglioasset.size())&#xD;
					{&#xD;
						var currentDettAsset = asset1.dettaglioasset.get(i);&#xD;
							&#xD;
						if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
						{&#xD;
							foundAccesso = true;&#xD;
							var j = 0;&#xD;
							while((ConsistenzaDati.tipoLinea == null || ConsistenzaDati.strutturaLinea == null || ConsistenzaDati.tipologiaClusterComune == null) &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
							{&#xD;
								var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
							&#xD;
								if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
								{&#xD;
									ConsistenzaDati.tipoLinea = currentAttDettAsset.valoreAttributo;&#xD;
								}&#xD;
								else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
								{&#xD;
									ConsistenzaDati.strutturaLinea = currentAttDettAsset.valoreAttributo;&#xD;
								}&#xD;
								else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE) // RU_964&#xD;
								{&#xD;
									ConsistenzaDati.tipologiaClusterComune = currentAttDettAsset.valoreAttributo;&#xD;
								}&#xD;
								j++;&#xD;
							}&#xD;
						}&#xD;
						i++;&#xD;
					}&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: trovata una consistenza fonia anziché dati per IdRisorsaBTSNaked: &quot; + IdRisorsaBTSNaked;&#xD;
					CodiceEsito = &quot;KO_02&quot;;&#xD;
				}	&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: consistenza non trovata per IdRisorsaBTSNaked: &quot; + IdRisorsaBTSNaked;&#xD;
				CodiceEsito = &quot;KO_02&quot;;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza skippato: IdRisorsaBTSNaked non trovato.&quot;;&#xD;
		CodiceEsito = null;&#xD;
	}&#xD;
&#xD;
	if(asset1 != null)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR LNA | Asset recuperato: &quot; + asset1.IDAsset);&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Attivazione WLR LNA | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="82.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="172.0">
              <xpdl2:Coordinates XCoordinate="885.0" YCoordinate="485.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_4U5tsbuaEea-FqioYDGtog" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_0jSdQLuaEea-FqioYDGtog" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="58.0">
              <xpdl2:Coordinates XCoordinate="109.0" YCoordinate="234.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_PV6v0MN-EeaIePUVnZpBHg" Name="DatiVerificaControlli" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Dati Verifica Controlli">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_Aa1wkMIeEeaIJ-AnJ3AotA" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="processIdentifier" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="Azione">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;INSERT&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="IDRichiestaOLO">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="Operatore">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.operatore</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="ConsistenzaDati">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ConsistenzaDati</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="ConsistenzaFonia">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ConsistenzaFonia</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="NumberPortability">
                  <xpdl2:Actual ScriptGrammar="JavaScript">NumberPortability</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="LavorazioneRichiesta">
                  <xpdl2:Actual ScriptGrammar="JavaScript">LavorazioneRichiesta</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="STS">
                  <xpdl2:Actual ScriptGrammar="JavaScript">STS</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="ConsistenzaRaccolta">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ConsistenzaRaccolta</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="ConsistenzaCPS">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ConsistenzaCPS</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="ConsistenzaCanale">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ConsistenzaCanale</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="ConsistenzaRaccoltaVLANMulticast">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ConsistenzaRaccoltaVLANMulticast</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="ConsistenzaSedeOLT">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ConsistenzaSedeOLT</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="ConsistenzaFeeder">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ConsistenzaFeeder</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="ConsistenzaNPNG">
                  <xpdl2:Actual ScriptGrammar="JavaScript">ConsistenzaNPNG</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="91.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="147.0">
              <xpdl2:Coordinates XCoordinate="1850.0" YCoordinate="234.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">processIdentifier = &quot;/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.utils.xpdl.DatiVerificaControlliStorico&quot;;&#xD;
if(ConsistenzaFonia != null)&#xD;
{&#xD;
	Process.auditLog(&quot;ConsistenzaFonia: &quot; + ConsistenzaFonia.IDAsset);&#xD;
}&#xD;
if(ConsistenzaDati != null)&#xD;
{&#xD;
	Process.auditLog(&quot;ConsistenzaDati: &quot; + ConsistenzaDati.IDAsset);&#xD;
}&#xD;
if(NumberPortability != null &amp;&amp; NumberPortability.size() > 0)&#xD;
{&#xD;
	Process.auditLog(&quot;NumberPortability trovata.&quot;);&#xD;
}&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_uEFckMOaEeagicJrJ3yatg">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_PV7W4MN-EeaIePUVnZpBHg"/>
                  <xpdl2:TransitionRef Id="_bv7HgEw4EeeLnrrGXLYF1g"/>
