        <xpdl2:Activity Id="_p0cwUO4AEeazSbn9P97FTQ">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="45.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="43.0">
              <xpdl2:Coordinates XCoordinate="1124.0" YCoordinate="234.0"/>
