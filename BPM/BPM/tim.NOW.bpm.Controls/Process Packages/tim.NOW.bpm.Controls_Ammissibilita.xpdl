        <xpdl2:Activity Id="_sp1CAe4AEeazSbn9P97FTQ" Name="Migrazione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Migrazione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: dati insufficienti per eseguire il controllo.&quot;;&#xD;
CodiceEsito = &quot;KO_0	2&quot;;&#xD;
&#xD;
if(!ConsistenzeStessoTipo)&#xD;
{&#xD;
	//SM_5933, CASO PARTICOLARE MIGRAZIONE OLO CON RECIPIENT CONDIVISO E DONATING CONDIVISO//		&#xD;
	var FaultMigRecipientCondiviso = false;&#xD;
	if(Asset2 == null &amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO)&#xD;
	{&#xD;
		var foundTipoLinea= false;&#xD;
		var i=0;&#xD;
		&#xD;
		while(!foundTipoLinea &amp;&amp; i&lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j=0;&#xD;
				&#xD;
				while(!foundTipoLinea &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						foundTipoLinea = true;&#xD;
						&#xD;
						if(attributo.valoreAttributo != &quot;LineaNonFonia&quot;)&#xD;
						{&#xD;
							FaultMigRecipientCondiviso = true;&#xD;
						}&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}	&#xD;
			i++;	&#xD;
		}&#xD;
		&#xD;
		if(!foundTipoLinea &amp;&amp; String(localRequest.offerta).slice(0, 3) == &quot;SHA&quot;){&#xD;
			FaultMigRecipientCondiviso = true;&#xD;
		}&#xD;
		&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Migrazione | FaultMigRecipientCondiviso: &quot;+FaultMigRecipientCondiviso);&#xD;
	}&#xD;
	&#xD;
	//SM_3404, CASO PARTICOLARE VULA FTTH e BITSTREAMNGAFTTH//&#xD;
	if&#xD;
	((&#xD;
		((OfferteFTTH.contains(String(Asset1.offerta)) &#xD;
		 || Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS						//SM_11629&#xD;
		 || Asset1.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)&#xD;
	  &amp;&amp; (OfferteFTTH.contains(String(localRequest.offerta))&#xD;
	      || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS               //SM_11629&#xD;
		  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA))          &#xD;
	|| &#xD;
		(!OfferteFTTH.contains(String(Asset1.offerta)) &amp;&amp; !OfferteFTTH.contains(String(localRequest.offerta)))&#xD;
	)&#xD;
	&amp;&amp; !FaultMigRecipientCondiviso)		&#xD;
	{&#xD;
&#xD;
		if(Asset2 == null&#xD;
		|| (Asset2 != null &amp;&amp; (Asset1.tipologiaAccesso != Asset2.tipologiaAccesso&#xD;
								|| ((String(Asset1.offerta).slice(0, 3) == &quot;ULL&quot; &amp;&amp; String(Asset2.offerta).slice(0, 3) == &quot;ULL&quot;) || (String(Asset1.offerta).slice(0, 3) == &quot;SLU&quot; &amp;&amp; String(Asset2.offerta).slice(0, 3) == &quot;SLU&quot;) &amp;&amp; Asset1.codificaOLOAGCOM == &quot;TLC&quot; &amp;&amp; Asset2.codificaOLOAGCOM == &quot;TLC&quot;)))&#xD;
		|| (localRequest.codiceRisorsaDonating != null &amp;&amp; localRequest.codiceRisorsaDonating != &quot;&quot; &amp;&amp; localRequest.codiceRisorsaDonating2 != null &amp;&amp; localRequest.codiceRisorsaDonating2 != &quot;&quot;&#xD;
			&amp;&amp; localRequest.codiceRisorsaDonating == localRequest.codiceRisorsaDonating2)&#xD;
		|| (Asset2 != null &amp;&amp; (stessaRisorsa || AssetCorrelato)))&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			&#xD;
			if(Asset2 != null)&#xD;
			{	&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza superato: Recuperate Consistenze: &quot; + String(Asset1.IDAsset) + &quot; e &quot; + String(Asset2.IDAsset);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza superato: Recuperata Consistenza: &quot; + String(Asset1.IDAsset);&#xD;
			}&#xD;
			CodiceEsito = null;&#xD;
&#xD;
			if(((&#xD;
			(Asset2 == null)&#xD;
				|| (Asset2 != null &amp;&amp; Asset1.tipologiaAccesso != Asset2.tipologiaAccesso)&#xD;
				|| (Asset2 != null &amp;&amp; localRequest.codiceRisorsaDonating != null&#xD;
					&amp;&amp; localRequest.codiceRisorsaDonating != &quot;&quot; &amp;&amp; localRequest.codiceRisorsaDonating2 != null&#xD;
					&amp;&amp; localRequest.codiceRisorsaDonating2 != &quot;&quot; &amp;&amp; localRequest.codiceRisorsaDonating == localRequest.codiceRisorsaDonating2))&#xD;
				&amp;&amp; Asset1.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA)&#xD;
			|| (Asset2 != null &amp;&amp; (stessaRisorsa || AssetCorrelato) &amp;&amp; destinazioneUsoFonia.contains(destinazioneUso1)))&#xD;
			{&#xD;
				assetFoniaMig = ScriptUtil.copy(Asset1);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				assetDatiMig = ScriptUtil.copy(Asset1);&#xD;
			}&#xD;
&#xD;
			if(Asset2 != null)&#xD;
			{ &#xD;
				if(assetDatiMig != null)&#xD;
				{&#xD;
					assetFoniaMig = ScriptUtil.copy(Asset2);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					assetDatiMig = ScriptUtil.copy(Asset2);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			// RU_915 - Se nella Fonia è stato messo l'asset CPS (caso in cui abbiamo SOLO 1 asset CPS e nessun dati o fonia), allora lo sbianchiamo&#xD;
			if(assetFoniaMig != null &amp;&amp; assetFoniaMig.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS &amp;&amp; assetCPSMig != null)&#xD;
			{&#xD;
				assetFoniaMig = null;&#xD;
			}&#xD;
&#xD;
			// RU_685 - nuova condizione per le migrazioni con asset simmetrico (SF 5.71)&#xD;
			if(assetDatiMig != null &amp;&amp;&#xD;
			   (((assetDatiMig.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT ||&#xD;
				  assetDatiMig.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL) &amp;&amp; &#xD;
					(assetDatiMig.codificaOLOAGCOM != localRequest.codificaOLOAGCOM || &#xD;
					  ((localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB &amp;&amp; &#xD;
						localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB) ||&#xD;
						localRequest.flagNaked == 'N'))) &#xD;
				//SM_9613: escluso ACCORPAMENTOOLO come da SF 8.127&#xD;
				|| (assetDatiMig.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT&#xD;
				    &amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
				// CR 502 - terzo or aggiunto come da SF 8.99&#xD;
				|| ((assetDatiMig.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH || assetDatiMig.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)&#xD;
					&amp;&amp; !OfferteFTTH.contains(String(localRequest.offerta))&#xD;
					&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS					//SM_11629&#xD;
					&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)&#xD;
				))&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: assetDatiMig offerte non gestite. LocalRequest: &quot;+localRequest.offerta+&quot;, Asset: &quot;+assetDatiMig.offerta;&#xD;
				CodiceEsito = &quot;KO_07&quot;;	&#xD;
			}&#xD;
			//RU_1164&#xD;
			else if(assetDatiMig != null &amp;&amp;&#xD;
					(assetDatiMig.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
					 || assetDatiMig.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
					 || assetDatiMig.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH)&#xD;
					 &amp;&amp;&#xD;
				    (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
				     || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
					 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH)&#xD;
					 &amp;&amp; assetDatiMig.codificaOLOAGCOM == localRequest.codificaOLOAGCOM)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: assetDatiMig offerte non gestite con stesso OLO Donating/Recipient. LocalRequest: &quot;+localRequest.offerta+&quot;, Asset: &quot;+assetDatiMig.offerta;&#xD;
				CodiceEsito = &quot;KO_24&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				//---VERIFICA CORRETTEZZA CODICI OLO---//&#xD;
				if(&#xD;
				Asset2 == null &#xD;
				||&#xD;
				(VerificaCowCodeOLOResponse != null &amp;&amp; Asset2 != null&#xD;
					&amp;&amp; VerificaCowCodeOLOResponse.codiceOLOPadre1 != null &amp;&amp; VerificaCowCodeOLOResponse.codiceOLOPadre1 != &quot;&quot;&#xD;
					&amp;&amp; VerificaCowCodeOLOResponse.codiceOLOPadre2 != null &amp;&amp; VerificaCowCodeOLOResponse.codiceOLOPadre2 != &quot;&quot;&#xD;
					&amp;&amp; ((Asset1.codificaOLOAGCOM == VerificaCowCodeOLOResponse.codiceOLOPadre1 &amp;&amp; Asset2.codificaOLOAGCOM == VerificaCowCodeOLOResponse.codiceOLOPadre2)&#xD;
						|| (Asset1.codificaOLOAGCOM == VerificaCowCodeOLOResponse.codiceOLOPadre2 &amp;&amp; Asset2.codificaOLOAGCOM == VerificaCowCodeOLOResponse.codiceOLOPadre1)))&#xD;
				|| &#xD;
				(VerificaCowCodeOLOResponse != null &amp;&amp; (VerificaCowCodeOLOResponse.codiceOLOPadre2 == null || VerificaCowCodeOLOResponse.codiceOLOPadre2 == &quot;&quot;)&#xD;
					&amp;&amp; VerificaCowCodeOLOResponse.codiceOLOPadre1 != null &amp;&amp; VerificaCowCodeOLOResponse.codiceOLOPadre1 != &quot;&quot;&#xD;
					&amp;&amp; (Asset1.codificaOLOAGCOM == VerificaCowCodeOLOResponse.codiceOLOPadre1 || (Asset2 != null &amp;&amp; Asset2.codificaOLOAGCOM == VerificaCowCodeOLOResponse.codiceOLOPadre1)))&#xD;
				|| &#xD;
				localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274)&#xD;
				{	&#xD;
					//---INIZIO ARRICCHIMENTO DATI---//&#xD;
					//---CREA CONSISTENZA FONIA---//&#xD;
					if(assetFoniaMig != null)&#xD;
					{&#xD;
						Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Migrazione | Creazione componente Consistenza Fonia: &quot;+String(assetFoniaMig.IDAsset));	&#xD;
						ConsistenzaFonia = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFoniaType();&#xD;
						&#xD;
						ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
						&#xD;
						ConsistenzaFonia.IDRisorsa = assetFoniaMig.IDRisorsa;&#xD;
&#xD;
						ConsistenzaFonia.IDRisorsaNOW = assetFoniaMig.IDRisorsaNOW;&#xD;
&#xD;
						ConsistenzaFonia.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetFoniaMig.offerta));&#xD;
&#xD;
						ConsistenzaFonia.codificaOLOAGCOMDonating = assetFoniaMig.codificaOLOAGCOM;&#xD;
&#xD;
						ConsistenzaFonia.codificaOLOAGCOMDonor = assetFoniaMig.codificaOLOAGCOMDonor;&#xD;
						&#xD;
						ConsistenzaFonia.IDRisorsaCorrelato = assetFoniaMig.IDRisorsaCorrelato; //SM_9694&#xD;
						&#xD;
						ConsistenzaFonia.operatoreRete = assetFoniaMig.operatoreRete; //RU_1142&#xD;
&#xD;
						if(localRequest.codiceRisorsaDonating2 != null &amp;&amp; localRequest.codiceRisorsaDonating2 != &quot;&quot;)&#xD;
						{&#xD;
							if(assetFoniaMig.IDAsset == Asset1.IDAsset)&#xD;
							{&#xD;
								//SM_8989&#xD;
								if(localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274)&#xD;
								{&#xD;
									var codSess1 = false;&#xD;
									if(Asset1.codificaOLOAGCOM == VerificaCowCodeOLOResponse.codiceOLOPadre1)&#xD;
									{&#xD;
										ConsistenzaFonia.cowCode = VerificaCowCodeOLOResponse.codiceOLOPadre1;&#xD;
										codSess1 = true;&#xD;
									}&#xD;
									else if(Asset1.codificaOLOAGCOM == VerificaCowCodeOLOResponse.codiceOLOPadre2)&#xD;
									{&#xD;
										ConsistenzaFonia.cowCode = VerificaCowCodeOLOResponse.codiceOLOPadre2;&#xD;
									}&#xD;
									else&#xD;
									{&#xD;
										ConsistenzaFonia.cowCode = localRequest.cowCodeOLO;&#xD;
									}&#xD;
									&#xD;
									if(codSess1)&#xD;
									{&#xD;
										ConsistenzaFonia.codiceSessione = localRequest.codiceSessione;&#xD;
									}&#xD;
									else&#xD;
									{&#xD;
										ConsistenzaFonia.codiceSessione = localRequest.codiceSessione2;&#xD;
									}&#xD;
								}&#xD;
								else&#xD;
								{&#xD;
									if(localRequest.cowCodeOLO != null &amp;&amp; localRequest.cowCodeOLO != &quot;&quot;)&#xD;
									{&#xD;
										ConsistenzaFonia.cowCode = localRequest.cowCodeOLO;&#xD;
									}&#xD;
									&#xD;
									if (localRequest.codiceSessione != null &amp;&amp; localRequest.codiceSessione != &quot;&quot;)&#xD;
									{&#xD;
										ConsistenzaFonia.codiceSessione = localRequest.codiceSessione;&#xD;
									}&#xD;
								}&#xD;
							}&#xD;
							else if(assetFoniaMig.IDAsset == Asset2.IDAsset)&#xD;
							{&#xD;
								//SM_8989&#xD;
								if(localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274)&#xD;
								{&#xD;
									var codSess1 = false;&#xD;
									if(Asset2.codificaOLOAGCOM == VerificaCowCodeOLOResponse.codiceOLOPadre1)&#xD;
									{&#xD;
										ConsistenzaFonia.cowCode = VerificaCowCodeOLOResponse.codiceOLOPadre1;&#xD;
										codSess1 = true;&#xD;
									}&#xD;
									else if(Asset2.codificaOLOAGCOM == VerificaCowCodeOLOResponse.codiceOLOPadre2)&#xD;
									{&#xD;
										ConsistenzaFonia.cowCode = VerificaCowCodeOLOResponse.codiceOLOPadre2;&#xD;
									}&#xD;
									else&#xD;
									{&#xD;
										ConsistenzaFonia.cowCode = localRequest.cowCodeOLO;&#xD;
									}&#xD;
									&#xD;
									if(codSess1)&#xD;
									{&#xD;
										ConsistenzaFonia.codiceSessione = localRequest.codiceSessione;&#xD;
									}&#xD;
									else&#xD;
									{&#xD;
										ConsistenzaFonia.codiceSessione = localRequest.codiceSessione2;&#xD;
									}&#xD;
								}&#xD;
								else&#xD;
								{&#xD;
									if (localRequest.cowCodeOLO2!= null &amp;&amp; localRequest.cowCodeOLO2!= &quot;&quot;)&#xD;
									{&#xD;
										ConsistenzaFonia.cowCode = localRequest.cowCodeOLO2;&#xD;
									}&#xD;
									&#xD;
									if (localRequest.codiceSessione2 != null &amp;&amp; localRequest.codiceSessione2 != &quot;&quot;)&#xD;
									{&#xD;
										ConsistenzaFonia.codiceSessione = localRequest.codiceSessione2;&#xD;
									}&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
						else &#xD;
						{&#xD;
							if (localRequest.cowCodeOLO!= null &amp;&amp; localRequest.cowCodeOLO!= &quot;&quot;)&#xD;
