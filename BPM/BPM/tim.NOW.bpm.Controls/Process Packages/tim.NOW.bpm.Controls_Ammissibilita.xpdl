        <xpdl2:Activity Id="_x8OSUnEeEee0o4pQ6mlIUQ" Name="VerificaCorrispondenzanumerazioniinportabilitdaDD" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Corrispondenza numerazioni in portabilità da DD">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per il controllo CTRL CORRISPONDENZA NUM&quot;;&#xD;
&#xD;
var failed = false;&#xD;
&#xD;
// CASO REGOLATORIO &#xD;
if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
{&#xD;
	if (localRequest.DNAggiuntivo != null &amp;&amp; localRequest.DNAggiuntivo.size() > 0)&#xD;
	{&#xD;
		var i = 0;&#xD;
		while(!failed &amp;&amp; i &lt; localRequest.DNAggiuntivo.size())&#xD;
		{&#xD;
			var currentDN = localRequest.DNAggiuntivo.get(i);&#xD;
			var matched = false;&#xD;
			&#xD;
			if(currentDN == NumeroPrincipale)&#xD;
			{&#xD;
				matched = true;&#xD;
			}&#xD;
			&#xD;
			var j = 0;&#xD;
			while(!matched &amp;&amp; j &lt; DATIDBCFX.size())&#xD;
			{&#xD;
				var currentDBCFX = DATIDBCFX.get(j);&#xD;
				&#xD;
				if(currentDN == currentDBCFX.DN)&#xD;
				{&#xD;
					matched = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(!matched)&#xD;
			{&#xD;
				failed = true;&#xD;
				EsitoResponse.descrizione = &quot;Nessuna corrispondenza trovata per il DN: &quot; + currentDN + &quot; tra i DN di DBCFX o NumeroPrincipale &quot;+ NumeroPrincipale + &quot;strutturaRichiesta = REGOLATORIO&quot;;&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
// CASO DATI&#xD;
else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
		|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)&#xD;
{&#xD;
/*	// Attivazione274&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274)&#xD;
	{&#xD;
		// EsitoOK&#xD;
		failed = false;		&#xD;
	}&#xD;
	else // Migrazione da Doppio Donating&#xD;
	{*/&#xD;
&#xD;
		if (localRequest.DNAggiuntivo != null &amp;&amp; localRequest.DNAggiuntivo.size() > 0)&#xD;
		{&#xD;
			var i = 0;&#xD;
			while(!failed &amp;&amp; i &lt; localRequest.DNAggiuntivo.size())&#xD;
			{&#xD;
				var currentDN = localRequest.DNAggiuntivo.get(i);&#xD;
				var matched = false;&#xD;
							&#xD;
				var j = 0;&#xD;
				while(!matched &amp;&amp; j &lt; DATIDBCFX.size())&#xD;
				{&#xD;
					var currentDBCFX = DATIDBCFX.get(j);&#xD;
					&#xD;
					if(currentDN == currentDBCFX.DN)&#xD;
					{&#xD;
						matched = true;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
				&#xD;
				if(!matched)&#xD;
				{&#xD;
					failed = true;&#xD;
					EsitoResponse.descrizione = &quot;Nessuna corrispondenza trovata per il DN: &quot; + currentDN + &quot; tra i DN di DBCFX strutturaRichiesta = DATI&quot;;&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
//	}&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Trovate tutte le corrispondenze tra i DN in INPUT ed i DN di DBCFX o Numero Principale&quot;;&#xD;
}&#xD;
&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="125.0" LaneId="_x7_BwXEeEee0o4pQ6mlIUQ" Width="182.0">
