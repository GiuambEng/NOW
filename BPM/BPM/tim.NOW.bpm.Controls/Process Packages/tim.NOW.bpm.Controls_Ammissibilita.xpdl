&#xD;
	&#xD;
	if(assetFWA != null)&#xD;
	{&#xD;
		// ---- CONSISTENZA DATI ----&#xD;
		Log.write(LogString+&quot;Creazione componente Consistenza Dati: &quot;+String(assetFWA.IDAsset));&#xD;
		&#xD;
		ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();&#xD;
		&#xD;
