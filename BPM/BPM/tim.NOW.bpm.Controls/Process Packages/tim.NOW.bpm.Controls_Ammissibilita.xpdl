          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaIDRisorsaRequest = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createVerifica_ID_Risorsa_Request();&#xD;
&#xD;
VerificaIDRisorsaRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaIDRisorsaRequest.IDRisorsa = localRequest.IDRisorsa;&#xD;
&#xD;
//SM_9345: aggiunto if per la sottolavorazione RIENTROCPS (CESSAZIONE CPS CON codificaOLOAGCOMA = TLC)&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
	&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS&#xD;
	&amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
	&amp;&amp; localRequest.canaleRichiesta != it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.SDR)   //aggiunta con SM_9405&#xD;
{&#xD;
	var foundCodiceOloCess = false;&#xD;
	var i=0;&#xD;
&#xD;
	while(!foundCodiceOloCess &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
		{&#xD;
			var j=0; &#xD;
			&#xD;
			while(!foundCodiceOloCess &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOLOCESS)&#xD;
				{&#xD;
					foundCodiceOloCess = true;&#xD;
					VerificaIDRisorsaRequest.codiceOLOAGCOM = attributo.valoreAttributo;&#xD;
					&#xD;
					Process.auditLog(&quot;Trovato attributo CODICEOLOCESS &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;	&#xD;
	}&#xD;
}&#xD;
else //solito&#xD;
{&#xD;
	VerificaIDRisorsaRequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;	&#xD;
}&#xD;
&#xD;
if(localRequest.ordine.codicePacchettoNOW != null)&#xD;
{&#xD;
	VerificaIDRisorsaRequest.isPacchetto = true;&#xD;
}&#xD;
else&#xD;
{&#xD;
	VerificaIDRisorsaRequest.isPacchetto = false;&#xD;
}&#xD;
&#xD;
if(localRequest.lavorazione != null)&#xD;
{&#xD;
	VerificaIDRisorsaRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
}&#xD;
&#xD;
VerificaIDRisorsaRequest.numeroLinea = localRequest.numeroTelefonico;&#xD;
&#xD;
if(localRequest.offerta != null)&#xD;
{&#xD;
	VerificaIDRisorsaRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
}&#xD;
&#xD;
VerificaIDRisorsaRequest.strutturaRichiesta = it_telecomitalia_it_NOW_casedata_v1_TipoStrutturaRichiestaEnumeration.get(String(localRequest.strutturaRichiesta));&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.tipologiaLinea != null)&#xD;
{&#xD;
	VerificaIDRisorsaRequest.tipoLinea = it_telecomitalia_it_NOW_casedata_v1_TipologiaLineaEnumeration.get(String(localRequest.ordine.tipologiaLinea));&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
	|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	if(VerificaIDRisorsaResponse.idRisorsaDati != null)&#xD;
	{&#xD;
		localRequest.IDRisorsa = VerificaIDRisorsaResponse.idRisorsaDati;&#xD;
		localRequest.ordine.IDRisorsa = VerificaIDRisorsaResponse.idRisorsaDati;&#xD;
		localRequest.ordine.IDRisorsaNOW = VerificaIDRisorsaResponse.idRisorsaNOW;&#xD;
	}&#xD;
	if(VerificaIDRisorsaResponse.esito.codice == true &amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
	{&#xD;
		localRequest.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.get(VerificaIDRisorsaResponse.datiAccesso.offertaAsset);&#xD;
		localRequest.IDOfferta = parseInt(VerificaIDRisorsaResponse.datiAccesso.identificativoOffertaAsset, 10);&#xD;
		localRequest.ordine.offerta = it_telecomitalia_it_NOW_casedata_OffertaEnumeration.get(VerificaIDRisorsaResponse.datiAccesso.offertaAsset);&#xD;
	}&#xD;
	//RU_1451&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM&#xD;
	   &amp;&amp; VerificaIDRisorsaResponse.idRisorsaOpenFiber != null)&#xD;
	{&#xD;
		localRequest.ordine.idRisorsaOpenFiber = VerificaIDRisorsaResponse.idRisorsaOpenFiber;&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
