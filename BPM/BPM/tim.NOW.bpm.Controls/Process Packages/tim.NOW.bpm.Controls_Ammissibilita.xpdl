        <xpdl2:Activity Id="_ni1TAO4AEeazSbn9P97FTQ" Name="Verificalavorazione" xpdExt:DisplayName="Verifica lavorazione">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_5aIQYLuaEea-FqioYDGtog"/>
                  <xpdl2:TransitionRef Id="_kaM4sO4BEeazSbn9P97FTQ"/>
                  <xpdl2:TransitionRef Id="_8GzbcO4CEeazSbn9P97FTQ"/>
                  <xpdl2:TransitionRef Id="_lkvR0O4EEeazSbn9P97FTQ"/>
                  <xpdl2:TransitionRef Id="_flAcoO4HEeazSbn9P97FTQ"/>
                  <xpdl2:TransitionRef Id="_yn1-8O4IEeazSbn9P97FTQ"/>
                  <xpdl2:TransitionRef Id="_ao-mYPILEeaZ6cKbRk0TDA"/>
                  <xpdl2:TransitionRef Id="_X2E5kPIOEeaZ6cKbRk0TDA"/>
                  <xpdl2:TransitionRef Id="_YXFU4PIOEeaZ6cKbRk0TDA"/>
                  <xpdl2:TransitionRef Id="_5GhrQAv9EeiwxfCTQ56R9A"/>
                  <xpdl2:TransitionRef Id="_jnZe8wVWEeqsOP2PgAIa2A"/>
                  <xpdl2:TransitionRef Id="_p1kRYwVWEeqsOP2PgAIa2A"/>
                  <xpdl2:TransitionRef Id="_bMbXAR_fEeqXuus3WsJtbw"/>
                  <xpdl2:TransitionRef Id="_iUPRwR_gEeqXuus3WsJtbw"/>
                  <xpdl2:TransitionRef Id="_JnIzEdMPEeq7la06MjxCkQ"/>
                  <xpdl2:TransitionRef Id="_didJUZLuEeuu8rvfxCUX4A"/>
                  <xpdl2:TransitionRef Id="_O--zMckwEeuhVM0iUag8Cw"/>
                  <xpdl2:TransitionRef Id="_SFE6EMkzEeuhVM0iUag8Cw"/>
                  <xpdl2:TransitionRef Id="_S_q6EMkzEeuhVM0iUag8Cw"/>
                  <xpdl2:TransitionRef Id="_HAsxMMk0EeuhVM0iUag8Cw"/>
                  <xpdl2:TransitionRef Id="_6ge28BF2EeyN2L0yjoZgiA"/>
                  <xpdl2:TransitionRef Id="_7ssLYBF2EeyN2L0yjoZgiA"/>
                  <xpdl2:TransitionRef Id="_8i7P0BF2EeyN2L0yjoZgiA"/>
                  <xpdl2:TransitionRef Id="_GZAWESs_Eey5QN9Wj-zCSQ"/>
                  <xpdl2:TransitionRef Id="_0iFkgdyMEe6ObbN4EiNagg"/>
                  <xpdl2:TransitionRef Id="_B5bZE0hSEfCLI8yfWP7Upw"/>
