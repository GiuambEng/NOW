                <xpdl2:Script ScriptGrammar="JavaScript">eseguiControllo = false;&#xD;
&#xD;
if(localRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.RICARICA)&#xD;
{&#xD;
	if(IDAssetAccessoDinamico != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(IDAssetAccessoDinamico));&#xD;
		Asset = AssetRef.readAsset();&#xD;
		&#xD;
		if(Asset != null&#xD;
		   &amp;&amp; Asset.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
		   &amp;&amp; Asset.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
		   &amp;&amp; Asset.flagPortato == &quot;Y&quot;&#xD;
		   &amp;&amp; Asset.IDRisorsa.slice(0,1) == &quot;U&quot;)&#xD;
		{&#xD;
			eseguiControllo = true;&#xD;
		}		&#xD;
	}&#xD;
}</xpdl2:Script>
