        <xpdl2:Activity Id="_uHyP80PbEeikB5gD0W8I9g" Name="VerificaOscuramentoServizioDinamico" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Oscuramento Servizio Dinamico">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;controllo superato - Nessun servizio dinamico in ingresso&quot;;&#xD;
&#xD;
var opzioneDinamica = false;&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
while(!opzioneDinamica &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(!opzioneDinamica &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONEDINAMICA&#xD;
			&amp;&amp; currentAttDettOrdine.valoreAttributo == &quot;Y&quot;)&#xD;
			{&#xD;
				opzioneDinamica=true;&#xD;
			}&#xD;
		j++;&#xD;
		}&#xD;
	}&#xD;
i++;&#xD;
}&#xD;
&#xD;
if (opzioneDinamica)&#xD;
{&#xD;
	EsitoResponse.codice=false;&#xD;
	EsitoResponse.descrizione = &quot;controllo fallito - trovato servizio dinamico&quot;;&#xD;
}&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
