        <xpdl2:Activity Id="_lHCfcsbDEeatjZjsZIIi5Q" Name="RecuperoIdRisorsa" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Recupero Id Risorsa">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_gbxvQMg5EeaP9bX0zobeeQ">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="false" Direction="IN" Formal="input">
                      <xpdl2:Actual ScriptGrammar="JavaScript">RecuperoIDRisorsaRequest</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageIn>
                <xpdl2:MessageOut Id="_gbxvQcg5EeaP9bX0zobeeQ">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="output.esito.codice">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.codice</xpdl2:Actual>
