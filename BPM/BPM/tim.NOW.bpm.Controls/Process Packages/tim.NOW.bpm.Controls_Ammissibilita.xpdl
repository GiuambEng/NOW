            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_42zT6PHfEeaZ6cKbRk0TDA" Name="CalcoloOLOAccorpante" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="CalcoloOLOAccorpante">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="__C6XogATEee5T_6Nyhre8g">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="false" Direction="IN" Formal="parameters">
                      <xpdl2:Actual ScriptGrammar="JavaScript">CalcolaOLOAccorpanteInput</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageIn>
                <xpdl2:MessageOut Id="__C6XowATEee5T_6Nyhre8g">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="false" Direction="OUT" Formal="parameters">
                      <xpdl2:Actual ScriptGrammar="JavaScript">CalcolaOLOAccorpanteOutput</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="__DAeQAATEee5T_6Nyhre8g" OperationName="CalcoloOLOAccorpante">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="CalcoloOLOAccorpantePortTypeSOAP" ServiceName="CalcoloOLOAccorpantePortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="CalcoloOLOAccorpante_gen1.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="CalcoloOLOAccorpantePortType" OperationName="CalcoloOLOAccorpante">
                  <xpdExt:ExternalReference location="CalcoloOLOAccorpante_gen1.wsdl"/>
                </xpdExt:PortTypeOperation>
              </xpdl2:TaskService>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:Performers>
            <xpdl2:Performer>__DAeQAATEee5T_6Nyhre8g</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="77.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="111.0">
              <xpdl2:Coordinates XCoordinate="1470.0" YCoordinate="234.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">CalcolaOLOAccorpanteInput = com_tim_NOW_xsd_CaclcoloOLOAccorpante_Factory.createCalcoloOLOAccorpanteInputType();&#xD;
CalcolaOLOAccorpanteInput.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
CalcolaOLOAccorpanteInput.calcoloOLOIn = com_tim_NOW_xsd_CaclcoloOLOAccorpante_Factory.createCalcoloOLOAccorpante();&#xD;
&#xD;
if(ConsistenzaDati!=null &amp;&amp; ConsistenzaDati.codificaOLOAGCOMDonating!=null &amp;&amp; ConsistenzaDati.codificaOLOAGCOMDonating!= &quot;&quot;){&#xD;
	CalcolaOLOAccorpanteInput.calcoloOLOIn.CODFC_OLO_AGCOM.add(ConsistenzaDati.codificaOLOAGCOMDonating);&#xD;
}&#xD;
if(ConsistenzaFonia!=null &amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating!=null &amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating!= &quot;&quot;){&#xD;
	CalcolaOLOAccorpanteInput.calcoloOLOIn.CODFC_OLO_AGCOM.add(ConsistenzaFonia.codificaOLOAGCOMDonating);&#xD;
}&#xD;
&#xD;
//SM_9676&#xD;
for(var i=0; i&lt;ConsistenzaCPS.size(); i++)&#xD;
{&#xD;
	if(ConsistenzaCPS.get(i).codificaOLOAGCOMDonating != null)&#xD;
	{&#xD;
		CalcolaOLOAccorpanteInput.calcoloOLOIn.CODFC_OLO_AGCOM.add(ConsistenzaCPS.get(i).codificaOLOAGCOMDonating);&#xD;
	}&#xD;
}&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(ConsistenzaDati!=null &amp;&amp; ConsistenzaDati.codificaOLOAGCOMDonating!= null &amp;&amp; ConsistenzaDati.codificaOLOAGCOMDonating!=&quot;&quot;){&#xD;
	var i=0;&#xD;
	var trovato=false;&#xD;
	while(!trovato &amp;&amp; i&lt;CalcolaOLOAccorpanteOutput.calcoloOLOOut.size()){&#xD;
		var OLOAccorpante = CalcolaOLOAccorpanteOutput.calcoloOLOOut.get(i);&#xD;
		if(ConsistenzaDati.codificaOLOAGCOMDonating == OLOAccorpante.COD_OLO_AGCOM){&#xD;
			ConsistenzaDati.codificaOLOAGCOMDonating = OLOAccorpante.COD_OLO_ACCORPANTE;&#xD;
			trovato = true;&#xD;
		}&#xD;
		i++;	&#xD;
	}&#xD;
}&#xD;
&#xD;
if(ConsistenzaFonia!=null &amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating!= null &amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating!=&quot;&quot;){&#xD;
	var i=0;&#xD;
	var trovato=false;&#xD;
	while(!trovato &amp;&amp; i&lt;CalcolaOLOAccorpanteOutput.calcoloOLOOut.size()){&#xD;
		var OLOAccorpante = CalcolaOLOAccorpanteOutput.calcoloOLOOut.get(i);&#xD;
		if(ConsistenzaFonia.codificaOLOAGCOMDonating == OLOAccorpante.COD_OLO_AGCOM){&#xD;
			ConsistenzaFonia.codificaOLOAGCOMDonating = OLOAccorpante.COD_OLO_ACCORPANTE;&#xD;
			trovato = true;&#xD;
		}&#xD;
		i++;	&#xD;
	}&#xD;
}&#xD;
&#xD;
//SM_9676 - inserito ciclo perché ConsistenzaCPS ora è multiplo&#xD;
for(var j=0; j&lt;ConsistenzaCPS.size(); j++)&#xD;
{&#xD;
	var i=0;&#xD;
	var trovato=false;&#xD;
	while(!trovato &amp;&amp; i&lt;CalcolaOLOAccorpanteOutput.calcoloOLOOut.size()){&#xD;
		var OLOAccorpante = CalcolaOLOAccorpanteOutput.calcoloOLOOut.get(i);&#xD;
		if(ConsistenzaCPS.get(j).codificaOLOAGCOMDonating == OLOAccorpante.COD_OLO_AGCOM){&#xD;
			ConsistenzaCPS.get(j).codificaOLOAGCOMDonating = OLOAccorpante.COD_OLO_ACCORPANTE;&#xD;
			trovato = true;&#xD;
		}&#xD;
		i++;	&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_9SQbcvHzEeaZ6cKbRk0TDA" Name="VariazioneFonia" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Variazione Fonia">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
CodiceEsito = null;&#xD;
&#xD;
var assetFonia = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetFonia = null;&#xD;
var assetDati = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetDati = null;&#xD;
var asset1 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset1 = null;&#xD;
var asset2 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset2 = null;&#xD;
var assetNP = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetNP = null;&#xD;
&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Fonia | Verifica servizio in consistenza Variazione Fonia.&quot;);&#xD;
&#xD;
if(localRequest.IDRisorsa != null &amp;&amp; localRequest.IDRisorsa != &quot;&quot;)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta &lt;> 'CPS'&quot;);&#xD;
	c.setQueryParameter(&quot;idr&quot;, localRequest.IDRisorsa);&#xD;
	//c.setQueryParameter(&quot;codificaOLOAGCOMRichiesta&quot;, localRequest.codificaOLOAGCOM);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Fonia | Trovato Asset con IDRisorsa=&quot;+localRequest.IDRisorsa);&#xD;
		&#xD;
		var i = 0;&#xD;
		while(i &lt; result.size())&#xD;
		{&#xD;
			var assetTempRef = result.get(i);&#xD;
			var assetTemp = assetTempRef.readAsset();&#xD;
			if(assetTemp.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP)&#xD;
			{&#xD;
				if(asset1 == null)&#xD;
				{&#xD;
					asset1 = ScriptUtil.copy(assetTemp);&#xD;
				}&#xD;
				else if(asset2 == null)&#xD;
				{&#xD;
					asset2 = ScriptUtil.copy(assetTemp);&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				assetNP = ScriptUtil.copy(assetTemp);&#xD;
			}&#xD;
			i++;	&#xD;
		}&#xD;
	}&#xD;
&#xD;
	if((asset1 == null || assetNP == null) &amp;&amp; localRequest.numeroTelefonico != null &amp;&amp; localRequest.numeroTelefonico != &quot;&quot;)&#xD;
	{&#xD;
		c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: DN AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta &lt;> 'CPS'&quot;);&#xD;
		c.setQueryParameter(&quot;DN&quot;, localRequest.numeroTelefonico);&#xD;
		//c.setQueryParameter(&quot;codificaOLOAGCOMRichiesta&quot;, localRequest.codificaOLOAGCOM);&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Fonia | Trovato Asset con IDRisorsa=numeroTelefonico(&quot;+localRequest.numeroTelefonico+&quot;)&quot;);&#xD;
&#xD;
		if(result != null &amp;&amp; result.size() > 0)&#xD;
		{&#xD;
			var i = 0;&#xD;
			while(i &lt; result.size())&#xD;
			{&#xD;
				var assetTempRef = result.get(i);&#xD;
				var assetTemp = assetTempRef.readAsset();&#xD;
				if(assetTemp.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP)&#xD;
				{&#xD;
					if(asset1 == null)&#xD;
					{&#xD;
						asset1 = ScriptUtil.copy(assetTemp);&#xD;
					}&#xD;
					else if(asset2 == null)&#xD;
					{&#xD;
						asset2 = ScriptUtil.copy(assetTemp);&#xD;
					}&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					assetNP = ScriptUtil.copy(assetTemp);&#xD;
				}&#xD;
				i++;	&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	if(asset1 != null)&#xD;
	{&#xD;
		if(asset2 != null)&#xD;
		{&#xD;
			//DOPPIO ASSET CON STESSA TIPOLOGIA ACCESSO ULL+SLU&#xD;
			if(asset1.tipologiaAccesso == asset2.tipologiaAccesso&#xD;
			&amp;&amp; (!(asset1.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA&#xD;
				&amp;&amp; asset1.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
				&amp;&amp; asset2.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
				&amp;&amp; ((String(asset1.offerta).slice(0, 3) == &quot;ULL&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;ULL&quot;)&#xD;
					|| (String(asset1.offerta).slice(0, 3) == &quot;SLU&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;SLU&quot;)))))&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: caso particolare ULL + ULL o SLU + SLU di TI non superato.&quot;;&#xD;
				CodiceEsito = &quot;KO_01&quot;;&#xD;
			}&#xD;
&#xD;
			//DOPPIO ASSET SHA&#xD;
			else if (asset1 != null &amp;&amp; asset2 != null &amp;&amp;&#xD;
					(String(asset1.offerta).slice(0, 3) == &quot;SHA&quot;  || String(asset2.offerta).slice(0, 3) == &quot;SHA&quot; ))&#xD;
			{&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Fonia | caso Doppio Asset SHA&quot;);&#xD;
				&#xD;
				if(String(asset2.offerta).slice(0,3)==&quot;SHA&quot;)&#xD;
				{&#xD;
					assetDati = asset2;&#xD;
					assetFonia = asset1;&#xD;
				}&#xD;
				else &#xD;
				{&#xD;
					assetDati = asset1;&#xD;
					assetFonia = asset2;&#xD;
&#xD;
				}&#xD;
&#xD;
			}&#xD;
			&#xD;
			//DOPPIO ASSET FONIA ULL+SLU&#xD;
			else if (asset1.tipologiaAccesso == asset2.tipologiaAccesso&#xD;
			&amp;&amp; ((asset1.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA&#xD;
				&amp;&amp; asset1.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
				&amp;&amp; asset2.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
				&amp;&amp; ((String(asset1.offerta).slice(0, 3) == &quot;ULL&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;ULL&quot;)&#xD;
					|| (String(asset1.offerta).slice(0, 3) == &quot;SLU&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;SLU&quot;)))))&#xD;
			{&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Fonia | caso Doppio Asset Fonia ULL+SLU&quot;);&#xD;
				&#xD;
				var DestinazioneUso1 = &quot;&quot;;&#xD;
				DestinazioneUso1 = null;&#xD;
				var destinazioneUso2 = &quot;&quot;;&#xD;
				destinazioneUso2 = null;&#xD;
&#xD;
				var i = 0;&#xD;
				while(DestinazioneUso1 == null &amp;&amp; i &lt; asset1.dettaglioasset.size())&#xD;
				{&#xD;
					var DettAsset1 = asset1.dettaglioasset.get(i);&#xD;
					if(String(DettAsset1.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						var j = 0;&#xD;
						while(DestinazioneUso1 == null &amp;&amp; j &lt; DettAsset1.attributidettaglioasset.size())&#xD;
						{&#xD;
							var AttrDettAsset1 = DettAsset1.attributidettaglioasset.get(j);&#xD;
							if(AttrDettAsset1.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
							{&#xD;
								DestinazioneUso1 = AttrDettAsset1.valoreAttributo;&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					i++;	&#xD;
				}&#xD;
&#xD;
				var i = 0;&#xD;
				while(destinazioneUso2 == null &amp;&amp; i &lt; asset2.dettaglioasset.size())&#xD;
				{&#xD;
					var DettAsset2 = asset2.dettaglioasset.get(i);&#xD;
					if(String(DettAsset2.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						var j = 0;&#xD;
						while(destinazioneUso2 == null &amp;&amp; j &lt; DettAsset2.attributidettaglioasset.size())&#xD;
						{&#xD;
							var AttrDettAsset2 = DettAsset2.attributidettaglioasset.get(j);&#xD;
							if(AttrDettAsset2.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
							{&#xD;
								destinazioneUso2 = AttrDettAsset2.valoreAttributo;&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					i++;&#xD;
				}&#xD;
&#xD;
				if(destinazioneUsoFonia.contains(DestinazioneUso1))&#xD;
				{&#xD;
					assetFonia = asset1;&#xD;
					assetDati = asset2;&#xD;
&#xD;
				}&#xD;
				else if(destinazioneUsoFonia.contains(destinazioneUso2))&#xD;
				{&#xD;
					assetFonia = asset2;&#xD;
					assetDati = asset1;&#xD;
&#xD;
				}&#xD;
			}&#xD;
			else &#xD;
			{&#xD;
				if (asset1.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA)&#xD;
				{	&#xD;
					assetFonia = asset1;&#xD;
				}&#xD;
				else &#xD;
				{&#xD;
					assetFonia = asset2;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		//1 ASSET	&#xD;
		{&#xD;
			if (asset1.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA || String(asset1.offerta).slice(0, 3) == &quot;SHA&quot;) //SM_8145: aggiunta esclusione per SHA, visto che è un asset dati gestito con variazione fonia&#xD;
			{	&#xD;
				assetFonia = asset1;&#xD;
			}&#xD;
			else &#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: consistenza FONIA non trovata per IDRisorsa: &quot; + localRequest.IDRisorsa + &quot; oppure NumeroTelefonico: &quot; + localRequest.numeroTelefonico;&#xD;
				CodiceEsito = &quot;KO_09&quot;;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: consistenza FONIA non trovata per IDRisorsa: &quot; + localRequest.IDRisorsa + &quot; oppure NumeroTelefonico: &quot; + localRequest.numeroTelefonico;&#xD;
		CodiceEsito = &quot;KO_09&quot;;&#xD;
	}	&#xD;
}&#xD;
&#xD;
//--------------------------------------------------CREA CONSISTENZA DATI-------------------------------------------------//&#xD;
if(assetDati != null)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Fonia | Creazione componente ConsistenzaDati: &quot;+assetDati.IDAsset);&#xD;
	ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();		 &#xD;
	//CODIFICAOLOAGCOMDONATING&#xD;
	ConsistenzaDati.codificaOLOAGCOMDonating = assetDati.codificaOLOAGCOM;		&#xD;
	//IDRISORSA&#xD;
	ConsistenzaDati.IDRisorsa = assetDati.IDRisorsa;		&#xD;
	//IDRISORSANOW&#xD;
	ConsistenzaDati.IDRisorsaNOW = assetDati.IDRisorsaNOW;		&#xD;
	//OFFERTA&#xD;
	ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetDati.offerta));&#xD;
	//CODICEORDINETI&#xD;
	ConsistenzaDati.codiceOrdineTI = assetDati.codiceOrdineTI;		&#xD;
	//CODICEORDINEOLO&#xD;
	ConsistenzaDati.codiceOrdineOLO = assetDati.codiceOrdineOLO;		&#xD;
	//IDENTIFICATIVOASSET&#xD;
	ConsistenzaDati.IDAsset = assetDati.IDAsset;		&#xD;
	//STATO&#xD;
	ConsistenzaDati.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(assetDati.statoAsset));	&#xD;
&#xD;
	//OPERATORERETE - RU_1142&#xD;
	ConsistenzaDati.operatoreRete = assetDati.operatoreRete;&#xD;
	&#xD;
	ConsistenzaDati.assetBTWhiteList = assetDati.assetBTWhiteList; //R1E-21-0325&#xD;
	&#xD;
	//R1E-21-0325&#xD;
	if(ConsistenzaDati.assetBTWhiteList != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
	}&#xD;
	&#xD;
	//RU_1275&#xD;
	if(assetDati.exOperatoreRete != null &amp;&amp; assetDati.exOperatoreRete != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.exOperatoreRete = assetDati.exOperatoreRete;&#xD;
		localRequest.ordine.exOperatoreRete = assetDati.exOperatoreRete;&#xD;
	}&#xD;
&#xD;
	/* caratteristica, tecnologia e profilo linea non previsti per SHA - per ora è l'unico caso in cui creiamo la consistenza dati&#xD;
	//CARATTERISTICA&#xD;
	var offerta = String(localRequest.offerta.BITSTREAMATMASIMMETRICOFLAT);&#xD;
	var offertaSlice4 = offerta.slice((offerta.length-4),offerta.length );&#xD;
	var offertaSlice2 = offerta.slice((offerta.length-2),offerta.length );&#xD;
	if(offertaSlice4 == &quot;FLAT&quot;)&#xD;
	{&#xD;
		ConsistenzaDati.caratteristica = &quot;0&quot;;&#xD;
	}&#xD;
	else if(offertaSlice4 == &quot;LITE&quot;)&#xD;
	{&#xD;
		ConsistenzaDati.caratteristica = &quot;1&quot;;&#xD;
	}&#xD;
	else if(offertaSlice2 == &quot;HL&quot;)&#xD;
	{&#xD;
		ConsistenzaDati.caratteristica = &quot;2&quot;;&#xD;
	}		&#xD;
	//TECNOLOGIA&#xD;
	//PROFILOTECNICOLINEA&#xD;
	var TECNOLOGIA = false;&#xD;
	var PROFILOTECNICOLINEA = false;&#xD;
	var i = 0;&#xD;
	var accessoTrovato = false;&#xD;
	while(!accessoTrovato &amp;&amp; i &lt; assetDati.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetDati.dettaglioasset.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			accessoTrovato = true;&#xD;
			var j = 0;&#xD;
			while((!TECNOLOGIA || !PROFILOTECNICOLINEA) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);					&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIA)&#xD;
				{&#xD;
					TECNOLOGIA = true;&#xD;
					ConsistenzaDati.tecnologia = attributo.valoreAttributo;		&#xD;
				}&#xD;
&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
				{&#xD;
					PROFILOTECNICOLINEA = true;&#xD;
					ConsistenzaDati.profiloTecnicoLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}*/&#xD;
&#xD;
	//TIPOLINEA&#xD;
	var TIPOLINEA = false;&#xD;
	var TIPOLOGIACLUSTERCOMUNE = false; //RU_964&#xD;
	&#xD;
	var i=0;&#xD;
	var accessoTrovato = false;&#xD;
	while(!accessoTrovato &amp;&amp; i &lt; assetDati.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetDati.dettaglioasset.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			accessoTrovato = true;&#xD;
			var j = 0;&#xD;
			while( (!TIPOLINEA || !TIPOLOGIACLUSTERCOMUNE) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);					&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					TIPOLINEA = true;&#xD;
					ConsistenzaDati.tipoLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE) //RU_964&#xD;
				{&#xD;
					TIPOLOGIACLUSTERCOMUNE = true;&#xD;
					ConsistenzaDati.tipologiaClusterComune = attributo.valoreAttributo;		&#xD;
				}&#xD;
&#xD;
				j++;&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}&#xD;
&#xD;
&#xD;
	//AZIONE&#xD;
	ConsistenzaDati.azione = &quot;N&quot;;&#xD;
&#xD;
}&#xD;
&#xD;
//RU_732 - confronto QUANTITALINEE in asset e XML in input - KO_22&#xD;
if(assetFonia != null &amp;&amp; String(localRequest.offerta).slice(0, 3) == &quot;WLR&quot; &amp;&amp; &#xD;
   localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOCANALIWLR)&#xD;
{	&#xD;
	var TipoLineaAsset = null;&#xD;
	var TipoLineaAsset = &quot;&quot;;&#xD;
	var StrutturaLineaAsset = null;&#xD;
	var StrutturaLineaAsset = &quot;&quot;;&#xD;
	var QuantitaLinee = null;&#xD;
	var QuantitaLinee = &quot;&quot;;&#xD;
	var QuantitaCanali = null;&#xD;
	var QuantitaCanali = &quot;&quot;;&#xD;
&#xD;
	var i = 0;&#xD;
	var accessoTrovato = false;&#xD;
	&#xD;
	while(!accessoTrovato &amp;&amp; i &lt; assetFonia.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetFonia.dettaglioasset.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			accessoTrovato = true;&#xD;
			var j = 0;&#xD;
			while((QuantitaCanali == &quot;&quot; || QuantitaLinee == &quot;&quot; || StrutturaLineaAsset == &quot;&quot; || TipoLineaAsset == &quot;&quot;) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					TipoLineaAsset = attributo.valoreAttributo;	&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
				{&#xD;
					StrutturaLineaAsset = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITACANALI)&#xD;
				{&#xD;
					QuantitaCanali = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITALINEE)&#xD;
				{&#xD;
					QuantitaLinee = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				j++;&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	accessoTrovato = false;&#xD;
	var QuantitaLineeXML = null;&#xD;
	var QuantitaLineeXML = &quot;&quot;;&#xD;
	i = 0;&#xD;
	&#xD;
	while(!accessoTrovato &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			accessoTrovato = true;&#xD;
			var j = 0;&#xD;
			while(QuantitaLineeXML == &quot;&quot; &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITALINEE)&#xD;
				{&#xD;
					QuantitaLineeXML = attributo.valoreAttributo;		&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
&#xD;
	if((QuantitaLineeXML != &quot;&quot; &amp;&amp; TipoLineaAsset != &quot;&quot; &amp;&amp; StrutturaLineaAsset != &quot;&quot; &amp;&amp; (QuantitaCanali != &quot;&quot; || QuantitaLinee != &quot;&quot;)) &amp;&amp;&#xD;
	   (((TipoLineaAsset == 'POTS' &amp;&amp; (StrutturaLineaAsset == 'PBX' || StrutturaLineaAsset == 'GNR')) &amp;&amp; QuantitaLinee == QuantitaLineeXML)||&#xD;
		((TipoLineaAsset == 'ISDN' &amp;&amp; (StrutturaLineaAsset == 'PBX' || StrutturaLineaAsset == 'GNR')) &amp;&amp; QuantitaCanali == QuantitaLineeXML)))&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: quantità linee in asset e in XML in input uguali&quot;;&#xD;
		CodiceEsito = &quot;KO_22&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
//--------------------------------------------------CREA CONSISTENZA FONIA-------------------------------------------------//&#xD;
if(assetFonia != null &amp;&amp; assetFonia.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP &amp;&amp; String(assetFonia.offerta).slice(0, 3) != &quot;SHA&quot;)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Fonia | Creazione componente ConsistenzaFonia, offerta DIVERSA da SHA: &quot;+assetFonia.IDAsset);&#xD;
&#xD;
	ConsistenzaFonia = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFoniaType();		&#xD;
	//CODIFICAOLOAGCOMDONATING&#xD;
	ConsistenzaFonia.codificaOLOAGCOMDonating = assetFonia.codificaOLOAGCOM;			&#xD;
	//AZIONE&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOULL&#xD;
		|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTOSLU&#xD;
		|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIONUMERO3&#xD;
		|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIONUMERO4&#xD;
		|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR13&#xD;
		|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR14&#xD;
		|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR15&#xD;
		|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.TRASLOCOWLR16)&#xD;
	{&#xD;
		ConsistenzaFonia.azione = &quot;D&quot;;&#xD;
	}&#xD;
	else if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTONP)&#xD;
	{&#xD;
		ConsistenzaFonia.azione = &quot;D&quot;; //RU_914 cambiata azione da T a D.&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		ConsistenzaFonia.azione = &quot;N&quot;;&#xD;
	}&#xD;
	//INVIO A DTU&#xD;
	ConsistenzaFonia.invioaDTU = &quot;N&quot;;	&#xD;
	//IDRISORSA&#xD;
	ConsistenzaFonia.IDRisorsa = assetFonia.IDRisorsa;		&#xD;
	//OFFERTA&#xD;
	ConsistenzaFonia.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetFonia.offerta));		&#xD;
	//IDENTIFICATIVOASSET&#xD;
	ConsistenzaFonia.IDAsset = assetFonia.IDAsset;		&#xD;
	//STATO&#xD;
	ConsistenzaFonia.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(assetFonia.statoAsset));		&#xD;
	//NUMEROTELEFONICOPRINCIPALE&#xD;
	ConsistenzaFonia.numeroTelefonicoPrincipale = assetFonia.numTelPrincipale;&#xD;
	&#xD;
	//OPERATORERETE - RU_1142&#xD;
	ConsistenzaFonia.operatoreRete = assetFonia.operatoreRete;&#xD;
	&#xD;
	ConsistenzaFonia.assetBTWhiteList = assetFonia.assetBTWhiteList; //R1E-21-0325&#xD;
	&#xD;
	//R1E-21-0325&#xD;
	if(ConsistenzaFonia.assetBTWhiteList != null &amp;&amp; ConsistenzaFonia.assetBTWhiteList != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
	}&#xD;
&#xD;
	//DESTINAZIONEUSO&#xD;
	//TIPOLINEA&#xD;
	//IDRISORSACORRELATO&#xD;
	var DESTINAZIONEUSO = false;&#xD;
	var TIPOLINEA = false;&#xD;
	var STRUTTURALINEA = false;&#xD;
	var IDRISORSACORRELATO = false;&#xD;
	var BANDASERVIZIO = false;&#xD;
	var foundFATTURAZIONELA = false;&#xD;
	var TIPOLOGIACLUSTERCOMUNE = false; //RU_964&#xD;
	&#xD;
	var i = 0;&#xD;
	var accessoTrovato = false;&#xD;
	while(!accessoTrovato &amp;&amp; i &lt; assetFonia.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetFonia.dettaglioasset.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			accessoTrovato = true;&#xD;
			var j = 0;&#xD;
			while((!DESTINAZIONEUSO || !TIPOLINEA || !IDRISORSACORRELATO || !foundFATTURAZIONELA || !STRUTTURALINEA || !BANDASERVIZIO || !TIPOLOGIACLUSTERCOMUNE) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
				{&#xD;
					DESTINAZIONEUSO = true;&#xD;
					ConsistenzaFonia.destinazioneUso = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					TIPOLINEA = true;&#xD;
					ConsistenzaFonia.tipoLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
				{&#xD;
					STRUTTURALINEA = true;&#xD;
					ConsistenzaFonia.strutturaLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSACORRELATO)&#xD;
				{&#xD;
					IDRISORSACORRELATO =true;&#xD;
					ConsistenzaFonia.IDRisorsaCorrelato = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FATTURAZIONELA)&#xD;
				{&#xD;
					foundFATTURAZIONELA =true;&#xD;
					ConsistenzaFonia.fatturazioneLA = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDASERVIZIO)&#xD;
				{&#xD;
					BANDASERVIZIO =true;&#xD;
					ConsistenzaFonia.bandaServizio = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE) //RU_964&#xD;
				{&#xD;
					TIPOLOGIACLUSTERCOMUNE = true;&#xD;
					ConsistenzaFonia.tipologiaClusterComune = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				j++;&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}&#xD;
&#xD;
	if(!foundFATTURAZIONELA)&#xD;
	{&#xD;
		var offertaConsistenzaFoniaSliced = String(ConsistenzaFonia.offerta).slice(0, 3);&#xD;
&#xD;
		if(offertaConsistenzaFoniaSliced == &quot;ULL&quot; || offertaConsistenzaFoniaSliced == &quot;SLU&quot;)&#xD;
		{&#xD;
			ConsistenzaFonia.fatturazioneLA = &quot;N&quot;;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else if(assetFonia != null &amp;&amp; String(assetFonia.offerta).slice(0, 3) == &quot;SHA&quot;)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Fonia | Creazione componente ConsistenzaDati con l'assetFonia, offerta SHA: &quot;+assetFonia.IDAsset);&#xD;
	&#xD;
	Log.write(&quot;Trovata consistenza dati SHA: &quot; + assetFonia.IDAsset);&#xD;
	ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();		&#xD;
	//CODIFICAOLOAGCOMDONATING&#xD;
	ConsistenzaDati.codificaOLOAGCOMDonating = assetFonia.codificaOLOAGCOM;			&#xD;
	//AZIONE&#xD;
	ConsistenzaDati.azione = &quot;N&quot;;&#xD;
	//IDRISORSA&#xD;
	ConsistenzaDati.IDRisorsa = assetFonia.IDRisorsa;&#xD;
	//IDRISORSANOW&#xD;
	ConsistenzaDati.IDRisorsaNOW = assetFonia.IDRisorsaNOW;&#xD;
	//OFFERTA&#xD;
	ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetFonia.offerta));		&#xD;
	//CODICE ORDINE TI&#xD;
	ConsistenzaDati.codiceOrdineTI = assetFonia.codiceOrdineTI;&#xD;
	//CODICE ORDINE OLO&#xD;
	ConsistenzaDati.codiceOrdineOLO = assetFonia.codiceOrdineOLO;&#xD;
	//IDENTIFICATIVOASSET&#xD;
	ConsistenzaDati.IDAsset = assetFonia.IDAsset;		&#xD;
	//STATO&#xD;
	ConsistenzaDati.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(assetFonia.statoAsset));		&#xD;
&#xD;
	ConsistenzaDati.assetBTWhiteList = assetFonia.assetBTWhiteList; //R1E-21-0325&#xD;
	&#xD;
	//R1E-21-0325&#xD;
	if(ConsistenzaDati.assetBTWhiteList != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
	}&#xD;
&#xD;
&#xD;
	//TIPOLINEA&#xD;
	var TIPOLINEA = false;&#xD;
	var TIPOLOGIACLUSTERCOMUNE = false; //RU_964&#xD;
	&#xD;
	var i = 0;&#xD;
	var accessoTrovato = false;&#xD;
	while(!accessoTrovato &amp;&amp; i &lt; assetFonia.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetFonia.dettaglioasset.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			accessoTrovato = true;&#xD;
			var j = 0;&#xD;
			while((!TIPOLINEA || !TIPOLOGIACLUSTERCOMUNE)&amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					TIPOLINEA = true;&#xD;
					ConsistenzaDati.tipoLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE)&#xD;
				{&#xD;
					TIPOLOGIACLUSTERCOMUNE = true;&#xD;
					ConsistenzaDati.tipologiaClusterComune = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
//--------------------------------------------------CREA NP-------------------------------------------------//&#xD;
if(assetNP != null &amp;&amp; assetNP.tipologiaAccesso == it_telecomitalia_it_NOW_casedata_TipologiaAccessoEnumeration.FONIA &amp;&amp; assetNP.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP&#xD;
&amp;&amp; (ConsistenzaFonia==null || ConsistenzaFonia.codificaOLOAGCOMDonating!=&quot;TLC&quot;))&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Fonia | Creazione componente NP: &quot;+assetNP.IDAsset);&#xD;
	&#xD;
	var np = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createNumberPortabilityType();&#xD;
	//INVIOADTU&#xD;
	np.invioaDTU = &quot;Y&quot;;		&#xD;
	//AZIONE&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTONP){&#xD;
		np.azione = &quot;D&quot;;&#xD;
	}&#xD;
	else{&#xD;
		np.azione = &quot;N&quot;;&#xD;
	}&#xD;
&#xD;
	//CODICEOPERATOREDONOR&#xD;
&#xD;
	var w = 0;&#xD;
	var CODICEOPERATOREDONOR = false;&#xD;
	while( !CODICEOPERATOREDONOR  &amp;&amp; w &lt; assetNP.dettaglioasset.size())&#xD;
	{&#xD;
		var dettaglioNP = assetNP.dettaglioasset.get(w);&#xD;
&#xD;
		for (var k=0; k &lt; dettaglioNP.attributidettaglioasset.size(); k++)&#xD;
		{&#xD;
			var attributoNP = dettaglioNP.attributidettaglioasset.get(k);&#xD;
&#xD;
			if( attributoNP.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR)&#xD;
			{&#xD;
				np.codiceOperatoreDonor = attributoNP.valoreAttributo;&#xD;
				CODICEOPERATOREDONOR = true;&#xD;
			}&#xD;
&#xD;
			}&#xD;
	w++;&#xD;
	}	&#xD;
&#xD;
	//CODICE ORDINE TI&#xD;
	np.codiceOrdineTI = assetNP.codiceOrdineTI;		&#xD;
	//NUMERO TELEFONICO&#xD;
	np.numeroTelefonico = assetNP.numeroTelefonico;&#xD;
	//NUMERO TELEFONICO PRINCIPALE&#xD;
	np.numeroTelefonicoPrincipale = assetNP.numTelPrincipale;		&#xD;
	//CODICEOPERATOREDONATING&#xD;
	np.codiceOperatoreDonating = assetNP.codificaOLOAGCOM;		&#xD;
	//CODICEOPERATORERECIPIENT&#xD;
	np.codiceOperatoreRecipient = localRequest.codificaOLOAGCOM;&#xD;
&#xD;
	np.assetBTWhiteList = assetNP.assetBTWhiteList; //R1E-21-0325&#xD;
	&#xD;
	//R1E-21-0325&#xD;
	if(np.assetBTWhiteList != null &amp;&amp; np.assetBTWhiteList != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
	}&#xD;
&#xD;
	&#xD;
	//OLORETAILER&#xD;
	//TIPOLINEA&#xD;
	//ROUTINGNUMBER&#xD;
	//AGGIUNTIVOWLR&#xD;
	var OLORETAILER = false;&#xD;
	var TIPOLINEA = false;&#xD;
	var ROUTINGNUMBER = false;&#xD;
	var AGGIUNTIVOWLR = false;&#xD;
	var codificaOLOAGCOMDonor = false;&#xD;
	var i = 0;&#xD;
	var accessoTrovato = false;&#xD;
	while(!accessoTrovato &amp;&amp; i &lt; assetNP.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetNP.dettaglioasset.get(i);&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			accessoTrovato = true;&#xD;
			var j = 0;&#xD;
			while((!OLORETAILER || !ROUTINGNUMBER || !TIPOLINEA || !AGGIUNTIVOWLR || !codificaOLOAGCOMDonor) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER)&#xD;
				{&#xD;
					OLORETAILER = true;&#xD;
					np.OLORetailer = attributo.valoreAttributo;		&#xD;
				}&#xD;
&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					TIPOLINEA = true;&#xD;
					np.tipoLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER)&#xD;
				{&#xD;
					ROUTINGNUMBER = true;&#xD;
					np.routingNumber = attributo.valoreAttributo;		&#xD;
				}&#xD;
&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AGGIUNTIVOWLR)&#xD;
				{&#xD;
					AGGIUNTIVOWLR = true;&#xD;
					np.aggiuntivoWLR = attributo.valoreAttributo;		&#xD;
				}&#xD;
&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR)&#xD;
				{&#xD;
					codificaOLOAGCOMDonor = true;&#xD;
					np.codiceOperatoreDonor = attributo.valoreAttributo;		&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}&#xD;
&#xD;
	NumberPortability.add(ScriptUtil.copy(np));&#xD;
}&#xD;
&#xD;
&#xD;
// RU_890 - In caso di offerta ULL LA NP/SLU LA NP e DECREMENTONP, in caso il richiedente sia l’OLO WHOLESALER cioè la CODIFICA OLO AGCOM sull’Asset di riferimento -> KO&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP)&#xD;
	&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTONP&#xD;
	&amp;&amp; (NumberPortability != null &amp;&amp; NumberPortability.size() > 0 &amp;&amp; NumberPortability.get(0).OLORetailer != null // SM_8944 - aggiunto controllo su esistenza OLORETAILER&#xD;
		&amp;&amp; ((ConsistenzaFonia != null &amp;&amp; localRequest.codificaOLOAGCOM == ConsistenzaFonia.codificaOLOAGCOMDonating) || NumberPortability.get(0).OLORetailer == localRequest.codificaOLOAGCOM)))&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: offerta: &quot;+localRequest.offerta+&quot; con OLOWHOLESALER o OLORETAILER = OLO richiedente&quot;;&#xD;
	CodiceEsito = &quot;KO_22&quot;;&#xD;
}&#xD;
&#xD;
LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
LavorazioneRichiesta.IDRisorsaOld = localRequest.IDRisorsa;&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Fonia | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="100.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="169.0">
              <xpdl2:Coordinates XCoordinate="894.0" YCoordinate="2363.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="__cvWAPHzEeaZ6cKbRk0TDA" Name="VariazioneDati" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Variazione Dati">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
CodiceEsito = null;&#xD;
&#xD;
var assetDati = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetDati = null;&#xD;
var asset1 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset1 = null;&#xD;
var asset2 = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
asset2 = null;&#xD;
&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Dati | Verifica servizio in consistenza Variazione Dati&quot;);&#xD;
&#xD;
if(localRequest.IDRisorsa != null &amp;&amp; localRequest.IDRisorsa != &quot;&quot;)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND codificaOLOAGCOM =: codificaOLOAGCOMRichiesta AND tipologiaAccesso = 'DATI'&quot;);&#xD;
	c.setQueryParameter(&quot;idr&quot;, localRequest.IDRisorsa);&#xD;
	c.setQueryParameter(&quot;codificaOLOAGCOMRichiesta&quot;, localRequest.codificaOLOAGCOM);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size() > 1)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		AssetRef = result.get(1);&#xD;
		asset2 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Dati | Trovati asset con IDRisorsa =&quot;+localRequest.IDRisorsa+&quot;, e OLO=&quot;+localRequest.codificaOLOAGCOM);&#xD;
	}&#xD;
	else if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		assetDati = ScriptUtil.copy(AssetRef.readAsset());&#xD;
		&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Dati | Trovato asset con IDRisorsa =&quot;+localRequest.IDRisorsa+&quot;, e OLO=&quot;+localRequest.codificaOLOAGCOM);&#xD;
	}&#xD;
	&#xD;
	if(assetDati == null &amp;&amp; asset1 == null &amp;&amp; localRequest.numeroTelefonico != null &amp;&amp; localRequest.numeroTelefonico != &quot;&quot;)&#xD;
	{&#xD;
		c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND codificaOLOAGCOM =: codificaOLOAGCOMRichiesta AND tipologiaAccesso = 'DATI'&quot;);&#xD;
		c.setQueryParameter(&quot;idr&quot;, localRequest.numeroTelefonico);&#xD;
		c.setQueryParameter(&quot;codificaOLOAGCOMRichiesta&quot;, localRequest.codificaOLOAGCOM);&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
		if(result != null &amp;&amp; result.size() > 1)&#xD;
		{&#xD;
			AssetRef = result.get(0);&#xD;
			asset1 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
			AssetRef = result.get(1);&#xD;
			asset2 = ScriptUtil.copy(AssetRef.readAsset());&#xD;
			&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Dati | Trovati asset con IDRisorsa=numeroTelefonico(&quot;+localRequest.numeroTelefonico+&quot;), e OLO=&quot;+localRequest.codificaOLOAGCOM);&#xD;
		}&#xD;
		else if(result != null &amp;&amp; result.size() > 0)&#xD;
		{&#xD;
			AssetRef = result.get(0);&#xD;
			assetDati = ScriptUtil.copy(AssetRef.readAsset());&#xD;
			&#xD;
			Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Dati | Trovato asset con IDRisorsa=numeroTelefonico(&quot;+localRequest.numeroTelefonico+&quot;), e OLO=&quot;+localRequest.codificaOLOAGCOM);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(asset2 != null)&#xD;
	{&#xD;
		if(!(asset1.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
			&amp;&amp; asset2.codificaOLOAGCOM == &quot;TLC&quot;&#xD;
			&amp;&amp; ((String(asset1.offerta).slice(0, 3) == &quot;ULL&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;ULL&quot;)&#xD;
				|| (String(asset1.offerta).slice(0, 3) == &quot;SLU&quot; &amp;&amp; String(asset2.offerta).slice(0, 3) == &quot;SLU&quot;))))&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: caso particolare ULL + ULL o SLU + SLU di TI non superato.&quot;;&#xD;
			CodiceEsito = &quot;KO_01&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			var DestinazioneUso1 = &quot;&quot;;&#xD;
			DestinazioneUso1 = null;&#xD;
			var destinazioneUso2 = &quot;&quot;;&#xD;
			destinazioneUso2 = null;&#xD;
		&#xD;
			var i = 0;&#xD;
			while(DestinazioneUso1 == null &amp;&amp; i &lt; asset1.dettaglioasset.size())&#xD;
			{&#xD;
				var DettAsset1 = asset1.dettaglioasset.get(i);&#xD;
				if(String(DettAsset1.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var j = 0;&#xD;
					while(DestinazioneUso1 == null &amp;&amp; j &lt; DettAsset1.attributidettaglioasset.size())&#xD;
					{&#xD;
						var AttrDettAsset1 = DettAsset1.attributidettaglioasset.get(j);&#xD;
						if(AttrDettAsset1.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
						{&#xD;
							DestinazioneUso1 = AttrDettAsset1.valoreAttributo;&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		&#xD;
			var i = 0;&#xD;
			while(destinazioneUso2 == null &amp;&amp; i &lt; asset2.dettaglioasset.size())&#xD;
			{&#xD;
				var DettAsset2 = asset2.dettaglioasset.get(i);&#xD;
				if(String(DettAsset2.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var j = 0;&#xD;
					while(destinazioneUso2 == null &amp;&amp; j &lt; DettAsset2.attributidettaglioasset.size())&#xD;
					{&#xD;
						var AttrDettAsset2 = DettAsset2.attributidettaglioasset.get(j);&#xD;
						if(AttrDettAsset2.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
						{&#xD;
							destinazioneUso2 = AttrDettAsset2.valoreAttributo;&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		&#xD;
			if(destinazioneUsoDati.contains(DestinazioneUso1))&#xD;
			{&#xD;
				assetDati = asset1;&#xD;
			}&#xD;
			else if(destinazioneUsoDati.contains(destinazioneUso2))&#xD;
			{&#xD;
				assetDati = asset2;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(assetDati == null)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: consistenza FONIA non trovata per IDRisorsa: &quot; + localRequest.IDRisorsa + &quot; oppure NumeroTelefonico: &quot; + localRequest.numeroTelefonico;&#xD;
		CodiceEsito = &quot;KO_12&quot;;&#xD;
	}&#xD;
	//RU_1184&#xD;
	else if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DISABILITAZIONESERVIZIO&#xD;
	        &amp;&amp; assetDati.statoDisAsset == &quot;DISABILITATO&quot;)   //modificato con SM_10282&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito. STATODISASSET: &quot; + assetDati.statoDisAsset;&#xD;
		CodiceEsito = &quot;KO_35&quot;;&#xD;
	}&#xD;
	//RU_1184&#xD;
	else if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIABILITAZIONESERVIZIO&#xD;
	        &amp;&amp; assetDati.statoDisAsset != &quot;DISABILITATO&quot;)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito. STATODISASSET: &quot; + assetDati.statoDisAsset;&#xD;
		CodiceEsito = &quot;KO_36&quot;;&#xD;
	}&#xD;
	&#xD;
	//SM_10173 -------------------------&#xD;
	if(assetDati != null&#xD;
	   &amp;&amp; (((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		  ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
		  ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH)&#xD;
		 &amp;&amp; (assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
			 ||assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
			 ||assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
			 ||assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS			//RU_1555: Aggiunte offerte fullgponplus/nga&#xD;
			 ||assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA))&#xD;
	   ||&#xD;
	   ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
		  ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
		  ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
		  ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS			//RU_1555: Aggiunte offerte fullgponplus/nga&#xD;
		  ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)&#xD;
		 &amp;&amp; (assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
			 ||assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
			 ||assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH))))&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: assetDati offerte non gestite. LocalRequest: &quot;+localRequest.offerta+&quot;, Asset: &quot;+assetDati.offerta;&#xD;
		CodiceEsito = &quot;KO_37&quot;;&#xD;
	}&#xD;
	//-----------------------------------&#xD;
	&#xD;
	/* //Eliminato Check Operatore Rete con SM_8074&#xD;
	else if(assetDati.operatoreRete != null &amp;&amp; assetDati.operatoreRete != &quot;&quot;)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: consistenza FONIA con operatoreRete valorizzato per IDRisorsa: &quot; + localRequest.IDRisorsa + &quot; oppure NumeroTelefonico: &quot; + localRequest.numeroTelefonico;&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH){&#xD;
			CodiceEsito = &quot;KO_05&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_06&quot;;&#xD;
		}&#xD;
	}*/	&#xD;
}&#xD;
&#xD;
//--------------------------------------------------CREA CONSISTENZA DATI-------------------------------------------------//&#xD;
if(EsitoResponse.codice &amp;&amp; assetDati != null)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Dati | Creazione componente ConsistenzaDati: &quot;+assetDati.IDAsset);&#xD;
	&#xD;
	ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();&#xD;
	//AZIONE&#xD;
	ConsistenzaDati.azione = &quot;N&quot;;		&#xD;
	//CODIFICAOLOAGCOMDONATING&#xD;
	ConsistenzaDati.codificaOLOAGCOMDonating = assetDati.codificaOLOAGCOM;		&#xD;
	//IDRISORSA&#xD;
	ConsistenzaDati.IDRisorsa = assetDati.IDRisorsa;		&#xD;
	//IDRISORSANOW&#xD;
	ConsistenzaDati.IDRisorsaNOW = assetDati.IDRisorsaNOW;		&#xD;
	//OFFERTA&#xD;
	ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetDati.offerta));&#xD;
	//CODICEORDINETI&#xD;
	ConsistenzaDati.codiceOrdineTI = assetDati.codiceOrdineTI;		&#xD;
	//CODICEORDINEOLO&#xD;
	ConsistenzaDati.codiceOrdineOLO = assetDati.codiceOrdineOLO;		&#xD;
	//IDENTIFICATIVOASSET&#xD;
	ConsistenzaDati.IDAsset = assetDati.IDAsset;		&#xD;
	//STATO&#xD;
	ConsistenzaDati.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(assetDati.statoAsset));		&#xD;
	&#xD;
	//OPERATORERETE - RU_1142&#xD;
	ConsistenzaDati.operatoreRete = assetDati.operatoreRete;&#xD;
	&#xD;
	ConsistenzaDati.assetBTWhiteList = assetDati.assetBTWhiteList; //R1E-21-0325&#xD;
	&#xD;
	//R1E-21-0325&#xD;
	if(ConsistenzaDati.assetBTWhiteList != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
	}&#xD;
	&#xD;
	//RU_1184&#xD;
	ConsistenzaDati.statoDisabilitazioneAsset = assetDati.statoDisAsset;&#xD;
	&#xD;
	//RU_1275&#xD;
	if(assetDati.exOperatoreRete != null &amp;&amp; assetDati.exOperatoreRete != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.exOperatoreRete = assetDati.exOperatoreRete;&#xD;
		localRequest.ordine.exOperatoreRete = assetDati.exOperatoreRete;&#xD;
	}&#xD;
	//SM_11795&#xD;
	if(assetDati.ontOperatore != null &amp;&amp; assetDati.ontOperatore != &quot;&quot;)&#xD;
	{&#xD;
		ConsistenzaDati.ontOperatore = assetDati.ontOperatore;&#xD;
	}&#xD;
	//SM_11801&#xD;
	if(assetDati.modelServPerValidazioni != null &amp;&amp; assetDati.modelServPerValidazioni != &quot;&quot;)&#xD;
	{&#xD;
		ConsistenzaDati.modelloServizioPerValidazioni = assetDati.modelServPerValidazioni;&#xD;
	}&#xD;
		&#xD;
	//CARATTERISTICA&#xD;
	var offerta = String(localRequest.offerta.BITSTREAMATMASIMMETRICOFLAT);&#xD;
	var offertaSlice4 = offerta.slice((offerta.length-4),offerta.length );&#xD;
	var offertaSlice2 = offerta.slice((offerta.length-2),offerta.length );&#xD;
	if(offertaSlice4 == &quot;FLAT&quot;)&#xD;
	{&#xD;
		ConsistenzaDati.caratteristica = &quot;0&quot;;&#xD;
	}&#xD;
	else if(offertaSlice4 == &quot;LITE&quot;)&#xD;
	{&#xD;
		ConsistenzaDati.caratteristica = &quot;1&quot;;&#xD;
	} else if(offertaSlice2 == &quot;HL&quot;)&#xD;
	{&#xD;
		ConsistenzaDati.caratteristica = &quot;2&quot;;&#xD;
	}&#xD;
	//OPZIONEDINAMICA&#xD;
	ConsistenzaDati.opzioneDinamica=assetDati.opzioneDinamica;&#xD;
	&#xD;
	//TIPOLINEA&#xD;
	//TECNOLOGIA&#xD;
	//PROFILOTECNICOLINEA&#xD;
	//TIPOPROTOCOLLO&#xD;
	var TECNOLOGIA = false;&#xD;
	var PROFILOTECNICOLINEA = false;&#xD;
	var TIPOPROTOCOLLO = false;&#xD;
	var MODULAZIONE = false;&#xD;
	var TIPOLINEA = false;&#xD;
	var TIPOLOGIACLUSTERCOMUNE = false; //RU_964&#xD;
	var INTERMEDIATEAGENTFULL = false;  //RU_966&#xD;
	var ENCAPSULATION = false; 			//SM_9525&#xD;
	var SEMIFIBRAFTTH = false; &#xD;
	var IDRETESECONDARIAOAO = false; &#xD;
	var CARATTERIZZAZIONEGEO = false; //RU_1353&#xD;
	var MODALITACONSEGNA = false; //RU_1614&#xD;
	var MERCATO = false; //FEA_32918&#xD;
	&#xD;
	var i = 0;&#xD;
	var accessoTrovato = false;&#xD;
	var protocolloTrovato = false;&#xD;
	while(!accessoTrovato &amp;&amp; !protocolloTrovato &amp;&amp; i &lt; assetDati.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetDati.dettaglioasset.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			accessoTrovato = true;&#xD;
			var j = 0;&#xD;
			while((!TECNOLOGIA || !PROFILOTECNICOLINEA || !MODULAZIONE || !TIPOLINEA || !TIPOLOGIACLUSTERCOMUNE || !INTERMEDIATEAGENTFULL || !ENCAPSULATION || !SEMIFIBRAFTTH || !IDRETESECONDARIAOAO || !CARATTERIZZAZIONEGEO || !MODALITACONSEGNA || !MERCATO) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIA)&#xD;
				{&#xD;
					TECNOLOGIA = true;&#xD;
					ConsistenzaDati.tecnologia = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
				{&#xD;
					PROFILOTECNICOLINEA = true;&#xD;
					ConsistenzaDati.profiloTecnicoLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MODULAZIONE)&#xD;
				{&#xD;
					MODULAZIONE = true;&#xD;
					ConsistenzaDati.modulazione = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					TIPOLINEA = true;&#xD;
					ConsistenzaDati.tipoLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE) // RU_964&#xD;
				{&#xD;
					TIPOLOGIACLUSTERCOMUNE = true;&#xD;
					ConsistenzaDati.tipologiaClusterComune = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INTERMEDIATEAGENTFULL)  //RU_966&#xD;
				{&#xD;
					INTERMEDIATEAGENTFULL = true;&#xD;
					ConsistenzaDati.intermediateAgentFull = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)  //SM_9525&#xD;
				{&#xD;
					ENCAPSULATION = true;&#xD;
					ConsistenzaDati.encapsulation = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SEMIFIBRAFTTH)&#xD;
				{&#xD;
					SEMIFIBRAFTTH = true;&#xD;
					ConsistenzaDati.semiFibraFTTH = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRETESECONDARIAOAO)&#xD;
				{&#xD;
					IDRETESECONDARIAOAO = true;&#xD;
					ConsistenzaDati.IDReteSecondariaOAO = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO) //RU_1353&#xD;
				{&#xD;
					CARATTERIZZAZIONEGEO = true;&#xD;
					ConsistenzaDati.caratterizzazioneGEO = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MODALITACONSEGNA) //RU_1614&#xD;
				{&#xD;
					MODALITACONSEGNA = true;&#xD;
					ConsistenzaDati.modalitaConsegna = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MERCATO) //RU_1614&#xD;
				{&#xD;
					MERCATO = true;&#xD;
					ConsistenzaDati.mercato = attributo.valoreAttributo;		&#xD;
				}				&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PROTOCOLLO)&#xD;
		{&#xD;
			protocolloTrovato = true;&#xD;
			var z = 0;&#xD;
			while(!TIPOPROTOCOLLO &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(z);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROTOCOLLO)&#xD;
				{&#xD;
					TIPOPROTOCOLLO = true;&#xD;
					ConsistenzaDati.tipoProtocollo = attributo.valoreAttributo;		&#xD;
				}&#xD;
				z++;&#xD;
			}&#xD;
		}		&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	&#xD;
//--------------------------------------------------CREA CONSISTENZA FONIA-------------------------------------------------//&#xD;
	if(ConsistenzaDati!=null &amp;&amp; &#xD;
		((ConsistenzaDati.tipoLinea == &quot;POTS&quot; || ConsistenzaDati.tipoLinea == &quot;ISDN&quot;) &amp;&amp;&#xD;
		(assetDati.IDRisorsaCorrelato!= null &amp;&amp; assetDati.IDRisorsaCorrelato!= &quot;&quot;)))&#xD;
	{&#xD;
		var assetFonia = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
		assetFonia = null;&#xD;
		&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta IN ('VULLLINEANONATTIVA','VULL','WLRLINEANONATTIVA','WLR','WLRLINEAATTIVA') AND tipologiaAccesso = 'FONIA'&quot;);&#xD;
		c.setQueryParameter(&quot;idr&quot;, assetDati.IDRisorsaCorrelato);&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);	&#xD;
		&#xD;
		if(result != null &amp;&amp; result.size() > 0)&#xD;
		{&#xD;
			AssetRef2 = result.get(0);&#xD;
			assetFonia = ScriptUtil.copy(AssetRef2.readAsset());&#xD;
			&#xD;
			if (assetFonia!=null)&#xD;
			{&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Dati | Creazione componente ConsistenzaFonia: &quot;+assetFonia.IDAsset);&#xD;
				&#xD;
					ConsistenzaFonia = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFoniaType();&#xD;
					// AZIONE&#xD;
					ConsistenzaFonia.azione = &quot;N&quot;;		&#xD;
					//IDRISORSA&#xD;
					ConsistenzaFonia.IDRisorsa = assetFonia.IDRisorsa;		&#xD;
					//IDRISORSANOW&#xD;
					ConsistenzaFonia.IDRisorsaNOW = assetFonia.IDRisorsaNOW;		&#xD;
					//OFFERTA&#xD;
					ConsistenzaFonia.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetFonia.offerta));&#xD;
					//CODIFICAOLOAGCOMDONATING&#xD;
					ConsistenzaFonia.codificaOLOAGCOMDonating = assetFonia.codificaOLOAGCOM;		&#xD;
					//CODICEORDINETI&#xD;
					ConsistenzaFonia.codiceOrdineTI = assetFonia.codiceOrdineTI;		&#xD;
					//CODICEORDINEOLO&#xD;
					ConsistenzaFonia.codiceOrdineOLO = assetFonia.codiceOrdineOLO;		&#xD;
					//IDENTIFICATIVOASSET&#xD;
					ConsistenzaFonia.IDAsset = assetFonia.IDAsset;		&#xD;
					&#xD;
					ConsistenzaFonia.assetBTWhiteList = assetFonia.assetBTWhiteList; //R1E-21-0325&#xD;
					&#xD;
					//R1E-21-0325&#xD;
					if(ConsistenzaFonia.assetBTWhiteList != null &amp;&amp; ConsistenzaFonia.assetBTWhiteList != &quot;&quot;)&#xD;
					{&#xD;
						localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
					}&#xD;
					&#xD;
					//TIPOLINEA&#xD;
					//STRUTTURALINEA&#xD;
					//DESTINAZIONEUSO&#xD;
					var accessoTrovato = false;&#xD;
					var i = 0;&#xD;
					var foundSTRUTTURALINEA = false;&#xD;
					var foundTIPOLINEA = false;&#xD;
					var foundDESTINAZIONEUSO = false;&#xD;
					var TIPOLOGIACLUSTERCOMUNE = false; // RU_964&#xD;
					&#xD;
					while(!accessoTrovato &amp;&amp; i &lt; assetFonia.dettaglioasset.size())&#xD;
					{&#xD;
						var componente = assetFonia.dettaglioasset.get(i);&#xD;
						if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
						{&#xD;
							accessoTrovato = true;&#xD;
							var j = 0;&#xD;
							while(( !foundDESTINAZIONEUSO || !foundSTRUTTURALINEA || !foundTIPOLINEA || !TIPOLOGIACLUSTERCOMUNE) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
							{&#xD;
								var attributo = componente.attributidettaglioasset.get(j);&#xD;
								&#xD;
								if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
								{&#xD;
									foundTIPOLINEA = true;&#xD;
									ConsistenzaFonia.tipoLinea = attributo.valoreAttributo;	&#xD;
								}&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
								{&#xD;
									foundSTRUTTURALINEA = true;&#xD;
									ConsistenzaFonia.strutturaLinea = attributo.valoreAttributo;	&#xD;
								}&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
								{&#xD;
									foundDESTINAZIONEUSO = true;&#xD;
									ConsistenzaFonia.destinazioneUso = attributo.valoreAttributo;	&#xD;
								}&#xD;
								else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE)&#xD;
								{&#xD;
									TIPOLOGIACLUSTERCOMUNE = true;&#xD;
									ConsistenzaFonia.tipologiaClusterComune = attributo.valoreAttributo;	&#xD;
								}&#xD;
								&#xD;
								j++;	&#xD;
							}&#xD;
						}&#xD;
						&#xD;
					i++;&#xD;
					}&#xD;
					&#xD;
					//STATO&#xD;
					ConsistenzaFonia.stato = it_telecomitalia_it_NOW_casedata_v1_StatoAssetEnumeration.get(String(assetFonia.statoAsset));&#xD;
					//NUMEROTELEFONICO&#xD;
					ConsistenzaFonia.numeroTelefonico = assetFonia.numeroTelefonico;&#xD;
					//NUMEROTELEFONICOPRINCIPALE&#xD;
					ConsistenzaFonia.numeroTelefonicoPrincipale = assetFonia.numTelPrincipale;&#xD;
					//NUMEROFITTIZIO&#xD;
					ConsistenzaFonia.numeroFittizio = assetFonia.numeroFittizio;&#xD;
					&#xD;
					//IDRISOIRSACORRELATO&#xD;
					ConsistenzaFonia.IDRisorsaCorrelato = assetFonia.IDRisorsaCorrelato;&#xD;
			&#xD;
					&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//LAVORAZIONE RICHIESTA&#xD;
LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
LavorazioneRichiesta.IDRisorsaOld = localRequest.IDRisorsa;&#xD;
if(ConsistenzaDati.mercato != null &amp;&amp; ConsistenzaDati.mercato != &quot;&quot;){&#xD;
		LavorazioneRichiesta.mercato = ConsistenzaDati.mercato;&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Variazione Dati | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="104.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="169.0">
              <xpdl2:Coordinates XCoordinate="894.0" YCoordinate="2487.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_F633EPH0EeaZ6cKbRk0TDA" Name="CessazioneBTSNGAGBEEASYIPSHA" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Cessazione BTS/NGA/GBE/EASYIP/SHA" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
CodiceEsito = null;&#xD;
&#xD;
var assetDati = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetDati = null;&#xD;
var assetFonia = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetFonia = null;&#xD;
var correlatoCessato = false;&#xD;
&#xD;
Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione BTS/NGA/GBE/EASYIP/SHA | Verifica servizio in consistenza Cessazione BTS/NGA/GBE/EASYIP/SHA.&quot;);&#xD;
&#xD;
if(localRequest.IDRisorsa != null &amp;&amp; localRequest.IDRisorsa != &quot;&quot;)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset =: ida AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND codificaOLOAGCOM =: codificaOLOAGCOMRichiesta AND tipologiaAccesso = 'DATI'&quot;);&#xD;
	c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(VerificaIDRisorsaResponse.datiAccesso.idAsset));&#xD;
	c.setQueryParameter(&quot;codificaOLOAGCOMRichiesta&quot;, localRequest.codificaOLOAGCOM);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		AssetRef = result.get(0);&#xD;
		assetDati = ScriptUtil.copy(AssetRef.readAsset());&#xD;
	}&#xD;
	&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione BTS/NGA/GBE/EASYIP/SHA | Trovato Asset per idAsset=&quot;+VerificaIDRisorsaResponse.datiAccesso.idAsset+&quot;, con OLOAGCOM=&quot;+localRequest.codificaOLOAGCOM);&#xD;
}&#xD;
&#xD;
if(result != null &amp;&amp; result.size() > 1)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: asset recuperato non univoco.&quot;;&#xD;
	CodiceEsito = &quot;KO_01&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	if(assetDati != null)&#xD;
	{&#xD;
		Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione BTS/NGA/GBE/EASYIP/SHA | Asset Dati recuperato: &quot; + assetDati.IDAsset);&#xD;
		&#xD;
		//SM_10173&#xD;
		if(((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
		      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH)&#xD;
		     &amp;&amp; (assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
		         ||assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
			     ||assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH))&#xD;
		   ||&#xD;
		   ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
		      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
		      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)&#xD;
		     &amp;&amp; (assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		         ||assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
			     ||assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH)))&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: assetDati offerte non gestite. LocalRequest: &quot;+localRequest.offerta+&quot;, Asset: &quot;+assetDati.offerta;&#xD;
			CodiceEsito = &quot;KO_37&quot;;&#xD;
		}&#xD;
		&#xD;
		//RU_1543 - logica di scarto su FULLGPONPLUS e FULLGPONPLUSNGA &#xD;
		if(((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH)&#xD;
		     &amp;&amp; (assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS &#xD;
		         ||assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA))&#xD;
		   ||&#xD;
		   ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
		      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)&#xD;
		     &amp;&amp; (assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		         ||assetDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH)))&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: assetDati offerte non gestite. LocalRequest: &quot;+localRequest.offerta+&quot;, Asset: &quot;+assetDati.offerta;&#xD;
			CodiceEsito = &quot;KO_37&quot;;&#xD;
		}		&#xD;
		&#xD;
		if(assetDati.IDRisorsaCorrelato != null &amp;&amp; assetDati.IDRisorsaCorrelato != &quot;&quot;)&#xD;
		{&#xD;
			c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =:idr AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND tipologiaAccesso = 'FONIA' AND IDAsset &lt;> :ida&quot;);&#xD;
			c.setQueryParameter(&quot;idr&quot;, assetDati.IDRisorsaCorrelato);&#xD;
			c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(assetDati.IDAsset));&#xD;
			var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
			if(result != null &amp;&amp; result.size() > 0)&#xD;
			{&#xD;
				AssetRef2 = result.get(0);&#xD;
				assetFonia = ScriptUtil.copy(AssetRef2.readAsset());&#xD;
				Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione BTS/NGA/GBE/EASYIP/SHA | Asset Fonia recuperato: &quot; + assetFonia.IDAsset);&#xD;
			}&#xD;
			if(assetFonia == null)&#xD;
			{&#xD;
				//SM_8984&#xD;
				c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =:idr AND statoAsset IN ('CESSATO') AND tipologiaAccesso = 'FONIA' AND IDAsset &lt;> :ida&quot;);&#xD;
				c.setQueryParameter(&quot;idr&quot;, assetDati.IDRisorsaCorrelato);&#xD;
				c.setQueryParameter(&quot;ida&quot;, ScriptUtil.createBigInteger(assetDati.IDAsset));&#xD;
				result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
				&#xD;
				if(result != null &amp;&amp; result.size() > 0)&#xD;
				{&#xD;
					AssetRef2 = result.get(0);&#xD;
					assetFonia = ScriptUtil.copy(AssetRef2.readAsset());&#xD;
					Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione BTS/NGA/GBE/EASYIP/SHA | Asset Fonia CESSATO recuperato: &quot; + assetFonia.IDAsset);&#xD;
					correlatoCessato = true;&#xD;
				}&#xD;
				/*&#xD;
				else&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: nessun asset recuperato per IDRisorsaCorrelato: &quot; + localRequest.IDRisorsaCorrelato;&#xD;
					&#xD;
					if (String(localRequest.offerta).slice(0, 3) == &quot;SHA&quot;)&#xD;
					{&#xD;
						CodiceEsito = &quot;KO_09&quot;;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						CodiceEsito = &quot;KO_12&quot;;&#xD;
					}&#xD;
				}&#xD;
				*/&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL ServizioConsistenza fallito: consistenza DATI non trovata per IDAsset: &quot; + VerificaIDRisorsaResponse.datiAccesso.idAsset;&#xD;
		&#xD;
		if (String(localRequest.offerta).slice(0, 3) == &quot;SHA&quot;)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_09&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_12&quot;;&#xD;
		}&#xD;
	}		&#xD;
}&#xD;
//--------------------------------------------------CREA CONSISTENZA FONIA-------------------------------------------------//&#xD;
if(assetFonia != null)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione BTS/NGA/GBE/EASYIP/SHA | Creazione componente ConsistenzaFonia: &quot;+assetFonia.IDAsset);&#xD;
	&#xD;
	ConsistenzaFonia = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaFoniaType();		&#xD;
	//AZIONE&#xD;
	if(correlatoCessato)&#xD;
	{&#xD;
		ConsistenzaFonia.azione = &quot;N&quot;; //SM_8984&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		ConsistenzaFonia.azione = &quot;M&quot;;		&#xD;
	}&#xD;
	//IDRISORSA&#xD;
	ConsistenzaFonia.IDRisorsa = assetFonia.IDRisorsa;		&#xD;
	//IDRISORSANOW&#xD;
	ConsistenzaFonia.IDRisorsaNOW = assetFonia.IDRisorsaNOW;		&#xD;
	//OFFERTA&#xD;
	ConsistenzaFonia.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetFonia.offerta));		&#xD;
	//CODIFICAOLOAGCOMDONATING&#xD;
	ConsistenzaFonia.codificaOLOAGCOMDonating = assetFonia.codificaOLOAGCOM;&#xD;
	//CODICEORDINETI&#xD;
	ConsistenzaFonia.codiceOrdineTI = assetFonia.codiceOrdineTI;		&#xD;
	//CODICEORDINEOLO&#xD;
	ConsistenzaFonia.codiceOrdineOLO = assetFonia.codiceOrdineOLO;		&#xD;
	//IDENTIFICATIVOASSET&#xD;
	ConsistenzaFonia.IDAsset = assetFonia.IDAsset;		&#xD;
	//NUMERO TELEFONICO&#xD;
	ConsistenzaFonia.numeroTelefonico = assetFonia.numeroTelefonico;		&#xD;
	//NUMERO TELEFONICO PRINCIPALE&#xD;
	ConsistenzaFonia.numeroTelefonicoPrincipale = assetFonia.numTelPrincipale;		&#xD;
	//NUMERO FITTIZIO&#xD;
	ConsistenzaFonia.numeroFittizio = assetFonia.numeroFittizio;	&#xD;
	//OPERATORERETE - RU_1142&#xD;
	ConsistenzaFonia.operatoreRete = assetFonia.operatoreRete;&#xD;
	&#xD;
	ConsistenzaFonia.assetBTWhiteList = assetFonia.assetBTWhiteList; //R1E-21-0325&#xD;
	&#xD;
	//R1E-21-0325&#xD;
	if(ConsistenzaFonia.assetBTWhiteList != null &amp;&amp; ConsistenzaFonia.assetBTWhiteList != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
	}&#xD;
	&#xD;
	//ID RISORSA CORRELATO&#xD;
	if(assetDati != null)&#xD;
	{&#xD;
		ConsistenzaFonia.IDRisorsaCorrelato = assetDati.IDRisorsa;&#xD;
	}&#xD;
	//COWCODE&#xD;
	//CODICESESSIONE&#xD;
	//DIREZIONALITA&#xD;
	//DESTINAZIONE USO&#xD;
	//STRUTTURALINEA&#xD;
	//TIPOLINEA&#xD;
	var DIREZIONALITA = false;&#xD;
	var DESTINAZIONEUSO = false;&#xD;
	var TIPOLINEA = false;&#xD;
	var STRUTTURALINEA = false;&#xD;
	var COWCODE = false;&#xD;
	var CODICESESSIONE = false;&#xD;
	var i = 0;&#xD;
	var accessoTrovato = false;&#xD;
	while(!accessoTrovato &amp;&amp; i &lt; assetFonia.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetFonia.dettaglioasset.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			accessoTrovato = true;&#xD;
			var j = 0;&#xD;
			while((!CODICESESSIONE|| !COWCODE || !DIREZIONALITA || !DESTINAZIONEUSO || !TIPOLINEA || !STRUTTURALINEA) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA)&#xD;
				{&#xD;
					DIREZIONALITA = true;&#xD;
					ConsistenzaFonia.direzionalita = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
				{&#xD;
					DESTINAZIONEUSO = true;&#xD;
					ConsistenzaFonia.destinazioneUso = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					TIPOLINEA = true;&#xD;
					ConsistenzaFonia.tipoLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
				{&#xD;
					STRUTTURALINEA = true;&#xD;
					ConsistenzaFonia.strutturaLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COWCODE)&#xD;
				{&#xD;
					COWCODE = true;&#xD;
					ConsistenzaFonia.cowCode = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESESSIONE)&#xD;
				{&#xD;
					CODICESESSIONE = true;&#xD;
					ConsistenzaFonia.codiceSessione = attributo.valoreAttributo;		&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(assetDati != null)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione BTS/NGA/GBE/EASYIP/SHA | Creazione componente ConsistenzaDati: &quot;+assetDati.IDAsset);&#xD;
	&#xD;
	ConsistenzaDati = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createConsistenzaDatiType();		&#xD;
	//AZIONE&#xD;
	ConsistenzaDati.azione = &quot;M&quot;;		&#xD;
	//IDRISORSA&#xD;
	ConsistenzaDati.IDRisorsa = assetDati.IDRisorsa;		&#xD;
	//IDRISORSANOW&#xD;
	ConsistenzaDati.IDRisorsaNOW = assetDati.IDRisorsaNOW;		&#xD;
	//OFFERTA&#xD;
	ConsistenzaDati.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(assetDati.offerta));		&#xD;
	//CODIFICAOLOAGCOMDONATING&#xD;
	ConsistenzaDati.codificaOLOAGCOMDonating = assetDati.codificaOLOAGCOM;&#xD;
	//CODICEORDINETI&#xD;
	ConsistenzaDati.codiceOrdineTI = assetDati.codiceOrdineTI;		&#xD;
	//CODICEORDINEOLO&#xD;
	ConsistenzaDati.codiceOrdineOLO = assetDati.codiceOrdineOLO;		&#xD;
	//IDENTIFICATIVOASSET&#xD;
	ConsistenzaDati.IDAsset = assetDati.IDAsset;		&#xD;
	//NUMERO TELEFONICO&#xD;
	ConsistenzaDati.numeroTelefonico = assetDati.numeroTelefonico;		&#xD;
	//NUMERO TELEFONICO PRINCIPALE&#xD;
	ConsistenzaDati.numeroTelefonicoPrincipale = assetDati.numTelPrincipale;		&#xD;
	//NUMERO FITTIZIO&#xD;
	ConsistenzaDati.numeroFittizio = assetDati.numeroFittizio;		&#xD;
	//ID RISORSA CORRELATO&#xD;
	if(assetFonia != null)&#xD;
	{&#xD;
		ConsistenzaDati.IDRisorsaCorrelato = assetFonia.IDRisorsa;&#xD;
	}&#xD;
	//OPZIONEDINAMICA&#xD;
	ConsistenzaDati.opzioneDinamica = assetDati.opzioneDinamica;&#xD;
	//OPERATORERETE - RU_1142&#xD;
	ConsistenzaDati.operatoreRete = assetDati.operatoreRete;&#xD;
	&#xD;
	ConsistenzaDati.assetBTWhiteList = assetDati.assetBTWhiteList; //R1E-21-0325&#xD;
	&#xD;
	//R1E-21-0325&#xD;
	if(ConsistenzaDati.assetBTWhiteList != null &amp;&amp; ConsistenzaDati.assetBTWhiteList != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.ordineAssetWhiteList = &quot;TIM EX BT&quot;;&#xD;
	}&#xD;
	&#xD;
	//RU_1184&#xD;
	ConsistenzaDati.statoDisabilitazioneAsset = assetDati.statoDisAsset;&#xD;
	&#xD;
	//RU_1275&#xD;
	if(assetDati.exOperatoreRete != null &amp;&amp; assetDati.exOperatoreRete != &quot;&quot;)&#xD;
	{&#xD;
		localRequest.exOperatoreRete = assetDati.exOperatoreRete;&#xD;
		localRequest.ordine.exOperatoreRete = assetDati.exOperatoreRete;&#xD;
	}&#xD;
	&#xD;
	//COWCODE&#xD;
	//CODICESESSIONE&#xD;
	//DIREZIONALITA&#xD;
	//DESTINAZIONE USO&#xD;
	//STRUTTURALINEA&#xD;
	//TIPOLINEA&#xD;
	var DIREZIONALITA = false;&#xD;
	var DESTINAZIONEUSO = false;&#xD;
	var TIPOLINEA = false;&#xD;
	var STRUTTURALINEA = false;&#xD;
	var COWCODE = false;&#xD;
	var CODICESESSIONE = false;&#xD;
	var SEMIFIBRAFTTH = false; //SM_10080&#xD;
	var ROEFFIB = false; //RU_1275&#xD;
	&#xD;
	var i = 0;&#xD;
	var accessoTrovato = false;&#xD;
	while(!accessoTrovato &amp;&amp; i &lt; assetDati.dettaglioasset.size())&#xD;
	{&#xD;
		var componente = assetDati.dettaglioasset.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			accessoTrovato = true;&#xD;
			var j = 0;&#xD;
			while((!CODICESESSIONE|| !COWCODE || !DIREZIONALITA || !DESTINAZIONEUSO || !TIPOLINEA || !STRUTTURALINEA || !SEMIFIBRAFTTH || !ROEFFIB) &amp;&amp; j &lt; componente.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributo = componente.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA)&#xD;
				{&#xD;
					DIREZIONALITA = true;&#xD;
					ConsistenzaDati.direzionalita = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
				{&#xD;
					DESTINAZIONEUSO = true;&#xD;
					ConsistenzaDati.destinazioneUso = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					TIPOLINEA = true;&#xD;
					ConsistenzaDati.tipoLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
				{&#xD;
					STRUTTURALINEA = true;&#xD;
					ConsistenzaDati.strutturaLinea = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COWCODE)&#xD;
				{&#xD;
					COWCODE = true;&#xD;
					ConsistenzaDati.cowCode = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESESSIONE)&#xD;
				{&#xD;
					CODICESESSIONE = true;&#xD;
					ConsistenzaDati.codiceSessione = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				//SM_10080&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SEMIFIBRAFTTH)&#xD;
				{&#xD;
					SEMIFIBRAFTTH = true;&#xD;
					ConsistenzaDati.semiFibraFTTH = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				//RU_1275&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROEFFIB)&#xD;
				{&#xD;
					ROEFFIB = true;&#xD;
					ConsistenzaDati.roeFFIB = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				j++;&#xD;
			}&#xD;
		}	&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(!EsitoResponse.codice)&#xD;
{&#xD;
	Log.write(&quot;CTRL SERVIZIO CONSISTENZA [&quot;+localRequest.IDRichiestaOLO+&quot;] | Task Cessazione BTS/NGA/GBE/EASYIP/SHA | &quot;+EsitoResponse.descrizione+&quot;. CODICE KO: &quot;+CodiceEsito);&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
