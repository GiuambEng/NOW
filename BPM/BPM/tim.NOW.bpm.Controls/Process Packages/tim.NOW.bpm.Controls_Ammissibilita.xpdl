          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="74.0" LaneId="_R18MovQ-EeazKYdqUBpQKA" Width="114.0">
              <xpdl2:Coordinates XCoordinate="302.0" YCoordinate="194.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
