    <xpdl2:WorkflowProcess Id="_x-qAMMbFEeatjZjsZIIi5Q" xpdExt:DisplayName="CTRL OL IN CORSO STESSO OLO_C04M03F01" xpdExt:XpdModelType="ServiceProcess" Name="CTRLOLINCORSOSTESSOOLO_C04M03F01">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_IbLQUMdlEea-PIfovU0abw" xpdExt:DisplayName="targetRequestRef" Name="targetRequestRef">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_2Y1K_erUEeWg_qPSKmWaWg"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_JOV-YOfvEei4xJsrh7TJpw" xpdExt:DisplayName="processIdentifier" Name="processIdentifier" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_ZM9oMOwWEeiufa1SEp6nSA" xpdExt:DisplayName="idRichiestaBloccante" Name="idRichiestaBloccante" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
