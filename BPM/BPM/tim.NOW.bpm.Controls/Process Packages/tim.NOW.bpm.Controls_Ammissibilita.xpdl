&#xD;
var SEMIFIBRAFTTH = &quot;&quot;;&#xD;
SEMIFIBRAFTTH = null;&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SEMIFIBRAFTTH)&#xD;
			{&#xD;
				SEMIFIBRAFTTH = attributo.valoreAttributo; //recupero il valore per le logiche di congruenza&#xD;
				Process.auditLog(&quot;Trovato attributo SEMIFIBRAFTTH&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			&#xD;
				attributo.valoreAttributo = &quot;SI&quot;;   //serve rimettere a SI il valore di SEMIFIBRAFTTH per i monitoraggi (DTU, SMS, ecc)&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	/* SM_10243&#xD;
	//VERIFICA PRESENZA FLAGMULTICAST NELLA COMPONENTE USERVLAN (email &quot;RE: XSD NGA cumulativo di Semivula e MULTICAST&quot;)&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST&#xD;
			    &amp;&amp; attributo.valoreAttributo == &quot;SI&quot;)&#xD;
			{	&#xD;
				CodiceEsito = &quot;KO_02&quot;;&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Controllo Congruenza Offerta Semifibra NON SUPERATO&quot;;&#xD;
				Process.auditLog(&quot;Trovato attributo FLAGMULTICAST&quot;+ attributo.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	*/&#xD;
}&#xD;
&#xD;
//VERIFICA CONGRUENZA ATTRIBUTO SEMIFIBRAFTTH E OFFERTA (email &quot;RE: RU_1164 - C6&quot;)&#xD;
if((SEMIFIBRAFTTH == &quot;SEMIVULA&quot; &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH)&#xD;
   || (SEMIFIBRAFTTH == &quot;SEMIBITSTREAMNGA&quot; &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH)&#xD;
   || (SEMIFIBRAFTTH == &quot;SEMIEASYIPNGA&quot; &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH))&#xD;
{&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
       || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
	{&#xD;
		CodiceEsito = &quot;KO_01&quot;;&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
            || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
	{&#xD;
		CodiceEsito = &quot;KO_02&quot;;&#xD;
	}&#xD;
	&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Controllo Congruenza Offerta Semifibra NON SUPERATO&quot;;&#xD;
	Process.auditLog(&quot;Trovato attributo SEMIFIBRAFTTH: &quot; + SEMIFIBRAFTTH + &quot;con offerta: &quot; + String(localRequest.offerta) + &quot;e lavorazione&quot; + String(localRequest.lavorazione) + &quot;. Codice Esito:&quot; + CodiceEsito);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
