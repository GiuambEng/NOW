          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="47.0" LaneId="_ItUOcd75EeacQOrD1dy-hA" Width="31.0">
              <xpdl2:Coordinates XCoordinate="1334.0" YCoordinate="239.0"/>
