}&#xD;
	&#xD;
if(VerificaCompatibilitaLavorazioneRequest.flagRientro == &quot;N&quot; &amp;&amp; VerificaCompatibilitaLavorazioneRequest.flagNPRichiesta == &quot;Y&quot; &amp;&amp; VerificaCompatibilitaLavorazioneRequest.flagNPAsset == &quot;Y&quot;)&#xD;
