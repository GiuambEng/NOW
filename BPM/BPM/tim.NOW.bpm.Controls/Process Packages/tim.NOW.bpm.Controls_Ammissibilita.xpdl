            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_xQ11EbuaEea-FqioYDGtog" Width="204.0">
              <xpdl2:Coordinates XCoordinate="894.0" YCoordinate="2712.0"/>
