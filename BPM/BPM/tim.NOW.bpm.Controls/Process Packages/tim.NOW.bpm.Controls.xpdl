          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = true;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	&#xD;
	var foundModulazione = false;&#xD;
	var i = 0;&#xD;
	&#xD;
	while(!foundModulazione &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettaglioOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for (var j=0; j&lt;currentDettaglioOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttrDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MODULAZIONE)&#xD;
						&#xD;
						{&#xD;
							foundModulazione=true;&#xD;
						}&#xD;
				}&#xD;
			}&#xD;
		&#xD;
		&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(!foundModulazione)&#xD;
	{&#xD;
	EseguiControllo= false;&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
&#xD;
</xpdl2:Script>
