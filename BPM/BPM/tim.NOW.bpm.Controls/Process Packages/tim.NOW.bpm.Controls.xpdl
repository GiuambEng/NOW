    <xpdl2:WorkflowProcess Id="_DW9fQCEDEeaub_W9_7VV0A" xpdExt:DisplayName="CTRL CONGRUENZA VLAN VULA-NGA_C04M01F38" Name="CTRLCONGRUENZAVLANVULANGA_C04M01F38">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_OXFb02YbEeeFLuxKJU-nxw" xpdExt:DisplayName="EseguiControllo" Name="EseguiControllo" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="BOOLEAN"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
      </xpdl2:DataFields>
