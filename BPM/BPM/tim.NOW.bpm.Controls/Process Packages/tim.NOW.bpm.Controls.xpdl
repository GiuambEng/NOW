      <xpdl2:Activities>
        <xpdl2:Activity Id="_zgyR4TL3EeajbIG7R_HFFQ" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_zgvOkjL3EeajbIG7R_HFFQ" Width="31.0">
              <xpdl2:Coordinates XCoordinate="660.0" YCoordinate="197.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_zgyR4jL3EeajbIG7R_HFFQ" Name="VerificaSaturazioneBandaVP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Saturazione Banda VP" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var currentCodiceVP = '';&#xD;
var currentMCRDOWN = '';&#xD;
var currentBandaConsegna = '';&#xD;
var failed = false;&#xD;
&#xD;
VPCode = DataUtil.createList();&#xD;
SumMCRDown = DataUtil.createList();&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
	{&#xD;
		currentCodiceVP = null;&#xD;
		currentMCRDOWN = null;&#xD;
		currentBandaConsegna = null;&#xD;
		var j = 0;&#xD;
		&#xD;
		while((currentCodiceVP == null || currentMCRDOWN == null) &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEVP)&#xD;
			{&#xD;
				currentCodiceVP = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRDOWN)&#xD;
			{&#xD;
				currentMCRDOWN = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDACONSEGNA)&#xD;
			{&#xD;
				currentBandaConsegna = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
		if(currentCodiceVP != null &amp;&amp; currentMCRDOWN != null)&#xD;
		{&#xD;
			Process.auditLog(&quot;Trovato CodiceVP: &quot; + currentCodiceVP + &quot; e MCRDOWN: &quot; +currentMCRDOWN);&#xD;
			if(VPCode.contains(currentCodiceVP))&#xD;
			{&#xD;
				Process.auditLog(&quot;VPCode giá trovato&quot;);&#xD;
				var tmp = 0;&#xD;
				var z = 0;&#xD;
				&#xD;
				while(tmp == 0 &amp;&amp; z &lt; VPCode.size())&#xD;
				{&#xD;
					if(VPCode.get(z) == currentCodiceVP)&#xD;
					{&#xD;
						tmp = SumMCRDown.get(z) + parseInt(currentMCRDOWN, 10);&#xD;
						SumMCRDown.set(z,tmp);&#xD;
					}&#xD;
					z++;&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				Process.auditLog(&quot;Trovato un nuovo VPCode&quot;);&#xD;
				VPCode.add(currentCodiceVP);&#xD;
				SumMCRDown.add(parseInt(currentMCRDOWN, 10));&#xD;
				Process.auditLog(&quot;Ultimo elemento in VPCode: &quot; + VPCode.get(VPCode.size() -1 ));&#xD;
				Process.auditLog(&quot;Ultimo elemento in SumMCRDown: &quot; + SumMCRDown.get(SumMCRDown.size() -1 ));&#xD;
			}&#xD;
		}&#xD;
		else if(currentBandaConsegna.toUpperCase() == 'CONDIVISA')&#xD;
		{&#xD;
			failed = true;&#xD;
			EsitoResponse.descrizione = &quot;Trovata ATMVC con BANDA CONDIVISA ma con CODICEVP o MCRDOWN mancante&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			//Per VC con BandaConsegna DEDICATA non va eseguito il controllo&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
var y = 0;&#xD;
&#xD;
while(!failed &amp;&amp;  y &lt; SumMCRDown.size())&#xD;
{&#xD;
	var matched = false;&#xD;
	var w = 0;&#xD;
	//da terminare implementazione (vedo punto aperto mail del 15 Jun)&#xD;
	Process.auditLog(&quot;EsistenzaVPOutput.size: &quot; + EsistenzaVPOutput.size());&#xD;
	&#xD;
	while(!matched &amp;&amp; w &lt; EsistenzaVPOutput.size())&#xD;
	{&#xD;
		var currentEsistenzaVP = EsistenzaVPOutput.get(w);&#xD;
		&#xD;
		Process.auditLog(&quot;Verifico se l'y-esimo VPCode: &quot; + VPCode.get(y) + &quot; é uguale al w-esimo EsistenzaVP.VPCode: &quot; + currentEsistenzaVP.VPCode);&#xD;
		&#xD;
		if(currentEsistenzaVP.VPCode == VPCode.get(y))&#xD;
		{&#xD;
			matched = true;&#xD;
			&#xD;
			if(SumMCRDown.get(y) > (4 * parseInt(currentEsistenzaVP.bandaMCR, 10)))&#xD;
			{&#xD;
				failed = true;&#xD;
				EsitoResponse.descrizione = &quot;La somma delle MCRDOWN (&quot; + SumMCRDown.get(y) + &quot;) é maggiore di 4 volte la BANDAMCR (&quot; + String(4 * parseInt(currentEsistenzaVP.bandaMCR, 10)) + &quot;) per il VPCODE di riferimento&quot;;&#xD;
			}&#xD;
		}&#xD;
		w++;&#xD;
	}&#xD;
	&#xD;
	if(!matched)&#xD;
	{&#xD;
		failed = true;&#xD;
		EsitoResponse.descrizione = &quot;Impossibile trovare BANDAMCR per il VPCODE di riferimento&quot;;&#xD;
	}&#xD;
	y++;&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Controlli superati&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
