    <xpdl2:WorkflowProcess Id="_pYWikCGOEeabcO_3BeoHyw" xpdExt:DisplayName="CTRL UNIVOCITA USERVLANID_C04M01F50" Name="CTRLUNIVOCITAUSERVLANID_C04M01F50">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_p6PvMcuPEee_cajyhqoTSw" xpdExt:DisplayName="EseguiControllo" Name="EseguiControllo" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="BOOLEAN"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_Y3aAkc7BEeelCLq79SRslg" xpdExt:DisplayName="Asset" Name="Asset">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_b-r6kc7BEeelCLq79SRslg" xpdExt:DisplayName="AssetRef" Name="AssetRef">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
