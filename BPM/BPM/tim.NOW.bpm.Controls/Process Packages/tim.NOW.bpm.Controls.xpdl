            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaContrattoComuneCoinvSemifibraRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaContrattoCoinvestimentoComuneSemifibra_RequestType();&#xD;
&#xD;
//Recupero Asset&#xD;
if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
}&#xD;
else if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.IDAsset != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaFonia.IDAsset, 10));&#xD;
}&#xD;
	&#xD;
if(AssetRef!= null)&#xD;
{	&#xD;
	Asset = AssetRef.readAsset();&#xD;
}&#xD;
&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest != &quot;&quot;)&#xD;
{&#xD;
	VerificaContrattoComuneCoinvSemifibraRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	VerificaContrattoComuneCoinvSemifibraRequest.lavorazione = String(localRequest.lavorazione);&#xD;
	VerificaContrattoComuneCoinvSemifibraRequest.offerta = String(localRequest.offerta);&#xD;
	VerificaContrattoComuneCoinvSemifibraRequest.idContratto = localRequest.IDContratto;&#xD;
	&#xD;
	//Bug #34716&#xD;
	if(localRequest.ISTATComune != null)&#xD;
	{&#xD;
		VerificaContrattoComuneCoinvSemifibraRequest.codiceIstatComune = localRequest.ISTATComune;&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
	        &amp;&amp; Asset != null &amp;&amp; Asset.codiceISTATComune != null)&#xD;
	{&#xD;
		VerificaContrattoComuneCoinvSemifibraRequest.codiceIstatComune = Asset.codiceISTATComune;&#xD;
	}	&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
