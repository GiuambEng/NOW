    <xpdl2:WorkflowProcess Id="_YtmQsGkEEeaCa7IeLXedLg" xpdExt:DisplayName="CTRL MODELLO VULA_C04M01F93" Name="CTRLMODELLOVULA_C04M01F93">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_e797dHnvEea1SPAdvnGrrA" xpdExt:DisplayName="processIdentifier" Name="processIdentifier">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>500</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
          <xpdExt:InitialValues>
            <xpdExt:Value>/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.utils.xpdl.DatiVerificaControlliStorico</xpdExt:Value>
          </xpdExt:InitialValues>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_DtV6cJedEea1Cdj6pUXdUQ" xpdExt:DisplayName="DatiVerificheFormali" Name="DatiVerificheFormali">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="com.tim.NOW.xsd.StoricoDatiVerificaControlli.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.StoricoDatiVerificaControlliDatiVerificheFormaliType"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_Mava4BSNEee1DqrKiDUwYQ" xpdExt:DisplayName="AssetRef" Name="AssetRef" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_Yt7n4WkEEeaCa7IeLXedLg" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_Ytos8WkEEeaCa7IeLXedLg" Width="31.0">
              <xpdl2:Coordinates XCoordinate="893.0" YCoordinate="218.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_Yt7n4mkEEeaCa7IeLXedLg" Name="DeterminazionemodelloVULA" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Determinazione modello VULA">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//C04M01F93 - Determinazione modello VULA - S6&#xD;
//SM_10422 - controllo cambiato per fix riguardanti FLAGMULTICAST&#xD;
&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice= true;&#xD;
EsitoResponse.descrizione=&quot; &quot;;&#xD;
&#xD;
var failed = false;&#xD;
var userVlanId = DataUtil.createList();&#xD;
var userVlanCode = DataUtil.createList();&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati != &quot;&quot;)&#xD;
	{&#xD;
		//Recupero Asset in consistenza&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
		var Asset = AssetRef.readAsset();&#xD;
		&#xD;
		for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
			if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
			&amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)&#xD;
			{&#xD;
				var j = 0;&#xD;
				&#xD;
				while(j&lt;currentDettAsset.attributidettaglioasset.size())&#xD;
				{&#xD;
					var currentAttributo = currentDettAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
					{&#xD;
						userVlanId.add(currentAttributo.valoreAttributo);&#xD;
						Process.auditLog(&quot;Da Asset aggiunta USERVLANID &quot;+currentAttributo.valoreAttributo);&#xD;
					}&#xD;
					//SM_10422&#xD;
					else if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
					{&#xD;
						userVlanCode.add(currentAttributo.valoreAttributo);&#xD;
						Process.auditLog(&quot;Da Asset aggiunto SVLANCODE &quot;+currentAttributo.valoreAttributo);&#xD;
					}&#xD;
					else if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST&#xD;
						 &amp;&amp; currentAttributo.valoreAttributo == &quot;SI&quot;)&#xD;
					{&#xD;
						userVlanCode.add(&quot;&quot;);&#xD;
						Process.auditLog(&quot;Da Asset aggiunto SVLANCODE vuoto&quot;);&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//SM_10478: se l'asset è UNTAGGED c'è una sola USERVLAN che non ha USERVLANID, quindi per evitare disallineamenti inseriamo un valore fittizio&#xD;
		if(userVlanCode.size() == 1 &amp;&amp; userVlanId.size() == 0)&#xD;
		{&#xD;
			userVlanId.add(&quot;0&quot;);&#xD;
		}&#xD;
&#xD;
		if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
		{&#xD;
			//INCREMENTODECREMENTOVC&#xD;
			if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
			{&#xD;
				for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++)&#xD;
				{&#xD;
					var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
					&#xD;
					if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
					{&#xD;
						var deletedIndex = -1;&#xD;
						var configIndex = -1;&#xD;
								&#xD;
						for(var j=0;j&lt;currentDettOrdine.attributiDettaglioOrdine.size();j++)&#xD;
						{&#xD;
							var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
							&#xD;
							if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
							{&#xD;
								//Recupero Index nell'array dell'asset dell'UserVlanID corrente, se c'è&#xD;
								if(userVlanId.contains(currentAttDettOrdine.valoreAttributo))&#xD;
								{&#xD;
									for(var k=0; k&lt;userVlanId.size();k++)&#xD;
									{&#xD;
										if(userVlanId.get(k) == currentAttDettOrdine.valoreAttributo)&#xD;
										{&#xD;
											configIndex = k;&#xD;
											Process.auditLog(&quot;ConfigIndex &quot;+configIndex);&#xD;
										}&#xD;
									}&#xD;
								}&#xD;
								&#xD;
								if(currentDettOrdine.azione == &quot;A&quot;)&#xD;
								{	&#xD;
									userVlanId.add(currentAttDettOrdine.valoreAttributo);&#xD;
									Process.auditLog(&quot;Da ORDINE aggiunta USERVLANID &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
								}&#xD;
								else if(currentDettOrdine.azione == &quot;D&quot;)&#xD;
								{	&#xD;
									for(var k=0; k&lt;userVlanId.size();k++)&#xD;
									{&#xD;
										if(userVlanId.get(k) == currentAttDettOrdine.valoreAttributo)&#xD;
										{&#xD;
											deletedIndex = k;&#xD;
											Process.auditLog(&quot;Da ORDINE rimossa SVLANCODE &quot;+userVlanCode.get(deletedIndex));&#xD;
											userVlanCode.remove(deletedIndex);   //SM_9909&#xD;
										}&#xD;
									}&#xD;
									userVlanId.remove(currentAttDettOrdine.valoreAttributo);&#xD;
									Process.auditLog(&quot;Da ORDINE rimossa USERVLANID &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
								}&#xD;
							}&#xD;
							else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
							{&#xD;
								if(currentDettOrdine.azione == &quot;A&quot;)&#xD;
								{&#xD;
									userVlanCode.add(currentAttDettOrdine.valoreAttributo);&#xD;
									Process.auditLog(&quot;Da ORDINE aggiunta SVLANCODE &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
								}&#xD;
								else if(currentAttDettOrdine.valoreAttributo != &quot;ATTRIBUTO IN ELIMINAZIONE&quot;&#xD;
									 &amp;&amp; configIndex != -1&#xD;
									 &amp;&amp; currentDettOrdine.azione != &quot;D&quot;)&#xD;
								{&#xD;
									userVlanCode.set(configIndex, currentAttDettOrdine.valoreAttributo);&#xD;
									Process.auditLog(&quot;Da ORDINE aggiornato SVLANCODE &quot;+currentAttDettOrdine.valoreAttributo+&quot; su indice &quot;+configIndex);&#xD;
								}&#xD;
							}&#xD;
							else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST&#xD;
							&amp;&amp; currentAttDettOrdine.valoreAttributo == &quot;SI&quot;&#xD;
							&amp;&amp; currentDettOrdine.azione == &quot;A&quot;)&#xD;
							{&#xD;
								if(currentDettOrdine.azione == &quot;A&quot;)&#xD;
								{&#xD;
									userVlanCode.add(&quot;&quot;);&#xD;
									Process.auditLog(&quot;Da ORDINE aggiunta SVLANCODE vuota (perché VLAN MULTICAST)&quot;);&#xD;
								}&#xD;
								else if(configIndex != -1&#xD;
									 &amp;&amp; currentDettOrdine.azione != &quot;D&quot;)&#xD;
								{&#xD;
									userVlanCode.set(configIndex, currentAttDettOrdine.valoreAttributo);&#xD;
									Process.auditLog(&quot;Da ORDINE sbiancato SVLANCODE su indice &quot;+configIndex);&#xD;
								}&#xD;
							}								&#xD;
						}//end for attributo j&#xD;
					}//end if uservlan&#xD;
				}//end for i&#xD;
			}//end if incrementodecremento&#xD;
			//RICONFIGURAZIONEVC&#xD;
			else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
			{&#xD;
				for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++)&#xD;
				{&#xD;
					var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
					&#xD;
					if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
					{		&#xD;
						var configIndex = -1;&#xD;
						var j = 0;&#xD;
						&#xD;
						while(configIndex == -1 &amp;&amp; j&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
						{&#xD;
							var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
&#xD;
							if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
							{&#xD;
								if(userVlanId.contains(currentAttDettOrdine.valoreAttributo))&#xD;
								{&#xD;
									for(var k=0; k&lt;userVlanId.size();k++)&#xD;
									{&#xD;
										if(userVlanId.get(k) == currentAttDettOrdine.valoreAttributo)&#xD;
										{&#xD;
											configIndex = k;&#xD;
											Process.auditLog(&quot;ConfigIndex &quot;+configIndex);&#xD;
										}&#xD;
									}&#xD;
								}&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
						&#xD;
						if(configIndex != -1)&#xD;
						{&#xD;
							for(var j=0;j&lt;currentDettOrdine.attributiDettaglioOrdine.size();j++)&#xD;
							{&#xD;
								var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
									&#xD;
								if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE&#xD;
								&amp;&amp; currentAttDettOrdine.valoreAttributo != &quot;ATTRIBUTO IN ELIMINAZIONE&quot;&#xD;
								&amp;&amp; configIndex != -1)&#xD;
								{&#xD;
									userVlanCode.set(configIndex,currentAttDettOrdine.valoreAttributo);&#xD;
									Process.auditLog(&quot;Da ORDINE aggiornato SVLANCODE &quot;+currentAttDettOrdine.valoreAttributo+&quot; su indice &quot;+configIndex);&#xD;
								}&#xD;
								else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST&#xD;
									 &amp;&amp; currentAttDettOrdine.valoreAttributo == &quot;SI&quot;&#xD;
									 &amp;&amp; configIndex != -1)&#xD;
								{&#xD;
									userVlanCode.set(configIndex,&quot;&quot;);&#xD;
									Process.auditLog(&quot;Da ORDINE sbiancato SVLANCODE su indice &quot;+configIndex);&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
					}//end if uservlan&#xD;
				}//end for i&#xD;
			}//end RICONFIGURAZIONEVC&#xD;
			//VARIAZIONETAGGING&#xD;
			else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING)&#xD;
			{&#xD;
				//UNTAGGED -> TAGGED&#xD;
				if(userVlanCode.size() == 1)&#xD;
				{&#xD;
					for(var i=0 ; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
					{&#xD;
						var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
						if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
						{&#xD;
							for(var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size();j++)&#xD;
							{&#xD;
								var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
								&#xD;
								if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
								{&#xD;
									userVlanId.add(currentAttDettOrdine.valoreAttributo);&#xD;
									Process.auditLog(&quot;aggiunto USERVLANID &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
								}&#xD;
								else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
								{&#xD;
									userVlanCode.add(currentAttDettOrdine.valoreAttributo);&#xD;
									Process.auditLog(&quot;aggiunto SVLANCODE &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
								}&#xD;
							&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					//TAGGED -> UNTAGGED&#xD;
					userVlanCode = DataUtil.createList();&#xD;
					//SVLANCODE = 100 è un codice fittizio&#xD;
					userVlanCode.add(&quot;100&quot;);&#xD;
					userVlanId.add(&quot;100&quot;);&#xD;
					Process.auditLog(&quot;aggiunto SVLANCODE e USERVLANID fittizi&quot;);&#xD;
				}&#xD;
			}	&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Impossibile completare l'operazione, Consistenza Dati non presente in input&quot;);&#xD;
	}&#xD;
			&#xD;
}//end if VARIAZIONE&#xD;
//ATTIVAZIONE MIGRAZIONE&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &#xD;
	 || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE){&#xD;
	&#xD;
	if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
	{&#xD;
		for(var i=0 ; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{&#xD;
				for(var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size();j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
					{&#xD;
						userVlanId.add(currentAttDettOrdine.valoreAttributo);&#xD;
						Process.auditLog(&quot;Da ORDINE ATT_MIG aggiunto USERVLANID &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
					{&#xD;
						userVlanCode.add(currentAttDettOrdine.valoreAttributo);&#xD;
						Process.auditLog(&quot;Da ORDINE ATT_MIG aggiunto SVLANCODE &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST&#xD;
						 &amp;&amp; currentAttDettOrdine.valoreAttributo == &quot;SI&quot;)&#xD;
					{&#xD;
						userVlanCode.add(&quot;&quot;);&#xD;
						Process.auditLog(&quot;Da ORDINE ATT_MIG aggiunto SVLANCODE vuoto per MULTICAST&quot;);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//SM_10422: ora alla fine di tutti i cicli, in UserVlanCode avrò &quot;&quot; se si tratta di una UserVlan Multicast nella richiesta&#xD;
//quindi, elimino quelle posizioni perché non vanno considerate&#xD;
for(var i = 0; i&lt;userVlanCode.size(); i++)&#xD;
{&#xD;
	if(userVlanCode.get(i) == &quot;&quot;)&#xD;
	{&#xD;
		userVlanCode.remove(i);&#xD;
		Process.auditLog(&quot;Da array in rimozione SVLANCODE corrispondente a USERVLANID &quot;+userVlanId.get(i));&#xD;
		userVlanId.remove(i);&#xD;
		i--;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(userVlanCode.size() &lt; 1)&#xD;
{&#xD;
	failed = true;&#xD;
	Process.auditLog(&quot;Presente nessuno SVLANCODE&quot;);&#xD;
}&#xD;
else&#xD;
{&#xD;
	var i=0;&#xD;
	&#xD;
	while(!failed &amp;&amp; i &lt; userVlanCode.size())&#xD;
	{&#xD;
		if(i > 0)&#xD;
		{&#xD;
			if(userVlanCode.get(i) != userVlanCode.get(i-1))&#xD;
			{&#xD;
				failed = true;&#xD;
				Process.auditLog(&quot;Trovati SVLANCODE diversi: &quot;+userVlanCode.get(i)+&quot; e &quot;+userVlanCode.get(i-1));&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Controllo MODELLO VULA: trovati SvlanCode distinti&quot;;&#xD;
	FlagNuovoModello = &quot;N&quot;;&#xD;
}&#xD;
else if(userVlanCode.size() &lt; 1)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Controllo MODELLO VULA: nessuna USERVLAN trovata&quot;;&#xD;
	FlagNuovoModello = &quot;N&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Controllo MODELLO VULA: nuovo modello (Y)&quot;;&#xD;
	FlagNuovoModello = &quot;Y&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);&#xD;
&#xD;
&#xD;
//aggiungere il flag in attributo dettaglio ordine (FLAGNUOVOMODELLO) della componente (ACCESSOVULAFTTH)&#xD;
i=0;&#xD;
var trovataComponente=false;&#xD;
var trovatoAttributo = false;&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
var attributoTemp = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
attributoTemp.lastUpdate = date;&#xD;
attributoTemp.created = date;&#xD;
attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUOVOMODELLO;&#xD;
attributoTemp.operatore= &quot;BPM&quot;;&#xD;
attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
attributoTemp.valoreAttributo = FlagNuovoModello;&#xD;
				&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	while(!trovataComponente &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var dettaglio = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTH&#xD;
		 || dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTCAB)&#xD;
		 {&#xD;
			trovataComponente=true;&#xD;
			var j = 0;&#xD;
			&#xD;
			while(!trovatoAttributo &amp;&amp; j &lt; dettaglio.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = dettaglio.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUOVOMODELLO)&#xD;
				{&#xD;
					trovatoAttributo = true;&#xD;
					attributo.valoreAttributo = FlagNuovoModello;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(!trovatoAttributo)&#xD;
			{&#xD;
				attributoTemp.IDDettaglioOrdine = dettaglio.IDDettaglioOrdine;&#xD;
				attributoTemp.IDRichiestaOLO = dettaglio.IDRichiestaOLO;&#xD;
&#xD;
				localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(!trovataComponente)&#xD;
	{&#xD;
		var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
		componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componente.created = DateTimeUtil.createDatetime();&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
		componente.integrationID = localRequest.IDRichiestaOLO + localRequest.ordine.dettaglioordine.size();&#xD;
		&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH)   //RU_1164&#xD;
		{&#xD;
			componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTH;&#xD;
		}&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
		{&#xD;
			componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTCAB;&#xD;
		}&#xD;
		&#xD;
		componente.operatore = &quot;BPM&quot;;&#xD;
		componente.progressivo = 1;&#xD;
		&#xD;
		attributoTemp.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
		attributoTemp.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				&#xD;
		componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
		&#xD;
		localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
