        <xpdl2:Activity Id="_IjXGgdOZEe27gKv0VQyaJw" Name="CtrlReferenteCodProgetto" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Ctrl Referente CodProgetto">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Inizializzo la struttura di esito&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL REFERENTE CODPROGETTO OK&quot;;&#xD;
&#xD;
var foundRefOnField = false;&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.referente != null)&#xD;
{&#xD;
	var i=0;&#xD;
	while(i&lt;localRequest.ordine.referente.size() &amp;&amp; !foundRefOnField)&#xD;
	{&#xD;
		if(localRequest.ordine.referente.get(i).tipoReferenteOrdine ==&#xD;
		it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTEONFIELD)&#xD;
		{&#xD;
			foundRefOnField = true;			&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(foundRefOnField &amp;&amp; OneStep != &quot;Y&quot;)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL REFERENTE CODPROGETTO KO&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);&#xD;
&#xD;
&#xD;
</xpdl2:Script>
