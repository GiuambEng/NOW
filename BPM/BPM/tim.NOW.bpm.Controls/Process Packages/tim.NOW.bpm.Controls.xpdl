&#xD;
//DATI DA CONSISTENZA&#xD;
if(ConsistenzaRaccolta != null)&#xD;
{	&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaRaccolta.IDAsset, 10));&#xD;
	Asset = AssetRef.readAsset();&#xD;
	&#xD;
	for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
		if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
		{&#xD;
			for(var j=0; j&lt;currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
				{&#xD;
					COSconsistenza = currentAttDettAsset.valoreAttributo;&#xD;
					Process.auditLog(&quot;IDENTIFICATIVOCOS in Consistenza: &quot;+COSconsistenza);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(String(currentDettAsset.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN)&#xD;
				{&#xD;
					TIPOLOGIACLUSTERVLANcons = currentAttDettAsset.valoreAttributo;&#xD;
					Process.auditLog(&quot;TIPOLOGIACLUSTERVLAN in Consistenza: &quot;+TIPOLOGIACLUSTERVLANcons);&#xD;
				}&#xD;
				else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FTTHONLY)&#xD;
				{&#xD;
					FTTHONLYcons = currentAttDettAsset.valoreAttributo;&#xD;
					Process.auditLog(&quot;FTTHONLY in Consistenza: &quot;+FTTHONLYcons);&#xD;
				}&#xD;
				//SM_9938&#xD;
				else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA)&#xD;
				{&#xD;
					SUPERMACROAREAcons = currentAttDettAsset.valoreAttributo;&#xD;
					Process.auditLog(&quot;SUPERMACROAREA in Consistenza: &quot;+SUPERMACROAREAcons);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//DATI DA LAVORAZIONERICHIESTA&#xD;
if(LavorazioneRichiesta != null)&#xD;
{&#xD;
	TIPOLOGIACLUSTERVLAN = LavorazioneRichiesta.tipologiaClusterVlan;&#xD;
	FTTHONLY = LavorazioneRichiesta.ftthOnly;&#xD;
	Process.auditLog(&quot;TIPOLOGIACLUSTERVLAN in LavorazioneRichiesta: &quot;+TIPOLOGIACLUSTERVLAN);&#xD;
	Process.auditLog(&quot;FTTHONLY in LavorazioneRichiesta: &quot;+FTTHONLY);&#xD;
}&#xD;
&#xD;
//DATI DA RICHIESTA (SM_9938)&#xD;
if(localRequest != null)&#xD;
{&#xD;
	for(var m=0; m&lt;localRequest.ordine.dettaglioordine.size(); m++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(m);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
		{&#xD;
			for(var k=0; k&lt;componente.attributiDettaglioOrdine.size(); k++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA)&#xD;
				{&#xD;
					SUPERMACROAREA = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo SUPERMACROAREA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
var eseguireRicerca = false;&#xD;
&#xD;
//SM_9925: sostiuiti valori OLD di TIPOLOGIACLUSTERVLAN e FTTHONLY con quelli della CONSISTENZA&#xD;
if((TIPOLOGIACLUSTERVLANcons == null &amp;&amp; TIPOLOGIACLUSTERVLAN == &quot;LIB&quot;) //CASO1&#xD;
|| (TIPOLOGIACLUSTERVLANcons == &quot;CC&quot; &amp;&amp; TIPOLOGIACLUSTERVLAN == &quot;LIB&quot;) //CASO1&#xD;
|| (TIPOLOGIACLUSTERVLANcons == null &amp;&amp; TIPOLOGIACLUSTERVLAN == &quot;CC&quot;)  //CASO2&#xD;
|| (FTTHONLYcons == null &amp;&amp; FTTHONLY == &quot;Y&quot;)						  //CASO3&#xD;
|| (SUPERMACROAREAcons == &quot;2&quot; &amp;&amp; TIPOLOGIACLUSTERVLAN == &quot;CC&quot; &amp;&amp; (SUPERMACROAREA == &quot;0&quot; || SUPERMACROAREA == null))    //CASO4 (SM_9938)&#xD;
|| (SUPERMACROAREAcons == &quot;3&quot; &amp;&amp; TIPOLOGIACLUSTERVLAN == &quot;LIB&quot; &amp;&amp; (SUPERMACROAREA == &quot;0&quot; || SUPERMACROAREA == null)))  //CASO5 (SM_9938)&#xD;
{&#xD;
	eseguireRicerca = true;&#xD;
	Process.auditLog(&quot;Ricerca da eseguire, TIPOLOGIACLUSTERVLANcons: &quot;+TIPOLOGIACLUSTERVLANcons+&quot;, TIPOLOGIACLUSTERVLAN: &quot;+TIPOLOGIACLUSTERVLAN+&quot;, FTTHONLYcons: &quot;+FTTHONLYcons+&quot;, FTTHONLY: &quot;+FTTHONLY);&#xD;
}&#xD;
&#xD;
&#xD;
if(eseguireRicerca)&#xD;
{&#xD;
	//SM_9838: esclusi ESPLETAMENTOTECNICO, ESPLETAMENTOTECNICOKO, FATTURAZIONEKO, ESPLETAMENTOTECNICOB2B&#xD;
	//RU_1554: esclusi stati D82&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;ordine.dettaglioordine.attributiDettaglioOrdine.nomeAttributo = 'SVLANCODE' AND ordine.dettaglioordine.attributiDettaglioOrdine.valoreAttributo =: IDRISORSA AND statoRichiestaNOW NOT IN ('CHIUSO', 'CHIUSOB2B', 'ANNULLATO', 'ANNULLATOB2B', 'SCARTATO', 'SCARTATOB2B', 'INVIATOAFATTURAZIONE', 'ESPLETAMENTOTECNICO', 'ESPLETAMENTOTECNICOKO', 'FATTURAZIONEKO', 'ESPLETAMENTOTECNICOB2B', 'ACQUISITOKOD82', 'ACCETTATOKOD82', 'ESPLETATOKOD82', 'ESPLETATOD82', 'ANNULLATOD82') AND IDRichiestaOLO &lt;>: PVM AND created&lt;:currentDate&quot;);        //SM_9725: escluso CHIUSOB2B //SM_9826: escluso ANNULLATOB2B e SCARTATOB2B&#xD;
	&#xD;
	criteria.setQueryParameter(&quot;IDRISORSA&quot;,localRequest.IDRisorsa);&#xD;
	criteria.setQueryParameter(&quot;PVM&quot;,localRequest.IDRichiestaOLO);&#xD;
	criteria.setQueryParameter(&quot;currentDate&quot;,localRequest.created);&#xD;
	&#xD;
	list = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
	if(list != null &amp;&amp; list.size()>0)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		Process.auditLog(&quot;Trovato PVM in uno stato non finale, CTRL in scarto&quot;);&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
