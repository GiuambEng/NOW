    <xpdl2:WorkflowProcess Id="_-L-hkCNGEea7qJ_CMNwz5w" xpdExt:DisplayName="CTRL VAL VP_C04M01F59" Name="CTRLVALVP_C04M01F59">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_-MA91iNGEea7qJ_CMNwz5w" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_-L-hkiNGEea7qJ_CMNwz5w" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_-MA91yNGEea7qJ_CMNwz5w" Name="VerificaValorizzazioneVP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Valorizzazione VP" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var foundVPCode = false;&#xD;
var foundTipoBandaCondivisa = false;&#xD;
var failed = false;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!failed &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC &amp;&amp; currentDettaglioOrdine.attributiDettaglioOrdine != null)&#xD;
		{&#xD;
			foundTipoBandaCondivisa = false;&#xD;
			foundVPCode = false;&#xD;
			var j = 0;&#xD;
			&#xD;
			while(!foundTipoBandaCondivisa &amp;&amp; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDACONSEGNA &amp;&amp; currentAttDettOrdine.valoreAttributo == &quot;CONDIVISA&quot;)&#xD;
				{&#xD;
					//Trovata TIPOBANDACONSEGNA = CONDIVISA&#xD;
					foundTipoBandaCondivisa = true;&#xD;
					&#xD;
					var z = 0;&#xD;
					while (!foundVPCode &amp;&amp; z &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						if(currentDettaglioOrdine.attributiDettaglioOrdine.get(z).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEVP)&#xD;
						{&#xD;
							//Trovato VPCode&#xD;
							foundVPCode = true;&#xD;
						}&#xD;
						z++;&#xD;
					}&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(foundTipoBandaCondivisa &amp;&amp; !foundVPCode)&#xD;
			{&#xD;
				//Trovato un TIPOBANDACONSEGNA = CONDIVISA ma non il relativo VPCode&#xD;
				failed = true;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(!failed)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Tutte le VC con TipoBandaConsegna valorizzata a Condivisa contengono il relativo VPCode&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Trovata una VC con TipoBandaConsegna valorizzata a Condivisa ma senza il relativo VPCode&quot;;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
