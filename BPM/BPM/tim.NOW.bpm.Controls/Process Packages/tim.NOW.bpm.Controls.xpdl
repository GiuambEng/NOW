          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaCongruenzaAccessoMulticastRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaCongruenzaAccessoMulticast_RequestType();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	VerificaCongruenzaAccessoMulticastRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	VerificaCongruenzaAccessoMulticastRequest.lavorazione = String(localRequest.lavorazione);&#xD;
	VerificaCongruenzaAccessoMulticastRequest.offerta = String(localRequest.offerta);&#xD;
	VerificaCongruenzaAccessoMulticastRequest.idContratto = String(localRequest.IDContratto);&#xD;
	VerificaCongruenzaAccessoMulticastRequest.CLLI = localRequest.ordine.CLLI;&#xD;
	VerificaCongruenzaAccessoMulticastRequest.DRO = String(localRequest.DRO);&#xD;
	VerificaCongruenzaAccessoMulticastRequest.codificaOloAgcom = localRequest.codificaOLOAGCOM;&#xD;
	&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			var UservlanInput = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVLan_VerificaEsistenzaVLAN();&#xD;
			UservlanInput.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			&#xD;
			if(componente.azione != null &amp;&amp; componente.azione != &quot;&quot;)&#xD;
			{&#xD;
				UservlanInput.azione = String(componente.azione);&#xD;
			}&#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
				{&#xD;
					if(UservlanInput.codiciVLAN == null)&#xD;
					{&#xD;
						UservlanInput.codiciVLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createCodiciVLANType();&#xD;
					}&#xD;
					UservlanInput.codiciVLAN.SVlanCode = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
				{&#xD;
					UservlanInput.codeVlanSingleTag = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
				{&#xD;
					if(UservlanInput.codiciVLAN == null)&#xD;
					{&#xD;
						UservlanInput.codiciVLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createCodiciVLANType();&#xD;
					}&#xD;
					UservlanInput.codiciVLAN.CVLAN_ID = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
				{&#xD;
					UservlanInput.flagMulticast = attributo.valoreAttributo;&#xD;
				}&#xD;
				//In VARIAZIONE mi serve salvarmi gli USERVLANID per evitare duplicati con quelli recuperati in consistenza&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID&#xD;
					 &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
				{&#xD;
					userVlanID.add(attributo.valoreAttributo);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//Mando le USERVLAN dell'ordine se siamo in ATTIVAZIONE/MIGRAZIONE, oppure se siamo in VARIAZIONE e sono in INCREMENTO&#xD;
			//Nel caso in cui siamo in VARIAZIONE e sono da decrementare, non c'è bisogno di inviarle&#xD;
			if(localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
			|| componente.azione != &quot;D&quot;)&#xD;
			{&#xD;
				VerificaCongruenzaAccessoMulticastRequest.uservlan.add(ScriptUtil.copy(UservlanInput));&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
	&amp;&amp; asset != null)&#xD;
	{&#xD;
		//SM_10288&#xD;
		VerificaCongruenzaAccessoMulticastRequest.CLLI = asset.CLLI;&#xD;
		&#xD;
		for(var k = 0; k &lt; asset.dettaglioasset.size(); k++)&#xD;
		{&#xD;
			var currentDettAsset = asset.dettaglioasset.get(k);&#xD;
			&#xD;
			if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
			   &amp;&amp; currentDettAsset.statoDettaglioAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO)     //Task #39422&#xD;
			{&#xD;
				var UservlanInput = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVLan_VerificaEsistenzaVLAN();&#xD;
				UservlanInput.IDDettaglioOrdine = 0;&#xD;
				UservlanInput.azione = &quot;N&quot;;&#xD;
				&#xD;
				var daInviare = true;&#xD;
				&#xD;
				for(var z = 0; z &lt; currentDettAsset.attributidettaglioasset.size(); z++)&#xD;
				{&#xD;
					var attributoAss = currentDettAsset.attributidettaglioasset.get(z);&#xD;
					&#xD;
					if(attributoAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
					{&#xD;
						if(UservlanInput.codiciVLAN == null)&#xD;
						{&#xD;
							UservlanInput.codiciVLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createCodiciVLANType();&#xD;
						}&#xD;
						UservlanInput.codiciVLAN.SVlanCode = attributoAss.valoreAttributo;&#xD;
					}&#xD;
					else if(attributoAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
					{&#xD;
						UservlanInput.codeVlanSingleTag = attributoAss.valoreAttributo;&#xD;
					}&#xD;
					else if(attributoAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
					{&#xD;
						if(UservlanInput.codiciVLAN == null)&#xD;
						{&#xD;
							UservlanInput.codiciVLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createCodiciVLANType();&#xD;
						}&#xD;
						UservlanInput.codiciVLAN.CVLAN_ID = attributoAss.valoreAttributo;&#xD;
					}&#xD;
					else if(attributoAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
					{&#xD;
						UservlanInput.flagMulticast = attributoAss.valoreAttributo;&#xD;
					}&#xD;
					else if(attributoAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID&#xD;
						 &amp;&amp; userVlanID.contains(attributoAss.valoreAttributo))&#xD;
					{&#xD;
						daInviare = false;&#xD;
					}&#xD;
					&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//Dalla consistenza vanno inviate SOLO quelle NON presenti nell'ordine, altrimenti abbiamo duplicati&#xD;
			if(daInviare)&#xD;
			{&#xD;
				VerificaCongruenzaAccessoMulticastRequest.uservlan.add(ScriptUtil.copy(UservlanInput));&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_tyW_sshSEeu6G-_mWPnbAw">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
