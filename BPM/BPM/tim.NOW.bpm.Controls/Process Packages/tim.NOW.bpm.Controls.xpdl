        <xpdl2:Activity Id="_UG0-wrrmEeaB_osvccw9kg" Name="VerificaDirezionalit" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Direzionalità">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL DIREZIONALITA: Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var direzionalita = DataUtil.createList();&#xD;
direzionalita.clear();&#xD;
var quantitalinee = &quot;&quot;;&#xD;
quantitalinee = null;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA)&#xD;
			{&#xD;
				direzionalita.add(currentAttDettOrdine.valoreAttributo);&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITALINEE)&#xD;
			{&#xD;
				quantitalinee = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(direzionalita.size() > 0 &amp;&amp; quantitalinee != null)&#xD;
{&#xD;
	var failed = false;&#xD;
	var z = 0;&#xD;
	&#xD;
	while(!failed &amp;&amp; z &lt; direzionalita.size())&#xD;
	{&#xD;
		if(parseInt(direzionalita.get(z), 10) > parseInt(quantitalinee, 10))&#xD;
		{&#xD;
			failed = true;&#xD;
		}&#xD;
		z++;&#xD;
	}&#xD;
	&#xD;
	if(failed)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL DIREZIONALITA fallito: almeno una direzionalita maggiore di quantita linee&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL DIREZIONALITA positivo: tutte le direzionalita minori o uguali a quantita linee&quot;;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
