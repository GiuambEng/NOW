          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_7TsTsnpXEe-gPfaj5dRftg" Width="96.0">
              <xpdl2:Coordinates XCoordinate="402.0" YCoordinate="147.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">jiveDecommissioningInput = com_tim_NOW_xsd_ControlliFormali_Factory.createDecommissioningJive_RequestType();&#xD;
jiveDecommissioningInput.SEDECLIENTE = com_tim_NOW_xsd_ControlliFormali_Factory.createSEDECLIENTEType();&#xD;
&#xD;
if(localRequest != null)&#xD;
{&#xD;
	if(localRequest.lavorazione != null &amp;&amp; localRequest.lavorazione != &quot;&quot;)&#xD;
	{&#xD;
		jiveDecommissioningInput.lavorazione = String(localRequest.lavorazione);&#xD;
	}&#xD;
	if(localRequest.offerta != null &amp;&amp; localRequest.offerta != &quot;&quot;)&#xD;
	{&#xD;
		jiveDecommissioningInput.offertaRichiesta = String(localRequest.offerta);&#xD;
	}&#xD;
	if(localRequest.tipologiaSottolav != null &amp;&amp; localRequest.tipologiaSottolav != &quot;&quot;)&#xD;
	{&#xD;
		jiveDecommissioningInput.tipologiaSottoLav = String(localRequest.tipologiaSottolav); &#xD;
	}&#xD;
	if(localRequest.IDRichiestaOLO != null &amp;&amp; localRequest.IDRichiestaOLO != &quot;&quot;)&#xD;
	{&#xD;
		jiveDecommissioningInput.IDRichiestaOLO = localRequest.IDRichiestaOLO; &#xD;
	}&#xD;
&#xD;
	//MAPPING lAVORAZIONE RICHIESTA&#xD;
	if(LavorazioneRichiesta !=null &amp;&amp; LavorazioneRichiesta.clli4Jive != null &amp;&amp; LavorazioneRichiesta.clli4Jive != &quot;&quot;)&#xD;
	{&#xD;
		jiveDecommissioningInput.clli4Jive = LavorazioneRichiesta.clli4Jive;&#xD;
	}&#xD;
	&#xD;
	//MAPPING DATI SEDE&#xD;
	for(var i = 0;i &lt; localRequest.ordine.sede.size(); i++)&#xD;
	{&#xD;
		var currentSede = localRequest.ordine.sede.get(i);&#xD;
		&#xD;
		if(currentSede.tipologiaSede == it_telecomitalia_it_NOW_casedata_TipologiaSedeEnumeration.SEDECLIENTE)&#xD;
		{	&#xD;
			jiveDecommissioningInput.SEDECLIENTE.particellaToponomastica = currentSede.particellaToponomastica;&#xD;
			jiveDecommissioningInput.SEDECLIENTE.via = currentSede.via;&#xD;
			jiveDecommissioningInput.SEDECLIENTE.civico = currentSede.civico;&#xD;
			jiveDecommissioningInput.SEDECLIENTE.localita = currentSede.localita;&#xD;
			jiveDecommissioningInput.SEDECLIENTE.istatComune = currentSede.codiceISTATComune;&#xD;
			jiveDecommissioningInput.SEDECLIENTE.codiceToponomastica = currentSede.codiceToponomastica;&#xD;
			jiveDecommissioningInput.SEDECLIENTE.CAP = currentSede.CAP;&#xD;
			jiveDecommissioningInput.SEDECLIENTE.provincia = currentSede.provincia;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//MAPPING CONSDATI e CONSFONIA&#xD;
if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.offerta != null &amp;&amp; ConsistenzaDati.offerta != &quot;&quot;)&#xD;
{&#xD;
	jiveDecommissioningInput.offertaConsDati = String(ConsistenzaDati.offerta);&#xD;
}&#xD;
if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.offerta != null &amp;&amp; ConsistenzaFonia.offerta != &quot;&quot;)&#xD;
{&#xD;
	jiveDecommissioningInput.offertaConsFonia = String(ConsistenzaFonia.offerta);&#xD;
}&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
