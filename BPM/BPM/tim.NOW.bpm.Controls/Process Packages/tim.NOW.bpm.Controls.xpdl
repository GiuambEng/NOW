          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var foundCLLICENTRALE = false;&#xD;
var foundBANDA = false;&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLICENTRALE)&#xD;
			{&#xD;
				foundCLLICENTRALE = true;&#xD;
				Process.auditLog(&quot;Trovato attributo CLLICENTRALE&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
			{&#xD;
				foundBANDA = true;&#xD;
				Process.auditLog(&quot;Trovato attributo BANDA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
if(foundCLLICENTRALE &amp;&amp; foundBANDA)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE CAMPI SEDE OLT_C04M01F466 SUPERATO&quot;;&#xD;
}&#xD;
else &#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE CAMPI SEDE OLT_C04M01F466 NON SUPERATO&quot;;&#xD;
}</xpdl2:Script>
