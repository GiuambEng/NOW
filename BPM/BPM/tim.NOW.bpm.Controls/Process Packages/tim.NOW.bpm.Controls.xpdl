        <xpdl2:Activity Id="_IA4nAuhEEeq88usheSrL-A" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">eseguiControllo = false;&#xD;
&#xD;
if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
	||	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN)&#xD;
&amp;&amp; (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONEBANDA&#xD;
	||	localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONECAR&#xD;
	||	localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT))&#xD;
{&#xD;
	eseguiControllo = true;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_305gkehDEeq88usheSrL-A" Width="96.0">
              <xpdl2:Coordinates XCoordinate="179.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_KKCE0uhEEeq88usheSrL-A">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_LA73oehEEeq88usheSrL-A"/>
                  <xpdl2:TransitionRef Id="_OO_IA-hEEeq88usheSrL-A"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="43.0" LaneId="_305gkehDEeq88usheSrL-A" Width="41.0">
              <xpdl2:Coordinates XCoordinate="331.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_LA73oOhEEeq88usheSrL-A" Name="VerificaVariazioniVLAN" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Variazioni VLAN">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo Verifica variazioni VLAN superato&quot;;&#xD;
&#xD;
//Scarto solo per evitare eventuale halted causato da ConsistenzaRaccolta assente&#xD;
if(ConsistenzaRaccolta == null)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Controllo Verifica variazioni VLAN fallito, ConsistenzaRaccolta assente&quot;;&#xD;
	CodiceEsito = &quot;KO_01&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	//RECUPERO IDENTIFICATIVOCOS DALLA CONSISTENZA&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaRaccolta.IDAsset, 10));&#xD;
	var identificativoCOS = &quot;&quot;;&#xD;
	identificativoCOS = null;&#xD;
	&#xD;
	if(AssetRef!= null)&#xD;
	{	&#xD;
		Asset = AssetRef.readAsset();&#xD;
		&#xD;
		var i = 0;&#xD;
	&#xD;
		while(identificativoCOS == null &amp;&amp; i &lt; Asset.dettaglioasset.size())&#xD;
		{&#xD;
			var currentComponente = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
			if(currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
			{&#xD;
				var j = 0;&#xD;
				&#xD;
				while(identificativoCOS == null &amp;&amp; j &lt; currentComponente.attributidettaglioasset.size())&#xD;
				{&#xD;
					var currentAttributo = currentComponente.attributidettaglioasset.get(j);&#xD;
				&#xD;
					if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
					{&#xD;
						identificativoCOS = currentAttributo.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	&#xD;
	// CASO 1&#xD;
	if (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONEBANDA)&#xD;
	{&#xD;
		if((ConsistenzaRaccolta.famigliaVlan == &quot;1&quot; &amp;&amp; (identificativoCOS == &quot;3&quot; || identificativoCOS == &quot;5&quot; || identificativoCOS == &quot;BMC&quot;)) || ConsistenzaRaccolta.famigliaVlan == &quot;2&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Controllo Verifica variazioni VLAN OK, offerta: &quot;+localRequest.offerta+&quot; sottoLav: &quot;+localRequest.tipologiaSottolav+&quot; IDCOScons: &quot;+identificativoCOS;&#xD;
			&#xD;
			// CASO 5&#xD;
			if ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN&#xD;
			  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA) &amp;&amp; ConsistenzaRaccolta.famigliaVlan == &quot;1&quot;)&#xD;
			{&#xD;
				var BANDA = false;&#xD;
				var PROFILOBMC = false;&#xD;
				var i = 0;&#xD;
				&#xD;
				while(i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
				{&#xD;
					var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
					&#xD;
					if(String(currentDettOrdine.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
					{&#xD;
						var j = 0;&#xD;
						&#xD;
						while(!PROFILOBMC &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
						{&#xD;
							var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
							&#xD;
							if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMC)&#xD;
							{&#xD;
								PROFILOBMC = true;&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
					{&#xD;
						var j = 0;&#xD;
						&#xD;
						while(!BANDA &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
						{&#xD;
							var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
							&#xD;
							if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
							{&#xD;
								BANDA = true;&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					i++;&#xD;
				}&#xD;
				&#xD;
				if(((identificativoCOS == &quot;3&quot; || identificativoCOS == &quot;5&quot;) &amp;&amp; !BANDA) || (identificativoCOS == &quot;BMC&quot; &amp;&amp; !PROFILOBMC))&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;Controllo Verifica variazioni VLAN fallito, identificativoCOS: &quot;+identificativoCOS+&quot;, BANDA: &quot;+BANDA+&quot;, PROFILOBMC: &quot;+PROFILOBMC;&#xD;
					CodiceEsito = &quot;KO_02&quot;;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Controllo Verifica variazioni VLAN fallito, offerta: &quot;+localRequest.offerta+&quot; sottoLav: &quot;+localRequest.tipologiaSottolav+&quot; IDCOScons: &quot;+identificativoCOS;&#xD;
			CodiceEsito = &quot;KO_01&quot;;&#xD;
		}&#xD;
	}&#xD;
	// CASO 2 - 4 - 6&#xD;
	else if (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT)&#xD;
	{&#xD;
		var VLANNGA = false;&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA)&#xD;
		{&#xD;
			VLANNGA = true;&#xD;
			var trovatoCAR = false;&#xD;
			var i = 0;&#xD;
			&#xD;
			while(!trovatoCAR &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if(String(currentDettOrdine.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
				{&#xD;
					var j = 0;&#xD;
					&#xD;
					while(!trovatoCAR &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCAR)&#xD;
						{&#xD;
							trovatoCAR = true;&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//CASO 2 (+ FamigliaVLAN 3 e NGA)&#xD;
		if((ConsistenzaRaccolta.famigliaVlan == &quot;1&quot; &amp;&amp; (identificativoCOS == &quot;0&quot; || identificativoCOS == &quot;1&quot; || identificativoCOS == &quot;3&quot; || identificativoCOS == &quot;5&quot; || identificativoCOS == &quot;BMC&quot;))&#xD;
			|| ConsistenzaRaccolta.famigliaVlan == &quot;2&quot;&#xD;
			|| (ConsistenzaRaccolta.famigliaVlan == &quot;3&quot; &amp;&amp; VLANNGA))&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Controllo Verifica variazioni VLAN OK, offerta: &quot;+localRequest.offerta+&quot; sottoLav: &quot;+localRequest.tipologiaSottolav+&quot; IDCOScons: &quot;+identificativoCOS;&#xD;
			&#xD;
			//Bug #33497: i casi 4 e 6 vanno fatti sono per VLANNGA&#xD;
			if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA)&#xD;
			{&#xD;
				// CASO 4&#xD;
				if((identificativoCOS == &quot;0&quot; || identificativoCOS == &quot;1&quot; || ConsistenzaRaccolta.famigliaVlan == &quot;2&quot; || ConsistenzaRaccolta.famigliaVlan == &quot;3&quot;)&#xD;
				&amp;&amp; !trovatoCAR)&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;Controllo Verifica variazioni VLAN fallito, CAR non trovato in input&quot;;&#xD;
					CodiceEsito = &quot;KO_02&quot;;&#xD;
				}&#xD;
				// CASO 6&#xD;
				else if((identificativoCOS == &quot;3&quot; || identificativoCOS == &quot;5&quot;)&#xD;
				&amp;&amp; ConsistenzaRaccolta.famigliaVlan == &quot;1&quot;&#xD;
				&amp;&amp; trovatoCAR)&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;Controllo Verifica variazioni VLAN fallito, CAR trovato in INPU con IDENTIFICATIVOCOS 3 o 5&quot;;&#xD;
					CodiceEsito = &quot;KO_02&quot;;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Controllo Verifica variazioni VLAN fallito, offerta: &quot;+localRequest.offerta+&quot; sottoLav: &quot;+localRequest.tipologiaSottolav+&quot; IDCOScons: &quot;+identificativoCOS;&#xD;
			CodiceEsito = &quot;KO_01&quot;;&#xD;
		}&#xD;
	}&#xD;
	// CASO 3&#xD;
	else if (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONECAR)&#xD;
	{&#xD;
		if((ConsistenzaRaccolta.famigliaVlan == &quot;1&quot; &amp;&amp; (identificativoCOS == &quot;0&quot; || identificativoCOS == &quot;1&quot; || identificativoCOS == &quot;BMC&quot;))&#xD;
			|| ConsistenzaRaccolta.famigliaVlan == &quot;2&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Controllo Verifica variazioni VLAN OK, offerta: &quot;+localRequest.offerta+&quot; sottoLav: &quot;+localRequest.tipologiaSottolav+&quot; IDCOScons: &quot;+identificativoCOS;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Controllo Verifica variazioni VLAN fallito, offerta: &quot;+localRequest.offerta+&quot; sottoLav: &quot;+localRequest.tipologiaSottolav+&quot; IDCOScons: &quot;+identificativoCOS;&#xD;
			CodiceEsito = &quot;KO_01&quot;;&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
