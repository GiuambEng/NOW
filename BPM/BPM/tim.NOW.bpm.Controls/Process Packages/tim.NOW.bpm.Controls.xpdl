            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaDisaggregazioneVULARequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaDisaggregazioneVula_RequestType();&#xD;
&#xD;
VerificaDisaggregazioneVULARequest.codOLOAgcom = localRequest.codificaOLOAGCOM;&#xD;
VerificaDisaggregazioneVULARequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaDisaggregazioneVULARequest.dataInvioRichiesta = localRequest.dataInvioRichiesta;&#xD;
&#xD;
var foundSvlancode = false;&#xD;
var i=0;&#xD;
&#xD;
while(!foundSvlancode &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	//Svlancode della prima USERVLAN&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
	{&#xD;
		var k=0;&#xD;
		&#xD;
		while(!foundSvlancode &amp;&amp; k&lt;componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
			{&#xD;
				foundSvlancode = true;&#xD;
				VerificaDisaggregazioneVULARequest.svlanCode = attributo.valoreAttributo;&#xD;
				 &#xD;
				Process.auditLog(&quot;Trovato attributo &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			k++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}</xpdExt:Information>
