            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">verificaVlanDRGInput = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaVLANcaratterizzateDRGOPZIONEZERO_RequestType();&#xD;
&#xD;
if(localRequest != null)&#xD;
{	&#xD;
	verificaVlanDRGInput.lavorazione = String(localRequest.lavorazione);&#xD;
	verificaVlanDRGInput.offerta = String(localRequest.offerta);&#xD;
	verificaVlanDRGInput.IDRichiestaOLO = localRequest.IDRichiestaOLO; &#xD;
}&#xD;
&#xD;
//MAPPING CONSRACCOLTA&#xD;
if(ConsistenzaRaccolta != null &amp;&amp; ConsistenzaRaccolta.caratteristicaVlan != null &amp;&amp; ConsistenzaRaccolta.caratteristicaVlan != &quot;&quot;)&#xD;
{&#xD;
	verificaVlanDRGInput.caratterizzazioneCARcons = ConsistenzaRaccolta.caratteristicaVlan;&#xD;
}&#xD;
&#xD;
//MAPPING LAVORAZIONE RICHIESTA&#xD;
if(LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.caratteristicaVlan != null &amp;&amp; LavorazioneRichiesta.caratteristicaVlan != &quot;&quot;)&#xD;
{&#xD;
	verificaVlanDRGInput.caratterizzazioneCARric = LavorazioneRichiesta.caratteristicaVlan;&#xD;
}&#xD;
&#xD;
//RU_1627:MAPPING FLAGPNRRDRGZERO da Asset&#xD;
if(ConsistenzaRaccolta != null &amp;&amp; ConsistenzaRaccolta.IDAsset != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaRaccolta.IDAsset, 10));&#xD;
&#xD;
	if(AssetRef!= null)&#xD;
	{	&#xD;
		Asset = AssetRef.readAsset();&#xD;
		&#xD;
		for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var currentComponente = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
			if(String(currentComponente.nomeComponente).slice(0,6) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for(var j=0; j&lt;currentComponente.attributidettaglioasset.size(); j++)&#xD;
				{&#xD;
					var currentAttributo = currentComponente.attributidettaglioasset.get(j);&#xD;
				&#xD;
					if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGPNRRDRGZERO)&#xD;
					{&#xD;
						verificaVlanDRGInput.FLAGPNRRDRGZERO = currentAttributo.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
</xpdExt:Information>
