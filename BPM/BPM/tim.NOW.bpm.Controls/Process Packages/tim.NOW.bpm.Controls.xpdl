    <xpdl2:WorkflowProcess Id="_a-2s0P1EEeWEXoIZeVGhKA" xpdExt:XpdModelType="ServiceProcess" xpdExt:DisplayName="CTRL DATI SEDE" Name="CTRLDATISEDE">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_UxMioOeiEeaXVo2ZLnujQA" xpdExt:DisplayName="ProcessIdentifier" Name="ProcessIdentifier">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>500</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_UxMioeeiEeaXVo2ZLnujQA" xpdExt:DisplayName="CodiceEsito" Name="CodiceEsito">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_a-_2wf1EEeWEXoIZeVGhKA" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
