          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTO&#xD;
&amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
