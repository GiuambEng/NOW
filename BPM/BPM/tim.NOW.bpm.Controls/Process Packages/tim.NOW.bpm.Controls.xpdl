            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ValorizzazioneOpzTrafficoRequest = com_tim_NOW_xsd_ControlliAmmessiNP_Factory.createVerificaValorizzazioneOpzTrafficoNPNG_RequestType();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	ValorizzazioneOpzTrafficoRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	ValorizzazioneOpzTrafficoRequest.lavorazione = String(localRequest.lavorazione);&#xD;
	ValorizzazioneOpzTrafficoRequest.offerta = String(localRequest.offerta);&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPZIONETRAFFICO)&#xD;
				{&#xD;
					ValorizzazioneOpzTrafficoRequest.opzioneTraffico = attributo.valoreAttributo;			&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
}</xpdExt:Information>
