        <xpdl2:Activity Id="_a5TX8pCMEeuePPUoZ8ncDg" Name="VerificaDoppiaDesospensione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Doppia Desospensione" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL DOPPIA DESOSPENSIONE C04M01F464 superato&quot;;&#xD;
&#xD;
//RICERCA ALTRO ORDINE DI DESOSPENSIONE&#xD;
var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;codiceOrdineTITarget =: Codice AND IDRichiestaOLO &lt;>: PVM AND lavorazione = 'INTERRUZIONESOSPENSIONE' AND statoRichiestaNOW NOT IN ('CHIUSO','SCARTATO') AND created&lt;:currentDate&quot;);&#xD;
criteria.setQueryParameter(&quot;Codice&quot;,localRequest.codiceOrdineTITarget);&#xD;
criteria.setQueryParameter(&quot;PVM&quot;,localRequest.IDRichiestaOLO);&#xD;
criteria.setQueryParameter(&quot;currentDate&quot;,localRequest.created);&#xD;
&#xD;
result = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
if(result != null &amp;&amp; result.size()>0)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DOPPIA DESOSPENSIONE C04M01F464 fallito. Trovato numero di richieste di InterruzioneSospensione:&quot; + String(result.size());&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
