            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_WGRXUvmhEeWxfZ79Ifv7Eg" Width="96.0">
              <xpdl2:Coordinates XCoordinate="379.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
