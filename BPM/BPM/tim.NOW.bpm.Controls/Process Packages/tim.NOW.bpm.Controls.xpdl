        <xpdl2:Activity Id="_P8aocIVfEeavyMWeDZ6E9A" Name="CheckPrecondizioni" xpdExt:Visibility="Private" xpdExt:DisplayName="CheckPrecondizioni">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript"> EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType(); &#xD;
 EsitoResponse.codice = true;&#xD;
 EsitoResponse.descrizione =&quot;precondizioni non rispettate&quot;;&#xD;
 &#xD;
 PrecondizioneSuperata = (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
 							|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT);&#xD;
 &#xD;
 &#xD;
 &#xD;
 if(PrecondizioneSuperata){&#xD;
 	&#xD;
 	var trovataBandaCondivisa = false;&#xD;
 	var trovataConsegna = false;&#xD;
 	if(localRequest.ordine != null){&#xD;
 		var i=0;&#xD;
 		while(!trovataBandaCondivisa &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
 			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
 			var j=0;&#xD;
 			while(!trovataBandaCondivisa &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size()){&#xD;
 				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
 				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDACONSEGNA){&#xD;
 					trovataConsegna =true;&#xD;
 					trovataBandaCondivisa = attributo.valoreAttributo.toUpperCase() == &quot;CONDIVISA&quot;;&#xD;
 					Process.auditLog(&quot;TIPOBANDACONSEGNA: &quot;+ attributo.valoreAttributo);&#xD;
 				}&#xD;
 				j++;&#xD;
 			}&#xD;
 			i++;&#xD;
 		}&#xD;
 	&#xD;
 	}&#xD;
 	&#xD;
 	&#xD;
 	PrecondizioneSuperata= trovataBandaCondivisa;&#xD;
 	&#xD;
 	&#xD;
&#xD;
 }</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
