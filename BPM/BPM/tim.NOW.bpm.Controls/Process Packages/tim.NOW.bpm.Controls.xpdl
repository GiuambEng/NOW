        <xpdl2:Activity Id="_E1a2UVJQEeafMOVsQ226Vw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_6d5o4FJPEeafMOVsQ226Vw" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="52.0" LaneId="_isgxgjL5EeajbIG7R_HFFQ" Width="73.0">
              <xpdl2:Coordinates XCoordinate="63.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_0B8QcBZYEei3_b_XX6_YRw" Name="Precondizioni" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizioni" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = true;&#xD;
&#xD;
&#xD;
if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
&#xD;
{&#xD;
	var foundDSLAM = false;&#xD;
	var foundKIT = false;&#xD;
	&#xD;
	var foundIncrementoVC = false;&#xD;
	&#xD;
	var i=0;&#xD;
	&#xD;
	while ((!foundDSLAM || !foundKIT || !foundIncrementoVC) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
		{&#xD;
			if (currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
			{&#xD;
				foundIncrementoVC = true;&#xD;
			}&#xD;
			&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPDSLAM)&#xD;
				{&#xD;
					foundDSLAM= true;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPKIT)&#xD;
				{&#xD;
					foundKIT=true;&#xD;
				}&#xD;
			}&#xD;
		&#xD;
		}&#xD;
&#xD;
	&#xD;
	i++;&#xD;
	}&#xD;
	&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &#xD;
	&amp;&amp; !foundIncrementoVC )&#xD;
	{&#xD;
		EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
		EseguiControllo=false;&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Controllo skippato - Non trovato incremento VC&quot;;&#xD;
	}	&#xD;
	&#xD;
	else if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC&#xD;
			&amp;&amp; !foundDSLAM &amp;&amp; !foundKIT)&#xD;
	{&#xD;
		EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
		EseguiControllo=false;&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Controllo skippato - Nessun VC per cui sono specificati IPDLAM - IPKIT&quot;;&#xD;
	}&#xD;
	&#xD;
	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
