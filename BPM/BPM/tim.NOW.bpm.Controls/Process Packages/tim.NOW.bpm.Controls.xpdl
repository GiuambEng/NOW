          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if (DeterminaCluster_Response != null)&#xD;
{&#xD;
//var foundCodiceCluser = false;&#xD;
var foundTipologiaCluster = false;&#xD;
&#xD;
/* // RU_964 - eliminata valorizzazione CODICE CLUSTER&#xD;
//verifico se servizio ha restituito codice cluster&#xD;
if (DeterminaCluster_Response.codiceCluster != null &amp;&amp; DeterminaCluster_Response.codiceCluster != &quot;&quot;)&#xD;
	{&#xD;
		for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
			{&#xD;
				//se già presente nell'ordine lo sovrascrivo&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var x = 0;&#xD;
					while(!foundCodiceCluser &amp;&amp; x &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(x);&#xD;
						if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLUSTER)&#xD;
						{&#xD;
							foundCodiceCluser = true;&#xD;
							currentAttributo.valoreAttributo = DeterminaCluster_Response.codiceCluster;&#xD;
						}&#xD;
					x++;&#xD;
					}&#xD;
					// se non presente nell'ordine lo aggiungo&#xD;
					if(!foundCodiceCluser)&#xD;
					{&#xD;
						var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
						nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLUSTER;&#xD;
						nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						nuovoAttributo.valoreAttributo = DeterminaCluster_Response.codiceCluster;&#xD;
						nuovoAttributo.operatore = localRequest.operatore;&#xD;
						currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
	}&#xD;
*/&#xD;
&#xD;
&#xD;
//verifico se servizio ha restituito tipologia cluster&#xD;
if (DeterminaCluster_Response.tipologiaClusterComune != null &amp;&amp; DeterminaCluster_Response.tipologiaClusterComune != &quot;&quot;)&#xD;
	{&#xD;
		for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
			{&#xD;
				//se già presente nell'ordine lo sovrascrivo&#xD;
				// SM_9404: in alcune VARIAZIONI l'accesso viene creato nei controlli formali, quindi in questo punto non c'è. Per non perderci tipologiaclustercomune viene mappato quindi anche in output dal controllo. &#xD;
				// Per i casi standard invece viene eseguita la logica sottostante. &#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var x = 0;&#xD;
					while(!foundTipologiaCluster &amp;&amp; x &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(x);&#xD;
						if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE)&#xD;
						{&#xD;
							foundTipologiaCluster = true;&#xD;
							currentAttributo.valoreAttributo = DeterminaCluster_Response.tipologiaClusterComune;&#xD;
						}&#xD;
					x++;&#xD;
					}&#xD;
					// se non presente nell'ordine lo aggiungo&#xD;
					if(!foundTipologiaCluster)&#xD;
					{&#xD;
						var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
						nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERCOMUNE;&#xD;
						nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						nuovoAttributo.valoreAttributo = DeterminaCluster_Response.tipologiaClusterComune;&#xD;
						nuovoAttributo.operatore = localRequest.operatore;&#xD;
						currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
	}&#xD;
	&#xD;
	//RU_1535&#xD;
	if(DeterminaCluster_Response.versioningClusterComune != null &amp;&amp; DeterminaCluster_Response.versioningClusterComune != &quot;&quot;&#xD;
	   &amp;&amp; localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
	{&#xD;
	 	localRequest.ordine.versioningClusterComune = DeterminaCluster_Response.versioningClusterComune;&#xD;
	}&#xD;
&#xD;
}&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">// Create target 'DeterminaCluster_Request' if it doesn't exist.
if (DeterminaCluster_Request == null) 
{
    DeterminaCluster_Request = com_tim_NOW_xsd_ControlliFormali_Factory.createDeterminaCluster_RequestType();
}

if(ConsistenzaDati != null)
{
	DeterminaCluster_Request.idAssetDati = ScriptUtil.createBigInteger(ConsistenzaDati.IDAsset);
}

if(ConsistenzaFoniaOp != null)
{
	DeterminaCluster_Request.idAssetFonia = ScriptUtil.createBigInteger(ConsistenzaFoniaOp.IDAsset);
}

DeterminaCluster_Request.dro = localRequest.DRO; // RU_964
DeterminaCluster_Request.offerta = String(localRequest.offerta);
DeterminaCluster_Request.idRichiesta = String(localRequest.IDRichiestaOLO);
DeterminaCluster_Request.istatComune = localRequest.ISTATComune;
DeterminaCluster_Request.lavorazione = String(localRequest.lavorazione);
DeterminaCluster_Request.sottoLavorazione = String(localRequest.tipologiaSottolav);
DeterminaCluster_Request.flagMigDel82 = localRequest.flagMigDel82; //RU_1546

if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)
{
	var k = 0;
	var j = 0;

	while(k &lt; localRequest.ordine.dettaglioordine.size())
	{
		var DettaglioOrdine = localRequest.ordine.dettaglioordine.get(k);
		
		if(String(DettaglioOrdine.nomeComponente).slice(0,7) == 'ACCESSO')
		{
			j = 0;
			
			while(j &lt; DettaglioOrdine.attributiDettaglioOrdine.size())
			{
				var AttributoDettaglioOrdine = DettaglioOrdine.attributiDettaglioOrdine.get(j);
				
				if(AttributoDettaglioOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)
				{
					DeterminaCluster_Request.tipoLinea = String(AttributoDettaglioOrdine.valoreAttributo);
				}
				
				j++;
			}
		}
		k++;
	}
}


</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
