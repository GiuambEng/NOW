        <xpdl2:Activity Id="_c0kBkObxEeaxQfG7SqNjEg" Name="RecuperaEsito" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupera Esito">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_VPkP4OYREeah1rpc5fLt3w" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping Direction="IN" Formal="scenario">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.tipologiaScenario</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="offerta">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.offerta</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="lavorazione">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.lavorazione</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="esitoControllo">
                  <xpdl2:Actual ScriptGrammar="JavaScript">CodiceEsito</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="IDRichiestaOLO">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="codiceControllo">
                  <xpdExt:ScriptInformation Id="_PFYp4ObzEeaxQfG7SqNjEg" Name="codiceControllo">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;CTRL DESTINAZIONE USO&quot;;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="isPacchetto">
                  <xpdExt:ScriptInformation Id="_UNQioObzEeaxQfG7SqNjEg" Name="isPacchetto">
                    <xpdExt:Expression ScriptGrammar="JavaScript"/>
                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var isPacchetto = false;&#xD;
&#xD;
if(localRequest.ordine.codicePacchettoNOW != null)&#xD;
{&#xD;
	isPacchetto = true;&#xD;
}&#xD;
