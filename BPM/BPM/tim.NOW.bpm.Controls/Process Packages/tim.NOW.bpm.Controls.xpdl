            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="43.0" LaneId="_KC2AQSqfEeyZQsnNZArMFQ" Width="41.0">
              <xpdl2:Coordinates XCoordinate="181.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_VWA9oiqfEeyZQsnNZArMFQ" Name="VerificaCongruenzaProfiloTecnicoperVariazionieMigrazioni" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Congruenza Profilo Tecnico per Variazioni e Migrazioni">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL CONGRUENZA PROFILO TECNICO VAR MIG_C04M01F485 SUPERATO&quot;;&#xD;
&#xD;
var ProfiloTecnicoLineaOrdine = &quot;&quot;;&#xD;
ProfiloTecnicoLineaOrdine = null;&#xD;
&#xD;
var i=0;&#xD;
&#xD;
while(ProfiloTecnicoLineaOrdine == null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j=0;&#xD;
		&#xD;
		while(ProfiloTecnicoLineaOrdine == null &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
			{&#xD;
				ProfiloTecnicoLineaOrdine = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo PROFILOTECNICOLINEA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
//VARIAZIONE RICONFIGURAZIONE ACCESSO&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{		&#xD;
	if(ProfiloTecnicoLineaOrdine == &quot;X1&quot; || ProfiloTecnicoLineaOrdine == &quot;X2&quot;)&#xD;
	{&#xD;
		if(ConsistenzaDati.profiloTecnicoLinea != &quot;X1&quot;&#xD;
	    &amp;&amp; ConsistenzaDati.profiloTecnicoLinea != &quot;X2&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE FALLITO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, profilo consistenza &quot;+ConsistenzaDati.profiloTecnicoLinea;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE SUPERATO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, profilo consistenza &quot;+ConsistenzaDati.profiloTecnicoLinea;&#xD;
		}&#xD;
	}&#xD;
	else if(ProfiloTecnicoLineaOrdine == &quot;Z6&quot; || ProfiloTecnicoLineaOrdine == &quot;Z7&quot; || ProfiloTecnicoLineaOrdine == &quot;Z8&quot;)&#xD;
	{&#xD;
		if(ConsistenzaDati.profiloTecnicoLinea != &quot;Z1&quot;&#xD;
	    &amp;&amp; ConsistenzaDati.profiloTecnicoLinea != &quot;Z2&quot;&#xD;
		&amp;&amp; ConsistenzaDati.profiloTecnicoLinea != &quot;Z3&quot;&#xD;
		&amp;&amp; ConsistenzaDati.profiloTecnicoLinea != &quot;Z4&quot;&#xD;
		&amp;&amp; ConsistenzaDati.profiloTecnicoLinea != &quot;Z5&quot;&#xD;
		&amp;&amp; ConsistenzaDati.profiloTecnicoLinea != &quot;Z6&quot;&#xD;
		&amp;&amp; ConsistenzaDati.profiloTecnicoLinea != &quot;Z7&quot;&#xD;
		&amp;&amp; ConsistenzaDati.profiloTecnicoLinea != &quot;Z8&quot;&#xD;
		&amp;&amp; ConsistenzaDati.profiloTecnicoLinea != &quot;Z9&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE FALLITO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, profilo consistenza &quot;+ConsistenzaDati.profiloTecnicoLinea;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE SUPERATO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, profilo consistenza &quot;+ConsistenzaDati.profiloTecnicoLinea;&#xD;
		}&#xD;
	}&#xD;
	else if(ProfiloTecnicoLineaOrdine == &quot;Z9&quot;)&#xD;
	{&#xD;
		if(ConsistenzaDati.profiloTecnicoLinea != &quot;Z9&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE FALLITO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, profilo consistenza &quot;+ConsistenzaDati.profiloTecnicoLinea;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE SUPERATO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, profilo consistenza &quot;+ConsistenzaDati.profiloTecnicoLinea;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
//MIGRAZIONE/ATTIVAZIONE CAMBIO TECNOLOGIA&#xD;
else&#xD;
{&#xD;
	if(ProfiloTecnicoLineaOrdine == &quot;X1&quot; || ProfiloTecnicoLineaOrdine == &quot;X2&quot;)&#xD;
	{&#xD;
		if(ConsistenzaDati.profiloTecnicoLinea != &quot;X1&quot;&#xD;
	    &amp;&amp; ConsistenzaDati.profiloTecnicoLinea != &quot;X2&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE FALLITO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, profilo consistenza &quot;+ConsistenzaDati.profiloTecnicoLinea;&#xD;
		}&#xD;
		else if(ConsistenzaDati.offerta != it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPNGAFTTH&#xD;
			 &amp;&amp; ConsistenzaDati.offerta != it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULAFTTH&#xD;
			 &amp;&amp; ConsistenzaDati.offerta != it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
			 &amp;&amp; ConsistenzaDati.offerta != it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
			 &amp;&amp; ConsistenzaDati.offerta != it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
			 &amp;&amp; ConsistenzaDati.offerta != it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIVULAFTTH)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE FALLITO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, offerta Consistenza &quot;+ConsistenzaDati.offerta;&#xD;
		}&#xD;
		else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH)&#xD;
		{	&#xD;
			if(ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
			|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
			|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIVULAFTTH)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE FALLITO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, offerta richiesta &quot;+localRequest.offerta+&quot;, offerta consistenza &quot;+ConsistenzaDati.offerta;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE SUPERATO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, offerta richiesta &quot;+localRequest.offerta+&quot;, offerta consistenza &quot;+ConsistenzaDati.offerta;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE FALLITO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, offerta richiesta &quot;+localRequest.offerta+&quot;, offerta consistenza &quot;+ConsistenzaDati.offerta;&#xD;
		}&#xD;
	}&#xD;
	else if(ProfiloTecnicoLineaOrdine == &quot;Z9&quot;)&#xD;
	{&#xD;
		if(ConsistenzaDati.profiloTecnicoLinea == &quot;X1&quot;&#xD;
	    || ConsistenzaDati.profiloTecnicoLinea == &quot;X2&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE FALLITO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, profilo consistenza &quot;+ConsistenzaDati.profiloTecnicoLinea;&#xD;
		}&#xD;
		// NON è una MIGRAZIONE EXTRA OAO ONE STEP&#xD;
		// NON è un' ATTIVAZIONE CAMBIO TECNOLOGIA ONE STEP&#xD;
		else if(!((OneStep == &quot;SI&quot;|| OneStep == &quot;Y&quot;) &#xD;
				&amp;&amp; (localRequest.codificaOLOAGCOM != ConsistenzaDati.codificaOLOAGCOMDonating&#xD;
					|| (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
					 &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA)))&#xD;
			 &amp;&amp; (ConsistenzaDati.profiloTecnicoLinea == &quot;Z1&quot;&#xD;
			     || ConsistenzaDati.profiloTecnicoLinea == &quot;Z2&quot;&#xD;
			     || ConsistenzaDati.profiloTecnicoLinea == &quot;Z3&quot;&#xD;
			     || ConsistenzaDati.profiloTecnicoLinea == &quot;Z4&quot;&#xD;
			     || ConsistenzaDati.profiloTecnicoLinea == &quot;Z5&quot;&#xD;
			     || ConsistenzaDati.profiloTecnicoLinea == &quot;Z6&quot;&#xD;
			     || ConsistenzaDati.profiloTecnicoLinea == &quot;Z7&quot;&#xD;
			     || ConsistenzaDati.profiloTecnicoLinea == &quot;Z8&quot;))&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE FALLITO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, profilo consistenza &quot;+ConsistenzaDati.profiloTecnicoLinea;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE FALLITO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, profilo consistenza &quot;+ConsistenzaDati.profiloTecnicoLinea;&#xD;
		}&#xD;
	}&#xD;
	else if(ProfiloTecnicoLineaOrdine == &quot;Z6&quot; || ProfiloTecnicoLineaOrdine == &quot;Z7&quot; || ProfiloTecnicoLineaOrdine == &quot;Z8&quot;)&#xD;
	{&#xD;
		if(ConsistenzaDati.profiloTecnicoLinea == &quot;X1&quot;&#xD;
	    || ConsistenzaDati.profiloTecnicoLinea == &quot;X2&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE FALLITO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, profilo consistenza &quot;+ConsistenzaDati.profiloTecnicoLinea;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL_CONGR_PROFILO VARIAZIONE FALLITO: profilo ordine &quot;+ProfiloTecnicoLineaOrdine+&quot;, profilo consistenza &quot;+ConsistenzaDati.profiloTecnicoLinea;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
