            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_7Qlo0j69EeuQMcABpMloqg" Name="Verificacongruenza" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica congruenza" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Verifica congruenza CC_LIB, FTTH Only, Supermacroarea VLAN C04M01F460 fallito&quot;;&#xD;
&#xD;
var SUPERMACROAREA = &quot;&quot;;&#xD;
var TIPOLOGIACLUSTERVLAN = &quot;&quot;;&#xD;
var FTTHONLY = &quot;&quot;;&#xD;
SUPERMACROAREA = null;&#xD;
TIPOLOGIACLUSTERVLAN = null;&#xD;
FTTHONLY = null;&#xD;
&#xD;
if(LavorazioneRichiesta != null)&#xD;
{&#xD;
&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA)&#xD;
				{&#xD;
					SUPERMACROAREA = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo SUPERMACROAREA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);	&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN)&#xD;
				{&#xD;
					TIPOLOGIACLUSTERVLAN = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo TIPOLOGIACLUSTERVLAN&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);	&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FTTHONLY)&#xD;
				{&#xD;
					FTTHONLY = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo FTTHONLY&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);	&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
		&amp;&amp; (!((TIPOLOGIACLUSTERVLAN == null || TIPOLOGIACLUSTERVLAN == &quot;CC&quot; || TIPOLOGIACLUSTERVLAN == &quot;LIB&quot;) &amp;&amp; FTTHONLY == &quot;Y&quot; &amp;&amp; (SUPERMACROAREA == &quot;0&quot; || SUPERMACROAREA == &quot;1&quot; || SUPERMACROAREA == &quot;2&quot; || SUPERMACROAREA == &quot;3&quot;))    //CASI 1 e 3  &#xD;
		   || !((TIPOLOGIACLUSTERVLAN == &quot;CC&quot; || TIPOLOGIACLUSTERVLAN == &quot;LIB&quot;) &amp;&amp; FTTHONLY == null &amp;&amp; (SUPERMACROAREA == &quot;1&quot; || SUPERMACROAREA == &quot;2&quot; || SUPERMACROAREA == &quot;3&quot;))    //CASO 2&#xD;
		   || (TIPOLOGIACLUSTERVLAN == null &amp;&amp; FTTHONLY == null &amp;&amp; (SUPERMACROAREA == &quot;0&quot; || SUPERMACROAREA == &quot;1&quot; || SUPERMACROAREA == &quot;2&quot; || SUPERMACROAREA == &quot;3&quot;) &amp;&amp; LavorazioneRichiesta.idKitAreaCar != null)    //CASO 4&#xD;
		   || ((TIPOLOGIACLUSTERVLAN == &quot;CC&quot; || TIPOLOGIACLUSTERVLAN == &quot;LIB&quot;) &amp;&amp; FTTHONLY == null &amp;&amp; SUPERMACROAREA == &quot;0&quot; &amp;&amp; LavorazioneRichiesta.idKitAreaCar != null)))  //CASI 5 e 6&#xD;
	   ||(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
	      &amp;&amp; !((TIPOLOGIACLUSTERVLAN == &quot;CC&quot; || TIPOLOGIACLUSTERVLAN == &quot;LIB&quot;) &amp;&amp; (SUPERMACROAREA == &quot;1&quot; || SUPERMACROAREA == &quot;2&quot; || SUPERMACROAREA == &quot;3&quot;))))      //RU_1135: aggiunta negazione &quot;!&quot; nelle condizioni&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Verifica congruenza CC_LIB, FTTH Only, Supermacroarea VLAN C04M01F460 fallito superato&quot;;&#xD;
	}&#xD;
&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
