        <xpdl2:Activity Id="_meNvsFSyEeaSAMniIKUOuA" Name="PrecondizioneFallita" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione Fallita">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo ESISTENZA VP saltato per precondizione: nessuna TIPOBANDACONSEGNA CONDIVISA trovata.&quot;;&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_AYA0ESQzEeapHu3Fp2ifqw" Width="227.0">
              <xpdl2:Coordinates XCoordinate="492.0" YCoordinate="111.0"/>
            </xpdl2:NodeGraphicsInfo>
