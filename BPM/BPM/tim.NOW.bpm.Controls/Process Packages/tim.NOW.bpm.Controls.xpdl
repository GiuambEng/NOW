        <xpdl2:Activity Id="_zihw8j69EeuQMcABpMloqg" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = false;&#xD;
&#xD;
//ATTIVAZIONE&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
   &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
{&#xD;
	var famigliaVlan = &quot;&quot;;&#xD;
	famigliaVlan = null;&#xD;
	var IdentificativoCos = &quot;&quot;;&#xD;
	IdentificativoCos = null;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
				{&#xD;
					famigliaVlan = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo FAMIGLIAVLAN&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);	&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	if(famigliaVlan == &quot;1&quot;)&#xD;
	{&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
					{&#xD;
						Process.auditLog(&quot;Trovato attributo IDENTIFICATIVOCOS&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);	&#xD;
						IdentificativoCos = attributo.valoreAttributo;	&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	if((famigliaVlan == &quot;1&quot; &amp;&amp; (IdentificativoCos == &quot;0&quot; || IdentificativoCos == &quot;1&quot;)) || famigliaVlan == &quot;2&quot; || famigliaVlan == &quot;3&quot;)&#xD;
	{&#xD;
		EseguiControllo = true;&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
//VARIAZIONE&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
       &amp;&amp;(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT&#xD;
          ||localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONECAR)&#xD;
	   &amp;&amp; ConsistenzaRaccolta != null)&#xD;
{&#xD;
	var IdentificativoCosCONS = &quot;&quot;;&#xD;
	IdentificativoCosCONS = null;&#xD;
	&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaRaccolta.IDAsset, 10));&#xD;
	Asset = AssetRef.readAsset();&#xD;
&#xD;
	if(Asset != null &amp;&amp; Asset.dettaglioasset != null &amp;&amp; ConsistenzaRaccolta.famigliaVlan == &quot;1&quot;)&#xD;
	{&#xD;
		for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var componenteAsset = Asset.dettaglioasset.get(i); &#xD;
			&#xD;
			if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
			{&#xD;
				for(var j=0; j&lt;componenteAsset.attributidettaglioasset.size(); j++)&#xD;
				{&#xD;
					var attributoAsset = componenteAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
					{&#xD;
						Process.auditLog(&quot;Trovato attributo IDENTIFICATIVOCOS&quot;+ attributoAsset.valoreAttributo +&quot; su componente con IDDett &quot;+componenteAsset.IDDettaglioAsset);&#xD;
						IdentificativoCosCONS = attributoAsset.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if((ConsistenzaRaccolta.famigliaVlan == &quot;1&quot; &amp;&amp; (IdentificativoCosCONS == &quot;0&quot; || IdentificativoCosCONS == &quot;1&quot;)) || ConsistenzaRaccolta.famigliaVlan == &quot;2&quot; || ConsistenzaRaccolta.famigliaVlan == &quot;3&quot;)&#xD;
	{&#xD;
		EseguiControllo = true;&#xD;
	}&#xD;
	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="63.0" LaneId="_XoH7kT69EeuQMcABpMloqg" Width="117.0">
              <xpdl2:Coordinates XCoordinate="193.0" YCoordinate="175.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
