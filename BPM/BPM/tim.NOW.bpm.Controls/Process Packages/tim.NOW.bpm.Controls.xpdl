        <xpdl2:Activity Id="_oYbgMga_EeaaXcIacC0_2w" Name="DataAppuntamentoDaOa" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Data Appuntamento Da Oa">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var foundDataAppuntamento = false;&#xD;
&#xD;
if(targetRequest != null &amp;&amp; targetRequest.ordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!foundDataAppuntamento &amp;&amp; i &lt; targetRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = targetRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAPPUNTAMENTO)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(!foundDataAppuntamento &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAAPPUNTAMENTO)&#xD;
				{&#xD;
					foundDataAppuntamento = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	//SM_10773 Aggiunte condizioni in OR sulla presenza di DADRimodulata, DAD e DUA&#xD;
	if(foundDataAppuntamento || targetRequest.ordine.DADRimodulata != null || targetRequest.ordine.DAD != null &#xD;
		|| targetRequest.ordine.DUA != null)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL DATA APPUNTAMENTO DA OA Successful&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL DATA APPUNTAMENTO DA OA Failed : Record for specified codiceOrdineOLO does not contain required nomeComponente &amp; nomeAttributo&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DATA APPUNTAMENTO DA OA Failed : No record found for specified codiceOrdineOLO&quot;;&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
/*var localCodiceOrdineOlo = localRequest.ordine.codiceOrdineOLO;&#xD;
