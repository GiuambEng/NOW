            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:Performers>
            <xpdl2:Performer>_YHMjsCMWEea7qJ_CMNwz5w</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="82.0" LaneId="_-oFrASPkEeaPieZ5iwuzWQ" Width="119.0">
              <xpdl2:Coordinates XCoordinate="684.0" YCoordinate="210.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaSommaBandePiccoRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaSommaBandePiccoRequest();&#xD;
&#xD;
if(localRequest.offerta != null)&#xD;
{&#xD;
	VerificaSommaBandePiccoRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
}&#xD;
&#xD;
//RU_1150&#xD;
VerificaSommaBandePiccoRequest.idRichiesta = localRequest.IDRichiestaOLO;&#xD;
&#xD;
//PROFILO TECNICO LINEA RICHIESTA&#xD;
var i = 0;&#xD;
while(VerificaSommaBandePiccoRequest.profiloTecnicoLinea == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(VerificaSommaBandePiccoRequest.profiloTecnicoLinea == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
			{&#xD;
				VerificaSommaBandePiccoRequest.profiloTecnicoLinea = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
//USERVLAN RICHIESTA&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp;&#xD;
	((localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
	&amp;&amp; currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
	||&#xD;
	localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC))&#xD;
	{&#xD;
		//RU_1180: le USERVLAN con FLAGMULTICAST a SI non vanno considerate&#xD;
		var foundFLAGMULTICAST = false;&#xD;
&#xD;
		for(var m=0; m&lt;currentDettOrdine.attributiDettaglioOrdine.size(); m++)&#xD;
		{&#xD;
			var attributoComp = currentDettOrdine.attributiDettaglioOrdine.get(m);&#xD;
			&#xD;
			if(attributoComp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST&#xD;
			   &amp;&amp; attributoComp.valoreAttributo == &quot;SI&quot;)&#xD;
			{&#xD;
				foundFLAGMULTICAST = true;		&#xD;
			}&#xD;
		}&#xD;
&#xD;
		if(!foundFLAGMULTICAST)&#xD;
		{&#xD;
			var uservlan = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createUserVlan_SommaBandePicco();&#xD;
			&#xD;
			uservlan.azione = String(currentDettOrdine.azione);&#xD;
&#xD;
&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
				{&#xD;
					uservlan.banda_Picco_DOWN = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
				{&#xD;
					uservlan.banda_Picco_UP = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
				{&#xD;
					uservlan.idUserVlan = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			VerificaSommaBandePiccoRequest.userVlan.add(uservlan);&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//VARIAZIONE&#xD;
if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	VerificaSommaBandePiccoRequest.idRisorsa = localRequest.IDRisorsa;&#xD;
	&#xD;
	if (ConsistenzaDati!= null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
		Asset = AssetRef.readAsset();&#xD;
		&#xD;
		//PROFILO TECNICO LINEA DA CONSISTEZA DATI&#xD;
		var i = 0;&#xD;
		while(VerificaSommaBandePiccoRequest.profiloTecnicoCons == null &amp;&amp; i &lt; Asset.dettaglioasset.size())&#xD;
		{&#xD;
			var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
	&#xD;
			if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(VerificaSommaBandePiccoRequest.profiloTecnicoCons == null &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
				{&#xD;
					var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
					if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
					{&#xD;
						VerificaSommaBandePiccoRequest.profiloTecnicoCons = currentAttDettAsset.valoreAttributo;&#xD;
					}&#xD;
				j++;&#xD;
				}&#xD;
			}&#xD;
		i++;&#xD;
		}&#xD;
		&#xD;
		// USERVLAN DA CONSISTENZA DATI&#xD;
		for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
	&#xD;
			if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{&#xD;
				//RU_1180: le USERVLAN con FLAGMULTICAST a SI non vanno considerate&#xD;
				var foundFLAGMULTICAST = false;&#xD;
&#xD;
				for(var m=0; m&lt;currentDettAsset.attributidettaglioasset.size(); m++)&#xD;
				{&#xD;
					var attributoComp = currentDettAsset.attributidettaglioasset.get(m);&#xD;
					&#xD;
					if(attributoComp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST&#xD;
					   &amp;&amp; attributoComp.valoreAttributo == &quot;SI&quot;)&#xD;
					{&#xD;
						foundFLAGMULTICAST = true;			&#xD;
					}&#xD;
				}&#xD;
&#xD;
				if(!foundFLAGMULTICAST)&#xD;
				{&#xD;
					var uservlanCons = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createUserVlan_SommaBandePiccoCons();&#xD;
&#xD;
					for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
						if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
						{&#xD;
							uservlanCons.banda_Picco_DOWN = currentAttDettAsset.valoreAttributo;&#xD;
						}&#xD;
						else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
						{&#xD;
							uservlanCons.banda_Picco_UP = currentAttDettAsset.valoreAttributo;&#xD;
						}&#xD;
						else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
						{&#xD;
							uservlanCons.idUserVlan = currentAttDettAsset.valoreAttributo;&#xD;
						}&#xD;
					}&#xD;
			&#xD;
					VerificaSommaBandePiccoRequest.userVlan_Cons.add(uservlanCons);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">// se il controllo ha dato esito OK e siamo nel caso della variazione (recuperati valori dalla consistenza in precedente)&#xD;
if (EsitoResponse.codice == true &amp;&amp; &#xD;
    localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if((localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &amp;&amp;&#xD;
			currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp;&#xD;
			currentDettaglioOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
			||&#xD;
			(localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
			&amp;&amp; currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN))&#xD;
		&#xD;
		{&#xD;
			var uservlan = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createUserVlan_SommaBandePicco();&#xD;
			var uservlan_id = null;&#xD;
			var uservlan_id = '';&#xD;
			&#xD;
			// Recupero UserVlan dalla richiesta&#xD;
			for (var j = 0 ; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
				{&#xD;
					uservlan.banda_Picco_DOWN = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
				{&#xD;
					uservlan.banda_Picco_UP = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if (currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
				{&#xD;
					uservlan_id = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			// se le bande non sono presenti nella richiesta&#xD;
			if(uservlan.banda_Picco_DOWN == null || uservlan.banda_Picco_UP == null)&#xD;
			{&#xD;
				&#xD;
				// Recupera le bande dalla consistenza salvata in precedenza&#xD;
				for(var k = 0; k &lt; VerificaSommaBandePiccoRequest.userVlan_Cons.size(); k++)&#xD;
				{&#xD;
					&#xD;
					if(VerificaSommaBandePiccoRequest.userVlan_Cons.get(k).idUserVlan == uservlan_id)&#xD;
					{&#xD;
						&#xD;
																		&#xD;
						// ARRICCHIMENTO RICHIESTA&#xD;
						var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						var data = DateTimeUtil.createDatetime();&#xD;
						&#xD;
						attributo.IDRichiestaOLO = currentDettaglioOrdine.IDRichiestaOLO;&#xD;
						attributo.IDDettaglioOrdine = currentDettaglioOrdine.IDDettaglioOrdine;&#xD;
						attributo.created = data;&#xD;
						attributo.lastUpdate = data;&#xD;
						attributo.operatore = currentDettaglioOrdine.operatore;&#xD;
						&#xD;
						if(uservlan.banda_Picco_DOWN == null)&#xD;
						{&#xD;
						  // Aggiunge Banda Picco Down&#xD;
						  uservlan.banda_Picco_DOWN = VerificaSommaBandePiccoRequest.userVlan_Cons.get(k).banda_Picco_DOWN;&#xD;
						  attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN;&#xD;
						  attributo.valoreAttributo = uservlan.banda_Picco_DOWN;&#xD;
						  attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						&#xD;
						  localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						}&#xD;
						&#xD;
						if(uservlan.banda_Picco_UP == null)&#xD;
						{&#xD;
						  // Aggiunge Banda Picco Up&#xD;
						  uservlan.banda_Picco_UP = VerificaSommaBandePiccoRequest.userVlan_Cons.get(k).banda_Picco_UP;&#xD;
						  attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP;&#xD;
						  attributo.valoreAttributo = uservlan.banda_Picco_UP;&#xD;
						  attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						&#xD;
						  localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));	&#xD;
						}&#xD;
					}&#xD;
					&#xD;
				}&#xD;
					&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
