            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_THM1EdMEEeqqWasz_r4Thg" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_HTDRkNMEEeqqWasz_r4Thg" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="82.0" LaneId="_E7-FcdMEEeqqWasz_r4Thg" Width="45.0">
              <xpdl2:Coordinates XCoordinate="58.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_VGTmENMEEeqqWasz_r4Thg" Name="VerificaIDRiferimento" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica IDRiferimento" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL VERIFICA AGGREGATO IDRIFERIMENTO SUPERATO&quot;;&#xD;
&#xD;
var foundCodiceOrdineTI = false;&#xD;
var foundCodiceOrdineOLO = false;&#xD;
&#xD;
//Bug #32742&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINETIDAOLO)&#xD;
			{&#xD;
				foundCodiceOrdineTI = true;&#xD;
				Process.auditLog(&quot;Trovato attributo CODICEORDINETIDAOLO &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEORDINEOLODAOLO)&#xD;
			{&#xD;
				foundCodiceOrdineOLO = true;&#xD;
				Process.auditLog(&quot;Trovato attributo CODICEORDINEOLODAOLO &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
   &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
       ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN))&#xD;
||(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
   &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
       ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN&#xD;
	   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANVULA)))&#xD;
{&#xD;
	if((foundCodiceOrdineTI &amp;&amp; foundCodiceOrdineOLO)||(!foundCodiceOrdineTI &amp;&amp; !foundCodiceOrdineOLO))&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VERIFICA AGGREGATO IDRIFERIMENTO NON SUPERATO&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
