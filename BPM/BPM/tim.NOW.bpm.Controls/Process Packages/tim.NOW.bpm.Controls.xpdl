        <xpdl2:DataField Id="_e-rGEHs8EeugKuyBU-xWMA" xpdExt:DisplayName="ArrayCVLANID" Name="ArrayCVLANID" IsArray="true" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_lmuYIHs8EeugKuyBU-xWMA" xpdExt:DisplayName="ArrayCODEVLANSINGLETAG" Name="ArrayCODEVLANSINGLETAG" IsArray="true" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_oGci4Hs8EeugKuyBU-xWMA" xpdExt:DisplayName="ArrayDaControllare" Name="ArrayDaControllare" IsArray="true" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_xTLTcM3WEeuoLqYAsH2OfQ" xpdExt:DisplayName="ArrayUSERVLANID" Name="ArrayUSERVLANID" IsArray="true" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_itMfINATEeuc3tuXn6ZXDg" xpdExt:DisplayName="eseguiControllo" Name="eseguiControllo" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="BOOLEAN"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_z-nyI3s5EeugKuyBU-xWMA" Name="EndEvent" xpdExt:DisplayName="End Event">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" LaneId="_z-nyIXs5EeugKuyBU-xWMA" Width="45.0">
              <xpdl2:Coordinates XCoordinate="863.0" YCoordinate="201.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_j75qgHs7EeugKuyBU-xWMA" Name="DuplicatiCvlanIdeCodeVlanSingleTag" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Duplicati CvlanId e CodeVlanSingleTag">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//CONTROLLO CREATO CON AGESP R1I-20-0313&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo duplicati CVLANID e CodeVlanSingleTag SUPERATO&quot;;&#xD;
&#xD;
//RECUPERO ASSET&#xD;
if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
}&#xD;
else if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.IDAsset != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaFonia.IDAsset, 10));&#xD;
}&#xD;
	&#xD;
if(AssetRef!= null)&#xD;
{	&#xD;
	Asset = AssetRef.readAsset();&#xD;
}&#xD;
&#xD;
//RECUPERO IL VALORE DI ENCAPSULATION&#xD;
//Come da mail, In caso di Attivazione e Migrazione va considerata l’Encapsulation della richiesta, mentre in VARIAZIONE va sempre considerata quella della consistenza a meno che non sia stato un CAMBIOTIPOVLAN e quindi va considerata la richiesta. &#xD;
var ENCAPSULATION = &quot;&quot;;&#xD;
ENCAPSULATION = null;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
   ||localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
   ||localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
				{&#xD;
					ENCAPSULATION = (attributo.valoreAttributo).toUpperCase();&#xD;
					Process.auditLog(&quot;Trovato attributo ENCAPSULATION nell'Ordine&quot;+ attributo.valoreAttributo);			&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else if(Asset != null)&#xD;
{	&#xD;
	for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var currentComponente = Asset.dettaglioasset.get(i);&#xD;
	&#xD;
		if(String(currentComponente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;currentComponente.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var currentAttributo = currentComponente.attributidettaglioasset.get(j);&#xD;
			&#xD;
				if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
				{&#xD;
					ENCAPSULATION = (currentAttributo.valoreAttributo).toUpperCase();&#xD;
					Process.auditLog(&quot;Trovato attributo ENCAPSULATION nell'Asset&quot;+ currentAttributo.valoreAttributo);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//VARIAZIONI CHE CI INTERESSANO&#xD;
var TipoVariazione = false;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
   &amp;&amp;(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
      ||localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING&#xD;
	  ||localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC&#xD;
	  ||localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN))&#xD;
{&#xD;
	TipoVariazione = true;&#xD;
}&#xD;
&#xD;
//CONTRUZIONE ARRAY&#xD;
if(ENCAPSULATION != null)&#xD;
{&#xD;
	//PER TUTTE E 3 LE LAVORAZIONI&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
		   &amp;&amp; (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
			   ||localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
			   ||((localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC          //SM_9972: modificato if per Variazioni&#xD;
                     ||localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING) &#xD;
				  &amp;&amp; componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
			   || ((localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC&#xD;
                     ||localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN) &#xD;
				  &amp;&amp; componente.azione == null)))&#xD;
		{&#xD;
			//Task #35348&#xD;
			var USERVLANIDRic = &quot;&quot;;&#xD;
			USERVLANIDRic = null;&#xD;
			var CVLANIDRic = &quot;&quot;;&#xD;
			CVLANIDRic = null;&#xD;
			var CODEVLANSINGLETAGRic = &quot;&quot;;&#xD;
			CODEVLANSINGLETAGRic = null;&#xD;
			&#xD;
			&#xD;
			//R1I-21-0093: le USERVLAN con FLAGMULTICAST a SI non vanno considerate&#xD;
			var foundFLAGMULTICAST = false;&#xD;
		&#xD;
			for(var m=0; m&lt;componente.attributiDettaglioOrdine.size(); m++)&#xD;
			{&#xD;
				var attributoComp = componente.attributiDettaglioOrdine.get(m);&#xD;
				&#xD;
				if(attributoComp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST&#xD;
				   &amp;&amp; attributoComp.valoreAttributo == &quot;SI&quot;)&#xD;
				{&#xD;
					foundFLAGMULTICAST = true;&#xD;
					Process.auditLog(&quot;Trovato attributo FLAGMULTICAST&quot;+ attributoComp.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if(!foundFLAGMULTICAST)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					//COSTRUZIONE ARRAY DI CVLAN_ID (ATTRIBUTO CVLANID) nel caso DOUBLETAG&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID &#xD;
					   &amp;&amp; ENCAPSULATION == &quot;DOUBLETAG&quot;)&#xD;
					{&#xD;
						CVLANIDRic = attributo.valoreAttributo;	&#xD;
					}&#xD;
					//COSTRUZIONE ARRAY CODEVLANSINGLETAG (ATTRIBUTO CODEVLANSINGLETAG PER BITSTREAMNGAFTTH) nel caso SINGLETAG&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG &#xD;
							&amp;&amp; ENCAPSULATION == &quot;SINGLETAG&quot;&#xD;
							&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
							 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
							 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA))   //KIT C06 2025&#xD;
					{&#xD;
						CODEVLANSINGLETAGRic = attributo.valoreAttributo;				&#xD;
					}&#xD;
					//SM_10089: COSTRUZIONE ARRAY USERVLANID&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
					{&#xD;
						USERVLANIDRic = attributo.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//Task #35348: può succedere che in input ci sia solo uservlanid e non cvlanid/codevlasingletag (se ad esempio si variano le velocità)&#xD;
				if(USERVLANIDRic != null &amp;&amp; CVLANIDRic != null)&#xD;
				{&#xD;
					ArrayUSERVLANID.add(USERVLANIDRic);&#xD;
					ArrayCVLANID.add(CVLANIDRic);&#xD;
					&#xD;
					Process.auditLog(&quot;Aggiunto elemento ad ArrayUSERVLANID: &quot;+USERVLANIDRic+ &quot; e aggiunto elemento ad ArrayCVLANID: &quot; +CVLANIDRic);	&#xD;
				}&#xD;
				else if(USERVLANIDRic != null &amp;&amp; CODEVLANSINGLETAGRic != null)&#xD;
				{&#xD;
					ArrayUSERVLANID.add(USERVLANIDRic);&#xD;
					ArrayCODEVLANSINGLETAG.add(CODEVLANSINGLETAGRic);&#xD;
					&#xD;
					Process.auditLog(&quot;Aggiunto elemento ad ArrayUSERVLANID: &quot;+USERVLANIDRic+ &quot; e aggiunto elemento ad ArrayCODEVLANSINGLETAG: &quot; +CODEVLANSINGLETAGRic);	&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	//SOLO PER VARIAZIONE: vanno aggiunti anche quelli in asset&#xD;
	if(TipoVariazione &amp;&amp; Asset != null)&#xD;
	{&#xD;
		for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var currentComponente = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
			if(currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
			   &amp;&amp; currentComponente.statoDettaglioAsset == &quot;ATTIVO&quot;)&#xD;
			{&#xD;
				//R1I-21-0093: le USERVLAN con FLAGMULTICAST a SI non vanno considerate&#xD;
				var foundFLAGMULTICAST = false;&#xD;
			&#xD;
				for(var m=0; m&lt;currentComponente.attributidettaglioasset.size(); m++)&#xD;
				{&#xD;
					var attributoComp = currentComponente.attributidettaglioasset.get(m);&#xD;
					&#xD;
					if(attributoComp.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST&#xD;
					   &amp;&amp; attributoComp.valoreAttributo == &quot;SI&quot;)&#xD;
					{&#xD;
						foundFLAGMULTICAST = true;&#xD;
						Process.auditLog(&quot;Trovato attributo FLAGMULTICAST&quot;+ attributoComp.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+currentComponente.IDDettaglioAsset);			&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				if(!foundFLAGMULTICAST)&#xD;
				{&#xD;
					for(var j=0; j&lt;currentComponente.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var currentAttributo = currentComponente.attributidettaglioasset.get(j);&#xD;
					&#xD;
						//COSTRUZIONE ARRAY DI CVLAN_ID (ATTRIBUTO CVLANID) nel caso DOUBLETAG&#xD;
						if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID &#xD;
						   &amp;&amp; ENCAPSULATION == &quot;DOUBLETAG&quot;)&#xD;
						{&#xD;
							ArrayCVLANID.add(currentAttributo.valoreAttributo);&#xD;
							Process.auditLog(&quot;Aggiunto elemento ad ArrayCVLANID &quot;+ currentAttributo.valoreAttributo);&#xD;
						}&#xD;
						//COSTRUZIONE ARRAY CODEVLANSINGLETAG (ATTRIBUTO CODEVLANSINGLETAG PER BITSTREAMNGAFTTH) nel caso SINGLETAG&#xD;
						//Task #35034: CODEVLANSINGLETAG viene assettizzato in SVLANCODE&#xD;
						else if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE &#xD;
								&amp;&amp; ENCAPSULATION == &quot;SINGLETAG&quot;&#xD;
								&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
								 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH))&#xD;
						{&#xD;
							ArrayCODEVLANSINGLETAG.add(currentAttributo.valoreAttributo);&#xD;
							Process.auditLog(&quot;Aggiunto elemento ad ArrayCODEVLANSINGLETAG &quot;+ currentAttributo.valoreAttributo);	&#xD;
						}&#xD;
						//SM_10089: COSTRUZIONE ARRAY USERVLANID&#xD;
						else if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
						{&#xD;
							ArrayUSERVLANID.add(currentAttributo.valoreAttributo);&#xD;
							Process.auditLog(&quot;Aggiunto elemento ad ArrayUSERVLANID &quot;+ currentAttributo.valoreAttributo);	&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(ArrayCVLANID != null &amp;&amp; ArrayCVLANID.size()>0)&#xD;
{&#xD;
	ArrayDaControllare = ArrayCVLANID;&#xD;
}&#xD;
else if(ArrayCODEVLANSINGLETAG != null &amp;&amp; ArrayCODEVLANSINGLETAG.size()>0)&#xD;
{&#xD;
	ArrayDaControllare = ArrayCODEVLANSINGLETAG;&#xD;
}&#xD;
&#xD;
//SM_10089: CHECK PER ELIMINARE CODEVLANSINGLETAG/CVLANID identici tra asset e ordine (non sono variati ma l'utente li ha messi in input) a parità di USERVLANID &#xD;
//A parità di UserVlan_id se il CodiceVlanSingletag/CvlanID in richiesta coincide con quello di consistenza, non deve essere considerato come duplicato &#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
   &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC&#xD;
   &amp;&amp; ArrayDaControllare != null &amp;&amp; ArrayDaControllare.size()>0 &amp;&amp; ArrayUSERVLANID != null &amp;&amp; ArrayUSERVLANID.size()>0)&#xD;
{&#xD;
	for(var m=0; m&lt;ArrayUSERVLANID.size()-1; m++)&#xD;
	{&#xD;
		var currentUservlanID = ArrayUSERVLANID.get(m);&#xD;
		&#xD;
		for(var s=m+1; s&lt;ArrayUSERVLANID.size(); s++)&#xD;
		{&#xD;
			var UservlanIDsuccessivo = ArrayUSERVLANID.get(s);&#xD;
			&#xD;
			if(currentUservlanID == UservlanIDsuccessivo &amp;&amp; ArrayDaControllare.get(m) == ArrayDaControllare.get(s))&#xD;
			{&#xD;
				Process.auditLog(&quot;Eliminato elemento: &quot;+ArrayDaControllare.get(s));&#xD;
				ArrayUSERVLANID.remove(s);&#xD;
				ArrayDaControllare.remove(s);&#xD;
				s--;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//CONTROLLO LA PRESENZA DI DUPLICATI&#xD;
while(ArrayDaControllare != null &amp;&amp; ArrayDaControllare.size()>0 &amp;&amp; EsitoResponse.codice)&#xD;
{&#xD;
	var Elemento = ArrayDaControllare.get(0);&#xD;
	ArrayDaControllare.remove(0);&#xD;
	&#xD;
	if(ArrayDaControllare != null &amp;&amp; ArrayDaControllare.size()>0 &amp;&amp; ArrayDaControllare.contains(Elemento))&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Controllo duplicati CVLANID e CodeVlanSingleTag NON SUPERATO&quot;;&#xD;
		Process.auditLog(&quot;Trovato duplicato nell'array&quot;+ Elemento);&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="92.0" LaneId="_z-nyIXs5EeugKuyBU-xWMA" Width="174.0">
              <xpdl2:Coordinates XCoordinate="607.0" YCoordinate="201.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_04pfgHs7EeugKuyBU-xWMA">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_1uOcoHs7EeugKuyBU-xWMA"/>
                  <xpdl2:TransitionRef Id="_3wwVE3s7EeugKuyBU-xWMA"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="45.0" LaneId="_z-nyIXs5EeugKuyBU-xWMA" Width="43.0">
              <xpdl2:Coordinates XCoordinate="401.0" YCoordinate="201.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_3wwVEns7EeugKuyBU-xWMA" Name="Precondizionefallita" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione fallita">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL DUPLICATI CVLANID CODEVLANSINGLETAG_C04M01F462 saltato&quot;;&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_z-nyIXs5EeugKuyBU-xWMA" Width="160.0">
