          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_Qk-GIKQjEeqZ85IFBW_LPA" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = false;&#xD;
&#xD;
//Ricerca di FASCIAORARIA DALLA RICHIESTA IN INPUT&#xD;
var i=0;&#xD;
var valoreFasciaOraria = &quot;&quot;;&#xD;
valoreFasciaOraria = null;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	while(valoreFasciaOraria == null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTODISAGGREGAZIONE)&#xD;
		{&#xD;
			for(var k=0; k&lt;componente.attributiDettaglioOrdine.size(); k++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FASCIAORARIA)&#xD;
				{&#xD;
					valoreFasciaOraria = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		i++;	&#xD;
	}&#xD;
}&#xD;
&#xD;
//Verifica precondizione&#xD;
if((targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
	  || targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA  &#xD;
	  || targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA) &#xD;
	&amp;&amp;(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.INTERRUZIONESOSPENSIONE&#xD;
      || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDAD)&#xD;
	&amp;&amp; valoreFasciaOraria == &quot;05&quot;)&#xD;
{&#xD;
	EseguiControllo = true;&#xD;
}&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
