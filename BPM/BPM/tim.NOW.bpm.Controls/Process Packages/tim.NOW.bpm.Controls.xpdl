        <xpdl2:Activity Id="_7Wsn0nWOEeqoN69Ux-xTDg" Name="Verificafasciaoraria" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica fascia oraria" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL Verifica Fascia Oraria Disaggregazione superato&quot;;&#xD;
&#xD;
var valoreOwnerPresaAppuntamento = &quot;&quot;;&#xD;
valoreOwnerPresaAppuntamento = null;&#xD;
var i=0;&#xD;
&#xD;
if(targetRequest != null &amp;&amp; targetRequest.ordine != null &amp;&amp; targetRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	//OWNERPRESAPPUNTAMENTO DALLA RICHIESTA TARGET&#xD;
	while(valoreOwnerPresaAppuntamento == null &amp;&amp; i&lt;targetRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = targetRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTODISAGGREGAZIONE)&#xD;
		{				&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OWNERPRESAAPPUNTAMENTO)&#xD;
				{&#xD;
					valoreOwnerPresaAppuntamento = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo OWNERPRESAAPPUNTAMENTO con valore: &quot;+ valoreOwnerPresaAppuntamento);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
    //DISAGGREGATO DALLA RICHIESTA TARGET&#xD;
	Process.auditLog(&quot;Trovato disaggregato nel tracciato OLO con valore: &quot;+ targetRequest.disaggregato);&#xD;
&#xD;
&#xD;
	//CONDIZIONE DI SCARTO&#xD;
	if(valoreOwnerPresaAppuntamento == 'TI' &amp;&amp; targetRequest.disaggregato == 'S')&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL Verifica Fascia Oraria Disaggregazione non superato&quot;;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
