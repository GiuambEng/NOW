                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_YHMjsCMWEea7qJ_CMNwz5w" OperationName="VerificaEsistenzaKit_s7">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckDatiPortTypeSOAP" ServiceName="BPM_CheckDatiPortType">
