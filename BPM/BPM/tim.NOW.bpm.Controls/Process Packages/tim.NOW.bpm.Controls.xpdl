    <xpdl2:WorkflowProcess Id="_kyOcgCEAEeaub_W9_7VV0A" xpdExt:DisplayName="CTRL ENCAPSULATION DT_C04M01F34" Name="CTRLENCAPSULATIONDT_C04M01F34">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_OciM4E9jEeap_8ctphwdnw" xpdExt:DisplayName="SvlanCode" Name="SvlanCode" IsArray="true">
