    <xpdl2:WorkflowProcess Id="_8pG5cCD9Eeaub_W9_7VV0A" xpdExt:DisplayName="CTRL ENCAPSULATION ST_C04M01F35" Name="CTRLENCAPSULATIONST_C04M01F35">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_2zSH0E9bEeap_8ctphwdnw" xpdExt:DisplayName="CodeVlanSingleTag" Name="CodeVlanSingleTag" IsArray="true">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="BOOLEAN"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_SgJv0kw5EeeXI5NEt_BPwA" xpdExt:DisplayName="AssetRef" Name="AssetRef">
