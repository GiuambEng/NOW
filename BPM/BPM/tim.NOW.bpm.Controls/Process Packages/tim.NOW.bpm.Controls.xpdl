              <xpdExt:Information ScriptGrammar="JavaScript">VerificaCompAggiuntiviApparatiRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaCompatibilitAggiuntiviApparati_RequestType();&#xD;
&#xD;
VerificaCompAggiuntiviApparatiRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
