          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var tagged = false;&#xD;
var failed = false;&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while((!tagged || !failed) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(!tagged &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING &amp;&amp; currentAttDettOrdine.valoreAttributo.toUpperCase() == &quot;TAGGED&quot;)&#xD;
				{&#xD;
					tagged = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			var z = 0;&#xD;
			var foundUservlanid = false;&#xD;
			while(!foundUservlanid &amp;&amp; z &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var bisCurrentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
				&#xD;
				if(bisCurrentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
				{&#xD;
					foundUservlanid = true;&#xD;
				}&#xD;
				z++;&#xD;
			}&#xD;
			&#xD;
			if(foundUservlanid &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING)&#xD;
			{&#xD;
				failed = true;&#xD;
				CodiceEsito = &quot;KO_01&quot;; // Caso aggiunto con SM_8721, prima era un solo KO&#xD;
			}&#xD;
			else if(!foundUservlanid)&#xD;
			{&#xD;
				failed = true;&#xD;
				CodiceEsito = &quot;KO_02&quot;;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(!tagged)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;USERVLAN1TAGGING non TAGGED&quot;;&#xD;
	}&#xD;
	else if(failed)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Trovata UserVLAN senza UserVlanID&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Tutte le UserVLAN hanno il tag UserVlanID&quot;;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
