            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_8pG5ciD9Eeaub_W9_7VV0A" Width="31.0">
              <xpdl2:Coordinates XCoordinate="888.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_8pIHlyD9Eeaub_W9_7VV0A" Name="VerificaEncapsulationSingleTag" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Encapsulation SingleTag">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var isIncremento = false;&#xD;
var foundCodeVlanSingleTag = false;&#xD;
var isSingleTag = false;&#xD;
var foundEncapsulation = false;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettaglioOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var k = 0;&#xD;
			while(!foundEncapsulation &amp;&amp; k &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(k);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION &amp;&amp; currentAttDettOrdine.valoreAttributo == &quot;SINGLETAG&quot;)&#xD;
				{&#xD;
					//TROVATO ENCAPSULATION = SINGLETAG&#xD;
					foundEncapsulation = true;&#xD;
					isSingleTag = true;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
				{&#xD;
					foundEncapsulation = true;&#xD;
				}&#xD;
				k++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		else if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			//R1I-21-0093: Il controllo non va effettuato se la USERVLAN ha FLAGMULTICAST&#xD;
			var FLAGMULTICAST = &quot;&quot;;&#xD;
			FLAGMULTICAST = null;&#xD;
			var m = 0;&#xD;
&#xD;
			while(FLAGMULTICAST == null &amp;&amp; m&lt;currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = currentDettaglioOrdine.attributiDettaglioOrdine.get(m);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
				{&#xD;
					FLAGMULTICAST = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo FLAGMULTICAST&quot;+ attributo.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+currentDettaglioOrdine.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				m++;&#xD;
			}&#xD;
			&#xD;
			if(FLAGMULTICAST != &quot;SI&quot;)&#xD;
			{&#xD;
				if(currentDettaglioOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A){&#xD;
					isIncremento = true;&#xD;
				}&#xD;
				foundCodeVlanSingleTag = false;&#xD;
				var j = 0;&#xD;
				while(!foundCodeVlanSingleTag &amp;&amp; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
					{&#xD;
						//Trovato CodeVlanSingleTag&#xD;
						foundCodeVlanSingleTag = true;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
				CodeVlanSingleTag.add(foundCodeVlanSingleTag);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
var isSingleTagASSET = false;&#xD;
var foundEncapsulationASSET = false;&#xD;
&#xD;
//cerco in asset&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset,10));&#xD;
	Asset = AssetRef.readAsset();&#xD;
	&#xD;
	for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var componenteAsset = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
		if(String(componenteAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
			var j=0;&#xD;
			&#xD;
			while(!foundEncapsulationASSET &amp;&amp; j&lt;componenteAsset.attributidettaglioasset.size())&#xD;
			{&#xD;
				var attributoAsset = componenteAsset.attributidettaglioasset.get(j);&#xD;
				if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION &amp;&amp; attributoAsset.valoreAttributo == &quot;SINGLETAG&quot;)&#xD;
				{&#xD;
					//TROVATO ENCAPSULATION = DOUBLETAG&#xD;
					foundEncapsulationASSET = true;&#xD;
					isSingleTagASSET = true;&#xD;
				}&#xD;
				else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
				{&#xD;
					foundEncapsulationASSET = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//verifico precondizioni per variazioni&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
	&amp;&amp; &#xD;
	(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &amp;&amp; !isIncremento))&#xD;
	{&#xD;
&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Precondizione fallita per variazione dati - INCREMENTODECREMENTOVC non in incremento&quot;;&#xD;
	Process.auditLog(EsitoResponse.descrizione);&#xD;
	}&#xD;
else&#xD;
{ &#xD;
	if(isSingleTag || (!foundEncapsulation &amp;&amp; isSingleTagASSET))&#xD;
	{&#xD;
		//Encapsulation di tipo SINGLETAG&#xD;
		var stillTrue = true;&#xD;
		var y = 0;&#xD;
	&#xD;
		while(stillTrue &amp;&amp; y &lt; CodeVlanSingleTag.size())&#xD;
		{&#xD;
			stillTrue = CodeVlanSingleTag.get(y);&#xD;
			y++;&#xD;
		}&#xD;
	&#xD;
		if(stillTrue)&#xD;
		{&#xD;
			//Trovato CodeVlanSingleTag&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Trovato Encapsulation di tipo SINGLETAG e tutte le USERVALN hanno CodeVlanSingleTag&quot;;&#xD;
			Process.auditLog(EsitoResponse.descrizione);&#xD;
		}&#xD;
		else&#xD;
		{	&#xD;
			//CodeVlanSingleTag NON Trovato&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Trovato Encapsulation di tipo SINGLETAG, ma almeno una USERVALN senza CodeVlanSingleTag&quot;;&#xD;
			Process.auditLog(EsitoResponse.descrizione);&#xD;
		}&#xD;
	}	&#xD;
	else if(foundEncapsulation &amp;&amp; !isSingleTag)&#xD;
	{&#xD;
		//Encapsulation NON di tipo SINGLETAG&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Precondizione fallita - Encapsulation non di tipo SINGLETAG&quot;;&#xD;
		Process.auditLog(EsitoResponse.descrizione);&#xD;
	}&#xD;
	else if(foundEncapsulationASSET &amp;&amp; !isSingleTagASSET)&#xD;
	{&#xD;
		//Encapsulation NON di tipo SINGLETAG&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Precondizione fallita - Encapsulation NON trovata nella richiesta, presente in ASSET non di tipo SINGLETAG&quot;;&#xD;
		Process.auditLog(EsitoResponse.descrizione);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		//Encapsulation NON trovato&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Encapsulation non trovato&quot;;&#xD;
		Process.auditLog(EsitoResponse.descrizione);&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="86.0" LaneId="_8pG5ciD9Eeaub_W9_7VV0A" Width="121.0">
              <xpdl2:Coordinates XCoordinate="659.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_3eyeUVJNEeafMOVsQ226Vw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_yYn1wFJNEeafMOVsQ226Vw" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="52.0" LaneId="_8pG5ciD9Eeaub_W9_7VV0A" Width="73.0">
              <xpdl2:Coordinates XCoordinate="66.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_hxIyADygEeeZjNKHD34LDg" Name="VerificaPrecondizione" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	Process.auditLog(&quot;Lavorazione: &quot;+ localRequest.lavorazione + &quot;, Sotto Lavorazione&quot;+ localRequest.ordine.tipologiaSottolav);&#xD;
	&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN&#xD;
	|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Precondizione per variazioni superata&quot;;&#xD;
		Process.auditLog(EsitoResponse.descrizione);&#xD;
	}&#xD;
	else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
	{	&#xD;
		// RECUPERA VALORI IN ASSET&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset,10));&#xD;
		Asset = AssetRef.readAsset();&#xD;
		&#xD;
		var UserVlanIDAsset = &quot;&quot;;&#xD;
		UserVlanIDAsset = null;&#xD;
		var SVLANCODEAsset = &quot;&quot;;&#xD;
		SVLANCODEAsset = null;&#xD;
		var ProfiloTecnicoLineaAsset = &quot;&quot;;&#xD;
		ProfiloTecnicoLineaAsset = null;&#xD;
		&#xD;
		for (var k=0; k&lt;Asset.dettaglioasset.size(); k++)&#xD;
		{&#xD;
			var componenteAsset = Asset.dettaglioasset.get(k);&#xD;
			&#xD;
			if (componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{&#xD;
				for (var z=0; z&lt;componenteAsset.attributidettaglioasset.size(); z++)&#xD;
				{&#xD;
					var attributoAsset = componenteAsset.attributidettaglioasset.get(z);&#xD;
					&#xD;
					if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
					{&#xD;
						UserVlanIDAsset = attributoAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
					{&#xD;
						SVLANCODEAsset = attributoAsset.valoreAttributo;&#xD;
					}	&#xD;
				}&#xD;
			}&#xD;
			else if(String(componenteAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for (var q=0; q&lt;componenteAsset.attributidettaglioasset.size(); q++)&#xD;
				{&#xD;
					var attributoAsset = componenteAsset.attributidettaglioasset.get(q);&#xD;
					&#xD;
					if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
					{&#xD;
						ProfiloTecnicoLineaAsset = attributoAsset.valoreAttributo;&#xD;
					}&#xD;
				}	&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		Process.auditLog(&quot;UserVlanIDAsset: &quot;+UserVlanIDAsset+&quot;. SVLANCODEAsset: &quot;+SVLANCODEAsset+&quot;. ProfiloTecnicoLineaAsset: &quot;+ProfiloTecnicoLineaAsset);&#xD;
		&#xD;
		// RECUPERA VALORI DALL'ORDINE&#xD;
		var UserVlanIDOrdine = &quot;&quot;;&#xD;
		UserVlanIDOrdine = null;&#xD;
		var SVLANCODEOrdine = &quot;&quot;;&#xD;
		SVLANCODEOrdine = null;&#xD;
		var ProfiloTecnicoLineaOrdine = &quot;&quot;;&#xD;
		ProfiloTecnicoLineaOrdine = null;&#xD;
			&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{	&#xD;
			var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if (currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{				&#xD;
				for (var j=0; j&lt;currentDettaglioOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
					{&#xD;
						UserVlanIDOrdine = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
					{&#xD;
						SVLANCODEOrdine = currentAttDettOrdine.valoreAttributo;&#xD;
					}	&#xD;
				}&#xD;
			}&#xD;
			else if(String(currentDettaglioOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for (var x=0; x&lt;currentDettaglioOrdine.attributiDettaglioOrdine.size(); x++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(x);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
					{&#xD;
						ProfiloTecnicoLineaOrdine = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
				&#xD;
		i++;	&#xD;
		}&#xD;
		&#xD;
		var foundRiattestazioneVLAN=false;&#xD;
		var foundModificaProfiloTecnicoLinea = false;&#xD;
		&#xD;
		if (SVLANCODEOrdine!= null)&#xD;
		{&#xD;
			if (UserVlanIDAsset!= null &amp;&amp; UserVlanIDOrdine!= null &amp;&amp; UserVlanIDAsset==UserVlanIDOrdine &amp;&amp; (SVLANCODEAsset == null || SVLANCODEAsset!=SVLANCODEOrdine))&#xD;
			{&#xD;
				foundRiattestazioneVLAN = true;&#xD;
			}&#xD;
			else if (UserVlanIDAsset == null &amp;&amp; (SVLANCODEAsset== null || SVLANCODEAsset!=SVLANCODEOrdine))&#xD;
			{&#xD;
				foundRiattestazioneVLAN = true;&#xD;
			}&#xD;
			else if (ProfiloTecnicoLineaOrdine!=null &amp;&amp; ProfiloTecnicoLineaAsset != ProfiloTecnicoLineaOrdine)&#xD;
			{&#xD;
				foundModificaProfiloTecnicoLinea = true;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
	    Process.auditLog(&quot;UserVlanIDOrdine: &quot;+UserVlanIDOrdine+&quot;. SVLANCODEOrdine: &quot;+SVLANCODEOrdine+&quot;. ProfiloTecnicoLineaOrdine: &quot;+ProfiloTecnicoLineaOrdine);&#xD;
		Process.auditLog(&quot;foundRiattestazioneVLAN: &quot;+String(foundRiattestazioneVLAN)+&quot;. foundModificaProfiloTecnicoLinea: &quot;+String(foundModificaProfiloTecnicoLinea));&#xD;
		&#xD;
		if (!foundRiattestazioneVLAN &amp;&amp; !foundModificaProfiloTecnicoLinea)&#xD;
		{			&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Skip controllo per precondizione non superata - Nessuna Riattestazione VLAN o Modifica Profilo Tecnico Linea trovata&quot;;&#xD;
			Process.auditLog(EsitoResponse.descrizione);&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Precondizione per variazioni non superata&quot;;&#xD;
		Process.auditLog(EsitoResponse.descrizione);&#xD;
	}&#xD;
}&#xD;
&#xD;
//SM_9689: controllo da skippare per ACCORPAMENTOOLO&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
	    &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Precondizione per MIGRAZIONE ACCORPAMENTOOLO non superata&quot;;&#xD;
	Process.auditLog(EsitoResponse.descrizione);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
