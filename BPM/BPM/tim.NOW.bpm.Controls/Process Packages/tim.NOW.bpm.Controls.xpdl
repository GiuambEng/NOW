        <xpdl2:Activity Id="_UQ6pcTLfEeajbIG7R_HFFQ" Name="VerificaCOS" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica COS" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche.&quot;;&#xD;
&#xD;
var Banda = &quot;&quot;;&#xD;
Banda = null;&#xD;
var equal = true;&#xD;
var i = 0;&#xD;
&#xD;
while(equal &amp;&amp; i &lt; EsistenzaVLANOutput.size())&#xD;
{&#xD;
	var currentEsistenza = EsistenzaVLANOutput.get(i);&#xD;
	if(Banda == null)&#xD;
	{&#xD;
		Banda = currentEsistenza.TIPO_BANDA;&#xD;
	}&#xD;
	else if(Banda != currentEsistenza.TIPO_BANDA)&#xD;
	{&#xD;
		equal = false;&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(equal)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Tutte le VLAN hanno il medesiamo valore TipoBanda.&quot;;	&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Trovate almeno 2 VLAN con TipoBanda differente.&quot;;&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="71.0" LaneId="_UQ40QDLfEeajbIG7R_HFFQ" Width="107.0">
