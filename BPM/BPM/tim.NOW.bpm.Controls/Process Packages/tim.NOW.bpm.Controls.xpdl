    <xpdl2:WorkflowProcess Id="_lV_AoCTAEeaDSLAcjdJJQQ" xpdExt:DisplayName="CTRL TIPO DSLAM_C04M01F37" Name="CTRLTIPODSLAM_C04M01F37">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_lWSioSTAEeaDSLAcjdJJQQ" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_lWBc4CTAEeaDSLAcjdJJQQ" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_lWSioiTAEeaDSLAcjdJJQQ" Name="VerificaTipoDSLAM" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Tipo DSLAM" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var failed = false;&#xD;
&#xD;
if(localRequest.ordine!=null)&#xD;
{	var j=0;&#xD;
	while(!failed &amp;&amp; j&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{	var componente = localRequest.ordine.dettaglioordine.get(j);&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
		{	var k=0;&#xD;
			var protocolloPila=&quot;&quot;;&#xD;
			while(protocolloPila==&quot;&quot; &amp;&amp; k&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{	var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
				if(attributo.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA)&#xD;
				{	protocolloPila=attributo.valoreAttributo;&#xD;
				}&#xD;
				k++;&#xD;
			}&#xD;
&#xD;
			if(EsistenzaVLANOutput != null &amp;&amp; EsistenzaVLANOutput.size() > 0 &amp;&amp; protocolloPila==&quot;IPoE&quot;)&#xD;
			{&#xD;
				var i = 0;&#xD;
				var foundMatch=false;&#xD;
				while(!failed &amp;&amp; i &lt; EsistenzaVLANOutput.size() &amp;&amp; !foundMatch)&#xD;
				{&#xD;
					var currentEsistenza = EsistenzaVLANOutput.get(i);&#xD;
					if(currentEsistenza.IDDettaglioOrdine==componente.IDDettaglioOrdine)&#xD;
					{	foundMatch=true;&#xD;
					}&#xD;
		&#xD;
					if(foundMatch &amp;&amp; currentEsistenza.TIPOLOGIA == &quot;GBE&quot; &amp;&amp; currentEsistenza.FLAG_ENCAPSULATION != &quot;Y&quot; &amp;&amp;&#xD;
					   (currentEsistenza.DSLAM_TYPE == &quot;05&quot; ||&#xD;
						currentEsistenza.DSLAM_TYPE == &quot;08&quot; ||&#xD;
					    currentEsistenza.DSLAM_TYPE == null ||&#xD;
						currentEsistenza.DSLAM_TYPE == &quot;&quot;))&#xD;
					{&#xD;
						failed = true;&#xD;
						Process.auditLog(&quot;Controllo KO. TIPOLOGIA: &quot; + currentEsistenza.TIPOLOGIA + &quot; FLAG_ENCAPSULATION: &quot; + currentEsistenza.FLAG_ENCAPSULATION + &quot; DSLAM_TYPE: &quot; + currentEsistenza.DSLAM_TYPE);&#xD;
					}&#xD;
					i++;&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
		j++;&#xD;
	}&#xD;
}	&#xD;
	&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Tipo DSLAM non ammesso&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Tipi DSLAM ammessi&quot;;&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
