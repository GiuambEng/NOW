        <xpdl2:Activity Id="_-Le_MnsWEeqY8abExM9GzQ" Name="VerificaDataNuovoContratto" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Data Nuovo Contratto">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL DATA NUOVO CONTRATTO: controllo ok&quot;;&#xD;
&#xD;
var DSC = DateTimeUtil.createDate();&#xD;
DSC = null;&#xD;
var DRO = DateTimeUtil.createDate();&#xD;
DRO = null;&#xD;
&#xD;
var dataDSC = '';&#xD;
dataDSC = null;&#xD;
&#xD;
//recupero la DSC da ACCESSOCPS&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);	&#xD;
		if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
		{&#xD;
			var j = 0;&#xD;
			var foundDataDSC = false;&#xD;
			while(!foundDataDSC &amp;&amp; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC)&#xD;
				{&#xD;
					dataDSC = currentAttDettOrdine.valoreAttributo;&#xD;
					foundDataDSC = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(dataDSC != null)&#xD;
{&#xD;
	var giorno = &quot;&quot;;&#xD;
	giorno = dataDSC.slice(0,2);&#xD;
	var mese = &quot;&quot;;&#xD;
	mese = dataDSC.slice(3,5);&#xD;
	var anno = &quot;&quot;;&#xD;
	anno = dataDSC.slice(6,10);&#xD;
	&#xD;
	DSC = DateTimeUtil.createDate(anno+&quot;-&quot;+mese+&quot;-&quot;+giorno);&#xD;
 &#xD;
 	DRO = DateTimeUtil.createDate(localRequest.DRO);&#xD;
 &#xD;
	//RU_1115: la DSC deve essere minore o uguale della DRO, non più solo minore&#xD;
	if(DSC &lt;= DRO)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL DATA NUOVO CONTRATTO: controllo KO: data sottoscrizione nuovo contratto non è inferiore alla DRO&quot;;&#xD;
		codiceEsito = &quot;KO_02&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DATA NUOVO CONTRATTO: controllo KO: data sottoscrizione nuovo contratto non valorizzato&quot;;&#xD;
	codiceEsito = &quot;KO_01&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione+&quot; DSC: &quot;+String(DSC)+&quot;, dataInizioValiditaDATE: &quot;+String(DRO));&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
