                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="__j4dENf-EeqGmsJqIQUu6w" OperationName="Verifica_Dominio_Valori_Banda">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckServiceVlanPortTypeSOAP" ServiceName="BPM_CheckServiceVlanPortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="BPM_CheckServiceVlan.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="BPM_CheckServiceVlanPortType" OperationName="Verifica_Dominio_Valori_Banda">
