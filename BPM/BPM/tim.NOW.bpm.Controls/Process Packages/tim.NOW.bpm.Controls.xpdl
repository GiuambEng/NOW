        <xpdl2:Activity Id="_-r0uIjLPEeajbIG7R_HFFQ" Name="VerificaCongruenzaProfiloVC" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Congruenza Profilo VC" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var failed = false;&#xD;
var offertaTemp = &quot;&quot;;&#xD;
offertaTemp = null;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	if(localRequest.caratteristica != null &amp;&amp; localRequest.caratteristica != &quot;&quot;)&#xD;
	{&#xD;
		offertaTemp = String(localRequest.offerta);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		offertaTemp = String(ConsistenzaDati.offerta);&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	offertaTemp = String(localRequest.offerta);&#xD;
}&#xD;
&#xD;
if(offertaTemp == &quot;BITSTREAMATMASIMMETRICOFLAT&quot;)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!failed &amp;&amp; i &lt; EsistenzaVPOutput.size())&#xD;
	{&#xD;
		var currentEsistenzaVP = EsistenzaVPOutput.get(i);&#xD;
		&#xD;
		if(currentEsistenzaVP.tipo != &quot;Standard&quot; &amp;&amp; currentEsistenzaVP.tipo != &quot;Special&quot;)&#xD;
		{&#xD;
			failed = true;&#xD;
			EsitoResponse.descrizione = &quot;Trovato tipo diverso da Standard e Special per OFFERTA BitstreamAsimmetricoFLAT&quot;;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
else if(offertaTemp == &quot;BITSTREAMATMASIMMETRICOLITE&quot;)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!failed &amp;&amp; i &lt; EsistenzaVPOutput.size())&#xD;
	{&#xD;
		var currentEsistenzaVP = EsistenzaVPOutput.get(i);&#xD;
		&#xD;
		if(currentEsistenzaVP.tipo != &quot;Lite&quot;)&#xD;
		{&#xD;
			failed = true;&#xD;
			EsitoResponse.descrizione = &quot;Trovato tipo diverso da Lite per OFFERTA BitstreamAsimmetricoLITE&quot;;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Requisiti rispettati&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
