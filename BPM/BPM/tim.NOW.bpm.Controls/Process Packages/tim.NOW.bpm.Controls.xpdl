        <xpdl2:Activity Id="_5L_Q0xd1EeqiOYbRIgBdnA" Name="RecuperaCausaleEsitoMultiplo" xpdExt:Visibility="Private" xpdExt:DisplayName="RecuperaCausaleEsitoMultiplo">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_VPkP4OYREeah1rpc5fLt3w" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdExt:OutputMappings MapperContext="SubProcessToProcess" MappingDirection="OUT">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="SubProcessToProcess.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="localRequest.IDAnagraficaCausale">
                    <xpdl2:Actual ScriptGrammar="JavaScript">IDAnagraficaCausale</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:OutputMappings>
              <xpdl2:DataMappings>
