          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_4yL24v09EeWpJNqyLx2N3w" Name="Permutatore2" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Permutatore2">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
  &#xD;
var sizeDO = localRequest.ordine.dettaglioordine.size();&#xD;
var status = 0;&#xD;
var check1 = 0;&#xD;
var check2 = 0;&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA ||&#xD;
	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP ||&#xD;
	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA)&#xD;
{&#xD;
	for(var i=0; i&lt;sizeDO; i++)&#xD;
	{&#xD;
		check1 = 0;&#xD;
		check2 = 0;&#xD;
		if(localRequest.ordine.dettaglioordine.get(i).nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU)&#xD;
		{&#xD;
			var sizeADO = localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.size();&#xD;
	&#xD;
			for(var j=0; j&lt;sizeADO; j++)&#xD;
			{&#xD;
				if((localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).nomeAttributo == &#xD;
					it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO) &amp;&amp;&#xD;
				   (localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).valoreAttributo == &quot;3&quot; ||&#xD;
				   localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).valoreAttributo == &quot;5&quot;))&#xD;
				{&#xD;
					check1 = 1;&#xD;
					break;&#xD;
				}&#xD;
			}&#xD;
			if(check1 == 1)&#xD;
			{&#xD;
				for(var j=0; j&lt;sizeADO; j++)&#xD;
				{&#xD;
					if(localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).nomeAttributo == &#xD;
					   it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEPERMUTATORE2 &amp;&amp;&#xD;
					   localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).valoreAttributo!=null)&#xD;
					{&#xD;
						check2 = 1;&#xD;
						break;&#xD;
					}&#xD;
				}&#xD;
			}			&#xD;
		}&#xD;
		if(check1 != check2)&#xD;
		{&#xD;
			status = 1;&#xD;
			break;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA)&#xD;
{&#xD;
	for(var i=0; i&lt;sizeDO; i++)&#xD;
	{&#xD;
		check1 = 0;&#xD;
		check2 = 0;&#xD;
		if(localRequest.ordine.dettaglioordine.get(i).nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULL)&#xD;
		{&#xD;
			var sizeADO = localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.size();&#xD;
	&#xD;
			for(var j=0; j&lt;sizeADO; j++)&#xD;
			{&#xD;
				if((localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).nomeAttributo == &#xD;
					it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO) &amp;&amp;&#xD;
				   (localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).valoreAttributo == &quot;3&quot; ||&#xD;
				   localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).valoreAttributo == &quot;5&quot;))&#xD;
				{&#xD;
					check1 = 1;&#xD;
					break;&#xD;
				}&#xD;
			}&#xD;
			if(check1 == 1)&#xD;
			{&#xD;
				for(var j=0; j&lt;sizeADO; j++)&#xD;
				{&#xD;
					if(localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).nomeAttributo == &#xD;
					   it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEPERMUTATORE2 &amp;&amp;&#xD;
					   localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).valoreAttributo!=null)&#xD;
					{&#xD;
						check2 = 1;&#xD;
						break;&#xD;
					}&#xD;
				}&#xD;
			}			&#xD;
		}&#xD;
		if(check1 != check2)&#xD;
		{&#xD;
			status = 1;&#xD;
			break;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
if(status == 1)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL PERMUTATORE2 Failed : Specified values of valoreAttributo for nomeAttributo=DESTINAZIONEUSO or &quot;&#xD;
								+ &quot;valoreAttributo for nomeAttributo=POSIZIONEPERMUTATORE2 are incorrect&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL PERMUTATORE2 Successful&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
