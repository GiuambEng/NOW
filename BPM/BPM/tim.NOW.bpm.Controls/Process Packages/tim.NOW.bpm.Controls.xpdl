                        <xpdl2:Actual ScriptGrammar="JavaScript">output.idCausale</xpdl2:Actual>
                      </xpdExt:DataMapping>
                    </xpdExt:DataMappings>
                  </xpdExt:OutputMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_YoQtQBO0EeekW5j-cV6_qA" OperationName="VerificaPresaAppuntamentoDisaggregazione">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckServiceFormaliPortTypeSOAP" ServiceName="BPM_CheckServiceFormaliPortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="BPM_CheckServiceFormali_v1.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
