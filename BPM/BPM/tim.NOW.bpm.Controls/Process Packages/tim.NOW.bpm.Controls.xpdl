        <xpdl2:Activity Id="_mPSlQPdsEeqM0K-BnFm19Q" Name="VerificaVariazioneKit" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Variazione Kit">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var CodiceTDKITRichiesta = &quot;&quot;;&#xD;
CodiceTDKITRichiesta = null;&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
	{	&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
			{&#xD;
				CodiceTDKITRichiesta = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo CODICETDKIT&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(ConsistenzaRaccolta != null &amp;&amp; ConsistenzaRaccolta.codiceTdKit != CodiceTDKITRichiesta)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA VARIAZIONE KIT superato&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA VARIAZIONE KIT fallito&quot;;&#xD;
}</xpdl2:Script>
