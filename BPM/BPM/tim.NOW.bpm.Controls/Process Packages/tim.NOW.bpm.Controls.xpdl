          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaOlInCorsoKitCentraleCos = com_tim_NOW_xsd_ControlliVlan_Factory.createVerifica_Ol_in_corso_su_Kit_Centrale_CosRequestType();&#xD;
&#xD;
VerificaOlInCorsoKitCentraleCos.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
VerificaOlInCorsoKitCentraleCos.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
VerificaOlInCorsoKitCentraleCos.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
VerificaOlInCorsoKitCentraleCos.sottoLavorazione = String(localRequest.tipologiaSottolav); //RU_1180&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
			{&#xD;
				VerificaOlInCorsoKitCentraleCos.codiceTdKit = attributo.valoreAttributo;		&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLLI)&#xD;
			{&#xD;
				VerificaOlInCorsoKitCentraleCos.codiceClli = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
