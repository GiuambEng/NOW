            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ValorizzazioneBMCLightRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createVerifica_Valorizzazione_BmcLight_RequestType();&#xD;
&#xD;
ValorizzazioneBMCLightRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
ValorizzazioneBMCLightRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
ValorizzazioneBMCLightRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCAR)&#xD;
			{&#xD;
				ValorizzazioneBMCLightRequest.identificativoCar = attributo.valoreAttributo;			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BMCLIGHT)&#xD;
			{&#xD;
				ValorizzazioneBMCLightRequest.bmcLight = attributo.valoreAttributo;			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
			{&#xD;
				ValorizzazioneBMCLightRequest.famigliaVlan = attributo.valoreAttributo;			&#xD;
			}&#xD;
			&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
if(LavorazioneRichiesta != null)&#xD;
{&#xD;
	ValorizzazioneBMCLightRequest.idKitAreaCar = LavorazioneRichiesta.idKitAreaCar;&#xD;
}&#xD;
</xpdExt:Information>
