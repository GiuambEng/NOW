EsitoResponse.descrizione = &quot;CTRL CONGRUENZA CCLIB FTTONLY SUPERMACROAREA_C04M01F460 saltato&quot;;&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
