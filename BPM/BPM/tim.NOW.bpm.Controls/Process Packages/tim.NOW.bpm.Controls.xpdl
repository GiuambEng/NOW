            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ControlloProfiloX1X2Request = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createControlloProfiloTecnicoLineaX1X2_RequestType();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	ControlloProfiloX1X2Request.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	ControlloProfiloX1X2Request.lavorazione = String(localRequest.lavorazione);&#xD;
	ControlloProfiloX1X2Request.offerta = String(localRequest.offerta);&#xD;
	ControlloProfiloX1X2Request.sottolavorazione = String(localRequest.tipologiaSottolav);&#xD;
&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
				{&#xD;
					ControlloProfiloX1X2Request.profiloTecnicoLinea = attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
