                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var IdentificativoCOS = &quot;&quot;;&#xD;
IdentificativoCOS = null;&#xD;
var foundBanda = false;&#xD;
&#xD;
//SM_9975&#xD;
var Banda = &quot;&quot;; &#xD;
Banda = null;&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
			{&#xD;
				IdentificativoCOS = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo IDENTIFICATIVOCOS &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
			{&#xD;
				Banda = attributo.valoreAttributo;    //SM_9975&#xD;
				foundBanda = true;&#xD;
				Process.auditLog(&quot;Trovato attributo BANDA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
//SM_9953: modificate logiche di scarto&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
       ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN)&#xD;
   &amp;&amp;(IdentificativoCOS == &quot;3&quot; || IdentificativoCOS == &quot;5&quot;) &amp;&amp; !foundBanda)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA VALORIZZAZIONE BANDA E COS NON SUPERATO, KO_01&quot;;&#xD;
	esitoControllo = &quot;KO_01&quot;;&#xD;
}&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
        &amp;&amp;(IdentificativoCOS == &quot;0&quot; || IdentificativoCOS == &quot;1&quot;) &amp;&amp; (foundBanda &amp;&amp; Banda != &quot;0&quot;))    //SM_9975: BANDA presente e != 0 (corrisponde alla presenza del tag Banda nell'xml in input)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA VALORIZZAZIONE BANDA E COS NON SUPERATO, KO_02&quot;;&#xD;
	esitoControllo = &quot;KO_02&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA VALORIZZAZIONE BANDA E COS SUPERATO&quot;;&#xD;
}&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
