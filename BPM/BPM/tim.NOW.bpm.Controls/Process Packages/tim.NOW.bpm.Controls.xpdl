VerificaCompAggiuntiviApparatiRequest.offerta = String(localRequest.offerta); //SM_11875&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componenteServizio = localRequest.ordine.dettaglioordine.get(i);&#xD;
