        <xpdl2:Activity Id="_2W3zoNJbEeqhn730Y0mNjw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_nJzMgNJbEeqhn730Y0mNjw" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="82.0" LaneId="_iUXuodJbEeqhn730Y0mNjw" Width="45.0">
