        <xpdl2:Activity Id="_qAkHwDMWEeajbIG7R_HFFQ" Name="IPV4Validation" xpdExt:Visibility="Private" xpdExt:DisplayName="IPV4 Validation">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">IPV4_Validator = it_telecomitalia_it_NOW_localbom_Factory.createIPV4_Validator();&#xD;
var IP = &quot;&quot;;&#xD;
IP= null;&#xD;
&#xD;
for(var i = 0; i &lt; VC_IPDSLAM_KIT.size(); i++)&#xD;
{&#xD;
	&#xD;
	IPV4_Validator.IP.add(VC_IPDSLAM_KIT.get(i).IPDSLAM);&#xD;
	&#xD;
	IPV4_Validator.IP.add(VC_IPDSLAM_KIT.get(i).IPKIT);&#xD;
}&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Requisiti rispettati&quot;;</xpdl2:Script>
              </xpdl2:TaskScript>
