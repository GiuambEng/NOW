            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">verificaSpostamentoVlanInput = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaSpostamentoVLAN_RequestType();&#xD;
&#xD;
if(localRequest != null)&#xD;
{&#xD;
	verificaSpostamentoVlanInput.lavorazione = String(localRequest.lavorazione);&#xD;
	verificaSpostamentoVlanInput.offerta = String(localRequest.offerta);&#xD;
	verificaSpostamentoVlanInput.IDRichiestaOLO = localRequest.IDRichiestaOLO; &#xD;
	verificaSpostamentoVlanInput.IDRisorsa = localRequest.IDRisorsa; &#xD;
}&#xD;
&#xD;
//MAPPING CONSRACCOLTA&#xD;
if(ConsistenzaRaccolta != null)&#xD;
{&#xD;
	verificaSpostamentoVlanInput.caratterizzazioneCARcons = ConsistenzaRaccolta.caratteristicaVlan;&#xD;
	verificaSpostamentoVlanInput.supermacroareaCons = ConsistenzaRaccolta.superMacroArea;&#xD;
	verificaSpostamentoVlanInput.nomeMacroAreaCons = ConsistenzaRaccolta.nomeMacroArea;&#xD;
}&#xD;
&#xD;
//MAPPING LAVORAZIONE RICHIESTA&#xD;
if(LavorazioneRichiesta != null)&#xD;
{	&#xD;
	verificaSpostamentoVlanInput.caratterizzazioneCARric = LavorazioneRichiesta.caratteristicaVlan;	&#xD;
	verificaSpostamentoVlanInput.nomeMacroAreaRic = LavorazioneRichiesta.nomeMacroArea;	&#xD;
}&#xD;
&#xD;
//RECUPERO SUPERMACROAREA DA RICHIESTA&#xD;
if(localRequest != null &amp;&amp; localRequest != &quot;&quot; &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine != &quot;&quot;)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA)&#xD;
				{&#xD;
					verificaSpostamentoVlanInput.supermacroareaRic = attributo.valoreAttributo;			&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
