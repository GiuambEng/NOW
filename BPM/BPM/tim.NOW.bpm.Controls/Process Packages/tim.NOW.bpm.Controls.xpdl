          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var strutturaLinea = &quot;&quot;;&#xD;
strutturaLinea = null;&#xD;
&#xD;
var i = 0;&#xD;
while(strutturaLinea == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
