          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaOLOSubContractorNonAccorpatoRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createVerifica_Olo_SubContractor_Non_Accorpato_RequestType();&#xD;
&#xD;
VerificaOLOSubContractorNonAccorpatoRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
VerificaOLOSubContractorNonAccorpatoRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
VerificaOLOSubContractorNonAccorpatoRequest.codiceOloTestata = localRequest.codificaOLONOW;&#xD;
&#xD;
if(ConsistenzaRaccolta != null &amp;&amp; ConsistenzaRaccolta.IDRisorsa != null)&#xD;
{&#xD;
	VerificaOLOSubContractorNonAccorpatoRequest.idRisorsaConsistenza = ConsistenzaRaccolta.IDRisorsa;&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OLOVLAN)&#xD;
	{&#xD;
		var SubContractor = com_tim_NOW_xsd_ControlliVlan_Factory.createSubContractor();&#xD;
	&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOLONUMERICO)&#xD;
			{&#xD;
				SubContractor.codiceOloSubContractor = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo CODICEOLONUMERICO &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AZIONE)&#xD;
			{&#xD;
				SubContractor.azione = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo AZIONE &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			&#xD;
			VerificaOLOSubContractorNonAccorpatoRequest.subContractor.add(SubContractor);&#xD;
		}&#xD;
	}&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
