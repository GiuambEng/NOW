        <xpdl2:Activity Id="_YVAKIhB7Eeyx1J_VnXlGew" Name="VerificaDatiReferentiNPNG" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Dati Referenti NPNG" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL DATI REFERENTI NPNG_C04M01F482 SUPERATO&quot;;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	var TIPOPROVISIONING = &quot;&quot;;&#xD;
	TIPOPROVISIONING = null;&#xD;
&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROVISIONING)&#xD;
				{&#xD;
					TIPOPROVISIONING = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo TIPOPROVISIONING&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
&#xD;
	if(TIPOPROVISIONING != null &amp;&amp; (TIPOPROVISIONING == &quot;1&quot; || TIPOPROVISIONING == &quot;2&quot;))&#xD;
	{&#xD;
		if(localRequest.ordine.referente != null &amp;&amp; localRequest.ordine.referente.size()>0)&#xD;
		{&#xD;
			for(var i=0; i&lt;localRequest.ordine.referente.size(); i++)&#xD;
			{&#xD;
				var currentReferente = localRequest.ordine.referente.get(i);&#xD;
				&#xD;
				if(currentReferente.nomeReferente == null ||currentReferente.nomeReferente == &quot;&quot;&#xD;
					||currentReferente.cognomeReferente == null ||currentReferente.cognomeReferente == &quot;&quot; &#xD;
					||currentReferente.telefonoFissoReferente == null ||currentReferente.telefonoFissoReferente == &quot;&quot;&#xD;
					||currentReferente.faxReferente == null ||currentReferente.faxReferente == &quot;&quot;&#xD;
				    ||currentReferente.emailReferente == null ||currentReferente.emailReferente == &quot;&quot;)&#xD;
				{&#xD;
					EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL DATI REFERENTI NPNG_C04M01F482 FALLITO&quot;;	&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}</xpdl2:Script>
