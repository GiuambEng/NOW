        <xpdl2:Activity Id="_DT8FAAGJEea4VP73EUzo0Q" Name="InitializeNpdOloRequest" xpdExt:Visibility="Private" xpdExt:DisplayName="Initialize NpdOlo Request">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
NpdOloRequest = com_tim_NOW_xsd_ControlliAmmessi_Factory.createVerifica_NPD_OLO_Request();&#xD;
&#xD;
NpdOloRequest.codice_OLO = localRequest.codificaOLONOW;&#xD;
NpdOloRequest.idRichiestaNOW = localRequest.IDRichiestaOLO;&#xD;
&#xD;
NpdOloRequest.servizio = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
&#xD;
if(NpdOloRequest.codice_OLO!=null &amp;&amp; NpdOloRequest.idRichiestaNOW!=null &amp;&amp; NpdOloRequest.servizio!=null)&#xD;
{&#xD;
	FlagInput = true;&#xD;
}&#xD;
else&#xD;
{&#xD;
	FlagInput = false;&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL NPD OLO Failed : Input request could not be formed&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_keAR4vmhEeWxfZ79Ifv7Eg" Width="96.0">
              <xpdl2:Coordinates XCoordinate="165.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
