    <xpdl2:WorkflowProcess Id="_ZV2z4E3DEeaBwvTnZzA0AQ" xpdExt:DisplayName="CTRL FINE CONTATTO_C04M01F75" Name="CTRLFINECONTATTO_C04M01F75">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_ZWBzAk3DEeaBwvTnZzA0AQ" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_ZV3a8E3DEeaBwvTnZzA0AQ" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_ZWBzA03DEeaBwvTnZzA0AQ" Name="VerificaFineContatto" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Fine Contatto">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var found = false;&#xD;
&#xD;
if(targetRequest != null &amp;&amp; targetRequest.ordine != null &amp;&amp; targetRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESO)&#xD;
{&#xD;
	if(targetRequest.ordine.dettaglioordine != null)&#xD;
	{&#xD;
		var i = 0;&#xD;
		while(!found &amp;&amp; i &lt; targetRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = targetRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUFINECONTATTO)&#xD;
			{&#xD;
				found = true;&#xD;
			}&#xD;
			&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUSOSPENSIONE)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(!found &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttrDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAUSALEESITO &amp;&amp; currentAttrDettOrdine.valoreAttributo != &quot;N36&quot;)&#xD;
					{&#xD;
						found = true;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		if(found)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL FINE CONTATTO passed - DTUFINEAPPUNTAMENTO o DTUSOSPENSIONE idoneo trovato.&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL FINE CONTATTO faild - DTUFINEAPPUNTAMENTO e DTUSOSPENSIONE idoneo non trovati.&quot;;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL FINE CONTATTO failed - Nessuna componente trovata.&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL FINE CONTATTO passed.&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
