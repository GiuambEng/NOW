          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
Process.auditLog(&quot;Lavorazione richiesta: &quot; + String(localRequest.lavorazione));&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RISCONTROCODICESESSIONE&#xD;
|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.PRENOTIFICADISATTIVAZIONECPS) //SM_9381: aggiunto prenotifica&#xD;
{&#xD;
	if(targetRequest != null&#xD;
		&amp;&amp; targetRequest.ordine != null&#xD;
		&amp;&amp; targetRequest.ordine.codiceOrdineTI != null)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI OLO passed&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI OLO failed&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	if(targetRequest != null&#xD;
		&amp;&amp; targetRequest.ordine != null&#xD;
		&amp;&amp; targetRequest.ordine.codiceOrdineTI != null&#xD;
		&amp;&amp; targetRequest.ordine.codificaOLONOW == localRequest.codificaOLONOW&#xD;
		&amp;&amp; targetRequest.strutturaRichiesta == localRequest.strutturaRichiesta)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI OLO passed&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI OLO failed&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
/*&#xD;
if(localRequest!=null &amp;&amp; localRequest.codiceOrdineTITarget!=null &amp;&amp; localRequest.codificaOLOAGCOM != null) {&#xD;
