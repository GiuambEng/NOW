                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="output.descrizione">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.descrizione</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_YHMjsCMWEea7qJ_CMNwz5w" OperationName="VerificaSommaBandePicco">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckDatiPortTypeSOAP" ServiceName="BPM_CheckDatiPortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="BPM_CheckServiceDati_concrete_v1.0.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="BPM_CheckDatiPortType" OperationName="VerificaSommaBandePicco">
                  <xpdExt:ExternalReference location="BPM_CheckServiceDati_concrete_v1.0.wsdl"/>
                </xpdExt:PortTypeOperation>
