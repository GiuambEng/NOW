        <xpdl2:Activity Id="_2CJbAn_AEeqvvKm_Ydj5SQ" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//SM_9504: eliminata dalla precondizione &quot;MIGRAZIONE VULA FTTCAB Linea Non Fonia / Linea POTS&quot; &#xD;
//ed eliminata Linea POTS da &quot;ATTIVAZIONE VULA FTTCAB Linea Non Fonia / Linea POTS&quot;&#xD;
//Erano state inserite con la R1I-20-0131&#xD;
&#xD;
eseguiControllo = false;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
   &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
	   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
	   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA&#xD;
	   || (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
	       &amp;&amp; localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.LINEANONFONIA)))&#xD;
{&#xD;
	&#xD;
	//inserito con SM_9440: prima si controllava la presenza della componente APPUNTAMENTODISAGGREGAZIONE&#xD;
	if(localRequest.disaggregato == &quot;S&quot;)&#xD;
	{&#xD;
		eseguiControllo = true;&#xD;
	}&#xD;
	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_k3UGsX_AEeqvvKm_Ydj5SQ" Width="143.0">
