        <xpdl2:Activity Id="_EM7JcshtEeu1QaGg3OOQiA" Name="ValorizzazioneCampiCanaleFeeder" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Valorizzazione Campi Canale Feeder" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE CAMPI CANALE FEEDER_C04M01F468 SUPERATO&quot;;&#xD;
&#xD;
var foundIDRISORSA = false;&#xD;
var foundIPMULTICAST = false;&#xD;
var foundIPSORGENTE = false;&#xD;
var foundBANDA = false;&#xD;
&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
			{&#xD;
				foundIDRISORSA = true;		&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPMULTICAST)&#xD;
			{&#xD;
				foundIPMULTICAST = true;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPSORGENTE)&#xD;
			{&#xD;
				foundIPSORGENTE = true;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
			{&#xD;
				foundBANDA = true;&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
//Se non c'è IDRISORSA, devono essere valorizzati tutti e 3 gli altri -> altrimenti scarto&#xD;
if(!foundIDRISORSA &amp;&amp; !(foundIPMULTICAST &amp;&amp; foundIPSORGENTE &amp;&amp; foundBANDA))   //SM_10523: fixato refuso &#xD;
{&#xD;
	CodiceEsito = &quot;KO_01&quot;;&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE CAMPI CANALE FEEDER_C04M01F468 NON SUPERATO&quot;;&#xD;
}&#xD;
//Se c'è IDRISORSA, allora se ne trova uno dei 3 scarta&#xD;
else if(foundIDRISORSA &amp;&amp; (foundIPMULTICAST || foundIPSORGENTE || foundBANDA))   //SM_10523: fixato refuso &#xD;
{&#xD;
	CodiceEsito = &quot;KO_02&quot;;&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE CAMPI CANALE FEEDER_C04M01F468 NON SUPERATO&quot;;&#xD;
}&#xD;
&#xD;
&#xD;
</xpdl2:Script>
