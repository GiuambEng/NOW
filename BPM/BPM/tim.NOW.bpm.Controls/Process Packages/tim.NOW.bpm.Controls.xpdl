          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
OlInCorsoRequest = com_tim_NOW_xsd_ControlliAmmessi_Factory.createVerifica_OL_In_Corso_Request();&#xD;
&#xD;
OlInCorsoRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
OlInCorsoRequest.codiceOLO = localRequest.codificaOLONOW;&#xD;
OlInCorsoRequest.codificaOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
if (localRequest.codiceOrdineOLO!= null &amp;&amp; localRequest.codiceOrdineOLO!= &quot;&quot;)&#xD;
{&#xD;
	OlInCorsoRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
}&#xD;
else &#xD;
{&#xD;
	OlInCorsoRequest.codiceOrdineOLO = &quot;NonValorizzatoDaOLO&quot;;&#xD;
}&#xD;
OlInCorsoRequest.lavorazione = String(localRequest.lavorazione);&#xD;
if (localRequest.ordine.tipologiaSottolav != null &amp;&amp; localRequest.ordine.tipologiaSottolav != &quot;&quot;)&#xD;
{&#xD;
	OlInCorsoRequest.sottoLavorazione = String(localRequest.ordine.tipologiaSottolav);&#xD;
}	&#xD;
&#xD;
if(localRequest.tipologiaScenario != null)&#xD;
{&#xD;
	OlInCorsoRequest.scenario = String(localRequest.tipologiaScenario);&#xD;
}&#xD;
&#xD;
if(DatiAccesso != null)&#xD;
{&#xD;
	OlInCorsoRequest.idRisorsa = DatiAccesso.idRisorsaNow;&#xD;
	OlInCorsoRequest.idAsset = DatiAccesso.idAsset;&#xD;
	OlInCorsoRequest.idOfferta = DatiAccesso.identificativoOffertaAsset;&#xD;
}&#xD;
else if(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL &amp;&amp; &#xD;
localRequest.tipoRichiesta != it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.RICARICA)&#xD;
{&#xD;
	var i = 0;&#xD;
	&#xD;
	while(OlInCorsoRequest.idAsset == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI&#xD;
			|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			var j = 0;&#xD;
			&#xD;
			while(OlInCorsoRequest.idAsset == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					OlInCorsoRequest.idAsset = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	var asset = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(OlInCorsoRequest.idAsset)).readAsset();&#xD;
	&#xD;
	OlInCorsoRequest.idRisorsa = asset.IDRisorsa;&#xD;
	OlInCorsoRequest.idOfferta = asset.IDOfferta;&#xD;
}&#xD;
else if (localRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.RICARICA)&#xD;
{&#xD;
	OlInCorsoRequest.idRisorsa = localRequest.IDRisorsa;&#xD;
	OlInCorsoRequest.idOfferta = localRequest.IDOfferta;&#xD;
	OlInCorsoRequest.idAsset = IDAssetAccessoDinamico;&#xD;
&#xD;
}&#xD;
//Id risorsa correlato per BTS in cessazione WLR&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp;&#xD;
	   (String(localRequest.offerta).slice(0,3) == &quot;WLR&quot; || String(localRequest.offerta).slice(0,3) == &quot;ULL&quot; || String(localRequest.offerta).slice(0,3) == &quot;SLU&quot; || String(localRequest.offerta).slice(0,4) == &quot;VULL&quot;) //SM_8573: aggiunti ULL/SLU/VULL&#xD;
		&amp;&amp; ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null&#xD;
		&amp;&amp; ConsistenzaDati.offerta != it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SHACONMANODOPERA&#xD;
		&amp;&amp; ConsistenzaDati.offerta != it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SHASENZAMANODOPERA)&#xD;
{&#xD;
	OlInCorsoRequest.idRisorsaCorrelata = ConsistenzaDati.IDRisorsa;&#xD;
}	</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(EsitoResponse.codice)&#xD;
{&#xD;
	var assetTarget = it_telecomitalia_it_NOW_casedata_Factory.createAssetTarget();&#xD;
	&#xD;
	assetTarget.IDAsset = ScriptUtil.createBigInteger(OlInCorsoRequest.idAsset);&#xD;
	assetTarget.flagInLavorazione = true;&#xD;
	&#xD;
	localRequest.assetTarget.add(ScriptUtil.copy(assetTarget));&#xD;
	&#xD;
	if(IDAssetNP != null)&#xD;
	{&#xD;
		assetTarget.IDAsset = ScriptUtil.createBigInteger(IDAssetNP);&#xD;
		assetTarget.flagInLavorazione = true;&#xD;
		&#xD;
		localRequest.assetTarget.add(ScriptUtil.copy(assetTarget));&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
