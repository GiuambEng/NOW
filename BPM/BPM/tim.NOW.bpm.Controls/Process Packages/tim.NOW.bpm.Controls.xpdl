        <xpdl2:Activity Id="_JTqBIq_8EeeHDeOkRvGnAA" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo=false;&#xD;
TrovatoModem= false;&#xD;
&#xD;
if(localRequest.cambioTecnologia == 'S') //RU_897&#xD;
{&#xD;
	EseguiControllo= true;&#xD;
}&#xD;
&#xD;
if (localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTO&#xD;
&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDAD&#xD;
&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CANCELLAZIONEACCODAMENTO&#xD;
&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.INTERRUZIONESOSPENSIONE&#xD;
&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.STATOAVANZAMENTO&#xD;
&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.INTERRUZIONEMIGRAZIONE&#xD;
&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDAC                 //Task #33973: escluse RIMODULAZIONEDAC e RIMODULAZIONEDACDARECIPIENT&#xD;
&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDACDARECIPIENT)&#xD;
{&#xD;
	if (localRequest.codiceProgetto != null &amp;&amp; localRequest.codiceProgetto.length > 0)&#xD;
	&#xD;
	{&#xD;
		EseguiControllo= true;&#xD;
	}&#xD;
	&#xD;
// PER SM_8301 COMMENTATE OFFERTE BTS ATM / GBE SIMMETRICO: MODEM VA CONTROLLATO SOLO PER BTS ATM / GBE ASIMMETRICO E PER EASYIP&#xD;
	if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp; &#xD;
		(localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICO ||&#xD;
		localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT ||&#xD;
		localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL ||&#xD;
		//localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICO ||&#xD;
		localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE ||&#xD;
		//localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT ||&#xD;
		//localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL ||&#xD;
		//localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICO ||&#xD;
		//localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT ||&#xD;
		localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT ||&#xD;
		localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT ||&#xD;
		localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUS ||&#xD;
		localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT ||&#xD;
		localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE ||&#xD;
		localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILE ||&#xD;
		localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT ||&#xD;
		localRequest.ordine.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE))&#xD;
		{&#xD;
			&#xD;
			var i=0;&#xD;
			while (!TrovatoModem &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if( currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.MODEM )&#xD;
					{&#xD;
					TrovatoModem=true;&#xD;
					EseguiControllo=true;&#xD;
					}&#xD;
			i++;&#xD;
			}&#xD;
	&#xD;
		}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
