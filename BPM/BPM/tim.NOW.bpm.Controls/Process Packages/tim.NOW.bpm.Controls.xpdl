                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="__j4dENf-EeqGmsJqIQUu6w" OperationName="Verifica_Coerenza_MacroArea">
