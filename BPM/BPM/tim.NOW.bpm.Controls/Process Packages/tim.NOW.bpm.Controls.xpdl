        </xpdl2:Activity>
        <xpdl2:Activity Id="_A2LKcNJkEeqLn70Ph9PbVA" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_yJf6oNJjEeqLn70Ph9PbVA" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_sdHmodJjEeqLn70Ph9PbVA" Width="58.0">
              <xpdl2:Coordinates XCoordinate="60.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_C7OycNJkEeqLn70Ph9PbVA" Name="CheckPrecondizione" xpdExt:DisplayName="Check Precondizione">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_EU-zo9JkEeqLn70Ph9PbVA"/>
                  <xpdl2:TransitionRef Id="_HOsLs9JkEeqLn70Ph9PbVA"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="76.0" LaneId="_sdHmodJjEeqLn70Ph9PbVA" Width="77.0">
              <xpdl2:Coordinates XCoordinate="375.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_EU-zotJkEeqLn70Ph9PbVA" Name="VerificaunivocitIDVLANOLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica univocità ID VLAN OLO" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL UNIVOCITA ID VLAN OLO_C04M01F431 passato&quot;;&#xD;
&#xD;
assetDati = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
assetDati = null;&#xD;
&#xD;
currentRequest = it_telecomitalia_it_NOW_casedata_Factory.createRichiesta();  //SM_9806&#xD;
currentRequest = null;                                                        //SM_9806&#xD;
&#xD;
var CODICETDKITric = &quot;&quot;;&#xD;
CODICETDKITric = null;&#xD;
var IDENTIFICATIVOVLANOLOric =  &quot;&quot;;&#xD;
IDENTIFICATIVOVLANOLOric = null;&#xD;
&#xD;
//Cerca CODICETDKIT e IDENTIFICATIVOVLANOLO&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(currentDettOrdine.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;&#xD;
	   ||currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOFEEDER)    //RU_1180&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
			{&#xD;
				CODICETDKITric = currentAttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;CODICETDKITric: &quot;+CODICETDKITric);&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOVLANOLO)&#xD;
			{&#xD;
				IDENTIFICATIVOVLANOLOric = currentAttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;IDENTIFICATIVOVLANOLOric: &quot;+IDENTIFICATIVOVLANOLOric);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(CODICETDKITric != null &amp;&amp; IDENTIFICATIVOVLANOLOric != null)&#xD;
{&#xD;
	//------------------------------------------------- RICERCA NELL'ENTITà ASSET -------------------------------------------------------------------&#xD;
	//Recupero tutti gli asset che hanno quel CODICETDKIT&#xD;
	//RU_1180: aggiunta offerta FEEDER nella cac&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;dettaglioasset.attributidettaglioasset.nomeAttributo = 'CODICETDKIT' AND dettaglioasset.attributidettaglioasset.valoreAttributo=:CODICETDKITric AND statoAsset IN ('ATTIVO', 'INLAVORAZIONE') AND offerta IN ('VLANVULA', 'VLAN', 'VLANNGA', 'FEEDER')&quot;);    //SM_9985: aggiunta condizione su statoAsset&#xD;
	c.setQueryParameter(&quot;CODICETDKITric&quot;,CODICETDKITric);&#xD;
	var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
	&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		var i = 0;&#xD;
		while(EsitoResponse.codice &amp;&amp; i &lt; result.size())&#xD;
		{&#xD;
			assetDatiRef = result.get(i);&#xD;
			assetDati = ScriptUtil.copy(assetDatiRef.readAsset());&#xD;
			Process.auditLog(&quot;Ciclo su asset: &quot;+String(assetDati.IDAsset));&#xD;
			&#xD;
			var k = 0;&#xD;
			var IDENTIFICATIVOVLANOLOasset = &quot;&quot;;&#xD;
			IDENTIFICATIVOVLANOLOasset = null;&#xD;
			&#xD;
			while(EsitoResponse.codice &amp;&amp; IDENTIFICATIVOVLANOLOasset == null &amp;&amp; k &lt; assetDati.dettaglioasset.size())&#xD;
			{&#xD;
				var componente = assetDati.dettaglioasset.get(k);&#xD;
				&#xD;
				if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;&#xD;
				   || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOFEEDER)  //RU_1180&#xD;
				{&#xD;
					for(var j = 0; j &lt; componente.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var attributo = componente.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOVLANOLO)&#xD;
						{&#xD;
							IDENTIFICATIVOVLANOLOasset = attributo.valoreAttributo;&#xD;
							Process.auditLog(&quot;IDENTIFICATIVOVLANOLOasset: &quot;+IDENTIFICATIVOVLANOLOasset);&#xD;
							&#xD;
							if(IDENTIFICATIVOVLANOLOasset == IDENTIFICATIVOVLANOLOric)&#xD;
							{&#xD;
								EsitoResponse.codice = false;&#xD;
								EsitoResponse.descrizione = &quot;CTRL UNIVOCITA ID VLAN OLO_C04M01F431 fallito: trovato Asset con CODICETDKIT =&quot;+CODICETDKITric+&quot; e IDENTIFICATIVOVLANOLO =&quot;+IDENTIFICATIVOVLANOLOric+&quot;, con IDAsset =&quot;+String(assetDati.IDAsset);&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				k++;&#xD;
			}&#xD;
			&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL UNIVOCITA ID VLAN OLO_C04M01F431 passato: nessun asset trovato con CODICETDKIT =&quot;+CODICETDKITric;	&#xD;
	}	&#xD;
	&#xD;
	&#xD;
	//--------------------------------------------- RICERCA NELL'ENTITà ORDINE : aggiunta con SM_9806 -------------------------------------------------------------------&#xD;
	//Recupero tutti gli ordini che hanno quel CODICETDKIT&#xD;
	if(EsitoResponse.codice)      //se non ha scartato prima&#xD;
	{&#xD;
		var c = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;ordine.dettaglioordine.attributiDettaglioOrdine.nomeAttributo = 'CODICETDKIT' AND ordine.dettaglioordine.attributiDettaglioOrdine.valoreAttributo=:CODICETDKITric AND IDRichiestaOLO &lt;>: PVM AND statoRichiestaNOW NOT IN ('SCARTATO','PERVENUTO','ESPLETAMENTOTECNICOKO','CHIUSO','ESPLETAMENTOTECNICO','FATTURAZIONEKO','INVIATOAFATTURAZIONE')&quot;);&#xD;
		c.setQueryParameter(&quot;CODICETDKITric&quot;,CODICETDKITric);&#xD;
		c.setQueryParameter(&quot;PVM&quot;,localRequest.IDRichiestaOLO);&#xD;
		var result = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(c);&#xD;
		&#xD;
		if(result != null &amp;&amp; result.size() > 0)&#xD;
		{&#xD;
			var i = 0;&#xD;
			while(EsitoResponse.codice &amp;&amp; i &lt; result.size())&#xD;
			{&#xD;
				currentRequestRef = result.get(i);&#xD;
				currentRequest = ScriptUtil.copy(currentRequestRef.readRichiesta());&#xD;
				Process.auditLog(&quot;Ciclo su ordine: &quot;+String(currentRequest.IDRichiestaOLO));&#xD;
				&#xD;
				var k = 0;&#xD;
				var IDENTIFICATIVOVLANOLO = &quot;&quot;;&#xD;
				IDENTIFICATIVOVLANOLO = null;&#xD;
				&#xD;
				while(EsitoResponse.codice &amp;&amp; IDENTIFICATIVOVLANOLO == null &amp;&amp; k &lt; currentRequest.ordine.dettaglioordine.size())&#xD;
				{&#xD;
					var componente = currentRequest.ordine.dettaglioordine.get(k);&#xD;
					&#xD;
					if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;&#xD;
					   || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOFEEDER)  //RU_1180&#xD;
					{&#xD;
						for(var j = 0; j &lt; componente.attributiDettaglioOrdine.size(); j++)&#xD;
						{&#xD;
							var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
							&#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOVLANOLO)&#xD;
							{&#xD;
								IDENTIFICATIVOVLANOLO = attributo.valoreAttributo;&#xD;
								Process.auditLog(&quot; Altro ordine con IDENTIFICATIVOVLANOLO trovato: &quot;+IDENTIFICATIVOVLANOLO);&#xD;
								&#xD;
								if(IDENTIFICATIVOVLANOLO == IDENTIFICATIVOVLANOLOric)&#xD;
								{&#xD;
									EsitoResponse.codice = false;&#xD;
									EsitoResponse.descrizione = &quot;CTRL UNIVOCITA ID VLAN OLO_C04M01F431 fallito: trovato ordine con CODICETDKIT =&quot;+CODICETDKITric+&quot; e IDENTIFICATIVOVLANOLO =&quot;+IDENTIFICATIVOVLANOLOric+&quot;, con IDAsset =&quot;+String(localRequest.IDRichiestaOLO);&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
					k++;&#xD;
				}&#xD;
				&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL UNIVOCITA ID VLAN OLO_C04M01F431 passato: nessun ordine trovato con CODICETDKIT =&quot;+CODICETDKITric;	&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
