          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaCarrierOLOCPSRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaCarrierOloCPS_RequestType();&#xD;
&#xD;
VerificaCarrierOLOCPSRequest.codiceCarrierUnica = CarrierUnica;&#xD;
VerificaCarrierOLOCPSRequest.codificaOloAgcom = localRequest.codificaOLOAGCOM;&#xD;
VerificaCarrierOLOCPSRequest.idRichiesta = localRequest.IDRichiestaOLO;&#xD;
VerificaCarrierOLOCPSRequest.lavorazione = String(localRequest.lavorazione);&#xD;
VerificaCarrierOLOCPSRequest.offerta = String(localRequest.offerta);&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);	&#xD;
		if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECARRIEROLO)&#xD;
				{&#xD;
					VerificaCarrierOLOCPSRequest.codiceCarrierOlo = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				//RU_975&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOLOCESS)&#xD;
				{&#xD;
					VerificaCarrierOLOCPSRequest.codificaOloAgcomRientroInTI = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
