              <xpdExt:Information ScriptGrammar="JavaScript">VerificaIdGponCoinvestimentoTipologiaAccessoUBBRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaIdGponCoinvestimentoTipologiaAccessoUBB_RequestType();&#xD;
&#xD;
VerificaIdGponCoinvestimentoTipologiaAccessoUBBRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaIdGponCoinvestimentoTipologiaAccessoUBBRequest.lavorazione = String(localRequest.lavorazione);&#xD;
VerificaIdGponCoinvestimentoTipologiaAccessoUBBRequest.offerta = String(localRequest.offerta);&#xD;
VerificaIdGponCoinvestimentoTipologiaAccessoUBBRequest.codiceOloAGCOM = localRequest.codificaOLOAGCOM;&#xD;
VerificaIdGponCoinvestimentoTipologiaAccessoUBBRequest.gestioneAutonoma = localRequest.gestioneAutonoma; //RU_1393&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
