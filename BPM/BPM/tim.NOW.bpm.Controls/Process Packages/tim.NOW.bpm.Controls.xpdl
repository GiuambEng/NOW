          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaCompatibilitaRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaCompatibilitaProfiloTecnicoLineaProfiloVCRequest();&#xD;
&#xD;
VerificaCompatibilitaRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaCompatibilitaRequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
VerificaCompatibilitaRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
VerificaCompatibilitaRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
&#xD;
if (localRequest.lavorazione != &quot;&quot; &amp;&amp; localRequest != null) {&#xD;
	VerificaCompatibilitaRequest.lavorazione = String(localRequest.lavorazione);&#xD;
}&#xD;
&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
	{&#xD;
		var VC = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVC_CompatibilitaProfiloTecnicoLineaProfiloVC();&#xD;
		VC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
		&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRDOWN)&#xD;
			{&#xD;
				VC.MCRDown = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRUP)&#xD;
			{&#xD;
				VC.MCRUp = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRDOWN)&#xD;
			{&#xD;
				VC.PCRDown = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRUP)&#xD;
			{&#xD;
				VC.PCRUp = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SCRDOWN)&#xD;
			{&#xD;
				VC.SCRDown = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SCRUP)&#xD;
			{&#xD;
				VC.SCRUp = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC)&#xD;
			{&#xD;
				VC.tipoProfiloVC = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
			{&#xD;
				VC.VCI = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
			{&#xD;
				VC.VPI = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		VerificaCompatibilitaRequest.VC_CompatibilitaProfiloTecnicoLineaProfiloVC.add(ScriptUtil.copy(VC));&#xD;
	}&#xD;
	else if(VerificaCompatibilitaRequest.profiloTecnicoLinea == null &amp;&amp; String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var z = 0;&#xD;
		while(VerificaCompatibilitaRequest.profiloTecnicoLinea == null &amp;&amp; z &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdineProfilo = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
			if(currentAttDettOrdineProfilo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
			{&#xD;
				VerificaCompatibilitaRequest.profiloTecnicoLinea = currentAttDettOrdineProfilo.valoreAttributo;&#xD;
			}&#xD;
			z++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
if(VerificaCompatibilitaRequest.profiloTecnicoLinea == null || VerificaCompatibilitaRequest.profiloTecnicoLinea == &quot;&quot;)&#xD;
{&#xD;
	VerificaCompatibilitaRequest.profiloTecnicoLinea = ConsistenzaDati.profiloTecnicoLinea;&#xD;
}&#xD;
&#xD;
if (ConsistenzaDati!=null &amp;&amp; ConsistenzaDati.IDAsset!=null &amp;&amp; ConsistenzaDati.IDAsset!=&quot;&quot;){&#xD;
	VerificaCompatibilitaRequest.idAsset = ScriptUtil.NUM(ConsistenzaDati.IDAsset);&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">	if(localRequest.ordine != null)&#xD;
	{&#xD;
		for(var i = 0; i &lt; ProfiloVCResponse.size(); i++)&#xD;
		{&#xD;
			if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
				||&#xD;
				localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
				||&#xD;
				localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
				||&#xD;
				localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
				||&#xD;
				localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
				||&#xD;
				localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL&#xD;
				||&#xD;
				localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
				)&#xD;
				{&#xD;
			&#xD;
					var foundIDPROFILOVC = false;&#xD;
					var j = 0;&#xD;
				&#xD;
					while(!foundIDPROFILOVC &amp;&amp; j &lt; localRequest.ordine.dettaglioordine.size())&#xD;
					{&#xD;
						var currentDettOrdine = localRequest.ordine.dettaglioordine.get(j);&#xD;
						&#xD;
						if(currentDettOrdine.IDDettaglioOrdine == ProfiloVCResponse.get(i).IDDettaglioOrdine) 		&#xD;
						{&#xD;
							var z = 0;&#xD;
							while(!foundIDPROFILOVC &amp;&amp; z &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
							{&#xD;
								var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
								if (currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDPROFILOVC)&#xD;
								{&#xD;
									foundIDPROFILOVC = true;&#xD;
									localRequest.ordine.dettaglioordine.get(j).attributiDettaglioOrdine.get(z).valoreAttributo = ProfiloVCResponse.get(i).idProfiloVC;&#xD;
								}&#xD;
								z++;&#xD;
							}&#xD;
							&#xD;
							if(!foundIDPROFILOVC)&#xD;
							{&#xD;
								var ora = DateTimeUtil.createDatetime();&#xD;
										&#xD;
								var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
								nuovoAttributo.IDDettaglioOrdine = ProfiloVCResponse.get(i).IDDettaglioOrdine;&#xD;
								nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
								nuovoAttributo.created = ora;&#xD;
								nuovoAttributo.lastUpdate = ora;&#xD;
								nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDPROFILOVC;&#xD;
								nuovoAttributo.operatore = localRequest.operatore;&#xD;
								nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
								nuovoAttributo.valoreAttributo = ProfiloVCResponse.get(i).idProfiloVC;&#xD;
								&#xD;
								localRequest.ordine.dettaglioordine.get(j).attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
								&#xD;
								foundIDPROFILOVC = true;&#xD;
							}&#xD;
						}&#xD;
					j++;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				// VALORIZZAZIONE PCRUP E DOWN PER SIMMETRICI (se non è presente l'attributo viene creato con il valore restituito dal controllo)&#xD;
				if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
				||&#xD;
				localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL&#xD;
				||&#xD;
				localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)&#xD;
				{&#xD;
			&#xD;
					var foundPCRUP = false;&#xD;
					var foundPCRDOWN = false;&#xD;
					var j = 0;&#xD;
				&#xD;
					while((!foundPCRUP || !foundPCRDOWN) &amp;&amp; j &lt; localRequest.ordine.dettaglioordine.size())&#xD;
					{&#xD;
						var currentDettOrdine = localRequest.ordine.dettaglioordine.get(j);&#xD;
						&#xD;
						if(currentDettOrdine.IDDettaglioOrdine == ProfiloVCResponse.get(i).IDDettaglioOrdine) 		&#xD;
						{&#xD;
							var z = 0;&#xD;
							while((!foundPCRUP || !foundPCRDOWN) &amp;&amp; z &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
							{&#xD;
								var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
								if (currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRDOWN)&#xD;
								{&#xD;
									foundPCRDOWN = true;&#xD;
								}&#xD;
								else if (currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRUP)&#xD;
								{&#xD;
									foundPCRUP = true;&#xD;
								}&#xD;
								z++;&#xD;
							}&#xD;
							&#xD;
							if(!foundPCRDOWN)&#xD;
							{&#xD;
								var ora = DateTimeUtil.createDatetime();&#xD;
										&#xD;
								var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
								nuovoAttributo.IDDettaglioOrdine = ProfiloVCResponse.get(i).IDDettaglioOrdine;&#xD;
								nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
								nuovoAttributo.created = ora;&#xD;
								nuovoAttributo.lastUpdate = ora;&#xD;
								nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRDOWN;&#xD;
								nuovoAttributo.operatore = localRequest.operatore;&#xD;
								nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
								nuovoAttributo.valoreAttributo = ProfiloVCResponse.get(i).PCRUp;&#xD;
								&#xD;
								localRequest.ordine.dettaglioordine.get(j).attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
								&#xD;
								foundPCRDOWN = true;&#xD;
							}&#xD;
							&#xD;
							if(!foundPCRUP)&#xD;
							{&#xD;
								var ora = DateTimeUtil.createDatetime();&#xD;
										&#xD;
								var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
								nuovoAttributo.IDDettaglioOrdine = ProfiloVCResponse.get(i).IDDettaglioOrdine;&#xD;
								nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
								nuovoAttributo.created = ora;&#xD;
								nuovoAttributo.lastUpdate = ora;&#xD;
								nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRUP;&#xD;
								nuovoAttributo.operatore = localRequest.operatore;&#xD;
								nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
								nuovoAttributo.valoreAttributo = ProfiloVCResponse.get(i).PCRUp;&#xD;
								&#xD;
								localRequest.ordine.dettaglioordine.get(j).attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
								&#xD;
								foundPCRUP = true;&#xD;
							}&#xD;
						}&#xD;
					j++;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
		}		&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Nessun ordine presente nella richiesta&quot;);&#xD;
	}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
