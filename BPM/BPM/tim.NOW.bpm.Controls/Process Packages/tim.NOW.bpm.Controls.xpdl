      <xpdl2:Activities>
        <xpdl2:Activity Id="_isj01jL5EeajbIG7R_HFFQ" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_isgxgjL5EeajbIG7R_HFFQ" Width="31.0">
              <xpdl2:Coordinates XCoordinate="924.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_isj01zL5EeajbIG7R_HFFQ" Name="VerificaIP_DSLAMeIP_KIT" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica IP_DSLAM e IP_KIT">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
&#xD;
// -------------------------------------------------------------------------ATTIVAZIONE/MIGRAZIONE------------------------------------------------------------------------&#xD;
&#xD;
if( localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &#xD;
|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
{&#xD;
	&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
		{&#xD;
			var VC = it_telecomitalia_it_NOW_localbom_Factory.createVC_IPDSLAM_KIT();&#xD;
			&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA)&#xD;
				{&#xD;
					VC.protocolloPila = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPDSLAM)&#xD;
				{&#xD;
					VC.IPDSLAM = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPKIT)&#xD;
				{&#xD;
					VC.IPKIT = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			&#xD;
			if (VC.protocolloPila == null)&#xD;
			{&#xD;
				VC.protocolloPila = &quot;ISNULL&quot;;&#xD;
			}&#xD;
			if ( VC.IPDSLAM == null )&#xD;
			{&#xD;
				VC.IPDSLAM=&quot;&quot;;&#xD;
			}&#xD;
			if ( VC.IPKIT == null )&#xD;
			{&#xD;
				VC.IPKIT=&quot;&quot;;&#xD;
			}&#xD;
			&#xD;
			&#xD;
			VC_IPDSLAM_KIT.add(ScriptUtil.copy(VC));&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	var failed = false;&#xD;
	&#xD;
	if(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.GUI)&#xD;
	{&#xD;
		var z = 0;&#xD;
		while(!failed &amp;&amp; z &lt; VC_IPDSLAM_KIT.size())&#xD;
		{&#xD;
			var currentVC = VC_IPDSLAM_KIT.get(z);&#xD;
			&#xD;
			if(currentVC.protocolloPila == &quot;IPoA&quot;)&#xD;
			{&#xD;
				if(currentVC.IPDSLAM != null &amp;&amp; currentVC.IPDSLAM.length > 0 &amp;&amp; currentVC.IPKIT != null &amp;&amp; currentVC.IPKIT.length > 0)&#xD;
				{&#xD;
					checkIPV4 = true;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					failed = true;&#xD;
					EsitoResponse.descrizione = &quot;Richiesta proveniente da GUI con ProtocolloPila IPoA ma con IPDSLAM o IPKIT mancanti&quot;;&#xD;
				}&#xD;
			}&#xD;
			z++;&#xD;
		}&#xD;
	}&#xD;
	else if(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.FILE&#xD;
			|| (localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL&#xD;
			 &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)) // SM_8935&#xD;
	{&#xD;
		var z = 0;&#xD;
		&#xD;
		while(!failed &amp;&amp; z &lt; VC_IPDSLAM_KIT.size())&#xD;
		{&#xD;
			var currentVC = VC_IPDSLAM_KIT.get(z);&#xD;
			&#xD;
			if(currentVC.protocolloPila == &quot;IPoA&quot;)&#xD;
			{&#xD;
				if(currentVC.IPDSLAM != null &amp;&amp; currentVC.IPDSLAM.length > 0 &amp;&amp; currentVC.IPKIT != null &amp;&amp; currentVC.IPKIT.length > 0)&#xD;
				{&#xD;
					checkIPV4 = true;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					failed = true;&#xD;
					EsitoResponse.descrizione = &quot;Richiesta proveniente da FILE con ProtocolloPila IPoA ma con IPDSLAM o IPKIT mancanti&quot;;&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				if(currentVC.IPDSLAM != &quot;&quot; || currentVC.IPKIT != &quot;&quot;)&#xD;
				{&#xD;
					failed = true;&#xD;
					EsitoResponse.descrizione = &quot;Richiesta proveniente da FILE con ProtocolloPila diverso da IPoA ma con IPDSLAM o IPKIT valorizzato&quot;;&#xD;
				}&#xD;
			}&#xD;
		z++;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		failed = true;&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Canale non conforme al requisito (GUI o FILE): &quot; + String(localRequest.canaleRichiesta);&#xD;
	}&#xD;
	&#xD;
	if(failed)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
	}&#xD;
	else if(!checkIPV4)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Requisiti rispettati&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
// -------------------------------------------------------------------------VARIAZIONE------------------------------------------------------------------------&#xD;
&#xD;
&#xD;
else if( localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	//RICERCO IL VALORE PROTOCOLLOPILA DALLA CONSISTENZA&#xD;
	&#xD;
	if(ConsistenzaDati!= null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaDati.IDAsset));&#xD;
		Asset = AssetRef.readAsset();&#xD;
		var ProtocolloPila = &quot;&quot;;&#xD;
		ProtocolloPila = null;&#xD;
		&#xD;
		var i=0;&#xD;
		&#xD;
		while (ProtocolloPila == null &amp;&amp; i&lt; Asset.dettaglioasset.size())&#xD;
		{&#xD;
			var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
			&#xD;
			if (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
				{&#xD;
					var j=0;&#xD;
					while (ProtocolloPila == null &amp;&amp; j&lt;currentDettAsset.attributidettaglioasset.size())&#xD;
					{&#xD;
						var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if (currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA)&#xD;
						{&#xD;
							ProtocolloPila = currentAttDettAsset.valoreAttributo;&#xD;
						}&#xD;
						&#xD;
					j++;&#xD;
					}&#xD;
				}&#xD;
			&#xD;
			&#xD;
		i++;&#xD;
		}&#xD;
		&#xD;
		if(ProtocolloPila!= null &amp;&amp; ProtocolloPila!= '' )&#xD;
		{&#xD;
			//RICERCO TUTTI I VALORI IPDSLAM - IPKIT DALL'ORDINE&#xD;
			&#xD;
			for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				&#xD;
				// PER INCREMENTOVC RICAVO TUTTI I VALORI DELLA COPPIA IPDSLAM-IPKIT PER TUTTE LE GBEVC IN INCREMENTO&#xD;
				if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
				{&#xD;
					if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC &#xD;
						&amp;&amp; currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
					{&#xD;
						var VC = it_telecomitalia_it_NOW_localbom_Factory.createVC_IPDSLAM_KIT();&#xD;
				&#xD;
						for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
						{&#xD;
							var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
							&#xD;
							if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPDSLAM)&#xD;
							{&#xD;
								VC.IPDSLAM = currentAttDettOrdine.valoreAttributo;&#xD;
							}&#xD;
							else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPKIT)&#xD;
							{&#xD;
								VC.IPKIT = currentAttDettOrdine.valoreAttributo;&#xD;
							}&#xD;
						}&#xD;
						&#xD;
						VC.protocolloPila = ProtocolloPila;&#xD;
				&#xD;
						VC_IPDSLAM_KIT.add(ScriptUtil.copy(VC));&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				// PER RICONFIGURAZIONE VC INSERISCO SOLO I GBE PER CUI LA COPPIA IPDSLAM E IPKIT RISULTA VALORIZZATA&#xD;
				else if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
				{&#xD;
					if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
					{&#xD;
						var VC = it_telecomitalia_it_NOW_localbom_Factory.createVC_IPDSLAM_KIT();&#xD;
						&#xD;
						&#xD;
						for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
						{&#xD;
							&#xD;
							var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
							&#xD;
							if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPDSLAM)&#xD;
							{&#xD;
								VC.IPDSLAM = currentAttDettOrdine.valoreAttributo;&#xD;
							}&#xD;
							else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPKIT)&#xD;
							{&#xD;
								VC.IPKIT = currentAttDettOrdine.valoreAttributo;&#xD;
							}&#xD;
							&#xD;
						}&#xD;
						&#xD;
						if(VC.IPKIT != null &amp;&amp; VC.IPKIT != &quot;&quot; &amp;&amp; VC.IPDSLAM!= null &amp;&amp; VC.IPDSLAM!= &quot;&quot;)&#xD;
						{&#xD;
							VC.protocolloPila = ProtocolloPila;&#xD;
				&#xD;
							VC_IPDSLAM_KIT.add(ScriptUtil.copy(VC));&#xD;
&#xD;
						}&#xD;
						&#xD;
						&#xD;
					}&#xD;
					&#xD;
					&#xD;
				}&#xD;
		&#xD;
				&#xD;
			}&#xD;
			&#xD;
			//VERIFICA PER PROTOCOLLO PILA = IPoA&#xD;
			&#xD;
			&#xD;
			if (ProtocolloPila == &quot;IPoA&quot;)&#xD;
			{&#xD;
				if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
				{&#xD;
					checkIPV4=true;&#xD;
					//NB: c'è certezza che la struttura VC_IPDSLAM_KIT sia valorizzata in quanto altrimenti avrebbe skippato per precondizione&#xD;
				}&#xD;
				&#xD;
				else if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
				{&#xD;
					&#xD;
					var counterCoppiaVuota =0;&#xD;
				&#xD;
					for(var z = 0; z &lt; VC_IPDSLAM_KIT.size(); z++)&#xD;
					{&#xD;
					&#xD;
						var currentVC = VC_IPDSLAM_KIT.get(z);&#xD;
					&#xD;
						if(currentVC.IPDSLAM != null &amp;&amp; currentVC.IPDSLAM.length > 0 &amp;&amp; currentVC.IPKIT != null &amp;&amp; currentVC.IPKIT.length > 0)&#xD;
						{&#xD;
							checkIPV4 = true;&#xD;
						}&#xD;
						else&#xD;
						{&#xD;
							counterCoppiaVuota++;&#xD;
							&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					if (counterCoppiaVuota>0)&#xD;
					{&#xD;
						checkIPV4 = false;&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;Richiesta di Variazione INCREMENTODECREMENTOVC con ProtocolloPila IPoA ma con IPDSLAM o IPKIT mancanti&quot;;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		&#xD;
			&#xD;
			//VERIFICA PER PROTOCOLLO PILA &lt;> IPoA&#xD;
			&#xD;
			else&#xD;
			{&#xD;
				checkIPV4=false;&#xD;
				&#xD;
				//Per INCREMENTODECREMENTOVC  &lt;ProtocolloPilaIPoA> è opzionale, quindi il controllo è superato (RU_594)&#xD;
				&#xD;
				if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
				{&#xD;
					&#xD;
					EsitoResponse.codice = true;&#xD;
					EsitoResponse.descrizione = &quot;Requisiti rispettati per VARIAZIONE INCREMENTODECREMENTOVC con ProtocolloPila &lt;> IPoA&quot;;&#xD;
					&#xD;
					&#xD;
					/*var foundProtocolloPilaIPoA = false;&#xD;
					var x = 0;&#xD;
					while(!foundProtocolloPilaIPoA &amp;&amp; x &lt; localRequest.ordine.dettaglioordine.size())&#xD;
					{&#xD;
						var currentDettOrdine = localRequest.ordine.dettaglioordine.get(x);&#xD;
						if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC &amp;&amp; &#xD;
							currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
						{&#xD;
							for(var y = 0; y &lt; currentDettOrdine.attributiDettaglioOrdine.size(); y++)&#xD;
							{&#xD;
								var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(y);&#xD;
								if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA &amp;&amp;&#xD;
									currentAttDettOrdine.valoreAttributo == &quot;IPoA&quot; )&#xD;
								{&#xD;
									foundProtocolloPilaIPoA = true;&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
						&#xD;
					x++;&#xD;
					}&#xD;
					&#xD;
					if (!foundProtocolloPilaIPoA)&#xD;
					{&#xD;
						EsitoResponse.codice = true;&#xD;
						EsitoResponse.descrizione = &quot;Requisiti rispettati per VARIAZIONE INCREMENTODECREMENTOVC con ProtocolloPila &lt;> IPoA&quot;;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;ProtocolloPila &lt;> IPoA in consistenza ma = IPoA nell'ordine per Variazione INCREMENTODECREMENTOVC&quot;;&#xD;
					}*/&#xD;
				&#xD;
				}&#xD;
				&#xD;
				&#xD;
				//Per RICONFIGURAZIONE VC è KO&#xD;
				else&#xD;
				{	&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;ProtocolloPila &lt;> IPoA per Variazione RINCONFIGURAZIONEVC&quot;;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			&#xD;
		}&#xD;
		&#xD;
		else&#xD;
		{&#xD;
			checkIPV4=false;&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Non è stato trovato in consistenza alcun PROTOCOLLOPILA per VARIAZIONE&quot;;&#xD;
		}&#xD;
		&#xD;
		&#xD;
		&#xD;
	}&#xD;
	&#xD;
	else &#xD;
	{&#xD;
		checkIPV4=false;&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Non presente Consistenza Dati&quot;;&#xD;
	}&#xD;
	&#xD;
	&#xD;
	&#xD;
}	</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
