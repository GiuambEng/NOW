          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaContrattoAttivoPerOLOSubcontractorRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createVerifica_Contratto_Attivo_Olo_SubContractor_RequestType();&#xD;
&#xD;
VerificaContrattoAttivoPerOLOSubcontractorRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
VerificaContrattoAttivoPerOLOSubcontractorRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
VerificaContrattoAttivoPerOLOSubcontractorRequest.codiceOloTestata = localRequest.codificaOLONOW;&#xD;
&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OLOVLAN)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOLONUMERICO)&#xD;
			{&#xD;
				VerificaContrattoAttivoPerOLOSubcontractorRequest.codiceOloSubContractor.add(attributo.valoreAttributo);&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo CODICEOLONUMERICO &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
