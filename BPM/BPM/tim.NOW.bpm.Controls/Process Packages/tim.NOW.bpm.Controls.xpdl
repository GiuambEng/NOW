          <xpdl2:Performers>
            <xpdl2:Performer>_YoQtQBO0EeekW5j-cV6_qA</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="91.0" LaneId="_UQ40QDLfEeajbIG7R_HFFQ" Width="129.0">
              <xpdl2:Coordinates XCoordinate="557.0" YCoordinate="304.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaCOSNGARequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerifica_COS_NGA_RequestType();&#xD;
&#xD;
VerificaCOSNGARequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
&#xD;
VerificaCOSNGARequest.strutturaRichiesta = &quot;&quot;+localRequest.strutturaRichiesta;//RU_1378&#xD;
&#xD;
AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset));&#xD;
Asset = AssetRef.readAsset();&#xD;
&#xD;
for(var i = 0; i &lt; EsistenzaVLANOutput.size(); i++)&#xD;
{&#xD;
	var currentEsistenza = EsistenzaVLANOutput.get(i);&#xD;
	var uservlan = com_tim_NOW_xsd_ControlliFormali_Factory.createUserVlan();&#xD;
	var foundFLAGMULTICAST = false;&#xD;
	&#xD;
	//RU_1378: tipoBanda e tipoCos vanno mappati entrambi	&#xD;
	uservlan.tipoBanda = currentEsistenza.TIPO_BANDA;&#xD;
	uservlan.tipoCos = currentEsistenza.TIPO_COS;	&#xD;
	&#xD;
	/*&#xD;
	RU_1378: rimossa logica per cui tipoBanda e tipoCos erano mutuamente esclusivi&#xD;
	&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
	&amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)&#xD;
	{&#xD;
		uservlan.tipoBanda = currentEsistenza.TIPO_BANDA;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		uservlan.tipoCos = currentEsistenza.TIPO_COS;&#xD;
	}&#xD;
	*/&#xD;
	&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
		&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICO&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT))&#xD;
	{&#xD;
		var VPI = &quot;&quot;;&#xD;
		VPI = null;&#xD;
		var VCI = &quot;&quot;;&#xD;
		VCI = null;&#xD;
		var VPIVCI = &quot;&quot;;&#xD;
		VPIVCI = null;&#xD;
	&#xD;
		var j = 0;&#xD;
		while((VCI == null || VPI== null) &amp;&amp; j &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(j);&#xD;
			if(currentDettOrdine.IDDettaglioOrdine == currentEsistenza.IDDettaglioOrdine)&#xD;
			{&#xD;
				var z = 0;&#xD;
				while((VCI == null || VPI== null) &amp;&amp; z &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
					{&#xD;
						VCI = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
					{&#xD;
						VPI = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					z++;&#xD;
				}&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	&#xD;
		VPIVCI = VPI + VCI;&#xD;
	&#xD;
		for(var j = 0; j &lt; Asset.dettaglioasset.size(); j++)&#xD;
		{&#xD;
			var currentDettAsset = Asset.dettaglioasset.get(j);&#xD;
			if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{&#xD;
				var codeVLAN = &quot;&quot;;&#xD;
				codeVLAN = null;&#xD;
				var AssetVPI = &quot;&quot;;&#xD;
				AssetVPI = null;&#xD;
				var AssetVCI = &quot;&quot;;&#xD;
				AssetVCI = null;&#xD;
				var AssetVPIVCI = &quot;&quot;;&#xD;
				AssetVPI = null;&#xD;
			&#xD;
				for(var z = 0; z &lt; currentDettAsset.attributidettaglioasset.size(); z++)&#xD;
				{&#xD;
					var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(z);&#xD;
					if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
					{&#xD;
						AssetVCI=currentAttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
					{&#xD;
						AssetVPI=currentAttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					else if (currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE&#xD;
					|| currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
					{&#xD;
						codeVLAN = currentAttDettAsset.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			&#xD;
				AssetVPIVCI = AssetVPI + AssetVCI;&#xD;
			&#xD;
				if(AssetVPIVCI == VPIVCI)&#xD;
				{&#xD;
					uservlan.codeVlan = codeVLAN;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					Process.auditLog(&quot;Nessun Match trovato per la coppia VPI- VCI.&quot;);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
			&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(uservlan.codeVlan == null &amp;&amp; j &lt; Asset.dettaglioasset.size())&#xD;
		{&#xD;
			var currentDettAsset = Asset.dettaglioasset.get(j);&#xD;
			if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
			{&#xD;
				var z = 0;&#xD;
				while(uservlan.codeVlan == null &amp;&amp; z &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
				{&#xD;
					var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(z);&#xD;
					if (currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE&#xD;
						|| currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
					{&#xD;
						uservlan.codeVlan = currentAttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					z++;&#xD;
				}&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(uservlan.userVlanId == null &amp;&amp; j &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(j);&#xD;
			&#xD;
			if(currentDettOrdine.IDDettaglioOrdine == currentEsistenza.IDDettaglioOrdine)&#xD;
			{&#xD;
				var z = 0;&#xD;
				while(uservlan.userVlanId == null &amp;&amp; z &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
					{&#xD;
						uservlan.userVlanId = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					z++;&#xD;
				}&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	&#xD;
		var contatoreUserVlan = 0;&#xD;
		for(var j = 0; j &lt; Asset.dettaglioasset.size(); j++)&#xD;
		{&#xD;
			var currentDettAsset = Asset.dettaglioasset.get(j);		&#xD;
			if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{&#xD;
				var IDmatched = false;&#xD;
				var codeVLAN = &quot;&quot;;&#xD;
				codeVLAN = null;&#xD;
				contatoreUserVlan++;&#xD;
				foundFLAGMULTICAST = false;    //SM_10552&#xD;
				&#xD;
				for(var z = 0; z &lt; currentDettAsset.attributidettaglioasset.size(); z++)&#xD;
				{&#xD;
					var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(z);&#xD;
					&#xD;
					if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID&#xD;
					&amp;&amp; currentAttDettAsset.valoreAttributo == uservlan.userVlanId)&#xD;
					{&#xD;
						IDmatched = true;&#xD;
					}&#xD;
					else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE&#xD;
					|| currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
					{&#xD;
						codeVLAN = currentAttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					//SM_10249&#xD;
					else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST&#xD;
						 &amp;&amp; currentAttDettAsset.valoreAttributo == &quot;SI&quot;)&#xD;
					{&#xD;
						foundFLAGMULTICAST = true;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				if(IDmatched || contatoreUserVlan == 1)&#xD;
				{&#xD;
					uservlan.codeVlan = codeVLAN;&#xD;
					if(!IDmatched)&#xD;
					{&#xD;
						Process.auditLog(&quot;USERVLANID non confrontato in quanto USERVLAN untagged&quot;);&#xD;
					}&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					//rimetto flagmulticast a false perché non ho matchato la uservlan che sto cercando&#xD;
					foundFLAGMULTICAST = false;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(!foundFLAGMULTICAST) //SM_10249: da inviare solo se non è flagmulticast&#xD;
	{&#xD;
		VerificaCOSNGARequest.user_Vlan.add(ScriptUtil.copy(uservlan));&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_ZOlUMldREee2jvYNBZCBIg" Name="Precondizione" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = true;&#xD;
&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	&#xD;
		if  (&#xD;
			(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &amp;&amp;&#xD;
			(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL || &#xD;
			localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA))&#xD;
			||&#xD;
			(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING &amp;&amp;&#xD;
			localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
			)&#xD;
			&#xD;
		{&#xD;
			var trovatoIncremento = false;&#xD;
			var i=0;&#xD;
			while(!trovatoIncremento &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var currentDettOrdine= localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if ((currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC ||&#xD;
					 currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN) &amp;&amp;&#xD;
					currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
				{&#xD;
					trovatoIncremento=true;&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
			&#xD;
			if (!trovatoIncremento)&#xD;
			{&#xD;
				EseguiControllo= false;&#xD;
			}&#xD;
		}&#xD;
	&#xD;
	else if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC &amp;&amp;&#xD;
			(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL || &#xD;
			localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA ))&#xD;
	{&#xD;
		var riattestazioneVlan= false;&#xD;
		var i=0;&#xD;
		while(!riattestazioneVlan &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine= localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if (currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC ||&#xD;
				currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{&#xD;
				for (var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttrDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE||&#xD;
						currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
						{&#xD;
							riattestazioneVlan=true;&#xD;
						}&#xD;
				}&#xD;
			}&#xD;
		 i++;&#xD;
		}&#xD;
		&#xD;
		if (!riattestazioneVlan)&#xD;
			{&#xD;
				EseguiControllo= false;&#xD;
			}&#xD;
		&#xD;
	}&#xD;
	&#xD;
	//SM_10249 / RU_1180 - Non eseguire il controllo se ci sono solo uservlan con FLAGMULTICAST&#xD;
	if(EseguiControllo&#xD;
	&amp;&amp; (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
	 || localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
	&amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
	{&#xD;
		var uservlanNOMulticast = false;&#xD;
		&#xD;
		for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{&#xD;
				//R1I-21-0093: Il controllo non va effettuato se la USERVLAN ha FLAGMULTICAST (quindi non passiamo la USERVLAN al servizio)&#xD;
				var FLAGMULTICAST = &quot;&quot;;&#xD;
				FLAGMULTICAST = null;&#xD;
				var m = 0;&#xD;
&#xD;
				while(FLAGMULTICAST == null &amp;&amp; m&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attributo = currentDettOrdine.attributiDettaglioOrdine.get(m);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
					{&#xD;
						FLAGMULTICAST = attributo.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo FLAGMULTICAST&quot;+ attributo.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+currentDettOrdine.IDDettaglioOrdine);			&#xD;
					}&#xD;
					&#xD;
					m++;&#xD;
				}&#xD;
				&#xD;
				if(FLAGMULTICAST != &quot;SI&quot;)&#xD;
				{&#xD;
					uservlanNOMulticast = true;&#xD;
				}&#xD;
			}	&#xD;
		}&#xD;
		&#xD;
		//Se non trova USERVLAN che NON ha FLAGMULTICAST, allora NON deve fare il controllo&#xD;
		if(!uservlanNOMulticast)&#xD;
		{&#xD;
			EseguiControllo = false;&#xD;
		}&#xD;
	}	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
