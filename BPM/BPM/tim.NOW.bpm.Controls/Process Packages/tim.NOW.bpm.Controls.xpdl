        <xpdl2:Activity Id="_r7IXADMWEeajbIG7R_HFFQ" Name="IPV4ValidationFailed" xpdExt:Visibility="Private" xpdExt:DisplayName="IPV4 Validation Failed">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;IP non conforme al formato IPv4&quot;;</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="75.0" LaneId="_isgxgjL5EeajbIG7R_HFFQ" Width="107.0">
              <xpdl2:Coordinates XCoordinate="712.0" YCoordinate="279.0"/>
            </xpdl2:NodeGraphicsInfo>
