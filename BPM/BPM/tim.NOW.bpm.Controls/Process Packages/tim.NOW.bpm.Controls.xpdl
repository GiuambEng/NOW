            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_r7yX0l28Eey3p5DdOXYxPQ" Name="VerificaNumerazioneAggiuntiva" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Numerazione Aggiuntiva" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL C04M01F490 - Verifica numerazione aggiuntiva WLR ISDN BRA MONO superato&quot;;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; ConsistenzaFonia != null&#xD;
   &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
   &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTSMULTINUMERO   //Task #36665&#xD;
   &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
       ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA))&#xD;
{&#xD;
	var foundAggiuntiviISDN = false;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AGGIUNTIVIISDN)&#xD;
				{&#xD;
					foundAggiuntiviISDN = true;&#xD;
					Process.auditLog(&quot;Trovato attributo AGGIUNTIVIISDN&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
	&#xD;
	if(foundAggiuntiviISDN&#xD;
	   &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEAATTIVA&#xD;
           ||ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEANONATTIVA)&#xD;
	   &amp;&amp; ConsistenzaFonia.tipoLinea == &quot;ISDN&quot; &#xD;
	   &amp;&amp; (ConsistenzaFonia.strutturaLinea.toUpperCase() == &quot;BRA MONO&quot; || ConsistenzaFonia.strutturaLinea.toUpperCase() == &quot;BRAMONO&quot;))&#xD;
	{&#xD;
		EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL C04M01F490 - Verifica numerazione aggiuntiva WLR ISDN BRA MONO fallito&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
