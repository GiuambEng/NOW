          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaDominioValoriDiBandaRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createVerifica_Dominio_Valori_Banda_RequestType();&#xD;
&#xD;
VerificaDominioValoriDiBandaRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
VerificaDominioValoriDiBandaRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
VerificaDominioValoriDiBandaRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
&#xD;
//ATTIVAZIONE&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
		{&#xD;
			var TipoCosTemp = com_tim_NOW_xsd_ControlliVlan_Factory.createTipoCos();&#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
				{&#xD;
					TipoCosTemp.identificativoCos = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
				{&#xD;
					TipoCosTemp.banda = attributo.valoreAttributo;		&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			VerificaDominioValoriDiBandaRequest.tipoCos.add(TipoCosTemp);&#xD;
		}	&#xD;
	}&#xD;
}&#xD;
//VARIAZIONE&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	if(Asset != null)&#xD;
	{&#xD;
		for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var componente = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
			{&#xD;
				var TipoCosTemp = com_tim_NOW_xsd_ControlliVlan_Factory.createTipoCos();&#xD;
				&#xD;
				for(var j=0; j&lt;componente.attributidettaglioasset.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributidettaglioasset.get(j);&#xD;
				&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
					{&#xD;
						TipoCosTemp.identificativoCos = attributo.valoreAttributo;			&#xD;
					}&#xD;
					&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
					{&#xD;
						TipoCosTemp.banda = attributo.valoreAttributo;		&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				VerificaDominioValoriDiBandaRequest.tipoCos.add(TipoCosTemp);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_9keR0eIJEeqeRbNUQWBXYw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_3ogpsOIJEeqeRbNUQWBXYw" xpdExt:Visibility="Public">
