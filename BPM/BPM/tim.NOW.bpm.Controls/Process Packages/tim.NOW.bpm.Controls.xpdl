          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="82.0" LaneId="_xv6GsXCZEe2-RbmrOf2dJA" Width="45.0">
              <xpdl2:Coordinates XCoordinate="62.0" YCoordinate="155.0"/>
