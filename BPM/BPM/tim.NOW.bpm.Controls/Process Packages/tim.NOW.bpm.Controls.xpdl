}&#xD;
&#xD;
if(FamigliaVlan == &quot;1&quot; &amp;&amp; (IdentificativoCos == &quot;1&quot; || IdentificativoCos == &quot;0&quot;) &amp;&amp; FtthOnly == &quot;Y&quot;)&#xD;
