        <xpdl2:Activity Id="_vu8icB0PEeu4uZ7mI5jbNA" Name="OLincorsosuAccessiperVlan" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="OL in corso su Accessi per Vlan" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL OL IN CORSO SU ACCESSI PER VLAN_C04M03F30 superato&quot;;&#xD;
&#xD;
//RICERCA SULL'ENTITà ASSET&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN&#xD;
   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANVULA)&#xD;
{&#xD;
	//SM_10076: aggiunta USERVLAN nella ricerca&#xD;
	//Task #35224: aggiunta condizione su statoDettaglioAsset = ATTIVO&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;dettaglioasset.nomeComponente IN ('GBEVC','USERVLAN') AND dettaglioasset.statoDettaglioAsset = 'ATTIVO' AND dettaglioasset.attributidettaglioasset.nomeAttributo =:Attributo AND dettaglioasset.attributidettaglioasset.valoreAttributo=:ValoreAttributo AND statoAsset IN ('ATTIVO','INLAVORAZIONE')&quot;);   //SM_10076: aggiunto ATTIVO&#xD;
	criteria.setQueryParameter(&quot;Attributo&quot;,&quot;SVLANCODE&quot;);&#xD;
}&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VP)&#xD;
{&#xD;
	//Task #35224: aggiunta condizione su statoDettaglioAsset = ATTIVO&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;dettaglioasset.nomeComponente IN ('ATMVC') AND dettaglioasset.statoDettaglioAsset = 'ATTIVO' AND dettaglioasset.attributidettaglioasset.nomeAttributo =:Attributo AND dettaglioasset.attributidettaglioasset.valoreAttributo=:ValoreAttributo AND statoAsset IN ('ATTIVO','INLAVORAZIONE')&quot;);   //SM_10076: aggiunto ATTIVO&#xD;
	criteria.setQueryParameter(&quot;Attributo&quot;,&quot;CODICEVP&quot;);	&#xD;
}&#xD;
&#xD;
criteria.setQueryParameter(&quot;ValoreAttributo&quot;,localRequest.IDRisorsa);&#xD;
&#xD;
ArrayAssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
&#xD;
if(ArrayAssetRef != null &amp;&amp; ArrayAssetRef.size() > 0)&#xD;
{&#xD;
	CodiceEsito = &quot;KO_01&quot;;   //SM_10076: il controllo diventa ad Esiti Multipli&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL OL IN CORSO SU ACCESSI PER VLAN_C04M03F30 fallito&quot;;&#xD;
}&#xD;
&#xD;
//SM_10076: AGGIUNTA RICERCA SULL'ENTITà RICHIESTA&#xD;
if(EsitoResponse.codice)&#xD;
{&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
	   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN&#xD;
	   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANVULA)&#xD;
	{&#xD;
		//SM_10076: aggiunta USERVLAN nella ricerca&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;ordine.dettaglioordine.nomeComponente IN ('GBEVC','USERVLAN') AND ordine.dettaglioordine.attributiDettaglioOrdine.nomeAttributo=:Attributo AND ordine.dettaglioordine.attributiDettaglioOrdine.valoreAttributo=:ValoreAttributo AND IDRichiestaOLO &lt;>: PVM AND statoRichiestaNOW NOT IN ('SCARTATO','SCARTATOB2B','ESPLETAMENTOTECNICOKO','CHIUSO','CHIUSOB2B','ESPLETAMENTOTECNICO','ESPLETAMENTOTECNICOB2B','FATTURAZIONEKO','INVIATOAFATTURAZIONE','ANNULLATOB2B','ANNULLATO')&quot;);&#xD;
		criteria.setQueryParameter(&quot;Attributo&quot;,&quot;SVLANCODE&quot;);&#xD;
	}&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VP)&#xD;
	{&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;ordine.dettaglioordine.nomeComponente IN ('ATMVC') AND ordine.dettaglioordine.attributiDettaglioOrdine.nomeAttributo=:Attributo AND ordine.dettaglioordine.attributiDettaglioOrdine.valoreAttributo=:ValoreAttributo AND IDRichiestaOLO &lt;>: PVM AND statoRichiestaNOW NOT IN ('SCARTATO','SCARTATOB2B','ESPLETAMENTOTECNICOKO','CHIUSO','CHIUSOB2B','ESPLETAMENTOTECNICO','ESPLETAMENTOTECNICOB2B','FATTURAZIONEKO','INVIATOAFATTURAZIONE','ANNULLATOB2B','ANNULLATO')&quot;);&#xD;
		criteria.setQueryParameter(&quot;Attributo&quot;,&quot;CODICEVP&quot;);	&#xD;
	}&#xD;
&#xD;
	criteria.setQueryParameter(&quot;ValoreAttributo&quot;,localRequest.IDRisorsa);&#xD;
	criteria.setQueryParameter(&quot;PVM&quot;,localRequest.IDRichiestaOLO);&#xD;
&#xD;
	ArrayRichiestaRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
	if(ArrayRichiestaRef != null &amp;&amp; ArrayRichiestaRef.size() > 0)&#xD;
	{&#xD;
		CodiceEsito = &quot;KO_02&quot;;  &#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL OL IN CORSO SU ACCESSI PER VLAN_C04M03F30 fallito&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
