          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaVPFLATAttestazioneRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaVPFLATAttestazioneRequest();&#xD;
&#xD;
VerificaVPFLATAttestazioneRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaVPFLATAttestazioneRequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
VerificaVPFLATAttestazioneRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
	{&#xD;
		var vc = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVC_VerificaVPFLATAttestazione();&#xD;
		&#xD;
		//SM_7883 EVO C10 inserito controllo per soli VC di tipo ABR&#xD;
		var isABR = false;&#xD;
		var trovatoTipoProfiloVC = false;&#xD;
		var k = 0;&#xD;
		&#xD;
		while(k &lt; currentDettOrdine.attributiDettaglioOrdine.size() &amp;&amp; trovatoTipoProfiloVC == false)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(k);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC)&#xD;
			{&#xD;
				trovatoTipoProfiloVC = true;&#xD;
				if(String(currentAttDettOrdine.valoreAttributo) == 'ABR')&#xD;
				{&#xD;
					isABR = true;&#xD;
				}&#xD;
			}&#xD;
			k++;&#xD;
		}&#xD;
		&#xD;
		if (isABR){&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEVP)&#xD;
				{&#xD;
					vc.VPCode = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDACONSEGNA)&#xD;
				{&#xD;
					vc.tipoBanda = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		&#xD;
		for(var z = 0; z &lt; EsistenzaVPOutput.size(); z++)&#xD;
		{&#xD;
			var currentEsistenzaVP = EsistenzaVPOutput.get(z);&#xD;
			if(currentEsistenzaVP.IDDettaglioOrdine == currentDettOrdine.IDDettaglioOrdine)&#xD;
			{&#xD;
				vc.TIPO = currentEsistenzaVP.tipo;&#xD;
				vc.bandaMCR = currentEsistenzaVP.bandaMCR;&#xD;
				vc.bandaPCR = currentEsistenzaVP.bandaPCR;&#xD;
				vc.modalitaFatturazione = currentEsistenzaVP.modalitaFatturazione;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
			VerificaVPFLATAttestazioneRequest.VC_VerificaVPFLATAttestazione.add(ScriptUtil.copy(vc));&#xD;
		&#xD;
		}&#xD;
		&#xD;
		&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_uJwfEVJBEeafMOVsQ226Vw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_n4CpYFJBEeafMOVsQ226Vw" xpdExt:Visibility="Public">
