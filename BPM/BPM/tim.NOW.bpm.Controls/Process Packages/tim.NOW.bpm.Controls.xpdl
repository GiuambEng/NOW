			{&#xD;
				ServizioAggiuntivo.nomeServizio = attributoServizio.valoreAttributo;		&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//Per ogni SERVIZIOAGGIUNTIVO vanno inviati gli APPARATI ad esso legati&#xD;
		for(var m=0; m&lt;localRequest.ordine.dettaglioordine.size(); m++)&#xD;
		{&#xD;
			var componenteApparato = localRequest.ordine.dettaglioordine.get(m);&#xD;
			&#xD;
			if(componenteApparato.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPARATO&#xD;
			   &amp;&amp; componenteApparato.IDDettaglioOrdineParent == componenteServizio.IDDettaglioOrdine)&#xD;
			{&#xD;
				var Apparato = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createApparatoType3();&#xD;
				&#xD;
				//Attributi di SERVIZIOAGGIUNTIVO&#xD;
				for(var j=0; j&lt;componenteApparato.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributoApparato = componenteApparato.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributoApparato.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEAPPARATO)&#xD;
					{&#xD;
						Apparato.codiceApparato = attributoApparato.valoreAttributo;		&#xD;
					}&#xD;
					else if(attributoApparato.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AZIONEAPPARATO)&#xD;
					{&#xD;
						Apparato.azioneApparato = attributoApparato.valoreAttributo;		&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//Aggiungi APPARATO AL SERVIZIOAGGIUNTIVO&#xD;
				ServizioAggiuntivo.apparato.add(ScriptUtil.copy(Apparato));			&#xD;
			}&#xD;
		}&#xD;
		//Aggiungi SERVIZIOAGGIUNTIVO alla Request&#xD;
		VerificaCompAggiuntiviApparatiRequest.serizioAggiuntivo.add(ScriptUtil.copy(ServizioAggiuntivo));&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
