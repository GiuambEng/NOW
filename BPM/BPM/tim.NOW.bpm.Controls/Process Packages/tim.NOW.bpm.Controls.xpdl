		{&#xD;
			var sizeADO = RichiestaRef.get(0).readRichiesta().ordine.dettaglioordine.get(i).attributiDettaglioOrdine.size();&#xD;
			for(var j=0; j&lt;sizeADO; i++)&#xD;
			{&#xD;
				if(RichiestaRef.get(0).readRichiesta().ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).nomeComponente ==&#xD;
				   it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAPPUNTAMENTO &amp;&amp;&#xD;
				   RichiestaRef.get(0).readRichiesta().ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).nomeAttributo ==&#xD;
				   it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAAPPUNTAMENTO)&#xD;
				{&#xD;
					status = 1;&#xD;
					break;&#xD;
				}			&#xD;
			}		&#xD;
			if(status==1)&#xD;
			{&#xD;
				break;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	if(status==1)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL DATA APPUNTAMENTO DA OA Successful&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL DATA APPUNTAMENTO DA OA Failed : Record for specified codiceOrdineOLO does not contain required nomeComponente &amp; nomeAttributo&quot;;&#xD;
	}	&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DATA APPUNTAMENTO DA OA Failed : No record found for specified codiceOrdineOLO&quot;;&#xD;
}*/</xpdl2:Script>
