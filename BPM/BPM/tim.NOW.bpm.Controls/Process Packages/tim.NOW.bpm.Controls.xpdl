        <xpdl2:Activity Id="_7SRmUv1DEeWEXoIZeVGhKA" Name="DestinazioneUso" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Destinazione Uso">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var foundBitrate = false;&#xD;
var needBitrate = false;&#xD;
var destinazioneUsoConsistenzaFonia = &quot;&quot;;&#xD;
destinazioneUsoConsistenzaFonia = null;&#xD;
var destinazioneUso = &quot;&quot;;&#xD;
destinazioneUso = null;&#xD;
var foundDestinazioneDuso = false;&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
       || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
       || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA)&#xD;
{&#xD;
       needBitrate = true;&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
       var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
       &#xD;
       if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU&#xD;
             || currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULL&#xD;
             || currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULLDATI)&#xD;
       {&#xD;
             &#xD;
             for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
             {&#xD;
                    var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
                    &#xD;
                    if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BITRATE)&#xD;
                    {&#xD;
						foundBitrate = true;&#xD;
                    }&#xD;
                    else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
                    {&#xD;
						&#xD;
						if(currentAttDettOrdine.valoreAttributo.slice(0,2) == '1|'&#xD;
							|| currentAttDettOrdine.valoreAttributo == '4'&#xD;
                            || currentAttDettOrdine.valoreAttributo == '5'&#xD;
                            || currentAttDettOrdine.valoreAttributo == '9'&#xD;
                            || currentAttDettOrdine.valoreAttributo == '10')&#xD;
                        {&#xD;
							needBitrate = true;&#xD;
                        }&#xD;
						&#xD;
						destinazioneUso = currentAttDettOrdine.valoreAttributo;&#xD;
                    }&#xD;
             }&#xD;
       }&#xD;
}&#xD;
&#xD;
//RU_728&#xD;
if(destinazioneUso == null &#xD;
	&amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &#xD;
	&amp;&amp; String(localRequest.offerta).slice(0,7) != &quot;ULLDATI&quot;) // MIGRAZIONE-ULLDATI aggiunti con SM_8213&#xD;
{&#xD;
       EsitoResponse.codice = false;&#xD;
       EsitoResponse.descrizione = &quot;DestinazioneUso assente&quot;;&#xD;
       CodiceEsito = &quot;KO_03&quot;;&#xD;
}&#xD;
/*else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONEDESTINAZIONEUSO) //Eliminata con RU_780&#xD;
{&#xD;
       Process.auditLog(&quot;CTRL DESTINAZIONE USO Trovato DestinazioneUso in CosistenzaFonia: &quot; + destinazioneUsoConsistenzaFonia);&#xD;
       &#xD;
       if(ConsistenzaFonia != null &amp;&amp; ConsistenzaFonia.destinazioneUso == destinazioneUso)&#xD;
       {&#xD;
             EsitoResponse.codice = false;&#xD;
             EsitoResponse.descrizione = &quot;DestinazioneUso uguale alla DestinazioneUso in ConsistenzaFonia&quot;;&#xD;
             CodiceEsito = &quot;KO_02&quot;;&#xD;
       }&#xD;
	   else if(needBitrate &amp;&amp; !foundBitrate)&#xD;
	   {&#xD;
			 EsitoResponse.codice = false;&#xD;
			 EsitoResponse.descrizione = &quot;DestinazioneUso di tipo DATI, ma BITRATE non valorizzato&quot;;&#xD;
		     CodiceEsito = &quot;KO_01&quot;;&#xD;
	   }&#xD;
       else&#xD;
       {&#xD;
             EsitoResponse.codice = true;&#xD;
             EsitoResponse.descrizione = &quot;DestinazioneUso differente alla DestinazioneUso in ConsistenzaFonia&quot;;&#xD;
       }&#xD;
}*/&#xD;
else if(needBitrate &amp;&amp; !foundBitrate)&#xD;
{&#xD;
       EsitoResponse.codice = false;&#xD;
       EsitoResponse.descrizione = &quot;DestinazioneUso di tipo DATI, ma BITRATE non valorizzato&quot;;&#xD;
       CodiceEsito = &quot;KO_01&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
       EsitoResponse.codice = true;&#xD;
       EsitoResponse.descrizione = &quot;DestinazioneUso di tipo DATI e BITRATE valorizzato o Destinazione di tipo FONIA &quot;;&#xD;
}&#xD;
&#xD;
/*&#xD;
var sizeDO = localRequest.ordine.dettaglioordine.size();&#xD;
