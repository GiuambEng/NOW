        <xpdl2:Activity Id="_HQGVoJq1Eea5QJFwYfra7A" Name="CalcoloPrecondizione" xpdExt:Visibility="Private" xpdExt:DisplayName="Calcolo Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = 'KIT NON DEFINITO';&#xD;
var kit = false;&#xD;
var i=0;&#xD;
while (!kit &amp;&amp;  i &lt; EsistenzaVLANOutput.size()){&#xD;
	var currEsistVLAN = EsistenzaVLANOutput.get(i);&#xD;
	if (currEsistVLAN.CODICE_KIT!=null &amp;&amp; currEsistVLAN.CODICE_KIT.length>0){&#xD;
		kit = true;&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = 'KIT DEFINITO';&#xD;
	}&#xD;
	else {&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = 'KIT NON DEFINITO';&#xD;
		}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
//SM_9019&#xD;
if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
