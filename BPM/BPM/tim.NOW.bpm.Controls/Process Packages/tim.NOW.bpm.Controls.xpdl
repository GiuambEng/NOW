        <xpdl2:Activity Id="_BoDbQPdvEeqM0K-BnFm19Q" Name="VariazioneValoreDiBanda" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Variazione Valore Di Banda">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var BandaRichiesta = &quot;&quot;;&#xD;
var BandaConsistenza = &quot;&quot;;&#xD;
BandaRichiesta = null;&#xD;
BandaConsistenza = null;&#xD;
&#xD;
//RECUPERO BANDA DALLA RICHIESTA&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
	{	&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
			{&#xD;
				BandaRichiesta = attributo.valoreAttributo;			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//RECUPERO BANDA DALLA CONSISTENZA&#xD;
if(ConsistenzaRaccolta == null) //Scarto per evitare eventuale halted causato da ConsistenzaRaccolta assente&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA VARIAZIONE VALORE DI BANDA fallito, ConsistenzaRaccolta assente&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaRaccolta.IDAsset, 10));&#xD;
&#xD;
	if(AssetRef!= null)&#xD;
	{	&#xD;
		Asset = AssetRef.readAsset();&#xD;
		&#xD;
		for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var currentComponente = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
			if(currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
			{&#xD;
				for(var j=0; j&lt;currentComponente.attributidettaglioasset.size(); j++)&#xD;
				{&#xD;
					var currentAttributo = currentComponente.attributidettaglioasset.get(j);&#xD;
				&#xD;
					if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
					{&#xD;
						BandaConsistenza = currentAttributo.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(BandaRichiesta != BandaConsistenza)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA VARIAZIONE VALORE DI BANDA superato&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA VARIAZIONE VALORE DI BANDA fallito&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
