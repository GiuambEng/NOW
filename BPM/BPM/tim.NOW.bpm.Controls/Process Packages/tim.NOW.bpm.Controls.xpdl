          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;C04M01F504 – Verifica Congruenza Aggregato UserVlan per OF superato&quot;;&#xD;
&#xD;
var profilo = &quot;&quot;;&#xD;
profilo = null;&#xD;
&#xD;
var ProfiloVLAN0 = &quot;&quot;;&#xD;
ProfiloVLAN0 = null;&#xD;
var ProfiloVLAN1 = &quot;&quot;;&#xD;
ProfiloVLAN1 = null;&#xD;
var ProfiloVLAN5 = &quot;&quot;;&#xD;
ProfiloVLAN5 = null;&#xD;
&#xD;
var countVlan = 0;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != &quot;&quot; &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		if(String(componente.nomeComponente).slice(0,8) == &quot;USERVLAN&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOVLAN)&#xD;
				{&#xD;
					if(attributo.valoreAttributo == &quot;0&quot;)&#xD;
					{&#xD;
						ProfiloVLAN0 = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if (attributo.valoreAttributo == &quot;1&quot;)&#xD;
					{&#xD;
						ProfiloVLAN1 = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if (attributo.valoreAttributo == &quot;5&quot;)&#xD;
					{&#xD;
						ProfiloVLAN5 = attributo.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					Process.auditLog(&quot;Recuperato valore : &quot;+attributo.valoreAttributo+&quot; per attributo &quot;+attributo.nomeAttributo);&#xD;
					&#xD;
					countVlan ++;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
				{&#xD;
					profilo = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Recuperato valore : &quot;+attributo.valoreAttributo+&quot; per attributo &quot;+attributo.nomeAttributo);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if((profilo == &quot;205M&quot; || profilo == &quot;78M&quot; || profilo == &quot;416M&quot;)  //R1F-25-0095: aggiunti 78M e 416M&#xD;
		&amp;&amp; !(ProfiloVLAN0 != null &amp;&amp; ProfiloVLAN1 != null &amp;&amp; ProfiloVLAN5 != null &amp;&amp; countVlan == 3))&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;controllo C04M01F504 – Verifica Congruenza Aggregato UserVlan per OF Fallito&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Esito controllo: &quot;+EsitoResponse.descrizione);&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
