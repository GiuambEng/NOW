        <xpdl2:Activity Id="_0fc8IRdoEeqiOYbRIgBdnA" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_PiJNwBdmEeqiOYbRIgBdnA" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
