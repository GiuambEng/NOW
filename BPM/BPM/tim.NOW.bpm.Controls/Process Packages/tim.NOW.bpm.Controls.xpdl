    <xpdl2:WorkflowProcess Id="_IH9iwNJ0EeqLn70Ph9PbVA" xpdExt:DisplayName="CTRL VALORIZZAZIONE FAMIGLIAVLAN E TIPOCOS_C04M01F425" Name="CTRLVALORIZZAZIONEFAMIGLIAVLANETIPOCOS_C04M01F425">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_aUDi9NJ4EeqLn70Ph9PbVA" xpdExt:DisplayName="CodiceEsito" Name="CodiceEsito">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
