            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" LaneId="_pYXwsSGOEeabcO_3BeoHyw" Width="118.0">
              <xpdl2:Coordinates XCoordinate="573.0" YCoordinate="240.0"/>
