        <xpdl2:Activity Id="_Z6uWgAS8EeatD5ngGOY_DA" Name="InitializeDataDaRequest" xpdExt:Visibility="Private" xpdExt:DisplayName="Initialize DataDa Request">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
DataDaRequest = com_tim_NOW_xsd_ControlliAmmessi_Factory.createVerifica_DAD_Per_Rimodulazione_DA_RequestType();&#xD;
&#xD;
DataDaRequest.IDRichiesta = localRequest.IDRichiestaOLO;&#xD;
DataDaRequest.DAD = localRequest.DAD;&#xD;
DataDaRequest.DATA_INVIO = localRequest.dataInvioRichiesta;&#xD;
&#xD;
&#xD;
//R1I-19-0350: per verificare se OWNERAPPUNTAMENTO = OP e richiesta DISAGGREGATO = ‘S’&#xD;
var valoreOwnerPresaAppuntamento = &quot;&quot;;&#xD;
var valoreFasciaOraria = &quot;&quot;;&#xD;
var valoreDataAppuntamento = &quot;&quot;;&#xD;
valoreOwnerPresaAppuntamento = null;&#xD;
valoreFasciaOraria = null;&#xD;
valoreDataAppuntamento = null;&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
while((valoreFasciaOraria == null || valoreDataAppuntamento == null || valoreOwnerPresaAppuntamento == null) &amp;&amp; i&lt;targetRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = targetRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTODISAGGREGAZIONE)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OWNERPRESAAPPUNTAMENTO)&#xD;
			{&#xD;
				valoreOwnerPresaAppuntamento = currentAttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo OWNERPRESAAPPUNTAMENTO con valore: &quot;+ valoreOwnerPresaAppuntamento);&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAAPPUNTAMENTO)&#xD;
			{&#xD;
				valoreDataAppuntamento = currentAttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo DATAAPPUNTAMENTO con valore: &quot;+ valoreDataAppuntamento);&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FASCIAORARIA)&#xD;
			{&#xD;
				valoreFasciaOraria = currentAttDettOrdine.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo DATAAPPUNTAMENTO con valore: &quot;+ valoreFasciaOraria);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
//SM_11268: inserito mapping di fascia_oraria_precedente e fascia_oraria (prima di questa SM non venivano considerati da BW)&#xD;
if(valoreOwnerPresaAppuntamento == 'OP' &amp;&amp; targetRequest.disaggregato == 'S' &amp;&amp; valoreFasciaOraria != null)&#xD;
{&#xD;
	DataDaRequest.fascia_oraria_precedente = valoreFasciaOraria;&#xD;
} &#xD;
else&#xD;
{&#xD;
	//non blocco il ciclo al primo DTUAPPUNTAMENTO per prendere l'ultimo in caso di duplicati&#xD;
	for(var i = 0; i &lt; targetRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = targetRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAPPUNTAMENTO)&#xD;
		{&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FASCIAORARIA)&#xD;
				{&#xD;
					DataDaRequest.fascia_oraria_precedente = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
if(localRequest.IDFasciaOraria != null)&#xD;
{&#xD;
	DataDaRequest.fascia_oraria = localRequest.IDFasciaOraria;&#xD;
}&#xD;
//------------------------------------------------------------------------------------------------------------------------------&#xD;
&#xD;
&#xD;
if(targetRequest != null &amp;&amp; targetRequest.ordine != null &amp;&amp; targetRequest.ordine.dettaglioordine != null)&#xD;
{	&#xD;
	var dataAppuntamentoDTU = DateTimeUtil.createDate();&#xD;
	dataAppuntamentoDTU = null;&#xD;
	&#xD;
	//R1I-19-0350&#xD;
	if(valoreOwnerPresaAppuntamento == 'OP' &amp;&amp; targetRequest.disaggregato == 'S' &amp;&amp; valoreDataAppuntamento != null)&#xD;
	{			&#xD;
		var giorno = &quot;&quot;;&#xD;
		giorno = valoreDataAppuntamento.slice(0,2);&#xD;
		var mese = &quot;&quot;;&#xD;
		mese = valoreDataAppuntamento.slice(3,5);&#xD;
		var anno = &quot;&quot;;&#xD;
		anno = valoreDataAppuntamento.slice(6,10);&#xD;
		&#xD;
		dataAppuntamentoDTU = DateTimeUtil.createDate(anno+&quot;-&quot;+mese+&quot;-&quot;+giorno);&#xD;
	}&#xD;
	else&#xD;
	{	&#xD;
		//non blocco il ciclo al primo DTUAPPUNTAMENTO per prendere l'ultimo in caso di duplicati&#xD;
		for(var i = 0; i &lt; targetRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine = targetRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAPPUNTAMENTO)&#xD;
			{&#xD;
				for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAAPPUNTAMENTO)&#xD;
					{&#xD;
						dataAppuntamentoDTU = DateTimeUtil.createDate(currentAttDettOrdine.valoreAttributo);&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ORAAPPUNTAMENTO)&#xD;
					{&#xD;
						//trovata ora appuntamento in formato orario, ma il controllo vuole la FasciaOraria&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
	&#xD;
	//SM_10685: se è ancora null, prendo il valore più grande tra DAD e DARimodulata (se c'è, il valore più alto è sempre quello della DADRimodulata)&#xD;
	if(dataAppuntamentoDTU == null)&#xD;
	{&#xD;
		if(targetRequest.ordine.DADRimodulata != null)&#xD;
		{&#xD;
			dataAppuntamentoDTU = targetRequest.ordine.DADRimodulata;&#xD;
		}&#xD;
		else if(targetRequest.ordine.DAD != null)&#xD;
		{&#xD;
			dataAppuntamentoDTU = targetRequest.ordine.DAD;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(dataAppuntamentoDTU != null &amp;&amp; (DataDaRequest.data_appuntamento_precedente == null || DataDaRequest.data_appuntamento_precedente &lt; dataAppuntamentoDTU))&#xD;
	{&#xD;
		DataDaRequest.data_appuntamento_precedente = dataAppuntamentoDTU;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(DataDaRequest.DAD!=null &amp;&amp; DataDaRequest.data_appuntamento_precedente!=null &amp;&amp; DataDaRequest.fascia_oraria!=null)&#xD;
{&#xD;
	FlagInput = true;&#xD;
}&#xD;
else&#xD;
{	&#xD;
	DataDaRequest = null;&#xD;
	FlagInput = false;&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DATA DA Failed : Input request could not be formed&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
