          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_qy0LgNleEemae6tVJMve6w" Name="VerificaPrecondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(//localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp;          SM_9499: effettuare il controllo anche per le CESSAZIONI&#xD;
 localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO&#xD;
 //&amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274         SM_9296&#xD;
 &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP&#xD;
 &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS&#xD;
 &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIXEDWIRELESSACCESS&#xD;
 &amp;&amp; String(localRequest.offerta).slice(0,4) != &quot;VLAN&quot; // RU_1058 - non è specificato di farlo nella lista dei controlli, quindi saltiamo per le VLAN&#xD;
 &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VP   //SM_9499: escluse anche le VP, oltre alle offerte precedenti&#xD;
 &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON  // RU_1150 - non è specificato di farlo nella lista dei controlli, quindi saltiamo per GPON&#xD;
 &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON&#xD;
 &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT      //RU_1180: non è specificato di farlo nella lista dei controlli, quindi saltiamo&#xD;
 &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE&#xD;
 &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER&#xD;
 &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FWAITALIA1GIGASARDEGNA)  //RU_1475&#xD;
{&#xD;
	EseguiControllo = true;&#xD;
}&#xD;
&#xD;
//RIENTRI DEL82: non va richiamato il Determina Cluster&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
   &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM&#xD;
   &amp;&amp; localRequest.flagRientriDel82 == &quot;SI&quot;)&#xD;
{&#xD;
	EseguiControllo = false;&#xD;
}&#xD;
&#xD;
/* RU_964 - ora il controllo va fatto per tutte le lavorazioni tranne Cessazione, AccorpamentoOLO e Attivazione274 (MIG OLO2TIM) tranne per NP, FWA e CPS&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH)&#xD;
	{&#xD;
		EseguiControllo = true;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EseguiControllo = false;&#xD;
	}&#xD;
}&#xD;
*/&#xD;
&#xD;
Process.auditLog(&quot;Offerta: &quot;+localRequest.offerta+&quot;, lavorazione: &quot;+localRequest.lavorazione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
