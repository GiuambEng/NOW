            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaServizioOpzionaleAlternativoRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaServizioOpzionaleAlternativo_RequestType();&#xD;
&#xD;
VerificaServizioOpzionaleAlternativoRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaServizioOpzionaleAlternativoRequest.offerta = String(localRequest.offerta);&#xD;
VerificaServizioOpzionaleAlternativoRequest.codOloAgcom = localRequest.codificaOLOAGCOM;&#xD;
VerificaServizioOpzionaleAlternativoRequest.DRO = localRequest.DRO;&#xD;
VerificaServizioOpzionaleAlternativoRequest.codiceProgetto = localRequest.codiceProgetto;&#xD;
&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO)&#xD;
			{&#xD;
				VerificaServizioOpzionaleAlternativoRequest.codiceServizio.add(attributo.valoreAttributo);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
</xpdExt:Information>
