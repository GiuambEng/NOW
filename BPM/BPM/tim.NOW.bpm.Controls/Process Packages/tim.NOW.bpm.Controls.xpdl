        <xpdl2:Activity Id="_z9f_kiM_Eea7qJ_CMNwz5w" Name="VerificaUnivocitVPIVCI" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Univocità VPI-VCI">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
VpiVci.clear();&#xD;
var duplicated = false;&#xD;
var vpi = '';&#xD;
var vci = '';&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!duplicated &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		vpi = '';&#xD;
		vci = '';&#xD;
		&#xD;
		if((currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || &#xD;
		currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC) &#xD;
		&amp;&amp; currentDettaglioOrdine.attributiDettaglioOrdine != null)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while((vpi == '' || vci == '') &amp;&amp; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
				{&#xD;
					vpi = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
				{&#xD;
					vci = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			j++;&#xD;
			}&#xD;
			&#xD;
			if(VpiVci != null &amp;&amp; VpiVci.contains(vpi+vci))&#xD;
			{&#xD;
				duplicated = true;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				VpiVci.add(vpi+vci);&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	// in caso di INCREMENTODECREMENTOVC, dopo aver verificato che non vi siano duplicati in richiesta controllo se per i VC in INCREMENTO non ci siano duplicati rispetto all'asset&#xD;
	&#xD;
	if (!duplicated &amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
	{&#xD;
		var VPI_incremento ='';&#xD;
		var VCI_incremento = '';&#xD;
		VpiVci.clear();&#xD;
&#xD;
		&#xD;
		for (var i=0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			VCI_incremento = '';&#xD;
			VPI_incremento = '';&#xD;
		&#xD;
			if((currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || &#xD;
			currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC) &#xD;
			&amp;&amp; currentDettaglioOrdine.attributiDettaglioOrdine != null&#xD;
			&amp;&amp; currentDettaglioOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while((VPI_incremento == '' || VCI_incremento == '') &amp;&amp; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
					{&#xD;
						VPI_incremento = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
					{&#xD;
						VCI_incremento = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
				j++;&#xD;
				}&#xD;
				&#xD;
				VpiVci.add(VPI_incremento+VCI_incremento);&#xD;
			}&#xD;
		&#xD;
		}&#xD;
	&#xD;
	&#xD;
		if(ConsistenzaDati != null &amp;&amp; VpiVci !=null &amp;&amp; VpiVci.size()>0 )&#xD;
		{&#xD;
			AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset));&#xD;
			Asset = AssetRef.readAsset();&#xD;
			var vpiCons = '';	&#xD;
			var vciCons = '';	&#xD;
			var i = 0;&#xD;
			while(!duplicated &amp;&amp; i &lt; Asset.dettaglioasset.size() > 0)&#xD;
			{&#xD;
				var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
				vciCons = '';	&#xD;
				vpiCons = '';&#xD;
				if(currentDettAsset.statoDettaglioAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO &amp;&amp; &#xD;
					(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC ||&#xD;
					 currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC))&#xD;
				{&#xD;
					var j = 0;&#xD;
					while((vpiCons == '' || vciCons == '') &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
					{&#xD;
						var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
						{&#xD;
							vpiCons=currentAttDettAsset.valoreAttributo;&#xD;
						}&#xD;
						else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
						{&#xD;
							vciCons=currentAttDettAsset.valoreAttributo;&#xD;
						}&#xD;
						&#xD;
					j++;&#xD;
					}&#xD;
					&#xD;
					if(VpiVci.contains(vpiCons+vciCons))&#xD;
					{&#xD;
						duplicated = true;&#xD;
					}&#xD;
					&#xD;
				}&#xD;
			i++;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	&#xD;
	if(duplicated)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Trovate coppie VPI - VCI duplicate&quot;;&#xD;
	}&#xD;
	else if(VpiVci != null &amp;&amp; VpiVci.size() > 0)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Tutte le coppie VPI - VCI sono distinte&quot;;&#xD;
	}&#xD;
	&#xD;
	else if (VpiVci.size()== 0 &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL UNIVOCITA VPI-VCI precondizione fallita&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Nessuna coppia VPI - VCI trovata&quot;;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="79.0" LaneId="_z9djUiM_Eea7qJ_CMNwz5w" Width="117.0">
              <xpdl2:Coordinates XCoordinate="530.0" YCoordinate="198.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
