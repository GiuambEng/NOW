        <xpdl2:Activity Id="_js8MNzLXEeajbIG7R_HFFQ" Name="VerificaCLLI" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica CLLI" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var CLLI = '';&#xD;
CLLI = null;&#xD;
var equal = true;&#xD;
var i = 0;&#xD;
&#xD;
while(equal &amp;&amp; i &lt; EsistenzaVLANOutput.size())&#xD;
{&#xD;
	var currentEsistenza = EsistenzaVLANOutput.get(i);&#xD;
	if(CLLI == null)&#xD;
	{&#xD;
		CLLI = currentEsistenza.CLLI;&#xD;
	}&#xD;
	else if(CLLI != currentEsistenza.CLLI)&#xD;
	{&#xD;
		equal = false;&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &amp;&amp; equal &amp;&amp; CLLI != null &amp;&amp; ConsistenzaDati != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset));&#xD;
	Asset = AssetRef.readAsset();&#xD;
	&#xD;
	if(Asset.CLLI != CLLI)&#xD;
	{&#xD;
		equal = false;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
if(equal)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Tuttle le UserVLAN sono attestate sulla medesima centrale&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Trovate almeno 2 UserVLAN attestate su centrali differenti&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
