        <xpdl2:Activity Id="_D53WQECQEeeykrgPLWVm3g" Name="SetINPUT" xpdExt:Visibility="Private" xpdExt:DisplayName="Set INPUT">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">CoerenzaRichiestRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createControlloCoerenzaRichiesta_RequestType();&#xD;
&#xD;
CoerenzaRichiestRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
CoerenzaRichiestRequest.offertaRichiesta = String(localRequest.offerta);&#xD;
CoerenzaRichiestRequest.lavorazione = String(localRequest.lavorazione);&#xD;
&#xD;
/* //Eliminata Gestione con SM_8253, sostituita direttamente con l'offerta della consistenza dati in input (ora il controllo è sempre chiamato DOPO il servizio in consistenza) &#xD;
&#xD;
if(AssetRef == null)&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&#xD;
	&quot;IDRisorsa=:IDRisorsa AND (statoAsset='ATTIVO' OR statoAsset='INLAVORAZIONE')&quot;);&#xD;
&#xD;
	criteria.setQueryParameter(&quot;IDRisorsa&quot;,localRequest.ordine.IDRisorsa);&#xD;
	&#xD;
	var assetRefs = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
	&#xD;
	if(assetRefs != null &amp;&amp; assetRefs.size() > 0)&#xD;
	{&#xD;
		AssetRef = assetRefs.get(0);&#xD;
	}&#xD;
}&#xD;
&#xD;
var asset = AssetRef.readAsset();&#xD;
&#xD;
*/&#xD;
&#xD;
if(ConsistenzaDati != null)&#xD;
{&#xD;
	CoerenzaRichiestRequest.offertaAsset = String(ConsistenzaDati.offerta);&#xD;
}&#xD;
//RU_1058&#xD;
else if(ConsistenzaRaccolta != null &amp;&amp; ConsistenzaRaccolta.offerta != null)&#xD;
{&#xD;
	CoerenzaRichiestRequest.offertaAsset = String(ConsistenzaRaccolta.offerta);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
