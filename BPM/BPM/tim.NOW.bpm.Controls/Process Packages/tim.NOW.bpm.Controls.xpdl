          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_tXaNUuIJEeqeRbNUQWBXYw" Width="134.0">
              <xpdl2:Coordinates XCoordinate="516.0" YCoordinate="221.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
