          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaEsistenzaImpresaVULARequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaEsistenzaImpresaVula_RequestType();&#xD;
&#xD;
VerificaEsistenzaImpresaVULARequest.codOLOAgcom = localRequest.codificaOLOAGCOM;&#xD;
VerificaEsistenzaImpresaVULARequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaEsistenzaImpresaVULARequest.dataInvioRichiesta = localRequest.dataInvioRichiesta;&#xD;
&#xD;
var foundSvlancode = false;&#xD;
var foundSystemunico = false;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE)&#xD;
	{&#xD;
		var j=0;&#xD;
		&#xD;
		while(!foundSystemunico &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SYSTEMUNICO)&#xD;
			{&#xD;
				foundSystemunico = true;&#xD;
				VerificaEsistenzaImpresaVULARequest.systemUnico = attributo.valoreAttributo;&#xD;
				 &#xD;
				Process.auditLog(&quot;Trovato attributo SYSTEMUNICO &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	//Svlancode della prima USERVLAN&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
	        &amp;&amp; !foundSvlancode)&#xD;
	{&#xD;
		var k=0;&#xD;
		&#xD;
		while(!foundSvlancode &amp;&amp; k&lt;componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
			{&#xD;
				foundSvlancode = true;&#xD;
				VerificaEsistenzaImpresaVULARequest.svlanCode = attributo.valoreAttributo;&#xD;
				 &#xD;
				Process.auditLog(&quot;Trovato attributo &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			k++;&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
