    <xpdl2:WorkflowProcess Id="_Zig0cD6cEeaA3Ie5-HTmGg" xpdExt:DisplayName="CTRL COD ORD OLO STATO" Name="CTRLCODORDOLOSTATO">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_ZixTIT6cEeaA3Ie5-HTmGg" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_ZiipoT6cEeaA3Ie5-HTmGg" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_ZixTIj6cEeaA3Ie5-HTmGg" Name="VerificacodiceOrdineOLORifStato" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica codice Ordine OLO Rif. Stato">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var checkStatus = 0;&#xD;
&#xD;
if (TargetRequest != null &amp;&amp; TargetRequestRef != null)&#xD;
{&#xD;
	TargetRequest = TargetRequestRef.readRichiesta();&#xD;
	&#xD;
	//Change Request #26296 - R1I-19-0354 per ANNULLAMNETO con	Stato Ordine &lt;> SOSPESO OPERE SPECIALI per servizi diversi da DATI&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTO&#xD;
		|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTORECIPIENT //SM_10853&#xD;
		)&#xD;
	{&#xD;
		if(TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CHIUSO &amp;&amp; &#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICO &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOAFATTURAZIONE &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSULDELIVERY &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATO &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INACCETTAZIONEPREVENTIVO &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOPERRIFIUTOPREVENTIVO &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETATOOKCONSUNTIVO &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESACONSUNTIVO &amp;&amp; &#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INRICHIESTAPREVENTIVO &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESAESPLETAMENTOFONIA)&#xD;
		{&#xD;
			//SM_9459: Stato Ordine &lt;> SOSPESO OPERE SPECIALI per servizi diversi da DATI &#xD;
			if(!(TargetRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOOPERESPECIALI &amp;&amp; &#xD;
				(TargetRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG ||&#xD;
				TargetRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)))&#xD;
			{&#xD;
				checkStatus = 1;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	//end Change Request #26296 - R1I-19-0354 &#xD;
		&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.INTERRUZIONEMIGRAZIONE&#xD;
		|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDAC&#xD;
		|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ESPLETAMENTODONORRECIPIENTDONATING&#xD;
		|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VALIDFORMALEDONATINGDONOR&#xD;
		|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VALIDTECNICADONATINGDONOR&#xD;
		|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RDACRECIPIENTDONOR //SM_10853&#xD;
		)&#xD;
	{&#xD;
		if(TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CHIUSO &amp;&amp; &#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICO &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SCARTATO &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOAFATTURAZIONE &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSULDELIVERY &amp;&amp;&#xD;
		   TargetRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATO)&#xD;
		 {&#xD;
		 	checkStatus = 1;&#xD;
		 }&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	if (localRequest.codiceOrdineTITarget != null)&#xD;
	{&#xD;
		checkStatus = 1;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(checkStatus == 1)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO STATO Successful&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO STATO Failed : Value specified for statoRichiestaNOW in input request is not applicable for current lavorazione&quot;;&#xD;
}	&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
