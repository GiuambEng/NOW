            <xpdl2:Performer>_YHMjsCMWEea7qJ_CMNwz5w</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="77.0" LaneId="_Qm4z8SMWEea7qJ_CMNwz5w" Width="116.0">
              <xpdl2:Coordinates XCoordinate="623.0" YCoordinate="203.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaEsistenzaVLANRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaEsistenzaVLANRequest();&#xD;
&#xD;
VerificaEsistenzaVLANRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaEsistenzaVLANRequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
VerificaEsistenzaVLANRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
&#xD;
if(localRequest.offerta != null)&#xD;
{&#xD;
	VerificaEsistenzaVLANRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
}&#xD;
&#xD;
//SM_10779 -- Non inviare IDAssetDati al controllo se Attivazione Cambio tecnologia di FTTH su FTTH&#xD;
if(!(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &#xD;
    &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA	&#xD;
	&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
	    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
	    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
	    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
	    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
	    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH)&#xD;
	&amp;&amp; ConsistenzaDati != null &amp;&amp; ConsistenzaDati != &quot;&quot;&#xD;
	&amp;&amp; (ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
	    || ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULAFTTH&#xD;
	    || ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPNGAFTTH&#xD;
	    || ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
	    || ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
	    || ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SEMIVULAFTTH)&#xD;
	&amp;&amp; ConsistenzaDati.azione == &quot;D&quot;))&#xD;
{&#xD;
&#xD;
	//SM_8754 -- Recuperiamo idAsset dalla ConsistenzaDati&#xD;
	if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null &amp;&amp; ConsistenzaDati.IDAsset != &quot;&quot;)&#xD;
		{&#xD;
				VerificaEsistenzaVLANRequest.IDAssetDati = parseInt(ConsistenzaDati.IDAsset, 10);&#xD;
		}&#xD;
		&#xD;
	else {&#xD;
&#xD;
		//SM_8628 -- Invio dell idAsset della ConsistenzaDati al servizio.&#xD;
		for(var x = 0; x &lt; localRequest.ordine.dettaglioordine.size(); x++)&#xD;
		{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(x);&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
			{&#xD;
				for(var y = 0; y &lt; currentDettOrdine.attributiDettaglioOrdine.size(); y++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(y);&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
					{&#xD;
						VerificaEsistenzaVLANRequest.IDAssetDati = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	//FINE SM_8628&#xD;
	}&#xD;
}&#xD;
&#xD;
//PER OFFERTE GBE ASIMMETRICO&#xD;
if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
	&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT)&#xD;
{&#xD;
	VerificaEsistenzaVLANRequest.GBE = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createGBE();&#xD;
		for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC &#xD;
				&amp;&amp; (localRequest.ordine.tipologiaSottolav!=it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
				|| (localRequest.ordine.tipologiaSottolav==it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
					&amp;&amp; currentDettOrdine.azione==it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)))&#xD;
			{&#xD;
				var gbevc = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVLan_VerificaEsistenzaVLAN();&#xD;
				&#xD;
				gbevc.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
			&#xD;
				for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
					{&#xD;
						if(gbevc.codiciVLAN == null)&#xD;
						{&#xD;
							gbevc.codiciVLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createCodiciVLANType();&#xD;
						}&#xD;
						gbevc.codiciVLAN.SVlanCode = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
					{&#xD;
						gbevc.codeVlanSingleTag = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
					{&#xD;
						if(gbevc.codiciVLAN == null)&#xD;
						{&#xD;
							gbevc.codiciVLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createCodiciVLANType();&#xD;
						}&#xD;
						gbevc.codiciVLAN.CVLAN_ID = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				VerificaEsistenzaVLANRequest.GBE.VC.add(ScriptUtil.copy(gbevc));&#xD;
			}&#xD;
		}&#xD;
//	}&#xD;
}&#xD;
&#xD;
//PER OFFERTE NGA E GBE SIMMETRICO&#xD;
else if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICO&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)&#xD;
{&#xD;
	VerificaEsistenzaVLANRequest.NGAVULA = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createNGAVULA();&#xD;
	var asset = it_telecomitalia_it_NOW_casedata_Factory.createAsset();&#xD;
	&#xD;
	var trovateUservlanAzioneA = false;  //SM_11499&#xD;
	&#xD;
	//CALCOLO ENCASULATION (SM_6906)&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
	{&#xD;
		var encapsulation = &quot;&quot;;&#xD;
		encapsulation = null;&#xD;
		&#xD;
		if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
		{&#xD;
			AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
			if(AssetRef!= null)&#xD;
			{	&#xD;
				asset = AssetRef.readAsset();&#xD;
				&#xD;
				var i = 0;&#xD;
			&#xD;
				while(encapsulation == null &amp;&amp; i &lt; asset.dettaglioasset.size())&#xD;
				{&#xD;
					var currentComponente = asset.dettaglioasset.get(i);&#xD;
				&#xD;
					if(String(currentComponente.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
					{&#xD;
						var j = 0;&#xD;
						while(encapsulation == null &amp;&amp; j &lt; currentComponente.attributidettaglioasset.size())&#xD;
						{&#xD;
							var currentAttributo = currentComponente.attributidettaglioasset.get(j);&#xD;
						&#xD;
							if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
							{&#xD;
								encapsulation = currentAttributo.valoreAttributo;&#xD;
							}&#xD;
							j++;&#xD;
						}&#xD;
					}&#xD;
					i++;&#xD;
				}&#xD;
			}	&#xD;
		}&#xD;
	}	&#xD;
	&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
			&amp;&amp; (localRequest.ordine.tipologiaSottolav!=it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
			|| (localRequest.ordine.tipologiaSottolav==it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
				&amp;&amp; currentDettOrdine.azione==it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)))&#xD;
		{&#xD;
			trovateUservlanAzioneA = true; //SM_11499&#xD;
			&#xD;
			//R1I-21-0093: Il controllo non va effettuato se la USERVLAN ha FLAGMULTICAST (quindi non passiamo la USERVLAN al servizio)&#xD;
			var FLAGMULTICAST = &quot;&quot;;&#xD;
			FLAGMULTICAST = null;&#xD;
			var m = 0;&#xD;
&#xD;
			while(FLAGMULTICAST == null &amp;&amp; m&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = currentDettOrdine.attributiDettaglioOrdine.get(m);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
				{&#xD;
					FLAGMULTICAST = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo FLAGMULTICAST&quot;+ attributo.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+currentDettOrdine.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				m++;&#xD;
			}&#xD;
&#xD;
			if(FLAGMULTICAST != &quot;SI&quot;)&#xD;
			{&#xD;
				var ngaUserVlan = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVLan_VerificaEsistenzaVLAN();&#xD;
				&#xD;
				var uservlanIDOrdine= &quot;&quot;;&#xD;
		&#xD;
				ngaUserVlan.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				&#xD;
				// RICERCO I VALORI NELL'ORDINE&#xD;
				for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
					{&#xD;
						if(ngaUserVlan.codiciVLAN == null)&#xD;
						{&#xD;
							ngaUserVlan.codiciVLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createCodiciVLANType();&#xD;
						}&#xD;
						ngaUserVlan.codiciVLAN.SVlanCode = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
					{&#xD;
						ngaUserVlan.codeVlanSingleTag = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
					{&#xD;
						if(ngaUserVlan.codiciVLAN == null)&#xD;
						{&#xD;
							ngaUserVlan.codiciVLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createCodiciVLANType();&#xD;
						}&#xD;
						ngaUserVlan.codiciVLAN.CVLAN_ID = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
					{&#xD;
						&#xD;
						uservlanIDOrdine = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
&#xD;
				}&#xD;
				&#xD;
				//RICERCO I VALORI IN ASSET per RICONFIGURAZIONE VC&#xD;
				if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
					&amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
				{&#xD;
					if (asset!=null)&#xD;
					{&#xD;
&#xD;
						for(var k = 0; k &lt; asset.dettaglioasset.size(); k++)&#xD;
						{&#xD;
							var currentDettAsset = asset.dettaglioasset.get(k);&#xD;
							if (currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
							|| currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
							&#xD;
							{&#xD;
								var CVLAN_ID = &quot;&quot;;&#xD;
								var codeVlanSingleTag = &quot;&quot;;&#xD;
								var SVlanCode = &quot;&quot;;&#xD;
								var UservlanIDAsset = &quot;&quot;;&#xD;
								&#xD;
								for(var z = 0; z &lt; currentDettAsset.attributidettaglioasset.size(); z++)&#xD;
								{&#xD;
									var currentAttrDettAsset = currentDettAsset.attributidettaglioasset.get(z);&#xD;
									&#xD;
									if (currentAttrDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
									{&#xD;
										CVLAN_ID = currentAttrDettAsset.valoreAttributo;&#xD;
									}&#xD;
									//Bug #38846: commentato&#xD;
									/*else if(currentAttrDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
									{&#xD;
										codeVlanSingleTag =  currentAttrDettAsset.valoreAttributo;&#xD;
									}*/ &#xD;
									else if(currentAttrDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
									{&#xD;
										//Bug #38846: Per ENCAPSULATION = SINGLETAG, CODEVLANSINGLETAG viene assettizzato nello SVLANCODE&#xD;
										if(encapsulation == &quot;SINGLETAG&quot;)&#xD;
										{&#xD;
											codeVlanSingleTag = currentAttrDettAsset.valoreAttributo;&#xD;
										}&#xD;
										else&#xD;
										{&#xD;
											SVlanCode = currentAttrDettAsset.valoreAttributo;&#xD;
										}&#xD;
									}&#xD;
									else if(currentAttrDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
									{&#xD;
										UservlanIDAsset =  currentAttrDettAsset.valoreAttributo;&#xD;
									}&#xD;
									&#xD;
								}&#xD;
								&#xD;
								if ((UservlanIDAsset == uservlanIDOrdine) || uservlanIDOrdine == &quot;&quot;)&#xD;
								{&#xD;
									//SET CVLAN ID dall'asset  se DOUBLETAG&#xD;
									if(encapsulation== &quot;DOUBLETAG&quot; &amp;&amp; CVLAN_ID!=&quot;&quot;)&#xD;
									{&#xD;
										if(ngaUserVlan.codiciVLAN == null)&#xD;
										{&#xD;
											ngaUserVlan.codiciVLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createCodiciVLANType();&#xD;
										}&#xD;
										&#xD;
										//SM_8754 SET CVLAN_ID se non presente nell'ordine&#xD;
										if (ngaUserVlan.codiciVLAN.CVLAN_ID == null || ngaUserVlan.codiciVLAN.CVLAN_ID == &quot;&quot;)&#xD;
										{	&#xD;
										ngaUserVlan.codiciVLAN.CVLAN_ID = CVLAN_ID;&#xD;
										}&#xD;
									}&#xD;
									&#xD;
										&#xD;
									// SET CODEVLANSINGLETAG dall'asset se SINGLETAG e se Non presente nell'ordine&#xD;
									if((ngaUserVlan.codeVlanSingleTag == null || ngaUserVlan.codeVlanSingleTag== &quot;&quot;) &#xD;
										&amp;&amp; encapsulation== &quot;SINGLETAG&quot; &amp;&amp; codeVlanSingleTag!=&quot;&quot;&#xD;
									    &amp;&amp; ngaUserVlan.codiciVLAN == null)  //SM_10737: se c'è lo SVLANCODE in input (può capitare che ci sia anche per i SINGLETAG), allora non va mappato dall'asset il CODEVLANSINGLETAG (se mappati entrambi andiamo in halted)&#xD;
									{&#xD;
										ngaUserVlan.codeVlanSingleTag = codeVlanSingleTag;&#xD;
									}&#xD;
									&#xD;
									// SET SVLANCODE dall'asset se DOUBLETAG e se Non presente nell'ordine&#xD;
									if(encapsulation == &quot;DOUBLETAG&quot; &amp;&amp; SVlanCode!=&quot;&quot; &amp;&amp;&#xD;
									(ngaUserVlan.codiciVLAN == null || (ngaUserVlan.codiciVLAN != null &amp;&amp; (ngaUserVlan.codiciVLAN.SVlanCode == null || ngaUserVlan.codiciVLAN.SVlanCode == &quot;&quot;))))&#xD;
									{&#xD;
										if(ngaUserVlan.codiciVLAN == null)&#xD;
										{&#xD;
											ngaUserVlan.codiciVLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createCodiciVLANType();&#xD;
										}&#xD;
										ngaUserVlan.codiciVLAN.SVlanCode = SVlanCode;&#xD;
									}&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
					}												&#xD;
				}&#xD;
				VerificaEsistenzaVLANRequest.NGAVULA.userVlan.add(ScriptUtil.copy(ngaUserVlan));&#xD;
			}			&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//SM_11499: in questa casistica di sottolav-offerta e se non trova azioni ad A (ma solo D - quelle a N sono in asset)&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
	   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
	   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB)&#xD;
	&amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
	&amp;&amp; !trovateUservlanAzioneA)&#xD;
{&#xD;
	if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
		&#xD;
		if(AssetRef!= null){	&#xD;
			asset = AssetRef.readAsset();&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(asset!=null)&#xD;
	{&#xD;
		for(var y=0; y&lt;asset.dettaglioasset.size(); y++)&#xD;
		{&#xD;
			var currentDettAsset = asset.dettaglioasset.get(y);&#xD;
			&#xD;
			if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
			   &amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)&#xD;
			{&#xD;
				var UservlanIDAsset = &quot;&quot;; UservlanIDAsset = null;&#xD;
				var trovataUservlanOrdine = false;&#xD;
				&#xD;
				for(var z=0; z&lt;currentDettAsset.attributidettaglioasset.size(); z++)&#xD;
				{&#xD;
					var currentAttrDettAsset = currentDettAsset.attributidettaglioasset.get(z);&#xD;
					&#xD;
					if(currentAttrDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
					{&#xD;
						UservlanIDAsset = currentAttrDettAsset.valoreAttributo;&#xD;
					}	&#xD;
				}&#xD;
				&#xD;
				for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
				{&#xD;
					var componenteOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
					&#xD;
					if(componenteOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
					    &amp;&amp; componenteOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
					{		&#xD;
						for(var p=0; p&lt;componenteOrdine.attributiDettaglioOrdine.size(); p++)&#xD;
						{&#xD;
							var attributoOrdine = componenteOrdine.attributiDettaglioOrdine.get(p);&#xD;
							&#xD;
							if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID&#xD;
							   &amp;&amp; UservlanIDAsset != null &amp;&amp;  UservlanIDAsset == attributoOrdine.valoreAttributo)&#xD;
							{&#xD;
								trovataUservlanOrdine = true;	&#xD;
							}&#xD;
						}	&#xD;
					}					&#xD;
				}	&#xD;
				&#xD;
				//USERVLAN TROVATA NELL'ORDINE CON AZIONE D&#xD;
				if(trovataUservlanOrdine)&#xD;
				{&#xD;
					Process.auditLog(&quot;Uservlan trovata nell'ordine con azione D - non va mappata in input al controllo&quot;);&#xD;
				}&#xD;
				//NON TROVATA -> MAPPO QUELLA DELL'ASSET (SARà NELL'ARRICCHIMENTO UNA USERVLAN CON AZIONE N)&#xD;
				else&#xD;
				{&#xD;
					var ngaUserVlan = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVLan_VerificaEsistenzaVLAN();				&#xD;
					ngaUserVlan.IDDettaglioOrdine = 99; //mando valore fittizio&#xD;
&#xD;
					for(var m=0; m&lt;currentDettAsset.attributidettaglioasset.size(); m++)&#xD;
					{&#xD;
						var currentAttrDettAsset = currentDettAsset.attributidettaglioasset.get(m);&#xD;
						&#xD;
						if(currentAttrDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
						{&#xD;
							if(ngaUserVlan.codiciVLAN == null)&#xD;
							{&#xD;
								ngaUserVlan.codiciVLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createCodiciVLANType();&#xD;
							}&#xD;
							ngaUserVlan.codiciVLAN.SVlanCode = currentAttrDettAsset.valoreAttributo;&#xD;
						}&#xD;
						else if(currentAttrDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
						{&#xD;
							ngaUserVlan.codeVlanSingleTag = currentAttrDettAsset.valoreAttributo;&#xD;
						}&#xD;
						else if(currentAttrDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
						{&#xD;
							if(ngaUserVlan.codiciVLAN == null)&#xD;
							{&#xD;
								ngaUserVlan.codiciVLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createCodiciVLANType();&#xD;
							}&#xD;
							ngaUserVlan.codiciVLAN.CVLAN_ID = currentAttrDettAsset.valoreAttributo;&#xD;
						}&#xD;
					}&#xD;
					VerificaEsistenzaVLANRequest.NGAVULA.userVlan.add(ScriptUtil.copy(ngaUserVlan));&#xD;
				}				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">var trovato = false;&#xD;
var i=0;&#xD;
if (EsistenzaVLANOutput != null &amp;&amp; EsistenzaVLANOutput.size() > 0)&#xD;
{&#xD;
	while (!trovato &amp;&amp; i &lt; EsistenzaVLANOutput.size())&#xD;
	{&#xD;
		localRequest.ordine.CLLI = EsistenzaVLANOutput.get(i).CLLI;&#xD;
		trovato = true;&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Il CLLI restituito dal controllo non risulta valorizzato&quot;);&#xD;
}&#xD;
	&#xD;
if(EsistenzaVLANOutput!=null &amp;&amp; EsistenzaVLANOutput.size() > 0)&#xD;
{&#xD;
	for(var j = 0; j &lt; EsistenzaVLANOutput.size(); j++)&#xD;
	{&#xD;
		var currentEsistenzaVLAN = EsistenzaVLANOutput.get(j);&#xD;
		if(currentEsistenzaVLAN.TIPO_TRASPORTO != null &amp;&amp; currentEsistenzaVLAN.TIPO_TRASPORTO.length > 0)&#xD;
		{&#xD;
			for(var k = 0; k &lt; localRequest.ordine.dettaglioordine.size(); k++)&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(k);&#xD;
				if(currentEsistenzaVLAN.IDDettaglioOrdine == currentDettOrdine.IDDettaglioOrdine)&#xD;
				{&#xD;
					var foundTipoTrasporto = false;&#xD;
					var z = 0;&#xD;
					while (!foundTipoTrasporto &amp;&amp; z&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
						if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOTRASPORTO)&#xD;
						{&#xD;
							foundTipoTrasporto = true;&#xD;
							currentAttributo.valoreAttributo = currentEsistenzaVLAN.TIPO_TRASPORTO;&#xD;
						}&#xD;
					z++;&#xD;
					}&#xD;
					&#xD;
					if (!foundTipoTrasporto)&#xD;
					{&#xD;
						var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
						nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOTRASPORTO;&#xD;
						nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						nuovoAttributo.valoreAttributo = currentEsistenzaVLAN.TIPO_TRASPORTO;&#xD;
						nuovoAttributo.operatore = localRequest.operatore;&#xD;
						currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
					}&#xD;
				}&#xD;
			}	&#xD;
		}&#xD;
		&#xD;
		//Start RU_835 BMCLIGHT&#xD;
		if(currentEsistenzaVLAN.BMC_LIGHT != null &amp;&amp; currentEsistenzaVLAN.BMC_LIGHT.length > 0)&#xD;
		{&#xD;
			for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				if(currentEsistenzaVLAN.IDDettaglioOrdine == currentDettOrdine.IDDettaglioOrdine)&#xD;
				{&#xD;
					var foundBmcLight = false;&#xD;
					var x = 0;&#xD;
					while(!foundBmcLight &amp;&amp; x &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(x);&#xD;
						if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BMCLIGHT)&#xD;
						{&#xD;
							foundBmcLight = true;&#xD;
							currentAttributo.valoreAttributo = currentEsistenzaVLAN.BMC_LIGHT;&#xD;
						}&#xD;
					x++;&#xD;
					}&#xD;
					&#xD;
					if(!foundBmcLight)&#xD;
					{&#xD;
						var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
						nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BMCLIGHT;&#xD;
						nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						nuovoAttributo.valoreAttributo = currentEsistenzaVLAN.BMC_LIGHT;&#xD;
						nuovoAttributo.operatore = localRequest.operatore;&#xD;
						currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		//Fine RU_835 BMCLIGHT&#xD;
		&#xD;
		// RU_964&#xD;
		if(currentEsistenzaVLAN.TIPOLOGIA_CLUSTER_VLAN != null &amp;&amp; currentEsistenzaVLAN.TIPOLOGIA_CLUSTER_VLAN.length > 0&#xD;
		&amp;&amp; ((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &#xD;
		  || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE) &#xD;
			&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS       //RU_1543&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)))&#xD;
		{&#xD;
			for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if(currentEsistenzaVLAN.IDDettaglioOrdine == currentDettOrdine.IDDettaglioOrdine)&#xD;
				{&#xD;
					var foundTipologiaClusterVlan = false;&#xD;
					var x = 0;&#xD;
					while(!foundBmcLight &amp;&amp; x &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(x);&#xD;
						if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN)&#xD;
						{&#xD;
							foundTipologiaClusterVlan = true;&#xD;
							currentAttributo.valoreAttributo = currentEsistenzaVLAN.TIPOLOGIA_CLUSTER_VLAN;&#xD;
						}&#xD;
					x++;&#xD;
					}&#xD;
					&#xD;
					if(!foundTipologiaClusterVlan)&#xD;
					{&#xD;
						var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
						nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN;&#xD;
						nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						nuovoAttributo.valoreAttributo = currentEsistenzaVLAN.TIPOLOGIA_CLUSTER_VLAN;&#xD;
						nuovoAttributo.operatore = localRequest.operatore;&#xD;
						currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}		&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_SOMgMVJOEeafMOVsQ226Vw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_N9aAcFJOEeafMOVsQ226Vw" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_Qm4z8SMWEea7qJ_CMNwz5w" Width="58.0">
              <xpdl2:Coordinates XCoordinate="86.0" YCoordinate="203.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_-M0M8l_VEeeYD-k4ff3ptQ" Name="Precondizione" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = true;&#xD;
&#xD;
ScartoPreControllo = false;&#xD;
// RU_966 - Per Scarto Precontrollo&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
// --------------------------------&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{	&#xD;
	if((localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &amp;&amp;&#xD;
		(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA || &#xD;
		(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT ||&#xD;
		localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)))&#xD;
		||&#xD;
		(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING &amp;&amp;&#xD;
		localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA))		&#xD;
	{&#xD;
		var trovatoIncremento = false;&#xD;
		var i=0;&#xD;
		&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine= localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if((currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC ||&#xD;
				 currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN) &amp;&amp;&#xD;
				currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
			{&#xD;
				trovatoIncremento = true;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(!trovatoIncremento)&#xD;
		{&#xD;
			EseguiControllo = false;&#xD;
		}	&#xD;
	}	&#xD;
	else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC &amp;&amp;&#xD;
			(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA || &#xD;
			(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT ||&#xD;
			localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)))&#xD;
	{	&#xD;
		//Verifico Riattestazione VLAN		&#xD;
		var riattestazioneVlan=false;&#xD;
		var foundVC=false;		&#xD;
		var i=0;&#xD;
		&#xD;
		while (((!ScartoPreControllo || !riattestazioneVlan) || (!foundVC &amp;&amp; localRequest.offerta==it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT)) &#xD;
			&amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrd= localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if (currentDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC &#xD;
				|| currentDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{&#xD;
				var foundSvlancodeOrCodevlansingletag = false;&#xD;
				var foundProfilobmdOrBandapiccoupOrBandapiccodown = false;&#xD;
				&#xD;
				for (var j=0; j&lt;currentDettOrd.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttrDettOrd = currentDettOrd.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					//RU_966: Particolare scarto nella precondizione&#xD;
					if(currentAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE&#xD;
						||currentAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG&#xD;
						||currentAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID&#xD;
						||currentAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)   //RU_1180 &#xD;
					{&#xD;
						foundSvlancodeOrCodevlansingletag = true;&#xD;
						riattestazioneVlan=true;&#xD;
					}&#xD;
					else if(currentAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD&#xD;
						    ||currentAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP&#xD;
							||currentAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
					{&#xD;
						foundProfilobmdOrBandapiccoupOrBandapiccodown = true;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				// RU_966 - PreScarto&#xD;
				if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
				   &amp;&amp; foundProfilobmdOrBandapiccoupOrBandapiccodown &amp;&amp; !foundSvlancodeOrCodevlansingletag)  //Scarto&#xD;
				{&#xD;
					ScartoPreControllo = true;&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CTRL ESISTENZA VLAN preControllo fallito&quot;;&#xD;
				}&#xD;
			}&#xD;
			if (currentDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
			{&#xD;
				foundVC=true;&#xD;
			}&#xD;
		&#xD;
		i++;&#xD;
		}&#xD;
		&#xD;
		// Se non c'è RiattestazioneVLAN Verifico se presente una Variazione del ProfiloTecnicoLinea		&#xD;
		if (!riattestazioneVlan)&#xD;
		{			&#xD;
			// Cerco valore ProfiloTecnicoLinea dell Ordine&#xD;
			var ProfiloTecnicoLineaOrdine = &quot;&quot;;&#xD;
			ProfiloTecnicoLineaOrdine = null;&#xD;
			var i=0;&#xD;
			&#xD;
			while (ProfiloTecnicoLineaOrdine == null &amp;&amp; localRequest.offerta==it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT &#xD;
				&amp;&amp; foundVC &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var currentDettOrdine= localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if (String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					for (var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
					{&#xD;
						var currentAttrDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if (currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
						{&#xD;
							ProfiloTecnicoLineaOrdine = currentAttrDettOrdine.valoreAttributo;&#xD;
						}												&#xD;
					}					&#xD;
				}			&#xD;
			i++;&#xD;
			}&#xD;
						&#xD;
			if(ProfiloTecnicoLineaOrdine!= null  &amp;&amp; localRequest.offerta==it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT &amp;&amp; foundVC)&#xD;
			{&#xD;
				if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
				{&#xD;
					AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
					&#xD;
					if(AssetRef != null)&#xD;
					{	&#xD;
						var asset = AssetRef.readAsset();	&#xD;
						var VariazioneProfiloTecnicoLinea = false;&#xD;
						&#xD;
						var k=0;&#xD;
						&#xD;
						while (!VariazioneProfiloTecnicoLinea &amp;&amp; k &lt; asset.dettaglioasset.size())&#xD;
						{&#xD;
							var currentDettAsset = asset.dettaglioasset.get(k);&#xD;
							&#xD;
							if (String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
							{&#xD;
								&#xD;
								for ( var z=0;  z &lt; currentDettAsset.attributidettaglioasset.size(); z++)&#xD;
								{&#xD;
									var currentAttrDettAsset = currentDettAsset.attributidettaglioasset.get(z);&#xD;
									&#xD;
									if (currentAttrDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
									{&#xD;
										if (ProfiloTecnicoLineaOrdine != currentAttrDettAsset.valoreAttributo)&#xD;
										{&#xD;
											VariazioneProfiloTecnicoLinea= true;&#xD;
										}										&#xD;
									}									&#xD;
								}&#xD;
							}&#xD;
						k++;					&#xD;
						}&#xD;
						&#xD;
						if (!VariazioneProfiloTecnicoLinea)&#xD;
						{&#xD;
							EseguiControllo= false;&#xD;
						}						&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EseguiControllo=false;&#xD;
			}			&#xD;
		}&#xD;
	}&#xD;
		&#xD;
	//SM_10249 / RU_1180 - Non eseguire il controllo se ci sono solo uservlan con FLAGMULTICAST&#xD;
	if(EseguiControllo&#xD;
	&amp;&amp; (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
	 || localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
	&amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
	{&#xD;
		var uservlanNOMulticast = false;&#xD;
		&#xD;
		for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
			 &amp;&amp; !(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
			   &amp;&amp; currentDettOrdine.azione == &quot;D&quot;)) //SM_10286 - da escludere le uservlan INCR/DECR con azione a D, queste non vengono mandate al servizio, quindi non vanno considerate per la logica di precondizione&#xD;
			{&#xD;
				//R1I-21-0093: Il controllo non va effettuato se la USERVLAN ha FLAGMULTICAST (quindi non passiamo la USERVLAN al servizio)&#xD;
				var FLAGMULTICAST = &quot;&quot;;&#xD;
				FLAGMULTICAST = null;&#xD;
				var m = 0;&#xD;
&#xD;
				while(FLAGMULTICAST == null &amp;&amp; m&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attributo = currentDettOrdine.attributiDettaglioOrdine.get(m);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
					{&#xD;
						FLAGMULTICAST = attributo.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo FLAGMULTICAST&quot;+ attributo.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+currentDettOrdine.IDDettaglioOrdine);			&#xD;
					}&#xD;
					&#xD;
					m++;&#xD;
				}&#xD;
				&#xD;
				if(FLAGMULTICAST != &quot;SI&quot;)&#xD;
				{&#xD;
					uservlanNOMulticast = true;&#xD;
				}&#xD;
			}	&#xD;
		}&#xD;
		&#xD;
		//Se trova delle USERVLAN senza FLAGMULTICAST, allora fa il controllo, altrimenti no&#xD;
		if(uservlanNOMulticast)&#xD;
		{&#xD;
			EseguiControllo = true;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EseguiControllo = false;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//SM_11499: in questo caso deve chiamare sempre il controllo per il calcolo della cartterizzazione DRG OPZIONE ZERO (anche per le azioni a D)&#xD;
	if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
	   &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
		   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
		   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB))&#xD;
	{&#xD;
		//Se trova USERVLAN con azione D&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &#xD;
			    &amp;&amp; currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
			{&#xD;
				EseguiControllo = true;&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
//SM_9613&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
	 &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
{&#xD;
	EseguiControllo= false;&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
