          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="52.0" LaneId="_pwOiodYoEemYBsyTeSOppQ" Width="73.0">
              <xpdl2:Coordinates XCoordinate="51.0" YCoordinate="132.0"/>
