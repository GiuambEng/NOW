          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaVLANBMDRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaVLANBMDEsitiMultipliRequest();&#xD;
VerificaVLANBMDRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaVLANBMDRequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
VerificaVLANBMDRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
VerificaVLANBMDRequest.id_Risorsa = localRequest.IDRisorsa;&#xD;
VerificaVLANBMDRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
VerificaVLANBMDRequest.scenario = it_telecomitalia_it_NOW_casedata_v1_TipologiaScenarioEnumeration.get(String(localRequest.tipologiaScenario));&#xD;
VerificaVLANBMDRequest.sottolavorazione = it_telecomitalia_it_NOW_casedata_v1_TipologiaSottolavorazioneEnumeration.get(String(localRequest.ordine.tipologiaSottolav));&#xD;
&#xD;
if(localRequest.offerta != null)&#xD;
{&#xD;
       VerificaVLANBMDRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
}&#xD;
&#xD;
if(localRequest.ordine.codicePacchettoNOW != null)&#xD;
{&#xD;
       VerificaVLANBMDRequest.isPacchetto = true;&#xD;
}&#xD;
else&#xD;
{&#xD;
       VerificaVLANBMDRequest.isPacchetto = false;&#xD;
}&#xD;
&#xD;
//MAP DA ASSET&#xD;
if(Asset != null)&#xD;
{&#xD;
       for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
       {&#xD;
             var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
             &#xD;
             if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
             {&#xD;
                    var z = 0;&#xD;
                    while(VerificaVLANBMDRequest.profiloTecnicoLineaEsistente == null &amp;&amp; z &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
                    {&#xD;
                           var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(z);&#xD;
                           &#xD;
                           if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
                           {&#xD;
                                  VerificaVLANBMDRequest.profiloTecnicoLineaEsistente = currentAttDettAsset.valoreAttributo;&#xD;
                           }&#xD;
                           z++;&#xD;
                    }&#xD;
             }&#xD;
             else if((currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
                        ||currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
					 &amp;&amp; currentDettAsset.statoDettaglioAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO)  //Task #36542&#xD;
             {&#xD;
                    var VLANAsset = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVer_VLANBMD_Esistenti_EsitiMultipli();&#xD;
                    VLANAsset.IDDettaglioOrdine = currentDettAsset.IDDettaglioAsset;&#xD;
       &#xD;
                    for(var z = 0; z &lt; currentDettAsset.attributidettaglioasset.size(); z++)&#xD;
                    {&#xD;
                           var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(z);&#xD;
                           &#xD;
                           if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD)&#xD;
                           {&#xD;
                                  VLANAsset.profilo_BMD = currentAttDettAsset.valoreAttributo;&#xD;
                           }&#xD;
                           else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
                           {&#xD;
                                  VLANAsset.banda_Picco_DOWN = currentAttDettAsset.valoreAttributo;&#xD;
                           }&#xD;
                           else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
                           {&#xD;
                                  VLANAsset.banda_Picco_UP = currentAttDettAsset.valoreAttributo;&#xD;
                           }&#xD;
                           else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
                           {&#xD;
                                  VLANAsset.SVLANCODE = currentAttDettAsset.valoreAttributo;&#xD;
                           }&#xD;
                           else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
                           {&#xD;
                                  VLANAsset.userVlan_ID = currentAttDettAsset.valoreAttributo;&#xD;
                           }&#xD;
                           if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
                           {&#xD;
                                  VLANAsset.VPI = currentAttDettAsset.valoreAttributo;&#xD;
                           }&#xD;
                           if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
                           {&#xD;
                                  VLANAsset.VCI = currentAttDettAsset.valoreAttributo;&#xD;
                           }&#xD;
                    }&#xD;
                    &#xD;
                    VerificaVLANBMDRequest.ver_VLANBMD_Esistenti.add(ScriptUtil.copy(VLANAsset));&#xD;
             }&#xD;
       }&#xD;
}&#xD;
&#xD;
&#xD;
       &#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
       // MAP VerificaVLANBMDRequest&#xD;
       var foundAccesso = false;&#xD;
       var x = 0;&#xD;
       while(!foundAccesso &amp;&amp; x &lt; localRequest.ordine.dettaglioordine.size())&#xD;
       {&#xD;
             var currentDettOrdine = localRequest.ordine.dettaglioordine.get(x);&#xD;
             &#xD;
             if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
             {&#xD;
                    foundAccesso = true;&#xD;
                    &#xD;
                    for(var y = 0; y &lt; currentDettOrdine.attributiDettaglioOrdine.size(); y++)&#xD;
                    {&#xD;
                           var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(y);&#xD;
                           &#xD;
                           if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
                           {&#xD;
                                  VerificaVLANBMDRequest.profiloTecnicoLinea = currentAttDettOrdine.valoreAttributo;&#xD;
                           }&#xD;
                           else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING)&#xD;
                           {&#xD;
                                  VerificaVLANBMDRequest.uservlan1Tagging = currentAttDettOrdine.valoreAttributo;&#xD;
                           }&#xD;
                           else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUOVOMODELLO)&#xD;
                           {&#xD;
                                  VerificaVLANBMDRequest.flagNuovoModello = currentAttDettOrdine.valoreAttributo;&#xD;
                           }&#xD;
                    }&#xD;
             }&#xD;
       x++;&#xD;
       }&#xD;
       &#xD;
&#xD;
       // MAPP VLAN SE ESEGUITA ESISTENZA VLAN&#xD;
       if (EsistenzaVLANOutput.size()>0)&#xD;
       {&#xD;
             for(var k = 0; k &lt; EsistenzaVLANOutput.size(); k++)&#xD;
             {&#xD;
                    var currentEsistenzaVLAN = EsistenzaVLANOutput.get(k);&#xD;
                    &#xD;
                    if(currentEsistenzaVLAN.TIPO_COS == &quot;BMD&quot;)&#xD;
                    {&#xD;
                           var matched = false;&#xD;
                           var y = 0;&#xD;
                           while(!matched &amp;&amp; y &lt; localRequest.ordine.dettaglioordine.size())&#xD;
                           {&#xD;
                                  var currentDettOrdine = localRequest.ordine.dettaglioordine.get(y);&#xD;
                                  &#xD;
                                  if(currentDettOrdine.IDDettaglioOrdine == currentEsistenzaVLAN.IDDettaglioOrdine)&#xD;
                                  {      &#xD;
                                        matched = true;&#xD;
                                        var VLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVer_VLANBMD_EsitiMultipli();&#xD;
                                        VLAN.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
                                        &#xD;
                                        for(var z = 0; z &lt; currentDettOrdine.attributiDettaglioOrdine.size(); z++)&#xD;
                                        {&#xD;
                                               var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
                                               &#xD;
                                               if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD)&#xD;
                                               {&#xD;
                                                      VLAN.profilo_BMD = currentAttDettOrdine.valoreAttributo;&#xD;
                                               }&#xD;
                                               else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
                                               {&#xD;
                                                      VLAN.banda_Picco_DOWN = currentAttDettOrdine.valoreAttributo;&#xD;
                                               }&#xD;
                                               else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
                                               {&#xD;
                                                      VLAN.banda_Picco_UP = currentAttDettOrdine.valoreAttributo;&#xD;
                                               }&#xD;
                                               else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
                                               {&#xD;
                                                      VLAN.SVLANCODE = currentAttDettOrdine.valoreAttributo;&#xD;
                                               }&#xD;
                                               else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
                                               {&#xD;
                                                      VLAN.userVlan_ID = currentAttDettOrdine.valoreAttributo;&#xD;
                                               }&#xD;
                                               else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
                                               {&#xD;
                                                      VLAN.VPI = currentAttDettOrdine.valoreAttributo;&#xD;
                                               }&#xD;
                                               else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
                                               {&#xD;
                                                      VLAN.VCI = currentAttDettOrdine.valoreAttributo;&#xD;
                                               }&#xD;
                                        }&#xD;
                                        &#xD;
                                        VerificaVLANBMDRequest.ver_VLANBMD.add(ScriptUtil.copy(VLAN));&#xD;
                                  }&#xD;
                                  y++;&#xD;
                           }&#xD;
                    }&#xD;
             }&#xD;
             &#xD;
       }&#xD;
       &#xD;
       // MAP VLAN SE NON ESEGUITA ESISTENZA VLAN&#xD;
       else &#xD;
       {&#xD;
             for(var y = 0; y &lt; localRequest.ordine.dettaglioordine.size(); y++)&#xD;
             {&#xD;
                    var currentDettOrdine = localRequest.ordine.dettaglioordine.get(y);&#xD;
                    &#xD;
                    if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
                           || currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
                    {&#xD;
						//SM_10379: Il controllo non va effettuato se la USERVLAN ha FLAGMULTICAST (quindi non passiamo la USERVLAN al servizio)&#xD;
						var FLAGMULTICAST = &quot;&quot;;&#xD;
						FLAGMULTICAST = null;&#xD;
						var m = 0;&#xD;
						&#xD;
						while(FLAGMULTICAST == null &amp;&amp; m&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
						{&#xD;
							var attributo = currentDettOrdine.attributiDettaglioOrdine.get(m);&#xD;
							&#xD;
							if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
							{&#xD;
								FLAGMULTICAST = attributo.valoreAttributo;&#xD;
								Process.auditLog(&quot;Trovato attributo FLAGMULTICAST&quot;+ attributo.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+currentDettOrdine.IDDettaglioOrdine);			&#xD;
							}&#xD;
							&#xD;
							m++;&#xD;
						}&#xD;
&#xD;
						if(FLAGMULTICAST != &quot;SI&quot;)&#xD;
						{&#xD;
						&#xD;
                           var VLAN = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVer_VLANBMD_EsitiMultipli();&#xD;
                           &#xD;
                           VLAN.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
                           &#xD;
             &#xD;
                           for(var k = 0; k &lt; currentDettOrdine.attributiDettaglioOrdine.size(); k++)&#xD;
                           {&#xD;
                                  var currentAttribOrdine = currentDettOrdine.attributiDettaglioOrdine.get(k);&#xD;
                                  &#xD;
                                  if(currentAttribOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD)&#xD;
                                  {&#xD;
                                        VLAN.profilo_BMD = currentAttribOrdine.valoreAttributo;&#xD;
                                  }&#xD;
                                  else if(currentAttribOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
                                  {&#xD;
                                        VLAN.banda_Picco_DOWN = currentAttribOrdine.valoreAttributo;&#xD;
                                  }&#xD;
                                  else if(currentAttribOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
                                  {&#xD;
                                        VLAN.banda_Picco_UP = currentAttribOrdine.valoreAttributo;&#xD;
                                  }&#xD;
                                  else if(currentAttribOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
                                  {&#xD;
                                        VLAN.SVLANCODE = currentAttribOrdine.valoreAttributo;&#xD;
                                  }&#xD;
                                  else if(currentAttribOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
                                  {&#xD;
                                        VLAN.userVlan_ID = currentAttribOrdine.valoreAttributo;&#xD;
                                  }&#xD;
                                  if(currentAttribOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
                                  {&#xD;
                                        VLAN.VPI = currentAttribOrdine.valoreAttributo;&#xD;
                                  }&#xD;
                                  if(currentAttribOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
                                  {&#xD;
                                        VLAN.VCI = currentAttribOrdine.valoreAttributo;&#xD;
                                  }&#xD;
                           }&#xD;
                           &#xD;
                           VerificaVLANBMDRequest.ver_VLANBMD.add(ScriptUtil.copy(VLAN));&#xD;
						  &#xD;
						}&#xD;
                    }&#xD;
             }&#xD;
       }            &#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">var foundProfiloBMD = false;&#xD;
var foundUserVlan = false;&#xD;
&#xD;
if(EsitoResponse.codice == true){&#xD;
	if(localRequest.ordine != null)&#xD;
	{&#xD;
		Process.auditLog(&quot;Recuperati &quot; + VerVLANBMDResponse.size()+&quot; record dal controllo VLANBMD&quot;);&#xD;
		var ora = DateTimeUtil.createDatetime();&#xD;
		var ordine = localRequest.ordine;&#xD;
		&#xD;
		for(var i = 0; i &lt; VerVLANBMDResponse.size(); i++)&#xD;
		{&#xD;
			foundProfiloBMD = false;&#xD;
			foundUserVlan = false;&#xD;
			var j = 0;&#xD;
			while(!foundProfiloBMD &amp;&amp; j &lt; ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var currentDettOrdine = ordine.dettaglioordine.get(j);&#xD;
				&#xD;
				//SM_11644: logica spostata da IDDettaglioOrdine a uservlanID&#xD;
				if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
				{&#xD;
					var valoreUSERVLANID = &quot;&quot;;&#xD;
					valoreUSERVLANID = null;&#xD;
					&#xD;
					for(var index=0; index&lt;currentDettOrdine.attributiDettaglioOrdine.size(); index++)&#xD;
					{&#xD;
						var attributoUservlan = currentDettOrdine.attributiDettaglioOrdine.get(index);&#xD;
						&#xD;
						if(attributoUservlan.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
						{&#xD;
							valoreUSERVLANID = attributoUservlan.valoreAttributo;&#xD;
							Process.auditLog(&quot;Trovato attributo USERVLANID&quot;+ attributoUservlan.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+currentDettOrdine.IDDettaglioOrdine);			&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					//Entra qui se trova lo stesso USERVLANID oppure se USERVLANID == null (caso UNTAGGED - una sola USERVLAN senza USERVLANID)&#xD;
					if(valoreUSERVLANID == VerVLANBMDResponse.get(i).uservlanID || valoreUSERVLANID == null)&#xD;
					{&#xD;
						if(currentDettOrdine.azione != it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)      //SM_9909&#xD;
						{&#xD;
							Process.auditLog(&quot;Trovato id risposta &quot; + VerVLANBMDResponse.get(i).IDDettaglioOrdine +&quot; nell'ordine&quot;);&#xD;
							&#xD;
							//SM_10379: Il controllo non va effettuato se la USERVLAN ha FLAGMULTICAST (quindi non passiamo la USERVLAN al servizio)&#xD;
							var FLAGMULTICAST = &quot;&quot;;&#xD;
							FLAGMULTICAST = null;&#xD;
							var m = 0;&#xD;
							&#xD;
							while(FLAGMULTICAST == null &amp;&amp; m&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
							{&#xD;
								var attributo = currentDettOrdine.attributiDettaglioOrdine.get(m);&#xD;
								&#xD;
								if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
								{&#xD;
									FLAGMULTICAST = attributo.valoreAttributo;&#xD;
									Process.auditLog(&quot;Trovato attributo FLAGMULTICAST&quot;+ attributo.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+currentDettOrdine.IDDettaglioOrdine);			&#xD;
								}&#xD;
								&#xD;
								m++;&#xD;
							}&#xD;
							&#xD;
							if(FLAGMULTICAST != &quot;SI&quot;)&#xD;
							{&#xD;
								var z = 0;&#xD;
								while(!foundProfiloBMD &amp;&amp; z &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
								{&#xD;
									var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
									&#xD;
									if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD)&#xD;
									{&#xD;
										foundProfiloBMD = true;&#xD;
										currentAttDettOrdine.lastUpdate = ora;&#xD;
										currentAttDettOrdine.valoreAttributo = VerVLANBMDResponse.get(i).ID_PROFILO_BMD;&#xD;
										Process.auditLog(&quot;Modificato Profilo BMD a &quot; + VerVLANBMDResponse.get(i).ID_PROFILO_BMD +&quot; per ID &quot;+currentDettOrdine.IDDettaglioOrdine);&#xD;
									}&#xD;
									z++;&#xD;
								}&#xD;
								&#xD;
								if(!foundProfiloBMD)&#xD;
								{&#xD;
									var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
									nuovoAttributo.IDDettaglioOrdine = VerVLANBMDResponse.get(i).IDDettaglioOrdine;&#xD;
									nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
									nuovoAttributo.created = ora;&#xD;
									nuovoAttributo.lastUpdate = ora;&#xD;
									nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD;&#xD;
									nuovoAttributo.operatore = localRequest.operatore;&#xD;
									nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
									nuovoAttributo.valoreAttributo = VerVLANBMDResponse.get(i).ID_PROFILO_BMD;&#xD;
							&#xD;
									currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
									Process.auditLog(&quot;Profilo BMD non trovato nell'ordine, aggiunto attributo con valore &quot; + VerVLANBMDResponse.get(i).ID_PROFILO_BMD);&#xD;
								}&#xD;
							}&#xD;
						}	&#xD;
						foundUserVlan = true;&#xD;
					}&#xD;
				}&#xD;
				//SM_11959: per GBEVC l'arricchimento va fatto tramita IDDettaglioOrdine&#xD;
				else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
				{&#xD;
					if(currentDettOrdine.IDDettaglioOrdine == VerVLANBMDResponse.get(i).IDDettaglioOrdine)&#xD;
					{&#xD;
						if(currentDettOrdine.azione != it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
						{&#xD;
							Process.auditLog(&quot;Trovato id risposta &quot; + VerVLANBMDResponse.get(i).IDDettaglioOrdine +&quot; nell'ordine&quot;);&#xD;
							&#xD;
							//Il controllo non va effettuato se c'è FLAGMULTICAST&#xD;
							var FLAGMULTICAST = &quot;&quot;;&#xD;
							FLAGMULTICAST = null;&#xD;
							var m = 0;&#xD;
							&#xD;
							while(FLAGMULTICAST == null &amp;&amp; m&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
							{&#xD;
								var attributo = currentDettOrdine.attributiDettaglioOrdine.get(m);&#xD;
								&#xD;
								if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
								{&#xD;
									FLAGMULTICAST = attributo.valoreAttributo;&#xD;
									Process.auditLog(&quot;Trovato attributo FLAGMULTICAST&quot;+ attributo.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+currentDettOrdine.IDDettaglioOrdine);			&#xD;
								}&#xD;
								&#xD;
								m++;&#xD;
							}&#xD;
							&#xD;
							if(FLAGMULTICAST != &quot;SI&quot;)&#xD;
							{&#xD;
								var z = 0;&#xD;
								while(!foundProfiloBMD &amp;&amp; z &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
								{&#xD;
									var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
									&#xD;
									if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD)&#xD;
									{&#xD;
										foundProfiloBMD = true;&#xD;
										currentAttDettOrdine.lastUpdate = ora;&#xD;
										currentAttDettOrdine.valoreAttributo = VerVLANBMDResponse.get(i).ID_PROFILO_BMD;&#xD;
										Process.auditLog(&quot;Modificato Profilo BMD a &quot; + VerVLANBMDResponse.get(i).ID_PROFILO_BMD +&quot; per ID &quot;+currentDettOrdine.IDDettaglioOrdine);&#xD;
									}&#xD;
									z++;&#xD;
								}&#xD;
								&#xD;
								if(!foundProfiloBMD)&#xD;
								{&#xD;
									var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
									nuovoAttributo.IDDettaglioOrdine = VerVLANBMDResponse.get(i).IDDettaglioOrdine;&#xD;
									nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
									nuovoAttributo.created = ora;&#xD;
									nuovoAttributo.lastUpdate = ora;&#xD;
									nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD;&#xD;
									nuovoAttributo.operatore = localRequest.operatore;&#xD;
									nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
									nuovoAttributo.valoreAttributo = VerVLANBMDResponse.get(i).ID_PROFILO_BMD;&#xD;
							&#xD;
									currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
									Process.auditLog(&quot;Profilo BMD non trovato nell'ordine, aggiunto attributo con valore &quot; + VerVLANBMDResponse.get(i).ID_PROFILO_BMD);&#xD;
								}&#xD;
							}&#xD;
						}	&#xD;
					}&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			//SM_7840: quando una delle USERVLAN non è nella richiesta (caso da FILE), recupera dall'asset e modifica con nuovo profilo BMD&#xD;
			if(!foundUserVlan &#xD;
			   &amp;&amp; (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC&#xD;
			       ||localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC))             //SM_9909&#xD;
			{&#xD;
				if(Asset != null)&#xD;
				{&#xD;
					for(var iterator = 0; iterator &lt; Asset.dettaglioasset.size(); iterator++)&#xD;
					{&#xD;
						var componenteAsset = Asset.dettaglioasset.get(iterator);&#xD;
&#xD;
						if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
						   &amp;&amp; componenteAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO) //SM_11634&#xD;
						{&#xD;
							var FLAGMULTICAST = &quot;&quot;;&#xD;
							FLAGMULTICAST = null;&#xD;
							Process.auditLog(&quot;Trovata USERVLAN in asset, iterator &quot;+iterator);&#xD;
&#xD;
							var componenteTemp = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
							var data = DateTimeUtil.createDatetime();&#xD;
							componenteTemp.IDDettaglioOrdineParent = 1;&#xD;
							componenteTemp.IDDettaglioOrdineRoot = 1;&#xD;
							componenteTemp.operatore = &quot;BPM&quot;;&#xD;
							componenteTemp.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							componenteTemp.created = data;&#xD;
							componenteTemp.lastUpdate = data;&#xD;
							componenteTemp.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
							&#xD;
							var contaVC =0;&#xD;
							for(var n=0; n&lt;localRequest.ordine.dettaglioordine.size(); n++){&#xD;
								if(localRequest.ordine.dettaglioordine.get(n).nomeComponente == componenteAsset.nomeComponente){&#xD;
									contaVC++;&#xD;
								}&#xD;
							}&#xD;
							&#xD;
							componenteTemp.progressivo = contaVC+1;&#xD;
							componenteTemp.integrationID = localRequest.IDRichiestaOLO + componenteTemp.IDDettaglioOrdine;&#xD;
							componenteTemp.nomeComponente = componenteAsset.nomeComponente;&#xD;
							componenteTemp.IDDettaglioOrdine = VerVLANBMDResponse.get(i).IDDettaglioOrdine;&#xD;
							var UserVlanIDAsset = &quot;&quot;;&#xD;
							UserVlanIDAsset = null;&#xD;
							&#xD;
							for(var z = 0; z &lt; componenteAsset.attributidettaglioasset.size(); z++)&#xD;
							{&#xD;
								var currentAttDettAsset = componenteAsset.attributidettaglioasset.get(z);&#xD;
								Process.auditLog(&quot;Arricchimento USERVLAN dall'asset, attributo &quot;+currentAttDettAsset.nomeAttributo);&#xD;
								&#xD;
								var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
								attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
								attributo.IDDettaglioOrdine = VerVLANBMDResponse.get(i).IDDettaglioOrdine;&#xD;
								attributo.created = data;&#xD;
								attributo.lastUpdate =data;&#xD;
								attributo.operatore = &quot;BPM&quot;;&#xD;
								attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
								&#xD;
								if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD)&#xD;
								{&#xD;
									attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD;&#xD;
									attributo.valoreAttributo = VerVLANBMDResponse.get(i).ID_PROFILO_BMD;&#xD;
									componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
								}&#xD;
								else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
								{&#xD;
									attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN;&#xD;
									attributo.valoreAttributo = currentAttDettAsset.valoreAttributo;&#xD;
									componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
								}&#xD;
								else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
								{&#xD;
									attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP;&#xD;
									attributo.valoreAttributo = currentAttDettAsset.valoreAttributo;&#xD;
									componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
								}&#xD;
								else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
								{&#xD;
									attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE;&#xD;
									attributo.valoreAttributo = currentAttDettAsset.valoreAttributo;&#xD;
									componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
								}&#xD;
								else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
								{&#xD;
									attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID;&#xD;
									attributo.valoreAttributo = currentAttDettAsset.valoreAttributo;&#xD;
									componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
									UserVlanIDAsset = currentAttDettAsset.valoreAttributo;&#xD;
									Process.auditLog(&quot;Trovato attributo USERVLANID con valore &quot;+currentAttDettAsset.valoreAttributo+&quot;, assegnato valore a VAR USERVLANID: &quot;+UserVlanIDAsset);&#xD;
								}&#xD;
								if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
								{&#xD;
									attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI;&#xD;
									attributo.valoreAttributo = currentAttDettAsset.valoreAttributo;&#xD;
									componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
								}&#xD;
								if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
								{&#xD;
									attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI;&#xD;
									attributo.valoreAttributo = currentAttDettAsset.valoreAttributo;&#xD;
									componenteTemp.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
								}&#xD;
								if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
								{&#xD;
									FLAGMULTICAST = currentAttDettAsset.valoreAttributo;&#xD;
								}&#xD;
							}&#xD;
							&#xD;
							//SM_8068 - Controlla se l'UserVlan corrente recuperata in asset è gia nell'ordine, se non lo è la aggiunge (gestione duplicati)&#xD;
							var y = 0;&#xD;
							var y2 = 0;&#xD;
							var sameUserVlanID = false;&#xD;
							&#xD;
							while(!sameUserVlanID &amp;&amp; y &lt; localRequest.ordine.dettaglioordine.size())&#xD;
							{&#xD;
								var currentDettOrdine = localRequest.ordine.dettaglioordine.get(y);&#xD;
								Process.auditLog(&quot;Controllo Gestione duplicati, y: &quot;+y+&quot; componente &quot;+currentDettOrdine.nomeComponente);&#xD;
								&#xD;
								if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
								{&#xD;
									Process.auditLog(&quot;Trovata USERVLAN nell'ordine&quot;);&#xD;
&#xD;
									y2 = 0;&#xD;
									while(!sameUserVlanID &amp;&amp; y2 &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
									{&#xD;
										var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(y2);&#xD;
										Process.auditLog(&quot;Controllo Attributi, y2: &quot;+y2+&quot;, attributo &quot;+currentAttDettOrdine.nomeAttributo);&#xD;
										&#xD;
										if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID &amp;&amp; UserVlanIDAsset != null &amp;&amp;&#xD;
										   UserVlanIDAsset == currentAttDettOrdine.valoreAttributo)&#xD;
										{&#xD;
											sameUserVlanID = true;&#xD;
											Process.auditLog(&quot;TROVATA CORRISPONDENZA tra USERVLAN ORDINE &quot;+currentAttDettOrdine.valoreAttributo+&quot; e in ASSET &quot;+UserVlanIDAsset);&#xD;
											Process.auditLog(&quot;sameUserVlanID: &quot;+sameUserVlanID);																					&#xD;
										}&#xD;
										y2++;&#xD;
									}&#xD;
								}&#xD;
								y++;&#xD;
							}&#xD;
							&#xD;
							if(!sameUserVlanID &amp;&amp; FLAGMULTICAST != &quot;SI&quot;)&#xD;
							{&#xD;
								localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componenteTemp));&#xD;
								Process.auditLog(&quot;Aggiunta USERVLAN all'ordine, sameUserVlanID: &quot;+sameUserVlanID);																					&#xD;
							}&#xD;
							else&#xD;
							{&#xD;
								Process.auditLog(&quot;USERVLAN non aggiunta all'ordine, sameUserVlanID: &quot;+sameUserVlanID);																					&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}		&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Nessun ordine presente nella richiesta&quot;);&#xD;
	}&#xD;
} else &#xD;
	{&#xD;
		Process.auditLog(&quot;Il servizio ha restituito esito KO&quot;);&#xD;
	}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_CIlDkAHXEeiXxMS0VatT7w" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo=false;&#xD;
&#xD;
if(ConsistenzaDati != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
	Asset = AssetRef.readAsset();&#xD;
}&#xD;
&#xD;
if (EsistenzaVLANOutput.size()>0)&#xD;
{&#xD;
	var foundBMD = false;&#xD;
&#xD;
	var i = 0;&#xD;
	while(!foundBMD &amp;&amp; i &lt; EsistenzaVLANOutput.size())&#xD;
	{&#xD;
		if(EsistenzaVLANOutput.get(i).TIPO_COS == &quot;BMD&quot;)&#xD;
		{&#xD;
			foundBMD = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
&#xD;
&#xD;
	if(foundBMD)&#xD;
	{&#xD;
		EseguiControllo= true;&#xD;
	}&#xD;
&#xD;
}&#xD;
else if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	//VERIFICO VARIAZIONE PROFILO TECNICA LINEA ED ESISTENZA DEL IDPROFILOBMD&#xD;
&#xD;
	var foundProfiloBMD = false;&#xD;
	var ProfiloTecnicoLineaVariato = false;&#xD;
	var ProfiloTecnicoLineaOrdine = &quot;&quot;;&#xD;
	ProfiloTecnicoLineaOrdine= null;&#xD;
	&#xD;
	//SM_9943&#xD;
	var FLAGNUOVOMODELLOordine = &quot;&quot;;&#xD;
	FLAGNUOVOMODELLOordine = null;&#xD;
	var FLAGNUOVOMODELLOvariato = false;&#xD;
	&#xD;
	&#xD;
	//ricavo valore ProfiloTecnicoLinea dall'ordine&#xD;
	var i=0;&#xD;
	while((ProfiloTecnicoLineaOrdine == null || FLAGNUOVOMODELLOordine == null) &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if (String(currentDettOrdine.nomeComponente).slice(0,7) ==&quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j=0;&#xD;
			while((ProfiloTecnicoLineaOrdine == null || FLAGNUOVOMODELLOordine == null) &amp;&amp; j&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)     //SM_9909: corretto refuso valoreAttributo mancante&#xD;
				{&#xD;
					ProfiloTecnicoLineaOrdine = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				//SM_9943&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUOVOMODELLO)&#xD;
				{&#xD;
					FLAGNUOVOMODELLOordine = currentAttDettOrdine.valoreAttributo;&#xD;
				}			&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
&#xD;
	//confronto il profilotecnicolinea dell'ordine e dell'asset per vedere se è variato e verifico l'esitenza di almeno un IDPROFILOBMD&#xD;
	if(Asset !=null)&#xD;
	{&#xD;
		var k=0;&#xD;
		&#xD;
		while((!foundProfiloBMD || !ProfiloTecnicoLineaVariato || !FLAGNUOVOMODELLOvariato) &amp;&amp; k &lt; Asset.dettaglioasset.size())  &#xD;
		{&#xD;
			var currentDettAsset = Asset.dettaglioasset.get(k);&#xD;
			&#xD;
			for(var z=0; z&lt;currentDettAsset.attributidettaglioasset.size(); z++)&#xD;
			{&#xD;
				var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(z);&#xD;
				&#xD;
				if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
				{&#xD;
					if(currentAttDettAsset.valoreAttributo != ProfiloTecnicoLineaOrdine &amp;&amp; ProfiloTecnicoLineaOrdine != null)    //SM_10325&#xD;
					{&#xD;
						ProfiloTecnicoLineaVariato = true;&#xD;
					}&#xD;
				}&#xD;
				else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDPROFILOBMD)&#xD;
				{&#xD;
					foundProfiloBMD = true;&#xD;
				}&#xD;
				else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD)&#xD;
				{&#xD;
					foundProfiloBMD = true;&#xD;
				}&#xD;
				//SM_9943&#xD;
				else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUOVOMODELLO&#xD;
				        &amp;&amp; currentAttDettAsset.valoreAttributo != FLAGNUOVOMODELLOordine &amp;&amp; FLAGNUOVOMODELLOordine != null)&#xD;
				{&#xD;
					FLAGNUOVOMODELLOvariato = true;	&#xD;
				}&#xD;
			}&#xD;
			k++;&#xD;
		}&#xD;
		&#xD;
		if((ProfiloTecnicoLineaVariato &amp;&amp; foundProfiloBMD) || FLAGNUOVOMODELLOvariato)   //SM_9943: aggiunta variazione di FLAGNUOVOMODELLO&#xD;
		{&#xD;
			EseguiControllo = true;&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
