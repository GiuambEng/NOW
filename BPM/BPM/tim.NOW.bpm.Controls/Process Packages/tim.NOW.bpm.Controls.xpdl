            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_4Fw7UBK6EeutPqRo3zfkHw" Name="VerificaCaratterizzazioneCAR" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Caratterizzazione CAR" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL CARATTERIZZAZIONE CAR_C04M01F439 fallito&quot;;&#xD;
&#xD;
var SUPERMACROAREA = &quot;&quot;;&#xD;
SUPERMACROAREA = null;&#xD;
&#xD;
//RU_1099&#xD;
var TIPOLOGIACLUSTERVLAN = &quot;&quot;;&#xD;
TIPOLOGIACLUSTERVLAN = null;&#xD;
&#xD;
var LavRicTIPOLOGIACLUSTERVLAN = &quot;&quot;;&#xD;
LavRicTIPOLOGIACLUSTERVLAN = null;&#xD;
&#xD;
if(LavorazioneRichiesta != null)&#xD;
{&#xD;
	LavRicTIPOLOGIACLUSTERVLAN = LavorazioneRichiesta.tipologiaClusterVlan;&#xD;
	Process.auditLog(&quot;TIPOLOGIACLUSTERVLAN da LavorazioneRichiesta: &quot;+LavRicTIPOLOGIACLUSTERVLAN);	&#xD;
}&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA)&#xD;
			{&#xD;
				SUPERMACROAREA = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo SUPERMACROAREA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);	&#xD;
			}&#xD;
			//RU_1099&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN)&#xD;
			{&#xD;
				TIPOLOGIACLUSTERVLAN = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo TIPOLOGIACLUSTERVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);	&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//SM_9732: rifatta logica&#xD;
//RU_1099: aggiunta logica con TIPOLOGIACLUSTERVLAN della richiesta&#xD;
//SM_9836: aggiunte condizioni SUPERMACROAREA = null e TIPOLOGIACLUSTERVLAN = CC/LIB &#xD;
if((LavRicTIPOLOGIACLUSTERVLAN == &quot;CC&quot; &amp;&amp; ((SUPERMACROAREA == &quot;2&quot; &amp;&amp;  TIPOLOGIACLUSTERVLAN == null) || ((SUPERMACROAREA == &quot;0&quot; || SUPERMACROAREA == null) &amp;&amp; TIPOLOGIACLUSTERVLAN == &quot;CC&quot;)))&#xD;
 ||(LavRicTIPOLOGIACLUSTERVLAN == &quot;LIB&quot; &amp;&amp; ((SUPERMACROAREA == &quot;3&quot; &amp;&amp;  TIPOLOGIACLUSTERVLAN == null) || ((SUPERMACROAREA == &quot;0&quot; || SUPERMACROAREA == null) &amp;&amp; TIPOLOGIACLUSTERVLAN == &quot;LIB&quot;)))&#xD;
 ||(LavRicTIPOLOGIACLUSTERVLAN == null &amp;&amp; ((SUPERMACROAREA == &quot;1&quot; || SUPERMACROAREA == &quot;0&quot;) &amp;&amp; TIPOLOGIACLUSTERVLAN == null))&#xD;
 ||(LavRicTIPOLOGIACLUSTERVLAN == null &amp;&amp; SUPERMACROAREA == null &amp;&amp; TIPOLOGIACLUSTERVLAN == null)) //Bug #33447&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL CARATTERIZZAZIONE CAR_C04M01F439 superato&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
