            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaCensimentoIPSorgenteRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaCensimentoIPSorgente_RequestType();&#xD;
&#xD;
if(LavorazioneRichiesta != null)&#xD;
{&#xD;
	VerificaCensimentoIPSorgenteRequest.IDContratto = LavorazioneRichiesta.identificativoContratto;&#xD;
}&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	VerificaCensimentoIPSorgenteRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	VerificaCensimentoIPSorgenteRequest.lavorazione = String(localRequest.lavorazione);&#xD;
	VerificaCensimentoIPSorgenteRequest.offerta = String(localRequest.offerta);&#xD;
	VerificaCensimentoIPSorgenteRequest.codOloAgcom = localRequest.codificaOLOAGCOM;&#xD;
&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPSORGENTE)&#xD;
				{&#xD;
					VerificaCensimentoIPSorgenteRequest.IPSorgente = attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
