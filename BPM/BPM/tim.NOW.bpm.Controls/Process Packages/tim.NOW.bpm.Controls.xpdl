        <xpdl2:Activity Id="_uDMcEAbqEeaaXcIacC0_2w" Name="InitializeDACSLARequest" xpdExt:Visibility="Private" xpdExt:DisplayName="Initialize DACSLA Request">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
DacSlaRequest = com_tim_NOW_xsd_ControlliAmmessi_Factory.createVerifica_DAC_SLA_Request();&#xD;
&#xD;
DacSlaRequest.IDRichiesta = localRequest.IDRichiestaOLO;&#xD;
DacSlaRequest.DAC = localRequest.ordine.DAC;&#xD;
DacSlaRequest.DRO = localRequest.DRO;&#xD;
&#xD;
DacSlaRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
DacSlaRequest.servizio = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
&#xD;
//SM_8894 &#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &#xD;
	&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
	    || (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP                //RU_1346&#xD;
		    &amp;&amp; localRequest.flagDelibera103 == &quot;Y&quot;)))&#xD;
{&#xD;
	DacSlaRequest.sottoLavorazione = String(localRequest.tipologiaSottolav);&#xD;
}&#xD;
&#xD;
if(InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null &amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea != null)&#xD;
{&#xD;
	DacSlaRequest.tipoNumero = InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero;&#xD;
	DacSlaRequest.tipoServizio = InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio;&#xD;
}&#xD;
&#xD;
if(localRequest.tipologiaScenario != null){&#xD;
	DacSlaRequest.scenario = it_telecomitalia_it_NOW_casedata_v1_TipologiaScenarioEnumeration.get(String(localRequest.tipologiaScenario));&#xD;
}&#xD;
&#xD;
if(DacSlaRequest.DAC != null &amp;&amp; DacSlaRequest.DRO != null &amp;&amp; DacSlaRequest.lavorazione != null &amp;&amp; DacSlaRequest.servizio != null)&#xD;
{&#xD;
	FlagInput = true;&#xD;
}&#xD;
else&#xD;
{&#xD;
	FlagInput = false;&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DAC SLA Failed : Input request could not be formed&quot;;&#xD;
}&#xD;
&#xD;
if(LavorazioneRichiesta != null)&#xD;
{&#xD;
	DacSlaRequest.migrazioneIntraOlo = LavorazioneRichiesta.migrazioneIntraOlo;&#xD;
}&#xD;
&#xD;
//RU_1346&#xD;
DacSlaRequest.flagDelibera103 = localRequest.flagDelibera103;&#xD;
DacSlaRequest.codificaOLOAGCOMDonor = localRequest.codificaOLOAGCOMDonor;&#xD;
&#xD;
//RU_1392&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.flagDelibera103 == 'Y' &#xD;
	&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PORTABILITASUCCESSIVA   &#xD;
	&amp;&amp; localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);					&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAOLO)     &#xD;
				{&#xD;
					DacSlaRequest.tipoLinea = attributo.valoreAttributo;	&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
