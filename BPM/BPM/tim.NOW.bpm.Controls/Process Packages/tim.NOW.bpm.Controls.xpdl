} &#xD;
else if(localRequest!=null &amp;&amp; localRequest.codiceOrdineOLOTarget != null)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI OLO Skipped: codiceOrdineTITarget is missing but codiceOrdineOLOTarget found&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI OLO Failed : not enough parameters.&quot;;&#xD;
}*/</xpdl2:Script>
