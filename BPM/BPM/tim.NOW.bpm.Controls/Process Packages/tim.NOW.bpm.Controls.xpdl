              <xpdl2:Coordinates XCoordinate="578.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_GiMvshdEEeqUUMXiyzzYEw" Name="VerificaDataDSC" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Data DSC" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL DATA DSC CPS. Controllo passato&quot;;&#xD;
&#xD;
//RU_1115: DSC non deve essere minore di sysdate, ma minore o uguale della DRO&#xD;
//var sysdate = DateTimeUtil.createDate();&#xD;
var DRO = DateTimeUtil.createDate();&#xD;
DRO = null;&#xD;
&#xD;
var DSC = DateTimeUtil.createDate();&#xD;
DSC = null;&#xD;
var DataInizioValiditaDATE = DateTimeUtil.createDate();&#xD;
DataInizioValiditaDATE = null;&#xD;
&#xD;
var dataDSC = '';&#xD;
dataDSC = null;&#xD;
&#xD;
//recupero la DSC da ACCESSOCPS&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);	&#xD;
		if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
		{&#xD;
			var j = 0;&#xD;
			var foundDataDSC = false;&#xD;
			while(!foundDataDSC &amp;&amp; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DSC)&#xD;
				{&#xD;
					dataDSC = currentAttDettOrdine.valoreAttributo;&#xD;
					foundDataDSC = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(dataDSC != null)&#xD;
{&#xD;
	var giorno = &quot;&quot;;&#xD;
	giorno = dataDSC.slice(0,2);&#xD;
	var mese = &quot;&quot;;&#xD;
	mese = dataDSC.slice(3,5);&#xD;
	var anno = &quot;&quot;;&#xD;
	anno = dataDSC.slice(6,10);&#xD;
	&#xD;
	DSC = DateTimeUtil.createDate(anno+&quot;-&quot;+mese+&quot;-&quot;+giorno);&#xD;
 &#xD;
 	DataInizioValiditaDATE = DateTimeUtil.createDate(String(dataInizioValidita).slice(0,10));&#xD;
	&#xD;
	DRO = DateTimeUtil.createDate(localRequest.DRO);   //RU_1115&#xD;
 &#xD;
    //RU_1115: DSC non deve essere minore di sysdate, ma minore o uguale della DRO&#xD;
	if(DSC &lt;= DRO &amp;&amp; DSC >= DataInizioValiditaDATE)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL DATA DSC CPS. data DSC > DRO oppure &lt; dataInizioValidita.&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DATA DSC CPS. data DSC non valorizzata.&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione+&quot; DSC: &quot;+String(DSC)+&quot;, dataInizioValiditaDATE: &quot;+String(DataInizioValiditaDATE)+&quot;, DRO: &quot;+String(DRO));</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="86.0" LaneId="_Gh7C4BdEEeqUUMXiyzzYEw" Width="108.0">
              <xpdl2:Coordinates XCoordinate="270.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
