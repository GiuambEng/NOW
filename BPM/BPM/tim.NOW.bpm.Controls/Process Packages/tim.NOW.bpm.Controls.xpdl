        <xpdl2:Activity Id="_lXKyoVJCEeafMOVsQ226Vw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_g3KLIFJCEeafMOVsQ226Vw" xpdExt:Visibility="Public">
          <xpdl2:Event>
