        <xpdl2:Activity Id="_ejDQsXB6EeeO8NmiNqPvrg" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = true;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	var MCRdown = false;&#xD;
	var MCRup = false;&#xD;
	var PCRdown = false;&#xD;
	var PCRup = false;&#xD;
	var SCRdown = false;&#xD;
	var SCRup = false;&#xD;
	var i = 0;&#xD;
	&#xD;
	while((!MCRdown || !MCRup || !PCRdown || !PCRup || !SCRup || !SCRdown) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if (currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
		{&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRDOWN)&#xD;
				{&#xD;
					MCRdown = true;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRUP)&#xD;
				{&#xD;
					MCRup = true;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRDOWN)&#xD;
				{&#xD;
					PCRdown = true;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRUP)&#xD;
				{&#xD;
					PCRup = true;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SCRDOWN)&#xD;
				{&#xD;
					SCRdown = true;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SCRUP)&#xD;
				{&#xD;
					SCRup = true;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	i++;&#xD;
	}&#xD;
	&#xD;
	if(!((MCRdown &amp;&amp; MCRup) || (PCRdown &amp;&amp; PCRup) || (SCRup &amp;&amp; SCRdown)))&#xD;
	{&#xD;
		EseguiControllo = false;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
