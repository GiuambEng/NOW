          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaBMCLightRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createVerifica_VLAN_NGA_BMC_e_BMC_LightRequestType();&#xD;
&#xD;
VerificaBMCLightRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
VerificaBMCLightRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
VerificaBMCLightRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
&#xD;
//ATTIVAZIONE&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
		if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
				{&#xD;
					VerificaBMCLightRequest.codiceTdKit = attributo.valoreAttributo;		&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLLI)&#xD;
				{&#xD;
					VerificaBMCLightRequest.clliCentrale = attributo.valoreAttributo;	&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA)&#xD;
				{&#xD;
					VerificaBMCLightRequest.superMacroArea = attributo.valoreAttributo;	&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BMCLIGHT)&#xD;
				{&#xD;
					VerificaBMCLightRequest.bmcLight = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
				{&#xD;
					VerificaBMCLightRequest.famigliaVlan = attributo.valoreAttributo;	&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCAR)&#xD;
				{                                                                          &#xD;
					VerificaBMCLightRequest.CAR = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN)&#xD;
				{                                                                          &#xD;
					VerificaBMCLightRequest.CC_LIB = attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
				&#xD;
//VARIAZIONE&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	var CodiceTdkitTrovato = false;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA)&#xD;
				{&#xD;
					VerificaBMCLightRequest.superMacroArea = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCAR)&#xD;
				{                                                                          &#xD;
					VerificaBMCLightRequest.CAR = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT &#xD;
				&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT)&#xD;
				{                                                                          &#xD;
					VerificaBMCLightRequest.codiceTdKit = attributo.valoreAttributo;&#xD;
					CodiceTdkitTrovato = true;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(ConsistenzaRaccolta != null &amp;&amp; ConsistenzaRaccolta!= '')&#xD;
	{&#xD;
		if(ConsistenzaRaccolta.codiceTdKit != null &amp;&amp; ConsistenzaRaccolta.codiceTdKit != '' &amp;&amp; !CodiceTdkitTrovato)&#xD;
		{&#xD;
			VerificaBMCLightRequest.codiceTdKit = ConsistenzaRaccolta.codiceTdKit;&#xD;
		}&#xD;
		if(ConsistenzaRaccolta.codiceClli != null &amp;&amp; ConsistenzaRaccolta.codiceClli != '')&#xD;
		{&#xD;
			VerificaBMCLightRequest.clliCentrale = ConsistenzaRaccolta.codiceClli;&#xD;
		}&#xD;
		if(ConsistenzaRaccolta.bmcLight != null &amp;&amp; ConsistenzaRaccolta.bmcLight != '')&#xD;
		{&#xD;
			VerificaBMCLightRequest.bmcLight = ConsistenzaRaccolta.bmcLight;&#xD;
		}&#xD;
		if(ConsistenzaRaccolta.famigliaVlan != null &amp;&amp; ConsistenzaRaccolta.famigliaVlan != '')&#xD;
		{&#xD;
			VerificaBMCLightRequest.famigliaVlan = ConsistenzaRaccolta.famigliaVlan;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(lavorazioneRichiesta != null &amp;&amp; lavorazioneRichiesta != '')&#xD;
	{&#xD;
		if(lavorazioneRichiesta.tipologiaClusterVlan != null &amp;&amp; lavorazioneRichiesta.tipologiaClusterVlan != '')&#xD;
		{&#xD;
			VerificaBMCLightRequest.CC_LIB = lavorazioneRichiesta.tipologiaClusterVlan;&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
