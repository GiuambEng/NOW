          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">verificaIncompServiziOpzionaliRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaIncompatibilitaServiziOpzionali_RequestType();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	verificaIncompServiziOpzionaliRequest.DRO = localRequest.DRO;&#xD;
	verificaIncompServiziOpzionaliRequest.IDRichiesta = localRequest.IDRichiestaOLO;&#xD;
	verificaIncompServiziOpzionaliRequest.codiceProgetto = localRequest.codiceProgetto;&#xD;
	verificaIncompServiziOpzionaliRequest.disaggregato = localRequest.disaggregato;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
		{&#xD;
			for(var j=0;j&lt;componente.attributiDettaglioOrdine.size();j++)&#xD;
		 	{&#xD;
		 		var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
		 		&#xD;
		 		if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO)&#xD;
		 		 {&#xD;
		 		 	verificaIncompServiziOpzionaliRequest.codiceServizio.add(attributo.valoreAttributo);&#xD;
		 		 }&#xD;
		 	}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_v3QPcgXoEe6dJ_gq6BcMpw" Name="PrecondizioneFallita" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione Fallita" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL INCOMPATIBILITA SERVIZI OPZIONALI C04M01F496 precondizione fallita&quot;;&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_W0DioQXmEe6dJ_gq6BcMpw" Width="96.0">
