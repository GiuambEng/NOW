            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_IsMMEQDZEea3XoEZuqG7Cg" Width="31.0">
              <xpdl2:Coordinates XCoordinate="855.0" YCoordinate="268.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_IsMMFQDZEea3XoEZuqG7Cg" Name="CodiceOrdineTIStato" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Codice Ordine TI Stato">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var checkStatus = 0;&#xD;
&#xD;
if (targetRequestRef != null)&#xD;
{&#xD;
	var ordineRiferimento = targetRequestRef.readRichiesta();&#xD;
	&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTO)&#xD;
	{&#xD;
		//Change Request #26296 - R1I-19-0354 	Stato Ordine &lt;> SOSPESO OPERE SPECIALI per servizi diversi da DATI&#xD;
		if(String(ordineRiferimento.statoRichiestaNOW).slice(0,6) != &quot;CHIUSO&quot; &amp;&amp;         			//SM_9725&#xD;
			String(ordineRiferimento.statoRichiestaNOW).slice(0,19) != &quot;ESPLETAMENTOTECNICO&quot; &amp;&amp;		//SM_9826&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO &amp;&amp;&#xD;
			String(ordineRiferimento.statoRichiestaNOW).slice(0,8) != &quot;SCARTATO&quot; &amp;&amp;					//SM_9826&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO &amp;&amp;&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOAFATTURAZIONE &amp;&amp;&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSULDELIVERY &amp;&amp;&#xD;
			String(ordineRiferimento.statoRichiestaNOW).slice(0,9) != &quot;ANNULLATO&quot; &amp;&amp;				//SM_9826&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INACCETTAZIONEPREVENTIVO &amp;&amp;&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOPERRIFIUTOPREVENTIVO &amp;&amp;&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETATOOKCONSUNTIVO &amp;&amp;&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESACONSUNTIVO &amp;&amp;&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESAESPLETAMENTOFONIA &amp;&amp;&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INRICHIESTAPREVENTIVO &amp;&amp;&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDTUPEROF &amp;&amp; 		//RU_1500 &#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSUDTUPERKOOF &amp;&amp;		//RU_1500 &#xD;
			ordineRiferimento.statoRichiestaOF != it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.ANNULLATOOF &amp;&amp;						//RU_1500 &#xD;
			ordineRiferimento.statoRichiestaOF != it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.INRICHIESTAANNULLAMENTOAUTO &amp;&amp;		//RU_1500 &#xD;
			ordineRiferimento.statoRichiestaOF != it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.INRICHIESTAANNULLAMENTO &amp;&amp;			//RU_1500 &#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACQUISITOKOD82 &amp;&amp;            //RU_1554: esclusi stati D82&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACCETTATOKOD82 &amp;&amp;&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETATOKOD82 &amp;&amp;&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETATOD82 &amp;&amp;&#xD;
			ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATOD82)&#xD;
		{&#xD;
		    //RU_958&#xD;
			if(!(ordineRiferimento.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOOPERESPECIALI &amp;&amp; &#xD;
					(ordineRiferimento.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG ||&#xD;
					 ordineRiferimento.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)))&#xD;
			{&#xD;
				checkStatus = 1;&#xD;
			}&#xD;
		}&#xD;
		//end Change Request #26296 - R1I-19-0354&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.INTERRUZIONESOSPENSIONE)&#xD;
	{&#xD;
		Process.auditLog(&quot;Lavorazione: &quot; + String(localRequest.lavorazione) + &quot;. StatoNOW: &quot; + String(ordineRiferimento.statoRichiestaNOW));&#xD;
		&#xD;
		if((ordineRiferimento.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESO &#xD;
		   &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM) || &#xD;
		   ((ordineRiferimento.statoRichiestaOF == it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.SOSPESOOF ||  //RU_1451&#xD;
		   	 ordineRiferimento.statoRichiestaOF == it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.ESPLETATOOK) &amp;&amp;	//SM_11286&#xD;
		    ordineRiferimento.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESO &amp;&amp;&#xD;
			localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM))		&#xD;
		{&#xD;
			//R1I-20-0128 &#xD;
			//Prop SM_9255: inserito caso in cui il codice è null&#xD;
			if(ordineRiferimento.codiceCausaleInterno != null)			&#xD;
			{&#xD;
				Process.auditLog(&quot;CodiceCausaleInterno: &quot; + String(ordineRiferimento.codiceCausaleInterno));&#xD;
				&#xD;
				//RU_1381: Modificata logica di recupero configurazione: oltre a -COVID19 vengono gestite altre configurazioni per altri codici causale&#xD;
				var causale = '';&#xD;
				if (ordineRiferimento.codiceCausaleInterno.length > 10 &amp;&amp; ordineRiferimento.codiceCausaleInterno.slice(4,11) == 'COVID19')&#xD;
				{&#xD;
					causale='COVID19';&#xD;
				}else{&#xD;
					causale=ordineRiferimento.codiceCausaleInterno;					&#xD;
				}&#xD;
				&#xD;
				//SM_11164: PER GPON IN GESTIONE AUTONOMA, SE SIAMO NEL CASO DI Z66 E 831 L'INTERRUZIONESOSPENSIONE VA INIBITA (checkStatus resta a 0)&#xD;
				//MA SOLO PER QUESTO CASO, PER GLI ALTRI OL LA SITUAZIONE RESTA QUELLA DI SEMPRE&#xD;
				if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON&#xD;
				   &amp;&amp; ordineRiferimento.gestioneAutonoma != null &amp;&amp; ordineRiferimento.gestioneAutonoma != &quot;&quot;  //SM_11172&#xD;
				   &amp;&amp; (causale == &quot;Z66&quot; || causale == &quot;831&quot;))&#xD;
				{&#xD;
					Process.auditLog(&quot;Siamo nel caso UBBSEMIGPON con gestioneAutonoma e causale:&quot; +causale);&#xD;
				}&#xD;
				else //SOLITO&#xD;
				{&#xD;
					Process.auditLog(&quot;Default - recupero della configurazione&quot;);&#xD;
					&#xD;
					var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key = 'DeSospensione&quot; + causale + &quot;'&quot;);&#xD;
					var configurations = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(criteria);&#xD;
					&#xD;
					if(configurations!=null &amp;&amp; configurations.size()>0)&#xD;
					{&#xD;
						configuration = configurations.get(0).readConfiguration();&#xD;
						Process.auditLog(&quot;Recuperata la configurazione DeSospensione&quot; + causale + &quot;: &quot; + configuration.value);&#xD;
						&#xD;
						if(configuration.value != 'N')&#xD;
						{&#xD;
							checkStatus = 1;&#xD;
						}&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						checkStatus = 1;&#xD;
					}				&#xD;
				}&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				checkStatus = 1;&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDAD)&#xD;
	{&#xD;
		if((ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACCODATO &amp;&amp;&#xD;
		   ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESO &amp;&amp;&#xD;
		   ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESACONFERMAANNULLAMENTO) ||&#xD;
		  (ordineRiferimento.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESO &amp;&amp;					//SM_11289&#xD;
		   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM))&#xD;
		{&#xD;
			checkStatus = 1;&#xD;
		}&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDAC&#xD;
			|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDACDARECIPIENT)&#xD;
	{&#xD;
		if(ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESO &amp;&amp;&#xD;
		   ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESACONFERMAANNULLAMENTO)&#xD;
		{&#xD;
			checkStatus = 1;&#xD;
		}&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CANCELLAZIONEACCODAMENTO)&#xD;
	{&#xD;
		if(ordineRiferimento.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACCODATO)&#xD;
		{&#xD;
			checkStatus = 1;&#xD;
		}&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ACCETTAZIONEOPERESPECIALI)&#xD;
	{&#xD;
		if(ordineRiferimento.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INACCETTAZIONEPREVENTIVO)&#xD;
		{&#xD;
			checkStatus = 1;&#xD;
		}&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.INTERRUZIONEMIGRAZIONE)&#xD;
	{&#xD;
		if(String(ordineRiferimento.statoRichiestaNOW).slice(0,6) != &quot;CHIUSO&quot; &amp;&amp;         			//SM_9725&#xD;
		   String(ordineRiferimento.statoRichiestaNOW).slice(0,19) != &quot;ESPLETAMENTOTECNICO&quot; &amp;&amp;		//SM_9826&#xD;
		   String(ordineRiferimento.statoRichiestaNOW).slice(0,8) != &quot;SCARTATO&quot; &amp;&amp;					//SM_9826&#xD;
		   String(ordineRiferimento.statoRichiestaNOW).slice(0,9) != &quot;ANNULLATO&quot; &amp;&amp;					//SM_9826&#xD;
		   ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO &amp;&amp;&#xD;
		   ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO &amp;&amp;&#xD;
		   ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOAFATTURAZIONE &amp;&amp;&#xD;
		   ordineRiferimento.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INANNULLAMENTOSULDELIVERY)&#xD;
		{&#xD;
			checkStatus = 1;&#xD;
		}&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RISCONTROCODICESESSIONE)&#xD;
	{&#xD;
		if(ordineRiferimento.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVERIFICADONATING)&#xD;
		{&#xD;
			checkStatus = 1;&#xD;
		}&#xD;
	}&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RICHIESTAPREVENTIVOOPERESPECIALI) // RU_869&#xD;
	{&#xD;
		if(ordineRiferimento.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOOPERESPECIALI &amp;&amp;&#xD;
			   (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB //RU_894: aggiunte offerte EASYIP&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH     //RU_1164: aggiunte offerte SEMI***&#xD;
             || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
             || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
			 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA))   //KIT C06 2025&#xD;
		{&#xD;
			checkStatus = 1;&#xD;
		}	&#xD;
	}&#xD;
	// RU_975&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.PRENOTIFICADISATTIVAZIONECPS)&#xD;
	{&#xD;
		if(ordineRiferimento.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVERIFICADONATING&#xD;
		&amp;&amp; ordineRiferimento.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
		{&#xD;
			checkStatus = 1;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	// RU_970&#xD;
	if(String(localRequest.lavorazione).slice(0,15) == &quot;RIMODULAZIONEDA&quot;)&#xD;
	{&#xD;
		var tokenAppuntamento = &quot;&quot;;&#xD;
		tokenAppuntamento = null;&#xD;
		var statoTokenAppuntamento = &quot;&quot;;&#xD;
		statoTokenAppuntamento = null;&#xD;
		&#xD;
		var i = 0;&#xD;
		while((tokenAppuntamento == null || statoTokenAppuntamento == null) &amp;&amp; i &lt; ordineRiferimento.ordine.dettaglioordine.size())&#xD;
		{	&#xD;
			var componente = ordineRiferimento.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for(var h=0; h&lt;componente.attributiDettaglioOrdine.size(); h++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(h);&#xD;
						&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TOKENAPPUNTAMENTO)&#xD;
					{&#xD;
						tokenAppuntamento = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATOTOKENAPPUNTAMENTO)&#xD;
					{&#xD;
						statoTokenAppuntamento = attributo.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		if(tokenAppuntamento != null &amp;&amp; statoTokenAppuntamento != &quot;VALIDO&quot;)&#xD;
		{&#xD;
			checkStatus = 0;&#xD;
			Process.auditLog(&quot;Caso particolare RIMODULAZIONE DAxxx, sovrascritto esito, messo a false in quanto statoTokenAppuntamento: &quot;+statoTokenAppuntamento);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
}/*&#xD;
else&#xD;
{&#xD;
	if (localRequest.codiceOrdineOLOTarget != null)&#xD;
	{&#xD;
		checkStatus = 1;&#xD;
	}&#xD;
}*/&#xD;
&#xD;
&#xD;
&#xD;
if(checkStatus == 1)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI STATO Successful. Stato Target &quot;+ordineRiferimento.statoRichiestaNOW+&quot;, offerta &quot;+localRequest.offerta;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI STATO Failed : Value specified for statoRichiestaNOW in input request is not applicable for current lavorazione&quot;;&#xD;
}	&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
