        <xpdl2:Activity Id="_kGbGEiMnEea7qJ_CMNwz5w" Name="VerificaRidondanzaCodiceVLAN" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Ridondanza Codice VLAN">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var foundSvlanCode = false;&#xD;
var foundCodeVlanSingleTag = false;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if((currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN || currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC) &amp;&amp; currentDettaglioOrdine.attributiDettaglioOrdine != null)&#xD;
		{&#xD;
			foundSvlanCode = false;&#xD;
			foundCodeVlanSingleTag = false;&#xD;
			var j = 0;&#xD;
			while((!foundSvlanCode || !foundCodeVlanSingleTag) &amp;&amp; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentDettaglioOrdine.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
				{&#xD;
					//Trovato SVLANCODE&#xD;
					foundSvlanCode = true;&#xD;
				}&#xD;
				else if(currentDettaglioOrdine.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
				{&#xD;
					//Trovato CodevlanSingleTag&#xD;
					foundCodeVlanSingleTag = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
			&#xD;
		if(foundSvlanCode &amp;&amp; foundCodeVlanSingleTag)&#xD;
		{&#xD;
			//Entrambi gli attributi (SVlanCode, CodeVlanSingleTag) trovati&#xD;
			break;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(foundSvlanCode &amp;&amp; foundCodeVlanSingleTag)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;SVLANCODE e CodevlanSingleTag non mutuamente esclusivi&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;SVLANCODE e CodevlanSingleTag mutuamente esclusivi&quot;;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
