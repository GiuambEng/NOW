          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_p6PvMMuPEee_cajyhqoTSw" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = false;&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)&#xD;
{&#xD;
	EseguiControllo = true;&#xD;
}&#xD;
&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB ||&#xD;
    localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH ||&#xD;
	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH ||         //RU_1164&#xD;
    localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH ||&#xD;
    localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH ||&#xD;
    localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS ||&#xD;
    localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA ||  //KIT C06 2025&#xD;
    localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
{&#xD;
	var foundUserVlan1Tagging = false;&#xD;
	var isTagged = false;&#xD;
	&#xD;
	//Task #36267: Per tutte le VARIAZIONI tranne VARIAZIONETAGGING, va considerato USERVLAN1TAGGING dell'asset&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
	   &amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING)&#xD;
	{&#xD;
		//RECUPERO ASSET&#xD;
		if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
		{&#xD;
			AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
		}&#xD;
&#xD;
		if(AssetRef!= null)&#xD;
		{	&#xD;
			Asset = AssetRef.readAsset();&#xD;
		}&#xD;
&#xD;
		if(Asset != null &amp;&amp; Asset.dettaglioasset != null)&#xD;
		{&#xD;
			for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
			{&#xD;
				var currentComponente = Asset.dettaglioasset.get(i);&#xD;
&#xD;
				if(String(currentComponente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					for(var j=0; j&lt;currentComponente.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var currentAttributo = currentComponente.attributidettaglioasset.get(j);&#xD;
					&#xD;
						if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING&#xD;
						   &amp;&amp; currentAttributo.valoreAttributo.toUpperCase() == &quot;TAGGED&quot;)&#xD;
						{&#xD;
							isTagged = true;&#xD;
							Process.auditLog(&quot;Trovato attributo USERVLAN1TAGGING nell'Asset&quot;+ currentAttributo.valoreAttributo);&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else //Solito (Pre-Task #36267)&#xD;
	{	&#xD;
		var i=0;&#xD;
		&#xD;
		while(!foundUserVlan1Tagging &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
			if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j=0;&#xD;
				&#xD;
				while(!foundUserVlan1Tagging &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING)&#xD;
					{&#xD;
						foundUserVlan1Tagging = true;&#xD;
					&#xD;
						if(currentAttDettOrdine.valoreAttributo.toUpperCase() == &quot;TAGGED&quot;)&#xD;
						{&#xD;
							isTagged = true;&#xD;
						}&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}	&#xD;
	}&#xD;
&#xD;
	if(isTagged)&#xD;
	{&#xD;
		EseguiControllo = true;&#xD;
	}&#xD;
}&#xD;
&#xD;
//SM_9019&#xD;
if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
{&#xD;
	EseguiControllo = false;&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
