        <xpdl2:Activity Id="_O-j1MNszEeu7x9j_Oo9ywg" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">eseguiControllo = false;&#xD;
&#xD;
//SM_10138: il controllo deve essere chiamato se c'è almeno una USERVLAN con FLAGMULTICAST a SI&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)  //KIT C06 2025&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST&#xD;
				   &amp;&amp; attributo.valoreAttributo == &quot;SI&quot;)&#xD;
				{&#xD;
					eseguiControllo = true;&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
	&#xD;
	//Se non ha trovato FLAGMULTICAST sull'ordine, ma siamo in variazione, dobbiamo controllare anche in ASSET&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
	&amp;&amp; ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
		asset = AssetRef.readAsset();&#xD;
		&#xD;
		if(asset != null &amp;&amp; !eseguiControllo)&#xD;
		{&#xD;
			for(var k = 0; k &lt; asset.dettaglioasset.size(); k++)&#xD;
			{&#xD;
				var currentDettAsset = asset.dettaglioasset.get(k);&#xD;
				&#xD;
				if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
				{&#xD;
					for(var z = 0; z &lt; currentDettAsset.attributidettaglioasset.size(); z++)&#xD;
					{&#xD;
						var attributoAss = currentDettAsset.attributidettaglioasset.get(z);&#xD;
						&#xD;
						if(attributoAss.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
						{&#xD;
							eseguiControllo = true;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
