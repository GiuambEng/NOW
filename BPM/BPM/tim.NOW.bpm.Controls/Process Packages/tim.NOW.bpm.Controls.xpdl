        <xpdl2:DataField Id="_L18MUOIKEeqeRbNUQWBXYw" xpdExt:DisplayName="VerificaDominioValoriDiBandaRequest" Name="VerificaDominioValoriDiBandaRequest" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="com.tim.NOW.xsd.ControlliVlan.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.ControlliVlanVerifica_Dominio_Valori_Banda_RequestType"/>
