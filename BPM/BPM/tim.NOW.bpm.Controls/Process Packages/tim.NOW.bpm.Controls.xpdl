            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_IW_ZUfmgEeWxfZ79Ifv7Eg" Width="96.0">
              <xpdl2:Coordinates XCoordinate="560.0" YCoordinate="317.0"/>
            </xpdl2:NodeGraphicsInfo>
