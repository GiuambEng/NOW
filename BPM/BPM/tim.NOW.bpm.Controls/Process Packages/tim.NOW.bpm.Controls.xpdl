          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = false;&#xD;
&#xD;
for(var i=0; i&lt;VerificaServizioAggiuntivoResponse.servizio.size(); i++)&#xD;
{&#xD;
	var servizioNow = VerificaServizioAggiuntivoResponse.servizio.get(i);&#xD;
	&#xD;
	if(servizioNow.ambito == &quot;DTU&quot;)&#xD;
	{&#xD;
		EseguiControllo = true;&#xD;
		Process.auditLog(&quot;Trovato ServizioAggiuntivo in AMBITO DTU&quot;);&#xD;
	}&#xD;
}&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
