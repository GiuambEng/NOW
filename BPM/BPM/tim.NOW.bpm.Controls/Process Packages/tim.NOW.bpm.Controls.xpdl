          </xpdl2:Implementation>
          <xpdl2:Performers>
            <xpdl2:Performer>_YoQtQBO0EeekW5j-cV6_qA</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="79.0" LaneId="_k3UGsX_AEeqvvKm_Ydj5SQ" Width="145.0">
              <xpdl2:Coordinates XCoordinate="570.0" YCoordinate="188.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaPresaAppuntamentoRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaPresaAppuntamentoDisaggregazione_ReqType();&#xD;
&#xD;
VerificaPresaAppuntamentoRequest.offerta = String(localRequest.offerta);&#xD;
VerificaPresaAppuntamentoRequest.idRichiesta = localRequest.IDRichiestaOLO;&#xD;
VerificaPresaAppuntamentoRequest.lavorazione = String(localRequest.lavorazione);&#xD;
VerificaPresaAppuntamentoRequest.dro = localRequest.DRO;&#xD;
&#xD;
var DataAppuntamento = &quot;&quot;;&#xD;
DataAppuntamento = null;&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTODISAGGREGAZIONE)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OWNERPRESAAPPUNTAMENTO)&#xD;
			{&#xD;
				VerificaPresaAppuntamentoRequest.ownerPresaAppuntamento = attributo.valoreAttributo;&#xD;
			}&#xD;
			&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAAPPUNTAMENTO)&#xD;
			{&#xD;
				DataAppuntamento = attributo.valoreAttributo;&#xD;
				&#xD;
				var giorno = &quot;&quot;;&#xD;
				giorno = DataAppuntamento.slice(0,2);&#xD;
				var mese = &quot;&quot;;&#xD;
				mese = DataAppuntamento.slice(3,5);&#xD;
				var anno = &quot;&quot;;&#xD;
				anno = DataAppuntamento.slice(6,10);&#xD;
				&#xD;
				VerificaPresaAppuntamentoRequest.dataAppuntamento = DateTimeUtil.createDate(anno+&quot;-&quot;+mese+&quot;-&quot;+giorno);&#xD;
			}&#xD;
			&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FASCIAORARIA)&#xD;
			{&#xD;
				VerificaPresaAppuntamentoRequest.fasciaOraria = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
