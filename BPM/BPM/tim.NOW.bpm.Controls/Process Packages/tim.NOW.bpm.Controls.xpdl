    <xpdl2:WorkflowProcess Id="_o_dO4P1GEeWEXoIZeVGhKA" xpdExt:DisplayName="CTRL COD ORD TI TIPO" Name="CTRLCODORDTITIPO">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_o_qqQf1GEeWEXoIZeVGhKA" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_o_dO4v1GEeWEXoIZeVGhKA" Width="31.0">
              <xpdl2:Coordinates XCoordinate="680.0" YCoordinate="259.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_o_qqQv1GEeWEXoIZeVGhKA" Name="CodiceOrdineTITipo" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Codice Ordine TI Tipo">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
//Verifiche preliminari&#xD;
if(localRequest != null)&#xD;
{&#xD;
       if(localRequest.codiceOrdineTITarget != null)&#xD;
       {&#xD;
             if(targetRequest != null)&#xD;
             {&#xD;
                    /*&#xD;
                    var checkStruttura = localRequest.strutturaRichiesta == targetRequest.strutturaRichiesta;&#xD;
       &#xD;
                    var checkLavorazioneDB = &#xD;
                     (targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp; &#xD;
                          (String(targetRequest.offerta).substring(0,3) == 'ULL' ||&#xD;
                          String(targetRequest.offerta).substring(0,3) == 'SLU' ||&#xD;
                          String(targetRequest.offerta).substring(0,4) == 'VULA' ||&#xD;
                          String(targetRequest.offerta).substring(0,9) == 'BITSTREAM' ||&#xD;
                          String(targetRequest.offerta).substring(0,6) == 'EASYIP' ||&#xD;
                          String(targetRequest.offerta).substring(0,3) == 'WLR' ||&#xD;
                          String(targetRequest.offerta).substring(0,4) == 'VULL'));&#xD;
                          &#xD;
                    var checkLavorazioneLocal = localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTO || &#xD;
                                                                  localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDAD ||&#xD;
                                                                  localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CANCELLAZIONEACCODAMENTO ||&#xD;
                                                                  localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.STATOAVANZAMENTO ||&#xD;
                                                                  localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.INTERRUZIONESOSPENSIONE;&#xD;
&#xD;
                    if(checkLavorazioneDB &amp;&amp; checkLavorazioneLocal &amp;&amp; checkStruttura)&#xD;
                    {&#xD;
                          EsitoResponse.codice = true;&#xD;
                          EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO Successful&quot;;&#xD;
                    }&#xD;
                    else&#xD;
                    {&#xD;
                          EsitoResponse.codice = false;&#xD;
                          EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO Failed : Specified codiceOrdineTI does not contain any record for (ATTIVAZIONE or CESSAZIONE) or &quot; + &#xD;
                                                                         &quot;(ANNULLAMENTO, RIMODULAZIONEDAD, CANCELLAZIONEACCODAMENTO or INTERRUZIONESOSPENSIONE)&quot;;&#xD;
                    }            &#xD;
                    */&#xD;
                    &#xD;
                    var lnala = &quot;&quot;;&#xD;
                    lnala = null;&#xD;
                    &#xD;
                    if(targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
                          || targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
                          || targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
                          || targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
                          || targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
                          || targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
                          || targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
                           || targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA)&#xD;
                    {&#xD;
                          lnala = &quot;LA&quot;;&#xD;
                    }&#xD;
                    else if(targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
                                 || targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
                                 || targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA&#xD;
                                 || targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA&#xD;
                                 || targetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA)&#xD;
                    {&#xD;
                          lnala = &quot;LNA&quot;;&#xD;
                    }&#xD;
                    &#xD;
                    if(lnala != null)&#xD;
                    {&#xD;
                          Process.auditLog(&quot;LNA_LA della targetRequest calcolato: &quot; + lnala);&#xD;
                    }&#xD;
                    &#xD;
                    //ANNULLAMENTO&#xD;
                    if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTO)&#xD;
                    {&#xD;
                          if(localRequest.strutturaRichiesta == targetRequest.strutturaRichiesta&#xD;
                                 &amp;&amp; targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
                          {&#xD;
                                 if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
                                 {&#xD;
                                       if(lnala == &quot;LNA&quot;)&#xD;
                                       {&#xD;
                                              EsitoResponse.codice = true;&#xD;
                                              EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO positivo&quot;;&#xD;
                                       }									   						   &#xD;
									   else&#xD;
                                       {&#xD;
                                              EsitoResponse.codice = false;&#xD;
                                              EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO fallito: Trovata ATTIVAZIONE LA&quot;;&#xD;
                                       }&#xD;
                                 }&#xD;
                                 else&#xD;
                                 {&#xD;
                                       EsitoResponse.codice = true;&#xD;
                                       EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO positivo&quot;;&#xD;
                                 }&#xD;
                          }&#xD;
						  //Bug #35055&#xD;
						  else if(targetRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO&#xD;
							   &amp;&amp; targetRequest.ordineAssetWhiteList != null)&#xD;
                          {&#xD;
								 EsitoResponse.codice = true;&#xD;
								 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO positivo&quot;;&#xD;
                          }&#xD;
                          else&#xD;
                          {&#xD;
                                 EsitoResponse.codice = false;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO fallito: StrutturaLocal: &quot; + localRequest.strutturaRichiesta + &quot; StrutturaTarget: &quot; + targetRequest.strutturaRichiesta + &quot; lavorazioneTarget: &quot; + targetRequest.lavorazione;&#xD;
                          }&#xD;
                    }&#xD;
                    //INTERRUZIONEMIGRAZIONE&#xD;
                    else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.INTERRUZIONEMIGRAZIONE)&#xD;
                    {&#xD;
                          if(localRequest.strutturaRichiesta == targetRequest.strutturaRichiesta)&#xD;
                          {&#xD;
                                 if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO)&#xD;
                                 {&#xD;
									   //Bug #35055 - per questa sottolav particolare deve arrivare ANNULLAMENTO, anche se si tratta di una migrazione&#xD;
									   if(targetRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO&#xD;
										   &amp;&amp; targetRequest.ordineAssetWhiteList != null)&#xD;
									   {&#xD;
											  EsitoResponse.codice = false;&#xD;
											  EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO fallito - MIGRAZIONEOLO WHITELIST, deve arrivare ANNULLAMENTO e non INTERRUZIONEMIGRAZIONE&quot;;&#xD;
									   }&#xD;
                                       else if(targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
                                              || (targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
                                                    &amp;&amp; lnala == &quot;LA&quot;))&#xD;
                                       {&#xD;
                                              EsitoResponse.codice = true;&#xD;
                                              EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO positivo&quot;;&#xD;
                                       }&#xD;
                                       else&#xD;
                                       {&#xD;
                                              EsitoResponse.codice = false;&#xD;
                                              EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO fallito: StrutturaLocal: &quot; + localRequest.strutturaRichiesta + &quot; StrutturaTarget: &quot; + targetRequest.strutturaRichiesta + &quot; lavorazioneTarget: &quot; + targetRequest.lavorazione;&#xD;
                                       }&#xD;
                                 }&#xD;
                                 else&#xD;
                                 {&#xD;
                                       if(targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
                                       {&#xD;
                                              EsitoResponse.codice = true;&#xD;
                                              EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO positivo&quot;;&#xD;
                                       }&#xD;
                                       else&#xD;
                                       {&#xD;
                                              EsitoResponse.codice = false;&#xD;
                                              EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO fallito: lavorazioneTarget: &quot; + targetRequest.lavorazione;&#xD;
                                       }&#xD;
                                 }&#xD;
                          }&#xD;
                          else&#xD;
                          {&#xD;
                                 EsitoResponse.codice = false;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO fallito: StrutturaLocal: &quot; + localRequest.strutturaRichiesta + &quot; StrutturaTarget: &quot; + targetRequest.strutturaRichiesta;&#xD;
                          }&#xD;
                    }&#xD;
                    //RIMODULAZIONEDAD&#xD;
                    else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDAD)&#xD;
                    {&#xD;
                          if(localRequest.strutturaRichiesta == targetRequest.strutturaRichiesta&#xD;
                          		&amp;&amp; (targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
                                       || targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
                                       || (targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &#xD;
                                       &amp;&amp; !(targetRequest.strutturaRichiesta ==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
                          				|| targetRequest.strutturaRichiesta ==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL))))&#xD;
                          {&#xD;
                                 EsitoResponse.codice = true;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO positivo&quot;;&#xD;
                          }&#xD;
                          else&#xD;
                          {&#xD;
                                 EsitoResponse.codice = false;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO fallito: StrutturaLocal: &quot; + localRequest.strutturaRichiesta + &quot; StrutturaTarget: &quot; + targetRequest.strutturaRichiesta + &quot; lavorazioneTarget: &quot; + targetRequest.lavorazione;&#xD;
                          }&#xD;
                    }&#xD;
                    //CANCELLAZIONEACCODAMENTO&#xD;
                    else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CANCELLAZIONEACCODAMENTO)&#xD;
                    {&#xD;
                          if(localRequest.strutturaRichiesta == targetRequest.strutturaRichiesta&#xD;
                                 &amp;&amp; (targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
                                       || targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE))&#xD;
                          {&#xD;
                                 EsitoResponse.codice = true;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO positivo&quot;;&#xD;
                          }&#xD;
                          else&#xD;
                          {&#xD;
                                 EsitoResponse.codice = false;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO fallito: StrutturaLocal: &quot; + localRequest.strutturaRichiesta + &quot; StrutturaTarget: &quot; + targetRequest.strutturaRichiesta + &quot; lavorazioneTarget: &quot; + targetRequest.lavorazione;&#xD;
                          }&#xD;
                    }&#xD;
                    //INTERRUZIONESOSPENSIONE&#xD;
                    else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.INTERRUZIONESOSPENSIONE)&#xD;
                    {&#xD;
                          if(localRequest.strutturaRichiesta == targetRequest.strutturaRichiesta&#xD;
                                 &amp;&amp; (targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
                                       || targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
                                       || (targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &#xD;
                                       &amp;&amp; !(targetRequest.strutturaRichiesta ==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
                          				|| targetRequest.strutturaRichiesta ==it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL))))&#xD;
                          {&#xD;
                                 EsitoResponse.codice = true;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO positivo&quot;;&#xD;
                          }&#xD;
                          else&#xD;
                          {&#xD;
                                 EsitoResponse.codice = false;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO fallito: StrutturaLocal: &quot; + localRequest.strutturaRichiesta + &quot; StrutturaTarget: &quot; + targetRequest.strutturaRichiesta + &quot; lavorazioneTarget: &quot; + targetRequest.lavorazione;&#xD;
                          }&#xD;
                    }&#xD;
                    //STATOAVANZAMENTO&#xD;
                    else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.STATOAVANZAMENTO)&#xD;
                    {&#xD;
                          if(localRequest.strutturaRichiesta == targetRequest.strutturaRichiesta&#xD;
                                 &amp;&amp; (targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
                                       || targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE))&#xD;
                          {&#xD;
                                 EsitoResponse.codice = true;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO positivo&quot;;&#xD;
                          }&#xD;
                          else&#xD;
                          {&#xD;
                                 EsitoResponse.codice = false;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO fallito: StrutturaLocal: &quot; + localRequest.strutturaRichiesta + &quot; StrutturaTarget: &quot; + targetRequest.strutturaRichiesta + &quot; lavorazioneTarget: &quot; + targetRequest.lavorazione;&#xD;
                          }&#xD;
                    }&#xD;
                    //RIMODULAZIONEDAC&#xD;
                    else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDAC&#xD;
                                 || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDACDARECIPIENT)&#xD;
                    {&#xD;
                          if(targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
                                 || targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
                          {&#xD;
                                 EsitoResponse.codice = true;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO positivo&quot;;&#xD;
                          }&#xD;
                          else&#xD;
                          {&#xD;
                                 EsitoResponse.codice = false;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO fallito: StrutturaLocal: &quot; + localRequest.strutturaRichiesta + &quot; StrutturaTarget: &quot; + targetRequest.strutturaRichiesta + &quot; lavorazioneTarget: &quot; + targetRequest.lavorazione;&#xD;
                          }&#xD;
                    }&#xD;
                    //RISCONTROCODICESESSIONE&#xD;
                    else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RISCONTROCODICESESSIONE)&#xD;
                    {&#xD;
                          if(targetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
                          {&#xD;
                                 EsitoResponse.codice = true;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO positivo&quot;;&#xD;
                          }&#xD;
                          else&#xD;
                          {&#xD;
                                 EsitoResponse.codice = false;&#xD;
                                 EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO fallito: StrutturaLocal: &quot; + localRequest.strutturaRichiesta + &quot; StrutturaTarget: &quot; + targetRequest.strutturaRichiesta + &quot; lavorazioneTarget: &quot; + targetRequest.lavorazione;&#xD;
                          }&#xD;
                    }&#xD;
                    else&#xD;
                    {&#xD;
                          EsitoResponse.codice = false;&#xD;
                          EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO fallito: Lavorazione della richiesta non gestita: &quot; + localRequest.lavorazione;&#xD;
                    }&#xD;
             }&#xD;
             else&#xD;
             {&#xD;
                    EsitoResponse.codice = false;&#xD;
                    EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO Failed : No record found for specified codiceOrdineTI&quot;;&#xD;
             }&#xD;
       }&#xD;
       else if(localRequest.codiceOrdineOLOTarget != null)&#xD;
       {&#xD;
             EsitoResponse.codice = true;&#xD;
             EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO Skipped : codiceOrdineOLOTarget found&quot;;&#xD;
       }&#xD;
}&#xD;
else&#xD;
{&#xD;
       EsitoResponse.codice = false;&#xD;
       EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI TIPO Failed : No record found for specified codiceOrdineTI&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
