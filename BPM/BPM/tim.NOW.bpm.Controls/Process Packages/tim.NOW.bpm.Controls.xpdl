        <xpdl2:Activity Id="_8Z3YIHnUEeaFitnB7kKNSA" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_4oTLAHnUEeaFitnB7kKNSA" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="82.0" LaneId="_h-_SEXmjEeaoH8j59Le6HA" Width="45.0">
