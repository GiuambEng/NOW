                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="output.CLLI">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.ordine.CLLI</xpdl2:Actual>
