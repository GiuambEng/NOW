          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaProfiloLineaRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaProfiloLinea_v2_RequestType();&#xD;
&#xD;
VerificaProfiloLineaRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaProfiloLineaRequest.caratteristica = localRequest.caratteristica;&#xD;
VerificaProfiloLineaRequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
VerificaProfiloLineaRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
&#xD;
if(localRequest.ordine.codicePacchettoNOW != null)&#xD;
{&#xD;
	VerificaProfiloLineaRequest.isPacchetto = true;&#xD;
}&#xD;
else&#xD;
{&#xD;
	VerificaProfiloLineaRequest.isPacchetto = false;&#xD;
}&#xD;
&#xD;
VerificaProfiloLineaRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
VerificaProfiloLineaRequest.scenario = String(localRequest.tipologiaScenario);&#xD;
&#xD;
if(localRequest.offerta != null)&#xD;
{&#xD;
	VerificaProfiloLineaRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
}&#xD;
&#xD;
var i = 0;&#xD;
while((VerificaProfiloLineaRequest.profiloTecnicoLinea == null || VerificaProfiloLineaRequest.tecnologia == null) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
	if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while((VerificaProfiloLineaRequest.profiloTecnicoLinea == null || VerificaProfiloLineaRequest.tecnologia == null) &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
			{&#xD;
				VerificaProfiloLineaRequest.profiloTecnicoLinea = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TECNOLOGIA)&#xD;
			{&#xD;
				VerificaProfiloLineaRequest.tecnologia = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}</xpdExt:Information>
