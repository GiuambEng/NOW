        <xpdl2:Activity Id="_fiWL8A5NEeeja9NY4DYfpQ" Name="Precodizionesaltata" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precodizione saltata">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;La precondizione non è stata superata, condizione = &quot;+preCondition+ &quot; Offerta: &quot;+localRequest.offerta);&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo COPPIA BANDE PICCO saltato, una o più precondizione non verificate&quot;;&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_h-_SEXmjEeaoH8j59Le6HA" Width="152.0">
              <xpdl2:Coordinates XCoordinate="1524.0" YCoordinate="406.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_pIXOhA5OEeeja9NY4DYfpQ" Name="SetInputVariazione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Set Input Variazione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//C04M01F94 - Verifica coppia Banda Picco set input variazioni&#xD;
&#xD;
input = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaCoppiaBandaPiccoRequestType();&#xD;
input.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
input.idRisorsa = localRequest.IDRisorsa;&#xD;
input.lavorazione = String(localRequest.lavorazione);&#xD;
input.sottoLavorazione = String(localRequest.ordine.tipologiaSottolav);&#xD;
input.profiloTecnicoLinea=&quot;&quot;;&#xD;
&#xD;
//Set Input x RICONFIGURAZIONEVC&#xD;
if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
		&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
			var k=0;&#xD;
			while(k&lt;componente.attributiDettaglioOrdine.size()){&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
				//PROFILOTECNICOLINEA&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA){&#xD;
					input.profiloTecnicoLinea = attributo.valoreAttributo;&#xD;
				}&#xD;
				k++;&#xD;
			}&#xD;
		}&#xD;
		if(componente.nomeComponente==it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
				var temp = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createUserVlan_CoppiaBandaPicco();&#xD;
				&#xD;
				var j=0;&#xD;
				while(j&lt;componente.attributiDettaglioOrdine.size()){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN){&#xD;
					&#xD;
						temp.bandaPiccoDown = attributo.valoreAttributo;&#xD;
					&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP){&#xD;
				&#xD;
						temp.bandaPiccoUp = attributo.valoreAttributo;&#xD;
					}&#xD;
					&#xD;
					else if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID){&#xD;
					&#xD;
						temp.uservlanId = attributo.valoreAttributo;&#xD;
					&#xD;
					}&#xD;
					&#xD;
					&#xD;
				j++;&#xD;
				}//end while&#xD;
			&#xD;
			input.userVlan.add(ScriptUtil.copy(temp));&#xD;
		&#xD;
		}//end USERVLAN&#xD;
	}//end for i&#xD;
	&#xD;
	&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
	var Asset = AssetRef.readAsset();&#xD;
	&#xD;
	input.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(Asset.offerta));&#xD;
	&#xD;
	for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
		if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
				if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
				{&#xD;
					input.profiloTecnicoLineaCONS = currentAttDettAsset.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		else if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
			 &amp;&amp; currentDettAsset.statoDettaglioAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO) //SM_9411&#xD;
		{&#xD;
			var temp = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createUserVlanCONS_CoppiaBandaPicco();&#xD;
			&#xD;
			for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
				if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
				{&#xD;
					temp.bandaPiccoUp = currentAttDettAsset.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
				{&#xD;
					temp.bandaPiccoDown = currentAttDettAsset.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
				{&#xD;
					temp.uservlanId = currentAttDettAsset.valoreAttributo;&#xD;
				}&#xD;
			}//end for j&#xD;
			&#xD;
			input.userVlanCONS.add(ScriptUtil.copy(temp));&#xD;
		}//end else if&#xD;
	 }//end for i&#xD;
	&#xD;
}//end if RICONFIGURAZIONEVC&#xD;
&#xD;
//Set Input INCREMENTODECREMENTOVC &amp; VARIAZIONETAGGING&#xD;
if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &#xD;
		|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
		&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
			var k=0;&#xD;
			while(k&lt;componente.attributiDettaglioOrdine.size()){&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
				//PROFILOTECNICOLINEA&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA){&#xD;
					input.profiloTecnicoLinea = attributo.valoreAttributo;&#xD;
				}&#xD;
				k++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(componente.nomeComponente==it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &#xD;
		&amp;&amp; componente.azione == &quot;A&quot;){&#xD;
				var temp = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createUserVlan_CoppiaBandaPicco();&#xD;
				&#xD;
				var j=0;&#xD;
				while(j&lt;componente.attributiDettaglioOrdine.size()){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN){&#xD;
					&#xD;
						temp.bandaPiccoDown = attributo.valoreAttributo;&#xD;
					&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP){&#xD;
				&#xD;
						temp.bandaPiccoUp = attributo.valoreAttributo;&#xD;
					&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID){&#xD;
				&#xD;
						temp.uservlanId = attributo.valoreAttributo;&#xD;
					&#xD;
					}&#xD;
				j++;&#xD;
				}//end while&#xD;
&#xD;
			input.userVlan.add(ScriptUtil.copy(temp));&#xD;
		&#xD;
		}//end USERVLAN&#xD;
	}//end for i&#xD;
	&#xD;
	&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
	var Asset = AssetRef.readAsset();&#xD;
	&#xD;
	input.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(Asset.offerta));&#xD;
	&#xD;
	for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
		if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
				if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
				{&#xD;
					input.profiloTecnicoLineaCONS = currentAttDettAsset.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	 }//end for i&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
