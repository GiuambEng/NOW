      <xpdl2:Transitions>
        <xpdl2:Transition Id="_IA4nA-hEEeq88usheSrL-A" Name="" From="_EyuB4ehEEeq88usheSrL-A" To="_IA4nAuhEEeq88usheSrL-A">
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
          </xpdl2:ConnectorGraphicsInfos>
        </xpdl2:Transition>
        <xpdl2:Transition Id="_KKCE0-hEEeq88usheSrL-A" Name="" From="_IA4nAuhEEeq88usheSrL-A" To="_KKCE0uhEEeq88usheSrL-A">
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
          </xpdl2:ConnectorGraphicsInfos>
        </xpdl2:Transition>
        <xpdl2:Transition Id="_LA73oehEEeq88usheSrL-A" Name="" From="_KKCE0uhEEeq88usheSrL-A" To="_LA73oOhEEeq88usheSrL-A">
          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">eseguiControllo;</xpdl2:Expression></xpdl2:Condition>
          <xpdl2:ConnectorGraphicsInfos>
