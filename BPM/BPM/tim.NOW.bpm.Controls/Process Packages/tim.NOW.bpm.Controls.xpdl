            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="52.0" LaneId="_a-2s0v1EEeWEXoIZeVGhKA" Width="31.0">
              <xpdl2:Coordinates XCoordinate="863.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_a-_2wv1EEeWEXoIZeVGhKA" Name="DatiSede" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Dati Sede">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per eseguire il controllo&quot;;&#xD;
&#xD;
var failed = false;&#xD;
var i = 0;&#xD;
&#xD;
while(!failed &amp;&amp; i &lt; localRequest.ordine.sede.size())&#xD;
{&#xD;
	var existParticellaToponomastica = true;&#xD;
	var existVia = true;&#xD;
	var existCivico = true;&#xD;
	var existLocalita = true;&#xD;
	var existCodiceISTATComune = true;&#xD;
	var existCodiceEGON = true;     //RU_1150&#xD;
&#xD;
	var currentSede = localRequest.ordine.sede.get(i);&#xD;
	&#xD;
	if(currentSede.codiceToponomastica == null || (currentSede.codiceToponomastica != null &amp;&amp; currentSede.codiceToponomastica.length == 0))&#xD;
	{&#xD;
		if(currentSede.particellaToponomastica == null || currentSede.particellaToponomastica.length == 0)&#xD;
		{&#xD;
			existParticellaToponomastica = false;&#xD;
		}&#xD;
		&#xD;
		if(currentSede.via == null || currentSede.via.length == 0)&#xD;
		{&#xD;
			existVia = false;&#xD;
		}&#xD;
		&#xD;
		if(currentSede.civico == null || currentSede.civico.length == 0)&#xD;
		{&#xD;
			existCivico = false;&#xD;
		}&#xD;
		&#xD;
		if(currentSede.localita == null || currentSede.localita.length == 0)&#xD;
		{&#xD;
			existLocalita = false;&#xD;
		}&#xD;
		&#xD;
		if(currentSede.codiceISTATComune == null || currentSede.codiceISTATComune.length == 0)&#xD;
		{&#xD;
			existCodiceISTATComune = false;&#xD;
		}&#xD;
		&#xD;
		//RU_1150: aggiunto recupero di Codice EGON&#xD;
		if(currentSede.codiceEGON == null || currentSede.codiceEGON.length == 0)&#xD;
		{&#xD;
			existCodiceEGON = false;&#xD;
		}&#xD;
		&#xD;
	}&#xD;
	&#xD;
	//OFFERTE DIVERSE DA UBBSEMIGPON e UBBFULLGPON e FULLGPON1BPNRR e SEMIGPON1BPNRR&#xD;
	if(localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON&#xD;
       &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON&#xD;
	   &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM      //RU_1450&#xD;
	   &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPON1BPNRR   //RU_1581 NEWGPON&#xD;
	   &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIGPON1BPNRR   //RU_1581 NEWGPON	   &#xD;
	   )&#xD;
	{&#xD;
	&#xD;
		if(CTRLSedeJive &amp;&amp; !existCodiceISTATComune &amp;&amp; !existParticellaToponomastica &amp;&amp; !existVia &amp;&amp; !existCivico &amp;&amp; !existLocalita)&#xD;
		{&#xD;
			failed = true;&#xD;
			CodiceEsito = &quot;KO_00&quot;;&#xD;
		}&#xD;
		else if(!CTRLSedeJive &amp;&amp; !existCodiceISTATComune)&#xD;
		{&#xD;
			failed = true;&#xD;
			CodiceEsito = &quot;KO_01&quot;;&#xD;
		}&#xD;
		else if(CTRLSedeJive)&#xD;
		{&#xD;
			if(!existCodiceISTATComune)&#xD;
			{&#xD;
				failed = true;&#xD;
				CodiceEsito = &quot;KO_01&quot;;&#xD;
			}&#xD;
			else if(!existVia)&#xD;
			{&#xD;
				failed = true;&#xD;
				CodiceEsito = &quot;KO_02&quot;;&#xD;
			}&#xD;
			else if(!existCivico)&#xD;
			{&#xD;
				failed = true;&#xD;
				CodiceEsito = &quot;KO_03&quot;;&#xD;
			}&#xD;
			else if(!existParticellaToponomastica)&#xD;
			{&#xD;
				failed = true;&#xD;
				CodiceEsito = &quot;KO_04&quot;;&#xD;
			}&#xD;
			else if(!existLocalita)&#xD;
			{&#xD;
				failed = true;&#xD;
				CodiceEsito = &quot;KO_05&quot;;&#xD;
			}&#xD;
		}&#xD;
	&#xD;
	}&#xD;
	//RU_1150: OFFERTE UBBSEMIGPON e UBBFULLGPON e RU_1581 NEWGPON FULLGPON1BPNRR e SEMIGPON1BPNRR&#xD;
	else if(!CTRLSedeJive &amp;&amp; !existCodiceEGON) &#xD;
	{&#xD;
		failed = true;&#xD;
		//RU_1450&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM)&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_08&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			CodiceEsito = &quot;KO_07&quot;;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Controllo DatiSede Fallito&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Controllo positivo&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
