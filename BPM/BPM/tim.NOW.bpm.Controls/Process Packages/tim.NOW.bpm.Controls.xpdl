      <xpdl2:Activities>
        <xpdl2:Activity Id="_pYnBQSGOEeabcO_3BeoHyw" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_pYXwsSGOEeabcO_3BeoHyw" Width="31.0">
              <xpdl2:Coordinates XCoordinate="816.0" YCoordinate="240.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_pYnBQiGOEeabcO_3BeoHyw" Name="VerificaunivocitUserVlanID" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica univocità UserVlanID">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
//CONTROLLO TUTTE LE USERVLAN ID NELL ORDINE&#xD;
var UservlanIDList = DataUtil.createList();&#xD;
var duplicated = false;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!duplicated &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN || String(currentDettaglioOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(!duplicated &amp;&amp; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
				{&#xD;
					if(UservlanIDList.contains(currentAttDettOrdine.valoreAttributo))&#xD;
					{&#xD;
						duplicated = true;&#xD;
						Process.auditLog(&quot;Trovato USERVLANID in Richiesta duplicata: &quot; + currentAttDettOrdine.valoreAttributo);&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						UservlanIDList.add(currentAttDettOrdine.valoreAttributo);&#xD;
					}&#xD;
				}&#xD;
			j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	// confronto uservlanid della richiesta con quelli in asset&#xD;
	if (!duplicated &amp;&amp; (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC &#xD;
					|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING))&#xD;
	{&#xD;
		if(ConsistenzaDati != null)&#xD;
		{&#xD;
			AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset));&#xD;
			Asset = AssetRef.readAsset();&#xD;
					&#xD;
			var i = 0;&#xD;
			while(!duplicated &amp;&amp; i &lt; Asset.dettaglioasset.size())&#xD;
			{&#xD;
				var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
				if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp; currentDettAsset.statoDettaglioAsset == 'ATTIVO') //RU_818 aggiunto stato ATTIVO.&#xD;
				{&#xD;
					var j = 0;&#xD;
					while(!duplicated &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
					{&#xD;
						var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
						if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
						{&#xD;
							if(UservlanIDList.contains(currentAttDettAsset.valoreAttributo))&#xD;
							{&#xD;
								Process.auditLog(&quot;Trovata USERVLANID in asset: &quot; + currentAttDettAsset.valoreAttributo + &quot;duplicata alla richiesta&quot;);&#xD;
								duplicated = true;&#xD;
							}&#xD;
							else&#xD;
							{&#xD;
								UservlanIDList.add(currentAttDettAsset.valoreAttributo);&#xD;
							}&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
			i++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(duplicated)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Trovati USERVLANID duplicati&quot;;&#xD;
		}&#xD;
		else if(UservlanIDList != null &amp;&amp; UservlanIDList.size() > 0)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Tutti gli attributi USERVLANID sono distinti&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Nessun attributo USERVLANID trovato&quot;;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	else if (!duplicated &amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
	{&#xD;
		//VERIFICO SOLO USERVLANID IN ASSET IN INCREMENTO	&#xD;
		UservlanIDList.clear();&#xD;
&#xD;
		for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &#xD;
				&amp;&amp; currentDettaglioOrdine.azione== it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
			{&#xD;
				&#xD;
				for(var j = 0;  j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
					{&#xD;
					&#xD;
							UservlanIDList.add(currentAttDettOrdine.valoreAttributo);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		// verifico per il solo incremento che non vi siano duplicati in asset&#xD;
		if(ConsistenzaDati != null &amp;&amp; UservlanIDList!=null &amp;&amp; UservlanIDList.size()>0)&#xD;
		{	&#xD;
			AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset));&#xD;
			Asset = AssetRef.readAsset();&#xD;
	&#xD;
			var i = 0;&#xD;
			while(!duplicated &amp;&amp; i &lt; Asset.dettaglioasset.size())&#xD;
			{&#xD;
				var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
				if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp; currentDettAsset.statoDettaglioAsset == 'ATTIVO')  //RU_818 aggiunto stato ATTIVO.&#xD;
				{&#xD;
					var j = 0;&#xD;
					while(!duplicated &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
					{&#xD;
						var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
						{&#xD;
							if(UservlanIDList.contains(currentAttDettAsset.valoreAttributo))&#xD;
							{&#xD;
								Process.auditLog(&quot;Trovata USERVLANID  in asset: &quot; + currentAttDettAsset.valoreAttributo + &quot;duplicata alla richiesta di Variazione per INCREMENTODECREMENTOVC&quot;);&#xD;
								duplicated = true;&#xD;
							}&#xD;
						}&#xD;
						j++;&#xD;
					}&#xD;
				}&#xD;
			i++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(duplicated)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Trovati USERVLANID duplicati per INCREMENTOVC&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Nessun attributo USERVLANID duplicato trovato&quot;;&#xD;
		}&#xD;
	}&#xD;
	else if(!duplicated)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Nessun attributo USERVLANID duplicato trovato&quot;;&#xD;
	}&#xD;
	else &#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Trovati USERVLANID duplicati nella richiesta&quot;;&#xD;
	}	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
