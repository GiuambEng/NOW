        <xpdl2:Transition Id="_r0R40KE8EeiDTuWeLjBBYQ" Name="" From="_pkm8QKE8EeiDTuWeLjBBYQ" To="_o394sKE8EeiDTuWeLjBBYQ">
          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">//RU_1357: aggiunta logica per cui se si tratta di migrazione NGA/XDSL ed è presente ReferenteOnField, &#xD;
//fare il controllo&#xD;
&#xD;
var foundRefOnField = false;&#xD;
var i = 0;&#xD;
&#xD;
if (localRequest.ordine != null &amp;&amp; localRequest.ordine.referente != null){&#xD;
	while (i&lt;localRequest.ordine.referente.size() &amp;&amp; !foundRefOnField)&#xD;
	{&#xD;
		if (localRequest.ordine.referente.get(i).tipoReferenteOrdine &#xD;
		== it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTEONFIELD)&#xD;
		{&#xD;
			foundRefOnField = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
(!foundRefOnField //RU_1357&#xD;
&amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
&amp;&amp; &#xD;
(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
||&#xD;
localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL));&#xD;
</xpdl2:Expression></xpdl2:Condition>
