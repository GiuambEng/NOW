              <xpdExt:Information ScriptGrammar="JavaScript">InterrogaConsistenzeCRMRetailRequest = com_tim_NOW_xsd_ControlliAmmessiNP_Factory.createInterrogaConsistenzeCRMRetail_RequestType();&#xD;
&#xD;
InterrogaConsistenzeCRMRetailRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
InterrogaConsistenzeCRMRetailRequest.lavorazione = String(localRequest.lavorazione);&#xD;
InterrogaConsistenzeCRMRetailRequest.offerta = String(localRequest.offerta);&#xD;
&#xD;
var foundDN = false;&#xD;
var i=0;&#xD;
&#xD;
while(!foundDN &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j=0;&#xD;
		&#xD;
		while(!foundDN &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN)&#xD;
			{&#xD;
				InterrogaConsistenzeCRMRetailRequest.DN = attributo.valoreAttributo;&#xD;
				foundDN = true;&#xD;
			}&#xD;
		    j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
</xpdExt:Information>
