                <xpdExt:PortTypeOperation PortTypeName="BPM_CheckServiceFormaliPortType" OperationName="VerificaPresaAppuntamentoDisaggregazione">
                  <xpdExt:ExternalReference location="BPM_CheckServiceFormali_v1.wsdl"/>
