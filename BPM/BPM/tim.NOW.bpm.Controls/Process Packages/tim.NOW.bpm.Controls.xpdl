          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ValorizzAggregatoCarRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createVerifica_Valorizzazione_Aggregato_Associato_Car_RequestType();&#xD;
&#xD;
//SM_11392  Aggiunta valorizzazione idkitareacar da lavorazionerichiesta&#xD;
if(LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.idKitAreaCar != null &amp;&amp; LavorazioneRichiesta.idKitAreaCar != &quot;&quot;)&#xD;
{&#xD;
	ValorizzAggregatoCarRequest.idKitAreaCar = LavorazioneRichiesta.idKitAreaCar;&#xD;
}&#xD;
&#xD;
ValorizzAggregatoCarRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
ValorizzAggregatoCarRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCAR)&#xD;
			{&#xD;
				ValorizzAggregatoCarRequest.identificativoCar = attributo.valoreAttributo;		&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BMCLIGHT)&#xD;
			{&#xD;
				ValorizzAggregatoCarRequest.bmcLight = attributo.valoreAttributo;			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
			{&#xD;
				ValorizzAggregatoCarRequest.famigliaVlan = attributo.valoreAttributo;		&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
