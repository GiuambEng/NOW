}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
  	EsitoResponse.descrizione = &quot;CTRL REFERENTE ON FIELD TELEFONI Failed : Specified values for FissoReferente and/or MobileReferente are incorrect&quot;;&#xD;
}&#xD;
*/</xpdl2:Script>
