            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaOpzioneVlanTraslationRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createVerifica_Opzione_Vlan_Traslation_RequestType();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest != &quot;&quot; &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine != &quot;&quot;)&#xD;
{&#xD;
	VerificaOpzioneVlanTraslationRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
		if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
