        <xpdl2:Activity Id="_QHRp0v1FEeWEXoIZeVGhKA" Name="ReferenteTelefoni" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Referente Telefoni" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;OK&quot;;&#xD;
&#xD;
localRequestTEMP = ScriptUtil.copy(localRequest);&#xD;
&#xD;
if(localRequestTEMP.ordine != null &amp;&amp; localRequestTEMP.ordine.referente != null &amp;&amp; localRequestTEMP.ordine.referente.size() > 0)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequestTEMP.ordine.referente.size(); i++)&#xD;
	{&#xD;
		var currentReferente = localRequestTEMP.ordine.referente.get(i);&#xD;
		&#xD;
		if(currentReferente.flag_Token == &quot;SI&quot;)&#xD;
		{&#xD;
			for(var k=0; k&lt;ReferentiDetokenizzati.size(); k++)&#xD;
			{&#xD;
				if(ReferentiDetokenizzati.get(k).progressivoReferente == currentReferente.progressivoReferente)&#xD;
				{&#xD;
					currentReferente.IDRichiestaOLO = ReferentiDetokenizzati.get(k).IDRichiestaOLO;&#xD;
					currentReferente.flag_Token = ReferentiDetokenizzati.get(k).flag_Token;&#xD;
					currentReferente.progressivoReferente = ReferentiDetokenizzati.get(k).progressivoReferente;&#xD;
					currentReferente.qualificaReferente = it_telecomitalia_it_NOW_casedata_QualificaReferenteEnumeration.get(String(ReferentiDetokenizzati.get(k).qualificaReferente));&#xD;
					currentReferente.telefonoFissoReferente = ReferentiDetokenizzati.get(k).telefonoFissoReferente;&#xD;
					currentReferente.telefonoMobileReferente = ReferentiDetokenizzati.get(k).telefonoMobileReferente;&#xD;
					currentReferente.tipoReferenteOrdine = it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.get(String(ReferentiDetokenizzati.get(k).tipoReferenteOrdine));&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(localRequestTEMP.ordine != null &amp;&amp; localRequestTEMP.ordine.referente != null &amp;&amp; localRequestTEMP.ordine.referente.size() > 0)&#xD;
{&#xD;
	var i=0;&#xD;
	while(EsitoResponse.codice != false &amp;&amp; i &lt; localRequestTEMP.ordine.referente.size())&#xD;
	{&#xD;
		if(localRequestTEMP.ordine.referente.get(i).tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTE || localRequestTEMP.ordine.referente.get(i).tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTEPERINTERRUZIONESOSPENSIONE){&#xD;
		&#xD;
		var currentReferente = localRequestTEMP.ordine.referente.get(i);&#xD;
		&#xD;
		if(currentReferente.telefonoFissoReferente != null &amp;&amp; currentReferente.telefonoFissoReferente.length >= 6)&#xD;
		{&#xD;
			var j=0;&#xD;
			while(EsitoResponse.codice != false &amp;&amp; j &lt; currentReferente.telefonoFissoReferente.length)&#xD;
			{&#xD;
				var currentCharCode = currentReferente.telefonoFissoReferente.charCodeAt(j);&#xD;
				if(currentCharCode &lt; 48 || currentCharCode > 57)&#xD;
				{&#xD;
					//trovato un carattere non numerico&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;KO&quot;;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		else if(currentReferente.telefonoMobileReferente != null &amp;&amp; currentReferente.telefonoMobileReferente.length >= 9 &amp;&amp; currentReferente.telefonoMobileReferente.length &lt;= 15)&#xD;
		{&#xD;
			var j=0;&#xD;
			while(EsitoResponse.codice != false &amp;&amp; j &lt; currentReferente.telefonoMobileReferente.length)&#xD;
			{&#xD;
				var currentCharCode = currentReferente.telefonoMobileReferente.charCodeAt(j);&#xD;
				if(currentCharCode &lt; 48 || currentCharCode > 57)&#xD;
				{&#xD;
					//trovato un carattere non numerico&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;KO&quot;;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			//nessun telefono fisso o mobile trovato con la lunghezza richiesta&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;KO&quot;;&#xD;
		}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
// RU_871 - Agesp R1I-19-0179&#xD;
else if(localRequestTEMP.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp;&#xD;
		 (localRequestTEMP.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT ||&#xD;
		  localRequestTEMP.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL ||&#xD;
		  localRequestTEMP.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT) &amp;&amp;&#xD;
	    LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.ritiroProdotti == 'Y')&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Cessazione &quot;+localRequestTEMP.offerta+&quot;, con refernti mancanti e ritiro prodotti valorizzati a &quot;+LavorazioneRichiesta.ritiroProdotti;&#xD;
	Process.auditLog(EsitoResponse.descrizione);&#xD;
}&#xD;
&#xD;
/*&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsito();&#xD;
&#xD;
var FissoReferente = &quot;&quot;;&#xD;
var MobileReferente = &quot;&quot;;&#xD;
var size = localRequestTEMP.ordine.referente.size();&#xD;
var i = 0;&#xD;
&#xD;
for(i=0; i&lt;size; i++)&#xD;
{&#xD;
	if(localRequestTEMP.ordine.referente.get(i).IDTypeReferenteOrdine == it_telecomitalia_it_NOW_casedata_IDTypeReferenteOrdineEnumeration.REFERENTE)&#xD;
	{	&#xD;
		FissoReferente = localRequestTEMP.ordine.referente.get(i).telefonoFissoReferente;&#xD;
  		MobileReferente = localRequestTEMP.ordine.referente.get(i).telefonoMobileReferente;&#xD;
  &#xD;
  		if(FissoReferente.length>0 || MobileReferente.length>0)&#xD;
  		{&#xD;
   			if(FissoReferente.length>0 &amp;&amp; MobileReferente.length>0)&#xD;
   			{&#xD;
    			if(!(isNaN(FissoReferente)) &amp;&amp; !(isNaN(MobileReferente)) &amp;&amp; FissoReferente.length>=6 &amp;&amp; MobileReferente.length>=9)&#xD;
    			{	continue;	}&#xD;
       			else&#xD;
    			{	break;	}&#xD;
	   		}&#xD;
   			else if(FissoReferente.length>0)&#xD;
  			{&#xD;
				if(!(isNaN(FissoReferente)) &amp;&amp; FissoReferente.length>=6)&#xD;
    	 		{	continue;	}&#xD;
	    		else&#xD;
	     		{	break;	}&#xD;
   			}  &#xD;
	   		else if(MobileReferente.length>0)&#xD;
   			{&#xD;
	    		if(!(isNaN(MobileReferente)) &amp;&amp; MobileReferente.length>=9)&#xD;
    	 		{	continue;	}&#xD;
	    		else&#xD;
     			{	break;	}&#xD;
	   		}&#xD;
		}&#xD;
	}&#xD;
} &#xD;
if(i==size)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
  	EsitoResponse.descrizione = &quot;CTRL REFERENTE TELEFONI Successful&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
  	EsitoResponse.descrizione = &quot;CTRL REFERENTE TELEFONI Failed : Specified values for FissoReferente and/or MobileReferente are incorrect&quot;;&#xD;
}&#xD;
*/</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
