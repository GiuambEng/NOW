        <xpdl2:Activity Id="_g-SzANDbEeqMndldZgNiUg" Name="ValorizzazioneFamigliaVlaneProfiloBmc" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Valorizzazione FamigliaVlan e ProfiloBmc" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var FamigliaVlan = &quot;&quot;;&#xD;
FamigliaVlan = null;&#xD;
&#xD;
var foundProfiloBmc = false;&#xD;
&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
			{&#xD;
				FamigliaVlan = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo FAMIGLIAVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMC)&#xD;
			{&#xD;
				foundProfiloBmc = true;&#xD;
				Process.auditLog(&quot;Trovato attributo PROFILOBMC &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
&#xD;
if((FamigliaVlan == &quot;1&quot; || FamigliaVlan == &quot;3&quot;) &amp;&amp; foundProfiloBmc)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA VALORIZZAZIONE FAMIGLIAVLAN E PROFILOBMC NON SUPERATO, KO_01&quot;;&#xD;
	esitoControllo = &quot;KO_01&quot;;&#xD;
}&#xD;
else if(FamigliaVlan == &quot;2&quot; &amp;&amp; !foundProfiloBmc)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA VALORIZZAZIONE FAMIGLIAVLAN E PROFILOBMC NON SUPERATO, KO_02&quot;;&#xD;
	esitoControllo = &quot;KO_02&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA VALORIZZAZIONE FAMIGLIAVLAN E PROFILOBMC SUPERATO&quot;;&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
