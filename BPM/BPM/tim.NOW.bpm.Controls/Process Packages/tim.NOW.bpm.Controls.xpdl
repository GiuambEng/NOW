                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="parameters.prodottoCatologo">
                      <xpdl2:Actual ScriptGrammar="JavaScript">LavorazioneRichiesta.prodottoCatalogo</xpdl2:Actual>
