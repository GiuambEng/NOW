        <xpdl2:Activity Id="_USkVojLnEeajbIG7R_HFFQ" Name="VerificaMaxVCperVP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Max VC per VP" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var failed = false;&#xD;
var i = 0;&#xD;
&#xD;
if(EsistenzaVPOutput != null)&#xD;
{&#xD;
 while(!failed &amp;&amp; i &lt; EsistenzaVPOutput.size())&#xD;
 {&#xD;
  if(EsistenzaVPOutput.get(i).VP_Disponibili != &quot;Y&quot;)&#xD;
  {&#xD;
   failed = true;&#xD;
  }&#xD;
  i++;&#xD;
 }&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
 EsitoResponse.codice = false;&#xD;
 EsitoResponse.descrizione = &quot;Trovato almeno un flag VP NON Disponibili&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
 EsitoResponse.codice = true;&#xD;
 EsitoResponse.descrizione = &quot;Tutti i flag sono VPDisponibili&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="85.0" LaneId="_USh5YjLnEeajbIG7R_HFFQ" Width="111.0">
              <xpdl2:Coordinates XCoordinate="431.0" YCoordinate="227.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
