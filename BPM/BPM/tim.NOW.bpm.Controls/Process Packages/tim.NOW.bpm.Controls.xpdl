        <xpdl2:Activity Id="_lspZQuVQEeuqdaKOstbSuw" Name="CambioTecnologiaWLR911" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Cambio Tecnologia WLR 9 11" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL CAMBIO TIPOLOGIA WLR 9 11 SUPERATO&quot;;&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECAMBIOTIPOLOGIA&#xD;
			   &amp;&amp; (attributo.valoreAttributo == &quot;9&quot; || attributo.valoreAttributo == &quot;11&quot;))&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CAMBIO TIPOLOGIA WLR 9 11 FALLITO&quot;;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo CODICECAMBIOTIPOLOGIA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
