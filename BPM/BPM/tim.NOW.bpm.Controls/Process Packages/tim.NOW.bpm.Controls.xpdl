        <xpdl2:Activity Id="_PfztEIXuEe2bCuCUNNAhBA" Name="VerificaRDACPacchettoDEL103" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica RDAC Pacchetto DEL 103">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL RDAC PACCHETTO D103 KO&quot;;&#xD;
&#xD;
if(TargetRequest != null &amp;&amp; TargetRequestRef!=null &amp;&amp; localRequest.DAC != null)&#xD;
{&#xD;
	TargetRequest = TargetRequestRef.readRichiesta();&#xD;
	if (TargetRequest.ordine != null &amp;&amp; TargetRequest.ordine.DACRimodulata != null)&#xD;
	{&#xD;
		if (localRequest.DAC>TargetRequest.ordine.DACRimodulata)//SM_10977&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL RDAC PACCHETTO D103 OK&quot;;&#xD;
		}else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL RDAC PACCHETTO D103 : localRequest.DAC &lt;= targetRequest.DACRimodulata&quot;;&#xD;
		}&#xD;
	}else if (TargetRequest.DAC != null)&#xD;
	{&#xD;
		if (localRequest.DAC>TargetRequest.DAC)//SM_10977&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL RDAC PACCHETTO D103 OK&quot;;&#xD;
		}else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL RDAC PACCHETTO D103 : localRequest.DAC &lt;= targetRequest.DAC&quot;;&#xD;
		}&#xD;
	} &#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
