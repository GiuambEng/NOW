        <xpdl2:Activity Id="_6kA254PyEea_rdtLLNNYYw" Name="VerificaCVLANCODEperGBE" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica CVLANCODE per GBE" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL VAL CVLANCODE GBE positivo&quot;;&#xD;
&#xD;
var foundSvlanCode = false;&#xD;
var foundCVLAN_ID = false;&#xD;
var termina = false;&#xD;
&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i = 0; (!termina &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size()); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
		{&#xD;
			foundSvlanCode = false;&#xD;
			foundCVLAN_ID = false;&#xD;
			var j = 0;&#xD;
			while((!foundSvlanCode || !foundCVLAN_ID) &amp;&amp; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
				{&#xD;
					//Trovato SVLANCODE&#xD;
					foundSvlanCode = true;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
				{&#xD;
					//Trovato CVLANID&#xD;
					foundCVLAN_ID = true;&#xD;
				}&#xD;
				&#xD;
				&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(foundSvlanCode){&#xD;
				if(!foundCVLAN_ID){&#xD;
					termina = true;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(termina){&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VAL CVLANCODE GBE fallito: Riscontrata una USERVLAN con SvlanCode valorizzato e CvlanCode(CVLAN_ID) non valorizzato&quot;;&#xD;
	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
