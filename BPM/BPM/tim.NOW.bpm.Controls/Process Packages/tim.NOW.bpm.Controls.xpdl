                           {&#xD;
                                  if((localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO) &amp;&amp;&#xD;
                                   (localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).valoreAttributo == &quot;4&quot; ||&#xD;
                                    localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).valoreAttributo == &quot;5&quot; ||&#xD;
                                      localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).valoreAttributo == &quot;9&quot; ||&#xD;
                                      localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).valoreAttributo == &quot;10&quot;))&#xD;
                                  {&#xD;
                                        status2 = 1;&#xD;
                                        break;&#xD;
                                  }&#xD;
                           }&#xD;
                    }&#xD;
             }&#xD;
             if(status1!=status2)&#xD;
             {&#xD;
                    check = 1;&#xD;
                    break;&#xD;
             }&#xD;
       }&#xD;
}&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA ||&#xD;
             localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP ||&#xD;
             localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA)&#xD;
{&#xD;
       for(var i=0; i&lt;sizeDO; i++)&#xD;
       {&#xD;
             if(localRequest.ordine.dettaglioordine.get(i).nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOULLDATI)&#xD;
             {&#xD;
                    var sizeADO = localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.size();&#xD;
                    for(var j=0; j&lt;sizeADO; j++)&#xD;
                    {&#xD;
                           if(localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BITRATE &#xD;
                              &amp;&amp; localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).valoreAttributo!=null)&#xD;
                           {&#xD;
                                  status1 = 1;&#xD;
