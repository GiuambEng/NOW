        <xpdl2:Activity Id="_z76OgP58EeWOWudSlXteYQ" Name="InitializeARLTI1Request" xpdExt:Visibility="Private" xpdExt:DisplayName="Initialize ARLTI1 Request">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
Arlti1Request = com_tim_NOW_xsd_ControlliAmmessi_Factory.createControllo_ARLTI1_Request();&#xD;
&#xD;
Arlti1Request.IDRichiesta = localRequest.IDRichiestaOLO;&#xD;
Arlti1Request.codice_OLO = localRequest.codificaOLONOW;&#xD;
Arlti1Request.IDSLUCO = localRequest.ordine.IDSLUCo;&#xD;
&#xD;
var foundAccesso = false;&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA ||&#xD;
	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP ||&#xD;
	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!foundAccesso &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var dettaglioOrdine_iesimo = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(dettaglioOrdine_iesimo.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU)&#xD;
		{&#xD;
			foundAccesso = true;&#xD;
			var j = 0;&#xD;
			&#xD;
			while(Arlti1Request.posizione_ARL_TI_1 == null &amp;&amp; j&lt;dettaglioOrdine_iesimo.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributiDettaglioOrdine_jesimo = dettaglioOrdine_iesimo.attributiDettaglioOrdine.get(j);&#xD;
				if(attributiDettaglioOrdine_jesimo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEARLTI1)&#xD;
				{&#xD;
					Arlti1Request.posizione_ARL_TI_1 = attributiDettaglioOrdine_jesimo.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(Arlti1Request.codice_OLO!=null &amp;&amp; Arlti1Request.posizione_ARL_TI_1!=null &amp;&amp; Arlti1Request.IDSLUCO!=null)&#xD;
{&#xD;
	FlagInput = true;&#xD;
}&#xD;
else&#xD;
{&#xD;
	FlagInput = false;&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ARLTI1 Failed : Input request could not be formed&quot;;&#xD;
}&#xD;
&#xD;
</xpdl2:Script>
