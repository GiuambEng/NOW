          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaRientroTIdaDBCFXrequest = com_tibco_VerificaRientroInTI_Factory.createRequestType();&#xD;
&#xD;
if(localRequest != null)&#xD;
{&#xD;
	VerificaRientroTIdaDBCFXrequest.codiceOlo = localRequest.codificaOLONOW; &#xD;
	VerificaRientroTIdaDBCFXrequest.codiceOrdineOlo = localRequest.codiceOrdineOLO;&#xD;
	VerificaRientroTIdaDBCFXrequest.codificaOloAgcom = localRequest.codificaOLOAGCOM;&#xD;
	VerificaRientroTIdaDBCFXrequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
	VerificaRientroTIdaDBCFXrequest.idRisorsa = localRequest.IDRisorsa;&#xD;
	VerificaRientroTIdaDBCFXrequest.statoRichiesta = String(localRequest.statoRichiestaNOW);&#xD;
}&#xD;
&#xD;
//SM_10409&#xD;
if(ConsistenzaFonia != null)&#xD;
{&#xD;
	VerificaRientroTIdaDBCFXrequest.codiceOrdineTI = ConsistenzaFonia.codiceOrdineTI;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL RIENTRO IN TI DA DBCFX_C04M01F486 fallito&quot;;&#xD;
&#xD;
//La chiamata a DBCFX è andata bene e il sistema risponde con OK o KO&#xD;
if(EsitoNOW == true)&#xD;
{	&#xD;
	if(EsitoDBCFX == &quot;OK&quot;)&#xD;
	{&#xD;
		esitoControllo = &quot;KO_01&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		esitoControllo = &quot;KO_02&quot;;&#xD;
	}&#xD;
}&#xD;
//La chiamata a DBCFX è andata in errore&#xD;
else&#xD;
{&#xD;
	esitoControllo = &quot;KO_02&quot;;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
