            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_J--fQA2LEeeRv6xWIpo7fw">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_0K0PUA5OEeeja9NY4DYfpQ"/>
                  <xpdl2:TransitionRef Id="_0ni1EA7yEee6d_j6D0uIvA"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="45.0" LaneId="_h-_SEXmjEeaoH8j59Le6HA" Width="43.0">
              <xpdl2:Coordinates XCoordinate="404.0" YCoordinate="255.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_L1TuwA2LEeeRv6xWIpo7fw" Name="Precondition" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondition">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//C04M01F94 - Verifica coppia Banda Picco &#xD;
&#xD;
////////////PRECONDIZIONI&#xD;
&#xD;
var profiloTecnicoLineaFlag = false;&#xD;
var bandaPiccoDownFlag = false;&#xD;
var bandaPiccoUpFlag = false;&#xD;
var actionUserVLanFlag = false;&#xD;
var existsUserVLanFlag = false;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	//VARIAZIONE &#xD;
&#xD;
		//Ricerco ProfiloTecnicoLinea OR Uservlan con Banda Picco Up/Down valorizzate&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			//ACCESSO&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
				var k=0;&#xD;
				while(!profiloTecnicoLineaFlag &amp;&amp; k&lt;componente.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA){&#xD;
						profiloTecnicoLineaFlag= true;&#xD;
						//profiloTecnicoLinea = attributo.valoreAttributo;&#xD;
					}&#xD;
				k++;&#xD;
				}//end while&#xD;
			}//end if ACCESSO&#xD;
			//USERVLAN&#xD;
			if(componente.nomeComponente==it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
				&#xD;
				existsUserVLanFlag = true;&#xD;
				if(componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A &amp;&amp; !actionUserVLanFlag){&#xD;
					actionUserVLanFlag = true;&#xD;
				}&#xD;
				&#xD;
				var j=0;&#xD;
				while((!bandaPiccoDownFlag||!bandaPiccoUpFlag)&amp;&amp;j&lt;componente.attributiDettaglioOrdine.size()){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN){&#xD;
					&#xD;
							bandaPiccoDownFlag=true;&#xD;
					}&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP){&#xD;
					&#xD;
							bandaPiccoUpFlag=true;&#xD;
					}&#xD;
				j++;&#xD;
				}&#xD;
			&#xD;
			}//end USERVLAN&#xD;
		}//end for i&#xD;
		&#xD;
		//LOGICA RICONFIGURAZIONEVC&#xD;
		if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
		{&#xD;
			preCondition = profiloTecnicoLineaFlag || (bandaPiccoDownFlag &amp;&amp; bandaPiccoUpFlag);&#xD;
		}&#xD;
		//LOGICA INCREMENTODECREMENTOVC &amp; VARIAZIONETAGGING&#xD;
		if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &#xD;
		|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING)&#xD;
		{&#xD;
			preCondition = actionUserVLanFlag &amp;&amp; existsUserVLanFlag;&#xD;
		}&#xD;
&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="73.0" LaneId="_h-_SEXmjEeaoH8j59Le6HA" Width="135.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="406.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
