    <xpdl2:WorkflowProcess Id="_mynNoHpNEeqtFZlTePOMyw" xpdExt:DisplayName="CTRL CODICE RIPENSAMENTO_C04M01F330" Name="CTRLCODICERIPENSAMENTO_C04M01F330">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_my_BE3pNEeqtFZlTePOMyw" Name="EndEvent" xpdExt:DisplayName="End Event">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_my_BEXpNEeqtFZlTePOMyw" Width="67.0">
              <xpdl2:Coordinates XCoordinate="673.0" YCoordinate="163.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_nQFh4HpPEeqtFZlTePOMyw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_4okGEHpOEeqtFZlTePOMyw" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="52.0" LaneId="_my_BEXpNEeqtFZlTePOMyw" Width="73.0">
              <xpdl2:Coordinates XCoordinate="110.0" YCoordinate="163.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_GnaKEHpQEeq-OOdIQ8-r7Q" Name="VerificaCodiceRipensamento" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Codice Ripensamento">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL Codice ripensamento saltato per precondizione non soddisfatta&quot;;&#xD;
Process.auditLog(EsitoResponse.descrizione);&#xD;
&#xD;
var i = 0;&#xD;
var codiceRipensamento = false;&#xD;
var trovatoAccesso = false;&#xD;
&#xD;
while((!codiceRipensamento || !trovatoAccesso) &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	var j = 0;&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
	{&#xD;
		trovatoAccesso = true;&#xD;
		&#xD;
		while(!codiceRipensamento &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
		&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODERIPENSAMENTOMAIRICHIESTO)&#xD;
			{&#xD;
				codiceRipensamento = true;&#xD;
				Process.auditLog(attributo.valoreAttributo);&#xD;
			}&#xD;
		&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(!codiceRipensamento)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL Codice ripensamento fallito: codiceRipensamento non trovato in ACCESSOCPS&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
