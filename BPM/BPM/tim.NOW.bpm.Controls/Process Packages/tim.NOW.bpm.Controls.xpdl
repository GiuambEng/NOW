      <xpdl2:DataFields>
        <xpdl2:DataField Id="_TYYRQH8pEeq4_8uLvbUAQA" xpdExt:DisplayName="eseguiControllo" Name="eseguiControllo" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="BOOLEAN"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_HNYekH8qEeq4_8uLvbUAQA" xpdExt:DisplayName="VerificaServiziOpzionaliRequest" Name="VerificaServiziOpzionaliRequest" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="com.tim.NOW.xsd.ControlliFormali.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.ControlliFormaliVerificaServiziOpzionali_RequestType"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
