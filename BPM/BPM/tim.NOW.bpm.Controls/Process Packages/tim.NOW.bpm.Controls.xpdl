    <xpdl2:WorkflowProcess Id="_4keoYCDnEeaub_W9_7VV0A" xpdExt:DisplayName="CTRL CONGRUENZA VLAN GBE_C04M01F33" Name="CTRLCONGRUENZAVLANGBE_C04M01F33">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_4kf2hiDnEeaub_W9_7VV0A" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_4keoYiDnEeaub_W9_7VV0A" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_4kf2hyDnEeaub_W9_7VV0A" Name="VerificaCongruenzaVLANGBE" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Congruenza VLAN GBE">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var foundSvlanCode = false;&#xD;
var foundCodeVlanSingleTag = false;&#xD;
var isDoubletag = false;&#xD;
var isSingletag = false;&#xD;
var failed = false;&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
while(!failed &amp;&amp; i &lt; EsistenzaVLANOutput.size())&#xD;
{&#xD;
	var currentEsistenzaVLAN = EsistenzaVLANOutput.get(i);&#xD;
	isDoubletag = false;&#xD;
	isSingletag = false;&#xD;
	foundSvlanCode = false;&#xD;
	foundCodeVlanSingleTag = false;&#xD;
	&#xD;
	if(currentEsistenzaVLAN.FLAG_ENCAPSULATION == &quot;Y&quot;)&#xD;
	{&#xD;
		isDoubletag = true;&#xD;
	}&#xD;
	else if(currentEsistenzaVLAN.FLAG_ENCAPSULATION == &quot;N&quot;)&#xD;
	{&#xD;
		isSingletag = true;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		failed = true;&#xD;
		EsitoResponse.descrizione = &quot;CongruenzaVLANGBE Fallito: FlagEncapsulation non trovato per almeno una VLAN&quot;;&#xD;
	}&#xD;
	&#xD;
	var matched = false;&#xD;
	var j = 0;&#xD;
	if(localRequest.ordine!=null)&#xD;
	{&#xD;
	while(!failed &amp;&amp; !matched &amp;&amp; j &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(j);&#xD;
		&#xD;
		if(currentEsistenzaVLAN.IDDettaglioOrdine == currentDettOrdine.IDDettaglioOrdine)&#xD;
		{&#xD;
			matched = true;&#xD;
			var z = 0;&#xD;
			while(!foundSvlanCode &amp;&amp; !foundCodeVlanSingleTag &amp;&amp; z &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
				{&#xD;
					foundSvlanCode = true;&#xD;
				}&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
				{&#xD;
					foundCodeVlanSingleTag = true;&#xD;
				}&#xD;
				z++;&#xD;
			}&#xD;
			&#xD;
			if(isDoubletag &amp;&amp; !foundSvlanCode)&#xD;
			{&#xD;
				failed = true;&#xD;
				EsitoResponse.descrizione = &quot;CongruenzaVLANGBE Fallito: Trovata VLAN DOUBLETAG senza SVLANCODE&quot;;&#xD;
			}&#xD;
			else if(isSingletag &amp;&amp; !foundCodeVlanSingleTag)&#xD;
			{&#xD;
				failed = true;&#xD;
				EsitoResponse.descrizione = &quot;CongruenzaVLANGBE Fallito: Trovata VLAN SINGLETAG senza CODEVLANSINGLETAG&quot;;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		j++;&#xD;
	}&#xD;
	}&#xD;
	&#xD;
	if(!matched)&#xD;
	{&#xD;
		failed = true;&#xD;
		EsitoResponse.descrizione = &quot;CongruenzaVLANGBE Fallito: Non trovato dettaglio VLAN corrispondente a EsistenzaVLAN&quot;;&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Controllo CongruenzaVLANGBE effettuato con successo&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="119.0" LaneId="_4keoYiDnEeaub_W9_7VV0A" Width="159.0">
              <xpdl2:Coordinates XCoordinate="276.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
