    <xpdl2:WorkflowProcess Id="_IsMMEgDZEea3XoEZuqG7Cg" xpdExt:DisplayName="CTRL COD ORD TI STATO" Name="CTRLCODORDTISTATO">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_VyE8EIZGEeqZ2_D7ht4cDQ" xpdExt:DisplayName="configuration" Name="configuration" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="timNOWbpmcasedataTechnical.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_odUd4JRyEeaeBaMnXA0nAA"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_Z14vwIZGEeqZ2_D7ht4cDQ" xpdExt:DisplayName="configurationRef" Name="configurationRef" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="timNOWbpmcasedataTechnical.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_odUd4JRyEeaeBaMnXA0nAA"/>
