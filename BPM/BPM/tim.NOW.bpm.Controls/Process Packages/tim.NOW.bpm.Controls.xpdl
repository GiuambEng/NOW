          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">Input = com_tim_NOW_xsd_ControlliAmmessi_Factory.createControllo_Recupera_Distretto_Request();&#xD;
Input.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
var found = false;&#xD;
var i = 0;&#xD;
&#xD;
while(!found &amp;&amp; i &lt; localRequest.ordine.sede.size())&#xD;
{&#xD;
	var currentSede = localRequest.ordine.sede.get(i);&#xD;
	Log.write(&quot;Recupera_Distretto per IDRichiestaOLO: &quot; + localRequest.IDRichiestaOLO +&quot;tipologiaSede:&quot;+ String(currentSede.tipologiaSede));&#xD;
	if(currentSede.tipologiaSede == it_telecomitalia_it_NOW_casedata_TipologiaSedeEnumeration.SEDECLIENTE)&#xD;
	{&#xD;
		found = true;&#xD;
		Process.auditLog(&quot;Found SEDECLIENTE&quot;);&#xD;
		Input.codiceIndirizzo = currentSede.codiceToponomastica;&#xD;
		Input.istatComune = currentSede.codiceISTATComune;&#xD;
		&#xD;
		//SM_8081 aggiunti particella toponomastica e via in input al servizio&#xD;
		if (currentSede.particellaToponomastica != &quot;&quot; &amp;&amp; currentSede.particellaToponomastica != null){&#xD;
			Input.particellaToponomastica = currentSede.particellaToponomastica;&#xD;
		}&#xD;
		&#xD;
		if (currentSede.via != &quot;&quot; &amp;&amp; currentSede.via != null){&#xD;
			Input.via = currentSede.via;&#xD;
		}&#xD;
		&#xD;
		//aggiunto numero civico mail Talone 28 dic 2018&#xD;
		if (currentSede.civico != &quot;&quot; &amp;&amp; currentSede.civico != null){&#xD;
			Input.numeroCivico = currentSede.civico;&#xD;
		}&#xD;
		&#xD;
			&#xD;
		Log.write(&quot;Recupera_Distretto per IDRichiestaOLO: &quot; + localRequest.IDRichiestaOLO);&#xD;
		Log.write(ScriptUtil.toXML(Input));&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(localRequest.numeroTelefonico!=null &amp;&amp; localRequest.numeroTelefonico!=&quot;&quot;)&#xD;
{&#xD;
	Input.numeroTelefonico = localRequest.numeroTelefonico;&#xD;
}&#xD;
&#xD;
if(localRequest.ordine!=null &amp;&amp; localRequest.ordine.tipologiaLinea!=null)&#xD;
{&#xD;
	Input.tipoLinea = String(localRequest.ordine.tipologiaLinea);&#xD;
}&#xD;
&#xD;
if(localRequest.lavorazione!=null)&#xD;
{&#xD;
	Input.lavorazione = String(localRequest.lavorazione);&#xD;
}&#xD;
&#xD;
//SM_11592&#xD;
if(localRequest.offerta!=null)&#xD;
{&#xD;
	Input.offerta=String(localRequest.offerta);&#xD;
}&#xD;
&#xD;
//SM_&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
   &amp;&amp; localRequest.flagRientriDel82 == &quot;SI&quot;)&#xD;
{	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttrDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDBUILDING)&#xD;
				{&#xD;
					Input.codiceIndirizzo = currentAttrDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
