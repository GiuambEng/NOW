          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaModelloKITRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createVerifica_Modello_Kit_RequestType();&#xD;
&#xD;
VerificaModelloKITRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
VerificaModelloKITRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
VerificaModelloKITRequest.sottoLavorazione = String(localRequest.tipologiaSottolav);&#xD;
&#xD;
if(ConsistenzaRaccolta != null)&#xD;
{&#xD;
	VerificaModelloKITRequest.codiceTdKitConsistenza = String(ConsistenzaRaccolta.codiceTdKit);&#xD;
}&#xD;
&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
			{&#xD;
				VerificaModelloKITRequest.codiceTdKit = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo codiceTdKit &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
