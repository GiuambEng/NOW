        <xpdl2:Activity Id="_Rv9a8tJ4EeqLn70Ph9PbVA" Name="VerificavalorizzazioneFamigliaVLANeTipoCoS" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica valorizzazione FamigliaVLAN e TipoCoS">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE FAMIGLIAVLAN E TIPOCOS_C04M01F425 superato&quot;;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
{&#xD;
	var FamigliaVlan = &quot;&quot;;&#xD;
	FamigliaVlan = null;&#xD;
	var identificativoCos = &quot;&quot;;&#xD;
	identificativoCos = null;&#xD;
	&#xD;
	var foundFTTHONLY = false;     //RU_1099&#xD;
	&#xD;
	var count = 0;&#xD;
&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
		if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
				{&#xD;
					FamigliaVlan = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo FAMIGLIAVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//RU_1099&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FTTHONLY)&#xD;
				{&#xD;
					foundFTTHONLY = true; &#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
		{&#xD;
			count++; //conta TIPOCOS&#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
				{&#xD;
					identificativoCos = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo IDENTIFICATIVOCOS &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//FAMIGLIAVLAN = 1 -> TIPOCOS è UNICO&#xD;
	if(FamigliaVlan == &quot;1&quot;&#xD;
	   &amp;&amp; identificativoCos != &quot;0&quot;&#xD;
	   &amp;&amp; identificativoCos != &quot;1&quot;&#xD;
	   &amp;&amp; identificativoCos != &quot;3&quot;&#xD;
	   &amp;&amp; identificativoCos != &quot;5&quot;)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE FAMIGLIAVLAN E TIPOCOS_C04M01F425 fallito. FamigliaVLAN: &quot;+FamigliaVlan+&quot;, IdentificativoCos: &quot;+identificativoCos;&#xD;
		CodiceEsito = &quot;KO_01&quot;;&#xD;
	}&#xD;
	//FAMIGLIAVLAN = 2 -> POTREBBERO SCENDERE SUL BPM 3 TIPOCOS (la terza componente è dovuta alla presenza dell'aggregato TIPOCOS nella richiesta in input)&#xD;
	//SM_9953: per FAMIGLIAVLA = 3, non vengono create TIPOCOS, ma mi arriverebbe solo quella corrispondente all'eventuale aggregato TIPOCOS in input&#xD;
	else if((FamigliaVlan == &quot;2&quot; &amp;&amp; count > 2) || (FamigliaVlan == &quot;3&quot; &amp;&amp; count > 0))&#xD;
	{	&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE FAMIGLIAVLAN E TIPOCOS_C04M01F425 fallito. FamigliaVLAN: &quot;+FamigliaVlan+&quot;, TIPOCOS presente in input&quot;;&#xD;
		CodiceEsito = &quot;KO_02&quot;;&#xD;
	}&#xD;
	//RU_1099&#xD;
	else if((FamigliaVlan == &quot;2&quot; || FamigliaVlan == &quot;3&quot;) &amp;&amp; foundFTTHONLY)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE FAMIGLIAVLAN E TIPOCOS_C04M01F425 fallito. FamigliaVLAN: &quot;+FamigliaVlan+&quot;, FTTHONLY presente in input&quot;;&#xD;
		CodiceEsito = &quot;KO_03&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="79.0" LaneId="_IIBNIdJ0EeqLn70Ph9PbVA" Width="146.0">
              <xpdl2:Coordinates XCoordinate="229.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
