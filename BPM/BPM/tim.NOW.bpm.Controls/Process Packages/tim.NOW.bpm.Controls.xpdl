        <xpdl2:Activity Id="_ikZEgIyDEe-bAfzKXKgSuQ" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest != null)&#xD;
{&#xD;
	eseguiControllo = false;&#xD;
	&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE 	&amp;&amp;&#xD;
	  (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA 		||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA 	||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA    ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA       ||    //RU_1510&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP))&#xD;
	{	&#xD;
		eseguiControllo = true;&#xD;
	}&#xD;
&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE   		&amp;&amp;     &#xD;
	(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT 		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT 		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL   		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE 		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT          		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE          		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT    		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE)		    &amp;&amp;&#xD;
	 ConsistenzaDati != null &amp;&amp; &#xD;
	(ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT		||	&#xD;
	 ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT 		||&#xD;
	 ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL  		||&#xD;
	 ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE		||&#xD;
	 ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPBASEPLUSFLAT         		||&#xD;
	 ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPBASEPLUSLITE         		||&#xD;
	 ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT   		||&#xD;
	 ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPSPECIALPROFILELITE))&#xD;
	{&#xD;
		eseguiControllo = true;&#xD;
	}&#xD;
	&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE   		&amp;&amp; &#xD;
	(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA           		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA              		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA       		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA          		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA           		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA              		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP            		||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP)		 		&amp;&amp;&#xD;
	 ConsistenzaFonia != null &amp;&amp; &#xD;
	(ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEANONATTIVA          	||&#xD;
	 ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVA             	||&#xD;
	 ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEANONATTIVA      	||&#xD;
	 ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVA         	||&#xD;
	 ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEANONATTIVA          	||&#xD;
	 ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEAATTIVA             	||&#xD;
	 ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVANP           	||&#xD;
	 ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVANP))&#xD;
	{&#xD;
		eseguiControllo = true;&#xD;
	}&#xD;
	&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE     &amp;&amp;&#xD;
	   (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA     	   ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA        	   ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA     	   ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA 		 	   ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP 	 	   ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA 	   ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA 	 	   ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP  	   ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL   ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT          ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE          ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT	   ||	   &#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE    ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA 		   ||&#xD;
	   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA))&#xD;
	{	&#xD;
		eseguiControllo = true;&#xD;
	}&#xD;
	&#xD;
	//R1I-24-0127: casistica in cui non va effettuata la chiamata al controllo&#xD;
	//RU_1540: aggiunto OR con MIGRAZIONE&#xD;
	if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
	     || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE) &#xD;
	   &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA &#xD;
	   &amp;&amp; localRequest.codificaOLOAGCOM == &quot;TLC&quot;)&#xD;
	{&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO &amp;&amp;&#xD;
					   attributo.valoreAttributo == &quot;10&quot;)&#xD;
					{&#xD;
						eseguiControllo = false;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
