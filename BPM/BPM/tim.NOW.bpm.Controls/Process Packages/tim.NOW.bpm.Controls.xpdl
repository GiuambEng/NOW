    <xpdl2:WorkflowProcess Id="_FyF6oAWIEeajW8ImTEYRAw" xpdExt:XpdModelType="ServiceProcess" xpdExt:DisplayName="RECUPERA CONTROLLI" Name="RECUPERACONTROLLI">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_hshEQAYvEeacFqTwifJNEw" xpdExt:DisplayName="RecuperaRequest" Name="RecuperaRequest">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="com.tim.NOW.xsd.ControlliAmmessi.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.ControlliAmmessiRecupero_Controlli_Request"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_FzC84QWIEeajW8ImTEYRAw" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="30.0" LaneId="_FyMBQQWIEeajW8ImTEYRAw" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_FzC84gWIEeajW8ImTEYRAw" Name="RecuperaControlli" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Recupera Controlli">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_M6lAQgWIEeajW8ImTEYRAw">
                  <xpdl2:DataMappings>
