    <xpdl2:WorkflowProcess Id="_LTtNIP1FEeWEXoIZeVGhKA" xpdExt:DisplayName="CTRL REFERENTE QUALIFICA" Name="CTRLREFERENTEQUALIFICA">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_LT4zUf1FEeWEXoIZeVGhKA" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_LTtNIv1FEeWEXoIZeVGhKA" Width="31.0">
              <xpdl2:Coordinates XCoordinate="580.0" YCoordinate="195.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_LT4zUv1FEeWEXoIZeVGhKA" Name="ReferenteQualifica" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Referente Qualifica">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var found = false;&#xD;
var failed = false;&#xD;
&#xD;
var prog0 = false; //modifica inclusa in seguito alla RU_970&#xD;
var prog1 = false;&#xD;
var prog2 = false;&#xD;
var prog3 = false;&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
if(localRequest.ordine.referente != null)&#xD;
{&#xD;
	while(!failed &amp;&amp; i &lt; localRequest.ordine.referente.size())&#xD;
	{&#xD;
		var currentReferente = localRequest.ordine.referente.get(i);&#xD;
		&#xD;
		if(currentReferente.tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTE)&#xD;
		{&#xD;
			found = true;&#xD;
			&#xD;
			if(currentReferente.progressivoReferente == 0 &amp;&amp; !prog0)  //modifica inclusa in seguito alla RU_970 &#xD;
			{&#xD;
				prog0 = true;&#xD;
			}&#xD;
			else if(currentReferente.progressivoReferente == 1 &amp;&amp; !prog1)&#xD;
			{&#xD;
				prog1 = true;&#xD;
			}&#xD;
			else if(currentReferente.progressivoReferente == 2 &amp;&amp; !prog2)&#xD;
			{&#xD;
				prog2 = true;&#xD;
			}&#xD;
			else if(currentReferente.progressivoReferente == 3 &amp;&amp; !prog3)&#xD;
			{&#xD;
				prog3 = true;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				failed = true;&#xD;
				EsitoResponse.descrizione = &quot;Progressivo mancante o duplicato&quot;;&#xD;
			}&#xD;
			&#xD;
			if(currentReferente.qualificaReferente != null &amp;&amp; (currentReferente.qualificaReferente == it_telecomitalia_it_NOW_casedata_QualificaReferenteEnumeration.CF || currentReferente.qualificaReferente == it_telecomitalia_it_NOW_casedata_QualificaReferenteEnumeration.O))&#xD;
			{&#xD;
				&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				failed = true;&#xD;
				EsitoResponse.descrizione = &quot;Qualifica referente mancante o diversa da (O o CF)&quot;;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
// RU_871 - Agesp R1I-19-0179&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp;&#xD;
		 (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT ||&#xD;
		  localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL ||&#xD;
		  localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT) &amp;&amp;&#xD;
	    LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.ritiroProdotti == 'Y')&#xD;
{&#xD;
	failed = true;&#xD;
	EsitoResponse.descrizione = &quot;Cessazione &quot;+localRequest.offerta+&quot;, con refernti mancanti e ritiro prodotti valorizzati a &quot;+LavorazioneRichiesta.ritiroProdotti;&#xD;
	Process.auditLog(EsitoResponse.descrizione);&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
}&#xD;
else if(!found)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Nessun Referente trovato, controllo saltato&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Controllo superato&quot;;&#xD;
}&#xD;
&#xD;
/*&#xD;
var size = localRequest.ordine.referente.size();&#xD;
var flag1 = 0;&#xD;
var flag2 = 0;&#xD;
var flag3 = 0;&#xD;
&#xD;
if(size>=1)&#xD;
{&#xD;
	for(var i=0; i&lt;size; i++)&#xD;
	{&#xD;
		if(localRequest.ordine.referente.get(i).progressivoReferente == 1 &amp;&amp; flag1 == 0)&#xD;
		{&#xD;
			flag1 = 1;&#xD;
		}&#xD;
		else if(localRequest.ordine.referente.get(i).progressivoReferente == 2 &amp;&amp; flag2 == 0)&#xD;
		{&#xD;
			flag2 = 1;&#xD;
		}&#xD;
		else if(localRequest.ordine.referente.get(i).progressivoReferente == 3 &amp;&amp; flag3 == 0)&#xD;
		{&#xD;
			flag3 = 1;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL REFERENTE QUALIFICA Failed : Specified values for progressivoReferente is incorrect&quot;;&#xD;
			break;&#xD;
		}&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL REFERENTE QUALIFICA Successful&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL REFERENTE QUALIFICA Failed : At least one Referente must be specified&quot;;&#xD;
}*/</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_LTtNIv1FEeWEXoIZeVGhKA" Width="105.0">
              <xpdl2:Coordinates XCoordinate="348.0" YCoordinate="195.0"/>
            </xpdl2:NodeGraphicsInfo>
