        <xpdl2:Activity Id="__Zc9sAGOEea4VP73EUzo0Q" Name="BPMCheckFlagOnField" xpdExt:Visibility="Private" xpdExt:DisplayName="BPM Check FlagOnField">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var check = 0;&#xD;
&#xD;
if(localRequest.ordine.tipologiaQualita!=null &amp;&amp; localRequest.ordine.codiceDelivery!=null &amp;&amp; localRequest.ordine.codiceDelivery.length > 0)&#xD;
{&#xD;
	var size = localRequest.ordine.referente.size();	&#xD;
	for(var i=0; i&lt;size; i++)&#xD;
	{&#xD;
		if(localRequest.ordine.referente.get(i).tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTEONFIELD)&#xD;
		{&#xD;
			check = 1;&#xD;
			break;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(check==1)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL NPD OLO Successful&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL NPD OLO Failed : IDTipologiaQualita &amp; codiceDelivery must not be NULL, IDTypeReferenteOrdine should be REFERENTEONFIELD&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
