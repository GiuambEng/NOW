        <xpdl2:Activity Id="_TqfHUAcIEeaaXcIacC0_2w" Name="InitializeSedeJiveRequest" xpdExt:Visibility="Private" xpdExt:DisplayName="Initialize SedeJive Request">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">SedeJiveRequest = com_tim_NOW_xsd_ControlliAmmessi_Factory.createVerifica_Dati_Sede_su_Jive_Request();&#xD;
&#xD;
SedeJiveRequest.IDRichiestaNOW = localRequest.IDRichiestaOLO;&#xD;
SedeJiveRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
SedeJiveRequest.codificaOLOAgcom = localRequest.codificaOLOAGCOM;&#xD;
&#xD;
if(localRequest.ordine.codicePacchettoNOW != null)&#xD;
{&#xD;
	SedeJiveRequest.isPacchetto = true;&#xD;
}&#xD;
else&#xD;
{&#xD;
	SedeJiveRequest.isPacchetto = false;&#xD;
}&#xD;
&#xD;
SedeJiveRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
SedeJiveRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
SedeJiveRequest.scenario = it_telecomitalia_it_NOW_casedata_v1_TipologiaScenarioEnumeration.get(String(localRequest.tipologiaScenario));&#xD;
&#xD;
var found = false;&#xD;
var i = 0;&#xD;
&#xD;
while(!found &amp;&amp; i &lt; localRequest.ordine.sede.size())&#xD;
{&#xD;
	var currentSede = localRequest.ordine.sede.get(i);&#xD;
	Log.write(&quot;SedeJiveRequest per IDRichiestaOLO: &quot; + localRequest.IDRichiestaOLO +&quot;tipologiaSede:&quot;+ String(currentSede.tipologiaSede));&#xD;
	if(currentSede.tipologiaSede == it_telecomitalia_it_NOW_casedata_TipologiaSedeEnumeration.SEDECLIENTE)&#xD;
	{&#xD;
		found = true;&#xD;
		Process.auditLog(&quot;Found SEDECLIENTE&quot;);&#xD;
		&#xD;
		SedeJiveRequest.IDRichiestaNOW = localRequest.IDRichiestaOLO;&#xD;
		SedeJiveRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
		SedeJiveRequest.codificaOLOAgcom = localRequest.codificaOLOAGCOM;&#xD;
		SedeJiveRequest.civico = currentSede.civico;&#xD;
		SedeJiveRequest.descr_Particella_Toponomastica = currentSede.particellaToponomastica;&#xD;
		SedeJiveRequest.provincia = currentSede.provincia;&#xD;
		SedeJiveRequest.CAP = currentSede.CAP;&#xD;
		SedeJiveRequest.istat_Comune = currentSede.codiceISTATComune;&#xD;
		SedeJiveRequest.codice_Indirizzo_Toponomastica = currentSede.codiceToponomastica;&#xD;
		SedeJiveRequest.descr_Localita = currentSede.localita;&#xD;
		//Workaround temporaneo, da REG arriva via, ma da NGA arriva codiceVia&#xD;
		//mentre capiscono il tracciato faccio logica sul bpm&#xD;
		if(currentSede.via != null)&#xD;
		{&#xD;
			SedeJiveRequest.descr_Via = currentSede.via;&#xD;
		}&#xD;
		else if(currentSede.codiceVia != null)&#xD;
		{&#xD;
			SedeJiveRequest.descr_Via = currentSede.codiceVia;&#xD;
		}&#xD;
		&#xD;
		Log.write(&quot;SedeJiveRequest per IDRichiestaOLO: &quot; + localRequest.IDRichiestaOLO);&#xD;
		Log.write(ScriptUtil.toXML(SedeJiveRequest));&#xD;
	}&#xD;
	i++;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_Y5Jj8AAKEeaDSeOUKZfAKg" Width="96.0">
              <xpdl2:Coordinates XCoordinate="227.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
