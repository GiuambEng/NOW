    <xpdl2:WorkflowProcess Id="_ztY0ECNMEea7qJ_CMNwz5w" xpdExt:DisplayName="CTRL ENCAPSULATION GBE_C04M01F61" Name="CTRLENCAPSULATIONGBE_C04M01F61">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_P9YcgjygEeeZjNKHD34LDg" xpdExt:DisplayName="Asset" Name="Asset">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_P9YcgzygEeeZjNKHD34LDg" xpdExt:DisplayName="AssetRef" Name="AssetRef">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_PwjegWV-EeeFLuxKJU-nxw" xpdExt:DisplayName="EseguiControllo" Name="EseguiControllo" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="BOOLEAN"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_ztb3YSNMEea7qJ_CMNwz5w" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_ztY0EiNMEea7qJ_CMNwz5w" Width="31.0">
              <xpdl2:Coordinates XCoordinate="621.0" YCoordinate="234.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_ztb3YiNMEea7qJ_CMNwz5w" Name="VerificaEncapsulationGBE" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Encapsulation GBE" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE){&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset,10));&#xD;
	Asset = AssetRef.readAsset();&#xD;
	var CVLANIDAsset = &quot;&quot;;&#xD;
	CVLANIDAsset= null;&#xD;
	var SVLANCODEAsset = &quot;&quot;;&#xD;
	SVLANCODEAsset= null;&#xD;
	var SVLANCODERichiesta = &quot;&quot;;&#xD;
	SVLANCODERichiesta=null;&#xD;
	var CVLANIDRichiesta = &quot;&quot;;&#xD;
	CVLANIDRichiesta= null;&#xD;
	&#xD;
	&#xD;
	&#xD;
	//cerco in asset&#xD;
	for(var i=0; i&lt;Asset.dettaglioasset.size(); i++){&#xD;
		var componenteAsset = Asset.dettaglioasset.get(i);				&#xD;
		if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
			|| componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC){&#xD;
			var j=0;				&#xD;
			while((CVLANIDAsset == null || SVLANCODEAsset == null) &amp;&amp; j&lt;componenteAsset.attributidettaglioasset.size()){&#xD;
				var attributoAsset = componenteAsset.attributidettaglioasset.get(j);&#xD;
				if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
				{&#xD;
					&#xD;
					CVLANIDAsset=attributoAsset.valoreAttributo;&#xD;
				}						&#xD;
				else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
				{&#xD;
					&#xD;
					SVLANCODEAsset=attributoAsset.valoreAttributo;&#xD;
				}	&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	//Il valore di Encapsulation per i VC in consistenza è desumibile dalla seguente regola:&#xD;
	//•	CVLANID e SVLANCODE valorizzati  DoubleTag&#xD;
	//•	SVLANCODE valorizzato e CVLANID assente  SingleTag&#xD;
	var FLAG_ENCAPSULATION= &quot;&quot;;&#xD;
	if(CVLANIDAsset!= null &amp;&amp; SVLANCODEAsset!=null){&#xD;
		FLAG_ENCAPSULATION = &quot;Y&quot;;&#xD;
	}&#xD;
	else {&#xD;
		FLAG_ENCAPSULATION = &quot;N&quot;;&#xD;
	}&#xD;
	&#xD;
	&#xD;
	var duplicated = true;&#xD;
	var i=0;&#xD;
	if(EsistenzaVLANOutput!= null){&#xD;
		while(duplicated &amp;&amp; i&lt;EsistenzaVLANOutput.size()){&#xD;
			if(FLAG_ENCAPSULATION != EsistenzaVLANOutput.get(i).FLAG_ENCAPSULATION)&#xD;
			{&#xD;
				duplicated = false;&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(duplicated)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Tutte le VLAN in input sono coerenti con la vlan in asset&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Le VLAN non hanno lo stesso FlagEncapsulation dell'asset&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
else{&#xD;
	if(EsistenzaVLANOutput != null &amp;&amp; EsistenzaVLANOutput.size() > 0)&#xD;
	{&#xD;
		var FlagEncapsulation = EsistenzaVLANOutput.get(0).FLAG_ENCAPSULATION;&#xD;
		var duplicated = true;&#xD;
		var i = 1;&#xD;
&#xD;
		while(duplicated &amp;&amp; i &lt; EsistenzaVLANOutput.size())&#xD;
		{&#xD;
			if(FlagEncapsulation != EsistenzaVLANOutput.get(i).FLAG_ENCAPSULATION)&#xD;
			{&#xD;
				duplicated = false;&#xD;
			}&#xD;
			i++;&#xD;
		}	&#xD;
	&#xD;
		if(duplicated)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Tutte le VLAN hanno lo stesso FlagEncapsulation&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Le VLAN non hanno lo stesso FlagEncapsulation&quot;;&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
