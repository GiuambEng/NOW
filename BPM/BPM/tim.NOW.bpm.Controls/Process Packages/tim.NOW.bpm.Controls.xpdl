    <xpdl2:WorkflowProcess Id="_oaIHwC1rEea06vjvi_HOpw" xpdExt:DisplayName="CTRL COD ORD RIF OLO Tipo per Annullamento_C04M01F73" Name="CTRLCODORDRIFOLOTipoperAnnullamento_C04M01F73">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_oaTt8S1rEea06vjvi_HOpw" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_oaIu0C1rEea06vjvi_HOpw" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_oaTt8i1rEea06vjvi_HOpw" Name="VerificadelCodiceOrdineRifOLOTipo" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica del Codice Ordine Rif OLO Tipo">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
if(TargetRequest != null &amp;&amp; TargetRequestRef!=null)&#xD;
{&#xD;
	TargetRequest = TargetRequestRef.readRichiesta();&#xD;
	Process.auditLog(&quot;Lavorazione Local: &quot; + String(localRequest.lavorazione));&#xD;
	Process.auditLog(&quot;Lavorazione Target: &quot; + String(TargetRequest.lavorazione));&#xD;
	Process.auditLog(&quot;Struttura Target: &quot; + String(TargetRequest.strutturaRichiesta));&#xD;
	Process.auditLog(&quot;Scenario Target: &quot; + String(TargetRequest.tipologiaScenario));&#xD;
	&#xD;
	if(TargetRequest.flagDelibera103 == localRequest.flagDelibera103)//SM_10996&#xD;
	{	&#xD;
		if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTO)&#xD;
		{&#xD;
			if((TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp;&#xD;
				(String(TargetRequest.offerta).substring(0,3) == 'ULL' ||&#xD;
				String(TargetRequest.offerta).substring(0,3) == 'SLU' ||&#xD;
				String(TargetRequest.offerta).substring(0,4) == 'VULA' ||&#xD;
				String(TargetRequest.offerta).substring(0,9) == 'BITSTREAM' ||&#xD;
				String(TargetRequest.offerta).substring(0,6) == 'EASYIP' ||&#xD;
				TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH ||           //RU_1164: aggiunte SEMI***&#xD;
				TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH ||&#xD;
				TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH ||&#xD;
				TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON ||         //SM_10081: aggiunte UBBFULLGPON e UBBSEMIGPON&#xD;
				TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON ||&#xD;
				TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM ||   		//RU_1451&#xD;
				TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS ||&#xD;
				TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA))    //SM_11622&#xD;
				||&#xD;
				(TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp;&#xD;
				(TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CESSAZIONEULL ||&#xD;
				TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CESSAZIONESLU)))&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO Successful.&quot;;&#xD;
			}&#xD;
			else if(TargetRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG &amp;&amp;&#xD;
					(TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE ||&#xD;
						TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.PORTIN ||&#xD;
						TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.PRENOTIFICADONATING))&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO Successful.&quot;;&#xD;
			}&#xD;
			//Bug #35055&#xD;
			else if(TargetRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO&#xD;
			   &amp;&amp; TargetRequest.ordineAssetWhiteList != null)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO positivo&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO Failed : ATTIVAZIONE or CESSAZIONE Offerta not in scope.&quot;;&#xD;
			}&#xD;
		}&#xD;
		else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ESPLETAMENTODONORRECIPIENTDONATING&#xD;
			|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTORECIPIENT //SM_10853&#xD;
			|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RDACDONORDONATING //SM_10853&#xD;
			)&#xD;
		{&#xD;
			if(TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
				&amp;&amp; TargetRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
				&amp;&amp; TargetRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DONOROLO)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Espletamento Donor Successful.&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Espletamento Donor Failed : Lavorazione not in scope.&quot;;&#xD;
			}&#xD;
		}&#xD;
		else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RIMODULAZIONEDAC)&#xD;
		{&#xD;
			if(TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
				&amp;&amp; TargetRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
				&amp;&amp; String(TargetRequest.tipologiaScenario).slice(0,10) == &quot;NPDONOROLO&quot; //Bug #41894&#xD;
				)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Rimodulazione DAC Successful.&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Rimodulazione DAC Failed : Lavorazione not in scope.&quot;;&#xD;
			}&#xD;
		}&#xD;
		else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VALIDFORMALEDONATINGDONOR&#xD;
				|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VALIDTECNICADONATINGDONOR&#xD;
				|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.RDACRECIPIENTDONOR //SM_10853&#xD;
				|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ESPLETAMENTODONATINGDONOR  //SM_10853&#xD;
				)&#xD;
		{&#xD;
			if(TargetRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG &amp;&amp;&#xD;
				(TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE ||&#xD;
					TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.PORTIN ||&#xD;
					TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.PRENOTIFICADONATING))&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Verifica Capacità Evasione o Verifica Codice Segreto Successful.&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Verifica Capacità Evasione o Verifica Codice Segreto Failed : Lavorazione not in scope.&quot;;&#xD;
			}&#xD;
		}&#xD;
		else if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VALIDTECNICACESSAZIONE)&#xD;
		{&#xD;
			if(TargetRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG &amp;&amp; &#xD;
			TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Validazione tecnica cessazione Successful&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Validazione tecnica cessazione Failed: Lavorazione not in scope&quot;;&#xD;
			}&#xD;
		}&#xD;
		else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.INTERRUZIONEMIGRAZIONE)&#xD;
		{&#xD;
			 //Bug #35055 - per questa sottolav particolare deve arrivare ANNULLAMENTO, anche se si tratta di una migrazione&#xD;
			if(TargetRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO&#xD;
			   &amp;&amp; TargetRequest.ordineAssetWhiteList != null)&#xD;
			{&#xD;
				  EsitoResponse.codice = false;&#xD;
				  EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO fallito - MIGRAZIONEOLO WHITELIST, deve arrivare ANNULLAMENTO e non INTERRUZIONEMIGRAZIONE&quot;;&#xD;
			}&#xD;
			else if(TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE ||&#xD;
				(TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp;&#xD;
				   (TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA ||&#xD;
					TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL ||&#xD;
					TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP ||&#xD;
					TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP ||&#xD;
					TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA ||&#xD;
					TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP ||&#xD;
					TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA ||&#xD;
					TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA ||&#xD;
					TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA ||&#xD;
					TargetRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA)))&#xD;
			{&#xD;
				Process.auditLog(&quot;Controllo C04M01F73 INTERRUZIONE MIGRAZIONE PER OFFERTA: &quot; + String(TargetRequest.offerta));&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Verifica interruzione migrazione Successful.&quot;;&#xD;
			}&#xD;
			else if(TargetRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &amp;&amp;&#xD;
					(String(TargetRequest.offerta).slice(0,9) == &quot;BITSTREAM&quot; || String(TargetRequest.offerta).slice(0,6) == &quot;EASYIP&quot; || String(TargetRequest.offerta).slice(0,4) == &quot;VULA&quot;)) &#xD;
			{&#xD;
					//var tipolinea = &quot;&quot;;&#xD;
					//tipolinea = null;&#xD;
					//var i = 0;&#xD;
&#xD;
					//while(tipolinea == null &amp;&amp; i &lt; TargetRequest.ordine.dettaglioordine.size())&#xD;
					//{&#xD;
						//var currentDettOrdine = TargetRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
						//if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
						//{&#xD;
							//var j = 0;&#xD;
				&#xD;
							//while(tipolinea == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
							//{&#xD;
								//var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
								//if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
								//{&#xD;
									//tipolinea = currentAttDettOrdine.valoreAttributo;&#xD;
								//}&#xD;
								//j++;&#xD;
							//}&#xD;
						//}&#xD;
					//	i++;&#xD;
				//	}&#xD;
					&#xD;
					//inserita logica su flagNaked dato che su lavorazioni target in pervenuto ordine ancora non è stato creato&#xD;
					var Condiviso = false;&#xD;
					if (TargetRequest.flagNaked != null &amp;&amp; TargetRequest.flagNaked != &quot;&quot;)&#xD;
					{&#xD;
						if (TargetRequest.flagNaked == 'N')&#xD;
						{&#xD;
							Condiviso = true;&#xD;
						}		&#xD;
					}		&#xD;
					&#xD;
					&#xD;
					Process.auditLog(&quot;Controllo C04M01F73 INTERRUZIONE MIGRAZIONE PER OFFERTA: &quot; + String(TargetRequest.offerta));&#xD;
						//if(tipolinea == &quot;POTS&quot; || tipolinea == &quot;ISDN&quot; )&#xD;
						if(Condiviso)&#xD;
					{&#xD;
						Process.auditLog(&quot;Controllo C04M01F73 INTERRUZIONE MIGRAZIONE FLAGNAKED: &quot;+TargetRequest.flagNaked);&#xD;
						EsitoResponse.codice = true;&#xD;
						EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Verifica interruzione migrazione Successful.&quot;;&#xD;
					} else&#xD;
					  {&#xD;
					  EsitoResponse.codice = false;&#xD;
					  EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Verifica interruzione migrazione Failed: Lavorazione not in scope.&quot;;&#xD;
					  }&#xD;
			}&#xD;
			else{&#xD;
				Process.auditLog(&quot;CTRL CODICE ORDINE OLO TIPO per Verifica interruzione migrazione Failed: Lavorazione not in scope.&quot;);&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Verifica interruzione migrazione Failed: Lavorazione not in scope.&quot;;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Annullamento Failed : No record found for specified codiceOrdineOLO and ATTIVAZIONE or CESSAZIONE.&quot;;&#xD;
		}&#xD;
	}&#xD;
	else //SM_10996&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Annullamento Failed : Disallineamneto FlagDelibera103 tra localRequest e TargetRequest &quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE OLO TIPO per Annullamento Failed : No record found for specified codiceOrdineOLO &quot;;&#xD;
}&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
