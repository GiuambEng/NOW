        <xpdl2:Activity Id="_iRZLEsUqEeucXYhZ3HMW7w" Name="Valorizzazione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Dominio Valori Banda Multicast">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var listaValoriBANDA = DataUtil.createList();&#xD;
listaValoriBANDA.add(&quot;0,2&quot;); &#xD;
listaValoriBANDA.add(&quot;0,5&quot;); &#xD;
listaValoriBANDA.add(&quot;2&quot;);&#xD;
listaValoriBANDA.add(&quot;4&quot;); &#xD;
listaValoriBANDA.add(&quot;6&quot;); &#xD;
listaValoriBANDA.add(&quot;8&quot;);&#xD;
listaValoriBANDA.add(&quot;10&quot;);&#xD;
listaValoriBANDA.add(&quot;12&quot;);&#xD;
listaValoriBANDA.add(&quot;14&quot;);&#xD;
listaValoriBANDA.add(&quot;16&quot;);&#xD;
listaValoriBANDA.add(&quot;20&quot;);&#xD;
listaValoriBANDA.add(&quot;30&quot;);&#xD;
listaValoriBANDA.add(&quot;40&quot;);&#xD;
listaValoriBANDA.add(&quot;50&quot;);&#xD;
listaValoriBANDA.add(&quot;60&quot;);&#xD;
listaValoriBANDA.add(&quot;70&quot;);&#xD;
listaValoriBANDA.add(&quot;80&quot;);&#xD;
listaValoriBANDA.add(&quot;100&quot;);&#xD;
listaValoriBANDA.add(&quot;200&quot;);&#xD;
listaValoriBANDA.add(&quot;300&quot;);&#xD;
listaValoriBANDA.add(&quot;400&quot;);&#xD;
listaValoriBANDA.add(&quot;500&quot;);&#xD;
listaValoriBANDA.add(&quot;600&quot;);&#xD;
listaValoriBANDA.add(&quot;700&quot;);&#xD;
listaValoriBANDA.add(&quot;800&quot;);&#xD;
listaValoriBANDA.add(&quot;900&quot;);&#xD;
listaValoriBANDA.add(&quot;1000&quot;);&#xD;
&#xD;
var BANDA = &quot;&quot;;&#xD;
BANDA = null;&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDA)&#xD;
			{&#xD;
				BANDA = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo BANDA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
if(BANDA != null &amp;&amp; listaValoriBANDA.contains(BANDA))&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DOMINIO VALORI BANDA MULTICAST_C04M01F467 SUPERATO&quot;;&#xD;
}&#xD;
else &#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DOMINIO VALORI BANDA MULTICAST_C04M01F467 NON SUPERATO&quot;;&#xD;
}</xpdl2:Script>
