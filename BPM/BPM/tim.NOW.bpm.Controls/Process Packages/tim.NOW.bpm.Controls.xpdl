          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL PRESTAZ ACCESSORIE OBBLIGATORIE OF_C04M01F512 non superato&quot;;&#xD;
&#xD;
for(var i=0; i&lt;VerificaServizioAggiuntivoResponse.servizio.size(); i++)&#xD;
{&#xD;
	var servizioNow = VerificaServizioAggiuntivoResponse.servizio.get(i);&#xD;
	&#xD;
	if(servizioNow.ambito == &quot;DTU&quot; &amp;&amp; servizioNow.nomeServizio == &quot;TLC1&quot;)&#xD;
	{&#xD;
		EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL PRESTAZ ACCESSORIE OBBLIGATORIE OF_C04M01F512 superato&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
