        <xpdl2:Activity Id="_QnDMAiMWEea7qJ_CMNwz5w" Name="VerificaEsistenzaVLAN" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Esistenza VLAN">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_YHGdECMWEea7qJ_CMNwz5w">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="false" Direction="IN" Formal="input">
                      <xpdl2:Actual ScriptGrammar="JavaScript">VerificaEsistenzaVLANRequest</xpdl2:Actual>
