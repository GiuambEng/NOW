        <xpdl2:Activity Id="_j5fspNlFEemWxaYTfiH0Tw" Name="ScriptTask" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Script Task">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">VerificaConsistenzaModemRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaPresenzaModem_RequestType();&#xD;
&#xD;
VerificaConsistenzaModemRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaConsistenzaModemRequest.IDRisorsa=localRequest.IDRisorsa;&#xD;
VerificaConsistenzaModemRequest.lavorazione=String(localRequest.lavorazione);&#xD;
VerificaConsistenzaModemRequest.offerta=String(localRequest.offerta);&#xD;
&#xD;
&#xD;
if(localRequest.ordine.referente != null &amp;&amp; localRequest.ordine.referente.size() > 0)&#xD;
	{&#xD;
	if (localRequest.ordine.referente.get(0).cognomeReferente!= null &amp;&amp; localRequest.ordine.referente.get(0).cognomeReferente!=&quot;&quot;)&#xD;
	{&#xD;
		Process.auditLog(&quot;Trovato cognome Referente:&quot;+localRequest.ordine.referente.get(0).cognomeReferente);&#xD;
		VerificaConsistenzaModemRequest.flagReferente = com_tim_NOW_xsd_ControlliFormali_FlagReferenteType.Y;&#xD;
	}&#xD;
	else if (localRequest.ordine.referente.get(0).nomeReferente!= null &amp;&amp; localRequest.ordine.referente.get(0).nomeReferente!=&quot;&quot;)&#xD;
		{&#xD;
		Process.auditLog(&quot;Trovato nome Referente:&quot;+localRequest.ordine.referente.get(0).nomeReferente);&#xD;
		VerificaConsistenzaModemRequest.flagReferente = com_tim_NOW_xsd_ControlliFormali_FlagReferenteType.Y;&#xD;
	}&#xD;
	else if (localRequest.ordine.referente.get(0).created!= null &amp;&amp; localRequest.ordine.referente.get(0).created!=&quot;&quot;)&#xD;
	{	&#xD;
		Process.auditLog(&quot;Trovato Referente created:&quot;+localRequest.ordine.referente.get(0).created);&#xD;
		VerificaConsistenzaModemRequest.flagReferente = com_tim_NOW_xsd_ControlliFormali_FlagReferenteType.Y;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
VerificaConsistenzaModemRequest.flagReferente = com_tim_NOW_xsd_ControlliFormali_FlagReferenteType.N;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
