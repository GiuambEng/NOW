RecuperaRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
if (Scenario != null &amp;&amp; Scenario != &quot;&quot; )&#xD;
{&#xD;
	RecuperaRequest.scenario = Scenario;&#xD;
}&#xD;
else if(localRequest.tipologiaScenario != null)&#xD;
{&#xD;
	RecuperaRequest.scenario = String(localRequest.tipologiaScenario);&#xD;
}&#xD;
&#xD;
if(localRequest.offerta != null)&#xD;
{&#xD;
	RecuperaRequest.servizio = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
}</xpdl2:Script>
