          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_XstUiBoSEeymUKPGzoQSMg" Name="ControllocongruenzaBMCeBMCLIGHT" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Controllo congruenza BMC e BMCLIGHT">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//CONTROLLO CREATO CON SM_10290&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;C04M01F488 Controllo congruenza BMC e BMCLIGHT&quot;;&#xD;
&#xD;
//RECUPERO ASSET&#xD;
if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
}&#xD;
	&#xD;
if(AssetRef!= null)&#xD;
{	&#xD;
	Asset = AssetRef.readAsset();&#xD;
}&#xD;
&#xD;
//LOGICA DEL CONTROLLO&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; Asset != null)&#xD;
{&#xD;
	//USERVLAN DELLA RICHIESTA&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			var USERVLANIDRic = &quot;&quot;;&#xD;
			USERVLANIDRic = null;&#xD;
			var SVLANCODERic = &quot;&quot;;&#xD;
			SVLANCODERic = null;&#xD;
			var CODEVLANSINGLETAGRic = &quot;&quot;;&#xD;
			CODEVLANSINGLETAGRic = null;&#xD;
			var BMCLIGHTRic = &quot;&quot;;&#xD;
			BMCLIGHTRic = null;&#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
				{&#xD;
					USERVLANIDRic = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
				{&#xD;
					SVLANCODERic = attributo.valoreAttributo;	&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
				{&#xD;
					CODEVLANSINGLETAGRic = attributo.valoreAttributo;				&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BMCLIGHT)&#xD;
				{&#xD;
					BMCLIGHTRic = attributo.valoreAttributo;				&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			Process.auditLog(&quot;Trovata USERVLAN nella richiesta con USERVLANID: &quot;+USERVLANIDRic+ &quot;, SVLANCODE: &quot;+SVLANCODERic+&quot;, CODEVLANSINGLETAG: &quot;+CODEVLANSINGLETAGRic);&#xD;
			&#xD;
			&#xD;
			//USERVLAN DELL'ASSET&#xD;
			var USERVLANIDAsset = &quot;&quot;;&#xD;
			USERVLANIDAsset = null;&#xD;
			var SVLANCODEAsset = &quot;&quot;;&#xD;
			SVLANCODEAsset = null;&#xD;
			var BMCLIGHTAsset = &quot;&quot;;&#xD;
			BMCLIGHTAsset = null;&#xD;
			&#xD;
			for(var k=0; k&lt;Asset.dettaglioasset.size(); k++)&#xD;
			{&#xD;
				var currentComponente = Asset.dettaglioasset.get(k);&#xD;
			&#xD;
				if(currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
				   &amp;&amp; currentComponente.statoDettaglioAsset == &quot;ATTIVO&quot;)&#xD;
				{				&#xD;
					for(var t=0; t&lt;currentComponente.attributidettaglioasset.size(); t++)&#xD;
					{&#xD;
						var currentAttributo = currentComponente.attributidettaglioasset.get(t);&#xD;
					&#xD;
						if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
						{&#xD;
							USERVLANIDAsset = currentAttributo.valoreAttributo;	&#xD;
						}&#xD;
						else if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
						{&#xD;
							SVLANCODEAsset = currentAttributo.valoreAttributo;&#xD;
						}&#xD;
						else if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BMCLIGHT)&#xD;
						{&#xD;
							BMCLIGHTAsset = currentAttributo.valoreAttributo;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					Process.auditLog(&quot;Trovata USERVLAN nell'asset con USERVLANID: &quot;+USERVLANIDAsset+ &quot;, SVLANCODE: &quot;+SVLANCODEAsset);&#xD;
					&#xD;
					&#xD;
					//ENCAPSULATION -> DOUBLETAG, ci deve essere una variazione di SVLANCODE &#xD;
					//ENCAPSULATION -> SINGLETAG, ci deve essere una variazione di CODEVLANSINGLETAG &#xD;
					//Se c'è una variazione da o a FLAGMULTICAST, non va considerata, così come la variazione del solo profilotecnicolinea o delle bande&#xD;
					if(USERVLANIDRic == USERVLANIDAsset&#xD;
					   &amp;&amp; ((SVLANCODERic != null &amp;&amp; SVLANCODEAsset != null &amp;&amp; SVLANCODERic != SVLANCODEAsset)&#xD;
						   ||(CODEVLANSINGLETAGRic != null &amp;&amp; SVLANCODEAsset != null &amp;&amp; CODEVLANSINGLETAGRic != SVLANCODEAsset))&#xD;
					   &amp;&amp; BMCLIGHTRic != BMCLIGHTAsset)&#xD;
					{						&#xD;
						//Scarto se BMCLIGHT sono diversi (quindi se sono entrambi valorizzati e diversi oppure se uno è null e l'altro no)&#xD;
						EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;Controllo congruenza BMC e BMCLIGHT_C04M01F482 non superato&quot;;	&#xD;
&#xD;
						Process.auditLog(&quot;Trovata USERVLAN con USERVLANID: &quot; +USERVLANIDRic+ &quot; avente BMCLIGHT della richiesta: &quot;+BMCLIGHTRic+ &quot; e BMCLIGHT della consistenza: &quot;+BMCLIGHTAsset);&#xD;
					}&#xD;
				}&#xD;
			}				&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_NWoRgRoSEeymUKPGzoQSMg" Width="151.0">
              <xpdl2:Coordinates XCoordinate="508.0" YCoordinate="215.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_aF2WIhoSEeymUKPGzoQSMg" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = false;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
   &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
	  ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS			//RU_1555: Aggiunte offerte FULLGPONPLUS/NGA&#xD;
	  ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA))&#xD;
{&#xD;
	//Il controllo va fatto sulle USERVLAN NON BMD e, arrivati a questo controllo, le USERVLAN sono o tutte BMD o tutte non BMD&#xD;
	if(EsistenzaVLANOutput != null &amp;&amp; EsistenzaVLANOutput.size()>0)&#xD;
	{&#xD;
		for(var i=0; i&lt;EsistenzaVLANOutput.size(); i++)&#xD;
		{&#xD;
			var currentEsistenzaVLAN = EsistenzaVLANOutput.get(i);&#xD;
			&#xD;
			if(currentEsistenzaVLAN.TIPO_COS != &quot;BMD&quot;)&#xD;
			{&#xD;
				EseguiControllo = true;&#xD;
			}		&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_NWoRgRoSEeymUKPGzoQSMg" Width="109.0">
              <xpdl2:Coordinates XCoordinate="167.0" YCoordinate="215.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
      </xpdl2:Activities>
