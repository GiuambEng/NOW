        <xpdl2:Activity Id="_Bd4BYtMZEeqqWasz_r4Thg" Name="ValorizzazioneCodiceProgetto" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Valorizzazione CodiceProgetto" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var VariazioneConcordata = &quot;&quot;;&#xD;
VariazioneConcordata = null;&#xD;
var foundCodiceProgetto = false;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.codiceProgetto != null &amp;&amp; localRequest.codiceProgetto != &quot;&quot;)&#xD;
{&#xD;
	foundCodiceProgetto = true;&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VARIAZIONECONCORDATA)&#xD;
			{&#xD;
				VariazioneConcordata = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo VARIAZIONECONCORDATA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
if(VariazioneConcordata == &quot;SI&quot; &amp;&amp; !foundCodiceProgetto)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE CODICE PROGETTO PER VARIAZIONE CONCORDATA NON SUPERATO&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE CODICE PROGETTO PER VARIAZIONE CONCORDATA SUPERATO&quot;;&#xD;
}&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
