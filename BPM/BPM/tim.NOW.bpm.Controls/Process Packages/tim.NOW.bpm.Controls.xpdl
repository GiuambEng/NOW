        <xpdl2:Activity Id="_2DdZEsDfEe64jdwJ5NkDGQ" Name="VerificaNumeroTelefonico" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Numero Telefonico">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL NUMERO TELEFONICO OF superato&quot;;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != &quot;&quot; &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.FONIA)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO) &#xD;
				{&#xD;
					Process.auditLog(&quot;Recuperato valore : &quot;+attributo.valoreAttributo+&quot; per attributo &quot;+attributo.nomeAttributo);&#xD;
					&#xD;
					for(var k=0;k &lt;attributo.valoreAttributo.length; k++)&#xD;
					{&#xD;
						var currentCharCode = attributo.valoreAttributo.charCodeAt(k);&#xD;
						&#xD;
						if(currentCharCode &lt; 48 || currentCharCode > 57)&#xD;
						{&#xD;
							//Trovato un carattere non numerico&#xD;
							EsitoResponse.codice = false;&#xD;
							EsitoResponse.descrizione = &quot;controllo C04M01F505 – Verifica Numero Telefonico per OF fallito per carattere non numerico&quot;;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					if(attributo.valoreAttributo.length &lt; 6 || attributo.valoreAttributo.length > 15)&#xD;
					{&#xD;
						//Lunghezza non rispettata&#xD;
						EsitoResponse.codice = false;&#xD;
						EsitoResponse.descrizione = &quot;Controllo C04M01F505 fallito per lunghezza non rispettata&quot;;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Esito controllo: &quot;+EsitoResponse.descrizione);&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
