          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(ContrattoOloResponse != null)&#xD;
{&#xD;
	if(ContrattoOloResponse.flag_Diffidato == com_tim_NOW_xsd_ControlliAmmessi_Flag_DiffidatoType.Y)&#xD;
	{&#xD;
		FlagDiffidato = &quot;Y&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		FlagDiffidato = &quot;N&quot;;&#xD;
	}&#xD;
	&#xD;
	//RU_1306&#xD;
	if(ContrattoOloResponse.flagOloDiffidatoFull == &quot;Y&quot;)&#xD;
	{&#xD;
		FlagOloDiffidatoFull = &quot;Y&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		FlagOloDiffidatoFull = &quot;N&quot;;&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ContrattoOLORequest = com_tim_NOW_xsd_ControlliAmmessi_Factory.createVerifica_Contratto_Request();&#xD;
&#xD;
ContrattoOLORequest.CODICE_OLO = localRequest.codificaOLONOW;&#xD;
ContrattoOLORequest.DRO = localRequest.DRO;&#xD;
ContrattoOLORequest.IDRichiesta = localRequest.IDRichiestaOLO;&#xD;
ContrattoOLORequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
ContrattoOLORequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
ContrattoOLORequest.lavorazione = String(localRequest.lavorazione); // SM_9642&#xD;
ContrattoOLORequest.tipologiaSottolav = String(localRequest.tipologiaSottolav); //RU_1184&#xD;
ContrattoOLORequest.gestioneAutonoma = localRequest.gestioneAutonoma; //RU_1393&#xD;
&#xD;
if(EsistenzaVLANOutput != null &amp;&amp; EsistenzaVLANOutput.size() > 0)&#xD;
{&#xD;
	ContrattoOLORequest.codiceOperatoreRete = EsistenzaVLANOutput.get(0).codiceOperatoreRete;&#xD;
}&#xD;
&#xD;
if(localRequest != null &#xD;
   &amp;&amp;(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS&#xD;
      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NPNG))    //RU_1203&#xD;
{&#xD;
	ContrattoOLORequest.DN = localRequest.IDRisorsa;&#xD;
}&#xD;
&#xD;
//RU_1393: Aggiunto GestioneAutonoma in interfaccia&#xD;
&#xD;
//SM_10361: se c'è almeno una USERVLAN (non da cessare) con FLAGMULTICAST, invio il suo valore (&quot;SI&quot;) al servizio&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
		   &amp;&amp; componente.azione != it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
				{&#xD;
					ContrattoOLORequest.flagMulticast = attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
