        <xpdl2:Activity Id="_0PxaAWkJEeaCa7IeLXedLg" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_e6sPoGkFEeaCa7IeLXedLg" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="52.0" LaneId="_Ytos8WkEEeaCa7IeLXedLg" Width="73.0">
              <xpdl2:Coordinates XCoordinate="54.0" YCoordinate="218.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_Aq1EIJd7EeaQs-K06GRZCw" Name="DatiVerificaControlli" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="DatiVerificaControlli">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_Aa1wkMIeEeaIJ-AnJ3AotA" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="processIdentifier" xpdExt:StartStrategy="ScheduleStart" xpdExt:SuspendResumeWithParent="false">
              <xpdl2:DataMappings>
                <xpdl2:DataMapping xpdExt:InitialValueMapping="true" Direction="IN" Formal="Azione">
                  <xpdl2:Actual ScriptGrammar="JavaScript">&quot;INSERT&quot;</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="IDRichiestaOLO">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="Operatore">
                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.operatore</xpdl2:Actual>
                </xpdl2:DataMapping>
                <xpdl2:DataMapping Direction="IN" Formal="DatiVerificheFormali">
                  <xpdl2:Actual ScriptGrammar="JavaScript">DatiVerificheFormali</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:Priority></xpdl2:Priority>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" LaneId="_Ytos8WkEEeaCa7IeLXedLg" Width="128.0">
              <xpdl2:Coordinates XCoordinate="715.0" YCoordinate="218.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="DataMapper">
<xpdExt:ScriptDataMapper MapperContext="InitiatedScriptTask" MappingDirection="IN">
                  <xpdExt:DataMappings>
                    <xpdExt:DataMapping xpdExt:SourceContributorId="ProcessData.DataMapperContent" xpdExt:TargetContributorId="ProcessData.DataMapperContent" Direction="IN" Formal="DatiVerificheFormali.flagNuovoModello">
                      <xpdl2:Actual ScriptGrammar="JavaScript">FlagNuovoModello</xpdl2:Actual>
                    </xpdExt:DataMapping>
                  </xpdExt:DataMappings>
                </xpdExt:ScriptDataMapper>
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
