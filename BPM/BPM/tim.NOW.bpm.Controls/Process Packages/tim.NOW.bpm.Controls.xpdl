          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = false;&#xD;
&#xD;
if((localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO&#xD;
      &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS)&#xD;
  ||localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
  ||localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL)&#xD;
{&#xD;
	if(localRequest.ordine != null &amp;&amp; localRequest.ordine.referente != null &amp;&amp; localRequest.ordine.referente.size() > 0)&#xD;
	{&#xD;
		var i=0;&#xD;
		&#xD;
		//Da effettuare se almeno un flag_Token = SI&#xD;
		while(!EseguiControllo &amp;&amp; i&lt;localRequest.ordine.referente.size())&#xD;
		{&#xD;
			var currentReferente = localRequest.ordine.referente.get(i);&#xD;
			&#xD;
			if(currentReferente.flag_Token == &quot;SI&quot;)&#xD;
			{&#xD;
				EseguiControllo = true;&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
