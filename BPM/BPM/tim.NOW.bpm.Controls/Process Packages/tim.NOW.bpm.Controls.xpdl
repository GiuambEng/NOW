        <xpdl2:Activity Id="_PoGC8D1NEeaLrLgcjfGZ6g" Name="AddSedeCertificata" xpdExt:Visibility="Private" xpdExt:DisplayName="Add SedeCertificata">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(SedeCertificata != null){&#xD;
	var serialized = ScriptUtil.toXML(SedeCertificata);&#xD;
	serialized = serialized.replace(&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot;,&quot;http://NOW.it.telecomitalia.it/casedata&quot;);&#xD;
	var SedeBOM = ScriptUtil.fromXML(serialized);&#xD;
	&#xD;
	localRequest.ordine.sede.add(SedeBOM);&#xD;
}&#xD;
&#xD;
if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL){&#xD;
	localRequest.ordine.numeroFittizio = localRequest.ordine.distretto;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
