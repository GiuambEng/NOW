          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">verificaCongruenzaClusterComuneVLANRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaCongruenzaClusterComuneVlan_RequestType();&#xD;
&#xD;
verificaCongruenzaClusterComuneVLANRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
verificaCongruenzaClusterComuneVLANRequest.lavorazione = String(localRequest.lavorazione);&#xD;
verificaCongruenzaClusterComuneVLANRequest.offerta = String(localRequest.offerta);&#xD;
verificaCongruenzaClusterComuneVLANRequest.sottoLavorazione = String(localRequest.tipologiaSottolav);&#xD;
verificaCongruenzaClusterComuneVLANRequest.istatComune = localRequest.ISTATComune;&#xD;
&#xD;
if(ConsistenzaDati != null)&#xD;
{&#xD;
	verificaCongruenzaClusterComuneVLANRequest.idAsset = ConsistenzaDati.IDAsset;&#xD;
}&#xD;
else if(ConsistenzaFonia != null)       //PROP SM_9428&#xD;
{&#xD;
	verificaCongruenzaClusterComuneVLANRequest.idAsset = ConsistenzaFonia.IDAsset;&#xD;
}&#xD;
else if(ConsistenzaRaccolta != null) //RU_1058&#xD;
{&#xD;
	verificaCongruenzaClusterComuneVLANRequest.idAsset = ConsistenzaRaccolta.IDAsset;&#xD;
	verificaCongruenzaClusterComuneVLANRequest.ftthOnlyConsistenza = ConsistenzaRaccolta.ftthOnly;&#xD;
	verificaCongruenzaClusterComuneVLANRequest.tipologiaClusterVlanConsistenza = ConsistenzaRaccolta.tipologiaClusterVlan; //nome nell'interfaccia sbagliato, da correggere&#xD;
}&#xD;
&#xD;
//RU_1058&#xD;
verificaCongruenzaClusterComuneVLANRequest.idRisorsaVlan = localRequest.IDRisorsa;&#xD;
&#xD;
if(LavorazioneRichiesta != null)&#xD;
{&#xD;
	if(LavorazioneRichiesta.idKitAreaCar != null)&#xD;
	{&#xD;
		verificaCongruenzaClusterComuneVLANRequest.idKitAreaCar = LavorazioneRichiesta.idKitAreaCar;&#xD;
	}&#xD;
	&#xD;
	//RU_1099&#xD;
	if(LavorazioneRichiesta.ftthOnly != null)&#xD;
	{&#xD;
		verificaCongruenzaClusterComuneVLANRequest.ftthOnly = LavorazioneRichiesta.ftthOnly;&#xD;
	}&#xD;
	&#xD;
	if(LavorazioneRichiesta.tipologiaClusterVlan != null)&#xD;
	{&#xD;
		verificaCongruenzaClusterComuneVLANRequest.tipologiaClusterVlan = LavorazioneRichiesta.tipologiaClusterVlan;&#xD;
	}&#xD;
}&#xD;
