          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaCodiceProgettoRequest = com_tim_NOW_xsd_ControlliAmmessi_Factory.createVerifica_Codice_Progetto_Request();&#xD;
&#xD;
VerificaCodiceProgettoRequest.DRO = localRequest.DRO;&#xD;
VerificaCodiceProgettoRequest.IDRichiesta = localRequest.IDRichiestaOLO;&#xD;
VerificaCodiceProgettoRequest.codice_OLO = localRequest.codificaOLONOW;&#xD;
VerificaCodiceProgettoRequest.codice_Progetto = localRequest.codiceProgetto;&#xD;
VerificaCodiceProgettoRequest.flag_Naked = localRequest.flagNaked;		//SM_8550&#xD;
VerificaCodiceProgettoRequest.flag_ReferenteOnField = &quot;N&quot;; //RU_1357&#xD;
&#xD;
if(localRequest.tipologiaScenario != null)&#xD;
{&#xD;
	VerificaCodiceProgettoRequest.scenario = String(localRequest.tipologiaScenario);&#xD;
}&#xD;
&#xD;
if(localRequest.lavorazione != null)&#xD;
{&#xD;
	VerificaCodiceProgettoRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
}&#xD;
if(localRequest.offerta != null)&#xD;
{&#xD;
	VerificaCodiceProgettoRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
}&#xD;
&#xD;
if(TrovatoModem)&#xD;
{&#xD;
	VerificaCodiceProgettoRequest.flag_Modem = &quot;Y&quot;;&#xD;
}&#xD;
else &#xD;
{&#xD;
	VerificaCodiceProgettoRequest.flag_Modem = &quot;N&quot;;&#xD;
}&#xD;
&#xD;
//SM_8550 start.&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			var foundFlagMigr = false;&#xD;
			while(!foundFlagMigr &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attrDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				if(attrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MIGRAZIONEINTRAOLO)&#xD;
				{&#xD;
					VerificaCodiceProgettoRequest.flag_MigrazioneIntraOlo = attrDettOrdine.valoreAttributo;&#xD;
					foundFlagMigr = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
		{&#xD;
			var k = 0;&#xD;
			var foundOffertaDonating = false;&#xD;
			while(!foundOffertaDonating &amp;&amp; k &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attrDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(k);&#xD;
				if(attrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
				{&#xD;
					VerificaCodiceProgettoRequest.offerta_Donating = attrDettOrdine.valoreAttributo;&#xD;
					foundOffertaDonating = true;&#xD;
				}&#xD;
				k++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	//RU_1357&#xD;
	if(localRequest.ordine.referente != null){&#xD;
		var foundRefOnField = false;&#xD;
		var j=0;&#xD;
		while (j&lt;localRequest.ordine.referente.size() &amp;&amp; !foundRefOnField)&#xD;
		{&#xD;
			if(localRequest.ordine.referente.get(j).tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTEONFIELD)&#xD;
			{&#xD;
				VerificaCodiceProgettoRequest.flag_ReferenteOnField = &quot;Y&quot;;&#xD;
				foundRefOnField = true;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
//SM_8550 fine.&#xD;
&#xD;
//RU_1317&#xD;
if(LavorazioneRichiesta == null)&#xD;
{&#xD;
	LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(VerificaCodiceProgettoResponse != null &amp;&amp; VerificaCodiceProgettoResponse.datiAccesso != null)&#xD;
{&#xD;
	OneStep = VerificaCodiceProgettoResponse.datiAccesso.oneStep;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
