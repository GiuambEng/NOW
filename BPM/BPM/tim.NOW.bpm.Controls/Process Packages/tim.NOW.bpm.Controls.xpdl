        </xpdl2:Activity>
        <xpdl2:Activity Id="_ZujGF_1FEeWEXoIZeVGhKA" Name="DataDa" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Data Da" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_WEaY0gSnEea_GtGlD07JSQ">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="false" Direction="IN" Formal="parameters">
                      <xpdl2:Actual ScriptGrammar="JavaScript">DataDaRequest</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageIn>
                <xpdl2:MessageOut Id="_WEaY0wSnEea_GtGlD07JSQ">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="false" Direction="OUT" Formal="parameters.esito">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_pVYpYAZLEeaX1ZATHwYxsQ" OperationName="Verifica_DAD_Per_Rimodulazione_DA">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckPortTypeSOAP" ServiceName="BPM_CheckPortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="BPM_CheckService_concrete_v.2.0.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="BPM_CheckPortType" OperationName="Verifica_DAD_Per_Rimodulazione_DA">
                  <xpdExt:ExternalReference location="BPM_CheckService_concrete_v.2.0.wsdl"/>
