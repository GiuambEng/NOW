        <xpdl2:Activity Id="_-oVioiPkEeaPieZ5iwuzWQ" Name="VerificaSommaBandediPicco" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Somma Bande di Picco" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_C8BlYiPlEeaPieZ5iwuzWQ">
