                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="parameters.idAssetNPCorrelata">
                      <xpdl2:Actual ScriptGrammar="JavaScript">IDAssetNP</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="parameters.idCausale">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDAnagraficaCausale</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_pVYpYAZLEeaX1ZATHwYxsQ" OperationName="Verifica_OL_in_Corso">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckPortTypeSOAP" ServiceName="BPM_CheckPortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="BPM_CheckService_concrete_v.2.0.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="BPM_CheckPortType" OperationName="Verifica_OL_in_Corso">
                  <xpdExt:ExternalReference location="BPM_CheckService_concrete_v.2.0.wsdl"/>
