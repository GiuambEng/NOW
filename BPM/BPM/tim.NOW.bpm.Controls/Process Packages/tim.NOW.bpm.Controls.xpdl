        <xpdl2:Activity Id="_r_GGYtF9EeqAGcayqwFHqA" Name="ValorizzazioneCareCos" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Valorizzazione Car e Cos" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var IdentificativoCOS = &quot;&quot;;&#xD;
IdentificativoCOS = null;&#xD;
var FamigliaVlan = &quot;&quot;;     //SM_9953&#xD;
FamigliaVlan = null;&#xD;
&#xD;
var foundIdentificativoCAR = false;&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
			{&#xD;
				IdentificativoCOS = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo IDENTIFICATIVOCOS &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
	{&#xD;
		for(var k=0; k&lt;componente.attributiDettaglioOrdine.size(); k++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCAR)&#xD;
			{&#xD;
				foundIdentificativoCAR = true;&#xD;
				Process.auditLog(&quot;Trovato attributo IDENTIFICATIVOCAR &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			//SM_9953&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
			{&#xD;
				FamigliaVlan = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo FAMIGLIAVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//SM_9953: modificate condizioni di scarto&#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA &#xD;
      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN)&#xD;
   &amp;&amp; (((IdentificativoCOS == &quot;0&quot; || IdentificativoCOS == &quot;1&quot;) &amp;&amp; FamigliaVlan == &quot;1&quot;)&#xD;
         || FamigliaVlan == &quot;2&quot; || FamigliaVlan == &quot;3&quot;)&#xD;
   &amp;&amp; !foundIdentificativoCAR)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE CAR E COS NON SUPERATO, KO_01&quot;;&#xD;
	esitoControllo = &quot;KO_01&quot;;&#xD;
}&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
        &amp;&amp; ((IdentificativoCOS == &quot;3&quot; || IdentificativoCOS == &quot;5&quot;) &amp;&amp; FamigliaVlan == &quot;1&quot;)&#xD;
		&amp;&amp; foundIdentificativoCAR)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE CAR E COS NON SUPERATO, KO_02&quot;;&#xD;
	esitoControllo = &quot;KO_02&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VALORIZZAZIONE CAR E COS SUPERATO&quot;;&#xD;
}&#xD;
&#xD;
</xpdl2:Script>
