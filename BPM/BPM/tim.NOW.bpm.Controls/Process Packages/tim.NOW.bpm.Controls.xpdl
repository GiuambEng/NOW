    <xpdl2:WorkflowProcess Id="_yMSmsBdoEeqiOYbRIgBdnA" xpdExt:XpdModelType="ServiceProcess" xpdExt:DisplayName="CTRL VERIFICA COMPATIBILITA TIPOLINEA CPS_C04M01F229" Name="CTRLVERIFICACOMPATIBILITATIPOLINEACPS_C04M01F229">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_kdthYBdpEeqiOYbRIgBdnA" xpdExt:DisplayName="ProcessIdentifier" Name="ProcessIdentifier" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>500</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_IZZsoBdqEeqiOYbRIgBdnA" xpdExt:DisplayName="esitoControllo" Name="esitoControllo" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
      </xpdl2:DataFields>
