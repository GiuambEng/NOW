        <xpdl2:Activity Id="_M9nAgWkgEeqw4792xkM2Ug" Name="VerificacompatibilitaTokenAppuntamento" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica compatibilita Token Appuntamento">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo superato&quot;;&#xD;
&#xD;
var tokenAppuntamento = &quot;&quot;;&#xD;
tokenAppuntamento = null;&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
while(tokenAppuntamento == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{	&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var h=0; h&lt;componente.attributiDettaglioOrdine.size(); h++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(h);&#xD;
				&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TOKENAPPUNTAMENTO)&#xD;
			{&#xD;
				tokenAppuntamento = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(tokenAppuntamento != null &amp;&amp; localRequest.codiceProgetto != null &amp;&amp; localRequest.rendezVous == 'S')&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Controllo fallito, tokenAppuntamento &quot;+tokenAppuntamento+&quot;, codiceProgetto &quot;+localRequest.codiceProgetto+&quot;, rendezVous &quot;+localRequest.rendezVous;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
