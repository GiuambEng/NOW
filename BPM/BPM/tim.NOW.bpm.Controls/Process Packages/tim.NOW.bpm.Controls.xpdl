        <xpdl2:Activity Id="_EGHNcWV6EeeFLuxKJU-nxw" Name="PrecondizioneFallita" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione Fallita">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL OCCUPAZIONE BANDA VP saltato per precondizione: nessuna TIPOBANDACONSEGNA CONDIVISA trovata&quot;;&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_zgvOkjL3EeajbIG7R_HFFQ" Width="227.0">
              <xpdl2:Coordinates XCoordinate="524.0" YCoordinate="77.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_2NHn4mV6EeeFLuxKJU-nxw" Name="Precondizione" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = true;&#xD;
&#xD;
&#xD;
&#xD;
if(localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT &amp;&amp;&#xD;
	localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT	)&#xD;
{&#xD;
	EseguiControllo=false;&#xD;
}&#xD;
&#xD;
if (EseguiControllo)&#xD;
{&#xD;
	var foundTipoBanda = false;&#xD;
	var foundTipoBandaCondivisa = false;&#xD;
	var i = 0;&#xD;
	&#xD;
	//While none TIPOBANDACONSEGNA equal to CONDIVISA keep to loop&#xD;
	while(!foundTipoBandaCondivisa &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		foundTipoBanda = false;&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(!foundTipoBanda &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDACONSEGNA)&#xD;
				{&#xD;
					foundTipoBanda = true;&#xD;
					&#xD;
					if(currentAttDettOrdine.valoreAttributo == &quot;CONDIVISA&quot;)&#xD;
					{&#xD;
						//Found TIPOBANDACONSEGNA CONDIVISA&#xD;
						foundTipoBandaCondivisa = true;&#xD;
					}&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(!foundTipoBandaCondivisa)&#xD;
	{&#xD;
	EseguiControllo = false;&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
