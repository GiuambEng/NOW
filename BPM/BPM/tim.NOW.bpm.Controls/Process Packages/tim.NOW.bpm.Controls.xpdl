        <xpdl2:Activity Id="_VJB1oN6uEem0hr5bIYAhAw" Name="VerificaTagUnicaC" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Tag UnicaC">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
if(InventoryOutput == null &#xD;
|| InventoryOutput.datiUnica == null)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DATI UNICA_C04M01F224: CTRL saltato, Inventory non chiamato&quot;;&#xD;
}&#xD;
else if(InventoryOutput.datiUnica.tipoNumero != null &#xD;
	 &amp;&amp; InventoryOutput.datiUnica.tipoServizio != null)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DATI UNICA_C04M01F224: CTRL OK, tipo Numero e tipo Servizio da UNICA valorizzati&quot;;&#xD;
}&#xD;
else if(InventoryOutput.datiUnica.tipoNumero == null)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DATI UNICA_C04M01F224: CTRL KO, tipoNumero da UNICA non valorizzato&quot;;&#xD;
}&#xD;
else if(InventoryOutput.datiUnica.tipoServizio == null)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DATI UNICA_C04M01F224: CTRL KO, tipoServizio da UNICA non valorizzato&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
