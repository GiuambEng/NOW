      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_N8B_o9CyEeqB68NXOld2rQ" Name="EndEvent" xpdExt:DisplayName="End Event">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_N8B_odCyEeqB68NXOld2rQ" Width="30.0">
              <xpdl2:Coordinates XCoordinate="592.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_V9IvUtCyEeqB68NXOld2rQ" Name="ValorizzazioneFamigliaVlaneTipoVlan" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Valorizzazione FamigliaVlan e TipoVlan">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var FamigliaVlan = &quot;&quot;;&#xD;
var TipoVlan = &quot;&quot;;&#xD;
&#xD;
FamigliaVlan = null;&#xD;
TipoVlan = null;&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
			{&#xD;
				FamigliaVlan = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo FAMIGLIAVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOVLAN)&#xD;
			{&#xD;
				TipoVlan = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo TIPOVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
//SM_9755: stravolta logica del controllo&#xD;
//Se FamigliaVlan = 3: OK per TipoVlan = 2, altrimenti KO.&#xD;
//Se FamigliaVlan non è 3, sempre OK.&#xD;
&#xD;
if(FamigliaVlan == &quot;3&quot; &amp;&amp; TipoVlan != &quot;2&quot;)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA VALORIZZAZIONE FAMIGLIAVLAN E TIPOVLAN NON SUPERATO&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA VALORIZZAZIONE FAMIGLIAVLAN E TIPOVLAN SUPERATO&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
