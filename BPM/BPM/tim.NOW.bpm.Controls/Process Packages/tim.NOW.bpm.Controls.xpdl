            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_acDnkVJQEeafMOVsQ226Vw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_RY6zIFJQEeafMOVsQ226Vw" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_USh5YjLnEeajbIG7R_HFFQ" Width="58.0">
