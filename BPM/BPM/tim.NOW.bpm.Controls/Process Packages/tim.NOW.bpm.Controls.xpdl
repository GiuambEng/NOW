        <xpdl2:DataField Id="_n9_EsOhjEeqS29u_gtG95g" xpdExt:DisplayName="AssetRef" Name="AssetRef" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
              </xpdl2:Member>
