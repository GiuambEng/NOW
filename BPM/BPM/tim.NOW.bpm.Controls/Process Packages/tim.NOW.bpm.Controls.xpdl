          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">/*ConsistenzaDati != null &amp;&amp;&#xD;
((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
	&amp;&amp; (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC&#xD;
	 || localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC))&#xD;
|| (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
 &amp;&amp; String(ConsistenzaDati.azione) == &quot;D&quot;&#xD;
 &amp;&amp; (localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FWA&#xD;
  || localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
  || localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL))&#xD;
|| (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
 &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA&#xD;
 &amp;&amp; String(ConsistenzaDati.azione) == &quot;D&quot;));*/&#xD;
 false; //RU_1263 - deve sempre saltare il controllo, non sono state eliminate le chiamate, verranno eliminate col prossimo kit&#xD;
 &#xD;
</xpdl2:Expression></xpdl2:Condition>
