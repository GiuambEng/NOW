        <xpdl2:Activity Id="_oO09IgX2Ee6dJ_gq6BcMpw" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">eseguiControllo = false;&#xD;
&#xD;
if(CTRLC04M01F400 == &quot;CTRL VERIFICA SERVIZI OPZIONALI precondizione fallita&quot;)&#xD;
{&#xD;
	Process.auditLog('Precondizione fallita per controllo C04M01F400 non effettuato');&#xD;
}&#xD;
else if(localRequest !=null &amp;&amp; localRequest.ordine !=null)&#xD;
{&#xD;
	var offertaNaked = false;&#xD;
&#xD;
	for(var i=0;i&lt;localRequest.ordine.dettaglioordine.size();i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA&#xD;
				   &amp;&amp; String(attributo.valoreAttributo).toUpperCase() == &quot;LINEANONFONIA&quot;)&#xD;
				{&#xD;
					offertaNaked = true;&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
	&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
		&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA))&#xD;
	{&#xD;
		eseguiControllo = true;		&#xD;
	}&#xD;
		&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
			&amp;&amp; (String(localRequest.offerta).slice(0,3) == &quot;ULL&quot; || String(localRequest.offerta).slice(0,3) == &quot;SLU&quot;))&#xD;
	{&#xD;
		eseguiControllo = true;&#xD;
	}&#xD;
	&#xD;
	else if((localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO&#xD;
			|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274&#xD;
			|| localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)                               //Task #34087: aggiunta ATTIVAZIONE qui invece dell'else if a parte (sono le stesse casistiche della MIGRAZIONE)&#xD;
		&amp;&amp; (localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
			|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA)&#xD;
		&amp;&amp; !(String(localRequest.offerta).length>15 &amp;&amp; String(localRequest.offerta).slice(12,16) == &quot;SIMM&quot;) &#xD;
		&amp;&amp; offertaNaked)&#xD;
	{&#xD;
		eseguiControllo = true; &#xD;
	}	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
