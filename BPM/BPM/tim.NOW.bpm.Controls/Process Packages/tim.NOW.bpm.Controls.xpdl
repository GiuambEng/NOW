              <xpdExt:Information ScriptGrammar="JavaScript">VerificaUnivocitaPrimoFeederRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaUnivocitaPrimoFeeder_RequestType();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	VerificaUnivocitaPrimoFeederRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	VerificaUnivocitaPrimoFeederRequest.lavorazione = String(localRequest.lavorazione);&#xD;
	VerificaUnivocitaPrimoFeederRequest.offerta = String(localRequest.offerta);&#xD;
	VerificaUnivocitaPrimoFeederRequest.codificaOloAgcom = localRequest.codificaOLOAGCOM;   //SM_10223&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
