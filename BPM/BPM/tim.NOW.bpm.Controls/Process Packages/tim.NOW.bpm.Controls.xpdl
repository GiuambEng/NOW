	&quot;ordine.codiceOrdineTI=:codiceOrdineTITarget and codificaOLOAGCOM=:codificaOLOAGCOM&quot;);&#xD;
&#xD;
	criteria.setQueryParameter(&quot;codiceOrdineTITarget&quot;,localRequest.codiceOrdineTITarget);&#xD;
	criteria.setQueryParameter(&quot;codificaOLOAGCOM&quot;,localRequest.codificaOLOAGCOM);&#xD;
&#xD;
	RichiestaRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
	if(!(RichiestaRef.isEmpty()))&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI OLO Successful&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL CODICE ORDINE TI OLO Failed : No record found.&quot;;&#xD;
