    <xpdl2:WorkflowProcess Id="_w3mP0P1GEeWEXoIZeVGhKA" xpdExt:XpdModelType="ServiceProcess" xpdExt:DisplayName="CTRL DATA INVIO" Name="CTRLDATAINVIO">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_8aBtwQLDEeaCSadujWKAsg" xpdExt:DisplayName="DataInvioRequest" Name="DataInvioRequest">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="com.tim.NOW.xsd.ControlliAmmessi.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.ControlliAmmessiVerifica_Data_Invio_Request"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_P6z48Qb6EeaaXcIacC0_2w" xpdExt:DisplayName="FlagInput" Name="FlagInput">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="BOOLEAN"/>
          </xpdl2:DataType>
          <xpdExt:InitialValues>
            <xpdExt:Value>false</xpdExt:Value>
          </xpdExt:InitialValues>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_w32ugf1GEeWEXoIZeVGhKA" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="52.0" LaneId="_w3m24P1GEeWEXoIZeVGhKA" Width="31.0">
              <xpdl2:Coordinates XCoordinate="674.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_w32ugv1GEeWEXoIZeVGhKA" Name="InitializeDataInvioRequest" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Initialize DataInvio Request">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
if (!(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp;&#xD;
	localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG))&#xD;
{ &#xD;
	DataInvioRequest = com_tim_NOW_xsd_ControlliAmmessi_Factory.createVerifica_Data_Invio_Request();&#xD;
	targetRequest = TargetRequestRef.readRichiesta();&#xD;
	&#xD;
	//RU_1346&#xD;
	DataInvioRequest.flagDelibera103 = localRequest.flagDelibera103;&#xD;
	DataInvioRequest.codificaOLOAGCOMDonor = localRequest.codificaOLOAGCOMDonor;&#xD;
	DataInvioRequest.tmpAck_NpDel103 = localRequest.tmpAckNpD103;&#xD;
	DataInvioRequest.sottolav_Ordine_di_Riferimento = String(targetRequest.tipologiaSottolav);	&#xD;
	&#xD;
	//DAC&#xD;
	DataInvioRequest.IDRichiesta = localRequest.IDRichiestaOLO;&#xD;
	&#xD;
	if(targetRequest.ordine != null &amp;&amp; targetRequest.ordine.DAC != null) //Bug #43706: aggiunta condizione targetRequest.ordine.DAC != null&#xD;
	{&#xD;
		DataInvioRequest.DAC = targetRequest.ordine.DAC;&#xD;
	}&#xD;
	//Bug #43706: per DEL 103 se la target è in PERVENUTO, mappa dalla DAC della richiesta (nel momento in cui arriva la richiesta di Annullamento, l’ordine non è stato ancora inserito nella BDS_1_CASEDATA_ORDINE) &#xD;
	else if(localRequest.flagDelibera103 == &quot;Y&quot; &amp;&amp; targetRequest.DAC != null)&#xD;
	{&#xD;
		DataInvioRequest.DAC = targetRequest.DAC;	&#xD;
	}&#xD;
	&#xD;
	//DAC RIMODULATA&#xD;
	if(targetRequest.ordine != null &amp;&amp; targetRequest.ordine.DACRimodulata != null)&#xD;
	{&#xD;
		DataInvioRequest.DACRimodulata = targetRequest.ordine.DACRimodulata;&#xD;
	}&#xD;
	&#xD;
	//NUOVA DAC PER RU_712&#xD;
	if (localRequest.DAC != null){&#xD;
		DataInvioRequest.nuovaDAC = localRequest.DAC;&#xD;
	}	&#xD;
	&#xD;
	//SM_10816: confronta DADRimodulata e DATAAPPUNTAMENTO di DTUAPPUNTAMENTO e prendi la maggiore&#xD;
	var maxData = &quot;&quot;;&#xD;
	maxData = null;&#xD;
	&#xD;
	if(targetRequest.ordine != null &amp;&amp; targetRequest.ordine.DADRimodulata != null)&#xD;
	{&#xD;
		maxData = targetRequest.ordine.DADRimodulata;&#xD;
	}&#xD;
		&#xD;
	if(targetRequest.ordine != null &amp;&amp; targetRequest.ordine.dettaglioordine != null)&#xD;
	{&#xD;
		var i = 0;&#xD;
		var foundData = false;&#xD;
		//var foundDataOF = false;&#xD;
		&#xD;
		while((!foundData) &amp;&amp; i &lt; targetRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = targetRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAPPUNTAMENTO)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(!foundData &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAAPPUNTAMENTO)&#xD;
					{					&#xD;
						foundData = true;&#xD;
						if (maxData == null || DateTimeUtil.createDate(currentAttDettOrdine.valoreAttributo) > maxData)&#xD;
						{&#xD;
							maxData = DateTimeUtil.createDate(currentAttDettOrdine.valoreAttributo);&#xD;
						}					&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
				foundData = true; //Set a true per farlo uscire dal primo while&#xD;
			}&#xD;
			&#xD;
			//SM_11270: non controlliamo più OFRDAC&#xD;
			/*else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OFRDAC)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(!foundDataOF &amp;&amp; j&lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAPREVISTAATTIVAZIONE)&#xD;
					{&#xD;
						foundDataOF = true;&#xD;
						if (maxData == null || DateTimeUtil.createDate(currentAttDettOrdine.valoreAttributo) > maxData)&#xD;
						{&#xD;
							maxData = DateTimeUtil.createDate(currentAttDettOrdine.valoreAttributo);&#xD;
						}&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
				foundDataOF = true;&#xD;
			}*/&#xD;
			&#xD;
			i++;&#xD;
		}	&#xD;
	}&#xD;
	&#xD;
	//SM_10853&#xD;
	if(maxData != null)&#xD;
	{&#xD;
		DataInvioRequest.DAD = DateTimeUtil.createDate(maxData);&#xD;
	}&#xD;
	else if(targetRequest.ordine != null &amp;&amp; targetRequest.ordine.DAD != null)&#xD;
	{&#xD;
		DataInvioRequest.DAD = targetRequest.ordine.DAD;&#xD;
	}&#xD;
	//SM_11270 - se continua a non essere valorizzata&#xD;
	else if(targetRequest.ordine != null &amp;&amp; targetRequest.ordine.dettaglioordine != null)&#xD;
	{&#xD;
		var i=0;&#xD;
		var foundDataDisag = false;&#xD;
		&#xD;
		while(!foundDataDisag &amp;&amp; i&lt;targetRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = targetRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTODISAGGREGAZIONE&#xD;
			   ||currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTOGESTIONEAUTONOMA)&#xD;
			{&#xD;
				var j=0;&#xD;
				while(!foundDataDisag &amp;&amp; j&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAAPPUNTAMENTO)&#xD;
					{			&#xD;
						var giorno = currentAttDettOrdine.valoreAttributo.slice(0,2);&#xD;
						var mese = currentAttDettOrdine.valoreAttributo.slice(3,5);&#xD;
						var anno = currentAttDettOrdine.valoreAttributo.slice(6,10);&#xD;
						&#xD;
						DataInvioRequest.DAD = DateTimeUtil.createDate(anno+&quot;-&quot;+mese+&quot;-&quot;+giorno);		&#xD;
						&#xD;
						foundDataDisag = true;						&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
				foundDataDisag = true; &#xD;
			}&#xD;
			i++;&#xD;
		}	&#xD;
	}		&#xD;
		&#xD;
	//NB: LA DATA APPUNTAMENTO NON VIENE MAPPATA in quanto BPM integration ha mantenuto tutta la logica direttamente sulla DAD:&#xD;
	// qualora si presentassero anomalie occorre mappare anche la Data Appuntamento&#xD;
	&#xD;
	//SM_9179: DRO dalla richiesta target e non dalla richiesta di annullamento&#xD;
	DataInvioRequest.DRO = targetRequest.DRO;&#xD;
	//--------&#xD;
	&#xD;
	DataInvioRequest.data_Invio_Richiesta = localRequest.dataInvioRichiesta;&#xD;
	&#xD;
	DataInvioRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
	&#xD;
	DataInvioRequest.lavorazione_Ordine_di_Riferimento = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(targetRequest.lavorazione));&#xD;
	&#xD;
	DataInvioRequest.strutturaRichiesta = it_telecomitalia_it_NOW_casedata_v1_TipoStrutturaRichiestaEnumeration.get(String(localRequest.strutturaRichiesta));&#xD;
	DataInvioRequest.codiceOrdineTI = localRequest.codiceOrdineTI;&#xD;
	DataInvioRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
	&#xD;
	//SM_8310 target invece di local&#xD;
	if(targetRequest.ordine != null &amp;&amp; targetRequest.ordine.LNA_LA!= null){&#xD;
		DataInvioRequest.LNA_LA = it_telecomitalia_it_NOW_casedata_v1_LNA_LAEnumeration.get(String(targetRequest.ordine.LNA_LA));&#xD;
	}&#xD;
	&#xD;
	if(localRequest.statoRichiestaOLO != null)&#xD;
	{&#xD;
		DataInvioRequest.statoRichiestaOLO = String(localRequest.statoRichiestaOLO);&#xD;
	}&#xD;
	&#xD;
	if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG)&#xD;
	{&#xD;
		if(targetRequest.tipologiaScenario != null)&#xD;
		{&#xD;
			DataInvioRequest.tipologiaScenario = it_telecomitalia_it_NOW_casedata_v1_TipologiaScenarioEnumeration.get(String(targetRequest.tipologiaScenario));&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(targetRequest!= null)&#xD;
	{&#xD;
		DataInvioRequest.IDRichiestaTarget = targetRequest.IDRichiestaOLO;&#xD;
		DataInvioRequest.statoRichiestaOLO = String(targetRequest.statoRichiestaOLO);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;targetRequest null&quot;);&#xD;
	}&#xD;
	&#xD;
	if(DataInvioRequest.DRO!=null &amp;&amp; DataInvioRequest.data_Invio_Richiesta!=null &#xD;
		&amp;&amp; DataInvioRequest.lavorazione!=null &amp;&amp; DataInvioRequest.lavorazione_Ordine_di_Riferimento!=null)&#xD;
	{&#xD;
		FlagInput = true;&#xD;
	}&#xD;
	else if((DataInvioRequest.lavorazione_Ordine_di_Riferimento == it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.CESSAZIONE ||DataInvioRequest.lavorazione_Ordine_di_Riferimento == it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
			&amp;&amp; DataInvioRequest.DRO!=null &#xD;
			&amp;&amp; DataInvioRequest.data_Invio_Richiesta!=null 	&amp;&amp; DataInvioRequest.lavorazione!=null &#xD;
			&amp;&amp; DataInvioRequest.lavorazione_Ordine_di_Riferimento!=null) &#xD;
	{&#xD;
		FlagInput = true;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		&#xD;
		Process.auditLog(&quot;DataInvioRequest: DAC:&quot;+String(DataInvioRequest.DAC)+&quot;-DACRimodulata:&quot;+String(DataInvioRequest.DACRimodulata)+&quot;-DAD:&quot;+String(DataInvioRequest.DAD)+&quot;-DRO:&quot;+String(DataInvioRequest.DRO)+&quot;-data_Invio_Richiesta:&quot;+String(DataInvioRequest.data_Invio_Richiesta)+&quot;lavorazione_Ordine_di_Riferimento:&quot;+String(DataInvioRequest.lavorazione_Ordine_di_Riferimento));&#xD;
		Process.auditLog(&quot;Richiesta: DAC:&quot;+String(targetRequest.ordine.DAC)+&quot;-DACRimodulata:&quot;+String(targetRequest.ordine.DACRimodulata)+&quot;-DAD:&quot;+String(targetRequest.ordine.DADRimodulata)+&quot;-DAD&quot;+String(targetRequest.ordine.DAD)+&quot;-DRO:&quot;+String(localRequest.DRO)+&quot;-data_Invio_Richiesta:&quot;+String(localRequest.dataInvioRichiesta)+&quot;lavorazione_Ordine_di_Riferimento:&quot;+String(targetRequest.lavorazione));&#xD;
		FlagInput = false;&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL DATA INVIO Failed : Input request could not be formed&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Controllo skippato per precondizione Cessazione NP&quot;;&#xD;
	FlagInput= false;&#xD;
}</xpdl2:Script>
