              <xpdl2:Coordinates XCoordinate="516.0" YCoordinate="196.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_Sp3qQJq1Eea5QJFwYfra7A" Name="PrecondizioneFallita" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione Fallita">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog('Precondizione Fallita per controllo C04M01F39 – Verifica Univocità CVLAN_ID : KIT NON DEFINITO');&#xD;
&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = 'Controllo UNICITA CVLAN ID Skippato';</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_j_xswDOUEeah8rgiGeuHTg" Width="96.0">
              <xpdl2:Coordinates XCoordinate="668.0" YCoordinate="89.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_KdIqkWYiEee3XoB1szycYw" Name="PrecondizioneVariazione" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione Variazione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = true;&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	if (localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING &amp;&amp;&#xD;
		localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &amp;&amp;&#xD;
		localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN &amp;&amp;&#xD;
		localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC) //SM_8628&#xD;
		{&#xD;
			EseguiControllo = false;&#xD;
		}&#xD;
	&#xD;
	if (EseguiControllo)&#xD;
	{&#xD;
		var foundIncremento = false;&#xD;
		var variazioneTagged = false;&#xD;
		var foundDoubleTag = false;&#xD;
		var i=0;&#xD;
		&#xD;
		while((!foundDoubleTag || !variazioneTagged || !foundIncremento)  &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine= localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if ((currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN||&#xD;
				currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC) &amp;&amp; &#xD;
				currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
			{&#xD;
					foundIncremento=true;&#xD;
			}&#xD;
			&#xD;
			else if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for (var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttrDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION &amp;&amp;&#xD;
						currentAttrDettOrdine.valoreAttributo.toUpperCase() == &quot;DOUBLETAG&quot;)&#xD;
						{&#xD;
							foundDoubleTag=true;&#xD;
						}&#xD;
						&#xD;
					else if (currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING &amp;&amp;&#xD;
						currentAttrDettOrdine.valoreAttributo.toUpperCase() == &quot;TAGGED&quot;)&#xD;
						{&#xD;
							variazioneTagged=true;&#xD;
						}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
		 i++;&#xD;
		}&#xD;
		&#xD;
		if (&#xD;
			(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &amp;&amp; !foundIncremento)&#xD;
			||&#xD;
			(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING &amp;&amp; !variazioneTagged) &#xD;
			||&#xD;
			(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN &amp;&amp; !foundDoubleTag)&#xD;
		   )&#xD;
			&#xD;
			{&#xD;
				EseguiControllo = false;&#xD;
			}&#xD;
	&#xD;
	&#xD;
	}	&#xD;
}&#xD;
&#xD;
//SM_8628 - recupero in asset di USERVLANID, CVLANID, SVLANCODE e confronto con quelli nell'ordine per capire se sono variati&#xD;
if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
{&#xD;
	Process.auditLog(&quot;AssetID: &quot;+ConsistenzaDati.IDAsset);&#xD;
	var AssetID = parseInt(ConsistenzaDati.IDAsset,10);&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(AssetID);&#xD;
	var Asset = AssetRef.readAsset();&#xD;
&#xD;
	var UserVlanIDAsset = DataUtil.createList();&#xD;
	var CVlanIDAsset = DataUtil.createList();&#xD;
	var SVlanCodeAsset = DataUtil.createList();&#xD;
&#xD;
	// Creo Array con gli USERVLAN, CVLANID e SVLANCODE delle USERVLAN presenti in asset in stato ATTIVO o INLAVORAZIONE&#xD;
	for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var componenteAsset = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
		if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
		&amp;&amp; componenteAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO)&#xD;
		{&#xD;
			for(var j = 0; j &lt; componenteAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var attributoAsset = componenteAsset.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
				{&#xD;
					UserVlanIDAsset.add(attributoAsset.valoreAttributo);&#xD;
				}&#xD;
				else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
				{&#xD;
					CVlanIDAsset.add(attributoAsset.valoreAttributo);&#xD;
				}&#xD;
				else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
				{&#xD;
					SVlanCodeAsset.add(attributoAsset.valoreAttributo);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	var foundUserVlanID = false;&#xD;
	var foundCVlanID = false;&#xD;
	var foundSVlanCODE = false;&#xD;
&#xD;
	var UserVlanIDinASSET = false;&#xD;
	var CVlanIDinASSET = false;&#xD;
	var SVlanCODEinASSET = false;	&#xD;
	&#xD;
	var numUserVLANOrdine = 0;	&#xD;
	&#xD;
	// Ciclo sulle USERVLAN in ASSET&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componenteOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
		if(componenteOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			foundUserVlanID = false;&#xD;
			foundCVlanID = false;&#xD;
			foundSVlanCODE = false;&#xD;
			&#xD;
			UserVlanIDinASSET = false;&#xD;
			CVlanIDinASSET = false;&#xD;
			SVlanCODEinASSET = false;	&#xD;
			&#xD;
			for(var j = 0; j &lt; componenteOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributoOrdine =  componenteOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
				{&#xD;
					foundUserVlanID = true;&#xD;
					var k1 = 0;&#xD;
					&#xD;
					// Se trovo l'UserVlanID dell'ordine in Asset vuol dire che non è stato variato&#xD;
					while(!UserVlanIDinASSET &amp;&amp; k1 &lt; UserVlanIDAsset.size())&#xD;
					{&#xD;
						if(UserVlanIDAsset.get(k1) == attributoOrdine.valoreAttributo)&#xD;
						{&#xD;
							UserVlanIDinASSET = true;&#xD;
							Process.auditLog(&quot;Trovato UserVlanID asset &quot;+UserVlanIDAsset.get(k1)+&quot; nell'ordine, non variato&quot;);&#xD;
						}&#xD;
						&#xD;
						k1++;	&#xD;
					}&#xD;
				}&#xD;
				else if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
				{&#xD;
					foundCVlanID = true;&#xD;
					var k2 = 0;&#xD;
					&#xD;
					// Se trovo il CVlanID dell'ordine in Asset vuol dire che non è stato variato&#xD;
					while(!CVlanIDinASSET &amp;&amp; k2 &lt; CVlanIDAsset.size())&#xD;
					{&#xD;
						if(CVlanIDAsset.get(k2) == attributoOrdine.valoreAttributo)&#xD;
						{&#xD;
							CVlanIDinASSET = true;&#xD;
							Process.auditLog(&quot;Trovato CVlanID asset &quot;+CVlanIDAsset.get(k2)+&quot; nell'ordine, non variato&quot;);&#xD;
						}&#xD;
						&#xD;
						k2++;	&#xD;
					}&#xD;
				}&#xD;
				else if(attributoOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
				{&#xD;
					foundSVlanCODE = true;					&#xD;
					var k3 = 0;&#xD;
					&#xD;
					// Se trovo lo SVlanCODE dell'ordine in Asset vuol dire che non è stato variato&#xD;
					while(!SVlanCODEinASSET &amp;&amp; k3 &lt; SVlanCodeAsset.size())&#xD;
					{&#xD;
						if(SVlanCodeAsset.get(k3) == attributoOrdine.valoreAttributo)&#xD;
						{&#xD;
							SVlanCODEinASSET = true;&#xD;
							Process.auditLog(&quot;Trovato SVlanCODE asset &quot;+SVlanCodeAsset.get(k3)+&quot; nell'ordine, non variato&quot;);&#xD;
						}&#xD;
						&#xD;
						k3++;	&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
&#xD;
			// Se non è stato variato niente della VLAN in questione rispetto a quanto presente in consistenza aggiungere all'array per skippare la USERVLAN durante il controllo&#xD;
			if((!foundUserVlanID || UserVlanIDinASSET) &amp;&amp; (!foundCVlanID || CVlanIDinASSET) &amp;&amp; (!foundSVlanCODE || SVlanCODEinASSET))&#xD;
			{&#xD;
				idDettaglioUserVLAN_SKIP.add(componenteOrdine.IDDettaglioOrdine);&#xD;
				Process.auditLog(&quot;USERVLAN con ID DETTAGLIO ORDINE &quot;+componenteOrdine.IDDettaglioOrdine+&quot; da non considerare nel controllo, nessun parametro variato&quot;);&#xD;
			}&#xD;
			&#xD;
			numUserVLANOrdine++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	// Se tutte le USERVLAN dell'ordine sono da SKIPPARE (nessuna variazione dei tre parametri chiave), precondizione fallita&#xD;
	if(numUserVLANOrdine == idDettaglioUserVLAN_SKIP.size())&#xD;
	{&#xD;
		EseguiControllo = false;&#xD;
		Process.auditLog(&quot;Nessuna USERVLAN presente nell'ordine con parametri USERVLANID/CVLANID/SVLANCODE variati, controllo da skippare&quot;);&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
