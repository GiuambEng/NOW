          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = true;&#xD;
&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	var foundProfiloTecnicoLinea= false;&#xD;
	var i=0;&#xD;
	&#xD;
	while(!foundProfiloTecnicoLinea &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine= localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if (String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for (var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttrDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
				{&#xD;
					foundProfiloTecnicoLinea=true;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if (!foundProfiloTecnicoLinea)&#xD;
	{&#xD;
		EseguiControllo= false;&#xD;
	}	&#xD;
}&#xD;
//SM_9613&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
	 &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)&#xD;
{&#xD;
	EseguiControllo= false;&#xD;
}</xpdl2:Script>
