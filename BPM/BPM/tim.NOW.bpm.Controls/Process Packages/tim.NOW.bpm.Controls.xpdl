    <xpdl2:WorkflowProcess Id="_wxqnoCM9Eea7qJ_CMNwz5w" xpdExt:DisplayName="CTRL VAL VPI-VCI_C04M01F56" Name="CTRLVALVPIVCI_C04M01F56">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_Vhv6QFdKEee2jvYNBZCBIg" xpdExt:DisplayName="EseguiControllo" Name="EseguiControllo" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="BOOLEAN"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_wxtD5iM9Eea7qJ_CMNwz5w" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
