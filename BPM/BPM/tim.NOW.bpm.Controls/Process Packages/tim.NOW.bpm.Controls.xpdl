              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">RecuperaRequest = com_tim_NOW_xsd_ControlliAmmessi_Factory.createRecupero_Controlli_Request();&#xD;
RecuperaResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createRecupero_Controlli_Response();&#xD;
&#xD;
