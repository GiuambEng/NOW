          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_KIpMInCaEe2-RbmrOf2dJA" Name="ControlloVerificaNPAttiva" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Controllo Verifica NP Attiva">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Controllo fallito: NON esiste una consistenza NP in stato ATTIVO&quot;;//SM_11025: Corretto messaggio di log&#xD;
&#xD;
var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO','INLAVORAZIONE') AND offerta = 'NP'&quot;);&#xD;
c.setQueryParameter(&quot;idr&quot;, localRequest.numeroTelefonico);&#xD;
result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
&#xD;
if(result != null  &amp;&amp; result.size() > 0) &#xD;
{&#xD;
	&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Controllo passato: esiste una consistenza NP in stato ATTIVO con IdRisorsa=DN&quot;;//SM_11025&#xD;
	&#xD;
}&#xD;
else{&#xD;
	&#xD;
	//SM_11025: aggiunta logica di ricerca anche su attributi CAPOSERIE e RADICALE&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;dettaglioasset.nomeComponente = 'NUMBERPORTABILITY' AND dettaglioasset.attributidettaglioasset.nomeAttributo IN ('RADICALE','CAPOSERIE') AND dettaglioasset.attributidettaglioasset.valoreAttributo=:DN AND statoAsset IN ('ATTIVO','INLAVORAZIONE') AND offerta = 'NP'&quot;);&#xD;
	criteria.setQueryParameter(&quot;DN&quot;, localRequest.numeroTelefonico);&#xD;
	result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
	&#xD;
	if(result != null  &amp;&amp; result.size() > 0)//SM_11025	 &#xD;
	{&#xD;
		&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Controllo passato: esiste una consistenza NP in stato ATTIVO con CAPOSERIE/RADICALE=DN&quot;;//SM_11025&#xD;
		&#xD;
	}&#xD;
	&#xD;
} &#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="98.0" LaneId="_xv6GsXCZEe2-RbmrOf2dJA" Width="135.0">
