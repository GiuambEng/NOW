    <xpdl2:WorkflowProcess Id="_zgvOkDL3EeajbIG7R_HFFQ" xpdExt:DisplayName="CTRL OCCUPAZIONE BANDA VP_C04M01F67" Name="CTRLOCCUPAZIONEBANDAVP_C04M01F67">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_TTfR4DMhEeajbIG7R_HFFQ" xpdExt:DisplayName="VPCode" Name="VPCode" IsArray="true">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_UYUL8DMhEeajbIG7R_HFFQ" xpdExt:DisplayName="SumMCRDown" Name="SumMCRDown" IsArray="true">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="INTEGER">
              <xpdl2:Precision>9</xpdl2:Precision>
            </xpdl2:BasicType>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_2NHn42V6EeeFLuxKJU-nxw" xpdExt:DisplayName="EseguiControllo" Name="EseguiControllo" ReadOnly="false">
          <xpdl2:DataType>
