        </xpdl2:Activity>
        <xpdl2:Activity Id="_wxtD5yM9Eea7qJ_CMNwz5w" Name="VerificaValorizzazioneVPIVCI" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Valorizzazione VPI-VCI" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var foundVCI = false;&#xD;
var foundVPI = false;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if((currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC) &amp;&amp; currentDettaglioOrdine.attributiDettaglioOrdine != null)&#xD;
		{&#xD;
			foundVCI = false;&#xD;
			foundVPI = false;&#xD;
			var j = 0;&#xD;
			while((!foundVCI || !foundVPI) &amp;&amp; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
				{&#xD;
					//Trovato VCI&#xD;
					foundVCI = true;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
				{&#xD;
					//Trovato VPI&#xD;
					foundVPI = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(!foundVCI || !foundVPI)&#xD;
			{&#xD;
				//VCI o VPI non trovato&#xD;
				break;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if (&#xD;
			(!foundVCI &amp;&amp; !foundVPI) &amp;&amp; &#xD;
			(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE 	&amp;&amp;&#xD;
			(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT ||&#xD;
			localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE ||&#xD;
			localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL	||&#xD;
			localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT ||&#xD;
			localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT			||&#xD;
			localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE			||&#xD;
			localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT	||&#xD;
			localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE	))&#xD;
		)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VAL VPI-VCI precondizione fallita&quot;;&#xD;
	}&#xD;
		&#xD;
	else if(!foundVCI || !foundVPI)&#xD;
	{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;VCI o VPI mancante&quot;;	&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;VCI e VPI entrambi valorizzati&quot;;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
