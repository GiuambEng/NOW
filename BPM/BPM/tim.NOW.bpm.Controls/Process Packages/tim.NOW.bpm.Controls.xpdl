                  <xpdExt:InputMappings MapperContext="InputToService" MappingDirection="IN">
                    <xpdExt:DataMappings>
                      <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="InputToService.DataMapperContent" Direction="IN" Formal="input">
                        <xpdl2:Actual ScriptGrammar="JavaScript">VerificaServiziOpzionaliRequest</xpdl2:Actual>
                      </xpdExt:DataMapping>
                    </xpdExt:DataMappings>
                  </xpdExt:InputMappings>
                </xpdl2:MessageIn>
                <xpdl2:MessageOut Id="_sbUKQX8pEeq4_8uLvbUAQA">
                  <xpdExt:OutputMappings MapperContext="OutputFromService" MappingDirection="OUT">
                    <xpdExt:DataMappings>
                      <xpdExt:DataMapping xpdExt:SourceContributorId="OutputFromService.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="EsitoResponse.codice">
                        <xpdl2:Actual ScriptGrammar="JavaScript">output.esito.codice</xpdl2:Actual>
                      </xpdExt:DataMapping>
                      <xpdExt:DataMapping xpdExt:SourceContributorId="OutputFromService.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="EsitoResponse.descrizione">
                        <xpdl2:Actual ScriptGrammar="JavaScript">output.esito.descrizione</xpdl2:Actual>
                      </xpdExt:DataMapping>
                      <xpdExt:DataMapping xpdExt:SourceContributorId="OutputFromService.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="ServiziOpzionaliOutput">
                        <xpdl2:Actual ScriptGrammar="JavaScript">output.serviziOpzionali</xpdl2:Actual>
                      </xpdExt:DataMapping>
                    </xpdExt:DataMappings>
                  </xpdExt:OutputMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_YoQtQBO0EeekW5j-cV6_qA" OperationName="VerificaServiziOpzionali">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckServiceFormaliPortTypeSOAP" ServiceName="BPM_CheckServiceFormaliPortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="BPM_CheckServiceFormali_v1.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="BPM_CheckServiceFormaliPortType" OperationName="VerificaServiziOpzionali">
                  <xpdExt:ExternalReference location="BPM_CheckServiceFormali_v1.wsdl"/>
                </xpdExt:PortTypeOperation>
              </xpdl2:TaskService>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:Performers>
            <xpdl2:Performer>_YoQtQBO0EeekW5j-cV6_qA</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="88.0" LaneId="_T-BxcX8oEeq4_8uLvbUAQA" Width="133.0">
              <xpdl2:Coordinates XCoordinate="692.0" YCoordinate="157.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaServiziOpzionaliRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaServiziOpzionali_RequestType();&#xD;
&#xD;
VerificaServiziOpzionaliRequest.idRichiesta = localRequest.IDRichiestaOLO;&#xD;
VerificaServiziOpzionaliRequest.offerta = String(localRequest.offerta);&#xD;
VerificaServiziOpzionaliRequest.codificaOloAgcom = localRequest.codificaOLOAGCOM;&#xD;
VerificaServiziOpzionaliRequest.DRO = localRequest.DRO; //Bug #44737&#xD;
&#xD;
if(LavorazioneRichiesta.areaDiCantiere != null)&#xD;
{&#xD;
	VerificaServiziOpzionaliRequest.areaDiCantiere = LavorazioneRichiesta.areaDiCantiere;&#xD;
}&#xD;
&#xD;
//RU_1485&#xD;
if(LavorazioneRichiesta.prodottoCatalogo != null)&#xD;
{&#xD;
	VerificaServiziOpzionaliRequest.prodottoCatalogo = LavorazioneRichiesta.prodottoCatalogo;&#xD;
}&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
	{&#xD;
		var servizio = com_tim_NOW_xsd_ControlliFormali_Factory.createServiziOpzionali_type();&#xD;
		&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO)&#xD;
			{&#xD;
				servizio.codiceServizio = attributo.valoreAttributo;&#xD;
				servizio.idDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			}&#xD;
		}&#xD;
		VerificaServiziOpzionaliRequest.serviziOpzionali.add(ScriptUtil.copy(servizio));&#xD;
	}&#xD;
}&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
