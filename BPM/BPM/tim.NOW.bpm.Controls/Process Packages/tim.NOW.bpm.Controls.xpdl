        <xpdl2:Activity Id="_0Ih7YHqVEeaS5t7kNsZoLA" Name="SetInputAttMig" xpdExt:Visibility="Private" xpdExt:DisplayName="Set Input Att Mig">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">preCondition = true;&#xD;
&#xD;
input = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaCoppiaBandaPiccoRequestType();&#xD;
input.profiloTecnicoLinea=&quot;&quot;;&#xD;
&#xD;
input.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
input.lavorazione = String(localRequest.lavorazione);&#xD;
input.sottoLavorazione = String(localRequest.ordine.tipologiaSottolav);&#xD;
&#xD;
var profiloTecnicoLineaTrovato = false;&#xD;
var profiloTecnicoLinea=&quot;&quot;;&#xD;
if(localRequest.ordine!=null){&#xD;
	&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
			var k=0;&#xD;
			while(!profiloTecnicoLineaTrovato &amp;&amp; k&lt;componente.attributiDettaglioOrdine.size()){&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA){&#xD;
					profiloTecnicoLineaTrovato= true;&#xD;
					profiloTecnicoLinea = attributo.valoreAttributo;&#xD;
				}&#xD;
				k++;&#xD;
			}&#xD;
		&#xD;
		}&#xD;
		&#xD;
		if(componente.nomeComponente==it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
			var bandaPiccoDownTrovato = false;&#xD;
			var bandaPiccoUpTrovato = false;&#xD;
			var bandaPiccoDown = &quot;0&quot;;&#xD;
			var bandaPiccoUp = &quot;0&quot;;&#xD;
			var j=0;&#xD;
			while((!bandaPiccoDownTrovato||!bandaPiccoUpTrovato)&amp;&amp;j&lt;componente.attributiDettaglioOrdine.size()){&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN){&#xD;
					&#xD;
						bandaPiccoDownTrovato=true;&#xD;
						bandaPiccoDown = attributo.valoreAttributo;&#xD;
					&#xD;
				}&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP){&#xD;
					&#xD;
						bandaPiccoUpTrovato=true;&#xD;
						bandaPiccoUp=attributo.valoreAttributo;&#xD;
					&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(bandaPiccoDownTrovato &amp;&amp; bandaPiccoUpTrovato &amp;&amp; profiloTecnicoLineaTrovato){&#xD;
				input.profiloTecnicoLinea = profiloTecnicoLinea;&#xD;
				var temp = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createUserVlan_CoppiaBandaPicco();&#xD;
				temp.bandaPiccoDown = bandaPiccoDown;&#xD;
				temp.bandaPiccoUp =bandaPiccoUp;&#xD;
				&#xD;
				input.userVlan.add(ScriptUtil.copy(temp));&#xD;
			}&#xD;
			else{&#xD;
				Process.auditLog(&quot;Warning sul recupero degli elemeni Banda Picco la UserVlan: &quot;+componente.IDDettaglioOrdine+&quot; bandaPiccoDownTrovato= &quot;+bandaPiccoDownTrovato+&quot; bandaPiccoUpTrovato=&quot;+bandaPiccoUpTrovato+ &quot; profiloTecnicoLineaTrovato=&quot;+profiloTecnicoLineaTrovato);&#xD;
			}&#xD;
			&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="70.0" LaneId="_h-_SEXmjEeaoH8j59Le6HA" Width="130.0">
              <xpdl2:Coordinates XCoordinate="653.0" YCoordinate="255.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
