             }&#xD;
       }&#xD;
       if(status1!=1)&#xD;
       {&#xD;
             check = 1;&#xD;
       }&#xD;
}&#xD;
&#xD;
if(check==1)&#xD;
{&#xD;
       EsitoResponse.codice = false;&#xD;
       EsitoResponse.descrizione = &quot;CTRL DESTINAZIONE USO Failed : Specified values of valoreAttributo for nomeAttributo=BITRATE or valoreAttributo for nomeAttributo=DESTINAZIONEUSO are incorrect&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
       EsitoResponse.codice = true;&#xD;
