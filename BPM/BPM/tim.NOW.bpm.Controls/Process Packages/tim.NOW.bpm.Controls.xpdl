        <xpdl2:Activity Id="_4roEgtJbEeqhn730Y0mNjw" Name="ValorizzazioneCC_LIBperCos3Cos5" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Valorizzazione CC_LIB per Cos 3 Cos 5" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL VERIFICA VALORIZZAZIONE CC_LIB SUPERATO&quot;;&#xD;
&#xD;
//ATTIVAZIONE&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
{&#xD;
	var FamigliaVlan = &quot;&quot;;&#xD;
	var IdentificativoCos = &quot;&quot;;&#xD;
	var FtthOnly = &quot;&quot;;&#xD;
	&#xD;
	FamigliaVlan = null;&#xD;
	IdentificativoCos = null;&#xD;
	FtthOnly = null;&#xD;
&#xD;
	var foundTipologiaClusterVlan = false;&#xD;
&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
				{&#xD;
					FamigliaVlan = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo FAMIGLIAVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FTTHONLY)&#xD;
				{&#xD;
					FtthOnly = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo FTTHONLY &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN)&#xD;
				{&#xD;
					foundTipologiaClusterVlan = true;&#xD;
					Process.auditLog(&quot;Trovato attributo TIPOLOGIACLUSTERVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
				{&#xD;
					IdentificativoCos = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo  &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
&#xD;
	if(FamigliaVlan == &quot;1&quot; &amp;&amp; (IdentificativoCos == &quot;3&quot; || IdentificativoCos == &quot;5&quot;) &amp;&amp; FtthOnly == &quot;Y&quot; &amp;&amp; !foundTipologiaClusterVlan)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VERIFICA VALORIZZAZIONE CC_LIB NON SUPERATO&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
//RU_1099: VARIAZIONETDKIT&#xD;
else if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_v1_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT&#xD;
        &amp;&amp; ConsistenzaRaccolta != null)&#xD;
{&#xD;
	var IdentificativoCosCONS = &quot;&quot;;&#xD;
	IdentificativoCosCONS = null;&#xD;
	var foundTipologiaClusterVlan = false;&#xD;
	&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaRaccolta.IDAsset, 10));&#xD;
	Asset = AssetRef.readAsset();&#xD;
&#xD;
	if(Asset != null &amp;&amp; Asset.dettaglioasset != null &amp;&amp; ConsistenzaRaccolta.famigliaVlan == &quot;1&quot;)&#xD;
	{&#xD;
		for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var componenteAsset = Asset.dettaglioasset.get(i); &#xD;
			&#xD;
			if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
			{&#xD;
				for(var j=0; j&lt;componenteAsset.attributidettaglioasset.size(); j++)&#xD;
				{&#xD;
					var attributoAsset = componenteAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
					{&#xD;
						IdentificativoCosCONS = attributoAsset.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	for(var h=0; h&lt;localRequest.ordine.dettaglioordine.size(); h++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(h);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
		{&#xD;
			for(var k=0; k&lt;componente.attributiDettaglioOrdine.size(); k++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN)&#xD;
				{&#xD;
					foundTipologiaClusterVlan = true;&#xD;
					Process.auditLog(&quot;Trovato attributo TIPOLOGIACLUSTERVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
			&#xD;
	if(ConsistenzaRaccolta.famigliaVlan == &quot;1&quot; &amp;&amp; (IdentificativoCosCONS == &quot;3&quot; || IdentificativoCosCONS == &quot;5&quot;) &amp;&amp; foundTipologiaClusterVlan)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VERIFICA VALORIZZAZIONE CC_LIB NON SUPERATO&quot;;&#xD;
	}&#xD;
}</xpdl2:Script>
