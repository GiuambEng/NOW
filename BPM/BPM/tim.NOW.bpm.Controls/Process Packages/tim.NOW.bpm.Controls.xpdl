                              &amp;&amp; localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).valoreAttributo!=null)&#xD;
                           {&#xD;
                                  status1 = 1;&#xD;
                                  break;&#xD;
                           }&#xD;
                    }&#xD;
                    if(status1==1)&#xD;
                    {&#xD;
                           for(var j=0; j&lt;sizeADO; j++)&#xD;
                           {&#xD;
                                  if((localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO) &amp;&amp;&#xD;
                                   (localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(j).valoreAttributo == &quot;4&quot; ||&#xD;
