          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//C04M01F94 - Verifica coppia Banda Picco &#xD;
&#xD;
////////////PRECONDIZIONI ESISTENZA KIT per VULAH&#xD;
&#xD;
kit = false;&#xD;
&#xD;
var i=0;&#xD;
while (!kit &amp;&amp;  i &lt; EsistenzaVLANOutput.size()){&#xD;
	var currEsistVLAN = EsistenzaVLANOutput.get(i);&#xD;
	if (currEsistVLAN.CODICE_KIT!=null &amp;&amp; currEsistVLAN.CODICE_KIT.length>0){&#xD;
		kit = true;&#xD;
	}&#xD;
	i++;&#xD;
}</xpdl2:Script>
