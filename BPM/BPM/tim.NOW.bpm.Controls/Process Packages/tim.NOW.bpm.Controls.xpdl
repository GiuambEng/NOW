        <xpdl2:Activity Id="_8Q4UsXpXEe-gPfaj5dRftg" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_CmnZoHpWEe-gPfaj5dRftg" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_7TsTsnpXEe-gPfaj5dRftg" Width="58.0">
              <xpdl2:Coordinates XCoordinate="55.0" YCoordinate="147.0"/>
