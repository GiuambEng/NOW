            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaEsistenzaKITRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaEsistenzaKITRequest();&#xD;
&#xD;
VerificaEsistenzaKITRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaEsistenzaKITRequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
VerificaEsistenzaKITRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
&#xD;
if(localRequest.ordine.distretto != null)&#xD;
{&#xD;
	VerificaEsistenzaKITRequest.distretto = localRequest.ordine.distretto; //SM_8496 &#xD;
}&#xD;
else if(ConsistenzaDati != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaDati.IDAsset));&#xD;
	&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		Asset = AssetRef.readAsset();&#xD;
	&#xD;
		VerificaEsistenzaKITRequest.distretto = Asset.distretto;&#xD;
	}&#xD;
}&#xD;
&#xD;
var foundTipoConsegnaDedicata = false;&#xD;
&#xD;
if(localRequest.offerta != null)&#xD;
{&#xD;
	VerificaEsistenzaKITRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
 &#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
	{&#xD;
		foundTipoConsegnaDedicata = false;&#xD;
&#xD;
		var vc = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVC_VerificaEsistenzaKIT();&#xD;
		var j = 0;&#xD;
		&#xD;
		vc.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
&#xD;
		while((!foundTipoConsegnaDedicata || vc.TDCode == null) &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETD)&#xD;
			{&#xD;
				vc.TDCode = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDACONSEGNA&#xD;
			   &amp;&amp; currentAttDettOrdine.valoreAttributo == &quot;DEDICATA&quot;)&#xD;
			{&#xD;
				foundTipoConsegnaDedicata = true;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
&#xD;
		if(foundTipoConsegnaDedicata)&#xD;
		{&#xD;
			VerificaEsistenzaKITRequest.VC_VerificaEsistenzaKIT.add(ScriptUtil.copy(vc));&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if (EsistenzaKITOutput!=null &amp;&amp; EsistenzaKITOutput.size() > 0)&#xD;
{&#xD;
	for(var i = 0; i &lt; EsistenzaKITOutput.size(); i++)&#xD;
	{&#xD;
		var currentEsistenzaKIT = EsistenzaKITOutput.get(i);&#xD;
		if(currentEsistenzaKIT.TRASPORTO!=null &amp;&amp; currentEsistenzaKIT.TRASPORTO.length > 0)&#xD;
		{&#xD;
			for(var j = 0; j &lt; localRequest.ordine.dettaglioordine.size(); j++)&#xD;
			{&#xD;
			&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(j);&#xD;
				if(currentEsistenzaKIT.IDDettaglioOrdine == currentDettOrdine.IDDettaglioOrdine)&#xD;
				{&#xD;
					var foundTrasporto = false;&#xD;
					var z=0;&#xD;
					&#xD;
					while (!foundTrasporto &amp;&amp; z&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						&#xD;
						var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
						&#xD;
						if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TRASPORTO)&#xD;
						{&#xD;
							foundTrasporto = true;&#xD;
							currentAttributo.valoreAttributo = currentEsistenzaKIT.TRASPORTO;&#xD;
						}&#xD;
						&#xD;
					z++;&#xD;
					}&#xD;
				&#xD;
					if (!foundTrasporto)&#xD;
					{&#xD;
						var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
						nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TRASPORTO;&#xD;
						nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						nuovoAttributo.valoreAttributo = currentEsistenzaKIT.TRASPORTO;&#xD;
						nuovoAttributo.operatore = localRequest.operatore;&#xD;
						currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
