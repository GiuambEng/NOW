        <xpdl2:Activity Id="_-jT4oGkEEeaCa7IeLXedLg" Name="PrecondizioneFallita" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione Fallita">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo MODELLO VULA saltato per precondizione: offerta non di tipo VULAFTTH o VULAFTTCAB&quot;;&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
