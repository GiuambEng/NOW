          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaProtocolloPilaRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaProtocolloPilaRequest();&#xD;
&#xD;
VerificaProtocolloPilaRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaProtocolloPilaRequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
VerificaProtocolloPilaRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
VerificaProtocolloPilaRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
VerificaProtocolloPilaRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
&#xD;
if(ConsistenzaDati != null)&#xD;
{&#xD;
	VerificaProtocolloPilaRequest.IDAsset = ConsistenzaDati.IDAsset;&#xD;
}&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC&#xD;
			|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			var vc = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVC_VerificaProtocolloPila();&#xD;
			vc.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				vc.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA)&#xD;
				{&#xD;
					vc.protocolloPila = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
				{&#xD;
					vc.SVlanCode = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
				{&#xD;
					vc.codeVlanSingleTag = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
				{&#xD;
					vc.VCI = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
				{&#xD;
					vc.VPI = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			var y = 0;&#xD;
			while(vc.tipologiaCos == null &amp;&amp; y &lt; EsistenzaVLANOutput.size())&#xD;
			{&#xD;
				var currentEsistenzaVLAN = EsistenzaVLANOutput.get(y);&#xD;
				if(currentEsistenzaVLAN.IDDettaglioOrdine == currentDettOrdine.IDDettaglioOrdine)&#xD;
				{&#xD;
					vc.tipologiaCos = currentEsistenzaVLAN.TIPO_COS;&#xD;
					vc.tipologiaEncapsulation = currentEsistenzaVLAN.FLAG_ENCAPSULATION;&#xD;
					vc.tipoBanda = currentEsistenzaVLAN.TIPO_BANDA;&#xD;
					if(currentEsistenzaVLAN.TIPO_COS == &quot;BMD&quot;)&#xD;
					{&#xD;
						vc.BMD = &quot;Y&quot;;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						vc.BMD = &quot;N&quot;;&#xD;
					}&#xD;
				}&#xD;
				y++;&#xD;
			}&#xD;
			&#xD;
			VerificaProtocolloPilaRequest.VC_VerificaProtocolloPila.add(ScriptUtil.copy(vc));&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
