        <xpdl2:Activity Id="_yR8txHmkEeaoH8j59Le6HA" Name="Precondizionenonsuperata" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione non superata">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;La precondizione non è stata superata, FLAG_NUOVO_MODELLO=&quot;+FLAGNUOVOMODELLO+ &quot; Offerta: &quot;+localRequest.offerta);&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo SUM BANDE PICCO saltato per precondizione: FLAG NUOVO MODELLO != 'N' o altre precondizioni non rispettate&quot;;</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="68.0" LaneId="_-oFrASPkEeaPieZ5iwuzWQ" Width="108.0">
              <xpdl2:Coordinates XCoordinate="684.0" YCoordinate="98.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_shisBHm9EeaUR6-tFZOkaQ" Name="RecuperaFlag" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="RecuperaFlag" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var i = 0;&#xD;
var trovataComponente = false;&#xD;
var trovatoAttributo = false;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	while(!trovataComponente &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var dettaglio = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTH || dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTCAB)&#xD;
		{&#xD;
			trovataComponente=true;&#xD;
			&#xD;
			var j = 0;&#xD;
			while(!trovatoAttributo &amp;&amp; j &lt; dettaglio.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributoDettaglio = dettaglio.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributoDettaglio.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUOVOMODELLO)&#xD;
				{&#xD;
					FLAGNUOVOMODELLO = attributoDettaglio.valoreAttributo;&#xD;
					trovatoAttributo = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
var i=0;&#xD;
while (!kit &amp;&amp;  i &lt; EsistenzaVLANOutput.size()){&#xD;
	var currEsistVLAN = EsistenzaVLANOutput.get(i);&#xD;
	if (currEsistVLAN.CODICE_KIT!=null &amp;&amp; currEsistVLAN.CODICE_KIT.length>0){&#xD;
		kit = true;&#xD;
	}&#xD;
	i++;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_-oFrASPkEeaPieZ5iwuzWQ" Width="96.0">
              <xpdl2:Coordinates XCoordinate="248.0" YCoordinate="210.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
      </xpdl2:Activities>
      <xpdl2:Transitions>
        <xpdl2:Transition Id="_-oVioyPkEeaPieZ5iwuzWQ" xpdExt:DisplayName="" Name="" From="_-oVioiPkEeaPieZ5iwuzWQ" To="_-oVioSPkEeaPieZ5iwuzWQ">
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.StartAnchorPosition"/>
          </xpdl2:ConnectorGraphicsInfos>
        </xpdl2:Transition>
        <xpdl2:Transition Id="_ZWfmUFJTEeafMOVsQ226Vw" xpdExt:DisplayName="" Name="" From="_tdHs0HmkEeaoH8j59Le6HA" To="_-oVioiPkEeaPieZ5iwuzWQ">
          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var result = false;&#xD;
var skipByFlag = false;&#xD;
&#xD;
if (localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
	 &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
	 &amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
	 &amp;&amp; (!(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE       //SM_9879: esclusa MIGRAZIONE ACCORPAMENTOOLO&#xD;
	        &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ACCORPAMENTOOLO)))&#xD;
{&#xD;
&#xD;
&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS)  //KIT C06 2024&#xD;
	{&#xD;
		if(((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)&#xD;
			|| ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
                  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS 		&#xD;
		          || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH) &amp;&amp; kit))&#xD;
			&amp;&amp; (FLAGNUOVOMODELLO == null || FLAGNUOVOMODELLO == &quot;N&quot;))&#xD;
		{&#xD;
			result = true;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			skipByFlag = true;&#xD;
			result = false;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(!skipByFlag &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
	{&#xD;
		if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC || &#xD;
			localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING)&#xD;
		{&#xD;
			var trovato = false;&#xD;
			var i=0;&#xD;
			&#xD;
			while(!trovato &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var currentDettOrdine= localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
				if(	currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
					&amp;&amp;&#xD;
					((currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A &amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC )&#xD;
					||&#xD;
					(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING))&#xD;
					&#xD;
				)&#xD;
				{&#xD;
					trovato=true;&#xD;
				}&#xD;
			&#xD;
			i++;&#xD;
			}&#xD;
			&#xD;
			if(trovato)&#xD;
			{&#xD;
				result = true;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				result = false;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
		{&#xD;
			var trovatoBande = false;&#xD;
			var trovatoProfilo = false;&#xD;
			var i=0;&#xD;
			&#xD;
			while((!trovatoBande || !trovatoProfilo) &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var currentDettOrdine= localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				// Check Bande nella richiesta&#xD;
				if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
				{&#xD;
					var FoundBandaUP = false;&#xD;
					var FoundBandaDOWN = false;&#xD;
					var j=0;&#xD;
					&#xD;
					while ((!FoundBandaDOWN || !FoundBandaUP) &amp;&amp; j&lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
						if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP) &#xD;
						{&#xD;
							FoundBandaUP= true;&#xD;
						}&#xD;
						else if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
						{&#xD;
							FoundBandaDOWN= true;&#xD;
						}&#xD;
					j++;&#xD;
					}&#xD;
					&#xD;
					if ( FoundBandaDOWN &amp;&amp; FoundBandaUP)&#xD;
					{&#xD;
						trovatoBande=true;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				// Check Profilo Tecnico Linea nella richiesta&#xD;
				if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
				{&#xD;
					var k = 0;&#xD;
					while(!trovatoProfilo &amp;&amp; k &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(k);&#xD;
						if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
						{&#xD;
							trovatoProfilo = true;&#xD;
						}&#xD;
						k++;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
			i++;&#xD;
			}&#xD;
			&#xD;
			if(trovatoBande || trovatoProfilo)&#xD;
			{&#xD;
				result = true;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				result = false;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			result = false;&#xD;
		}&#xD;
	}&#xD;
	else if(!skipByFlag &amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
	{&#xD;
		result = true;&#xD;
	}&#xD;
}&#xD;
&#xD;
result;</xpdl2:Expression>
</xpdl2:Condition>
