        <xpdl2:Activity Id="_rVJ2ABMLEeeLQKfc2l1iRg" Name="VerificaCOSVariazioneNGA" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica COS Variazione NGA" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_YoHjUBO0EeekW5j-cV6_qA">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="false" Direction="IN" Formal="parameters">
                      <xpdl2:Actual ScriptGrammar="JavaScript">VerificaCOSNGARequest</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageIn>
                <xpdl2:MessageOut Id="_YoHjURO0EeekW5j-cV6_qA">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="parameters.verifica_COS_NGAResponse.codice">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.codice</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="parameters.verifica_COS_NGAResponse.descrizione">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.descrizione</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_YoQtQBO0EeekW5j-cV6_qA" OperationName="Verifica_COS_NGA">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckServiceFormaliPortTypeSOAP" ServiceName="BPM_CheckServiceFormaliPortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="BPM_CheckServiceFormali_v1.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="BPM_CheckServiceFormaliPortType" OperationName="Verifica_COS_NGA">
                  <xpdExt:ExternalReference location="BPM_CheckServiceFormali_v1.wsdl"/>
                </xpdExt:PortTypeOperation>
