          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaServizioOpzionalePadreRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaServizioOpzionalePadre_RequestType();&#xD;
&#xD;
VerificaServizioOpzionalePadreRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaServizioOpzionalePadreRequest.DRO = localRequest.DRO;&#xD;
VerificaServizioOpzionalePadreRequest.codiceProgetto = localRequest.codiceProgetto;&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO)&#xD;
			{&#xD;
				VerificaServizioOpzionalePadreRequest.codiceServizio.add(attributo.valoreAttributo);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
