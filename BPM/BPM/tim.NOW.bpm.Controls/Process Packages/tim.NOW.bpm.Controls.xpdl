        <xpdl2:Activity Id="_kAEAojOUEeah8rgiGeuHTg" Name="VerificaUnivocitCVLAN_ID" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Univocità CVLAN_ID" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var failed = false;&#xD;
var i = 0;&#xD;
&#xD;
while(!failed &amp;&amp; i &lt; EsistenzaVLANOutput.size())&#xD;
{&#xD;
	var currentEsistenzaVLAN = EsistenzaVLANOutput.get(i);&#xD;
	var skippare = false;&#xD;
		&#xD;
	if(currentEsistenzaVLAN.FLAG_ENCAPSULATION == &quot;Y&quot; &amp;&amp; currentEsistenzaVLAN.CVLAN_ID_DUPLICATO == &quot;Y&quot;)&#xD;
	{&#xD;
	&#xD;
		// SM_8628 - per RICONFIGURAZIONEVC prima di scartare bisogna verificare che l'uservlan in questione sia stata variata (idDettaglioUserVLAN_SKIP valorizzato in script &quot;precondizione&quot;)&#xD;
		if(localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)&#xD;
		{&#xD;
			for(var j = 0; j &lt; idDettaglioUserVLAN_SKIP.size(); j++)&#xD;
			{&#xD;
				if(currentEsistenzaVLAN.IDDettaglioOrdine == idDettaglioUserVLAN_SKIP.get(j))&#xD;
				{&#xD;
		 			Process.auditLog(&quot;USERVLAN con ID &quot;+currentEsistenzaVLAN.IDDettaglioOrdine+&quot; non variata, scarto da non effettuare&quot;);&#xD;
					skippare = true;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(!skippare)&#xD;
		{	&#xD;
			failed = true;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Trovato CVLANID Duplicato&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Nessun CVLANID duplicato&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
