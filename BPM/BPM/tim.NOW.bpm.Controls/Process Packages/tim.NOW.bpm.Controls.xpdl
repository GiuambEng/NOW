        <xpdl2:Activity Id="_znH7UoSoEeq6aNC-wcpZZA" Name="LogicaSTS" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Logica STS">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL VERIFICA CPS SU UNICA_C04M01F331 passato&quot;;&#xD;
&#xD;
var STSpresente = false;&#xD;
EseguiVerificaCarrierOLOCPS = false;&#xD;
&#xD;
if(InventoryOutput!=null &#xD;
&amp;&amp; InventoryOutput.STSUnica != null &#xD;
&amp;&amp; InventoryOutput.STSUnica.codiceSTS!=null &#xD;
&amp;&amp; InventoryOutput.STSUnica.codiceSTS.size()>0)&#xD;
{&#xD;
	for(var i=0; i&lt;InventoryOutput.STSUnica.codiceSTS.size(); i++)&#xD;
	{&#xD;
		var STS = InventoryOutput.STSUnica.codiceSTS.get(i);&#xD;
		&#xD;
		if(STS == '100051')&#xD;
		{&#xD;
			STSpresente = true;&#xD;
			Process.auditLog(&quot;Trovato STS &quot;+STS+&quot; restituito da UNICA&quot;);&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(STSpresente)&#xD;
	{&#xD;
		var k = 0;&#xD;
		var codiceCarrierOLO = &quot;&quot;;&#xD;
		codiceCarrierOLO = null;&#xD;
		var foundAccesso = false;&#xD;
		&#xD;
		while(!foundAccesso &amp;&amp; k&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(k);&#xD;
			&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOCPS)&#xD;
			{&#xD;
				foundAccesso = true;&#xD;
			&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECARRIEROLO)&#xD;
					{&#xD;
						codiceCarrierOLO = attributo.valoreAttributo;&#xD;
						Process.auditLog(&quot;CODICECARRIEROLO: &quot;+codiceCarrierOLO);					&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			k++;&#xD;
		}&#xD;
		&#xD;
		if(codiceCarrierOLO!=null &#xD;
		&amp;&amp; InventoryOutput.datiUnica != null &#xD;
		&amp;&amp; InventoryOutput.datiUnica.carrierUnica != null&#xD;
		&amp;&amp; codiceCarrierOLO == '10'+InventoryOutput.datiUnica.carrierUnica)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL VERIFICA CPS SU UNICA_C04M01F331 fallito, CODICECARRIEROLO: &quot;+codiceCarrierOLO+&quot; CarrierUnica: &quot;+InventoryOutput.datiUnica.carrierUnica;&#xD;
		}&#xD;
		else&#xD;
		{	&#xD;
			if(InventoryOutput.datiUnica != null &amp;&amp; InventoryOutput.datiUnica.carrierUnica != null)&#xD;
			{&#xD;
				EseguiVerificaCarrierOLOCPS = true;&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL VERIFICA CPS SU UNICA_C04M01F331 OK post logica STS, da chiamare CarrierOLOCPS&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL VERIFICA CPS SU UNICA_C04M01F331 fallito, aggregato dati unica e quindi CarrierUnica non presente da Inventory&quot;;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VERIFICA CPS SU UNICA_C04M01F331 passato, codiceSTS 100051 non presente tra quelli restituiti da UNICA&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VERIFICA CPS SU UNICA_C04M01F331 passato, codiciSTS non presenti o InventoryOutput vuoto&quot;;&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_wobAdoSmEeq6aNC-wcpZZA" Width="96.0">
              <xpdl2:Coordinates XCoordinate="597.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
