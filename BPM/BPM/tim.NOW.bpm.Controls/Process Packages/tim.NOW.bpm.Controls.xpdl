        <xpdl2:Activity Id="_tVjS9zLcEeajbIG7R_HFFQ" Name="VerificaMaxVCperKIT" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Max VC per KIT">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var failed = false;&#xD;
var i = 0;&#xD;
&#xD;
if(EsistenzaKITOutput != null)&#xD;
{&#xD;
	while(!failed &amp;&amp; i &lt; EsistenzaKITOutput.size())&#xD;
	{&#xD;
		if(EsistenzaKITOutput.get(i).VC_Disponibili != &quot;Y&quot;)&#xD;
		{&#xD;
			failed = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Trovato almeno un flag VC NON Disponibili&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Tutti i flag sono VCDisponibili&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
