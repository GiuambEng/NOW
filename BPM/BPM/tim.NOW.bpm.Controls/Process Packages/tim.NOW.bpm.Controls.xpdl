        <xpdl2:Activity Id="_LNVagMhUEeuDgYTGAAXwog" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_S_c94MhSEeu6G-_mWPnbAw" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="82.0" LaneId="_VTDYMchSEeu6G-_mWPnbAw" Width="45.0">
              <xpdl2:Coordinates XCoordinate="50.0" YCoordinate="212.0"/>
