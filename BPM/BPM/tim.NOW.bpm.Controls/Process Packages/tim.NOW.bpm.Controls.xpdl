        <xpdl2:Activity Id="_U-sNsVJVEeafMOVsQ226Vw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_PLrGMFJVEeafMOVsQ226Vw" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_wxrOsCM9Eea7qJ_CMNwz5w" Width="58.0">
