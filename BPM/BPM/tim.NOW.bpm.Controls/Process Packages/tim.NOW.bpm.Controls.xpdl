    <xpdl2:WorkflowProcess Id="_ZuW40P1FEeWEXoIZeVGhKA" xpdExt:XpdModelType="ServiceProcess" xpdExt:DisplayName="CTRL DATA DA" Name="CTRLDATADA">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_bqHQgAS8EeatD5ngGOY_DA" xpdExt:DisplayName="DataDaRequest" Name="DataDaRequest">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="com.tim.NOW.xsd.ControlliAmmessi.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.ControlliAmmessiVerifica_DAD_Per_Rimodulazione_DA_RequestType"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
