          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaCodiceOLORequest = com_tim_NOW_xsd_ControlliAmmessi_Factory.createVerifica_Codice_OLO_Request();&#xD;
&#xD;
VerificaCodiceOLORequest.IDFile = localRequest.IDFileInput;&#xD;
VerificaCodiceOLORequest.IDRichiesta = localRequest.IDRichiestaOLO;&#xD;
&#xD;
if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
	&amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
	&amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.NORMALE&#xD;
	&amp;&amp; OLORetailerCessante == null) //RU_890: se OLORetailerCessante è diverso da null vuol dire che siamo nella casistica della 890, quindi chi chiede la cessazione è l'OLORETAILER e va mappato codificaOLOAGCOM&#xD;
{&#xD;
	VerificaCodiceOLORequest.codiceOLO = localRequest.codificaOLONOWDonating;&#xD;
	VerificaCodiceOLORequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOMDonating;&#xD;
}&#xD;
else&#xD;
{&#xD;
	// Bug #32020: quando OLOReatilerCessante è WIN può capitare che la codificaOLOAGCOM della richiesta sia INF (stesso olo in realtà, ma il controllo scarterebbe)&#xD;
	if(OLORetailerCessante==&quot;WIN&quot;)&#xD;
	{&#xD;
		VerificaCodiceOLORequest.codiceOLOAGCOM = OLORetailerCessante;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		VerificaCodiceOLORequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
	}&#xD;
	&#xD;
	VerificaCodiceOLORequest.codiceOLO = localRequest.codificaOLONOW;&#xD;
}&#xD;
VerificaCodiceOLORequest.strutturaRichiesta = it_telecomitalia_it_NOW_casedata_v1_TipoStrutturaRichiestaEnumeration.get(String(localRequest.strutturaRichiesta));&#xD;
&#xD;
// RU_975&#xD;
VerificaCodiceOLORequest.lavorazione = String(localRequest.lavorazione);&#xD;
VerificaCodiceOLORequest.offerta = String(localRequest.offerta);</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(!EsitoResponse.codice &amp;&amp; CodiceOloFile != null &amp;&amp; CodiceOloFile != &quot;&quot;)&#xD;
{&#xD;
	localRequest.codificaOLOAGCOM = CodiceOloFile;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
