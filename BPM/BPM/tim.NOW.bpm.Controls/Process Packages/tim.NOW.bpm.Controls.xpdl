    <xpdl2:WorkflowProcess Id="_I7yAECMvEea7qJ_CMNwz5w" xpdExt:DisplayName="CTRL VALORIZZAZIONE VLAN CODE_C04M01F53" Name="CTRLVALORIZZAZIONEVLANCODE_C04M01F53">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_hVe4Y2V_EeeFLuxKJU-nxw" xpdExt:DisplayName="EseguiControllo" Name="EseguiControllo" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="BOOLEAN"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_I70cViMvEea7qJ_CMNwz5w" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_I7yAEiMvEea7qJ_CMNwz5w" Width="31.0">
              <xpdl2:Coordinates XCoordinate="514.0" YCoordinate="175.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_I70cVyMvEea7qJ_CMNwz5w" Name="VerificaValorizzazioneCodiceVLAN" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Valorizzazione Codice VLAN" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var foundSvlanCode = false;&#xD;
var foundCodeVlanSingleTag = false;&#xD;
var foundFlagMulticast = false;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if((currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN || currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC || currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC) &amp;&amp; currentDettaglioOrdine.attributiDettaglioOrdine != null)&#xD;
		{&#xD;
			foundSvlanCode = false;&#xD;
			foundCodeVlanSingleTag = false;&#xD;
			foundFlagMulticast = false;&#xD;
			var j = 0;&#xD;
			while((!foundSvlanCode &amp;&amp; !foundCodeVlanSingleTag &amp;&amp; !foundFlagMulticast) &amp;&amp; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentDettaglioOrdine.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
				{&#xD;
					//Trovato SVLANCODE&#xD;
					foundSvlanCode = true;&#xD;
				}&#xD;
				else if(currentDettaglioOrdine.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
				{&#xD;
					//Trovato CodevlanSingleTag&#xD;
					foundCodeVlanSingleTag = true;&#xD;
				}&#xD;
				//SM_10243&#xD;
				else if(currentDettaglioOrdine.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST&#xD;
				     &amp;&amp; currentDettaglioOrdine.attributiDettaglioOrdine.get(j).valoreAttributo == &quot;SI&quot;)&#xD;
				{&#xD;
					//Trovato FlagMulticast&#xD;
					foundFlagMulticast = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(!foundSvlanCode &amp;&amp; !foundCodeVlanSingleTag &amp;&amp; !foundFlagMulticast)&#xD;
			{&#xD;
				//Nessun attributo (SVlanCode o CodeVlanSingleTag o FLAGMULTICAST) trovato&#xD;
				break;&#xD;
			}&#xD;
			&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(!foundSvlanCode &amp;&amp; !foundCodeVlanSingleTag &amp;&amp; !foundFlagMulticast)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;SVLANCODE, CodevlanSingleTag e FLAGMULTICAST tutti mancanti&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;SVLANCODE o CodevlanSingleTag o FLAGMULTICAST valorizzato&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
