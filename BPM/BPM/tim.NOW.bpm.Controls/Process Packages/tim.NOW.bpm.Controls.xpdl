        <xpdl2:Activity Id="_XstUhxoSEeymUKPGzoQSMg" Name="Precondizionefallita" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione fallita" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL CONGRUENZA BMC E BMCLIGHT_C04M01F488 SALTATO&quot;;</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_NWoRgRoSEeymUKPGzoQSMg" Width="129.0">
              <xpdl2:Coordinates XCoordinate="505.0" YCoordinate="103.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
