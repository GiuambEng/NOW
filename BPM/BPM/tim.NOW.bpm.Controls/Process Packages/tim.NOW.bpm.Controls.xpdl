          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;Precondizione non superata, nessun vc con TIPOBANDACONSEGNA Condivisa&quot;);</xpdl2:Script>
