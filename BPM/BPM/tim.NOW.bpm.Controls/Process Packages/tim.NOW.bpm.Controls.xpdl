            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="74.0" LaneId="_GdvOQSQJEeaK86aeaOop2g" Width="111.0">
              <xpdl2:Coordinates XCoordinate="530.0" YCoordinate="324.0"/>
