EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo Verifica variazioni VLAN: precondizione fallita&quot;;&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
