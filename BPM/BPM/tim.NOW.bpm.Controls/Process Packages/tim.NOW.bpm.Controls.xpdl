            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="77.0" LaneId="_lWBc4CTAEeaDSLAcjdJJQQ" Width="113.0">
              <xpdl2:Coordinates XCoordinate="268.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
