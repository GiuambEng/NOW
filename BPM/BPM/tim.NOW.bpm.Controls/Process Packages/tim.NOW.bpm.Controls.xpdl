            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_6qe-Mm3sEeawjMpvs9ADLQ" Width="31.0">
              <xpdl2:Coordinates XCoordinate="520.0" YCoordinate="308.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_6qlE123sEeawjMpvs9ADLQ" Name="VerificaSLAASSURANCE" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica SLA ASSURANCE">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione=&quot;&quot;;&#xD;
&#xD;
//SM_10315 &#xD;
if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
  || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
 &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)&#xD;
 &amp;&amp; localRequest.ordine.codiceSLAAssurance == null)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione= &quot;CTRL SLA ASSURANCE: lavorazione &quot;+localRequest.lavorazione+&quot;, offerta &quot;+localRequest.offerta+&quot;, codiceSLAAssurance non valorizzato, controllo saltato&quot;;&#xD;
}&#xD;
else if(localRequest.ordine.codiceSLAAssurance!=null &amp;&amp; &#xD;
    (localRequest.ordine.codiceSLAAssurance==&quot;0&quot; &#xD;
    || localRequest.ordine.codiceSLAAssurance==&quot;D&quot;&#xD;
    || localRequest.ordine.codiceSLAAssurance==&quot;E&quot;&#xD;
    || localRequest.ordine.codiceSLAAssurance==&quot;F&quot;&#xD;
    || localRequest.ordine.codiceSLAAssurance==&quot;G&quot;&#xD;
    || localRequest.ordine.codiceSLAAssurance==&quot;A&quot;&#xD;
    || localRequest.ordine.codiceSLAAssurance==&quot;B&quot;&#xD;
    || localRequest.ordine.codiceSLAAssurance==&quot;C&quot;))&#xD;
{        &#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione= &quot;CTRL SLA ASSURANCE Successful&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;CTRL SLA ASSURANCE failed, valore codiceSLAAssurance: &quot;+localRequest.ordine.codiceSLAAssurance);&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione= &quot;CTRL SLA ASSURANCE failed K05: Valori di un campo fuori dal dominio&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
