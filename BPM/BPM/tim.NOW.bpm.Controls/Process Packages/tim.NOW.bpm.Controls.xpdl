        <xpdl2:Activity Id="_tfGowBz5EeuP5dMMgOiJUw" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = false;&#xD;
&#xD;
var FamigliaVlan = &quot;&quot;;&#xD;
var IdentificativoCos = &quot;&quot;;&#xD;
FamigliaVlan = null;&#xD;
IdentificativoCos = null;&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
    ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN)&#xD;
{&#xD;
	//ATTIVAZIONE&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
	{&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
			if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
					{&#xD;
						FamigliaVlan = attributo.valoreAttributo; 		&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
					{&#xD;
						IdentificativoCos = attributo.valoreAttributo; 			&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	//VARIAZIONE&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
	        &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETDKIT)&#xD;
	{&#xD;
		if(ConsistenzaRaccolta != null &amp;&amp; ConsistenzaRaccolta.IDAsset != null)&#xD;
		{	&#xD;
			AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaRaccolta.IDAsset, 10));&#xD;
			Asset = AssetRef.readAsset();&#xD;
		}&#xD;
		&#xD;
		if(Asset != null)&#xD;
		{&#xD;
			for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
			{&#xD;
				var componente = Asset.dettaglioasset.get(i);&#xD;
			&#xD;
				if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
				{&#xD;
					for(var j=0; j&lt;componente.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
						{&#xD;
							FamigliaVlan = attributo.valoreAttributo; 		&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
				{&#xD;
					for(var j=0; j&lt;componente.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
						{&#xD;
							IdentificativoCos = attributo.valoreAttributo; 			&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//Per FamigliaVlan = 2 o 3, l'aggregato TIPOCOS non deve essere presente nell'xml in input e, se presente per sbaglio, si deve scartare sul controllo C04M01F425&#xD;
	if(FamigliaVlan == &quot;1&quot; &amp;&amp; (IdentificativoCos == &quot;3&quot; || IdentificativoCos == &quot;5&quot;))&#xD;
	{&#xD;
		EseguiControllo = true;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
