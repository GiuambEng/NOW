        <xpdl2:Activity Id="_1Ql0oNmVEeack7ej6Yci5Q" Name="VerificaValoriBandaPicco" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Valori Banda Picco">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_9KBPANmVEeack7ej6Yci5Q">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="false" Direction="IN" Formal="input">
                      <xpdl2:Actual ScriptGrammar="JavaScript">ControlloValoriBandaPicco</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageIn>
                <xpdl2:MessageOut Id="_9KBPAdmVEeack7ej6Yci5Q">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="output.codice">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.codice</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="output.descrizione">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.descrizione</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_YHMjsCMWEea7qJ_CMNwz5w" OperationName="ControlloValoriBandaPicco">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckDatiPortTypeSOAP" ServiceName="BPM_CheckDatiPortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="BPM_CheckServiceDati_concrete_v1.0.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="BPM_CheckDatiPortType" OperationName="ControlloValoriBandaPicco">
                  <xpdExt:ExternalReference location="BPM_CheckServiceDati_concrete_v1.0.wsdl"/>
                </xpdExt:PortTypeOperation>
              </xpdl2:TaskService>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:Performers>
            <xpdl2:Performer>_YHMjsCMWEea7qJ_CMNwz5w</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="79.0" LaneId="_XuMGsdmVEea0E92mZMa6Yw" Width="111.0">
              <xpdl2:Coordinates XCoordinate="709.0" YCoordinate="231.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ControlloValoriBandaPicco = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createControlloValoriBandaPiccoReq();&#xD;
ControlloValoriBandaPicco.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
&#xD;
// variabile booleana per capire se è stata già recuperata la consistenza&#xD;
var consRead = false;&#xD;
&#xD;
//Task #36493&#xD;
Uservlan1Tagging = null;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	if((localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &amp;&amp;&#xD;
		currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp;&#xD;
		currentDettaglioOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
		||&#xD;
		(localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
		&amp;&amp; currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN))&#xD;
	&#xD;
	{&#xD;
		//SM_10243: Il controllo non va effettuato se la USERVLAN ha FLAGMULTICAST (quindi non passiamo la USERVLAN al servizio)&#xD;
		var FLAGMULTICAST = &quot;&quot;;&#xD;
		FLAGMULTICAST = null;&#xD;
		var m = 0;&#xD;
&#xD;
		while(FLAGMULTICAST == null &amp;&amp; m&lt;currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attributo = currentDettaglioOrdine.attributiDettaglioOrdine.get(m);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
			{&#xD;
				FLAGMULTICAST = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Trovato attributo FLAGMULTICAST&quot;+ attributo.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+currentDettaglioOrdine.IDDettaglioOrdine);			&#xD;
			}&#xD;
			&#xD;
			m++;&#xD;
		}&#xD;
&#xD;
		if(FLAGMULTICAST != &quot;SI&quot;)&#xD;
		{		&#xD;
			var uservlan = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createUserVlan_ValoriBandaPicco();&#xD;
			var uservlan_id = null;&#xD;
			var uservlan_id = '';&#xD;
			&#xD;
			// Recupero UserVlan dalla richiesta&#xD;
			for (var j = 0 ; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
				{&#xD;
					uservlan.bandaPiccoDown = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
				{&#xD;
					uservlan.bandaPiccoUp = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if (currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
				{&#xD;
					// salvo uservlan_id per eventuale recupero della consistenza&#xD;
					uservlan_id = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				var k = 0; &#xD;
				var trovato = false;&#xD;
				while (!trovato &amp;&amp; k &lt; EsistenzaVLANOutput.size())&#xD;
				{&#xD;
					var currEsistVLAN = EsistenzaVLANOutput.get(k);&#xD;
					if (currEsistVLAN.IDDettaglioOrdine == currentAttDettOrdine.IDDettaglioOrdine)&#xD;
					{&#xD;
						trovato = true;&#xD;
						uservlan.tipoCos = currEsistVLAN.TIPO_COS;&#xD;
					}&#xD;
					k++;			&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			// se le bande non sono presenti nella richiesta mette quelle recuperate nella CONS&#xD;
			if((uservlan.bandaPiccoDown == null || uservlan.bandaPiccoUp == null) &amp;&amp; &#xD;
			   localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
			{&#xD;
				&#xD;
				// Se la consistenza non è statta ancora recuperata la recupera&#xD;
				if(consRead == false)&#xD;
				{&#xD;
				&#xD;
					// Data Field di appoggio per UserVlan della consistenza (BOM di Verifica Somma Bande Picco)&#xD;
					ControlloValoriBandaPiccoCons = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaSommaBandePiccoRequest();&#xD;
						&#xD;
					if (ConsistenzaDati!= null)&#xD;
					{&#xD;
						AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
						Asset = AssetRef.readAsset();&#xD;
&#xD;
						// RECUPERO&#xD;
						for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
						{&#xD;
							var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
&#xD;
							if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
							{&#xD;
								&#xD;
								// Uso USERVLAN di Verifica Somma Bande Picco come appoggio&#xD;
								var uservlanCons = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createUserVlan_SommaBandePiccoCons();&#xD;
&#xD;
								for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
								{&#xD;
									var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
								&#xD;
									if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
									{&#xD;
										uservlanCons.banda_Picco_DOWN = currentAttDettAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
									{&#xD;
										uservlanCons.banda_Picco_UP = currentAttDettAsset.valoreAttributo;&#xD;
									}&#xD;
									else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
									{&#xD;
										uservlanCons.idUserVlan = currentAttDettAsset.valoreAttributo;&#xD;
									}&#xD;
									&#xD;
								}&#xD;
&#xD;
								ControlloValoriBandaPiccoCons.userVlan_Cons.add(uservlanCons);&#xD;
							}&#xD;
							//Task #36493&#xD;
							else if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
							{&#xD;
								for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
								{&#xD;
									var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
								&#xD;
									if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING)&#xD;
									{								&#xD;
										Uservlan1Tagging = currentAttDettAsset.valoreAttributo;&#xD;
									}&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					consRead = true;&#xD;
				}&#xD;
				&#xD;
				for(var k = 0; k &lt; ControlloValoriBandaPiccoCons.userVlan_Cons.size(); k++)&#xD;
				{&#xD;
					&#xD;
					if((ControlloValoriBandaPiccoCons.userVlan_Cons.get(k).idUserVlan == uservlan_id)&#xD;
						||&#xD;
					    //Task #36493: in questa casistica c'è una sola USERVLAN che non ha l'attributo USERVLANID&#xD;
					    (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC&#xD;
						 &amp;&amp; Uservlan1Tagging.toUpperCase() == &quot;UNTAGGED&quot;))&#xD;
					{&#xD;
						if(uservlan.bandaPiccoDown == null)&#xD;
						{&#xD;
							uservlan.bandaPiccoDown = ControlloValoriBandaPiccoCons.userVlan_Cons.get(k).banda_Picco_DOWN;&#xD;
						}&#xD;
						if(uservlan.bandaPiccoUp == null)&#xD;
						{&#xD;
							uservlan.bandaPiccoUp = ControlloValoriBandaPiccoCons.userVlan_Cons.get(k).banda_Picco_UP;&#xD;
						}&#xD;
					}&#xD;
					&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			ControlloValoriBandaPicco.userVlan.add(uservlan);	&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">//Se il controllo ha dato esito OK e siamo nel caso della variazione (recuperati valori dalla consistenza in precedente)&#xD;
if(EsitoResponse.codice == true &amp;&amp; &#xD;
    localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if((localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &amp;&amp;&#xD;
			currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp;&#xD;
			currentDettaglioOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
			||&#xD;
			(localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC&#xD;
			&amp;&amp; currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN))&#xD;
		&#xD;
		{&#xD;
			var uservlan = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createUserVlan_ValoriBandaPicco();&#xD;
			var uservlan_id = null;&#xD;
			var uservlan_id = '';&#xD;
			&#xD;
			// Recupero UserVlan dalla richiesta&#xD;
			for (var j = 0 ; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
				{&#xD;
					uservlan.bandaPiccoDown = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
				{&#xD;
					uservlan.bandaPiccoUp = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if (currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
				{&#xD;
					uservlan_id = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			// se le bande non sono presenti nella richiesta&#xD;
			if(uservlan.bandaPiccoDown == null || uservlan.bandaPiccoUp == null)&#xD;
			{&#xD;
				&#xD;
				// Recupera le bande dalla consistenza salvata in precedenza&#xD;
				for(var k = 0; k &lt; ControlloValoriBandaPiccoCons.userVlan_Cons.size(); k++)&#xD;
				{&#xD;
					&#xD;
					if((ControlloValoriBandaPiccoCons.userVlan_Cons.get(k).idUserVlan == uservlan_id)&#xD;
					   ||&#xD;
					   //Task #36493: in questa casistica c'è una sola USERVLAN che non ha l'attributo USERVLANID&#xD;
					   (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC&#xD;
						&amp;&amp; Uservlan1Tagging.toUpperCase() == &quot;UNTAGGED&quot;))&#xD;
					{												&#xD;
						&#xD;
						// ARRICCHIMENTO RICHIESTA&#xD;
						var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						var data = DateTimeUtil.createDatetime();&#xD;
						&#xD;
						attributo.IDRichiestaOLO = currentDettaglioOrdine.IDRichiestaOLO;&#xD;
						attributo.IDDettaglioOrdine = currentDettaglioOrdine.IDDettaglioOrdine;&#xD;
						attributo.created = data;&#xD;
						attributo.lastUpdate = data;&#xD;
						attributo.operatore = currentDettaglioOrdine.operatore;&#xD;
						&#xD;
						if(uservlan.bandaPiccoDown == null)&#xD;
						{&#xD;
							// Aggiunge Banda Picco Down&#xD;
							uservlan.bandaPiccoDown = ControlloValoriBandaPiccoCons.userVlan_Cons.get(k).banda_Picco_DOWN;&#xD;
							attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN;&#xD;
							attributo.valoreAttributo = uservlan.bandaPiccoDown;&#xD;
							attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;							&#xD;
						&#xD;
							localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						}&#xD;
						if(uservlan.bandaPiccoUp == null)&#xD;
						{&#xD;
							// Aggiunge Banda Picco Up&#xD;
							uservlan.bandaPiccoUp = ControlloValoriBandaPiccoCons.userVlan_Cons.get(k).banda_Picco_UP;&#xD;
							attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP;&#xD;
							attributo.valoreAttributo = uservlan.bandaPiccoUp;&#xD;
							attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						&#xD;
							localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						}&#xD;
					}					&#xD;
				}					&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_1mHYsNmVEeack7ej6Yci5Q" Name="Precondizionenonsuperata" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione non superata">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Process.auditLog(&quot;La precondizione non è stata superata, FLAG_NUOVO_MODELLO=&quot;+FLAGNUOVOMODELLO+ &quot; Offerta: &quot;+localRequest.offerta);&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo VALORI BANDA PICCO saltato per precondizione: FLAG NUOVO MODELLO != 'Y' o altre precondizioni non superate&quot;;</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_XuMGsdmVEea0E92mZMa6Yw" Width="144.0">
              <xpdl2:Coordinates XCoordinate="709.0" YCoordinate="88.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
      </xpdl2:Activities>
      <xpdl2:Transitions>
        <xpdl2:Transition Id="_XuclY9mVEea0E92mZMa6Yw" xpdExt:DisplayName="" Name="" From="_1Ql0oNmVEeack7ej6Yci5Q" To="_XuclYdmVEea0E92mZMa6Yw">
