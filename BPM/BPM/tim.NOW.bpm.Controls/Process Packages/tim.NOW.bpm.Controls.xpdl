    <xpdl2:WorkflowProcess Id="_huv20P1FEeWEXoIZeVGhKA" xpdExt:DisplayName="CTRL REFERENTE ON FIELD TELEFONI" Name="CTRLREFERENTEONFIELDTELEFONI">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_hu8EFv1FEeWEXoIZeVGhKA" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_huv20v1FEeWEXoIZeVGhKA" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_hu8EF_1FEeWEXoIZeVGhKA" Name="ReferenteOnFieldTelefoni" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Referente On Field Telefoni">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//Inizializzo la struttura di esito&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;OK&quot;;&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.referente != null &amp;&amp; localRequest.ordine.referente.size() > 0)&#xD;
{&#xD;
	var i=0;&#xD;
	while(EsitoResponse.codice != false &amp;&amp; i &lt; localRequest.ordine.referente.size())&#xD;
	{&#xD;
		if(localRequest.ordine.referente.get(i).tipoReferenteOrdine == it_telecomitalia_it_NOW_casedata_TipoReferenteOrdineEnumeration.REFERENTEONFIELD)&#xD;
		{&#xD;
		var currentReferente = localRequest.ordine.referente.get(i);&#xD;
		&#xD;
		if(currentReferente.telefonoFissoReferente != null &amp;&amp; currentReferente.telefonoFissoReferente.length >= 6)&#xD;
		{&#xD;
			var j=0;&#xD;
			while(EsitoResponse.codice != false &amp;&amp; j &lt; currentReferente.telefonoFissoReferente.length)&#xD;
			{&#xD;
				var currentCharCode = currentReferente.telefonoFissoReferente.charCodeAt(j);&#xD;
				if(currentCharCode &lt; 48 || currentCharCode > 57)&#xD;
				{&#xD;
					//trovato un carattere non numerico&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;KO&quot;;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		else if(currentReferente.telefonoMobileReferente != null &amp;&amp; currentReferente.telefonoMobileReferente.length >= 9 &amp;&amp; currentReferente.telefonoMobileReferente.length &lt;= 15)&#xD;
		{&#xD;
			var j=0;&#xD;
			while(EsitoResponse.codice != false &amp;&amp; j &lt; currentReferente.telefonoMobileReferente.length)&#xD;
			{&#xD;
				var currentCharCode = currentReferente.telefonoMobileReferente.charCodeAt(j);&#xD;
				if(currentCharCode &lt; 48 || currentCharCode > 57)&#xD;
				{&#xD;
					//trovato un carattere non numerico&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;KO&quot;;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			//nessun telefono fisso o mobile trovato con la lunghezza richiesta&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;KO&quot;;&#xD;
		}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
/*&#xD;
