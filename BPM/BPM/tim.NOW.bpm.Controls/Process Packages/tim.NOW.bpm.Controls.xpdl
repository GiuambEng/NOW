{&#xD;
	if(localRequest.ordine.referente.get(i).IDTypeReferenteOrdine == it_telecomitalia_it_NOW_casedata_IDTypeReferenteOrdineEnumeration.REFERENTEONFIELD)&#xD;
	{	&#xD;
		FissoReferente = localRequest.ordine.referente.get(i).telefonoFissoReferente;&#xD;
