                      <xpdExt:DataMapping xpdExt:SourceContributorId="OutputFromService.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="tipologiaClusterComune">
                        <xpdl2:Actual ScriptGrammar="JavaScript">output.tipologiaClusterComune</xpdl2:Actual>
