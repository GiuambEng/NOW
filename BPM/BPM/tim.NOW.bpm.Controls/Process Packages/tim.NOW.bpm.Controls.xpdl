        <xpdl2:Activity Id="_yMXfMhdoEeqiOYbRIgBdnA" Name="VerificaCompatibilitaTipolinea" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Compatibilita Tipolinea" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL VERIFICA COMPATIBILITA TIPOLINEA CPS. Controllo passato&quot;;&#xD;
&#xD;
if(InterrogazioneInventory != null &amp;&amp; InterrogazioneInventory.datiUnica != null &amp;&amp; InterrogazioneInventory.CRMWSResponse != null &amp;&amp; InterrogazioneInventory.CRMWSResponse.tipo_Linea != null)&#xD;
{&#xD;
	if(InterrogazioneInventory.datiUnica.flagAttivo == &quot;N&quot;)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VERIFICA COMPATIBILITA TIPOLINEA CPS. 35 NUMERAZIONE NON COMMERCIALIZZATA/CESSATA.&quot;;&#xD;
		esitoControllo = &quot;KO_01&quot;;&#xD;
	}&#xD;
	else if(InterrogazioneInventory.datiUnica.flagTP == &quot;Y&quot;)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VERIFICA COMPATIBILITA TIPOLINEA CPS. 10 IMPIANTO DI TELEFONIA PUBBLICA.&quot;;&#xD;
		esitoControllo = &quot;KO_02&quot;;&#xD;
	}&#xD;
	else if(InterrogazioneInventory.datiUnica.flagNumerazioneServizio == &quot;Y&quot;)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VERIFICA COMPATIBILITA TIPOLINEA CPS. 17 COLLEGAMENTO DI SERVIZIO.&quot;;&#xD;
		esitoControllo = &quot;KO_03&quot;;&#xD;
	}&#xD;
	else if(InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Portabilita != null &amp;&amp; InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Portabilita == &quot;DONOR&quot;)   //RU_1102: da != &quot;NON PORTATO&quot; a == &quot;DONOR&quot;&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VERIFICA COMPATIBILITA TIPOLINEA CPS. D7 PRESENZA DI SERVIZIO INCOMPATIBILE CON SERVIZIO RICHIESTO.&quot;;&#xD;
		esitoControllo = &quot;KO_04&quot;;&#xD;
	}&#xD;
	//RU_1102&#xD;
	else if(InterrogazioneInventory.STSUnica != null &amp;&amp; InterrogazioneInventory.STSUnica.codiceSTS != null &amp;&amp; InterrogazioneInventory.STSUnica.codiceSTS.size()>0)&#xD;
	{&#xD;
		var foundCodiceSTS = false;&#xD;
&#xD;
		for(var i=0; i&lt;InterrogazioneInventory.STSUnica.codiceSTS.size(); i++)&#xD;
		{&#xD;
			var currentCodiceSTS = InterrogazioneInventory.STSUnica.codiceSTS.get(i); &#xD;
			&#xD;
			if(currentCodiceSTS == &quot;100095&quot;)&#xD;
			{&#xD;
				foundCodiceSTS = true;&#xD;
			}&#xD;
		}&#xD;
&#xD;
		if(foundCodiceSTS)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL VERIFICA COMPATIBILITA TIPOLINEA CPS. D7 PRESENZA DI SERVIZIO INCOMPATIBILE CON SERVIZIO RICHIESTO.&quot;;&#xD;
			esitoControllo = &quot;KO_04&quot;;&#xD;
		}&#xD;
	}&#xD;
	//RU_1093&#xD;
	else if(InterrogazioneInventory.datiUnica.caposerie != null &amp;&amp; InterrogazioneInventory.datiUnica.caposerie != &quot;&quot;)&#xD;
	{&#xD;
		var DN = &quot;&quot;;&#xD;
		DN = null;&#xD;
&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN)&#xD;
					{&#xD;
						DN = attributo.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}	&#xD;
		}&#xD;
		&#xD;
		if(InterrogazioneInventory.datiUnica.caposerie != DN)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL VERIFICA COMPATIBILITA TIPOLINEA CPS. 3 CAPOSTIPITE, CAPOSERIE O TESTA DI SERIE MANCANTI.&quot;;&#xD;
			esitoControllo = &quot;KO_06&quot;;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	&#xD;
	if(EsitoResponse.codice)&#xD;
	{	&#xD;
		if(InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Numero != null &amp;&amp; InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Numero != &quot;NATIVO VOIP IMS&quot;)&#xD;
		{&#xD;
			if(InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;RTG&quot; &amp;&amp; InterrogazioneInventory.CRMWSResponse.tipo_Linea.banda_Servizio != &quot;IMS&quot;)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				TipoLineaUnica = &quot;POTS&quot;;&#xD;
				StrutturaLineaUnica = &quot;SIMPLEX&quot;;&#xD;
			}&#xD;
			else if((InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;CAPOSERIE&quot; || InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;LINEA PBX&quot;) &#xD;
						&amp;&amp; InterrogazioneInventory.CRMWSResponse.tipo_Linea.banda_Servizio == &quot;SX&quot;)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				TipoLineaUnica = &quot;POTS&quot;;&#xD;
				StrutturaLineaUnica = &quot;PBX&quot;;&#xD;
			}&#xD;
			else if((InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;RADICALE&quot; &#xD;
				  || InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;SPE&quot; &#xD;
				  || InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;SPU&quot;) &#xD;
				&amp;&amp; InterrogazioneInventory.CRMWSResponse.tipo_Linea.banda_Servizio == &quot;SX&quot;)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				TipoLineaUnica = &quot;POTS&quot;;&#xD;
				StrutturaLineaUnica = &quot;GNR&quot;;&#xD;
			}&#xD;
			else if(InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;ISDN BMO&quot;)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				TipoLineaUnica = &quot;ISDN&quot;;&#xD;
				StrutturaLineaUnica = &quot;BRA MONO&quot;;				&#xD;
			}&#xD;
			else if(InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;ISDN BMU&quot;)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				TipoLineaUnica = &quot;ISDN&quot;;&#xD;
				StrutturaLineaUnica = &quot;BRA MULTI&quot;;				&#xD;
			}&#xD;
			else if((InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;CAPOSERIE&quot; &#xD;
				  || InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;LINEA PBX&quot;) &#xD;
				&amp;&amp; InterrogazioneInventory.CRMWSResponse.tipo_Linea.banda_Servizio == &quot;ISDN BRA&quot;)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				TipoLineaUnica = &quot;ISDN&quot;;&#xD;
				StrutturaLineaUnica = &quot;PBX&quot;;				&#xD;
			}&#xD;
			else if((InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;RADICALE&quot; &#xD;
				  || InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;SPE&quot; &#xD;
				  || InterrogazioneInventory.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;SPU&quot;) &#xD;
				&amp;&amp; (InterrogazioneInventory.CRMWSResponse.tipo_Linea.banda_Servizio == &quot;ISDN BRA&quot; || InterrogazioneInventory.CRMWSResponse.tipo_Linea.banda_Servizio == &quot;ISDN PRA&quot;))&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				TipoLineaUnica = &quot;ISDN&quot;;&#xD;
				StrutturaLineaUnica = &quot;GNR&quot;;			&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CTRL VERIFICA COMPATIBILITA TIPOLINEA CPS. D5 TIPOLOGIA DI UTENZA INCOMPATIBILE CON IL SERVIZIO RICHIESTO.&quot;;&#xD;
				esitoControllo = &quot;KO_05&quot;;&#xD;
			}&#xD;
		}			&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL VERIFICA COMPATIBILITA TIPOLINEA CPS. D5 TIPOLOGIA DI UTENZA INCOMPATIBILE CON IL SERVIZIO RICHIESTO.&quot;;&#xD;
			esitoControllo = &quot;KO_05&quot;;&#xD;
		}&#xD;
		&#xD;
		//SM_9081 - commentata per refuso SF&#xD;
		/*if((DatiUnica.tipoServizio == &quot;RTG&quot; &amp;&amp; DatiUnica.tipoNumero == &quot;GENERICA&quot;) || DatiUnica.tipoServizio == &quot;ISDN&quot; || DatiUnica.tipoServizio == &quot;ISDN BMO&quot; || DatiUnica.tipoServizio == &quot;ISDN PRA&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL VERIFICA COMPATIBILITA TIPOLINEA CPS. D5 TIPOLOGIA DI UTENZA INCOMPATIBILE CON IL SERVIZIO RICHIESTO.&quot;;&#xD;
			esitoControllo = &quot;KO_03&quot;;&#xD;
		}*/&#xD;
	}&#xD;
}&#xD;
&#xD;
Log.write(&quot;CTRL COMPATIBILITA TIPO LINEA CPS [&quot;+localRequest.IDRichiestaOLO+&quot; esito: &quot;+esitoControllo+&quot;, TipoLineaUnica: &quot;+TipoLineaUnica+&quot;, StrutturaLineaUnica: &quot;+StrutturaLineaUnica);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
