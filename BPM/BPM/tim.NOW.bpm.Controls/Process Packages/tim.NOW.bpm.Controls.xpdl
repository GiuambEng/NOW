            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaVPRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaVPRequestEsitiMultipli();&#xD;
&#xD;
VerificaVPRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaVPRequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
VerificaVPRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
VerificaVPRequest.codiceOLO = localRequest.codificaOLONOW;&#xD;
VerificaVPRequest.caratteristica = localRequest.caratteristica;&#xD;
VerificaVPRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
VerificaVPRequest.scenario = it_telecomitalia_it_NOW_casedata_v1_TipologiaScenarioEnumeration.get(String(localRequest.tipologiaScenario));&#xD;
&#xD;
if(localRequest.ordine.codicePacchettoNOW != null)&#xD;
{&#xD;
	VerificaVPRequest.isPacchetto = true;&#xD;
}&#xD;
else&#xD;
{&#xD;
	VerificaVPRequest.isPacchetto = false;&#xD;
}&#xD;
&#xD;
var foundTipoConsegnaCondivisa = false;&#xD;
&#xD;
if(localRequest.offerta != null)&#xD;
{&#xD;
	VerificaVPRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
}&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
		{&#xD;
			foundTipoConsegnaCondivisa = false;&#xD;
			&#xD;
			var vc = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVC_VerificaVP();&#xD;
			vc.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
			&#xD;
			var j = 0;&#xD;
			while((!foundTipoConsegnaCondivisa || vc.VPCode == null) &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEVP)&#xD;
				{&#xD;
					vc.VPCode = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDACONSEGNA&#xD;
						&amp;&amp; currentAttDettOrdine.valoreAttributo == &quot;CONDIVISA&quot;)&#xD;
				{&#xD;
					foundTipoConsegnaCondivisa = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(foundTipoConsegnaCondivisa)&#xD;
			{&#xD;
				VerificaVPRequest.VC_VerificaVP.add(ScriptUtil.copy(vc));&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if (EsistenzaVPOutput != null &amp;&amp; EsistenzaVPOutput.size() > 0)&#xD;
{&#xD;
	for(var i = 0; i &lt; EsistenzaVPOutput.size(); i++)&#xD;
	{	&#xD;
		var currentEsistenzaVP = EsistenzaVPOutput.get(i);&#xD;
		if(currentEsistenzaVP.tipo_Trasporto!=null &amp;&amp; currentEsistenzaVP.tipo_Trasporto.length > 0)&#xD;
		{&#xD;
			for( var j = 0; j &lt; localRequest.ordine.dettaglioordine.size(); j++)&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(j);&#xD;
				if(currentEsistenzaVP.IDDettaglioOrdine == currentDettOrdine.IDDettaglioOrdine)&#xD;
				{&#xD;
					var foundTipoTrasporto = false;&#xD;
					var z=0;&#xD;
					&#xD;
					while (!foundTipoTrasporto &amp;&amp; z&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						&#xD;
						var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
						&#xD;
						if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TRASPORTO)&#xD;
						{&#xD;
							foundTipoTrasporto = true;&#xD;
							currentAttributo.valoreAttributo = currentEsistenzaVP.tipo_Trasporto;&#xD;
						}&#xD;
						&#xD;
					z++;&#xD;
					}&#xD;
				&#xD;
					if (!foundTipoTrasporto)&#xD;
					{&#xD;
						var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
						nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TRASPORTO;&#xD;
						nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						nuovoAttributo.valoreAttributo = currentEsistenzaVP.tipo_Trasporto;&#xD;
						nuovoAttributo.operatore = localRequest.operatore;&#xD;
						currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
