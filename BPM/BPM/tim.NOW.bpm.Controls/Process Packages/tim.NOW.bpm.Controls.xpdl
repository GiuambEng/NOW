            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaGestioneAutonomaPresaAppuntamentoRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaGestioneAutonomaPresaAppuntamentoSemigpon_RequestType();&#xD;
&#xD;
if(LavorazioneRichiesta != null)&#xD;
{&#xD;
	VerificaGestioneAutonomaPresaAppuntamentoRequest.areaDiCentrale = LavorazioneRichiesta.areaDiCentrale;&#xD;
	VerificaGestioneAutonomaPresaAppuntamentoRequest.impresaAreaDiCentrale = LavorazioneRichiesta.impresaAreaDiCentrale;	&#xD;
}&#xD;
&#xD;
if(localRequest != null)&#xD;
{&#xD;
	VerificaGestioneAutonomaPresaAppuntamentoRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	VerificaGestioneAutonomaPresaAppuntamentoRequest.codOLOAgcom = localRequest.codificaOLOAGCOM;&#xD;
	VerificaGestioneAutonomaPresaAppuntamentoRequest.dro = localRequest.DRO;&#xD;
	VerificaGestioneAutonomaPresaAppuntamentoRequest.offerta = String(localRequest.offerta); //SM_11106&#xD;
	VerificaGestioneAutonomaPresaAppuntamentoRequest.lavorazione = String(localRequest.lavorazione); //SM_11106&#xD;
	if(localRequest.ordine != null)&#xD;
	{&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTOGESTIONEAUTONOMA)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OWNERPRESAAPPUNTAMENTO)&#xD;
					{&#xD;
						VerificaGestioneAutonomaPresaAppuntamentoRequest.ownerPresaAppuntamento = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAAPPUNTAMENTO)&#xD;
					{&#xD;
						VerificaGestioneAutonomaPresaAppuntamentoRequest.dataAppuntamento = attributo.valoreAttributo;&#xD;
