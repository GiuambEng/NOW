              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_4_fG4ScdEeaczdq0fQ_Kww" Width="31.0">
              <xpdl2:Coordinates XCoordinate="704.0" YCoordinate="159.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_4_twYicdEeaczdq0fQ_Kww" Name="VerificaUserVlan1UNTAGGEDNumerosit" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica UserVlan1 UNTAGGED Numerosità" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var countUserVlan = 0;&#xD;
var untagged = false;&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(!untagged &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING &amp;&amp; currentAttDettOrdine.valoreAttributo.toUpperCase() == &quot;UNTAGGED&quot;)&#xD;
				{&#xD;
					untagged = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			countUserVlan++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(!untagged)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;USERVLAN1TAGGING non UNTAGGED&quot;;&#xD;
	}&#xD;
	else if(untagged &amp;&amp; countUserVlan > 1)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Trovate &quot; + countUserVlan.toString() + &quot; UserVLAN&quot;;&#xD;
	}&#xD;
	else if(untagged &amp;&amp; countUserVlan == 1)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;UNTAGGED e trovata una sola UserVLAN&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;UNTAGGED e nessuna UserVLAN trovata&quot;;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
