    <xpdl2:WorkflowProcess Id="_GAaTADFEEeafpa4CEFkvQw" xpdExt:DisplayName="CTRL VLAN NON BMD_C04M01F45" Name="CTRLVLANNONBMD_C04M01F45">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_GAoVcTFEEeafpa4CEFkvQw" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_GAcIMTFEEeafpa4CEFkvQw" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_GAoVcjFEEeafpa4CEFkvQw" Name="VerificaVLANNONBMD" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica VLAN NON BMD" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var failed = false;&#xD;
&#xD;
var i = 0;&#xD;
while(!failed &amp;&amp; i &lt; EsistenzaVLANOutput.size())&#xD;
{&#xD;
	var currentEsistenzaVLAN = EsistenzaVLANOutput.get(i);&#xD;
	&#xD;
	if(currentEsistenzaVLAN.TIPO_COS != &quot;BMD&quot;)&#xD;
	{&#xD;
		var matched = false;&#xD;
		var j = 0;&#xD;
		&#xD;
		while(!matched &amp;&amp; j &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(j);	&#xD;
			&#xD;
			if(currentDettOrdine.IDDettaglioOrdine == currentEsistenzaVLAN.IDDettaglioOrdine)&#xD;
			{&#xD;
				matched = true;&#xD;
				var z = 0;&#xD;
				&#xD;
				while(!failed &amp;&amp; z &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD)&#xD;
					{&#xD;
						failed = true;&#xD;
					}&#xD;
					z++;&#xD;
				}&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Trovato un PROFILOBMD per una VLAN non BMD&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Nessun PROFILOBMD trovato per le VLAN non BMD&quot;;&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="86.0" LaneId="_GAcIMTFEEeafpa4CEFkvQw" Width="119.0">
