            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaCOSsuKitDiRiferimentoRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createVerifica_Cos_Su_Kit_Riferimento_RequestType();&#xD;
&#xD;
VerificaCOSsuKitDiRiferimentoRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
VerificaCOSsuKitDiRiferimentoRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
&#xD;
//SM_10091&#xD;
var foundCODICETDKIT = false;&#xD;
var foundCODICECLLI = false;&#xD;
var foundIDENTIFICATIVOCAR = false;&#xD;
var foundSUPERMACROAREA = false;&#xD;
var foundTIPOLOGIACLUSTERVLAN = false;&#xD;
var foundFAMIGLIAVLAN = false;&#xD;
var foundIDENTIFICATIVOCOS = false;&#xD;
&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
			{&#xD;
				VerificaCOSsuKitDiRiferimentoRequest.codiceTdKit = attributo.valoreAttributo;&#xD;
				foundCODICETDKIT = true;			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLLI)&#xD;
			{&#xD;
				VerificaCOSsuKitDiRiferimentoRequest.clli = attributo.valoreAttributo;&#xD;
				foundCODICECLLI = true;			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCAR)&#xD;
			{&#xD;
				VerificaCOSsuKitDiRiferimentoRequest.identificativoCar = attributo.valoreAttributo;&#xD;
				foundIDENTIFICATIVOCAR = true;			&#xD;
			}&#xD;
			//SM_9821&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA)&#xD;
			{&#xD;
				VerificaCOSsuKitDiRiferimentoRequest.superMacroArea = attributo.valoreAttributo;&#xD;
				foundSUPERMACROAREA = true;			&#xD;
			}&#xD;
			//SM_9821 - gli va mandato il valore di CC_LIB&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN)&#xD;
			{&#xD;
				VerificaCOSsuKitDiRiferimentoRequest.CC_LIB = attributo.valoreAttributo;&#xD;
				foundTIPOLOGIACLUSTERVLAN = true;		&#xD;
			}&#xD;
			//SM_9953&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
			{&#xD;
				VerificaCOSsuKitDiRiferimentoRequest.famigliaVLAN = attributo.valoreAttributo;&#xD;
				foundFAMIGLIAVLAN = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
			{&#xD;
				VerificaCOSsuKitDiRiferimentoRequest.identificaticoCos.add(attributo.valoreAttributo);&#xD;
				foundIDENTIFICATIVOCOS = true;&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
//SM_10091&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
   &amp;&amp; ConsistenzaRaccolta != null)&#xD;
{&#xD;
	//Se non sono in input, vanno recuperati dalla consistenza&#xD;
	if(!foundCODICETDKIT)&#xD;
	{&#xD;
		VerificaCOSsuKitDiRiferimentoRequest.codiceTdKit = ConsistenzaRaccolta.codiceTdKit;&#xD;
	}&#xD;
	&#xD;
	if(!foundCODICECLLI)&#xD;
	{&#xD;
		VerificaCOSsuKitDiRiferimentoRequest.clli = ConsistenzaRaccolta.codiceClli;&#xD;
	}&#xD;
	&#xD;
	if(!foundIDENTIFICATIVOCAR)&#xD;
	{&#xD;
		VerificaCOSsuKitDiRiferimentoRequest.identificativoCar = ConsistenzaRaccolta.identificativoCar;&#xD;
	}&#xD;
	&#xD;
	if(!foundSUPERMACROAREA)&#xD;
	{&#xD;
		VerificaCOSsuKitDiRiferimentoRequest.superMacroArea = ConsistenzaRaccolta.superMacroArea;&#xD;
	}&#xD;
	&#xD;
	if(!foundTIPOLOGIACLUSTERVLAN)&#xD;
	{&#xD;
		VerificaCOSsuKitDiRiferimentoRequest.CC_LIB = ConsistenzaRaccolta.tipologiaClusterVlan;&#xD;
	}&#xD;
	&#xD;
	if(!foundFAMIGLIAVLAN)&#xD;
	{&#xD;
		VerificaCOSsuKitDiRiferimentoRequest.famigliaVLAN = ConsistenzaRaccolta.famigliaVlan;&#xD;
	}&#xD;
	&#xD;
	if(ConsistenzaRaccolta.IDAsset != null &amp;&amp; !foundIDENTIFICATIVOCOS)&#xD;
	{	&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaRaccolta.IDAsset, 10));&#xD;
		Asset = AssetRef.readAsset();&#xD;
	&#xD;
		if(Asset != null)&#xD;
		{&#xD;
			for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
			{&#xD;
				var componente = Asset.dettaglioasset.get(i);&#xD;
			&#xD;
				if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
				{&#xD;
					for(var j=0; j&lt;componente.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var attributo = componente.attributidettaglioasset.get(j);&#xD;
					&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
						{&#xD;
							VerificaCOSsuKitDiRiferimentoRequest.identificaticoCos.add(attributo.valoreAttributo);&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_RgAwAeIGEeqeRbNUQWBXYw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_HVeOoOIGEeqeRbNUQWBXYw" xpdExt:Visibility="Public">
