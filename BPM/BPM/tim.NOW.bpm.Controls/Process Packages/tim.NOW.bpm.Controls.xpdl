        <xpdl2:Activity Id="_DW-tZyEDEeaub_W9_7VV0A" Name="VerificaCongruenzaVLANVULANGA" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Congruenza VLAN VULA-NGA">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var failed = false;&#xD;
var ENCAPSULATION =&quot;&quot;;&#xD;
var FLAG_ENCAPSULATIONList=DataUtil.createList();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!failed &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettaglioOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
				{&#xD;
					ENCAPSULATION = currentAttDettOrdine.valoreAttributo.toUpperCase();&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
				var z = 0;&#xD;
				while(z &lt; EsistenzaVLANOutput.size())&#xD;
				{&#xD;
					if(EsistenzaVLANOutput.get(z).IDDettaglioOrdine == currentDettaglioOrdine.IDDettaglioOrdine)&#xD;
					{&#xD;
						FLAG_ENCAPSULATIONList.add(EsistenzaVLANOutput.get(z).FLAG_ENCAPSULATION);&#xD;
						&#xD;
					}&#xD;
					z++;&#xD;
				}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	var n=0;&#xD;
	while(!failed &amp;&amp; n &lt; FLAG_ENCAPSULATIONList.size()){&#xD;
		if(ENCAPSULATION==&quot;SINGLETAG&quot;){&#xD;
			failed= FLAG_ENCAPSULATIONList.get(n)!=&quot;N&quot;;&#xD;
		}else if(ENCAPSULATION==&quot;DOUBLETAG&quot;){&#xD;
			failed= FLAG_ENCAPSULATIONList.get(n)!=&quot;Y&quot;;&#xD;
		}&#xD;
		&#xD;
		n++;&#xD;
	}&#xD;
	&#xD;
	&#xD;
	if(failed)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Flag incongruenti con l'encapsulation&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Flag congruenti con l'encapsulation&quot;;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
