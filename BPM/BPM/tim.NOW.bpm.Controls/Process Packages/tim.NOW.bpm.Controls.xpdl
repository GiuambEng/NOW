                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_YHMjsCMWEea7qJ_CMNwz5w" OperationName="VerificaCoppiaBandaPicco">
