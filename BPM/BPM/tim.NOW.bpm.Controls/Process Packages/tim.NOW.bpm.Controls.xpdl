          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">DetokenizzazioneRecapitiCFRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createGestioneDetokenizzazioneRecapitiCF_RequestType();&#xD;
&#xD;
DetokenizzazioneRecapitiCFRequest.codiceOrdineOlo = localRequest.codiceOrdineOLO;&#xD;
DetokenizzazioneRecapitiCFRequest.codificaOloAgcom = localRequest.codificaOLOAGCOM;&#xD;
DetokenizzazioneRecapitiCFRequest.idRichiesta = localRequest.IDRichiestaOLO;&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.referente != null &amp;&amp; localRequest.ordine.referente.size() > 0)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.referente.size(); i++)&#xD;
	{&#xD;
		var currentReferente = localRequest.ordine.referente.get(i);&#xD;
		&#xD;
		//Invio solo i referenti con flag_Token = SI&#xD;
		if(currentReferente.flag_Token == &quot;SI&quot;)&#xD;
		{&#xD;
			var ReferenteToken = com_tim_NOW_xsd_ControlliFormali_Factory.createReferenteToken();&#xD;
&#xD;
			ReferenteToken.IDRichiestaOLO = currentReferente.IDRichiestaOLO;&#xD;
			ReferenteToken.flag_Token = currentReferente.flag_Token;&#xD;
			ReferenteToken.progressivoReferente = currentReferente.progressivoReferente;&#xD;
			ReferenteToken.qualificaReferente = String(currentReferente.qualificaReferente);&#xD;
			ReferenteToken.telefonoFissoReferente = currentReferente.telefonoFissoReferente;&#xD;
			ReferenteToken.telefonoMobileReferente = currentReferente.telefonoMobileReferente;&#xD;
			ReferenteToken.tipoReferenteOrdine = String(currentReferente.tipoReferenteOrdine);&#xD;
			&#xD;
			DetokenizzazioneRecapitiCFRequest.referente.add(ReferenteToken);&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
