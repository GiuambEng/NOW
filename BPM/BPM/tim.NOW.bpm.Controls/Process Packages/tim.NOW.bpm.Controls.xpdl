        <xpdl2:Activity Id="_bKFZ8QllEeeDDtMDmF9rOw" Name="VerificaProfiloLinea" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Profilo Linea" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
