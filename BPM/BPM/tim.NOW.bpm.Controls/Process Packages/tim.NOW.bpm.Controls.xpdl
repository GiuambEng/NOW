          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Precondizione fallita per offerta: &quot;+localRequest.offerta;&#xD;
&#xD;
Process.auditLog(&quot;Controllo C04M01F220 saltato per precondizione: &quot; + EsitoResponse.descrizione);</xpdl2:Script>
