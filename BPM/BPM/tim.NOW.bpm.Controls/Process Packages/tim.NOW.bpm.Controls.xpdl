          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaVariazioneCarSupermacroareaRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createVerifica_Variazione_Car_SuperMacroArea_RequestType();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest != &quot;&quot; &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine != &quot;&quot;)&#xD;
{&#xD;
	VerificaVariazioneCarSupermacroareaRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
	VerificaVariazioneCarSupermacroareaRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
	VerificaVariazioneCarSupermacroareaRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
	VerificaVariazioneCarSupermacroareaRequest.sottoLavorazione = String(localRequest.tipologiaSottolav);&#xD;
&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
		if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
