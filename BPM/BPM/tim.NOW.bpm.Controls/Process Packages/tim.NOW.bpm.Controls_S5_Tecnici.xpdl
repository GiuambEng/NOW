            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="89.0" LaneId="_pWlyNYYiEeamBaXFXbQJ5A" Width="137.0">
              <xpdl2:Coordinates XCoordinate="274.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
