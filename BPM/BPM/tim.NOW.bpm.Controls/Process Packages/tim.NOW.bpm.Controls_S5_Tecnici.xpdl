        <xpdl2:Activity Id="_Eob5UJltEeex3ti7FqBMlw" Name="Precondizionefallita" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione fallita">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo CTRL INVENTORY saltato per precondizione&quot;;&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_pWlyLYYiEeamBaXFXbQJ5A" Width="96.0">
              <xpdl2:Coordinates XCoordinate="405.0" YCoordinate="77.0"/>
            </xpdl2:NodeGraphicsInfo>
