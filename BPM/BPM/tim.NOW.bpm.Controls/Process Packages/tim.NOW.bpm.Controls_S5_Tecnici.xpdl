    <xpdl2:WorkflowProcess Id="_pWlyIIYiEeamBaXFXbQJ5A" xpdExt:DisplayName="CTRL VI DN ATTIVO_C04M01F82" Name="CTRLVIDNATTIVO_C04M01F82">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_pWlyIoYiEeamBaXFXbQJ5A" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_pWmZOYYiEeamBaXFXbQJ5A" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_pWlyI4YiEeamBaXFXbQJ5A" Name="VIDNattivo" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="VI - DN attivo">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Esito Positivo&quot;;&#xD;
&#xD;
if(InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null &#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea!= null&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero!= null&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero.toUpperCase()== &quot;FOIP&quot;)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Esito Positivo, Numero fornito da Inventory è uguale a FOIP&quot;;&#xD;
}&#xD;
else if(String(localRequest.tipologiaScenario).slice(0,7) == &quot;NPSUTIF&quot; &amp;&amp;     //SM_9809: considerati tutti gli NPSUTIF*** e non il solo NPSUTIF&#xD;
		InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null) // RU_742&#xD;
{&#xD;
	if(InventoryOutput.CRMWSResponse.flag_Attivo == &quot;Y&quot;)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Esito Positivo, NPSUTIF, flag attivo impostato ad attivo&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Esito Negativo, NPSUTIF, flag attivo non impostato ad attivo&quot;;&#xD;
	}&#xD;
}&#xD;
else if(InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null&#xD;
	 &amp;&amp; InventoryOutput.CRMWSResponse.flag_Attivo == &quot;Y&quot;) // RU_742&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Esito Positivo, altro scenario, flag attivo impostato ad attivo&quot;;&#xD;
}&#xD;
else if(InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse.flag_Attivo != &quot;Y&quot;&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse.donating != null) // RU_742&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Esito Positivo, altro scenario, flag attivo non impostato ad attivo, donating valorizzato&quot;;	&#xD;
}&#xD;
else if(InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse.flag_Attivo != &quot;Y&quot;&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse.donating == null)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Esito Negativo&quot;;&#xD;
}&#xD;
// RU_813 - se siamo in Cautelare bisogna utilizzare lo statoNumerazione risalito da StopNGo in Gestione Esiti Tecnici&#xD;
else if(InventoryOutput == null &amp;&amp; localRequest.idTplgCautelare == 'Y' &amp;&amp; statoNumerazioneCAUT != null &amp;&amp; statoNumerazioneCAUT.toUpperCase() != 'ATTIVO')&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Esito Negativo - In CAUTELARE lo stato numerazione e' &quot;+statoNumerazioneCAUT;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
