                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL VI NS: Esito Negativo&quot;;&#xD;
&#xD;
if(InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse.donating != null)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VI NS: Esito Positivo&quot;;&#xD;
}&#xD;
else if(InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null &amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea != null&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea.flg_Num_Servizio != &quot;Y&quot;&#xD;
	/*&amp;&amp; InventoryOutput.CRMWSResponse.flag_Attivo == &quot;Y&quot;*/)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VI NS: Esito Positivo&quot;;&#xD;
}</xpdl2:Script>
