      </xpdl2:Activities>
      <xpdl2:Transitions>
        <xpdl2:Transition Id="_pWmZNIYiEeamBaXFXbQJ5A" xpdExt:DisplayName="" Name="" From="_pWmZM4YiEeamBaXFXbQJ5A" To="_pWmZMoYiEeamBaXFXbQJ5A">
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.StartAnchorPosition"/>
          </xpdl2:ConnectorGraphicsInfos>
        </xpdl2:Transition>
        <xpdl2:Transition Id="_289mIJVVEeaK6KCRIRatSw" xpdExt:DisplayName="" Name="" From="_yff-AJlsEeex3ti7FqBMlw" To="_pWmZM4YiEeamBaXFXbQJ5A">
          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var result = true;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
&amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEOLO){&#xD;
	result = false;&#xD;
	&#xD;
	if(localRequest.DNAggiuntivo != null &amp;&amp; localRequest.DNAggiuntivo.size()>0){&#xD;
		if(((localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR&#xD;
			&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
			&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
			&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
			&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA))&#xD;
		&amp;&amp;&#xD;
			(ConsistenzaFonia!= null &amp;&amp;&#xD;
			(ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLR&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEAATTIVA&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULL&#xD;
				|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULLLINEANONATTIVA))){&#xD;
		&#xD;
			result = true;&#xD;
		}&#xD;
		else if(ConsistenzaFonia!= null &amp;&amp; ConsistenzaDati!= null &amp;&amp; ConsistenzaFonia.codificaOLOAGCOMDonating == &quot;TLC&quot;){&#xD;
			result = true;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(localRequest.idTplgCautelare == 'Y' &amp;&amp; FlagRetryCautelare != 'Y') //RU_813 - saltare il controllo se siamo ancora in cautelare&#xD;
{																	 // SM_8664: aggiunta logica RetryCautelare, il controllo va saltato solo se FlagRetryCautelare è a Y (siamo in irrobustimentoNPCautelare)&#xD;
	result = false;&#xD;
}&#xD;
&#xD;
result;</xpdl2:Expression>
