        <xpdl2:Activity Id="_pWlyUYYiEeamBaXFXbQJ5A" Name="VerificaDataOrdineOLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica DataOrdine OLO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_RIQjcpVYEeaK6KCRIRatSw">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="true" Direction="IN" Formal="input.IDFileInput">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDFileInput</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="true" Direction="IN" Formal="input.IDRichiestaOLO">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="true" Direction="IN" Formal="input.codiceOLOAGCOM">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.codificaOLOAGCOM</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="true" Direction="IN" Formal="input.strutturaRichiesta">
