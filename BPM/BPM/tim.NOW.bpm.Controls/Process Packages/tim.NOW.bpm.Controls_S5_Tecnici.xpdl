          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="93.0" LaneId="_pWmZN4YiEeamBaXFXbQJ5A" Width="141.0">
