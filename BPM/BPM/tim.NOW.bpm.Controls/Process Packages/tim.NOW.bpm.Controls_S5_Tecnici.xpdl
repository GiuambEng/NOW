        <xpdl2:Activity Id="_pWmZM4YiEeamBaXFXbQJ5A" Name="InterrogazioneInventory" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Interrogazione Inventory">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_SMrYYpVZEeaK6KCRIRatSw">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="false" Direction="IN" Formal="input">
                      <xpdl2:Actual ScriptGrammar="JavaScript">InventoryInput</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageIn>
                <xpdl2:MessageOut Id="_SMrYY5VZEeaK6KCRIRatSw">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="output.esito.codice">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.codice</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="output.esito.descrizione">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.descrizione</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="false" Direction="OUT" Formal="output">
                      <xpdl2:Actual ScriptGrammar="JavaScript">InventoryOutput</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_ZPcicJVXEeaK6KCRIRatSw" OperationName="InterrogazioneInventory">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="CheckServiceNP_PortTypeSOAP" ServiceName="CheckServiceNP_PortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="BPM_CheckServiceNP.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="CheckServiceNP_PortType" OperationName="InterrogazioneInventory">
                  <xpdExt:ExternalReference location="BPM_CheckServiceNP.wsdl"/>
                </xpdExt:PortTypeOperation>
              </xpdl2:TaskService>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:Performers>
            <xpdl2:Performer>_ZPcicJVXEeaK6KCRIRatSw</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="91.0" LaneId="_pWlyLYYiEeamBaXFXbQJ5A" Width="136.0">
              <xpdl2:Coordinates XCoordinate="405.0" YCoordinate="243.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">InventoryInput = com_tim_NOW_xsd_ControlliAmmessiNP_Factory.createInterrogazione_Inventory_Request();&#xD;
&#xD;
InventoryInput.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
InventoryInput.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
InventoryInput.id_Task = Process.getParentProcessId();&#xD;
InventoryInput.flagCautelare = FlagRetryCautelare; // RU_813&#xD;
InventoryInput.flagDelibera103 = localRequest.flagDelibera103; //RU_1346&#xD;
&#xD;
//Bug #34049&#xD;
InventoryInput.tipologiaScenario = String(localRequest.tipologiaScenario);&#xD;
&#xD;
//Bug #34049&#xD;
if(ConsistenzaFonia != null)&#xD;
{&#xD;
	InventoryInput.aggiuntivoWLR = ConsistenzaFonia.aggiuntivoWLR;&#xD;
}&#xD;
&#xD;
var i = 0;&#xD;
while((InventoryInput.tipoLineaOLO == null || InventoryInput.flagNPNumerazioniAggiuntive == null) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
	{&#xD;
		var y = 0;&#xD;
		while((InventoryInput.tipoLineaOLO == null || InventoryInput.flagNPNumerazioniAggiuntive == null) &amp;&amp; y &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(y);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUMERAZIONIAGGIUNTIVE)&#xD;
			{&#xD;
				InventoryInput.flagNPNumerazioniAggiuntive = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			//Bug #34049&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAOLO)&#xD;
			{&#xD;
				InventoryInput.tipoLineaOLO = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			y++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(NumeroTelefonico!= null &amp;&amp; NumeroTelefonico!= &quot;&quot;)&#xD;
{&#xD;
	InventoryInput.numeroTelefonicoNP = NumeroTelefonico;&#xD;
}&#xD;
else&#xD;
{&#xD;
	if(localRequest.numeroTelefonico!= null)&#xD;
	{&#xD;
		InventoryInput.numeroTelefonicoNP = localRequest.numeroTelefonico;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		var numero = &quot;&quot;;&#xD;
		numero = null;&#xD;
		var i=0;&#xD;
		&#xD;
		while(numero == null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())  //PROP SM_9427&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) ==&quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j=0;&#xD;
				&#xD;
				while(numero == null &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())   //PROP SM_9427&#xD;
				{&#xD;
					var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO){&#xD;
						numero = attr.valoreAttributo;&#xD;
					}&#xD;
					else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN){&#xD;
						numero = attr.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;	&#xD;
		}&#xD;
		InventoryInput.numeroTelefonicoNP = numero;&#xD;
	}&#xD;
}&#xD;
&#xD;
NumeroTelefonico = InventoryInput.numeroTelefonicoNP;&#xD;
Process.auditLog(&quot;NumeroTelefonico utilizzato:&quot;+NumeroTelefonico);</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">InventoryOutput.numero_Telefonico=InventoryInput.numeroTelefonicoNP;&#xD;
&#xD;
/* ----------------------------Bug #34049 :COMMENTATO TUTTO IL COMPLETE SCRIPT&#xD;
&#xD;
// RU_857: valorizzazione AGGIUNTIVOWLR di NP come da SF 7.64&#xD;
//Il parameter verrà aggiunto all'ordine NELL'ARRICCHIMENTO DETTAGLIO ORDINE (Attivazione NP). Anticipato con la RU_919 per le logiche sull'output di CTRL INVENTORY.&#xD;
if((ConsistenzaFonia !=  null &amp;&amp; ConsistenzaFonia.aggiuntivoWLR == 'Y'&#xD;
	 &amp;&amp; InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null &amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea != null&#xD;
	 &amp;&amp;(InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero == &quot;GENERICA&quot; &#xD;
	 || InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;LINEA PBX&quot;&#xD;
	 || (InventoryOutput.aggiuntiviUnica != null &amp;&amp; InventoryOutput.aggiuntiviUnica.size()>0))))&#xD;
{&#xD;
	AggiuntivoWLR = 'Y';&#xD;
}&#xD;
else&#xD;
{&#xD;
	AggiuntivoWLR = 'N';&#xD;
}&#xD;
&#xD;
// Se il controllo non ha scartato, logiche di compatibilità  - STRAVOLTE CON SF 7.108 (RU_931)&#xD;
if(EsitoResponse.codice)&#xD;
{&#xD;
	var TIPOLINEAOLO = &quot;&quot;;&#xD;
	TIPOLINEAOLO = null;&#xD;
&#xD;
	// RECUPERO TIPO LINEA inviato da OLO&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			var j = 0;&#xD;
			&#xD;
			while(TIPOLINEAOLO == null &amp;&amp;  j&lt; currentComponente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
			 &#xD;
				if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAOLO)&#xD;
				{&#xD;
					TIPOLINEAOLO = currentAttributo.valoreAttributo;&#xD;
				}&#xD;
			 &#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	if(InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null &amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea != null)&#xD;
	{&#xD;
		if(AggiuntivoWLR == 'N')&#xD;
		{&#xD;
			if(InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero == &quot;AGGIUNTIVO&quot;)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;KO - tipo_Numero: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero+&quot;, banda_Servizio: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.banda_Servizio+&quot;, tipo_Servizio: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio+&quot;, TIPOLINEAOLO: &quot;+TIPOLINEAOLO;&#xD;
			}&#xD;
			else if((InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero == &quot;GNR RADICALE&quot;&#xD;
			      || InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero == &quot;RADICALE ACCORPATO&quot;&#xD;
				  || InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero == &quot;GNR LINEE&quot;)&#xD;
				  &amp;&amp; (TIPOLINEAOLO == '1' || TIPOLINEAOLO == '2'))&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;OK - tipo_Numero: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero+&quot;, banda_Servizio: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.banda_Servizio+&quot;, tipo_Servizio: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio+&quot;, TIPOLINEAOLO: &quot;+TIPOLINEAOLO;				&#xD;
			}&#xD;
			else if(TIPOLINEAOLO == null || TIPOLINEAOLO == '0' || TIPOLINEAOLO == '3')&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;OK - tipo_Numero: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero+&quot;, banda_Servizio: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.banda_Servizio+&quot;, tipo_Servizio: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio+&quot;, TIPOLINEAOLO: &quot;+TIPOLINEAOLO;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;KO - tipo_Numero: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero+&quot;, banda_Servizio: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.banda_Servizio+&quot;, tipo_Servizio: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio+&quot;, TIPOLINEAOLO: &quot;+TIPOLINEAOLO;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			if(InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero == &quot;GENERICA&quot;&#xD;
			&amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio == &quot;LINEA PBX&quot;&#xD;
			&amp;&amp; (TIPOLINEAOLO == null || TIPOLINEAOLO == '0' || TIPOLINEAOLO == '3'))&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;OK - tipo_Numero: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero+&quot;, banda_Servizio: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.banda_Servizio+&quot;, tipo_Servizio: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio+&quot;, TIPOLINEAOLO: &quot;+TIPOLINEAOLO;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;KO - tipo_Numero: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero+&quot;, banda_Servizio: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.banda_Servizio+&quot;, tipo_Servizio: &quot;+InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio+&quot;, TIPOLINEAOLO: &quot;+TIPOLINEAOLO;&#xD;
			}			&#xD;
		}&#xD;
	&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.descrizione = &quot;KO ricevuto da servizio InterrogazioneInventory&quot;;&#xD;
}&#xD;
&#xD;
Log.write(&quot;CTRL INVENTORY [&quot;+localRequest.IDRichiestaOLO+&quot;] - &quot;+EsitoResponse.descrizione);&#xD;
&#xD;
*/&#xD;
&#xD;
&#xD;
//RU_1030: In caso di Scenario = NPDEL82 e si ha un KO sul controllo (da Inventory o sul BPM), proseguire come se si avesse un OK &#xD;
//e procedere all’arricchimento di TIPONUMERO di DATIUNICA con &quot;NATIVO VOIP IMS&quot;&#xD;
if(!EsitoResponse.codice &amp;&amp; InventoryOutput != null&#xD;
   &amp;&amp; localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNPDEL82)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Scenario:&quot; + localRequest.tipologiaScenario + &quot;ed EsitoResponse.codice:&quot; + EsitoResponse.codice;&#xD;
&#xD;
	//Scarto da Inventory (datiUnica non restituita)&#xD;
	if(InventoryOutput.datiUnica == null)&#xD;
    {&#xD;
        InventoryOutput.datiUnica = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createDatiUnicaType();&#xD;
		&#xD;
		//Se è null, ci metto quello in input&#xD;
		if(InventoryOutput.numero_Telefonico == null)&#xD;
		{&#xD;
			InventoryOutput.numero_Telefonico = NumeroTelefonico;&#xD;
		}&#xD;
    }&#xD;
   &#xD;
    InventoryOutput.datiUnica.tipoNumero = &quot;NATIVO VOIP IMS&quot;;	&#xD;
}&#xD;
&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_2Y8TEZVVEeaK6KCRIRatSw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_ycH44IWWEeaXXpJ4oYybYg" xpdExt:Visibility="Public">
          <xpdl2:Event>
