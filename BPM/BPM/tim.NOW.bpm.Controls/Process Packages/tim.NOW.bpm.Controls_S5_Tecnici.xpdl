                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="43.0" LaneId="_pWlyLYYiEeamBaXFXbQJ5A" Width="41.0">
              <xpdl2:Coordinates XCoordinate="211.0" YCoordinate="243.0"/>
