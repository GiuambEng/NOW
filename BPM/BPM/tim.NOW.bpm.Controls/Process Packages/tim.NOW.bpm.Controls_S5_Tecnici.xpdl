    <xpdl2:WorkflowProcess Id="_pWlyVIYiEeamBaXFXbQJ5A" xpdExt:DisplayName="CTRL VI Tipo Linea_C04M01F83" Name="CTRLVITipoLinea_C04M01F83">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_-3YSAAsUEee03cNoTQEl9g" xpdExt:DisplayName="Asset" Name="Asset">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_AhfqcAsVEee03cNoTQEl9g" xpdExt:DisplayName="AssetRef" Name="AssetRef">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_pWlyVoYiEeamBaXFXbQJ5A" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_pWlyN4YiEeamBaXFXbQJ5A" Width="31.0">
              <xpdl2:Coordinates XCoordinate="762.0" YCoordinate="260.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_pWlyV4YiEeamBaXFXbQJ5A" Name="VITipoLinea" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="VI – Tipo Linea">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;&quot;;&#xD;
&#xD;
//TIPOLINEA&#xD;
var tipoLineaAtt = &quot;&quot;;&#xD;
tipoLineaAtt = null;&#xD;
&#xD;
var i = 0;&#xD;
while(tipoLineaAtt == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(tipoLineaAtt == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAOLO)&#xD;
			{&#xD;
				tipoLineaAtt = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
//TIPOSERVIZIO&#xD;
var tipoServizio = &quot;&quot;;&#xD;
tipoServizio = null;&#xD;
&#xD;
if(InventoryOutput != null&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse != null&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea != null&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio != null)&#xD;
{&#xD;
	tipoServizio = InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Servizio;&#xD;
}&#xD;
&#xD;
//TIPONUMERO&#xD;
var tipoNumero = &quot;&quot;;&#xD;
tipoNumero = null;&#xD;
&#xD;
if(InventoryOutput != null&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse != null&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea != null&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero != null)&#xD;
{&#xD;
	tipoNumero = InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero;&#xD;
}&#xD;
&#xD;
//BANDA SERVIZIO&#xD;
var bandaServizio = &quot;&quot;;&#xD;
bandaServizio = null;&#xD;
if(InventoryOutput != null &#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse != null&#xD;
	&amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea.banda_Servizio != null)&#xD;
{&#xD;
	bandaServizio = InventoryOutput.CRMWSResponse.tipo_Linea.banda_Servizio;&#xD;
}&#xD;
&#xD;
//DNAGGIUNTIVI&#xD;
var DNaggiuntivi = DataUtil.createList();&#xD;
&#xD;
//SM_11001: per DEL 103 gli unici aggiuntivi da considerare per questo controllo sono quelli ISDN che vengono mappati in aggiuntiviUnica&#xD;
if(localRequest.flagDelibera103 == 'Y')   &#xD;
{	&#xD;
	if(InventoryOutput != null &amp;&amp; InventoryOutput.aggiuntiviUnica != null &amp;&amp; InventoryOutput.aggiuntiviUnica.size()>0)&#xD;
	{&#xD;
		for(var z = 0; z &lt; InventoryOutput.aggiuntiviUnica.size(); z++)&#xD;
		{&#xD;
		DNaggiuntivi.add(InventoryOutput.aggiuntiviUnica.get(z).numeroTelefonico);&#xD;
		}&#xD;
	}		&#xD;
}&#xD;
//solito&#xD;
else if(InventoryOutput != null&#xD;
		&amp;&amp; InventoryOutput.CRMWSResponse != null&#xD;
		&amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea != null&#xD;
		&amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea.aggiuntivi != null)&#xD;
{	&#xD;
	for(var z = 0; z &lt; InventoryOutput.CRMWSResponse.tipo_Linea.aggiuntivi.linee.item.size(); z++)&#xD;
	{&#xD;
		DNaggiuntivi.add(InventoryOutput.CRMWSResponse.tipo_Linea.aggiuntivi.linee.item.get(z).DN);&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
if(localRequest.flagDelibera103 == 'Y') //RU_1346: AGGIUNTE CASISTICHE NP D103&#xD;
{&#xD;
	if(DNaggiuntivi != null &amp;&amp; DNaggiuntivi.size()>0 &amp;&amp; DNaggiuntivi.contains(localRequest.numeroTelefonico) //Bug #41778&#xD;
	    &amp;&amp;(ConsistenzaFonia == null || String(ConsistenzaFonia.offerta).slice(0,3) != 'WLR' || ConsistenzaFonia.strutturaLinea != 'PBX'))&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Controllo C04M01F83 fallito: Il DN della richiesta corrisponde al DN di una lavorazione aggiuntiva tornata da Inventory&quot;;&#xD;
	}&#xD;
	else if (tipoServizio == &quot;CAPOSERIE&quot; &#xD;
		|| tipoServizio == &quot;ISDN BMU&quot; &#xD;
		|| tipoServizio == &quot;LINEA PBX&quot;)&#xD;
	{		&#xD;
		if (tipoLineaAtt == &quot;0&quot;)//SM_10889&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Controllo C04M01F83 fallito: Mancata congruenza - caso complesso D103. TipoServizio: &quot; + tipoServizio + &quot; TipoLinea: &quot; + tipoLineaAtt;&#xD;
		}else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Controllo C04M01F83 positivo: Mancata congruenza - caso complesso D103. TipoServizio: &quot; + tipoServizio + &quot; TipoLinea: &quot; + tipoLineaAtt;&#xD;
		}				&#xD;
	}&#xD;
	else if (tipoNumero == &quot;GNR RADICALE&quot; &#xD;
		|| tipoNumero == &quot;RADICALE ACCORPATO&quot; &#xD;
		|| tipoNumero == &quot;GNR LINEE&quot;)		&#xD;
	{		&#xD;
		if (tipoLineaAtt == &quot;1&quot;)//SM_10889&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Controllo C04M01F83 positivo: Trovata congruenza - caso complesso D103. TipoNumero: &quot; + tipoNumero + &quot; TipoLinea: &quot; + tipoLineaAtt;&#xD;
		}else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Controllo C04M01F83 fallito: Mancata congruenza - caso complesso D103. TipoNumero: &quot; + tipoNumero + &quot; TipoLinea: &quot; + tipoLineaAtt;&#xD;
		}		&#xD;
	}&#xD;
	else&#xD;
	{		&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Controllo C04M01F83 positivo: Trovata congruenza - caso generico D103. TipoNumero: &quot; + tipoNumero + &quot; TipoServizio: &quot; + tipoServizio + &quot; TipoLinea: &quot; + tipoLineaAtt;		&#xD;
	}	&#xD;
}&#xD;
else&#xD;
{&#xD;
	//STEP1&#xD;
	if(InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null &amp;&amp; InventoryOutput.CRMWSResponse.donating != null)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Controllo C04M01F83 positivo: Trovato campo Donating&quot;;&#xD;
	}&#xD;
&#xD;
	//STEP2&#xD;
	else if(tipoServizio != null&#xD;
			&amp;&amp; (tipoServizio == &quot;ALICE MIA&quot;&#xD;
				|| tipoServizio == &quot;ALICE NAKED&quot;&#xD;
				|| tipoServizio == &quot;BMO IP CENTREX&quot;&#xD;
				|| tipoServizio == &quot;FONIA IP PBX&quot;&#xD;
				|| tipoServizio == &quot;FONIA IP PBX P&quot;&#xD;
				|| tipoServizio == &quot;FONIA VPBX TOP&quot;&#xD;
				|| tipoServizio == &quot;RTG IP CENTREX&quot;&#xD;
				|| tipoServizio == &quot;VPBX BASIC&quot;&#xD;
				|| tipoServizio == &quot;VPBX PLUS&quot;))&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Controllo C04M01F83 positivo: TipoServizio VOIP (ma non GNR). TipoServizio: &quot; + tipoServizio;&#xD;
	}&#xD;
	//STEP3&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &amp;&amp; &#xD;
				((tipoServizio == &quot;ISDN&quot;&#xD;
				|| tipoServizio == &quot;ISDN BMO&quot;&#xD;
				|| tipoServizio == &quot;ISDN BMU&quot;&#xD;
				|| tipoServizio == &quot;ISDN PRA&quot;)&#xD;
				|| &#xD;
				((tipoServizio == &quot;CAPOSERIE&quot; || tipoServizio == &quot;LINEA PBX&quot;) &amp;&amp; (bandaServizio == 'ISDN BRA' || bandaServizio == 'ISDN PRA'))&#xD;
				||&#xD;
				((tipoServizio == &quot;RADICALE&quot; || tipoServizio == &quot;SPE&quot; || tipoServizio == &quot;SPU&quot;) &#xD;
					&amp;&amp; (bandaServizio == &quot;ISDN BRA&quot; || bandaServizio == &quot;ISDN PRA&quot;))))&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Controllo C04M01F83 positivo: Lavorazione di tipo CESSAZIONE e TipoServizio ISDN. TipoServizio: &quot; + tipoServizio;&#xD;
	}&#xD;
&#xD;
	//STEP 4 - Bug #41778&#xD;
	else if(DNaggiuntivi.contains(localRequest.numeroTelefonico) &#xD;
	 &amp;&amp;(ConsistenzaFonia == null || String(ConsistenzaFonia.offerta).slice(0,3) != 'WLR' || ConsistenzaFonia.strutturaLinea != 'PBX'))&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Controllo C04M01F83 fallito: Il DN della richiesta corrisponde al DN di una lavorazione aggiuntiva tornata da Inventory&quot;;&#xD;
	}&#xD;
&#xD;
	//STEP5&#xD;
	else&#xD;
	{&#xD;
		//caso GNR&#xD;
		if(tipoLineaAtt == &quot;1&quot; || tipoLineaAtt ==  &quot;2&quot;)&#xD;
		{	&#xD;
			if(tipoNumero == &quot;GNR RADICALE&quot;	|| tipoNumero == &quot;RADICALE ACCORPATO&quot; || tipoNumero == &quot;GNR LINEE&quot;)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;Controllo C04M01F83 positivo: Trovata congruenza riga 1 o 3. TipoNumero: &quot; + tipoNumero + &quot; TipoServizio: &quot; + tipoServizio + &quot; TipoLinea: &quot; + tipoLineaAtt;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Controllo C04M01F83 fallito: Mancata congruenza - caso generico GNR. TipoNumero: &quot; + tipoNumero + &quot; TipoServizio: &quot; + tipoServizio + &quot; TipoLinea: &quot; + tipoLineaAtt;&#xD;
			}&#xD;
		}&#xD;
		//caso non GNR&#xD;
		else if(tipoNumero == &quot;GNR RADICALE&quot; || tipoNumero == &quot;RADICALE ACCORPATO&quot; || tipoNumero == &quot;GNR LINEE&quot;)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Controllo C04M01F83 fallito: Mancata congruenza - riga 2 o 4. TipoNumero: &quot; + tipoNumero + &quot; TipoServizio: &quot; + tipoServizio + &quot; TipoLinea: &quot; + tipoLineaAtt;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Controllo C04M01F83 positivo: Trovata congruenza caso generico non GNR. TipoNumero: &quot; + tipoNumero + &quot; TipoServizio: &quot; + tipoServizio + &quot; TipoLinea: &quot; + tipoLineaAtt;&#xD;
		}&#xD;
&#xD;
	}&#xD;
&#xD;
	// ------------ RU_813 - SF in progress 7.17 --- CASO IN CAUTELARE ------------&#xD;
	if(localRequest.idTplgCautelare == 'Y')&#xD;
	{&#xD;
		if(tipoConnettivitaCAUT == 'GNR')&#xD;
		{&#xD;
