    <xpdl2:WorkflowProcess Id="_pWlyOIYiEeamBaXFXbQJ5A" xpdExt:DisplayName="CTRL AGGIUNTIVI_C04M01F84" Name="CTRLAGGIUNTIVI_C04M01F84">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_pWlyOoYiEeamBaXFXbQJ5A" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_pWlyNYYiEeamBaXFXbQJ5A" Width="30.0">
              <xpdl2:Coordinates XCoordinate="515.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_pWlyO4YiEeamBaXFXbQJ5A" Name="VerificaFlagAggiuntivi" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Flag Aggiuntivi" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Esito Negativo&quot;;&#xD;
&#xD;
var foundTipoLineaOLO = false;&#xD;
var isISDN = false;&#xD;
var foundFlagAggiuntivo = false;&#xD;
&#xD;
var i = 0;&#xD;
while((!foundTipoLineaOLO || !foundFlagAggiuntivo) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
	{&#xD;
		var y = 0;&#xD;
		while((!foundTipoLineaOLO || !foundFlagAggiuntivo) &amp;&amp; y &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(y);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAOLO)&#xD;
			{&#xD;
				foundTipoLineaOLO = true;&#xD;
				if(currentAttDettOrdine.valoreAttributo == &quot;3&quot;)&#xD;
				{&#xD;
					isISDN = true;&#xD;
				}&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUMERAZIONIAGGIUNTIVE)&#xD;
			{&#xD;
				foundFlagAggiuntivo = true;&#xD;
			}&#xD;
			y++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(isISDN &amp;&amp; foundFlagAggiuntivo)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Controllo C04M01F84 superato: TipoLineaNP di tipo ISDN e FLAGNUMERAZIONIAGGIUNTIVE valorizzato&quot;;&#xD;
}&#xD;
else if(isISDN)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Controllo C04M01F84 fallito: FLAGNUMERAZIONIAGGIUNTIVE non valorizzato per TipoLineaNP ISDN&quot;;&#xD;
}&#xD;
else &#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Controllo C04M01F84 superato: TipoLineaNP non di tipo ISDN&quot;;&#xD;
}&#xD;
&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
