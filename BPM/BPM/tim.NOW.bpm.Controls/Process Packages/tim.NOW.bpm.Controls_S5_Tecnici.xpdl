        <xpdl2:Activity Id="_pWlyMYYiEeamBaXFXbQJ5A" Name="VerificaCodiceOrdineOLOsuCRMWS" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica CodiceOrdineOLO su CRMWS">
