			}&#xD;
		}&#xD;
		else if(tipoConnettivitaCAUT == 'RTG')&#xD;
		{&#xD;
			if(tipoLineaAtt == &quot;1&quot; || tipoLineaAtt ==  &quot;2&quot; || tipoLineaAtt == &quot;3&quot;)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;CASO CAUTELARE - Controllo C04M01F83 negativo: TipoConnettivitaCRMCAUT: &quot; + tipoConnettivitaCAUT + &quot; TipoLineaOrdine: &quot; + tipoLineaAtt;	&#xD;
