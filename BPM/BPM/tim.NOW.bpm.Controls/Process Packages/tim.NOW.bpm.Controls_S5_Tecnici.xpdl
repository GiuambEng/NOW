                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="true" Direction="IN" Formal="input.dataInvioRichiesta">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.dataInvioRichiesta</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageIn>
                <xpdl2:MessageOut Id="_RIQjc5VYEeaK6KCRIRatSw">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="output.esito.codice">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.codice</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="output.esito.descrizione">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.descrizione</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_ZPcicJVXEeaK6KCRIRatSw" OperationName="VerificaDataOrdineOLO">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="CheckServiceNP_PortTypeSOAP" ServiceName="CheckServiceNP_PortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="BPM_CheckServiceNP.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="CheckServiceNP_PortType" OperationName="VerificaDataOrdineOLO">
                  <xpdExt:ExternalReference location="BPM_CheckServiceNP.wsdl"/>
                </xpdExt:PortTypeOperation>
              </xpdl2:TaskService>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:Performers>
            <xpdl2:Performer>_ZPcicJVXEeaK6KCRIRatSw</xpdl2:Performer>
