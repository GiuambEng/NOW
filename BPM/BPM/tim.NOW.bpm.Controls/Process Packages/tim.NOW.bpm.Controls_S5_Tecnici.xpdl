            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_pXj3EvVLEeesndeHLwm53Q" Name="VIVerificaAllineamentoDonating" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="VI - Verifica Allineamento Donating">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
if (InventoryOutput!= null &amp;&amp; InventoryOutput.CRMWSResponse != null &amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea!=null &#xD;
	&amp;&amp;	InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero!=null &amp;&amp;&#xD;
	InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Numero.toUpperCase() == &quot;FOIP&quot;)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VI DB ALLINEATO TIPO NUMERO FOIP: Esito Positivo&quot;;&#xD;
&#xD;
}&#xD;
else if( localRequest.ordine.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUTIF)&#xD;
{&#xD;
	&#xD;
	if(InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null &amp;&amp;&#xD;
	InventoryOutput.CRMWSResponse.donating == null &amp;&amp;  InventoryOutput.CRMWSResponse.flag_Attivo == 'Y')&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VI DB ALLINEATO PRIMAPORTABILITA: Esito Positivo&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VI DB ALLINEATO PRIMAPORTABILITA: Esito Negativo&quot;;&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
else if (localRequest.tipoComunicazioneNP == it_telecomitalia_it_NOW_casedata_TipologiaComunicazioneNPEnumeration.PRENOTIFICADONATING)&#xD;
{&#xD;
	if(InventoryOutput != null &amp;&amp; InventoryOutput.CRMWSResponse != null&#xD;
	 &amp;&amp;  InventoryOutput.CRMWSResponse.flag_Attivo == 'Y' &#xD;
	 &amp;&amp; InventoryOutput.CRMWSResponse.tipo_Linea.tipo_Portabilita == 'RECIPIENT')&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VI DB ALLINEATO DONOROLO: Esito Positivo&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VI DB ALLINEATO DONOROLO: Esito Negativo&quot;;&#xD;
	}&#xD;
&#xD;
			&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VI DB ALLINEATO: skip&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
