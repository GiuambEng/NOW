    <xpdl2:WorkflowProcess Id="_k9ag8CRbEeeAUIVIBex-Zw" xpdExt:DisplayName="CTRL CONGRUENZA OLO CODING_C04M04F02" Name="CTRLCONGRUENZAOLOCODING_C04M04F02">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_k9eLUSRbEeeAUIVIBex-Zw" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_k9ag8iRbEeeAUIVIBex-Zw" Width="31.0">
              <xpdl2:Coordinates XCoordinate="555.0" YCoordinate="222.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_k9eLUiRbEeeAUIVIBex-Zw" Name="VerificacongruenzaOLOCoding" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica congruenza OLO Coding" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
if(localRequest.IDCorrelazione.slice(0, 3) == localRequest.codificaOLOAGCOM)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL CONGRUENZA OLO CODING positivo. CodiceCorrelazione: &quot; + localRequest.IDCorrelazione + &quot; CodificaOLOAGCOM: &quot; + localRequest.codificaOLOAGCOM;&#xD;
}&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &#xD;
		&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP&#xD;
		&amp;&amp; localRequest.IDCorrelazione.slice(0, 3) == localRequest.codificaOLOAGCOMDonating)&#xD;
{&#xD;
	EsitoResponse.codice = true;   // SM_8545&#xD;
	EsitoResponse.descrizione = &quot;CTRL CONGRUENZA OLO CODING positivo. CodiceCorrelazione: &quot; + localRequest.IDCorrelazione + &quot; CodificaOLOAGCOMDONATING: &quot; + localRequest.codificaOLOAGCOMDonating;&#xD;
&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL CONGRUENZA OLO CODING fallito. CodiceCorrelazione: &quot; + localRequest.IDCorrelazione + &quot; CodificaOLOAGCOM: &quot; + localRequest.codificaOLOAGCOM;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
