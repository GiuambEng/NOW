    <xpdl2:WorkflowProcess Id="_fWHPUCRdEeeAUIVIBex-Zw" xpdExt:DisplayName="CTRL IDENTIFICATIVO PACCHETTO_C04M04F03" Name="CTRLIDENTIFICATIVOPACCHETTO_C04M04F03">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_fWJrkSRdEeeAUIVIBex-Zw" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_fWH2YSRdEeeAUIVIBex-Zw" Width="31.0">
              <xpdl2:Coordinates XCoordinate="578.0" YCoordinate="258.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_fWJrkiRdEeeAUIVIBex-Zw" Name="VerificaIdentificativoPacchetto" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Identificativo Pacchetto" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
if(localRequest.IDCorrelazione.length == 10)&#xD;
{&#xD;
	var slicedIDCorrelazione = localRequest.IDCorrelazione.slice(5);&#xD;
	var failed = false;&#xD;
	var i = 0;&#xD;
	&#xD;
	while(!failed &amp;&amp; i &lt; slicedIDCorrelazione.length)&#xD;
	{&#xD;
		var currentCharCode = slicedIDCorrelazione.charCodeAt(i);&#xD;
		if(currentCharCode &lt; 48 || currentCharCode > 57)&#xD;
		{&#xD;
			//trovato un carattere non numerico&#xD;
			failed = true;&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL IDENTIFICATIVO PACCHETTO fallito. Trovato un carattere non numerico in posizione: &quot; + i + &quot; per IDCorrelazione: &quot; + localRequest.IDCorrelazione;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(!failed)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL IDENTIFICATIVO PACCHETTO positivo. IDCorrelazione: &quot; + localRequest.IDCorrelazione;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL IDENTIFICATIVO PACCHETTO fallito. Lunghezza diversa da 10 per IDCorrelazione: &quot; + localRequest.IDCorrelazione;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="86.0" LaneId="_fWH2YSRdEeeAUIVIBex-Zw" Width="125.0">
              <xpdl2:Coordinates XCoordinate="336.0" YCoordinate="258.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
