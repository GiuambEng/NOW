        <xpdl2:Activity Id="_VcVB5D5AEei7IcgYfvd3tQ" Name="VerificaAccensioneRicaricastessoOLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Accensione Ricarica stesso OLO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">&#xD;
EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo Verifica Accensione Ricarica stesso OLO superato&quot;;&#xD;
&#xD;
&#xD;
&#xD;
	//Cerco la ricarica ACCESA da spegnere&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.createCriteria(&quot;IDAsset =: IDAssetAccessoDinamico AND statoAsset = 'ACCESA'&quot;);&#xD;
	c.setQueryParameter(&quot;IDAssetAccessoDinamico&quot;,ScriptUtil.createBigInteger(IDAssetAccessoDinamico));&#xD;
	&#xD;
	&#xD;
	ResultAssetRicRef = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.findByCriteria(c);	&#xD;
	&#xD;
	&#xD;
	if (ResultAssetRicRef != null &amp;&amp; ResultAssetRicRef.size()>0)&#xD;
	{&#xD;
	&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Controllo Verifica Accensione Ricarica stesso OLO fallito - presenti altre ricariche accese&quot;;&#xD;
	}&#xD;
	&#xD;
	else &#xD;
	{&#xD;
	&#xD;
		// cerco se sono presenti per lo stesso IDRISORSA lavorazioni di accensione o spegnimento in corso&#xD;
		var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;IDRisorsa =: IDRisorsa AND tipoRichiesta='RICARICA' AND statoRichiestaNOW NOT IN ('ESPLETAMENTOTECNICOKO','SCARTATO','CHIUSO') AND lavorazione IN ('SPEGNIMENTO','ACCENSIONE') AND IDRichiestaOLO&lt;>: pvm&quot;);&#xD;
		criteria.setQueryParameter(&quot;IDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
		criteria.setQueryParameter(&quot;pvm&quot;,localRequest.IDRichiestaOLO);&#xD;
		&#xD;
		&#xD;
		ResultRequestRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
		&#xD;
		if (ResultRequestRef != null || ResultRequestRef.size()>0)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Controllo Verifica Accensione Ricarica stesso OLO fallito - presenti lavorazioni in corso di accensione/spegnimento&quot;;&#xD;
		}&#xD;
		&#xD;
		&#xD;
	&#xD;
	}&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
