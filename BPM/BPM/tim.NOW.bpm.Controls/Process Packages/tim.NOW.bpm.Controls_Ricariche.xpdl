        <xpdl2:Activity Id="_C25qlbOXEemNxbfuHsTQAg" Name="VerificaNumeroOrdineRichiesta" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Numero Ordine Richiesta">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo OK&quot;;&#xD;
&#xD;
if(IDAssetRicarica == &quot;NON PRESENTE&quot;)&#xD;
{&#xD;
	CodiceEsito = &quot;KO_01&quot;;&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Controllo fallito con codice esito KO_01, IDAssetRicarica: &quot;+IDAssetRicarica;&#xD;
}&#xD;
else if(IDAssetRicarica != null)&#xD;
{&#xD;
	var c = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.createCriteria(&quot;IDAssetRicarica =: IDAssetRicarica&quot;);&#xD;
	c.setQueryParameter(&quot;IDAssetRicarica&quot;,ScriptUtil.createBigInteger(IDAssetRicarica));&#xD;
	&#xD;
	AssetRicaricaRef = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.findByCriteria(c);&#xD;
&#xD;
	// SM_8819: logica su congruenza della risorsa dinamica di riferimento aggiunta&#xD;
	if (AssetRicaricaRef != null &amp;&amp; AssetRicaricaRef.size()>0)&#xD;
	{&#xD;
		AssetRicarica = AssetRicaricaRef.get(0).readAssetRicarica();&#xD;
		&#xD;
		var c2 = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDAsset =: IDAsset&quot;);&#xD;
		c2.setQueryParameter(&quot;IDAsset&quot;,ScriptUtil.createBigInteger(AssetRicarica.IDAsset));&#xD;
		&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c2);&#xD;
		&#xD;
		if (AssetRef != null &amp;&amp; AssetRef.size()>0)&#xD;
		{&#xD;
			Asset = AssetRef.get(0).readAsset();&#xD;
			&#xD;
			if(localRequest.IDRisorsa == Asset.IDRisorsa)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;Controllo OK, asset con IDAssetRicarica &quot;+IDAssetRicarica+&quot; trovato&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Controllo fallito con codice esito KO_02, IDRisorsa in input: &quot;+localRequest.IDRisorsa+&quot;, IDRisorsa della risorsa dinamica: &quot;+Asset.IDRisorsa;			&#xD;
				CodiceEsito = &quot;KO_02&quot;;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Controllo fallito con codice esito KO_02, nessun Asset Dinamico trovato con IDASSET: &quot;+AssetRicarica.IDAsset;			&#xD;
			CodiceEsito = &quot;KO_02&quot;;&#xD;
		}	&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Controllo fallito con codice esito KO_02, IDAssetRicarica: &quot;+IDAssetRicarica+&quot;, nessun asset trovato&quot;;			&#xD;
		CodiceEsito = &quot;KO_02&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	CodiceEsito = &quot;KO_01&quot;;&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Controllo fallito con codice esito KO_01, IDAssetRicarica: &quot;+IDAssetRicarica;	&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
