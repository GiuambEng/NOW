        <xpdl2:Activity Id="_z7Nboj4_Eei7IcgYfvd3tQ" Name="VerificaRichiesteRicaricastessoOLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Richieste Ricarica stesso OLO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo Verifica Richieste Ricarica stesso OLO superato&quot;;&#xD;
&#xD;
&#xD;
&#xD;
if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ACCENSIONE ||&#xD;
localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.SPEGNIMENTO)&#xD;
{&#xD;
	&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;IDRisorsa =: IDRisorsa AND tipoRichiesta='RICARICA' AND statoRichiestaNOW NOT IN ('ESPLETAMENTOTECNICOKO','SCARTATO','CHIUSO','ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE','FATTURAZIONEKO','ANNULLATO') AND lavorazione IN ('ACCENSIONE','SPEGNIMENTO') AND IDRichiestaOLO&lt;>:pvm&quot;);&#xD;
	criteria.setQueryParameter(&quot;IDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
	criteria.setQueryParameter(&quot;pvm&quot;,localRequest.IDRichiestaOLO);&#xD;
&#xD;
&#xD;
	ResultRequestRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
	if (ResultRequestRef != null &amp;&amp; ResultRequestRef.size() > 0)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Controllo fallito - Richiesta di accensione/spegnimento in corso&quot;;&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ANNULLAMENTO)&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;IDRisorsa =: IDRisorsa AND tipoRichiesta='RICARICA' AND statoRichiestaNOW NOT IN ('ESPLETAMENTOTECNICOKO','SCARTATO','CHIUSO','ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE','FATTURAZIONEKO','ANNULLATO') AND lavorazione = 'ANNULLAMENTO' AND IDRichiestaOLO&lt;>:pvm&quot;);&#xD;
	criteria.setQueryParameter(&quot;IDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
	criteria.setQueryParameter(&quot;pvm&quot;,localRequest.IDRichiestaOLO);&#xD;
&#xD;
	ResultRequestRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
	if (ResultRequestRef != null &amp;&amp; ResultRequestRef.size() > 0)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Controllo fallito - Richiesta di ANNULLAMENTO in corso&quot;;&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
else if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.SCHEDULAZIONE)&#xD;
{&#xD;
	&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;IDRisorsa =: IDRisorsa AND tipoRichiesta='RICARICA' AND statoRichiestaNOW NOT IN ('ESPLETAMENTOTECNICOKO','SCARTATO','CHIUSO','ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE','FATTURAZIONEKO','ANNULLATO') AND lavorazione IN ('ACCENSIONE','SPEGNIMENTO','SCHEDULAZIONE') AND IDRichiestaOLO&lt;>:pvm&quot;);&#xD;
	criteria.setQueryParameter(&quot;IDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
	criteria.setQueryParameter(&quot;pvm&quot;,localRequest.IDRichiestaOLO);&#xD;
&#xD;
&#xD;
	ResultRequestRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
	if (ResultRequestRef != null &amp;&amp; ResultRequestRef.size() > 0)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Controllo fallito - Richiesta di accensione/spegnimento in corso&quot;;&#xD;
	}&#xD;
	&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
