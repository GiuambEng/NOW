                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="true" Direction="IN" Formal="input.idRisorsa">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRisorsa</xpdl2:Actual>
