        <xpdl2:Activity Id="_TYGq4j5BEei7IcgYfvd3tQ" Name="VerificaAnnullamentoRicaricastessoOLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Annullamento Ricarica stesso OLO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Controllo Verifica Annullamento Ricarica Stesso OLO FALLITO&quot;;&#xD;
&#xD;
// CAC per recupero Asset Ricarica SCHEDULATA o PROLUNGATA&#xD;
var c = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.createCriteria(&quot;IDAssetRicarica =: IDAssetRicarica AND ((statoAsset NOT IN ('ANNULLATA')) AND famigliaAsset IN ('PROLUNGATA','SCHEDULATA')) &quot;); //Ultima revisione SM_8822&#xD;
c.setQueryParameter(&quot;IDAssetRicarica&quot;,ScriptUtil.createBigInteger(IDAssetRicarica));&#xD;
&#xD;
AssetRicaricaRef = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.findByCriteria(c);     &#xD;
if (AssetRicaricaRef != null &amp;&amp; AssetRicaricaRef.size()>0)&#xD;
{&#xD;
   // Leggo Asset Ricarica per ricavare Data Inizio&#xD;
   AssetRicarica = ScriptUtil.copy(AssetRicaricaRef.get(0).readAssetRicarica());&#xD;
   Process.auditLog(&quot;Recuperato asset con id &quot;+AssetRicarica.IDAsset);&#xD;
   &#xD;
   // CAC per recupero GV per configuration value &quot;Scadenza Annullamento Ricarica&quot;&#xD;
   var c2 = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key = 'ScadenzaAnnullamentoRicarica'&quot;);&#xD;
   ConfigurationRef = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(c2);&#xD;
   &#xD;
   if (ConfigurationRef != null &amp;&amp; ConfigurationRef.size()>0)&#xD;
   {&#xD;
		// Leggo Configuration per ricavare GV&#xD;
		Configuration =ScriptUtil.copy(ConfigurationRef.get(0).readConfiguration());&#xD;
		Process.auditLog(&quot;Recuperato parametro Scadenza Annullamento Ricarica con valore &quot;+Configuration.value);&#xD;
		&#xD;
		// data massima per cui è consentito l'annullamento&#xD;
		var Days= DateTimeUtil.createDuration(false,0,0,ScriptUtil.createBigInteger(Configuration.value),0,0,0);&#xD;
		Process.auditLog(&quot;duration calcolata  &quot;+String(Days));&#xD;
		&#xD;
		var maxDateForAnnullamento = AssetRicarica.dataInizio;&#xD;
		maxDateForAnnullamento.add(Days);&#xD;
		&#xD;
		Process.auditLog(&quot;data massima per annullamento calcolata  &quot;+String(maxDateForAnnullamento));&#xD;
		&#xD;
		if (localRequest.dataInvioRichiesta &lt; maxDateForAnnullamento)&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;Controllo Verifica Annullamento Ricarica Stesso OLO SUPERATO&quot;;                      &#xD;
        }                               &#xD;
    }&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
