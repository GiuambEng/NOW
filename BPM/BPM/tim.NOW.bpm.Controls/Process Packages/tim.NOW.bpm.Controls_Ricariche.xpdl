        <xpdl2:Activity Id="_5e3Ks7N2EemNxbfuHsTQAg" Name="VerificaTaglioRicarica" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Taglio Ricarica" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_LqiuQLgoEemq6I7w3Ba2UQ">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="true" Direction="IN" Formal="input.idRichiestaOLO">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
