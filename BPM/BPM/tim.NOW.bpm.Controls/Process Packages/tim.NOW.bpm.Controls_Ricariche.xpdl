                      <xpdExt:DataMapping xpdExt:SourceContributorId="OutputFromService.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="EsitoResponse.descrizione">
                        <xpdl2:Actual ScriptGrammar="JavaScript">output.esito.descrizione</xpdl2:Actual>
