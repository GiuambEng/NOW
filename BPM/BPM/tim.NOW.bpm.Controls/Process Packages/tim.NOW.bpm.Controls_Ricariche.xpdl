                    <xpdl2:DataMapping Direction="IN" Formal="input.taglioRicarica">
                      <xpdExt:ScriptInformation Id="_nywgsLgpEemq6I7w3Ba2UQ" Name="TaglioRicarica"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">var taglio = &quot;&quot;;&#xD;
taglio = null;&#xD;
&#xD;
var i=0;&#xD;
var j=0;&#xD;
&#xD;
while(taglio == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
	if (currentComponente. nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DATIRICARICA)&#xD;
	{&#xD;
		j = 0;&#xD;
		while (taglio == null &amp;&amp; j&lt; currentComponente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOTIPOLOGIARICARICA)&#xD;
			{&#xD;
				taglio = currentAttributo.valoreAttributo;&#xD;
			}&#xD;
&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
taglio;</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageIn>
