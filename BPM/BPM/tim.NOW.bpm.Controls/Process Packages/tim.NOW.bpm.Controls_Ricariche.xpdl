            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_CJSYAj5NEei7IcgYfvd3tQ" Width="31.0">
              <xpdl2:Coordinates XCoordinate="607.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_CJSYBT5NEei7IcgYfvd3tQ" Name="VerificaRicaricaNRTincorsostessoOLO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Ricarica NRT in corso stesso OLO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo ricarica NRT in corso superato&quot;;&#xD;
&#xD;
var sysdate = DateTimeUtil.createDate();&#xD;
&#xD;
&#xD;
	// richieste di accensione/prolungamento/schedulazione/sepgnimento in corso&#xD;
	// richieste di accensione/prolungamento nella stessa giornata in stati finali positivi nella stessa giornata &#xD;
&#xD;
var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;IDRisorsa =: IDRisorsa AND tipoRichiesta='RICARICA' AND lavorazione IN ('SCHEDULAZIONE','SPEGNIMENTO','ACCENSIONE','PROLUNGAMENTO') AND statoRichiestaNOW NOT IN  ('CHIUSO', 'SCARTATO','ANNULLATO', 'ESPLETAMENTOTECNICOKO','INVIATOAFATTURAZIONE','ESPLETAMENTOTECNICO','FATTURAZIONEKO') AND IDRichiestaOLO &lt;>: pvm&quot;);&#xD;
&#xD;
criteria.setQueryParameter(&quot;IDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
criteria.setQueryParameter(&quot;pvm&quot;,localRequest.IDRichiestaOLO);&#xD;
&#xD;
ResultRequestRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
if (ResultRequestRef != null &amp;&amp; ResultRequestRef.size() > 0)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Controllo fallito - Richiesta di Ricarica in corso&quot;;&#xD;
}&#xD;
&#xD;
else&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;IDRisorsa =: IDRisorsa AND tipoRichiesta='RICARICA' AND lavorazione IN ('ACCENSIONE','PROLUNGAMENTO') AND statoRichiestaNOW  IN  ('CHIUSO','INVIATOAFATTURAZIONE','ESPLETAMENTOTECNICO','FATTURAZIONEKO')  AND dataInvioRichiesta =: Date AND IDRichiestaOLO &lt;>: pvm&quot;);&#xD;
	&#xD;
	criteria.setQueryParameter(&quot;IDRisorsa&quot;,localRequest.IDRisorsa);&#xD;
	criteria.setQueryParameter(&quot;Date&quot;,sysdate);&#xD;
	criteria.setQueryParameter(&quot;pvm&quot;,localRequest.IDRichiestaOLO);&#xD;
	&#xD;
	ResultRequestRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
	&#xD;
		if (ResultRequestRef != null &amp;&amp; ResultRequestRef.size() > 0)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Controllo fallito - Richiesta di Ricarica di accensione/prolungamento nella stessa giornata andata a buon fine&quot;;&#xD;
	&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
	&#xD;
			var c = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.createCriteria(&quot;IDAsset =: IDAssetAccessoDinamico AND statoAsset = 'SCHEDULATA' AND ((dataInizio>=: Di AND dataInizio&lt;=: Df) OR (dataFine &lt;=: Df AND dataFine >=: Di  ) OR (dataInizio&lt;=: Di AND dataFine>=: Df))&quot;);&#xD;
			c.setQueryParameter(&quot;IDAssetAccessoDinamico&quot;,ScriptUtil.createBigInteger(IDAssetAccessoDinamico));&#xD;
			&#xD;
			c.setQueryParameter(&quot;Di&quot;,DataInizioRicarica);&#xD;
			c.setQueryParameter(&quot;Df&quot;,DataFineRicarica);&#xD;
			&#xD;
			ResultAssetRicRef = cac_it_telecomitalia_it_NOW_casedata_AssetRicarica.findByCriteria(c);	&#xD;
			&#xD;
				if (ResultAssetRicRef != null &amp;&amp; ResultAssetRicRef.size()>0)&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;Controllo fallito - Presenti ricariche schedulate nell'intervallo richiesto&quot;;&#xD;
			&#xD;
				}&#xD;
		}&#xD;
	&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="92.0" LaneId="_CJSYAj5NEei7IcgYfvd3tQ" Width="154.0">
              <xpdl2:Coordinates XCoordinate="317.0" YCoordinate="132.0"/>
