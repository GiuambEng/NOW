        <xpdl2:Activity Id="_sRgkElAVEfCtlsqLj8PmFQ" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = false;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
		{&#xD;
			EseguiControllo = true;&#xD;
		}&#xD;
	}	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_sR1UMlAVEfCtlsqLj8PmFQ" Width="96.0">
              <xpdl2:Coordinates XCoordinate="157.0" YCoordinate="203.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_sRgkE1AVEfCtlsqLj8PmFQ" Name="VerificaCompatibilitaServizioOpzionaleOffertaMigrDel82" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Compatibilita Servizio OpzionaleOfferta Migr Del82">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Verifica superata con successo&quot;;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null&#xD;
   &amp;&amp;(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA))&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
		{&#xD;
			for(var j=0; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size();j++)&#xD;
			{&#xD;
				var currentAttributo = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO&#xD;
				   &amp;&amp; currentAttributo.valoreAttributo == &quot;TLC8&quot;)&#xD;
				{&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;CodiceServizio è valorizzato con il valore = TLC8&quot;;	&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
