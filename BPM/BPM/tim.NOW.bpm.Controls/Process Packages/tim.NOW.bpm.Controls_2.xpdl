          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaVlanBmdRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaVLANBMDMigrDel82_RequestType();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	VerificaVlanBmdRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	VerificaVlanBmdRequest.offerta = String(localRequest.offerta);&#xD;
	&#xD;
	for(var i=0 ; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for (var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttrDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if (currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
				{&#xD;
					VerificaVlanBmdRequest.profiloTecnicoLinea = currentAttrDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if (currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUOVOMODELLO)&#xD;
				{&#xD;
					VerificaVlanBmdRequest.flagNuovoModello = currentAttrDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			//Il controllo non va effettuato se la USERVLAN ha FLAGMULTICAST (quindi non passiamo la USERVLAN al servizio)&#xD;
			var FLAGMULTICAST = &quot;&quot;;&#xD;
			FLAGMULTICAST = null;&#xD;
			var m=0;&#xD;
			&#xD;
			while(FLAGMULTICAST == null &amp;&amp; m&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = currentDettOrdine.attributiDettaglioOrdine.get(m);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
				{&#xD;
					FLAGMULTICAST = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo FLAGMULTICAST&quot;+ attributo.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+currentDettOrdine.IDDettaglioOrdine);			&#xD;
				}&#xD;
				&#xD;
				m++;&#xD;
			}&#xD;
&#xD;
			if(FLAGMULTICAST != &quot;SI&quot;)&#xD;
			{							&#xD;
				var bandetipocos = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createbandaType3();&#xD;
				bandetipocos.idDettagliOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				&#xD;
				for(var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
					{&#xD;
						bandetipocos.bandaPiccoUp = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
					{&#xD;
						bandetipocos.bandaPiccoDown = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
					{&#xD;
						bandetipocos.uservlanID = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD)&#xD;
					{&#xD;
						bandetipocos.profiloBMD = attributo.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
				VerificaVlanBmdRequest.banda.add(bandetipocos);&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">var foundProfiloBMD = false;&#xD;
&#xD;
if(EsitoResponse.codice)&#xD;
{&#xD;
	if(localRequest.ordine != null)&#xD;
	{&#xD;
		Process.auditLog(&quot;Recuperati &quot; + VerificaVlanBmdResponse.ID.size()+&quot; record dal controllo VLANBMD&quot;);&#xD;
		var ora = DateTimeUtil.createDatetime();&#xD;
		&#xD;
		for(var i=0; i&lt;VerificaVlanBmdResponse.ID.size(); i++)&#xD;
		{&#xD;
			foundProfiloBMD = false;&#xD;
			var j = 0;&#xD;
			while(!foundProfiloBMD &amp;&amp; j &lt; localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(j);&#xD;
				&#xD;
				if(currentDettOrdine.IDDettaglioOrdine == VerificaVlanBmdResponse.ID.get(i).idDettagliOrdine)&#xD;
				{					&#xD;
					Process.auditLog(&quot;Trovato id risposta &quot; + VerificaVlanBmdResponse.ID.get(i).idDettagliOrdine +&quot; nell'ordine&quot;);&#xD;
					&#xD;
					//Il controllo non va effettuato se la USERVLAN ha FLAGMULTICAST (quindi non passiamo la USERVLAN al servizio)&#xD;
					var FLAGMULTICAST = &quot;&quot;;&#xD;
					FLAGMULTICAST = null;&#xD;
					var m = 0;&#xD;
					&#xD;
					while(FLAGMULTICAST == null &amp;&amp; m&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var attributo = currentDettOrdine.attributiDettaglioOrdine.get(m);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
						{&#xD;
							FLAGMULTICAST = attributo.valoreAttributo;&#xD;
							Process.auditLog(&quot;Trovato attributo FLAGMULTICAST&quot;+ attributo.valoreAttributo +&quot; su componente USERVLAN con IDDett &quot;+currentDettOrdine.IDDettaglioOrdine);			&#xD;
						}&#xD;
						m++;&#xD;
					}&#xD;
					&#xD;
					if(FLAGMULTICAST != &quot;SI&quot;)&#xD;
					{&#xD;
						var z = 0;&#xD;
						while(!foundProfiloBMD &amp;&amp; z &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
						{&#xD;
							var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
							&#xD;
							if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD)&#xD;
							{&#xD;
								foundProfiloBMD = true;&#xD;
								currentAttDettOrdine.lastUpdate = ora;&#xD;
								currentAttDettOrdine.valoreAttributo = VerificaVlanBmdResponse.ID.get(i).ID_PROFILO_BMD;&#xD;
								Process.auditLog(&quot;Modificato Profilo BMD a &quot; + VerificaVlanBmdResponse.ID.get(i).ID_PROFILO_BMD +&quot; per ID &quot;+currentDettOrdine.IDDettaglioOrdine);&#xD;
							}&#xD;
							z++;&#xD;
						}&#xD;
						&#xD;
						if(!foundProfiloBMD)&#xD;
						{&#xD;
							var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
							nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
							nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
							nuovoAttributo.created = ora;&#xD;
							nuovoAttributo.lastUpdate = ora;&#xD;
							nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD;&#xD;
							nuovoAttributo.operatore = localRequest.operatore;&#xD;
							nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
							nuovoAttributo.valoreAttributo = VerificaVlanBmdResponse.ID.get(i).ID_PROFILO_BMD;&#xD;
					&#xD;
							currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
							foundProfiloBMD = true;&#xD;
							Process.auditLog(&quot;Profilo BMD non trovato nell'ordine, aggiunto attributo con valore &quot; + VerificaVlanBmdResponse.ID.get(i).ID_PROFILO_BMD);&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}		&#xD;
	}&#xD;
}</xpdExt:Information>
