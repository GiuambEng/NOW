&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	for(var i=0 ; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
