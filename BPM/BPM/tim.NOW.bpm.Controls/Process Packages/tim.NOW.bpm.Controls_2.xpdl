            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaContrattoCoinvestimentoRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaContrattoCoinvestimentoComuneSemivulaMigrDel82_RequestType();&#xD;
&#xD;
//Recupero IDAsset dalla localRequest&#xD;
if(localRequest != null &amp;&amp; localRequest.assetTarget != null)&#xD;
{&#xD;
for(var k=0; k&lt;localRequest.assetTarget.size(); k++)&#xD;
	{&#xD;
		if (localRequest.assetTarget.get(k).IDAsset != null)&#xD;
		{&#xD;
		IDAsset=localRequest.assetTarget.get(k).IDAsset;&#xD;
		k=localRequest.assetTarget.size();&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(localRequest != null)&#xD;
{&#xD;
	if (IDAsset != null)			//SM_11848&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(IDAsset, 10));&#xD;
		Asset = AssetRef.readAsset();&#xD;
	}&#xD;
	if(Asset != null &amp;&amp; Asset != &quot;&quot; &amp;&amp; Asset.codiceISTATComune != null)&#xD;
	{&#xD;
		VerificaContrattoCoinvestimentoRequest.istatComune = Asset.codiceISTATComune;&#xD;
	}&#xD;
	VerificaContrattoCoinvestimentoRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	VerificaContrattoCoinvestimentoRequest.DRO = localRequest.DRO;&#xD;
	VerificaContrattoCoinvestimentoRequest.offerta = String(localRequest.offerta);&#xD;
	VerificaContrattoCoinvestimentoRequest.contratto = String(localRequest.IDContratto);&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
