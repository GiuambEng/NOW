        <xpdl2:Activity Id="_BYI8Y1ASEfCtlsqLj8PmFQ" Name="VerificaUserVlanMulticastMigrDel82" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica UserVlan Multicast Migr Del82">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo C04M01F530 superato&quot;;&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	var nUservlan = 0;&#xD;
	var nflagMulticastY = 0;&#xD;
	//VERIFICO QUANTE USERVLAN CI SONO&#xD;
	for(var i=0 ; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			nUservlan ++;&#xD;
			&#xD;
			for(var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
				{&#xD;
					if(attributo.valoreAttributo == 'Y')&#xD;
					{&#xD;
						nflagMulticastY ++;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	//CASO 1&#xD;
	if(nUservlan == 1 &amp;&amp; nflagMulticastY == 1)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Controllo C04M01F530 Fallito&quot;;&#xD;
	}&#xD;
	&#xD;
	//CASO 2&#xD;
	if(nUservlan > 1 &amp;&amp; nflagMulticastY == 1)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Controllo C04M01F530 superato&quot;;&#xD;
	}&#xD;
	&#xD;
	//CASO 3&#xD;
	if(nUservlan > 1 &amp;&amp; nflagMulticastY > 1)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Controllo C04M01F530 Fallito&quot;;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_BYI8b1ASEfCtlsqLj8PmFQ" Width="96.0">
              <xpdl2:Coordinates XCoordinate="421.0" YCoordinate="188.0"/>
            </xpdl2:NodeGraphicsInfo>
