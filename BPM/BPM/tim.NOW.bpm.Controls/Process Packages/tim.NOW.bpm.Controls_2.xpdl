            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">//SALVO ARRAY&#xD;
if(EsistenzaVLANMigDel82Response != null &amp;&amp; EsistenzaVLANMigDel82Response != &quot;&quot; &#xD;
   &amp;&amp; EsistenzaVLANMigDel82Response.vlan != null &amp;&amp; EsistenzaVLANMigDel82Response.vlan.size() > 0)&#xD;
{&#xD;
	var EsistenzaVLANMigDel82Output = ScriptUtil.copyAll(EsistenzaVLANMigDel82Response.vlan);&#xD;
}&#xD;
&#xD;
//LOGICA DI ARRICCHIMENTO&#xD;
var trovato = false;&#xD;
var i=0;&#xD;
&#xD;
if(EsistenzaVLANMigDel82Output != null &amp;&amp; EsistenzaVLANMigDel82Output.size() > 0)&#xD;
{&#xD;
	while (!trovato &amp;&amp; i &lt; EsistenzaVLANMigDel82Output.size())&#xD;
	{&#xD;
		localRequest.ordine.CLLI = EsistenzaVLANMigDel82Output.get(i).CLLI;&#xD;
		trovato = true;&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Il CLLI restituito dal controllo non risulta valorizzato&quot;);&#xD;
}&#xD;
	&#xD;
if(EsistenzaVLANMigDel82Output != null &amp;&amp; EsistenzaVLANMigDel82Output.size() > 0)&#xD;
{&#xD;
	for(var j = 0; j &lt; EsistenzaVLANMigDel82Output.size(); j++)&#xD;
	{&#xD;
		var currentEsistenzaVLAN = EsistenzaVLANMigDel82Output.get(j);&#xD;
		&#xD;
		//TIPOTRASPORTO&#xD;
		if(currentEsistenzaVLAN.TIPO_TRASPORTO != null &amp;&amp; currentEsistenzaVLAN.TIPO_TRASPORTO.length > 0)&#xD;
		{&#xD;
			for(var k = 0; k &lt; localRequest.ordine.dettaglioordine.size(); k++)&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(k);&#xD;
				if(currentEsistenzaVLAN.IDDettaglioOrdine == currentDettOrdine.IDDettaglioOrdine)&#xD;
				{&#xD;
					var foundTipoTrasporto = false;&#xD;
					var z = 0;&#xD;
					while (!foundTipoTrasporto &amp;&amp; z&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
						if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOTRASPORTO)&#xD;
						{&#xD;
							foundTipoTrasporto = true;&#xD;
							currentAttributo.valoreAttributo = currentEsistenzaVLAN.TIPO_TRASPORTO;&#xD;
						}&#xD;
					z++;&#xD;
					}&#xD;
					&#xD;
					if(!foundTipoTrasporto)&#xD;
					{&#xD;
						var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
						nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOTRASPORTO;&#xD;
						nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						nuovoAttributo.valoreAttributo = currentEsistenzaVLAN.TIPO_TRASPORTO;&#xD;
						nuovoAttributo.operatore = localRequest.operatore;&#xD;
						currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
					}&#xD;
				}&#xD;
			}	&#xD;
		}&#xD;
		&#xD;
		//BMCLIGHT&#xD;
		if(currentEsistenzaVLAN.BMC_LIGHT != null &amp;&amp; currentEsistenzaVLAN.BMC_LIGHT.length > 0)&#xD;
		{&#xD;
			for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
			{&#xD;
				var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				if(currentEsistenzaVLAN.IDDettaglioOrdine == currentDettOrdine.IDDettaglioOrdine)&#xD;
				{&#xD;
					var foundBmcLight = false;&#xD;
					var x = 0;&#xD;
					while(!foundBmcLight &amp;&amp; x &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currentAttributo = currentDettOrdine.attributiDettaglioOrdine.get(x);&#xD;
						if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BMCLIGHT)&#xD;
						{&#xD;
							foundBmcLight = true;&#xD;
							currentAttributo.valoreAttributo = currentEsistenzaVLAN.BMC_LIGHT;&#xD;
						}&#xD;
					x++;&#xD;
					}&#xD;
					&#xD;
					if(!foundBmcLight)&#xD;
					{&#xD;
						var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
						nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
						nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
						nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BMCLIGHT;&#xD;
						nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						nuovoAttributo.valoreAttributo = currentEsistenzaVLAN.BMC_LIGHT;&#xD;
						nuovoAttributo.operatore = localRequest.operatore;&#xD;
						currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//TIPOLOGIACLUSTERVLAN&#xD;
		if(currentEsistenzaVLAN.TIPOLOGIA_CLUSTER_VLAN != null &amp;&amp; currentEsistenzaVLAN.TIPOLOGIA_CLUSTER_VLAN.length > 0)&#xD;
		{&#xD;
			for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
