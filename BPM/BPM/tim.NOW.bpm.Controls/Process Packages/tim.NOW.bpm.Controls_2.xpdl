              <xpdExt:Information ScriptGrammar="JavaScript">CongruenzaModelloDiServizioRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaCongruenzaModelloDiServizio_RequestType();&#xD;
CongruenzaModelloDiServizioRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
&#xD;
for(var k=0; k&lt;EsistenzaVLANOutput.size(); k++)&#xD;
{&#xD;
	var arrUservlan = com_tim_NOW_xsd_ControlliFormali_Factory.createUserVlanType1();&#xD;
	var currentEsistenza = EsistenzaVLANOutput.get(k);&#xD;
	&#xD;
	if(currentEsistenza.TIPO_BANDA != null)&#xD;
	{&#xD;
		arrUservlan.tipoBanda = currentEsistenza.TIPO_BANDA;&#xD;
	}&#xD;
	&#xD;
	if(currentEsistenza.TIPO_COS != null)&#xD;
	{&#xD;
		arrUservlan.tipoCos = currentEsistenza.TIPO_COS;&#xD;
	}&#xD;
	&#xD;
	if(currentEsistenza.BMC_LIGHT != null)&#xD;
	{&#xD;
		arrUservlan.bmcLight = currentEsistenza.BMC_LIGHT;&#xD;
	}&#xD;
	CongruenzaModelloDiServizioRequest.userVlan.add(arrUservlan);&#xD;
}&#xD;
