{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING&#xD;
				 &amp;&amp; attributo.valoreAttributo.toUpperCase() == &quot;UNTAGGED&quot;)&#xD;
				{&#xD;
					nextStep = true;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
if(nextStep)&#xD;
{&#xD;
	while(!kit &amp;&amp;  i &lt; EsistenzaVLANMigDel82Response.vlan.size())&#xD;
	{&#xD;
		var currEsistVLAN = EsistenzaVLANMigDel82Response.vlan.get(i);&#xD;
		&#xD;
		if (currEsistVLAN.CODICE_KIT!=null &amp;&amp; currEsistVLAN.CODICE_KIT.length>0)&#xD;
		{&#xD;
			kit = true;&#xD;
			EseguiControllo = true;&#xD;
		}&#xD;
		else &#xD;
		{&#xD;
			EseguiControllo = false;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
