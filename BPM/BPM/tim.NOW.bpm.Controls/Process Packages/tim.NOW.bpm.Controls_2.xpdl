          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">GestioneAnagraficaMercatoRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createGestioneAnagraficaMercato_RequestType();&#xD;
&#xD;
GestioneAnagraficaMercatoRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
GestioneAnagraficaMercatoRequest.lavorazione = String(localRequest.lavorazione);&#xD;
GestioneAnagraficaMercatoRequest.offerta = String(localRequest.offerta);&#xD;
GestioneAnagraficaMercatoRequest.richiesta = localRequest.IDRichiestaOLO;&#xD;
&#xD;
if (localRequest.ISTATComune != null &amp;&amp; localRequest.ISTATComune != '') {&#xD;
    GestioneAnagraficaMercatoRequest.codiceIstatComune = localRequest.ISTATComune;&#xD;
} else {&#xD;
    Asset = null;&#xD;
    if (localRequest.IDRisorsa != null &amp;&amp; localRequest.IDRisorsa != &quot;&quot;) {&#xD;
        IDRisorsa = localRequest.IDRisorsa;&#xD;
    } else if (ConsistenzaDati.IDRisorsa != null &amp;&amp; ConsistenzaDati.IDRisorsa != &quot;&quot;) {&#xD;
        IDRisorsa = ConsistenzaDati.IDRisorsa;&#xD;
    } else {&#xD;
        Log.write(&quot;IDRisorsa non valorizzato&quot;);&#xD;
    }&#xD;
&#xD;
    Log.write(&quot;Recupero codiceISTATComune per Migrazioni&quot;);&#xD;
    var c = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;IDRisorsa =: idr AND statoAsset IN ('ATTIVO')&quot;);&#xD;
    c.setQueryParameter(&quot;idr&quot;, IDRisorsa);&#xD;
    var result = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(c);&#xD;
&#xD;
    if (result != null &amp;&amp; result.size()>0) {&#xD;
        AssetRef = result.get(0);&#xD;
        Asset = ScriptUtil.copy(AssetRef.readAsset());&#xD;
        codiceISTATComune = Asset.codiceISTATComune;&#xD;
        GestioneAnagraficaMercatoRequest.codiceIstatComune = codiceISTATComune;&#xD;
        Log.write(&quot;ASSET Per IDRisorsa [&quot; + localRequest.IDRisorsa + &quot;] | Task Recupera codiceISTATComune : &quot; + String(Asset.codiceISTATComune));&#xD;
    } else {&#xD;
        Log.write(&quot;ASSET [&quot; + localRequest.IDRisorsa + &quot;] non trovato&quot;);&#xD;
    }&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
