				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
				{&#xD;
					if(SVLANCODE0 == null)&#xD;
					{&#xD;
						SVLANCODE0 = currentAttDettOrdine.valoreAttributo;&#xD;
