		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			//Le USERVLAN con FLAGMULTICAST non vanno inviate al controllo&#xD;
			var FLAGMULTICAST = &quot;&quot;;&#xD;
			FLAGMULTICAST = null;&#xD;
			var m = 0;&#xD;
&#xD;
			while(FLAGMULTICAST == null &amp;&amp; m&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributoMulticast = currentDettOrdine.attributiDettaglioOrdine.get(m);&#xD;
				&#xD;
				if(attributoMulticast.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
				{&#xD;
					FLAGMULTICAST = attributoMulticast.valoreAttributo;		&#xD;
				}				&#xD;
				m++;&#xD;
			}&#xD;
&#xD;
			if(FLAGMULTICAST != &quot;SI&quot;)&#xD;
			{		&#xD;
				var UservlanTrovate = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createvlanType(); 				&#xD;
				UservlanTrovate.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				&#xD;
				var foundUservlanID = false;&#xD;
				&#xD;
				for(var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
					{&#xD;
						UservlanTrovate.uservlanID = attributo.valoreAttributo;&#xD;
						foundUservlanID = true;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
					{&#xD;
						UservlanTrovate.serviceVlan = attributo.valoreAttributo;&#xD;
					}&#xD;
				}				&#xD;
				&#xD;
				//SM_11672: Nel caso untagged non é presente l'attributo UservlanID&#xD;
				if(!foundUservlanID)&#xD;
				{&#xD;
					UservlanTrovate.uservlanID = 'caso_Untagged';		&#xD;
				}&#xD;
				&#xD;
				VerificaEsistenzaVlanMigDel82Request.vlan.add(UservlanTrovate);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
