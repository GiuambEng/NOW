            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaServiziOpzionaliRequest = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createVerificaServiziOpzionaliMigrDel82_RequestType();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	VerificaServiziOpzionaliRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
