            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaRolloutRequest = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createVerificarolloutMigrazioneFTTHDel82_RequestType();&#xD;
&#xD;
VerificaRolloutRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaRolloutRequest.lavorazione = String(localRequest.lavorazione);&#xD;
VerificaRolloutRequest.offerta = String(localRequest.offerta);&#xD;
VerificaRolloutRequest.scenario = String(localRequest.tipologiaScenario);&#xD;
&#xD;
&#xD;
VerificaRolloutRequest.servizioOpzionaleTCL89 = 'KO'; //SM_11649&#xD;
&#xD;
//Recupero Asset&#xD;
if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
	Asset = AssetRef.readAsset();&#xD;
}&#xD;
&#xD;
if(Asset != null &amp;&amp; Asset != &quot;&quot; &amp;&amp; Asset.codiceISTATComune != null)&#xD;
{&#xD;
	VerificaRolloutRequest.codiceIstatComune = Asset.codiceISTATComune;&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
	{&#xD;
		for(var j=0; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size();j++)&#xD;
		{&#xD;
			var currentAttributo = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO&#xD;
			   &amp;&amp; (currentAttributo.valoreAttributo == &quot;TLC8&quot; || currentAttributo.valoreAttributo == &quot;TLC9&quot;))&#xD;
			{&#xD;
				VerificaRolloutRequest.servizioOpzionaleTCL89 = &quot;OK&quot;;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
</xpdExt:Information>
