          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ControlloValoriBandaPiccoRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createControlloValoriBandaPiccoMigrDel82_RequestType();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	ControlloValoriBandaPiccoRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	ControlloValoriBandaPiccoRequest.genericParam = String(localRequest.offerta); //RU_1558: Aggiunta offerta in genericparam&#xD;
	&#xD;
	for(var i=0 ; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			//Il controllo non va effettuato se la USERVLAN ha FLAGMULTICAST (quindi non passiamo la USERVLAN al servizio)&#xD;
			var FLAGMULTICAST = &quot;&quot;;&#xD;
			FLAGMULTICAST = null;&#xD;
			var m=0;&#xD;
			&#xD;
			while(FLAGMULTICAST == null &amp;&amp; m&lt;componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(m);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
				{&#xD;
					FLAGMULTICAST = attributo.valoreAttributo;		&#xD;
				}&#xD;
				&#xD;
				m++;&#xD;
			}&#xD;
&#xD;
			if(FLAGMULTICAST != &quot;SI&quot;)&#xD;
			{				&#xD;
				var bandetipocos = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createbandaType();&#xD;
				var idDettOrd = componente.IDDettaglioOrdine;&#xD;
				&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
					{&#xD;
						bandetipocos.bandaPiccoUp = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
					{&#xD;
						bandetipocos.bandaPiccoDown = attributo.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
				//TIPO_COS&#xD;
				for(var k=0; k&lt;EsistenzaVLANMigDel82Response.vlan.size(); k++)&#xD;
				{&#xD;
					var currentEsistenza = EsistenzaVLANMigDel82Response.vlan.get(k);&#xD;
					&#xD;
					if(currentEsistenza.IDDettaglioOrdine == idDettOrd)&#xD;
					{&#xD;
						bandetipocos.tipoCos = currentEsistenza.TIPO_COS;&#xD;
					}&#xD;
				}				&#xD;
				&#xD;
				ControlloValoriBandaPiccoRequest.banda.add(bandetipocos);			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
