            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = false;&#xD;
&#xD;
var kit = false;&#xD;
var i=0;&#xD;
var nextStep = false;&#xD;
&#xD;
