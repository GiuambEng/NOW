        <xpdl2:Activity Id="_P4xURFASEfCtlsqLj8PmFQ" Name="VerificaduplicatiCVLANIDMigrDel82" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica duplicati CVLANID Migr Del82">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo C04M01F544 superato&quot;;&#xD;
&#xD;
var duplicated = false;&#xD;
var CvlanIDList = DataUtil.createList();&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!duplicated &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(!duplicated &amp;&amp; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
				{&#xD;
					if(CvlanIDList.contains(currentAttDettOrdine.valoreAttributo))&#xD;
					{&#xD;
						duplicated = true;&#xD;
						Process.auditLog(&quot;Trovato CvlanID in Richiesta duplicata: &quot; + currentAttDettOrdine.valoreAttributo);&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
						CvlanIDList.add(currentAttDettOrdine.valoreAttributo);&#xD;
					}&#xD;
				}&#xD;
			j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(duplicated)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Controllo C04M01F534 fallito&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
