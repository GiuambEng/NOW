            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaAbilitazioneONTRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaAbilitazioneONTDel82_RequestType();&#xD;
&#xD;
VerificaAbilitazioneONTRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaAbilitazioneONTRequest.lavorazione = String(localRequest.lavorazione);&#xD;
VerificaAbilitazioneONTRequest.offerta = String(localRequest.offerta);&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
	{&#xD;
		var arrServOpzionali = com_tim_NOW_xsd_ControlliFormali_Factory.createServizioOpzionaleType();&#xD;
		var CODICESERVIZIOrichiesta = &quot;&quot;; CODICESERVIZIOrichiesta = null;&#xD;
		&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO)&#xD;
			{&#xD;
				arrServOpzionali.codiceServizio = attributo.valoreAttributo;&#xD;
				CODICESERVIZIOrichiesta = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO)&#xD;
			{&#xD;
				arrServOpzionali.vincolantePerEspletamento = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//SM_11788&#xD;
		for(var k=0; k&lt;ServiziOpzionaliOutput.size(); k++)&#xD;
		{&#xD;
			if(ServiziOpzionaliOutput.get(k).codiceServizio == CODICESERVIZIOrichiesta)&#xD;
			{&#xD;
				arrServOpzionali.ambitoDel82 = ServiziOpzionaliOutput.get(k).ambitoDel82;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		VerificaAbilitazioneONTRequest.servizioOpzionale.add(arrServOpzionali);&#xD;
