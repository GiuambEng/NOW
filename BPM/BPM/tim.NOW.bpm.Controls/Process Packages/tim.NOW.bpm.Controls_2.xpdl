                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_S2MkoKRGEfCIAZnZrqoSeQ" OperationName="DeterminaCodiceProgettoONESTEPereditabile">
