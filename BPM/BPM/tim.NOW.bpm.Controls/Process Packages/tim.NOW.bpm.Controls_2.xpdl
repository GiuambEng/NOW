          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">// ── 1. Recupero Asset e IDPrimoOrdine ────────────────────────────────────&#xD;
if(ConsistenzaDati.IDAsset !=null) {&#xD;
		Process.auditLog(&quot;Asset Trovato con idAsset:&quot; + ConsistenzaDati.IDAsset);&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaDati.IDAsset));		&#xD;
		Asset = AssetRef.readAsset();&#xD;
}&#xD;
else if(ConsistenzaFonia.IDAsset !=null) {&#xD;
		Process.auditLog(&quot;Asset Trovato con idAsset:&quot; + ConsistenzaFonia.IDAsset);&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaFonia.IDAsset));		&#xD;
		Asset = AssetRef.readAsset();&#xD;
}&#xD;
else {&#xD;
		Process.auditLog(&quot; Nessun Asset Trovato&quot;);&#xD;
	}&#xD;
		&#xD;
if (Asset != null) {&#xD;
    primoOrdineRef = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByIDRichiestaOLO(Asset.IDPrimoOrdine);&#xD;
&#xD;
    if (primoOrdineRef != null) {&#xD;
		primoOrdine = ScriptUtil.copy(primoOrdineRef.readRichiesta());&#xD;
		&#xD;
        if (primoOrdine != null &amp;&amp; primoOrdine.ordine != null) {&#xD;
            codiceProgettoPrimoOrdine = primoOrdine.ordine.codiceProgetto;&#xD;
			Process.auditLog(&quot;CodiceProgetto primo ordine:&quot; + codiceProgettoPrimoOrdine);&#xD;
        } else {&#xD;
            Process.auditLog(&quot;WARN: ordine testata null per IDPrimoOrdine:&quot; + Asset.IDPrimoOrdine);&#xD;
        }&#xD;
&#xD;
    } else {&#xD;
&#xD;
        Process.auditLog(&quot;WARN: nessun ordine trovato per IDPrimoOrdine:&quot; + Asset.IDPrimoOrdine);&#xD;
	}&#xD;
} &#xD;
else {&#xD;
	Process.auditLog(&quot;WARN: Asset null o IDPrimoOrdine assente&quot;);&#xD;
}&#xD;
&#xD;
DeterminaOneStepEreditabileReq = com_tim_NOW_xsd_ControlliFormali_Factory.createDeterminaCodiceProgettoONESTEPereditabile_RequestType();&#xD;
&#xD;
DeterminaOneStepEreditabileReq.IDRichiestaOLO = String(localRequest.IDRichiestaOLO);&#xD;
DeterminaOneStepEreditabileReq.codiceProgetto = String(localRequest.codiceProgetto);&#xD;
&#xD;
if(codiceProgettoPrimoOrdine != null){&#xD;
DeterminaOneStepEreditabileReq.codiceProgettoOld = String(codiceProgettoPrimoOrdine);&#xD;
}&#xD;
&#xD;
DeterminaOneStepEreditabileReq.codificaOLOAgcom = String(localRequest.codificaOLOAGCOM);&#xD;
DeterminaOneStepEreditabileReq.offerta = String(localRequest.offerta);&#xD;
DeterminaOneStepEreditabileReq.lavorazione = String(localRequest.lavorazione);&#xD;
DeterminaOneStepEreditabileReq.idRisorsa = String(localRequest.IDRisorsa);&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
