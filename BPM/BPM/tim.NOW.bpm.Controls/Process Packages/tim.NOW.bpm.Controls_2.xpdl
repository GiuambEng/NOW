				{&#xD;
					FLAGNUOVOMODELLO = attributoDettaglio.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
 &#xD;
if(EsistenzaVLANMigDel82Response != null &amp;&amp; EsistenzaVLANMigDel82Response.vlan != null&#xD;
&amp;&amp; EsistenzaVLANMigDel82Response.vlan.size()>0)&#xD;
{&#xD;
	var m=0;&#xD;
	while (!kit &amp;&amp;  m &lt; EsistenzaVLANMigDel82Response.vlan.size())&#xD;
	{&#xD;
		var currEsistVLAN = EsistenzaVLANMigDel82Response.vlan.get(m);&#xD;
		if(currEsistVLAN.CODICE_KIT!=null &amp;&amp; currEsistVLAN.CODICE_KIT.length>0)&#xD;
		{&#xD;
			kit = true;&#xD;
		}&#xD;
		m++;&#xD;
	}&#xD;
}&#xD;
 &#xD;
if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
       || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS 		&#xD;
       || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH) &#xD;
&amp;&amp; kit &amp;&amp; FLAGNUOVOMODELLO == &quot;Y&quot;)&#xD;
{&#xD;
	EseguiControllo = true;&#xD;
}</xpdl2:Script>
