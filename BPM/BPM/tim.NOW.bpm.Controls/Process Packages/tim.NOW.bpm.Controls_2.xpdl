		{&#xD;
			var codServizioDettOrdine = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createServiziOpzionaliType();&#xD;
			&#xD;
			codServizioDettOrdine.idDettagliOrdine = componente.IDDettaglioOrdine;&#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO)&#xD;
				{&#xD;
					codServizioDettOrdine.codiceServizio = attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
			VerificaServiziOpzionaliRequest.serviziOpzionali.add(codServizioDettOrdine);&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
