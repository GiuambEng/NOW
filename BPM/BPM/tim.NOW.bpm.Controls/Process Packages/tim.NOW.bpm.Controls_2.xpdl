    <xpdl2:WorkflowProcess Id="_FRBX8FEOEfCkwa-FkWuMHw" xpdExt:DisplayName="CTRL VERIFICA COS MIG DEL82_C04M01F549" Name="CTRLVERIFICACOSMIGDEL82_C04M01F549">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_FRJTw1EOEfCkwa-FkWuMHw" Name="EndEvent" xpdExt:DisplayName="End Event">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" LaneId="_FRJTwVEOEfCkwa-FkWuMHw" Width="45.0">
              <xpdl2:Coordinates XCoordinate="570.0" YCoordinate="196.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_ZBhG8FEOEfCkwa-FkWuMHw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_NEMZUFEOEfCkwa-FkWuMHw" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="82.0" LaneId="_FRJTwVEOEfCkwa-FkWuMHw" Width="45.0">
              <xpdl2:Coordinates XCoordinate="75.0" YCoordinate="196.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_cdhTwFEOEfCkwa-FkWuMHw" Name="VerificaCOSMigDel82" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica COS Mig. Del82" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo C01M02F49 superato&quot;;&#xD;
&#xD;
var initTipobanda = &quot;&quot;;&#xD;
initTipobanda = null;&#xD;
var initTipoCos = &quot;&quot;;&#xD;
initTipoCos = null;&#xD;
var initBmcLight = &quot;&quot;;&#xD;
initBmcLight = null;&#xD;
var isMulticos = false;&#xD;
&#xD;
&#xD;
if(EsistenzaVLANMigDel82Response != null &amp;&amp; EsistenzaVLANMigDel82Response.vlan.size()>0)&#xD;
{&#xD;
	for(var k=0; k &lt; EsistenzaVLANMigDel82Response.vlan.size(); k++)&#xD;
	{&#xD;
		var currentEsistenza = EsistenzaVLANMigDel82Response.vlan.get(k);&#xD;
&#xD;
		//STEP 1&#xD;
		if(currentEsistenza.TIPO_BANDA != &quot;&quot;)&#xD;
		{&#xD;
			if(currentEsistenza.TIPO_BANDA == 'MULTICOS')&#xD;
			{&#xD;
				isMulticos = true;&#xD;
			}&#xD;
&#xD;
			if(initTipobanda == null)&#xD;
			{ &#xD;
				initTipobanda = currentEsistenza.TIPO_BANDA;&#xD;
			}&#xD;
			else if(initTipobanda != currentEsistenza.TIPO_BANDA)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Controllo C01M02F49 Fallito&quot;;&#xD;
				Process.auditLog(&quot;Controllo Fallito per Tipo banda diverso tra le uservlan 1: &quot;+currentEsistenza.TIPO_BANDA+&quot; 2: &quot;+initTipobanda);&#xD;
			}&#xD;
		}&#xD;
&#xD;
		//STEP 2&#xD;
		if(EsitoResponse.codice &amp;&amp; isMulticos)&#xD;
		{&#xD;
			if(initTipoCos == null)&#xD;
			{&#xD;
				initTipoCos = currentEsistenza.TIPO_COS;&#xD;
			}&#xD;
			else if(currentEsistenza.TIPO_COS != initTipoCos)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Controllo C01M02F49 fallito&quot;;&#xD;
				Process.auditLog(&quot;Controllo Fallito allo step 2 per TIPOCOS diverso tra le uservlan 1: &quot;+currentEsistenza.TIPO_COS+&quot; 2: &quot;+initTipoCos);&#xD;
			}&#xD;
&#xD;
			if(initBmcLight == null)&#xD;
			{&#xD;
				initBmcLight = currentEsistenza.BMC_LIGHT;&#xD;
			}&#xD;
			else if(currentEsistenza.BMC_LIGHT != initBmcLight)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Controllo C01M02F49 fallito&quot;;&#xD;
