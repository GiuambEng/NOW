          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Controllo C04M01F541 Superato&quot;;&#xD;
&#xD;
&#xD;
var FoundTag = &quot;&quot;;&#xD;
FoundTag = null;&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
				{&#xD;
					FoundTag = attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(FoundTag != null &amp;&amp; EsistenzaVLANMigDel82Response != null &amp;&amp; EsistenzaVLANMigDel82Response.vlan.size() > 0)&#xD;
{                                                               &#xD;
	for(var i = 0; i &lt; EsistenzaVLANMigDel82Response.vlan.size(); i++)&#xD;
	{&#xD;
		var currentEsistenza = EsistenzaVLANMigDel82Response.vlan.get(i);&#xD;
		&#xD;
		if(FoundTag == &quot;SINGLETAG&quot; &amp;&amp; currentEsistenza.FLAG_ENCAPSULATION != 'N')&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Controllo C04M01F541 fallito&quot;;&#xD;
		}&#xD;
		else if(FoundTag == &quot;DOUBLETAG&quot; &amp;&amp; currentEsistenza.FLAG_ENCAPSULATION != 'Y')&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Controllo C04M01F541 fallito&quot;;&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
