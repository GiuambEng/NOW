          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaSommaBandeRequest = com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createVerificaSommaBandediPiccoMigrDel82_RequestType();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	VerificaSommaBandeRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	VerificaSommaBandeRequest.offerta = String(localRequest.offerta);&#xD;
	&#xD;
	for(var i=0 ; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if (String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for (var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttrDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if (currentAttrDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
				{&#xD;
					VerificaSommaBandeRequest.profiloTecnicoLinea = currentAttrDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			var bande =  com_tim_NOW_xsd_ControlliAmmessiDati_Factory.createbandaType2();&#xD;
			&#xD;
			for(var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
				{&#xD;
					bande.bandaPiccoUp = attributo.valoreAttributo;&#xD;
				}&#xD;
				&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
				{&#xD;
					bande.bandaPiccoDown = attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
			VerificaSommaBandeRequest.banda.add(bande);&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
