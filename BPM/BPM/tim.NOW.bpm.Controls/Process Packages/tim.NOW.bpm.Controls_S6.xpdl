        <xpdl2:Activity Id="_7NfbdAf5EeeqYJMovLSTQA" Name="VerificavariazioneUserVlanTagged" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica variazione UserVlan Tagged" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset,10));&#xD;
Asset = AssetRef.readAsset();&#xD;
&#xD;
var uservlanTaggingAsset = &quot;&quot;;&#xD;
uservlanTaggingAsset = null;&#xD;
var countUserVlanAsset = 0;&#xD;
var countUserVlanIncrementoRichiesta = 0;&#xD;
var countUserVlanDecrementoRichiesta = 0;&#xD;
&#xD;
for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
{&#xD;
	var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
	&#xD;
	if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
		&amp;&amp; currentDettAsset.statoDettaglioAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO)&#xD;
	{&#xD;
		countUserVlanAsset++;&#xD;
	}&#xD;
	else if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(uservlanTaggingAsset == null &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
		{&#xD;
			var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
			if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING)&#xD;
			{&#xD;
				uservlanTaggingAsset = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
	{&#xD;
		if(currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
		{&#xD;
			countUserVlanIncrementoRichiesta++;&#xD;
		}&#xD;
		else if(currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		{&#xD;
			countUserVlanDecrementoRichiesta++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(uservlanTaggingAsset == &quot;Tagged&quot;)&#xD;
{&#xD;
	if(countUserVlanAsset + countUserVlanIncrementoRichiesta - countUserVlanDecrementoRichiesta &lt;= 4)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL MODIFICA TAGGED positivo: somma di UserVLAN minore o uguale a 4. UserVlan in Consistenza: &quot; + countUserVlanAsset + &quot; UserVlan in Incremento: &quot; + countUserVlanIncrementoRichiesta + &quot; UserVlan in Decremento: &quot; + countUserVlanDecrementoRichiesta;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL MODIFICA TAGGED negativo: somma di UserVLAN superiore a 4. UserVlan in Consistenza: &quot; + countUserVlanAsset + &quot; UserVlan in Incremento: &quot; + countUserVlanIncrementoRichiesta + &quot; UserVlan in Decremento: &quot; + countUserVlanDecrementoRichiesta;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL MODIFICA TAGGED fallito: USERVLAN1TAGGING in Consistenza non di tipo TAGGED: &quot; + uservlanTaggingAsset;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
