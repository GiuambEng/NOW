              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_2PVAgQo3Eeen-MTwjTWWJQ" Width="31.0">
              <xpdl2:Coordinates XCoordinate="789.0" YCoordinate="260.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_2PkREgo3Eeen-MTwjTWWJQ" Name="VerificaUserVlaninAsset" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica UserVlan in Asset" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var UserVLANIDRichiesta = DataUtil.createList();&#xD;
var UserVLANIDDecrementoRichiesta = DataUtil.createList();&#xD;
var UserVLANIDAsset = DataUtil.createList();&#xD;
var UserVLANID = &quot;&quot;;&#xD;
UserVLANID = null;&#xD;
var taggingRichiesta = &quot;&quot;;&#xD;
taggingRichiesta = null;&#xD;
var taggingAsset = &quot;&quot;;&#xD;
taggingAsset = null;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
			{&#xD;
				UserVLANID = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING)&#xD;
			{&#xD;
				taggingRichiesta = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
			{&#xD;
				UserVLANIDRichiesta.add(currentAttDettOrdine.valoreAttributo);&#xD;
				&#xD;
				if(currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
				{&#xD;
					UserVLANIDDecrementoRichiesta.add(currentAttDettOrdine.valoreAttributo);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
Asset = AssetRef.readAsset();&#xD;
&#xD;
for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
{&#xD;
	var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
	&#xD;
	if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
		{&#xD;
			var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
			if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING)&#xD;
			{&#xD;
				taggingAsset = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
		 &amp;&amp; currentDettAsset.statoDettaglioAsset != it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.CESSATO) // != Cessato aggiunto con Bug #25693&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
		{&#xD;
			var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
			if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
			{&#xD;
				UserVLANIDAsset.add(currentAttDettAsset.valoreAttributo);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
var failed = false;&#xD;
&#xD;
if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!failed &amp;&amp; i &lt; UserVLANIDDecrementoRichiesta.size())&#xD;
	{&#xD;
		if(!UserVLANIDAsset.contains(UserVLANIDDecrementoRichiesta.get(i)))&#xD;
		{&#xD;
			failed = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL USERVLAN IN ASSET fallito. Non trovata in consistenza la VLAN con ID: &quot; + UserVLANIDDecrementoRichiesta.get(i);&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC&#xD;
		|| localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN)&#xD;
{&#xD;
	&#xD;
	//Prop Bug #30451: per l'offerta BITSTREAMGBESIMMETRICO si assume il caso TAGGED&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICO)&#xD;
	{&#xD;
		taggingAsset = &quot;TAGGED&quot;;&#xD;
	}&#xD;
	&#xD;
	if(taggingAsset != null &amp;&amp; UserVLANIDRichiesta != null &amp;&amp; ((taggingAsset.toUpperCase() == &quot;TAGGED&quot; ||&#xD;
	   taggingAsset.toUpperCase() == &quot;UNTAGGED&quot;) &amp;&amp; UserVLANIDRichiesta.size() > 0))&#xD;
	{&#xD;
		var i = 0;&#xD;
		while(!failed &amp;&amp; i &lt; UserVLANIDRichiesta.size())&#xD;
		{&#xD;
			if(!UserVLANIDAsset.contains(UserVLANIDRichiesta.get(i)))&#xD;
			{&#xD;
				failed = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL USERVLAN IN ASSET fallito. Non trovata in consistenza la VLAN con ID: &quot; + UserVLANIDRichiesta.get(i);&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
	&#xD;
	}&#xD;
	//AGGIUNTA CONDIZIONE PER KO ASSET TAGGED SENZA VLAN ID IN INPUT&#xD;
	else if (taggingAsset !=null &amp;&amp; taggingAsset.toUpperCase() == &quot;TAGGED&quot; &amp;&amp; UserVLANIDRichiesta.size()==0)&#xD;
	{&#xD;
		failed = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL USERVLAN IN ASSET fallito. Asset TAGGED e VLAN ID non presente in input&quot;;&#xD;
	}&#xD;
	&#xD;
}&#xD;
else if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING)&#xD;
{&#xD;
	if(taggingAsset != null &amp;&amp; taggingAsset.toUpperCase() == &quot;TAGGED&quot; &amp;&amp; taggingRichiesta != null &amp;&amp; taggingRichiesta.toUpperCase() == &quot;UNTAGGED&quot;)&#xD;
	{&#xD;
		if(!UserVLANIDAsset.contains(UserVLANID))&#xD;
		{&#xD;
			failed = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL USERVLAN IN ASSET fallito. Non trovata in consistenza la VLAN con ID: &quot; + UserVLANID;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL USERVLAN IN ASSET positivo.&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
