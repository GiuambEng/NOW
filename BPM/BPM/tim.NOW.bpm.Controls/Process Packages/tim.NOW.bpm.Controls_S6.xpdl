    <xpdl2:WorkflowProcess Id="_FUA8kATmEeeZqucln-kp1w" xpdExt:DisplayName="CTRL RID CVLANCODE GBE_C04M01F144" Name="CTRLRIDCVLANCODEGBE_C04M01F144">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_FUD_4gTmEeeZqucln-kp1w" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_FUBjoQTmEeeZqucln-kp1w" Width="31.0">
              <xpdl2:Coordinates XCoordinate="599.0" YCoordinate="253.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_FUD_4wTmEeeZqucln-kp1w" Name="VerificaridondanzaCVLANCODEperGBE" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica ridondanza CVLANCODE per GBE" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Dati insufficienti per effettuare le verifiche&quot;;&#xD;
&#xD;
var foundSvlanCode = false;&#xD;
var foundCVlanCode = false;&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
		{&#xD;
			foundSvlanCode = false;&#xD;
			foundCVlanCode = false;&#xD;
			var j = 0;&#xD;
			while((!foundSvlanCode || !foundCVlanCode) &amp;&amp; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentDettaglioOrdine.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
				{&#xD;
					//Trovato SVLANCODE&#xD;
					foundSvlanCode = true;&#xD;
				}&#xD;
				else if(currentDettaglioOrdine.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
				{&#xD;
					//Trovato CodevlanSingleTag&#xD;
					foundCVlanCode = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(foundSvlanCode &amp;&amp; foundCVlanCode)&#xD;
		{&#xD;
			//Entrambi gli attributi (SVlanCode, CodeVlanSingleTag) trovati&#xD;
			break;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(foundSvlanCode &amp;&amp; foundCVlanCode)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL RID CVLANCODE GBE fallito. Trovato SVLANCODE e CVLANCODE&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL RID CVLANCODE GBE poritivo.&quot;;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
