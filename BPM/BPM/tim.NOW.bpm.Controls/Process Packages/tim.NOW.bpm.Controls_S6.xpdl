        <xpdl2:Activity Id="_l62uJ_zeEeawSun_Qeigjg" Name="VerificaCongruenzaBandaConsegnaperATM" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Congruenza BandaConsegna per ATM">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var listaTipoBandaConsegna = DataUtil.createList();&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDACONSEGNA)&#xD;
			{&#xD;
				listaTipoBandaConsegna.add(currentAttDettOrdine.valoreAttributo);&#xD;
				Process.auditLog(&quot;Trovata la seguente BandaConsegna: &quot; + currentAttDettOrdine.valoreAttributo);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
var offerta_tmp = &quot;&quot;;&#xD;
&#xD;
if(localRequest.caratteristica != null)&#xD;
{&#xD;
	offerta_tmp = String(localRequest.offerta);&#xD;
}&#xD;
else if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.offerta != null)&#xD;
{&#xD;
	offerta_tmp = String(ConsistenzaDati.offerta);&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Offerta: &quot; + offerta_tmp);&#xD;
&#xD;
var failed = false;&#xD;
&#xD;
if(offerta_tmp == &quot;BITSTREAMATMASIMMETRICOFLAT&quot;)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!failed &amp;&amp; i &lt; listaTipoBandaConsegna.size())&#xD;
	{&#xD;
		var currentTipoBanda = listaTipoBandaConsegna.get(i);&#xD;
		&#xD;
		if(currentTipoBanda != &quot;CONDIVISA&quot; &amp;&amp; currentTipoBanda != &quot;DEDICATA&quot;)&#xD;
		{&#xD;
			failed = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
else if(offerta_tmp == &quot;BITSTREAMATMASIMMETRICOHL&quot;)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!failed &amp;&amp; i &lt; listaTipoBandaConsegna.size())&#xD;
	{&#xD;
		var currentTipoBanda = listaTipoBandaConsegna.get(i);&#xD;
		&#xD;
		if(currentTipoBanda != &quot;DEDICATA&quot;)&#xD;
		{&#xD;
			failed = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
else if(offerta_tmp == &quot;BITSTREAMATMASIMMETRICOLITE&quot;)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!failed &amp;&amp; i &lt; listaTipoBandaConsegna.size())&#xD;
	{&#xD;
		var currentTipoBanda = listaTipoBandaConsegna.get(i);&#xD;
		&#xD;
		if(currentTipoBanda != &quot;CONDIVISA&quot;)&#xD;
		{&#xD;
			failed = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL BANDA CONSEGNA ATM negativo&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL BANDA CONSEGNA ATM positivo&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
