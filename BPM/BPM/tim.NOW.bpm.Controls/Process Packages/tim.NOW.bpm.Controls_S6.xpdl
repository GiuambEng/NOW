        <xpdl2:Activity Id="_8t9JNzutEeeeO7ajyIf1EA" Name="VerificaDNperMigrazioniWLRVULLsuNakedLNA" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica DN per Migrazioni WLR/VULL su Naked/LNA" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
//Verifica presenza DN in input &#xD;
if (localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null &amp;&amp; localRequest.ordine.dettaglioordine.size()>0)&#xD;
{	&#xD;
	var DN = false;&#xD;
	for (var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentdettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if (String(currentdettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{	&#xD;
			for (var j = 0; j &lt; currentdettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttdettOrdine = currentdettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				if (currentAttdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DN)&#xD;
				{&#xD;
					DN = true;&#xD;
					Process.auditLog(&quot;DN presente in input&quot;);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//ULL o SLU&#xD;
if ((localRequest.offerta != null&#xD;
&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
   	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA))&#xD;
	&amp;&amp; (ConsistenzaFonia != null &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
		|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
		|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEANONATTIVA&#xD;
		|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVA&#xD;
		|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEAATTIVA&#xD;
		|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
		|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
		|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEAATTIVANP&#xD;
		|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVANP)) &amp;&amp; DN == false)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DN per Migrazioni WLR/VULL negativo.&quot;;&#xD;
}&#xD;
&#xD;
//BTS &#xD;
else if ((localRequest.offerta != null&#xD;
&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA))&#xD;
	&amp;&amp; (ConsistenzaDati != null &amp;&amp; (ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULAFTTCAB) &amp;&amp; ConsistenzaDati.flagBTSNaked == &quot;Y&quot;) &amp;&amp; DN == false)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DN per Migrazioni WLR/VULL negativo.&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL DN per Migrazioni WLR/VULL positivo.&quot;;&#xD;
} </xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
