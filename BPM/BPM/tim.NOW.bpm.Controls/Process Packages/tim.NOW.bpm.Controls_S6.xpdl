        <xpdl2:Activity Id="_M4KPUf6XEea8keRKq8wfNA" Name="VerificaProfilodiBandaBMD" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Profilo di Banda BMD">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_dPtskP6XEea8keRKq8wfNA">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="false" Direction="IN" Formal="parameters">
                      <xpdl2:Actual ScriptGrammar="JavaScript">VerificaProfiloBandaBMDRequest</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageIn>
                <xpdl2:MessageOut Id="_dPtskf6XEea8keRKq8wfNA">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="parameters.esito.codice">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.codice</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="parameters.esito.descrizione">
                      <xpdl2:Actual ScriptGrammar="JavaScript">EsitoResponse.descrizione</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_5bhI8OVGEea6YttIibUsWA" OperationName="Verifica_Profilo_di_Banda_BMD">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckServiceFormaliPortTypeSOAP" ServiceName="BPM_CheckServiceFormaliPortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="BPM_CheckServiceFormali_v1.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="BPM_CheckServiceFormaliPortType" OperationName="Verifica_Profilo_di_Banda_BMD">
                  <xpdExt:ExternalReference location="BPM_CheckServiceFormali_v1.wsdl"/>
