          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaOverbookingRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerificaOverbookingVC_RequestType();&#xD;
&#xD;
VerificaOverbookingRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaOverbookingRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
&#xD;
var i = 0;&#xD;
while(i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var dettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	if(String(dettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(j &lt; dettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attDettOrdine = dettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
			{&#xD;
				VerificaOverbookingRequest.profiloTecnicoLinea = attDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	else if(dettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
	{&#xD;
		var datiVC = com_tim_NOW_xsd_ControlliFormali_Factory.createDATIVC();&#xD;
				&#xD;
		if (dettOrdine.azione != null &amp;&amp; dettOrdine.azione != &quot;&quot;)&#xD;
		{&#xD;
			datiVC.azione = com_tim_NOW_xsd_ControlliFormali_AzioneType.get(String(dettOrdine.azione));&#xD;
		}&#xD;
		&#xD;
		var j = 0;&#xD;
		while(j &lt; dettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attDettOrdine = dettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRUP)&#xD;
			{&#xD;
				datiVC.MCRUp = attDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRDOWN)&#xD;
			{&#xD;
				datiVC.MCRDown = attDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SCRUP)&#xD;
			{&#xD;
				datiVC.SCRUp = attDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SCRDOWN)&#xD;
			{&#xD;
				datiVC.SCRDown = attDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRUP)&#xD;
			{&#xD;
				datiVC.PCRUp = attDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRDOWN)&#xD;
			{&#xD;
				datiVC.PCRDown = attDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC)&#xD;
			{&#xD;
				datiVC.profiloVC = attDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDPROFILOVC)&#xD;
			{&#xD;
				datiVC.idProfiloVC = attDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
			{&#xD;
				datiVC.VCI = attDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
			{&#xD;
				datiVC.VPI = attDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
		VerificaOverbookingRequest.datiVc.add(ScriptUtil.copy(datiVC));&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(VerificaOverbookingRequest.profiloTecnicoLinea == null)&#xD;
{&#xD;
	VerificaOverbookingRequest.profiloTecnicoLinea = ConsistenzaDati.profiloTecnicoLinea;&#xD;
}&#xD;
&#xD;
AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
Asset = AssetRef.readAsset();&#xD;
&#xD;
var i = 0;&#xD;
while(i &lt; Asset.dettaglioasset.size())&#xD;
{&#xD;
	var dettAsset = Asset.dettaglioasset.get(i);&#xD;
	&#xD;
	if(dettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
	|| dettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
	{&#xD;
		var datiVC = com_tim_NOW_xsd_ControlliFormali_Factory.createDATIVC();&#xD;
		&#xD;
		var j = 0;&#xD;
		while(j &lt; dettAsset.attributidettaglioasset.size())&#xD;
		{&#xD;
			var attDettAsset = dettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
			if(attDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRUP)&#xD;
			{&#xD;
				datiVC.MCRUp = attDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRDOWN)&#xD;
			{&#xD;
				datiVC.MCRDown = attDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SCRUP)&#xD;
			{&#xD;
				datiVC.SCRUp = attDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SCRDOWN)&#xD;
			{&#xD;
				datiVC.SCRDown = attDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRUP)&#xD;
			{&#xD;
				datiVC.PCRUp = attDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRDOWN)&#xD;
			{&#xD;
				datiVC.PCRDown = attDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC)&#xD;
			{&#xD;
				datiVC.profiloVC = attDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDPROFILOVC)&#xD;
			{&#xD;
				datiVC.idProfiloVC = attDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
			{&#xD;
				datiVC.VCI = attDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(attDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
			{&#xD;
				datiVC.VPI = attDettAsset.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
		VerificaOverbookingRequest.consistenzaDatiVc.add(ScriptUtil.copy(datiVC));&#xD;
	}&#xD;
	i++;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
