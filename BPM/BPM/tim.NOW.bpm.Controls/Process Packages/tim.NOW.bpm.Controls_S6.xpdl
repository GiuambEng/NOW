          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo=true;&#xD;
&#xD;
&#xD;
&#xD;
if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
	&#xD;
		var trovataBanda = false;&#xD;
		var i=0;&#xD;
		while (!trovataBanda &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		 {&#xD;
		 	var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		 	&#xD;
		 	if( currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC )&#xD;
		 		{&#xD;
		 			for(var j = 0; j &lt; currentDettaglioOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
					{&#xD;
						var currentAttDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
						if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDACONSEGNA)&#xD;
						{&#xD;
					&#xD;
							trovataBanda=true;&#xD;
						}&#xD;
		 			}&#xD;
