        <xpdl2:Activity Id="_NNfx0uIqEeaA7ZwGk0WGwg" Name="VerificaVULLMonoVendor" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica VULL Mono Vendor">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL VULL MONOVENDOR Negativo: Dati insufficienti per le verifiche&quot;;&#xD;
&#xD;
if(ConsistenzaFonia != null)&#xD;
{&#xD;
	if(localRequest.codificaOLOAGCOM == ConsistenzaFonia.codificaOLOAGCOMDonating)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VULL MONOVENDOR Positivo: CodificaOLOAGCOM della richiesta corrispondente alla CodificaOLOAGCOMDonating della ConsistenzaFonia&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VULL MONOVENDOR Negativo: CodificaOLOAGCOM della richiesta non corrispondente alla CodificaOLOAGCOMDonating della ConsistenzaFonia&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VULL MONOVENDOR Negativo: CONSISTENZAFONIA non trovata&quot;;&#xD;
}</xpdl2:Script>
