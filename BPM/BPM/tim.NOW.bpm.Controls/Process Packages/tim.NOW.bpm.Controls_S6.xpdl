          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_UYPYUgP3Eeecl-4U35e5bg" Width="31.0">
              <xpdl2:Coordinates XCoordinate="607.0" YCoordinate="274.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_UYQmdAP3Eeecl-4U35e5bg" Name="VerificaIDSLUCOinconsistenza" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica IDSLUCO in consistenza">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var idslucoRichiesta = &quot;&quot;;&#xD;
idslucoRichiesta = null;&#xD;
var idslucoAsset = &quot;&quot;;&#xD;
idslucoAsset = null;&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
while(idslucoRichiesta == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(idslucoRichiesta == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDSLUCO)&#xD;
			{&#xD;
				idslucoRichiesta = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(ConsistenzaFonia != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaFonia.IDAsset, 10));&#xD;
	Asset = AssetRef.readAsset();&#xD;
	var i = 0;&#xD;
	&#xD;
	while(idslucoAsset == null &amp;&amp; i &lt; Asset.dettaglioasset.size())&#xD;
	{&#xD;
		var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
		if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(idslucoAsset == null &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
			{&#xD;
				var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDSLUCO)&#xD;
				{&#xD;
					idslucoAsset = currentAttDettAsset.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(idslucoRichiesta != null &amp;&amp; idslucoAsset != null &amp;&amp; idslucoRichiesta == idslucoAsset)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL IDSLUCO CONS positivo&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL IDSLUCO CONS negativo. IDSLUCO della Richiesta: &quot; + idslucoRichiesta + &quot; IDSLUCO in Consistenza: &quot; + idslucoAsset;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
