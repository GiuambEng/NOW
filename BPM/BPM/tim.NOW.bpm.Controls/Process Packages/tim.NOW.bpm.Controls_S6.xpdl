            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_J7ajQQWbEeeO9up-mGrNGw" Width="31.0">
              <xpdl2:Coordinates XCoordinate="816.0" YCoordinate="236.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_J7olsgWbEeeO9up-mGrNGw" Name="VerificaPresenzaSetUserVlan" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Presenza Set UserVlan">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICO&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)&#xD;
{&#xD;
	var foundUserVlan = false;&#xD;
	var i = 0;&#xD;
	&#xD;
	while(!foundUserVlan &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			foundUserVlan = true;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(foundUserVlan)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL SET USERVLAN positivo&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL SET USERVLAN fallito. Nessuna UserVlan trovata in INPUT&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset,10));&#xD;
Asset = AssetRef.readAsset();&#xD;
&#xD;
var uservlanTaggingAsset = &quot;&quot;;&#xD;
uservlanTaggingAsset = null;&#xD;
var uservlanIDAsset = DataUtil.createList();&#xD;
var uservlanIDRichiesta = DataUtil.createList();&#xD;
var foundSvlancodeRichiesta = false;&#xD;
var foundCvlanIDRichiesta = false;&#xD;
var foundCodeVlanSingleTagRichiesta = false;&#xD;
var EncapsulationRichiesta = &quot;&quot;;&#xD;
EncapsulationRichiesta = null;&#xD;
var countUservlanRichiesta = 0;&#xD;
&#xD;
&#xD;
for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
{&#xD;
	var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
	&#xD;
	if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
	   &amp;&amp; currentDettAsset.statoDettaglioAsset == &quot;ATTIVO&quot;)   //RU_1164: Nel confrontare con le USERVLAN in consistenza si dovranno considerare solo le USERVLAN con stato della componente ATTIVO&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
		{&#xD;
			var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
			if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
			{&#xD;
				uservlanIDAsset.add(currentAttDettAsset.valoreAttributo);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
		{&#xD;
			var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
			if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING)&#xD;
			{&#xD;
				uservlanTaggingAsset = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
while(EncapsulationRichiesta == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(EncapsulationRichiesta == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
			{&#xD;
				EncapsulationRichiesta = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
var failed = false;&#xD;
i = 0;&#xD;
&#xD;
while(!failed &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
	{&#xD;
		countUservlanRichiesta++;&#xD;
		foundSvlancodeRichiesta = false;&#xD;
		foundCvlanIDRichiesta = false;&#xD;
		foundCodeVlanSingleTagRichiesta = false;&#xD;
		&#xD;
		var j = 0;&#xD;
		&#xD;
		while(!failed &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
			{&#xD;
				uservlanIDRichiesta.add(currentAttDettOrdine.valoreAttributo);&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
			{&#xD;
				foundSvlancodeRichiesta = true;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID)&#xD;
			{&#xD;
				foundCvlanIDRichiesta = true;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG)&#xD;
			{&#xD;
				foundCodeVlanSingleTagRichiesta = true;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
		if(EncapsulationRichiesta != null &amp;&amp; EncapsulationRichiesta.toUpperCase() == &quot;DOUBLETAG&quot;)&#xD;
		{&#xD;
			if(!foundSvlancodeRichiesta || !foundCvlanIDRichiesta)&#xD;
			{&#xD;
				failed = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL SET USERVLAN fallito: Trovata Encapsulation DOUBLETAG, ma assente Svlancode o CvlanID per DettaglioOrdine: &quot; + currentDettOrdine.IDDettaglioOrdine;&#xD;
			}&#xD;
		}&#xD;
		else if(EncapsulationRichiesta != null &amp;&amp; EncapsulationRichiesta.toUpperCase() == &quot;SINGLETAG&quot;)&#xD;
		{&#xD;
			if(!foundCodeVlanSingleTagRichiesta)&#xD;
			{&#xD;
				failed = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL SET USERVLAN fallito: Trovata Encapsulation SINGLETAG, ma assente CodeVlanSingleTag per DettaglioOrdine: &quot; + currentDettOrdine.IDDettaglioOrdine;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			failed = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL SET USERVLAN fallito: Encapsulation non trovata o valore non gestito per DettaglioOrdine: &quot; + currentDettOrdine.IDDettaglioOrdine;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(uservlanTaggingAsset != null &amp;&amp; uservlanTaggingAsset.toUpperCase() == &quot;UNTAGGED&quot;)&#xD;
{&#xD;
	if(countUservlanRichiesta != 1)&#xD;
	{&#xD;
		failed = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL SET USERVLAN fallito: Trovate &quot; + countUservlanRichiesta + &quot; UserVlan in INPUT per USERVLAN1TAGGING UNTAGGED in ASSET&quot;;&#xD;
	}&#xD;
}&#xD;
else if(uservlanTaggingAsset != null &amp;&amp; uservlanTaggingAsset.toUpperCase() == &quot;TAGGED&quot;)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(!failed &amp;&amp; i &lt; uservlanIDAsset.size())&#xD;
	{&#xD;
		if(!uservlanIDRichiesta.contains(uservlanIDAsset.get(i)))&#xD;
		{&#xD;
			failed = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL SET USERVLAN fallito: Non trovata in Richiesta l'UserVlanID &quot; + uservlanIDAsset.get(i) + &quot; presente in ASSET per USERVLAN1TAGGING TAGGED&quot;;&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	failed = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL SET USERVLAN fallito: USERVLAN1TAGGING in Asset non trovato o valore non gestito&quot;;&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL SET USERVLAN positivo&quot;;&#xD;
}&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
