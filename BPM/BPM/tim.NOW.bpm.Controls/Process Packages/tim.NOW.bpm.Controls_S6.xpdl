            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_mG5MsgAYEeeCcNWKDtDUdA" Name="VerificaNumerazioniAggiuntive" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Numerazioni Aggiuntive" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var attivazioneSTSMultinumero = localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTSMULTINUMERO;&#xD;
var aggiuntiviISDN = 0;&#xD;
aggiuntiviISDN = null;&#xD;
var numAggiuntivi = 0;&#xD;
numAggiuntivi = null;&#xD;
var failed = false;&#xD;
var numeriTelefonici = DataUtil.createList();&#xD;
var tipolineaWLR = &quot;&quot;; // per RU_852&#xD;
var strutturaLineaWLR = &quot;&quot;; // SM_8706&#xD;
&#xD;
if(ConsistenzaFonia != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaFonia.IDAsset, 10));&#xD;
	if(AssetRef != null)&#xD;
	{&#xD;
		Asset = AssetRef.readAsset();&#xD;
		for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
			if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
			{&#xD;
				for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
				{&#xD;
					var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
					//RU_852 start -- salvo attributo TIPOLINEA solo per CESSAZIONESTSMULTINUMERO.&#xD;
					if(!attivazioneSTSMultinumero &amp;&amp; currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						tipolineaWLR = currentAttDettAsset.valoreAttributo;&#xD;
					}&#xD;
					else if(!attivazioneSTSMultinumero &amp;&amp; currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
					{&#xD;
						strutturaLineaWLR = currentAttDettAsset.valoreAttributo; // SM_8706&#xD;
					}&#xD;
					//RU_852 end&#xD;
					if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMAGGIUNTIVI &amp;&amp; currentAttDettAsset.valoreAttributo != &quot;&quot;)&#xD;
					{&#xD;
						numAggiuntivi = parseInt(currentAttDettAsset.valoreAttributo, 10);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			else if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.AGGIUNTIVO)&#xD;
			{&#xD;
				//RU_852 start&#xD;
				var statoAggiuntivo = DataUtil.createList();;&#xD;
				var numTelefonicoAggiuntivo = DataUtil.createList();&#xD;
				for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
				{&#xD;
					var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
					if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATO)&#xD;
					{&#xD;
						statoAggiuntivo.add(currentAttDettAsset.valoreAttributo);&#xD;
					}&#xD;
					if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
					{&#xD;
						numTelefonicoAggiuntivo.add(currentAttDettAsset.valoreAttributo);	&#xD;
					}&#xD;
				}&#xD;
				for(var k = 0; k &lt; numTelefonicoAggiuntivo.size(); k++)&#xD;
				{					&#xD;
					//anche in ATTIVAZIONESTSMULTINUMERO va controllato lo stato ATTIVO.&#xD;
					if(numTelefonicoAggiuntivo.get(k) != null &amp;&amp; statoAggiuntivo.get(k) != null &amp;&amp; statoAggiuntivo.get(k) == 'ATTIVO')&#xD;
					{&#xD;
						numeriTelefonici.add(numTelefonicoAggiuntivo.get(k));&#xD;
					}&#xD;
				}&#xD;
				//RU_852 end&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
			{&#xD;
				for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AGGIUNTIVIISDN &amp;&amp; currentAttDettOrdine.valoreAttributo != &quot;&quot;)&#xD;
					{&#xD;
						aggiuntiviISDN = parseInt(currentAttDettOrdine.valoreAttributo, 10);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//ATTIVAZIONESTSMULTINUMERO&#xD;
		if(attivazioneSTSMultinumero)&#xD;
		{&#xD;
			if(aggiuntiviISDN + numAggiuntivi > 7)&#xD;
			{&#xD;
				failed = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL NUM AGGIUNTIVI fallito. La somma di AggiuntiviISDN: &quot; + aggiuntiviISDN + &quot; e NumeriAggiuntivi: &quot; + numAggiuntivi + &quot;maggiore di 7 per ATTIVAZIONESTSMULTINUMERO&quot;;&#xD;
				CodiceEsito = &quot;KO_01&quot;;&#xD;
			}&#xD;
		}&#xD;
		//CESSAZIONESTSMULTINUMERO&#xD;
		else&#xD;
		{&#xD;
			var i = 0;&#xD;
			while(!failed &amp;&amp; i &lt; localRequest.DNAggiuntivo.size())&#xD;
			{&#xD;
				if(!numeriTelefonici.contains(localRequest.DNAggiuntivo.get(i)))&#xD;
				{&#xD;
					failed = true;&#xD;
					EsitoResponse.descrizione = &quot;CTRL NUM AGGIUNTIVI fallito. NumeroAggiuntivo: &quot; + localRequest.DNAggiuntivo.get(i) + &quot; non trovato in consistenza&quot;;&#xD;
					CodiceEsito = &quot;KO_02&quot;;&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
			//RU_852 start &amp;&amp; SM_8706&#xD;
			if(tipolineaWLR == &quot;ISDN&quot; &amp;&amp; strutturaLineaWLR.toUpperCase() == &quot;BRA MULTI&quot;)&#xD;
			{&#xD;
				if(numAggiuntivi -  aggiuntiviISDN &lt; 1)&#xD;
				{&#xD;
					failed = true;&#xD;
					EsitoResponse.descrizione = &quot;CTRL NUM AGGIUNTIVI fallito. La differenza di NumeriAggiuntivi: &quot; + numAggiuntivi + &quot; e AggiuntiviISDN: &quot; + aggiuntiviISDN + &quot; minore di 1 per CESSAZIONESTSMULTINUMERO&quot;;&#xD;
					CodiceEsito = &quot;KO_03&quot;;&#xD;
				}&#xD;
			}&#xD;
			//RU_852 end&#xD;
			&#xD;
			//CR514: aggiunto scarto KO_02&#xD;
			if(aggiuntiviISDN != localRequest.DNAggiuntivo.size())&#xD;
			{&#xD;
				failed = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL NUM AGGIUNTIVI fallito. AGGIUNTIVIISDN:&quot; + aggiuntiviISDN + &quot;è diverso dal numero dei DNAggiuntivo:&quot; + localRequest.DNAggiuntivo.size();&#xD;
				CodiceEsito = &quot;KO_02&quot;;&#xD;
			}&#xD;
			//----------------------------&#xD;
			&#xD;
		}&#xD;
		&#xD;
		if(failed)&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL NUM AGGIUNTIVI positivo&quot;;&#xD;
		}&#xD;
		&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL NUM AGGIUNTIVI fallito: nessun Asset recuperato per ID: &quot; + ConsistenzaFonia.IDAsset;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL NUM AGGIUNTIVI fallito: nessuna ConsistenzaFonia trovata&quot;;&#xD;
}</xpdl2:Script>
