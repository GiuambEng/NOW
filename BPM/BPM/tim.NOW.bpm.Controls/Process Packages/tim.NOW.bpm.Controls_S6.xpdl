        </xpdl2:Activity>
        <xpdl2:Activity Id="_ecfEV_RoEeazKYdqUBpQKA" Name="VerificaVOIPperWLRVULLRecipient" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica VOIP per WLR/VULL Recipient" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;CTRL VOIP WLR VULL RECIPIENT fallito : Dati insufficienti ad effettuare il controllo&quot;;&#xD;
&#xD;
/*&#xD;
if(NumberPortability != null)&#xD;
{&#xD;
	if(NumberPortability.tipoLinea == &quot;VOIP&quot; &amp;&amp; localRequest.numeroTelefonico == NumberPortability.numeroTelefonico)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VOIP WLR VULL RECIPIENT negativo&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VOIP WLR VULL RECIPIENT positivo&quot;;&#xD;
	}&#xD;
}&#xD;
else if(InventoryOut!= null &amp;&amp; InventoryOut.datiUnica!= null){&#xD;
	Process.auditLog(&quot;Controllo eseguito su Inventory:tipoNumero=&quot;+InventoryOut.datiUnica.tipoNumero);&#xD;
	if(InventoryOut.datiUnica.tipoNumero== &quot;NATIVO VOIP IMS&quot; &amp;&amp; localRequest.numeroTelefonico == InventoryOut.datiUnica.numeroTelefonicoPrincipale){&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VOIP WLR VULL RECIPIENT negativo&quot;;&#xD;
	}&#xD;
	else{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VOIP WLR VULL RECIPIENT positivo&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VOIP WLR VULL RECIPIENT negativo: nessuna NumberPortability trovata&quot;;&#xD;
}&#xD;
*/&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
{&#xD;
	if(localRequest.DNAggiuntivo != null &amp;&amp; localRequest.DNAggiuntivo.size() > 0)&#xD;
	{&#xD;
		if(NumberPortability != null &amp;&amp; NumberPortability.size() > 0)&#xD;
		{&#xD;
			var failed = false;&#xD;
			var matched = false;&#xD;
			var DNRichiesta = localRequest.DNAggiuntivo.get(0);&#xD;
		&#xD;
			var i = 0;&#xD;
			while(!matched &amp;&amp; i &lt; NumberPortability.size())&#xD;
			{&#xD;
				var currentNumberPortability = NumberPortability.get(i);&#xD;
				&#xD;
				if(currentNumberPortability.numeroTelefonico == DNRichiesta)&#xD;
				{&#xD;
					matched = true;&#xD;
					Process.auditLog(&quot;Trovata corrispondenza tra DNRichiesta e DN NP. TipoLinea NP: &quot; + currentNumberPortability.tipoLinea);&#xD;
					if(currentNumberPortability.tipoLinea == &quot;VOIP&quot;)&#xD;
					{&#xD;
						failed = true;&#xD;
						EsitoResponse.descrizione = &quot;CTRL VOIP WLR VULL RECIPIENT negativo. Tipolinea della NumberPortability corrispondente uguale a VOIP&quot;;&#xD;
					}&#xD;
				}&#xD;
				i++;&#xD;
			}&#xD;
		&#xD;
			if(!matched || failed)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL VOIP WLR VULL RECIPIENT positivo&quot;;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL VOIP WLR VULL RECIPIENT negativo&quot;;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VOIP WLR VULL RECIPIENT positivo, DN non presente in INPUT&quot;;&#xD;
	}&#xD;
}&#xD;
else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
{&#xD;
	if(InventoryOut!= null &amp;&amp; InventoryOut.datiUnica!= null)&#xD;
	{&#xD;
		Process.auditLog(&quot;Controllo eseguito su Inventory:tipoNumero = &quot; + InventoryOut.datiUnica.tipoNumero);&#xD;
		if(InventoryOut.datiUnica.tipoNumero == &quot;NATIVO VOIP IMS&quot; &amp;&amp; localRequest.numeroTelefonico == InventoryOut.datiUnica.numeroTelefonicoPrincipale&#xD;
		&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA) // WLR LA aggiunta con RU_860&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL VOIP WLR VULL RECIPIENT negativo&quot;;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL VOIP WLR VULL RECIPIENT positivo&quot;;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
		{&#xD;
			EsitoResponse.codice = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL VOIP WLR VULL RECIPIENT skippato : Dati Inventory non presenti&quot;;&#xD;
		}&#xD;
}&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
