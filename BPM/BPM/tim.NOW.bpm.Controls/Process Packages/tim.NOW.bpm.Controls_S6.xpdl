        <xpdl2:Activity Id="__aLhMBCzEeedvsft6w9Rug" Name="LookforRoutingNumber" xpdExt:Visibility="Private" xpdExt:DisplayName="Look for RoutingNumber">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = true;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
{&#xD;
	Process.auditLog(&quot;Verifica Precondizione, Offerta: &quot;+localRequest.offerta);&#xD;
	&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA ||&#xD;
	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL ||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA ||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA ||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA ||&#xD;
	 localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA)&#xD;
	 {&#xD;
	 	EseguiControllo=false;&#xD;
	 }&#xD;
	 else if(String(localRequest.offerta).slice(0,9) == &quot;BITSTREAM&quot;)&#xD;
	 {&#xD;
	 	var condiviso=false;&#xD;
	 	var i=0;&#xD;
	 	while (!condiviso &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	 	{&#xD;
	 		var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	 		if (String(currentComponente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	 			{&#xD;
	 				var j=0;&#xD;
	 				while (!condiviso &amp;&amp; j&lt; currentComponente.attributiDettaglioOrdine.size())&#xD;
	 				{&#xD;
	 					var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
	 					&#xD;
	 					if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA&#xD;
	 						&amp;&amp; (currentAttributo.valoreAttributo == &quot;POTS&quot; || currentAttributo.valoreAttributo == 'ISDN' ))&#xD;
	 						{&#xD;
	 							condiviso=true;&#xD;
	 						}&#xD;
	 					 &#xD;
	 				j++;	&#xD;
	 				}&#xD;
	 			&#xD;
	 			}&#xD;
	 	i++;&#xD;
	 	}&#xD;
	 	if (condiviso)&#xD;
	 	{&#xD;
	 		Process.auditLog(&quot;Offerta BTS Condivisa&quot;);&#xD;
	 		EseguiControllo=false;&#xD;
	 	}&#xD;
	 }&#xD;
}&#xD;
	 &#xD;
// RU_756 - Effettuare il controllo se presente almeno una NP Donor TLC&#xD;
if(EseguiControllo)&#xD;
{&#xD;
	EseguiControllo = false;&#xD;
	&#xD;
	if(NumberPortability != null &amp;&amp; NumberPortability.size() > 0) //SM_10050 prima era nell'if esterno&#xD;
	{&#xD;
		for(var k = 0; k &lt; NumberPortability.size(); k++)&#xD;
		{&#xD;
			Process.auditLog(&quot;Ciclo su Number Portability &quot;+(k+1)+&quot;, Donor: &quot;+NumberPortability.get(k).codiceOperatoreDonor);&#xD;
			&#xD;
			if(NumberPortability.get(k).codiceOperatoreDonor == 'TLC')&#xD;
			{&#xD;
				Process.auditLog(&quot;Trovata NP TLC, controllo da effettuare&quot;);&#xD;
				EseguiControllo = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//SM_10781&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
	    &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
			|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP) &#xD;
		&amp;&amp; DatiDiogene != null &amp;&amp; DatiDiogene != &quot;&quot; &amp;&amp; DatiDiogene.flagDnDonorOlo == &quot;N&quot;)&#xD;
	{&#xD;
		Process.auditLog(&quot;Lavorazione Attivazione e restituito FLAGDONOROLO:&quot; +DatiDiogene.flagDnDonorOlo+ &quot;in uscita da CTRL NP SINCRONIZZATA_C04M03F06&quot;);&#xD;
		EseguiControllo = true;&#xD;
	}&#xD;
	&#xD;
	if(!EseguiControllo)&#xD;
	{&#xD;
		Process.auditLog(&quot;Trovate solo NP Donor OLO, controllo da non effettuare&quot;);&#xD;
	}&#xD;
}&#xD;
&#xD;
if(EseguiControllo)&#xD;
{	&#xD;
	var i = 0;&#xD;
	while(routingNumber == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(routingNumber == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER)&#xD;
				{&#xD;
					routingNumber = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		else if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;&#xD;
			 &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE) // In caso di Attivazione lo prende dall'accesso perché non c'è ancora la NP&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(routingNumber == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER)&#xD;
				{&#xD;
					routingNumber = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
