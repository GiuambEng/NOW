        <xpdl2:Activity Id="_tIOMwFKeEeeXKqQfwvM4Aw" Name="PrecondizioneVariazione" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione Variazione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">eseguiControllo = false;&#xD;
&#xD;
if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
      ||localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
	  ||localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)   //SM_10325: aggiunte ATTIVAZIONE e MIGRAZIONE e offerte&#xD;
   &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
      ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH)&#xD;
   &amp;&amp; localRequest.ordine != null)&#xD;
{	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);		&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
		{&#xD;
			var trovatoprofiloBMD = false;&#xD;
			var trovatoFlagMulticast = false;&#xD;
			&#xD;
			for(var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)			&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD)&#xD;
				{&#xD;
					trovatoprofiloBMD = true;&#xD;
				}&#xD;
				//SM_10325&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
				{&#xD;
					trovatoFlagMulticast = true;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if((trovatoFlagMulticast &amp;&amp; trovatoprofiloBMD) //SM_10325: eseguo il controllo per tutte le lavorazioni se la USERVLAN ha FLAGMULTICAST e anche PROFILOBMD (deve esserci uno scarto lato BW)&#xD;
			    ||(trovatoprofiloBMD &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
			       &amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC)) //Pre-SM_10325: chiamiamo il controllo se c'è una variazione di PROFILOBMD. Il controllo veniva chiamato solo per RICONFIGURAZIONEVC, è lo scarto FLAGMULTICAST-PROFILOBMD che va fatto anche per le altre sottolav.&#xD;
			{&#xD;
				eseguiControllo = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
