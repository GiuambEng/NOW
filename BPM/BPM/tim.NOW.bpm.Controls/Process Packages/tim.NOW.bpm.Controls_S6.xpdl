        <xpdl2:Activity Id="_ctiL5Ql0EeeDDtMDmF9rOw" Name="VerificaSUMVCallespletamento" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica SUM VC all’espletamento" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset,10));&#xD;
Asset = AssetRef.readAsset();&#xD;
&#xD;
var countVCAsset = 0;&#xD;
var countVCIncrementoRichiesta = 0;&#xD;
var countVCDecrementoRichiesta = 0;&#xD;
&#xD;
for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
{&#xD;
	var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
	&#xD;
	if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
		|| currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
	{&#xD;
		countVCAsset++;&#xD;
	}&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
	{&#xD;
		if(currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
		{&#xD;
			countVCIncrementoRichiesta++;&#xD;
		}&#xD;
		else if(currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		{&#xD;
			countVCDecrementoRichiesta++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(countVCAsset + countVCIncrementoRichiesta - countVCDecrementoRichiesta &lt;= 10)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL SUM VC ESPLETAMENTO positivo: somma di DatiVC minore o uguale a 10. DatiVC in Consistenza: &quot; + countVCAsset + &quot; DatiVC in Incremento: &quot; + countVCIncrementoRichiesta + &quot; DatiVC in Decremento: &quot; + countVCDecrementoRichiesta;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL SUM VC ESPLETAMENTO negativo: somma di DatiVC superiore a 10. DatiVC in Consistenza: &quot; + countVCAsset + &quot; DatiVC in Incremento: &quot; + countVCIncrementoRichiesta + &quot; DatiVC in Decremento: &quot; + countVCDecrementoRichiesta;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
