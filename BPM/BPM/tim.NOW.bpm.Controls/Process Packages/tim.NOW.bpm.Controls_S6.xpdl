    <xpdl2:WorkflowProcess Id="_FuLcwASpEeeZqucln-kp1w" xpdExt:XpdModelType="ServiceProcess" xpdExt:DisplayName="CTRL COMP CARATTERISTICA_C04M01F137" Name="CTRLCOMPCARATTERISTICA_C04M01F137">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_N3uyRgSzEeeZqucln-kp1w" xpdExt:DisplayName="LavorazioneRichiesta" Name="LavorazioneRichiesta">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="com.tim.NOW.xsd.StoricoDatiVerificaControlli.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.StoricoDatiVerificaControlliLavorazioneRichiestaType"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_N3uyRwSzEeeZqucln-kp1w" xpdExt:DisplayName="subprocessIdentifier" Name="subprocessIdentifier">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>500</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_FuMq4QSpEeeZqucln-kp1w" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="52.0" LaneId="_FuLcwgSpEeeZqucln-kp1w" Width="31.0">
              <xpdl2:Coordinates XCoordinate="1150.0" YCoordinate="270.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_FuMq4gSpEeeZqucln-kp1w" Name="VerificavariazioneattributoCaratteristicaEasyIP" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica variazione attributo Caratteristica EasyIP" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var failed = false;&#xD;
var profiloTecnicoLineaRichiesta = &quot;&quot;;&#xD;
profiloTecnicoLineaRichiesta = null;&#xD;
var foundModulazioneRichiesta = false;&#xD;
var foundDatiVCRichiesta = false;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA&#xD;
				&amp;&amp; currentAttDettOrdine.valoreAttributo.length > 0)&#xD;
			{&#xD;
				profiloTecnicoLineaRichiesta = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MODULAZIONE)&#xD;
			{&#xD;
				foundModulazioneRichiesta = true;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC)&#xD;
			{&#xD;
				foundDatiVCRichiesta = true;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(ConsistenzaDati != null)&#xD;
{&#xD;
	//STEP1&#xD;
	if((ConsistenzaDati.caratteristica == &quot;0&quot; &amp;&amp; localRequest.caratteristica == &quot;1&quot;)&#xD;
		|| (ConsistenzaDati.caratteristica == &quot;1&quot; &amp;&amp; localRequest.caratteristica == &quot;0&quot;))&#xD;
	{&#xD;
		if(profiloTecnicoLineaRichiesta == null)&#xD;
		{&#xD;
			failed = true;&#xD;
			EsitoResponse.descrizione = &quot;CTRL COMP CARATTERISTICA fallito. ProfiloTecnicoLinea nella richiesta non valorizzato per Caratteristica in richista: &quot; + localRequest.caratteristica + &quot; e caratteristica in ConsistenzaDati: &quot; + ConsistenzaDati.caratteristica;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	//STEP2&#xD;
	if(!failed &amp;&amp; profiloTecnicoLineaRichiesta != null)&#xD;
	{&#xD;
		if(!foundDatiVCRichiesta &amp;&amp; !foundModulazioneRichiesta)&#xD;
		{&#xD;
			if((ConsistenzaDati.caratteristica == &quot;0&quot; &amp;&amp; ConsistenzaDati.profiloTecnicoLinea == &quot;A&quot; &amp;&amp; localRequest.caratteristica == &quot;1&quot; &amp;&amp; profiloTecnicoLineaRichiesta == &quot;A1&quot;)&#xD;
				|| (ConsistenzaDati.caratteristica == &quot;1&quot; &amp;&amp; ConsistenzaDati.profiloTecnicoLinea == &quot;A1&quot; &amp;&amp; localRequest.canaleRichiesta == &quot;0&quot; &amp;&amp; profiloTecnicoLineaRichiesta == &quot;A&quot;))&#xD;
			{&#xD;
				LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
				localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONECARATTERISTICA;&#xD;
				LavorazioneRichiesta.sottoLavorazione = String(localRequest.ordine.tipologiaSottolav);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(failed)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL COMP CARATTERISTICA positivo.&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
