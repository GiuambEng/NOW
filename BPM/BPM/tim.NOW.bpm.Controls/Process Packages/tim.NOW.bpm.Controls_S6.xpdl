    <xpdl2:WorkflowProcess Id="_CWlRMP_7EeaG_cVvdplHPQ" xpdExt:XpdModelType="ServiceProcess" xpdExt:DisplayName="CTRL STS_C04M01F104" Name="CTRLSTS_C04M01F104">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_46UKEAAFEeeCcNWKDtDUdA" xpdExt:DisplayName="AssetRef" Name="AssetRef">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_r-btAAAGEeeCcNWKDtDUdA" xpdExt:DisplayName="Asset" Name="Asset">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_m3XiEOtgEeWJlNXqzYh0oA"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_oSJYwQAXEeeCcNWKDtDUdA" xpdExt:DisplayName="CodiceEsito" Name="CodiceEsito">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_NiRAVAAYEeeCcNWKDtDUdA" xpdExt:DisplayName="ProcessIdentifier" Name="ProcessIdentifier">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>500</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_CW4MIf_7EeaG_cVvdplHPQ" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="52.0" LaneId="_CWnGYf_7EeaG_cVvdplHPQ" Width="31.0">
              <xpdl2:Coordinates XCoordinate="962.0" YCoordinate="240.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_CW4MIv_7EeaG_cVvdplHPQ" Name="VerificaSTS" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica STS" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
//SM_7887 (Step 0)&#xD;
var codiciSTSCensiti = DataUtil.createList();&#xD;
codiciSTSCensiti.add('05');&#xD;
codiciSTSCensiti.add('09');&#xD;
codiciSTSCensiti.add('17');&#xD;
codiciSTSCensiti.add('21');&#xD;
codiciSTSCensiti.add('22');&#xD;
codiciSTSCensiti.add('23');&#xD;
codiciSTSCensiti.add('24');&#xD;
codiciSTSCensiti.add('25');&#xD;
codiciSTSCensiti.add('26');&#xD;
codiciSTSCensiti.add('27');&#xD;
codiciSTSCensiti.add('28');&#xD;
codiciSTSCensiti.add('29');&#xD;
codiciSTSCensiti.add('30');&#xD;
codiciSTSCensiti.add('31');&#xD;
codiciSTSCensiti.add('32');&#xD;
&#xD;
//SM_8947&#xD;
var codiciSTSjumpStep2 = DataUtil.createList();&#xD;
codiciSTSjumpStep2.add('15');&#xD;
codiciSTSjumpStep2.add('16');&#xD;
&#xD;
//SM_8947 eliminati controlli per sottolav ATTIVAZIONESTSMULTINUMERO e CESSAZIONESTSMULTINUMERO (già non presente).&#xD;
//var attivazioneSTSMultinumero = localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTSMULTINUMERO;&#xD;
var attivazioneSTS = localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONESTS;&#xD;
var incrementoBorchia = localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTOBORCHIA;&#xD;
&#xD;
//STEP0 &#xD;
if((attivazioneSTS || incrementoBorchia) &amp;&amp; codiciSTSCensiti.contains(localRequest.codiceSTS))&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL STS fallito. CodiceSTS richiesto tra quelli censiti come RISERVATI&quot;;&#xD;
	CodiceEsito = &quot;KO_08&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	if(ConsistenzaFonia != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaFonia.IDAsset));&#xD;
		&#xD;
		var codiciSTS = DataUtil.createList();&#xD;
		var failed = false;&#xD;
		var borchia = &quot;&quot;;&#xD;
		&#xD;
		if(AssetRef != null)&#xD;
		{&#xD;
			Asset = AssetRef.readAsset();&#xD;
		&#xD;
			for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
			{&#xD;
				var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
			&#xD;
				if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.STS &#xD;
					&amp;&amp; currentDettAsset.statoDettaglioAsset == it_telecomitalia_it_NOW_casedata_StatoAssetEnumeration.ATTIVO)&#xD;
				{&#xD;
					for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICE)&#xD;
						{&#xD;
							codiciSTS.add(currentAttDettAsset.valoreAttributo);&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				else if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR)&#xD;
				{&#xD;
					for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
						&#xD;
						if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BORCHIANT1PLUS)&#xD;
						{&#xD;
							borchia = currentAttDettAsset.valoreAttributo;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			//SM_8947&#xD;
			if(!codiciSTSjumpStep2.contains(localRequest.codiceSTS))&#xD;
			{&#xD;
				//STEP1 - eliminato con RU_595&#xD;
				if(codiciSTS.contains(localRequest.codiceSTS))&#xD;
				{&#xD;
					//ATTIVAZIONESTS&#xD;
					if(attivazioneSTS)&#xD;
					{&#xD;
						failed = true;&#xD;
						EsitoResponse.descrizione = &quot;CTRL STS fallito: Trovato un CodiceSTS presente in consistenza per ATTIVAZIONESTS&quot;;&#xD;
						CodiceEsito = &quot;KO_01&quot;;&#xD;
					}&#xD;
				}&#xD;
				//CESSAZIONESTS&#xD;
				else if(!attivazioneSTS &amp;&amp; !incrementoBorchia)&#xD;
				{&#xD;
					failed = true;&#xD;
					EsitoResponse.descrizione = &quot;CTRL STS fallito: CodiceSTS non presente in consistenza per CESSAZIONESTS&quot;;&#xD;
					CodiceEsito = &quot;KO_05&quot;;&#xD;
				}		&#xD;
			}&#xD;
			&#xD;
			//STEP2	&#xD;
			//ATTIVAZIONESTS&#xD;
			if(attivazioneSTS || incrementoBorchia)&#xD;
			{&#xD;
				if(localRequest.codiceSTS == &quot;15&quot;)&#xD;
				{&#xD;
					if(ConsistenzaFonia.tipoLinea == &quot;ISDN&quot;)&#xD;
					{&#xD;
						if(borchia == &quot;W+&quot;)&#xD;
						{&#xD;
							failed = true;&#xD;
							EsitoResponse.descrizione = &quot;CTRL STS fallito. TipoLinea in ConsistenzaFonia ISDN e BORCHIANT1PLUS W+ per ATTIVAZIONESTS&quot;;&#xD;
							CodiceEsito = &quot;KO_02&quot;;&#xD;
						}&#xD;
					}&#xD;
					else if(ConsistenzaFonia.tipoLinea == &quot;POTS&quot;)&#xD;
					{&#xD;
						failed = true;&#xD;
						EsitoResponse.descrizione = &quot;CTRL STS fallito. TipoLinea in ConsistenzaFonia POTS per ATTIVAZIONESTS&quot;;&#xD;
						CodiceEsito = &quot;KO_03&quot;;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			//CESSAZIONESTS&#xD;
			else&#xD;
			{&#xD;
				if(localRequest.codiceSTS == &quot;16&quot;)&#xD;
				{&#xD;
					if(borchia != &quot;W+&quot;)&#xD;
					{&#xD;
						failed = true;&#xD;
						EsitoResponse.descrizione = &quot;CTRL STS fallito. BORCHIANT1PLUS diverso da W+: &quot; + borchia +&quot; per CESSAZIONESTS&quot;;&#xD;
						CodiceEsito = &quot;KO_06&quot;;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			&#xD;
			//STEP3&#xD;
			if(!failed)&#xD;
			{&#xD;
				//ATTIVAZIONESTS&#xD;
				if(attivazioneSTS || incrementoBorchia)&#xD;
				{&#xD;
					if(localRequest.codiceSTS == &quot;16&quot;)&#xD;
					{&#xD;
						failed = true;&#xD;
						EsitoResponse.descrizione = &quot;CTRL STS fallito. CodiceSTS 16 per ATTIVAZIONESTS&quot;;&#xD;
						CodiceEsito = &quot;KO_04&quot;;&#xD;
					}&#xD;
				}&#xD;
				//CESSAZIONESTS&#xD;
				else&#xD;
				{&#xD;
					if(localRequest.codiceSTS == &quot;15&quot;)&#xD;
					{&#xD;
						failed = true;&#xD;
						EsitoResponse.descrizione = &quot;CTRL STS fallito. CodiceSTS 15 per CESSAZIONESTS&quot;;&#xD;
						CodiceEsito = &quot;KO_07&quot;;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if(failed)&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;CTRL STS positivo&quot;;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;CTRL STS fallito: nessun Asset recuperato per ID: &quot; + ConsistenzaFonia.IDAsset;&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL STS fallito: nessuna ConsistenzaFonia trovata&quot;;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
