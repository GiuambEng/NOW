        </xpdl2:Activity>
        <xpdl2:Activity Id="_-IQlxwQPEeecl-4U35e5bg" Name="VerificaVariazioneBitstreamAsimmetricoLITE" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica Variazione Bitstream Asimmetrico LITE">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VARIAZIONE BITSTREAM ASIM LITE negativo. Offerta in ConsistenzaDati BITSTREAMATMASIMMETRICOLITE&quot;;&#xD;
}&#xD;
else if(ConsistenzaDati == null)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VARIAZIONE BITSTREAM ASIM LITE negativo. ConsistenzaDati non trovata.&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VARIAZIONE BITSTREAM ASIM LITE positivo. Offerta in ConsistenzaDati diversa da BITSTREAMATMASIMMETRICOLITE&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="100.0" LaneId="_-IPXogQPEeecl-4U35e5bg" Width="150.0">
