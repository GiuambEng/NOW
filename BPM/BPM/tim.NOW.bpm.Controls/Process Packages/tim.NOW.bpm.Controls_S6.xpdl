var i = 0;&#xD;
&#xD;
while(!azione &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var dettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
