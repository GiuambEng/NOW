        <xpdl2:Activity Id="_NnBVUvRjEeazKYdqUBpQKA" Name="ControlloServizioOrigine" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Controllo Servizio Origine">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
   if(ConsistenzaFonia != null)&#xD;
   {&#xD;
	  if(String(localRequest.tipologiaSottolav).slice(0,8) == &quot;TRASLOCO&quot; &amp;&amp; String(ConsistenzaFonia.offerta).slice(0,3) == 'WLR')&#xD;
	  {&#xD;
		    /*&#xD;
			if(localRequest.servizioOrigine == &quot;P&quot;&#xD;
						   &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVA&#xD;
										  || ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
										  || ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVANP))&#xD;
			{&#xD;
						   EsitoResponse.codice = true;&#xD;
						   EsitoResponse.descrizione = &quot;CTRL SERV ORIG positivo. ServizioOriginale: &quot; + localRequest.servizioOrigine + &quot; Offerta  ConsistenzaFonia: &quot; + ConsistenzaFonia.offerta;&#xD;
			}&#xD;
			else if(localRequest.servizioOrigine == &quot;Q&quot;&#xD;
										  &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
											   || ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
											   || ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVANP))&#xD;
			{&#xD;
						   EsitoResponse.codice = true;&#xD;
						   EsitoResponse.descrizione = &quot;CTRL SERV ORIG positivo. ServizioOriginale: &quot; + localRequest.servizioOrigine + &quot; Offerta  ConsistenzaFonia: &quot; + ConsistenzaFonia.offerta;&#xD;
			}&#xD;
			*/&#xD;
			if((localRequest.servizioOrigine == &quot;0&quot;)&#xD;
						   &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEAATTIVA))&#xD;
			{&#xD;
						   EsitoResponse.codice = true;&#xD;
						   EsitoResponse.descrizione = &quot;CTRL SERV ORIG positivo. ServizioOriginale: &quot; + localRequest.servizioOrigine + &quot; Offerta  ConsistenzaFonia: &quot; + ConsistenzaFonia.offerta;&#xD;
			}&#xD;
			else if((localRequest.servizioOrigine == &quot;1&quot;)&#xD;
										  &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEANONATTIVA))&#xD;
			{&#xD;
						   EsitoResponse.codice = true;&#xD;
						   EsitoResponse.descrizione = &quot;CTRL SERV ORIG positivo. ServizioOriginale: &quot; + localRequest.servizioOrigine + &quot; Offerta  ConsistenzaFonia: &quot; + ConsistenzaFonia.offerta;&#xD;
			}&#xD;
&#xD;
			else&#xD;
			{&#xD;
						   EsitoResponse.codice = false;&#xD;
						   EsitoResponse.descrizione = &quot;CTRL SERV ORIG fallito per offerta: &quot; + localRequest.offerta + &quot; per sottolavorazione TRASLOCO e servizio origine: &quot;+ localRequest.servizioOrigine;&#xD;
			}&#xD;
	  }&#xD;
	  &#xD;
	  /*&#xD;
	  else if (localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOCOPPIA &#xD;
								   || localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOCOPPIADG )&#xD;
	  {&#xD;
					if(localRequest.servizioOrigine == &quot;D&quot;&#xD;
								   &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVA&#xD;
												  || ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEANONATTIVA))&#xD;
					{&#xD;
								   EsitoResponse.codice = true;&#xD;
								   EsitoResponse.descrizione = &quot;CTRL SERV ORIG positivo. ServizioOriginale: &quot; + localRequest.servizioOrigine + &quot; Offerta  ConsistenzaFonia: &quot; + ConsistenzaFonia.offerta;&#xD;
					}&#xD;
					else if((localRequest.servizioOrigine == &quot;E&quot;)&#xD;
												  &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVANP))&#xD;
					{&#xD;
								   EsitoResponse.codice = true;&#xD;
								   EsitoResponse.descrizione = &quot;CTRL SERV ORIG positivo. ServizioOriginale: &quot; + localRequest.servizioOrigine + &quot; Offerta  ConsistenzaFonia: &quot; + ConsistenzaFonia.offerta;&#xD;
					}&#xD;
					else if((localRequest.servizioOrigine == &quot;F&quot;)&#xD;
												  &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SHACONMANODOPERA&#xD;
																 || ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SHASENZAMANODOPERA))&#xD;
					{&#xD;
								   EsitoResponse.codice = true;&#xD;
								   EsitoResponse.descrizione = &quot;CTRL SERV ORIG positivo. ServizioOriginale: &quot; + localRequest.servizioOrigine + &quot; Offerta  ConsistenzaFonia: &quot; + ConsistenzaFonia.offerta;&#xD;
					}&#xD;
					else if((localRequest.servizioOrigine == &quot;G&quot;)&#xD;
												  &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
																 || ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEANONATTIVA))&#xD;
					{&#xD;
								   EsitoResponse.codice = true;&#xD;
								   EsitoResponse.descrizione = &quot;CTRL SERV ORIG positivo. ServizioOriginale: &quot; + localRequest.servizioOrigine + &quot; Offerta  ConsistenzaFonia: &quot; + ConsistenzaFonia.offerta;&#xD;
					}&#xD;
					else if((localRequest.servizioOrigine == &quot;M&quot;)&#xD;
												  &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVA))&#xD;
					{&#xD;
								   EsitoResponse.codice = true;&#xD;
								   EsitoResponse.descrizione = &quot;CTRL SERV ORIG positivo. ServizioOriginale: &quot; + localRequest.servizioOrigine + &quot; Offerta  ConsistenzaFonia: &quot; + ConsistenzaFonia.offerta;&#xD;
					}&#xD;
					else if((localRequest.servizioOrigine == &quot;N&quot;)&#xD;
												  &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVANP))&#xD;
					{&#xD;
								   EsitoResponse.codice = true;&#xD;
								   EsitoResponse.descrizione = &quot;CTRL SERV ORIG positivo. ServizioOriginale: &quot; + localRequest.servizioOrigine + &quot; Offerta  ConsistenzaFonia: &quot; + ConsistenzaFonia.offerta;&#xD;
					}&#xD;
					else if((localRequest.servizioOrigine == &quot;O&quot;)&#xD;
												  &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEANONATTIVA))&#xD;
					{&#xD;
								   EsitoResponse.codice = true;&#xD;
								   EsitoResponse.descrizione = &quot;CTRL SERV ORIG positivo. ServizioOriginale: &quot; + localRequest.servizioOrigine + &quot; Offerta  ConsistenzaFonia: &quot; + ConsistenzaFonia.offerta;&#xD;
					}&#xD;
					else&#xD;
					{&#xD;
								   EsitoResponse.codice = false;&#xD;
								   EsitoResponse.descrizione = &quot;CTRL SERV ORIG fallito per offerta: &quot; + localRequest.offerta + &quot; per sottolavorazione CAMBIOCOPPIA e servizio origine: &quot;+ localRequest.servizioOrigine;&#xD;
					}&#xD;
					&#xD;
	  }&#xD;
	  */&#xD;
	  else if(localRequest.tipologiaSottolav==it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONEDESTINAZIONEUSO)&#xD;
	  {&#xD;
			if(localRequest.servizioOrigine == &quot;4&quot;&#xD;
						   &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVA&#xD;
										  || ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEANONATTIVA))&#xD;
			{&#xD;
						   EsitoResponse.codice = true;&#xD;
						   EsitoResponse.descrizione = &quot;CTRL SERV ORIG positivo. ServizioOriginale: &quot; + localRequest.servizioOrigine + &quot; Offerta  ConsistenzaFonia: &quot; + ConsistenzaFonia.offerta;&#xD;
			}&#xD;
			&#xD;
			else if((localRequest.servizioOrigine == &quot;5&quot;)&#xD;
										  &amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVANP))&#xD;
			{&#xD;
						   EsitoResponse.codice = true;&#xD;
						   EsitoResponse.descrizione = &quot;CTRL SERV ORIG positivo. ServizioOriginale: &quot; + localRequest.servizioOrigine + &quot; Offerta  ConsistenzaFonia: &quot; + ConsistenzaFonia.offerta;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
						   EsitoResponse.codice = false;&#xD;
						   EsitoResponse.descrizione = &quot;CTRL SERV ORIG fallito per offerta: &quot; + localRequest.offerta + &quot; per sottolavorazione VARIAZIONEDESTINAZIONEUSO e servizio origine: &quot;+ localRequest.servizioOrigine;&#xD;
			}				&#xD;
	  }&#xD;
	  else&#xD;
	  {&#xD;
					EsitoResponse.codice = true;&#xD;
					EsitoResponse.descrizione = &quot;CTRL SERV ORIG fallito per sottolavorazione non gestita: &quot; + localRequest.tipologiaSottolav;&#xD;
	  }&#xD;
   }&#xD;
   else&#xD;
   {&#xD;
				  EsitoResponse.codice = false;&#xD;
				  EsitoResponse.descrizione = &quot;CTRL SERV ORIG fallito: Nessuna ConsistenzaFonia trovata&quot;;&#xD;
   }&#xD;
}&#xD;
else&#xD;
{&#xD;
   &#xD;
   EsitoResponse.codice = true;&#xD;
   EsitoResponse.descrizione = &quot;CTRL SERV ORIG skippato - Lavorazione diversa da VARIAZIONE&quot;;&#xD;
               &#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
