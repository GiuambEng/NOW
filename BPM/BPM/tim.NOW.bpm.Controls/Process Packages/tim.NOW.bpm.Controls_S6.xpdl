        <xpdl2:Activity Id="_776pIOVGEea6YttIibUsWA" Name="PrecondizioneFallita" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione Fallita">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;CTRL OLO WHOLESALER precondizione fallita&quot;;&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
