          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var result = false;&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
	&amp;&amp; localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS)&#xD;
{&#xD;
	result = true;&#xD;
}&#xD;
else if((localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS&#xD;
		|| localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN)&#xD;
		&amp;&amp;&#xD;
		(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOFLAT&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOHL&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMASIMMETRICOLITE&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT))&#xD;
{&#xD;
	result = true;	&#xD;
}&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHACONMANODOPERA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SHASENZAMANODOPERA)&#xD;
{&#xD;
	result = true;&#xD;
}&#xD;
&#xD;
if(result &amp;&amp; ConsistenzaFonia != null)&#xD;
{&#xD;
	if(ConsistenzaFonia.offerta != it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULL)&#xD;
	{&#xD;
		result = false;&#xD;
	}&#xD;
}&#xD;
&#xD;
result;</xpdl2:Expression>
</xpdl2:Condition>
