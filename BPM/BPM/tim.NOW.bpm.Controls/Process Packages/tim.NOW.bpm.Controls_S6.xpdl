      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_XqjkJgToEeeZqucln-kp1w" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_XqhH4gToEeeZqucln-kp1w" Width="31.0">
              <xpdl2:Coordinates XCoordinate="816.0" YCoordinate="278.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_XqjkJwToEeeZqucln-kp1w" Name="VerificaValorizzazioneBandePicco" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Valorizzazione Bande Picco" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var foundBandaUP = false;&#xD;
var foundBandaDOWN = false;&#xD;
var failed = false;&#xD;
var i = 0;&#xD;
&#xD;
while(!failed &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN&#xD;
		&amp;&amp; currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
	{&#xD;
		foundBandaUP = false;&#xD;
		foundBandaDOWN = false;&#xD;
		var j = 0;&#xD;
		&#xD;
		while(!failed &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCODOWN)&#xD;
			{&#xD;
				foundBandaDOWN = true;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDAPICCOUP)&#xD;
			{&#xD;
				foundBandaUP = true;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
		&#xD;
		if(!foundBandaDOWN || !foundBandaUP)&#xD;
		{&#xD;
			failed = true;&#xD;
			Process.auditLog(&quot;BandaPiccoUP o BandaPiccoDOWN mancante per UserVLAN del DettaglioOrdine: &quot; + currentDettOrdine.IDDettaglioOrdine);&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VAL BANDE PICCO fallito&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VAL BANDE PICCO positivo.&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
