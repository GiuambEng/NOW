                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var isPacchetto = false;&#xD;
&#xD;
if(localRequest.ordine.codicePacchettoNOW != null)&#xD;
{&#xD;
	isPacchetto = true;&#xD;
}&#xD;
&#xD;
isPacchetto;</xpdl2:Actual>
