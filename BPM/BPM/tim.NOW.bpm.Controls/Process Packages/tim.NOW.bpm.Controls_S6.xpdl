        <xpdl2:Activity Id="_izLC4gTeEeeZqucln-kp1w" Name="VerificaEsistenzaVPIVCI" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Esistenza VPI-VCI" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var datiVCRichiesta = DataUtil.createList();&#xD;
var datiVCAsset = DataUtil.createList();&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
	{&#xD;
		var vci = &quot;&quot;;&#xD;
		var vpi = &quot;&quot;;&#xD;
		vci = null;&#xD;
		vpi = null;&#xD;
		&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
			{&#xD;
				vci = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
			{&#xD;
				vpi = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		datiVCRichiesta.add(vci + &quot;,&quot; + vpi);&#xD;
		Process.auditLog(&quot;Trovata in Richiesta la coppia VCI: &quot; + vci + &quot; VPI: &quot; + vpi);&#xD;
	}&#xD;
}&#xD;
&#xD;
AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
Asset = AssetRef.readAsset();&#xD;
&#xD;
for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
{&#xD;
	var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
	&#xD;
	if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
		|| currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC&#xD;
		|| currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
	{&#xD;
		var vci = &quot;&quot;;&#xD;
		var vpi = &quot;&quot;;&#xD;
		vci = null;&#xD;
		vpi = null;&#xD;
		&#xD;
		for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
		{&#xD;
			var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
			if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
			{&#xD;
				vci = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
			{&#xD;
				vpi = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		datiVCAsset.add(vci + &quot;,&quot; + vpi);&#xD;
		Process.auditLog(&quot;Trovata in consistenza la coppia VCI: &quot; + vci + &quot; VPI: &quot; + vpi);&#xD;
	}&#xD;
}&#xD;
&#xD;
var failed = false;&#xD;
&#xD;
for(var i = 0; i &lt; datiVCRichiesta.size(); i++)&#xD;
{&#xD;
	if(!datiVCAsset.contains(datiVCRichiesta.get(i)))&#xD;
	{&#xD;
		failed = true;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ESISTENZA VPI-VCI fallito&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL ESISTENZA VPI-VCI positivo&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
