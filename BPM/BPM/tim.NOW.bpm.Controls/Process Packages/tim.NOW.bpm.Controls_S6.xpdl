          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaVariazioneAttributoRequest = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createVerifica_Var_Attributo_Caratt_RequestType();&#xD;
&#xD;
VerificaVariazioneAttributoRequest.CONSISTENZADATI = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createCONSISTENZADATIType();&#xD;
VerificaVariazioneAttributoRequest.CONSISTENZADATI.idAsset = ConsistenzaDati.IDAsset;&#xD;
VerificaVariazioneAttributoRequest.CONSISTENZADATI.offerta = ConsistenzaDati.offerta;&#xD;
VerificaVariazioneAttributoRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaVariazioneAttributoRequest.caratteristica = localRequest.caratteristica;&#xD;
&#xD;
var modulazioneRichiesta = &quot;&quot;;&#xD;
var profiloTecnicoLineaRichiesta = &quot;&quot;;&#xD;
modulazioneRichiesta = null;&#xD;
profiloTecnicoLineaRichiesta = null;&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
			{&#xD;
				profiloTecnicoLineaRichiesta = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MODULAZIONE)&#xD;
			{&#xD;
				modulazioneRichiesta = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
	{&#xD;
		var dativc = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createDatiVC();&#xD;
		&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRDOWN)&#xD;
			{&#xD;
				dativc.MCRDOWN = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MCRUP)&#xD;
			{&#xD;
				dativc.MCRUP = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRDOWN)&#xD;
			{&#xD;
				dativc.PCRDOWN = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PCRUP)&#xD;
			{&#xD;
				dativc.PCRUP = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOBANDACONSEGNA)&#xD;
			{&#xD;
				dativc.bandaConsegna = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEVP)&#xD;
			{&#xD;
				dativc.codiceVP = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC)&#xD;
			{&#xD;
				dativc.tipoProfilo = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		VerificaVariazioneAttributoRequest.VC.add(ScriptUtil.copy(dativc));&#xD;
	}&#xD;
}&#xD;
&#xD;
AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
Asset = AssetRef.readAsset();&#xD;
&#xD;
for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
{&#xD;
	var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
	&#xD;
	if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC)&#xD;
	{&#xD;
		var consistenzaDativc = com_tim_NOW_xsd_ControllidiAmmissibilita_Factory.createConsDatiVC();&#xD;
		&#xD;
		for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
		{&#xD;
			var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
			&#xD;
			if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETD)&#xD;
			{&#xD;
				consistenzaDativc.CODICETD = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAESPLETAMENTOVC)&#xD;
			{&#xD;
				consistenzaDativc.DATAESPLETAMENTOVC = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDPROFILOVC)&#xD;
			{&#xD;
				consistenzaDativc.IDPROFILOVC = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAVC)&#xD;
			{&#xD;
				consistenzaDativc.IDRISORSAVC = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC)&#xD;
			{&#xD;
				consistenzaDativc.TIPOPROFILOVC = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCI)&#xD;
			{&#xD;
				consistenzaDativc.VCI = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VCISP)&#xD;
			{&#xD;
				consistenzaDativc.VCISP = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPI)&#xD;
			{&#xD;
				consistenzaDativc.VPI = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VPISP)&#xD;
			{&#xD;
				consistenzaDativc.VPISP = currentAttDettAsset.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		VerificaVariazioneAttributoRequest.CONSISTENZADATIVC.add(ScriptUtil.copy(consistenzaDativc));&#xD;
	}&#xD;
}&#xD;
&#xD;
VerificaVariazioneAttributoRequest.modulazione = modulazioneRichiesta;&#xD;
VerificaVariazioneAttributoRequest.profiloTecnicoLinea = profiloTecnicoLineaRichiesta;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_3MZ4wQTREeeZqucln-kp1w" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_czOlkATREeeZqucln-kp1w" xpdExt:Visibility="Public">
