        <xpdl2:Activity Id="_-x9pgvT6EeaIvKeprhSP7w" Name="VerificacongruenzaProfiloOffertaperBITSTREAMATMASIM" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica congruenza Profilo-Offerta per BITSTREAM  ATM ASIM" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var failed = false;&#xD;
var i = 0;&#xD;
&#xD;
while(!failed &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
		&amp;&amp; currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(!failed &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROFILOVC&#xD;
				&amp;&amp; currentAttDettOrdine.valoreAttributo != &quot;ABR&quot;)&#xD;
			{&#xD;
				failed = true;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;CTRL CONG PROFILOVC-OFFERTA FLAT fallito: Trovata ATMVC con Azione A e TIPOPROFILOVC ABR in DettaglioOrdine con ID: &quot; + currentDettOrdine.IDDettaglioOrdine;&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL CONG PROFILOVC-OFFERTA FLAT positivo&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
