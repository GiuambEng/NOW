    <xpdl2:WorkflowProcess Id="_XzDf8PRtEeazKYdqUBpQKA" xpdExt:DisplayName="CTRL COMP VULL DN_C04M01F142" Name="CTRLCOMPVULLDN_C04M01F142">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_XzF8MfRtEeazKYdqUBpQKA" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_XzDf8vRtEeazKYdqUBpQKA" Width="31.0">
              <xpdl2:Coordinates XCoordinate="731.0" YCoordinate="239.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_XzF8MvRtEeazKYdqUBpQKA" Name="VerificacompatibilitMigrazioneWLRVULLDN" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica compatibilità Migrazione WLR VULL / DN">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
&#xD;
	if((localRequest.DNAggiuntivo.get(0) == ConsistenzaFonia.numeroTelefonico || localRequest.DNAggiuntivo.get(0) == ConsistenzaFonia.IDRisorsa)&#xD;
		&amp;&amp; (ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
			|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEAATTIVANP&#xD;
			|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
			|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEAATTIVA&#xD;
			|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
			|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULLLINEANONATTIVA&#xD;
			|| ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.VULL)&#xD;
			)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL COMP VULL DN positivo&quot;;&#xD;
	}&#xD;
	else if(ConsistenzaFonia.destinazioneUso == &quot;4&quot;&#xD;
			|| ConsistenzaFonia.destinazioneUso == &quot;5&quot;&#xD;
			|| ConsistenzaFonia.destinazioneUso == &quot;9&quot;&#xD;
			|| ConsistenzaFonia.destinazioneUso == &quot;10&quot;)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL COMP VULL DN positivo&quot;;&#xD;
	}&#xD;
	else if(ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.ULLLINEANONATTIVA &#xD;
			 || ConsistenzaFonia.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.SLULINEANONATTIVA)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL COMP VULL DN positivo&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL COMP VULL DN negativo&quot;;&#xD;
	}&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
