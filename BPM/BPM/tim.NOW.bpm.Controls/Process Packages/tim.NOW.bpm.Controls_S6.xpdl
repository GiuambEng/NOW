          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaOLOWholesalerRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerifica_OLO_Wholesaler_RequestType();&#xD;
&#xD;
VerificaOLOWholesalerRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaOLOWholesalerRequest.codiceOLOAGCOMRecipient = localRequest.codificaOLOAGCOM;&#xD;
VerificaOLOWholesalerRequest.flag_GUI = false;&#xD;
VerificaOLOWholesalerRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
VerificaOLOWholesalerRequest.routingNumberRecipient = routingNumber;&#xD;
&#xD;
if(localRequest.ordine.tipologiaLinea != null)&#xD;
{&#xD;
	VerificaOLOWholesalerRequest.tipoLinea = it_telecomitalia_it_NOW_casedata_v1_TipologiaLineaEnumeration.get(String(localRequest.ordine.tipologiaLinea));&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">// Script aggiunto con SM_8493 per aggiornamento OLORETAILER nella componente NP corrispondente nell'ordine&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
var trovatoOLORetailer = false;&#xD;
&#xD;
var indexOLORetailer = -1;&#xD;
var numeroTelefonicoNP = &quot;&quot;;&#xD;
numeroTelefonicoNP = null;&#xD;
var routingNumberOrdine = &quot;&quot;;&#xD;
routingNumberOrdine = null;&#xD;
var codiceOperatoreDonor = &quot;&quot;;&#xD;
codiceOperatoreDonor = null;&#xD;
&#xD;
if(InfoOLO != null &amp;&amp; InfoOLO.OLORetailer != null)&#xD;
{	&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			numeroTelefonicoNP = null;&#xD;
			indexOLORetailer = -1;&#xD;
			trovatoOLORetailer = false;&#xD;
			codiceOperatoreDonor = null;&#xD;
			&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER)&#xD;
				{&#xD;
					trovatoOLORetailer = true;&#xD;
					indexOLORetailer = j;&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
				{&#xD;
					numeroTelefonicoNP = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				//SM_8493&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER)&#xD;
				{&#xD;
					routingNumberOrdine = currentAttDettOrdine.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato routingNumber: &quot;+routingNumberOrdine);&#xD;
				}&#xD;
				//RU_1061&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR)&#xD;
				{&#xD;
					codiceOperatoreDonor = currentAttDettOrdine.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato codiceOperatoreDonor: &quot;+codiceOperatoreDonor);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if((routingNumberOrdine != null &amp;&amp; routingNumber == routingNumberOrdine)&#xD;
				&amp;&amp; (InfoOLO.OLORetailer != localRequest.codificaOLOAGCOM &#xD;
				&amp;&amp; !(InfoOLO.OLORetailer == 'INF' &amp;&amp; localRequest.codificaOLOAGCOM == 'WIN')&#xD;
				&amp;&amp; !(InfoOLO.OLORetailer == 'WIN' &amp;&amp; localRequest.codificaOLOAGCOM == 'INF'))&#xD;
				&amp;&amp; codiceOperatoreDonor == &quot;TLC&quot;) //RU_1061 &#xD;
				// Bug #26774 - aggiunta condition per non propagare mai OLORETAILER in caso in cui sia == RECIPIENT&#xD;
				// SM_9221 - fixata condition per no propagare OLORETAILER in caso sia == recipient (sostituito NUMBERPORTABILITYOut con INFOOLO)&#xD;
			{&#xD;
				if(trovatoOLORetailer)&#xD;
				{&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.get(indexOLORetailer).valoreAttributo = NumberPortabilityOut.OLORetailer;&#xD;
					Process.auditLog(&quot;Aggiornato valore OLORETAILER per NP &quot;+numeroTelefonicoNP+&quot; con valore: &quot;+NumberPortabilityOut.OLORetailer);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = localRequest.operatore;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.valoreAttributo = NumberPortabilityOut.OLORetailer;&#xD;
					attributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
				&#xD;
					localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					Process.auditLog(&quot;Creato attributo OLORETAILER per NP &quot;+numeroTelefonicoNP+&quot; con valore: &quot;+NumberPortabilityOut.OLORetailer);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(InfoOLO != null &amp;&amp; InfoOLO.OLORetailer != null)&#xD;
{&#xD;
	OLORetailerAttivazione = InfoOLO.OLORetailer;	&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
