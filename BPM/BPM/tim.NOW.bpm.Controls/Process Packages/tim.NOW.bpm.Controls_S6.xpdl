            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="47.0" LaneId="_lct7EgP5Eeecl-4U35e5bg" Width="31.0">
              <xpdl2:Coordinates XCoordinate="686.0" YCoordinate="219.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_lcvwQgP5Eeecl-4U35e5bg" Name="VerificaVariazionedecrementoVC" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica Variazione decremento VC" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
Asset = AssetRef.readAsset();&#xD;
&#xD;
var TotVCDec = 0;&#xD;
var TotVCInc= 0;&#xD;
&#xD;
for(var j=0; j&lt; localRequest.ordine.dettaglioordine.size(); j++)&#xD;
{&#xD;
  var currentDettOrdine = localRequest.ordine.dettaglioordine.get(j);&#xD;
  &#xD;
  if (currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC ||&#xD;
  		currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC){&#xD;
  		&#xD;
  		if(currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D){&#xD;
  		&#xD;
  			TotVCDec++;&#xD;
  		}&#xD;
  		&#xD;
  		else if(currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A){&#xD;
  		&#xD;
  			TotVCInc++;&#xD;
  		}&#xD;
  		&#xD;
  	}&#xD;
	&#xD;
}&#xD;
&#xD;
&#xD;
if(TotVCDec >= 1){&#xD;
&#xD;
	var TotVCCons = 0;&#xD;
&#xD;
	for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
	&#xD;
		if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC&#xD;
			|| currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC)&#xD;
		{&#xD;
			TotVCCons++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if( (TotVCCons + TotVCInc -TotVCDec)>=1)&#xD;
	{&#xD;
		 EsitoResponse.codice = true;&#xD;
		 EsitoResponse.descrizione = &quot;CTRL Decremento VC positivo&quot;;	&#xD;
	}&#xD;
	&#xD;
	else &#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL Decremento VC negativo&quot;;&#xD;
&#xD;
	}&#xD;
}&#xD;
&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL Decremento VC positivo, precondizione non rispettata&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
