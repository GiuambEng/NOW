    <xpdl2:WorkflowProcess Id="_rrtIEP9zEeaScOD1GBERCQ" xpdExt:DisplayName="CTRL VAR CONSEGNA EASYIP_C04M01F138" Name="CTRLVARCONSEGNAEASYIP_C04M01F138">
      <xpdl2:ProcessHeader/>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_rr1q9P9zEeaScOD1GBERCQ" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="52.0" LaneId="_rrtIEv9zEeaScOD1GBERCQ" Width="31.0">
              <xpdl2:Coordinates XCoordinate="584.0" YCoordinate="259.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_rr1q9f9zEeaScOD1GBERCQ" Name="VerificavariazioneConsegna" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica variazione Consegna">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var foundCodiceTD = false;&#xD;
&#xD;
var i = 0;&#xD;
while(!foundCodiceTD &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	var j = 0;&#xD;
	while(!foundCodiceTD &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
	{&#xD;
		var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
		&#xD;
		if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETD)&#xD;
		{&#xD;
			foundCodiceTD = true;&#xD;
		}&#xD;
		j++;&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(foundCodiceTD)&#xD;
{&#xD;
	if(ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPSPECIALPROFILELITE&#xD;
		|| ConsistenzaDati.offerta == it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VAR CONSEGNA EASYIP fallito&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;CTRL VAR CONSEGNA EASYIP positivo&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;CTRL VAR CONSEGNA EASYIP saltato per precondizione: nessun CodiceTD trovato&quot;;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
