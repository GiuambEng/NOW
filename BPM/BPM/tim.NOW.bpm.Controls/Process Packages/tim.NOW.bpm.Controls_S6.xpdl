          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaColocazioneRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerifica_Richiesta_Colocazione_RequestType();&#xD;
&#xD;
VerificaColocazioneRequest.DRO = localRequest.DRO;&#xD;
VerificaColocazioneRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
VerificaColocazioneRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaColocazioneRequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
&#xD;
if(localRequest.ordine.codicePacchettoNOW != null)&#xD;
{&#xD;
	VerificaColocazioneRequest.isPacchetto = true;&#xD;
}&#xD;
else&#xD;
{&#xD;
	VerificaColocazioneRequest.isPacchetto = false;&#xD;
}&#xD;
&#xD;
VerificaColocazioneRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
VerificaColocazioneRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
VerificaColocazioneRequest.scenario = it_telecomitalia_it_NOW_casedata_v1_TipologiaScenarioEnumeration.get(String(localRequest.tipologiaScenario));&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(VerificaColocazioneRequest.numeroRichColocaz == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULL)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(VerificaColocazioneRequest.numeroRichColocaz == null &amp;&amp;  j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMRICHCOLOCAZ)&#xD;
				{&#xD;
					VerificaColocazioneRequest.numeroRichColocaz = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
if(progettoVULL != null)&#xD;
{&#xD;
	VerificaColocazioneRequest.progettoVULL = progettoVULL;&#xD;
}&#xD;
else&#xD;
{&#xD;
	VerificaColocazioneRequest.progettoVULL = &quot;N&quot;;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">var result = &quot;&quot;;&#xD;
&#xD;
if(VerificaColocazioneResponse.VULLPatroclo!= null){&#xD;
	result = VerificaColocazioneResponse.VULLPatroclo.CLLI;&#xD;
}&#xD;
&#xD;
result;&#xD;
&#xD;
localRequest.ordine.CLLI = result;</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
