            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:Performers>
            <xpdl2:Performer>_5bhI8OVGEea6YttIibUsWA</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="85.0" LaneId="_M3_QMf6XEea8keRKq8wfNA" Width="136.0">
              <xpdl2:Coordinates XCoordinate="677.0" YCoordinate="267.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaProfiloBandaBMDRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createVerifica_Profilo_di_Banda_BMD_RequestType();&#xD;
&#xD;
VerificaProfiloBandaBMDRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaProfiloBandaBMDRequest.IDRisorsa = localRequest.IDRisorsa;&#xD;
VerificaProfiloBandaBMDRequest.lavorazione = String(localRequest.lavorazione); //SM_10325&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
	{&#xD;
		var uv = com_tim_NOW_xsd_ControlliFormali_Factory.createUserVlanType2();   //Type modificato post localbom per la RU_1558&#xD;
		var foundSvlanCode = false;&#xD;
		&#xD;
		for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
			{&#xD;
				uv.idUserVlan = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOBMD)&#xD;
			{&#xD;
				uv.profiloBMD = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
			{&#xD;
				foundSvlanCode = true;&#xD;
			}&#xD;
			//SM_10325&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
			{&#xD;
				uv.flagMulticast = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		//SM_10325: anche per attivazione deve esserci PROFILOBMD per poter chiamare il controllo (commentata riga 39)&#xD;
		if(//localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE ||&#xD;
			uv.profiloBMD != null)// &amp;&amp; !foundSvlanCode)&#xD;
		{&#xD;
			VerificaProfiloBandaBMDRequest.userVlan.add(ScriptUtil.copy(uv));&#xD;
		}&#xD;
		&#xD;
		uv = null;&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_VHGmsf6XEea8keRKq8wfNA" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_PZFT8P6XEea8keRKq8wfNA" xpdExt:Visibility="Public">
          <xpdl2:Event>
