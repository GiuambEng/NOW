        <xpdl2:Activity Id="_dM20ZQNOEeevKdjqJ57WWg" Name="VerificaIDULLCOinconsistenza" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica IDULLCO in consistenza" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var idullcoRichiesta = &quot;&quot;;&#xD;
idullcoRichiesta = null;&#xD;
var idullcoAsset = &quot;&quot;;&#xD;
idullcoAsset = null;&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
