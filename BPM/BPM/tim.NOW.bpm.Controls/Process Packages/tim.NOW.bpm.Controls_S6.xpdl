          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = true;&#xD;
&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT ||&#xD;
			localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL )&#xD;
	{ &#xD;
			var foundprotocolloATM= false;&#xD;
			var i=0;&#xD;
			while (!foundprotocolloATM &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size() )&#xD;
			{&#xD;
				var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				if (currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.PROTOCOLLO)&#xD;
				{&#xD;
					for (var j=0; j&lt;currentDettaglioOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
					{&#xD;
						var currentAttributiDettOrdine = currentDettaglioOrdine.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if (currentAttributiDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOPROTOCOLLO &amp;&amp;&#xD;
							currentAttributiDettOrdine.valoreAttributo == &quot;ATM&quot;)&#xD;
						{&#xD;
							foundprotocolloATM = true;&#xD;
							&#xD;
						}&#xD;
	 				&#xD;
					}&#xD;
				}&#xD;
			i++;&#xD;
			}&#xD;
			if (!foundprotocolloATM)&#xD;
			{&#xD;
				EseguiControllo=false;&#xD;
			}&#xD;
	}&#xD;
	&#xD;
	 if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &amp;&amp; EseguiControllo)&#xD;
		{&#xD;
			&#xD;
			if(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
			{		&#xD;
					var trovatoIncremento = false;&#xD;
					var i=0;&#xD;
					while(!trovatoIncremento &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
					{&#xD;
						var currentDettOrdine= localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
						if ((currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC ||&#xD;
							currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC ||&#xD;
						 	currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN) &amp;&amp;&#xD;
							currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
						{&#xD;
							trovatoIncremento=true;&#xD;
						}&#xD;
					i++;&#xD;
					}&#xD;
			&#xD;
				if (!trovatoIncremento)&#xD;
				{&#xD;
				EseguiControllo= false;&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			&#xD;
		}&#xD;
		&#xD;
 &#xD;
 &#xD;
 &#xD;
}</xpdl2:Script>
