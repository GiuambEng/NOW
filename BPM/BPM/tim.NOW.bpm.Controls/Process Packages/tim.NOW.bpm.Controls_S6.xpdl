        <xpdl2:Activity Id="_X8-xkmV3EeeFLuxKJU-nxw" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo=true;&#xD;
&#xD;
&#xD;
if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
{&#xD;
	&#xD;
		var trovatoDecremento = false;&#xD;
		var i=0;&#xD;
		while (!trovatoDecremento &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		 {&#xD;
		 	var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		 	&#xD;
		 	if( (currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ATMVC ||&#xD;
		 		currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC) &amp;&amp;&#xD;
		 		currentDettaglioOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		 		{&#xD;
		 			trovatoDecremento = true;&#xD;
		 		}&#xD;
		 i++;&#xD;
		 }&#xD;
		 &#xD;
		 if (!trovatoDecremento)&#xD;
		 {&#xD;
		 	EseguiControllo= false;&#xD;
		 }&#xD;
	&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
