          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_IYASsGV1EeeFLuxKJU-nxw">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_AIJYYAo7Eeen-MTwjTWWJQ"/>
                  <xpdl2:TransitionRef Id="_IrpncWV1EeeFLuxKJU-nxw"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="45.0" LaneId="_2PVAgQo3Eeen-MTwjTWWJQ" Width="43.0">
              <xpdl2:Coordinates XCoordinate="320.0" YCoordinate="260.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_f9um0mV1EeeFLuxKJU-nxw" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo=true;&#xD;
&#xD;
if (localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONETAGGING &amp;&amp;&#xD;
	localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN &amp;&amp;&#xD;
	localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC &amp;&amp;&#xD;
	localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
	{&#xD;
		EseguiControllo=false;&#xD;
	}&#xD;
&#xD;
else if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC )&#xD;
{&#xD;
	&#xD;
		var trovato = false;&#xD;
		var i=0;&#xD;
		while (!trovato &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		 {&#xD;
		 	var currentDettaglioOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		 	&#xD;
		 	if( currentDettaglioOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp;&#xD;
		 	currentDettaglioOrdine.azione ==  it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D)&#xD;
		 		{&#xD;
		 			trovato=true;&#xD;
		 		}&#xD;
		 i++;&#xD;
		 }&#xD;
		 &#xD;
		 if (!trovato)&#xD;
		 {&#xD;
		 	EseguiControllo= false;&#xD;
		 }&#xD;
	&#xD;
}&#xD;
&#xD;
//SM_10770 - Non effettuare il controllo se non sono presenti USERVLAN&#xD;
if (localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA &amp;&amp; &#xD;
	localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE){&#xD;
            &#xD;
	var foundUserVlan = false;&#xD;
	var i = 0;&#xD;
	&#xD;
	while (!foundUserVlan &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size()){&#xD;
&#xD;
		var currentDettOrd= localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if (currentDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN){&#xD;
			foundUserVlan=true;&#xD;
		}&#xD;
&#xD;
		i++;&#xD;
&#xD;
	}&#xD;
			   &#xD;
	if (!foundUserVlan){&#xD;
		EseguiControllo=false;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
