        <xpdl2:Activity Id="_WNVlcWfTEee0Vdsdmhh9lA" Name="Precondizione" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EseguiControllo = true;&#xD;
&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
&#xD;
{ &#xD;
	if (localRequest.ordine.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC)&#xD;
	{&#xD;
		EseguiControllo=false;&#xD;
	}&#xD;
	&#xD;
	else &#xD;
 	{&#xD;
		var foundIncremento= false;&#xD;
		var i=0;&#xD;
		while(!foundIncremento &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine= localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if (currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp;&#xD;
				currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
			{&#xD;
				foundIncremento=true;&#xD;
			}&#xD;
		 i++;&#xD;
		}&#xD;
		&#xD;
		if (!foundIncremento)&#xD;
			{&#xD;
				EseguiControllo= false;&#xD;
			}&#xD;
	}&#xD;
}&#xD;
		&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
