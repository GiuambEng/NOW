            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="57.0" LaneId="_rJBr0m_1Ee2Px7-r-hy6yA" Width="32.0">
              <xpdl2:Coordinates XCoordinate="1006.0" YCoordinate="157.0"/>
