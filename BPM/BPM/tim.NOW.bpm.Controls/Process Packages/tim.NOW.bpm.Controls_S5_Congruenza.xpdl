          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">VerificaPresenzaCRMRequest = com_tim_NOW_xsd_ControlliAmmessiNP_Factory.createVerifica_Presenza_Altro_Ordinativo_Su_CRM_EsitiMultipli_Request();&#xD;
&#xD;
VerificaPresenzaCRMRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
VerificaPresenzaCRMRequest.codiceOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
&#xD;
if(localRequest.ordine.codicePacchettoNOW != null)&#xD;
{&#xD;
	VerificaPresenzaCRMRequest.isPacchetto = true;&#xD;
}&#xD;
else&#xD;
{&#xD;
	VerificaPresenzaCRMRequest.isPacchetto = false;&#xD;
}&#xD;
&#xD;
VerificaPresenzaCRMRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
&#xD;
if(DN != null &amp;&amp; DN != &quot;&quot;)&#xD;
{&#xD;
	VerificaPresenzaCRMRequest.numeroTelefonicoNP.add(DN);&#xD;
}&#xD;
else&#xD;
{&#xD;
	VerificaPresenzaCRMRequest.numeroTelefonicoNP.add(localRequest.numeroTelefonico);&#xD;
}&#xD;
&#xD;
VerificaPresenzaCRMRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
&#xD;
if(localRequest.ordine.tipologiaScenario != null)&#xD;
{&#xD;
	VerificaPresenzaCRMRequest.scenario = String(localRequest.ordine.tipologiaScenario);&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
