        <xpdl2:Activity Id="_1WsG_YYiEeamBaXFXbQJ5A" Name="VerificapresenzaaltroordinativodiNPg" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica presenza altro ordinativo di  NPg" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Fallito per insufficienza di dati&quot;;&#xD;
&#xD;
if(PresenzaOrdinativoCRM != null &amp;&amp; PresenzaOrdinativoNOW != null)&#xD;
{&#xD;
	if(PresenzaOrdinativoCRM == &quot;01&quot; || PresenzaOrdinativoNOW == &quot;01&quot;)&#xD;
	{&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Fallito per NP in corso. CRM: &quot; + PresenzaOrdinativoCRM + &quot; NOW: &quot; + PresenzaOrdinativoNOW;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Riuscito. CRM: &quot; + PresenzaOrdinativoCRM + &quot; NOW: &quot; + PresenzaOrdinativoNOW;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Esito controllo C04M02F90: &quot; + EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
