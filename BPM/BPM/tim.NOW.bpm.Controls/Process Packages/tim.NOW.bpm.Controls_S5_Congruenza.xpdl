        <xpdl2:Activity Id="_7orU0E-FEee5hreS_z3HJA" Name="RecuperoOLONormalizzato" xpdExt:Visibility="Private" xpdExt:DisplayName="Recupero OLO Normalizzato">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_t6eQsk-LEee5hreS_z3HJA">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="true" Direction="IN" Formal="parameters.IDRichiestaOLO">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRichiestaOLO</xpdl2:Actual>
