                    <xpdl2:DataMapping Direction="IN" Formal="parameters.codfc_OLO_AGCOM_Rich">
                      <xpdExt:ScriptInformation Id="_Ll25IL9LEe2QRIkIpH2JOQ" Name="CodificaOloAgcomToService"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">//SM_11008: Chiamare il servizio con codice OperatoreReturning in caso di NP D103&#xD;
if(localRequest.flagDelibera103 == 'Y')&#xD;
{&#xD;
	localRequest.codiceOperatoreReturning;&#xD;
}else&#xD;
{&#xD;
