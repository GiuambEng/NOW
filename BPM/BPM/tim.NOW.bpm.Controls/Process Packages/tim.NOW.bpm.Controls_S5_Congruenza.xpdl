        <xpdl2:Activity Id="_1WsHG4YiEeamBaXFXbQJ5A" Name="VerificavaliditDonating" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica validità Donating">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice = false;&#xD;
EsitoResponse.descrizione = &quot;Esito C04M02F86 Negativo.&quot;;&#xD;
&#xD;
var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;numeroTelefonico =: DN AND statoAsset &lt;> 'CESSATO' AND offerta = 'NP'&quot;);&#xD;
criteria.setQueryParameter(&quot;DN&quot;, localRequest.numeroTelefonico);&#xD;
&#xD;
var assets = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
if(assets != null &amp;&amp; assets.size() > 0)&#xD;
{&#xD;
	Asset = assets.get(0).readAsset();&#xD;
}&#xD;
else&#xD;
{&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Asset.createCriteria(&quot;dettaglioasset.attributidettaglioasset.nomeAttributo = 'RADICALE' AND dettaglioasset.attributidettaglioasset.valoreAttributo=:DN AND statoAsset &lt;> 'CESSATO' AND offerta = 'NP'&quot;);&#xD;
	criteria.setQueryParameter(&quot;DN&quot;, localRequest.numeroTelefonico);&#xD;
	&#xD;
	var assets = cac_it_telecomitalia_it_NOW_casedata_Asset.findByCriteria(criteria);&#xD;
	Asset = assets.get(0).readAsset();&#xD;
}&#xD;
&#xD;
//SM_11008: differenziata logica tra NP D103 e D35&#xD;
if(localRequest.flagDelibera103 == 'Y')//D103&#xD;
{&#xD;
	if(OLONormalizzato != null &amp;&amp; OLONormalizzato == Asset.codificaOLOAGCOM)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Esito Controllo C04M02F86 Positivo: codiceOperatoreReturning NORMALIZZATO corrispondente tra Richiesta ed Asset.&quot;;&#xD;
	}&#xD;
	else if(localRequest.codiceOperatoreReturning == Asset.codificaOLOAGCOM)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Esito Controllo C04M02F86 Positivo: codiceOperatoreReturning corrispondente tra Richiesta ed Asset.&quot;;		&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		var oloRetailer = &quot;&quot;;&#xD;
		oloRetailer = null;&#xD;
		var i = 0;&#xD;
		&#xD;
		while(oloRetailer == null &amp;&amp; i &lt; Asset.dettaglioasset.size())&#xD;
		{&#xD;
			var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
			&#xD;
			if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(oloRetailer == null &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER)&#xD;
					{&#xD;
						oloRetailer = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		if(oloRetailer != null)&#xD;
		{&#xD;
			Process.auditLog(&quot;Controllo C04M02F86: trovato OLORETAILER in Asset: &quot; + oloRetailer);&#xD;
			&#xD;
			if(oloRetailer == localRequest.codiceOperatoreReturning)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;Esito Controllo C04M02F86 Positivo: trovato OLORETAILER in Asset e corrispondente alla codiceOperatoreReturning nella richiesta.&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Esito Controllo C04M02F86 Negativo: trovato OLORETAILER in Asset, ma non corrispondente alla codiceOperatoreReturning nella richiesta.&quot;;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Esito Controllo C04M02F86 Negativo: codiceOperatoreReturning incongruente tra Richiesta ed Asset e non trovato OLORETAILER in Asset.&quot;;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else //D35&#xD;
{&#xD;
	if(OLONormalizzato != null &amp;&amp; OLONormalizzato == Asset.codificaOLOAGCOM)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Esito Controllo C04M02F86 Positivo: codificaOLOAGCOMDonating NORMALIZZATO corrispondente tra Richiesta ed Asset.&quot;;&#xD;
	}&#xD;
	else if(localRequest.codificaOLOAGCOMDonating == Asset.codificaOLOAGCOM)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Esito Controllo C04M02F86 Positivo: codificaOLOAGCOMDonating corrispondente tra Richiesta ed Asset.&quot;;&#xD;
	}&#xD;
	else if(localRequest.codificaOLOAGCOMDonating == null)&#xD;
	{&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Esito Controllo C04M02F86 Positivo: codificaOLOAGCOMDonating mancante nella richiesta.&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		var oloRetailer = &quot;&quot;;&#xD;
		oloRetailer = null;&#xD;
		var i = 0;&#xD;
		&#xD;
		while(oloRetailer == null &amp;&amp; i &lt; Asset.dettaglioasset.size())&#xD;
		{&#xD;
			var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
			&#xD;
			if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(oloRetailer == null &amp;&amp; j &lt; currentDettAsset.attributidettaglioasset.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER)&#xD;
					{&#xD;
						oloRetailer = currentAttDettOrdine.valoreAttributo;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
		&#xD;
		if(oloRetailer != null)&#xD;
		{&#xD;
			Process.auditLog(&quot;Controllo C04M02F86: trovato OLORETAILER in Asset: &quot; + oloRetailer);&#xD;
			&#xD;
			if(oloRetailer == localRequest.codificaOLOAGCOMDonating)&#xD;
			{&#xD;
				EsitoResponse.codice = true;&#xD;
				EsitoResponse.descrizione = &quot;Esito Controllo C04M02F86 Positivo: trovato OLORETAILER in Asset e corrispondente alla codificaOLOAGCOMDonating nella richiesta.&quot;;&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				EsitoResponse.codice = false;&#xD;
				EsitoResponse.descrizione = &quot;Esito Controllo C04M02F86 Negativo: trovato OLORETAILER in Asset, ma non corrispondente alla codificaOLOAGCOMDonating nella richiesta.&quot;;&#xD;
			}&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			EsitoResponse.codice = false;&#xD;
			EsitoResponse.descrizione = &quot;Esito Controllo C04M02F86 Negativo: codificaOLOAGCOMDonating incongruente tra Richiesta ed Asset e non trovato OLORETAILER in Asset.&quot;;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
