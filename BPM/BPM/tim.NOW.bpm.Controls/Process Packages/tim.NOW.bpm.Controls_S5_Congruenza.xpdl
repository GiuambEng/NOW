          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="57.0" LaneId="_1WsG-YYiEeamBaXFXbQJ5A" Width="32.0">
