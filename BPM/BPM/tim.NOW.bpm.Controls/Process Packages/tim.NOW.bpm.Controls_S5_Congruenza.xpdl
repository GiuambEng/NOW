    <xpdl2:WorkflowProcess Id="_1WsHBoYiEeamBaXFXbQJ5A" xpdExt:XpdModelType="ServiceProcess" xpdExt:DisplayName="CTRL TRV ORD_C04M02F87" Name="CTRLTRVORD_C04M02F87">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_pdrxkJq7EeaAldjiiSSEuQ" xpdExt:DisplayName="foundRequest" Name="foundRequest">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_2Y1K_erUEeWg_qPSKmWaWg"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_tPrcgJq7EeaAldjiiSSEuQ" xpdExt:DisplayName="foundRequestRef" Name="foundRequestRef" IsArray="false">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_2Y1K_erUEeWg_qPSKmWaWg"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_KDyDMqHREea-N5z6B9EhIw" xpdExt:DisplayName="processIdentifier" Name="processIdentifier">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>500</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
          <xpdExt:InitialValues>
            <xpdExt:Value>/tim.NOW.bpm.invokeInternalService/Process Packages/tim.NOW.bpm.invokeInternalService.utils.xpdl.DatiVerificaControlliStorico</xpdExt:Value>
          </xpdExt:InitialValues>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_TNCnEMLpEeaFXd4m6BeAbg" xpdExt:DisplayName="LavorazioneInCorso" Name="LavorazioneInCorso" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="com.tim.NOW.xsd.StoricoDatiVerificaControlli.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.StoricoDatiVerificaControlliLavorazioneInCorsoType"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_rmRsWDy6Eee4zbUpopsr5g" xpdExt:DisplayName="CodiceEsito" Name="CodiceEsito">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>50</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_rmRsWTy6Eee4zbUpopsr5g" xpdExt:DisplayName="ProcessIdentifier" Name="ProcessIdentifier">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="STRING">
              <xpdl2:Length>500</xpdl2:Length>
            </xpdl2:BasicType>
          </xpdl2:DataType>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_x1IfwNA9EeeW_7cNL7mnTQ" xpdExt:DisplayName="arrayFoundRequestRef" Name="arrayFoundRequestRef" IsArray="true">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_2Y1K_erUEeWg_qPSKmWaWg"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_1WsHCIYiEeamBaXFXbQJ5A" Name="End" xpdExt:Visibility="Private" xpdExt:DisplayName="End">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="52.0" LaneId="_1WsHA4YiEeamBaXFXbQJ5A" Width="31.0">
              <xpdl2:Coordinates XCoordinate="1223.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_1WsHCYYiEeamBaXFXbQJ5A" Name="VerificapresenzaaltroordinativodiincorsosuNow" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica presenza altro ordinativo di  in corso su Now">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
//CASO 1 RU 752&#xD;
&#xD;
//DN - NUMERO TELEFONICO&#xD;
var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;numeroTelefonico=:DN&quot;);&#xD;
&#xD;
if(DN != null)&#xD;
{&#xD;
	criteria.setQueryParameter(&quot;DN&quot;,DN);&#xD;
}&#xD;
else&#xD;
{&#xD;
	criteria.setQueryParameter(&quot;DN&quot;,localRequest.numeroTelefonico);&#xD;
}&#xD;
&#xD;
var temparrayFoundRequestRef1 = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
//ATTRIBUTO NUMERO TELEFONICO&#xD;
var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;ordine.dettaglioordine.attributiDettaglioOrdine.nomeAttributo = 'NUMEROTELEFONICO' AND ordine.dettaglioordine.attributiDettaglioOrdine.valoreAttributo=:DN&quot;);&#xD;
&#xD;
if(DN != null)&#xD;
{&#xD;
	criteria.setQueryParameter(&quot;DN&quot;,DN);&#xD;
}&#xD;
else&#xD;
{&#xD;
	criteria.setQueryParameter(&quot;DN&quot;,localRequest.numeroTelefonico);&#xD;
}&#xD;
&#xD;
var temparrayFoundRequestRef2 = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
if(temparrayFoundRequestRef1 != null)&#xD;
{&#xD;
	Process.auditLog(&quot;Inizializzo arrayFoundRequestRef con gli elementi di temparrayFoundRequestRef1&quot;);&#xD;
	arrayFoundRequestRef.addAll(temparrayFoundRequestRef1);&#xD;
}&#xD;
&#xD;
if(temparrayFoundRequestRef2 != null)&#xD;
{&#xD;
	if(arrayFoundRequestRef == null)&#xD;
	{&#xD;
		Process.auditLog(&quot;Iniizializzo arrayFoundRequestRef con gli elementi di temparrayFoundRequestRef2&quot;);&#xD;
		arrayFoundRequestRef.addAll(temparrayFoundRequestRef2);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		for(var i = 0; i &lt; temparrayFoundRequestRef2.size(); i++)&#xD;
		{&#xD;
			var currenttemparrayFoundRequestRef2 = temparrayFoundRequestRef2.get(i);&#xD;
			Process.auditLog(&quot;Verifico &quot; + currenttemparrayFoundRequestRef2.toString() + &quot; per duplicazione&quot;);&#xD;
			&#xD;
			if(!arrayFoundRequestRef.contains(currenttemparrayFoundRequestRef2))&#xD;
			{&#xD;
				Process.auditLog(&quot;Elemento non trovato in array principale.&quot;);&#xD;
				arrayFoundRequestRef.add(currenttemparrayFoundRequestRef2);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
if(arrayFoundRequestRef != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; arrayFoundRequestRef.size(); i++)&#xD;
	{&#xD;
		var currentRequest = arrayFoundRequestRef.get(i).readRichiesta();&#xD;
		Process.auditLog(&quot;Controllo la richiesta: &quot; + currentRequest.IDRichiestaOLO);&#xD;
		&#xD;
		// Caso Generico&#xD;
		if(currentRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CHIUSO&#xD;
		    || String(currentRequest.statoRichiestaNOW).slice(0,6) == &quot;CHIUSO&quot;          		//SM_9725&#xD;
			|| String(currentRequest.statoRichiestaNOW).slice(0,9) == &quot;ANNULLATO&quot;				//SM_9826&#xD;
			|| String(currentRequest.statoRichiestaNOW).slice(0,8) == &quot;SCARTATO&quot;				//SM_9826&#xD;
			|| currentRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO&#xD;
			|| currentRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO&#xD;
			|| String(currentRequest.statoRichiestaNOW).slice(0,19) == &quot;ESPLETAMENTOTECNICO&quot;	//SM_9826&#xD;
			|| currentRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOAFATTURAZIONE&#xD;
			|| currentRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.ALTRO&#xD;
			|| currentRequest.IDRichiestaOLO == localRequest.IDRichiestaOLO)&#xD;
		{&#xD;
			// Trovata Richiesta CHIUSA, OK&#xD;
			Process.auditLog(&quot;Rimuovo la richiesta: &quot; + currentRequest.IDRichiestaOLO + &quot; in stato: &quot; + currentRequest.statoRichiestaNOW + &quot; di tipo: &quot; + currentRequest.tipoRichiesta);&#xD;
			arrayFoundRequestRef.remove(i);&#xD;
			i--;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			// In caso di NP del 35 prima o seconda portabilità faccio ulteriore controllo, altrimenti KO&#xD;
			if(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG &amp;&amp;&#xD;
			   localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP) //mofificata condizione RU_752&#xD;
			{&#xD;
				&#xD;
				if((currentRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG) &amp;&amp;&#xD;
				(String(currentRequest.statoRichiestaNOW).slice(0,16) == &quot;INVIATOADELIVERY&quot; ||&#xD;
				   currentRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.VERIFICHEINRETE ||&#xD;
				   currentRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INDELIVERY))&#xD;
				{&#xD;
					&#xD;
					// KO dopo&#xD;
						Process.auditLog(&quot;Trovata richiesta NPG più recente: &quot; + currentRequest.IDRichiestaOLO);&#xD;
						&#xD;
				}&#xD;
				else&#xD;
				{	&#xD;
					// se local Request ha stesso stato, lavorazione, numero telefonico, ed è più recente ESITO KO&#xD;
					if (localRequest.statoRichiestaNOW == currentRequest.statoRichiestaNOW &amp;&amp;&#xD;
						 localRequest.lavorazione == currentRequest.lavorazione &amp;&amp;&#xD;
						 localRequest.numeroTelefonico == currentRequest.numeroTelefonico &amp;&amp; 										&#xD;
						 localRequest.created > currentRequest.created)							&#xD;
					{&#xD;
						Log.write(&quot;LocalDate della richiesta: &quot; + localRequest.IDRichiestaOLO + localRequest.created + &quot; maggiore della currDate della richiesta : &quot; + currentRequest.IDRichiestaOLO + currentRequest.created);&#xD;
						Log.write(&quot;KO - Richiesta : &quot; + localRequest.IDRichiestaOLO);&#xD;
					}&#xD;
					//SM_9178&#xD;
					else if(currentRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
							|| (currentRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
							 &amp;&amp; currentRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO))&#xD;
					{&#xD;
						Log.write(&quot;Trovata Richiesta di MIGRAZIONE o ATTIVAZIONE REG &quot;+currentRequest.IDRichiestaOLO+&quot; con NUMEROTELEFONICO = a quello della NP in corso &quot;+localRequest.IDRichiestaOLO);&#xD;
						Log.write(&quot;KO - Richiesta : &quot; + localRequest.IDRichiestaOLO);&#xD;
					}&#xD;
					else&#xD;
					{	&#xD;
						Log.write(&quot;LocalDate della richiesta: &quot; + localRequest.IDRichiestaOLO + localRequest.created + &quot; minore della currDate della richiesta : &quot; + currentRequest.IDRichiestaOLO + currentRequest.created);&#xD;
						Log.write(&quot;rimuovo - Richiesta : &quot; + currentRequest.IDRichiestaOLO);&#xD;
						arrayFoundRequestRef.remove(i);&#xD;
						i--;&#xD;
					}&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			&#xD;
		}&#xD;
		&#xD;
	}&#xD;
&#xD;
	Process.auditLog(&quot;Array finale con: &quot; + arrayFoundRequestRef.size() + &quot; elementi&quot;);&#xD;
}&#xD;
&#xD;
if(arrayFoundRequestRef.size() == 0)&#xD;
{&#xD;
	PresenzaOrdinativoNOW = &quot;00&quot;;&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Esito Positivo&quot;;&#xD;
}&#xD;
else&#xD;
{&#xD;
	foundRequestRef = arrayFoundRequestRef.get(0);&#xD;
	foundRequest = foundRequestRef.readRichiesta();&#xD;
	&#xD;
	idRicBloccante = foundRequest.IDRichiestaOLO; // SM_8145&#xD;
	&#xD;
	var lnala = &quot;&quot;;&#xD;
	lnala = null;&#xD;
	if(foundRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA&#xD;
		|| foundRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
		|| foundRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA&#xD;
		|| foundRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
		|| foundRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA&#xD;
		|| foundRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP&#xD;
		|| foundRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULL&#xD;
		|| foundRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA)&#xD;
	{&#xD;
		lnala = &quot;LA&quot;;&#xD;
	}&#xD;
	else if(foundRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
			|| foundRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
			|| foundRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA&#xD;
			|| foundRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA&#xD;
			|| foundRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA)&#xD;
	{&#xD;
		lnala = &quot;LNA&quot;;&#xD;
	}&#xD;
	&#xD;
	if(foundRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG)&#xD;
	{&#xD;
		PresenzaOrdinativoNOW = &quot;01&quot;;&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Esito Negativo&quot;;&#xD;
		CodiceEsito = &quot;KO_01&quot;;&#xD;
	}&#xD;
	else if(foundRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
	{&#xD;
		PresenzaOrdinativoNOW = &quot;03&quot;;&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Esito Negativo&quot;;&#xD;
		CodiceEsito = &quot;KO_03&quot;;&#xD;
	}&#xD;
	else if(foundRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
			|| (foundRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
				&amp;&amp; foundRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO&#xD;
				&amp;&amp; lnala == &quot;LA&quot;))&#xD;
	{&#xD;
		PresenzaOrdinativoNOW = &quot;02&quot;;&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Esito Negativo&quot;;&#xD;
		CodiceEsito = &quot;KO_02&quot;;&#xD;
	}&#xD;
	else if(foundRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
	{&#xD;
		PresenzaOrdinativoNOW = &quot;04&quot;;&#xD;
		EsitoResponse.codice = false;&#xD;
		EsitoResponse.descrizione = &quot;Esito Negativo&quot;;&#xD;
		CodiceEsito = &quot;KO_04&quot;;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;PresenzaOrdinativoNOW sará NULL, trovata la seguente richiesta non gestita: &quot; + foundRequest.IDRichiestaOLO);&#xD;
		EsitoResponse.codice = true;&#xD;
		EsitoResponse.descrizione = &quot;Esito Positivo&quot;;&#xD;
	}	&#xD;
}&#xD;
&#xD;
&#xD;
//CASO 2 RU 752&#xD;
&#xD;
//RICHIESTE CON COMPONENTE NUMBER PORTABILITY ATTRIBUTO NUMERO TELEFONICO&#xD;
//Verifico se controlli del CASO 1 sono andati a buon fine&#xD;
if(EsitoResponse.codice)&#xD;
{&#xD;
	Process.auditLog(&quot;inizio ricerca richiesta con componente NUMBER PORTABILITY e stesso NUMERO TELEFONICO.&quot;);&#xD;
	var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;ordine.dettaglioordine.nomeComponente = 'NUMBERPORTABILITY' AND ordine.dettaglioordine.attributiDettaglioOrdine.nomeAttributo = 'NUMEROTELEFONICO' AND ordine.dettaglioordine.attributiDettaglioOrdine.valoreAttributo=:DN&quot;);&#xD;
&#xD;
	if(DN != null)&#xD;
	{&#xD;
		criteria.setQueryParameter(&quot;DN&quot;,DN);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		criteria.setQueryParameter(&quot;DN&quot;,localRequest.numeroTelefonico);&#xD;
	}&#xD;
&#xD;
	var arrayFoundRequestRef3 = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
&#xD;
	if(arrayFoundRequestRef3 != null)&#xD;
	{&#xD;
		&#xD;
		for(var i = 0; i &lt; arrayFoundRequestRef3.size(); i++)&#xD;
		{&#xD;
			var currentRequest = arrayFoundRequestRef3.get(i).readRichiesta();&#xD;
			Process.auditLog(&quot;Verifico condizioni per &quot; + currentRequest.IDRichiestaOLO);&#xD;
			&#xD;
			if(String(currentRequest.statoRichiestaNOW).slice(0,6) != &quot;CHIUSO&quot;          			//SM_9725&#xD;
				&amp;&amp; String(currentRequest.statoRichiestaNOW).slice(0,9) != &quot;ANNULLATO&quot;				//SM_9826&#xD;
				&amp;&amp; String(currentRequest.statoRichiestaNOW).slice(0,8) != &quot;SCARTATO&quot;				//SM_9826&#xD;
				&amp;&amp; currentRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO&#xD;
				&amp;&amp; currentRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO&#xD;
				&amp;&amp; String(currentRequest.statoRichiestaNOW).slice(0,19) != &quot;ESPLETAMENTOTECNICO&quot;	//SM_9826&#xD;
				&amp;&amp; currentRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOAFATTURAZIONE&#xD;
				&amp;&amp; currentRequest.IDRichiestaOLO != localRequest.IDRichiestaOLO)&#xD;
			{&#xD;
					PresenzaOrdinativoNOW = &quot;02&quot;;&#xD;
					EsitoResponse.codice = false;&#xD;
					EsitoResponse.descrizione = &quot;Esito Negativo&quot;;&#xD;
					CodiceEsito = &quot;KO_02&quot;;&#xD;
					idRicBloccante = currentRequest.IDRichiestaOLO; // SM_8303&#xD;
			}&#xD;
		}&#xD;
		&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		Process.auditLog(&quot;Nessuna Richiesta con componente NUMBER PORTABILITY e stesso NUMERO TELEFONICO.&quot;);&#xD;
	}&#xD;
&#xD;
}&#xD;
&#xD;
