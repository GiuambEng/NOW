          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="82.0" LaneId="_xTcYAW83Ee2fLuVz0xfcSg" Width="45.0">
              <xpdl2:Coordinates XCoordinate="69.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_7rZN0m84Ee2fLuVz0xfcSg" Name="VerificapresenzaaltroordinativodiNPincorsosuNowperDel103" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Verifica presenza altro ordinativo di NP in corso su Now per Del.103">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;numeroTelefonico=:DN&quot;);&#xD;
&#xD;
if(DN != null)&#xD;
{&#xD;
	criteria.setQueryParameter(&quot;DN&quot;,DN);&#xD;
}&#xD;
else&#xD;
{&#xD;
	criteria.setQueryParameter(&quot;DN&quot;,localRequest.numeroTelefonico);&#xD;
}&#xD;
&#xD;
var queryDN = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
//ATTRIBUTO NUMERO TELEFONICO&#xD;
var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;ordine.dettaglioordine.attributiDettaglioOrdine.nomeAttributo = 'NUMEROTELEFONICO' AND ordine.dettaglioordine.attributiDettaglioOrdine.valoreAttributo=:DN&quot;);&#xD;
&#xD;
if(DN != null)&#xD;
{&#xD;
	criteria.setQueryParameter(&quot;DN&quot;,DN);&#xD;
}&#xD;
else&#xD;
{&#xD;
	criteria.setQueryParameter(&quot;DN&quot;,localRequest.numeroTelefonico);&#xD;
}&#xD;
&#xD;
var queryNumeroTelefonico = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
//Aggiunta nell'array complessivo della query col DN&#xD;
if(queryDN != null)&#xD;
{&#xD;
	Process.auditLog(&quot;Inizializzo arrayFoundRequestRef con gli elementi di queryDN&quot;);&#xD;
	arrayFoundRequestRef.addAll(queryDN);&#xD;
}&#xD;
&#xD;
//In questo if verifichiamo che l'array dei risultati della query sul DN e quella sull'attributo numero telefonico non siano null.&#xD;
//Se entrambi sono valorizzati, si eliminano i record duplicati e si fa merge. Altrimenti si fa addAll dell'array numero telefonico&#xD;
if(queryNumeroTelefonico != null)&#xD;
{&#xD;
	if(arrayFoundRequestRef == null)&#xD;
	{&#xD;
		Process.auditLog(&quot;Iniizializzo arrayFoundRequestRef con gli elementi di queryNumeroTelefonico&quot;);&#xD;
		arrayFoundRequestRef.addAll(queryNumeroTelefonico);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		for(var i = 0; i &lt; queryNumeroTelefonico.size(); i++)&#xD;
		{&#xD;
			var currenttemparrayFoundRequestRef2 = queryNumeroTelefonico.get(i);&#xD;
			Process.auditLog(&quot;Verifico &quot; + currenttemparrayFoundRequestRef2.toString() + &quot; per duplicazione&quot;);&#xD;
			&#xD;
			if(!arrayFoundRequestRef.contains(currenttemparrayFoundRequestRef2))&#xD;
			{&#xD;
				Process.auditLog(&quot;Elemento non trovato in array principale.&quot;);&#xD;
				arrayFoundRequestRef.add(currenttemparrayFoundRequestRef2);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//INIZIO DEI VARI CONTROLLI&#xD;
if(arrayFoundRequestRef != null)&#xD;
{&#xD;
	for(var i = 0; i &lt; arrayFoundRequestRef.size(); i++)&#xD;
	{&#xD;
		var currentRequest = arrayFoundRequestRef.get(i).readRichiesta();&#xD;
		Process.auditLog(&quot;Controllo la richiesta: &quot; + currentRequest.IDRichiestaOLO);&#xD;
		&#xD;
		// Caso Generico: primo capoverso del controllo -> RICERCA DELLA RICHIESTA CORRENTE SE SI TROVA IN UNO STATO CHIUSO: SE SI LA RIMUOVIAMO DALL'ARRAY COMPLESSIVO&#xD;
		if(currentRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CHIUSO&#xD;
		    || String(currentRequest.statoRichiestaNOW).slice(0,6) == &quot;CHIUSO&quot;          		&#xD;
			|| String(currentRequest.statoRichiestaNOW).slice(0,9) == &quot;ANNULLATO&quot;				&#xD;
			|| String(currentRequest.statoRichiestaNOW).slice(0,8) == &quot;SCARTATO&quot;				&#xD;
			|| currentRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO&#xD;
			|| currentRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO&#xD;
			|| String(currentRequest.statoRichiestaNOW).slice(0,19) == &quot;ESPLETAMENTOTECNICO&quot;	&#xD;
			|| currentRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INVIATOAFATTURAZIONE&#xD;
			|| currentRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.ALTRO &#xD;
			|| currentRequest.IDRichiestaOLO == localRequest.IDRichiestaOLO)&#xD;
		{&#xD;
			// Trovata Richiesta CHIUSA, OK&#xD;
			Process.auditLog(&quot;Rimuovo la richiesta: &quot; + currentRequest.IDRichiestaOLO + &quot; in stato: &quot; + currentRequest.statoRichiestaNOW + &quot; di tipo: &quot; + currentRequest.tipoRichiesta);&#xD;
			arrayFoundRequestRef.remove(i);&#xD;
			i--;&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			&#xD;
			// SECONDO CAPOVERSO: ELIMINATO IF DEL CONTROLLO ORIGINARIO DATO CHE *QUESTO* CONTROLLO è SOLO PER NP&#xD;
			if((currentRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG) &amp;&amp;&#xD;
			(String(currentRequest.statoRichiestaNOW).slice(0,16) == &quot;INVIATOADELIVERY&quot; ||&#xD;
			   currentRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.VERIFICHEINRETE ||&#xD;
			   currentRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INDELIVERY)&#xD;
			 &amp;&amp; currentRequest.flagDelibera103 == 'Y')//AGGIUNTO DA ME&#xD;
			{&#xD;
				&#xD;
				// KO dopo&#xD;
				Process.auditLog(&quot;Trovata richiesta NPG più recente: &quot; + currentRequest.IDRichiestaOLO);&#xD;
					&#xD;
			}&#xD;
			else&#xD;
			{	&#xD;
				// TERZO CAPOVERSO : se local Request ha stesso stato, lavorazione, numero telefonico, ed è più recente ESITO KO&#xD;
				if (localRequest.statoRichiestaNOW == currentRequest.statoRichiestaNOW &amp;&amp;&#xD;
					 localRequest.lavorazione == currentRequest.lavorazione &amp;&amp;&#xD;
					 localRequest.numeroTelefonico == currentRequest.numeroTelefonico &amp;&amp; 										&#xD;
					 localRequest.created > currentRequest.created)							&#xD;
				{&#xD;
					Log.write(&quot;LocalDate della richiesta: &quot; + localRequest.IDRichiestaOLO + localRequest.created + &quot; maggiore della currDate della richiesta : &quot; + currentRequest.IDRichiestaOLO + currentRequest.created);&#xD;
					Log.write(&quot;KO - Richiesta : &quot; + localRequest.IDRichiestaOLO);&#xD;
				}&#xD;
				else&#xD;
				{	&#xD;
					Log.write(&quot;LocalDate della richiesta: &quot; + localRequest.IDRichiestaOLO + localRequest.created + &quot; minore della currDate della richiesta : &quot; + currentRequest.IDRichiestaOLO + currentRequest.created);&#xD;
					Log.write(&quot;rimuovo - Richiesta : &quot; + currentRequest.IDRichiestaOLO);&#xD;
					arrayFoundRequestRef.remove(i);&#xD;
					i--;&#xD;
				}&#xD;
			}&#xD;
			&#xD;
		}&#xD;
		&#xD;
	}&#xD;
&#xD;
	Process.auditLog(&quot;Array finale con: &quot; + arrayFoundRequestRef.size() + &quot; elementi&quot;);&#xD;
}&#xD;
&#xD;
if(arrayFoundRequestRef.size() == 0)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Esito Positivo&quot;;&#xD;
}else&#xD;
{&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;Esito Negativo&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
