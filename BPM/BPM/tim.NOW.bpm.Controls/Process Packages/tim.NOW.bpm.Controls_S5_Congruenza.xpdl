    <xpdl2:WorkflowProcess Id="_dYm08G6tEe2yqM9WLKyWOA" xpdExt:DisplayName="CTRL TRV ORD VARWLR D103_C04M02F93" Name="CTRLTRVORDVARWLRD103_C04M02F93">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_Y20LgW7_Ee2CQNfo1pE7AQ" xpdExt:DisplayName="queryDN" Name="queryDN" IsArray="true" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:RecordType>
              <xpdl2:Member>
                <xpdl2:ExternalReference location="tim.NOW.bpm.casedataBOM.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="_2Y1K_erUEeWg_qPSKmWaWg"/>
              </xpdl2:Member>
            </xpdl2:RecordType>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
      </xpdl2:DataFields>
      <xpdl2:Activities>
        <xpdl2:Activity Id="_dZC5026tEe2yqM9WLKyWOA" Name="EndEvent" xpdExt:DisplayName="End Event">
          <xpdl2:Event>
            <xpdl2:EndEvent Result="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="30.0" LaneId="_dZC50W6tEe2yqM9WLKyWOA" Width="30.0">
              <xpdl2:Coordinates XCoordinate="592.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_mAw2MG6wEe2yqM9WLKyWOA" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_iU_vEG6wEe2yqM9WLKyWOA" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="82.0" LaneId="_dZC50W6tEe2yqM9WLKyWOA" Width="45.0">
              <xpdl2:Coordinates XCoordinate="69.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_kcoUgm6xEe2yqM9WLKyWOA" Name="VerificaaltroordinativodiVarWLRincorso" IsATransaction="false" xpdExt:RequireNewTransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Verifica altro ordinativo di VarWLR in corso">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
var criteria = cac_it_telecomitalia_it_NOW_casedata_Richiesta.createCriteria(&quot;numeroTelefonico=:DN&quot;);&#xD;
&#xD;
if(DN != null)&#xD;
{&#xD;
	criteria.setQueryParameter(&quot;DN&quot;,DN);&#xD;
}&#xD;
else&#xD;
{&#xD;
	criteria.setQueryParameter(&quot;DN&quot;,localRequest.numeroTelefonico);&#xD;
}&#xD;
&#xD;
queryDN = cac_it_telecomitalia_it_NOW_casedata_Richiesta.findByCriteria(criteria);&#xD;
&#xD;
var foundVariazione = false;&#xD;
var i=0;&#xD;
&#xD;
while (!foundVariazione &amp;&amp; i&lt;queryDN.size()){&#xD;
	&#xD;
	var currentRequest = queryDN.get(i).readRichiesta();&#xD;
	Process.auditLog(&quot;Controllo la richiesta: &quot; + currentRequest.IDRichiestaOLO);&#xD;
	&#xD;
	if (currentRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
		&amp;&amp; (String(currentRequest.tipologiaSottolav).slice(0,12) == &quot;CAMBIONUMERO&quot;&#xD;
			|| String(currentRequest.tipologiaSottolav).slice(0,16) == &quot;INCREMENTOCANALI&quot;&#xD;
			|| String(currentRequest.tipologiaSottolav).slice(0,16) == &quot;DECREMENTOCANALI&quot;&#xD;
			|| String(currentRequest.tipologiaSottolav).slice(0,17) == &quot;INCREMENTOBORCHIA&quot;&#xD;
			|| String(currentRequest.tipologiaSottolav).slice(0,17) == &quot;DECREMENTOBORCHIA&quot;&#xD;
			|| String(currentRequest.tipologiaSottolav).slice(0,18) == &quot;CAMBIOTIPOLOGIAWLR&quot;&#xD;
			|| String(currentRequest.tipologiaSottolav).slice(0,25) == &quot;ATTIVAZIONESTSMULTINUMERO&quot;&#xD;
			|| String(currentRequest.tipologiaSottolav).slice(0,24) == &quot;CESSAZIONESTSMULTINUMERO&quot;&#xD;
			|| String(currentRequest.tipologiaSottolav).slice(0,14) == &quot;PRESTAZIONEWLR&quot;&#xD;
			|| String(currentRequest.tipologiaSottolav).slice(0,14) == &quot;ATTIVAZIONESTS&quot;&#xD;
			|| String(currentRequest.tipologiaSottolav).slice(0,13) == &quot;CESSAZIONESTS&quot;)&#xD;
		&amp;&amp; String(currentRequest.statoRichiestaNOW).slice(0,6) != &quot;CHIUSO&quot;          			//SM_9725&#xD;
		&amp;&amp; String(currentRequest.statoRichiestaNOW).slice(0,9) != &quot;ANNULLATO&quot;				//SM_9826&#xD;
		&amp;&amp; String(currentRequest.statoRichiestaNOW).slice(0,8) != &quot;SCARTATO&quot;				//SM_9826&#xD;
		&amp;&amp; currentRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO&#xD;
		&amp;&amp; currentRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.FATTURAZIONEKO&#xD;
		&amp;&amp; String(currentRequest.statoRichiestaNOW).slice(0,19) != &quot;ESPLETAMENTOTECNICO&quot;)&#xD;
		{&#xD;
			foundVariazione = true;&#xD;
		}&#xD;
	&#xD;
	i++;&#xD;
	&#xD;
}&#xD;
&#xD;
if (foundVariazione){&#xD;
	EsitoResponse.codice = false;&#xD;
	EsitoResponse.descrizione = &quot;VariazioneWLR in corso&quot;;&#xD;
}else{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Esito Positivo&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="100.0" LaneId="_dZC50W6tEe2yqM9WLKyWOA" Width="153.0">
              <xpdl2:Coordinates XCoordinate="312.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
      </xpdl2:Activities>
      <xpdl2:Transitions>
        <xpdl2:Transition Id="_kcoUg26xEe2yqM9WLKyWOA" Name="" From="_mAw2MG6wEe2yqM9WLKyWOA" To="_kcoUgm6xEe2yqM9WLKyWOA">
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
          </xpdl2:ConnectorGraphicsInfos>
        </xpdl2:Transition>
        <xpdl2:Transition Id="_mVRRIG6xEe2yqM9WLKyWOA" xpdExt:DisplayName="" Name="" From="_kcoUgm6xEe2yqM9WLKyWOA" To="_dZC5026tEe2yqM9WLKyWOA">
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.LabelAnchorPosition">
              <xpdl2:Coordinates XCoordinate="50.0" YCoordinate="0.0"/>
              <xpdl2:Coordinates XCoordinate="0.0" YCoordinate="0.0"/>
            </xpdl2:ConnectorGraphicsInfo>
          </xpdl2:ConnectorGraphicsInfos>
