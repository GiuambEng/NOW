                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_t6mMgE-LEee5hreS_z3HJA" OperationName="OLONormalizzato">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckPortTypeSOAP" ServiceName="BPM_CheckPortType">
