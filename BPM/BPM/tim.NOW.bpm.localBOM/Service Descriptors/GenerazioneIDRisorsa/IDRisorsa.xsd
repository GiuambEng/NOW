<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/GenerateIDResource" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/GenerateIDResource" xmlns:pref="http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive" xmlns:pref1="http://NOW.it.telecomitalia.it/casedata_v1">
	<import schemaLocation="../CaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"/>
	<element name="IDRisorsaInput">
		<complexType>
			<sequence>
				<element name="Servizio" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="PrefissoDistrettuale" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="IDRichiestaOLO" type="string" maxOccurs="1" minOccurs="1"/>
				<element name="StrutturaRichiesta" type="pref1:TipoStrutturaRichiestaEnumeration" maxOccurs="1" minOccurs="1"/>
				<element name="NumerazioneCondivisa" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="Lavorazione" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="SottoLavorazione" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="IdRisorsaDati" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="IdRisorsaFonia" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="CodiceOLO" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="CodiceCLLI" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="NomeMacroArea" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="FeederSuccessivoInput" type="tns:FeederSuccessivoIn" minOccurs="0" maxOccurs="unbounded"></element>
			</sequence>
		</complexType>
	</element>
	<element name="IDRisorsaOutput">
		<complexType>
			<sequence>
				<element name="IDRisorsa" type="string" maxOccurs="1" minOccurs="1"/>
				<element name="PrimoNumeroDisponibile" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="IDRisorsaVLANMulticast" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="FeederSuccessivoOutput" type="tns:FeederSuccessivoOut" minOccurs="0" maxOccurs="unbounded"></element>
			</sequence>
		</complexType>
	</element>
	<element name="IDRisorsaFault">
		<complexType>
			<sequence>
				<element name="Msg" type="string"/>
				<element name="Code" type="string"/>
			</sequence>
		</complexType>
	</element>
	<complexType name="FeederSuccessivoIn">
		<sequence>
			<element name="IDDettaglioOrdine" type="string"
				minOccurs="0" maxOccurs="1">
			</element>
			<element name="ClliFeederSuccessivo" type="string" minOccurs="0" maxOccurs="1"></element>
		</sequence>
	</complexType>
	<complexType name="FeederSuccessivoOut">
		<sequence>
			<element name="IDDettaglioOrdine" type="string"
				minOccurs="0" maxOccurs="1">
			</element>
			<element name="ClliFeederSuccessivo" type="string"
				minOccurs="0" maxOccurs="1">
			</element>
			<element name="IDRisorsaFeeder" type="string" minOccurs="0" maxOccurs="1"></element>
		</sequence>
	</complexType>
</schema>