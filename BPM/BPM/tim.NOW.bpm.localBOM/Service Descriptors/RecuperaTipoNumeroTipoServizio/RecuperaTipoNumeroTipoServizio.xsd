<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/RecuperaTipoNumeroTipoServizio" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/RecuperaTipoNumeroTipoServizio">

    <element name="RecuperaTipoNumTipoServIn">
    	<complexType>
    		<sequence>
                <element name="IdRichiestaOLO" type="string"></element>
                <element name="NumeroTelefonicoNP" maxOccurs="unbounded"
                	minOccurs="1">
                	<complexType>
                		<sequence>
                			<element name="NumeroTelefonico" type="string" maxOccurs="1" minOccurs="1"></element>
                		</sequence>
                	</complexType>
                </element>
    		</sequence>
    	</complexType>
    </element>

    <element name="RecuperaTipoNumTipoServOut">
    	<complexType>
    		<sequence>
    			<element name="RecuperaTipoNumOutput"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="TipoNumero" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="TipoServizio" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="Flag_Attivo" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="Tipo_Portabilita" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="Oscurato" type="boolean"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Fault">
    	<complexType>
    		<sequence>
    			<element name="Esito" type="string"></element>
    			<element name="Messaggio" type="string"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>