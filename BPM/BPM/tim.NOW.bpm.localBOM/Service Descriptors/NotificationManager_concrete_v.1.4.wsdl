<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:ns="http://www.tim.com/NOW/wsdl/concrete/NotificationManager/" xmlns:ns0="http://www.tim.com/NOW/xsd/NotificationManager/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="NotificationManagerPortType" targetNamespace="http://www.tim.com/NOW/wsdl/concrete/NotificationManager/">
  <wsdl:import namespace="http://www.tim.com/NOW/xsd/NotificationManager/" location="NotificationManager/NotificationManager.xsd"/>
  <wsdl:message name="CreateNotificationRequest">
    <wsdl:part element="ns0:NotificationRequest" name="NotificaRichiesta"/>
  </wsdl:message>
  <wsdl:message name="CreateNotificationResponse">
    <wsdl:part element="ns0:NotificationResponse" name="NotificaRisposta"/>
  </wsdl:message>
  <wsdl:message name="CreateNotificationFault">
    <wsdl:part element="ns0:NotificationFault" name="NotificaFault"/>
  </wsdl:message>
  <wsdl:portType name="NotificationManagerPortType">
    <wsdl:operation name="CreateNotification">
      <wsdl:input message="ns:CreateNotificationRequest"/>
      <wsdl:output message="ns:CreateNotificationResponse"/>
      <wsdl:fault message="ns:CreateNotificationFault" name="fault"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="NotificationManagerSOAPService" type="ns:NotificationManagerPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="CreateNotification">
      <soap:operation soapAction="CreateNotification" style="document"/>
      <wsdl:input>
        <soap:body parts="NotificaRichiesta" use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body parts="NotificaRisposta" use="literal"/>
      </wsdl:output>
      <wsdl:fault name="fault">
        <soap:fault name="fault" use="literal"/>
      </wsdl:fault>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="NotificationManagerPortType">
    <wsdl:port binding="ns:NotificationManagerSOAPService" name="NotificationManagerPortTypeSOAP">
      <soap:address location="https://localhost:8083/NotificationManager_SOAPService/notificationManager_v1/"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
