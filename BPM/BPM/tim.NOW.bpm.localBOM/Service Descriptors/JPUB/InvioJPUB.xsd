<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns:Q1="http://NOW.it.telecomitalia.it/casedata_v1"
	xmlns:extns="http://xsd.telecomitalia.it/Schema/jpub/"
	xmlns:asd="http://xsd.telecomitalia.it/Schema/jpubADSL/"
	xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://www.tim.com/NOW/xsd/InvioJPUB/"
	xmlns:tns="http://www.tim.com/NOW/xsd/InvioJPUB/"
	elementFormDefault="qualified">
	<import namespace="http://xsd.telecomitalia.it/Schema/jpub/" schemaLocation="OrdiniCRMWS_Reg_2.23.xsd" />
	<import	schemaLocation="../CaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"/>
	
	<element name="BPMRequest">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="Richiesta"
					type="Q1:Richiesta" />
				<element name="Asset" maxOccurs="1" minOccurs="0"
					type="Q1:Asset" />
				<element name="Flag_OpereSpeciali" maxOccurs="1"
					minOccurs="0" type="boolean" />
				<element name="AssetCorrelatiAttivi" type="Q1:Asset" maxOccurs="unbounded" minOccurs="0"></element>
				<element name="AssetCorrelatiCessati" type="Q1:Asset" maxOccurs="unbounded" minOccurs="0"></element>
				<element name="AssetCorrelatiVariati" type="Q1:Asset" maxOccurs="unbounded" minOccurs="0"></element>
				<element name="AssetRicarica" type="Q1:AssetRicarica" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
	<element name="BPMResponse">
		<complexType>
			<sequence>
				<element name="Codice" type="string" maxOccurs="1" minOccurs="1"/>
				<element name="Descrizione" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="IdEventoOrdNowWhols" type="int" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="SendJPUBResponse">
		<complexType>
			<sequence>
				<element name="code">
					<simpleType>
						<restriction base="string">
							<maxLength value="500"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="msg">
					<simpleType>
						<restriction base="string">
							<maxLength value="500"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="Response_Aggiuntivi" maxOccurs="unbounded" minOccurs="0">
					<complexType>
						<sequence>
							<element name="code">
								<simpleType>
									<restriction base="string">
										<maxLength value="500"></maxLength>
									</restriction>
								</simpleType>
							</element>
                            <element name="msg">
								<simpleType>
									<restriction base="string">
										<maxLength value="500"></maxLength>
									</restriction>
								</simpleType>
							</element>
                            <element name="Identificativo" type="string"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="SendJPUBFault" type="tns:Fault"/>
	<element name="BPMFault" type="tns:Fault"/>
	<complexType name="Fault">
		<sequence>
			<element name="code" type="string"/>
			<element name="msg" type="string"/>
		</sequence>
	</complexType>
</schema>