<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:pref="http://xsd.telecomitalia.it/Schema/jpub/"
	xmlns:pref1="http://www.tim.com/NOW/xsd/InvioJPUB/"
	xmlns:pref2="http://xsd.telecomitalia.it/Schema/jpubADSL/"
	xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util"
	elementFormDefault="qualified"
	targetNamespace="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:pref3="http://NOW.it.telecomitalia.it/casedata_v1">
	<import namespace="http://xsd.telecomitalia.it/Schema/jpub/"
		schemaLocation="OrdiniCRMWS_Reg_2.23.xsd">
	</import>
	<import namespace="http://www.tim.com/NOW/xsd/InvioJPUB/"
		schemaLocation="InvioJPUB.xsd">
	</import>
	<import schemaLocation="../CaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"></import>
		<element name="ProcedureXSD">
		<complexType>
			<sequence>
				<element name="inputSet">
					<complexType>
						<sequence>
							<element maxOccurs="unbounded" minOccurs="0"
								name="SEARCH_KEYS">
								<complexType>
									<sequence>
										<element name="TAG"
											type="string">
										</element>
										<element
											name="VALORE_DA_TRASCODFCRE" type="string">
										</element>
										<element name="NOME_ATTR_VALORE"
											type="string">
										</element>
									</sequence>
								</complexType>
							</element>
							<element name="INIDSISTEMA" type="int" />
							<element name="INAMBITO" type="string" />
							<element name="INCOD_OFFERTA_JPUB"
								type="string">
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	
	<element name="REGOLATORIORipetitivo">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="1"
					ref="pref:REGOLATORIO">
				</element>
			</sequence>
		</complexType>
	</element>
	
	<element name="UPDATEGestioneFatturazioneResponse">
		<complexType>
			<sequence>
				<element name="PRINCIPALE">
					<complexType>
						<sequence>
							<element maxOccurs="unbounded" minOccurs="1"
								ref="tns:Record" />
						</sequence>
					</complexType>
				</element>
				<element maxOccurs="1" minOccurs="0"
					name="AGGIUNTIVI">
					<complexType>
						<sequence>
							<element maxOccurs="unbounded" minOccurs="1"
								ref="tns:Record" />
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="UPDATEGestioneFatturazioneRecord">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="1"
					ref="tns:Record">
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Record">
		<complexType>
			<sequence>
				<element name="CONTENUTO_XML" type="string" />
				<element name="TIMSTP_AGGTO" type="string" />
				<element name="ID_RISORSA" type="string" />
				<element name="ID_RICH_OLO" type="string" />
				<element name="ID_EVENTO_ORDN_NOW_WHLS" type="int" />
				<element maxOccurs="1" minOccurs="0"
					name="IDDETTAGLIOORDINE" type="int">
				</element>
				<element maxOccurs="1" minOccurs="0"
					name="ID_ORDINE_COMPOSTO" type="string">
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="TIPO_COS">
		<complexType>
			<sequence>
				<element name="COS" maxOccurs="4" minOccurs="1">
					<complexType>
						<sequence>
							<element name="TIPO_COS" type="int"></element>
							<element name="BANDA_PICCO_UP"
								type="string">
							</element>
							<element name="BANDA_PICCO_DOWN"
								type="string">
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Response_Aggiuntivi">
		<complexType>
			<sequence>
				<element name="Code" type="string"></element>
				<element name="Msg" type="string"></element>
				<element name="Identificativo" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Sede">
		<complexType>
			<sequence>



				<element name="SedeRipetitiva" maxOccurs="unbounded"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="CodiceComuneIstat"
								type="string">
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>

	<element name="ValorizzaPreventivoResponse">
		<complexType>
			<sequence>
				<element name="TRANSACTION_ID" type="string"></element>
				<element name="RESPONSE_DATE" type="dateTime"></element>
				<element name="RETURN_CODE" type="string"></element>
				<element name="DESCRIZIONE_ERRORE" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
			</sequence>
		</complexType>
	</element>

	<element name="MappingREG_WLRResponse">
		<complexType>
			<sequence>
				<element name="WLR">
					<complexType>
						<sequence>
							<element name="PRINCIPALE">
								<complexType>
									<sequence>

										<element
											ref="pref:REGOLATORIO">
										</element>
									</sequence>
								</complexType>
							</element>
							<element name="AGGIUNTIVI" maxOccurs="1"
								minOccurs="0">
								<complexType>
									<sequence>

										<element ref="pref:REGOLATORIO"
											maxOccurs="unbounded" minOccurs="1">
										</element>
									</sequence>
								</complexType>
							</element>
						</sequence>
					</complexType>
				</element>

			</sequence>
		</complexType>
	</element>

	<element name="CodeCausaleRequest">
		<complexType>
			<sequence>
				<element name="PID_SISTEMA" type="string"></element>
				<element name="PSCENARIO" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="PSOTTOLAVORAZ" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="ID_Rich_OLO" type="string"></element>
			</sequence>
		</complexType>
	</element>

	<element name="CodeCausaleResponse">
		<complexType>
			<sequence>
				<element name="VALOREATTRIBUTO" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="COD_CAUS_DESTINATARIO" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
			</sequence>
		</complexType>
	</element>

	<element name="ValorizzaPreventivoRequest">
		<complexType>
			<sequence>

				<element name="Request">
					<complexType>
						<sequence>
							<element name="Richiesta" type="pref3:Richiesta"></element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>
