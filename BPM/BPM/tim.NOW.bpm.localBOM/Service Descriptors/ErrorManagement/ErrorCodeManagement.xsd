<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:Q1="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:cs="http://www.tim.com/NOW/xsd/CommonSchema/" xmlns:ecm="http://www.tim.com/NOW/xsd/ErrorCodeManagement/" targetNamespace="http://www.tim.com/NOW/xsd/ErrorCodeManagement/" elementFormDefault="qualified">
	<import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../CaseData/it.telecomitalia.it.NOW.casedata.xsd"/>
	<import namespace="http://www.tim.com/NOW/xsd/CommonSchema/" schemaLocation="../CommonSchema/CommonSchema.xsd"/>
	<element name="VerificaCongruenzaCausali" type="ecm:verificaCongruenzaCausaliInput"/>
	<element name="VerificaCongruenzaCausaliResponse" type="ecm:verificaCongruenzaCausaliOutput"/>
	<element name="RecuperaCausaliValide" type="ecm:recuperaCausaliValideInput"/>
	<element name="RecuperaCausaliValideResponse" type="ecm:recuperaCausaliValideOutput"/>
	<element name="TrascodificaCausale" type="ecm:trascodificaCausaleInput"/>
	<element name="TrascodificaCausaleResponse" type="ecm:trascodificaCausaleOutput"/>
	<element name="TrascodificaCodiceCausale" type="ecm:trascodificaCodiceCausaleInput"/>
	<element name="TrascodificaCodiceCausaleResponse" type="ecm:trascodificaCodiceCausaleOutput"/>
	<element name="VerificaCongruenzaCausaleResponse" type="ecm:verificaCongruenzaCausaleOutput"/>
	<element name="Fault" type="ecm:fault"/>
	<complexType name="verificaCongruenzaCausaliInput">
		<sequence>
			<element name="IdRichiestaNOW" type="string"/>
			<element name="Servizio" type="Q1:OffertaEnumeration" minOccurs="0"/>
			<element name="Lavorazione" type="Q1:LavorazioneEnumeration"/>
			<element name="CodificaOLO_AGCOM" type="cs:CodificaOLOAGCOM"/>
			<element name="FlagNPD" type="string" minOccurs="0"/>
			<element name="TipoLinea" type="cs:TipoLinea" minOccurs="0"/>
			<element name="IDAnagraficaCausale" type="int"/>
			<element name="Fase" type="cs:Fase"/>
		</sequence>
	</complexType>
	<complexType name="verificaCongruenzaCausaliOutput">
		<sequence>
			<element name="Esito" type="ecm:esito"/>
		</sequence>
	</complexType>
	<complexType name="verificaCongruenzaCausaleOutput">
		<sequence>
			<element name="Esito" type="ecm:esito"/>
			<element name="Descrizione" type="string" maxOccurs="1" minOccurs="0"/>
			<element name="Flag_timeout" type="string" maxOccurs="1" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="recuperaCausaliValideInput">
		<sequence>
			<element name="IdRichiestaNOW" type="string"/>
			<element name="Servizio" type="Q1:OffertaEnumeration" minOccurs="0"/>
			<element name="Lavorazione" type="Q1:LavorazioneEnumeration" minOccurs="0"/>
			<element name="CodificaOLO_AGCOM" type="cs:CodificaOLOAGCOM"/>
			<element name="FlagNPD" type="string" minOccurs="0"/>
			<element name="TipoLinea" type="cs:TipoLinea" minOccurs="0"/>
			<element name="Fase" type="cs:Fase"/>
		</sequence>
	</complexType>
	<complexType name="recuperaCausaliValideOutput">
		<sequence>
			<element name="ListaCausaliValide" type="ecm:listaCausali" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
	<complexType name="listaCausali">
		<sequence>
			<element name="IdAnagraficaCausale" type="int"/>
			<element name="CodiceCausaleInterna" type="string"/>
			<element name="DescrizioneCausaleInterna" type="string" minOccurs="0"/>
			<element name="CodiceCausaleDG" type="string" minOccurs="0"/>
			<element name="DescrizioneCausaleDG" type="string" minOccurs="0"/>
			<element name="CodiceCausaleOLO" type="string" minOccurs="0"/>
			<element name="DescrizioneCausaleOLO" type="string" minOccurs="0"/>
			<element name="Offerta" type="string"/>
			<element name="TipologiaLavorazione" type="string"/>
		</sequence>
	</complexType>
	<complexType name="trascodificaCausaleInput">
		<sequence>
			<element name="IdAnagraficaCausale" type="int"/>
		</sequence>
	</complexType>
	<complexType name="trascodificaCausaleOutput">
		<sequence>
			<element name="CodiceCausaleNowDG" type="string"/>
			<element name="CodiceCausaleOLO" type="string"/>
			<element name="DescrizioneCausaleInterna" type="string"/>
			<element name="DescrizioneCausaleNowDG" type="string"/>
			<element name="DescrizioneCausaleOLO" type="string"/>
			<element name="IdAnagraficaCausale" type="string"/>
			<element name="IdCausaleInterno" type="string"/>
			<element name="IdFamigliaCausale" type="string" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="trascodificaCodiceCausaleInput">
		<sequence>
			<element name="codiceCausale" type="string"/>
		</sequence>
	</complexType>
	<complexType name="trascodificaCodiceCausaleOutput">
		<sequence>
			<element name="IdAnagraficaCausale" type="int"/>
		</sequence>
	</complexType>
	<complexType name="fault">
		<sequence>
			<element name="CodiceErrore" type="string"/>
			<element name="MessaggioErrore" type="string"/>
		</sequence>
	</complexType>
	<simpleType name="esito">
		<restriction base="string">
			<enumeration value="SCARTO"/>
			<enumeration value="IMPROPRIO"/>
			<enumeration value="ERRATO"/>
			<enumeration value=""/>
		</restriction>
	</simpleType>
	<element name="MonitoraggioCautelare" type="ecm:monitoraggioCautelareInput"/>
	<complexType name="monitoraggioCautelareInput">
		<sequence>
			<element name="IDRichiestaOLO" type="string"/>
			<element name="TipoOperazione" type="ecm:TipoOperazioneType1"/>
			<element name="idAnagCaus" type="int"/>
			<element name="codCausInternoNew" type="string" minOccurs="0"/>
			<element name="descrCausInternoNew" type="string" minOccurs="0"/>
			<element name="TMSTP_AggRichOLO" type="dateTime"/>
			<element name="TipologiaLavorazione" type="string" minOccurs="0"/>
			<element name="Offerta" type="string" minOccurs="0"/>
			<element name="EsitoVerifica" type="string"/>
		</sequence>
	</complexType>
	<element name="MonitoraggioCautelareResponse" type="ecm:monitoraggioCautelareOutput"/>
	<complexType name="monitoraggioCautelareOutput">
		<sequence>
			<element name="Esito" minOccurs="0">
				<complexType>
					<sequence>
						<element name="Codice" type="string" minOccurs="0"/>
						<element name="DescrizioneErrore" type="string" minOccurs="0"/>
					</sequence>
				</complexType>
			</element>
		</sequence>
	</complexType>
	
	<element name="MonitoraggioCautelare_v1_Request" type="ecm:monitoraggioCautelare_Input"/>
    <complexType name="monitoraggioCautelare_Input">
       	<sequence>
    	   	<element name="IDRichiestaOLO" type="string"/>
            <element name="TipoOperazione" type="ecm:TipoOperazioneType1"/>
            <element name="idAnagCaus" type="int"/>
            <element name="codCausInternoNew" type="string" minOccurs="0"/>
            <element name="descrCausInternoNew" type="string" minOccurs="0"/>
            <element name="TMSTP_AggRichOLO" type="dateTime"/>
            <element name="TipologiaLavorazione" type="string" minOccurs="0"/>
            <element name="Offerta" type="string" minOccurs="0"/>
            <element name="EsitoVerifica" type="string"/>
            <element name="IdLavorazioneHD" type="int" minOccurs="0"/>
        </sequence>
     </complexType>
     <element name="MonitoraggioCautelare_v1_Response" type="ecm:monitoraggioCautelare_Output"/>
     <complexType name="monitoraggioCautelare_Output">
     	<sequence>
        	<element name="Esito" minOccurs="0">
            	<complexType>
            		<sequence>
                		<element name="Codice" type="string" minOccurs="0"/>
                		<element name="DescrizioneErrore" type="string" minOccurs="0"/>
            			<element name="IdLavorazioneHD" type="int" minOccurs="0"/>
             		</sequence>
           		</complexType>
			</element>
		</sequence>
	</complexType>

	<complexType name="storicizzaLavorazioneManualeInput">
		<sequence>
			<element name="ID_RchiestaOLO" type="string"/>
			<element name="TipoOperazione" type="ecm:TipoOperazioneType1"/>
			<element name="IDAnagCaus" type="int"/>
			<element name="Lavorazione" type="string"/>
			<element name="CodOLO" type="string"/>
			<element name="EsitoVerifica" type="string"/>
			<element name="CausaleErrore" type="string" minOccurs="0"/>
			<element name="TipoAzione" type="string" minOccurs="0"/>
			<element name="Operatore" type="string" minOccurs="0"/>
			<element name="IDRisorsa" type="string" minOccurs="0"/>
			<element name="CodificaOLONow" type="string" minOccurs="0"/>
			<element name="IDOfferta" type="int" minOccurs="0"/>
			<element name="NoteElaborazione" minOccurs="0">
				<simpleType>
					<restriction base="string">
						<maxLength value="150"/>
					</restriction>
				</simpleType>
			</element>
			<element name="Offerta" type="string" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="storicizzaLavorazioneManualeOutput">
		<sequence>
			<element name="Codice" type="string" minOccurs="0"/>
			<element name="DescrizioneErrore" type="string" minOccurs="0"/>
		</sequence>
	</complexType>
	<element name="StoricizzaLavorazioneManuale" type="ecm:storicizzaLavorazioneManualeInput"/>
	<element name="StoricizzaLavorazioneManualeResponse" type="ecm:storicizzaLavorazioneManualeOutput"/>
	<simpleType name="TipoOperazioneType1">
		<restriction base="string">
			<enumeration value="INSERT"/>
			<enumeration value="UPDATE"/>
		</restriction>
	</simpleType>
	
	<element name="RiscontroCodSessioneKO_Request" type="ecm:RiscontroCodSessioneInput" />
	<element name="RiscontroCodSessioneKO_Response" type="ecm:RiscontroCodSessioneOutput" />
	<complexType name="RiscontroCodSessioneInput">
		<sequence>
			<element minOccurs="1" type="string" name="IdRichiestaOlo" />
			<element minOccurs="1" type="string" name="CodiceScartoDonating" />
			<element minOccurs="1" type="string" name="AmbitoServizioDonating" />
			<element minOccurs="1" type="string" name="AmbitoServizioRrecipient" />
		</sequence>	
	</complexType>
	<complexType name="RiscontroCodSessioneOutput">
		<sequence>
			<element minOccurs="1" type="int" name="IdAanagraficaCausale" />
			<element minOccurs="1" type="int" name="IdAanagraficaCausaleDonating" />
		</sequence>
	</complexType>

	<element name="TrascodificaCodiceCausaleOlo"
		type="ecm:trascodificaCodiceCausaleOloInput">
	</element>

	<complexType name="trascodificaCodiceCausaleOloInput">
		<sequence>
            <element name="IdRichiestaOlo" type="string" maxOccurs="1" minOccurs="0"></element>
            <element name="CodiceCausaleOlo" type="string"></element>
		</sequence>
	</complexType>

	<element name="TrascodificaCausaleOloResponse"
		type="ecm:trascodificaCodiceCausaleOloOutput">
	</element>

	<complexType name="trascodificaCodiceCausaleOloOutput">
		<sequence>
			<element name="IdAnagraficaCausale" type="int"></element>
		</sequence>
	</complexType>
</schema>