<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://telecomitalia.it/Recharge/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://telecomitalia.it/Recharge/" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1">
	<import schemaLocation="../CaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"></import>

	<element name="Request">
		<complexType>
			<sequence>
				<element name="Richiesta" type="pref:Richiesta">
				</element>
				<element name="AssetRicarica" maxOccurs="1"
					minOccurs="0" type="pref:AssetRicarica">
				</element>
				<element name="BusinessID" type="string"></element>
			</sequence>
		</complexType>
	</element>

	<element name="Response">
		<complexType>
			<sequence>
				<element name="Esito" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>

	<element name="Fault">
		<complexType>
			<sequence>
				<element name="Code" type="string"></element>
				<element name="Msg" type="string"></element>
			</sequence>
		</complexType>
	</element>
</schema>