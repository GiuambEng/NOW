<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns="http://www.tim.com/NOW/xsd/ServiceTimedRequest" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/ServiceTimedRequest">


	<import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../CaseData/it.telecomitalia.it.NOW.casedata.xsd"/>
	<complexType name="GestioneSospesoAppuntamento">
		<sequence>
			<element maxOccurs="1" minOccurs="1" name="IdirichiestaOLO" type="string"/>
			<element maxOccurs="1" minOccurs="1" name="Scadenza" type="dateTime"/>
			<element maxOccurs="1" minOccurs="0" name="FLAG_ANNULLAMENTO_TIMER" type="string"/>

		</sequence>
	</complexType>

	<complexType name="GestioneSospesoAppuntamentoResponse">
		<sequence>
			<element maxOccurs="1" minOccurs="1" name="Esito">
				<simpleType>
					<restriction base="string">
						<enumeration value="OK"/>
					</restriction>
				</simpleType>
			</element>
		</sequence>
	</complexType>

	<complexType name="GestioneAppuntamentoFault">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="FaultCode" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="FaultMessage" type="string"/>
		</sequence>
	</complexType>
	
	    <complexType name="CreateRequestRicarica">
    <sequence>
    	<element maxOccurs="1" minOccurs="0" name="AssetRicarica"
    		type="pref:AssetRicarica" />
    	<element maxOccurs="1" minOccurs="0" name="ProcessID"
    		type="string" />

    	<element name="IDAssetRicarica" type="integer" maxOccurs="1"
    		minOccurs="0" />
    	<element name="CanaleRichiesta" type="string" maxOccurs="1"
    		minOccurs="0">
    	</element>
    	<element name="FlagAccensione" type="boolean" maxOccurs="1"
    		minOccurs="0">
    	</element>
    	<element name="FlagScheduler" type="boolean" maxOccurs="1" minOccurs="0"></element>
    </sequence>
	    </complexType>
       
           <complexType name="CreateRequestRicaricaResponse">
    <sequence>
			
			<element maxOccurs="1" minOccurs="0" name="Esito" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="IDRichiestaOLO" type="string"/>
            <element maxOccurs="1" minOccurs="0" name="ControlloFault" type="boolean"/>
		</sequence>
    
    </complexType>
    
    <complexType name="CreateRequestRicaricaFault">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="FaultCode" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="FaultMessage" type="string"/>
		</sequence>
	</complexType>
	
		<complexType name="StoricoRichiestaRicarica">
		<sequence>
			<element name="IDRichOLO" type="string" maxOccurs="1" minOccurs="1"></element>
			<element name="IDAssetRicarica" type="string" maxOccurs="unbounded" minOccurs="1"></element>
		</sequence>
	</complexType>

	<complexType name="StoricoRichiestaRicaricaResponse">
		<sequence>
			<element name="EsitoInserimento" type="string"></element>
		</sequence>
	</complexType>

    <complexType name="StoricoRichiestaRicaricaFault">
    
    <sequence>
			<element maxOccurs="1" minOccurs="0" name="FaultCode" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="FaultMessage" type="string"/>
		</sequence>
    
    
    </complexType>
	
	<element name="operationRequest">
		<complexType>
			<sequence>
			<element name="in" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="operationResponse">
		<complexType>
			<sequence>
				<element name="out" type="string"/>
			</sequence>
		</complexType>
	</element>


</schema>
