<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
	targetNamespace="http://www.tim.com/NOW/xsd/NOWtoCRMWS_GetConsistenzaReg"
	elementFormDefault="qualified"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWS_GetConsistenzaReg"
	xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1"
	xmlns:pref1="http://www.tim.com/NOW/xsd/CRMWSNumberPortability/">
	<xsd:import
		schemaLocation="../CaseData/it.telecomitalia.it.NOW.casedata.xsd"
		namespace="http://NOW.it.telecomitalia.it/casedata_v1">
	</xsd:import>
	<xsd:import schemaLocation="CRMWSNumberPortability.xsd" namespace="http://www.tim.com/NOW/xsd/CRMWSNumberPortability/"></xsd:import>
	<xsd:element name="REQUEST">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="SERVIZIO" type="tns:servizioType"></xsd:element>
				<xsd:element name="LAVORAZIONE"
					type="pref:LavorazioneEnumeration">
				</xsd:element>

				<xsd:element name="ORDINE" type="pref:Asset"></xsd:element>
				<xsd:element name="DATIORDINE">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="DAC" type="xsd:date"
								maxOccurs="1" minOccurs="0" />
							<xsd:element name="cognomeRagioneSociale"
								maxOccurs="1" minOccurs="0">
								<xsd:simpleType>
									<xsd:restriction
										base="xsd:string">
										<xsd:maxLength value="50"></xsd:maxLength>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="nome" maxOccurs="1"
								minOccurs="0">
								<xsd:simpleType>
									<xsd:restriction
										base="xsd:string">
										<xsd:maxLength value="50"></xsd:maxLength>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="CF" maxOccurs="1"
								minOccurs="0">
								<xsd:simpleType>
									<xsd:restriction
										base="xsd:string">
										<xsd:maxLength value="50"></xsd:maxLength>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="PIVA" maxOccurs="1"
								minOccurs="0">
								<xsd:simpleType>
									<xsd:restriction
										base="xsd:string">
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="NumeriAggiuntivi"
					type="pref1:AssetAggiuntiviComplexType" maxOccurs="unbounded" minOccurs="0">
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="RESPONSE">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="RESPONSE" type="tns:responseType"></xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="RESPONSE_NP">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="RESPONSE_NP" type="tns:responseType" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="servizioType">
		<xsd:sequence>
			<xsd:element name="CODICE_OLO">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:length value="3"></xsd:length>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="DESCOLO">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="3"></xsd:maxLength>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="responseType">
		<xsd:sequence>
			<xsd:element name="TRANSACTION_ID">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="50"></xsd:maxLength>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="RESPONSE_DATE" type="xsd:dateTime"></xsd:element>
			<xsd:element name="RETURN_CODE">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="2"></xsd:maxLength>
						<xsd:enumeration value="OK"></xsd:enumeration>
						<xsd:enumeration value="KO"></xsd:enumeration>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="DESCRIZIONE_ERRORE" maxOccurs="1" minOccurs="0">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="150"></xsd:maxLength>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>



	<xsd:simpleType name="dateType">
		<xsd:restriction base="xsd:dateTime">
			<xsd:pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"></xsd:pattern>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:element name="FAULT">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Codice_Errore" type="xsd:string"
					maxOccurs="1" minOccurs="0">
				</xsd:element>
				<xsd:element name="Messaggio_Errore" type="xsd:string"
					maxOccurs="1" minOccurs="0">
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>