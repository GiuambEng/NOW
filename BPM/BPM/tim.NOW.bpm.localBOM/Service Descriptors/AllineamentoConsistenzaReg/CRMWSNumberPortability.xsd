<?xml version="1.0" encoding="UTF-8"?>
<schema
	targetNamespace="http://www.tim.com/NOW/xsd/CRMWSNumberPortability/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/CRMWSNumberPortability/" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1">

	<import schemaLocation="../CaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"></import>
	<element name="NumberPortability">
		<complexType>
			<sequence>
				<element name="AssetAggiuntivi" maxOccurs="unbounded"
					minOccurs="0" type="tns:AssetAggiuntiviComplexType">
				</element>
			</sequence>
		</complexType>
	</element>


    <complexType name="codificaOLOAGCOMDonatingNewType"></complexType>

    <simpleType name="codificaOLOAGCOMNewType">
    	<restriction base="string">
    		<maxLength value="50"></maxLength>
    	</restriction>
    </simpleType>
    <complexType name="AssetAggiuntiviComplexType">
    	<sequence>
    		<element minOccurs="0" maxOccurs="1" name="NumeroTelefonico"
    			type="string" />
    		<element minOccurs="0" maxOccurs="1" name="IDAsset"
    			type="integer" />
    		<element name="IDContratto" type="int" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="CodiceOrdineOLO" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="CodiceOrdineTI" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="IDRisorsa" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="IDAssetCRMWS" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="DES" type="date" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Distretto" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="CodificaOLOAgicomDonating" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="NumeroTelefonicoPrincipale" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="Nome" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="CF" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="cognomeragsociale" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="PartitaIVA" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element minOccurs="0" maxOccurs="1"
    			name="NUMBERPORTABILITY">
    			<complexType>
    				<sequence>
    					<element minOccurs="0" maxOccurs="1"
    						name="AttributiNumeriAggiunti"
    						type="tns:attributiNumeriAggiunti" />
    				</sequence>
    			</complexType>
    		</element>
    		<element name="Offerta" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="IDRichOLO" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="CodificaOLOAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    <complexType name="attributiNumeriAggiunti">
		<sequence>
			<element minOccurs="0" maxOccurs="1" name="PRINCIPALE"
				type="string" />
			<element minOccurs="0" maxOccurs="1" name="RADICALE"
				type="string" />
			<element minOccurs="0" maxOccurs="1" name="TIPOLINEANP"
				type="string" />
			<element minOccurs="0" maxOccurs="1" name="ROUTINGNUMBER"
				type="string" />
			<element name="TOTALEAGGIUNTIVI" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="TOTALELINEE" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="TIPOSERVIZIO" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="PIATTAFORME" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="TIPONUMERO" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="OLORETAILER" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="CODICERO" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="CAPOSERIE" type="string" maxOccurs="1" minOccurs="0"></element>
		</sequence>
    </complexType>
    
</schema>