<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/DatiVerificaControlli" xmlns:tns="http://www.tim.com/NOW/xsd/DatiVerificaControlli" elementFormDefault="qualified">
    <element name="DatiVerificaControlliInput">
    	<complexType>
    		<sequence>
    			<element name="Operatore" type="string" maxOccurs="1" minOccurs="1" />
    			<element name="IDRichiestaOLO" type="string" maxOccurs="1" minOccurs="1" />
    			<element name="Note" type="string" maxOccurs="1" minOccurs="0" />
    			<element name="Azione" type="tns:azione" maxOccurs="1" minOccurs="1" />
    			<element name="DatoRichiesta" type="tns:DatoRichiesta" maxOccurs="1" minOccurs="0"/>
    			<element name="DatoRichiestaNP" type="tns:DatoRichiestaNP" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
    				<complexType name="DatoRichiesta">
    					<sequence>
    						<element name="IDCodiceProgetto"
    							type="string" maxOccurs="1" minOccurs="0" />
    						<element name="IDContratto" type="string"
    							maxOccurs="1" minOccurs="0" />
    						<element name="FlagOLODiffidato"
    							type="string" maxOccurs="1" minOccurs="0" />
    						<element name="IDIDULLCO" type="string"
    							maxOccurs="1" minOccurs="0" />
    						<element name="IDIDSLUCO" type="string"
    							maxOccurs="1" minOccurs="0" />
    						<element name="CODICE_TOPONOMASTICA"
    							type="string" maxOccurs="1" minOccurs="0" />
    						<element name="TIPOTRASPORTO" type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="TRASPORTO" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="FLAGNUOVOMODELLO"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>						
    				</complexType>
 
    <element name="DatiVerificaControlliOutput">
    	<complexType>
    		<sequence>
    			<element name="Response" type="string" maxOccurs="1" minOccurs="1" />
    		</sequence>
    	</complexType>
    </element>
    <element name="DativerificaControlliFault">
    	<complexType>
    		<sequence>
    			<element name="MSGError" type="string" />
    			<element name="CODError" type="string" />
    		</sequence>
    	</complexType>
    </element>
    
    <simpleType name="azione">
   		<restriction base="string">
    		<enumeration value="INSERT"/>
	    	<enumeration value="DELETE"/>
	    </restriction>
    </simpleType>

    <complexType name="DatoRichiestaNP">
    	<sequence>
    		<element name="NUMEROTELEFONICO_AGG_UNI" type="string"
    			minOccurs="0" maxOccurs="7">
    		</element>
    		<element name="STATO" type="string" minOccurs="0"
    			maxOccurs="7">
    		</element>
    		<element name="DISTRETTO_AGG_UNI" type="string"
    			minOccurs="0" maxOccurs="1">
    		</element>
    		<element name="NUMEROTELEFONICOPRINCIPALE_AGG_UNI"
    			type="string" minOccurs="0" maxOccurs="1">
    		</element>
    		<element name="TIPOLOGIALAVORAZIONENOW" type="string"
    			minOccurs="0" maxOccurs="1">
    		</element>
    		<element name="TIPOLOGIALAVORAZIONECRM" type="string"
    			minOccurs="0" maxOccurs="1">
    		</element>
    		<element name="TIPONUMERO" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="TOTALEAGGIUNTIVI" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
            <element name="DISTRETTO_DATI_UNI" type="string" maxOccurs="1" minOccurs="0"></element>
            <element name="TIPOSERVIZIO" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
            <element name="NUMEROTELEFONICOPRINCIPALE_DATI_UNI" type="string" maxOccurs="1" minOccurs="0"></element>
            <element name="NUMEROTELEFONICO_DATI_UNI" type="string" maxOccurs="7" minOccurs="0"></element>
            <element name="RADICALE" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="CAPOSERIE" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="CODICE_RO" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="TOTALELINEE" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="FLAGATTIVO" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="CODICEOPERATOREDONATING" type="string"
    			minOccurs="0" maxOccurs="1">
    		</element>
    		<element name="FLAGTP" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="FLAGNUMERAZIONESERVIZIO" type="string"
    			minOccurs="0" maxOccurs="1">
    		</element>
    	</sequence>
    </complexType>
</schema>