<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://www.tim.com/NOW/xsd/GenerateHashingCliente/"
	elementFormDefault="unqualified" xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/GenerateHashingCliente/" >
	
	<xs:element name="GenerateHashingClienteRequest" type="tns:RequestType" />
	<xs:complexType name="RequestType">
		<xs:sequence>
				<xs:element minOccurs="0" type="xs:string" name="IDRichiestaOLO" />
				<xs:element minOccurs="0" type="xs:string" name="CanaleRichiesta" />
				<xs:element minOccurs="0" type="xs:string" name="CodiceOrdineOLO" />
				<xs:element minOccurs="0" type="xs:string" name="CodificaOLOAGCOM" />
                <xs:element minOccurs="0" type="xs:string" name="CognomeRagioneSociale" />
                <xs:element minOccurs="0" type="xs:string" name="Nome" />
				<xs:element minOccurs="0" type="xs:string" name="CF" />
                <xs:element minOccurs="0" type="xs:string" name="PIVA" />
                <xs:element minOccurs="0" type="xs:string" name="GenericParam" />
		</xs:sequence>
	</xs:complexType>
	
	<xs:element name="GenerateHashingClienteResponse" type="tns:ResponseType" />
	<xs:complexType name="ResponseType">
		<xs:sequence>
				<xs:element minOccurs="1" type="xs:boolean" name="Codice" />
                <xs:element minOccurs="1" type="xs:string" name="Esito" />
		</xs:sequence>
	</xs:complexType>
    
    
    <xs:element name="GenerateHashingClienteFault" type="tns:FaultType" />
    <xs:complexType name="FaultType">
		<xs:sequence>
		    <xs:element maxOccurs="1" minOccurs="1" type="xs:string" name="CodeMsg" />
			<xs:element maxOccurs="1" minOccurs="1" type="xs:string" name="ErrorMsg" />         
		</xs:sequence>
	</xs:complexType>

</xs:schema>