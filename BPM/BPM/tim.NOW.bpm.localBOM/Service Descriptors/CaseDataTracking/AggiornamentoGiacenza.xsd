						<restriction base="string">
							<maxLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="STATO_RICH_OLO" type="string"/>
				<element minOccurs="0" name="ID_OFFERTA" type="int"/>
