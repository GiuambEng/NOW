	</complexType>
	<complexType name="Aggiornamento_Giacenza_Fault">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="Codice_Errore" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="Msg_Errore" type="string"/>
