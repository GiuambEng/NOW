					<simpleType>
						<restriction base="string">
							<maxLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="STATO_RICH_NOW" type="string"/>
				<element minOccurs="0" name="COD_ORDN_OLO" type="string"/>
				<element minOccurs="0" name="CATEGORIA_REPORT_AGCOM" type="string"/>
				<element minOccurs="0" name="ID_ANAG_CAUS" type="int"/>
			</sequence>
		</complexType>
	</element>
</schema>