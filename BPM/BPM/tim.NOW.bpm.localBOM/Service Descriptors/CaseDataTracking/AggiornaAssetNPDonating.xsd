<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://www.tim.com/NOW/xsd/AggiornaAssetNPDonating/"
	elementFormDefault="unqualified" xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/AggiornaAssetNPDonating/" >
	
	<xs:element name="AggiornaAssetNPDonatingRequest" type="tns:RequestType" />
	<xs:complexType name="RequestType">
		<xs:sequence>
                <xs:element minOccurs="1" maxOccurs="unbounded" type="xs:integer" name="IdAsset" />
		</xs:sequence>
	</xs:complexType>
	
	<xs:element name="AggiornaAssetNPDonatingResponse" type="tns:ResponseType" />
	<xs:complexType name="ResponseType">
		<xs:sequence>
				<xs:element minOccurs="1" type="xs:boolean" name="Codice" />
                <xs:element minOccurs="1" type="xs:string" name="Esito" />
		</xs:sequence>
	</xs:complexType>
    
    
    <xs:element name="AggiornaAssetNPDonatingFault" type="tns:FaultType" />
    <xs:complexType name="FaultType">
		<xs:sequence>
		    <xs:element maxOccurs="1" minOccurs="1" type="xs:string" name="CodeMsg" />
			<xs:element maxOccurs="1" minOccurs="1" type="xs:string" name="ErrorMsg" />         
		</xs:sequence>
	</xs:complexType>

</xs:schema>