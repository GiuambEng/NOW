<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/GestionePacchetti/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/GestionePacchetti/">
	<element name="VerificaEsistenzaPacchettoInput">
		<complexType>
			<sequence>
				<element name="CodificaOLOAGCOM" type="string"></element>
				<element name="IDCorrelazione" type="string"></element>
				<element name="TipoPacchetto" type="string"></element>
				<element name="TotaleRichiesteDichiarate"
					type="int">
				</element>
				<element name="IDRichiestaOLO" type="string"></element>
			</sequence>
		</complexType>
	</element>
	<element name="VerificaEsistenzaPacchettoOutput">
		<complexType>
			<sequence>
				<element name="IDPacchettoNOW" type="string"></element>
				<element name="FlagPrimaRichiesta" type="boolean"></element>
			</sequence>
		</complexType>
	</element>
	<element name="VerificaEsistenzaPacchettoFault">
		<complexType>
			<sequence>
				<element name="Msg" type="string"></element> 
				<element name="Code" type="string"></element>
			</sequence>
		</complexType>
	</element>
	<element name="RecuperaParametriConfigurazioneNOWInput">
		<complexType>
			<sequence>
				<element name="Chiave" type="string"></element>
				<element name="IDRichiestaOLO" type="string"></element>
			</sequence>
		</complexType>
	</element>
	<element name="RecuperaParametriConfigurazioneNOWOutput">
		<complexType>
			<choice>
				<element name="ValoreStringa" type="string"></element>
				<element name="ValoreNumerico" type="int"></element>
			</choice>
		</complexType>
	</element>
	<element name="RecuperaParametriConfigurazioneNOWFault">
		<complexType>
			<sequence>
				<element name="Msg" type="string"></element>
				<element name="Code" type="string"></element>
			</sequence>
		</complexType>
	</element>
	<element name="AggiornaPacchettoInput">
		<complexType>
			<sequence>
				<element name="IDPacchettoNOW" type="string"></element>
                <element name="Stato" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="TimestampChiusura" type="dateTime" maxOccurs="1" minOccurs="0"></element>
                <element name="IDRichiestaOLO" type="string"></element>
			</sequence>
		</complexType>
	</element>
	<element name="AggiornaPacchettoOutput">
		<complexType>
			<sequence>
				<element name="Esito" type="string"></element>
			</sequence>
		</complexType>
	</element>
	<element name="AggiornaPacchettoFault">
		<complexType>
			<sequence>
				<element name="Msg" type="string"></element>
				<element name="Code" type="string"></element>
			</sequence>
		</complexType>
	</element>
	
	<element name="AggiornaPacchettoSingleRichInput">
		<complexType>
			<sequence>
                <element type="string" minOccurs="0" maxOccurs="1" name="IDRichiestaOLO" />
                <element type="string" minOccurs="0" maxOccurs="1" name="StatoPacchettoSingleRich" />
			</sequence>
		</complexType>
	</element>
	<element name="AggiornaPacchettoSingleRichOutput">
		<complexType>
			<sequence>
				<element type="string" name="Esito" />
			</sequence>
		</complexType>
	</element>
		<element name="AggiornaPacchettoSingleRichFault">
		<complexType>
			<sequence>
				<element type="string" name="Msg" />
				<element type="string" name="Code" />
			</sequence>
		</complexType>
	</element>
</schema>