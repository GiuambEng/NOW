<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:xdtu="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:sm="http://www.tim.com/NOW/xsd/StateMachine/" xmlns:cd="http://NOW.it.telecomitalia.it/casedata_v1" targetNamespace="http://www.tim.com/NOW/xsd/StateMachine/" elementFormDefault="qualified">
	<import schemaLocation="../CaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"/>
	<import namespace="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" schemaLocation="../DTU/Tracciati_Richiesta_Notifica_NOW_DTU.xsd" />
	<element name="ValidateDTUEventRequest">
		<complexType>
			<sequence>
				<element name="IdRichiesta" type="string"/>
				<element name="Evento" type="string"/>
				<element name="CodiceEsito" type="string"/>
				<element name="CausaleEsito" type="string"/>
				<element name="Offerta" type="cd:OffertaEnumeration"/>
				<element name="Lavorazione" type="cd:LavorazioneEnumeration"/>
				<element name="StatoRichiestaNow" type="cd:StatoNOWEnumeration"/>
				<element name="StatoRichiestaPrecNow" type="cd:StatoNOWEnumeration"/>
				<element name="StatoRichiestaOlo" type="cd:StatoOLOEnumeration"/>
				<element name="Scenario" type="cd:TipologiaScenarioEnumeration" minOccurs="0"/>
				<element name="AnnullamentoAutomatico" type="boolean" minOccurs="0"/>
				<element name="FlagOpereSpeciali" type="sm:FlagOpereSpecialiType" minOccurs="0"/>
				<element name="FlagDisaggregazione" type="string" minOccurs="0"/>
				<element name="GestioneAutonoma" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AssociativaCausaliDTURequest">
		<complexType>
			<sequence>
				<element name="IdRichiesta" type="string"/>
				<element name="Evento" type="string"/>
				<element name="CausaleEsito" type="string"/>
				<element name="CodiceMacchinaStatiDTU" type="string"/>
				<element name="IdTipologiaEsitoDTU" type="int"/>
				<element name="IdAnagraficaCausalePrec" type="int" minOccurs="0"/>
				<element name="StatoRichiestaNOWprec" type="cd:StatoNOWEnumeration"/> <!-- SM_7387 in precedenza: StatoOLOEnumeration -->
				<element name="FonteAnnullamento" type="string" minOccurs="0"/>
				<element name="Lavorazione" type="string" minOccurs="0"/>
				<element name="Offerta" type="string" minOccurs="0"/>
				<element name="GestioneAutonoma" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AssociativaCausaliDTUResponse">
		<complexType>
			<sequence>
				<element ref="sm:RecordAssociativa" minOccurs="0" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	<element name="RecordAssociativa">
		<complexType>
			<sequence>
				<element name="IdAnagraficaCausale" type="int"/>
				<element name="IdAnagraficaCausaleOpereSpeciali" type="int"/>
			</sequence>
		</complexType>
	</element>
	<element name="ValidateDTUEventResponse">
		<complexType>
			<sequence>
				<element name="CausaleEsitoACK" type="sm:CausaleEsitoType"/>
				<element name="DescrizioneErrore" type="string" minOccurs="0"/>
				<element name="StatoSuccessivo" type="string" minOccurs="0"/>
				<element name="FlagAltroOperatore" type="string" minOccurs="0" />
				<element name="Notifica" type="sm:NotificaType" minOccurs="0" maxOccurs="unbounded"/>
				<element ref="sm:Error" minOccurs="0"/>
				<element name="FLAG_ARRICCHIMENTO" type="boolean" minOccurs="0" />
			</sequence>
		</complexType>
	</element>
	<element name="ValidateDTUEventFault">
		<complexType>
			<sequence>
				<element name="CausaleEsito" type="string"/>
				<element name="DescrizioneErrore" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="StateMachineValidationRequest">
		<complexType>
			<sequence>
				<element name="IdRichiesta" type="string"/>
				<element name="IdEventoOrdnNowWhls" type="int"/>
				<element ref="xdtu:EVENTO_NOTIFICA" minOccurs="0"/>
				<element name="Offerta" type="cd:OffertaEnumeration"/>
				<element name="Lavorazione" type="cd:LavorazioneEnumeration"/>
				<element name="StatoRichiestaNow" type="cd:StatoNOWEnumeration"/>
				<element name="StatoRichiestaPrecNow" type="cd:StatoNOWEnumeration"/>
				<element name="StatoRichiestaOlo" type="cd:StatoOLOEnumeration"/>
				<element name="CodProcsoNoFile" type="string"/>
				<element name="IdEsecProcsoNoFile" type="int"/>
				<element name="Scenario" type="cd:TipologiaScenarioEnumeration" minOccurs="0"/>
				<element name="AnnullamentoAutomatico" type="boolean" minOccurs="0"/>
				<element name="DataSospensione" type="string" minOccurs="0"/>
				<element name="IDPreventivo" type="int" minOccurs="0" />
				<element name="FlagOpereSpeciali" type="sm:FlagOpereSpecialiType" minOccurs="0"/>
				<element name="OffertaDonating" type="cd:OffertaEnumeration" minOccurs="0"/>
				<element name="FlagDisaggregazione" type="string" minOccurs="0"/>
				<element name="GestioneAutonoma" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="StateMachineValidationResponse">
		<complexType>
			<sequence>
				<element name="ID_RICHIESTA" type="string"/>
				<element name="ESITO_VALIDAZIONE" type="sm:EsitoValidazioneType"/>
				<element name="STATO_SUCCESSIVO" type="string"	minOccurs="0"/>
				<element name="FLAG_ALTRO_OPERATORE" type="string" minOccurs="0" />
				<element name="NOTIFICA" type="sm:NotificaType" minOccurs="0" maxOccurs="unbounded"/>
				<element name="ARRICCHIMENTI" type="sm:ArricchimentoType" minOccurs="0" maxOccurs="unbounded"/>
				<element name="IDPreventivo" type="int" minOccurs="0" maxOccurs="1" />
				<element name="IDConsuntivo" type="int" minOccurs="0" maxOccurs="1" />
				<element ref="xdtu:EVENTO_NOTIFICA" minOccurs="0"/>
				<element name="FLAG_ARRICCHIMENTO" type="boolean" minOccurs="0" />
			</sequence>
		</complexType>
	</element>
	<element name="StateMachineValidationFault">
		<complexType>
			<sequence>
				<element name="CausaleEsito" type="string"/>
				<element name="DescrizioneErrore" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="Error">
		<complexType>
			<sequence>
				<element name="CodiceErrore" type="string"/>
				<element name="DescrizioneErrore" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="StateMachineValidation_Request">
		<complexType>
			<sequence>
				<element name="IdRichiesta" type="string"/>
				<element name="IdEventoOrdnNowWhls" type="int"/>
				<element ref="xdtu:EVENTO_NOTIFICA"/>
				<element name="Offerta" type="cd:OffertaEnumeration"/>
				<element name="Lavorazione" type="cd:LavorazioneEnumeration"/>
				<element name="StatoRichiestaNow" type="cd:StatoNOWEnumeration"/>
				<element name="StatoRichiestaPrecNow" type="cd:StatoNOWEnumeration"/>
				<element name="StatoRichiestaOlo" type="cd:StatoOLOEnumeration"/>
				<element name="CodProcsoNoFile" type="string"/>
				<element name="IdEsecProcsoNoFile" type="int"/>
				<element name="Scenario" type="cd:TipologiaScenarioEnumeration" minOccurs="0"/>
				<element name="AnnullamentoAutomatico" type="boolean" minOccurs="0"/>
				<element name="DataSospensione" type="string" minOccurs="0"/>
				<element name="IDPreventivo" type="int" minOccurs="0" />
			</sequence>
		</complexType>
	</element>
	<element name="StateMachineValidation_Response">
		<complexType>
			<sequence>
				<element name="ID_RICHIESTA" type="string"/>
				<element name="ESITO_VALIDAZIONE" type="sm:EsitoValidazioneType"/>
				<element name="STATO_SUCCESSIVO" type="string"	minOccurs="0"/>
				<element name="FLAG_ALTRO_OPERATORE" type="string" minOccurs="0" />
				<element name="NOTIFICA" type="sm:NotificaType" minOccurs="0" maxOccurs="unbounded"/>
				<element name="ARRICCHIMENTI" type="sm:ArricchimentoType" minOccurs="0" maxOccurs="unbounded"/>
				<element name="FLAG_ARRICCHIMENTO" type="boolean" minOccurs="0" />
			</sequence>
		</complexType>
	</element>
	<element name="Notifiche">
		<complexType>
			<sequence>
				<element name="Notifica" type="sm:NotificaType" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	<element name="QueryMacchinaStati_Response">
		<complexType>
			<sequence>
				<element name="QueryMacchinaStatiResponse" type="sm:QueryMacchinaStatiType" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	<complexType name="NotificaType">
		<sequence>
			<element name="CODICE_CAUSALE_NOW" type="string" minOccurs="0"/>
			<element name="ID_ANAGRAFICA_CAUSALE" type="int" minOccurs="0"/>
			<element name="ID_NOTIFICA_RECIPIENT" type="string" minOccurs="0"/>
			<element name="ID_NOTIFICA_DONATING" type="string" minOccurs="0"/>
			<element name="ID_NOTIFICA_DONOR" type="string"	minOccurs="0"/>
			<element name="COMPONENTE_DONATING" type="string" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="ArricchimentoType">
		<choice>
			<element ref="cd:DettaglioOrdineElement" maxOccurs="unbounded" />
			<element ref="cd:SedeElement"/>
			<element ref="cd:ReferenteElement"/>
			<element ref="cd:DettaglioAssetElement"/>
		</choice>
	</complexType>
	<complexType name="QueryMacchinaStatiType">
		<sequence>
				<element name="COD_TIPOLG_NOTF_RECIPIENT" type="string" minOccurs="0" />
				<element name="COD_TIPOLG_NOTF_DONATING" type="string"	minOccurs="0"/>
				<element name="COD_TIPOLG_NOTF_DONOR" type="string" minOccurs="0" />
				<element name="COD_TIPOLG_NOTF_DPP_DONATING" type="string" minOccurs="0" />
				<element name="STATO_RICH_NOW" type="string" minOccurs="0" />
				<element name="IDTPLG_ESITO_DTU" type="int" minOccurs="0" />
				<element name="COD_MACCHINA_A_STATI_DTU" type="string" minOccurs="0" />
				<element name="COMPONENTE_DONATING" type="string" minOccurs="0" />
				<element name="COMPONENTE_DPP_DONATING" type="string" minOccurs="0" />
				<element name="FLAG_ALTRO_OPERATORE" type="string" minOccurs="0" />
				<element name="COMP_DONATING_CPS" type="string" minOccurs="0" />
				<element name="COD_TIPO_NOTF_DONOR_CPS" type="string" minOccurs="0" />
		</sequence>
	</complexType>
	<simpleType name="FlagOpereSpecialiType">
		<restriction base="string">
			<length value="1"/>
			<enumeration value="S"/>
			<enumeration value="N"/>
		</restriction>
	</simpleType>
	<simpleType name="CausaleEsitoType">
		<restriction base="string">
			<length value="3"/>
			<enumeration value="000"/> <!-- OK -->
			<enumeration value="003"/> <!-- Fuori Sequenza -->
		</restriction>
	</simpleType>
	<simpleType name="EsitoValidazioneType">
		<restriction base="string">
			<enumeration value="OK"/>
			<enumeration value="KO"/>
		</restriction>
	</simpleType>
</schema>