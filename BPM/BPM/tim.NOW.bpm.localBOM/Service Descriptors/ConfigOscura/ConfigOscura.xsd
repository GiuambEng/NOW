<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xs:schema xmlns:tns="http://www.tim.com/NOW/xsd/ConfigOscura/" xmlns:xs="http://www.w3.org/2001/XMLSchema" 
	elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/ConfigOscura/">
	
	<xs:element name="ConfigOscuraFunzione_Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" type="xs:string" name="IdRichiestaOlo" />
				<xs:element minOccurs="1" type="xs:string" name="NomeFunzione" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ConfigOscura_Output">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" type="xs:boolean" name="Abilitato" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="ConfigTrasformIndotte_Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" type="xs:string" name="IdRichiestaOlo" />
				<xs:element minOccurs="1" type="xs:string" name="CodTrasformazione" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="RecuperaScenarioBPM_Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="1" type="xs:string" name="IdRichiestaOlo" />
				<xs:element minOccurs="1" maxOccurs="1" type="xs:string" name="Scenario" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RecuperaScenarioBPM_Ouput">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" maxOccurs="1" type="xs:string" name="ScenarioBPM" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="RecuperaCodiceOLONumerico_Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="1" type="xs:string" name="IdRichiestaOlo" />
				<xs:element minOccurs="1" maxOccurs="1" type="xs:string" name="CodificaOLOAgcom" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RecuperaCodiceOLONumerico_Ouput">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" maxOccurs="1" type="xs:string" name="CodiceOLONumerico" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="ConfigOscura_Fault">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Codice_Errore" type="xs:string"/>
				<xs:element minOccurs="0" name="Msg_Errore" type="xs:string"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>