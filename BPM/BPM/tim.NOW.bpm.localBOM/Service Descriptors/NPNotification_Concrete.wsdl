<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:ns="http://www.tim.com/NOW/wsdl/concrete/NPNotification/" xmlns:ns0="http://telecomitalia.it/NPNotification/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="NPNotificationPortType" targetNamespace="http://www.tim.com/NOW/wsdl/concrete/NPNotification/">
	<wsdl:import namespace="http://telecomitalia.it/NPNotification/" location="ESB/NPNotification.xsd"/>
	<wsdl:message name="NPNotificationRequest">
		<wsdl:part name="Request" element="ns0:Request"/>
	</wsdl:message>
	<wsdl:message name="NPNotificationResponse">
		<wsdl:part name="Response" element="ns0:Response"/>
	</wsdl:message>
	<wsdl:message name="NPNotificationFault">
		<wsdl:part name="Fault" element="ns0:Fault"/>
	</wsdl:message>
	<wsdl:portType name="NPNotificationPortType">
		<wsdl:operation name="NPNotification">
			<wsdl:input message="ns:NPNotificationRequest"/>
			<wsdl:output message="ns:NPNotificationResponse"/>
			<wsdl:fault name="fault" message="ns:NPNotificationFault"/>
		</wsdl:operation>
	</wsdl:portType>
	<wsdl:binding name="SOAPServiceBinding2" type="ns:NPNotificationPortType">
		<soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
		<wsdl:operation name="NPNotification">
			<soap:operation soapAction="NPNotification" style="document"/>
			<wsdl:input>
				<soap:body parts="Request" use="literal"/>
			</wsdl:input>
			<wsdl:output>
				<soap:body parts="Response" use="literal"/>
			</wsdl:output>
			<wsdl:fault name="fault">
				<soap:fault name="fault" use="literal"/>
			</wsdl:fault>
		</wsdl:operation>
	</wsdl:binding>
	<wsdl:service name="NPNotificationPortType">
		<wsdl:port name="NPNotificationPortTypeSOAP" binding="ns:SOAPServiceBinding2">
			<soap:address location="https://localhost:9368/SOAPServiceBinding2/nPNotificationPortType/"/>
		</wsdl:port>
	</wsdl:service>
</wsdl:definitions>
