{
  "name": "timnow",
  "description": "TIM NOW Bower Components",
  "version": "0.2.1",
  "homepage": "https://github.com/angular/angular-seed",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "angular": "1.5.3",
    "angular-animate": "1.5.3",
    "angular-bootstrap": "1.3.2",
    "angular-resource": "1.5.3",
    "angular-sanitize": "1.5.3",
    "angular-spinner": "urish/angular-spinner#0.8.1",
    "angular-touch": "1.5.3",
    "angular-ui": "0.4.0",
    "angular-ui-router": "0.2.18",
    "ng-file-upload": "12.0.4",
    "angular-ui-select": "0.17.1",
    "bootstrap": "3.3.6",
    "underscore": "^1.12.0",
    "moment": "^2.29.1"
  },
  "overrides": {
    "angular": {
      "main": "./angular.min.js"
    },
    "angular-animate": {
      "main": "./angular-animate.min.js"
    },
    "angular-bootstrap": {
      "main": [
        "./ui-bootstrap.min.js",
        "./ui-bootstrap-tpls.min.js"
      ]
    },
    "angular-resource": {
      "main": "./angular-resource.min.js"
    },
    "angular-sanitize": {
      "main": "./angular-sanitize.min.js"
    },
    "angular-spinner": {
      "main": "./angular-spinner.min.js"
    },
    "angular-touch": {
      "main": "./angular-touch.min.js"
    },
    "angular-ui": {
      "main": [
        "./build/angular-ui.min.js",
        "./build/angular-ui.min.css"
      ]
    },
    "angular-ui-router": {
      "main": "./release/angular-ui-router.min.js"
    },
    "angular-ui-select": {
      "main": [
        "dist/select.min.js",
        "dist/select.min.css"
      ]
    },
    "ng-file-upload": {
      "main": [
        "ng-file-upload.min.js",
        "ng-file-upload-shim.min.js"
      ]
    },
    "bootstrap": {
      "main": [
        "./dist/css/bootstrap.min.css",
        "./dist/fonts/*"
      ]
    },
    "jquery": {
      "ignore": true
    }
  }
}
