<?xml version="1.0" encoding="UTF-8"?>
<mappings xmlns="http://dozer.sourceforge.net" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://dozer.sourceforge.net http://dozer.sourceforge.net/schema/beanmapping.xsd">

	<!-- La configurazione di dozer deve essere effettuata in un unico punto. 
		La registrazione dei custom converter deve essere effettuata obbligatoriamente 
		in questo file -->
	<configuration>
		<relationship-type>non-cumulative</relationship-type>
		<custom-converters>
			<converter
				type="com.nttdata.tim.now.util.data.converter.StringToBooleanConverter">
				<class-a>java.lang.String</class-a>
				<class-b>java.lang.Boolean</class-b>
			</converter>
			<converter
				type="com.nttdata.tim.now.core.converter.ConditionBeanToConditionDTOConverter">
				<class-a>com.nttdata.tim.now.data.bean.ricerca.ConditionBean
				</class-a>
				<class-b>com.nttdata.tim.now.data.dto.ricerca.ConditionDTO</class-b>
			</converter>
			<converter
				type="com.nttdata.tim.now.core.converter.ordine.CreazioneNuovoOrdineINConverter">
				<class-a>com.nttdata.tim.now.data.dto.ordine.CreazioneNuovoOrdineInputDTO
				</class-a>
				<class-b>com.nttdata.tim.now.data.bean.ordine.CreazioneNuovoOrdineInputBean
				</class-b>
			</converter>
			<converter
				type="com.nttdata.tim.now.core.converter.ordine.DettagliDettaglioOrdineConverter">
				<class-a>com.nttdata.tim.now.data.dto.ordine.dettaglio.DettagliDettaglioOrdineDTO
				</class-a>
				<class-b>com.nttdata.tim.now.data.bean.ordine.dettaglio.DettagliDettaglioOrdineBean
				</class-b>
			</converter>
			<converter
				type="com.nttdata.tim.now.core.converter.offerta.DettaglioOffertaConverter">
				<class-a>com.nttdata.tim.now.data.bean.offerta.DettaglioOffertaOutputBean
				</class-a>
				<class-b>com.nttdata.tim.now.data.dto.offerta.DettaglioOffertaOutputDTO
				</class-b>
			</converter>
			<converter
				type="com.nttdata.tim.now.core.converter.offerta.DettaglioOffertaOrdineConverter">
				<class-a>com.nttdata.tim.now.data.bean.ordine.DettaglioOffertaOrdineBean
				</class-a>
				<class-b>com.nttdata.tim.now.data.dto.offerta.OfferDetailDTO
				</class-b>
			</converter>
			<converter
				type="com.nttdata.tim.now.core.converter.ordine.DettaglioOrdineConverter">
				<class-a>com.nttdata.tim.now.data.dto.ordine.dettaglio.DettaglioOrdineOutputDTO
				</class-a>
				<class-b>com.nttdata.tim.now.data.bean.ordine.dettaglio.DettaglioOrdineOutputBean
				</class-b>
			</converter>
			<converter
				type="com.nttdata.tim.now.core.converter.asset.ServizioAssetConverter">
				<class-a>com.nttdata.tim.now.data.dto.asset.ServizioAssetDTO
				</class-a>
				<class-b>com.nttdata.tim.now.data.bean.asset.ServizioAssetBean
				</class-b>
			</converter>
			<converter
				type="com.nttdata.tim.now.core.converter.asset.DettaglioAssetConverter">
				<class-a>com.nttdata.tim.now.data.dto.asset.DettaglioAssetOutputDTO
				</class-a>
				<class-b>com.nttdata.tim.now.data.bean.asset.DettaglioAssetOutputBean
				</class-b>
			</converter>
			<converter
				type="com.nttdata.tim.now.core.converter.offerta.OffertaConverter">
				<class-a>com.nttdata.tim.now.data.dto.offerta.OffertaOutputDTO
				</class-a>
				<class-b>com.nttdata.tim.now.data.bean.offerta.OffertaOutputBean
				</class-b>
			</converter>
			<converter
				type="com.nttdata.tim.now.core.converter.ordine.MonitoraggioRimodulazioniDACConverter">
				<class-a>com.nttdata.tim.now.data.dto.monitoring.rimodulazionedac.MonitoraggioRimodulazioniDACOutputDTO
				</class-a>
				<class-b>com.nttdata.tim.now.data.bean.monitoring.rimodulazionedac.MonitoraggioRimodulazioniDACOutputBean
				</class-b>
			</converter>
			<converter 
				type="com.nttdata.tim.now.core.converter.ricerca.avanzata.FieldsResearchDTOToRicercaCampiOutputBeanConverter">
				<class-a>com.nttdata.tim.now.data.dto.ricerca.FieldsResearchDTO
				</class-a>
				<class-b>com.nttdata.tim.now.data.bean.ricerca.RicercaCampiOutputBean
				</class-b>
			</converter>
			
			<!-- converter 
				type="com.nttdata.tim.now.core.converter.contratto.NuovoContrattoInputConverter">
				<class-a map-null="false">com.nttdata.tim.now.data.dto.contratto.NuovoContrattoInputDTO
				</class-a>
				<class-b map-null="false">com.nttdata.tim.now.data.bean.contratto.NuovoContrattoInputBean
				</class-b>
			</converter>
			<converter 
				type="com.nttdata.tim.now.core.converter.contratto.ModificaContrattoInputConverter">
				<class-a map-null="false">com.nttdata.tim.now.data.dto.contratto.ModificaContrattoInputDTO
				</class-a>
				<class-b map-null="false">com.nttdata.tim.now.data.bean.contratto.ModificaContrattoInputBean
				</class-b>
			</converter-->

		</custom-converters>

	</configuration>

</mappings>
