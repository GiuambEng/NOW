<web-app xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
	version="3.0">

	<display-name>TIMNOW</display-name>

	<context-param>
		<param-name>contextConfigLocation</param-name>
		<param-value>classpath*:/spring/config/applicationContext*.xml</param-value>
	</context-param>

	<!-- SetCharacterEncodingFilter -->
	<filter>
		<filter-name>SetCharacterEncodingFilter</filter-name>
		<filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
		<init-param>
			<param-name>encoding</param-name>
			<param-value>UTF-8</param-value>
		</init-param>
		<init-param>
			<param-name>forceEncoding</param-name>
			<param-value>true</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>SetCharacterEncodingFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>
	<!-- UserRoleFilter -->
	<filter>
		<filter-name>UserRoleFilter</filter-name>
		<filter-class>com.nttdata.tim.now.web.filter.UserRoleFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>UserRoleFilter</filter-name>
		<url-pattern>/rest/*</url-pattern>
	</filter-mapping>
	<!-- mdcEnhancerFilter -->
	<filter>
		<filter-name>mdcEnhancerFilter</filter-name>
		<filter-class>com.nttdata.tim.now.web.filter.MdcEnhancerFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>mdcEnhancerFilter</filter-name>
		<url-pattern>/rest/*</url-pattern>
	</filter-mapping>
	<!-- authenticationFilter -->
	<filter>
		<filter-name>authenticationFilter</filter-name>
		<filter-class>org.springframework.web.filter.DelegatingFilterProxy</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>authenticationFilter</filter-name>
		<url-pattern>/rest/*</url-pattern>
	</filter-mapping>
	<!-- NoCacheFilter -->
	<filter>
		<filter-name>NoCacheFilter</filter-name>
		<filter-class>com.nttdata.tim.now.web.filter.NoCacheFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>NoCacheFilter</filter-name>
		<url-pattern>/rest/*</url-pattern>
	</filter-mapping>

	<listener>
		<listener-class>com.nttdata.tim.now.web.configuration.PropertiesApplicationListener</listener-class>
	</listener>
	<listener>
		<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
	</listener>
	<listener>
		<listener-class>com.nttdata.tim.now.web.configuration.InitApplicationListener</listener-class>
	</listener>
	<!-- Scommentare per abilitare il listner delle sessioni -->
	<listener>
		<listener-class>com.nttdata.tim.now.web.listener.HttpSessionInvalidationListener</listener-class>
	</listener>

	<servlet>
		<servlet-name>timnow</servlet-name>
		<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
		<init-param>
			<param-name>contextConfigLocation</param-name>
			<param-value>classpath*:/spring/config/webmvc-config.xml</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>timnow</servlet-name>
		<url-pattern>/rest/*</url-pattern>
	</servlet-mapping>

	<!-- SESSION COOKIE only for development -->
	<session-config>
		<cookie-config>
			<name>TIMNOWSID</name>
			<path>/</path>
		</cookie-config>
		<tracking-mode>COOKIE</tracking-mode>
	</session-config>
	<!-- END SESSION COOKIE -->

	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>
	<error-page>
		<error-code>403</error-code>
		<location>/notAuthorized.html</location>
	</error-page>
	<error-page>
		<error-code>503</error-code>
		<location>/serviceUnavailable.html</location>
	</error-page>
	<error-page>
		<error-code>404</error-code>
		<location>/404.html</location>
	</error-page>
	<!-- RU_856 -->
	<error-page>
		<error-code>501</error-code>
		<location>/manutenzioneProgrammata.jsp</location>
	</error-page>
	
</web-app>