<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<groupId>com.nttdata.tim.now</groupId>
	<artifactId>timnow</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<modules>
		<module>../timnow.data</module>
		<module>../timnow.util</module>
		<module>../timnow.web</module>
		<module>../timnow.core</module>
		<module>../timnow.ws-adapter</module>
	</modules>

	<properties>
		<!-- Progetto -->
		<!-- java.version>17</java.version-->
		<java.version>1.7</java.version>
		<project.name>NOW</project.name>
		<project.build.sourceEncoding>ISO-8859-1</project.build.sourceEncoding>
		<project.module.version>1.0.0-SNAPSHOT</project.module.version>
		<!-- Build -->
		<build.id>N.A.</build.id>
		<build.number>SNAPSHOT</build.number>
		<date_string>${maven.build.timestamp}</date_string>
		<maven.build.timestamp.format>yyyyMMddHHmmss</maven.build.timestamp.format>
		<!-- Dipendenze comuni -->
		<spring.version>4.3.4.RELEASE</spring.version>
		<jackson.version>2.7.2</jackson.version>
		<jersey2.version>2.22</jersey2.version>
		<jaxrs.version>2.0</jaxrs.version>
		<!-- Logging -->
		<slf4j-api.version>1.7.6</slf4j-api.version>
		<logback.version>1.1.2</logback.version>
		<jcl-over-slf4j.version>1.7.5</jcl-over-slf4j.version>
		<!-- Apache commons -->
		<commons.io.version>1.3.2</commons.io.version>
		<commons.lang.version>3.4</commons.lang.version>
		<commons.codec.version>1.10</commons.codec.version>
		<commons.fileupload.version>1.3</commons.fileupload.version>
		<!-- Testing -->
		<powermock.version>1.6.1</powermock.version>
	</properties>

	<!-- Le dipendenze sotto definite (tag dependencyManagement) sono gestite 
		in maniera centralizzata dal parent pom. Nel parent è possibile gestire tutti 
		gli attributi delle dipendenze (scope, version, exclusion etc) ma le dipendenze 
		non sono automaticamente ereditate dai progetti figli. I figli devono esplicitamente 
		indicare le dipendenze. Per la documentazione vedere https://maven.apache.org/guides/introduction/introduction-to-dependency-mechanism.html#Dependency_Management -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework</groupId>
				<artifactId>spring-framework-bom</artifactId>
				<version>${spring.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework</groupId>
				<artifactId>spring-core</artifactId>
				<version>${spring.version}</version>
				<exclusions>
					<exclusion>
						<groupId>commons-logging</groupId>
						<artifactId>commons-logging</artifactId>
					</exclusion>
				</exclusions>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Le dipendenze sotto definite (tag dependencies) in questo parent pom 
		sono ereditate da tutti i moduli figli senza dichiarazione esplicita di dipendenza. 
		Per la documentazione vedere https://maven.apache.org/guides/introduction/introduction-to-dependency-mechanism.html#Dependency_Management -->
	<dependencies>
		<!-- Logging -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j-api.version}</version>
		</dependency>
		<!-- Test -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.12</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-all</artifactId>
			<version>1.9.5</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<!-- Vedere https://maven.apache.org/pom.html#Plugins -->
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<!-- version>3.10.1</version>
				<configuration>
					<release>${java.version}</release>
				</configuration-->
				<version>2.3.2</version>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
				</configuration>
			</plugin>
		</plugins>
		<!-- Vedere https://maven.apache.org/pom.html#Plugin_Management -->
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-war-plugin</artifactId>
					<!-- version>3.3.2</version-->
					<version>2.6</version>
					<configuration>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
						<warName>now</warName>
						<archive>
							<manifestEntries>
								<Specification-Title>${project.name}</Specification-Title>
								<Build-Id>${date_string}</Build-Id>
								<Implementation-Version>${build.number}</Implementation-Version>
								<Built-By></Built-By>
							</manifestEntries>
						</archive>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<profiles>
		<profile>
			<id>local</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
		</profile>
		<profile>
			<id>build</id>
		</profile>
		<profile>
			<id>runtime</id>
		</profile>
	</profiles>

</project>
