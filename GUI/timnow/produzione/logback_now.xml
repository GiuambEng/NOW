<configuration scan="true" debug="true">


   <!-- Generic Log Level: log-level used by all other components used in the application -->
    <property name="genericLogLevel" value="DEBUG" />
    
	<!-- rest client level -->
	<property name="restServicesloglevel" value="DEBUG" />
	
	<!-- statistics level -->
	<property name="statisticsloglevel" value="DEBUG" />    

   <!-- 
        Rolling log file 
        Maximum file size of each log-file. 
        The maxFileSize option can be specified in bytes, kilobytes, megabytes 
        or gigabytes by suffixing a numeric value with KB, MB and respectively GB. 
        For example, 5000000, 5000KB, 5MB and 2GB are all valid values, 
        with the first three being equivalent. 
    -->
    <property name="maxFileSize" value="100MB"/> 

    <!-- 
        Rolling log file 
        Maximum days that archived/rolled over log files will be kept
    -->
    <property name="historyDays" value="10"/>

    <!--Use a variable to define the logging directory. Can be JNDI or a System Environement Variable-->
    <property name="LOG_DIR" value="/apps/timnow/logs"/>



	<appender name="STANDARD_OUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
	    	<pattern>%d{dd/MM/yyyy HH:mm:ss.SSS} - %X{SID} - %X{TID} - %level - [%file:%line] - %msg%n</pattern>
	    </encoder>
	 </appender>
	
	  
	<appender name="APPLICATION_OUT" class="ch.qos.logback.core.rolling.RollingFileAppender">
	 	<file>${LOG_DIR}/timnow.log</file>
	 	<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>
				${LOG_DIR}/archive_logs/timnow-%d{yyyy-MM-dd}.%i.log
			</fileNamePattern>
			<timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<!-- or whenever the file size reaches ${maxFileSize} -->
				<maxFileSize>${maxFileSize}</maxFileSize>
			</timeBasedFileNamingAndTriggeringPolicy>
			<!-- keep history -->
			<maxHistory>${historyDays}</maxHistory>
		</rollingPolicy>
	     <encoder>
	      <pattern>%d{dd/MM/yyyy HH:mm:ss.SSS} - %X{SID} - %X{TID} - %level - [%file:%line] - %msg%n</pattern>
	    </encoder>
	 </appender>
	 
	 <appender name="APPLICATION_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
	     <filter class="ch.qos.logback.classic.filter.LevelFilter">
		      <level>ERROR</level>
		      <onMatch>ACCEPT</onMatch>
		      <onMismatch>DENY</onMismatch>
		 </filter>
		 <file>${LOG_DIR}/timnow.error</file>
	 	
	 	 <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>
				${LOG_DIR}/archive_logs/timnow-%d{yyyy-MM-dd}.%i.error
			</fileNamePattern>
			<timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<!-- or whenever the file size reaches ${maxFileSize} -->
				<maxFileSize>${maxFileSize}</maxFileSize>
			</timeBasedFileNamingAndTriggeringPolicy>
			<!-- keep history -->
			<maxHistory>${historyDays}</maxHistory>
		</rollingPolicy>
	     <encoder>
	      <pattern>%d{dd/MM/yyyy HH:mm:ss.SSS} - %X{SID} - %X{TID} - %level - [%file:%line] - %msg%n</pattern>
	    </encoder>
	 </appender>
	 
	<appender name="RESTCLIENT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<charset>UTF-8</charset>
<!-- 		 <filter class="com.bnppf.ssc.imb.sf.fwk.logging.config.filters.DenyFilter"> -->
<!-- 			<marker>SECURITY</marker> -->
<!-- 		</filter>  -->
		<!--The artefact id is resolved at build time -->
		<file>${LOG_DIR}/timnow_restclient.log</file>

		<!--Avoid too many log statements -->
<!-- 		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>INFO</level>
		</filter> -->

		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>
				${LOG_DIR}/archive_logs/timnow_restclient-%d{yyyy-MM-dd}.%i.log
			</fileNamePattern>
			<timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<!-- or whenever the file size reaches ${maxFileSize} -->
				<maxFileSize>${maxFileSize}</maxFileSize>
			</timeBasedFileNamingAndTriggeringPolicy>
			<!-- keep history -->
			<maxHistory>${historyDays}</maxHistory>
		</rollingPolicy>
		<!--Secure against log injection -->	
		<encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
	        <layout class="com.nttdata.tim.now.util.logging.CustomLoggingLayout">
	            <!-- <patternsProperty>.*password.*</patternsProperty> -->
	       		<pattern>[%d{MMM dd yyyy HH:mm:ss.SSS}][%thread][%logger{32}][%-5p][%X{UID}][%X{SID}][%X{TID}][%X{SRVC-URL}][%X{METHOD}][%m]%n</pattern>
			 </layout>		
		</encoder>	

	</appender>

	<appender name="RESTSTATISTIC_FILE"
		class="ch.qos.logback.core.rolling.RollingFileAppender">
		<charset>UTF-8</charset>
		<file>${LOG_DIR}/timnow_statistics.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>
				${LOG_DIR}/archive_logs/timnow_statistics-%d{yyyy-MM-dd}.%i.log
			</fileNamePattern>
			<timeBasedFileNamingAndTriggeringPolicy
				class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<maxFileSize>${maxFileSize}</maxFileSize>
			</timeBasedFileNamingAndTriggeringPolicy>
			<maxHistory>${historyDays}</maxHistory>
		</rollingPolicy>
		<encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
			<layout class="com.nttdata.tim.now.util.logging.CustomLoggingLayout">
				<pattern>%d{yyyyMMdd:HHmmss.SSS}#%X{UID}#%X{SID}#%X{TID}#%X{SRVC-URL}#%X{METHOD}#%X{STATUS}#%X{ELAPSED_TIME}</pattern>
			</layout>
		</encoder>

	</appender>	 
	
	 <root level="${genericLogLevel}">
     	<appender-ref ref="STANDARD_OUT" />
  	 </root>
  	 
  	  <!-- log .error  -->
	<logger name="com.nttdata.tim" level="ERROR" additivity="false">
     	<appender-ref ref="STANDARD_OUT" />
	 	<appender-ref ref="APPLICATION_ERROR" />
	 </logger>
  	 
  	  <!-- log applicativi .log -->
  	 <logger name="com.nttdata.tim" level="${genericLogLevel}">
     	<appender-ref ref="STANDARD_OUT" />
	 	<appender-ref ref="APPLICATION_OUT" />
	 </logger>
		 
	 <!-- logger di librerie esterne -->
 	 <logger name="org.dozer" level="ERROR">
	 	<appender-ref ref="APPLICATION_OUT" />
	 	<appender-ref ref="APPLICATION_ERROR" />
	 </logger>
	 
	 <logger name="org" level="INFO">
		<!-- appender-ref ref="STANDARD_OUT" /-->
	 	<appender-ref ref="APPLICATION_OUT" />
	 	<appender-ref ref="APPLICATION_ERROR" />
	 </logger>
	 
	 
	<logger name="com.nttdata.tim.now.adapters.rest.filters" level="${restServicesloglevel}"  additivity="false">
     	<appender-ref ref="STANDARD_OUT" />
		<appender-ref ref="RESTCLIENT_FILE" />
	</logger>

	<logger name="com.nttdata.tim.now.adapters.rest.filters.statistic" level="${statisticsloglevel}" additivity="false">
		<appender-ref ref="STANDARD_OUT" />
		<appender-ref ref="RESTSTATISTIC_FILE" />
	</logger>
	
</configuration>