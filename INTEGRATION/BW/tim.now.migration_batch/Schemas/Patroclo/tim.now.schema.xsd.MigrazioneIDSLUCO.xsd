<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/MigrazioneIDSLUCO" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/MigrazioneIDSLUCO">

    <element name="MigrazioneIDSLUCO">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:MigrazioneIDSLUCO_dettaglio">
    			</element>
    		</sequence>
    	</complexType>
  </element>
    <element name="MigrazioneIDSLUCO_dettaglio">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="Tipo_record">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="2"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="IDSLUCO">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="OPERATORE">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="CLLI">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="DATA_CONSEGNA_OLO">
    			  <simpleType>
    			<restriction base="string">
    			<pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"/>
    			</restriction> 
    			</simpleType>
        
          
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="ID_RICHIESTA">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="10"/>
    			</restriction>
          </simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="COPPIA_DA">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="COPPIA_A">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="DATA_INVIO">
    			<simpleType>
    			<restriction base="string">
    			<pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"/>
    			</restriction>
          </simpleType>
    			
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="TESTARMADIO">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="2"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="PROGRESSIVO" type="int">
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>
