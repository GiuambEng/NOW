<?xml version="1.0" encoding="UTF-8"?>

<schema xmlns="http://www.w3.org/2001/XMLSchema"
  xmlns:tns="http://www.tim.com/NOW/xsd/Anagrafica_Gestori"
  targetNamespace="http://www.tim.com/NOW/xsd/Anagrafica_Gestori"
  elementFormDefault="qualified" attributeFormDefault="unqualified">

    

    <element name="AnagraficaGestori">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:AnagraficaGestoriDettaglio">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="AnagraficaGestoriDettaglio">
    	<complexType>
    	<sequence>
    	<element name="CODE_GESTORE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="int">
    						<totalDigits value="5"></totalDigits>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DESC_GESTORE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DATA_INIZ_VALI" type="tns:NEWDATE"
    				maxOccurs="1" minOccurs="1">
    			</element>
    			<element name="DATA_FINE_VALI" type="tns:NEWDATE" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			</sequence>
    	
    	</complexType>
    </element>

    <simpleType name="NEWDATE">
    	<restriction base="string"> <pattern
                                          value="((0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-(1[0-9][0-9][0-9]|2[0][01][0-6]))" /></restriction>
    </simpleType>
</schema>