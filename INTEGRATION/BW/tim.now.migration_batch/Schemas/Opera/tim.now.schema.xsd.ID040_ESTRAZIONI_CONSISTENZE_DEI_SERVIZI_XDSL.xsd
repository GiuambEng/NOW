    			<element name="CODE_GEST" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="CODE_UTENZA_PRIM" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="TIPO_LINEA" type="string" maxOccurs="1" minOccurs="1"></element>
