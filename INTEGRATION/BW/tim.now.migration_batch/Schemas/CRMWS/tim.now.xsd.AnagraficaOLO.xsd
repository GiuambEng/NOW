<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/tim.now.AnagraficaOLO" xmlns:tns="http://www.example.org/tim.now.AnagraficaOLO" elementFormDefault="qualified">

    <element name="AnagraficaOLO">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:AnagraficaOLO_dettaglio">
    			</element>
    		</sequence>
    	</complexType></element>
    <element name="AnagraficaOLO_dettaglio">
    	<complexType>
    		<sequence>
    			<element name="Tipo_record" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="tns:Varchar1">
    						<enumeration value="2"></enumeration>
    					
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DENOMINAZIONE_OLO" type="tns:Varchar100" maxOccurs="1" minOccurs="1"></element>
    			<element name="RAGIONE_SOCIALE" type="tns:Varchar100" maxOccurs="1" minOccurs="1"></element>
    			<element name="P.IVA" type="tns:Varchar30" maxOccurs="1" minOccurs="1"></element>
    			<element name="CODICE_NUMERICO_OLO" type="tns:Varchar3" maxOccurs="1" minOccurs="1"></element>
    			<element name="CODICE_ALFANUMERICO_OLO" type="tns:Varchar3" maxOccurs="1" minOccurs="1"></element>
    			<element name="CODICE_OLO_RETE" type="tns:Varchar5" maxOccurs="1" minOccurs="0"></element>
    			<element name="TIPOLOGIA_GESTORE" type="tns:Varchar30" maxOccurs="1" minOccurs="0"></element>
    			<element name="FLAG_OLO_MOROSO" type="tns:Varchar1" maxOccurs="1" minOccurs="1"></element>
    			<element name="FLAG_SANMARINO" type="tns:Varchar1" maxOccurs="1" minOccurs="1"></element>
    			<element name="EMAIL" type="tns:Varchar50" maxOccurs="1" minOccurs="0"></element>
    			<element name="OLO_ACCORPANTE_FLAG" type="tns:Varchar1" maxOccurs="1" minOccurs="1"></element>
    			<element name="CODICE_OLO_ACCORPANTE" type="tns:Varchar3" maxOccurs="1" minOccurs="0"></element>
    			<element name="CODICE_ALFANUMERICO_OLO_ACCORPANTE"
    				type="tns:Varchar3" maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="STATO_ACCORPAMENTO" type="tns:Varchar30" maxOccurs="1" minOccurs="0"></element>
    			<element name="DATA_ACCORPAMENTO" type="date" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <simpleType name="Varchar1">
    	<restriction base="string">
    		<maxLength value="1"></maxLength>
    		</restriction>
    </simpleType>

    <simpleType name="Varchar30">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="Varchar3">
    	<restriction base="string">
    		<maxLength value="3"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="Varchar50">
    	<restriction base="string">
    		<maxLength value="50"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="Varchar5">
    	<restriction base="string">
    		<maxLength value="5"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="Varchar100">
    	<restriction base="string">
    		<maxLength value="100"></maxLength>
    	</restriction>
    </simpleType>
</schema>