<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/MigrazioneAnagraficaSLA_Noval" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/MigrazioneAnagraficaSLA_Noval">

    <element name="MigrazioneAnagraficaSLA_Noval">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:Dettaglio"/>
    		</sequence>
    	</complexType>
    </element>
    <element name="Dettaglio">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="Tipo_record" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="SERVIZIO" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="TIPO_LINEA" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="LAVORAZIONE" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="SOTTO_LAVORAZIONE" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="TIME" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="SLA_START_DATE" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="SLA_END_DATE" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="FLAG_MONITORAGGIO" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="FLAG_RECLAMO" type="string">
    			</element>
    			<element name="Flag_Validita" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Stato" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="DescrizioneErrore" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="Record" type="string" maxOccurs="1" minOccurs="0"></element>
				<element name="NumeroRecord" type="string" maxOccurs="1" minOccurs="0"></element>
				<element name="ID_FILE_PROCSTO_INPUT" type="decimal" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>
