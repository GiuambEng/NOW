<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVP" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVP">

    <element name="AllineamentoVP">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:AllineamentoVP_Dettaglio">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="AllineamentoVP_Dettaglio">
    	<complexType>
    		<sequence>
    			<element name="Tipo_record" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="2"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ID_RISORSA" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="STATO" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    						<enumeration value="Active"></enumeration>
    						<enumeration value="Inactive"></enumeration>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="MOD_FATT" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="Flat"></enumeration>
    						<enumeration value="Lite"></enumeration>
    						<enumeration value="HL"></enumeration>
    						<maxLength value="30"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TIPO" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="Standard"></enumeration>
    						<enumeration value="Special"></enumeration>
    						<enumeration value="Lite"></enumeration>
    						<maxLength value="30"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="BANDA_MCR" type="int" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			<element name="BANDA_PCR" type="int" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			<element name="NR_MAX_VC" type="int" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			<element name="ADR_CODE" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DESC_ADR" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="255"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TD_KIT" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="VPI_RETE" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="VPI" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="OLO_CODING" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="OLO_CODE" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TIPO_TRASPORTO" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    						<enumeration value="Assente"></enumeration>
    						<enumeration value="Presente"></enumeration>
    						<minLength value="1"></minLength>
    						<enumeration value=""></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CLLI" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="10"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="NOME_CENTRALE" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="255"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DEC_ATT" type="date" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			<element name="DEC" type="date" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			<element name="Timestamp" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="FlagValidita" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="ID_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Numero_Record" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>