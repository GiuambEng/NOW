<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/Now_SendIdullco/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/Now_SendIdullco/">

    <element name="Now_SendIdullco_Request">
    	<complexType>
    		<sequence>
    			<element name="Transaction_id" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Transaction_date" type="dateTime"
    				maxOccurs="1" minOccurs="1">
    			</element>
    			<element name="Sistema_origine" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Azione" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="21"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="IDULLCO" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="OPERATORE" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CLLI" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DATA_CONSEGNA_OLO" type="dateTime" maxOccurs="1" minOccurs="1"></element>
    			<element name="DATA_FINE_VALIDITA" type="date" maxOccurs="1" minOccurs="0"></element>
    			<element name="DATA_INVIO" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="Nome" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="255"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DRCP" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Codice_GAT" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="6"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			
    		</sequence>
    	</complexType>
    </element>

    <element name="Now_SendIdullco_Root">
    	<complexType>
    		<sequence>
    			<element ref="tns:Now_SendIdullco_Request"></element>
    			<element ref="tns:Now_SendIdullco_Response"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Now_SendIdullco_Response">
    	<complexType>
    		<sequence>
    			<element name="Transaction_ID" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Response_date">
    			<simpleType>
    			<restriction base="string">
                <pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"/>
                </restriction>
    			</simpleType>
    			</element>
    			<element name="Return_Code" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="2"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Descrizione_errore" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			
    		</sequence>
    	</complexType>
    </element>
</schema>