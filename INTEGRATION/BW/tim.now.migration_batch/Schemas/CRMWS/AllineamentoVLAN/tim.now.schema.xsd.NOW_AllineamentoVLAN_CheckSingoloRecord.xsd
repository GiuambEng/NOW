<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVLAN" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVLAN">

    <element name="AllineamentoVLAN">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:AllineamentoVLAN_Dettaglio">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="AllineamentoVLAN_Dettaglio">
    	<complexType>
    		<sequence>
    			<element name="Tipo_record" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="2"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="IDVLAN" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TIPO_BANDA" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="10"></maxLength>
    						<enumeration value="MULTICOS"></enumeration>
    						<enumeration value="MONOCOS"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TIPO_COS" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="5"></maxLength>
    						<enumeration value="BMD"></enumeration>
    						<enumeration value="BMC"></enumeration>
    						<enumeration value="0"></enumeration>
    						<enumeration value="1"></enumeration>
    						<enumeration value="3"></enumeration>
    						<enumeration value="5"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="OLO_CODING" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="OLO_CODE" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="OLO_CONDIG_SUB" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="OLO_CODE_SUB " maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="STATO_SUB" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    						<enumeration value="ACTIVE"></enumeration>
    						<enumeration value="INACTIVE"></enumeration>
    						<enumeration value=""></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DATA_ATTIVAZIONE_SUB" maxOccurs="1"
    				minOccurs="0" type="date">
    			</element>
    			<element name="DATA_CESSAZIONE_SUB" maxOccurs="1"
    				minOccurs="0" type="date">
    			</element>
    			<element name="ENCAPSULATION" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="Y"></enumeration>
    						<enumeration value="N"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TIPOLOGIA" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="NGA"></enumeration>
    						<enumeration value="GBE"></enumeration>
    						<maxLength value="30"></maxLength>
    						<enumeration value="VULA"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="STATO" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    						<enumeration value="ACTIVE"></enumeration>
    						<enumeration value="INACTIVE"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="NOME" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="255"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CLLI" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="10"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="NOME_CENTRALE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="255"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TD_KIT" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DEC_ATT" type="date" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			<element name="DEC" type="date" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			<element name="ADR_CODE" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ADR_DESC" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="255"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="MACRO_AREA_CODE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="MACRO_AREA_DESC" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="255"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="SUPER_MACRO_AREA_CODE" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="430"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="SUPER_MACRO_AREA_DESC" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="255"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TIPO_TRASPORTO" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="5"></maxLength>
    						<enumeration value="L1"></enumeration>
    						<enumeration value="L2"></enumeration>
    						<enumeration value="LD"></enumeration>
    						<enumeration value=""></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="IDVLANOLO" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="FLAG_VLAN_TRANSLATION" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DSLAM_TYPE" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="01"></enumeration>
    						<enumeration value="02"></enumeration>
    						<enumeration value="03"></enumeration>
    						<enumeration value="04"></enumeration>
    						<enumeration value="05"></enumeration>
    						<enumeration value="06"></enumeration>
    						<enumeration value="07"></enumeration>
    						<enumeration value="08"></enumeration>
    						<enumeration value=""></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CAR" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    						<enumeration value="1"></enumeration>
    						<enumeration value="2"></enumeration>
    						<enumeration value="3"></enumeration>
    						<enumeration value="4"></enumeration>
    						<enumeration value="5"></enumeration>
    						<enumeration value="NA"></enumeration>
    						<enumeration value=""></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CUSTOMER" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="4"></maxLength>
    						<enumeration value="CSPA"></enumeration>
    						<enumeration value=""></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Timestamp" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="FlagValidita" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="ID_FILE" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="Numero_Record" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>