<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/AnagraficaNumeriCivici" elementFormDefault="qualified"     attributeFormDefault="unqualified"   xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AnagraficaNumeriCivici">

    <element name="AnagraficaNumeriCiviciDettaglio">
    	<complexType>
    		<sequence>
    			<element name="CODICE_CIVICO" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="int">
    						<totalDigits value="18"></totalDigits>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CODICE_STRADA" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="int">
    						<totalDigits value="11"></totalDigits>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="COD_VIA" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="int">
    						<totalDigits value="9"></totalDigits>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CIVICO" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="70"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ADC" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="6"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="GAT" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="6"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CLLI" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="11"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TIPO_ELEMENTO" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="11"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CAP" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="int">
    						<totalDigits value="13"></totalDigits>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="FLAG_OPA" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="FLAG_OPERAZIONE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="I"></enumeration>
    						<enumeration value="U"></enumeration>
    						<enumeration value="Z"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="LATITUDINE" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
                <element name="LONGITUDINE" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
                <element name="TIPO_FONTE" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TIPO_CATEGORIA" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="PRECISIONE" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
                <element name="DR" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="2"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
                <element name="CODICE_TOPONOMASTICA" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
            </sequence>
    	</complexType></element>


    <element name="AnagraficaNumeriCivici">
    	<complexType>
    		<sequence>
    			<element ref="tns:AnagraficaNumeriCiviciDettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>
</schema>