<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/tim.now.schema.xsd.VariazioniAmministrative" xmlns:tns="http://www.tim.com/NOW/xsd/tim.now.schema.xsd.VariazioniAmministrative" elementFormDefault="qualified">


    <element name="VariazioniAmministrative">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:VariazioniAmministrative_Dettaglio">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="VariazioniAmministrative_Dettaglio">
    	<complexType>
    		<sequence>
    			<element name="CODICE_CIVICO_NEW"  maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="18"></totalDigits>
    			</restriction> </simpleType></element>
    			<element name="CIVICO_NEW" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="70"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CODICE_STRADA_NEW"  maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="11"></totalDigits>
    			</restriction> </simpleType></element>
    			<element name="CODICE_ISTAT_PROV_NEW"  maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="3"></totalDigits>
    			</restriction> </simpleType></element>
    			<element name="CODICE_ISTAT_COMUNE_NEW"  maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="6"></totalDigits>
    			</restriction> </simpleType></element>
    			<element name="CODICE_VIA_NEW"  maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="9"></totalDigits>
    			</restriction> </simpleType></element>
    			<element name="CODICE_COMUNE_NEW" maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="11"></totalDigits>
    			</restriction> </simpleType></element>
    			<element name="CODICE_CIVICO_OLD"  maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="18"></totalDigits>
    			</restriction> </simpleType></element>
    			<element name="CIVICO_OLD" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="70"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CODICE_STRADA_OLD"  maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="11"></totalDigits>
    			</restriction> </simpleType></element>
    			<element name="CODICE_ISTAT_PROV_OLD" maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="3"></totalDigits>
    			</restriction> </simpleType></element>
    			<element name="CODICE_ISTAT_COMUNE_OLD" maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="6"></totalDigits>
    			</restriction> </simpleType></element>
    			<element name="CODICE_VIA_OLD"  maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="9"></totalDigits>
    			</restriction> </simpleType></element>
    			<element name="CODICE_COMUNE_OLD"  maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="11"></totalDigits>
    			</restriction> </simpleType></element>
    		</sequence>
    	</complexType>
    </element>
</schema>