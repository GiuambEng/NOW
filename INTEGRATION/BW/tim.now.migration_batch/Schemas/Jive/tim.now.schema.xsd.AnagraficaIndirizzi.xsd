<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/AnagraficaIndirizzi" xmlns:tns="http://www.tim.com/NOW/xsd/AnagraficaIndirizzi" elementFormDefault="qualified">


    <element name="AnagraficaIndirizzi">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:AnagraficaIndirizzi_dettaglio">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="AnagraficaIndirizzi_dettaglio">
    	<complexType>
    		<sequence>
    			<element name="CODICE_PROVINCIA"  maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="11"></totalDigits>
    			</restriction>
    			</simpleType></element>
    			<element name="ISTAT_PROV"  maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="3"></totalDigits>
    			</restriction>
    			</simpleType></element>
    			<element name="DESCRIZIONE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="80"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="SIGLA_PROV" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="COD_DISTRETTO"  maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="10"></totalDigits>
    			</restriction>
    			</simpleType>
    			</element>
    			<element name="FLAG_OPERAZIONE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>