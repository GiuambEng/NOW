<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
xmlns:tns="http://www.tim.com/NOW/xsd/IDULLCO_TIM/" 
targetNamespace="http://www.tim.com/NOW/xsd/IDULLCO_TIM/"
elementFormDefault="qualified"
attributeFormDefault="unqualified">
    <element name="IDULLCO_TIM">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:IDULLCO_TIM_Dettaglio">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="IDULLCO_TIM_Dettaglio">
    	<complexType>
    	
						<sequence>
							<element name="Tipo_record" maxOccurs="1"
								minOccurs="1">
								<simpleType>
									<restriction base="string">
										<enumeration value="2"></enumeration>
									</restriction>
								</simpleType>
							</element>
							<element name="IDULLCO" maxOccurs="1"
								minOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"></maxLength>
									</restriction>
								</simpleType>
							</element>
							<element name="OLO" maxOccurs="1"
								minOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="3"></maxLength>
										<enumeration value="TLC"></enumeration>
									</restriction>
								</simpleType>
							</element>
							<element name="CLLI" maxOccurs="1"
								minOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"></maxLength>
									</restriction>
								</simpleType>
							</element>
							<element name="DATA_CONSEGNA_OLO"
								type="tns:datatimenew" maxOccurs="1" minOccurs="1">
							</element>
							<element name="DATA_FINE_VALIDITA"
								type="tns:datatimenew" maxOccurs="1" minOccurs="0">
							</element>
							<element name="DATA_INVIO" type="tns:datatimenew"
								maxOccurs="1" minOccurs="1">
							</element>
							<element name="Nome" maxOccurs="1"
								minOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="255"></maxLength>
									</restriction>
								</simpleType>
							</element>
							<element name="DRCP" maxOccurs="1"
								minOccurs="0">
								<simpleType>
									<restriction base="string">
										<maxLength value="30"></maxLength>
									</restriction>
								</simpleType>
							</element>
							<element name="Codice_GAT" maxOccurs="1"
								minOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="6"></maxLength>
									</restriction>
								</simpleType>
							</element>
						</sequence>
					</complexType>
    </element>
    <simpleType name="datatimenew">
		<restriction base="string"> <pattern
                                          value="((0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-(1[0-9][0-9][0-9]|2[0][01][0-6]))" /></restriction>
	</simpleType>
</schema>