<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified"    
  attributeFormDefault="unqualified"   
  targetNamespace="http://www.tim.com/NOW/xsd/NOWSollecitoSegnalazione" 
  xmlns="http://www.w3.org/2001/XMLSchema"
xmlns:tns="http://www.tim.com/NOW/xsd/NOWSollecitoSegnalazione">

    <element name="Input">
    	<complexType>
    		<sequence>
    			<element ref="tns:NOWSollecitoSegnalazione_input">
    			</element>
    		</sequence>
    	</complexType>
  </element>
    <element name="NOWSollecitoSegnalazione_input">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="COD_ORD_TI" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="COD_OLO" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="COD_ORD_OLO" type="string">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Output">
    	<complexType>
    		<sequence>
    			<element ref="tns:NOWSollecitoSegnalazione_output" />

    		</sequence>
    	</complexType>
  </element>
    <element name="NOWSollecitoSegnalazione_output">
    	<complexType>
    		<sequence>
    			<element name="ORDINE" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="DATA_RICEZ_ORD">
    						<simpleType>
    						<restriction base="string">
                <pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"/>
    						
    						</restriction>
    						</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="DATA_ATT_CONS">
    						<simpleType>
    						<restriction base="string">
                <pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"/>
    						
    						</restriction>
    						</simpleType>
    						
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="PROFILO_LINEA" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="TIPO_LINEA" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="CAUS_ORD" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="STATO" type="string"/>
    					</sequence>
    				</complexType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="ERROR_CODE" type="int"/>
    			<element maxOccurs="1" minOccurs="1" name="ERROR_DESC" type="string"/>
    		</sequence>
    	</complexType>
    </element>


    <element name="NOWSollecitoSegnalazione_fault">
    	<complexType>
    		<sequence>
    			<element name="Codice_errore" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Messaggio_errore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>
</schema>
