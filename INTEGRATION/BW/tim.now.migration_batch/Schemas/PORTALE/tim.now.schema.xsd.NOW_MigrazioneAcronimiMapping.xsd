<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified"
	targetNamespace="http://www.tim.com/NOW/xsd/MigrazioneAcronimiMapping/" 
	xmlns="http://www.w3.org/2001/XMLSchema"  
	xmlns:tns="http://www.tim.com/NOW/xsd/MigrazioneAcronimiMapping/">
	
				<element name="MigrazioneAcronimiMapping">
					<complexType>
						<sequence>
							<element ref="tns:MigrazioneAcronimiMappingDettaglio" maxOccurs="unbounded" minOccurs="0"/>

						</sequence>
					</complexType>
				</element>
			

	<simpleType name="String3">
		<restriction base="string">
			<maxLength value="3" />
		</restriction>
	</simpleType>

	<simpleType name="String100">
		<restriction base="string">
			<maxLength value="100" />
		</restriction>
	</simpleType>
	<element name="MigrazioneAcronimiMappingDettaglio">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1"
					name="Tipo_record">

					<simpleType>
						<restriction base="string">
							<enumeration value="2"></enumeration>
							<maxLength value="1"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="COMPANY_CODE"
					type="tns:String3">
				</element>
				<element maxOccurs="1" minOccurs="1" name="COMPANY_NAME"
					type="tns:String100">
				</element>
				<element maxOccurs="1" minOccurs="1" name="CODICE_OP"
					type="tns:String3">
				</element>
				<element maxOccurs="1" minOccurs="1" name="RAGIONE_OP"
					type="tns:String100">
				</element>
				<element maxOccurs="1" minOccurs="1" name="SISTEMA"
					type="tns:String100">
				</element>
				<element maxOccurs="1" minOccurs="1" name="DESC_SISTEMA"
					type="tns:String100">
				</element>
			</sequence>
		</complexType>
	</element>
</schema>
