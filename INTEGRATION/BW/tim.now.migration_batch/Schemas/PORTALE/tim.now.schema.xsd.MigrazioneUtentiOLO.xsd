<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	
	xmlns:tns="http://www.tim.com/NOW/xsd/MigrazioneUtentiOLO"
	elementFormDefault="qualified"
	targetNamespace="http://www.tim.com/NOW/xsd/MigrazioneUtentiOLO">

	<element name="MigrazioneUtentiOLO">
		<complexType>
			<sequence>
				<element ref="tns:MigrazioneUtentiOLO_dettaglio" maxOccurs="unbounded" minOccurs="0">

				</element>
			</sequence>
		</complexType>
	</element>

	<element name="MigrazioneUtentiOLO_dettaglio">
		<complexType>
			<sequence>



				<element name="Tipo_record" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<enumeration value="2"></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element name="USER_ID_UNICO" maxOccurs="1"
					minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="NOME" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="COGNOME" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="USER_ALIAS" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="MATRICOLA" type="string" maxOccurs="1" minOccurs="0"></element>
				<element name="DISABILITATO" maxOccurs="1"
					minOccurs="1">					<simpleType>						<restriction base="int">							<totalDigits value="10" />							<enumeration value="0"></enumeration>							<enumeration value="1"></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element name="PROFILO152" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="COMPANY_CODE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="PROFILO_UTENTI_TI" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"></maxLength>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>
