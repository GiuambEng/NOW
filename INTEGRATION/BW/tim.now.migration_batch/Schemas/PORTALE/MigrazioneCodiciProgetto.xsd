<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	
	xmlns:tns="http://www.example.org/MigrazioneCodiciProgetto"
	elementFormDefault="qualified"
	targetNamespace="http://www.example.org/MigrazioneCodiciProgetto">



	<element name="Root">
		<complexType>
			<sequence>
				<element name="MigrazioneCodiciProgetto">
					<complexType>
						<sequence>


							<element ref="tns:Dettaglio">

							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>

	<simpleType name="String100">
		<restriction base="string">
			<maxLength value="100" />
		</restriction>
	</simpleType>

	<simpleType name="String3">
		<restriction base="string">
			<maxLength value="3" />
		</restriction>
	</simpleType>

	<simpleType name="String2">
		<restriction base="string" />
	</simpleType>
	<element name="Dettaglio">
		<complexType>
			<sequence>
				<element minOccurs="1" maxOccurs="1"
					name="Tipo_record">
					<simpleType>
						<restriction base="int">
							<enumeration value="2"></enumeration>
							<maxExclusive value="1"></maxExclusive>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="1" maxOccurs="1"
					name="CODICE_PROGETTO" type="tns:String100">
				</element>
				<element minOccurs="1" maxOccurs="1"
					name="CODICE_OPERATORE" type="tns:String3">
				</element>
				<element minOccurs="1" maxOccurs="1"
					name="DATA_INIZIO_PROV" type="date">
				</element>
				<element minOccurs="1" maxOccurs="1"
					name="DATA_FINE_PROV" type="date">
				</element>
				<element minOccurs="1" maxOccurs="1" name="FITTIZIO">
					<simpleType>
						<restriction base="tns:String2">
							<enumeration value="SI"></enumeration>
							<enumeration value="NO"></enumeration>
							<maxLength value="2"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="1" maxOccurs="1" name="REPORT">
					<simpleType>
						<restriction base="tns:String2">
							<enumeration value="SI"></enumeration>
							<enumeration value="NO"></enumeration>
							<maxLength value="2"></maxLength>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>
