<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/NOW_CodiceProgetto" 
elementFormDefault="qualified"    attributeFormDefault="unqualified" 
 xmlns="http://www.w3.org/2001/XMLSchema" 
 xmlns:tns="http://www.tim.com/NOW/xsd/NOW_CodiceProgetto">

    <element name="Input">
    	<complexType>
    		<sequence>
    			<element ref="tns:NOWCodiceProgetto_input"></element>
    		</sequence>
    	</complexType></element>
    <element name="NOWCodiceProgetto_input">
    	<complexType>
    		<sequence>
    			<element name="COD_ORD_TI" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="COD_OLO" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="COD_ORD_OLO" type="string" maxOccurs="1" minOccurs="1"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Output">
    	<complexType>
    		<sequence>
    			<element ref="tns:NOWCodiceProgetto_output"></element>
    		</sequence>
    	</complexType></element>
    <element name="NOWCodiceProgetto_output">
    	<complexType>
    		<sequence>
    			<element name="PRATICA" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="COD_PROGETTO" type="string" maxOccurs="1" minOccurs="1"></element>
    						<element name="STATO" type="string" maxOccurs="1" minOccurs="1"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="ERROR_CODE" type="int" maxOccurs="1" minOccurs="1"></element>
    			<element name="ERROR_DESC" type="string" maxOccurs="1" minOccurs="1"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="NOWCodiceProgetto_fault">
    	<complexType>
    		<sequence>
    			<element name="Codice_errore" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Messaggio_errore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>
</schema>