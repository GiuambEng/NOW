&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/ContaRecord/" xmlns:tns1="http://www.example.org/tim.now.schema.xsd.Coda" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="NumRecord"/&gt;&lt;xsl:param name="Coda"/&gt;&lt;xsl:template name="ContaRecordOut-input" match="/"&gt;&lt;tns:ContaRecordResponse&gt;&lt;parameters&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Coda/Rows/tns1:Coda[1]/tns1:Numero_record=$NumRecord"&gt;&lt;tns:ContaRecordResponse&gt;&lt;out&gt;&lt;xsl:value-of select="0"/&gt;&lt;/out&gt;&lt;NumeroRecord&gt;&lt;xsl:value-of select="xsd:int($NumRecord)"/&gt;&lt;/NumeroRecord&gt;&lt;/tns:ContaRecordResponse&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Coda/Rows/tns1:Coda[1]/tns1:Numero_record != $NumRecord"&gt;&lt;tns:ContaRecordResponse&gt;&lt;out&gt;&lt;xsl:value-of select="1"/&gt;&lt;/out&gt;&lt;/tns:ContaRecordResponse&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns:ContaRecordResponse&gt;&lt;out&gt;&lt;xsl:value-of select="1"/&gt;&lt;/out&gt;&lt;/tns:ContaRecordResponse&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/parameters&gt;&lt;/tns:ContaRecordResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
