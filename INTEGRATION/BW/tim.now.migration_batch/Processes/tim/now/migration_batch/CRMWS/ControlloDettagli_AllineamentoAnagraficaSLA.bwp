                                xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO SLA_ORDN (DATAFI_VALID, DATAINZ_VALID, FLAG_MONITORAGGIO,&#xa;  FLAG_RECLAMO, ID_OFFERTA, IDTPLG_LAVRZ, IDTPLG_LINEA, IDTPLG_SOTTO_LAVRZ,&#xa;  SLA)&#xa;  VALUES (TO_DATE(?, 'YYYY-MM-DD'), TO_DATE(?, 'YYYY-MM-DD'),&#xa;    ?, ?,  ?, ?, (SELECT IDTPLG_LINEA&#xa;                                                                FROM TIPOLG_LINEA&#xa;                                                                WHERE TIPOLG_LINEA = ?),&#xa;    (SELECT IDTPLG_SOTTO_LAVRZ&#xa;       FROM TIPOLG_SOTTO_LAVRZ&#xa;       WHERE TIPOLG_SOTTO_LAVRZ_GUI = UPPER(?)&#xa;        AND IDTPLG_LAVRZ =  ?), TO_NUMBER(?, '999'))"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAFI_VALID"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINZ_VALID"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_MONITORAGGIO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_RECLAMO"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_OFFERTA"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDTPLG_LAVRZ"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDTPLG_LINEA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDTPLG_SOTTO_LAVRZ"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="TIPOLG_LAVRZ"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SLA"/>
                                    </value>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
