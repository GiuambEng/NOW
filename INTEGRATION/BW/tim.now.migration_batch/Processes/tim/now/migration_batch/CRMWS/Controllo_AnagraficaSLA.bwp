                <bpws:link name="CallProcess3ToEnd1" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="58d77ca6-6574-46fe-b583-ae2d5594d3ab"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets/>
                    <bpws:sources>
                        <bpws:source linkName="StartToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(string-length($Start/tns:Flag_Validita)=0 )and (upper-case($Start/tns:LAVORAZIONE)='ATTIVAZIONE' or upper-case($Start/tns:LAVORAZIONE)='CESSAZIONE' or upper-case($Start/tns:LAVORAZIONE)='MIGRAZIONE' or upper-case($Start/tns:LAVORAZIONE)='VARIAZIONE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(string-length($Start/tns:Flag_Validita)=0 )and (upper-case($Start/tns:LAVORAZIONE)='ATTIVAZIONE' or upper-case($Start/tns:LAVORAZIONE)='CESSAZIONE' or upper-case($Start/tns:LAVORAZIONE)='MIGRAZIONE' or upper-case($Start/tns:LAVORAZIONE)='VARIAZIONE')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToLogStart">
