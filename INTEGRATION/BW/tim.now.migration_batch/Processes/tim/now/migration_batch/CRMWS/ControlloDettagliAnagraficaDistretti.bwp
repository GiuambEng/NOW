                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMERO_RECD"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE_PROCSTO"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
