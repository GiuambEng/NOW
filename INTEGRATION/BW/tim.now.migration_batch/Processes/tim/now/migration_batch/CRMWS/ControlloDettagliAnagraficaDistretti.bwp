                                    <value batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE STAG_ANAG_DISTR&#xa;  SET  DESCR_ERRORE =?  , ID_STATO_ELAB_STAG = TO_NUMBER(?,'9'),&#xa;      TMSP_INSMTO = ?&#xa;  WHERE (COD_DISTR = ? AND DESCR_DISTR = ? AND ID_FILE_PROCSTO_INPUT=?) OR (NUMERO_RECD=? AND ID_FILE_PROCSTO_INPUT=?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
