                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InsertStagingAnagraficaDistretti&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnagraficaDistretti&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns1=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Noval_Details&quot;/>&#xa;    &lt;xsl:param name=&quot;Noval_Detail_Last&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;CallProcess&quot;/>&#xa;    &lt;xsl:template name=&quot;Var_InsertStag&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($Noval_Detail_Last/Rows/tns1:DettaglioAnagraficaDistretti_Noval_dettaglio)=0&quot;>&#xa;                &lt;tns:DettaglioAnagraficaDistretti_Noval>&#xa;                    &lt;xsl:for-each select=&quot;$Noval_Details/Rows/tns1:DettaglioAnagraficaDistretti_Noval_dettaglio&quot;>&#xa;                        &lt;tns:DettaglioAnagraficaDistretti_Noval_dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&#xa;                                &lt;tns:Tipo_record>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&#xa;                                &lt;/tns:Tipo_record>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DISTRETTO_TELEFONICO&quot;>&#xa;                                &lt;tns:DISTRETTO_TELEFONICO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DISTRETTO_TELEFONICO&quot;/>&#xa;                                &lt;/tns:DISTRETTO_TELEFONICO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DESCRIZIONE_DISTRETTO&quot;>&#xa;                                &lt;tns:DESCRIZIONE_DISTRETTO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DESCRIZIONE_DISTRETTO&quot;/>&#xa;                                &lt;/tns:DESCRIZIONE_DISTRETTO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Flag_Validita&quot;>&#xa;                                &lt;tns:Flag_Validita>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Flag_Validita&quot;/>&#xa;                                &lt;/tns:Flag_Validita>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:Stato>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/tns:Stato>&#xa;                            &lt;tns:TimeStamp>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns:TimeStamp>&#xa;                            &lt;tns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/tns:NUMERO_RECD>&#xa;                            &lt;tns:ID_FILE_PROCSTO_INPUT>&#xa;                                &lt;xsl:value-of select=&quot;xsd:decimal($ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                            &lt;/tns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;xsl:if test=&quot;$CallProcess/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;>&#xa;                                &lt;tns:Contenuto_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$CallProcess/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;/>&#xa;                                &lt;/tns:Contenuto_RECD>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:DettaglioAnagraficaDistretti_Noval_dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:DettaglioAnagraficaDistretti_Noval>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:DettaglioAnagraficaDistretti_Noval>&#xa;                    &lt;xsl:for-each select=&quot;$Noval_Detail_Last/Rows/tns1:DettaglioAnagraficaDistretti_Noval_dettaglio&quot;>&#xa;                        &lt;tns:DettaglioAnagraficaDistretti_Noval_dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&#xa;                                &lt;tns:Tipo_record>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&#xa;                                &lt;/tns:Tipo_record>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DISTRETTO_TELEFONICO&quot;>&#xa;                                &lt;tns:DISTRETTO_TELEFONICO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DISTRETTO_TELEFONICO&quot;/>&#xa;                                &lt;/tns:DISTRETTO_TELEFONICO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DESCRIZIONE_DISTRETTO&quot;>&#xa;                                &lt;tns:DESCRIZIONE_DISTRETTO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DESCRIZIONE_DISTRETTO&quot;/>&#xa;                                &lt;/tns:DESCRIZIONE_DISTRETTO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Flag_Validita&quot;>&#xa;                                &lt;tns:Flag_Validita>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Flag_Validita&quot;/>&#xa;                                &lt;/tns:Flag_Validita>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:Stato>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/tns:Stato>&#xa;                            &lt;tns:TimeStamp>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns:TimeStamp>&#xa;                            &lt;tns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/tns:NUMERO_RECD>&#xa;                            &lt;tns:ID_FILE_PROCSTO_INPUT>&#xa;                                &lt;xsl:value-of select=&quot;xsd:decimal($ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                            &lt;/tns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;xsl:if test=&quot;$CallProcess/ns1:Output_ContenutoRecord[ns1:Posizione=$var1]/ns1:Valore&quot;>&#xa;                                &lt;tns:Contenuto_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$CallProcess/ns1:Output_ContenutoRecord[ns1:Posizione=$var1]/ns1:Valore&quot;/>&#xa;                                &lt;/tns:Contenuto_RECD>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:DettaglioAnagraficaDistretti_Noval_dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:DettaglioAnagraficaDistretti_Noval>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
