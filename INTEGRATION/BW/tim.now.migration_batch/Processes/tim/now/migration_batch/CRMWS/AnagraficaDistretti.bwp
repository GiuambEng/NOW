                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="if (string-length($FileRead/fileInfo/fileName)>0) then concat($PathErrore, 'ERROR_', substring-before( $FileRead/fileInfo/fileName,'.csv.ctr' ), $Estensione) else concat($PathErrore, $NomeErrore, format-dateTime(current-dateTime(), &quot;[Y0001][M01][D01]_[H01][m01][s01]&quot;), $Estensione)"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                inputVariable="PathScarto"
                                name="PathError"
                                outputVariable="PathScarto"
                                tibex:xpdlId="7ac1dad1-b41c-4780-9225-22c231f7bca8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="Empty1ToPathError"/>
                                    <bpws:target linkName="JDBCUpdateToPathError"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="AssignToLogERRORchiusura"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (string-length($FileRead/fileInfo/fileName)>0) then concat($PathErrore, 'ERROR_', substring-before( $FileRead/fileInfo/fileName,'.csv.ctr' ), $Estensione) else concat($PathErrore, $NomeErrore, format-dateTime(current-dateTime(), &quot;[Y0001][M01][D01]_[H01][m01][s01]&quot;), $Estensione)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="PathScarto" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PathScarto&quot;/>&lt;xsl:param name=&quot;ReadFile&quot;/>&lt;xsl:template name=&quot;RenameFile1-input&quot; match=&quot;/&quot;>&lt;tns:RenameActivityConfig>&lt;xsl:if test=&quot;$ReadFile/tns1:FullName&quot;>&lt;fromFileName>&lt;xsl:value-of select=&quot;$ReadFile/tns1:FullName&quot;/>&lt;/fromFileName>&lt;/xsl:if>&lt;toFileName>&lt;xsl:value-of select=&quot;$PathScarto&quot;/>&lt;/toFileName>&lt;/tns:RenameActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="RenameFile1-input"
                                name="RenameFile1"
                                outputVariable="RenameFile1"
                                tibex:xpdlId="2562b21c-aeca-4f89-b68a-e277d2d776c8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToLogERRORchiusura"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="RenameFile1ToLogERRORchiusura"/>
                                    <bpws:source
                                    linkName="RenameFile1ToExit1"
                                    tibex:faultDetailsVar="RenameFile1" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PathScarto&quot;/>&lt;xsl:param name=&quot;ReadFile&quot;/>&lt;xsl:template name=&quot;RenameFile1-input&quot; match=&quot;/&quot;>&lt;tns:RenameActivityConfig>&lt;xsl:if test=&quot;$ReadFile/tns1:FullName&quot;>&lt;fromFileName>&lt;xsl:value-of select=&quot;$ReadFile/tns1:FullName&quot;/>&lt;/fromFileName>&lt;/xsl:if>&lt;toFileName>&lt;xsl:value-of select=&quot;$PathScarto&quot;/>&lt;/toFileName>&lt;/tns:RenameActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.file.rename"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//RenameFile"/>
                                    <value xsi:type="file:RenameFile"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:empty name="Empty1" tibex:xpdlId="0a9b620f-f260-4647-ae8f-b495d7f69a43">
                            <bpws:targets>
                                <bpws:target linkName="JDBCUpdateToEmpty1"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="Empty1ToPathError"/>
                            </bpws:sources>
                        </bpws:empty>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5cc1806d-feaf-4a11-9bff-c6aaf4ee8eb0+input&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ProcessLogger&quot;/>&lt;xsl:param name=&quot;ReadFile&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&lt;/ID_FILE>&lt;SISTEMA>&lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&lt;/SISTEMA>&lt;FLUSSO>&lt;xsl:value-of select=&quot;'AnagraficaDistretti'&quot;/>&lt;/FLUSSO>&lt;DETAILS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ReadFile/tns1:FileName)&quot;>&lt;xsl:value-of select=&quot;$ReadFile/tns1:FileName&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DETAILS>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(),true())&quot;/>&lt;/DESCR_ERRORE>&lt;STATO>&lt;xsl:value-of select=&quot;'KO TECNICO'&quot;/>&lt;/STATO>&lt;ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE)&quot;/>&lt;/ID_ESEC_PROCSO_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="JDBCUpdate-input"
                                name="JDBCUpdate"
                                outputVariable="JDBCUpdate"
                                tibex:xpdlId="5cc1806d-feaf-4a11-9bff-c6aaf4ee8eb0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="Log1ToExit1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToEmpty1"/>
                                    <bpws:source
                                    linkName="JDBCUpdateToPathError"
                                    tibex:faultDetailsVar="JDBCUpdate" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5cc1806d-feaf-4a11-9bff-c6aaf4ee8eb0+input&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFile&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:decimal($ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;            &lt;/ID_FILE>&#xa;            &lt;SISTEMA>&#xa;                &lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&#xa;            &lt;/SISTEMA>&#xa;            &lt;FLUSSO>&#xa;                &lt;xsl:value-of select=&quot;'AnagraficaDistretti'&quot;/>&#xa;            &lt;/FLUSSO>&#xa;            &lt;DETAILS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ReadFile/tns1:FileName)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFile/tns1:FileName&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DETAILS>&#xa;            &lt;DESCR_ERRORE>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(),true())&quot;/>&#xa;            &lt;/DESCR_ERRORE>&#xa;            &lt;STATO>&#xa;                &lt;xsl:value-of select=&quot;'KO TECNICO'&quot;/>&#xa;            &lt;/STATO>&#xa;            &lt;ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:decimal($ProcessLogger.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE)&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO_FILE>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STATO_ALLINEAMENTI (ID_FILE, SISTEMA, FLUSSO,&#xa;  DETAILS, DESCR_ERRORE, FLAG_LETTURA, STATO, ID_ESEC_PROCSO_FILE,&#xa;  CREATED)&#xa;  VALUES (?, ?, ?, ?, ?, 'Y', ?, ?, SYSDATE)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SISTEMA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLUSSO"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DETAILS"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DESCR_ERRORE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_FILE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link
                    name="StartAnagraficaDistrettiToInsertFileProc" tibex:linkType="SUCCESS"/>
