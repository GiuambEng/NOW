nput/ns:DIMENSIONE_FILE"&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:DIMENSIONE_FILE"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO"&gt;&lt;ns:ID_CAUS_SCARTO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO"/&gt;&lt;/ns:ID_CAUS_SCARTO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT"&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_KO"&gt;&lt;ns:QT_RECD_KO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_KO"/&gt;&lt;/ns:QT_RECD_KO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_OK"&gt;&lt;ns:QT_RECD_OK&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_OK"/&gt;&lt;/ns:QT_RECD_OK&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_TOTALI"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_TOTALI"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoInput&gt;&lt;ns:EsecuzioneFile&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:COD_PROCSO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:COD_PROCSO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:ID_PROCSO_FILE"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:STATO_ESEC"&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:STATO_ESEC"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB"&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB"&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:if&gt;&lt;/ns:EsecuzioneFile&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$Var_InsertProc/ns:LogFileProcessato/ns:COD_PROCSO"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:LogFileProcessato/ns:COD_PROCSO"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:LogFileProcessato/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:LogFileProcessato/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:LogFileProcessato/ns:LOG_LEVEL"&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:LogFileProcessato/ns:LOG_LEVEL"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:LogFileProcessato/ns:LOG_MESSAGE"&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:LogFileProcessato/ns:LOG_MESSAGE"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:LogFileProcessato/ns:TIMSTP_INSMTO"&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:LogFileProcessato/ns:TIMSTP_INSMTO"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/xsl:if&gt;&lt;/ns:LogFileProcessato&gt;&lt;ns:FileProcessatoOutput&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE"&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoOutput/ns:ESITO_INVIO"&gt;&lt;ns:ESITO_INVIO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoOutput/ns:ESITO_INVIO"/&gt;&lt;/ns:ESITO_INVIO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT"&gt;&lt;ns:ID_FILE_PROCSTO_OUTPUT&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT"/&gt;&lt;/ns:ID_FILE_PROCSTO_OUTPUT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE"&gt;&lt;ns:TIMSTP_CREZIONE_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE"/&gt;&lt;/ns:TIMSTP_CREZIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoOutput/ns:TIMSTP_INVIO"&gt;&lt;ns:TIMSTP_INVIO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoOutput/ns:TIMSTP_INVIO"/&gt;&lt;/ns:TIMSTP_INVIO&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoOutput&gt;&lt;ns:ContenutoFile&gt;&lt;xsl:if test="$Var_InsertProc/ns:ContenutoFile/ns:ID_CONTENUTO_FILE"&gt;&lt;ns:ID_CONTENUTO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:ContenutoFile/ns:ID_CONTENUTO_FILE"/&gt;&lt;/ns:ID_CONTENUTO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:ContenutoFile/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:ContenutoFile/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:ContenutoFile/ns:FullName"&gt;&lt;ns:FullName&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:ContenutoFile/ns:FullName"/&gt;&lt;/ns:FullName&gt;&lt;/xsl:if&gt;&lt;/ns:ContenutoFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Var_InsertProc&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcessLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:TipologiaProcesso&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:TipologiaOperazione&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:ProcFile/ns:ID_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:ProcFile/ns:ID_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:COD_OLO&quot;>&#xa;                    &lt;ns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:COD_OLO&quot;/>&#xa;                    &lt;/ns:COD_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;ns:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CODFC_OLO_AGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:DATA_FILE&quot;>&#xa;                    &lt;ns:DATA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:DATA_FILE&quot;/>&#xa;                    &lt;/ns:DATA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:DESCR_STATO_FILE&quot;>&#xa;                    &lt;ns:DESCR_STATO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:DESCR_STATO_FILE&quot;/>&#xa;                    &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:ESITO&quot;>&#xa;                    &lt;ns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:ESITO&quot;/>&#xa;                    &lt;/ns:ESITO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:ID_INTRFC&quot;>&#xa;                    &lt;ns:ID_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:ID_INTRFC&quot;/>&#xa;                    &lt;/ns:ID_INTRFC>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:IDTPLG_FILE&quot;>&#xa;                    &lt;ns:IDTPLG_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:IDTPLG_FILE&quot;/>&#xa;                    &lt;/ns:IDTPLG_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:NOME_FILE&quot;>&#xa;                    &lt;ns:NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:NOME_FILE&quot;/>&#xa;                    &lt;/ns:NOME_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;>&#xa;                    &lt;ns:TIMSTP_APERTURA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;/>&#xa;                    &lt;/ns:TIMSTP_APERTURA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;>&#xa;                    &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;/>&#xa;                    &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:VERSO_DEL_FILE&quot;>&#xa;                    &lt;ns:VERSO_DEL_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:VERSO_DEL_FILE&quot;/>&#xa;                    &lt;/ns:VERSO_DEL_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:FileProcessatoInput>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:DATA_ARRIVO&quot;>&#xa;                    &lt;ns:DATA_ARRIVO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:DATA_ARRIVO&quot;/>&#xa;                    &lt;/ns:DATA_ARRIVO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:DIMENSIONE_FILE&quot;>&#xa;                    &lt;ns:DIMENSIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:DIMENSIONE_FILE&quot;/>&#xa;                    &lt;/ns:DIMENSIONE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO&quot;>&#xa;                    &lt;ns:ID_CAUS_SCARTO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO&quot;/>&#xa;                    &lt;/ns:ID_CAUS_SCARTO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT&quot;>&#xa;                    &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT&quot;/>&#xa;                    &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_KO&quot;>&#xa;                    &lt;ns:QT_RECD_KO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_KO&quot;/>&#xa;                    &lt;/ns:QT_RECD_KO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_OK&quot;>&#xa;                    &lt;ns:QT_RECD_OK>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_OK&quot;/>&#xa;                    &lt;/ns:QT_RECD_OK>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_TOTALI&quot;>&#xa;                    &lt;ns:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_TOTALI&quot;/>&#xa;                    &lt;/ns:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessatoInput>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:EsecuzioneFile/ns:COD_PROCSO_FILE&quot;>&#xa;                    &lt;ns:COD_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:EsecuzioneFile/ns:COD_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:COD_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:EsecuzioneFile/ns:ID_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:EsecuzioneFile/ns:ID_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:EsecuzioneFile/ns:STATO_ESEC&quot;>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:EsecuzioneFile/ns:STATO_ESEC&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB&quot;>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB&quot;>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:LogFileProcessato/ns:COD_PROCSO&quot;>&#xa;                    &lt;ns:COD_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:LogFileProcessato/ns:COD_PROCSO&quot;/>&#xa;                    &lt;/ns:COD_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:LogFileProcessato/ns:ID_ESEC_PROCSO&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:LogFileProcessato/ns:ID_ESEC_PROCSO&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:LogFileProcessato/ns:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:LogFileProcessato/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:LogFileProcessato/ns:LOG_LEVEL&quot;>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:LogFileProcessato/ns:LOG_LEVEL&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:LogFileProcessato/ns:LOG_MESSAGE&quot;>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:LogFileProcessato/ns:LOG_MESSAGE&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:LogFileProcessato/ns:TIMSTP_INSMTO&quot;>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:LogFileProcessato/ns:TIMSTP_INSMTO&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:LogFileProcessato>&#xa;            &lt;ns:FileProcessatoOutput>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE&quot;>&#xa;                    &lt;ns:DIMENSIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE&quot;/>&#xa;                    &lt;/ns:DIMENSIONE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessatoOutput/ns:ESITO_INVIO&quot;>&#xa;                    &lt;ns:ESITO_INVIO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessatoOutput/ns:ESITO_INVIO&quot;/>&#xa;                    &lt;/ns:ESITO_INVIO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT&quot;>&#xa;                    &lt;ns:ID_FILE_PROCSTO_OUTPUT>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT&quot;/>&#xa;                    &lt;/ns:ID_FILE_PROCSTO_OUTPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI&quot;>&#xa;                    &lt;ns:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI&quot;/>&#xa;                    &lt;/ns:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE&quot;>&#xa;                    &lt;ns:TIMSTP_CREZIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE&quot;/>&#xa;                    &lt;/ns:TIMSTP_CREZIONE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessatoOutput/ns:TIMSTP_INVIO&quot;>&#xa;                    &lt;ns:TIMSTP_INVIO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessatoOutput/ns:TIMSTP_INVIO&quot;/>&#xa;                    &lt;/ns:TIMSTP_INVIO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessatoOutput>&#xa;            &lt;ns:ContenutoFile>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:ContenutoFile/ns:ID_CONTENUTO_FILE&quot;>&#xa;                    &lt;ns:ID_CONTENUTO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:ContenutoFile/ns:ID_CONTENUTO_FILE&quot;/>&#xa;                    &lt;/ns:ID_CONTENUTO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:ContenutoFile/ns:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:ContenutoFile/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:ContenutoFile/ns:FullName&quot;>&#xa;                    &lt;ns:FullName>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:ContenutoFile/ns:FullName&quot;/>&#xa;                    &lt;/ns:FullName>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:ContenutoFile>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
