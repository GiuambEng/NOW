&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/Now_CRMWS_AnagraficaDistretti/" xmlns:tns1="http://www.tim.com/NOW/xsd/AnagraficaDistretti" xmlns:ns2="http://www.tibco.com/ContaRecord/" xmlns:tns2="http://www.example.org/InsertStagingAnagraficaDistretti" version="2.0"&gt;&lt;xsl:param name="Var_InsertStag"/&gt;&lt;xsl:template name="DetailControl-input" match="/"&gt;&lt;tns:DetailControlRequest&gt;&lt;parameters&gt;&lt;tns1:DettaglioAnagraficaDistretti_Noval&gt;&lt;xsl:for-each select="$Var_InsertStag/tns2:DettaglioAnagraficaDistretti_Noval_dettaglio"&gt;&lt;tns1:DettaglioAnagraficaDistretti_Noval_dettaglio&gt;&lt;xsl:if test="tns2:Tipo_record"&gt;&lt;tns1:Tipo_record&gt;&lt;xsl:value-of select="tns2:Tipo_record"/&gt;&lt;/tns1:Tipo_record&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns2:DISTRETTO_TELEFONICO"&gt;&lt;tns1:DISTRETTO_TELEFONICO&gt;&lt;xsl:value-of select="tns2:DISTRETTO_TELEFONICO"/&gt;&lt;/tns1:DISTRETTO_TELEFONICO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns2:DESCRIZIONE_DISTRETTO"&gt;&lt;tns1:DESCRIZIONE_DISTRETTO&gt;&lt;xsl:value-of select="tns2:DESCRIZIONE_DISTRETTO"/&gt;&lt;/tns1:DESCRIZIONE_DISTRETTO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns2:Flag_Validita"&gt;&lt;tns1:Flag_Validita&gt;&lt;xsl:value-of select="tns2:Flag_Validita"/&gt;&lt;/tns1:Flag_Validita&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns2:NUMERO_RECD"&gt;&lt;tns1:NumeroRecord&gt;&lt;xsl:value-of select="tns2:NUMERO_RECD"/&gt;&lt;/tns1:NumeroRecord&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns2:ID_FILE_PROCSTO_INPUT"&gt;&lt;tns1:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="tns2:ID_FILE_PROCSTO_INPUT"/&gt;&lt;/tns1:ID_FILE_PROCSTO_INPUT&gt;&lt;/xsl:if&gt;&lt;/tns1:DettaglioAnagraficaDistretti_Noval_dettaglio&gt;&lt;/xsl:for-each&gt;&lt;/tns1:DettaglioAnagraficaDistretti_Noval&gt;&lt;/parameters&gt;&lt;/tns:DetailControlRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
