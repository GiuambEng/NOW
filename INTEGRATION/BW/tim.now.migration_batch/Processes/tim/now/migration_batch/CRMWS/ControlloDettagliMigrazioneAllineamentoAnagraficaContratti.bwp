                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.AnagraficaContratti_noval&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DetailControlIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;Record&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:AnagraficaContratti_dettaglio>&#xa;            &lt;xsl:variable name=&quot;var&quot; select=&quot;$DetailControlIn.parameters/tns1:AnagraficaContratti_dettaglio[number($index)]&quot;/>&#xa;            &lt;xsl:if test=&quot;$var/tns1:Tipo_record&quot;>&#xa;                &lt;tns1:Tipo_record>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:Tipo_record&quot;/>&#xa;                &lt;/tns1:Tipo_record>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:AGREE_NUMBER&quot;>&#xa;                &lt;tns1:AGREE_NUMBER>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:AGREE_NUMBER&quot;/>&#xa;                &lt;/tns1:AGREE_NUMBER>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:AGREE_ID_CRMWS&quot;>&#xa;                &lt;tns1:AGREE_ID_CRMWS>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:AGREE_ID_CRMWS&quot;/>&#xa;                &lt;/tns1:AGREE_ID_CRMWS>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:AGREE_NAME&quot;>&#xa;                &lt;tns1:AGREE_NAME>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:AGREE_NAME&quot;/>&#xa;                &lt;/tns1:AGREE_NAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:CODICE_OLO&quot;>&#xa;                &lt;tns1:CODICE_OLO>&#x