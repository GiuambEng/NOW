                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DATAFI_VALID FROM OFFERTA WHERE ID_OFFERTA= (SELECT ID_OFFERTA FROM TRASCODFC_OFFERTA WHERE NOME_OFFERTA_ESTERNA=? and PROVENIENZA='CRMWS')"
