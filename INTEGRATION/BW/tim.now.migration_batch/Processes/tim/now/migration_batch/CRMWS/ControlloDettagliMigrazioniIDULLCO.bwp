                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE STAG_CLC_IDULLCO_FILE&#xa;  SET DESCR_ERRORE = ?, ID_STATO_ELAB_STAG = TO_NUMBER(?, '9'),&#xa;      TMSP_INSMTO = ?&#xa;  WHERE ID_FILE_PROCSTO_INPUT=? AND NUMERO_RECD=?"
