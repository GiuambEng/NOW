                                    sqlStatement="INSERT INTO CLC_IDULLCO (CLLI, COD_GAT, CODFC_OLO_AGCOM,&#xa;  DATA_CONSEGNA_OLO, DATAFI_VALID, DATA_INVIO, DRCP_CENTRALE,&#xa;  IDULLCO, NOME_CENTRALE, TIPOLG_CLC)&#xa;  VALUES (?, ?, ?, TO_DATE(?, 'YYYY-MM-DD'), TO_DATE(?, 'YYYY-MM-DD'),&#xa;    TO_DATE(?, 'DD-MM-YYYY HH24:MI:SS'), ?, ?, ?, ?)"
