                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_SLA_ORDN (DATAFI_VALID, DATAINZ_VALID,&#xa;  FLAG_MONITORAGGIO, FLAG_RECLAMO, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG,&#xa;  LAVRZ, NUMERO_RECD, SOTTO_LAVRZ, TIPO_LINEA, TMSP_INSMTO, SRVZ,&#xa;  SLA,CONTENUTO_RECD)&#xa;  VALUES (?, ?, ?, ?,  ?, ?, ?, ?, ?, ?, ?, ?, ?,RTRIM(?, CHR(10) || CHR(13)))"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAFI_VALID"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINZ_VALID"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_MONITORAGGIO"/>

