D_DATE)&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns1:SLA_END_DATE&quot;>&#xa;                                        &lt;tns:SLA_END_DATE>&#xa;                                            &lt;xsl:value-of select=&quot;tns1:SLA_END_DATE&quot;/>&#xa;                                        &lt;/tns:SLA_END_DATE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:SLA_END_DATE>&#xa;                                        &lt;xsl:value-of select=&quot;'2999-01-01'&quot;/>&#xa;                                    &lt;/tns:SLA_END_DATE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;tns1:FLAG_MONITORAGGIO&quot;>&#xa;                                &lt;tns:FLAG_MONITORAGGIO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:FLAG_MONITORAGGIO&quot;/>&#xa;                                &lt;/tns:FLAG_MONITORAGGIO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:FLAG_RECLAMO&quot;>&#xa;                                &lt;tns:FLAG_RECLAMO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:FLAG_RECLAMO&quot;/>&#xa;                                &lt;/tns:FLAG_RECLAMO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Flag_Validita&quot;>&#xa;                                &lt;tns:Flag_Validita>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Flag_Validita&quot;/>&#xa;                                &lt;/tns:Flag_Validita>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:Stato>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;             