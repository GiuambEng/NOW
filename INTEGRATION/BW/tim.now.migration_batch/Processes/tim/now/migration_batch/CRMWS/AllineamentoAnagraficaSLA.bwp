    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="9501d03e-1307-45e4-8b8b-ab3f0fa98b64">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="FileErrorToRenameFile1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="RenameFile1ToCallProcess2" tibex:linkType="SUCCESS"/>
                            <bpws:link name="CallProcess2ToExit1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="RenameFile1ToExit11" tibex:linkType="ERROR"/>
                            <bpws:link name="CallProcess1ToRenameFile1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="CallProcess3ToFileError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCUpdate1ToFileError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="Empty1ToFileError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCErrorToFileError" tibex:linkType="ERROR"/>
                        </bpws:links>
                        <bpws:exit name="Exit1" tibex:xpdlId="68348063-d8c0-47e5-b0c4-fb818f651635">
                            <bpws:targets>
                                <bpws:target linkName="CallProcess2ToExit1"/>
                                <bpws:target linkName="RenameFile1ToExit11"/>
                            </bpws:targets>
                        </bpws:exit>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="if (string-length($FileRead/fileInfo/fileName)>0) then concat($PathErrore, 'ERROR_', substring-before( $FileRead/fileInfo/fileName,'.csv.ctr' ), $Estensione) else concat($PathErrore, $NomeFileErrore, format-dateTime(current-dateTime(), &quot;[Y0001][M01][D01]_[H01][m01][s01]&quot;), $Estensione)"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                inputVariable="PathScarto"
                                name="FileError"
                                outputVariable="PathScarto"
                                tibex:xpdlId="84dd868e-edf1-4061-89a6-be330ffc9c77" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="Empty1ToFileError"/>
                                    <bpws:target linkName="JDBCErrorToFileError"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="FileErrorToRenameFile1"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (string-length($FileRead/fileInfo/fileName)>0) then concat($PathErrore, 'ERROR_', substring-before( $FileRead/fileInfo/fileName,'.csv.ctr' ), $Estensione) else concat($PathErrore, $NomeFileErrore, format-dateTime(current-dateTime(), &quot;[Y0001][M01][D01]_[H01][m01][s01]&quot;), $Estensione)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="PathScarto" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PathScarto&quot;/>&lt;xsl:param name=&quot;ReadFile&quot;/>&lt;xsl:template name=&quot;RenameFile1-input&quot; match=&quot;/&quot;>&lt;tns:RenameActivityConfig>&lt;xsl:if test=&quot;$ReadFile/tns1:FullName&quot;>&lt;fromFileName>&lt;xsl:value-of select=&quot;$ReadFile/tns1:FullName&quot;/>&lt;/fromFileName>&lt;/xsl:if>&lt;toFileName>&lt;xsl:value-of select=&quot;$PathScarto&quot;/>&lt;/toFileName>&lt;/tns:RenameActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="RenameFile1-input"
                                name="RenameFile1"
                                outputVariable="RenameFile1"
                                tibex:xpdlId="296d00d1-b97c-47bf-aabe-eebc22f4aeec" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToRenameFile1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="RenameFile1ToCallProcess2"/>
                                    <bpws:source
                                    linkName="RenameFile1ToExit11"
                                    tibex:faultDetailsVar="RenameFile1" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PathScarto&quot;/>&lt;xsl:param name=&quot;ReadFile&quot;/>&lt;xsl:template name=&quot;RenameFile1-input&quot; match=&quot;/&quot;>&lt;tns:RenameActivityConfig>&lt;xsl:if test=&quot;$ReadFile/tns1:FullName&quot;>&lt;fromFileName>&lt;xsl:value-of select=&quot;$ReadFile/tns1:FullName&quot;/>&lt;/fromFileName>&lt;/xsl:if>&lt;toFileName>&lt;xsl:value-of select=&quot;$PathScarto&quot;/>&lt;/toFileName>&lt;/tns:RenameActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.file.rename"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//RenameFile"/>
                                    <value xsi:type="file:RenameFile"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Appl&quot;/>&lt;xsl:param name=&quot;Proc&quot;/>&lt;xsl:template name=&quot;LogErrorFine-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Appl&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;$Proc&quot;/>&lt;/tns:Process>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;'ERRORE TECNICO'&quot;/>&lt;/tns:MsgCode>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="LogErrorFine-input"
                                name="LogErrorFine"
                                tibex:xpdlId="d11dc93a-22be-4eaa-8f57-79aee8a9000f"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="RenameFile1ToCallProcess2"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="CallProcess2ToExit1"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Appl&quot;/>&lt;xsl:param name=&quot;Proc&quot;/>&lt;xsl:template name=&quot;LogErrorFine-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Appl&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;$Proc&quot;/>&lt;/tns:Process>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;'ERRORE TECNICO'&quot;/>&lt;/tns:MsgCode>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Appl&quot;/>&lt;xsl:param name=&quot;Proc&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;PathScarto&quot;/>&lt;xsl:template name=&quot;LogPathFileError-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Appl&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;$Proc&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;$PathScarto&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="LogPathFileError-input"
                                name="LogPathFileError"
                                tibex:xpdlId="8967f3ef-47a4-49ee-b087-43a9622fb452"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="FileErrorToRenameFile1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="CallProcess1ToRenameFile1"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Appl&quot;/>&lt;xsl:param name=&quot;Proc&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;PathScarto&quot;/>&lt;xsl:template name=&quot;LogPathFileError-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Appl&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;$Proc&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;$PathScarto&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
