                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Var_InputLogger&quot;/>&#xa;    &lt;xsl:template name=&quot;LogIn-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;$Var_InputLogger/ns:TipologiaProcesso&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;$Var_InputLogger/ns:TipologiaOperazione&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;xsl:if test=&quot;$Var_InputLogger/ns:ProcFile/ns:ID_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InputLogger/ns:ProcFile/ns:ID_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$Var_InputLogger/ns:LogFileProcessato/ns:COD_PROCSO&quot;>&#xa;                    &lt;ns:COD_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InputLogger/ns:LogFileProcessato/ns:COD_PROCSO&quot;/>&#xa;                    &lt;/ns:COD_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InputLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InputLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;               