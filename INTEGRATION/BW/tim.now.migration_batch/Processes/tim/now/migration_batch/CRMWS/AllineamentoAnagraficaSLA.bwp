tns1:TIME&quot;>&lt;tns:TIME>&lt;xsl:value-of select=&quot;tns1:TIME&quot;/>&lt;/tns:TIME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:SLA_START_DATE&quot;>&lt;tns:SLA_START_DATE>&lt;xsl:value-of select=&quot;tns1:SLA_START_DATE&quot;/>&lt;/tns:SLA_START_DATE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:SLA_END_DATE)>0&quot;>&lt;xsl:if test=&quot;tns1:SLA_END_DATE&quot;>&lt;tns:SLA_END_DATE>&lt;xsl:value-of select=&quot;tns1:SLA_END_DATE&quot;/>&lt;/tns:SLA_END_DATE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SLA_END_DATE>&lt;xsl:value-of select=&quot;'2999-01-01'&quot;/>&lt;/tns:SLA_END_DATE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns1:FLAG_MONITORAGGIO&quot;>&lt;tns:FLAG_MONITORAGGIO>&lt;xsl:value-of select=&quot;tns1:FLAG_MONITORAGGIO&quot;/>&lt;/tns:FLAG_MONITORAGGIO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_RECLAMO&quot;>&lt;tns:FLAG_RECLAMO>&lt;xsl:value-of select=&quot;tns1:FLAG_RECLAMO&quot;/>&lt;/tns:FLAG_RECLAMO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Flag_Validita&quot;>&lt;tns:Flag_Validita>&lt;xsl:value-of select=&quot;tns1:Flag_Validita&quot;/>&lt;/tns:Flag_Validita>&lt;/xsl:if>&lt;tns:Stato>&lt;xsl:value-of select=&quot;'2'&quot;/>&lt;/tns:Stato>&lt;tns:TimeStamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TimeStamp>&lt;tns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var&quot;/>&lt;/tns:NUMERO_RECD>&lt;tns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal($ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&lt;/tns:ID_FILE_PROCSTO_INPUT>&lt;xsl:if test=&quot;$CallProcess/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;>&lt;tns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$CallProcess/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;/>&lt;/tns:CONTENUTO_RECD>&lt;/xsl:if>&lt;/tns:Dettaglio>&lt;/xsl:for-each>&lt;/tns:MigrazioneAnagraficaSLA_Noval>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:MigrazioneAnagraficaSLA_Noval>&lt;xsl:for-each select=&q