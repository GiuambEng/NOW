                          &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;xsl:if test=&quot;$CallProcess/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;>&#xa;                                &lt;ns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$CallProcess/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;/>&#xa;                                &lt;/ns:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns:Input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/ns:root>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
