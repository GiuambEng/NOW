                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ProcessLogger&quot;/>&lt;xsl:param name=&quot;ID_FILE_PROC&quot;/>&lt;xsl:template name=&quot;Var_InsertLogger&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:TipologiaProcesso>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/ns:TipologiaProcesso>&lt;ns:TipologiaOperazione>&lt;xsl:value-of select=&quot;&amp;quot;LOG&amp;quot;&quot;/>&lt;/ns:TipologiaOperazione>&lt;ns:ProcFile>&lt;ns:ID_PROCSO_FILE>&lt;xsl:value-of select=&quot;$ID_FILE_PROC&quot;/>&lt;/ns:ID_PROCSO_FILE>&lt;/ns:ProcFile>&lt;ns:LogFileProcessato>&lt;xsl:if test=&quot;$ProcessLogger/part1/ns:Output/ns:Esito/ns:COD_PROCSO_FILE&quot;>&lt;ns:COD_PROCSO>&lt;xsl:value-of select=&quot;$ProcessLogger/part1/ns:Output/ns:Esito/ns:COD_PROCSO_FILE&quot;/>&lt;/ns:COD_PROCSO>&lt;/xsl:if>&lt;ns:ID_ESEC_PROCSO>&lt;xsl:value-of select=&quot;xsd:integer($ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ns:ID_ESEC_PROCSO>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:integer($ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&lt;/ns:ID_FILE>&lt;ns:LOG_LEVEL>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/ns:LOG_LEVEL>&lt;ns:LOG_MESSAGE>&lt;xsl:value-of select=&quot;&amp;quot;INIZIO LAVORAZIONE FILE INPUT&amp;quot;&quot;/>&lt;/ns:LOG_MESSAGE>&lt;ns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_INSMTO>&lt;/ns:LogFileProcessato>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
