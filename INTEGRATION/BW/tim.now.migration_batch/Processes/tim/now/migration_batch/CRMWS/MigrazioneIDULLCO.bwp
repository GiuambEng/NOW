                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/log/InsertInizialeStaging/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_IDULLCOnoval&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Dettaglio_Noval_ultimi&quot;/>&#xa;    &lt;xsl:param name=&quot;LeggiFile&quot;/>&#xa;    &lt;xsl:param name=&quot;Dettaglio_Noval&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;CallProcess&quot;/>&#xa;    &lt;xsl:template name=&quot;Var_InsertStag&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($Dettaglio_Noval_ultimi/Rows/tns1:MigrazioneIDULLCO_dettaglio_NoVal)=0&quot;>&#xa;                &lt;ns:root>&#xa;                    &lt;xsl:for-each select=&quot;$Dettaglio_Noval/Rows/tns1:MigrazioneIDULLCO_dettaglio_NoVal&quot;>&#xa;                        &lt;ns:Input>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&#xa;                                &lt;ns:Tipo_record>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&#xa;                                &lt;/ns:Tipo_record>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Codice_GAT&quot;>&#xa;                                &lt;ns:COD_GAT>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Codice_GAT&quot;/>&#xa;                                &lt;/ns:COD_GAT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO&quot;>&#xa;                                &lt;ns:CODFC_OLO_AGICOM>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO&quot;/>&#xa;                                &lt;/ns:CODFC_OLO_AGICOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DATA_CONSEGNA_OLO&quot;>&#xa;                                &lt;ns:DATA_CONSEGNA_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_CONSEGNA_OLO&quot;/>&#xa;                                &lt;/ns:DATA_CONSEGNA_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(tns1:DATA_FINE_VALIDITA)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns1:DATA_FINE_VALIDITA&quot;>&#xa;                                        &lt;ns:DATAFI_VALID>&#xa;                                            &lt;xsl:value-of select=&quot;tns1:DATA_FINE_VALIDITA&quot;/>&#xa;                                        &lt;/ns:DATAFI_VALID>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:DATAFI_VALID>&#xa;                                        &lt;xsl:value-of select=&quot;'2999-01-01'&quot;/>&#xa;                                    &lt;/ns:DATAFI_VALID>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;tns1:DATA_INVIO&quot;>&#xa;                                &lt;ns:DATA_INVIO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_INVIO&quot;/>&#xa;                                &lt;/ns:DATA_INVIO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DRCP&quot;>&#xa;                                &lt;ns:DRCP_CENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DRCP&quot;/>&#xa;                                &lt;/ns:DRCP_CENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CLLI&quot;>&#xa;                                &lt;ns:ID_CENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&#xa;                                &lt;/ns:ID_CENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:NOME_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$LeggiFile/fileInfo/fileName&quot;/>&#xa;                            &lt;/ns:NOME_FILE>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:if test=&quot;tns1:IDULLCO&quot;>&#xa;                                &lt;ns:IDULLCO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:IDULLCO&quot;/>&#xa;                                &lt;/ns:IDULLCO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Nome&quot;>&#xa;                                &lt;ns:NOME_CENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Nome&quot;/>&#xa;                                &lt;/ns:NOME_CENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Tipo_colocazione&quot;>&#xa;                                &lt;ns:COD_TIPOLG_CLC>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Tipo_colocazione&quot;/>&#xa;                                &lt;/ns:COD_TIPOLG_CLC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Flag_Validita&quot;>&#xa;                                &lt;ns:Flag_Validita>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Flag_Validita&quot;/>&#xa;                                &lt;/ns:Flag_Validita>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:Stato>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/ns:Stato>&#xa;                            &lt;ns:TimeStamp>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TimeStamp>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                                &lt;xsl:value-of select=&quot;xsd:decimal($ProcessLogger.part1/ns1:Esito/ns1:ID_FILE)&quot;/>&#xa;                            &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;xsl:if test=&quot;$CallProcess/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;>&#xa;                                &lt;ns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$CallProcess/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;/>&#xa;                                &lt;/ns:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns:Input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/ns:root>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:root>&#xa;                    &lt;xsl:for-each select=&quot;$Dettaglio_Noval_ultimi/Rows/tns1:MigrazioneIDULLCO_dettaglio_NoVal&quot;>&#xa;                        &lt;ns:Input>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&#xa;                                &lt;ns:Tipo_record>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&#xa;                                &lt;/ns:Tipo_record>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Codice_GAT&quot;>&#xa;                                &lt;ns:COD_GAT>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Codice_GAT&quot;/>&#xa;                                &lt;/ns:COD_GAT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO&quot;>&#xa;                                &lt;ns:CODFC_OLO_AGICOM>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO&quot;/>&#xa;                                &lt;/ns:CODFC_OLO_AGICOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DATA_CONSEGNA_OLO&quot;>&#xa;                                &lt;ns:DATA_CONSEGNA_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_CONSEGNA_OLO&quot;/>&#xa;                                &lt;/ns:DATA_CONSEGNA_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(tns1:DATA_FINE_VALIDITA)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns1:DATA_FINE_VALIDITA&quot;>&#xa;                                        &lt;ns:DATAFI_VALID>&#xa;                                            &lt;xsl:value-of select=&quot;tns1:DATA_FINE_VALIDITA&quot;/>&#xa;                                        &lt;/ns:DATAFI_VALID>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:DATAFI_VALID>&#xa;                                        &lt;xsl:value-of select=&quot;'2999-01-01'&quot;/>&#xa;                                    &lt;/ns:DATAFI_VALID>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;tns1:DATA_INVIO&quot;>&#xa;                                &lt;ns:DATA_INVIO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_INVIO&quot;/>&#xa;                                &lt;/ns:DATA_INVIO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DRCP&quot;>&#xa;                                &lt;ns:DRCP_CENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DRCP&quot;/>&#xa;                                &lt;/ns:DRCP_CENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CLLI&quot;>&#xa;                                &lt;ns:ID_CENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&#xa;                                &lt;/ns:ID_CENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:NOME_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$LeggiFile/fileInfo/fileName&quot;/>&#xa;                            &lt;/ns:NOME_FILE>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:if test=&quot;tns1:IDULLCO&quo