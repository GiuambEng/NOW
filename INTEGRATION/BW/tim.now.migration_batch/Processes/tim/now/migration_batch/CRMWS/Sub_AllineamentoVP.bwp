                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+736026b9-8a95-44d8-9aeb-c7cc83c5d67b+input&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.InsertTargetVP&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Target&quot;/>&lt;xsl:template name=&quot;JDBCTarget-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Target/tns1:InsertTarget_input&quot;>&lt;Record>&lt;BANDA_MCR>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:BANDA_MCR)&quot;>&lt;xsl:value-of select=&quot;tns1:BANDA_MCR&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/BANDA_MCR>&lt;BANDA_PCR>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:BANDA_PCR)&quot;>&lt;xsl:value-of select=&quot;tns1:BANDA_PCR&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/BANDA_PCR>&lt;CLLI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:CLLI)&quot;>&lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CLLI>&lt;COD_AREA_RACCOLTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:COD_AREA_RACCOLTA)&quot;>&lt;xsl:value-of select=&quot;tns1:COD_AREA_RACCOLTA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_AREA_RACCOLTA>&lt;COD_KIT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:COD_KIT)&quot;>&lt;xsl:value-of select=&quot;tns1:C