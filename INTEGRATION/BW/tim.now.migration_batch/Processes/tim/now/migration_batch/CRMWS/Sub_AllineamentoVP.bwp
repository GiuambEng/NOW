                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="cf16bff3-7b88-411e-a138-2596f99e6d84" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
