                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="InvokeProcessLogger-input"
                name="InvokeProcessLogger" operation="Insert"
                outputVariable="InvokeProcessLogger"
                partnerLink="Logger" portType="ns3:ProcessLog" tibex:xpdlId="67c8daad-fdd0-481a-b634-a99c08712de6">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" version="2.0"&gt;&lt;xsl:param name="Input_ProcessLogger"/&gt;&lt;xsl:template name="InvokeProcessLogger-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:TipologiaProcesso"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:TipologiaOperazione"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:ProcFile/ns:ID_PROCSO_FILE"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:ProcFile/ns:ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;/ns:ProcFile&gt;&lt;ns:FileProcessato&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO"&gt;&lt;ns:COD_OLO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO"/&gt;&lt;/ns:COD_OLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM"&gt;&lt;ns:CODFC_OLO_AGCOM&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM"/&gt;&lt;/ns:CODFC_OLO_AGCOM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE"&gt;&lt;ns:DATA_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE"/&gt;&lt;/ns:DATA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:DESCR_STATO_FILE"&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:DESCR_STATO_FILE"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:ESITO"&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:ESITO"/&gt;&lt;/ns:ESITO&gt;&lt;/xsl:if&gt;&