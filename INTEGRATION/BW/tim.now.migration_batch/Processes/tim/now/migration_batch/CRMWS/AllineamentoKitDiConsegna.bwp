                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogStaging-input"
                                    name="LogStaging"
                                    tibex:xpdlId="751e9acd-a697-4aa9-a779-a4fb8ce42352" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
