                tibex:faultNameVar="FaultName1" tibex:xpdlId="bd458eaf-56c8-4fdf-a13c-15c889cd8f88">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="Log_ErrToAssign" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="Error_RenameFileToRenameFile1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="RenameFile_ErrorToLog" tibex:linkType="SUCCESS"/>
                            <bpws:link name="LogToExit3" tibex:linkType="SUCCESS"/>
                            <bpws:link name="RenameFile_ErrorToExit3" tibex:linkType="ERROR"/>
                            <bpws:link
