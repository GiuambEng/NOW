                                    expression="if (string-length($FilePoller/fileInfo/fileName)>0) then concat($PathFileError, 'ERROR_', substring-before( $FilePoller/fileInfo/fileName,'.csv.ctr' ), $Estensione) else concat($PathFileError, $NomeFileError, format-dateTime(current-dateTime(), &quot;[Y0001][M01][D01]_[H01][m01][s01]&quot;), $Estensione)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
