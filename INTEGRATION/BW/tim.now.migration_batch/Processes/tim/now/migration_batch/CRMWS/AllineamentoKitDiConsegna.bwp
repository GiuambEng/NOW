            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvokeProcessLogger&quot;/>&lt;xsl:template name=&quot;LogOutput_LoggerProcess-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;tib:render-xml($InvokeProcessLogger/part1/ns:Output)&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogOutput_LoggerProcess-input"
                    name="LogOutput_LoggerProcess"
                    tibex:xpdlId="b63272bc-f3f8-43f0-b899-da7ad36c819c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
