                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7d82c26f-cea8-494e-945e-a7e11cd8f19e+input&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvokeProcessLogger&quot;/>&lt;xsl:param name=&quot;ReadFile&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($InvokeProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&lt;/ID_FILE>&lt;SISTEMA>&lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&lt;/SISTEMA>&lt;FLUSSO>&lt;xsl:value-of select=&quot;'AnagraficaKit'&quot;/>&lt;/FLUSSO>&lt;DETAILS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ReadFile/tns1:FileName)&quot;>&lt;xsl:value-of select=&quot;$ReadFile/tns1:FileName&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DETAILS>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(),true())&quot;/>&lt;/DESCR_ERRORE>&lt;STATO>&lt;xsl:value-of select=&quot;'KO TECNICO'&quot;/>&lt;/STATO>&lt;ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($InvokeProcessLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ID_ESEC_PROCSO_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="JDBCUpdate-input"
                                name="JDBCUpdate"
                                outputVariable="JDBCUpdate"
                                tibex:xpdlId="7d82c26f-cea8-494e-945e-a7e11cd8f19e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
