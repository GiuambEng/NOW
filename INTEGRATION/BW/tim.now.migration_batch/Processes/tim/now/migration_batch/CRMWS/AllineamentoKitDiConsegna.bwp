                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InputStagingToLogStaging"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/log/AllineamentoKitDiConsegna_Staging/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoKitDiConsegna_Noval&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Dettagli&quot;/>&#xa;    &lt;xsl:param name=&quot;LastDetail&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELAB_RECORD_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoRecord&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:template name=&quot;InputStaging&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($LastDetail/Rows/tns1:Allineamentokitdiconsegna_Dettaglio_Noval)= 0&quot;>&#xa;                &lt;ns:AllineamentoKitDiConsegna>&#xa;                    &lt;xsl:for-each select=&quot;$Dettagli/Rows/tns1:Allineamentokitdiconsegna_Dettaglio_Noval&quot;>&#xa;                        &lt;ns:AllineamentoKitDiConsegna_dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1) ) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:CLLI_SEDE&quot;>&#xa;                                &lt;ns:CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CLLI_SEDE&quot;/>&#xa;                                &lt;/ns:CLLI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ADR_CODE&quot;>&#xa;                                &lt;ns:COD_AREA_RACCOLTA>&#xa;                      