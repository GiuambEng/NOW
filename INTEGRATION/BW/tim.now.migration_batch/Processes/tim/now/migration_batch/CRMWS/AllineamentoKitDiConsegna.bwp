   &lt;ns:DEC_ATTIVAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DEC_ATT&quot;/>&#xa;                                &lt;/ns:DEC_ATTIVAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ADR_DESC&quot;>&#xa;                                &lt;ns:DESC_AREA_RACCOLTA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ADR_DESC&quot;/>&#xa;                                &lt;/ns:DESC_AREA_RACCOLTA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$InvokeProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;>&#xa;                                &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$InvokeProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;/>&#xa;                                &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TD_KIT_PRIME_CONTRACTOR&quot;>&#xa;                                &lt;ns:ID_PRIME_CONTRACTOR>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TD_KIT_PRIME_CONTRACTOR&quot;/>&#xa;                                &lt;/ns:ID_PRIME_CONTRACTOR>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;tns1:STATO&quot;>&#xa;                                &lt;ns:STATO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:STATO&quot;/>&#xa;                                &lt;/n