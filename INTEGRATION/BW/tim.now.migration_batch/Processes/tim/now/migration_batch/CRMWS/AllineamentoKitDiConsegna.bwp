tns1:CLLI_SEDE&quot;>&lt;ns:CLLI>&lt;xsl:value-of select=&quot;tns1:CLLI_SEDE&quot;/>&lt;/ns:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ADR_CODE&quot;>&lt;ns:COD_AREA_RACCOLTA>&lt;xsl:value-of select=&quot;tns1:ADR_CODE&quot;/>&lt;/ns:COD_AREA_RACCOLTA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:TD_KIT&quot;>&lt;ns:COD_KIT>&lt;xsl:value-of select=&quot;tns1:TD_KIT&quot;/>&lt;/ns:COD_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:OLO_CODE&quot;>&lt;ns:COD_OLO>&lt;xsl:value-of select=&quot;tns1:OLO_CODE&quot;/>&lt;/ns:COD_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:OLO_CODING&quot;>&lt;ns:CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;tns1:OLO_CODING&quot;/>&lt;/ns:CODFC_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DEC&quot;>&lt;ns:DEC>&lt;xsl:value-of select=&quot;tns1:DEC&quot;/>&lt;/ns:DEC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DEC_ATT&quot;>&lt;ns:DEC_ATTIVAZIONE>&lt;xsl:value-of select=&quot;tns1:DEC_ATT&quot;/>&lt;/ns:DEC_ATTIVAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ADR_DESC&quot;>&lt;ns:DESC_AREA_RACCOLTA>&lt;xsl:value-of select=&quot;tns1:ADR_DESC&quot;/>&lt;/ns:DESC_AREA_RACCOLTA>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvokeProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;>&lt;ns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$InvokeProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;/>&lt;/ns:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:TD_KIT_PRIME_CONTRACTOR&quot;>&lt;ns:ID_PRIME_CONTRACTOR>&lt;xsl:value-of select=&quot;tns1:TD_KIT_PRIME_CONTRACTOR&quot;/>&lt;/ns:ID_PRIME_CONTRACTOR>&lt;/xsl:if>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var