                                    expression="($Invoke_Counter/part1/ns7:contaRecord_Output/ns7:NumeroRecord=0 and$Invoke_Counter/part1/ns7:contaRecord_Output/ns7:out='OK') or ($Invoke_Counter/part1/ns7:contaRecord_Output/ns7:out='KO')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($Invoke_Counter.part1/ns7:NumeroRecord=0 and$Invoke_Counter.part1/ns7:out='OK') or ($Invoke_Counter.part1/ns7:out='KO')]]></bpws:transitionCondition>
