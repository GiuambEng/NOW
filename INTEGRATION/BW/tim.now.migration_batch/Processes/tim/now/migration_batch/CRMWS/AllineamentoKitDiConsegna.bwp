SEC&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneNOFileProcessato/ns:STATO_ESEC"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneNOFileProcessato/ns:TMSP_FINE_ELAB"&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneNOFileProcessato/ns:TMSP_FINE_ELAB"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneNOFileProcessato/ns:TMSP_INIZIO_ELAB"&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneNOFileProcessato/ns:TMSP_INIZIO_ELAB"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:if&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL"&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE"&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO"&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessa