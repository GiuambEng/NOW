                                    <value
                                    batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.STAG_ANAG_KIT_FILE (CLLI, COD_AREA_RACCOLTA,&#xa;  COD_KIT, COD_OLO, CODFC_OLO_AGCOM, CONTENUTO_RECD, DEC, DEC_ATTIVAZIONE,&#xa;  DESC_AREA_RACCOLTA, ID_FILE_PROCSTO_INPUT, ID_PRIME_CONTRACTOR,&#xa;  ID_STATO_ELAB_STAG, NUMERO_RECD, STATO, TMSP_INSMTO)&#xa;  VALUES (?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)), ?, ?, ?, ?, ?, ?, ?, ?, ?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

