E&quot;>&lt;tns1:PREFISSO_MOBILE>&lt;xsl:value-of select=&quot;$var/tns1:PREFISSO_MOBILE&quot;/>&lt;/tns1:PREFISSO_MOBILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:NUMERO_MOBILE&quot;>&lt;tns1:NUMERO_MOBILE>&lt;xsl:value-of select=&quot;$var/tns1:NUMERO_MOBILE&quot;/>&lt;/tns1:NUMERO_MOBILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:MOBILE_ALTERNATIVO&quot;>&lt;tns1:MOBILE_ALTERNATIVO>&lt;xsl:value-of select=&quot;$var/tns1:MOBILE_ALTERNATIVO&quot;/>&lt;/tns1:MOBILE_ALTERNATIVO>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:PREFISSO_FISSO&quot;>&lt;tns1:PREFISSO_FISSO>&lt;xsl:value-of select=&quot;$var/tns1:PREFISSO_FISSO&quot;/>&lt;/tns1:PREFISSO_FISSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:NUMERO_FISSO&quot;>&lt;tns1:NUMERO_FISSO>&lt;xsl:value-of select=&quot;$var/tns1:NUMERO_FISSO&quot;/>&lt;/tns1:NUMERO_FISSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:FISSO_ALTERNATIVO&quot;>&lt;tns1:FISSO_ALTERNATIVO>&lt;xsl:value-of select=&quot;$var/tns1:FISSO_ALTERNATIVO&quot;/>&lt;/tns1:FISSO_ALTERNATIVO>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:CODICE_REFERENTE&quot;>&lt;tns1:CODICE_REFERENTE>&lt;xsl:value-of select=&quot;$var/tns1:CODICE_REFERENTE&quot;/>&lt;/tns1:CODICE_REFERENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:Numero_Record&quot;>&lt;tns1:Numero_Record>&lt;xsl:value-of select=&quot;$var/tns1:Numero_Record&quot;/>&lt;/tns1:Numero_Record>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($var/tns1:Flag_Validita)>0 and( $var/tns1:Flag_Validita!=&amp;quot;&amp;#xD;&amp;quot;)&quot;>&lt;tns1:Stato>&lt;xsl:value-of select=&quot;'3'&quot;/>&lt;/tns1:Stato>&lt;tns1:DescrizioneErrore>&lt;xsl:value-of select=&quot;'NON CONFORMITA DEL RECORD'&quot;/>&lt;/tns1:DescrizioneErrore>&lt;tns1:Record>&lt;xsl:value-of select=&quot;tib:render-xml($var)&quot;/>&lt;/tns1:Record>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Stato>&lt;xsl:value-of select=&quot;'4'&quot;/>&lt;/tns1:Stato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$var/tns1:ID_FILE&quot;>&lt;tns1:ID_FILE>&lt;xsl:value-of select=&quot;$var/tns1:ID_FILE&quot;/>&lt;/tns1:ID_FILE>&lt;/xsl:if>&lt;/tns1:AllineamentoContattiOLO_dettaglio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
