                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.AllineamentoContattiOLONoval&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ContantiOLOIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Record&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:AllineamentoContattiOLO_dettaglio>&#xa;            &lt;xsl:variable name=&quot;var&quot; select=&quot;$ContantiOLOIn.parameters/tns1:AllineamentoContattiOLO_dettaglio[number($index)]&quot;/>&#xa;            &lt;xsl:if test=&quot;$var/tns1:Tipo_record&quot;>&#xa;                &lt;tns1:Tipo_record>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:Tipo_record&quot;/>&#xa;                &lt;/tns1:Tipo_record>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:ID_CONTATTO&quot;>&#xa;                &lt;tns1:ID_CONTATTO>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:ID_CONTATTO&quot;/>&#xa;                &lt;/tns1:ID_CONTATTO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:ID_INDIRIZZO&quot;>&#xa;                &lt;tns1:ID_INDIRIZZO>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:ID_INDIRIZZO&quot;/>&#xa;                &lt;/tns1:ID_INDIRIZZO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:NOME&quot;>&#xa;                &lt;tns1:NOME>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:NOME&quot;/>&#xa;                &lt;/tns1:NOME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:COGNOME&quot;>&#xa;                &lt;tns1:COGNOME>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:COGNOME&quot;/>&#xa; 