;tns1:P.TOPONOMASTICA>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:P.TOPONOMASTICA&quot;/>&#xa;                &lt;/tns1:P.TOPONOMASTICA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:COD_ISTAT_INDIRIZZO&quot;>&#xa;                &lt;tns1:COD_ISTAT_INDIRIZZO>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:COD_ISTAT_INDIRIZZO&quot;/>&#xa;                &lt;/tns1:COD_ISTAT_INDIRIZZO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:NUMERO_CIVICO&quot;>&#xa;                &lt;tns1:NUMERO_CIVICO>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:NUMERO_CIVICO&quot;/>&#xa;                &lt;/tns1:NUMERO_CIVICO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:COD_ISTAT_COMUNE&quot;>&#xa;                &lt;tns1:COD_ISTAT_COMUNE>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:COD_ISTAT_COMUNE&quot;/>&#xa;                &lt;/tns1:COD_ISTAT_COMUNE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:PROVINCIA&quot;>&#xa;                &lt;tns1:PROVINCIA>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:PROVINCIA&quot;/>&#xa;                &lt;/tns1:PROVINCIA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:COD_ISTAT_PROVINCIA&quot;>&#xa;                &lt;tns1:COD_ISTAT_PROVINCIA>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:COD_ISTAT_PROVINCIA&quot;/>&#xa;                &lt;/tns1:COD_ISTAT_PROVINCIA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:CAP&quot;>&#xa;                &lt;tns1:CAP>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:CAP&quot;/>&#xa;                &lt;/tns1:CAP>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:FAX&quot;>&#xa;                &lt;tns1:FAX>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:FAX&quot;/>&#xa;                &lt;/tns1:FAX>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:PREFISSO_MOBILE&quot;>&#xa;                &lt;tns1:PREFISSO_MOBILE>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:PREFISSO_MOBILE&quot;/>&#xa;                &lt;/tns1:PREFISSO_MOBILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:NUMERO_MOBILE&quot;>&#xa;                &lt;tns1:NUMERO_MOBILE>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:NUMERO_MOBILE&quot;/>&#xa;                &lt;/tns1:NUMERO_MOBILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:MOBILE_ALTERNATIVO&quot;>&#xa;                &lt;tns1:MOBILE_ALTERNATIVO>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:MOBILE_ALTERNATIVO&quot;/>&#xa;                &lt;/tns1:MOBILE_ALTERNATIVO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:PREFISSO_FISSO&quot;>&#xa;                &lt;tns1:PREFISSO_FISSO>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:PREFISSO_FISSO&quot;/>&#xa;                &lt;/tns1:PREFISSO_FISSO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:NUMERO_FISSO&quot;>&#xa;                &lt;tns1:NUMERO_FISSO>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:NUMERO_FISSO&quot;/>&#xa;                &lt;/tns1:NUMERO_FISSO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:FISSO_ALTERNATIVO&quot;>&#xa;                &lt;tns1:FISSO_ALTERNATIVO>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:FISSO_ALTERNATIVO&quot;/>&#xa;                &lt;/tns1:FISSO_ALTERNATIVO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:CODICE_REFERENTE&quot;>&#xa;                &lt;tns1:CODICE_REFERENTE>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:CODICE_REFERENTE&quot;/>&#xa;                &lt;/tns1:CODICE_REFERENTE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns1:Numero_Record&quot;>&#xa;                &lt;tns1:Numero_Record>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:Numero_Record&quot;/>&#xa;                &lt;/tns1:Numero_Record>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:Stato>&#xa;                &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;            &lt;/tns1:Stato>&#xa;            &lt;tns1:DescrizioneErrore>&#xa;                &lt;xsl:value-of select=&quot;concat('RECORD IN ERRORE:       ',substring(tib:render-xml($_error),1,200))&quot;/>&#xa;            &lt;/tns1:DescrizioneErrore>&#xa;            &lt;tns1:Record>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($var)&quot;/>&#xa;            &lt;/tns1:Record>&#xa;            &lt;xsl:if test=&quot;$var/tns1:ID_FILE&quot;>&#xa;                &lt;tns1:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns1:ID_FILE&quot;/>&#xa;                &lt;/tns1:ID_FILE>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:AllineamentoContattiOLO_dettaglio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
