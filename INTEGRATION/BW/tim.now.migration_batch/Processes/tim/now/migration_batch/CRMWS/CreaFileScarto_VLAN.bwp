                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.now.sharedlibrary.crea.file.scarto" xmlns:tns="http://xmlns.example.com/1463585496988" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="CreaFIleScarto-input" match="/"&gt;&lt;tns:Request&gt;&lt;part1&gt;&lt;ns:FileScartoInput&gt;&lt;xsl:if test="$Start/ns:NomeTabella"&gt;&lt;ns:NomeTabella&gt;&lt;xsl:value-of select="$Start/ns:NomeTabella"/&gt;&lt;/ns:NomeTabella&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:IdFile"&gt;&lt;ns:IdFile&gt;&lt;xsl:value-of select="$Start/ns:IdFile"/&gt;&lt;/ns:IdFile&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Passo"&gt;&lt;ns:Passo&gt;&lt;xsl:value-of select="$Start/ns:Passo"/&gt;&lt;/ns:Passo&gt;&lt;/xsl:if&gt;&lt;/ns:FileScartoInput&gt;&lt;/part1&gt;&lt;/tns:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
