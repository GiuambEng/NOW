t=&quot;tns1:TIPO&quot;>&lt;ns:TIPO>&lt;xsl:value-of select=&quot;tns1:TIPO&quot;/>&lt;/ns:TIPO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:TIPO_TRASPORTO&quot;>&lt;ns:TIPO_TRASPORTO>&lt;xsl:value-of select=&quot;tns1:TIPO_TRASPORTO&quot;/>&lt;/ns:TIPO_TRASPORTO>&lt;/xsl:if>&lt;ns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INSMTO>&lt;xsl:if test=&quot;tns1:VPI&quot;>&lt;ns:VPI>&lt;xsl:value-of select=&quot;tns1:VPI&quot;/>&lt;/ns:VPI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:VPI_RETE&quot;>&lt;ns:VPI_RETE>&lt;xsl:value-of select=&quot;tns1:VPI_RETE&quot;/>&lt;/ns:VPI_RETE>&lt;/xsl:if>&lt;/ns:AllineamentoVP_dettaglio>&lt;/xsl:for-each>&lt;/ns:AllineamentoVP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
