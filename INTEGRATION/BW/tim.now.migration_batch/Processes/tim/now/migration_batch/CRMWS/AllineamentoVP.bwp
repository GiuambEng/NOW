                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVP_SubProcess&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVP_Tracciato&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LastDetail&quot;/>&lt;xsl:param name=&quot;detail&quot;/>&lt;xsl:param name=&quot;Passo_CRMWS_VP&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;InvokeProcessLogger&quot;/>&lt;xsl:template name=&quot;Input_Sub&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($LastDetail/Rows/tns1:AllineamentoVP_Dettaglio_Noval) =0&quot;>&lt;tns:AllineamentoVP_Noval>&lt;xsl:for-each select=&quot;$detail/Rows/tns1:AllineamentoVP_Dettaglio_Noval&quot;>&lt;tns:AllineamentoVP_Dettaglio_Noval>&lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&lt;tns:Tipo_record>&lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&lt;/tns:Tipo_record>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ID_RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;tns1:ID_RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:STATO&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;tns1:STATO&quot;/>&lt;/tns:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:MOD_FATT&quot;>&lt;tns:MOD_FATT>&lt;xsl:value-of select=&quot;tns1:MOD_FATT&quot;/>&lt;/tns:MOD_FATT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:TIPO&quot;>&lt;tns:TIPO>&lt;xsl:value-of select=&quot;tns1:TIPO&quot;/>&lt;/tns:TIPO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:BANDA_MCR&quot;>&lt;tns:BANDA_MCR>&lt;xsl:value-of select=&quot;tns1:BANDA_MCR&quot;/>&lt;/tns:BANDA_MCR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:BANDA_PCR&quot;>&lt;tns:BANDA_PCR>&lt;xsl:value-of select=&quot;tns1:BANDA_PCR&quot;/>&lt;/tns:BANDA_PCR>&lt