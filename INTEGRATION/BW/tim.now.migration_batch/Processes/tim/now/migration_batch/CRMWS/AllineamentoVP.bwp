                                    DataTypeDisplayValue="VARCHAR" ParameterName="DEC"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DEC_ATTIVAZIONE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESC_AREA_RACCOLTA"/>

                                    <PreparedParameters
