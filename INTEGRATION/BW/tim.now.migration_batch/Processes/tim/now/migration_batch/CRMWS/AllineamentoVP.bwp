                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO_TRASPORTO"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TMSP_INSMTO"/>

