                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/log/AllineamentoVP_Staging/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVP_Tracciato&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LastDetail&quot;/>&lt;xsl:param name=&quot;detail&quot;/>&lt;xsl:param name=&quot;OK_ELAB_RECORD_FILE&quot;/>&lt;xsl:param name=&quot;Passo_CRMWS_VP&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;InvokeProcessLogger&quot;/>&lt;xsl:param name=&quot;ContenutoRecord&quot;/>&lt;xsl:template name=&quot;InputStaging&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($LastDetail/Rows/tns1:AllineamentoVP_Dettaglio_Noval) =0&quot;>&lt;ns:AllineamentoVP>&lt;xsl:for-each select=&quot;$detail/Rows/tns1:AllineamentoVP_Dettaglio_Noval&quot;>&lt;ns:AllineamentoVP_dettaglio>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_CRMWS_VP * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:BANDA_MCR&quot;>&lt;ns:BANDA_MCR>&lt;xsl:value-of select=&quot;tns1:BANDA_MCR&quot;/>&lt;/ns:BANDA_MCR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:BANDA_PCR&quot;>&lt;ns:BANDA_PCR>&lt;xsl:value-of select=&quot;tns1:BANDA_PCR&quot;/>&lt;/ns:BANDA_PCR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CLLI&quot;>&lt;ns:CLLI>&lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&lt;/ns:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ADR_CODE&quot;>&lt;ns:COD_AREA_RACCOLTA>&lt;xsl:value-of select=&quot;tns1:ADR_CODE&quot;/>&lt;/ns:COD_AREA_RACCOLTA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:TD_KIT&quot;>&lt;ns:COD_KIT>&lt;xsl:value-of select=&quot;tns1:TD_KIT&quot;/>&lt;/ns:COD_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:OLO_CODE&quot;>&lt;ns:COD_OLO>&lt;xsl:value-of select=&quot;tns1:OLO_CODE&quot;/>&lt;/ns:COD_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ID_RISORSA&quot;>&lt;ns:COD_VP>&lt;xsl:value-of select=&quot;tns1:ID_RISORSA&quot;/>&lt;/ns:COD_VP>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:OLO_CODING&quot;>&lt;ns:CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;tns1:OLO_CODING&quot;/>&lt;/ns:CODFC_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DEC&quot;>&lt;ns:DEC>&lt;xsl:value-of select=&quot;tns1:DEC&quot;/>&lt;/ns:DEC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DEC_ATT&quot;>&lt;ns:DEC_ATTIVAZIONE>&lt;xsl:value-of select=&quot;tns1:DEC_ATT&quot;/>&lt;/ns:DEC_ATTIVAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DESC_ADR&quot;>&lt;ns:DESC_AREA_RACCOLTA>&lt;xsl:value-of select=&quot;tns1:DESC_ADR&quot;/>&lt;/ns:DESC_AREA_RACCOLTA>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvokeProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;>&lt;ns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$InvokeProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;/>&lt;/ns:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;xsl:if test=&quot;tns1:MOD_FATT&quot;>&lt;ns:MODALITA_FATTURAZIONE>&lt;xsl:value-of select=&quot;tns1:MOD_FATT&quot;/>&lt;/ns:MODALITA_FATTURAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:NOME_CENTRALE&quot;>&lt;ns:NOME_CENTRALE>&lt;xsl:value-of select=&quot;tns1:NOME_CENTRALE&quot;/>&lt;/ns:NOME_CENTRALE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:NR_MAX_VC&quot;>&lt;ns:NUMERO_MAX_VC>&lt;xsl:value-of select=&quot;tns1:NR_MAX_VC&quot;/>&lt;/ns:NUMERO_MAX_VC>&lt;/xsl:if>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var&quot;/>&lt;/ns:NUMERO_RECD>&lt;xsl:if test=&quot;tns1:STATO&quot;>&lt;ns:STATO>&lt;xsl:value-of select=&quot;tns1:STATO&quot;/>&lt;/ns:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:TIPO&quot;>&lt;ns:TIPO>&lt;xsl:value-of select=&quot;tns1:TIPO&quot;/>&lt;/ns:TIPO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:TIPO_TRASPORTO&quot;>&lt;ns:TIPO_TRASPORTO>&lt;xsl:value-of select=&quot;tns1:TIPO_TRASPORTO&quot;/>&lt;/ns:TIPO_TRASPORTO>&lt;/xsl:if>&lt;ns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INSMTO>&lt;xsl:if test=&quot;tns1:VPI&quot;>&lt;ns:VPI>&lt;xsl:value-of select=&quot;tns1:VPI&quot;/>&lt;/ns:VPI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:VPI_RETE&quot;>&lt;ns:VPI_RETE>&lt;xsl:value-of select=&quot;tns1:VPI_RETE&quot;/>&lt;/ns:VPI_RETE>&lt;/xsl:if>&lt;/ns:AllineamentoVP_dettaglio>&lt;/xsl:for-each>&lt;/ns:AllineamentoVP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:AllineamentoVP>&lt;xsl:for-each select=&quot;$LastDetail/Rows/tns1:AllineamentoVP_Dettaglio_Noval&quot;>&lt;ns:AllineamentoVP_dettaglio>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo_CRMWS_VP* ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:BANDA_MCR&quot;>&lt;ns:BANDA_MCR>&lt;xsl:value-of select=&quot;tns1:BANDA_MCR&quot;/>&lt;/ns:BANDA_MCR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:BANDA_PCR&quot;>&lt;ns:BANDA_PCR>&lt;xsl:value-of select=&quot;tns1:BANDA_PCR&quot;/>&lt;/ns:BANDA_PCR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CLLI&quot;>&lt;ns:CLLI>&lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&lt;/ns:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ADR_CODE&quot;>&lt;ns:COD_AREA_RACCOLTA>&lt;xsl:value-of select=&quot;tns1:ADR_CODE&quot;/>&lt;/ns:COD_AREA_RACCOLTA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:TD_KIT&quot;>&lt;ns:COD_KIT>&lt;xsl:value-of select=&quot;tns1:TD_KIT&quot;/>&lt;/ns:COD_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:OLO_CODE&quot;>&lt;ns:COD_OLO>&lt;xsl:value-of select=&quot;tns1:OLO_CODE&quot;/>&lt;/ns:COD_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ID_RISORSA&quot;>&lt;ns:COD_