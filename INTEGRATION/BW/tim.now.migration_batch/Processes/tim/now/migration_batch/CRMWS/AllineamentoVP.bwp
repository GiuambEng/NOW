t;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESC_AREA_RACCOLTA>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal(ns:ID_FILE_PROCSTO_INPUT)&quot;/>&lt;/ID_FILE_PROCSTO_INPUT>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:decimal(ns:ID_STATO_ELAB_STAG)&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;MODALITA_FATTURAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:MODALITA_FATTURAZIONE)&quot;>&lt;xsl:value-of select=&quot;ns:MODALITA_FATTURAZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/MODALITA_FATTURAZIONE>&lt;NOME_CENTRALE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:NOME_CENTRALE)&quot;>&lt;xsl:value-of select=&quot;ns:NOME_CENTRALE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME_CENTRALE>&lt;NUMERO_MAX_VC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:NUMERO_MAX_VC)&quot;>&lt;xsl:value-of select=&quot;ns:NUMERO_MAX_VC&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NUMERO_MAX_VC>&lt;NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:decimal(ns:NUMERO_RECD)&quot;/>&lt;/NUMERO_RECD>&lt;STATO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:STATO)&quot;>&lt;xsl:value-of select=&quot;ns:STATO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STATO>&lt;TIPO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:TIPO)&quot;>&lt;xsl:value-of select=&quot;ns:TIPO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIPO>&lt;TIPO_TRASPORTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:TIPO_TRASPORTO)&quot;>&lt;xsl:value-of select=&quot;ns:TIPO_TRASPORTO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIPO_TRASPORTO>&lt;TMSP_INSMTO>&lt;xsl:value-of select=&quot;xsd:dateTime(ns:TMSP_INSMTO)&quot;/>&lt;/TMSP_INSMTO>&lt;VPI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:VPI)&quot;>&lt;xsl:value-of select=&quot;ns:VPI&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/VPI>&lt;VPI_RETE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:VPI_RETE)&quot;>&lt;xsl:value-of select=&quot;ns:VPI_RETE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/VPI_RETE>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_ANAG_VP_FILE (BANDA_MCR, BANDA_PCR, CLLI,&#xa;  COD_AREA_RACCOLTA, COD_KIT, COD_OLO, COD_VP, CODFC_OLO_AGCOM,&#xa;  CONTENUTO_RECD, DEC, DEC_ATTIVAZIONE, DESC_AREA_RACCOLTA, ID_FILE_PROCSTO_INPUT,&#xa;  ID_STATO_ELAB_STAG, MODALITA_FATTURAZIONE, NOME_CENTRALE, NUMERO_MAX_VC,&#xa;  NUMERO_RECD, STATO, TIPO, TIPO_TRASPORTO, TMSP_INSMTO, VPI,&#xa;  VPI_RETE)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)), ?, ?, ?, ?, ?, ?, ?, ?, ?,&#xa;    ?, ?, ?, ?, ?, ?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="BANDA_MCR"/>

                                    <PreparedParameters
