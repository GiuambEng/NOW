f select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:ID_INTRFC&quot;/>&#xa;                    &lt;/ns:ID_INTRFC>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE&quot;>&#xa;                    &lt;ns:IDTPLG_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE&quot;/>&#xa;                    &lt;/ns:IDTPLG_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:NOME_FILE&quot;>&#xa;                    &lt;ns:NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:NOME_FILE&quot;/>&#xa;                    &lt;/ns:NOME_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;>&#xa;                    &lt;ns:TIMSTP_APERTURA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;/>&#xa;                    &lt;/ns:TIMSTP_APERTURA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;>&#xa;                    &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;/>&#xa;                    &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:VERSO_DEL_FILE&quot;>&#xa;                    &lt;ns:VERSO_DEL_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:VERSO_DEL_FILE&quot;/>&#xa;                    &lt;/ns:VERSO_DEL_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessato>&#xa;    