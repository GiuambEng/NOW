lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL&quot;>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE&quot;>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO&quot;>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:LogFileProcessato>&#xa;            &lt;ns:FileProcessatoOutput>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE&quot;>&#xa;                    &lt;ns:DIMENSIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE&quot;/>&#xa;                    &lt;/ns:DIMENSIONE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ESITO_INVIO&quot;>&#xa;                    &lt;ns:ESITO_INVIO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ESITO_INVIO&quot;/>&#xa;                    &lt;/ns:ESITO_INVIO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT&quot;>&#xa;                    &lt;ns:ID_FILE_PROCSTO_OUTPUT>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT&quot;/>&#xa;                    &lt;/ns:ID_FILE_PROCSTO_OUTPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI&quot;>&#xa;                    &lt;ns:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI&quot;/>&#xa;                    &lt;/ns:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE&quot;>&#xa;                    &lt;ns:TIMSTP_CREZIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE&quot;/>&#xa;                    &lt;/ns:TIMSTP_CREZIONE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_INVIO&quot;>&#xa;                    &lt;ns:TIMSTP_INVIO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_INVIO&quot;/>&#xa;                    &lt;/ns:TIMSTP_INVIO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessatoOutput>&#xa;            &lt;ns:ContenutoFile>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:ContenutoFile/ns:ID_CONTENUTO_FILE&quot;>&#xa;                    &lt;ns:ID_CONTENUTO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:ContenutoFile/ns:ID_CONTENUTO_FILE&quot;/>&#xa;                    &lt;/ns:ID_CONTENUTO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:ContenutoFile/ns:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:ContenutoFile/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:ContenutoFile/ns:FullName&quot;>&#xa;                    &lt;ns:FullName>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:ContenutoFile/ns:FullName&quot;/>&#xa;                    &lt;/ns:FullName>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:ContenutoFile>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
