                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMERO_MAX_VC"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="NUMERO_RECD"/>

