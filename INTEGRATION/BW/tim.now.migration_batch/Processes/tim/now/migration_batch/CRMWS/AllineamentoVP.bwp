                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/log/AllineamentoVP_Staging/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVP_Tracciato&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;LastDetail&quot;/>&#xa;    &lt;xsl:param name=&quot;detail&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELAB_RECORD_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo_CRMWS_VP&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoRecord&quot;/>&#xa;    &lt;xsl:template name=&quot;InputStaging&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($LastDetail/Rows/tns1:AllineamentoVP_Dettaglio_Noval) =0&quot;>&#xa;                &lt;ns:AllineamentoVP>&#xa;                    &lt;xsl:for-each select=&quot;$detail/Rows/tns1:AllineamentoVP_Dettaglio_Noval&quot;>&#xa;                        &lt;ns:AllineamentoVP_dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_CRMWS_VP * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:BANDA_MCR&quot;>&#xa;                                &lt;ns:BANDA_MCR>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:BANDA_MCR&quot;/>&#xa;                                &lt;/ns:BANDA_MCR>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:BANDA_PCR&quot;>&#xa;                                &lt;ns:BANDA_PCR>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:BANDA_PCR&quot;/>&#xa;                                &lt;/ns:BANDA_PCR>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CLLI&quot;>&#xa;                                &lt;ns:CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&#xa;                                &lt;/ns:CLLI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ADR_CODE&quot;>&#xa;                                &lt;ns:COD_AREA_RACCOLTA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ADR_CODE&quot;/>&#xa;                                &lt;/ns:COD_AREA_RACCOLTA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TD_KIT&quot;>&#xa;                                &lt;ns:COD_KIT>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TD_KIT&quot;/>&#xa;                                &lt;/ns:COD_KIT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CODE&quot;>&#xa;                                &lt;ns:COD_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CODE&quot;/>&#xa;                                &lt;/ns:COD_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ID_RISORSA&quot;>&#xa;                                &lt;ns:COD_VP>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ID_RISORSA&quot;/>&#xa;                                &lt;/ns:COD_VP>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CODING&quot;>&#xa;                                &lt;ns:CODFC_OLO_AGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CODING&quot;/>&#xa;                                &lt;/ns:CODFC_OLO_AGCOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;>&#xa;                                &lt;ns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;/>&#xa;                                &lt;/ns:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DEC&quot;>&#xa;                                &lt;ns:DEC>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DEC&quot;/>&#xa;                                &lt;/ns:DEC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DEC_ATT&quot;>&#xa;                                &lt;ns:DEC_ATTIVAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DEC_ATT&quot;/>&#xa;                                &lt;/ns:DEC_ATTIVAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DESC_ADR&quot;>&#xa;                                &lt;ns:DESC_AREA_RACCOLTA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DESC_ADR&quot;/>&#xa;                                &lt;/ns:DESC_AREA_RACCOLTA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$InvokeProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;>&#xa;                                &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$InvokeProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;/>&#xa;                                &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:if test=&quot;tns1:MOD_FATT&quot;>&#xa;                                &lt;ns:MODALITA_FATTURAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:MOD_FATT&quot;/>&#xa;                                &lt;/ns:MODALITA_FATTURAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:NOME_CENTRALE&quot;>&#xa;                                &lt;ns:NOME_CENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:NOME_CENTRALE&quot;/>&#xa;                                &lt;/ns:NOME_CENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:NR_MAX_VC&quot;>&#xa;                                &lt;ns:NUMERO_MAX_VC>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:NR_MAX_VC&quot;/>&#xa;                                &lt;/ns:NUMERO_MAX_VC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;tns1:STATO&quot;>&#xa;                                &lt;ns:STATO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:STATO&quot;/>&#xa;                                &lt;/ns:STATO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TIPO&quot;>&#xa;                                &lt;ns:TIPO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TIPO&quot;/>&#xa;                                &lt;/ns:TIPO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TIPO_TRASPORTO&quot;>&#xa;                                &lt;ns:TIPO_TRASPORTO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TIPO_TRASPORTO&quot;/>&#xa;                                &lt;/ns:TIPO_TRASPORTO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TMSP_INSMTO>&#xa;                            &lt;xsl:if test=&quot;tns1:VPI&quot;>&#xa;                                &lt;ns:VPI>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:VPI&quot;/>&#xa;                                &lt;/ns:VPI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:VPI_RETE&quot;>&#xa;                                &lt;ns:VPI_RETE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:VPI_RETE&quot;/>&#xa;                                &lt;/ns:VPI_RETE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns:AllineamentoVP_dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/ns:AllineamentoVP>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:AllineamentoVP>&#xa;                    &lt;xsl:for-each select=&quot;$LastDetail/Rows/tns1:AllineamentoVP_Dettaglio_Noval&quot;>&#xa;                        &lt;ns:AllineamentoVP_dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo_CRMWS_VP* ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:BANDA_MCR&quot;>&#xa;                                &lt;ns:BANDA_MCR>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:BANDA_MCR&quot;/>&#xa;                                &lt;/ns:BANDA_MCR>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl: