                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVLAN_SubProcess&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVLAN_Noval&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;InvokeProcessLogger&quot;/>&lt;xsl:param name=&quot;Passo_CRMWS_VLAN&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;Input_Sub&quot; match=&quot;/&quot;>&lt;tns:AllineamentoVLAN_Noval>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($DetailNoVal/Rows/tns2:AllineamentoVLAN_Dettaglio_Noval[1]/tns2:Tipo_record)>0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns2:AllineamentoVLAN_Dettaglio_Noval&quot;>&lt;tns:AllineamentoVLAN_Dettaglio_Noval>&lt;xsl:if test=&quot;tns2:Tipo_record&quot;>&lt;tns:Tipo_record>&lt;xsl:value-of select=&quot;tns2:Tipo_record&quot;/>&lt;/tns:Tipo_record>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:IDVLAN&quot;>&lt;tns:IDVLAN>&lt;xsl:value-of select=&quot;tns2:IDVLAN&quot;/>&lt;/tns:IDVLAN>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:TIPO_BANDA&quot;>&lt;tns:TIPO_BANDA>&lt;xsl:value-of select=&quot;tns2:TIPO_BANDA&quot;/>&lt;/tns:TIPO_BANDA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:TIPO_COS&quot;>&lt;tns:TIPO_COS>&lt;xsl:value-of select=&quot;tns2:TIPO_COS&quot;/>&lt;/tns:TIPO_COS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:OLO_CODING&quot;>&lt;tns:OLO_CODING>&lt;xsl:value-of select=&quot;tns2:OLO_CODING&quot;/>&lt;/tns:OLO_CODING>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:OLO_CODE&quot;>&lt;tns:OLO_CODE>&lt;xsl:value-of select=&quot;tns2:OLO_CODE&quot;/>&lt;/tns:OLO_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:OLO_CONDIG_SUB&quot;>&lt;tns:OLO_CONDIG_SUB>&lt;xsl:value-of select=&quot;tns2:OLO_CONDIG_SUB&quot;/>&lt;/tns:OLO_CONDIG_SUB>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:OLO_CODE_SUB&quot;>&lt;tns:OLO_CODE_SUB>&lt;xsl:value-of select=&quot;tns2:OLO_CODE_SUB&quot;/>&lt;/tns:OLO_CODE_SUB>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:STATO_SUB&quot;>&lt;tns:STATO_SUB>&lt;xsl:value-of select=&quot;tns2:STATO_SUB&quot;/>&lt;/tns:STATO_SUB>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:DATA_ATTIVAZIOE_SUB&quot;>&lt;tns:DATA_ATTIVAZIOE_SUB>&lt;xsl:value-of select=&quot;tns2:DATA_ATTIVAZIOE_SUB&quot;/>&lt;/tns:DATA_ATTIVAZIOE_SUB>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:DATA_CESSAZIONE_SUB&quot;>&lt;tns:DATA_CESSAZIONE_SUB>&lt;xsl:value-of select=&quot;tns2:DATA_CESSAZIONE_SUB&quot;/>&lt;/tns:DATA_CESSAZIONE_SUB>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:ENCAPSULATION&quot;>&lt;tns:ENCAPSULATION>&lt;xsl:value-of select=&quot;tns2:ENCAPSULATION&quot;/>&lt;/tns:ENCAPSULATION>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:TIPOLOGIA&quot;>&lt;tns:TIPOLOGIA>&lt;xsl:value-of select=&quot;tns2:TIPOLOGIA&quot;/>&lt;/tns:TIPOLOGIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:STATO&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;tns2:STATO&quot;/>&lt;/tns:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:NOME&quot;>&lt;tns:NOME>&lt;xsl:value-of select=&quot;tns2:NOME&quot;/>&lt;/tns:NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:CLLI&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;tns2:CLLI&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:NOME_CENTRALE&quot;>&lt;tns:NOME_CENTRALE>&lt;xsl:value-of select=&quot;tns2:NOME_CENTRALE&quot;/>&lt;/tns:NOME_CENTRALE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:TD_KIT&quot;>&lt;tns:TD_KIT>&lt;xsl:value-of select=&quot;tns2:TD_KIT&quot;/>&lt;/tns:TD_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:DEC&quot;>&lt;tns:DEC>&lt;xsl:value-of select=&quot;tns2:DEC&quot;/>&lt;/tns:DEC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:DEC_ATT&quot;>&lt;tns:DEC_ATT>&lt;xsl:value-of select=&quot;tns2:DEC_ATT&quot;/>&lt;/tns:DEC_ATT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:ADR_CODE&quot;>&lt;tns:ADR_CODE>&lt;xsl:value-of select=&quot;tns2:ADR_CODE&quot;/>&lt;/tns:ADR_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:ADR_DESC&quot;>&lt;tns:ADR_DESC>&lt;xsl:value-of select=&quot;tns2:ADR_DESC&quot;/>&lt;/tns:ADR_DESC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:MACRO_AREA_CODE&quot;>&lt;tns:MACRO_AREA_CODE>&lt;xsl:value-of select=&quot;tns2:MACRO_AREA_CODE&quot;/>&lt;/tns:MACRO_AREA_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:MACRO_AREA_DESC&quot;>&lt;tns:MACRO_AREA_DESC>&lt;xsl:value-of select=&quot;tns2:MACRO_AREA_DESC&quot;/>&lt;/tns:MACRO_AREA_DESC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:SUPER_MACRO_AREA_CODE&quot;>&lt;tns:SUPER_MACRO_AREA_CODE>&lt;xsl:value-of select=&quot;tns2:SUPER_MACRO_AREA_CODE&quot;/>&lt;/tns:SUPER_MACRO_AREA_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:SUPER_MACRO_AREA_DESC&quot;>&lt;tns:SUPER_MACRO_AREA_DESC>&lt;xsl:value-of select=&quot;tns2:SUPER_MACRO_AREA_DESC&quot;/>&lt;/tns:SUPER_MACRO_AREA_DESC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:TIPO_TRASPORTO&quot;>&lt;tns:TIPO_TRASPORTO>&lt;xsl:value-of select=&quot;tns2:TIPO_TRASPORTO&quot;/>&lt;/tns:TIPO_TRASPORTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:IDVLANOLO&quot;>&lt;tns:IDVLANOLO>&lt;xsl:value-of select=&quot;tns2:IDVLANOLO&quot;/>&lt;/tns:IDVLANOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:FLAG_VLAN_TRANSLATION&quot;>&lt;tns:FLAG_VLAN_TRANSLATION>&lt;xsl:value-of select=&quot;tns2:FLAG_VLAN_TRANSLATION&quot;/>&lt;/tns:FLAG_VLAN_TRANSLATION>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:DSLAM_TYPE&quot;>&lt;tns:DSLAM_TYPE>&lt;xsl:value-of select=&quot;tns2:DSLAM_TYPE&quot;/>&lt;/tns:DSLAM_TYPE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:CAR&quot;>&lt;tns:CAR>&lt;xsl:value-of select=&quot;tns2:CAR&quot;/>&lt;/tns:CAR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:CUSTOMER&quot;>&lt;tns:CUSTOMER>&lt;xsl:value-of select=&quot;tns2:CUSTOMER&quot;/>&lt;/tns:CUSTOMER>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:FlagVlalidita&quot;>&lt;tns:FlagVlalidita>&lt;xsl:value-of select=&quot;tns2:FlagVlalidita&quot;/>&lt;/tns:FlagVlalidita>&lt;/xsl:if>&lt;tns:Numero_Record>&lt;xsl:value-of select=&quot;(($Passo_CRMWS_VLAN * ($index -1)) + position())&quot;/>&lt;/tns:Numero_Record>&lt;xsl:if test=&quot;$InvokeProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;$InvokeProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;/>&lt;/tns:ID_FILE>&lt;/xsl:if>&lt;/tns:AllineamentoVLAN_Dettaglio_Noval>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns2:AllineamentoVLAN_Dettaglio_Noval&quot;>&lt;tns:AllineamentoVLAN_Dettaglio_Noval>&lt;xsl:if test=&quot;tns2:Tipo_record&quot;>&lt;tns:Tipo_record>&lt;xsl:value-of select=&quot;tns2:Tipo_record&quot;/>&lt;/tns:Tipo_record>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:IDVLAN&quot;>&lt;tns:IDVLAN>&lt;xsl:value-of select=&quot;tns2:IDVLAN&quot;/>&lt;/tns:IDVLAN>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:TIPO_BANDA&quot;>&lt;tns:TIPO_BANDA>&lt;xsl:value-of select=&quot;tns2:TIPO_BANDA&quot;/>&lt;/tns:TIPO_BANDA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:TIPO_COS&quot;>&lt;tns:TIPO_COS>&lt;xsl:value-of select=&quot;tns2:TIPO_COS&quot;/>&lt;/tns:TIPO_COS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:OLO_CODING&quot;>&lt;tns:OLO_CODING>&lt;xsl:value-of select=&quot;tns2:OLO_CODING&quot;/>&lt;/tns:OLO_CODING>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:OLO_CODE&quot;>&lt;tns:OLO_CODE>&lt;xsl:value-of select=&quot;tns2:OLO_CODE&quot;/>&lt;/tns:OLO_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:OLO_CONDIG_SUB&quot;>&lt;tns:OLO_CONDIG_SUB>&lt;xsl:value-of select=&quot;tns2:OLO_CONDIG_SUB&quot;/>&lt;/tns:OLO_CONDIG_SUB>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:OLO_CODE_SUB&quot;>&lt;tns:OLO_CODE_SUB>&lt;xsl:value-of select=&quot;tns2:OLO_CODE_SUB&quot;/>&lt;/tns:OLO_CODE_SUB>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:STATO_SUB&quot;>&lt;tns:STATO_SUB>&lt;xsl:value-of select=&quot;tns2:STATO_SUB&quot;/>&lt;/tns:STATO_SUB>&lt;/xsl:if>&lt;xsl:i