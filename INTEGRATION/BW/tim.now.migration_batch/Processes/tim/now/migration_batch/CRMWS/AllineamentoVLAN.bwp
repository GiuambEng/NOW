                                    <value
                                    batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_ANAG_VLAN_FILE (CLLI, COD_AREA_RACCOLTA,&#xa;  COD_KIT, COD_MACRO_AREA, COD_OLO, COD_OLO_SUB, COD_SUPER_MACRO_AREA,&#xa;  COD_VLAN, CODFC_OLO_AGCOM, CODFC_OLO_AGCOM_SUB, DATA_ATTIVAZIONE_SUB,&#xa;  DATA_CESSAZIONE_SUB, DEC, DEC_ATTIVAZIONE, DESC_AREA_RACCOLTA,&#xa;  DESC_MACRO_AREA, DESC_SUPER_MACRO_AREA, DSLAM_TYPE, FLAG_ENCAPSULATION,&#xa;  FLAG_VLAN_TRANSLATION, ID_VLAN_OLO, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG,&#xa;  NOME, NOME_CENTRALE, NUMERO_RECD, STATO, STATO_SUB, TIPO_BANDA,&#xa;  TIPO_COS, TIPO_TRASPORTO, TIPOLG, TMSP_INSMTO, CONTENUTO_RECD,&#xa;  CAR,OPERATORERETE)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,&#xa;    ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)), ?,?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

