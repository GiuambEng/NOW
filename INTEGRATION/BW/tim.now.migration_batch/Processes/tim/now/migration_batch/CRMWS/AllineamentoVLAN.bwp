STATO_SUB>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:STATO_SUB&quot;/>&#xa;                                &lt;/tns:STATO_SUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:DATA_ATTIVAZIOE_SUB&quot;>&#xa;                                &lt;tns:DATA_ATTIVAZIOE_SUB>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:DATA_ATTIVAZIOE_SUB&quot;/>&#xa;                                &lt;/tns:DATA_ATTIVAZIOE_SUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:DATA_CESSAZIONE_SUB&quot;>&#xa;                                &lt;tns:DATA_CESSAZIONE_SUB>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:DATA_CESSAZIONE_SUB&quot;/>&#xa;                                &lt;/tns:DATA_CESSAZIONE_SUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:ENCAPSULATION&quot;>&#xa;                                &lt;tns:ENCAPSULATION>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:ENCAPSULATION&quot;/>&#xa;                                &lt;/tns:ENCAPSULATION>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:TIPOLOGIA&quot;>&#xa;                                &lt;tns:TIPOLOGIA>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:TIPOLOGIA&quot;/>&#xa;                                &lt;/tns:TIPOLOGIA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:STATO&quot;>&#xa;                                &lt;tns:STATO>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:STATO&quot;/>&#xa;                                &lt;/tns:STATO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:NOME&quot;>&#xa;               