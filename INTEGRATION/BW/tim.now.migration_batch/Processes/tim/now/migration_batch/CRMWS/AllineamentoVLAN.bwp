                partnerLink="Logger" portType="ns3:ProcessLog" tibex:xpdlId="88428fdd-41f9-4cd3-b42a-4eb2837cf4a9">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://www.tim.com/NOW/AllineamentiBatch/contaRecord/" version="2.0"&gt;&lt;xsl:param name="InvokeProcessLogger"/&gt;&lt;xsl:param name="Invoke_Counter"/&gt;&lt;xsl:template name="UpCount-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;COUNTER&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:FileProcessatoInput&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="xsd:integer($InvokeProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:if test="$Invoke_Counter/part1/ns1:contaRecord_Output/ns1:NumeroRecord"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$Invoke_Counter/part1/ns1:contaRecord_Output/ns1:NumeroRecord"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoInput&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Invoke_Counter.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;UpCount-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;COUNTER&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:FileProcessatoInput>&#xa;                &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($InvokeProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;xsl:if test=&quot;$Invoke_Counter.part1/ns1:NumeroRecord&quot;>&#xa;                    &lt;ns:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke_Counter.part1/ns1:NumeroRecord&quot;/>&#xa;                    &lt;/ns:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessatoInput>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Output_Log_counterToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpCountToWhile"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:invoke inputVariable="Update_ChiusuraFile-input"
                name="Update_ChiusuraFile" operation="Insert"
                outputVariable="Update_ChiusuraFile"
                partnerLink="Logger" portType="ns3:ProcessLog" tibex:xpdlId="16b33a71-d6d1-4776-bfa4-a63a04ddb0ae">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="InvokeProcessLogger"/&gt;&lt;xsl:param name="VersoDelFile"/&gt;&lt;xsl:param name="VLAN"/&gt;&lt;xsl:template name="Update_ChiusuraFile-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:FileProcessato&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/ns:ESITO&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="xsd:integer($InvokeProcessLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="xsd:integer($InvokeProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;&lt;/ns:ID_FILE&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="$VersoDelFile"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/ns:FileProcessato&gt;&lt;ns:FileProcessatoInput&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="xsd:integer($InvokeProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;ns:QT_RECD_KO&gt;&lt;xsl:value-of select="xsd:integer($VLAN/outputSet/COUNT_KO_ELAB_STAGING) + xsd:integer($VLAN/outputSet/COUNT_KO_ELAB_TARGET)"/&gt;&lt;/ns:QT_RECD_KO&gt;&lt;ns:QT_RECD_OK&gt;&lt;xsl:value-of select="xsd:integer($VLAN/outputSet/COUNT_OK_ELAB_TARGET)"/&gt;&lt;/ns:QT_RECD_OK&gt;&lt;/ns:FileProcessatoInput&gt;&lt;ns:EsecuzioneFile&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="xsd:integer($InvokeProcessLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;VersoDelFile&quot;/>&#xa;    &lt;xsl:param name=&quot;VLAN&quot;/>&#xa;    &lt;xsl:template name=&quot;Update_ChiusuraFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;ns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($InvokeProcessLogger.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;ns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($InvokeProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE>&#xa;                &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;ns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$VersoDelFile&quot;/>&#xa;                &lt;/ns:VERSO_DEL_FILE>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:FileProcessatoInput>&#xa;                &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($InvokeProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;ns:QT_RECD_KO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($VLAN/outputSet/COUNT_KO_ELAB_STAGING) + xsd:integer($VLAN/outputSet/COUNT_KO_ELAB_TARGET)&quot;/>&#xa;                &lt;/ns:QT_RECD_KO>&#xa;                &lt;ns:QT_RECD_OK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($VLAN/outputSet/COUNT_OK_ELAB_TARGET)&quot;/>&#xa;                &lt;/ns:QT_RECD_OK>&#xa;            &lt;/ns:FileProcessatoInput>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($InvokeProcessLogger.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_FINE_ELAB>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Log1ToUpdate_ChiusuraFile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Update_ChiusuraFileToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Update_ChiusuraFileToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$VLAN/outputSet/COUNT_KO_ELAB_STAGING!=0 or $VLAN/outputSet/COUNT_KO_ELAB_TARGET!=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$VLAN/outputSet/COUNT_KO_ELAB_STAGING!=0 or $VLAN/outputSet/COUNT_KO_ELAB_TARGET!=0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
