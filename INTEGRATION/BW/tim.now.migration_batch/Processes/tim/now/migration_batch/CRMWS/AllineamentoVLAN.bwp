                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/log/AllineamentoVLAN_Staging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVLAN_Noval&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;current-dateTime&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELAB_RECORD_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo_CRMWS_VLAN&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoRecd&quot;/>&#xa;    &lt;xsl:template name=&quot;InputStaging&quot; match=&quot;/&quot;>&#xa;        &lt;ns:AllineamentoVLAN>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:AllineamentoVLAN_Dettaglio_Noval)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AllineamentoVLAN_Dettaglio_Noval&quot;>&#xa;                        &lt;ns:AllineamentoVLAN_dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_CRMWS_VLAN * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:CLLI&quot;>&#xa;                                &lt;ns:CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&#xa;                                &lt;/ns:CLLI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ADR_CODE&quot;>&#xa;                                &lt;ns:COD_AREA_RACCOLTA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ADR_CODE&quot;/>&#xa;                                &lt;/ns:COD_AREA_RACCOLTA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TD_KIT&quot;>&#xa;                                &lt;ns:COD_KIT>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TD_KIT&quot;/>&#xa;                                &lt;/ns:COD_KIT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:MACRO_AREA_CODE&quot;>&#xa;                                &lt;ns:COD_MACRO_AREA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:MACRO_AREA_CODE&quot;/>&#xa;                                &lt;/ns:COD_MACRO_AREA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CODE&quot;>&#xa;                                &lt;ns:COD_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CODE&quot;/>&#xa;                                &lt;/ns:COD_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CODE_SUB&quot;>&#xa;                                &lt;ns:COD_OLO_SUB>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CODE_SUB&quot;/>&#xa;                                &lt;/ns:COD_OLO_SUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:SUPER_MACRO_AREA_CODE&quot;>&#xa;                                &lt;ns:COD_SUPER_MACRO_AREA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:SUPER_MACRO_AREA_CODE&quot;/>&#xa;                                &lt;/ns:COD_SUPER_MACRO_AREA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:IDVLAN&quot;>&#xa;                                &lt;ns:COD_VLAN>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:IDVLAN&quot;/>&#xa;                                &lt;/ns:COD_VLAN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CODING&quot;>&#xa;                                &lt;ns:CODFC_OLO_AGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CODING&quot;/>&#xa;                                &lt;/ns:CODFC_OLO_AGCOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CONDIG_SUB&quot;>&#xa;                                &lt;ns:CODFC_OLO_AGCOM_SUB>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CONDIG_SUB&quot;/>&#xa;                                &lt;/ns:CODFC_OLO_AGCOM_SUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecd/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;>&#xa;                                &lt;ns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecd/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;/>&#xa;                                &lt;/ns:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DATA_ATTIVAZIOE_SUB&quot;>&#xa;                                &lt;ns:DATA_ATTIVAZIONE_SUB>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_ATTIVAZIOE_SUB&quot;/>&#xa;                                &lt;/ns:DATA_ATTIVAZIONE_SUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DATA_CESSAZIONE_SUB&quot;>&#xa;                                &lt;ns:DATA_CESSAZIONE_SUB>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_CESSAZIONE_SUB&quot;/>&#xa;                                &lt;/ns:DATA_CESSAZIONE_SUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DEC&quot;>&#xa;                                &lt;ns:DEC>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DEC&quot;/>&#xa;                                &lt;/ns:DEC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DEC_ATT&quot;>&#xa;                                &lt;ns:DEC_ATTIVAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DEC_ATT&quot;/>&#xa;                                &lt;/ns:DEC_ATTIVAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ADR_DESC&quot;>&#xa;                                &lt;ns:DESC_AREA_RACCOLTA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ADR_DESC&quot;/>&#xa;                                &lt;/ns:DESC_AREA_RACCOLTA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:MACRO_AREA_DESC&quot;>&#xa;                                &lt;ns:DESC_MACRO_AREA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:MACRO_AREA_DESC&quot;/>&#xa;                                &lt;/ns:DESC_MACRO_AREA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:SUPER_MACRO_AREA_DESC&quot;>&#xa;                                &lt;ns:DESC_SUPER_MACRO_AREA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:SUPER_MACRO_AREA_DESC&quot;/>&#xa;                                &lt;/ns:DESC_SUPER_MACRO_AREA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DSLAM_TYPE&quot;>&#xa;                                &lt;ns:DSLAM_TYPE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DSLAM_TYPE&quot;/>&#xa;                                &lt;/ns:DSLAM_TYPE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ENCAPSULATION&quot;>&#xa;                                &lt;ns:FLAG_ENCAPSULATION>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ENCAPSULATION&quot;/>&#xa;                                &lt;/ns:FLAG_ENCAPSULATION>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:FLAG_VLAN_TRANSLATION&quot;>&#xa;                                &lt;ns:FLAG_VLAN_TRANSLATION>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:FLAG_VLAN_TRANSLATION&quot;/>&#xa;                                &lt;/ns:FLAG_VLAN_TRANSLATION>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:IDVLANOLO&quot;>&#xa;                                &lt;ns:ID_VLAN_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:IDVLANOLO&quot;/>&#xa;                                &lt;/ns:ID_VLAN_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$InvokeProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;>&#xa;                                &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$InvokeProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;/>&#xa;                                &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:if test=&quot;tns1:NOME&quot;>&#xa;                                &lt;ns:NOME>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:NOME&quot;/>&#xa;                                &lt;/ns:NOME>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:NOME_CENTRALE&quot;>&#xa;                                &lt;ns:NOME_CENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:NOME_CENTRALE&quot;/>&#xa;                                &lt;/ns:NOME_CENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;tns1:STATO&quot;>&#xa;                                &lt;ns:STATO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:STATO&quot;/>&#xa;                                &lt;/ns:STATO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:STATO_SUB&quot;>&#xa;                                &lt;ns:STATO_SUB>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:STATO_SUB&quot;/>&#xa;                                &lt;/ns:STATO_SUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TIPO_BANDA&quot;>&#xa;                                &lt;ns:TIPO_BANDA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TIPO_BANDA&quot;/>&#xa;                                &lt;/ns:TIPO_BANDA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CAR&quot;>&#xa;                                &lt;ns:CAR>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CAR&quot;/>&#xa;                                &lt;/ns:CAR>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CUSTOMER&quot;>&#xa;                                &lt;ns:CUSTOMER>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CUSTOMER&quot;/>&#xa;                                &lt;/ns:CUSTOMER>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TIPO_COS&quot;>&#xa;                                &lt;ns:TIPO_COS>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TIPO_COS&quot;/>&#xa;                                &lt;/ns:TIPO_COS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TIPO_TRASPORTO&quot;>&#xa;                                &lt;ns:TIPO_TRASPORTO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TIPO_TRASPORTO&quot;/>&#xa;                                &lt;/ns:TIPO_TRASPORTO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TIPOLOGIA&quot;>&#xa;                                &lt;ns:TIPOLG>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TIPOLOGIA&quot;/>&#xa;                                &lt;/ns:TIPOLG>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;$current-dateTime&quot;/>&#xa;                            &lt;/ns:TMSP_INSMTO>&#xa;                        &lt;/ns:AllineamentoVLAN_dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:AllineamentoVLAN_Dettaglio_Noval&quot;>&#xa;                        &lt;ns:AllineamentoVLAN_dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo_CRMWS_VLAN * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:CLLI&quot;>&#xa;                                &lt;ns:CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&#xa;                                &lt;/ns:CLLI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ADR_CODE&quot;>&#xa;                                &lt;ns:COD_AREA_RACCOLTA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ADR_CODE&quot;/>&#xa;                                &lt;/ns:COD_AREA_RACCOLTA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TD_KIT&quot;>&#xa;                                &lt;ns:COD_KIT>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TD_KIT&quot;/>&#xa;                                &lt;/ns:COD_KIT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:MACRO_AREA_CODE&quot;>&#xa;                                &lt;ns:COD_MACRO_AREA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:MACRO_AREA_CODE&quot;/>&#xa;                                &lt;/ns:COD_MACRO_AREA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CODE&quot;>&#xa;                                &lt;ns:COD_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CODE&quot;/>&#xa;                                &lt;/ns:COD_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CODE_SUB&quot;>&#xa;                                &lt;ns:COD_OLO_SUB>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CODE_SUB&quot;/>&#xa;                                &lt;/ns:COD_OLO_SUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:SUPER_MACRO_AREA_CODE&quot;>&#xa;                                &lt;ns:COD_SUPER_MACRO_AREA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:SUPER_MACRO_AREA_CODE&quot;/>&#xa;                                &lt;/ns:COD_SUPER_MACRO_AREA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:IDVLAN&quot;>&#xa;                                &lt;ns:COD_VLAN>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:IDVLAN&quot;/>&#xa;                                &lt;/ns:COD_VLAN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CODING&quot;>&#xa;                                &lt;ns:CODFC_OLO_AGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CODING&quot;/>&#xa;                                &lt;/ns:CODFC_OLO_AGCOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CONDIG_SUB&quot;>&#xa;                                &lt;ns:CODFC_OLO_AGCOM_SUB>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CONDIG_SUB&quot;/>&#xa;                                &lt;/ns:CODFC_OLO_AGCOM_SUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecd/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;>&#xa;                                &lt;ns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecd/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;/>&#xa;                                &lt;/ns:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DATA_ATTIVAZIOE_SUB&quot;>&#xa;                                &lt;ns:DATA_ATTIVAZIONE_SUB>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_ATTIVAZIOE_SUB&quot;/>&#xa;                                &lt;/ns:DATA_ATTIVAZIONE_SUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DATA_CESSAZIONE_SUB&quot;>&#xa;                                &lt;ns:DATA_CESSAZIONE_SUB>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_CESSAZIONE_SUB&quot;/>&#xa;                                &lt;/ns:DATA_CESSAZIONE_SUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DEC&quot;>&#xa;                                &lt;ns:DEC>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DEC&quot;/>&#xa;                                &lt;/ns:DEC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DEC_ATT&quot;>&#xa;                                &lt;ns:DEC_ATTIVAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DEC_ATT&quot;/>&#xa;                                &lt;/ns:DEC_ATTIVAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ADR_DESC&quot;>&#xa;                                &lt;ns:DESC_AREA_RACCOLTA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ADR_DESC&quot;/>&#xa;                                &lt;/ns:DESC_AREA_RACCOLTA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:MACRO_AREA_DESC&quot;>&#xa;                                &lt;ns:DESC_MACRO_AREA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:MACRO_AREA_DESC&quot;/>&#xa;                                &lt;/ns:DESC_MACRO_AREA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:SUPER_MACRO_AREA_DESC&quot;>&#xa;                                &lt;ns:DESC_SUPER_MACRO_AREA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:SUPER_MACRO_AREA_DESC&quot;/>&#xa;                                &lt;/ns:DESC_SUPER_MACRO_AREA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DSLAM_TYPE&quot;>&#xa;                                &lt;ns:DSLAM_TYPE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DSLAM_TYPE&quot;/>&#xa;                                &lt;/ns:DSLAM_TYPE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ENCAPSULATION&quot;>&#xa;                                &lt;ns:FLAG_ENCAPSULATION>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ENCAPSULATION&quot;/>&#xa;                                &lt;/ns:FLAG_ENCAPSULATION>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:FLAG_VLAN_TRANSLATION&quot;>&#xa;                                &lt;ns:FLAG_VLAN_TRANSLATION>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:FLAG_VLAN_TRANSLATION&quot;/>&#xa;                                &lt;/ns:FLAG_VLAN_TRANSLATION>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:IDVLANOLO&quot;>&#xa;                                &lt;ns:ID_VLAN_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:IDVLANOLO&quot;/>&#xa;                                &lt;/ns:ID_VLAN_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$InvokeProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;>&#xa;                                &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$InvokeProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;/>&#xa;                                &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:if test=&quot;tns1:NOME&quot;>&#xa;                                &lt;ns:NOME>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:NOME&quot;/>&#xa;                                &lt;/ns:NOME>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:NOME_CENTRALE&quot;>&#xa;                                &lt;ns:NOME_CENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:NOME_CENTRALE&quot;/>&#xa;                                &lt;/ns:NOME_CENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;tns1:STATO&quot;>&#xa;                                &lt;ns:STATO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:STATO&quot;/>&#xa;                                &lt;/ns:STATO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:STATO_SUB&quot;>&#xa;                                &lt;ns:STATO_SUB>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:STATO_SUB&quot;/>&#xa;                                &lt;/ns:STATO_SUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TIPO_BANDA&quot;>&#xa;                                &lt;ns:TIPO_BANDA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TIPO_BANDA&quot;/>&#xa;                                &lt;/ns:TIPO_BANDA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CAR&quot;>&#xa;                                &lt;ns:CAR>&#xa;                                    &lt;xsl:value-of select=