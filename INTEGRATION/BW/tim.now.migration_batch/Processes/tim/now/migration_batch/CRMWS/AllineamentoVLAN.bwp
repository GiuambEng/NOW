            <bpws:invoke inputVariable="End_Proc-input" name="End_Proc"
                operation="Insert" outputVariable="End_Proc"
                partnerLink="Logger" portType="ns3:ProcessLog" tibex:xpdlId="d7e15399-cfee-4d68-8ec2-7c27481b94fd">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
