                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ContenutoRecdAllineamentoVLAN&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVLAN_Noval&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;Passo_CRMWS_VLAN&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:template name=&quot;ContenutoRecd-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:AllineamentoVLAN_Dettaglio_Noval)=0&quot;>&lt;tns:InputAllineamentoVLAN_ContenutoRecd>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AllineamentoVLAN_Dettaglio_Noval&quot;>&lt;tns:ContenutoRecdVLAN_input>&lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&lt;tns:TipoRecord>&lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&lt;/tns:TipoRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:IDVLAN&quot;>&lt;tns:IDVLAN>&lt;xsl:value-of select=&quot;tns1:IDVLAN&quot;/>&lt;/tns:IDVLAN>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:TIPO_BANDA&quot;>&lt;tns:TIPO_BANDA>&lt;xsl:value-of select=&quot;tns1:TIPO_BANDA&quot;/>&lt;/tns:TIPO_BANDA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:TIPO_COS&quot;>&lt;tns:TIPO_COS>&lt;xsl:value-of select=&quot;tns1:TIPO_COS&quot;/>&lt;/tns:TIPO_COS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:OLO_CODING&quot;>&lt;tns:OLO_CODING>&lt;xsl:value-of select=&quot;tns1:OLO_CODING&quot;/>&lt;/tns:OLO_CODING>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:OLO_CODE&quot;>&lt;tns:OLO_CODE>&lt;xsl:value-of select=&quot;tns1:OLO_CODE&quot;/>&lt;/tns:OLO_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:OLO_CONDIG_SUB&quot;>&lt;tns:OLO_CONDIG_SUB>&lt;xsl:value-of select=&quot;tns1:OLO_CONDIG_SUB&quot;/>&lt;/tns:OLO_CONDIG_SUB>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:OLO_CODE_SUB&quot;>&lt;