                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVLAN_SubProcess&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVLAN_Noval&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo_CRMWS_VLAN&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Input_Sub&quot; match=&quot;/&quot;>&#xa;        &lt;tns:AllineamentoVLAN_Noval>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DetailNoVal/Rows/tns2:AllineamentoVLAN_Dettaglio_Noval[1]/tns2:Tipo_record)>0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns2:AllineamentoVLAN_Dettaglio_Noval&quot;>&#xa;                        &lt;tns:AllineamentoVLAN_Dettaglio_Noval>&#xa;                            &lt;xsl:if test=&quot;tns2:Tipo_record&quot;>&#xa;                                &lt;tns:Tipo_record>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:Tipo_record&quot;/>&#xa;                                &lt;/tns:Tipo_record>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:IDVLAN&quot;>&#xa;                                &lt;tns:IDVLAN>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:IDVLAN&quot;/>&#xa;                                &lt;/tns:IDVLAN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:TIPO_BANDA&quot;>&#xa;                     