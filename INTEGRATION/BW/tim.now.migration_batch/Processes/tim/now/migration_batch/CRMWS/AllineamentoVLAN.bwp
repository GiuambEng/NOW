                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/log/AllineamentoVLAN_Staging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVLAN_Noval&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;current-dateTime&quot;/>&lt;xsl:param name=&quot;OK_ELAB_RECORD_FILE&quot;/>&lt;xsl:param name=&quot;InvokeProcessLogger&quot;/>&lt;xsl:param name=&quot;Passo_CRMWS_VLAN&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ContenutoRecd&quot;/>&lt;xsl:template name=&quot;InputStaging&quot; match=&quot;/&quot;>&lt;ns:AllineamentoVLAN>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:AllineamentoVLAN_Dettaglio_Noval)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AllineamentoVLAN_Dettaglio_Noval&quot;>&lt;ns:AllineamentoVLAN_dettaglio>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_CRMWS_VLAN * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:CLLI&quot;>&lt;ns:CLLI>&lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&lt;/ns:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ADR_CODE&quot;>&lt;ns:COD_AREA_RACCOLTA>&lt;xsl:value-of select=&quot;tns1:ADR_CODE&quot;/>&lt;/ns:COD_AREA_RACCOLTA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:TD_KIT&quot;>&lt;ns:COD_KIT>&lt;xsl:value-of select=&quot;tns1:TD_KIT&quot;/>&lt;/ns:COD_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:MACRO_AREA_CODE&quot;>&lt;ns:COD_MACRO_AREA>&lt;xsl:value-of select=&quot;tns1:MACRO_AREA_CODE&quot;/>&lt;/ns:COD_MACRO_AREA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:OLO_CODE&quot;>&lt;ns:COD_OLO>&lt;xsl:value-of select=&qu