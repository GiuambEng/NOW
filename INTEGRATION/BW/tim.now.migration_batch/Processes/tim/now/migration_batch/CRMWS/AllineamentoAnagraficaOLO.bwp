                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InsertStagingAnagraficaOLO&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.xsd.AnagraficaOLO_noval&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns1=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NoVal_Detail&quot;/>&lt;xsl:param name=&quot;Noval_Detail_ultimi&quot;/>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ProcLogger&quot;/>&lt;xsl:param name=&quot;CallProcess&quot;/>&lt;xsl:template name=&quot;Var_InsertStag&quot; match=&quot;/&quot;>&lt;tns:AllineamentoAnagraficaOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Noval_Detail_ultimi/Rows/tns1:AllineamentoAnagraficaOLO_dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$NoVal_Detail/Rows/tns1:AllineamentoAnagraficaOLO_dettaglio&quot;>&lt;tns:AllineamentoAnagraficaOLO_dettaglio>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:TipoRecord&quot;>&lt;tns:TipoRecord>&lt;xsl:value-of select=&quot;tns1:TipoRecord&quot;/>&lt;/tns:TipoRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DENOMINAZIONE_OLO&quot;>&lt;tns:DENOMINAZIONE_OLO>&lt;xsl:value-of select=&quot;tns1:DENOMINAZIONE_OLO&quot;/>&lt;/tns:DENOMINAZIONE_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:RAGIONE_SOCIALE&quot;>&lt;tns:RAGIONE_SOCIALE>&lt;xsl:value-of select=&quot;tns1:RAGIONE_SOCIALE&quot;/>&lt;/tns:RAGIONE_SOCIALE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:P.IVA&quot;>&lt;tns:P.IVA>&lt;xsl:value-of select=&quot;tns1:P.IVA&quot;/>&lt;/tns:P.IVA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD