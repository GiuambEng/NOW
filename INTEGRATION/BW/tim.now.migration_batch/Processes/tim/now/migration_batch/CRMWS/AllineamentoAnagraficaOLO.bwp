;                            &lt;tns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/tns:NUMERO_RECD>&#xa;                            &lt;tns:ID_FILE_PROCSTO_INPUT>&#xa;                                &lt;xsl:value-of select=&quot;xsd:decimal($ProcLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                            &lt;/tns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;xsl:if test=&quot;$CallProcess/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;>&#xa;                                &lt;tns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$CallProcess/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;/>&#xa;                                &lt;/tns:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:AllineamentoAnagraficaOLO_dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$Noval_Detail_ultimi/Rows/tns1:AllineamentoAnagraficaOLO_dettaglio&quot;>&#xa;                        &lt;tns:AllineamentoAnagraficaOLO_dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:TipoRecord&quot;>&#xa;                                &lt;tns:TipoRecord>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TipoRecord&quot;/>&#xa;                                &lt;/tns:TipoRecord>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DENOMINAZIONE_OLO&quot;>&#xa;                                &lt;tns:DENOMINAZIONE_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DENOMINAZIONE_OLO&quot;/>&#xa;               