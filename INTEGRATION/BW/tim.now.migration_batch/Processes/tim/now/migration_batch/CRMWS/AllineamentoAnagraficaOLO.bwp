                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.SelectCountRecord&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;NomeStaging&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectCountRecord-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:SelecCountRecordInput>&#xa;            &lt;ns:NomeTabella>&#xa;                &lt;xsl:value-of select=&quot;$NomeStaging&quot;/>&#xa;            &lt;/ns:NomeTabella>&#xa;            &lt;xsl:if test=&quot;$ProcLogger.part1/ns1:Esito/ns1:ID_FILE&quot;>&#xa;                &lt;ns:IdFile>&#xa;                    &lt;xsl:value-of select=&quot;$ProcLogger.part1/ns1:Esito/ns1:ID_FILE&quot;/>&#xa;                &lt;/ns:IdFile>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:SelecCountRecordInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
