;                            &lt;xsl:if test=&quot;tns1:TIPOLOGIA_GESTORE&quot;>&#xa;                                &lt;tns:TIPOLOGIA_GESTORE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TIPOLOGIA_GESTORE&quot;/>&#xa;                                &lt;/tns:TIPOLOGIA_GESTORE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:FLAG_OLO_MOROSO&quot;>&#xa;                                &lt;tns:FLAG_OLO_MOROSO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:FLAG_OLO_MOROSO&quot;/>&#xa;                                &lt;/tns:FLAG_OLO_MOROSO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:FLAG_SANMARINO&quot;>&#xa;                                &lt;tns:FLAG_SANMARINO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:FLAG_SANMARINO&quot;/>&#xa;                                &lt;/tns:FLAG_SANMARINO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:EMAIL&quot;>&#xa;                                &lt;tns:EMAIL>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:EMAIL&quot;/>&#xa;                                &lt;/tns:EMAIL>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_ACCORPANTE_FLAG&quot;>&#xa;                                &lt;tns:OLO_ACCORPANTE_FLAG>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_ACCORPANTE_FLAG&quot;/>&#xa;                                &lt;/tns:OLO_ACCORPANTE_FLAG>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CODICE_OLO_ACCORPANTE&quot;>&#xa;                                &lt;tns:CODICE_OLO_ACCORPANTE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CODICE_OLO_ACCORPANTE&quot;/>&#xa;              