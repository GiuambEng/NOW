                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns1="http://www.tim.com/NOW/AllineamentiBatch/contaRecord/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="ContaRecord"/&gt;&lt;xsl:param name="ProcLogger"/&gt;&lt;xsl:param name="ID_PROCSO_FILE"/&gt;&lt;xsl:template name="UpCount-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;COUNTER&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/ns:ProcFile&gt;&lt;ns:FileProcessatoInput&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="xsd:integer($ProcLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:if test="$ContaRecord/part1/ns1:contaRecord_Output/ns1:NumeroRecord"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$ContaRecord/part1/ns1:contaRecord_Output/ns1:NumeroRecord"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoInput&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ContaRecord.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_FILE&quot;/>&#xa;    &lt;xsl:template name=&quot;UpCount-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;COUNTER&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;ns:ID_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ID_PROCSO_FILE&quot;/>&#xa;                &lt;/ns:ID_PROCSO_FILE>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessatoInput>&#xa;                &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($ProcLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;xsl:if test=&quot;$ContaRecord.part1/ns1:NumeroRecord&quot;>&#xa;                    &lt;ns:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$ContaRecord.part1/ns1:NumeroRecord&quot;/>&#xa;                    &lt;/ns:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessatoInput>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template