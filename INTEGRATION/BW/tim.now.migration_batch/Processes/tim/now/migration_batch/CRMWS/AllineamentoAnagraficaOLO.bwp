                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Var_InsertLogger&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;$Var_InsertLogger/ns:TipologiaProcesso&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;$Var_InsertLogger/ns:TipologiaOperazione&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;xsl:if test=&quot;$Var_InsertLogger/ns:ProcFile/ns:ID_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertLogger/ns:ProcFile/ns:ID_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;xsl:if test=&quot;$Var_InsertLogger/ns:FileProcessato/ns:COD_OLO&quot;>&#xa;                    &lt;ns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertLogger/ns:FileProcessato/ns:COD_OLO&quot;/>&#xa;                    &lt;/ns:COD_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;ns:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CODFC_OLO_AGCOM>&#xa;                &lt;/xsl