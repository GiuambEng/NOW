                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_ANAG_OLO (COD_OLO, COD_OLO_ACCORPANTE,&#xa;  CODFC_AGCOM_OLO_ACCORPANTE, CODFC_OLO_AGCOM, CODFC_OLO_RETE,&#xa;  DATA_ACCORPTO, DESCR_ERRORE, FLAG_OLO_ACCORPANTE, FLAG_SAN_MARINO,&#xa;  ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG, INDIRIZZO_EMAIL,&#xa;  MOROSO, NOME, NUMERO_RECD, PARTITA_IVA, RAGIONE_SOCIALE, STATO_ACCORPTO,&#xa;  TIPOLG_OLO, TMSP_INSMTO,CONTENUTO_RECD)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,&#xa;    ?, ?, ?, ?, ?, ?, ?, ?,RTRIM(?, CHR(10) || CHR(13)))"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

