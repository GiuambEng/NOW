                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="faultToExit1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="AssignToExit1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="RenameFile1ToExit1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="Log1ToExit1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="RenameFile1ToExit11" tibex:linkType="ERROR"/>
                            <bpws:link name="JDBCUpdateToErrorPath" tibex:linkType="SUCCESS"/>
