                                    sqlStatement="INSERT INTO STAG_ANAG_CONTRATTO (COD_CONTRATTO, COD_CONTRATTO_CRMWS,&#xa;  COD_CONTRATTO_PADRE, COD_OLO, CODFC_OLO_AGCOM, DATAFI_VALID,&#xa;  DATAINZ_VALID, FAMIG_OFFERTA, FLAG_ABILITATO, FLAG_ANFIBIO,&#xa;  FLAG_DIFFIDATO, FLAG_FILE_NOTIFY, FLAG_NPD, FLAG_STANDARD, FLAG_VALIDO,&#xa;  ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG, NOME_CONTRATTO, NOME_STANDARD,&#xa;  SRVZ, STATO_CONTRATTO, STATO_STANDARD, TIPO, TIPOLG_CONTRATTO,&#xa;  TMSP_INSMTO, NUMERO_RECD,CONTENUTO_RECD,OPERATORERETE)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,&#xa;    ?, ?, ?, ?, ?, ?, ?, ?,RTRIM(?, CHR(10) || CHR(13)),?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

