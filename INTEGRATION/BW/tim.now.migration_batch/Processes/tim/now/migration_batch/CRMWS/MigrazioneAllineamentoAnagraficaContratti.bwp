      &lt;tns2:DATA_INIZIO_VALIDITA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_INIZIO_VALIDITA&quot;/>&#xa;                                &lt;/tns2:DATA_INIZIO_VALIDITA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DATA_FINE_VALIDITA&quot;>&#xa;                                &lt;tns2:DATA_FINE_VALIDITA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_FINE_VALIDITA&quot;/>&#xa;                                &lt;/tns2:DATA_FINE_VALIDITA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:VALID_FLG&quot;>&#xa;                                &lt;tns2:VALID_FLG>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:VALID_FLG&quot;/>&#xa;                                &lt;/tns2:VALID_FLG>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:NPD_FLG&quot;>&#xa;                                &lt;tns2:NPD_FLG>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:NPD_FLG&quot;/>&#xa;                                &lt;/tns2:NPD_FLG>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DIFFIDATO_FLG&quot;>&#xa;                                &lt;tns2:DIFFIDATO_FLG>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DIFFIDATO_FLG&quot;/>&#xa;                                &lt;/tns2:DIFFIDATO_FLG>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:AMBITO&quot;>&#xa;                                &lt;tns2:AMBITO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:AMBITO&quot;/>&#xa;                                &lt;/tns2:AMBITO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ANFIBIO_FLG&quot;>&#