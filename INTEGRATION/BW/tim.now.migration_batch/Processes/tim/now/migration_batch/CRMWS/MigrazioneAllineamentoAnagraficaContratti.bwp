                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.AnagraficaContratti_noval&quot; xmlns:tns2=&quot;http://www.example.org/InsertStagingAnagraficaContratti&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns1=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Noval_Detail_Last&quot;/>&#xa;    &lt;xsl:param name=&quot;Noval_Detail&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoRecord&quot;/>&#xa;    &lt;xsl:template name=&quot;Var_InsertStaging&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($Noval_Detail_Last/Rows/tns1:AnagraficaContratti_dettaglio)=0&quot;>&#xa;                &lt;tns2:AnagraficaContratti>&#xa;                    &lt;xsl:for-each select=&quot;$Noval_Detail/Rows/tns1:AnagraficaContratti_dettaglio&quot;>&#xa;                        &lt;tns2:AnagraficaContratti_dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&#xa;                                &lt;tns2:Tipo_record>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&#xa;                                &lt;/tns2:Tipo_record>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:AGREE_NUMBER&quot;>&#xa;                                &lt;tns2:AGREE_NUMBER>&#xa;                             