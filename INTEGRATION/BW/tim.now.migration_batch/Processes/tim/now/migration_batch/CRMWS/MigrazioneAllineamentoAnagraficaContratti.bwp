                               &lt;xsl:value-of select=&quot;tns1:TIPO&quot;/>&#xa;                                &lt;/tns2:TIPO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CUSTOMER&quot;>&#xa;                                &lt;tns2:CUSTOMER>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CUSTOMER&quot;/>&#xa;                                &lt;/tns2:CUSTOMER>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Flag_Validita&quot;>&#xa;                                &lt;tns2:Flag_Validita>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Flag_Validita&quot;/>&#xa;                                &lt;/tns2:Flag_Validita>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns2:Stato>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/tns2:Stato>&#xa;                            &lt;tns2:ID_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:decimal($ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                            &lt;/tns2:ID_FILE>&#xa;                            &lt;tns2:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/tns2:NumeroRecord>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecord/ns1:Output_ContenutoRecord[ns1:Posizione=$var1]/ns1:Valore&quot;>&#xa;                                &lt;tns2:Record>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecord/ns1:Output_ContenutoRecord[ns1:Posizione=$var1]/ns1:Valore&quot;/>&#xa;                                &lt;/tns2:Record>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns2:AnagraficaContratti_dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;    