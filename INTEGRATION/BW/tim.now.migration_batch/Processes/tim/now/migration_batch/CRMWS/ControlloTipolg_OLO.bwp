    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="JDBCQueryToEnd" tibex:linkType="SUCCESS"/>
