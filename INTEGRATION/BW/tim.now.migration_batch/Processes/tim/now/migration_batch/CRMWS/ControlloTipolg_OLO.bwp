                <bpws:link name="AssignToEnd1" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToRecordKO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToRecordKO" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log1ToRecordOK" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log1ToRecordKO" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="6fbab5c2-739f-40f9-9f2e-50cbe09dc663"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/tns:TIPOLOGIA_GESTORE)>0 and (string-length($Start/tns:Flag_Validita)=0)  and &#xd;&#xa;(  &#xd;&#xa;(($Start/tns:OLO_ACCORPANTE_FLAG='Y') and &#xd;&#xa;string-length($Start/tns:CODICE_OLO_ACCORPANTE)=0 &#xd;&#xa;and string-length($Start/tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE)=0)&#xd;&#xa;   or &#xd;&#xa; (($Start/tns:OLO_ACCORPANTE_FLAG='N') and &#xd;&#xa; string-length($Start/tns:CODICE_OLO_ACCORPANTE) > 0 &#xd;&#xa; and string-length($Start/tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE) > 0 )  &#xd;&#xa; or &#xd;&#xa; (($Start/tns:OLO_ACCORPANTE_FLAG='N') and&#xd;&#xa; string-length($Start/tns:CODICE_OLO_ACCORPANTE) = 0 &#xd;&#xa; and string-length($Start/tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE) = 0 ) &#xd;&#xa; )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($Start/tns:TIPOLOGIA_GESTORE)>0 and (string-length($Start/tns:Flag_Validita)=0)  and 
(  
(($Start/tns:OLO_ACCORPANTE_FLAG='Y') and 
string-length($Start/tns:CODICE_OLO_ACCORPANTE)=0 
and string-length($Start/tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE)=0)
   or 
 (($Start/tns:OLO_ACCORPANTE_FLAG='N') and 
 string-length($Start/tns:CODICE_OLO_ACCORPANTE) > 0 
 and string-length($Start/tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE) > 0 )  
 or 
 (($Start/tns:OLO_ACCORPANTE_FLAG='N') and
 string-length($Start/tns:CODICE_OLO_ACCORPANTE) = 0 
 and string-length($Start/tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE) = 0 ) 
 )]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToRecordOK">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/tns:TIPOLOGIA_GESTORE)=0 and (string-length($Start/tns:Flag_Validita)=0)  and &#xd;&#xa;(  &#xd;&#xa;(($Start/tns:OLO_ACCORPANTE_FLAG='Y') and &#xd;&#xa;string-length($Start/tns:CODICE_OLO_ACCORPANTE)=0 &#xd;&#xa;and string-length($Start/tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE)=0)&#xd;&#xa;   or &#xd;&#xa; (($Start/tns:OLO_ACCORPANTE_FLAG='N') and &#xd;&#xa; string-length($Start/tns:CODICE_OLO_ACCORPANTE) > 0 &#xd;&#xa; and string-length($Start/tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE) > 0 )  &#xd;&#xa; or &#xd;&#xa; (($Start/tns:OLO_ACCORPANTE_FLAG='N') and&#xd;&#xa; string-length($Start/tns:CODICE_OLO_ACCORPANTE) = 0 &#xd;&#xa; and string-length($Start/tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE) = 0 ) &#xd;&#xa; )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($Start/tns:TIPOLOGIA_GESTORE)=0 and (string-length($Start/tns:Flag_Validita)=0)  and 
(  
(($Start/tns:OLO_ACCORPANTE_FLAG='Y') and 
string-length($Start/tns:CODICE_OLO_ACCORPANTE)=0 
and string-length($Start/tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE)=0)
   or 
 (($Start/tns:OLO_ACCORPANTE_FLAG='N') and 
 string-length($Start/tns:CODICE_OLO_ACCORPANTE) > 0 
 and string-length($Start/tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE) > 0 )  
 or 
 (($Start/tns:OLO_ACCORPANTE_FLAG='N') and
 string-length($Start/tns:CODICE_OLO_ACCORPANTE) = 0 
 and string-length($Start/tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE) = 0 ) 
 )]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToRecordKO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
