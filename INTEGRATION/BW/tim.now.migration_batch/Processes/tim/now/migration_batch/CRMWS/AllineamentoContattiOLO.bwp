oneFile/ns:ID_PROCSO_FILE"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:EsecuzioneFile/ns:ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:EsecuzioneFile/ns:STATO_ESEC"&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:EsecuzioneFile/ns:STATO_ESEC"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB"&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB"&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:if&gt;&lt;/ns:EsecuzioneFile&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$Var_InsertLogger/ns:LogFileProcessato/ns:COD_PROCSO"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:LogFileProcessato/ns:COD_PROCSO"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:LogFileProcessato/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:LogFileProcessato/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:LogFileProcessato/ns:LOG_LEVEL"&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:LogFileProcessato/ns:LOG_LEVEL"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:LogFileProcessato/ns:LOG_MESSAGE"&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:LogFileProcessato/ns:LOG_MESSAGE"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO"&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/xsl:if&gt;&lt;/ns:LogFileProcessato&gt;&lt;ns:FileProcessatoOutput&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE"&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessatoOutput/ns:ESITO_INVIO"&gt;&lt;ns:ESITO_INVIO&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessatoOutput/ns:ESITO_INVIO"/&gt;&lt;/ns:ESITO_INVIO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT"&gt;&lt;ns:ID_FILE_PROCSTO_OUTPUT&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT"/&gt;&lt;/ns:ID_FILE_PROCSTO_OUTPUT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE"&gt;&lt;ns:TIMSTP_CREZIONE_FILE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE"/&gt;&lt;/ns:TIMSTP_CREZIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessatoOutput/ns:TIMSTP_INVIO"&gt;&lt;ns:TIMSTP_INVIO&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessatoOutput/ns:TIMSTP_INVIO"/&gt;&lt;/ns:TIMSTP_INVIO&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoOutput&gt;&lt;ns:ContenutoFile&gt;&lt;xsl:if test="$Var_InsertLogger/ns:ContenutoFile/ns:ID_CONTENUTO_FILE"&gt;&lt;ns:ID_CONTENUTO_FILE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:ContenutoFile/ns:ID_CONTENUTO_FILE"/&gt;&lt;/ns:ID_CONTENUTO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:ContenutoFile/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:ContenutoFile/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:ContenutoFile/ns:FullName"&gt;&lt;ns:FullName&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:ContenutoFile/ns:FullName"/&gt;&lt;/ns:FullName&gt;&lt;/xsl:if&gt;&lt;/ns:ContenutoFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Var_InsertLogger&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcessLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;$Var_InsertLogger/ns:TipologiaProcesso&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;$Var_InsertLogger/ns:TipologiaOperazione&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;xsl:if test=&quot;$Var_InsertLogger/ns:ProcFile/ns:ID_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertLogger/ns:ProcFile/ns:ID_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;xsl:if test=&quot;$Var_InsertLogger/ns:FileProcessato/ns:COD_OLO&quot;>&#xa;                    &lt;ns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertLogger/ns:FileProcessato/ns:COD_OLO&quot;/>&#xa;                    &lt;/ns:COD_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;ns:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CODFC_OLO_AGCOM>&#xa;                &lt;/