                                    <value
                                    batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.STAG_ANAG_CONTATTO (CAP, COD_ISTAT_COMUNE,&#xa;  COD_ISTAT_INDIRIZZO, COD_ISTAT_PROV, COD_REFTE, CODFC_OLO_AGCOM,&#xa;  COGNOME, COMUNE, EMAIL, FAX, FISSO_ALTERNATIVO, FLAG_PRIMARIO,&#xa;  ID_INDIRIZZO, ID_CONTATTO_NATIVO, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG,&#xa;  INDIRIZZO, MOBL_ALTERNATIVO, NOME, NUMERO_CIVICO, NUMERO_FISSO,&#xa;  NUMERO_MOBL, NUMERO_RECD, PART_TOPON, PREFISSO_FISSO, PREFISSO_MOBL,&#xa;  PROV, TIPO_CONTATTO, TITOLO, TMSP_INSMTO, CONTENUTO_RECD, TMSP_AGGTO)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,&#xa;    ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)), ?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

