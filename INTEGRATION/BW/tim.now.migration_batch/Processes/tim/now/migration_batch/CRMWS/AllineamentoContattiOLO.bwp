            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="2dae5b6a-c762-4886-9f0e-47c21fb09089">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="Assign1ToExit2" tibex:linkType="SUCCESS"/>
                            <bpws:link name="RenameFile1ToCallProcess7" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="CallProcess8ToPathFileError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="CallProcess7ToExit2" tibex:linkType="SUCCESS"/>
                            <bpws:link name="RenameFile1ToExit2" tibex:linkType="ERROR"/>
                            <bpws:link name="JDBCUpdateToPathFileError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="Empty1ToPathFileError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCUpdateToPathFileError1" tibex:linkType="ERROR"/>
                        </bpws:links>
                        <bpws:exit name="Exit2" tibex:xpdlId="44079ccc-d3c1-4a3b-90ad-c643647f9d68">
                            <bpws:targets>
                                <bpws:target linkName="CallProcess7ToExit2"/>
                                <bpws:target linkName="RenameFile1ToExit2"/>
                            </bpws:targets>
                        </bpws:exit>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="if (string-length($FileRead/fileInfo/fileName)>0) then concat($PathFileErroreContattiOLO, 'ERROR_', substring-before( $FileRead/fileInfo/fileName,'.csv.ctr' ), $Estensione) else concat($PathFileErroreContattiOLO, $NomeFileErrore, format-dateTime(current-dateTime(), &quot;[Y0001][M01][D01]_[H01][m01][s01]&quot;), $Estensione)"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                inputVariable="PathScarto"
                                name="PathFileError"
                                outputVariable="PathScarto"
                                tibex:xpdlId="81fac520-a450-4571-8b5f-fdd12da4ef24" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="Empty1ToPathFileError"/>
                                    <bpws:target linkName="JDBCUpdateToPathFileError1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Assign1ToExit2"/>
                                </bpws:sources>
                                <tibex:inputBindings>
