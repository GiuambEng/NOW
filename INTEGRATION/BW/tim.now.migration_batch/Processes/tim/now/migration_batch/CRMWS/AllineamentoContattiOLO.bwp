#xa;                            &lt;xsl:if test=&quot;tns1:COD_ISTAT_PROVINCIA&quot;>&#xa;                                &lt;tns:COD_ISTAT_PROVINCIA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:COD_ISTAT_PROVINCIA&quot;/>&#xa;                                &lt;/tns:COD_ISTAT_PROVINCIA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CAP&quot;>&#xa;                                &lt;tns:CAP>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CAP&quot;/>&#xa;                                &lt;/tns:CAP>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:FAX&quot;>&#xa;                                &lt;tns:FAX>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:FAX&quot;/>&#xa;                                &lt;/tns:FAX>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:PREFISSO_MOBILE&quot;>&#xa;                                &lt;tns:PREFISSO_MOBILE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:PREFISSO_MOBILE&quot;/>&#xa;                                &lt;/tns:PREFISSO_MOBILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:NUMERO_MOBILE&quot;>&#xa;                                &lt;tns:NUMERO_MOBILE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:NUMERO_MOBILE&quot;/>&#xa;                                &lt;/tns:NUMERO_MOBILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:MOBILE_ALTERNATIVO&quot;>&#xa;                                &lt;tns:MOBILE_ALTERNATIVO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:MOBILE_ALTERNATIVO&quot;/>&#xa;                                &lt;/tns:MOBILE_ALTERNATIVO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:PREFISSO_FISSO&quot;>&#xa;                                &lt;tns:PREFISSO_FISSO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:PREFISSO_FISSO&quot;/>&#xa;                                &lt;/tns:PREFISSO_FISSO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:NUMERO_FISSO&quot;>&#xa;                                &lt;tns:NUMERO_FISSO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:NUMERO_FISSO&quot;/>&#xa;                                &lt;/tns:NUMERO_FISSO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:FISSO_ALTERNATIVO&quot;>&#xa;                                &lt;tns:FISSO_ALTERNATIVO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:FISSO_ALTERNATIVO&quot;/>&#xa;                                &lt;/tns:FISSO_ALTERNATIVO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CODICE_REFERENTE&quot;>&#xa;                                &lt;tns:CODICE_REFERENTE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CODICE_REFERENTE&quot;/>&#xa;                                &lt;/tns:CODICE_REFERENTE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:Stato>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/tns:Stato>&#xa;                            &lt;tns:TimeStamp>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns:TimeStamp>&#xa;                            &lt;tns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/tns:NUMERO_RECD>&#xa;                            &l