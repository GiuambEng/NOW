/ns:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessato/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessato/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessato/ns:ID_INTRFC"&gt;&lt;ns:ID_INTRFC&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessato/ns:ID_INTRFC"/&gt;&lt;/ns:ID_INTRFC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessato/ns:IDTPLG_FILE"&gt;&lt;ns:IDTPLG_FILE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessato/ns:IDTPLG_FILE"/&gt;&lt;/ns:IDTPLG_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessato/ns:NOME_FILE"&gt;&lt;ns:NOME_FILE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessato/ns:NOME_FILE"/&gt;&lt;/ns:NOME_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"&gt;&lt;ns:TIMSTP_APERTURA_FILE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"/&gt;&lt;/ns:TIMSTP_APERTURA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessato/ns:VERSO_DEL_FILE"&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessato/ns:VERSO_DEL_FILE"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessato&gt;&lt;ns:FileProcessatoInput&gt;&lt;xsl:if test="$Var_InsertLogger/ns:FileProcessatoInput/ns:DATA_ARRIVO"&gt;&lt;ns:DATA_ARRIVO&gt;&lt;xsl:value-of select="$Var_InsertLogger/ns:FileProcessatoInput/ns:DATA_ARRIVO"/&gt;&lt;/ns:DATA_ARRIVO&gt;