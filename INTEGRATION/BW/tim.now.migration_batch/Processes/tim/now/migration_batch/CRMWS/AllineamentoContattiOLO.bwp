                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROC_FILE&quot;/>&#xa;    &lt;xsl:template name=&quot;ErroreConformitaFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;ns:ID_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ID_PROC_FILE&quot;/>&#xa;                &lt;/ns:ID_PROCSO_FILE>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;ns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ERRORE NUMERO RECORD&amp;quot;&quot;/>&#xa;                &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($ProcessLogger.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;ns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE>&#xa;       