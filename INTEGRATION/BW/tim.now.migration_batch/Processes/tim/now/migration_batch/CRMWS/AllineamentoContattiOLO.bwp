                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InsertStagingAnagraficaContatti&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.AllineamentoContattiOLONoval&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns1=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Noval_Detail&quot;/>&lt;xsl:param name=&quot;Noval_Detail_Last&quot;/>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ProcessLogger&quot;/>&lt;xsl:param name=&quot;CallProcess&quot;/>&lt;xsl:template name=&quot;Var_InsertStaging&quot; match=&quot;/&quot;>&lt;tns:AllineamentoContattiOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Noval_Detail_Last/Rows/tns1:AllineamentoContattiOLO_dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$Noval_Detail/Rows/tns1:AllineamentoContattiOLO_dettaglio&quot;>&lt;tns:AllineamentoContattiOLO_dettaglio>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&lt;tns:Tipo_record>&lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&lt;/tns:Tipo_record>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ID_CONTATTO&quot;>&lt;tns:ID_CONTATTO>&lt;xsl:value-of select=&quot;tns1:ID_CONTATTO&quot;/>&lt;/tns:ID_CONTATTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ID_INDIRIZZO&quot;>&lt;tns:ID_INDIRIZZO>&lt;xsl:value-of select=&quot;tns1:ID_INDIRIZZO&quot;/>&lt;/tns:ID_INDIRIZZO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:NOME&quot;>&lt;tns:NOME>&lt;xsl:value-of select=&quot;tns1:NOME&quot;/>&lt;/tns:NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COGNOME&quot;>&lt;tns:CO