:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$Noval_Detail_Last/Rows/tns1:AllineamentoContattiOLO_dettaglio&quot;>&#xa;                        &lt;tns:AllineamentoContattiOLO_dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&#xa;                                &lt;tns:Tipo_record>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&#xa;                                &lt;/tns:Tipo_record>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ID_CONTATTO&quot;>&#xa;                                &lt;tns:ID_CONTATTO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ID_CONTATTO&quot;/>&#xa;                                &lt;/tns:ID_CONTATTO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ID_INDIRIZZO&quot;>&#xa;                                &lt;tns:ID_INDIRIZZO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ID_INDIRIZZO&quot;/>&#xa;                                &lt;/tns:ID_INDIRIZZO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:NOME&quot;>&#xa;                                &lt;tns:NOME>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:NOME&quot;/>&#xa;                                &lt;/tns:NOME>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:COGNOME&quot;>&#xa;                                &lt;tns:COGNOME>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:COGNOME&quot;/>&#xa;                                &lt;/tns:COGNOME>&#xa;                            &lt;/xsl:if>&#xa;