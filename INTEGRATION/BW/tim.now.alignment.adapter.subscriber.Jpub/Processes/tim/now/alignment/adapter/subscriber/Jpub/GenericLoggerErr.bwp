                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns1="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="InvokeIn"/&gt;&lt;xsl:param name="ID_Process"/&gt;&lt;xsl:template name="ProcessID-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($InvokeIn/part1/ns1:Input/ns1:ID_Esec_Proc)&gt;0"&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:ProcFile/&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:CorrelationID&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(xsd:string($InvokeIn/part1/ns1:Input/ns1:CorrelationID))&gt;0"&gt;&lt;ns:Value&gt;&lt;xsl:value-of select="xsd:int($InvokeIn/part1/ns1:Input/ns1:CorrelationID)"/&gt;&lt;/ns:Value&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(xsd:string($InvokeIn/part1/ns1:Input/ns1:CorrelationID))&gt;0"&gt;&lt;ns:Mode&gt;&lt;xsl:value-of select="&amp;quot;CORRELATE&amp;quot;"/&gt;&lt;/ns:Mode&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;/ns:CorrelationID&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($InvokeIn/part1/ns1:Input/ns1:ID_Esec_Proc)&gt;0"&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(substring-before($InvokeIn/part1/ns1:Input/ns1:ID_Esec_Proc, &amp;quot;.&amp;quot;))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($InvokeIn/part1/ns1:Input/ns1:ID_Esec_Proc)=0 or not(exists($InvokeIn/part1/ns1:Input/ns1:ID_Esec_Proc))"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$ID_Process"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($InvokeIn/part1/ns1:Input/ns1:ID_Esec_Proc)=0 or not(exists($InvokeIn/part1/ns1:Input/ns1:ID_Esec_Proc))"&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_Process&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcessID-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($InvokeIn.part1/ns1:ID_Esec_Proc)>0&quot;>&#xa;                    &lt;ns:TipologiaOperazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                    &lt;/ns:TipologiaOperazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:TipologiaOperazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                    &lt;/ns:TipologiaOperazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:ProcFile/>&#xa;            &lt;ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:CorrelationID>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(xsd:string($InvokeIn.part1/ns1:CorrelationID))>0&quot;>&#xa;                            &lt;ns:Value>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($InvokeIn.part1/ns1:CorrelationID)&quot;/>&#xa;                            &lt;/ns:Value>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(xsd:string($InvokeIn.part1/ns1:CorrelationID))>0&quot;>&#xa;                            &lt;ns:Mode>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CORRELATE&amp;quot;&quot;/>&#xa;                            &lt;/ns:Mode>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ns:CorrelationID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($InvokeIn.part1/ns1:ID_Esec_Proc)>0&quot;>&#xa;                        &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;xsd:integer(substring-before($InvokeIn.part1/ns1:ID_Esec_Proc, &amp;quot;.&amp;quot;))&quot;/>&#xa;                        &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($InvokeIn.part1/ns1:ID_Esec_Proc)=0 or not(exists($InvokeIn.part1/ns1:ID_Esec_Proc))&quot;>&#xa;                        &lt;ns:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$ID_Process&quot;/>&#xa;                        &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($InvokeIn.part1/ns1:ID_Esec_Proc)=0 or not(exists($InvokeIn.part1/ns1:ID_Esec_Proc))&quot;>&#xa;                        &lt;ns:TMSP_INIZIO_ELAB>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ns:EsecuzioneNOFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
