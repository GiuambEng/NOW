            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c002078b-2c4b-4a76-a1a0-e80064c820df+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvokeIn&quot;/>&lt;xsl:template name=&quot;Check_1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($InvokeIn/part1/ns:Input/ns:ID_Esec_Proc, '.')&quot;>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($InvokeIn/part1/ns:Input/ns:ID_Esec_Proc,'.'))&quot;/>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($InvokeIn/part1/ns:Input/ns:ID_Esec_Proc)&quot;/>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
