            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="9ea2a398-2101-4cc4-baea-c7355c2e636f">
                <bpws:targets>
                    <bpws:target linkName="ProcessIstanceToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToUpProcessID"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($SendVariazioneIn/part1/tns:root/tns:Contratto)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($SendVariazioneIn.part1/tns:Contratto)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link
                                    name="Ins_StagingToRepeatOnError" tibex:linkType="SUCCESS"/>
                                <bpws:link name="RequestToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToIns_Staging" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RepeatOnErrorToUp_Staging" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToRequest" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Up_StagingToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="RepeatOnErrorToAssign" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="LogFaultJpubContrattoToInvoke" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="AssignToLogFaultJpubContratto" tibex:linkType="SUCCESS"/>
                                <bpws:link name="StagKOToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="StagKOToCallProcess1" tibex:linkType="ERROR"/>
                                <bpws:link name="RecoveryToCallProcess" tibex:linkType="ERROR"/>
                                <bpws:link name="CallProcessToGroupEnd2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="RequestToAssign" tibex:linkType="ERROR"/>
                                <bpws:link name="Ins_StagingToAssign" tibex:linkType="ERROR"/>
                                <bpws:link name="Up_StagingToAssign" tibex:linkType="ERROR"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="ef722b94-2aa8-4d61-a9ff-a8bd83a79208">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToRequest"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="8f2271ce-6156-45f2-a413-92682717f596">
                                <bpws:targets>
                                    <bpws:target linkName="Up_StagingToGroupEnd"/>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                    <bpws:target linkName="CallProcessToGroupEnd2"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allinemaneotAnagraficaJPUB&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://tim.now.alignement.Jpub.adapter.Contratto&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ProcessIstance&quot;/>&lt;xsl:param name=&quot;OK_Elab_Staging&quot;/>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:param name=&quot;SendVariazioneIn&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;TransactionID&quot;/>&lt;xsl:template name=&quot;Ins_Staging-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:Insert>&lt;ns:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($Request)&quot;/>&lt;/ns:CONTENUTO_REQUEST>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;ns:ID_RICH_JPUB_RICH>&lt;xsl:value-of select=&quot;$TransactionID&quot;/>&lt;/ns:ID_RICH_JPUB_RICH>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_Elab_Staging&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RICH>&lt;xsl:if test=&quot;$SendVariazioneIn/part1/tns:root/tns:Contratto[$index]/tns:CODE_CONTR&quot;>&lt;ns:CODE_CONTR>&lt;xsl:value-of select=&quot;$SendVariazioneIn/part1/tns:root/tns:Contratto[$index]/tns:CODE_CONTR&quot;/>&lt;/ns:CODE_CONTR>&lt;/xsl:if>&lt;xsl:if test=&quot;$SendVariazioneIn/part1/tns:root/tns:Contratto[$index]/tns:CODE_GEST&quot;>&lt;ns:CODE_GEST>&lt;xsl:value-of select=&quot;$SendVariazioneIn/part1/tns:root/tns:Contratto[$index]/tns:CODE_GEST&quot;/>&lt;/ns:CODE_GEST>&lt;/xsl:if>&lt;ns:ID_TIPOLG_MESSG>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/ns:ID_TIPOLG_MESSG>&lt;xsl:if test=&quot;$SendVariazioneIn/part1/tns:root/tns:Contratto[$index]/tns:ID_TRANSAZIONE&quot;>&lt;ns:ID_TRANSAZIONE>&lt;xsl:value-of select=&quot;$SendVariazioneIn/part1/tns:root/tns:Contratto[$index]/tns:ID_TRANSAZIONE&quot;/>&lt;/ns:ID_TRANSAZIONE>&lt;/xsl:if>&lt;/ns:Insert>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Ins_Staging-input"
                                    name="Ins_Staging"
                                    tibex:xpdlId="0754f7b2-e978-4cad-a0ee-e89bd5796b70"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToIns_Staging"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Ins_StagingToRepeatOnError"/>
                                    <bpws:source
                                    linkName="Ins_StagingToAssign"
                                    tibex:faultDetailsVar="Ins_Staging" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allinemaneotAnagraficaJPUB&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://tim.now.alignement.Jpub.adapter.Contratto&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendVariazioneIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessIstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_Elab_Staging&quot;/>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionID&quot;/>&#xa;    &lt;xsl:template name=&quot;Ins_Staging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:Insert>&#xa;                &lt;ns:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Request)&quot;/>&#xa;                &lt;/ns:CONTENUTO_REQUEST>&#xa;                &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns:ID_RICH_JPUB_RICH>&#xa;                    &lt;xsl:value-of select=&quot;$TransactionID&quot;/>&#xa;                &lt;/ns:ID_RICH_JPUB_RICH>&#xa;                &lt;ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$OK_Elab_Staging&quot;/>&#xa;                &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                &lt;ns:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_RICH>&#xa;                &lt;xsl:if test=&quot;$SendVariazioneIn.part1/tns:Contratto[$index]/tns:CODE_CONTR&quot;>&#xa;                    &lt;ns:CODE_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;$SendVariazioneIn.part1/tns:Contratto[$index]/tns:CODE_CONTR&quot;/>&#xa;                    &lt;/ns:CODE_CONTR>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$SendVariazioneIn.part1/tns:Contratto[$index]/tns:CODE_GEST&quot;>&#xa;                    &lt;ns:CODE_GEST>&#xa;                        &lt;xsl:value-of select=&quot;$SendVariazioneIn.part1/tns:Contratto[$index]/tns:CODE_GEST&quot;/>&#xa;                    &lt;/ns:CODE_GEST>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:ID_TIPOLG_MESSG>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/ns:ID_TIPOLG_MESSG>&#xa;                &lt;xsl:if test=&quot;$SendVariazioneIn.part1/tns:Contratto[$index]/tns:ID_TRANSAZIONE&quot;>&#xa;                    &lt;ns:ID_TRANSAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$SendVariazioneIn.part1/tns:Contratto[$index]/tns:ID_TRANSAZIONE&quot;/>&#xa;                    &lt;/ns:ID_TRANSAZIONE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:Insert>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
