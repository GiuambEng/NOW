                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allinemaneotAnagraficaJPUB&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;www.tim.now.proxyJpub.schema&quot; xmlns:tns=&quot;http://tim.now.alignement.Jpub.adapter.Contratto&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OK_Elab_Staging&quot;/>&lt;xsl:param name=&quot;ProcessIstance&quot;/>&lt;xsl:param name=&quot;JpubContratto&quot;/>&lt;xsl:param name=&quot;SendVariazioneIn&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;Up_Staging-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:Update>&lt;ns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($JpubContratto/part1/ns2:Response, true(),true())&quot;/>&lt;/ns:CONTENUTO_RESPONSE>&lt;ns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RISPOSTA>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_Elab_Staging&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:if test=&quot;$SendVariazioneIn/part1/tns:root/tns:Contratto[$index]/tns:CODE_CONTR&quot;>&lt;ns:CODE_CONTR>&lt;xsl:value-of select=&quot;$SendVariazioneIn/part1/tns:root/tns:Contratto[$index]/tns:CODE_CONTR&quot;/>&lt;/ns:CODE_CONTR>&lt;/xsl:if>&lt;xsl:if test=&quot;$SendVariazioneIn/part1/tns:root/tns:Contratto[$index]/tns:CODE_GEST&quot;>&lt;ns:CODE_GEST>&lt;xsl:value-of select=&quot;$SendVariazioneIn/part1/tns:root/tns:Contratto[$index]/tns:CODE_GEST&quot;/>&lt;/ns:CODE_GEST>&lt;/xsl:if>&lt;ns: