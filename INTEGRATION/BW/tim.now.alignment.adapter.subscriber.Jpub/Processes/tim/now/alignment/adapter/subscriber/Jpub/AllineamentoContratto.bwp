                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com.insert.recovery.table&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessIstance&quot;/>&#xa;    &lt;xsl:template name=&quot;Recovery-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RecoveryInsert_Request>&#xa;            &lt;ns:Application>&#xa;                &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;            &lt;/ns:Application>&#xa;            &lt;ns:LogLevel>&#xa;                &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;            &lt;/ns:LogLevel>&#xa;            &lt;ns:LogName>&#xa;                &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;            &lt;/ns:LogName>&#xa;            &lt;ns:Nome_Staging>&#xa;                &lt;xsl:value-of select=&quot;'STAG_JPUB_OUT'&quot;/>&#xa;            &lt;/ns:Nome_Staging>&#xa;            &lt;ns:Id_Esec_Proc>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($ProcessIstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&quot;/>&#xa;            &lt;/ns:Id_Esec_Proc>&#xa;            &lt;ns:Stato_Elab>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;DA_LAVORARE&amp;quot;&quot;/>&#xa;            &lt;/ns:Stato_Elab>&#xa;            &lt;ns:Flag_Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;            &lt;/ns:Flag_Lavorazione>&#xa;        &lt;/ns:RecoveryInsert_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
