                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allinemaneotAnagraficaJPUB&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;www.tim.now.proxyJpub.schema&quot; xmlns:tns=&quot;http://tim.now.alignement.Jpub.adapter.Contratto&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendVariazioneIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;JpubContratto.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessIstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_Elab_Staging&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Up_Staging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:Update>&#xa;                &lt;ns:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($JpubContratto.part1, true(),true())&quot;/>&#xa;                &lt;/ns:CONTENUTO_RESPONSE>&#xa;                &lt;ns:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_RISPOSTA>&#xa;                &lt;ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$OK_Elab_Staging&quot;/>&#xa;                &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;xsl:if test=&quot;$SendVariazioneIn.part1/tns:Contratto[$index]/tns:CODE_CONTR&quot;>&#xa;                    &lt;ns:CODE_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;$SendVariazioneIn.part1/tns:Contratto[$index]/tns:CODE_CONTR&quot;/>&#xa;                    &lt;/ns:CODE_CONTR>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$SendVariazioneIn.part1/tns:Contratto[$index]/tns:CODE_GEST&quot;>&#xa;                    &lt;ns:CODE_GEST>&#xa;                        &lt;xsl:value-of select=&quot;$SendVariazioneIn.part1/tns:Contratto[$index]/tns:CODE_GEST&quot;/>&#xa;                    &lt;/ns:CODE_GEST>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:ID_TIPOLG_MESSG>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/ns:ID_TIPOLG_MESSG>&#xa;                &lt;xsl:if test=&quot;$SendVariazioneIn.part1/tns:Contratto[$index]/tns:ID_TRANSAZIONE&quot;>&#xa;                    &lt;ns:ID_TRANSAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$SendVariazioneIn.part1/tns:Contratto[$index]/tns:ID_TRANSAZIONE&quot;/>&#xa;                    &lt;/ns:ID_TRANSAZIONE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:Update>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
