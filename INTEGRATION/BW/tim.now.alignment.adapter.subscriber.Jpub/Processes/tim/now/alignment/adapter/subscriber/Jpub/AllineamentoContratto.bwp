In.part1/tns1:Contratto[number($index)]/tns1:DATA_SCAD_CONTR&quot;/>&#xa;                &lt;/DATA_SCAD_CONTR>&#xa;                &lt;DATA_STIP_CONTR>&#xa;                    &lt;xsl:value-of select=&quot;xsd:dateTime($SendVariazioneIn.part1/tns1:Contratto[number($index)]/tns1:DATA_STIP_CONTR)&quot;/>&#xa;                &lt;/DATA_STIP_CONTR>&#xa;                &lt;DATA_INIZIO_VALID>&#xa;                    &lt;xsl:value-of select=&quot;xsd:dateTime($SendVariazioneIn.part1/tns1:Contratto[number($index)]/tns1:DATA_INIZIO_VALID)&quot;/>&#xa;                &lt;/DATA_INIZIO_VALID>&#xa;                &lt;DATA_FINE_VALID>&#xa;                    &lt;xsl:value-of select=&quot;$SendVariazioneIn.part1/tns1:Contratto[number($index)]/tns1:DATA_FINE_VALID&quot;/>&#xa;                &lt;/DATA_FINE_VALID>&#xa;                &lt;DATA_COINV>&#xa;                    &lt;xsl:value-of select=&quot;$SendVariazioneIn.part1/tns1:Contratto[number($index)]/tns1:DATA_COINV&quot;/>&#xa;                &lt;/DATA_COINV>&#xa;            &lt;/tns:CONTRATTI>&#xa;        &lt;/tns:ANAGRAFICHE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
