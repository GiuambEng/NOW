                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com.insert.recovery.table&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;ProcessIstance&quot;/>&lt;xsl:template name=&quot;InsertRecovery-input&quot; match=&quot;/&quot;>&lt;ns:RecoveryInsert_Request>&lt;ns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/ns:Application>&lt;ns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/ns:LogLevel>&lt;ns:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/ns:LogName>&lt;ns:Nome_Staging>&lt;xsl:value-of select=&quot;'STAG_JPUB_OUT'&quot;/>&lt;/ns:Nome_Staging>&lt;ns:Id_Esec_Proc>&lt;xsl:value-of select=&quot;xsd:integer($ProcessIstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&quot;/>&lt;/ns:Id_Esec_Proc>&lt;ns:Stato_Elab>&lt;xsl:value-of select=&quot;&amp;quot;DA_LAVORARE&amp;quot;&quot;/>&lt;/ns:Stato_Elab>&lt;ns:Flag_Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/ns:Flag_Lavorazione>&lt;/ns:RecoveryInsert_Request>&lt;/xsl:template>&lt;/xsl:stylesheet>"
