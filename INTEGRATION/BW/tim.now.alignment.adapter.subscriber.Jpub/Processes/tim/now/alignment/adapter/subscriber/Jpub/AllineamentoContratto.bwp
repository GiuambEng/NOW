                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.proxyJpubContratto_concrete&quot; xmlns:ns1=&quot;www.tim.now.proxyJpub.schema&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:template name=&quot;JpubContratto-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:RequestContrattiProxy>&#xa;            &lt;ns1:ID_TRANSAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$Request/ID_TRANSAZIONE&quot;/>&#xa;            &lt;/ns1:ID_TRANSAZIONE>&#xa;            &lt;xsl:for-each select=&quot;$Request/ns2:CONTRATTI&quot;>&#xa;                &lt;ns1:Contratti>&#xa;                    &lt;ns1:CODE_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;CODE_CONTR&quot;/>&#xa;                    &lt;/ns1:CODE_CONTR>&#xa;                    &lt;ns1:CODE_TIPO_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;CODE_TIPO_CONTR&quot;/>&#xa;                    &lt;/ns1:CODE_TIPO_CONTR>&#xa;                    &lt;ns1:CODE_GEST>&#xa;                        &lt;xsl:value-of select=&quot;CODE_GEST&quot;/>&#xa;                    &lt;/ns1:CODE_GEST>&#xa;                    &lt;ns1:DESC_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;DESC_CONTR&quot;/>&#xa;                    &lt;/ns1:DESC_CONTR>&#xa;                    &lt;ns1:DATA_SCAD_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;DATA_SCAD_CONTR&quot;/>&#xa;                    &lt;/ns1:DATA_SCAD_CONTR>&#xa;                    &lt;ns1:DATA_STIP_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;DATA_STIP_CONTR&quot;/>&#xa;                    &lt;/ns1:DATA_STIP_CONTR>&#xa;                    &lt;ns1:DATA_INIZIO_VALID>&#xa;                        &lt;xsl:value-of select=&quot;DATA_INIZIO_VALID&quot;/>&#xa;                    &lt;/ns1:DATA_INIZIO_VALID>&#xa;                    &lt;ns1:DATA_FINE_VALID>&#xa;                        &lt;xsl:value-of select=&quot;DATA_FINE_VALID&quot;/>&#xa;                    &lt;/ns1:DATA_FINE_VALID>&#xa;                    &lt;ns1:DATA_COINV>&#xa;                        &lt;xsl:value-of select=&quot;DATA_COINV&quot;/>&#xa;                    &lt;/ns1:DATA_COINV>&#xa;                &lt;/ns1:Contratti>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns1:RequestContrattiProxy>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
