            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="abd914ba-9500-49b5-834e-ab4ec82a2221">
                <bpws:targets>
                    <bpws:target linkName="ProcessIstanceToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToUp_ProcessID"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($SendVariazioneIn/part1/tns:root/tns:AnagraficaOLO)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($SendVariazioneIn.part1/tns:AnagraficaOLO)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link
                                    name="Ins_StagingToRepeatOnError" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToIns_Staging" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RepeatOnErrorToUp_Staging" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Up_StagingToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToAssign" tibex:linkType="ERROR"/>
                                <bpws:link name="Ins_StagingToAssign" tibex:linkType="ERROR"/>
                                <bpws:link name="RepeatOnErrorToAssign" tibex:linkType="ERROR"/>
                                <bpws:link name="AssignToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogFaultJpubOLOToInvoke" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InvokeToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InvokeToCallProcess11" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="CallProcessToCallProcess1" tibex:linkType="ERROR"/>
                                <bpws:link name="CallProcess1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Up_StagingToAssign" tibex:linkType="ERROR"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="6e50377b-25cc-4e19-8b4d-fe3d1d5e8206">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToMapper"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="d2442e1f-72ef-4cb8-8830-c243fb7be1cc">
                                <bpws:targets>
                                    <bpws:target linkName="Up_StagingToGroupEnd"/>
