                                    subProcessName="LoggerAccessiUtenti.InsertRecovery" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://tim.now.alignement.Jpub.adapter.OLO&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;SendVariazioneIn&quot;/>&lt;xsl:param name=&quot;StagKO&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;CallProcess1-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'AllineamentoOLO'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'AllineamentoOLO'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'SendVariazione'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$SendVariazioneIn/part1/tns2:root/tns2:ProcessID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$SendVariazioneIn/part1/tns2:root/tns2:ProcessID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StagKO/part1/ns:Output)&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('ErrorRecovery',$_error/StackTrace,$_error/ProcessStack,$_error/MsgCode,$_error/Msg,$_error/FullClass)&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Error StagKO',$_error/StackTrace,$_error/ProcessStack,$_error/MsgCode,$_error/Msg,$_error/FullClass)&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallProcess1-input"
                                    name="CallProcess1"
