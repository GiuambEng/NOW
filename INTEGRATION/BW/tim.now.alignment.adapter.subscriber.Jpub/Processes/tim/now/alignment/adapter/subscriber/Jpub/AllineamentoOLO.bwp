                                    <bpws:sources>
                                    <bpws:source linkName="LogFaultJpubOLOToInvoke"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://tim.now.alignement.Jpub.adapter.OLO&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendVariazioneIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorInvoke&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultJpubOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoOLO'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoOLO'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendVariazione'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$SendVariazioneIn.part1/tns2:ProcessID&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$SendVariazioneIn.part1/tns2:ProcessID&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Fault',$ErrorInvoke)&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:invoke inputVariable="StagKO-input"
                                name="StagKO" operation="Invoke"
                                outputVariable="StagKO"
                                partnerLink="GenericLoggerErr"
                                portType="ns10:GenericError" tibex:xpdlId="bdf43dbb-bbab-4ecd-9e68-a8ed4805a801">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1469551322714" xmlns:ns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://tim.now.alignement.Jpub.adapter.OLO" version="2.0"&gt;&lt;xsl:param name="ProcessIstance"/&gt;&lt;xsl:param name="TransactioID"/&gt;&lt;xsl:param name="CorrelationID"/&gt;&lt;xsl:param name="ErrorInvoke"/&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="SendVariazioneIn"/&gt;&lt;xsl:template name="StagKO-input" match="/"&gt;&lt;tns:Input&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="'ALLINEAMENTO_OLO'"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Error&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="''"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Msg&gt;&lt;xsl:value-of select="''"/&gt;&lt;/ns:Msg&gt;&lt;ns:MsgCode&gt;&lt;xsl:value-of select="''"/&gt;&lt;/ns:MsgCode&gt;&lt;ns:ProcessStack&gt;&lt;xsl:value-of select="''"/&gt;&lt;/ns:ProcessStack&gt;&lt;ns:StackTrace&gt;&lt;xsl:value-of select="$ErrorInvoke"/&gt;&lt;/ns:StackTrace&gt;&lt;/ns:Error&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ProcessIstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;&lt;xsl:if test="$ProcessIstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$ProcessIstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;ns:JpubTransactionID&gt;&lt;xsl:value-of select="$TransactioID"/&gt;&lt;/ns:JpubTransactionID&gt;&lt;ns:CorrelationID&gt;&lt;xsl:value-of select="$CorrelationID"/&gt;&lt;/ns:CorrelationID&gt;&lt;xsl:if test="$SendVariazioneIn/part1/tns1:root/tns1:AnagraficaOLO[number($index)]/tns1:ID_TRANSAZIONE"&gt;&lt;ns:IDTransazione&gt;&lt;xsl:value-of select="$SendVariazioneIn/part1/tns1:root/tns1:AnagraficaOLO[number($index)]/tns1:ID_TRANSAZIONE"/&gt;&lt;/ns:IDTransazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$SendVariazioneIn/part1/tns1:root/tns1:ProcessID"&gt;&lt;ns:ProcessID&gt;&lt;xsl:value-of select="$SendVariazioneIn/part1/tns1:root/tns1:ProcessID"/&gt;&lt;/ns:ProcessID&gt;&lt;/xsl:if&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:Input&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://tim.now.alignement.Jpub.adapter.OLO&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendVariazioneIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessIstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactioID&quot;/>&#xa;    &lt;xsl:param name=&quot;CorrelationID&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;StagKO-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:ActivityName>&#xa;                &lt;xsl:value-of select=&quot;'ALLINEAMENTO_OLO'&quot;/>&#xa;            &lt;/ns:ActivityName>&#xa;            &lt;ns:Error>&#xa;                &lt;ns:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/ns:ActivityName>&#xa;                &lt;ns:Msg>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/ns:Msg>&#xa;                &lt;ns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/ns:MsgCode>&#xa;                &lt;ns:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/ns:ProcessStack>&#xa;                &lt;ns:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorInvoke&quot;/>&#xa;                &lt;/ns:StackTrace>&#xa;            &lt;/ns:Error>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ProcessIstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessIstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessIstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:JpubTransactionID>&#xa;                &lt;xsl:value-of select=&quot;$TransactioID&quot;/>&#xa;            &lt;/ns:JpubTransactionID>&#xa;            &lt;ns:CorrelationID>&#xa;                &lt;xsl:value-of select=&quot;$CorrelationID&quot;/>&#xa;            &lt;/ns:CorrelationID>&#xa;            &lt;xsl:if test=&quot;$SendVariazioneIn.part1/tns1:AnagraficaOLO[number($index)]/tns1:ID_TRANSAZIONE&quot;>&#xa;                &lt;ns:IDTransazione>&#xa;                    &lt;xsl:value-of select=&quot;$SendVariazioneIn.part1/tns1:AnagraficaOLO[number($index)]/tns1:ID_TRANSAZIONE&quot;/>&#xa;                &lt;/ns:IDTransazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendVariazioneIn.part1/tns1:ProcessID&quot;>&#xa;                &lt;ns:ProcessID>&#xa;                    &lt;xsl:value-of select=&quot;$SendVariazioneIn.part1/tns1:ProcessID&quot;/>&#xa;                &lt;/ns:ProcessID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="LogFaultJpubOLOToInvoke"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="InvokeToCallProcess1"/>
                                    <bpws:source
                                    linkName="InvokeToCallProcess11"
                                    tibex:faultDetailsVar="StagKO" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
