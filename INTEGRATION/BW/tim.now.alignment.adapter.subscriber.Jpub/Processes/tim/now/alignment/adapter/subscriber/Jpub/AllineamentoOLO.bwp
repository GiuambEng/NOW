                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://tim.now.alignement.Jpub.adapter.OLO&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendVariazioneIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcso&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcessIstance-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile/>&#xa;            &lt;ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:CorrelationID>&#xa;                    &lt;ns:Value>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SendVariazioneIn.part1/tns1:AnagraficaOLO[1]/tns1:CorrelationID)&quot;/>&#xa;                    &lt;/ns:Value>&#xa;                    &lt;ns:Mode>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CORRELATE&amp;quot;&quot;/>&#xa;                    &lt;/ns:Mode>&#xa;                &lt;/ns:CorrelationID>&#xa;                &lt;ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcso&quot;/>&#xa;                &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_INIZIO_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_INIZIO_ELAB>&#xa;            &lt;/ns:EsecuzioneNOFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
