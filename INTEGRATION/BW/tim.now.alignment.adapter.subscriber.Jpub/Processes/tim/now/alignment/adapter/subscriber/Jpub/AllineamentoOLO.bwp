                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToIns_Staging"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://tim.now.alignement.Jpub.adapter.OLO&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendVariazioneIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_request-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoOLO'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoOLO'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendVariazione'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$SendVariazioneIn.part1/tns2:ProcessID&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$SendVariazioneIn.part1/tns2:ProcessID&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Mapper',tib:render-xml($Mapper,true(),true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:scope name="RepeatOnError"
                                tibex:group="repeatOnError" tibex:xpdlId="f4704c5c-3ce7-42bc-91f8-0eebee72dc4d">
                                <bpws:targets>
                                    <bpws:target linkName="Ins_StagingToRepeatOnError"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="RepeatOnErrorToUp_Staging"/>
                                    <bpws:source
                                    linkName="RepeatOnErrorToAssign"
                                    tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                    <bpws:variable
                                    name="repeatOnError_success_flag"
                                    sca-bpel:internal="true" type="xsd:boolean"/>
                                    <bpws:variable name="FaultName1"
                                    sca-bpel:internal="true" type="xsd:string"/>
                                    <bpws:variable
                                    element="ns:FaultDetail"
                                    name="FaultDetails1" sca-bpel:internal="true"/>
                                </bpws:variables>
                                <bpws:repeatUntil name="repeatUntil" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:scope name="innerScope">
                                    <bpws:faultHandlers>
                                    <bpws:catchAll
                                    tibex:faultDetailsVar="FaultDetails1" tibex:faultNameVar="FaultName1">
                                    <bpws:if name="if">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$index1>=$MaxRetry" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1>=$MaxRetry]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow"/>
                                    <bpws:else>
                                    <bpws:assign
                                    name="Assign" validate="no">
                                    <bpws:copy>

                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                    </bpws:if>
                                    </bpws:catchAll>
                                    </bpws:faultHandlers>
                                    <bpws:flow name="flow3">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStart1ToJpubOLO" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="JpubOLOToGroupEnd1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart1ToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="CallProcessToGroupEnd1" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:empty
                                    name="GroupStart1"
                                    tibex:group="groupStart" tibex:xpdlId="f90d4bb5-6151-4c73-9d87-5a7682279cbe">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToJpubOLO">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$index1=1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$index1=1]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart1ToCallProcess">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    </bpws:empty>
                                    <bpws:assign
                                    name="GroupEnd1"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="ed69a2c8-d700-4e64-8ec8-29296a5accef" validate="no">
                                    <bpws:targets>
                                    <bpws:target linkName="JpubOLOToGroupEnd1"/>
                                    <bpws:target linkName="CallProcessToGroupEnd1"/>
                                    </bpws:targets>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[true()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:invoke
                                    inputVariable="JpubOLO-input"
                                    name="JpubOLO"
                                    operation="Operation"
                                    outputVariable="JpubOLO"
                                    partnerLink="ProxyJpubOLO"
                                    portType="ns16:ProxyJpubOLO" tibex:xpdlId="5293a1ef-4477-4072-a4fc-80555170eba6">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.now.proxyJpubOLOConcrete" xmlns:ns1="www.tim.now.proxyJpub.schema" xmlns:ns2="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input" version="2.0"&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:template name="JpubOLO-input" match="/"&gt;&lt;ns:Request&gt;&lt;part1&gt;&lt;ns1:RequestGestoreProxy&gt;&lt;ns1:ID_TRANSAZIONE&gt;&lt;xsl:value-of select="$Mapper/ID_TRANSAZIONE"/&gt;&lt;/ns1:ID_TRANSAZIONE&gt;&lt;xsl:for-each select="$Mapper/ns2:ANAGRAFICA_GESTORI"&gt;&lt;ns1:Gestore&gt;&lt;ns1:TIPO_AZIONE&gt;&lt;xsl:value-of select="TIPO_AZIONE"/&gt;&lt;/ns1:TIPO_AZIONE&gt;&lt;ns1:CODE_GEST&gt;&lt;xsl:value-of select="CODE_GEST"/&gt;&lt;/ns1:CODE_GEST&gt;&lt;ns1:NOME_RAG_SOC_GEST&gt;&lt;xsl:value-of select="NOME_RAG_SOC_GEST"/&gt;&lt;/ns1:NOME_RAG_SOC_GEST&gt;&lt;ns1:NOME_GEST_SIGLA&gt;&lt;xsl:value-of select="NOME_GEST_SIGLA"/&gt;&lt;/ns1:NOME_GEST_SIGLA&gt;&lt;ns1:CODE_PARTITA_IVA&gt;&lt;xsl:value-of select="CODE_PARTITA_IVA"/&gt;&lt;/ns1:CODE_PARTITA_IVA&gt;&lt;ns1:CODE_GEST_TIRKS&gt;&lt;xsl:value-of select="CODE_GEST_TIRKS"/&gt;&lt;/ns1:CODE_GEST_TIRKS&gt;&lt;/ns1:Gestore&gt;&lt;/xsl:for-each&gt;&lt;/ns1:RequestGestoreProxy&gt;&lt;/part1&gt;&lt;/ns:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.proxyJpubOLOConcrete&quot; xmlns:ns1=&quot;www.tim.now.proxyJpub.schema&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;JpubOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:RequestGestoreProxy>&#xa;            &lt;ns1:ID_TRANSAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$Mapper/ID_TRANSAZIONE&quot;/>&#xa;            &lt;/ns1:ID_TRANSAZIONE>&#xa;            &lt;xsl:for-each select=&quot;$Mapper/ns2:ANAGRAFICA_GESTORI&quot;>&#xa;                &lt;ns1:Gestore>&#xa;                    &lt;ns1:TIPO_AZIONE>&#xa;                        &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                    &lt;/ns1:TIPO_AZIONE>&#xa;                    &lt;ns1:CODE_GEST>&#xa;                        &lt;xsl:value-of select=&quot;CODE_GEST&quot;/>&#xa;                    &lt;/ns1:CODE_GEST>&#xa;                    &lt;ns1:NOME_RAG_SOC_GEST>&#xa;                        &lt;xsl:value-of select=&quot;NOME_RAG_SOC_GEST&quot;/>&#xa;                    &lt;/ns1:NOME_RAG_SOC_GEST>&#xa;                    &lt;ns1:NOME_GEST_SIGLA>&#xa;                        &lt;xsl:value-of select=&quot;NOME_GEST_SIGLA&quot;/>&#xa;                    &lt;/ns1:NOME_GEST_SIGLA>&#xa;                    &lt;ns1:CODE_PARTITA_IVA>&#xa;                        &lt;xsl:value-of select=&quot;CODE_PARTITA_IVA&quot;/>&#xa;                    &lt;/ns1:CODE_PARTITA_IVA>&#xa;                    &lt;ns1:CODE_GEST_TIRKS>&#xa;                        &lt;xsl:value-of select=&quot;CODE_GEST_TIRKS&quot;/>&#xa;                    &lt;/ns1:CODE_GEST_TIRKS>&#xa;                &lt;/ns1:Gestore>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns1:RequestGestoreProxy>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToJpubOLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JpubOLOToGroupEnd1"/>
                                    </bpws:sources>
                                    </bpws:invoke>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://tim.now.alignement.Jpub.adapter.OLO&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;SendVariazioneIn&quot;/>&lt;xsl:param name=&quot;index1&quot;/>&lt;xsl:template name=&quot;LogRetry-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'AllineamentoOLO'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'AllineamentoOLO'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'SendVariazione'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$SendVariazioneIn/part1/tns2:root/tns2:ProcessID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$SendVariazioneIn/part1/tns2:root/tns2:ProcessID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Retry Fault JpubOLO','||','numero:','||',string($index1))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogRetry-input"
                                    name="LogRetry"
                                    tibex:xpdlId="0f21a013-f86c-449d-9d71-49a97932f21f"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://tim.now.alignement.Jpub.adapter.OLO&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendVariazioneIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:template name=&quot;LogRetry-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoOLO'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoOLO'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendVariazione'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$SendVariazioneIn.part1/tns2:ProcessID&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$SendVariazioneIn.part1/tns2:ProcessID&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Retry Fault JpubOLO','||','numero:','||',string($index1))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                    </bpws:scope>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[boolean($repeatOnError_success_flag)]]></bpws:condition>
                                </bpws:repeatUntil>
                            </bpws:scope>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ErrorInvoke"
                                    name="Assign"
                                    outputVariable="ErrorInvoke"
                                    tibex:xpdlId="ecb9513a-640c-4aa8-b059-7e39f1b7eacc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
