<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
targetNamespace="www.tim.now.genereciErrorGestioneSegnalazione"
xmlns="www.tim.now.genereciErrorGestioneSegnalazione"
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
	<xs:element name="Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ActivityName" type="xs:string"
					minOccurs="0" />
				<xs:element name="Error" type="ErrorType" minOccurs="0" />
				<xs:element name="ID_Esec_Proc" type="xs:string"
					minOccurs="0" />
				<xs:element name="ProcessName" type="xs:string"
					minOccurs="0" />
				<xs:element name="JpubTransactionID" type="xs:integer"
					minOccurs="0" />
				<xs:element name="CorrelationID" type="xs:integer"
					minOccurs="0" />
				<xs:element name="IDTransazione" type="xs:string"
					maxOccurs="1" minOccurs="0">
				</xs:element>
				<xs:element name="ProcessID" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="ErrorType">
		<xs:sequence>
			<xs:element name="ActivityName" type="xs:string" minOccurs="1"/>
			<xs:element name="Data" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:any minOccurs="0"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Msg" type="xs:string" minOccurs="1"/>
			<xs:element name="MsgCode" type="xs:string" minOccurs="1"/>
			<xs:element name="ProcessStack" type="xs:string" minOccurs="1"/>
			<xs:element name="StackTrace" type="xs:string" minOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
		<xs:element name="Output">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ErrorCode" type="xs:integer" minOccurs="0"/>
				<xs:element name="ErrorDesc" type="xs:string" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
