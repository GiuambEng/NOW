    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogStartToRepeat" tibex:linkType="SUCCESS"/>
                <bpws:link name="RepeatToForEach" tibex:linkType="SUCCESS"/>
                <bpws:link name="ForEachToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperToForEach" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="MapperToIterate1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="MapperToEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Iterate1ToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
