<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified"
targetNamespace="www.tim.now.schema.Record"
xmlns="www.tim.now.schema.Record">
	<xs:element name="Insert">
  <xs:complexType>
   <xs:sequence>
   	<xs:element maxOccurs="unbounded" minOccurs="0"
   		ref="InsertStaging">
   	</xs:element>
   </xs:sequence>
  </xs:complexType>
 </xs:element>
	<xs:element name="InsertStaging">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" name="tipoRecord"
					type="xs:string">
				</xs:element>
				<xs:element minOccurs="0" name="ID_Risorsa"
					type="xs:string">
				</xs:element>
				<xs:element minOccurs="0" name="Flag_Validita"
					type="xs:string">
				</xs:element>
				<xs:element minOccurs="0" name="ID_STATO_ELAB_STAG"
					type="xs:string">
				</xs:element>
				<xs:element minOccurs="0" name="NUMERO_RECD"
					type="xs:string">
				</xs:element>
			
				<xs:element minOccurs="0" name="ID_FILE"
					type="xs:decimal">
				</xs:element>
				
				<xs:element minOccurs="0" name="DESCR_ERRORE"
					type="xs:string">
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
