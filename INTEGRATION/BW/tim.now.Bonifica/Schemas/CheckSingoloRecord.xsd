<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified"
targetNamespace="www.tim.now.schema.CheckSingoloRecord"
xmlns="www.tim.now.schema.CheckSingoloRecord">
	<xs:element name="CheckSingoloRecord">
  <xs:complexType>
   <xs:sequence>
   	<xs:element maxOccurs="1" minOccurs="0" ref="Input"></xs:element>
   </xs:sequence>
  </xs:complexType>
 </xs:element>

	<xs:element name="Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" name="TipoRecord" maxOccurs="1">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="2"></xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="1" maxOccurs="1"
					name="ID_Risorsa">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"></xs:minLength>
							<xs:maxLength value="50"></xs:maxLength>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="Flag_Validita"
					type="xs:string">
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
