urrent-date()&quot;/>&lt;/ns:DATA_ARRIVO>&lt;ns:DIMENSIONE_FILE>&lt;xsl:value-of select=&quot;xsd:integer($FindFileName/tns:Size)&quot;/>&lt;/ns:DIMENSIONE_FILE>&lt;/ns:FileProcessatoInput>&lt;ns:EsecuzioneFile>&lt;ns:ID_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($ID_PROC)&quot;/>&lt;/ns:ID_PROCSO_FILE>&lt;ns:STATO_ESEC>&lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&lt;/ns:STATO_ESEC>&lt;ns:TMSP_INIZIO_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INIZIO_ELAB>&lt;/ns:EsecuzioneFile>&lt;ns:ContenutoFile>&lt;ns:ID_CONTENUTO_FILE>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/ns:ID_CONTENUTO_FILE>&lt;xsl:if test=&quot;$FindFileName/tns:FullName&quot;>&lt;ns:FullName>&lt;xsl:value-of select=&quot;$FindFileName/tns:FullName&quot;/>&lt;/ns:FullName>&lt;/xsl:if>&lt;/ns:ContenutoFile>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
