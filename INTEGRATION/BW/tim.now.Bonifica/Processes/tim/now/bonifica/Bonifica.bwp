                                expression="if (string-length($FindFileName/ns1:FileName)>0) then concat($PathErrorFile, 'ERROR_', substring-before( $FilePoller/fileInfo/fileName,'.TAPPO' ), $Estensione) else concat($PathErrorFile, $ErrorNameFile, format-dateTime(current-dateTime(), &quot;[Y0001][M01][D01]_[H01][m01][s01]&quot;), $Estensione)"
