                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/" xmlns:ns1="http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/" xmlns:tns="http://www.example.org/FileTappo" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="FindFileName"/&gt;&lt;xsl:param name="ProcLogger"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;ns:Conta_Request&gt;&lt;part1&gt;&lt;ns1:contaRecord_Input&gt;&lt;ns1:in&gt;&lt;xsl:value-of select="$FindFileName/tns:FullName"/&gt;&lt;/ns1:in&gt;&lt;ns1:TipoSeparatore&gt;&lt;xsl:value-of select="&amp;quot;ContaRecord_PipeCancelletto&amp;quot;"/&gt;&lt;/ns1:TipoSeparatore&gt;&lt;ns1:Flusso&gt;&lt;xsl:value-of select="'BonificaVULA'"/&gt;&lt;/ns1:Flusso&gt;&lt;ns1:ID_FILE&gt;&lt;xsl:value-of select="xsd:integer($ProcLogger/part1/ns2:Output/ns2:Esito/ns2:ID_FILE)"/&gt;&lt;/ns1:ID_FILE&gt;&lt;xsl:if test="$FindFileName/tns:FullName"&gt;&lt;ns1:FULLNAME&gt;&lt;xsl:value-of select="$FindFileName/tns:FullName"/&gt;&lt;/ns1:FULLNAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindFileName/tns:FileName"&gt;&lt;ns1:FILENAME&gt;&lt;xsl:value-of select="$FindFileName/tns:FileName"/&gt;&lt;/ns1:FILENAME&gt;&lt;/xsl:if&gt;&lt;ns1:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="xsd:integer($ProcLogger/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_FILE)"/&gt;&lt;/ns1:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:if test="$ProcLogger/part1/ns2:Output/ns2:Esito/ns2:COD_PROCSO_FILE"&gt;&lt;ns1:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$ProcLogger/part1/ns2:Output/ns2:Esito/ns2:COD_PROCSO_FILE"/&gt;&lt;/ns1:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns1:NomeProcesso&gt;&lt;xsl:value-of select="'BonificaVULA'"/&gt;&lt;/ns1:NomeProcesso&gt;&lt;/ns1:contaRecord_Input&gt;&lt;/part1&gt;&lt;/ns:Conta_Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
