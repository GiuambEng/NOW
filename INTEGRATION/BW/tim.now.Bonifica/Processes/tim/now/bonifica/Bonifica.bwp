                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FindFileName&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:contaRecord_Input>&#xa;            &lt;ns1:in>&#xa;                &lt;xsl:value-of select=&quot;$FindFileName/tns:FullName&quot;/>&#xa;            &lt;/ns1:in>&#xa;            &lt;ns1:TipoSeparatore>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ContaRecord_PipeCancelletto&amp;quot;&quot;/>&#xa;            &lt;/ns1:TipoSeparatore>&#xa;            &lt;ns1:Flusso>&#xa;                &lt;xsl:value-of select=&quot;'BonificaVULA'&quot;/>&#xa;            &lt;/ns1:Flusso>&#xa;            &lt;ns1:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($ProcLogger.part1/ns2:Esito/ns2:ID_FILE)&quot;/>&#xa;            &lt;/ns1:ID_FILE>&#xa;            &lt;xsl:if test=&quot;$FindFileName/tns:FullName&quot;>&#xa;                &lt;ns1:FULLNAME>&#xa;                    &lt;xsl:value-of select=&quot;$FindFileName/tns:FullName&quot;/>&#xa;                &lt;/ns1:FULLNAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$FindFileName/tns:FileName&quot;>&#xa;                &lt;ns1:FILENAME>&#xa;                    &lt;xsl:value-of select=&quot;$FindFileName/tns:FileName&quot;/>&#xa;                &lt;/ns1:FILENAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns1:ID_ESEC_PROCSO_FI