                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindCase.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;VarFindCase&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Output>&#xa;            &lt;tns:Find>&#xa;                &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:CaseReference&quot;>&#xa;                    &lt;tns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:CaseReference&quot;/>&#xa;                    &lt;/tns:CaseReference>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;$FindCase.part1/tns:Find/tns:Asset&quot;>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;xsl:if test=&quot;IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;codiceOrdineOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;codiceOrdineTI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;codiceOrdineTI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;invariante&quot;>&#xa;                            &lt;invari