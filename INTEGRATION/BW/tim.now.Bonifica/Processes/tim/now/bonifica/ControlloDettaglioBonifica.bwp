ind/tns:Asset/IDRichiestaOLO"&gt;&lt;IDRichiestaOLO&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/IDRichiestaOLO"/&gt;&lt;/IDRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/IDPrimoOrdine"&gt;&lt;IDPrimoOrdine&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/IDPrimoOrdine"/&gt;&lt;/IDPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;IDContratto&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/IDContratto"/&gt;&lt;/IDContratto&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/DEC"&gt;&lt;DEC&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/DEC"/&gt;&lt;/DEC&gt;&lt;/xsl:if&gt;&lt;statoAsset&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/statoAsset"/&gt;&lt;/statoAsset&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/numeroTelefonico"&gt;&lt;numeroTelefonico&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/numeroTelefonico"/&gt;&lt;/numeroTelefonico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/IDAssetCRMWS"&gt;&lt;IDAssetCRMWS&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/IDAssetCRMWS"/&gt;&lt;/IDAssetCRMWS&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/IDAssetDa"&gt;&lt;IDAssetDa&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/IDAssetDa"/&gt;&lt;/IDAssetDa&gt;&lt;/xsl:if&gt;&lt;DES&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/DES"/&gt;&lt;/DES&gt;&lt;tipologiaAccesso&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/tipologiaAccesso"/&gt;&lt;/tipologiaAccesso&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/RO"&gt;&lt;RO&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/RO"/&gt;&lt;/RO&gt;&lt;/xsl:if&gt;&lt;offerta&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/offerta"/&gt;&lt;/offerta&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/lineaRiferimento"&gt;&lt;lineaRiferimento&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/lineaRiferimento"/&gt;&lt;/lineaRiferimento&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/complesso"&gt;&lt;complesso&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/complesso"/&gt;&lt;/complesso&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/interno"&gt;&lt;interno&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/interno"/&gt;&lt;/interno&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/piano"&gt;&lt;piano&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/piano"/&gt;&lt;/piano&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/scala"&gt;&lt;scala&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/scala"/&gt;&lt;/scala&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/dettaglioasset[nomeComponente='ACCESSOVULAFTTCAB' or nomeComponente = 'ACCESSOVULAFTTH']"&gt;&lt;dettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;xsl:if test="IDDettaglioAssetParent"&gt;&lt;IDDettaglioAssetParent&gt;&lt;xsl:value-of select="IDDettaglioAssetParent"/&gt;&lt;/IDDettaglioAssetParent&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDDettaglioAssetRoot"&gt;&lt;IDDettaglioAssetRoot&gt;&lt;xsl:value-of select="IDDettaglioAssetRoot"/&gt;&lt;/IDDettaglioAssetRoot&gt;&lt;/xsl:if&gt;&lt;integrationID&gt;&lt;xsl:value-of select="integrationID"/&gt;&lt;/integrationID&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;nomeComponente&gt;&lt;xsl:value-of select="nomeComponente"/&gt;&lt;/nomeComponente&gt;&lt;xsl:for-each select="attributidettaglioasset"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="nomeAttributo"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="valoreAttributo"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="tipologiaDato"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="'FLAGNUOVOMODELLO'"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="'Y'"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="statoDettaglioAsset"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="progressivo"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;xsl:for-each select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/dettaglioasset[nomeComponente='USERVLAN']"&gt;&lt;dettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;xsl:if test="IDDettaglioAssetParent"&gt;&lt;IDDettaglioAssetParent&gt;&lt;xsl:value-of select="IDDettaglioAssetParent"/&gt;&lt;/IDDettaglioAssetParent&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDDettaglioAssetRoot"&gt;&lt;IDDettaglioAssetRoot&gt;&lt;xsl:value-of select="IDDettaglioAssetRoot"/&gt;&lt;/IDDettaglioAssetRoot&gt;&lt;/xsl:if&gt;&lt;integrationID&gt;&lt;xsl:value-of select="integrationID"/&gt;&lt;/integrationID&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;nomeComponente&gt;&lt;xsl:value-of select="nomeComponente"/&gt;&lt;/nomeComponente&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count(attributidettaglioasset[nomeAttributo='PROFILOBMD'])&gt;0"&gt;&lt;xsl:for-each select="attributidettaglioasset[nomeAttributo='PROFILOBMD']"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="nomeAttributo"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/ID_PROFILO_BMD"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="tipologiaDato"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:for-each select="attributidettaglioasset"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="nomeAttributo"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="valoreAttributo"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="tipologiaDato"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="'PROFILOBMD'"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/ID_PROFILO_BMD"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="statoDettaglioAsset"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="progressivo"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/DESPrimoOrdine"&gt;&lt;DESPrimoOrdine&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/DESPrimoOrdine"/&gt;&lt;/DESPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/CAP"&gt;&lt;CAP&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/CAP"/&gt;&lt;/CAP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/codiceISTATComune"&gt;&lt;codiceISTATComune&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/codiceISTATComune"/&gt;&lt;/codiceISTATComune&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/codiceISTATProvincia"&gt;&lt;codiceISTATProvincia&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/codiceISTATProvincia"/&gt;&lt;/codiceISTATProvincia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/codiceToponomastica"&gt;&lt;codiceToponomastica&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/codiceToponomastica"/&gt;&lt;/codiceToponomastica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/comune"&gt;&lt;comune&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/comune"/&gt;&lt;/comune&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/descrPartToponomastica"&gt;&lt;descrPartToponomastica&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/descrPartToponomastica"/&gt;&lt;/descrPartToponomastica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/descrizioneVia"&gt;&lt;descrizioneVia&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/descrizioneVia"/&gt;&lt;/descrizioneVia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/localita"&gt;&lt;localita&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/localita"/&gt;&lt;/localita&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/numeroCivico"&gt;&lt;numeroCivico&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/numeroCivico"/&gt;&lt;/numeroCivico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/provincia"&gt;&lt;provincia&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/provincia"/&gt;&lt;/provincia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/siglaProvincia"&gt;&lt;siglaProvincia&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/siglaProvincia"/&gt;&lt;/siglaProvincia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/distretto"&gt;&lt;distretto&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/distretto"/&gt;&lt;/distretto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/CLLI"&gt;&lt;CLLI&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/CLLI"/&gt;&lt;/CLLI&gt;&lt;/xsl:if&gt;&lt;CRMOrigine&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/CRMOrigine"/&gt;&lt;/CRMOrigine&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/codiceSLAAssurance"&gt;&lt;codiceSLAAssurance&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/codiceSLAAssurance"/&gt;&lt;/codiceSLAAssurance&gt;&lt;/xsl:if&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDOfferta&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/IDOfferta"/&gt;&lt;/IDOfferta&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/indirizzoEstesoNonCert"&gt;&lt;indirizzoEstesoNonCert&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/indirizzoEstesoNonCert"/&gt;&lt;/indirizzoEstesoNonCert&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase/part1/tns:Output/tns:Find/tns:Asset/numeroFittizio"&gt;&lt;numeroFittizio&gt;&lt;xsl:value-of select="$FindCase/part1/tns:Output/tns:Find/tns:Asset/numeroFittizio"/&gt;&lt;/numeroFittizio&gt;&lt;/xsl:if&gt;&lt;/tns:Asset&gt;&lt;/tns:Input&gt;&lt;/tns:Update&gt;&lt;/tns:Input&gt;&lt;/part1&gt;&lt;/ns:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindCase.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Upcase-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Update>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:CaseReference&quot;/>&#xa;                    &lt;/tns:CaseReference>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/codiceOrdineOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/codiceOrdineTI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/codiceOrdineTI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/invariante&quot;>&#xa;                            &lt;invariante>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/invariante&quot;/>&#xa;                            &lt;/invariante>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/lastUpdate&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/IDRichiestaOLO&quot;>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/IDRichiestaOLO&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/IDPrimoOrdine&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/IDPrimoOrdine&quot;/>&#xa;                            &lt;/IDPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/IDContratto&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/DEC&quot;>&#xa;                            &lt;DEC>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/DEC&quot;/>&#xa;                            &lt;/DEC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/statoAsset&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/IDRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/numeroTelefonico&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/numeroTelefonico&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/IDAssetCRMWS&quot;>&#xa;                            &lt;IDAssetCRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/IDAssetCRMWS&quot;/>&#xa;                            &lt;/IDAssetCRMWS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/IDAssetDa&quot;>&#xa;                            &lt;IDAssetDa>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/IDAssetDa&quot;/>&#xa;                            &lt;/IDAssetDa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DES>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/DES&quot;/>&#xa;                        &lt;/DES>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/tipologiaAccesso&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/RO&quot;>&#xa;                            &lt;RO>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/RO&quot;/>&#xa;                            &lt;/RO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/offerta&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/lineaRiferimento&quot;>&#xa;                            &lt;lineaRiferimento>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/lineaRiferimento&quot;/>&#xa;                            &lt;/lineaRiferimento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/complesso&quot;>&#xa;                            &lt;complesso>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/complesso&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/interno&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/interno&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/piano&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/piano&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/scala&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/scala&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$FindCase.part1/tns:Find/tns:Asset/dettaglioasset[nomeComponente='ACCESSOVULAFTTCAB' or nomeComponente = 'ACCESSOVULAFTTH']&quot;>&#xa;                            &lt;dettaglioasset>&#xa;                                &lt;IDAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                &lt;/IDAsset>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                                    &lt;IDDettaglioAssetParent>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                                    &lt;/IDDettaglioAssetParent>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                                    &lt;IDDettaglioAssetRoot>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                                    &lt;/IDDettaglioAssetRoot>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;integrationID>&#xa;                                    &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                &lt;/integrationID>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                                &lt;nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                &lt;/nomeComponente>&#xa;                                &lt;xsl:for-each select=&quot;attributidettaglioasset&quot;>&#xa;                                    &lt;attributidettaglioasset>&#xa;                                        &lt;IDAsset>&#xa;                                            &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                        &lt;/IDAsset>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                        &lt;IDDettaglioAsset>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                        &lt;/IDDettaglioAsset>&#xa;                                    &lt;/attributidettaglioasset>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'FLAGNUOVOMODELLO'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                    &lt;IDDettaglioAsset>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                    &lt;/IDDettaglioAsset>&#xa;                                &lt;/attributidettaglioasset>&#xa;                                &lt;IDRisorsaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                &lt;/IDRisorsaNOW>&#xa;                                &lt;IDDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                &lt;/IDDettaglioAsset>&#xa;                                &lt;statoDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                                &lt;/statoDettaglioAsset>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioasset>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:for-each select=&quot;$FindCase.part1/tns:Find/tns:Asset/dettaglioasset[nomeComponente='USERVLAN']&quot;>&#xa;                            &lt;dettaglioasset>&#xa;                                &lt;IDAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                &lt;/IDAsset>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                                    &lt;IDDettaglioAssetParent>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                                    &lt;/IDDettaglioAssetParent>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                                    &lt;IDDettaglioAssetRoot>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                                    &lt;/IDDettaglioAssetRoot>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;integrationID>&#xa;                                    &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                &lt;/integrationID>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                                &lt;nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                &lt;/nomeComponente>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count(attributidettaglioasset[nomeAttributo='PROFILOBMD'])>0&quot;>&#xa;                                        &lt;xsl:for-each select=&quot;attributidettaglioasset[nomeAttributo='PROFILOBMD']&quot;>&#xa;                                            &lt;attributidettaglioasset>&#xa;                                                &lt;IDAsset>&#xa;                                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                                &lt;/IDAsset>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                                    &lt;lastUpdate>&#xa;                                                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                                    &lt;/lastUpdate>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                                &lt;/nomeAttributo>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/ID_PROFILO_BMD&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                                &lt;IDDettaglioAsset>&#xa;                                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                                &lt;/IDDettaglioAsset>&#xa;                                            &lt;/attributidettaglioasset>&#xa;                                        &lt;/xsl:for-each>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:for-each select=&quot;attributidettaglioasset&quot;>&#xa;                                            &lt;attributidettaglioasset>&#xa;                                                &lt;IDAsset>&#xa;                                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                                &lt;/IDAsset>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                                    &lt;lastUpdate>&#xa;                                                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                                    &lt;/lastUpdate>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                                &lt;/nomeAttributo>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                                &lt;IDDettaglioAsset>&#xa;                                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                                &lt;/IDDettaglioAsset>&#xa;                                            &lt;/attributidettaglioasset>&#xa;                                        &lt;/xsl:for-each>&#xa;                                        &lt;attributidettaglioasset>&#xa;                                            &lt;IDAsset>&#xa;                                                &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                            &lt;/IDAsset>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;'PROFILOBMD'&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/ID_PROFILO_BMD&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                            &lt;IDDettaglioAsset>&#xa;                                                &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                            &lt;/IDDettaglioAsset>&#xa;                                        &lt;/attributidettaglioasset>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;IDRisorsaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                &lt;/IDRisorsaNOW>&#xa;                                &lt;IDDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                &lt;/IDDettaglioAsset>&#xa;                                &lt;statoDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                                &lt;/statoDettaglioAsset>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioasset>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/DESPrimoOrdine&quot;>&#xa;                            &lt;DESPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/DESPrimoOrdine&quot;/>&#xa;                            &lt;/DESPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/CAP&quot;>&#xa;                            &lt;CAP>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/CAP&quot;/>&#xa;                            &lt;/CAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCase.part1/tns:Find/tns:Asset/codiceISTATComune&quot;>&#xa;                            &lt;codiceISTATComune>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find/tns:Asset/codiceISTATComune&quot;/>&#xa;                           