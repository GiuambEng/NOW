                                <tibex:expression
                                    expression="count($JDBCVerificaIDRisorsaEStato/Record)>0 and count($JDBCVerificaIDRisorsaEStato/Record[STATOASSET='ATTIVO'])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($JDBCVerificaIDRisorsaEStato/Record)>0 and count($JDBCVerificaIDRisorsaEStato/Record[STATOASSET='ATTIVO'])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBCVerificaIDRisorsaEStatoToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($JDBCVerificaIDRisorsaEStato/Record)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($JDBCVerificaIDRisorsaEStato/Record)=0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source
                            linkName="JDBCVerificaIDRisorsaEStatoToCallProcess3"
                            tibex:faultDetailsVar="JDBCVerificaIDRisorsaEStato" tibex:faultNameVar="FaultName">
