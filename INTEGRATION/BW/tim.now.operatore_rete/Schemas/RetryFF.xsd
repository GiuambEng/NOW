<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/RetryFF" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/RetryFF">

    <complexType name="RetryRequestType">
    	<sequence>
    		<element name="Azione">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="GET"></enumeration>
    					<enumeration value="RETRY"></enumeration>
    					<enumeration value="OK"></enumeration>
    					<enumeration value="KO"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="IdRichiestaOLO" type="string"
    			minOccurs="0">
    		</element>
    		<element name="NumTentativo" type="int" minOccurs="0"></element>
    		<element name="CodiceEgon" type="string" minOccurs="0"></element>
    		<element name="Progettazione" type="string" minOccurs="0"></element>
    		<element name="IdGpon" type="string" minOccurs="0"></element>
    		<element name="CodiceRoe" type="string" minOccurs="0"></element>
    		<element name="CodiceSplitterPrimario" type="string"
    			minOccurs="0">
    		</element>
    		<element name="CodiceSplitterSecondario" type="string"
    			minOccurs="0">
    		</element>
    		<element name="PosizioneMorsettieraRoe" type="string"
    			minOccurs="0">
    		</element>
    		<element name="PosizioneMorsettiera" type="string"
    			minOccurs="0">
    		</element>
    		<element name="ErrorMessage" type="string" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="RetryFFRequest" type="tns:RetryRequestType"></element>
</schema>