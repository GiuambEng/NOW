                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+aaccb690-486a-4d77-b017-e651b92755e4+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SendFF&quot;/>&lt;xsl:template name=&quot;Query-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CAUS_ESITO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SendFF/parameters/tns1:BPM2FFRequest/tns1:CausaleEsitoDTU)&quot;>&lt;xsl:value-of select=&quot;$SendFF/parameters/tns1:BPM2FFRequest/tns1:CausaleEsitoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CAUS_ESITO>&lt;ESITO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SendFF/parameters/tns1:BPM2FFRequest/tns1:EsitoDTU)&quot;>&lt;xsl:value-of select=&quot;$SendFF/parameters/tns1:BPM2FFRequest/tns1:EsitoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ESITO>&lt;EVENTO_NATIVO_DTU>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SendFF/parameters/tns1:BPM2FFRequest/tns1:TipologiaEventoDTU)&quot;>&lt;xsl:value-of select=&quot;$SendFF/parameters/tns1:BPM2FFRequest/tns1:TipologiaEventoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/EVENTO_NATIVO_DTU>&lt;xsl:choose>&lt;xsl:when test=&quot;$SendFF/parameters/tns1:BPM2FFRequest/ns:RichiestaElement/operatoreRete='FC'&quot;>&lt;OPERATORE_RETE>&lt;xsl:value-of select=&quot;'FC'&quot;/>&lt;/OPERATORE_RETE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;OPERATORE_RETE>&lt;xsl:value-of select=&quot;'FF'&quot;/>&lt;/OPERATORE_RETE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
