                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendFF.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Query&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryDescrizione&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;DynamicMapping-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:BPM2FFRequest>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$SendFF.parameters/tns:TipoRiscontro = 'CESSAZIONE_TX' and $Oscuramento/Record[1]/FLAG_OSCURMENTO='1'&quot;>&#xa;                    &lt;tns:TipoRiscontro>&#xa;                        &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:TipoRiscontro = 'CESSAZIONE'&quot;/>&#xa;                    &lt;/tns:TipoRiscontro>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:TipoRiscontro>&#xa;                        &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:TipoRiscontro&quot;/>&#xa;                    &lt;/tns:TipoRiscontro>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$SendFF.parameters/ns:RichiestaElement&quot;/>&#xa;            &lt;xsl:if test=&quot;$SendFF.parameters/tns:Codice&quot;>&#xa;                &lt;tns:Codice>&#xa;                    &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:Codice&quot;/>&#xa;                &lt;/tns:Codice>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendFF.parameters/tns:Descrizione&quot;>&#xa;                &lt;tns:Descrizione>&#xa;                    &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:Descrizione&quot;/>&#xa;                &lt;/tns:Descrizione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendFF.parameters/tns:CodiceOrdineOperatore&quot;>&#xa;                &lt;tns:CodiceOrdineOperatore>&#xa;                    &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:CodiceOrdineOperatore&quot;/>&#xa;                &lt;/tns:CodiceOrdineOperatore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendFF.parameters/tns:CausaleEsitoDTU&quot;>&#xa;                &lt;tns:CausaleEsitoDTU>&#xa;                    &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:CausaleEsitoDTU&quot;/>&#xa;                &lt;/tns:CausaleEsitoDTU>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendFF.parameters/tns:EsitoDTU&quot;>&#xa;                &lt;tns:EsitoDTU>&#xa;                    &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:EsitoDTU&quot;/>&#xa;                &lt;/tns:EsitoDTU>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendFF.parameters/tns:TipologiaEventoDTU&quot;>&#xa;                &lt;tns:TipologiaEventoDTU>&#xa;                    &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:TipologiaEventoDTU&quot;/>&#xa;                &lt;/tns:TipologiaEventoDTU>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($SendFF.parameters/tns:OK_KO)&quot;>&#xa;                &lt;xsl:if test=&quot;$SendFF.parameters/tns:OK_KO&quot;>&#xa;                    &lt;tns:OK_KO>&#xa;                        &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:OK_KO&quot;/>&#xa;                    &lt;/tns:OK_KO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendFF.parameters/tns:IdRichiestaDTU&quot;>&#xa;                &lt;tns:IdRichiestaDTU>&#xa;                    &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:IdRichiestaDTU&quot;/>&#xa;                &lt;/tns:IdRichiestaDTU>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendFF.parameters/tns:NoteDaSistema&quot;>&#xa;                &lt;tns:NoteDaSistema>&#xa;                    &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:NoteDaSistema&quot;/>&#xa;                &lt;/tns:NoteDaSistema>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($SendFF.parameters/tns:AnnullamentoAutomatico)&quot;>&#xa;                &lt;xsl:if test=&quot;$SendFF.parameters/tns:AnnullamentoAutomatico&quot;>&#xa;                    &lt;tns:AnnullamentoAutomatico>&#xa;                        &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:AnnullamentoAutomatico&quot;/>&#xa;                    &lt;/tns:AnnullamentoAutomatico>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendFF.parameters/tns:TipoRiscontro='ESPLETAMENTO' and $SendFF.parameters/tns:OK_KO='KO'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Query/Record[1]/CAUSALE) and string-length($Query/Record[1]/CAUSALE)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Query/Record[1]/CAUSALE&quot;>&#xa;                            &lt;tns:CausaleEspletamentoKO>&#xa;                                &lt;xsl:value-of select=&quot;$Query/Record[1]/CAUSALE&quot;/>&#xa;                            &lt;/tns:CausaleEspletamentoKO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$SendFF.parameters/tns:CausaleEsitoDTU&quot;>&#xa;                            &lt;tns:CausaleEspletamentoKO>&#xa;                                &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:CausaleEsitoDTU&quot;/>&#xa;                            &lt;/tns:CausaleEspletamentoKO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendFF.parameters/tns:TipoRiscontro='ESPLETAMENTO' and $SendFF.parameters/tns:OK_KO='KO'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Query/Record[1]/DESCRIZIONE) and string-length($Query/Record[1]/DESCRIZIONE)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Query/Record[1]/DESCRIZIONE&quot;>&#xa;                            &lt;tns:DescrizioneEspletamentoKO>&#xa;                                &lt;xsl:value-of select=&quot;$Query/Record[1]/DESCRIZIONE&quot;/>&#xa;                            &lt;/tns:DescrizioneEspletamentoKO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$QueryDescrizione/Record[1]/DESCR&quot;>&#xa;                            &lt;tns:DescrizioneEspletamentoKO>&#xa;                                &lt;xsl:value-of select=&quot;$QueryDescrizione/Record[1]/DESCR&quot;/>&#xa;                            &lt;/tns:DescrizioneEspletamentoKO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendFF.parameters/tns:TipoRiscontro='ESPLETAMENTO' and $SendFF.parameters/tns:OK_KO='KO'&quot;>&#xa;                &lt;xsl:if test=&quot;$Query/Record[1]/FLAG_INVIO&quot;>&#xa;                    &lt;tns:FlagInvioEspletamentoKO>&#xa;                        &lt;xsl:value-of select=&quot;$Query/Record[1]/FLAG_INVIO&quot;/>&#xa;                    &lt;/tns:FlagInvioEspletamentoKO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendFF.parameters/tns:ConsistenzaDaInviare&quot;>&#xa;                &lt;tns:ConsistenzaDaInviare>&#xa;                    &lt;xsl:value-of select=&quot;$SendFF.parameters/tns:ConsistenzaDaInviare&quot;/>&#xa;                &lt;/tns:ConsistenzaDaInviare>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:BPM2FFRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
