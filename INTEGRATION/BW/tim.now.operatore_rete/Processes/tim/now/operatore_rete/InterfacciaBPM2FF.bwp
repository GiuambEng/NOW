$Query/Record[1]/CAUSALE)>0&quot;>&lt;xsl:if test=&quot;$Query/Record[1]/CAUSALE&quot;>&lt;tns:CausaleEspletamentoKO>&lt;xsl:value-of select=&quot;$Query/Record[1]/CAUSALE&quot;/>&lt;/tns:CausaleEspletamentoKO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$SendFF/parameters/tns:BPM2FFRequest/tns:CausaleEsitoDTU&quot;>&lt;tns:CausaleEspletamentoKO>&lt;xsl:value-of select=&quot;$SendFF/parameters/tns:BPM2FFRequest/tns:CausaleEsitoDTU&quot;/>&lt;/tns:CausaleEspletamentoKO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$SendFF/parameters/tns:BPM2FFRequest/tns:TipoRiscontro='ESPLETAMENTO' and $SendFF/parameters/tns:BPM2FFRequest/tns:OK_KO='KO'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Query/Record[1]/DESCRIZIONE) and string-length($Query/Record[1]/DESCRIZIONE)>0&quot;>&lt;xsl:if test=&quot;$Query/Record[1]/DESCRIZIONE&quot;>&lt;tns:DescrizioneEspletamentoKO>&lt;xsl:value-of select=&quot;$Query/Record[1]/DESCRIZIONE&quot;/>&lt;/tns:DescrizioneEspletamentoKO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$QueryDescrizione/Record[1]/DESCR&quot;>&lt;tns:DescrizioneEspletamentoKO>&lt;xsl:value-of select=&quot;$QueryDescrizione/Record[1]/DESCR&quot;/>&lt;/tns:DescrizioneEspletamentoKO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$SendFF/parameters/tns:BPM2FFRequest/tns:TipoRiscontro='ESPLETAMENTO' and $SendFF/parameters/tns:BPM2FFRequest/tns:OK_KO='KO'&quot;>&lt;xsl:if test=&quot;$Query/Record[1]/FLAG_INVIO&quot;>&lt;tns:FlagInvioEspletamentoKO>&lt;xsl:value-of select=&quot;$Query/Record[1]/FLAG_INVIO&quot;/>&lt;/tns:FlagInvioEspletamentoKO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$SendFF/parameters/tns:BPM2FFRequest/tns:ConsistenzaDaInviare&quot;>&lt;tns:ConsistenzaDaInviare>&lt;xsl:value-of select=&quot;$SendFF/parameters/tns:BPM2FFRequest/tns:ConsistenzaDaInviare&quot;/>&lt;/tns:ConsistenzaDaInviare>&lt;/xsl:if>&lt;/tns:BPM2FFRequest>&lt;/xsl:template