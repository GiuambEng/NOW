                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0f0fb289-d111-4e11-aa10-c72e74045288+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT s_id_notifica_ff.nextval AS id_notifica, s_id_messaggio_ff.nextval AS id_messaggio FROM dual " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_NOTIFICA"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_MESSAGGIO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="b3dd0526-4b3b-48ed-9d69-b35f9267e1e3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToEmpty1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput&amp;#x9;-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Inizio Processo: &amp;quot;&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($JDBCQuery)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogMapper-input"
                    name="LogMapper"
                    tibex:xpdlId="2e9298e1-f59b-4482-988b-177ef5c62cba"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToEnd"/>
                        <bpws:target linkName="MapperFCToLogMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess1ToInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperFC&quot;/>&#xa;    &lt;xsl:template name=&quot;LogMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Richiesta da inviare a FF: &amp;quot;&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Richiesta da inviare a FC: &amp;quot;&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns2:Payload>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($Mapper)&quot;/>&#xa;                        &lt;/tns2:Payload>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Payload>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapperFC)&quot;/>&#xa;                        &lt;/tns2:Payload>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:nslt2=&quot;urn:PegaRULES:SOAP:OrdiniCommerciali:Services&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Riscontri&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogRiscontri-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Risposta da FF: &amp;quot;&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Riscontri/cessazioneResponse/nslt2:cessazioneResponse)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogRiscontri-input"
                    name="LogRiscontri"
                    tibex:xpdlId="1afa1788-df36-4302-8e46-f33b49a35e77"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ScopeToLogRiscontri"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess2ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:nslt2=&quot;urn:PegaRULES:SOAP:OrdiniCommerciali:Services&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Riscontri.cessazioneResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogRiscontri-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Risposta da FF: &amp;quot;&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Riscontri.cessazioneResponse)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="InsertStaging-input"
                name="InsertStaging" operation="Tracciamento"
                outputVariable="InsertStaging"
                partnerLink="TracciamentoWSTIM2"
                portType="ns7:TracciamentoWSTIM2" tibex:xpdlId="1dcf55c5-de58-44aa-80b6-41fa54dac49b">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns3="http://www.tim.com/NOW/xsd/EONOWwhls" xmlns:tns4="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns1="http://www.tim.com/NOW/xsd/BPM2FF" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="Mapper"/&gt;
    &lt;xsl:param name="IdProcsoNoFile"/&gt;
    &lt;xsl:param name="MapperFC"/&gt;
    &lt;xsl:template name="InsertStaging-input" match="/"&gt;
        &lt;tns5:TracciamentoRequest&gt;
            &lt;parameters&gt;
                &lt;tns2:TracciamentoInput&gt;
                    &lt;tns2:InsertUpdateStaging&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;
                                &lt;tns4:ContenutoRequest&gt;
                                    &lt;xsl:value-of select="tib:render-xml($Mapper)"/&gt;
                                &lt;/tns4:ContenutoRequest&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:ContenutoRequest&gt;
                                    &lt;xsl:value-of select="tib:render-xml($MapperFC)"/&gt;
                                &lt;/tns4:ContenutoRequest&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns4:IdProcsoNoFile&gt;
                            &lt;xsl:value-of select="$IdProcsoNoFile"/&gt;
                        &lt;/tns4:IdProcsoNoFile&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;
                                &lt;tns4:IdMessaggio&gt;
                                    &lt;xsl:value-of select="$Mapper/richiesta/testata/idMessaggio"/&gt;
                                &lt;/tns4:IdMessaggio&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:IdMessaggio&gt;
                                    &lt;xsl:value-of select="$MapperFC/request/testata/idMessaggio"/&gt;
                                &lt;/tns4:IdMessaggio&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns4:IdStatoElabStaging&gt;
                            &lt;xsl:value-of select="42"/&gt;
                        &lt;/tns4:IdStatoElabStaging&gt;
                        &lt;tns4:TimstpRich&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TimstpRich&gt;
                        &lt;tns4:TimstpRisposta&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TimstpRisposta&gt;
                        &lt;tns4:IdRichOlo&gt;
                            &lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;
                        &lt;/tns4:IdRichOlo&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;
                                &lt;tns4:IdNotf&gt;
                                    &lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;
                                &lt;/tns4:IdNotf&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:IdNotf&gt;
                                    &lt;xsl:value-of select="$MapperFC/request/testata/idNotifica"/&gt;
                                &lt;/tns4:IdNotf&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;
                                &lt;tns4:IdRisorsaOperatoreRete&gt;
                                    &lt;xsl:value-of select="&amp;quot;FF&amp;quot;"/&gt;
                                &lt;/tns4:IdRisorsaOperatoreRete&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:IdRisorsaOperatoreRete&gt;
                                    &lt;xsl:value-of select="&amp;quot;FC&amp;quot;"/&gt;
                                &lt;/tns4:IdRisorsaOperatoreRete&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;
                                &lt;tns4:TipoOrdine&gt;
                                    &lt;xsl:value-of select="$Mapper/richiesta/testata/tipoOrdine"/&gt;
                                &lt;/tns4:TipoOrdine&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:TipoOrdine&gt;
                                    &lt;xsl:value-of select="$MapperFC/request/testata/tipoOrdine"/&gt;
                                &lt;/tns4:TipoOrdine&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;
                                &lt;tns4:Transaction_ID&gt;
                                    &lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;
                                &lt;/tns4:Transaction_ID&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:Transaction_ID&gt;
                                    &lt;xsl:value-of select="$MapperFC/request/testata/codiceOrdineOperatore"/&gt;
                                &lt;/tns4:Transaction_ID&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns4:Azione&gt;
                            &lt;xsl:value-of select="&amp;quot;Insert&amp;quot;"/&gt;
                        &lt;/tns4:Azione&gt;
                        &lt;tns4:TipoRiscontro&gt;
                            &lt;xsl:value-of select="$Start/tns1:TipoRiscontro"/&gt;
                        &lt;/tns4:TipoRiscontro&gt;
                        &lt;tns4:NumTentativo&gt;
                            &lt;xsl:value-of select="0"/&gt;
                        &lt;/tns4:NumTentativo&gt;
                    &lt;/tns2:InsertUpdateStaging&gt;
                    &lt;tns2:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/tns2:Azione&gt;
                    &lt;tns2:EONW&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;
                                &lt;tns3:SistemaDestinatario&gt;
                                    &lt;xsl:value-of select="&amp;quot;FLASHFIBER&amp;quot;"/&gt;
                                &lt;/tns3:SistemaDestinatario&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns3:SistemaDestinatario&gt;
                                    &lt;xsl:value-of select="&amp;quot;FIBERCOP&amp;quot;"/&gt;
                                &lt;/tns3:SistemaDestinatario&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns3:SistemaMittente&gt;
                            &lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;
                        &lt;/tns3:SistemaMittente&gt;
                        &lt;tns3:IdRichiestaOLO&gt;
                            &lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;
                        &lt;/tns3:IdRichiestaOLO&gt;
                        &lt;tns3:TipologiaEvento&gt;
                            &lt;xsl:value-of select="&amp;quot;FF_OL&amp;quot;"/&gt;
                        &lt;/tns3:TipologiaEvento&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;
                                &lt;tns3:Transaction_ID&gt;
                                    &lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;
                                &lt;/tns3:Transaction_ID&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns3:Transaction_ID&gt;
                                    &lt;xsl:value-of select="$MapperFC/request/testata/codiceOrdineOperatore"/&gt;
                                &lt;/tns3:Transaction_ID&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:if test="$Start/tns1:IdRichiestaDTU"&gt;
                            &lt;tns3:IdRichiestaDTU&gt;
                                &lt;xsl:value-of select="$Start/tns1:IdRichiestaDTU"/&gt;
                            &lt;/tns3:IdRichiestaDTU&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns2:EONW&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;
                            &lt;tns2:TransactionId&gt;
                                &lt;xsl:value-of select="concat($Mapper/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$Mapper/richiesta/testata/idMessaggio)"/&gt;
                            &lt;/tns2:TransactionId&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns2:TransactionId&gt;
                                &lt;xsl:value-of select="concat($MapperFC/request/testata/idNotifica,&amp;quot;-&amp;quot;,$MapperFC/request/testata/idMessaggio)"/&gt;
                            &lt;/tns2:TransactionId&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns2:IdProcsoNoFile&gt;
                        &lt;xsl:value-of select="$IdProcsoNoFile"/&gt;
                    &lt;/tns2:IdProcsoNoFile&gt;
                &lt;/tns2:TracciamentoInput&gt;
            &lt;/parameters&gt;
        &lt;/tns5:TracciamentoRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperFC&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns2:InsertUpdateStaging>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns4:ContenutoRequest>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($Mapper)&quot;/>&#xa;                        &lt;/tns4:ContenutoRequest>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:ContenutoRequest>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapperFC)&quot;/>&#xa;                        &lt;/tns4:ContenutoRequest>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:IdProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                &lt;/tns4:IdProcsoNoFile>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns4:IdMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idMessaggio&quot;/>&#xa;                        &lt;/tns4:IdMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:IdMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;$MapperFC/request/testata/idMessaggio&quot;/>&#xa;                        &lt;/tns4:IdMessaggio>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;42&quot;/>&#xa;                &lt;/tns4:IdStatoElabStaging>&#xa;                &lt;tns4:TimstpRich>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRich>&#xa;                &lt;tns4:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRisposta>&#xa;                &lt;tns4:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:IdRichOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns4:IdNotf>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                        &lt;/tns4:IdNotf>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:IdNotf>&#xa;                            &lt;xsl:value-of select=&quot;$MapperFC/request/testata/idNotifica&quot;/>&#xa;                        &lt;/tns4:IdNotf>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns4:IdRisorsaOperatoreRete>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FF&amp;quot;&quot;/>&#xa;                        &lt;/tns4:IdRisorsaOperatoreRete>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:IdRisorsaOperatoreRete>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FC&amp;quot;&quot;/>&#xa;                        &lt;/tns4:IdRisorsaOperatoreRete>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns4:TipoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/tipoOrdine&quot;/>&#xa;                        &lt;/tns4:TipoOrdine>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:TipoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$MapperFC/request/testata/tipoOrdine&quot;/>&#xa;                        &lt;/tns4:TipoOrdine>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns4:Transaction_ID>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                        &lt;/tns4:Transaction_ID>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:Transaction_ID>&#xa;                            &lt;xsl:value-of select=&quot;$MapperFC/request/testata/codiceOrdineOperatore&quot;/>&#xa;                        &lt;/tns4:Transaction_ID>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Insert&amp;quot;&quot;/>&#xa;                &lt;/tns4:Azione>&#xa;                &lt;tns4:TipoRiscontro>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:TipoRiscontro&quot;/>&#xa;                &lt;/tns4:TipoRiscontro>&#xa;                &lt;tns4:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns4:NumTentativo>&#xa;            &lt;/tns2:InsertUpdateStaging>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:EONW>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns3:SistemaDestinatario>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FLASHFIBER&amp;quot;&quot;/>&#xa;                        &lt;/tns3:SistemaDestinatario>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:SistemaDestinatario>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FIBERCOP&amp;quot;&quot;/>&#xa;                        &lt;/tns3:SistemaDestinatario>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:SistemaMittente>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaMittente>&#xa;                &lt;tns3:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:IdRichiestaOLO>&#xa;                &lt;tns3:TipologiaEvento>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FF_OL&amp;quot;&quot;/>&#xa;                &lt;/tns3:TipologiaEvento>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns3:Transaction_ID>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                        &lt;/tns3:Transaction_ID>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Transaction_ID>&#xa;                            &lt;xsl:value-of select=&quot;$MapperFC/request/testata/codiceOrdineOperatore&quot;/>&#xa;                        &lt;/tns3:Transaction_ID>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:IdRichiestaDTU&quot;>&#xa;                    &lt;tns3:IdRichiestaDTU>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaDTU&quot;/>&#xa;                    &lt;/tns3:IdRichiestaDTU>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:EONW>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                    &lt;tns2:TransactionId>&#xa;                        &lt;xsl:value-of select=&quot;concat($Mapper/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$Mapper/richiesta/testata/idMessaggio)&quot;/>&#xa;                    &lt;/tns2:TransactionId>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:TransactionId>&#xa;                        &lt;xsl:value-of select=&quot;concat($MapperFC/request/testata/idNotifica,&amp;quot;-&amp;quot;,$MapperFC/request/testata/idMessaggio)&quot;/>&#xa;                    &lt;/tns2:TransactionId>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:IdProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;            &lt;/tns2:IdProcsoNoFile>&#xa;        &lt;/tns2:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcess1ToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Invoke1ToInvoke"/>
