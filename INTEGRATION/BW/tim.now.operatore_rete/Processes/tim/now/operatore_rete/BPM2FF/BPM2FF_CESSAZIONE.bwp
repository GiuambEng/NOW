                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://ordinicommerciali.service.flashfiber.com/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRisorsaCessazione&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:cessazione>&#xa;            &lt;richiesta>&#xa;                &lt;testata>&#xa;                    &lt;codiceOperatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TIM&amp;quot;&quot;/>&#xa;                    &lt;/codiceOperatore>&#xa;                    &lt;codiceOrdineOperatore>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/codiceOrdineOperatore>&#xa;                    &lt;xsl:if test=&quot;not(ends-with($Start/tns1:CodiceOrdineOperatore, '_1'))&quot;>&#xa;                        &lt;codiceOrdineOperatorePadre>&#xa;                            &lt;xsl:value-of select=&quot;concat(tib:substring-before-last($Start/tns1:CodiceOrdineOperatore, &amp;quot;_&amp;quot;), &amp;quot;_1&amp;quot;)&quot;/>&#xa;                        &lt;/codiceOrdineOperatorePadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/codiceProgetto&quot;>&#xa;                        &lt;codiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codiceProgetto&quot;/>&#xa;                        &lt;/codiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;dataIdMessaggio>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/dataIdMessaggio>&#xa;                    &lt;dataIdNotifica>&#xa;                        &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[Y0001][M01][D01] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                    &lt;/dataIdNotifica>&#xa;                    &lt;idMessaggio>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_MESSAGGIO)&quot;/>&#xa;                    &lt;/idMessaggio>&#xa;                    &lt;idNotifica>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&#xa;                    &lt;/idNotifica>&#xa;                    &lt;tipoOrdine>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/lavorazione&quot;/>&#xa;                    &lt;/tipoOrdine>&#xa;                &lt;/testata>&#xa;                &lt;accessoGpon>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($IdRisorsaCessazione/Record[1]/IDRISORSAOPERATORERETE)>0&quot;>&#xa;                            &lt;idRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$IdRisorsaCessazione/Record[1]/IDRISORSAOPERATORERETE&quot;/>&#xa;                            &lt;/idRisorsa>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($IdRisorsaCessazione/Record[1]/IDRISORSA)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;contains($IdRisorsaCessazione/Record[1]/IDRISORSA, 'W')&quot;>&#xa;                                            &lt;idRisorsa>&#xa;                                                &lt;xsl:value-of select=&quot;translate(tib:substring-before-last($IdRisorsaCessazione/Record[1]/IDRISORSA, 'W'), ' ', '')&quot;/>&#xa;                                            &lt;/idRisorsa>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;idRisorsa>&#xa;                                                &lt;xsl:value-of select=&quot;$IdRisorsaCessazione/Record[1]/IDRISORSA&quot;/>&#xa;                                            &lt;/idRisorsa>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;contains($Start/ns:RichiestaElement/IDRisorsa, 'W')&quot;>&#xa;                                            &lt;idRisorsa>&#xa;                                                &lt;xsl:value-of select=&quot;translate(tib:substring-before-last($Start/ns:RichiestaElement/IDRisorsa, 'W'), ' ', '')&quot;/>&#xa;                                            &lt;/idRisorsa>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;idRisorsa>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;/>&#xa;                                            &lt;/idRisorsa>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:NoteDaSistema&quot;>&#xa;                        &lt;note>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:NoteDaSistema&quot;/>&#xa;                        &lt;/note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;outSourcer>&#xa;                        &lt;system>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;TIM&amp;quot;&quot;/>&#xa;                        &lt;/system>&#xa;                    &lt;/outSourcer>&#xa;                &lt;/accessoGpon>&#xa;            &lt;/richiesta>&#xa;        &lt;/tns2:cessazione>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
