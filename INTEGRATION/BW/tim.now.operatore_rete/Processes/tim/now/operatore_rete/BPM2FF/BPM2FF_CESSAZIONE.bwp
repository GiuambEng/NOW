                <bpws:correlations/>
            </bpws:invoke>
            <bpws:invoke inputVariable="Update-input" name="Update"
                operation="Tracciamento" outputVariable="Update"
                partnerLink="TracciamentoWSTIM2"
                portType="ns7:TracciamentoWSTIM2" tibex:xpdlId="7107d635-6e2c-455d-9527-39364c100446">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns5="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:tns3="http://www.tim.com/NOW/xsd/EventoOperatoreRete" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:nslt21="urn:PegaRULES:SOAP:OrdiniCommerciali:Services" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="Mapper"/&gt;
    &lt;xsl:param name="Riscontri"/&gt;
    &lt;xsl:param name="InsertStaging"/&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:template name="Update-input" match="/"&gt;
        &lt;tns4:TracciamentoRequest&gt;
            &lt;parameters&gt;
                &lt;tns2:TracciamentoInput&gt;
                    &lt;tns2:InsertUpdateStaging&gt;
                        &lt;tns5:ContenutoResponse&gt;
                            &lt;xsl:value-of select="tib:render-xml($Riscontri/cessazioneResponse/nslt21:cessazioneResponse)"/&gt;
                        &lt;/tns5:ContenutoResponse&gt;
                        &lt;tns5:IdStatoElabStaging&gt;
                            &lt;xsl:value-of select="11"/&gt;
                        &lt;/tns5:IdStatoElabStaging&gt;
                        &lt;tns5:TimstpRisposta&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns5:TimstpRisposta&gt;
                        &lt;tns5:CodiceAckNack&gt;
                            &lt;xsl:value-of select="$Riscontri/cessazioneResponse/nslt21:cessazioneResponse/risposta/esito/codice"/&gt;
                        &lt;/tns5:CodiceAckNack&gt;
                        &lt;xsl:if test="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"&gt;
                            &lt;tns5:IdEventoOrdnNowWhls&gt;
                                &lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;
                            &lt;/tns5:IdEventoOrdnNowWhls&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns5:Transaction_ID&gt;
                            &lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;
                        &lt;/tns5:Transaction_ID&gt;
                        &lt;tns5:Azione&gt;
                            &lt;xsl:value-of select="&amp;quot;Update&amp;quot;"/&gt;
                        &lt;/tns5:Azione&gt;
                        &lt;tns5:NumTentativo&gt;
                            &lt;xsl:value-of select="1"/&gt;
                        &lt;/tns5:NumTentativo&gt;
                    &lt;/tns2:InsertUpdateStaging&gt;
                    &lt;tns2:EventoOperatoreRete&gt;
                        &lt;tns3:IdEventoOrdnNowWhls&gt;
                            &lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;
                        &lt;/tns3:IdEventoOrdnNowWhls&gt;
                        &lt;tns3:IdNotf&gt;
                            &lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;
                        &lt;/tns3:IdNotf&gt;
                        &lt;tns3:IdRichOlo&gt;
                            &lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;
                        &lt;/tns3:IdRichOlo&gt;
                        &lt;tns3:IdMessaggio&gt;
                            &lt;xsl:value-of select="$Mapper/richiesta/testata/idMessaggio"/&gt;
                        &lt;/tns3:IdMessaggio&gt;
                        &lt;tns3:TimstpInsmto&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns3:TimstpInsmto&gt;
                        &lt;tns3:IdEventoOperatoreRete&gt;
                            &lt;xsl:value-of select="2"/&gt;
                        &lt;/tns3:IdEventoOperatoreRete&gt;
                        &lt;tns3:IdRisorsa&gt;
                            &lt;xsl:value-of select="$Mapper/richiesta/accessoGpon/idRisorsa"/&gt;
                        &lt;/tns3:IdRisorsa&gt;
                        &lt;xsl:if test="$Mapper/richiesta/accessoGpon/note"&gt;
                            &lt;tns3:Note&gt;
                                &lt;xsl:value-of select="$Mapper/richiesta/accessoGpon/note"/&gt;
                            &lt;/tns3:Note&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns2:EventoOperatoreRete&gt;
                    &lt;tns2:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                    &lt;/tns2:Azione&gt;
                    &lt;tns2:StatoEsec&gt;
                        &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                    &lt;/tns2:StatoEsec&gt;
                    &lt;tns2:ContenutoResponse&gt;
                        &lt;xsl:value-of select="tib:render-xml($Riscontri/cessazioneResponse/nslt21:cessazioneResponse)"/&gt;
                    &lt;/tns2:ContenutoResponse&gt;
                    &lt;tns2:CodiceAckNack&gt;
                        &lt;xsl:value-of select="$Riscontri/cessazioneResponse/nslt21:cessazioneResponse/risposta/esito/codice"/&gt;
                    &lt;/tns2:CodiceAckNack&gt;
                    &lt;tns2:TransactionId&gt;
                        &lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;
                    &lt;/tns2:TransactionId&gt;
                    &lt;xsl:if test="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"&gt;
                        &lt;tns2:IdEventoOrdineNowWhls&gt;
                            &lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;
                        &lt;/tns2:IdEventoOrdineNowWhls&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns2:TracciamentoInput&gt;
            &lt;/parameters&gt;
        &lt;/tns4:TracciamentoRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EventoOperatoreRete&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:nslt21=&quot;urn:PegaRULES:SOAP:OrdiniCommerciali:Services&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Riscontri.cessazioneResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStaging.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns2:InsertUpdateStaging>&#xa;                &lt;tns5:ContenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Riscontri.cessazioneResponse)&quot;/>&#xa;                &lt;/tns5:ContenutoResponse>&#xa;                &lt;tns5:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns5:IdStatoElabStaging>&#xa;                &lt;tns5:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns5:TimstpRisposta>&#xa;                &lt;tns5:CodiceAckNack>&#xa;                    &lt;xsl:value-of select=&quot;$Riscontri.cessazioneResponse/risposta/esito/codice&quot;/>&#xa;                &lt;/tns5:CodiceAckNack>&#xa;                &lt;xsl:if test=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;>&#xa;                    &lt;tns5:IdEventoOrdnNowWhls>&#xa;                        &lt;xsl:value-of select=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;/>&#xa;                    &lt;/tns5:IdEventoOrdnNowWhls>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns5:Transaction_ID>&#xa;                &lt;tns5:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&#xa;                &lt;/tns5:Azione>&#xa;                &lt;tns5:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/tns5:NumTentativo>&#xa;            &lt;/tns2:InsertUpdateStaging>&#xa;            &lt;tns2:EventoOperatoreRete>&#xa;                &lt;tns3:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;/>&#xa;                &lt;/tns3:IdEventoOrdnNowWhls>&#xa;                &lt;tns3:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns3:IdNotf>&#xa;                &lt;tns3:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:IdRichOlo>&#xa;                &lt;tns3:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idMessaggio&quot;/>&#xa;                &lt;/tns3:IdMessaggio>&#xa;                &lt;tns3:TimstpInsmto>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns3:TimstpInsmto>&#xa;                &lt;tns3:IdEventoOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdEventoOperatoreRete>&#xa;                &lt;tns3:IdRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGpon/idRisorsa&quot;/>&#xa;                &lt;/tns3:IdRisorsa>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGpon/note&quot;>&#xa;                    &lt;tns3:Note>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGpon/note&quot;/>&#xa;                    &lt;/tns3:Note>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:EventoOperatoreRete>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/tns2:StatoEsec>&#xa;            &lt;tns2:ContenutoResponse>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($Riscontri.cessazioneResponse)&quot;/>&#xa;            &lt;/tns2:ContenutoResponse>&#xa;            &lt;tns2:CodiceAckNack>&#xa;                &lt;xsl:value-of select=&quot;$Riscontri.cessazioneResponse/risposta/esito/codice&quot;/>&#xa;            &lt;/tns2:CodiceAckNack>&#xa;            &lt;tns2:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;            &lt;/tns2:TransactionId>&#xa;            &lt;xsl:if test=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;>&#xa;                &lt;tns2:IdEventoOrdineNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;/>&#xa;                &lt;/tns2:IdEventoOrdineNowWhls>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
