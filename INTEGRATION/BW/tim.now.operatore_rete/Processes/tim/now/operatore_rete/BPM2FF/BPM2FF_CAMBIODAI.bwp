                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Update.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Termine del sottoprocesso di invio cambioDAI. Update della staging eseguito: &amp;quot;&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Update.parameters)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="Update-input" name="Update"
                operation="Tracciamento" outputVariable="Update"
                partnerLink="TracciamentoWSTIM2"
                portType="ns7:TracciamentoWSTIM2" tibex:xpdlId="3f3c299c-f7eb-497e-b9e6-4baabed2ef1b">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:nslt2="urn:PegaRULES:SOAP:RiscontriOL:Services" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns3="http://www.tim.com/NOW/xsd/EventoOperatoreRete" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="InsertStaging"/&gt;&lt;xsl:param name="Riscontri"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="Update-input" match="/"&gt;&lt;tns1:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns2:TracciamentoInput&gt;&lt;tns2:InsertUpdateStaging&gt;&lt;tns:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Riscontri/riscontriOLResponse/nslt2:riscontriOLResponse)"/&gt;&lt;/tns:ContenutoResponse&gt;&lt;tns:IdStatoElabStaging&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns:IdStatoElabStaging&gt;&lt;tns:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns:TimstpRisposta&gt;&lt;tns:CodiceAckNack&gt;&lt;xsl:value-of select="$Riscontri/riscontriOLResponse/nslt2:riscontriOLResponse/risposta/esito/codice"/&gt;&lt;/tns:CodiceAckNack&gt;&lt;xsl:if test="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"&gt;&lt;tns:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;&lt;/tns:IdEventoOrdnNowWhls&gt;&lt;/xsl:if&gt;&lt;tns:Transaction_ID&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns:Transaction_ID&gt;&lt;tns:Azione&gt;&lt;xsl:value-of select="&amp;quot;Update&amp;quot;"/&gt;&lt;/tns:Azione&gt;&lt;tns:NumTentativo&gt;&lt;xsl:value-of select="1"/&gt;&lt;/tns:NumTentativo&gt;&lt;/tns2:InsertUpdateStaging&gt;&lt;tns2:EventoOperatoreRete&gt;&lt;tns3:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;&lt;/tns3:IdEventoOrdnNowWhls&gt;&lt;tns3:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns3:IdNotf&gt;&lt;tns3:IdRichOlo&gt;&lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns3:IdRichOlo&gt;&lt;tns3:IdMessaggio&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idMessaggio"/&gt;&lt;/tns3:IdMessaggio&gt;&lt;tns3:TimstpInsmto&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns3:TimstpInsmto&gt;&lt;tns3:IdEventoOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdEventoOperatoreRete&gt;&lt;tns3:CodMotivoCambioDai&gt;&lt;xsl:value-of select="$Mapper/richiesta/cambioDAI/codiceMotivoCambioDAI"/&gt;&lt;/tns3:CodMotivoCambioDai&gt;&lt;tns3:CodOrdineFlashfiber&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineFlashFiber"/&gt;&lt;/tns3:CodOrdineFlashfiber&gt;&lt;tns3:DescrMotivoCambioDai&gt;&lt;xsl:value-of select="$Mapper/richiesta/cambioDAI/descrizioneMotivoCambioDAI"/&gt;&lt;/tns3:DescrMotivoCambioDai&gt;&lt;xsl:if test="$Mapper/richiesta/cambioDAI/nuovaFasciaDAI"&gt;&lt;tns3:FasciaOrariaDai&gt;&lt;xsl:value-of select="$Mapper/richiesta/cambioDAI/nuovaFasciaDAI"/&gt;&lt;/tns3:FasciaOrariaDai&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/cambioDAI/note"&gt;&lt;tns3:Note&gt;&lt;xsl:value-of select="$Mapper/richiesta/cambioDAI/note"/&gt;&lt;/tns3:Note&gt;&lt;/xsl:if&gt;&lt;tns3:NuovaDai&gt;&lt;xsl:value-of select="tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$Mapper/richiesta/cambioDAI/nuovaDAI)"/&gt;&lt;/tns3:NuovaDai&gt;&lt;/tns2:EventoOperatoreRete&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:StatoEsec&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/tns2:StatoEsec&gt;&lt;tns2:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Riscontri/riscontriOLResponse/nslt2:riscontriOLResponse)"/&gt;&lt;/tns2:ContenutoResponse&gt;&lt;tns2:CodiceAckNack&gt;&lt;xsl:value-of select="$Riscontri/riscontriOLResponse/nslt2:riscontriOLResponse/risposta/esito/codice"/&gt;&lt;/tns2:CodiceAckNack&gt;&lt;tns2:TransactionId&gt;&lt;xsl:value-of select="concat($Mapper/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$Mapper/richiesta/testata/idMessaggio)"/&gt;&lt;/tns2:TransactionId&gt;&lt;xsl:if test="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"&gt;&lt;tns2:IdEventoOrdineNowWhls&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;&lt;/tns2:IdEventoOrdineNowWhls&gt;&lt;/xsl:if&gt;&lt;/tns2:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns1:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
