                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommerciali.service.flashfiber.com/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:cambioDAI>&lt;richiesta>&lt;testata>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;FFACQUISITO&amp;quot;])&quot;>&lt;codiceOrdineFlashFiber>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;FFACQUISITO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICEORDINEFLASHFIBER&amp;quot;]/valoreAttributo&quot;/>&lt;/codiceOrdineFlashFiber>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codiceOrdineFlashFiber>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;FFRIFIUTOACQUISITO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICEORDINEFLASHFIBER&amp;quot;]/valoreAttributo&quot;/>&lt;/codiceOrdineFlashFiber>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codiceOrdineOperatore>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/codiceOrdineOperatore>&lt;codiceOutSourcer>&lt;xsl:value-of select=&quot;&amp;quot;TIM&amp;quot;&quot;/>&lt;/codiceOutSourcer>&lt;dataIdMessaggio>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/dataIdMessaggio>&lt;dataIdNotifica>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[Y0001][M01][D01] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/dataIdNotifica>&lt;dataRiscontro>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/dataRiscontro>&lt;idMessaggio>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_MESSAGGIO)&quot;/>&lt;/idMessaggio>&lt;idNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&lt;/idNotifica>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/lavorazione&quot;/>&lt;/tipoOrdine>&lt;tipoRiscontro>&lt;xsl:value-of select=&quot;&amp;quot;CAMBIO DAI&amp;quot;&quot;/>&lt;/tipoRiscontro>&lt;/testata>&lt;cambioDAI>&lt;codiceMotivoCambioDAI>&lt;xsl:value-of select=&quot;$Start/tns1:Codice&quot;/>&lt;/codiceMotivoCambioDAI>&lt;descrizioneMotivoCambioDAI>&lt;xsl:value-of select=&quot;$Start/tns1:Descrizione&quot;/>&lt;/descrizioneMotivoCambioDAI>&lt;note>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/note>&lt;nuovaDAI>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DATAAPPUNTAMENTO&amp;quot;]/valoreAttributo), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/nuovaDAI>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ORAAPPUNTAMENTO&amp;quot;]/valoreAttributo&quot;>&lt;nuovaFasciaDAI>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ORAAPPUNTAMENTO&amp;quot;]/valoreAttributo&quot;/>&lt;/nuovaFasciaDAI>&lt;/xsl:if>&lt;/cambioDAI>&lt;/richiesta>&lt;/tns:cambioDAI>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
