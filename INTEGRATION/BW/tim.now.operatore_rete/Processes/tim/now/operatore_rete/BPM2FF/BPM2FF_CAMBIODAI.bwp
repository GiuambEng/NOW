ciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateTimeout-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:TracciamentoInput>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;tns1:IdEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($InsertStaging.parameters/tns1:IdEsecProcsoNoFile))&quot;/>&#xa;            &lt;/tns1:IdEsecProcsoNoFile>&#xa;            &lt;xsl:if test=&quot;$InsertStaging.parameters/tns1:CodProcsoNoFile&quot;>&#xa;                &lt;tns1:CodProcsoFIle>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStaging.parameters/tns1:CodProcsoNoFile&quot;/>&#xa;                &lt;/tns1:CodProcsoFIle>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;            &lt;/tns1:StatoEsec>&#xa;            &lt;tns1:DescrErrore>&#xa;                &lt;xsl:value-of select=&quot;'TIMEOUT'&quot;/>&#xa;            &lt;/tns1:DescrErrore>&#xa;            &lt;xsl:if test=&quot;$Start/tns3:CodiceOrdineOperatore&quot;>&#xa;                &lt;tns1:TransactionId>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns3:CodiceOrdineOperatore&quot;/>&#xa;                &lt;/tns1:TransactionId>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertStaging.parameters/tns1:IdEventoOrdineWhls&quot;>&#xa;                &lt;tns1:IdEventoOrdineNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStaging.parameters/tns1:IdEventoOrdineWhls&quot;/>&#xa;                &lt;/tns1:IdEventoOrdineNowWhls>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:IdProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;            &lt;/tns1:IdProcsoNoFile>&#xa;            &lt;tns1:NumTentativo>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/tns1:NumTentativo>&#xa;        &lt;/tns1:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
