            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:nslt2=&quot;urn:PegaRULES:SOAP:RiscontriOL:Services&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:param name=&quot;Riscontri&quot;/>&lt;xsl:template name=&quot;LogRiscontri-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Risposta da FF: &amp;quot;&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($Riscontri/riscontriOLResponse/nslt2:riscontriOLResponse)&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogRiscontri-input"
                    name="LogRiscontri"
                    tibex:xpdlId="1afa1788-df36-4302-8e46-f33b49a35e77"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ScopeToLogRiscontri"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess2ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:nslt2=&quot;urn:PegaRULES:SOAP:RiscontriOL:Services&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Riscontri.riscontriOLResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogRiscontri-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Risposta da FF: &amp;quot;&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Riscontri.riscontriOLResponse)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="InsertStaging-input"
                name="InsertStaging" operation="Tracciamento"
                outputVariable="InsertStaging"
                partnerLink="TracciamentoWSTIM2"
                portType="ns7:TracciamentoWSTIM2" tibex:xpdlId="2eda9a78-ab15-48ad-b5c0-5177da2bff79">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns3="http://www.tim.com/NOW/xsd/EONOWwhls" xmlns:tns4="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns="http://www.tim.com/NOW/xsd/BPM2FF" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="IdProcsoNoFile"/&gt;&lt;xsl:template name="InsertStaging-input" match="/"&gt;&lt;tns1:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns2:TracciamentoInput&gt;&lt;tns2:InsertUpdateStaging&gt;&lt;tns4:ContenutoRequest&gt;&lt;xsl:value-of select="tib:render-xml($Mapper)"/&gt;&lt;/tns4:ContenutoRequest&gt;&lt;tns4:IdProcsoNoFile&gt;&lt;xsl:value-of select="$IdProcsoNoFile"/&gt;&lt;/tns4:IdProcsoNoFile&gt;&lt;tns4:IdMessaggio&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idMessaggio"/&gt;&lt;/tns4:IdMessaggio&gt;&lt;tns4:IdStatoElabStaging&gt;&lt;xsl:value-of select="42"/&gt;&lt;/tns4:IdStatoElabStaging&gt;&lt;tns4:TimstpRich&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns4:TimstpRich&gt;&lt;tns4:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns4:TimstpRisposta&gt;&lt;tns4:IdRichOlo&gt;&lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns4:IdRichOlo&gt;&lt;tns4:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns4:IdNotf&gt;&lt;tns4:IdRisorsaOperatoreRete&gt;&lt;xsl:value-of select="&amp;quot;FF&amp;quot;"/&gt;&lt;/tns4:IdRisorsaOperatoreRete&gt;&lt;tns4:TipoOrdine&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/tipoOrdine"/&gt;&lt;/tns4:TipoOrdine&gt;&lt;tns4:Transaction_ID&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns4:Transaction_ID&gt;&lt;tns4:Azione&gt;&lt;xsl:value-of select="&amp;quot;Insert&amp;quot;"/&gt;&lt;/tns4:Azione&gt;&lt;tns4:TipoRiscontro&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/tipoRiscontro"/&gt;&lt;/tns4:TipoRiscontro&gt;&lt;tns4:NumTentativo&gt;&lt;xsl:value-of select="0&amp;#xD;&amp;#xA;"/&gt;&lt;/tns4:NumTentativo&gt;&lt;/tns2:InsertUpdateStaging&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:EONW&gt;&lt;tns3:SistemaDestinatario&gt;&lt;xsl:value-of select="&amp;quot;FLASHFIBER&amp;quot;"/&gt;&lt;/tns3:SistemaDestinatario&gt;&lt;tns3:SistemaMittente&gt;&lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;&lt;/tns3:SistemaMittente&gt;&lt;tns3:IdRichiestaOLO&gt;&lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns3:IdRichiestaOLO&gt;&lt;tns3:TipologiaEvento&gt;&lt;xsl:value-of select="&amp;quot;FF_OL&amp;quot;"/&gt;&lt;/tns3:TipologiaEvento&gt;&lt;tns3:Transaction_ID&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns3:Transaction_ID&gt;&lt;xsl:if test="$Start/tns:IdRichiestaDTU"&gt;&lt;tns3:IdRichiestaDTU&gt;&lt;xsl:value-of select="$Start/tns:IdRichiestaDTU"/&gt;&lt;/tns3:IdRichiestaDTU&gt;&lt;/xsl:if&gt;&lt;/tns2:EONW&gt;&lt;tns2:TransactionId&gt;&lt;xsl:value-of select="concat($Mapper/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$Mapper/richiesta/testata/idMessaggio)"/&gt;&lt;/tns2:TransactionId&gt;&lt;tns2:IdProcsoNoFile&gt;&lt;xsl:value-of select="$IdProcsoNoFile"/&gt;&lt;/tns2:IdProcsoNoFile&gt;&lt;/tns2:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns1:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns2:InsertUpdateStaging>&#xa;                &lt;tns4:ContenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Mapper)&quot;/>&#xa;                &lt;/tns4:ContenutoRequest>&#xa;                &lt;tns4:IdProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                &lt;/tns4:IdProcsoNoFile>&#xa;                &lt;tns4:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idMessaggio&quot;/>&#xa;                &lt;/tns4:IdMessaggio>&#xa;                &lt;tns4:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;42&quot;/>&#xa;                &lt;/tns4:IdStatoElabStaging>&#xa;                &lt;tns4:TimstpRich>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRich>&#xa;                &lt;tns4:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRisposta>&#xa;                &lt;tns4:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:IdRichOlo>&#xa;                &lt;tns4:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns4:IdNotf>&#xa;                &lt;tns4:IdRisorsaOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FF&amp;quot;&quot;/>&#xa;                &lt;/tns4:IdRisorsaOperatoreRete>&#xa;                &lt;tns4:TipoOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/tipoOrdine&quot;/>&#xa;                &lt;/tns4:TipoOrdine>&#xa;                &lt;tns4:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns4:Transaction_ID>&#xa;                &lt;tns4:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Insert&amp;quot;&quot;/>&#xa;                &lt;/tns4:Azione>&#xa;                &lt;tns4:TipoRiscontro>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/tipoRiscontro&quot;/>&#xa;                &lt;/tns4:TipoRiscontro>&#xa;                &lt;tns4:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;0&amp;#xD;&amp;#xA;&quot;/>&#xa;                &lt;/tns4:NumTentativo>&#xa;            &lt;/tns2:InsertUpdateStaging>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:EONW>&#xa;                &lt;tns3:SistemaDestinatario>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FLASHFIBER&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaDestinatario>&#xa;                &lt;tns3:SistemaMittente>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaMittente>&#xa;                &lt;tns3:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:IdRichiestaOLO>&#xa;                &lt;tns3:TipologiaEvento>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FF_OL&amp;quot;&quot;/>&#xa;                &lt;/tns3:TipologiaEvento>&#xa;                &lt;tns3:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns3:Transaction_ID>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiestaDTU&quot;>&#xa;                    &lt;tns3:IdRichiestaDTU>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaDTU&quot;/>&#xa;                    &lt;/tns3:IdRichiestaDTU>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:EONW>&#xa;            &lt;tns2:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($Mapper/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$Mapper/richiesta/testata/idMessaggio)&quot;/>&#xa;            &lt;/tns2:TransactionId>&#xa;            &lt;tns2:IdProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;            &lt;/tns2:IdProcsoNoFile>&#xa;        &lt;/tns2:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcess1ToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Invoke1ToInvoke"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:param name=&quot;InsertStaging&quot;/>&lt;xsl:template name=&quot;LogTrack-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Output insert staging: &amp;quot;&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($InsertStaging/parameters/tns2:TracciamentoOutput)&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogTrack-input" name="LogTrack"
                    tibex:xpdlId="25b50b92-c764-4240-b524-8b8adca2463d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Invoke1ToInvoke"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogTrackToScope">
                            <tibex:DesignExpression>
                                <tibex:expression expression="1=2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[1=2]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogTrackToLogNuovaGestione">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogTrack-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Output insert staging: &amp;quot;&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InsertStaging.parameters)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:param name=&quot;Update&quot;/>&lt;xsl:template name=&quot;LogUpdate-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Termine del sottoprocesso di invio cambioDAI. Update della staging eseguito: &amp;quot;&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($Update/parameters/tns2:TracciamentoOutput)&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
