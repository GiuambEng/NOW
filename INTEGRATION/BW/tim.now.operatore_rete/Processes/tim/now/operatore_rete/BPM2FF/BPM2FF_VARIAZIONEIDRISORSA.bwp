                    <bpws:sources>
                        <bpws:source linkName="LogMapperToTracciamentoWSTIM2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperFC&quot;/>&#xa;    &lt;xsl:template name=&quot;LogMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Richiesta da inviare a FC: &amp;quot;&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperFC)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="InsertStaging-input"
                name="InsertStaging" operation="Tracciamento"
                outputVariable="InsertStaging"
                partnerLink="TracciamentoWSTIM2"
                portType="ns2:TracciamentoWSTIM2" tibex:xpdlId="691cc912-eb3b-47de-b256-1173f1caafdc">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns7="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns5="http://www.tim.com/NOW/xsd/EONOWwhls" xmlns:tns8="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns1="http://www.tim.com/NOW/xsd/BPM2FF" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="IdProcsoNoFile"/&gt;
    &lt;xsl:param name="MapperFC"/&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:template name="InsertStaging-input" match="/"&gt;
        &lt;tns6:TracciamentoRequest&gt;
            &lt;parameters&gt;
                &lt;tns7:TracciamentoInput&gt;
                    &lt;tns7:InsertUpdateStaging&gt;
                        &lt;tns8:ContenutoRequest&gt;
                            &lt;xsl:value-of select="tib:render-xml($MapperFC)"/&gt;
                        &lt;/tns8:ContenutoRequest&gt;
                        &lt;tns8:IdProcsoNoFile&gt;
                            &lt;xsl:value-of select="$IdProcsoNoFile"/&gt;
                        &lt;/tns8:IdProcsoNoFile&gt;
                        &lt;tns8:IdMessaggio&gt;
                            &lt;xsl:value-of select="$MapperFC/request/testata/idMessaggio"/&gt;
                        &lt;/tns8:IdMessaggio&gt;
                        &lt;tns8:IdStatoElabStaging&gt;
                            &lt;xsl:value-of select="42"/&gt;
                        &lt;/tns8:IdStatoElabStaging&gt;
                        &lt;tns8:TimstpRich&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns8:TimstpRich&gt;
                        &lt;tns8:TimstpRisposta&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns8:TimstpRisposta&gt;
                        &lt;tns8:IdRichOlo&gt;
                            &lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;
                        &lt;/tns8:IdRichOlo&gt;
                        &lt;tns8:IdNotf&gt;
                            &lt;xsl:value-of select="$MapperFC/request/testata/idNotifica"/&gt;
                        &lt;/tns8:IdNotf&gt;
                        &lt;tns8:IdRisorsaOperatoreRete&gt;
                            &lt;xsl:value-of select="&amp;quot;FC&amp;quot;"/&gt;
                        &lt;/tns8:IdRisorsaOperatoreRete&gt;
                        &lt;tns8:TipoOrdine&gt;
                            &lt;xsl:value-of select="$MapperFC/request/testata/tipoOrdine"/&gt;
                        &lt;/tns8:TipoOrdine&gt;
                        &lt;tns8:Transaction_ID&gt;
                            &lt;xsl:value-of select="$MapperFC/request/testata/codiceOrdineOperatore"/&gt;
                        &lt;/tns8:Transaction_ID&gt;
                        &lt;tns8:Azione&gt;
                            &lt;xsl:value-of select="&amp;quot;Insert&amp;quot;"/&gt;
                        &lt;/tns8:Azione&gt;
                        &lt;tns8:TipoRiscontro&gt;
                            &lt;xsl:value-of select="$Start/tns1:TipoRiscontro"/&gt;
                        &lt;/tns8:TipoRiscontro&gt;
                        &lt;tns8:NumTentativo&gt;
                            &lt;xsl:value-of select="0"/&gt;
                        &lt;/tns8:NumTentativo&gt;
                    &lt;/tns7:InsertUpdateStaging&gt;
                    &lt;tns7:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/tns7:Azione&gt;
                    &lt;tns7:EONW&gt;
                        &lt;tns5:SistemaDestinatario&gt;
                            &lt;xsl:value-of select="&amp;quot;FIBERCOP&amp;quot;"/&gt;
                        &lt;/tns5:SistemaDestinatario&gt;
                        &lt;tns5:SistemaMittente&gt;
                            &lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;
                        &lt;/tns5:SistemaMittente&gt;
                        &lt;tns5:IdRichiestaOLO&gt;
                            &lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;
                        &lt;/tns5:IdRichiestaOLO&gt;
                        &lt;tns5:TipologiaEvento&gt;
                            &lt;xsl:value-of select="&amp;quot;FF_OL&amp;quot;"/&gt;
                        &lt;/tns5:TipologiaEvento&gt;
                        &lt;tns5:Transaction_ID&gt;
                            &lt;xsl:value-of select="$MapperFC/request/testata/codiceOrdineOperatore"/&gt;
                        &lt;/tns5:Transaction_ID&gt;
                        &lt;xsl:if test="$Start/tns1:IdRichiestaDTU"&gt;
                            &lt;tns5:IdRichiestaDTU&gt;
                                &lt;xsl:value-of select="$Start/tns1:IdRichiestaDTU"/&gt;
                            &lt;/tns5:IdRichiestaDTU&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns7:EONW&gt;
                    &lt;tns7:TransactionId&gt;
                        &lt;xsl:value-of select="concat($MapperFC/request/testata/idNotifica,&amp;quot;-&amp;quot;,$MapperFC/request/testata/idMessaggio)"/&gt;
                    &lt;/tns7:TransactionId&gt;
                    &lt;tns7:IdProcsoNoFile&gt;
                        &lt;xsl:value-of select="$IdProcsoNoFile"/&gt;
                    &lt;/tns7:IdProcsoNoFile&gt;
                &lt;/tns7:TracciamentoInput&gt;
            &lt;/parameters&gt;
        &lt;/tns6:TracciamentoRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperFC&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:TracciamentoInput>&#xa;            &lt;tns7:InsertUpdateStaging>&#xa;                &lt;tns8:ContenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperFC)&quot;/>&#xa;                &lt;/tns8:ContenutoRequest>&#xa;                &lt;tns8:IdProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                &lt;/tns8:IdProcsoNoFile>&#xa;                &lt;tns8:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/idMessaggio&quot;/>&#xa;                &lt;/tns8:IdMessaggio>&#xa;                &lt;tns8:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;42&quot;/>&#xa;                &lt;/tns8:IdStatoElabStaging>&#xa;                &lt;tns8:TimstpRich>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns8:TimstpRich>&#xa;                &lt;tns8:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns8:TimstpRisposta>&#xa;                &lt;tns8:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns8:IdRichOlo>&#xa;                &lt;tns8:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/idNotifica&quot;/>&#xa;                &lt;/tns8:IdNotf>&#xa;                &lt;tns8:IdRisorsaOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FC&amp;quot;&quot;/>&#xa;                &lt;/tns8:IdRisorsaOperatoreRete>&#xa;                &lt;tns8:TipoOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/tipoOrdine&quot;/>&#xa;                &lt;/tns8:TipoOrdine>&#xa;                &lt;tns8:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns8:Transaction_ID>&#xa;                &lt;tns8:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Insert&amp;quot;&quot;/>&#xa;                &lt;/tns8:Azione>&#xa;                &lt;tns8:TipoRiscontro>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:TipoRiscontro&quot;/>&#xa;                &lt;/tns8:TipoRiscontro>&#xa;                &lt;tns8:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns8:NumTentativo>&#xa;            &lt;/tns7:InsertUpdateStaging>&#xa;            &lt;tns7:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns7:Azione>&#xa;            &lt;tns7:EONW>&#xa;                &lt;tns5:SistemaDestinatario>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FIBERCOP&amp;quot;&quot;/>&#xa;                &lt;/tns5:SistemaDestinatario>&#xa;                &lt;tns5:SistemaMittente>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns5:SistemaMittente>&#xa;                &lt;tns5:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns5:IdRichiestaOLO>&#xa;                &lt;tns5:TipologiaEvento>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FF_OL&amp;quot;&quot;/>&#xa;                &lt;/tns5:TipologiaEvento>&#xa;                &lt;tns5:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns5:Transaction_ID>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:IdRichiestaDTU&quot;>&#xa;                    &lt;tns5:IdRichiestaDTU>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaDTU&quot;/>&#xa;                    &lt;/tns5:IdRichiestaDTU>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns7:EONW>&#xa;            &lt;tns7:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($MapperFC/request/testata/idNotifica,&amp;quot;-&amp;quot;,$MapperFC/request/testata/idMessaggio)&quot;/>&#xa;            &lt;/tns7:TransactionId>&#xa;            &lt;tns7:IdProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;            &lt;/tns7:IdProcsoNoFile>&#xa;        &lt;/tns7:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
