        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperFCToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogMapperToTracciamentoWSTIM2" tibex:linkType="SUCCESS"/>
                <bpws:link name="InsertStagingToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToJDBCQuery1" tibex:linkType="SUCCESS"/>
                <bpws:link name="QueryOscuramentoToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogOscuramentoToMapperFC" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogOscuramentoToJDBCQuery1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="RichiestaToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogRichiestaToMapperFC" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="3f8ceea8-b50c-439e-8ab6-cdb3af575419"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="6d348bde-21c1-4949-8bf9-1d12de28cc6b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="JDBCQuery-input"
                    name="JDBCQuery" outputVariable="JDBCQuery"
                    tibex:xpdlId="a6495c5b-6c49-422b-aec3-0ac100de82a1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a6495c5b-6c49-422b-aec3-0ac100de82a1+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT s_id_notifica_ff.nextval AS id_notifica, s_id_messaggio_ff.nextval AS id_messaggio FROM dual " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_NOTIFICA"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_MESSAGGIO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="e7d25ec1-f2b2-43ea-9dfc-7991e809d741"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToJDBCQuery1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Inizio Processo di invio variazione id risorsa. Id  &amp;quot;&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($JDBCQuery)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="MapperFC-input"
                    name="MapperFC" outputVariable="MapperFC"
                    tibex:xpdlId="1a7b4d26-3a1b-4e91-9f97-72f2448453df" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogOscuramentoToMapperFC"/>
                        <bpws:target linkName="LogRichiestaToMapperFC"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperFCToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://ordinicommerciali.service.fibercop.com/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;QueryOscuramento&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:template name=&quot;MapperFC-input&quot; match=&quot;/&quot;>&lt;tns4:variazioneIDRisorsa>&lt;request>&lt;testata>&lt;codiceOperatore>&lt;xsl:value-of select=&quot;'TIM'&quot;/>&lt;/codiceOperatore>&lt;codiceOrdineOperatore>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/codiceOrdineOperatore>&lt;dataIdMessaggio>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/dataIdMessaggio>&lt;idMessaggio>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_MESSAGGIO)&quot;/>&lt;/idMessaggio>&lt;idNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&lt;/idNotifica>&lt;dataIdNotifica>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/dataIdNotifica>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:TipoRiscontro = 'MIGRAZ_INTRA'&quot;>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;&amp;quot;MIGRAZ_INTRA&amp;quot;&quot;/>&lt;/tipoOrdine>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:TipoRiscontro = 'MIGRAZIONE'&quot;>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;'MIGRAZIONE'&quot;/>&lt;/tipoOrdine>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;'UPDATE_ID'&quot;/>&lt;/tipoOrdine>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/offerta = ('VULAFTTH','BITSTREAMNGAFTTH','EASYIPNGAFTTH', 'SEMIVULAFTTH', 'SEMIBITSTREAMNGAFTTH', 'SEMIEASYIPNGAFTTH')&quot;>&lt;servizio>&lt;xsl:value-of select=&quot;&amp;quot;SemiGpon&amp;quot;&quot;/>&lt;/servizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;servizio>&lt;xsl:value-of select=&quot;'RAME'&quot;/>&lt;/servizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/offerta = ('SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH','SEMIEASYIPNGAFTTH')&quot;>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/codificaOLOAGCOM&quot;>&lt;codiceOperatoreOspitato>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/codificaOLOAGCOM&quot;/>&lt;/codiceOperatoreOspitato>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codiceOperatoreOspitato>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/codiceOperatoreOspitato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/offerta = ('SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH','SEMIEASYIPNGAFTTH')&quot;>&lt;codiceOperatoreOspitante>&lt;xsl:value-of select=&quot;&amp;quot;TIM&amp;quot;&quot;/>&lt;/codiceOperatoreOspitante>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codiceOperatoreOspitante>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/codiceOperatoreOspitante>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/testata>&lt;accessoGponUpdate>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:TipoRiscontro = 'MIGRAZIONE' and count($QueryOscuramento/Record)=0 and ($Start/ns:RichiestaElement/codiceTrasformazione = 'TSHA_ULLD' or ( $Start/ns:RichiestaElement/codiceTrasformazione = 'TCOND_NAKED' and $Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente= 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo = 'POTS'))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Richiesta/Record[NOMEATTRIBUTO='OPERATORERETE']/VALOREATTRIBUTO = 'FC'&quot;>&lt;idRisorsa>&lt;xsl:value-of select=&quot;if (contains($Richiesta/Record[NOMEATTRIBUTO='IDRISORSA']/VALOREATTRIBUTO, 'W')) then translate(tib:substring-before-last($Richiesta/Record[NOMEATTRIBUTO='IDRISORSA']/VALOREATTRIBUTO, 'W'), ' ', '') else $Richiesta/Record[NOMEATTRIBUTO='IDRISORSA']/VALOREATTRIBUTO&quot;/>&lt;/idRisorsa>&lt;/xsl:when>&lt;xsl:otherwise>&lt;idRisorsa>&lt;xsl:value-of select=&quot;if (contains($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo, 'W')) then translate(tib:substring-before-last($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo, 'W'), ' ', '') else $Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo&quot;/>&lt;/idRisorsa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:ConsistenzaDaInviare='CONSISTENZAFONIA'&quot;>&lt;idRisorsa>&lt;xsl:value-of select=&quot;if (contains($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo, 'W')) then translate(tib:substring-before-last($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo, 'W'), ' ', '') else $Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&lt;/idRisorsa>&lt;/xsl:when>&lt;xsl:otherwise>&lt;idRisorsa>&lt;xsl:value-of select=&quot;if (contains($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo, 'W')) then translate(tib:substring-before-last($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo, 'W'), ' ', '') else $Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&lt;/idRisorsa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:NoteDaSistema&quot;>&lt;note>&lt;xsl:value-of select=&quot;$Start/tns1:NoteDaSistema&quot;/>&lt;/note>&lt;/xsl:if>&lt;outSourcer>&lt;system>&lt;xsl:value-of select=&quot;'TIM'&quot;/>&lt;/system>&lt;/outSourcer>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:TipoRiscontro = 'MIGRAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($QueryOscuramento/Record)=0 and ($Start/ns:RichiestaElement/codiceTrasformazione = 'TSHA_ULLD' or ( $Start/ns:RichiestaElement/codiceTrasformazione = 'TCOND_NAKED' and $Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente= 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo = 'POTS'))&quot;>&lt;xsl:if test=&quot;if (contains($Start/ns:RichiestaElement/IDRisorsa, 'W')) then translate(tib:substring-before-last($Start/ns:RichiestaElement/IDRisorsa, 'W'), ' ', '') else $Start/ns:RichiestaElement/IDRisorsa&quot;>&lt;IdRisorsaNew>&lt;xsl:value-of select=&quot;if (contains($Start/ns:RichiestaElement/IDRisorsa, 'W')) then translate(tib:substring-before-last($Start/ns:RichiestaElement/IDRisorsa, 'W'), ' ', '') else $Start/ns:RichiestaElement/IDRisorsa&quot;/>&lt;/IdRisorsaNew>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:ConsistenzaDaInviare='CONSISTENZAFONIA' and $Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo !=$Start/ns:RichiestaElement/IDRisorsa&quot;>&lt;xsl:if test=&quot;if (contains($Start/ns:RichiestaElement/IDRisorsa, 'W')) then translate(tib:substring-before-last($Start/ns:RichiestaElement/IDRisorsa, 'W'), ' ', '') else $Start/ns:RichiestaElement/IDRisorsa&quot;>&lt;IdRisorsaNew>&lt;xsl:value-of select=&quot;if (contains($Start/ns:RichiestaElement/IDRisorsa, 'W')) then translate(tib:substring-before-last($Start/ns:RichiestaElement/IDRisorsa, 'W'), ' ', '') else $Start/ns:RichiestaElement/IDRisorsa&quot;/>&lt;/IdRisorsaNew>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:ConsistenzaDaInviare='CONSISTENZADATI' and $Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo !=$Start/ns:RichiestaElement/IDRisorsa&quot;>&lt;xsl:if test=&quot;if (contains($Start/ns:RichiestaElement/IDRisorsa, 'W')) then translate(tib:substring-before-last($Start/ns:RichiestaElement/IDRisorsa, 'W'), ' ', '') else $Start/ns:RichiestaElement/IDRisorsa&quot;>&lt;IdRisorsaNew>&lt;xsl:value-of select=&quot;if (contains($Start/ns:RichiestaElement/IDRisorsa, 'W')) then translate(tib:substring-before-last($Start/ns:RichiestaElement/IDRisorsa, 'W'), ' ', '') else $Start/ns:RichiestaElement/IDRisorsa&quot;/>&lt;/IdRisorsaNew>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;if (contains($Start/ns:RichiestaElement/IDRisorsa, 'W')) then translate(tib:substring-before-last($Start/ns:RichiestaElement/IDRisorsa, 'W'), ' ', '') else $Start/ns:RichiestaElement/IDRisorsa&quot;>&lt;IdRisorsaNew>&lt;xsl:value-of select=&quot;if (contains($Start/ns:RichiestaElement/IDRisorsa, 'W')) then translate(tib:substring-before-last($Start/ns:RichiestaElement/IDRisorsa, 'W'), ' ', '') else $Start/ns:RichiestaElement/IDRisorsa&quot;/>&lt;/IdRisorsaNew>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/accessoGponUpdate>&lt;/request>&lt;/tns4:variazioneIDRisorsa>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:ordinicommerciali.service.fibercop.com="http://ordinicommerciali.service.fibercop.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="ordinicommerciali.service.fibercop.com:variazioneIDRisorsa" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogMapper-input"
                    name="LogMapper"
                    tibex:xpdlId="83d83b0c-fbc8-4ef4-aee9-efbcc763f30e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
