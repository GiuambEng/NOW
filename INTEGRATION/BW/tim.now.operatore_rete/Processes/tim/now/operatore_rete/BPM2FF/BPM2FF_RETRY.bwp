                portType="ns6:TracciamentoWSTIM2" tibex:xpdlId="c0442bc3-4ed6-44db-938e-12801a6b060c">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:tns3="http://www.tim.com/NOW/xsd/EventoOperatoreRete" xmlns:nslt2="urn:PegaRULES:SOAP:OrdiniCommerciali:Services" xmlns:tns4="http://www.tim.com/NOW/xsd/RetryFF" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="InsertStaging"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="RETRY"/&gt;&lt;xsl:template name="Update-input" match="/"&gt;&lt;tns1:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns2:TracciamentoInput&gt;&lt;tns2:InsertUpdateStaging&gt;&lt;tns:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($RETRY/attivazioneResponse/nslt2:attivazioneResponse)"/&gt;&lt;/tns:ContenutoResponse&gt;&lt;tns:IdStatoElabStaging&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns:IdStatoElabStaging&gt;&lt;tns:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns:TimstpRisposta&gt;&lt;xsl:if test="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"&gt;&lt;tns:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;&lt;/tns:IdEventoOrdnNowWhls&gt;&lt;/xsl:if&gt;&lt;tns:Transaction_ID&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns:Transaction_ID&gt;&lt;tns:Azione&gt;&lt;xsl:value-of select="&amp;quot;Update&amp;quot;"/&gt;&lt;/tns:Azione&gt;&lt;xsl:if test="$Start/tns4:NumTentativo"&gt;&lt;tns:NumTentativo&gt;&lt;xsl:value-of select="$Start/tns4:NumTentativo"/&gt;&lt;/tns:NumTentativo&gt;&lt;/xsl:if&gt;&lt;/tns2:InsertUpdateStaging&gt;&lt;tns2:EventoOperatoreRete&gt;&lt;tns3:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;&lt;/tns3:IdEventoOrdnNowWhls&gt;&lt;tns3:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns3:IdNotf&gt;&lt;tns3:IdRichOlo&gt;&lt;xsl:value-of select="$Start/tns4:IdRichiestaOLO"/&gt;&lt;/tns3:IdRichOlo&gt;&lt;tns3:IdMessaggio&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idMessaggio"/&gt;&lt;/tns3:IdMessaggio&gt;&lt;tns3:TimstpInsmto&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns3:TimstpInsmto&gt;&lt;tns3:IdEventoOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdEventoOperatoreRete&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/sede/cap"&gt;&lt;tns3:Cap&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/sede/cap"/&gt;&lt;/tns3:Cap&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/datiCliente/codiceFiscale"&gt;&lt;tns3:Cf&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/datiCliente/codiceFiscale"/&gt;&lt;/tns3:Cf&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/sede/civico"&gt;&lt;tns3:Civico&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/sede/civico"/&gt;&lt;/tns3:Civico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/sede/codiceComune"&gt;&lt;tns3:CodComune&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/sede/codiceComune"/&gt;&lt;/tns3:CodComune&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/codiceSplitterPrimario"&gt;&lt;tns3:CodSplitterPrimario&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/codiceSplitterPrimario"/&gt;&lt;/tns3:CodSplitterPrimario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/codiceSplitterSecondario"&gt;&lt;tns3:CodSplitterSecondario&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/codiceSplitterSecondario"/&gt;&lt;/tns3:CodSplitterSecondario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/codiceROE"&gt;&lt;tns3:CodRoe&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/codiceROE"/&gt;&lt;/tns3:CodRoe&gt;&lt;/xsl:if&gt;&lt;tns3:CognomeRagSociale&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/datiCliente/cognomeRagioneSociale"/&gt;&lt;/tns3:CognomeRagSociale&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/sede/complesso"&gt;&lt;tns3:Complesso&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/sede/complesso"/&gt;&lt;/tns3:Complesso&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length($Mapper/richiesta/accessoGponLna/outSourcer/dataDAI)&gt;0"&gt;&lt;tns3:DataDai&gt;&lt;xsl:value-of select="tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$Mapper/richiesta/accessoGponLna/outSourcer/dataDAI)"/&gt;&lt;/tns3:DataDai&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/outSourcer/fasciaOrariaDAI"&gt;&lt;tns3:FasciaOrariaDai&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/outSourcer/fasciaOrariaDAI"/&gt;&lt;/tns3:FasciaOrariaDai&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/idGpon"&gt;&lt;tns3:IdGpon&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/idGpon"/&gt;&lt;/tns3:IdGpon&gt;&lt;/xsl:if&gt;&lt;tns3:IdEgon&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/sede/codiceEgon"/&gt;&lt;/tns3:IdEgon&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/sede/interno"&gt;&lt;tns3:Interno&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/sede/interno"/&gt;&lt;/tns3:Interno&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/sede/localita"&gt;&lt;tns3:Localita&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/sede/localita"/&gt;&lt;/tns3:Localita&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/datiCliente/nome"&gt;&lt;tns3:Nome&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/datiCliente/nome"/&gt;&lt;/tns3:Nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/note"&gt;&lt;tns3:Note&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/note"/&gt;&lt;/tns3:Note&gt;&lt;/xsl:if&gt;&lt;tns3:FlagProgettazione&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/progettazione"/&gt;&lt;/tns3:FlagProgettazione&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/posizioneMorsettieraROE"&gt;&lt;tns3:PosizMorsettieraRoe&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/posizioneMorsettieraROE"/&gt;&lt;/tns3:PosizMorsettieraRoe&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/posizioneSplitterSecondario"&gt;&lt;tns3:PosizSplitter&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/posizioneSplitterSecondario"/&gt;&lt;/tns3:PosizSplitter&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/sede/piano"&gt;&lt;tns3:Piano&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/sede/piano"/&gt;&lt;/tns3:Piano&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/datiCliente/partitaIva"&gt;&lt;tns3:Piva&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/datiCliente/partitaIva"/&gt;&lt;/tns3:Piva&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/datiCliente/recapitoMobileCliente"&gt;&lt;tns3:RecapitoMobileCliente&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/datiCliente/recapitoMobileCliente"/&gt;&lt;/tns3:RecapitoMobileCliente&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/datiCliente/recapitoFissoCliente"&gt;&lt;tns3:RecapitoFissoCliente&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/datiCliente/recapitoFissoCliente"/&gt;&lt;/tns3:RecapitoFissoCliente&gt;&lt;/xsl:if&gt;&lt;tns3:Riprogettazione&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/outSourcer/riprogettazione"/&gt;&lt;/tns3:Riprogettazione&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/sede/scala"&gt;&lt;tns3:Scala&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/sede/scala"/&gt;&lt;/tns3:Scala&gt;&lt;/xsl:if&gt;&lt;tns3:SlaAssurance&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/slaAssurance"/&gt;&lt;/tns3:SlaAssurance&gt;&lt;xsl:if test="$Mapper/richiesta/accessoGponLna/sede/via"&gt;&lt;tns3:Via&gt;&lt;xsl:value-of select="$Mapper/richiesta/accessoGponLna/sede/via"/&gt;&lt;/tns3:Via&gt;&lt;/xsl:if&gt;&lt;/tns2:EventoOperatoreRete&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:StatoEsec&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/tns2:StatoEsec&gt;&lt;tns2:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($RETRY/attivazioneResponse/nslt2:attivazioneResponse)"/&gt;&lt;/tns2:ContenutoResponse&gt;&lt;tns2:TransactionId&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns2:TransactionId&gt;&lt;xsl:if test="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"&gt;&lt;tns2:IdEventoOrdineNowWhls&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;&lt;/tns2:IdEventoOrdineNowWhls&gt;&lt;/xsl:if&gt;&lt;/tns2:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns1:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EventoOperatoreRete&quot; xmlns:nslt2=&quot;urn:PegaRULES:SOAP:OrdiniCommerciali:Services&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/RetryFF&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RETRY.attivazioneResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns2:InsertUpdateStaging>&#xa;                &lt;tns:ContenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($RETRY.attivazioneResponse)&quot;/>&#xa;                &lt;/tns:ContenutoResponse>&#xa;                &lt;tns:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns:IdStatoElabStaging>&#xa;                &lt;tns:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TimstpRisposta>&#xa;                &lt;xsl:if test=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;>&#xa;                    &lt;tns:IdEventoOrdnNowWhls>&#xa;                        &lt;xsl:value-of select=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;/>&#xa;                    &lt;/tns:IdEventoOrdnNowWhls>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns:Transaction_ID>&#xa;                &lt;tns:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&#xa;                &lt;/tns:Azione>&#xa;                &lt;xsl:if test=&quot;$Start/tns4:NumTentativo&quot;>&#xa;                    &lt;tns:NumTentativo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns4:NumTentativo&quot;/>&#xa;                    &lt;/tns:NumTentativo>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:InsertUpdateStaging>&#xa;            &lt;tns2:EventoOperatoreRete>&#xa;                &lt;tns3:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;/>&#xa;                &lt;/tns3:IdEventoOrdnNowWhls>&#xa;                &lt;tns3:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns3:IdNotf>&#xa;                &lt;tns3:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdRichiestaOLO&quot;/>&#xa;                &lt;/tns3:IdRichOlo>&#xa;                &lt;tns3:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idMessaggio&quot;/>&#xa;                &lt;/tns3:IdMessaggio>&#xa;                &lt;tns3:TimstpInsmto>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns3:TimstpInsmto>&#xa;                &lt;tns3:IdEventoOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdEventoOperatoreRete>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/sede/cap&quot;>&#xa;                    &lt;tns3:Cap>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/sede/cap&quot;/>&#xa;                    &lt;/tns3:Cap>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/datiCliente/codiceFiscale&quot;>&#xa;                    &lt;tns3:Cf>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/datiCliente/codiceFiscale&quot;/>&#xa;                    &lt;/tns3:Cf>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/sede/civico&quot;>&#xa;                    &lt;tns3:Civico>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/sede/civico&quot;/>&#xa;                    &lt;/tns3:Civico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/sede/codiceComune&quot;>&#xa;                    &lt;tns3:CodComune>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/sede/codiceComune&quot;/>&#xa;                    &lt;/tns3:CodComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/codiceSplitterPrimario&quot;>&#xa;                    &lt;tns3:CodSplitterPrimario>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/codiceSplitterPrimario&quot;/>&#xa;                    &lt;/tns3:CodSplitterPrimario>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/codiceSplitterSecondario&quot;>&#xa;                    &lt;tns3:CodSplitterSecondario>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/codiceSplitterSecondario&quot;/>&#xa;                    &lt;/tns3:CodSplitterSecondario>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/codiceROE&quot;>&#xa;                    &lt;tns3:CodRoe>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/codiceROE&quot;/>&#xa;                    &lt;/tns3:CodRoe>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:CognomeRagSociale>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/datiCliente/cognomeRagioneSociale&quot;/>&#xa;                &lt;/tns3:CognomeRagSociale>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/sede/complesso&quot;>&#xa;                    &lt;tns3:Complesso>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/sede/complesso&quot;/>&#xa;                    &lt;/tns3:Complesso>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($Mapper/richiesta/accessoGponLna/outSourcer/dataDAI)>0&quot;>&#xa;                    &lt;tns3:DataDai>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$Mapper/richiesta/accessoGponLna/outSourcer/dataDAI)&quot;/>&#xa;                    &lt;/tns3:DataDai>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/outSourcer/fasciaOrariaDAI&quot;>&#xa;                    &lt;tns3:FasciaOrariaDai>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/outSourcer/fasciaOrariaDAI&quot;/>&#xa;                    &lt;/tns3:FasciaOrariaDai>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/idGpon&quot;>&#xa;                    &lt;tns3:IdGpon>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/idGpon&quot;/>&#xa;                    &lt;/tns3:IdGpon>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:IdEgon>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/sede/codiceEgon&quot;/>&#xa;                &lt;/tns3:IdEgon>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/sede/interno&quot;>&#xa;                    &lt;tns3:Interno>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/sede/interno&quot;/>&#xa;                    &lt;/tns3:Interno>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/sede/localita&quot;>&#xa;                    &lt;tns3:Localita>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/sede/localita&quot;/>&#xa;                    &lt;/tns3:Localita>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/datiCliente/nome&quot;>&#xa;                    &lt;tns3:Nome>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/datiCliente/nome&quot;/>&#xa;                    &lt;/tns3:Nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/note&quot;>&#xa;                    &lt;tns3:Note>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/note&quot;/>&#xa;                    &lt;/tns3:Note>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:FlagProgettazione>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/progettazione&quot;/>&#xa;                &lt;/tns3:FlagProgettazione>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/posizioneMorsettieraROE&quot;>&#xa;                    &lt;tns3:PosizMorsettieraRoe>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/posizioneMorsettieraROE&quot;/>&#xa;                    &lt;/tns3:PosizMorsettieraRoe>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/posizioneSplitterSecondario&quot;>&#xa;                    &lt;tns3:PosizSplitter>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/posizioneSplitterSecondario&quot;/>&#xa;                    &lt;/tns3:PosizSplitter>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/sede/piano&quot;>&#xa;                    &lt;tns3:Piano>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/sede/piano&quot;/>&#xa;                    &lt;/tns3:Piano>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/datiCliente/partitaIva&quot;>&#xa;                    &lt;tns3:Piva>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/datiCliente/partitaIva&quot;/>&#xa;                    &lt;/tns3:Piva>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/datiCliente/recapitoMobileCliente&quot;>&#xa;                    &lt;tns3:RecapitoMobileCliente>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/datiCliente/recapitoMobileCliente&quot;/>&#xa;                    &lt;/tns3:RecapitoMobileCliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/datiCliente/recapitoFissoCliente&quot;>&#xa;                    &lt;tns3:RecapitoFissoCliente>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/datiCliente/recapitoFissoCliente&quot;/>&#xa;                    &lt;/tns3:RecapitoFissoCliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Riprogettazione>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/outSourcer/riprogettazione&quot;/>&#xa;                &lt;/tns3:Riprogettazione>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/sede/scala&quot;>&#xa;                    &lt;tns3:Scala>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/sede/scala&quot;/>&#xa;                    &lt;/tns3:Scala>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:SlaAssurance>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/slaAssurance&quot;/>&#xa;                &lt;/tns3:SlaAssurance>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/accessoGponLna/sede/via&quot;>&#xa;                    &lt;tns3:Via>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/accessoGponLna/sede/via&quot;/>&#xa;                    &lt;/tns3:Via>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:EventoOperatoreRete>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/tns2:StatoEsec>&#xa;            &lt;tns2:ContenutoResponse>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($RETRY.attivazioneResponse)&quot;/>&#xa;            &lt;/tns2:ContenutoResponse>&#xa;            &lt;tns2:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;            &lt;/tns2:TransactionId>&#xa;            &lt;xsl:if test=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;>&#xa;                &lt;tns2:IdEventoOrdineNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;/>&#xa;                &lt;/tns2:IdEventoOrdineNowWhls>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
