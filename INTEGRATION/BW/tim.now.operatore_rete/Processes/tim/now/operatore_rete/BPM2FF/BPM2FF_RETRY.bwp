            <bpws:invoke inputVariable="InsertStaging-input"
                name="InsertStaging" operation="Tracciamento"
                outputVariable="InsertStaging"
                partnerLink="TracciamentoWSTIM2"
                portType="ns6:TracciamentoWSTIM2" tibex:xpdlId="6fed0f36-72ec-4546-8ce7-b77b98bdd699">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns3="http://www.tim.com/NOW/xsd/EONOWwhls" xmlns:tns4="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/RetryFF" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="IdProcsoNoFile"/&gt;&lt;xsl:template name="InsertStaging-input" match="/"&gt;&lt;tns1:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns2:TracciamentoInput&gt;&lt;tns2:InsertUpdateStaging&gt;&lt;tns4:ContenutoRequest&gt;&lt;xsl:value-of select="tib:render-xml($Mapper)"/&gt;&lt;/tns4:ContenutoRequest&gt;&lt;tns4:IdProcsoNoFile&gt;&lt;xsl:value-of select="$IdProcsoNoFile"/&gt;&lt;/tns4:IdProcsoNoFile&gt;&lt;tns4:IdMessaggio&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idMessaggio"/&gt;&lt;/tns4:IdMessaggio&gt;&lt;tns4:IdStatoElabStaging&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns4:IdStatoElabStaging&gt;&lt;tns4:TimstpRich&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns4:TimstpRich&gt;&lt;tns4:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns4:TimstpRisposta&gt;&lt;xsl:if test="$Start/tns5:IdRichiestaOLO"&gt;&lt;tns4:IdRichOlo&gt;&lt;xsl:value-of select="$Start/tns5:IdRichiestaOLO"/&gt;&lt;/tns4:IdRichOlo&gt;&lt;/xsl:if&gt;&lt;tns4:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns4:IdNotf&gt;&lt;tns4:IdRisorsaOperatoreRete&gt;&lt;xsl:value-of select="&amp;quot;FF&amp;quot;"/&gt;&lt;/tns4:IdRisorsaOperatoreRete&gt;&lt;tns4:TipoOrdine&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/tipoOrdine"/&gt;&lt;/tns4:TipoOrdine&gt;&lt;tns4:Transaction_ID&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns4:Transaction_ID&gt;&lt;tns4:Azione&gt;&lt;xsl:value-of select="&amp;quot;Insert&amp;quot;"/&gt;&lt;/tns4:Azione&gt;&lt;tns4:TipoRiscontro&gt;&lt;xsl:value-of select="&amp;quot;ATTIVAZIONE&amp;quot;"/&gt;&lt;/tns4:TipoRiscontro&gt;&lt;xsl:if test="$Start/tns5:NumTentativo"&gt;&lt;tns4:NumTentativo&gt;&lt;xsl:value-of select="$Start/tns5:NumTentativo"/&gt;&lt;/tns4:NumTentativo&gt;&lt;/xsl:if&gt;&lt;/tns2:InsertUpdateStaging&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:EONW&gt;&lt;tns3:SistemaDestinatario&gt;&lt;xsl:value-of select="&amp;quot;FLASHFIBER&amp;quot;"/&gt;&lt;/tns3:SistemaDestinatario&gt;&lt;tns3:SistemaMittente&gt;&lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;&lt;/tns3:SistemaMittente&gt;&lt;xsl:if test="$Start/tns5:IdRichiestaOLO"&gt;&lt;tns3:IdRichiestaOLO&gt;&lt;xsl:value-of select="$Start/tns5:IdRichiestaOLO"/&gt;&lt;/tns3:IdRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;tns3:TipologiaEvento&gt;&lt;xsl:value-of select="&amp;quot;FF_OL&amp;quot;"/&gt;&lt;/tns3:TipologiaEvento&gt;&lt;tns3:Transaction_ID&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns3:Transaction_ID&gt;&lt;/tns2:EONW&gt;&lt;tns2:TransactionId&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns2:TransactionId&gt;&lt;tns2:IdProcsoNoFile&gt;&lt;xsl:value-of select="$IdProcsoNoFile"/&gt;&lt;/tns2:IdProcsoNoFile&gt;&lt;/tns2:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns1:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/RetryFF&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns2:InsertUpdateStaging>&#xa;                &lt;tns4:ContenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Mapper)&quot;/>&#xa;                &lt;/tns4:ContenutoRequest>&#xa;                &lt;tns4:IdProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                &lt;/tns4:IdProcsoNoFile>&#xa;                &lt;tns4:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idMessaggio&quot;/>&#xa;                &lt;/tns4:IdMessaggio>&#xa;                &lt;tns4:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns4:IdStatoElabStaging>&#xa;                &lt;tns4:TimstpRich>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRich>&#xa;                &lt;tns4:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRisposta>&#xa;                &lt;xsl:if test=&quot;$Start/tns5:IdRichiestaOLO&quot;>&#xa;                    &lt;tns4:IdRichOlo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns5:IdRichiestaOLO&quot;/>&#xa;                    &lt;/tns4:IdRichOlo>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns4:IdNotf>&#xa;                &lt;tns4:IdRisorsaOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FF&amp;quot;&quot;/>&#xa;                &lt;/tns4:IdRisorsaOperatoreRete>&#xa;                &lt;tns4:TipoOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/tipoOrdine&quot;/>&#xa;                &lt;/tns4:TipoOrdine>&#xa;                &lt;tns4:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns4:Transaction_ID>&#xa;                &lt;tns4:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Insert&amp;quot;&quot;/>&#xa;                &lt;/tns4:Azione>&#xa;                &lt;tns4:TipoRiscontro>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                &lt;/tns4:TipoRiscontro>&#xa;                &lt;xsl:if test=&quot;$Start/tns5:NumTentativo&quot;>&#xa;                    &lt;tns4:NumTentativo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns5:NumTentativo&quot;/>&#xa;                    &lt;/tns4:NumTentativo>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:InsertUpdateStaging>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:EONW>&#xa;                &lt;tns3:SistemaDestinatario>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FLASHFIBER&amp;quot;&quot;/>