ssaggio>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/dataIdMessaggio>&#xa;                    &lt;dataIdNotifica>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/dataIdNotifica>&#xa;                    &lt;idMessaggio>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_MESSAGGIO)&quot;/>&#xa;                    &lt;/idMessaggio>&#xa;                    &lt;idNotifica>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&#xa;                    &lt;/idNotifica>&#xa;                    &lt;tipoOrdine>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/tipoOrdine&quot;/>&#xa;                    &lt;/tipoOrdine>&#xa;                &lt;/testata>&#xa;                &lt;accessoGponLna>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Start/tns1:IdGpon)&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:IdGpon&quot;>&#xa;                                &lt;idGpon>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:IdGpon&quot;/>&#xa;                                &lt;/idGpon>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/note&quot;>&#xa;                        &lt;note>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/note&quot;/>&#xa;                        &lt;/note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;progettazione>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:Progettazione&quot;/>&#xa;                    &lt;/progettazione>&#xa;                    &lt;slaAssurance>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/slaAssurance&quot;/>&#xa;                    &lt;/slaAssurance>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Start/tns1:CodiceRoe)&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:CodiceRoe&quot;>&#xa;                                &lt;codiceROE>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:CodiceRoe&quot;/>&#xa;                                &lt;/codiceROE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Start/tns1:CodiceSplitterPrimario)&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:CodiceSplitterPrimario&quot;>&#xa;                                &lt;codiceSplitterPrimario>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:CodiceSplitterPrimario&quot;/>&#xa;                                &lt;/codiceSplitterPrimario>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Start/tns1:CodiceSplitterSecondario)&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:CodiceSplitterSecondario&quot;>&#xa;                                &lt;codiceSplitterSecondario>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:CodiceSplitterSecondario&quot;/>&#xa;                                &lt;/codiceSplitterSecondario>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:PosizioneMorsettieraRoe)>2&quot;>&#xa;                            &lt;posizioneMorsettieraROE>&#xa;                                &lt;xsl:value-of select=&quot;tib:right($Start/tns1:PosizioneMorsettieraRoe,2)&quot;/>&#xa;                            &lt;/posizioneMorsettieraROE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:PosizioneMorsettieraRoe)>0&quot;>&#xa;                            &lt;posizioneMorsettieraROE>&#xa;                                &lt;xsl:value-of select=&quot;tib:pad-front($Start/tns1:PosizioneMorsettieraRoe,2,&amp;quot;0&amp;quot;)&quot;/>&#xa;                            &lt;/posizioneMorsettieraROE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:PosizioneMorsettieraRoe&quot;>&#xa;                                &lt;posizioneMorsettieraROE>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:PosizioneMorsettieraRoe&quot;/>&#xa;                                &lt;/posizioneMorsettieraROE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:PosizioneMorsettiera)>2&quot;>&#xa;                            &lt;posizioneSplitterSecondario>&#xa;                                &lt;xsl:value-of select=&quot;tib:right($Start/tns1:PosizioneMorsettiera,2)&quot;/>&#xa;                            &lt;/posizioneSplitterSecondario>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:PosizioneMorsettiera)>0&quot;>&#xa;                            &lt;posizioneSplitterSecondario>&#xa;                                &lt;xsl:value-of select=&quot;tib:pad-front($Start/tns1:PosizioneMorsettiera,2,&amp;quot;0&amp;quot;)&quot;/>&#xa;                            &lt;/posizioneSplitterSecondario>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:PosizioneMorsettiera&quot;>&#xa;                                &lt;posizioneSplitterSecondario>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:PosizioneMorsettiera&quot;/>&#xa;                                &lt;/posizioneSplitterSecondario>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:copy-of select=&quot;$ParseXml/richiesta/accessoGponLna/datiCliente&quot;/>&#xa;                    &lt;outSourcer>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Invoke.parameters/tns2:outputDate)&quot;>&#xa;                                &lt;dataDAI>&#xa;                                    &lt;xsl:value-of select=&quot;format-date($Invoke.parameters/tns2:outputDate,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&#xa;                                &lt;/dataDAI>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;dataDAI>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/outSourcer/dataDAI&quot;/>&#xa;                                &lt;/dataDAI>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/outSourcer/fasciaOrariaDAI&quot;>&#xa;                            &lt;fasciaOrariaDAI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/outSourcer/fasciaOrariaDAI&quot;/>&#xa;                            &lt;/fasciaOrariaDAI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;riprogettazione>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/outSourcer/riprogettazione&quot;/>&#xa;                        &lt;/riprogettazione>&#xa;                        &lt;system>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/outSourcer/system&quot;/>&#xa;                        &lt;/system>&#xa;                    &lt;/outSourcer>&#xa;                    &lt;sede>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/cap&quot;>&#xa;                            &lt;cap>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/cap&quot;/>&#xa;                            &lt;/cap>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/civico&quot;>&#xa;                            &lt;civico>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/civico&quot;/>&#xa;                            &lt;/civico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/codiceComune&quot;>&#xa;                            &lt;codiceComune>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/codiceComune&quot;/>&#xa;                            &lt;/codiceComune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Start/tns1:CodiceEgon)>0&quot;>&#xa;                                &lt;codiceEgon>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:CodiceEgon&quot;/>&#xa;                                &lt;/codiceEgon>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;codiceEgon>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/codiceEgon&quot;/>&#xa;                                &lt;/codiceEgon>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/complesso&quot;>&#xa;                            &lt;complesso>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/complesso&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/interno&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/interno&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/localita&quot;>&#xa;                            &lt;localita>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/localita&quot;/>&#xa;                            &lt;/localita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/particellaToponomastica&quot;>&#xa;                            &lt;particellaToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/particellaToponomastica&quot;/>&#xa;                            &lt;/particellaToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/piano&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/piano&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/scala&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/scala&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/via&quot;>&#xa;                            &lt;via>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/via&quot;/>&#xa;                            &lt;/via>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/sede>&#xa;                &lt;/accessoGponLna>&#xa;            &lt;/richiesta>&#xa;        &lt;/tns:attivazione>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
