lect="&amp;quot;Insert&amp;quot;"/&gt;&lt;/tns4:Azione&gt;&lt;tns4:TipoRiscontro&gt;&lt;xsl:value-of select="$Start/tns:TipoRiscontro"/&gt;&lt;/tns4:TipoRiscontro&gt;&lt;tns4:NumTentativo&gt;&lt;xsl:value-of select="0&amp;#xD;&amp;#xA;"/&gt;&lt;/tns4:NumTentativo&gt;&lt;xsl:choose&gt;&lt;xsl:when test="starts-with($Start/ns:RichiestaElement/ordine/referente[1]/telefonoFissoReferente, 'kk')"&gt;&lt;xsl:if test="$Start/ns:RichiestaElement/ordine/referente[1]/telefonoFissoReferente"&gt;&lt;tns4:Token&gt;&lt;xsl:value-of select="$Start/ns:RichiestaElement/ordine/referente[1]/telefonoFissoReferente"/&gt;&lt;/tns4:Token&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="starts-with($Start/ns:RichiestaElement/ordine/referente[1]/telefonoMobileReferente, 'kk')"&gt;&lt;xsl:if test="$Start/ns:RichiestaElement/ordine/referente[1]/telefonoMobileReferente"&gt;&lt;tns4:Token&gt;&lt;xsl:value-of select="$Start/ns:RichiestaElement/ordine/referente[1]/telefonoMobileReferente"/&gt;&lt;/tns4:Token&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;/tns2:InsertUpdateStaging&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:EONW&gt;&lt;tns3:SistemaDestinatario&gt;&lt;xsl:value-of select="&amp;quot;FIBERCOP&amp;quot;"/&gt;&lt;/tns3:SistemaDestinatario&gt;&lt;tns3:SistemaMittente&gt;&lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;&lt;/tns3:SistemaMittente&gt;&lt;tns3:IdRichiestaOLO&gt;&lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns3:IdRichiestaOLO&gt;&lt;tns3:TipologiaEvento&gt;&lt;xsl:value-of select="&amp;quot;FF_OL&amp;quot;"/&gt;&lt;/tns3:TipologiaEvento&gt;&lt;tns3:Transaction_ID&gt;&lt;xsl:value-of select="$MapperFC/request/testata/codiceOrdineOperatore"/&gt;&lt;/tns3:Transaction_ID&gt;&lt;xsl:if test="$Start/tns:IdRichiestaDTU"&gt;&lt;tns3:IdRichiestaDTU&gt;&lt;xsl:value-of select="$Start/tns:IdRichiestaDTU"/&gt;&lt;/tns3:IdRichiestaDTU&gt;&lt;/xsl:if&gt;&lt;/tns2:EONW&gt;&lt;