                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperFC&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns2:InsertUpdateStaging>&#xa;                &lt;tns4:ContenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperFC)&quot;/>&#xa;                &lt;/tns4:ContenutoRequest>&#xa;                &lt;tns4:IdProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                &lt;/tns4:IdProcsoNoFile>&#xa;                &lt;tns4:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/idMessaggio&quot;/>&#xa;                &lt;/tns4:IdMessaggio>&#xa;                &lt;tns4:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;42&quot;/>&#xa;                &lt;/tns4:IdStatoElabStaging>&#xa;                &lt;tns4:TimstpRich>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRich>&#xa;                &lt;tns4:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRisposta>&#xa;                &lt;tns4:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:IdRichOlo>&#xa;                &lt;tns4:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/idNotifica&quot;/>&#xa;                &lt;/tns4:IdNotf>&#xa;                &lt;tns4:IdRisorsaOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FC&amp;quot;&quot;/>&#xa;                &lt;/tns4:IdRisorsaOperatoreRete>&#xa;                &lt;tns4:TipoOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/tipoOrdine&quot;/>&#xa;                &lt;/tns4:TipoOrdine>&#xa;                &lt;tns4:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns4:Transaction_ID>&#xa;                &lt;tns4:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Insert&amp;quot;&quot;/>&#xa;                &lt;/tns4:Azione>&#xa;                &lt;tns4:TipoRiscontro>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:TipoRiscontro&quot;/>&#xa;                &lt;/tns4:TipoRiscontro>&#xa;                &lt;tns4:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;0&amp;#xD;&amp;#xA;&quot;/>&#xa;                &lt;/tns4:NumTentativo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;starts-with($Start/ns:RichiestaElement/ordine/referente[1]/telefonoFissoReferente, 'kk')&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/referente[1]/telefonoFissoReferente&quot;>&#xa;                            &lt;tns4:Token>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/referente[1]/telefonoFissoReferente&quot;/>&#xa;                            &lt;/tns4:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;starts-with($Start/ns:RichiestaElement/ordine/referente[1]/telefonoMobileReferente, 'kk')&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/referente[1]/telefonoMobileReferente&quot;>&#xa;                            &lt;tns4:Token>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/referente[1]/telefonoMobileReferente&quot;/>&#xa;                            &lt;/tns4:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns2:InsertUpdateStaging>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:EONW>&#xa;                &lt;tns3:SistemaDestinatario>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FIBERCOP&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaDestinatario>&#xa;                &lt;tns3:SistemaMittente>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaMittente>&#xa;                &lt;tns3:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:IdRichiestaOLO>&#xa;                &lt;tns3:TipologiaEvento>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FF_OL&amp;quot;&quot;/>&#xa;                &lt;/tns3:TipologiaEvento>&#xa;                &lt;tns3:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns3:Transaction_ID>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiestaDTU&quot;>&#xa;                    &lt;tns3:IdRichiestaDTU>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaDTU&quot;/>&#xa;                    &lt;/tns3:IdRichiestaDTU>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:EONW>&#xa;            &lt;tns2:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($MapperFC/request/testata/idNotifica,&amp;quot;-&amp;quot;,$MapperFC/request/testata/idMessaggio)&quot;/>&#xa;            &lt;/tns2:TransactionId>&#xa;            &lt;tns2:IdProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;            &lt;/tns2:IdProcsoNoFile>&#xa;        &lt;/tns2:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogMapperToTracciamentoWSTIM2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InsertStagingToGenericLogger"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStaging&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InsertStaging/parameters/tns2:TracciamentoOutput)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogStaging-input" name="LogStaging"
                    tibex:xpdlId="815672b5-1daa-432d-90e7-8f60d8573f12"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InsertStagingToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InsertStaging.parameters)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
