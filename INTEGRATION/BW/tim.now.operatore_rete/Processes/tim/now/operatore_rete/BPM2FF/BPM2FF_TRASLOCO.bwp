                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommerciali.service.fibercop.com/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperFC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:trasloco>&#xa;            &lt;request>&#xa;                &lt;testata>&#xa;                    &lt;codiceOperatore>&#xa;                        &lt;xsl:value-of select=&quot;'TIM'&quot;/>&#xa;                    &lt;/codiceOperatore>&#xa;                    &lt;codiceOrdineOperatore>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/codiceOrdineOperatore>&#xa;                    &lt;dataIdMessaggio>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/dataIdMessaggio>&#xa;                    &lt;dataIdNotifica>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/dataIdNotifica>&#xa;                    &lt;idMessaggio>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_MESSAGGIO)&quot;/>&#xa;                    &lt;/idMessaggio>&#xa;                    &lt;idNotifica>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&#xa;                    &lt;/idNotifica>&#xa;                    &lt;tipoOrdine>&#xa;                        &lt;xsl:value-of select=&quot;'TRASLOCO'&quot;/>&#xa;                    &lt;/tipoOrdine>&#xa;                    &lt;servizio>&#xa;                        &lt;xsl:value-of select=&quot;'RAME'&quot;/>&#xa;                    &lt;/servizio>&#xa;                &lt;/testata>&#xa;                &lt;accessoTrasl>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:NoteDaSistema&quot;>&#xa;                        &lt;note>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:NoteDaSistema&quot;/>&#xa;                        &lt;/note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;slaAssurance>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/slaAssurance>&#xa;                    &lt;datiCliente>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/CF&quot;>&#xa;                            &lt;codiceFiscale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/CF&quot;/>&#xa;                            &lt;/codiceFiscale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;cognomeRagioneSociale>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/cognomeRagioneSociale&quot;/>&#xa;                        &lt;/cognomeRagioneSociale>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/nome&quot;>&#xa;                            &lt;nome>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/nome&quot;/>&#xa;                            &lt;/nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/PIVA&quot;>&#xa;                            &lt;partitaIva>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/PIVA&quot;/>&#xa;                            &lt;/partitaIva>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;recapitoFissoCliente>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/recapitoFissoCliente>&#xa;                        &lt;recapitoMobileCliente>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/recapitoMobileCliente>&#xa;                    &lt;/datiCliente>&#xa;                    &lt;outSourcer>&#xa;                        &lt;dataDAI>&#xa;                            &lt;xsl:value-of select=&quot;format-date($Invoke.parameters/tns2:outputDate, &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&#xa;                        &lt;/dataDAI>&#xa;                        &lt;system>&#xa;                            &lt;xsl:value-of select=&quot;'TIM'&quot;/>&#xa;                        &lt;/system>&#xa;                    &lt;/outSourcer>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;])&quot;>&#xa;                            &lt;sede>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/CAP&quot;>&#xa;                                    &lt;cap>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/CAP&quot;/>&#xa;                                    &lt;/cap>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/civico&quot;>&#xa;                                    &lt;civico>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/civico&quot;/>&#xa;                                    &lt;/civico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/codiceISTATComune&quot;>&#xa;                                    &lt;codiceComune>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/codiceISTATComune&quot;/>&#xa;                                    &lt;/codiceComune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;codiceEgon>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDEGON&amp;quot;]/valoreAttributo&quot;/>&#xa;                                &lt;/codiceEgon>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/complesso&quot;>&#xa;                                    &lt;complesso>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/complesso&quot;/>&#xa;                                    &lt;/complesso>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/interno&quot;>&#xa;                                    &lt;interno>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/interno&quot;/>&#xa;                                    &lt;/interno>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/localita&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/localita&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/particellaToponomastica&quot;>&#xa;                                    &lt;particellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/particellaToponomastica&quot;/>&#xa;                                    &lt;/particellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/piano&quot;>&#xa;                                    &lt;piano>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/piano&quot;/>&#xa;                                    &lt;/piano>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/scala&quot;>&#xa;                                    &lt;scala>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/scala&quot;/>&#xa;                                    &lt;/scala>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/via&quot;>&#xa;                                    &lt;via>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/via&quot;/>&#xa;                                    &lt;/via>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/sede>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;sede>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/CAP&quot;>&#xa;                                    &lt;cap>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/CAP&quot;/>&#xa;                                    &lt;/cap>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/civico&quot;>&#xa;                                    &lt;civico>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/civico&quot;/>&#xa;                                    &lt;/civico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/codiceISTATComune&quot;>&#xa;                                    &lt;codiceComune>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/codiceISTATComune&quot;/>&#xa;                                    &lt;/codiceComune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;codiceEgon>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDEGON&amp;quot;]/valoreAttributo&quot;/>&#xa;                                &lt;/codiceEgon>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/complesso&quot;>&#xa;                                    &lt;complesso>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/complesso&quot;/>&#xa;                                    &lt;/complesso>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/interno&quot;>&#xa;                                    &lt;interno>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/interno&quot;/>&#xa;                                    &lt;/interno>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/localita&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/localita&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/particellaToponomastica&quot;>&#xa;                                    &lt;particellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/particellaToponomastica&quot;/>&#xa;                                    &lt;/particellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/piano&quot;>&#xa;                                    &lt;piano>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/piano&quot;/>&#xa;                                    &lt;/piano>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/scala&quot;>&#xa;                                    &lt;scala>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/scala&quot;/>&#xa;                                    &lt;/scala>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/via&quot;>&#xa;                                    &lt;via>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/via&quot;/>&#xa;                                    &lt;/via>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/sede>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:ConsistenzaDaInviare='CONSISTENZAFONIA'&quot;>&#xa;                            &lt;IdRisorsaTIM>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&#xa;                            &lt;/IdRisorsaTIM>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;IdRisorsaTIM>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&#xa;                            &lt;/IdRisorsaTIM>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;IdRisorsaNew>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;/>&#xa;                    &lt;/IdRisorsaNew>&#xa;                &lt;/accessoTrasl>&#xa;            &lt;/request>&#xa;        &lt;/tns:trasloco>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
