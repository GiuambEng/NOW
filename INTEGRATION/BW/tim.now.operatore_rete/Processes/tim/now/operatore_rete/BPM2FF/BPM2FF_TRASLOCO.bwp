            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns1:jdbcQueryActivityInput"
            name="JDBCQuery-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:resultSet" name="JDBCQuery" sca-bpel:internal="true"/>
        <bpws:variable name="Timeout" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Performance/JDBC/Timeout" type="xsd:int"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogInput-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:trasloco" name="MapperFC-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:trasloco" name="MapperFC" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns6:calcNextDateByDurationRequest"
            name="Invoke-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns6:calcNextDateByDurationResponse"
            name="Invoke" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogInvoke-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogMapper-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns7:TracciamentoRequest"
            name="InsertStaging-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns7:TracciamentoResponse"
            name="InsertStaging" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogStaging-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="InvokeToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInvokeToMapperFC" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperFCToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogMapperToTracciamentoWSTIM2" tibex:linkType="SUCCESS"/>
                <bpws:link name="InsertStagingToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="22f2b68d-660a-4f31-92ba-85c82a6b5736"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="9f12055d-59a6-4273-b2df-8ede9c02a346" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="JDBCQuery-input"
                    name="JDBCQuery" outputVariable="JDBCQuery"
                    tibex:xpdlId="455a0aac-3a3c-4cc8-99f2-781831ec856c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+455a0aac-3a3c-4cc8-99f2-781831ec856c+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT s_id_notifica_ff.nextval AS id_notifica, s_id_messaggio_ff.nextval AS id_messaggio FROM dual " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_NOTIFICA"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_MESSAGGIO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="eb57ad47-315b-490c-a9cc-1e46e3563901"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Inizio Processo di invio trasloco. Id  &amp;quot;&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($JDBCQuery)&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommerciali.service.fibercop.com/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;Invoke&quot;/>&lt;xsl:template name=&quot;MapperFC-input&quot; match=&quot;/&quot;>&lt;tns:trasloco>&lt;request>&lt;testata>&lt;codiceOperatore>&lt;xsl:value-of select=&quot;'TIM'&quot;/>&lt;/codiceOperatore>&lt;codiceOrdineOperatore>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/codiceOrdineOperatore>&lt;dataIdMessaggio>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/dataIdMessaggio>&lt;dataIdNotifica>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/dataIdNotifica>&lt;idMessaggio>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_MESSAGGIO)&quot;/>&lt;/idMessaggio>&lt;idNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&lt;/idNotifica>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;'TRASLOCO'&quot;/>&lt;/tipoOrdine>&lt;servizio>&lt;xsl:value-of select=&quot;'RAME'&quot;/>&lt;/servizio>&lt;/testata>&lt;accessoTrasl>&lt;xsl:if test=&quot;$Start/tns1:NoteDaSistema&quot;>&lt;note>&lt;xsl:value-of select=&quot;$Start/tns1:NoteDaSistema&quot;/>&lt;/note>&lt;/xsl:if>&lt;slaAssurance>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/slaAssurance>&lt;datiCliente>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/CF&quot;>&lt;codiceFiscale>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/CF&quot;/>&lt;/codiceFiscale>&lt;/xsl:if>&lt;cognomeRagioneSociale>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/cognomeRagioneSociale&quot;/>&lt;/cognomeRagioneSociale>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/nome&quot;>&lt;nome>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/nome&quot;/>&lt;/nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/PIVA&quot;>&lt;partitaIva>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/PIVA&quot;/>&lt;/partitaIva>&lt;/xsl:if>&lt;recapitoFissoCliente>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/recapitoFissoCliente>&lt;recapitoMobileCliente>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/recapitoMobileCliente>&lt;/datiCliente>&lt;outSourcer>&lt;dataDAI>&lt;xsl:value-of select=&quot;format-date($Invoke/parameters/tns2:Response/tns2:outputDate, &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/dataDAI>&lt;system>&lt;xsl:value-of select=&quot;'TIM'&quot;/>&lt;/system>&lt;/outSourcer>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;])&quot;>&lt;sede>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/CAP&quot;>&lt;cap>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/CAP&quot;/>&lt;/cap>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/civico&quot;>&lt;civico>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/civico&quot;/>&lt;/civico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/codiceISTATComune&quot;>&lt;codiceComune>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/codiceISTATComune&quot;/>&lt;/codiceComune>&lt;/xsl:if>&lt;codiceEgon>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDEGON&amp;quot;]/valoreAttributo&quot;/>&lt;/codiceEgon>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/complesso&quot;>&lt;complesso>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/complesso&quot;/>&lt;/complesso>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/interno&quot;>&lt;interno>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/interno&quot;/>&lt;/interno>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/localita&quot;>&lt;localita>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/localita&quot;/>&lt;/localita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/particellaToponomastica&quot;>&lt;particellaToponomastica>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/particellaToponomastica&quot;/>&lt;/particellaToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/piano&quot;>&lt;piano>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/piano&quot;/>&lt;/piano>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/scala&quot;>&lt;scala>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/scala&quot;/>&lt;/scala>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/via&quot;>&lt;via>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/via&quot;/>&lt;/via>&lt;/xsl:if>&lt;/sede>&lt;/xsl:when>&lt;xsl:otherwise>&lt;sede>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/CAP&quot;>&lt;cap>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/CAP&quot;/>&lt;/cap>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/civico&quot;>&lt;civico>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/civico&quot;/>&lt;/civico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/codiceISTATComune&quot;>&lt;codiceComune>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/codiceISTATComune&quot;/>&lt;/codiceComune>&lt;/xsl:if>&lt;codiceEgon>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDEGON&amp;quot;]/valoreAttributo&quot;/>&lt;/codiceEgon>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/complesso&quot;>&lt;complesso>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/complesso&quot;/>&lt;/complesso>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/interno&quot;>&lt;interno>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/interno&quot;/>&lt;/interno>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/localita&quot;>&lt;localita>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/localita&quot;/>&lt;/localita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/particellaToponomastica&quot;>&lt;particellaToponomastica>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/particellaToponomastica&quot;/>&lt;/particellaToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/piano&quot;>&lt;piano>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/piano&quot;/>&lt;/piano>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/scala&quot;>&lt;scala>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/scala&quot;/>&lt;/scala>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/via&quot;>&lt;via>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/via&quot;/>&lt;/via>&lt;/xsl:if>&lt;/sede>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ConsistenzaDaInviare='CONSISTENZAFONIA'&quot;>&lt;IdRisorsaTIM>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&lt;/IdRisorsaTIM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IdRisorsaTIM>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&lt;/IdRisorsaTIM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IdRisorsaNew>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;/>&lt;/IdRisorsaNew>&lt;/accessoTrasl>&lt;/request>&lt;/tns:trasloco>&lt;/xsl:template>&lt;/xsl:stylesheet>"
