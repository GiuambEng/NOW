                portType="ns7:TracciamentoWSTIM2" tibex:xpdlId="2eda9a78-ab15-48ad-b5c0-5177da2bff79">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns3="http://www.tim.com/NOW/xsd/EONOWwhls" xmlns:tns4="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns="http://www.tim.com/NOW/xsd/BPM2FF" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="IdProcsoNoFile"/&gt;&lt;xsl:param name="MapperFC"/&gt;&lt;xsl:param name="Causali"/&gt;&lt;xsl:template name="InsertStaging-input" match="/"&gt;&lt;tns1:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns2:TracciamentoInput&gt;&lt;tns2:InsertUpdateStaging&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;&lt;tns4:ContenutoRequest&gt;&lt;xsl:value-of select="tib:render-xml($Mapper)"/&gt;&lt;/tns4:ContenutoRequest&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:ContenutoRequest&gt;&lt;xsl:value-of select="tib:render-xml($MapperFC)"/&gt;&lt;/tns4:ContenutoRequest&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns4:IdProcsoNoFile&gt;&lt;xsl:value-of select="$IdProcsoNoFile"/&gt;&lt;/tns4:IdProcsoNoFile&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;&lt;tns4:IdMessaggio&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idMessaggio"/&gt;&lt;/tns4:IdMessaggio&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:IdMessaggio&gt;&lt;xsl:value-of select="$MapperFC/richiesta/testata/idMessaggio"/&gt;&lt;/tns4:IdMessaggio&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FC'"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($Causali/Record[1]/FLAG_INVIO) and string-length($Causali/Record[1]/FLAG_INVIO)&gt;0 and $Causali/Record[1]/FLAG_INVIO='Y'"&gt;&lt;tns4:IdStatoElabStaging&gt;&lt;xsl:value-of select="42"/&gt;&lt;/tns4:IdStatoElabStaging&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:IdStatoElabStaging&gt;&lt;xsl:value-of select="46"/&gt;&lt;/tns4:IdStatoElabStaging&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:IdStatoElabStaging&gt;&lt;xsl:value-of select="42"/&gt;&lt;/tns4:IdStatoElabStaging&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns4:TimstpRich&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns4:TimstpRich&gt;&lt;tns4:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns4:TimstpRisposta&gt;&lt;tns4:IdRichOlo&gt;&lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns4:IdRichOlo&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;&lt;tns4:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns4:IdNotf&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:IdNotf&gt;&lt;xsl:value-of select="$MapperFC/richiesta/testata/idNotifica"/&gt;&lt;/tns4:IdNotf&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;&lt;tns4:IdRisorsaOperatoreRete&gt;&lt;xsl:value-of select="&amp;quot;FF&amp;quot;"/&gt;&lt;/tns4:IdRisorsaOperatoreRete&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:IdRisorsaOperatoreRete&gt;&lt;xsl:value-of select="&amp;quot;FC&amp;quot;"/&gt;&lt;/tns4:IdRisorsaOperatoreRete&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;&lt;tns4:TipoOrdine&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/tipoOrdine"/&gt;&lt;/tns4:TipoOrdine&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:TipoOrdine&gt;&lt;xsl:value-of select="$MapperFC/richiesta/testata/tipoOrdine"/&gt;&lt;/tns4:TipoOrdine&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;&lt;tns4:Transaction_ID&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns4:Transaction_ID&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:Transaction_ID&gt;&lt;xsl:value-of select="$MapperFC/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns4:Transaction_ID&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns4:Azione&gt;&lt;xsl:value-of select="&amp;quot;Insert&amp;quot;"/&gt;&lt;/tns4:Azione&gt;&lt;tns4:TipoRiscontro&gt;&lt;xsl:value-of select="&amp;quot;ESPLETAMENTO&amp;quot;"/&gt;&lt;/tns4:TipoRiscontro&gt;&lt;tns4:NumTentativo&gt;&lt;xsl:value-of select="0&amp;#xD;&amp;#xA;"/&gt;&lt;/tns4:NumTentativo&gt;&lt;/tns2:InsertUpdateStaging&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:EONW&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;&lt;tns3:SistemaDestinatario&gt;&lt;xsl:value-of select="&amp;quot;FLASHFIBER&amp;quot;"/&gt;&lt;/tns3:SistemaDestinatario&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns3:SistemaDestinatario&gt;&lt;xsl:value-of select="&amp;quot;FIBERCOP&amp;quot;"/&gt;&lt;/tns3:SistemaDestinatario&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns3:SistemaMittente&gt;&lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;&lt;/tns3:SistemaMittente&gt;&lt;tns3:IdRichiestaOLO&gt;&lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns3:IdRichiestaOLO&gt;&lt;tns3:TipologiaEvento&gt;&lt;xsl:value-of select="&amp;quot;FF_OL&amp;quot;"/&gt;&lt;/tns3:TipologiaEvento&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;&lt;tns3:Transaction_ID&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns3:Transaction_ID&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns3:Transaction_ID&gt;&lt;xsl:value-of select="$MapperFC/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns3:Transaction_ID&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$Start/tns:IdRichiestaDTU"&gt;&lt;tns3:IdRichiestaDTU&gt;&lt;xsl:value-of select="$Start/tns:IdRichiestaDTU"/&gt;&lt;/tns3:IdRichiestaDTU&gt;&lt;/xsl:if&gt;&lt;/tns2:EONW&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/ns:RichiestaElement/operatoreRete='FF'"&gt;&lt;tns2:TransactionId&gt;&lt;xsl:value-of select="concat($Mapper/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$Mapper/richiesta/testata/idMessaggio)"/&gt;&lt;/tns2:TransactionId&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:TransactionId&gt;&lt;xsl:value-of select="concat($MapperFC/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$MapperFC/richiesta/testata/idMessaggio)"/&gt;&lt;/tns2:TransactionId&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns2:IdProcsoNoFile&gt;&lt;xsl:value-of select="$IdProcsoNoFile"/&gt;&lt;/tns2:IdProcsoNoFile&gt;&lt;/tns2:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns1:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperFC&quot;/>&#xa;    &lt;xsl:param name=&quot;Causali&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns2:InsertUpdateStaging>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns4:ContenutoRequest>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($Mapper)&quot;/>&#xa;                        &lt;/tns4:ContenutoRequest>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:ContenutoRequest>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapperFC)&quot;/>&#xa;                        &lt;/tns4:ContenutoRequest>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:IdProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                &lt;/tns4:IdProcsoNoFile>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns4:IdMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idMessaggio&quot;/>&#xa;                        &lt;/tns4:IdMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:IdMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;$MapperFC/richiesta/testata/idMessaggio&quot;/>&#xa;                        &lt;/tns4:IdMessaggio>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FC'&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Causali/Record[1]/FLAG_INVIO) and string-length($Causali/Record[1]/FLAG_INVIO)>0 and $Causali/Record[1]/FLAG_INVIO='Y'&quot;>&#xa;                                &lt;tns4:IdStatoElabStaging>&#xa;                                    &lt;xsl:value-of select=&quot;42&quot;/>&#xa;                                &lt;/tns4:IdStatoElabStaging>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns4:IdStatoElabStaging>&#xa;                                    &lt;xsl:value-of select=&quot;46&quot;/>&#xa;                                &lt;/tns4:IdStatoElabStaging>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:IdStatoElabStaging>&#xa;                            &lt;xsl:value-of select=&quot;42&quot;/>&#xa;                        &lt;/tns4:IdStatoElabStaging>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:TimstpRich>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRich>&#xa;                &lt;tns4:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRisposta>&#xa;                &lt;tns4:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:IdRichOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns4:IdNotf>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                        &lt;/tns4:IdNotf>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:IdNotf>&#xa;                            &lt;xsl:value-of select=&quot;$MapperFC/richiesta/testata/idNotifica&quot;/>&#xa;                        &lt;/tns4:IdNotf>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns4:IdRisorsaOperatoreRete>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FF&amp;quot;&quot;/>&#xa;                        &lt;/tns4:IdRisorsaOperatoreRete>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:IdRisorsaOperatoreRete>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FC&amp;quot;&quot;/>&#xa;                        &lt;/tns4:IdRisorsaOperatoreRete>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns4:TipoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/tipoOrdine&quot;/>&#xa;                        &lt;/tns4:TipoOrdine>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:TipoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$MapperFC/richiesta/testata/tipoOrdine&quot;/>&#xa;                        &lt;/tns4:TipoOrdine>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns4:Transaction_ID>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                        &lt;/tns4:Transaction_ID>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:Transaction_ID>&#xa;                            &lt;xsl:value-of select=&quot;$MapperFC/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                        &lt;/tns4:Transaction_ID>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Insert&amp;quot;&quot;/>&#xa;                &lt;/tns4:Azione>&#xa;                &lt;tns4:TipoRiscontro>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTO&amp;quot;&quot;/>&#xa;                &lt;/tns4:TipoRiscontro>&#xa;                &lt;tns4:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;0&amp;#xD;&amp;#xA;&quot;/>&#xa;                &lt;/tns4:NumTentativo>&#xa;            &lt;/tns2:InsertUpdateStaging>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:EONW>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns3:SistemaDestinatario>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FLASHFIBER&amp;quot;&quot;/>&#xa;                        &lt;/tns3:SistemaDestinatario>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:SistemaDestinatario>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FIBERCOP&amp;quot;&quot;/>&#xa;                        &lt;/tns3:SistemaDestinatario>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:SistemaMittente>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaMittente>&#xa;                &lt;tns3:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:IdRichiestaOLO>&#xa;                &lt;tns3:TipologiaEvento>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FF_OL&amp;quot;&quot;/>&#xa;                &lt;/tns3:TipologiaEvento>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                        &lt;tns3:Transaction_ID>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                        &lt;/tns3:Transaction_ID>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Transaction_ID>&#xa;                            &lt;xsl:value-of select=&quot;$MapperFC/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                        &lt;/tns3:Transaction_ID>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiestaDTU&quot;>&#xa;                    &lt;tns3:IdRichiestaDTU>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaDTU&quot;/>&#xa;                    &lt;/tns3:IdRichiestaDTU>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:EONW>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FF'&quot;>&#xa;                    &lt;tns2:TransactionId>&#xa;                        &lt;xsl:value-of select=&quot;concat($Mapper/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$Mapper/richiesta/testata/idMessaggio)&quot;/>&#xa;                    &lt;/tns2:TransactionId>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:TransactionId>&#xa;                        &lt;xsl:value-of select=&quot;concat($MapperFC/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$MapperFC/richiesta/testata/idMessaggio)&quot;/>&#xa;                    &lt;/tns2:TransactionId>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:IdProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;            &lt;/tns2:IdProcsoNoFile>&#xa;        &lt;/tns2:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcess1ToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Invoke1ToInvoke"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:param name=&quot;InsertStaging&quot;/>&lt;xsl:template name=&quot;LogStaging-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Output insert staging: &amp;quot;&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($InsertStaging/parameters/tns2:TracciamentoOutput)&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogStaging-input" name="LogStaging"
                    tibex:xpdlId="25b50b92-c764-4240-b524-8b8adca2463d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Invoke1ToInvoke"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStagingToScope">
                            <tibex:DesignExpression>
                                <tibex:expression expression="1=2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[1=2]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogStagingToLogNuovaGestione">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Output insert staging: &amp;quot;&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InsertStaging.parameters)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:param name=&quot;Update&quot;/>&lt;xsl:template name=&quot;LogUpdate-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Termine del sottoprocesso di invio espletamento. Update della staging eseguito: &amp;quot;&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($Update/parameters/tns2:TracciamentoOutput)&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogUpdate-input" name="LogUpdate"
                    tibex:xpdlId="11fa6432-922f-4157-9281-b9e880c508ce"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Invoke1ToCallProcess4"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess4ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Update.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Termine del sottoprocesso di invio espletamento. Update della staging eseguito: &amp;quot;&amp;#xD;&amp;#xA;&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Update.parameters)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="Update-input" name="Update"
                operation="Tracciamento" outputVariable="Update"
                partnerLink="TracciamentoWSTIM2"
                portType="ns7:TracciamentoWSTIM2" tibex:xpdlId="3f3c299c-f7eb-497e-b9e6-4baabed2ef1b">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:nslt2="urn:PegaRULES:SOAP:RiscontriOL:Services" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns3="http://www.tim.com/NOW/xsd/EventoOperatoreRete" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="Riscontri"/&gt;&lt;xsl:param name="InsertStaging"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="Update-input" match="/"&gt;&lt;tns1:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns2:TracciamentoInput&gt;&lt;tns2:InsertUpdateStaging&gt;&lt;tns:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Riscontri/riscontriOLResponse/nslt2:riscontriOLResponse)"/&gt;&lt;/tns:ContenutoResponse&gt;&lt;tns:IdStatoElabStaging&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns:IdStatoElabStaging&gt;&lt;tns:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns:TimstpRisposta&gt;&lt;tns:CodiceAckNack&gt;&lt;xsl:value-of select="$Riscontri/riscontriOLResponse/nslt2:riscontriOLResponse/risposta/esito/codice"/&gt;&lt;/tns:CodiceAckNack&gt;&lt;xsl:if test="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"&gt;&lt;tns:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;&lt;/tns:IdEventoOrdnNowWhls&gt;&lt;/xsl:if&gt;&lt;tns:Transaction_ID&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns:Transaction_ID&gt;&lt;tns:Azione&gt;&lt;xsl:value-of select="&amp;quot;Update&amp;quot;"/&gt;&lt;/tns:Azione&gt;&lt;tns:NumTentativo&gt;&lt;xsl:value-of select="1"/&gt;&lt;/tns:NumTentativo&gt;&lt;/tns2:InsertUpdateStaging&gt;&lt;tns2:EventoOperatoreRete&gt;&lt;tns3:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;&lt;/tns3:IdEventoOrdnNowWhls&gt;&lt;tns3:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns3:IdNotf&gt;&lt;tns3:IdRichOlo&gt;&lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns3:IdRichOlo&gt;&lt;tns3:IdMessaggio&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idMessaggio"/&gt;&lt;/tns3:IdMessaggio&gt;&lt;tns3:TimstpInsmto&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns3:TimstpInsmto&gt;&lt;tns3:IdEventoOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdEventoOperatoreRete&gt;&lt;xsl:if test="$Mapper/richiesta/espletamento/causaRiprogettazioneOnField"&gt;&lt;tns3:CausaRiprogtOnField&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/causaRiprogettazioneOnField"/&gt;&lt;/tns3:CausaRiprogtOnField&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/espletamento/rifiuto/codiceMotivoRifiuto"&gt;&lt;tns3:CodMotivoRifiuto&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/rifiuto/codiceMotivoRifiuto"/&gt;&lt;/tns3:CodMotivoRifiuto&gt;&lt;/xsl:if&gt;&lt;tns3:CodOrdineFlashfiber&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineFlashFiber"/&gt;&lt;/tns3:CodOrdineFlashfiber&gt;&lt;xsl:if test="$Mapper/richiesta/espletamento/codiceSplitterPrimario"&gt;&lt;tns3:CodSplitterPrimario&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/codiceSplitterPrimario"/&gt;&lt;/tns3:CodSplitterPrimario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/espletamento/codiceSplitterSecondario"&gt;&lt;tns3:CodSplitterSecondario&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/codiceSplitterSecondario"/&gt;&lt;/tns3:CodSplitterSecondario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/espletamento/codiceROE"&gt;&lt;tns3:CodRoe&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/codiceROE"/&gt;&lt;/tns3:CodRoe&gt;&lt;/xsl:if&gt;&lt;tns3:DataEspletamento&gt;&lt;xsl:value-of select="tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$Mapper/richiesta/espletamento/dataEspletamento)"/&gt;&lt;/tns3:DataEspletamento&gt;&lt;tns3:IdGpon&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/idGpon"/&gt;&lt;/tns3:IdGpon&gt;&lt;tns3:IdRisorsa&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/idRisorsa"/&gt;&lt;/tns3:IdRisorsa&gt;&lt;xsl:if test="$Mapper/richiesta/espletamento/impresa"&gt;&lt;tns3:ImpresaSystem&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/impresa"/&gt;&lt;/tns3:ImpresaSystem&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/espletamento/rifiuto/motivoRifiuto"&gt;&lt;tns3:MotivoRifiuto&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/rifiuto/motivoRifiuto"/&gt;&lt;/tns3:MotivoRifiuto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/espletamento/note"&gt;&lt;tns3:Note&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/note"/&gt;&lt;/tns3:Note&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/espletamento/posizioneMorsettieraROE"&gt;&lt;tns3:PosizMorsettieraRoe&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/posizioneMorsettieraROE"/&gt;&lt;/tns3:PosizMorsettieraRoe&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/espletamento/posizioneSplitterSecondario"&gt;&lt;tns3:PosizSplitter&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/posizioneSplitterSecondario"/&gt;&lt;/tns3:PosizSplitter&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/richiesta/espletamento/riprogettato"&gt;&lt;tns3:Riprogettato&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/riprogettato"/&gt;&lt;/tns3:Riprogettato&gt;&lt;/xsl:if&gt;&lt;tns3:StatoOrdine&gt;&lt;xsl:value-of select="$Mapper/richiesta/espletamento/statoOrdine"/&gt;&lt;/tns3:StatoOrdine&gt;&lt;/tns2:EventoOperatoreRete&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:StatoEsec&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/tns2:StatoEsec&gt;&lt;tns2:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Riscontri/riscontriOLResponse/nslt2:riscontriOLResponse)"/&gt;&lt;/tns2:ContenutoResponse&gt;&lt;tns2:CodiceAckNack&gt;&lt;xsl:value-of select="$Riscontri/riscontriOLResponse/nslt2:riscontriOLResponse/risposta/esito/codice"/&gt;&lt;/tns2:CodiceAckNack&gt;&lt;tns2:TransactionId&gt;&lt;xsl:value-of select="concat($Mapper/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$Mapper/richiesta/testata/idMessaggio)"/&gt;&lt;/tns2:TransactionId&gt;&lt;xsl:if test="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"&gt;&lt;tns2:IdEventoOrdineNowWhls&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;&lt;/tns2:IdEventoOrdineNowWhls&gt;&lt;/xsl:if&gt;&lt;/tns2:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns1:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:nslt2=&quot;urn:PegaRULES:SOAP:RiscontriOL:Services&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EventoOperatoreRete&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Riscontri.riscontriOLResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns2:InsertUpdateStaging>&#xa;                &lt;tns:ContenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Riscontri.riscontriOLResponse)&quot;/>&#xa;                &lt;/tns:ContenutoResponse>&#xa;                &lt;tns:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns:IdStatoElabStaging>&#xa;                &lt;tns:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TimstpRisposta>&#xa;                &lt;tns:CodiceAckNack>&#xa;                    &lt;xsl:value-of select=&quot;$Riscontri.riscontriOLResponse/risposta/esito/codice&quot;/>&#xa;                &lt;/tns:CodiceAckNack>&#xa;                &lt;xsl:if test=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;>&#xa;                    &lt;tns:IdEventoOrdnNowWhls>&#xa;                        &lt;xsl:value-of select=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;/>&#xa;                    &lt;/tns:IdEventoOrdnNowWhls>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns:Transaction_ID>&#xa;                &lt;tns:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&#xa;                &lt;/tns:Azione>&#xa;                &lt;tns:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/tns:NumTentativo>&#xa;            &lt;/tns2:InsertUpdateStaging>&#xa;            &lt;tns2:EventoOperatoreRete>&#xa;                &lt;tns3:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;/>&#xa;                &lt;/tns3:IdEventoOrdnNowWhls>&#xa;                &lt;tns3:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns3:IdNotf>&#xa;                &lt;tns3:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:IdRichOlo>&#xa;                &lt;tns3:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idMessaggio&quot;/>&#xa;                &lt;/tns3:IdMessaggio>&#xa;                &lt;tns3:TimstpInsmto>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns3:TimstpInsmto>&#xa;                &lt;tns3:IdEventoOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdEventoOperatoreRete>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/espletamento/causaRiprogettazioneOnField&quot;>&#xa;                    &lt;tns3:CausaRiprogtOnField>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/causaRiprogettazioneOnField&quot;/>&#xa;                    &lt;/tns3:CausaRiprogtOnField>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/espletamento/rifiuto/codiceMotivoRifiuto&quot;>&#xa;                    &lt;tns3:CodMotivoRifiuto>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/rifiuto/codiceMotivoRifiuto&quot;/>&#xa;                    &lt;/tns3:CodMotivoRifiuto>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:CodOrdineFlashfiber>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineFlashFiber&quot;/>&#xa;                &lt;/tns3:CodOrdineFlashfiber>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/espletamento/codiceSplitterPrimario&quot;>&#xa;                    &lt;tns3:CodSplitterPrimario>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/codiceSplitterPrimario&quot;/>&#xa;                    &lt;/tns3:CodSplitterPrimario>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/espletamento/codiceSplitterSecondario&quot;>&#xa;                    &lt;tns3:CodSplitterSecondario>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/codiceSplitterSecondario&quot;/>&#xa;                    &lt;/tns3:CodSplitterSecondario>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/espletamento/codiceROE&quot;>&#xa;                    &lt;tns3:CodRoe>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/codiceROE&quot;/>&#xa;                    &lt;/tns3:CodRoe>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:DataEspletamento>&#xa;                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$Mapper/richiesta/espletamento/dataEspletamento)&quot;/>&#xa;                &lt;/tns3:DataEspletamento>&#xa;                &lt;tns3:IdGpon>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/idGpon&quot;/>&#xa;                &lt;/tns3:IdGpon>&#xa;                &lt;tns3:IdRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/idRisorsa&quot;/>&#xa;                &lt;/tns3:IdRisorsa>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/espletamento/impresa&quot;>&#xa;                    &lt;tns3:ImpresaSystem>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/impresa&quot;/>&#xa;                    &lt;/tns3:ImpresaSystem>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/espletamento/rifiuto/motivoRifiuto&quot;>&#xa;                    &lt;tns3:MotivoRifiuto>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/rifiuto/motivoRifiuto&quot;/>&#xa;                    &lt;/tns3:MotivoRifiuto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/espletamento/note&quot;>&#xa;                    &lt;tns3:Note>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/note&quot;/>&#xa;                    &lt;/tns3:Note>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/espletamento/posizioneMorsettieraROE&quot;>&#xa;                    &lt;tns3:PosizMorsettieraRoe>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/posizioneMorsettieraROE&quot;/>&#xa;                    &lt;/tns3:PosizMorsettieraRoe>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/espletamento/posizioneSplitterSecondario&quot;>&#xa;                    &lt;tns3:PosizSplitter>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/posizioneSplitterSecondario&quot;/>&#xa;                    &lt;/tns3:PosizSplitter>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/espletamento/riprogettato&quot;>&#xa;                    &lt;tns3:Riprogettato>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/riprogettato&quot;/>&#xa;                    &lt;/tns3:Riprogettato>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:StatoOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/espletamento/statoOrdine&quot;/>&#xa;                &lt;/tns3:StatoOrdine>&#xa;            &lt;/tns2:EventoOperatoreRete>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/tns2:StatoEsec>&#xa;            &lt;tns2:ContenutoResponse>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($Riscontri.riscontriOLResponse)&quot;/>&#xa;            &lt;/tns2:ContenutoResponse>&#xa;            &lt;tns2:CodiceAckNack>&#xa;                &lt;xsl:value-of select=&quot;$Riscontri.riscontriOLResponse/risposta/esito/codice&quot;/>&#xa;            &lt;/tns2:CodiceAckNack>&#xa;            &lt;tns2:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($Mapper/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$Mapper/richiesta/testata/idMessaggio)&quot;/>&#xa;            &lt;/tns2:TransactionId>&#xa;            &lt;xsl:if test=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;>&#xa;                &lt;tns2:IdEventoOrdineNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;/>&#xa;                &lt;/tns2:IdEventoOrdineNowWhls>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcess2ToEnd"/>
