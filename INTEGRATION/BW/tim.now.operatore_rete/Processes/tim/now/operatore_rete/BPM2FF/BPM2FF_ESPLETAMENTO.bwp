                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommerciali.service.flashfiber.com/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;Causali&quot;/>&lt;xsl:param name=&quot;descrDtu&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:espletamento>&lt;richiesta>&lt;testata>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;FFACQUISITO&amp;quot;])&quot;>&lt;codiceOrdineFlashFiber>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;FFACQUISITO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICEORDINEFLASHFIBER&amp;quot;]/valoreAttributo&quot;/>&lt;/codiceOrdineFlashFiber>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codiceOrdineFlashFiber>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;FFRIFIUTOACQUISITO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICEORDINEFLASHFIBER&amp;quot;]/valoreAttributo&quot;/>&lt;/codiceOrdineFlashFiber>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codiceOrdineOperatore>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/codiceOrdineOperatore>&lt;codiceOutSourcer>&lt;xsl:value-of select=&quot;&amp;quot;TIM&amp;quot;&quot;/>&lt;/codiceOutSourcer>&lt;dataIdMessaggio>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/dataIdMessaggio>&lt;dataIdNotifica>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[Y0001][M01][D01] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/dataIdNotifica>&lt;dataRiscontro>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/dataRiscontro>&lt;idMessaggio>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_MESSAGGIO)&quot;/>&lt;/idMessaggio>&lt;idNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&lt;/idNotifica>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/lavorazione&quot;/>&lt;/tipoOrdine>&lt;tipoRiscontro>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTO&amp;quot;&quot;/>&lt;/tipoRiscontro>&lt;/testata>&lt;xsl:variable name=&quot;Riprogettato&quot; select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIACCESSO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;RIPROGETTATO&amp;quot;]/valoreAttributo&quot;/>&lt;xsl:variable name=&quot;StatoOrdine&quot; select=&quot;if($Start/tns1:OK_KO=&amp;quot;OK&amp;quot;) then &amp;quot;0&amp;quot; else &amp;quot;1&amp;quot;&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;$StatoOrdine=&amp;quot;0&amp;quot;&quot;>&lt;espletamento>&lt;xsl:choose>&lt;xsl:when test=&quot;$Riprogettato='Y'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIACCESSO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CAUSALERIPROGETTAZIONE&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIACCESSO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CAUSALERIPROGETTAZIONE&amp;quot;]/valoreAttributo&quot;>&lt;causaRiprogettazioneOnField>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIACCESSO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CAUSALERIPROGETTAZIONE&amp;q