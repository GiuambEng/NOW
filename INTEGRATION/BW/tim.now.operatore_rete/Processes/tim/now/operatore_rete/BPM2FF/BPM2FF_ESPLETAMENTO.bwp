W']/valoreAttributo&quot;/>&lt;/idRisorsa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/IDRisorsa)>0 and ($Start/ns:RichiestaElement/ordine/IDRisorsa=$Start/ns:RichiestaElement/ordine/IDRisorsaNOW)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;substring(tib:trim($Start/ns:RichiestaElement/ordine/IDRisorsa), string-length(tib:trim($Start/ns:RichiestaElement/ordine/IDRisorsa))-2,1) = &amp;quot;W&amp;quot;&quot;>&lt;idRisorsa>&lt;xsl:value-of select=&quot;tib:trim(tib:substring-before-last($Start/ns:RichiestaElement/ordine/IDRisorsa, &amp;quot;W&amp;quot;))&quot;/>&lt;/idRisorsa>&lt;/xsl:when>&lt;xsl:otherwise>&lt;idRisorsa>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;/>&lt;/idRisorsa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;substring(tib:trim($Start/ns:RichiestaElement/ordine/IDRisorsaNOW), string-length(tib:trim($Start/ns:RichiestaElement/ordine/IDRisorsaNOW))-2,1) = &amp;quot;W&amp;quot;&quot;>&lt;idRisorsa>&lt;xsl:value-of select=&quot;tib:trim(tib:substring-before-last($Start/ns:RichiestaElement/ordine/IDRisorsaNOW, &amp;quot;W&amp;quot;))&quot;/>&lt;/idRisorsa>&lt;/xsl:when>&lt;xsl:otherwise>&lt;idRisorsa>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/IDRisorsaNOW&quot;/>&lt;/idRisorsa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/IDRisorsa!=$Start/ns:RichiestaElement/ordine/IDRisorsaNOW&quot;>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/IDRisorsa&quot;>&lt;idRisorsaExt>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/IDRisorsa&quot;/>&lt;/idRisorsaExt>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TIPORETE&amp;quot;]/valoreAttributo=('RIGIDA','ELASTICA')&quot;/>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDISAGGREGAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IMPRESA&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDISAGGREGAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IMPRESA&amp;quot;]/valoreAttributo&quot;>&lt;impresa>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDISAGGREGAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IMPRESA&amp;quot;]/valoreAttributo&quot;/>&lt;/impresa>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUASU&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IMPRESA&amp;quot;]/valoreAttributo&quot;>&lt;impresa>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUASU&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IMPRESA&amp;quot;]/valoreAttributo&quot;/>&lt;/impresa>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:NoteDaSistema&quot;>&lt;note>&lt;xsl:value-of select=&quot;$Start/tns1:NoteDaSistema&quot;/>&lt;/note>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TIPORETE&amp;quot;]/valoreAttributo=('RIGIDA','ELASTICA')&quot;/>&lt;xsl:when test=&quot;string-length($Riprogettato) > 0&quot;>&lt;xsl:if test=&quot;$Riprogettato&quot;>&lt;riprogettato>&lt;xsl:value-of select=&quot;$Riprogettato&quot;/>&lt;/riprogettato>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;riprogettato>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/riprogettato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;statoOrdine>&lt;xsl:value-of select=&quot;$StatoOrdine&quot;/>&lt;/statoOrdine>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Causali/Record)>0&quot;>&lt;rifiuto>&lt;codiceMotivoRifiuto>&lt;xsl:value-of select=&quot;$Causali/Record[1]/CAUSALE&quot;/>&lt;/codiceMotivoRifiuto>&lt;motivoRifiuto>&lt;xsl:value-of select=&quot;$Causali/Record[1]/DESCRIZIONE&quot;/>&lt;/motivoRifiuto>&lt;/rifiuto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;rifiuto>&lt;codiceMotivoRifiuto>&lt;xsl:value-of select=&quot;$Start/tns1:CausaleEsitoDTU&quot;/>&lt;/codiceMotivoRifiuto>&lt;motivoRifiuto>&lt;xsl:value-of select=&quot;$descrDtu/Record[1]/DESCR&quot;/>&lt;/motivoRifiuto>&lt;/rifiuto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TIPORETE&amp;quot;]/valoreAttributo='TRADIZ'&quot;>&lt;tipoRete>&lt;xsl:value-of select=&quot;'TRADIZIONALE'&quot;/>&lt;/tipoRete>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipoRete>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TIPORETE&amp;quot;]/valoreAttributo&quot;/>&lt;/tipoRete>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;starts-with($Start/ns:RichiestaElement/tipologiaSottolav, 'TRASLOCO')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/IDRisorsa)>0 and ($Start/ns:RichiestaElement/IDRisorsa = $Start/ns:RichiestaElement/ordine/IDRisorsaNOW)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;substring(tib:trim($Start/ns:RichiestaElement/ordine/IDRisorsa), string-length(tib:trim($Start/ns:RichiestaElement/ordine/IDRisorsa))-2,1) = &amp;quot;W&amp;quot;&quot;>&lt;IdRisorsaNew>&lt;xsl:value-of select=&quot;tib:trim(tib:substring-before-last($Start/ns:RichiestaElement/ordine/IDRisorsa, &amp;quot;W&amp;quot;))&quot;/>&lt;/IdRisorsaNew>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;>&lt;IdRisorsaNew>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;/>&lt;/IdRisorsaNew>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;substring(tib:trim($Start/ns:RichiestaElement/ordine/IDRisorsaNOW), string-length(tib:trim($Start/ns:RichiestaElement/ordine/IDRisorsaNOW))-2,1)= &amp;quot;W&amp;quot;&quot;>&lt;IdRisorsaNew>&lt;xsl:value-of select=&quot;tib:trim(tib:substring-before-last($Start/ns:RichiestaElement/ordine/IDRisorsaNOW, &amp;quot;W&amp;quot;))&quot;/>&lt;/IdRisorsaNew>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/IDRisorsaNOW&quot;>&lt;IdRisorsaNew>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/IDRisorsaNOW&quot;/>&lt;/IdRisorsaNew>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;nomeDistributore>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DISTRIBUTORE&amp;quot;]/valoreAttributo&quot;/>&lt;/nomeDistributore>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIACCESSO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;NUMEROCOPPIERAME&amp;quot;]/valoreAttributo = 'ND' or string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIACCESSO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;NUMEROCOPPIERAME&amp;quot;]/valoreAttributo) = 0&quot;>&lt;numeroCoppie>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/numeroCoppie>&lt;/xsl:when>&lt;xsl:otherwise>&lt;numeroCoppie>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIACCESSO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;NUMEROCOPPIERAME&amp;quot;]/valoreAttributo&quot;/>&lt;/numeroCoppie>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;coppia>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;COPPIA&amp;quot;]/valoreAttributo&quot;/>&lt;/coppia>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='AGGIUNTIVO' and azione=('A','D')])&quot;>&lt;xsl:for-each select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='AGGIUNTIVO' and azione=('A','D')]&quot;>&lt;xsl:variable name=&quot;var&quot; select=&quot;if (contains(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo, 'W')) then translate(tib:substring-before-last(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo, 'W'), ' ', '') else attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&lt;secondariaAggiuntiva>&lt;idRisorsaAggiuntiva>&lt;xsl:value-of select=&quot;if (substring(concat('0',xsd:string(xsd:integer($var))), 2, 1)=('2','6')) then concat('00',xsd:string(xsd:integer($var)))&amp;#xD;&amp;#xA;else if (substring(concat('0',xsd:string(xsd:integer($var))), 3, 1)=('0','1','5','9')) then concat('00',xsd:string(xsd:integer($var)))&amp;#xD;&amp;#xA;else xsd:string(xsd:integer($var))&quot;/>&lt;/idRisorsaAggiuntiva>&lt;/secondariaAggiuntiva>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/espletamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/richiesta>&lt;/tns:espletamento>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
