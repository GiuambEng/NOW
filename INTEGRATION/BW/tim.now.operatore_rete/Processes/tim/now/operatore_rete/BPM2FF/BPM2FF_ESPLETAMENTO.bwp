                        <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://ordinicommerciali.service.flashfiber.com/" version="2.0"&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:template name="InvokeFF-input" match="/"&gt;&lt;tns:espletamento&gt;&lt;espletamento&gt;&lt;xsl:copy-of select="$Mapper"/&gt;&lt;/espletamento&gt;&lt;/tns:espletamento&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                        <tibex:inputBindings>
                            <tibex:partBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommerciali.service.flashfiber.com/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeFF-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$Mapper&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <bpws:targets>
                            <bpws:target linkName="GroupStartToRiscontri"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="RiscontriToGroupEnd"/>
                        </bpws:sources>
                    </bpws:invoke>
                </bpws:flow>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Causali-input"
                    name="Causali" outputVariable="Causali"
                    tibex:xpdlId="55206a70-98f7-4378-af88-3c785eff7748" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToJDBCQuery1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQuery1ToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Causali/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Causali/Record) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CausaliToJDBCQuery1_NoCausaliFF">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+55206a70-98f7-4378-af88-3c785eff7748+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Causali-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CAUS_ESITO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CausaleEsitoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CausaleEsitoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CAUS_ESITO>&lt;esito>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:EsitoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:EsitoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/esito>&lt;IDTPLG_EVENTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:TipologiaEventoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:TipologiaEventoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDTPLG_EVENTO>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/operatoreRete='FC'&quot;>&lt;OPERATORE_RETE>&lt;xsl:value-of select=&quot;'FC'&quot;/>&lt;/OPERATORE_RETE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;OPERATORE_RETE>&lt;xsl:value-of select=&quot;'FF'&quot;/>&lt;/OPERATORE_RETE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ff.CAUSALE,ff.DESCRIZIONE, ff.DESCRIZIONE_EVENTO_FF, ff.FLAG_INVIO&#xd;&#xa;FROM TRASCODFC_CAUS_FF ff&#xd;&#xa;JOIN TIPOLG_ESITO_DTU dtu ON (dtu.CAUS_ESITO = ff.CAUS_ESITO AND dtu.ESITO = ff.ESITO AND dtu.IDTPLG_EVENTO = ff.IDTPLG_EVENTO)&#xd;&#xa;WHERE dtu.CAUS_ESITO = ? AND dtu.ESITO = ? AND dtu.EVENTO_NATIVO_DTU = ? AND dtu.FLAG_ALTRO_OPERATORE = 'Y' AND ff.OPERATORE_RETE IN (?,'ALL')" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CAUS_ESITO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="esito"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDTPLG_EVENTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OPERATORE_RETE"/>
                                    <columnMetadata
                                    columnName="CAUSALE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONE_EVENTO_FF"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_INVIO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogCausali-input"
                    name="LogCausali"
                    tibex:xpdlId="225bd3f9-cd42-4534-83bf-d92fa3d41fc2"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQuery1ToCallProcess"/>
                        <bpws:target linkName="descrDtuToLogCausali"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogCausaliToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:param name=&quot;Causali&quot;/>&lt;xsl:param name=&quot;descrDtu&quot;/>&lt;xsl:template name=&quot;LogCausali-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Causali recuperate: &amp;quot;&quot;/>&lt;/tns:Message>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Causali/Record) > 0&quot;>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;FF: &amp;quot;, string(tib:render-xml($Causali, true(), true())))&quot;/>&lt;/tns:Payload>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;DTU: &amp;quot;, string(tib:render-xml($descrDtu, true(), true())))&quot;/>&lt;/tns:Payload>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogNuovaGestione-input"
                    name="LogNuovaGestione"
                    tibex:xpdlId="46f55456-b8a0-40eb-97aa-691b8d7f45e6"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStagingToLogNuovaGestione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogNuovaGestioneToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:template name=&quot;LogNuovaGestione-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Terminato processo invio notifica Espletamento verso FF con nuova gestione'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="descrDtu-input"
                    name="descrDtu" outputVariable="descrDtu"
                    tibex:xpdlId="62c5dc94-d3ee-43b8-9ea5-85db2131b229" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CausaliToJDBCQuery1_NoCausaliFF"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="descrDtuToLogCausali"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+62c5dc94-d3ee-43b8-9ea5-85db2131b229+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;descrDtu-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CausEsito>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CausaleEsitoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CausaleEsitoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CausEsito>&lt;Esito>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:EsitoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:EsitoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Esito>&lt;EventoNativoDtu>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:TipologiaEventoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:TipologiaEventoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/EventoNativoDtu>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT dtu.DESCR &#xd;&#xa;FROM TIPOLG_ESITO_DTU dtu &#xd;&#xa;WHERE dtu.CAUS_ESITO = ? AND dtu.ESITO = ? &#xd;&#xa;&#x9;AND dtu.EVENTO_NATIVO_DTU = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CausEsito"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Esito"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="EventoNativoDtu"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="13a911f1-4f11-4a15-95fc-d030ae4d038b">
                <bpws:targets>
                    <bpws:target linkName="LogCausaliToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToMapper">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/tns:RichiestaElement/operatoreRete='FF'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/tns:RichiestaElement/operatoreRete='FF']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToMapper1">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="MapperFC-input"
                    name="MapperFC" outputVariable="MapperFC"
                    tibex:xpdlId="fe34f9b9-904d-4b2c-ba43-1eeb0367ed11" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToMapper1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperFCToLogMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommerciali.service.fibercop.com/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;Causali&quot;/>&lt;xsl:param name=&quot;descrDtu&quot;/>&lt;xsl:template name=&quot;MapperFC-input&quot; match=&quot;/&quot;>&lt;tns:espletamento>&lt;richiesta>&lt;testata>&#xa;                                    &lt;!--Il codiceOrdineFiberCop viene inserito nel batch andandolo a recuperare dal record di Attivazione della tabella di staging-->&lt;codiceOrdineOperatore>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/codiceOrdineOperatore>&lt;codiceOutSourcer>&lt;xsl:value-of select=&quot;&amp;quot;TIM&amp;quot;&quot;/>&lt;/codiceOutSourcer>&lt;dataIdMessaggio>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/dataIdMessaggio>&lt;dataIdNotifica>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[Y0001][M01][D01] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/dataIdNotifica>&lt;dataRiscontro>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/dataRiscontro>&lt;idMessaggio>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_MESSAGGIO)&quot;/>&lt;/idMessaggio>&lt;idNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&lt;/idNotifica>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/lavorazione&quot;/>&lt;/tipoOrdine>&lt;tipoRiscontro>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTO&amp;quot;&quot;/>&lt;/tipoRiscontro>&lt;codiceOrdineFiberCop>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/codiceOrdineFiberCop>&lt;/testata>&lt;xsl:variable name=&quot;Riprogettato&quot; select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;RIPROGETTATO&amp;quot;]/valoreAttributo&quot;/>&lt;xsl:variable name=&quot;StatoOrdine&quot; select=&quot;if($Start/tns1:OK_KO=&amp;quot;OK&amp;quot;) then &amp;quot;0&amp;quot; else &amp;quot;1&amp;quot;&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;$StatoOrdine=&amp;quot;0&amp;quot;&quot;>&lt;espletamento>&lt;xsl:if test=&quot;$Riprogettato='Y' and not($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TIPORETE&amp;quot;]/valoreAttributo=('RIGIDA','ELASTICA'))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CAUSALERIPROGETTAZIONE&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CAUSALERIPROGETTAZIONE&amp;quot;]/valoreAttributo&quot;>&lt;causaRiprogettazioneOnField>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CAUSALERIPROGETTAZIONE&amp;quot;]/valoreAttributo&quot;/>&lt;/causaRiprogettazioneOnField>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;causaRiprogettazioneOnField>&lt;xsl:value-of select=&quot;'Cambio porta'&quot;/>&lt;/causaRiprogettazioneOnField>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TIPORETE&amp;quot;]/valoreAttributo=('RIGIDA','ELASTICA')&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ROE&amp;quot;]/valoreAttributo&quot;>&lt;codiceROE>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ROE&amp;quot;]/valoreAttributo&quot;/>&lt;/codiceROE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TIPORETE&amp;quot;]/valoreAttributo=('RIGIDA','ELASTICA')&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;]/valoreAttributo&quot;>&lt;codiceSplitterPrimario>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;]/valoreAttributo&quot;/>&lt;/codiceSplitterPrimario>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TIPORETE&amp;quot;]/valoreAttributo=('RIGIDA','ELASTICA')&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICESPLITTERSECONDARIO&amp;quot;]/valoreAttributo&quot;>&lt;codiceSplitterSecondario>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICESPLITTERSECONDARIO&amp;quot;]/valoreAttributo&quot;/>&lt;/codiceSplitterSecondario>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TIPORETE&amp;quot;]/valoreAttributo=('RIGIDA','ELASTICA')&quot;/>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;]/valoreAttributo)>2&quot;>&lt;posizioneMorsettieraROE>&lt;xsl:value-of select=&quot;tib:right($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;]/valoreAttributo,2)&quot;/>&lt;/posizioneMorsettieraROE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;posizioneMorsettieraROE>&lt;xsl:value-of select=&quot;tib:pad-front($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;]/valoreAttributo,2,&amp;quot;0&amp;quot;)&quot;/>&lt;/posizioneMorsettieraROE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TIPORETE&amp;quot;]/valoreAttributo=('RIGIDA','ELASTICA')&quot;/>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONESPLITTERSECONDARIO&amp;quot;]/valoreAttributo)>2&quot;>&lt;posizioneSplitterSecondario>&lt;xsl:value-of select=&quot;tib:right($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONESPLITTERSECONDARIO&amp;quot;]/valoreAttributo,2)&quot;/>&lt;/posizioneSplitterSecondario>&lt;/xsl:when>&lt;xsl:otherwise>&lt;posizioneSplitterSecondario>&lt;xsl:value-of select=&quot;tib:pad-front($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONESPLITTERSECONDARIO&amp;quot;]/valoreAttributo,2,&amp;quot;0&amp;quot;)&quot;/>&lt;/posizioneSplitterSecondario>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TIPORETE&amp;quot;]/valoreAttributo=('RIGIDA','ELASTICA')&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DIMENSIONEMORSETTIERA&amp;quot;]/valoreAttributo&quot;>&lt;dimensioneMorsettiera>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DIMENSIONEMORSETTIERA&amp;quot;]/valoreAttributo&quot;/>&lt;/dimensioneMorsettiera>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(format-date(xsd:date($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIACCESSO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DES&amp;quot;]/valoreAttributo), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot; ))>0&quot;>&lt;dataEspletamento>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIACCESSO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DES&amp;quot;]/valoreAttributo), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot; )&quot;/>&lt;/dataEspletamento>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(format-date($Start/ns:RichiestaElement/ordine/DES, &amp;quot;[Y0001]-[M01]-[D01]&amp;quot; ))>0&quot;>&lt;dataEspletamento>&lt;xsl:value-of select=&quot;format-date($Start/ns:RichiestaElement/ordine/DES, &amp;quot;[Y0001]-[M01]-[D01]&amp;quot; )&quot;/>&lt;/dataEspletamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;dataEspletamento>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/dataEspletamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDGPON&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDGPON&amp;quot;]/valoreAttributo&quot;>&lt;idGpon>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDGPON&amp;quot;]/valoreAttributo&quot;/>&lt;/idGpon>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;]/valoreAttributo&quot;>&lt;idGpon>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;]/valoreAttributo&quot;/>&lt;/idGpon>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/ns:RichiestaElement/tipologiaSottolav, 'TRASLOCO')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo) = ($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSANOW']/valoreAttributo)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;substring(tib:trim($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo), string-length(tib:trim($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo))-2,1) = &amp;quot;W&amp;quot;&quot;>&lt;idRisorsa>&lt;xsl:value-of select=&quot;tib:trim(tib:substring-before-last($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo, &amp;quot;W&amp;quot;))&quot;/>&lt;/idRisorsa>&lt;/xsl:when>&lt;xsl:otherwise>&lt;idRisorsa>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&lt;/idRisorsa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;substring(tib:trim($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSANOW']/valoreAttributo), string-length(tib:trim($Start/ns:Rich