    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperFCToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogMapperToTracciamentoWSTIM2" tibex:linkType="SUCCESS"/>
                <bpws:link name="InsertStagingToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="3be5bd91-1680-4bf0-a946-2793f535369c"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="0070856e-d7f1-45bd-be8a-e891d5213ce9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="JDBCQuery-input"
                    name="JDBCQuery" outputVariable="JDBCQuery"
                    tibex:xpdlId="3f388852-d26c-4747-b79f-bb84b0d620b3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3f388852-d26c-4747-b79f-bb84b0d620b3+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT s_id_notifica_ff.nextval AS id_notifica, s_id_messaggio_ff.nextval AS id_messaggio FROM dual " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_NOTIFICA"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_MESSAGGIO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="812681c9-5a68-467c-852e-7fb0ce5d02e2"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Inizio Processo di invio variazione aggiuntivi. Id  &amp;quot;&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($JDBCQuery)&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="MapperFC-input"
                    name="MapperFC" outputVariable="MapperFC"
                    tibex:xpdlId="0ff35c7c-bfd2-4b53-a3ef-f6764e1e3250" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperFCToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommerciali.service.fibercop.com/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;MapperFC-input&quot; match=&quot;/&quot;>&lt;tns:variazioneAggiuntivi>&lt;request>&lt;testata>&lt;codiceOperatore>&lt;xsl:value-of select=&quot;'TIM'&quot;/>&lt;/codiceOperatore>&lt;codiceOrdineOperatore>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/codiceOrdineOperatore>&lt;dataIdMessaggio>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/dataIdMessaggio>&lt;idMessaggio>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_MESSAGGIO)&quot;/>&lt;/idMessaggio>&lt;idNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&lt;/idNotifica>&lt;dataIdNotifica>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/dataIdNotifica>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;'VARIAZIONE_SEC'&quot;/>&lt;/tipoOrdine>&lt;servizio>&lt;xsl:value-of select=&quot;'RAME'&quot;/>&lt;/servizio>&lt;/testata>&lt;accessoVarSec>&lt;idRisorsa>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;/>&lt;/idRisorsa>&lt;note>&lt;xsl:value-of select=&quot;$Start/tns1:NoteDaSistema&quot;/>&lt;/note>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/tipologiaSottolav='INCREMENTOCANALI'&quot;>&lt;tipoLavorazione>&lt;xsl:value-of select=&quot;'INCREMENTO'&quot;/>&lt;/tipoLavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/tipologiaSottolav='DECREMENTOCANALI'&quot;>&lt;tipoLavorazione>&lt;xsl:value-of select=&quot;'DECREMENTO'&quot;/>&lt;/tipoLavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipoLavorazione>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tipoLavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/offerta='WLR' and $Start/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo=('PBX','GNR')&quot;>&lt;quantitaAggiuntivi>&lt;xsl:value-of select=&quot;count($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=('AGGIUNTIVO','DTUAGGIUNTIVO','DTUPRENOTAZIONEAGGIUNTIVO') and azione=('A','D')])&quot;/>&lt;/quantitaAggiuntivi>&lt;/xsl:when>&lt;xsl:otherwise>&lt;quantitaAggiuntivi>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/quantitaAggiuntivi>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/offerta='WLR' and $Start/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo=('PBX','GNR')&quot;>&lt;xsl:for-each select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=('AGGIUNTIVO','DTUAGGIUNTIVO','DTUPRENOTAZIONEAGGIUNTIVO') and azione=('A','D')]&quot;>&lt;xsl:variable name=&quot;var&quot; select=&quot;if(string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0) then (if (contains(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo, 'W')) then translate(tib:substring-before-last(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo, 'W'), ' ', '') else attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo) else (if (contains(attributiDettaglioOrdine[nomeAttributo='TELAGGIUNTIVO']/valoreAttributo, 'W')) then translate(tib:substring-before-last(attributiDettaglioOrdine[nomeAttributo='TELAGGIUNTIVO']/valoreAttributo, 'W'), ' ', '') else attributiDettaglioOrdine[nomeAttributo='TELAGGIUNTIVO']/valoreAttributo)&quot;/>&lt;serviziAggiuntivi>&lt;idRisorsaAggiuntiva>&lt;xsl:value-of select=&quot;if (substring(concat('0',xsd:string(xsd:integer($var))), 2, 1)=('2','6')) then concat('00',xsd:string(xsd:integer($var)))&amp;#xD;&amp;#xA;else if (substring(concat('0',xsd:string(xsd:integer($var))), 3, 1)=('0','1','5','9')) then concat('00',xsd:string(xsd:integer($var)))&amp;#xD;&amp;#xA;else xsd:string(xsd:integer($var))&quot;/>&lt;/idRisorsaAggiuntiva>&lt;xsl:choose>&lt;xsl:when test=&quot;azione='A'&quot;>&lt;movimentazione>&lt;xsl:value-of select=&quot;'ADD'&quot;/>&lt;/movimentazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;movimentazione>&lt;xsl:value-of select=&quot;'DEL'&quot;/>&lt;/movimentazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/serviziAggiuntivi>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;serviziAggiuntivi>&lt;idRisorsaAggiuntiva>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/idRisorsaAggiuntiva>&lt;movimentazione>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/movimentazione>&lt;/serviziAggiuntivi>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/accessoVarSec>&lt;/request>&lt;/tns:variazioneAggiuntivi>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:ordinicommerciali.service.fibercop.com="http://ordinicommerciali.service.fibercop.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="ordinicommerciali.service.fibercop.com:variazioneAggiuntivi" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogMapper-input"
                    name="LogMapper"
                    tibex:xpdlId="d22b2266-49ea-4ba5-9a3e-26b14f887f66"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperFCToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogMapperToTracciamentoWSTIM2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperFC&quot;/>&#xa;    &lt;xsl:template name=&quot;LogMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Richiesta da inviare a FC: &amp;quot;&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperFC)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="InsertStaging-input"
                name="InsertStaging" operation="Tracciamento"
                outputVariable="InsertStaging"
                partnerLink="TracciamentoWSTIM2"
                portType="ns1:TracciamentoWSTIM2" tibex:xpdlId="04f01eb5-267f-4bdd-b168-59c327a33be4">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns3="http://www.tim.com/NOW/xsd/EONOWwhls" xmlns:tns4="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns="http://www.tim.com/NOW/xsd/BPM2FF" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="IdProcsoNoFile"/&gt;
    &lt;xsl:param name="MapperFC"/&gt;
    &lt;xsl:template name="InsertStaging-input" match="/"&gt;
        &lt;tns1:TracciamentoRequest&gt;
            &lt;parameters&gt;
                &lt;tns2:TracciamentoInput&gt;
                    &lt;tns2:InsertUpdateStaging&gt;
                        &lt;tns4:ContenutoRequest&gt;
                            &lt;xsl:value-of select="tib:render-xml($MapperFC)"/&gt;
                        &lt;/tns4:ContenutoRequest&gt;
                        &lt;tns4:IdProcsoNoFile&gt;
                            &lt;xsl:value-of select="$IdProcsoNoFile"/&gt;
                        &lt;/tns4:IdProcsoNoFile&gt;
                        &lt;tns4:IdMessaggio&gt;
                            &lt;xsl:value-of select="$MapperFC/request/testata/idMessaggio"/&gt;
                        &lt;/tns4:IdMessaggio&gt;
                        &lt;tns4:IdStatoElabStaging&gt;
                            &lt;xsl:value-of select="42"/&gt;
                        &lt;/tns4:IdStatoElabStaging&gt;
                        &lt;tns4:TimstpRich&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TimstpRich&gt;
                        &lt;tns4:TimstpRisposta&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TimstpRisposta&gt;
                        &lt;tns4:IdRichOlo&gt;
                            &lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;
                        &lt;/tns4:IdRichOlo&gt;
                        &lt;tns4:IdNotf&gt;
                            &lt;xsl:value-of select="$MapperFC/request/testata/idNotifica"/&gt;
                        &lt;/tns4:IdNotf&gt;
                        &lt;tns4:IdRisorsaOperatoreRete&gt;
                            &lt;xsl:value-of select="&amp;quot;FC&amp;quot;"/&gt;
                        &lt;/tns4:IdRisorsaOperatoreRete&gt;
                        &lt;tns4:TipoOrdine&gt;
                            &lt;xsl:value-of select="$MapperFC/request/testata/tipoOrdine"/&gt;
                        &lt;/tns4:TipoOrdine&gt;
                        &lt;tns4:Transaction_ID&gt;
                            &lt;xsl:value-of select="$MapperFC/request/testata/codiceOrdineOperatore"/&gt;
                        &lt;/tns4:Transaction_ID&gt;
                        &lt;tns4:Azione&gt;
                            &lt;xsl:value-of select="&amp;quot;Insert&amp;quot;"/&gt;
                        &lt;/tns4:Azione&gt;
                        &lt;tns4:TipoRiscontro&gt;
                            &lt;xsl:value-of select="$Start/tns:TipoRiscontro"/&gt;
                        &lt;/tns4:TipoRiscontro&gt;
                        &lt;tns4:NumTentativo&gt;
                            &lt;xsl:value-of select="0&amp;#xD;&amp;#xA;"/&gt;
                        &lt;/tns4:NumTentativo&gt;
                    &lt;/tns2:InsertUpdateStaging&gt;
                    &lt;tns2:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/tns2:Azione&gt;
                    &lt;tns2:EONW&gt;
                        &lt;tns3:SistemaDestinatario&gt;
                            &lt;xsl:value-of select="&amp;quot;FIBERCOP&amp;quot;"/&gt;
                        &lt;/tns3:SistemaDestinatario&gt;
                        &lt;tns3:SistemaMittente&gt;
                            &lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;
                        &lt;/tns3:SistemaMittente&gt;
                        &lt;tns3:IdRichiestaOLO&gt;
                            &lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;
                        &lt;/tns3:IdRichiestaOLO&gt;
                        &lt;tns3:TipologiaEvento&gt;
                            &lt;xsl:value-of select="&amp;quot;FF_OL&amp;quot;"/&gt;
                        &lt;/tns3:TipologiaEvento&gt;
                        &lt;tns3:Transaction_ID&gt;
                            &lt;xsl:value-of select="$MapperFC/request/testata/codiceOrdineOperatore"/&gt;
                        &lt;/tns3:Transaction_ID&gt;
                        &lt;xsl:if test="$Start/tns:IdRichiestaDTU"&gt;
                            &lt;tns3:IdRichiestaDTU&gt;
                                &lt;xsl:value-of select="$Start/tns:IdRichiestaDTU"/&gt;
                            &lt;/tns3:IdRichiestaDTU&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns2:EONW&gt;
                    &lt;tns2:TransactionId&gt;
                        &lt;xsl:value-of select="concat($MapperFC/request/testata/idNotifica,&amp;quot;-&amp;quot;,$MapperFC/request/testata/idMessaggio)"/&gt;
                    &lt;/tns2:TransactionId&gt;
                    &lt;tns2:IdProcsoNoFile&gt;
                        &lt;xsl:value-of select="$IdProcsoNoFile"/&gt;
                    &lt;/tns2:IdProcsoNoFile&gt;
                &lt;/tns2:TracciamentoInput&gt;
            &lt;/parameters&gt;
        &lt;/tns1:TracciamentoRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperFC&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns2:InsertUpdateStaging>&#xa;                &lt;tns4:ContenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperFC)&quot;/>&#xa;                &lt;/tns4:ContenutoRequest>&#xa;                &lt;tns4:IdProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                &lt;/tns4:IdProcsoNoFile>&#xa;                &lt;tns4:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/idMessaggio&quot;/>&#xa;                &lt;/tns4:IdMessaggio>&#xa;                &lt;tns4:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;42&quot;/>&#xa;                &lt;/tns4:IdStatoElabStaging>&#xa;                &lt;tns4:TimstpRich>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRich>&#xa;                &lt;tns4:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRisposta>&#xa;                &lt;tns4:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:IdRichOlo>&#xa;                &lt;tns4:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/idNotifica&quot;/>&#xa;                &lt;/tns4:IdNotf>&#xa;                &lt;tns4:IdRisorsaOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FC&amp;quot;&quot;/>&#xa;                &lt;/tns4:IdRisorsaOperatoreRete>&#xa;                &lt;tns4:TipoOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/tipoOrdine&quot;/>&#xa;                &lt;/tns4:TipoOrdine>&#xa;                &lt;tns4:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns4:Transaction_ID>&#xa;                &lt;tns4:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Insert&amp;quot;&quot;/>&#xa;                &lt;/tns4:Azione>&#xa;                &lt;tns4:TipoRiscontro>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:TipoRiscontro&quot;/>&#xa;                &lt;/tns4:TipoRiscontro>&#xa;                &lt;tns4:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;0&amp;#xD;&amp;#xA;&quot;/>&#xa;                &lt;/tns4:NumTentativo>&#xa;            &lt;/tns2:InsertUpdateStaging>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:EONW>&#xa;                &lt;tns3:SistemaDestinatario>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FIBERCOP&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaDestinatario>&#xa;                &lt;tns3:SistemaMittente>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaMittente>&#xa;                &lt;tns3:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:IdRichiestaOLO>&#xa;                &lt;tns3:TipologiaEvento>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FF_OL&amp;quot;&quot;/>&#xa;                &lt;/tns3:TipologiaEvento>&#xa;                &lt;tns3:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/request/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns3:Transaction_ID>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiestaDTU&quot;>&#xa;                    &lt;tns3:IdRichiestaDTU>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaDTU&quot;/>&#xa;                    &lt;/tns3:IdRichiestaDTU>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:EONW>&#xa;            &lt;tns2:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($MapperFC/request/testata/idNotifica,&amp;quot;-&amp;quot;,$MapperFC/request/testata/idMessaggio)&quot;/>&#xa;            &lt;/tns2:TransactionId>&#xa;            &lt;tns2:IdProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;            &lt;/tns2:IdProcsoNoFile>&#xa;        &lt;/tns2:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogMapperToTracciamentoWSTIM2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InsertStagingToGenericLogger"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStaging&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InsertStaging/parameters/tns2:TracciamentoOutput)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogStaging-input" name="LogStaging"
                    tibex:xpdlId="8799023f-1f65-41a8-ad53-e70752cbc0cb"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InsertStagingToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InsertStaging.parameters)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
