    <bpws:import importType="http://schemas.xmlsoap.org/wsdl/"
        location="../../../../../Service%20Descriptors/OrdiniCommercialiFC.wsdl" namespace="http://ordinicommerciali.service.fibercop.com/"/>
    <bpws:import importType="http://schemas.xmlsoap.org/wsdl/" namespace="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/"/>
    <bpws:partnerLinks>
        <bpws:partnerLink name="TracciamentoWSTIM2"
            partnerLinkType="ns0:partnerLinkType" partnerRole="use"
            sca-bpel:ignore="true"
