                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaNotifica&quot;/>&#xa;    &lt;xsl:template name=&quot;LogNotifica-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Application>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Recuperata notifica:   &amp;quot;&quot;/>&#xa;                &lt;/tns6:Message>&#xa;                &lt;tns6:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($RecuperaNotifica)&quot;/>&#xa;                &lt;/tns6:Payload>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
