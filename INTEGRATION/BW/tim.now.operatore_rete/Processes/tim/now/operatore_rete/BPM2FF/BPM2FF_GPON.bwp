                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://ordinicommercialioao.service.fibercop.com/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;NomeFile&quot;/>&lt;xsl:param name=&quot;ParseRichiesta&quot;/>&lt;xsl:param name=&quot;ParseNotifica&quot;/>&lt;xsl:template name=&quot;MapperFC-input&quot; match=&quot;/&quot;>&lt;tns5:RichiestaFibercop>&lt;TestataFibercop>&lt;Canale>&lt;xsl:value-of select=&quot;'OSS'&quot;/>&lt;/Canale>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_ATTIVAZIONE'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'Attivazione'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_CESSAZIONE'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'Cessazione'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_ANNULLAMENTO'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'Annullamento'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_RIMODULAZIONEAPPUNTAMENTO'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'RimodulazioneAppuntamento'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_INTERRUZIONESOSPENSIONE'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'InterruzioneSospensione'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_ACCETTAZIONEOPERESPECIALI'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'AccettazioneOpereSpeciali'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_CANCELLAZIONEACCODAMENTO'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'CancellazioneAccodamento'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_ACCETTAZIONE'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'Accettato'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_SOSPENSIONE'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'Sospensione'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_DATAAPPUNTAMENTO'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'DataAppuntamento'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_PREVENTIVOOPERESPECIALI'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'PreventivoOpereSpeciali'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_ACCODAMENTO'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'Accodamento'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_RIMODULAZIONEDPS'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'RimodulazioneDPS'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_INCARICOADELIVERY'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'InCaricoADelivery'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_RAGIONESOCIALESU'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'RagioneSocialeSU'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_TENTATIVICONTATTO'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'TentativoContatto'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_RIMODULAZIONEDAI'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'RimodulazioneDAI'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_ESPLETAMENTO'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'Espletamento'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_INIZIOATTIVITA'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'InizioAttivita'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_INFO'&quot;>&lt;TipoEvento>&lt;xsl:value-of select=&quot;'Info'&quot;/>&lt;/TipoEvento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TipoEvento>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/TipoEvento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IdMessaggio>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_MESSAGGIO)&quot;/>&lt;/IdMessaggio>&lt;DataMessaggio>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DataMessaggio>&lt;DataNotifica>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DataNotifica>&lt;xsl:if test=&quot;$Start/tns:TipoRiscontro=('GPON_ATTIVAZIONE','GPON_CESSAZIONE','GPON_ANNULLAMENTO','GPON_RIMODULAZIONEAPPUNTAMENTO','GPON_INTERRUZIONESOSPENSIONE','GPON_ACCETTAZIONEOPERESPECIALI','GPON_CANCELLAZIONEACCODAMENTO')&quot;>&lt;xsl:if test=&quot;$NomeFile/Record[1]/NOME_FILE&quot;>&lt;NomeFileRichiesta>&lt;xsl:value-of select=&quot;$NomeFile/Record[1]/NOME_FILE&quot;/>&lt;/NomeFileRichiesta>&lt;/xsl:if>&lt;/xsl:if>&lt;IdNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&lt;/IdNotifica>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_ESPLETAMENTO' and $Start/ns:RichiestaElement/exGestioneAutonoma = 'S'&quot;>&lt;StatoDisaggregazione>&lt;xsl:value-of select=&quot;'EX-GESTIONE_AUTONOMA'&quot;/>&lt;/StatoDisaggregazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipoRiscontro='GPON_ESPLETAMENTO' and $Start/ns:RichiestaElement/gestioneAutonoma = ('IS', 'OS')&quot;>&lt;StatoDisaggregazione>&lt;xsl:value-of select=&quot;'GESTIONE_AUTONOMA'&quot;/>&lt;/StatoDisaggregaz