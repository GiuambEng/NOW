&amp;quot;]/valoreAttributo&quot;>&lt;TIPOLOGIACAVETTO>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TIPOLOGIACAVETTO&amp;quot;]/valoreAttributo&quot;/>&lt;/TIPOLOGIACAVETTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DIMENSIONEMORSETTIERA&amp;quot;]/valoreAttributo&quot;>&lt;DIMENSIONEMORSETTIERA>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DIMENSIONEMORSETTIERA&amp;quot;]/valoreAttributo&quot;/>&lt;/DIMENSIONEMORSETTIERA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDEGON&amp;quot;]/valoreAttributo&quot;>&lt;IDEGON>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDEGON&amp;quot;]/valoreAttributo&quot;/>&lt;/IDEGON>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;])&quot;>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/codiceISTATComune&quot;>&lt;CODICEISTAT>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/codiceISTATComune&quot;/>&lt;/CODICEISTAT>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/codiceISTATComune&quot;>&lt;CODICEISTAT>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/codiceISTATComune&quot;/>&lt;/CODICEISTAT>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDBORCHIAOTTICA&amp;quot;]/valoreAttributo&quot;>&lt;ID_BORCHIAOTTICA>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUDATIOPERATORERETE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDBORCHIAOTTICA&amp;quot;]/valoreAttributo&quot;/>&lt;/ID_BORCHIAOTTICA>&lt;/xsl:if>&lt;/DatiRete>&lt;/xsl:if>&lt;/tns5:RichiestaFibercop>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:ordinicommercialioao.service.fibercop.com="http://ordinicommercialioao.service.fibercop.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="ordinicommercialioao.service.fibercop.com:RichiestaFibercop" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogMapper-input"
                    name="LogMapper"
                    tibex:xpdlId="967ad07c-8868-4ed8-9b49-d07d20c52170"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperFCToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogMapperToTracciamentoWSTIM2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperFC&quot;/>&#xa;    &lt;xsl:template name=&quot;LogMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Application>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Richiesta da inviare a FC: &amp;quot;&quot;/>&#xa;                &lt;/tns6:Message>&#xa;                &lt;tns6:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperFC)&quot;/>&#xa;                &lt;/tns6:Payload>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="InsertStaging-input"
                name="InsertStaging" operation="Tracciamento"
                outputVariable="InsertStaging"
                partnerLink="TracciamentoWSTIM2"
                portType="ns2:TracciamentoWSTIM2" tibex:xpdlId="b43aae3e-6230-47d3-888c-0f8a3c014cc8">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns3="http://www.tim.com/NOW/xsd/EONOWwhls" xmlns:tns4="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns="http://www.tim.com/NOW/xsd/BPM2FF" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="IdProcsoNoFile"/&gt;&lt;xsl:param name="MapperFC"/&gt;&lt;xsl:template name="InsertStaging-input" match="/"&gt;&lt;tns1:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns2:TracciamentoInput&gt;&lt;tns2:InsertUpdateStaging&gt;&lt;tns4:ContenutoRequest&gt;&lt;xsl:value-of select="tib:render-xml($MapperFC)"/&gt;&lt;/tns4:ContenutoRequest&gt;&lt;tns4:IdProcsoNoFile&gt;&lt;xsl:value-of select="$IdProcsoNoFile"/&gt;&lt;/tns4:IdProcsoNoFile&gt;&lt;tns4:IdMessaggio&gt;&lt;xsl:value-of select="$MapperFC/TestataFibercop/IdMessaggio"/&gt;&lt;/tns4:IdMessaggio&gt;&lt;tns4:IdStatoElabStaging&gt;&lt;xsl:value-of select="42"/&gt;&lt;/tns4:IdStatoElabStaging&gt;&lt;tns4:TimstpRich&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns4:TimstpRich&gt;&lt;tns4:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns4:TimstpRisposta&gt;&lt;tns4:IdRichOlo&gt;&lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns4:IdRichOlo&gt;&lt;tns4:IdNotf&gt;&lt;xsl:value-of select="$MapperFC/TestataFibercop/IdNotifica"/&gt;&lt;/tns4:IdNotf&gt;&lt;tns4:IdRisorsaOperatoreRete&gt;&lt;xsl:value-of select="&amp;quot;FC&amp;quot;"/&gt;&lt;/tns4:IdRisorsaOperatoreRete&gt;&lt;tns4:TipoOrdine&gt;&lt;xsl:value-of select="$MapperFC/TestataFibercop/TipoEvento"/&gt;&lt;/tns4:TipoOrdine&gt;&lt;xsl:if test="$Start/tns:CodiceOrdineOperatore"&gt;&lt;tns4:Transaction_ID&gt;&lt;xsl:value-of select="$Start/tns:CodiceOrdineOperatore"/&gt;&lt;/tns4:Transaction_ID&gt;&lt;/xsl:if&gt;&lt;tns4:Azione&gt;&lt;xsl:value-of select="&amp;quot;Insert&amp;quot;"/&gt;&lt;/tns4:Azione&gt;&lt;tns4:TipoRiscontro&gt;&lt;xsl:value-of select="$Start/tns:TipoRiscontro"/&gt;&lt;/tns4:TipoRiscontro&gt;&lt;tns4:NumTentativo&gt;&lt;xsl:value-of select="0"/&gt;&lt;/tns4:NumTentativo&gt;&lt;/tns2:InsertUpdateStaging&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:EONW&gt;&lt;tns3:SistemaDestinatario&gt;&lt;xsl:value-of select="&amp;quot;FIBERCOP&amp;quot;"/&gt;&lt;/tns3:SistemaDestinatario&gt;&lt;tns3:SistemaMittente&gt;&lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;&lt;/tns3:SistemaMittente&gt;&lt;tns3:IdRichiestaOLO&gt;&lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns3:IdRichiestaOLO&gt;&lt;tns3:TipologiaEvento&gt;&lt;xsl:value-of select="&amp;quot;FF_OL&amp;quot;"/&gt;&lt;/tns3:TipologiaEvento&gt;&lt;xsl:if test="$Start/tns:CodiceOrdineOperatore"&gt;&lt;tns3:Transaction_ID&gt;&lt;xsl:value-of select="$Start/tns:CodiceOrdineOperatore"/&gt;&lt;/tns3:Transaction_ID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:IdRichiestaDTU"&gt;&lt;tns3:IdRichiestaDTU&gt;&lt;xsl:value-of select="$Start/tns:IdRichiestaDTU"/&gt;&lt;/tns3:IdRichiestaDTU&gt;&lt;/xsl:if&gt;&lt;/tns2:EONW&gt;&lt;tns2:TransactionId&gt;&lt;xsl:value-of select="concat($MapperFC/TestataFibercop/IdNotifica,&amp;quot;-&amp;quot;,$MapperFC/TestataFibercop/IdMessaggio)"/&gt;&lt;/tns2:TransactionId&gt;&lt;tns2:IdProcsoNoFile&gt;&lt;xsl:value-of select="$IdProcsoNoFile"/&gt;&lt;/tns2:IdProcsoNoFile&gt;&lt;/tns2:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns1:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperFC&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns2:InsertUpdateStaging>&#xa;                &lt;tns4:ContenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperFC)&quot;/>&#xa;                &lt;/tns4:ContenutoRequest>&#xa;                &lt;tns4:IdProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                &lt;/tns4:IdProcsoNoFile>&#xa;                &lt;tns4:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/TestataFibercop/IdMessaggio&quot;/>&#xa;                &lt;/tns4:IdMessaggio>&#xa;                &lt;tns4:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;42&quot;/>&#xa;                &lt;/tns4:IdStatoElabStaging>&#xa;                &lt;tns4:TimstpRich>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRich>&#xa;                &lt;tns4:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TimstpRisposta>&#xa;                &lt;tns4:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:IdRichOlo>&#xa;                &lt;tns4:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/TestataFibercop/IdNotifica&quot;/>&#xa;                &lt;/tns4:IdNotf>&#xa;                &lt;tns4:IdRisorsaOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FC&amp;quot;&quot;/>&#xa;                &lt;/tns4:IdRisorsaOperatoreRete>&#xa;                &lt;tns4:TipoOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$MapperFC/TestataFibercop/TipoEvento&quot;/>&#xa;                &lt;/tns4:TipoOrdine>&#xa;                &lt;xsl:if test=&quot;$Start/tns:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns4:Transaction_ID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns4:Transaction_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Insert&amp;quot;&quot;/>&#xa;                &lt;/tns4:Azione>&#xa;                &lt;tns4:TipoRiscontro>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:TipoRiscontro&quot;/>&#xa;                &lt;/tns4:TipoRiscontro>&#xa;                &lt;tns4:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns4:NumTentativo>&#xa;            &lt;/tns2:InsertUpdateStaging>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:EONW>&#xa;                &lt;tns3:SistemaDestinatario>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FIBERCOP&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaDestinatario>&#xa;                &lt;tns3:SistemaMittente>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaMittente>&#xa;                &lt;tns3:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:IdRichiestaOLO>&#xa;                &lt;tns3:TipologiaEvento>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FF_OL&amp;quot;&quot;/>&#xa;                &lt;/tns3:TipologiaEvento>&#xa;                &lt;xsl:if test=&quot;$Start/tns:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns3:Transaction_ID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns3:Transaction_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiestaDTU&quot;>&#xa;                    &lt;tns3:IdRichiestaDTU>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaDTU&quot;/>&#xa;                    &lt;/tns3:IdRichiestaDTU>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:EONW>&#xa;            &lt;tns2:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($MapperFC/TestataFibercop/IdNotifica,&amp;quot;-&amp;quot;,$MapperFC/TestataFibercop/IdMessaggio)&quot;/>&#xa;            &lt;/tns2:TransactionId>&#xa;            &lt;tns2:IdProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;            &lt;/tns2:IdProcsoNoFile>&#xa;        &lt;/tns2:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogMapperToTracciamentoWSTIM2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InsertStagingToGenericLogger"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStaging&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Application>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InsertStaging/parameters/tns2:TracciamentoOutput)&quot;/>&#xa;                &lt;/tns6:Payload>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogStaging-input" name="LogStaging"
                    tibex:xpdlId="1649d6c0-f826-4d67-a7e6-ccc7b898ab4f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InsertStagingToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Application>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:CodiceOrdineOperatore&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InsertStaging.parameters)&quot;/>&#xa;                &lt;/tns6:Payload>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
