                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/FF2BPM&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Rifiuto.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;Export2BPMRifiuto-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($Rifiuto.Input/tns:ATTIVAZIONE/tns:ACQUISITO/tns:CODICEORDINEFLASHFIBER)>0&quot;>&#xa;                &lt;Q1:InputFF2BPM>&#xa;                    &lt;Q1:NomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FFRIFIUTOACQUISITO&amp;quot;&quot;/>&#xa;                    &lt;/Q1:NomeComponente>&#xa;                    &lt;Q1:IdRichiestaOlo>&#xa;                        &lt;xsl:value-of select=&quot;substring-before($Rifiuto.Input/tns:TESTATA/tns:CODICEORDINEOPERATORE, &amp;quot;_&amp;quot;)&quot;/>&#xa;                    &lt;/Q1:IdRichiestaOlo>&#xa;                    &lt;Q1:Attributi>&#xa;                        &lt;xsl:if test=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:ACQUISITO/tns:CODICEORDINEFLASHFIBER&quot;>&#xa;                            &lt;Q1:CODICEORDINEFLASHFIBER>&#xa;                                &lt;xsl:value-of select=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:ACQUISITO/tns:CODICEORDINEFLASHFIBER&quot;/>&#xa;                            &lt;/Q1:CODICEORDINEFLASHFIBER>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:ACQUISITO/tns:CODICECAUSALE&quot;>&#xa;                            &lt;Q1:CAUSALERIFIUTOFF>&#xa;                                &lt;xsl:value-of select=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:ACQUISITO/tns:CODICECAUSALE&quot;/>&#xa;                            &lt;/Q1:CAUSALERIFIUTOFF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:ACQUISITO/tns:DESCRIZIONECAUSALE&quot;>&#xa;                            &lt;Q1:DESCRIZIONERIFIUTOFF>&#xa;                                &lt;xsl:value-of select=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:ACQUISITO/tns:DESCRIZIONECAUSALE&quot;/>&#xa;                            &lt;/Q1:DESCRIZIONERIFIUTOFF>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/Q1:Attributi>&#xa;                &lt;/Q1:InputFF2BPM>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($Rifiuto.Input/tns:ATTIVAZIONE/tns:EMESSO)&quot;>&#xa;                &lt;Q1:InputFF2BPM>&#xa;                    &lt;Q1:NomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FFRIFIUTOEMESSO&amp;quot;&quot;/>&#xa;                    &lt;/Q1:NomeComponente>&#xa;                    &lt;Q1:IdRichiestaOlo>&#xa;                        &lt;xsl:value-of select=&quot;substring-before($Rifiuto.Input/tns:TESTATA/tns:CODICEORDINEOPERATORE, &amp;quot;_&amp;quot;)&quot;/>&#xa;                    &lt;/Q1:IdRichiestaOlo>&#xa;                    &lt;Q1:Attributi>&#xa;                        &lt;xsl:if test=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:CODICEORDINEFLASHFIBER&quot;>&#xa;                            &lt;Q1:CODICEORDINEFLASHFIBER>&#xa;                                &lt;xsl:value-of select=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:CODICEORDINEFLASHFIBER&quot;/>&#xa;                            &lt;/Q1:CODICEORDINEFLASHFIBER>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:CODICECAUSALE&quot;>&#xa;                            &lt;Q1:CAUSALERIFIUTOFF>&#xa;                                &lt;xsl:value-of select=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:CODICECAUSALE&quot;/>&#xa;                            &lt;/Q1:CAUSALERIFIUTOFF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:DESCRIZIONECAUSALE&quot;>&#xa;                            &lt;Q1:DESCRIZIONERIFIUTOFF>&#xa;                                &lt;xsl:value-of select=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:DESCRIZIONECAUSALE&quot;/>&#xa;                            &lt;/Q1:DESCRIZIONERIFIUTOFF>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/Q1:Attributi>&#xa;                &lt;/Q1:InputFF2BPM>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($Rifiuto.Input/tns:ATTIVAZIONE/tns:CHIUSO)&quot;>&#xa;                &lt;Q1:InputFF2BPM>&#xa;                    &lt;Q1:NomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FFCHIUSO&amp;quot;&quot;/>&#xa;                    &lt;/Q1:NomeComponente>&#xa;                    &lt;Q1:IdRichiestaOlo>&#xa;                        &lt;xsl:value-of select=&quot;substring-before($Rifiuto.Input/tns:TESTATA/tns:CODICEORDINEOPERATORE, &amp;quot;_&amp;quot;)&quot;/>&#xa;                    &lt;/Q1:IdRichiestaOlo>&#xa;                    &lt;Q1:Attributi>&#xa;                        &lt;xsl:if test=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:CHIUSO/tns:CODICEORDINEFLASHFIBER&quot;>&#xa;                            &lt;Q1:CODICEORDINEFLASHFIBER>&#xa;                                &lt;xsl:value-of select=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:CHIUSO/tns:CODICEORDINEFLASHFIBER&quot;/>&#xa;                            &lt;/Q1:CODICEORDINEFLASHFIBER>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:CHIUSO/tns:CODICECAUSALE&quot;>&#xa;                            &lt;Q1:CAUSALERIFIUTOFF>&#xa;                                &lt;xsl:value-of select=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:CHIUSO/tns:CODICECAUSALE&quot;/>&#xa;                            &lt;/Q1:CAUSALERIFIUTOFF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:CHIUSO/tns:DESCRIZIONECAUSALE&quot;>&#xa;                            &lt;Q1:DESCRIZIONERIFIUTOFF>&#xa;                                &lt;xsl:value-of select=&quot;$Rifiuto.Input/tns:ATTIVAZIONE/tns:CHIUSO/tns:DESCRIZIONECAUSALE&quot;/>&#xa;                            &lt;/Q1:DESCRIZIONERIFIUTOFF>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/Q1:Attributi>&#xa;                &lt;/Q1:InputFF2BPM>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;Q1:InputFF2BPM>&#xa;                    &lt;Q1:NomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FFRIFIUTOACQUISITO&amp;quot;&quot;/>&#xa;                    &lt;/Q1:NomeComponente>&#xa;                    &lt;Q1:IdRichiestaOlo>&#xa;                        &lt;xsl:value-of select=&quot;substring-before($Rifiuto.Input/tns:TESTATA/tns:CODICEORDINEOPERATORE, &amp;quot;_&amp;quot;)&quot;/>&#xa;                    &lt;/Q1:IdRichiestaOlo>&#xa;                    &lt;Q1:Attributi>&#xa;                        &lt;xsl:if test=&quot;$Rifiuto.Input/tns:CESSAZIONE/tns:ACQUISITO/tns:CODICEORDINEFLASHFIBER&quot;>&#xa;                            &lt;Q1:CODICEORDINEFLASHFIBER>&#xa;                                &lt;xsl:value-of select=&quot;$Rifiuto.Input/tns:CESSAZIONE/tns:ACQUISITO/tns:CODICEORDINEFLASHFIBER&quot;/>&#xa;                            &lt;/Q1:CODICEORDINEFLASHFIBER>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/Q1:Attributi>&#xa;                &lt;/Q1:InputFF2BPM>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.operatore_rete.Export2BPM.FF2BPM" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Rifiuto&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:template name=&quot;LogNuovaGestione2-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;WSTIM1PortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Rifiuto&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;concat($Rifiuto/Input/tns2:Rifiuto/tns2:TESTATA/tns2:IDNOTIFICA,&amp;quot;-&amp;quot;,$Rifiuto/Input/tns2:Rifiuto/tns2:TESTATA/tns2:IDMESSAGGIO)&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Terminato processo invio notifica Rifiuto verso BPM con nuova gestione'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogNuovaGestione2-input"
                                    name="LogNuovaGestione2"
                                    tibex:xpdlId="b56504fe-4fa9-4471-9bc0-d4d6c821c085"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Scope1ToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToExit1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Rifiuto.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogNuovaGestione2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;WSTIM1PortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Rifiuto&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;concat($Rifiuto.Input/tns2:TESTATA/tns2:IDNOTIFICA,&amp;quot;-&amp;quot;,$Rifiuto.Input/tns2:TESTATA/tns2:IDMESSAGGIO)&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Terminato processo invio notifica Rifiuto verso BPM con nuova gestione'&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:exit name="Exit1" tibex:xpdlId="6c919413-0879-4e9e-a548-6ca054e5d0d9">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToExit1"/>
                                </bpws:targets>
                            </bpws:exit>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
