                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://www.tim.com/NOW/xsd/WSTIM1/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="FaultDetails1"/&gt;&lt;xsl:param name="Rifiuto"/&gt;&lt;xsl:param name="TracciamentoRifiuto"/&gt;&lt;xsl:template name="Invoke2-input" match="/"&gt;&lt;tns1:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns2:TracciamentoInput&gt;&lt;xsl:copy-of select="$Rifiuto/Input/tns3:Rifiuto"/&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:IdEsecProcsoNoFile&gt;&lt;xsl:value-of select="xsd:int(xsd:decimal($TracciamentoRifiuto/parameters/tns2:TracciamentoOutput/tns2:IdEsecProcsoNoFile))"/&gt;&lt;/tns2:IdEsecProcsoNoFile&gt;&lt;xsl:if test="$TracciamentoRifiuto/parameters/tns2:TracciamentoOutput/tns2:CodProcsoNoFile"&gt;&lt;tns2:CodProcsoFIle&gt;&lt;xsl:value-of select="$TracciamentoRifiuto/parameters/tns2:TracciamentoOutput/tns2:CodProcsoNoFile"/&gt;&lt;/tns2:CodProcsoFIle&gt;&lt;/xsl:if&gt;&lt;tns2:StatoEsec&gt;&lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;&lt;/tns2:StatoEsec&gt;&lt;tns2:DescrErrore&gt;&lt;xsl:value-of select="tib:render-xml($FaultDetails1/StackTrace, true(),true())"/&gt;&lt;/tns2:DescrErrore&gt;&lt;tns2:TransactionId&gt;&lt;xsl:value-of select="concat($Rifiuto/Input/tns3:Rifiuto/tns3:TESTATA/tns3:IDNOTIFICA,&amp;quot;-&amp;quot;,$Rifiuto/Input/tns3:Rifiuto/tns3:TESTATA/tns3:IDMESSAGGIO)"/&gt;&lt;/tns2:TransactionId&gt;&lt;xsl:if test="$TracciamentoRifiuto/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"&gt;&lt;tns2:IdEventoOrdineNowWhls&gt;&lt;xsl:value-of select="$TracciamentoRifiuto/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;&lt;/tns2:IdEventoOrdineNowWhls&gt;&lt;/xsl:if&gt;&lt;/tns2:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns1:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
