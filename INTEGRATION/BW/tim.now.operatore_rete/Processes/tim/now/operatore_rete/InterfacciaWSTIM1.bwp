                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/FF2BPM&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NotificaAttivazione_Cessazione.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;Export2BPM-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:ACQUISITO/tns:CODICEORDINEFLASHFIBER)>0&quot;>&#xa;                &lt;Q1:InputFF2BPM>&#xa;                    &lt;Q1:NomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FFACQUISITO&amp;quot;&quot;/>&#xa;                    &lt;/Q1:NomeComponente>&#xa;                    &lt;Q1:IdRichiestaOlo>&#xa;                        &lt;xsl:value-of select=&quot;substring-before($NotificaAttivazione_Cessazione.Input/tns:TESTATA/tns:CODICEORDINEOPERATORE, &amp;quot;_&amp;quot;)&quot;/>&#xa;                    &lt;/Q1:IdRichiestaOlo>&#xa;                    &lt;Q1:Attributi>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:ACQUISITO/tns:CODICEORDINEFLASHFIBER&quot;>&#xa;                            &lt;Q1:CODICEORDINEFLASHFIBER>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:ACQUISITO/tns:CODICEORDINEFLASHFIBER&quot;/>&#xa;                            &lt;/Q1:CODICEORDINEFLASHFIBER>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/Q1:Attributi>&#xa;                &lt;/Q1:InputFF2BPM>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO)&quot;>&#xa;                &lt;Q1:InputFF2BPM>&#xa;                    &lt;Q1:NomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FFEMESSO&amp;quot;&quot;/>&#xa;                    &lt;/Q1:NomeComponente>&#xa;                    &lt;Q1:IdRichiestaOlo>&#xa;                        &lt;xsl:value-of select=&quot;substring-before($NotificaAttivazione_Cessazione.Input/tns:TESTATA/tns:CODICEORDINEOPERATORE, &amp;quot;_&amp;quot;)&quot;/>&#xa;                    &lt;/Q1:IdRichiestaOlo>&#xa;                    &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:IDRISORSA&quot;>&#xa;                        &lt;Q1:IdRisorsaFF>&#xa;                            &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:IDRISORSA&quot;/>&#xa;                        &lt;/Q1:IdRisorsaFF>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;Q1:Attributi>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:CODICEORDINEFLASHFIBER&quot;>&#xa;                            &lt;Q1:CODICEORDINEFLASHFIBER>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:CODICEORDINEFLASHFIBER&quot;/>&#xa;                            &lt;/Q1:CODICEORDINEFLASHFIBER>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:SEDE/tns:CODICEEGON&quot;>&#xa;                            &lt;Q1:IDEGON>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:SEDE/tns:CODICEEGON&quot;/>&#xa;                            &lt;/Q1:IDEGON>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:PROGETTAZIONE&quot;>&#xa;                            &lt;Q1:PROGETTAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:PROGETTAZIONE&quot;/>&#xa;                            &lt;/Q1:PROGETTAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:IDGPON&quot;>&#xa;                            &lt;Q1:IDGPON>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:IDGPON&quot;/>&#xa;                            &lt;/Q1:IDGPON>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:CODICESPLITTERPRIMARIO&quot;>&#xa;                            &lt;Q1:CODICESPLITTERPRIMARIO>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:CODICESPLITTERPRIMARIO&quot;/>&#xa;                            &lt;/Q1:CODICESPLITTERPRIMARIO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:CODICESPLITTERSECONDARIO&quot;>&#xa;                            &lt;Q1:CODICESPLITTERSECONDARIO>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:CODICESPLITTERSECONDARIO&quot;/>&#xa;                            &lt;/Q1:CODICESPLITTERSECONDARIO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:POSIZIONESPLITTER&quot;>&#xa;                            &lt;Q1:POSIZIONESPLITTER>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:POSIZIONESPLITTER&quot;/>&#xa;                            &lt;/Q1:POSIZIONESPLITTER>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:CODICEROE&quot;>&#xa;                            &lt;Q1:ROE>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:CODICEROE&quot;/>&#xa;                            &lt;/Q1:ROE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:POSIZIONEMORSETTIERAROE&quot;>&#xa;                            &lt;Q1:POSIZIONEMORSETTIERAROE>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:POSIZIONEMORSETTIERAROE&quot;/>&#xa;                            &lt;/Q1:POSIZIONEMORSETTIERAROE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:RIPROGETTAZIONE&quot;>&#xa;                            &lt;Q1:RIPROGETTAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:RIPROGETTAZIONE&quot;/>&#xa;                            &lt;/Q1:RIPROGETTAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:FORCE&quot;>&#xa;                            &lt;Q1:FORCE>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:EMESSO/tns:FORCE&quot;/>&#xa;                            &lt;/Q1:FORCE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/Q1:Attributi>&#xa;                &lt;/Q1:InputFF2BPM>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:DESOSPESO)&quot;>&#xa;                &lt;Q1:InputFF2BPM>&#xa;                    &lt;Q1:NomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FFDESOSPESO&amp;quot;&quot;/>&#xa;                    &lt;/Q1:NomeComponente>&#xa;                    &lt;Q1:IdRichiestaOlo>&#xa;                        &lt;xsl:value-of select=&quot;substring-before($NotificaAttivazione_Cessazione.Input/tns:TESTATA/tns:CODICEORDINEOPERATORE, &amp;quot;_&amp;quot;)&quot;/>&#xa;                    &lt;/Q1:IdRichiestaOlo>&#xa;                    &lt;Q1:Attributi>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:DESOSPESO/tns:CODICEORDINEFLASHFIBER&quot;>&#xa;                            &lt;Q1:CODICEORDINEFLASHFIBER>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:DESOSPESO/tns:CODICEORDINEFLASHFIBER&quot;/>&#xa;                            &lt;/Q1:CODICEORDINEFLASHFIBER>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:DESOSPESO/tns:SEDE/tns:CODICEEGON&quot;>&#xa;                            &lt;Q1:IDEGON>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:DESOSPESO/tns:SEDE/tns:CODICEEGON&quot;/>&#xa;                            &lt;/Q1:IDEGON>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:DESOSPESO/tns:PROGETTAZIONE&quot;>&#xa;                            &lt;Q1:PROGETTAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns:ATTIVAZIONE/tns:DESOSPESO/tns:PROGETTAZIO