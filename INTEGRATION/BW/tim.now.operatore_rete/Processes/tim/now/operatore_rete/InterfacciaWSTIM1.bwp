                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NotificaAttivazione_Cessazione.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Tracciamento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($NotificaAttivazione_Cessazione.Input/tns4:ATTIVAZIONE/tns4:EMESSO)&quot;>&#xa;                    &lt;tns4:NotificaAttivazione_Cessazione>&#xa;                        &lt;xsl:copy-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns4:TESTATA&quot;/>&#xa;                        &lt;tns4:ATTIVAZIONE>&#xa;                            &lt;xsl:copy-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns4:ATTIVAZIONE/tns4:ACQUISITO&quot;/>&#xa;                            &lt;tns4:EMESSO>&#xa;                                &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns4:ATTIVAZIONE/tns4:EMESSO/tns4:CODICEORDINEFLASHFIBER&quot;>&#xa;                                    &lt;tns4:CODICEORDINEFLASHFIBER>&#xa;                                        &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns4:ATTIVAZIONE/tns4:EMESSO/tns4:CODICEORDINEFLASHFIBER&quot;/>&#xa;                                    &lt;/tns4:CODICEORDINEFLASHFIBER>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:copy-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns4:ATTIVAZIONE/tns4:EMESSO/tns4:SEDE&quot;/>&#xa;                                &lt;tns4:DATAEMISSIONE>&#xa;                                    &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns4:ATTIVAZIONE/tns4:EMESSO/tns4:DATAEMISSIONE&quot;/>&#xa;                                &lt;/tns4:DATAEMISSIONE>&#xa;                                &lt;tns4:IDRISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns4:ATTIVAZIONE/tns4:EMESSO/tns4:IDRISORSA&quot;/>&#xa;                                &lt;/tns4:IDRISORSA>&#xa;                                &lt;tns4:DAI>&#xa;                                    &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns4:ATTIVAZIONE/tns4:EMESSO/tns4:DAI&quot;/>&#xa;                                &lt;/tns4:DAI>&#xa;                                &lt;xsl:if test=&quot;$NotificaAttivazione_Cessazione.Input/tns4:ATTIVAZIONE/tns4:EMESSO/tns4:FASCIAORARIADAI&quot;>&#xa;                                    &lt;tns4:FASCIAORARIADAI>&#xa;                                        &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns4:ATTIVAZIONE/tns4:EMESSO/tns4:FASCIAORARIADAI&quot;/>&#xa;                                    &lt;/tns4:FASCIAORARIADAI>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns4:PROGETTAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns4:ATTIVAZIONE/tns4:EMESSO/tns4:PROGETTAZIONE&quot;/>&#xa;                                &lt;/tns4:PROGETTAZIONE>&#xa;                                &lt;tns4:IDGPON>&#xa;                                    &lt;xsl:value-of select=&quot;$NotificaAttivazione_Cessazione.Input/tns4:ATTIVAZIONE/tns4:EMESSO/tns4:IDGPON&quot;/>&#xa;                                &lt;/tns4:IDGPON>&#xa;                                &lt;tns4:CODICESPLITTERPRIMARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$No