azione_Cessazione.Input/tns4:ATTIVAZIONE/tns4:DESOSPESO)&quot;>&#xa;                        &lt;tns3:TipologiaEvento>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FF_DESOSPENSIONE_DA_FF&amp;quot;&quot;/>&#xa;                        &lt;/tns3:TipologiaEvento>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaAttivazione_Cessazione.Input/tns4:CESSAZIONE/tns4:ACQUISITO)&quot;>&#xa;                        &lt;tns3:TipologiaEvento>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FF_CESSAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tns3:TipologiaEvento>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;concat($NotificaAttivazione_Cessazione.Input/tns4:TESTATA/tns4:IDNOTIFICA,&amp;quot;-&amp;quot;,$NotificaAttivazione_Cessazione.Input/tns4:TESTATA/tns4:IDMESSAGGIO)&quot;/>&#xa;                &lt;/tns3:Transaction_ID>&#xa;            &lt;/tns2:EONW>&#xa;            &lt;tns2:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($NotificaAttivazione_Cessazione.Input/tns4:TESTATA/tns4:IDNOTIFICA,&amp;quot;-&amp;quot;,$NotificaAttivazione_Cessazione.Input/tns4:TESTATA/tns4:IDMESSAGGIO)&quot;/>&#xa;            &lt;/tns2:TransactionId>&#xa;            &lt;tns2:IdProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;            &lt;/tns2:IdProcsoNoFile>&#xa;        &lt;/tns2:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
