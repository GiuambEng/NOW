                                partnerLink="TracciamentoWSTIM2"
                                portType="ns2:TracciamentoWSTIM2" tibex:xpdlId="2f94e947-28b7-4b0b-8681-52db332d75c3">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns3="http://www.tim.com/NOW/xsd/EONOWwhls" xmlns:tns4="http://www.tim.com/NOW/xsd/WSTIM1/" version="2.0"&gt;&lt;xsl:param name="IdProcsoNoFile"/&gt;&lt;xsl:param name="Rifiuto"/&gt;&lt;xsl:template name="TracciamentoRifiuto-input" match="/"&gt;&lt;tns1:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns2:TracciamentoInput&gt;&lt;xsl:copy-of select="$Rifiuto/Input/tns4:Rifiuto"/&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:EONW&gt;&lt;tns3:SistemaDestinatario&gt;&lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;&lt;/tns3:SistemaDestinatario&gt;&lt;tns3:SistemaMittente&gt;&lt;xsl:value-of select="&amp;quot;FLASHFIBER&amp;quot;"/&gt;&lt;/tns3:SistemaMittente&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains($Rifiuto/Input/tns4:Rifiuto/tns4:TESTATA/tns4:CODICEORDINEOPERATORE,'_')"&gt;&lt;tns3:IdRichiestaOLO&gt;&lt;xsl:value-of select="substring-before($Rifiuto/Input/tns4:Rifiuto/tns4:TESTATA/tns4:CODICEORDINEOPERATORE,'_')"/&gt;&lt;/tns3:IdRichiestaOLO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns3:IdRichiestaOLO&gt;&lt;xsl:value-of select="$Rifiuto/Input/tns4:Rifiuto/tns4:TESTATA/tns4:CODICEORDINEOPERATORE"/&gt;&lt;/tns3:IdRichiestaOLO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($Rifiuto/Input/tns4:Rifiuto/tns4:ATTIVAZIONE/tns4:ACQUISITO)"&gt;&lt;tns3:TipologiaEvento&gt;&lt;xsl:value-of select="&amp;quot;FF_ACQUISITO_KO&amp;quot;"/&gt;&lt;/tns3:TipologiaEvento&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($Rifiuto/Input/tns4:Rifiuto/tns4:ATTIVAZIONE/tns4:EMESSO)"&gt;&lt;tns3:TipologiaEvento&gt;&lt;xsl:value-of select="&amp;quot;FF_EMESSO_KO&amp;quot;"/&gt;&lt;/tns3:TipologiaEvento&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($Rifiuto/Input/tns4:Rifiuto/tns4:ATTIVAZIONE/tns4:CHIUSO)"&gt;&lt;tns3:TipologiaEvento&gt;&lt;xsl:value-of select="&amp;quot;FF_CHIUSO&amp;quot;"/&gt;&lt;/tns3:TipologiaEvento&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($Rifiuto/Input/tns4:Rifiuto/tns4:CESSAZIONE/tns4:ACQUISITO)"&gt;&lt;tns3:TipologiaEvento&gt;&lt;xsl:value-of select="&amp;quot;FF_CESSAZIONE&amp;quot;"/&gt;&lt;/tns3:TipologiaEvento&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;tns3:Transaction_ID&gt;&lt;xsl:value-of select="concat($Rifiuto/Input/tns4:Rifiuto/tns4:TESTATA/tns4:IDNOTIFICA,&amp;quot;-&amp;quot;,$Rifiuto/Input/tns4:Rifiuto/tns4:TESTATA/tns4:IDMESSAGGIO)"/&gt;&lt;/tns3:Transaction_ID&gt;&lt;/tns2:EONW&gt;&lt;tns2:TransactionId&gt;&lt;xsl:value-of select="concat($Rifiuto/Input/tns4:Rifiuto/tns4:TESTATA/tns4:IDNOTIFICA,&amp;quot;-&amp;quot;,$Rifiuto/Input/tns4:Rifiuto/tns4:TESTATA/tns4:IDMESSAGGIO)"/&gt;&lt;/tns2:TransactionId&gt;&lt;tns2:IdProcsoNoFile&gt;&lt;xsl:value-of select="$IdProcsoNoFile"/&gt;&lt;/tns2:IdProcsoNoFile&gt;&lt;/tns2:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns1:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Rifiuto.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;TracciamentoRifiuto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;xsl:copy-of select=&quot;$Rifiuto.Input&quot;/>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:EONW>&#xa;                &lt;tns3:SistemaDestinatario>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaDestinatario>&#xa;                &lt;tns3:SistemaMittente>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FLASHFIBER&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaMittente>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($Rifiuto.Input/tns4:TESTATA/tns4:CODICEORDINEOPERATORE,'_')&quot;>&#xa;                        &lt;tns3:IdRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($Rifiuto.Input/tns4:TESTATA/tns4:CODICEORDINEOPERATORE,'_')&quot;/>&#xa;                        &lt;/tns3:IdRichiestaOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:IdRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Rifiuto.Input/tns4:TESTATA/tns4:CODICEORDINEOPERATORE&quot;/>&#xa;                        &lt;/tns3:IdRichiestaOLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Rifiuto.Input/tns4:ATTIVAZIONE/tns4:ACQUISITO)&quot;>&#xa;                        &lt;tns3:TipologiaEvento>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FF_ACQUISITO_KO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:TipologiaEvento>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Rifiuto.Input/tns4:ATTIVAZIONE/tns4:EMESSO)&quot;>&#xa;                        &lt;tns3:TipologiaEvento>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FF_EMESSO_KO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:TipologiaEvento>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Rifiuto.Input/tns4:ATTIVAZIONE/tns4:CHIUSO)&quot;>&#xa;                        &lt;tns3:TipologiaEvento>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FF_CHIUSO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:TipologiaEvento>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Rifiuto.Input/tns4:CESSAZIONE/tns4:ACQUISITO)&quot;>&#xa;                        &lt;tns3:TipologiaEvento>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FF_CESSAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tns3:TipologiaEvento>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;concat($Rifiuto.Input/tns4:TESTATA/tns4:IDNOTIFICA,&amp;quot;-&amp;quot;,$Rifiuto.Input/tns4:TESTATA/tns4:IDMESSAGGIO)&quot;/>&#xa;                &lt;/tns3:Transaction_ID>&#xa;            &lt;/tns2:EONW>&#xa;            &lt;tns2:TransactionI