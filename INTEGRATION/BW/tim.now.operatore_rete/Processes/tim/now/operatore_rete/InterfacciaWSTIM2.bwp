                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/WSTIM2/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OL.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;Tracciamento.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-Tracciamento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;xsl:copy-of select=&quot;$OL.Input&quot;/>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:IdEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Tracciamento.parameters/tns2:IdEsecProcsoNoFile))&quot;/>&#xa;            &lt;/tns2:IdEsecProcsoNoFile>&#xa;            &lt;xsl:if test=&quot;$Tracciamento.parameters/tns2:CodProcsoNoFile&quot;>&#xa;                &lt;tns2:CodProcsoFIle>&#xa;                    &lt;xsl:value-of select=&quot;$Tracciamento.parameters/tns2:CodProcsoNoFile&quot;/>&#xa;                &lt;/tns2:CodProcsoFIle>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/tns2:StatoEsec>&#xa;            &lt;tns2:ContenutoResponse>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($Response)&quot;/>&#xa;            &lt;/tns2:ContenutoResponse>&#xa;            &lt;tns2:CodiceAckNack>&#xa;                &lt;xsl:value-of select=&q