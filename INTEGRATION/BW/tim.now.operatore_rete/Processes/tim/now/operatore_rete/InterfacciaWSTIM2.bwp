                                partnerLink="TracciamentoWSTIM2"
                                portType="ns3:TracciamentoWSTIM2" tibex:xpdlId="4b802f08-57e5-41ca-b3e3-7a6fe0f2cd52">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/WSTIM2/" xmlns:tns1="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns3="http://www.tim.com/NOW/xsd/EONOWwhls" version="2.0"&gt;&lt;xsl:param name="OL"/&gt;&lt;xsl:param name="IdProcsoNoFile"/&gt;&lt;xsl:template name="Tracciamento-input" match="/"&gt;&lt;tns1:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns2:TracciamentoInput&gt;&lt;tns:OL&gt;&lt;xsl:copy-of select="$OL/Input/tns:OL/tns:TESTATA"/&gt;&lt;tns:ATTIVAZIONE&gt;&lt;tns:DATICLIENTE&gt;&lt;tns:COGNOMERAGSOC&gt;&lt;xsl:value-of select="$OL/Input/tns:OL/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:COGNOMERAGSOC"/&gt;&lt;/tns:COGNOMERAGSOC&gt;&lt;xsl:if test="$OL/Input/tns:OL/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:NOME"&gt;&lt;tns:NOME&gt;&lt;xsl:value-of select="$OL/Input/tns:OL/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:NOME"/&gt;&lt;/tns:NOME&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($OL/Input/tns:OL/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:RECAPITOFISSOCLIENTE)"&gt;&lt;tns:RECAPITOFISSOCLIENTE&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns:RECAPITOFISSOCLIENTE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns:RECAPITOMOBILECLIENTE&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns:RECAPITOMOBILECLIENTE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$OL/Input/tns:OL/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:CF"&gt;&lt;tns:CF&gt;&lt;xsl:value-of select="$OL/Input/tns:OL/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:CF"/&gt;&lt;/tns:CF&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$OL/Input/tns:OL/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:PIVA"&gt;&lt;tns:PIVA&gt;&lt;xsl:value-of select="$OL/Input/tns:OL/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:PIVA"/&gt;&lt;/tns:PIVA&gt;&lt;/xsl:if&gt;&lt;/tns:DATICLIENTE&gt;&lt;xsl:copy-of select="$OL/Input/tns:OL/tns:ATTIVAZIONE/tns:SEDE"/&gt;&lt;xsl:copy-of select="$OL/Input/tns:OL/tns:ATTIVAZIONE/tns:OUTSOURCER"/&gt;&lt;xsl:copy-of select="$OL/Input/tns:OL/tns:ATTIVAZIONE/tns:OL"/&gt;&lt;xsl:if test="$OL/Input/tns:OL/tns:ATTIVAZIONE/tns:NOTE"&gt;&lt;tns:NOTE&gt;&lt;xsl:value-of select="$OL/Input/tns:OL/tns:ATTIVAZIONE/tns:NOTE"/&gt;&lt;/tns:NOTE&gt;&lt;/xsl:if&gt;&lt;/tns:ATTIVAZIONE&gt;&lt;/tns:OL&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:EONW&gt;&lt;tns3:SistemaDestinatario&gt;&lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;&lt;/tns3:SistemaDestinatario&gt;&lt;tns3:SistemaMittente&gt;&lt;xsl:value-of select="&amp;quot;FLASHFIBER&amp;quot;"/&gt;&lt;/tns3:SistemaMittente&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains($OL/Input/tns:OL/tns:TESTATA/tns:CODICEORDINEOPERATORE,'_')"&gt;&lt;tns3:IdRichiestaOLO&gt;&lt;xsl:value-of select="substring-before($OL/Input/tns:OL/tns:TESTATA/tns:CODICEORDINEOPERATORE,'_')"/&gt;&lt;/tns3:IdRichiestaOLO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns3:IdRichiestaOLO&gt;&lt;xsl:value-of select="$OL/Input/tns:OL/tns:TESTATA/tns:CODICEORDINEOPERATORE"/&gt;&lt;/tns3:IdRichiestaOLO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns3:TipologiaEvento&gt;&lt;xsl:value-of select="&amp;quot;FF_OL&amp;quot;"/&gt;&lt;/tns3:TipologiaEvento&gt;&lt;tns3:Transaction_ID&gt;&lt;xsl:value-of select="concat($OL/Input/tns:OL/tns:TESTATA/tns:IDNOTIFICA,&amp;quot;-&amp;quot;,$OL/Input/tns:OL/tns:TESTATA/tns:IDMESSAGGIO)"/&gt;&lt;/tns3:Transaction_ID&gt;&lt;/tns2:EONW&gt;&lt;tns2:TransactionId&gt;&lt;xsl:value-of select="concat($OL/Input/tns:OL/tns:TESTATA/tns:IDNOTIFICA,&amp;quot;-&amp;quot;,$OL/Input/tns:OL/tns:TESTATA/tns:IDMESSAGGIO)"/&gt;&lt;/tns2:TransactionId&gt;&lt;tns2:IdProcsoNoFile&gt;&lt;xsl:value-of select="$IdProcsoNoFile"/&gt;&lt;/tns2:IdProcsoNoFile&gt;&lt;/tns2:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns1:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/WSTIM2/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OL.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Tracciamento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns:OL>&#xa;                &lt;xsl:copy-of select=&quot;$OL.Input/tns:TESTATA&quot;/>&#xa;                &lt;tns:ATTIVAZIONE>&#xa;                    &lt;tns:DATICLIENTE>&#xa;                        &lt;tns:COGNOMERAGSOC>&#xa;                            &lt;xsl:value-of select=&quot;$OL.Input/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:COGNOMERAGSOC&quot;/>&#xa;                        &lt;/tns:COGNOMERAGSOC>&#xa;                        &lt;xsl:if test=&quot;$OL.Input/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:NOME&quot;>&#xa;                            &lt;tns:NOME>&#xa;                                &lt;xsl:value-of select=&quot;$OL.Input/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:NOME&quot;/>&#xa;                            &lt;/tns:NOME>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($OL.Input/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:RECAPITOFISSOCLIENTE)&quot;>&#xa;                                &lt;tns:RECAPITOFISSOCLIENTE>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/tns:RECAPITOFISSOCLIENTE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:RECAPITOMOBILECLIENTE>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/tns:RECAPITOMOBILECLIENTE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$OL.Input/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:CF&quot;>&#xa;                            &lt;tns:CF>&#xa;                                &lt;xsl:value-of select=&quot;$OL.Input/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:CF&quot;/>&#xa;                            &lt;/tns:CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$OL.Input/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:PIVA&quot;>&#xa;                            &lt;tns:PIVA>&#xa;                                &lt;xsl:value-of select=&quot;$OL.Input/tns:ATTIVAZIONE/tns:DATICLIENTE/tns:PIVA&quot;/>&#xa;                            &lt;/tns:PIVA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:DATICLIENTE>&#xa;                    &lt;xsl:copy-of select=&quot;$OL.Input/tns:ATTIVAZIONE/tns:SEDE&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$OL.Input/tns:ATTIVAZIONE/tns:OUTSOURCER&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$OL.Input/tns:ATTIVAZIONE/tns:OL&quot;/>&#xa;                    &lt;xsl:if test=&quot;$OL.Input/tns:ATTIVAZIONE/tns:NOTE&quot;>&#xa;                        &lt;tns:NOTE>&#xa;                            &lt;xsl:value-of select=&quot;$OL.Input/tns:ATTIVAZIONE/tns:NOTE&quot;/>&#xa;                        &lt;/tns:NOTE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:ATTIVAZIONE>&#xa;            &lt;/tns:OL>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:EONW>&#xa;                &lt;tns3:SistemaDestinatario>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaDestinatario>&#xa;                &lt;tns3:SistemaMittente>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FLASHFIBER&amp;quot;&quot;/>&#xa;                &lt;/tns3:SistemaMittente>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($OL.Input/tns:TESTATA/tns:CODICEORDINEOPERATORE,'_')&quot;>&#xa;                        &lt;tns3:IdRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($OL.Input/tns:TESTATA/tns:CODICEORDINEOPERATORE,'_')&quot;/>&#xa;                        &lt;/tns3:IdRichiestaOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:IdRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$OL.Input/tns:TESTATA/tns:CODICEORDINEOPERATORE&quot;/>&#xa;                        &lt;/tns3:IdRichiestaOLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:TipologiaEvento>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FF_OL&amp;quot;&quot;/>&#xa;                &lt;/tns3:TipologiaEvento>&#xa;                &lt;tns3:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;concat($OL.Input/tns:TESTATA/tns:IDNOTIFICA,&amp;quot;-&amp;quot;,$OL.Input/tns:TESTATA/tns:IDMESSAGGIO)&quot;/>&#xa;                &lt;/tns3:Transaction_ID>&#xa;            &lt;/tns2:EONW>&#xa;            &lt;tns2:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($OL.Input/tns:TESTATA/tns:IDNOTIFICA,&amp;quot;-&amp;quot;,$OL.Input/tns:TESTATA/tns:IDMESSAGGIO)&quot;/>&#xa;            &lt;/tns2:TransactionId>&#xa;            &lt;tns2:IdProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;            &lt;/tns2:IdProcsoNoFile>&#xa;        &lt;/tns2:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
