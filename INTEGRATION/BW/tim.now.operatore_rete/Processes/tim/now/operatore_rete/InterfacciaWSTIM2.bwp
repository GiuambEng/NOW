                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FF2BPM&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WSTIM2/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OL&quot;/>&lt;xsl:template name=&quot;Export2BPM-input&quot; match=&quot;/&quot;>&lt;tns:InputFF2BPM>&lt;tns:NomeComponente>&lt;xsl:value-of select=&quot;&amp;quot;FFOL&amp;quot;&quot;/>&lt;/tns:NomeComponente>&lt;tns:IdRichiestaOlo>&lt;xsl:value-of select=&quot;substring-before($OL/Input/tns1:OL/tns1:TESTATA/tns1:CODICEORDINEOPERATORE,&amp;quot;_&amp;quot;)&quot;/>&lt;/tns:IdRichiestaOlo>&lt;tns:Attributi>&lt;tns:CODICEORDINEFLASHFIBER>&lt;xsl:value-of select=&quot;$OL/Input/tns1:OL/tns1:TESTATA/tns1:CODICEORDINEMITTENTE&quot;/>&lt;/tns:CODICEORDINEFLASHFIBER>&lt;xsl:if test=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:SEDE/tns1:CODICEEGON&quot;>&lt;tns:IDEGON>&lt;xsl:value-of select=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:SEDE/tns1:CODICEEGON&quot;/>&lt;/tns:IDEGON>&lt;/xsl:if>&lt;xsl:if test=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:PROGETTAZIONE&quot;>&lt;tns:PROGETTAZIONE>&lt;xsl:value-of select=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:PROGETTAZIONE&quot;/>&lt;/tns:PROGETTAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:IDGPON&quot;>&lt;tns:IDGPON>&lt;xsl:value-of select=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:IDGPON&quot;/>&lt;/tns:IDGPON>&lt;/xsl:if>&lt;xsl:if test=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:CODICESPLITTERPRIMARIO&quot;>&lt;tns:CODICESPLITTERPRIMARIO>&lt;xsl:value-of select=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:CODICESPLITTERPRIMARIO&quot;/>&lt;/tns:CODICESPLITTERPRIMARIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:CODICESPLITTERSECONDARIO&quot;>&lt;tns:CODICESPLITTERSECONDARIO>&lt;xsl:value-of select=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:CODICESPLITTERSECONDARIO&quot;/>&lt;/tns:CODICESPLITTERSECONDARIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:POSIZIONESPLITTER&quot;>&lt;tns:POSIZIONESPLITTER>&lt;xsl:value-of select=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:POSIZIONESPLITTER&quot;/>&lt;/tns:POSIZIONESPLITTER>&lt;/xsl:if>&lt;xsl:if test=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:CODICEROE&quot;>&lt;tns:ROE>&lt;xsl:value-of select=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:CODICEROE&quot;/>&lt;/tns:ROE>&lt;/xsl:if>&lt;xsl:if test=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:POSIZIONEMORSETTIERAROE&quot;>&lt;tns:POSIZIONEMORSETTIERAROE>&lt;xsl:value-of select=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:POSIZIONEMORSETTIERAROE&quot;/>&lt;/tns:POSIZIONEMORSETTIERAROE>&lt;/xsl:if>&lt;xsl:if test=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:RIPROGETTAZIONE&quot;>&lt;tns:RIPROGETTAZIONE>&lt;xsl:value-of select=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:RIPROGETTAZIONE&quot;/>&lt;/tns:RIPROGETTAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:FORCE&quot;>&lt;tns:FORCE>&lt;xsl:value-of select=&quot;$OL/Input/tns1:OL/tns1:ATTIVAZIONE/tns1:OL/tns1:FORCE&quot;/>&lt;/tns:FORCE>&lt;/xsl:if>&lt;/tns:Attributi>&lt;/tns:InputFF2BPM>&lt;/xsl:template>&lt;/xsl:stylesheet>"
