            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.tibco.com/WSTIM2/"/>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/"/>
        </wsdl:definitions>
    </tibex:Types>
