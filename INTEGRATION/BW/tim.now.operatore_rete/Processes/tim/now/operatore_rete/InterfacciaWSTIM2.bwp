                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FF2BPM&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WSTIM2/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OL.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;Export2BPM-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:InputFF2BPM>&#xa;            &lt;tns:NomeComponente>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FFOL&amp;quot;&quot;/>&#xa;            &lt;/tns:NomeComponente>&#xa;            &lt;tns:IdRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;substring-before($OL.Input/tns1:TESTATA/tns1:CODICEORDINEOPERATORE,&amp;quot;_&amp;quot;)&quot;/>&#xa;            &lt;/tns:IdRichiestaOlo>&#xa;            &lt;tns:Attributi>&#xa;                &lt;tns:CODICEORDINEFLASHFIBER>&#xa;                    &lt;xsl:value-of select=&quot;$OL.Input/tns1:TESTATA/tns1:CODICEORDINEMITTENTE&quot;/>&#xa;                &lt;/tns:CODICEORDINEFLASHFIBER>&#xa;                &lt;xsl:if test=&quot;$OL.Input/tns1:ATTIVAZIONE/tns1:SEDE/tns1:CODICEEGON&quot;>&#xa;                    &lt;tns:IDEGON>&#xa;                        &lt;xsl:value-of select=&quot;$OL.Input/tns1:ATTIVAZIONE/tns1:SEDE/tns1:CODICEEGON&quot;/>&#xa;                    &lt;/tns:IDEGON>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$OL.Input/tns1:ATTIVAZIONE/tns1:OL/tns1:PROGETTAZIONE&quot;>&#xa;                    &lt;tns:PROGETTAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$OL.Input/tns1:ATTIVAZIONE/tns1:OL/tns1:PROGETTAZIONE&quot;/>&#xa;                    &lt;/tns:PROGETTAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$OL.Input/tns1:ATTIVAZIONE/tns1:OL/tns1:IDGPON&quot;>&#xa;                    &lt;tns:IDGPON>&#xa;                        &lt;xsl:valu