tribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TPLG_EVENTO>&lt;TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_AGGTO>&lt;TIMSTP_INSMTO_EVENTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_INSMTO_EVENTO>&lt;ID_RICH_DTU>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IdRichiestaDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_DTU>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
