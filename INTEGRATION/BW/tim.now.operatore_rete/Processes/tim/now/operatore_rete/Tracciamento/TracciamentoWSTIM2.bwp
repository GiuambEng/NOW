            <bpws:invoke inputVariable="InsertNoFile-input"
                name="InsertNoFile" operation="Insert"
                outputVariable="InsertNoFile" partnerLink="ProcessLog"
                portType="ns2:ProcessLog" tibex:xpdlId="68a019a0-b554-4c58-8992-2185a6ec650e">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" version="2.0"&gt;&lt;xsl:param name="OLIn"/&gt;&lt;xsl:template name="InsertNoFile-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile/&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$OLIn/parameters/tns2:TracciamentoInput/tns2:IdProcsoNoFile"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$OLIn/parameters/tns2:TracciamentoInput/tns2:IdProcsoNoFile"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="string(current-dateTime())"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:if test="$OLIn/parameters/tns2:TracciamentoInput/tns2:TransactionId"&gt;&lt;ns:TRANSACTION_ID&gt;&lt;xsl:value-of select="$OLIn/parameters/tns2:TracciamentoInput/tns2:TransactionId"/&gt;&lt;/ns:TRANSACTION_ID&gt;&lt;/xsl:if&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
