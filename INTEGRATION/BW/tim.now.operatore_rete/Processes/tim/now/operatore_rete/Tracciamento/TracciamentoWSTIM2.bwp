                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/WSTIM2/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OLIn&quot;/>&lt;xsl:param name=&quot;EONW&quot;/>&lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging)&quot;>&lt;tns2:InputInsertUpdate>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:ContenutoRequest&quot;>&lt;tns2:ContenutoRequest>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:ContenutoRequest&quot;/>&lt;/tns2:ContenutoRequest>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:ContenutoResponse&quot;>&lt;tns2:ContenutoResponse>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:ContenutoResponse&quot;/>&lt;/tns2:ContenutoResponse>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:DescrErrore&quot;>&lt;tns2:DescrErrore>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:DescrErrore&quot;/>&lt;/tns2:DescrErrore>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:HTTPResponse&quot;>&lt;tns2:HTTPResponse>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoIn