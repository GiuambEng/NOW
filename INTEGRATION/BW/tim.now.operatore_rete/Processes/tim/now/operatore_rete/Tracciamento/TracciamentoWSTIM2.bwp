InsertUpdateStaging/tns2:IdNotf&quot;/>&lt;/tns2:IdNotf>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:IdRisorsaOperatoreRete&quot;>&lt;tns2:IdRisorsaOperatoreRete>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:IdRisorsaOperatoreRete&quot;/>&lt;/tns2:IdRisorsaOperatoreRete>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:CodiceAckNack&quot;>&lt;tns2:CodiceAckNack>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:CodiceAckNack&quot;/>&lt;/tns2:CodiceAckNack>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:TipoOrdine&quot;>&lt;tns2:TipoOrdine>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:TipoOrdine&quot;/>&lt;/tns2:TipoOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:TipoMessaggio&quot;>&lt;tns2:TipoMessaggio>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:TipoMessaggio&quot;/>&lt;/tns2:TipoMessaggio>&lt;/xsl:if>&lt;xsl:if test=&quot;$EONW/tns1:IdEONW&quot;>&lt;tns2:IdEventoOrdnNowWhls>&lt;xsl:value-of select=&quot;$EONW/tns1:IdEONW&quot;/>&lt;/tns2:IdEventoOrdnNowWhls>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:Transaction_ID&quot;>&lt;tns2:Transaction_ID>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:Transaction_ID&quot;/>&lt;/tns2:Transaction_ID>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:Azione&quot;>&lt;tns2:Azione>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:Azione&quot;/>&lt;/tns2:Azione>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:TipoRiscontro&quot;>&lt;tns2:TipoRiscontro>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:TipoRiscontro&quot;/>&lt;/tns2:TipoRiscontro>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:NumTentativo&quot;>&lt;tns2:NumTentativo>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:NumTentativo&quot;/>&lt;/tns2:NumTentativo>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:Token&quot;>&lt;tns2:Token>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:InsertUpdateStaging/tns2:Token&quot;/>&lt;/tns2:Token>&lt;/xsl:if>&lt;/tns2:InputInsertUpdate>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:InputInsertUpdate>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($OLIn/parameters/tns:TracciamentoInput/tns3:OL)&quot;>&lt;tns2:ContenutoRequest>&lt;xsl:value-of select=&quot;tib:render-xml($OLIn/parameters/tns:TracciamentoInput/tns3:OL)&quot;/>&lt;/tns2:ContenutoRequest>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($OLIn/parameters/tns:TracciamentoInput/tns4:NotificaAttivazione_Cessazione)&quot;>&lt;tns2:ContenutoRequest>&lt;xsl:value-of select=&quot;tib:render-xml($OLIn/parameters/tns:TracciamentoInput/tns4:NotificaAttivazione_Cessazione)&quot;/>&lt;/tns2:ContenutoRequest>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:ContenutoRequest>&lt;xsl:value-of select=&quot;tib:render-xml($OLIn/parameters/tns:TracciamentoInput/tns4:Rifiuto)&quot;/>&lt;/tns2:ContenutoRequest>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:IdProcsoNoFile&quot;>&lt;tns2:IdProcsoNoFile>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:IdProcsoNoFile&quot;/>&lt;/tns2:IdProcsoNoFile>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($OLIn/parameters/tns:TracciamentoInput/tns3:OL/tns3:TESTATA/tns3:IDMESSAGGIO)>0&quot;>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns3:OL/tns3:TESTATA/tns3:IDMESSAGGIO&quot;>&lt;tns2:IdMessaggio>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns3:OL/tns3:TESTATA/tns3:IDMESSAGGIO&quot;/>&lt;/tns2:IdMessaggio>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($OLIn/parameters/tns:TracciamentoInput/tns4:NotificaAttivazione_Cessazione/tns4:TESTATA/tns4:IDMESSAGGIO)>0&quot;>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns4:NotificaAttivazione_Cessazione/tns4:TESTATA/tns4:IDMESSAGGIO&quot;>&lt;tns2:IdMessaggio>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns4:NotificaAttivazione_Cessazione/tns4:TESTATA/tns4:IDMESSAGGIO&quot;/>&lt;/tns2:IdMessaggio>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns4:Rifiuto/tns4:TESTATA/tns4:IDMESSAGGIO&quot;>&lt;tns2:IdMessaggio>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns4:Rifiuto/tns4:TESTATA/tns4:IDMESSAGGIO&quot;/>&lt;/tns2:IdMessaggio>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:IdStatoElabStaging>&lt;xsl:value-of select=&quot;42&quot;/>&lt;/tns2:IdStatoElabStaging>&lt;tns2:TimstpRich>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns2:TimstpRich>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:EONW/tns1:IdRichiestaOLO&quot;>&lt;tns2:IdRichOlo>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:EONW/tns1:IdRichiestaOLO&quot;/>&lt;/tns2:IdRichOlo>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($OLIn/parameters/tns:TracciamentoInput/tns3:OL/tns3:TESTATA/tns3:IDNOTIFICA)>0&quot;>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns3:OL/tns3:TESTATA/tns3:IDNOTIFICA&quot;>&lt;tns2:IdNotf>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns3:OL/tns3:TESTATA/tns3:IDNOTIFICA&quot;/>&lt;/tns2:IdNotf>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($OLIn/parameters/tns:TracciamentoInput/tns4:NotificaAttivazione_Cessazione/tns4:TESTATA/tns4:IDNOTIFICA)>0&quot;>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns4:NotificaAttivazione_Cessazione/tns4:TESTATA/tns4:IDNOTIFICA&quot;>&lt;tns2:IdNotf>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns4:NotificaAttivazione_Cessazione/tns4:TESTATA/tns4:IDNOTIFICA&quot;/>&lt;/tns2:IdNotf>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns4:Rifiuto/tns4:TESTATA/tns4:IDNOTIFICA&quot;>&lt;tns2:IdNotf>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns4:Rifiuto/tns4:TESTATA/tns4:IDNOTIFICA&quot;/>&lt;/tns2:IdNotf>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:IdRisorsaOperatoreRete>&lt;xsl:value-of select=&quot;&amp;quot;FF&amp;quot;&quot;/>&lt;/tns2:IdRisorsaOperatoreRete>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($OLIn/parameters/tns:TracciamentoInput/tns4:NotificaAttivazione_Cessazione/tns4:CESSAZIONE) or exists($OLIn/parameters/tns:TracciamentoInput/tns4:Rifiuto/tns4:CESSAZIONE)&quot;>&lt;tns2:TipoOrdine>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&lt;/tns2:TipoOrdine>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:TipoOrdine>&lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&lt;/tns2:TipoOrdine>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($OLIn/parameters/tns:TracciamentoInput/tns4:NotificaAttivazione_Cessazione/tns4:TESTATA/tns4:TIPOMESSAGGIO)>0&quot;>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns4:NotificaAttivazione_Cessazione/tns4:TESTATA/tns4:TIPOMESSAGGIO&quot;>&lt;tns2:TipoMessaggio>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns4:NotificaAttivazione_Cessazione/tns4:TESTATA/tns4:TIPOMESSAGGIO&quot;/>&lt;/tns2:TipoMessaggio>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($OLIn/parameters/tns:TracciamentoInput/tns4:Rifiuto/tns4:TESTATA/tns4:TIPOMESSAGGIO)>0&quot;>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns4:Rifiuto/tns4:TESTATA/tns4:TIPOMESSAGGIO&quot;>&lt;tns2:TipoMessaggio>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns4:Rifiuto/tns4:TESTATA/tns4:TIPOMESSAGGIO&quot;/>&lt;/tns2:TipoMessaggio>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$EONW/tns1:IdEONW&quot;>&lt;tns2:IdEventoOrdnNowWhls>&lt;xsl:value-of select=&quot;$EONW/tns1:IdEONW&quot;/>&lt;/tns2:IdEventoOrdnNowWhls>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:TransactionId&quot;>&lt;tns2:Transaction_ID>&lt;xsl:value-of select=&quot;$OLIn/parameters/tns:TracciamentoInput/tns:TransactionId&quot;/>&lt;/tns2:Transaction_ID>&lt;/xsl:if>&lt;tns2:Azione>&lt;xsl:value-of select=&quot;&amp;quot;Insert&amp;quot;&quot;/>&lt;/tns2:Azione>&lt;/tns2:InputInsertUpdate>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="InsertStaging-input"
                    name="InsertStaging"
                    tibex:xpdlId="6ed0d76e-cb10-47d7-8a9b-7e9b454bf153"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToInsertStaging"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/WSTIM2/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;EONW&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($OLIn.parameters/tns:InsertUpdateStaging)&quot;>&#xa;                &lt;tns2:InputInsertUpdate>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:ContenutoRequest&quot;>&#xa;                        &lt;tns2:ContenutoRequest>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:ContenutoRequest&quot;/>&#xa;                        &lt;/tns2:ContenutoRequest>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:ContenutoResponse&quot;>&#xa;                        &lt;tns2:ContenutoResponse>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:ContenutoResponse&quot;/>&#xa;                        &lt;/tns2:ContenutoResponse>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:DescrErrore&quot;>&#xa;                        &lt;tns2:DescrErrore>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:DescrErrore&quot;/>&#xa;                        &lt;/tns2:DescrErrore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:HTTPResponse&quot;>&#xa;                        &lt;tns2:HTTPResponse>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:HTTPResponse&quot;/>&#xa;                        &lt;/tns2:HTTPResponse>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:IdProcsoNoFile&quot;>&#xa;                        &lt;tns2:IdProcsoNoFile>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:IdProcsoNoFile&quot;/>&#xa;                        &lt;/tns2:IdProcsoNoFile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:IdMessaggio&quot;>&#xa;                        &lt;tns2:IdMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:IdMessaggio&quot;/>&#xa;                        &lt;/tns2:IdMessaggio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:IdStatoElabStaging&quot;>&#xa;                        &lt;tns2:IdStatoElabStaging>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:IdStatoElabStaging&quot;/>&#xa;                        &lt;/tns2:IdStatoElabStaging>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:TimstpRich&quot;>&#xa;                        &lt;tns2:TimstpRich>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns:InsertUpdateStaging/tns2:TimstpRich