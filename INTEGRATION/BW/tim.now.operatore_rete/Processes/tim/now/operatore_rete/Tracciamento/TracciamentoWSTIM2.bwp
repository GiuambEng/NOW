                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($OLIn.parameters/tns1:InsertUpdateStaging)&quot;>&#xa;                &lt;tns:InputInsertUpdate>&#xa;                    &lt;xsl:copy-of select=&quot;$OLIn.parameters/tns1:InsertUpdateStaging/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$OLIn.parameters/tns1:InsertUpdateStaging/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$OLIn.parameters/tns1:InsertUpdateStaging/node()&quot;/>&#xa;                &lt;/tns:InputInsertUpdate>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:InputInsertUpdate>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns1:ContenutoResponse&quot;>&#xa;                        &lt;tns:ContenutoResponse>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns1:ContenutoResponse&quot;/>&#xa;                        &lt;/tns:ContenutoResponse>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns1:DescrErrore&quot;>&#xa;                        &lt;tns:DescrErrore>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns1:DescrErrore&quot;/>&#xa;                        &lt;/tns:DescrErrore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($OLIn.parameters/tns1:DescrErrore)>0&quot;>&#xa;                            &lt;tns:IdStatoElabStaging>&#xa;                                &lt;xsl:value-of select=&quot;12&quot;/>&#xa;                            &lt;/tns:IdStatoElabStaging>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:IdStatoElabStaging>&#xa;                                &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                            &lt;/tns:IdStatoElabStaging>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:TimstpRisposta>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:TimstpRisposta>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns1:CodiceAckNack&quot;>&#xa;                        &lt;tns:CodiceAckNack>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns1:CodiceAckNack&quot;/>&#xa;                        &lt;/tns:CodiceAckNack>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns1:IdEventoOrdineNowWhls&quot;>&#xa;                        &lt;tns:IdEventoOrdnNowWhls>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns1:IdEventoOrdineNowWhls&quot;/>&#xa;                        &lt;/tns:IdEventoOrdnNowWhls>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns1:TransactionId&quot;>&#xa;                        &lt;tns:Transaction_ID>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns1:TransactionId&quot;/>&#xa;                        &lt;/tns:Transaction_ID>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:Azione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&#xa;                    &lt;/tns:Azione>&#xa;                    &lt;xsl:if test=&quot;$OLIn.parameters/tns1:NumTentativo&quot;>&#xa;                        &lt;tns:NumTentativo>&#xa;                            &lt;xsl:value-of select=&quot;$OLIn.parameters/tns1:NumTentativo&quot;/>&#xa;                        &lt;/tns:NumTentativo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:InputInsertUpdate>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
