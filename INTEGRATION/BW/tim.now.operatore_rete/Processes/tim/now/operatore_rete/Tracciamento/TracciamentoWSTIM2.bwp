                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/EventoOperatoreRete&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/WSTIM2/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;EventoOperatoreRete-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($OLIn.parameters/tns:EventoOperatoreRete)&quot;>&#xa;                &lt;tns1:InputEOR>&#xa;                    &lt;xsl:copy-of select=&quot;$OLIn.parameters/tns:EventoOperatoreRete/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$OLIn.parameters/tns:EventoOperatoreRete/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$OLIn.parameters/tns:EventoOperatoreRete/node()&quot;/>&#xa;                &lt;/tns1:InputEOR>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:InputEOR>&#xa;                    &lt;tns1:IdEventoOrdnNowWhls>&#xa;                        &lt;xsl:value-of select=&quot;$OLIn.parameters/tns:IdEventoOrdineNowWhls&quot;/>&#xa;                    &lt;/tns1:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($OLIn.parameters/tns2:OL/tns2:TESTATA/tns2:IDNOTIFICA)>0&quot;>&#xa;                            &lt;tns1:IdNotf>&#xa;                                &lt;xsl:value-of select=&quot;$OLIn.parameters/tns2:OL/tns2:TESTATA/tns2:IDNOTIFICA&quot;/>&#xa;                            &lt;/tns1:IdNotf>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:TESTATA/tns3:IDNOTIFICA)>0&quot;>&#xa;                            &lt;tns1:IdNotf>&#xa;                                &lt;xsl:value-of select=&quot;$OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:TESTATA/tns3:IDNOTIFICA&quot;/>&#xa;                            &lt;/tns1:IdNotf>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:IdNotf>&#xa;                                &lt;xsl:value-of select=&quot;$OLIn.parameters/tns3:Rifiuto/tns3:TESTATA/tns3:IDNOTIFICA&quot;/>&#xa;                            &lt;/tns1:IdNotf>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($OLIn.parameters/tns2:OL/tns2:TESTATA/tns2:CODICEORDINEOPERATORE)>0&quot;>&#xa;                            &lt;tns1:IdRichOlo>&#xa;                                &lt;xsl:value-of select=&quot;substring-before($OLIn.parameters/tns2:OL/tns2:TESTATA/tns2:CODICEORDINEOPERATORE, &amp;quot;_&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:IdRichOlo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:TESTATA/tns3:CODICEORDINEOPERATORE)>0&quot;>&#xa;                            &lt;tns1:IdRichOlo>&#xa;                                &lt;xsl:value-of select=&quot;substring-before($OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:TESTATA/tns3:CODICEORDINEOPERATORE, &amp;quot;_&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:IdRichOlo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($OLIn.parameters/tns3:Rifiuto/tns3:TESTATA/tns3:CODICEORDINEOPERATORE)>0&quot;>&#xa;                            &lt;tns1:IdRichOlo>&#xa;                                &lt;xsl:value-of select=&quot;substring-before($OLIn.parameters/tns3:Rifiuto/tns3:TESTATA/tns3:CODICEORDINEOPERATORE, &amp;quot;_&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:IdRichOlo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:IdRichOlo>&#xa;                                &lt;xsl:value-of select=&quot;$OLIn.parameters/tns:EONW/tns4:IdRichiestaOLO&quot;/>&#xa;                            &lt;/tns1:IdRichOlo>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($OLIn.parameters/tns2:OL/tns2:TESTATA/tns2:IDMESSAGGIO)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$OLIn.parameters/tns2:OL/tns2:TESTATA/tns2:IDMESSAGGIO&quot;>&#xa;                                &lt;tns1:IdMessaggio>&#xa;                                    &lt;xsl:value-of select=&quot;$OLIn.parameters/tns2:OL/tns2:TESTATA/tns2:IDMESSAGGIO&quot;/>&#xa;                                &lt;/tns1:IdMessaggio>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:TESTATA/tns3:IDMESSAGGIO)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:TESTATA/tns3:IDMESSAGGIO&quot;>&#xa;                                &lt;tns1:IdMessaggio>&#xa;                                    &lt;xsl:value-of select=&quot;$OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:TESTATA/tns3:IDMESSAGGIO&quot;/>&#xa;                                &lt;/tns1:IdMessaggio>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$OLIn.parameters/tns3:Rifiuto/tns3:TESTATA/tns3:IDMESSAGGIO&quot;>&#xa;                                &lt;tns1:IdMessaggio>&#xa;                                    &lt;xsl:value-of select=&quot;$OLIn.parameters/tns3:Rifiuto/tns3:TESTATA/tns3:IDMESSAGGIO&quot;/>&#xa;                                &lt;/tns1:IdMessaggio>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns1:TimstpInsmto>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:TimstpInsmto>&#xa;                    &lt;tns1:IdEventoOperatoreRete>&#xa;                        &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                    &lt;/tns1:IdEventoOperatoreRete>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($OLIn.parameters/tns2:OL/tns2:ATTIVAZIONE/tns2:SEDE/tns2:CAP)&quot;>&#xa;                            &lt;xsl:if test=&quot;$OLIn.parameters/tns2:OL/tns2:ATTIVAZIONE/tns2:SEDE/tns2:CAP&quot;>&#xa;                                &lt;tns1:Cap>&#xa;                                    &lt;xsl:value-of select=&quot;$OLIn.parameters/tns2:OL/tns2:ATTIVAZIONE/tns2:SEDE/tns2:CAP&quot;/>&#xa;                                &lt;/tns1:Cap>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:ATTIVAZIONE/tns3:EMESSO/tns3:SEDE/tns3:CAP)&quot;>&#xa;                            &lt;xsl:if test=&quot;$OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:ATTIVAZIONE/tns3:EMESSO/tns3:SEDE/tns3:CAP&quot;>&#xa;                                &lt;tns1:Cap>&#xa;                                    &lt;xsl:value-of select=&quot;$OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:ATTIVAZIONE/tns3:EMESSO/tns3:SEDE/tns3:CAP&quot;/>&#xa;                                &lt;/tns1:Cap>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:ATTIVAZIONE/tns3:DESOSPESO/tns3:SEDE/tns3:CAP&quot;>&#xa;                                &lt;tns1:Cap>&#xa;                                    &lt;xsl:value-of select=&quot;$OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:ATTIVAZIONE/tns3:DESOSPESO/tns3:SEDE/tns3:CAP&quot;/>&#xa;                                &lt;/tns1:Cap>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($OLIn.parameters/tns2:OL/tns2:ATTIVAZIONE/tns2:DATICLIENTE/tns2:CF)&quot;>&#xa;                            &lt;xsl:if test=&quot;$OLIn.parameters/tns2:OL/tns2:ATTIVAZIONE/tns2:DATICLIENTE/tns2:CF&quot;>&#xa;                                &lt;tns1:Cf>&#xa;                                    &lt;xsl:value-of select=&quot;$OLIn.parameters/tns2:OL/tns2:ATTIVAZIONE/tns2:DATICLIENTE/tns2:CF&quot;/>&#xa;                                &lt;/tns1:Cf>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:ATTIVAZIONE/tns3:EMESSO/tns3:DATICLIENTE/tns3:CF&quot;>&#xa;                                &lt;tns1:Cf>&#xa;                                    &lt;xsl:value-of select=&quot;$OLIn.parameters/tns3:NotificaAttivazione_Cessazione/tns3:ATTIVAZ