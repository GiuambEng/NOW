            <bpws:receive createInstance="yes" name="Start"
                operation="Tracciamento"
                partnerLink="TracciamentoWSTIM2"
                portType="ns3:TracciamentoWSTIM2"
                tibex:xpdlId="b4f10bc2-2585-4808-96f9-e0c1d9d1f4c7" variable="OLIn">
                <bpws:sources>
                    <bpws:source linkName="StartToEnd">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$OLIn/parameters/tns:TracciamentoInput/tns:Azione = &quot;INSERT&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$OLIn.parameters/tns:Azione = "INSERT"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="StartToInvoke">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:receive>
            <bpws:reply name="End" operation="Tracciamento"
                partnerLink="TracciamentoWSTIM2"
                portType="ns3:TracciamentoWSTIM2"
                tibex:xpdlId="b454d0fa-e710-4e3e-bfd8-3318ae7ac798" variable="OLOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns1="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns2="http://www.tim.com/NOW/xsd/EONOWwhls" version="2.0"&gt;&lt;xsl:param name="InsertNoFile"/&gt;&lt;xsl:param name="EONW"/&gt;&lt;xsl:template name="OLOut-input" match="/"&gt;&lt;tns:TracciamentoResponse&gt;&lt;parameters&gt;&lt;tns1:TracciamentoOutput&gt;&lt;xsl:if test="$InsertNoFile/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE"&gt;&lt;tns1:IdEsecProcsoNoFile&gt;&lt;xsl:value-of select="$InsertNoFile/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/tns1:IdEsecProcsoNoFile&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InsertNoFile/part1/ns:Output/ns:Esito/ns:COD_PROCSO_NO_FILE"&gt;&lt;tns1:CodProcsoNoFile&gt;&lt;xsl:value-of select="$InsertNoFile/part1/ns:Output/ns:Esito/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/tns1:CodProcsoNoFile&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$EONW/tns2:IdEONW"&gt;&lt;tns1:IdEventoOrdineWhls&gt;&lt;xsl:value-of select="$EONW/tns2:IdEONW"/&gt;&lt;/tns1:IdEventoOrdineWhls&gt;&lt;/xsl:if&gt;&lt;/tns1:TracciamentoOutput&gt;&lt;/parameters&gt;&lt;/tns:TracciamentoResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertNoFile.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;EONW&quot;/>&#xa;    &lt;xsl:template name=&quot;OLOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:TracciamentoOutput>&#xa;            &lt;xsl:if test=&quot;$InsertNoFile.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                &lt;tns1:IdEsecProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$InsertNoFile.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                &lt;/tns1:IdEsecProcsoNoFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertNoFile.part1/ns:Esito/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                &lt;tns1:CodProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$InsertNoFile.part1/ns:Esito/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                &lt;/tns1:CodProcsoNoFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$EONW/tns2:IdEONW&quot;>&#xa;                &lt;tns1:IdEventoOrdineWhls>&#xa;                    &lt;xsl:value-of select=&quot;$EONW/tns2:IdEONW&quot;/>&#xa;                &lt;/tns1:IdEventoOrdineWhls>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:TracciamentoOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
