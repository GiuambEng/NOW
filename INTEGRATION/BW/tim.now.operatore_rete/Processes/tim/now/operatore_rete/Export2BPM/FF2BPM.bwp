&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/bx/2009/management/process" xmlns:pm="http://www.tibco.com/bx/2009/management/processManagerType" xmlns:Q1="http://www.tim.com/NOW/xsd/FF2BPM" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="BPMModuleName"/&gt;&lt;xsl:param name="BPMProcessName"/&gt;&lt;xsl:param name="BPMOperationName"/&gt;&lt;xsl:param name="IdRichiestaOLO_PN"/&gt;&lt;xsl:param name="DettaglioOrdine_PN"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="DettaglioOrdine"/&gt;&lt;xsl:param name="IdRisorsaFF_PN"/&gt;&lt;xsl:template name="Send2BPM-input" match="/"&gt;&lt;tns:createProcessInstanceRequest&gt;&lt;params&gt;&lt;pm:createProcessInstanceInput&gt;&lt;pm:processQName&gt;&lt;pm:moduleName&gt;&lt;xsl:value-of select="$BPMModuleName"/&gt;&lt;/pm:moduleName&gt;&lt;pm:processName&gt;&lt;xsl:value-of select="$BPMProcessName"/&gt;&lt;/pm:processName&gt;&lt;/pm:processQName&gt;&lt;pm:operationName&gt;&lt;xsl:value-of select="$BPMOperationName"/&gt;&lt;/pm:operationName&gt;&lt;pm:options/&gt;&lt;pm:parameterMap&gt;&lt;pm:parameter&gt;&lt;pm:name&gt;&lt;xsl:value-of select="$IdRichiestaOLO_PN"/&gt;&lt;/pm:name&gt;&lt;pm:value&gt;&lt;xsl:value-of select="$Start/Q1:IdRichiestaOlo"/&gt;&lt;/pm:value&gt;&lt;/pm:parameter&gt;&lt;pm:parameter&gt;&lt;pm:name&gt;&lt;xsl:value-of select="$DettaglioOrdine_PN"/&gt;&lt;/pm:name&gt;&lt;pm:value&gt;&lt;xsl:value-of select="tib:render-xml($DettaglioOrdine)"/&gt;&lt;/pm:value&gt;&lt;/pm:parameter&gt;&lt;xsl:if test="string-length($Start/Q1:IdRisorsaFF)&gt;0"&gt;&lt;pm:parameter&gt;&lt;pm:name&gt;&lt;xsl:value-of select="$IdRisorsaFF_PN"/&gt;&lt;/pm:name&gt;&lt;pm:value&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($Start/Q1:IdRisorsaFF)"&gt;&lt;xsl:value-of select="$Start/Q1:IdRisorsaFF"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/pm:value&gt;&lt;/pm:parameter&gt;&lt;/xsl:if&gt;&lt;/pm:parameterMap&gt;&lt;/pm:createProcessInstanceInput&gt;&lt;/params&gt;&lt;/tns:createProcessInstanceRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/bx/2009/management/process&quot; xmlns:pm=&quot;http://www.tibco.com/bx/2009/management/processManagerType&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/FF2BPM&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;BPMModuleName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMProcessName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMOperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOLO_PN&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioOrdine_PN&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRisorsaFF_PN&quot;/>&#xa;    &lt;xsl:template name=&quot;Send2BPM-input&quot; match=&quot;/&quot;>&#xa;        &lt;pm:createProcessInstanceInput>&#xa;            &lt;pm:processQName>&#xa;                &lt;pm:moduleName>&#xa;                    &lt;xsl:value-of select=&quot;$BPMModuleName&quot;/>&#xa;                &lt;/pm:moduleName>&#xa;                &lt;pm:processName>&#xa;                    &lt;xsl:value-of select=&quot;$BPMProcessName&quot;/>&#xa;                &lt;/pm:processName>&#xa;            &lt;/pm:processQName>&#xa;            &lt;pm:operationName>&#xa;                &lt;xsl:value-of select=&quot;$BPMOperationName&quot;/>&#xa;            &lt;/pm:operationName>&#xa;            &lt;pm:options/>&#xa;            &lt;pm:parameterMap>&#xa;                &lt;pm:parameter>&#xa;                    &lt;pm:name>&#xa;                        &lt;xsl:value-of select=&quot;$IdRichiestaOLO_PN&quot;/>&#xa;                    &lt;/pm:name>&#xa;                    &lt;pm:value>&#xa;                        &lt;xsl:value-of select=&quot;$Start/Q1:IdRichiestaOlo&quot;/>&#xa;                    &lt;/pm:value>&#xa;                &lt;/pm:parameter>&#xa;                &lt;pm:parameter>&#xa;                    &lt;pm:name>&#xa;                        &lt;xsl:value-of select=&quot;$DettaglioOrdine_PN&quot;/>&#xa;                    &lt;/pm:name>&#xa;                    &lt;pm:value>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($DettaglioOrdine)&quot;/>&#xa;                    &lt;/pm:value>&#xa;                &lt;/pm:parameter>&#xa;                &lt;xsl:if test=&quot;string-length($Start/Q1:IdRisorsaFF)>0&quot;>&#xa;                    &lt;pm:parameter>&#xa;                        &lt;pm:name>&#xa;                            &lt;xsl:value-of select=&quot;$IdRisorsaFF_PN&quot;/>&#xa;                        &lt;/pm:name>&#xa;                        &lt;pm:value>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/Q1:IdRisorsaFF)&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/Q1:IdRisorsaFF&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/pm:value>&#xa;                    &lt;/pm:parameter>&#xa;                &lt;/xsl:if>&#xa;            &lt;/pm:parameterMap>&#xa;        &lt;/pm:createProcessInstanceInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
