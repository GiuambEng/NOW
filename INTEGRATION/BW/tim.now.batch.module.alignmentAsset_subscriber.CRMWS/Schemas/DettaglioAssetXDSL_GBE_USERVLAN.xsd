						</simpleType>
					</element>
					<element name="PROTOCOLLOIPOA" minOccurs="0">
						<complexType>
							<sequence>
								<element name="IPDSLAM">
									<simpleType>
										<restriction base="string">
											<maxLength value="15" />
										</restriction>
									</simpleType>
								</element>
								<element name="IPKIT">
									<simpleType>
