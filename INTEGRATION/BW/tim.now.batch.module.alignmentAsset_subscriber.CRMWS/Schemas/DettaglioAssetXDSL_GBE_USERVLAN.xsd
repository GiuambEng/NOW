						<simpleType>
							<restriction base="string">
								<maxLength value="100"></maxLength>
							</restriction>
						</simpleType>
					</element>
					<element name="DATAESPLETAMENTO" type="string"
						maxOccurs="1" minOccurs="0">
					</element>
				</sequence>
