<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/DettaglioAssetXDSL_GBE_USERVLAN" xmlns:tns="http://www.example.org/DettaglioAssetXDSL_GBE_USERVLAN" elementFormDefault="qualified">

<element name="NEWGBE_Input">
<complexType>
