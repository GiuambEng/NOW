		<element name="IDRisorsa" type="string"></element>
		<element name="IDOfferta" type="string"></element>
		<element name="SERVIZIO" type="string"></element>
		<element name="Transaction_ID" type="string" maxOccurs="1" minOccurs="0"></element>
