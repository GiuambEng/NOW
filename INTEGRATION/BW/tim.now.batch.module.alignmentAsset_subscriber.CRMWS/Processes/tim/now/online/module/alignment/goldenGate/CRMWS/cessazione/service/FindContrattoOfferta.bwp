                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelectContratto&quot;/>&lt;xsl:param name=&quot;Contratto&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:findContrattoOfferta_Output>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Contratto,'.')&quot;>&lt;tns:ID_CONTRATTO>&lt;xsl:value-of select=&quot;substring-before($Contratto,'.')&quot;/>&lt;/tns:ID_CONTRATTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$SelectContratto/Record[1]/ID_CONTRATTO&quot;>&lt;tns:ID_CONTRATTO>&lt;xsl:value-of select=&quot;$SelectContratto/Record[1]/ID_CONTRATTO&quot;/>&lt;/tns:ID_CONTRATTO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:findContrattoOfferta_Output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="903de855-25aa-4423-b463-cf3736c8c823" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelectContratto&quot;/>&lt;xsl:param name=&quot;Contratto&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:findContrattoOfferta_Output>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Contratto,'.')&quot;>&lt;tns:ID_CONTRATTO>&lt;xsl:value-of select=&quot;substring-before($Contratto,'.')&quot;/>&lt;/tns:ID_CONTRATTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$SelectContratto/Record[1]/ID_CONTRATTO&quot;>&lt;tns:ID_CONTRATTO>&lt;xsl:value-of select=&quot;$SelectContratto/Record[1]/ID_CONTRATTO&quot;/>&lt;/tns:ID_CONTRATTO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:findContrattoOfferta_Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
