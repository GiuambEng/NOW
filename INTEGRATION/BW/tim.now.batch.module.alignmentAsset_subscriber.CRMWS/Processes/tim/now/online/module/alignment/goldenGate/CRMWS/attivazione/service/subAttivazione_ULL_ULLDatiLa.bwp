erwise>&#xa;                                &lt;xsl:if test=&quot;$ParseCRMWS/ns1:SERVIZIO/ns1:ULLLA/ns1:ATTIVAZIONE/ns1:SEDE/ns1:SIGLAPROVINCIA&quot;>&#xa;                                    &lt;siglaProvincia>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRMWS/ns1:SERVIZIO/ns1:ULLLA/ns1:ATTIVAZIONE/ns1:SEDE/ns1:SIGLAPROVINCIA&quot;/>&#xa;                                    &lt;/siglaProvincia>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseCRMWS/ns1:SERVIZIO/ns1:ULLLA/ns1:ATTIVAZIONE/ns1:DISTR_TELEFONICO)=2&quot;>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;tib:pad-front($ParseCRMWS/ns1:SERVIZIO/ns1:ULLLA/ns1:ATTIVAZIONE/ns1:DISTR_TELEFONICO, 3, '0')&quot;/>&#xa;                                &lt;/distretto>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseCRMWS/ns1:SERVIZIO/ns1:ULLLA/ns1:ATTIVAZIONE/ns1:DISTR_TELEFONICO)=3&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRMWS/ns1:SERVIZIO/ns1:ULLLA/ns1:ATTIVAZIONE/ns1:DISTR_TELEFONICO&quot;>&#xa;                                    &lt;distretto>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRMWS/ns1:SERVIZIO/ns1:ULLLA/ns1:ATTIVAZIONE/ns1:DISTR_TELEFONICO&quot;/>&#xa;                                    &lt;/distretto>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseCRMWS/ns1:SERVIZIO/ns1:ULLLA/ns1:ATTIVAZIONE/ns1:DISTR_TELEFONICO)=4&quot;>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;substring($ParseCRMWS/ns1:SERVIZIO/ns1:ULLLA/ns1:ATTIVAZIONE/ns1:DISTR_TELEFONICO,2,3)&quot;/>&#xa;                                &lt;/distretto>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$ParseCRMWS/ns1:SERVIZIO/ns1:ULLLA/ns1:ATTIVAZIONE/ns1:CLLI_CENTRALE&quot;>&#xa;                            &lt;CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRMWS/ns1:SERVIZIO/ns1:ULLLA/ns1:ATTIVAZIONE/ns1:CLLI_CENTRALE&quot;/>&#xa;                            &lt;/CLLI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CRMOrigine>&#xa;                            &lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&#xa;                        &lt;/CRMOrigine>&#xa;                        &lt;IDRisorsaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRMWS/ns1:SERVIZIO/ns1:ULLLA/ns1:ATTIVAZIONE/ns1:RISORSA&quot;/>&#xa;                        &lt;/IDRisorsaNOW>&#xa;                        &lt;IDOfferta>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:IdOfferta&quot;/>&#xa;                        &lt;/IDOfferta>&#xa;                        &lt;CRMEstrattore>&#xa;                            &lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&#xa;                        &lt;/CRMEstrattore>&#xa;                        &lt;cliente>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;              