&#xa;                            &lt;/DEC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/statoAsset&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:RISORSA&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/numeroTelefonico&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/numeroTelefonico&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:ID_CRMWS&quot;>&#xa;                            &lt;IDAssetCRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:ID_CRMWS&quot;/>&#xa;                            &lt;/IDAssetCRMWS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDAssetDa&quot;>&#xa;                            &lt;IDAssetDa>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDAssetDa&quot;/>&#xa;                            &lt;/IDAssetDa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DES>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:DEC&quot;/>&#xa;                        &lt;/DES>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;'FONIA'&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/RO&quot;>&#xa;                            &lt;RO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/RO&quot;/>&#xa;                            &lt;/RO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/offerta&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/lineaRiferimento&quot;>&#xa;                            &lt;lineaRiferimento>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/lineaRiferimento&quot;/>&#xa;                            &lt;/lineaRiferimento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;dettaglioasset>&#xa;                            &lt;xsl:copy-of select=&quot;$TipoServizio_01/ns:DettaglioAsset/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                            &lt;xsl:copy-of select=&quot;$TipoServizio_01/ns:DettaglioAsset/@*&quot;/>&#xa;                            &lt;xsl:copy-of select=&quot;$TipoServizio_01/ns:DettaglioAsset/node()&quot;/>&#xa;                        &lt;/dettaglioasset>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/DESPrimoOrdine&quot;>&#xa;                            &lt;DESPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/DESPrimoOrdine&quot;/>&#xa;                            &lt;/DESPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/comune&quot;>&#xa;                            &lt;comune>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/comune&quot;/>&#xa;                            &lt;/comune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:DISTR_TELEFONICO)=2&quot;>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;tib:pad-front($ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:DISTR_TELEFONICO, 3, '0')&quot;/>&#xa;                                &lt;/distretto>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:DISTR_TELEFONICO)=3&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:DISTR_TELEFONICO&quot;>&#xa;                                    &lt;distretto>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:DISTR_TELEFONICO&quot;/>&#xa;                                    &lt;/distretto>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:DISTR_TELEFONICO)=4&quot;>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;substring($ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:DISTR_TELEFONICO,2,3)&quot;/>&#xa;                                &lt;/distretto>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:CLLI_CENTRALE&quot;>&#xa;                            &lt;CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:CLLI_CENTRALE&quot;/>&#xa;                            &lt;/CLLI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CRMOrigine>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/CRMOrigine&quot;/>&#xa;                        &lt;/CRMOrigine>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/codiceSLAAssurance&quot;>&#xa;                            &lt;codiceSLAAssurance>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/codiceSLAAssurance&quot;/>&#xa;                            &lt;/codiceSLAAssurance>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDRisorsaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns4:SERVIZIO/ns4:SLULA/ns4:VARIAZIONE/ns4:RISORSA&quot;/>&#xa;                        &lt;/IDRisorsaNOW>&#xa;                        &lt;IDOfferta>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDOfferta&quot;/>&#xa;                        &lt;/IDOfferta>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/indirizzoEstesoNonCert&quot;>&#xa;                            &lt;indirizzoEstesoNonCert>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/indirizzoEstesoNonCert&quot;/>&#xa;                            &lt;/indirizzoEstesoNonCert>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/numeroFittizio&quot;>&#xa;                            &lt;numeroFittizio>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/numeroFittizio&quot;/>&#xa;                            &lt;/numeroFittizio>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns2:Asset>&#xa;                &lt;/tns2:Input>&#xa;            &lt;/tns2:Update>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
