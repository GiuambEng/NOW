IO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:DISTR_TELEFONICO"&gt;&lt;distretto&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:DISTR_TELEFONICO"/&gt;&lt;/distretto&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:DISTR_TELEFONICO)=4"&gt;&lt;distretto&gt;&lt;xsl:value-of select="substring($ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:DISTR_TELEFONICO,2,3)"/&gt;&lt;/distretto&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:CLLI_CENTRALE"&gt;&lt;CLLI&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:CLLI_CENTRALE"/&gt;&lt;/CLLI&gt;&lt;/xsl:if&gt;&lt;CRMOrigine&gt;&lt;xsl:value-of select="'CRMWS'"/&gt;&lt;/CRMOrigine&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:RISORSA"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDOfferta&gt;&lt;xsl:value-of select="$Start/ns2:IdOfferta"/&gt;&lt;/IDOfferta&gt;&lt;CRMEstrattore&gt;&lt;xsl:value-of select="'CRMWS'"/&gt;&lt;/CRMEstrattore&gt;&lt;cliente&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:CF"&gt;&lt;codiceFiscale&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:CF"/&gt;&lt;/codiceFiscale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:COGNOMERAGSOC"&gt;&lt;cognomeRagioneSociale&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:COGNOMERAGSOC"/&gt;&lt;/cognomeRagioneSociale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:NOME"&gt;&lt;nome&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:NOME"/&gt;&lt;/nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:PIVA"&gt;&lt;partitaIVA&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:PIVA"/&gt;&lt;/partitaIVA&gt;&lt;/xsl:if&gt;&lt;/cliente&gt;&lt;/tns:Asset&gt;&lt;/tns:Input&gt;&lt;/tns:Create&gt;&lt;/tns:Input&gt;&lt;/part1&gt;&lt;/ns:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns2=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns3=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeSLULA/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseCRM&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Toponomastica&quot;/>&#xa;    &lt;xsl:param name=&quot;caseModelVersion&quot;/>&#xa;    &lt;xsl:param name=&quot;caseType&quot;/>&#xa;    &lt;xsl:param name=&quot;Check1&quot;/>&#xa;    &lt;xsl:template name=&quot;CreateCase-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Create>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:caseType>&#xa;                        &lt;xsl:value-of select=&quot;$caseType&quot;/>&#xa;                    &lt;/tns:caseType>&#xa;                    &lt;tns:caseModelVersion>&#xa;                        &lt;xsl:value-of select=&quot;$caseModelVersion&quot;/>&#xa;                    &lt;/tns:caseModelVersion>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:CODICEORDINEOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:CODICE_ORDINE_TI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:CODICE_ORDINE_TI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:DESCOLO&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Check1/ns2:IdContrattoNOW))&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;'ATTIVO'&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:RISORSA&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:DN&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:DN&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:ID_CRMWS&quot;>&#xa;                            &lt;IDAssetCRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:ID_CRMWS&quot;/>&#xa;                            &lt;/IDAssetCRMWS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DES>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:DEC&quot;/>&#xa;                        &lt;/DES>&#xa;                        &lt;ORA_DES>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-time(&amp;quot;yyyy-MM-dd&amp;quot;,xsd:string($ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:DEC ))&quot;/>&#xa;                        &lt;/ORA_DES>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FONIA&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:NomeOffertaEsterna&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:SEDE/ns3:COMPLESSO&quot;>&#xa;                            &lt;complesso>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:SEDE/ns3:COMPLESSO&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:SEDE/ns3:INTERNO&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:SEDE/ns3:INTERNO&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:SEDE/ns3:PIANO&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:SEDE/ns3:PIANO&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:SEDE/ns3:SCALA&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:SEDE/ns3:SCALA&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;dettaglioasset>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                            &lt;integrationID>&#xa;                                &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                            &lt;/integrationID>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:RISORSA&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ACCESSOSLU&amp;quot;&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                            &lt;attributidettaglioasset>&#xa;                                &lt;IDAsset>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/IDAsset>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;nomeAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;IDSLUCO&amp;quot;&quot;/>&#xa;                                &lt;/nomeAttributo>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:IDSLUCO_NGOM)>0&quot;>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:IDSLUCO_NGOM&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:IDENTIFICATIVOSLU/ns3:IDSLUCO&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;tipologiaDato>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                &lt;/tipologiaDato>&#xa;                                &lt;IDDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDDettaglioAsset>&#xa;                            &lt;/attributidettaglioasset>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($ParseCRM/ns3:SERVIZIO/ns3:SLULA/ns3:ATTIVAZIONE/ns3:IDENTIFICATIVOSLU/ns3:IDARLOLO)>0&quot;>&#xa;                                    &lt;attributidettaglioasset>&#xa;                                        &lt;IDAsset>&#xa;                                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                        &lt;/IDAsset>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;IDARLOLO&amp;quot;&quot;/>&#xa;          