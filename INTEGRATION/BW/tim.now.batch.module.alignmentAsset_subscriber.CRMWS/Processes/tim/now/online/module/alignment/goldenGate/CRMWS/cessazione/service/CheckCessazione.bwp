            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE" name="EndLog-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:jdbcQueryActivityInput"
            name="SelectOGG-input" sca-bpel:internal="true"/>
