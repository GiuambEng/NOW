select="operatore"/&gt;&lt;/operatore&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;nomeComponente&gt;&lt;xsl:value-of select="nomeComponente"/&gt;&lt;/nomeComponente&gt;&lt;xsl:for-each select="attributidettaglioasset"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="nomeAttributo"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="valoreAttributo"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="tipologiaDato"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="statoDettaglioAsset"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="progressivo"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$Mapper/tns2:Update/tns2:Input/tns2:Asset/DESPrimoOrdine"&gt;&lt;DESPrimoOrdine&gt;&lt;xsl:value-of select="$Mapper/tns2:Update/tns2:Input/tns2:Asset/DESPrimoOrdine"/&gt;&lt;/DESPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns2:Update/tns2:Input/tns2:Asset/CAP"&gt;&lt;CAP&gt;&lt;xsl:value-of select="$Mapper/tns2:Update/tns2:Input/tns2:Asset/CAP"/&gt;&lt;/CAP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns2:Update/tns2:Input/tns2:Asset/codiceISTATComune"&gt;&lt;codiceISTATComune&gt;&lt;xsl:value-of select="$Mapper/t