                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2eada13f-1a94-40ac-a453-91ae73b05075+input&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeVLANGBE/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseCRM&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;Record>&lt;COD_VLAN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseCRM/ns:SERVIZIO/ns:VLANGBE/ns:VARIAZIONE/ns:RISORSA)&quot;>&lt;xsl:value-of select=&quot;$ParseCRM/ns:SERVIZIO/ns:VLANGBE/ns:VARIAZIONE/ns:RISORSA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_VLAN>&lt;CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseCRM/ns:SERVIZIO/ns:VLANGBE/ns:VARIAZIONE/ns:SUBCONTRACTOR[$index]/ns:CODOLOSUB)&quot;>&lt;xsl:value-of select=&quot;$ParseCRM/ns:SERVIZIO/ns:VLANGBE/ns:VARIAZIONE/ns:SUBCONTRACTOR[$index]/ns:CODOLOSUB&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODFC_OLO_AGCOM>&lt;ID_OLO_TITOLARE_VLAN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery1/Record[1]/ID_OLO_VLAN)&quot;>&lt;xsl:value-of select=&quot;$JDBCQuery1/Record[1]/ID_OLO_VLAN&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_OLO_TITOLARE_VLAN>&lt;ID_OLO_VLAN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery/Record[1]/NEXTVAL)&quot;>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/NEXTVAL&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_OLO_VLAN>&lt;STATO>&lt;xsl:value-of select=&quot;'ACTIVE'&quot;/>&lt;/STATO>&lt;/Record>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
