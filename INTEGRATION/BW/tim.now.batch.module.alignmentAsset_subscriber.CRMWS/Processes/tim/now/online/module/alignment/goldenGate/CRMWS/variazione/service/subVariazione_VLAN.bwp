                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns2=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeVLANGBE/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseCRM&quot;/>&lt;xsl:param name=&quot;FindContrattoOfferta&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns2:Input>&lt;tns2:Update>&lt;tns2:Input>&lt;tns2:CaseReference>&lt;xsl:value-of select=&quot;$Start/ns2:CaseReference&quot;/>&lt;/tns2:CaseReference>&lt;tns2:Asset>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDAsset&quot;>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDAsset&quot;/>&lt;/IDAsset>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$ParseCRM/ns:SERVIZIO/ns:VLANGBE/ns:VARIAZIONE/ns:CODICEORDINEOLO&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;$ParseCRM/ns:SERVIZIO/ns:VLANGBE/ns:VARIAZIONE/ns:CODICE_ORDINE_TI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;$ParseCRM/ns:SERVIZIO/ns:VLANGBE/ns:VARIAZIONE/ns:CODICE_ORDINE_TI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/invariante&quot;>&lt;invariante>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/invariante&quot;/>&lt;/invariante>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/operatore&quot;/>&lt;/operatore>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDRichiestaOLO&quot;>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDPrimoOrdine&quot;>&lt;IDPrimoOrdine>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDPrimoOrdine&quot;/>&lt;/IDPrimoOrdine>&lt;/xsl:if>&lt;IDContratto>&lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($FindContrattoOfferta/ns2:ID_CONTRATTO))&quot;/>&lt;/IDContratto>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/DEC&quot;>&lt;DEC>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/DEC&quot;/>&lt;/DEC>&lt;/xsl:if>&lt;statoAsset>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/statoAsset&quot;/>&lt;/statoAsset>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$ParseCRM/ns:SERVIZIO/ns:VLANGBE/ns:VARIAZIONE/ns:RISORSA&quot;/>&lt;/IDRisorsa>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ParseCRM/ns:SERVIZIO/ns:VLANGBE/ns:VARIAZIONE/ns:ID_CRMWS)>0&quot;>&lt;xsl:if test=&quot;$ParseCRM/ns:SERVIZIO/ns:VLANGBE/ns:VARIAZIONE/ns:ID_CRMWS&quot;>&lt;IDAssetCRMWS>&lt;xsl:value-of select=&quot;$ParseCRM/ns:SERVIZIO/ns:VLANGBE/ns:VARIAZIONE/ns:ID_CRMWS&quot;/>&lt;/IDAssetCRMWS>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDAssetCRMWS&quot;>&lt;IDAssetCRMWS>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDAssetCRMWS&quot;/>&lt;/IDAssetCRMWS>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDAssetDa&quot;>&lt;IDAssetDa>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDAssetDa&quot;/>&lt;/IDAssetDa>&lt;/xsl:if>&lt;DES>&lt;xsl:value-of select=&quot;$ParseCRM/ns:SERVIZIO/ns:VLANGBE/ns:VARIAZIONE/ns:DEC&quot;/>&lt;/DES>&lt;tipologiaAccesso>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/tipologiaAccesso&quot;/>&lt;/tipologiaAccesso>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/RO&quot;>&lt;RO>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/RO&quot;/>&lt;/RO>&lt;/xsl:if>&lt;offerta>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/offerta&quot;/>&lt;/offerta>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/lineaRiferimento&quot;>&lt;lineaRiferimento>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/lineaRiferimento&quot;/>&lt;/lineaRiferimento>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/complesso&quot;>&lt;complesso>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/complesso&quot;/>&lt;/complesso>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/interno&quot;>&lt;interno>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/interno&quot;/>&lt;/interno>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/piano&quot;>&lt;piano>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/piano&quot;/>&lt;/piano>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/scala&quot;>&lt;scala>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/scala&quot;/>&lt;/scala>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/ns2:Asset_Now/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]&quot;>&lt;dettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&lt;IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&lt;/IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&lt;IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&lt;/IDDettaglioAssetRoot>&lt;/xsl:if>&lt;integrationID>&lt;xsl:value-of select=&quot;integrationID&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;nomeComponente&quot;/>&lt;/nomeComponente>&lt;xsl:if test=&qu