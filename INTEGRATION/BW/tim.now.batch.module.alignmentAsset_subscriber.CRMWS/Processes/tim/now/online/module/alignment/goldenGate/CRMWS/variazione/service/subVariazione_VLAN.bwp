                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.maxNumber&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeVLANNGA/&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeVLANGBE/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseCRM&quot;/>&lt;xsl:template name=&quot;Check_Dati&quot; match=&quot;/&quot;>&lt;tns:Check_Dati>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ParseCRM/ns1:SERVIZIO/ns1:VLANGBE/ns1:VARIAZIONE/ns1:CODICECLLI)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns1:SERVIZIO/ns1:VLANGBE/ns1:VARIAZIONE/ns1:CODICEORDINEOLO)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns1:SERVIZIO/ns1:VLANGBE/ns1:VARIAZIONE/ns1:CODICE_ORDINE_TI)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns1:SERVIZIO/ns1:VLANGBE/ns1:VARIAZIONE/ns1:CONTRATTO)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns1:SERVIZIO/ns1:VLANGBE/ns1:VARIAZIONE/ns1:RISORSA)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($ParseCRM/ns1:SERVIZIO/ns1:VLANGBE/ns1:VARIAZIONE/ns1:DEC))=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns1:SERVIZIO/ns1:VLANGBE/ns1:SERVIZIO)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Check>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Check>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Check_Dati>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
