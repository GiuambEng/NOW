hen&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/comune"&gt;&lt;comune&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/comune"/&gt;&lt;/comune&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$ParseCRM/ns4:SERVIZIO/ns4:SHA/ns4:ATT_VAR_ACCESSO/ns4:SEDE/ns4:PARTICELLATOPONOMASTICA"&gt;&lt;descrPartToponomastica&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:SHA/ns4:ATT_VAR_ACCESSO/ns4:SEDE/ns4:PARTICELLATOPONOMASTICA"/&gt;&lt;/descrPartToponomastica&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$ParseCRM/ns4:SERVIZIO/ns4:SHA/ns4:ATT_VAR_ACCESSO/ns4:SEDE/ns4:VIA"&gt;&lt;descrizioneVia&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:SHA/ns4:ATT_VAR_ACCESSO/ns4:SEDE/ns4:VIA"/&gt;&lt;/descrizioneVia&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$ParseCRM/ns4:SERVIZIO/ns4:SHA/ns4:ATT_VAR_ACCESSO/ns4:SEDE/ns4:LOCALITA"&gt;&lt;localita&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:SHA/ns4:ATT_VAR_ACCESSO/ns4:SEDE/ns4:LOCALITA"/&gt;&lt;/localita&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$ParseCRM/ns4:SERVIZIO/ns4:SHA/ns4:ATT_VAR_ACCESSO/ns4:SEDE/ns4:CIVICO"&gt;&lt;numeroCivico&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:SHA/ns4:ATT_VAR_ACCESSO/ns4:SEDE/ns4:CIVICO"/&gt;&lt;/numeroCivico&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$ParseCRM/ns4:SERVIZIO/ns4:SHA/ns4:ATT