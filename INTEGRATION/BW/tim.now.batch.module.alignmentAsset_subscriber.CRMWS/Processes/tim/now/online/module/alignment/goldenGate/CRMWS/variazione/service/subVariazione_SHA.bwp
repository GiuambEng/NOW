                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsisstenze.DettaglioAsset.xsd&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns2=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:ns4=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeSHA/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseCRM&quot;/>&lt;xsl:param name=&quot;Dettaglio&quot;/>&lt;xsl:param name=&quot;QueryNumeCivico&quot;/>&lt;xsl:param name=&quot;FindContrattoOfferta&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns2:Input>&lt;tns2:Update>&lt;tns2:Input>&lt;tns2:CaseReference>&lt;xsl:value-of select=&quot;$Start/ns2:CaseReference&quot;/>&lt;/tns2:CaseReference>&lt;tns2:Asset>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDAsset&quot;>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDAsset&quot;/>&lt;/IDAsset>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$ParseCRM/ns4:SERVIZIO/ns4:SHA/ns4:ATT_VAR_ACCESSO/ns4:CODICEORDINEOLO&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;$ParseCRM/ns4:SERVIZIO/ns4:SHA/ns4:ATT_VAR_ACCESSO/ns4:CODICE_ORDINE_TI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;$ParseCRM/ns4:SERVIZIO/ns4:SHA/ns4:ATT_VAR_ACCESSO/ns4:CODICE_ORDINE_TI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/invariante&quot;>&lt;invariante>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/invariante&quot;/>&lt;/invariante>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;$Start/