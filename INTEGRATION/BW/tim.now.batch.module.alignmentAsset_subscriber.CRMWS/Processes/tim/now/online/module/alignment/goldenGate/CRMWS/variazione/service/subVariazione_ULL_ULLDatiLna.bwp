&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/CRMEstrattore"&gt;&lt;CRMEstrattore&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/CRMEstrattore"/&gt;&lt;/CRMEstrattore&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/IDRichiestaOLD"&gt;&lt;IDRichiestaOLD&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDRichiestaOLD"/&gt;&lt;/IDRichiestaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($Start/ns2:Asset_Now/cliente)"&gt;&lt;cliente&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/cliente/IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/cliente/created"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CLIENTE/ns3:CF"&gt;&lt;codiceFiscale&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CLIENTE/ns3:CF"/&gt;&lt;/codiceFiscale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CLIENTE/ns3:COGNOMERAGIONESOCIALE"&gt;&lt;cognomeRagioneSociale&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CLIENTE/ns3:COGNOMERAGIONESOCIALE"/&gt;&lt;/cognomeRagioneSociale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CLIENTE/ns3:NOME"&gt;&lt;nome&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CLIENTE/ns3:NOME"/&gt;&lt;/nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CLIENTE/ns3:PIVA"&gt;&lt;partitaIVA&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CLIENTE/ns3:PIVA"/&gt;&lt;/partitaIVA&gt;&lt;/xsl:if&gt;&lt;/cliente&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/LNA_LA"&gt;&lt;LNA_LA&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/LNA_LA"/&gt;&lt;/LNA_LA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/modalitaFatturazione"&gt;&lt;modalitaFatturazione&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/modalitaFatturazione"/&gt;&lt;/modalitaFatturazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/IDRisorsaOLD"&gt;&lt;IDRisorsaOLD&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDRisorsaOLD"/&gt;&lt;/IDRisorsaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/IDRisorsaCorrelato"&gt;&lt;IDRisorsaCorrelato&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDRisorsaCorrelato"/&gt;&lt;/IDRisorsaCorrelato&gt;&lt;/xsl:if&gt;&lt;/tns2:Asset&gt;&lt;/tns2:Input&gt;&lt;/tns2:Update&gt;&lt;/tns2:Input&gt;&lt;/part1&gt;&lt;/ns1:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsisstenze.DettaglioAsset.xsd&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:ns2=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:ns3=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeULLLNA/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseCRM&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryNumeCivico&quot;/>&#xa;    &lt;xsl:param name=&quot;Dettaglio&quot;/>&#xa;    &lt;xsl:param name=&quot;FindContrattoOfferta&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateCaseData-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;tns2:Update>&#xa;                &lt;tns2:Input>&#xa;                    &lt;tns2:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns2:CaseReference&quot;/>&#xa;                    &lt;/tns2:CaseReference>&#xa;                    &lt;tns2:Asset>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CODICEORDINEOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CODICE_ORDINE_TI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CODICE_ORDINE_TI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/invariante&quot;>&#xa;                            &lt;invariante>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/invariante&quot;/>&#xa;                            &lt;/invariante>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDPrimoOrdine&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDPrimoOrdine&quot;/>&#xa;                            &lt;/IDPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($FindContrattoOfferta/ns2:ID_CONTRATTO))&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/DEC&quot;>&#xa;                            &lt;DEC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/DEC&quot;/>&#xa;                            &lt;/DEC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/statoAsset&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:RISORSA&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/numeroTelefonico&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/numeroTelefonico&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:ID_CRMWS)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:ID_CRMWS&quot;>&#xa;                                    &lt;IDAssetCRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:ID_CRMWS&quot;/>&#xa;                                    &lt;/IDAssetCRMWS>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDAssetCRMWS&quot;>&#xa;                                    &lt;IDAssetCRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDAssetCRMWS&quot;/>&#xa;                                    &lt;/IDAssetCRMWS>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDAssetDa&quot;>&#xa;                            &lt;IDAssetDa>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDAssetDa&quot;/>&#xa;                            &lt;/IDAssetDa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DES>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DEC&quot;/>&#xa;                        &lt;/DES>&#xa;                        &lt;ORA_DES>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-time(&amp;quot;yyyy-MM-dd&amp;quot;,xsd:string($ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DEC ))&quot;/>&#xa;                        &lt;/ORA_DES>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/tipologiaAccesso&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/RO&quot;>&#xa;                            &lt;RO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/RO&quot;/>&#xa;                            &lt;/RO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/offerta&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/lineaRiferimento&quot;>&#xa;                            &lt;lineaRiferimento>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/lineaRiferimento&quot;/>&#xa;                            &lt;/lineaRiferimento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:COMPLESSO&quot;>&#xa;                            &lt;complesso>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:COMPLESSO&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:INTERNO&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:INTERNO&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:PIANO&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:PIANO&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:SCALA&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:SCALA&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Dettaglio/ns:DettaglioAsset&quot;>&#xa;                            &lt;dettaglioasset>&#xa;                                &lt;IDAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                &lt;/IDAsset>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                                    &lt;IDDettaglioAssetParent>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                                    &lt;/IDDettaglioAssetParent>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                                    &lt;IDDettaglioAssetRoot>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                                    &lt;/IDDettaglioAssetRoot>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;integrationID>&#xa;                                    &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                &lt;/integrationID>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                                &lt;nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                &lt;/nomeComponente>&#xa;                                &lt;xsl:for-each select=&quot;attributidettaglioasset&quot;>&#xa;                                    &lt;attributidettaglioasset>&#xa;                                        &lt;IDAsset>&#xa;                                            &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                        &lt;/IDAsset>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                        &lt;IDDettaglioAsset>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                        &lt;/IDDettaglioAsset>&#xa;                                    &lt;/attributidettaglioasset>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;IDRisorsaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                &lt;/IDRisorsaNOW>&#xa;                                &lt;IDDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                &lt;/IDDettaglioAsset>&#xa;                                &lt;statoDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                                &lt;/statoDettaglioAsset>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioasset>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/DESPrimoOrdine&quot;>&#xa;                            &lt;DESPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/DESPrimoOrdine&quot;/>&#xa;                            &lt;/DESPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:CAP&quot;>&#xa;                                    &lt;CAP>&#xa;    