            <bpws:invoke inputVariable="UpdateCase-input"
                name="UpdateCase" operation="Invoke"
                outputVariable="UpdateCase" partnerLink="FindUpdateCase"
                portType="ns5:FindUpdateCase" tibex:xpdlId="32c62be6-63b1-4eeb-848f-354f4686b151">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns1="http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/" xmlns:tns="http://www.tim.com/NOW/xsd/FindUpdateCase/" xmlns:ns="www.tim.now.dinamicprocess.allineamentoOggAsset" xmlns:ns2="http://www.tim.now.WLR_CorrelationProcess" xmlns:ns3="http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeXDSLATM/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="Correlazione"/&gt;&lt;xsl:param name="ParseCRM"/&gt;&lt;xsl:template name="UpdateCase-input" match="/"&gt;&lt;ns1:Request&gt;&lt;part1&gt;&lt;tns:Input&gt;&lt;tns:Update&gt;&lt;tns:Input&gt;&lt;tns:CaseReference&gt;&lt;xsl:value-of select="$Start/ns:CaseReference"/&gt;&lt;/tns:CaseReference&gt;&lt;tns:Asset&gt;&lt;xsl:if test="$Start/ns:Asset_Now/IDAsset"&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDAsset"/&gt;&lt;/IDAsset&gt;&lt;/xsl:if&gt;&lt;codiceOrdineOLO&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:CODICEORDINEOLO"/&gt;&lt;/codiceOrdineOLO&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:CODICE_ORDINE_TI"&gt;&lt;codiceOrdineTI&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:CODICE_ORDINE_TI"/&gt;&lt;/codiceOrdineTI&gt;&lt;/xsl:if&gt;&lt;codificaOLOAGCOM&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/codificaOLOAGCOM"/&gt;&lt;/codificaOLOAGCOM&gt;&lt;xsl:if test="$Start/ns:Asset_Now/invariante"&gt;&lt;invariante&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/invariante"/&gt;&lt;/invariante&gt;&lt;/xsl:if&gt;&lt;created&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/created"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/operatore"/&gt;&lt;/operatore&gt;&lt;xsl:if test="$Start/ns:Asset_Now/IDPrimoOrdine"&gt;&lt;IDPrimoOrdine&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDPrimoOrdine"/&gt;&lt;/IDPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;IDContratto&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDContratto"/&gt;&lt;/IDContratto&gt;&lt;xsl:if test="$Start/ns:Asset_Now/DEC"&gt;&lt;DEC&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/DEC"/&gt;&lt;/DEC&gt;&lt;/xsl:if&gt;&lt;statoAsset&gt;&lt;xsl:value-of select="'CESSATO'"/&gt;&lt;/statoAsset&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;xsl:if test="$Start/ns:Asset_Now/numeroTelefonico"&gt;&lt;numeroTelefonico&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/numeroTelefonico"/&gt;&lt;/numeroTelefonico&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:ID_CRMWS)&gt;0"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:ID_CRMWS"&gt;&lt;IDAssetCRMWS&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:ID_CRMWS"/&gt;&lt;/IDAssetCRMWS&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$Start/ns:Asset_Now/IDAssetCRMWS"&gt;&lt;IDAssetCRMWS&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDAssetCRMWS"/&gt;&lt;/IDAssetCRMWS&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$Start/ns:Asset_Now/IDAssetDa"&gt;&lt;IDAssetDa&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDAssetDa"/&gt;&lt;/IDAssetDa&gt;&lt;/xsl:if&gt;&lt;DES&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:DEC"/&gt;&lt;/DES&gt;&lt;ORA_DES&gt;&lt;xsl:value-of select="tib:parse-time(&amp;quot;yyyy-MM-dd&amp;quot;,xsd:string($ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:DEC ))"/&gt;&lt;/ORA_DES&gt;&lt;tipologiaAccesso&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/tipologiaAccesso"/&gt;&lt;/tipologiaAccesso&gt;&lt;xsl:if test="$Start/ns:Asset_Now/RO"&gt;&lt;RO&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/RO"/&gt;&lt;/RO&gt;&lt;/xsl:if&gt;&lt;offerta&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/offerta"/&gt;&lt;/offerta&gt;&lt;xsl:if test="$Start/ns:Asset_Now/lineaRiferimento"&gt;&lt;lineaRiferimento&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/lineaRiferimento"/&gt;&lt;/lineaRiferimento&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/complesso"&gt;&lt;complesso&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/complesso"/&gt;&lt;/complesso&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/interno"&gt;&lt;interno&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/interno"/&gt;&lt;/interno&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/piano"&gt;&lt;piano&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/piano"/&gt;&lt;/piano&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/scala"&gt;&lt;scala&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/scala"/&gt;&lt;/scala&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="$Start/ns:Asset_Now/dettaglioasset"&gt;&lt;dettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;xsl:if test="IDDettaglioAssetParent"&gt;&lt;IDDettaglioAssetParent&gt;&lt;xsl:value-of select="IDDettaglioAssetParent"/&gt;&lt;/IDDettaglioAssetParent&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDDettaglioAssetRoot"&gt;&lt;IDDettaglioAssetRoot&gt;&lt;xsl:value-of select="IDDettaglioAssetRoot"/&gt;&lt;/IDDettaglioAssetRoot&gt;&lt;/xsl:if&gt;&lt;integrationID&gt;&lt;xsl:value-of select="integrationID"/&gt;&lt;/integrationID&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;nomeComponente&gt;&lt;xsl:value-of select="nomeComponente"/&gt;&lt;/nomeComponente&gt;&lt;xsl:for-each select="attributidettaglioasset"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="nomeAttributo"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="valoreAttributo"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="tipologiaDato"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="&amp;quot;CESSATO&amp;quot;"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="progressivo"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$Start/ns:Asset_Now/DESPrimoOrdine"&gt;&lt;DESPrimoOrdine&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/DESPrimoOrdine"/&gt;&lt;/DESPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/CAP"&gt;&lt;CAP&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/CAP"/&gt;&lt;/CAP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/codiceISTATComune"&gt;&lt;codiceISTATComune&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/codiceISTATComune"/&gt;&lt;/codiceISTATComune&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/codiceISTATProvincia"&gt;&lt;codiceISTATProvincia&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/codiceISTATProvincia"/&gt;&lt;/codiceISTATProvincia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/codiceToponomastica"&gt;&lt;codiceToponomastica&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/codiceToponomastica"/&gt;&lt;/codiceToponomastica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/comune"&gt;&lt;comune&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/comune"/&gt;&lt;/comune&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/descrPartToponomastica"&gt;&lt;descrPartToponomastica&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/descrPartToponomastica"/&gt;&lt;/descrPartToponomastica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/descrizioneVia"&gt;&lt;descrizioneVia&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/descrizioneVia"/&gt;&lt;/descrizioneVia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/localita"&gt;&lt;localita&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/localita"/&gt;&lt;/localita&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/numeroCivico"&gt;&lt;numeroCivico&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/numeroCivico"/&gt;&lt;/numeroCivico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/provincia"&gt;&lt;provincia&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/provincia"/&gt;&lt;/provincia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/siglaProvincia"&gt;&lt;siglaProvincia&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/siglaProvincia"/&gt;&lt;/siglaProvincia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/distretto"&gt;&lt;distretto&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/distretto"/&gt;&lt;/distretto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/CLLI"&gt;&lt;CLLI&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/CLLI"/&gt;&lt;/CLLI&gt;&lt;/xsl:if&gt;&lt;CRMOrigine&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/CRMOrigine"/&gt;&lt;/CRMOrigine&gt;&lt;xsl:if test="$Start/ns:Asset_Now/codiceSLAAssurance"&gt;&lt;codiceSLAAssurance&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/codiceSLAAssurance"/&gt;&lt;/codiceSLAAssurance&gt;&lt;/xsl:if&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDOfferta&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDOfferta"/&gt;&lt;/IDOfferta&gt;&lt;xsl:if test="$Start/ns:Asset_Now/indirizzoEstesoNonCert"&gt;&lt;indirizzoEstesoNonCert&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/indirizzoEstesoNonCert"/&gt;&lt;/indirizzoEstesoNonCert&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/numeroFittizio"&gt;&lt;numeroFittizio&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/numeroFittizio"/&gt;&lt;/numeroFittizio&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/codificaOLOAGCOMDonating"&gt;&lt;codificaOLOAGCOMDonating&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/codificaOLOAGCOMDonating"/&gt;&lt;/codificaOLOAGCOMDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/codificaOLOAGCOMDonor"&gt;&lt;codificaOLOAGCOMDonor&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/codificaOLOAGCOMDonor"/&gt;&lt;/codificaOLOAGCOMDonor&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/codificaOLONOWDonating"&gt;&lt;codificaOLONOWDonating&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/codificaOLONOWDonating"/&gt;&lt;/codificaOLONOWDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/codificaOLONOWDonor"&gt;&lt;codificaOLONOWDonor&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/codificaOLONOWDonor"/&gt;&lt;/codificaOLONOWDonor&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/tipologiaScenario"&gt;&lt;tipologiaScenario&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/tipologiaScenario"/&gt;&lt;/tipologiaScenario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/totaleOrdinePacchetto"&gt;&lt;totaleOrdinePacchetto&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/totaleOrdinePacchetto"/&gt;&lt;/totaleOrdinePacchetto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/IDCorrelazione"&gt;&lt;IDCorrelazione&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDCorrelazione"/&gt;&lt;/IDCorrelazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/numTelPrincipale"&gt;&lt;numTelPrincipale&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/numTelPrincipale"/&gt;&lt;/numTelPrincipale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/codiceFatturazioneJPUB"&gt;&lt;codiceFatturazioneJPUB&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/codiceFatturazioneJPUB"/&gt;&lt;/codiceFatturazioneJPUB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/CRMEstrattore"&gt;&lt;CRMEstrattore&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/CRMEstrattore"/&gt;&lt;/CRMEstrattore&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/IDRichiestaOLD"&gt;&lt;IDRichiestaOLD&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDRichiestaOLD"/&gt;&lt;/IDRichiestaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($Start/ns:Asset_Now/cliente)"&gt;&lt;cliente&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/cliente/IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/cliente/created"/&gt;&lt;/created&gt;&lt;xsl:if test="$Start/ns:Asset_Now/cliente/lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/cliente/lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/cliente/codiceFiscale"&gt;&lt;codiceFiscale&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/cliente/codiceFiscale"/&gt;&lt;/codiceFiscale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/cliente/cognomeRagioneSociale"&gt;&lt;cognomeRagioneSociale&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/cliente/cognomeRagioneSociale"/&gt;&lt;/cognomeRagioneSociale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/cliente/nome"&gt;&lt;nome&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/cliente/nome"/&gt;&lt;/nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/cliente/partitaIVA"&gt;&lt;partitaIVA&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/cliente/partitaIVA"/&gt;&lt;/partitaIVA&gt;&lt;/xsl:if&gt;&lt;/cliente&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/LNA_LA"&gt;&lt;LNA_LA&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/LNA_LA"/&gt;&lt;/LNA_LA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/modalitaFatturazione"&gt;&lt;modalitaFatturazione&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/modalitaFatturazione"/&gt;&lt;/modalitaFatturazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/IDRisorsaOLD"&gt;&lt;IDRisorsaOLD&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDRisorsaOLD"/&gt;&lt;/IDRisorsaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Correlazione/ns2:Output_Correlazione='Y'"&gt;&lt;xsl:if test="$Correlazione/ns2:IdRisosaCorrelazione"&gt;&lt;IDRisorsaCorrelato&gt;&lt;xsl:value-of select="$Correlazione/ns2:IdRisosaCorrelazione"/&gt;&lt;/IDRisorsaCorrelato&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$Start/ns:Asset_Now/IDRisorsaCorrelato"&gt;&lt;IDRisorsaCorrelato&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDRisorsaCorrelato"/&gt;&lt;/IDRisorsaCorrelato&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns:Asset&gt;&lt;/tns:Input&gt;&lt;/tns:Update&gt;&lt;/tns:Input&gt;&lt;/part1&gt;&lt;/ns1:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:ns2=&quot;http://www.tim.now.WLR_CorrelationProcess&quot; xmlns:ns3=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeXDSLATM/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Correlazione&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseCRM&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateCase-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Update>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:CaseReference&quot;/>&#xa;                    &lt;/tns:CaseReference>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:CODICEORDINEOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:CODICE_ORDINE_TI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:CODICE_ORDINE_TI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/invariante&quot;>&#xa;                            &lt;invariante>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/invariante&quot;/>&#xa;                            &lt;/invariante>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDPrimoOrdine&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDPrimoOrdine&quot;/>&#xa;                            &lt;/IDPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDContratto&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/DEC&quot;>&#xa;                            &lt;DEC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/DEC&quot;/>&#xa;                            &lt;/DEC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;'CESSATO'&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/numeroTelefonico&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/numeroTelefonico&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:ID_CRMWS)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:ID_CRMWS&quot;>&#xa;                                    &lt;IDAssetCRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:ID_CRMWS&quot;/>&#xa;                                    &lt;/IDAssetCRMWS>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDAssetCRMWS&quot;>&#xa;                                    &lt;IDAssetCRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDAssetCRMWS&quot;/>&#xa;                                    &lt;/IDAssetCRMWS>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDAssetDa&quot;>&#xa;                            &lt;IDAssetDa>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDAssetDa&quot;/>&#xa;                            &lt;/IDAssetDa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DES>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:DEC&quot;/>&#xa;                        &lt;/DES>&#xa;                        &lt;ORA_DES>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-time(&amp;quot;yyyy-MM-dd&amp;quot;,xsd:string($ParseCRM/ns3:SERVIZIO/ns3:CESSAZIONE/ns3:DEC ))&quot;/>&#xa;                        &lt;/ORA_DES>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/tipologiaAccesso&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/RO&quot;>&#xa;                            &lt;RO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/RO&quot;/>&#xa;                            &lt;/RO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/offerta&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/lineaRiferimento&quot;>&#xa;                            &lt;lineaRiferimento>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/lineaRiferimento&quot;/>&#xa;                            &lt;/lineaRiferimento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/complesso&quot;>&#xa;                            &lt;complesso>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/complesso&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/interno&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/interno&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/piano&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/piano&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/scala&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/scala&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Start/ns:Asset_Now/dettaglioasset&quot;>&#xa;                            &lt;dettaglioasset>&#xa;                                &lt;IDAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                &lt;/IDAsset>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                                    &lt;IDDettaglioAssetParent>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                                    &lt;/IDDettaglioAssetParent>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                                    &lt;IDDettaglioAssetRoot>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                                    &lt;/IDDettaglioAssetRoot>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;integrationID>&#xa;                                    &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                &lt;/integrationID>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                                &lt;nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                &lt;/nomeComponente>&#xa;                                &lt;xsl:for-each select=&quot;attributidettaglioasset&quot;>&#xa;                                    &lt;attributidettaglioasset>&#xa;                                        &lt;IDAsset>&#xa;                                            &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                        &lt;/IDAsset>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                        &lt;IDDettaglioAsset>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                        &lt;/IDDettaglioAsset>&#xa;                                    &lt;/attributidettaglioasset>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;IDRisorsaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                &lt;/IDRisorsaNOW>&#xa;                                &lt;IDDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                &lt;/IDDettaglioAsset>&#xa;                                &lt;statoDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;CESSATO&amp;quot;&quot;/>&#xa;                                &lt;/statoDettaglioAsset>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioasset>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/DESPrimoOrdine&quot;>&#xa;                            &lt;DESPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/DESPrimoOrdine&quot;/>&#xa;                            &lt;/DESPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/CAP&quot;>&#xa;                            &lt;CAP>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/CAP&quot;/>&#xa;                            &lt;/CAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/codiceISTATComune&quot;>&#xa;                            &lt;codiceISTATComune>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codiceISTATComune&quot;/>&#xa;                            &lt;/codiceISTATComune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/codiceISTATProvincia&quot;>&#xa;                            &lt;codiceISTATProvincia>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codiceISTATProvincia&quot;/>&#xa;                            &lt;/codiceISTATProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/codiceToponomastica&quot;>&#xa;                            &lt;codiceToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codiceToponomastica&quot;/>&#xa;                            &lt;/codiceToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/comune&quot;>&#xa;                            &lt;comune>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/comune&quot;/>&#xa;                            &lt;/comune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/descrPartToponomastica&quot;>&#xa;                            &lt;descrPartToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/descrPartToponomastica&quot;/>&#xa;                            &lt;/descrPartToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/descrizioneVia&quot;>&#xa;                            &lt;descrizioneVia>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/descrizioneVia&quot;/>&#xa;                            &lt;/descrizioneVia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/localita&quot;>&#xa;                            &lt;localita>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/localita&quot;/>&#xa;                            &lt;/localita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/numeroCivico&quot;>&#xa;                            &lt;numeroCivico>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/numeroCivico&quot;/>&#xa;                            &lt;/numeroCivico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/provincia&quot;>&#xa;                            &lt;provincia>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/provincia&quot;/>&#xa;                            &lt;/provincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/siglaProvincia&quot;>&#xa;                            &lt;siglaProvincia>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/siglaProvincia&quot;/>&#xa;                            &lt;/siglaProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/distretto&quot;>&#xa;                            &lt;distretto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/distretto&quot;/>&#xa;                            &lt;/distretto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/CLLI&quot;>&#xa;                            &lt;CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/CLLI&quot;/>&#xa;                            &lt;/CLLI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CRMOrigine>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/CRMOrigine&quot;/>&#xa;                        &lt;/CRMOrigine>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/codiceSLAAssurance&quot;>&#xa;                            &lt;codiceSLAAssurance>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codiceSLAAssurance&quot;/>&#xa;                            &lt;/codiceSLAAssurance>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDRisorsaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDRisorsaNOW&quot;/>&#xa;                        &lt;/IDRisorsaNOW>&#xa;                        &lt;IDOfferta>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDOfferta&quot;/>&#xa;                        &lt;/IDOfferta>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/indirizzoEstesoNonCert&quot;>&#xa;                            &lt;indirizzoEstesoNonCert>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/indirizzoEstesoNonCert&quot;/>&#xa;                            &lt;/indirizzoEstesoNonCert>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/numeroFittizio&quot;>&#xa;                            &lt;numeroFittizio>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/numeroFittizio&quot;/>&#xa;                            &lt;/numeroFittizio>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/codificaOLOAGCOMDonating&quot;>&#xa;                            &lt;codificaOLOAGCOMDonating>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codificaOLOAGCOMDonating&quot;/>&#xa;                            &lt;/codificaOLOAGCOMDonating>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/codificaOLOAGCOMDonor&quot;>&#xa;                            &lt;codificaOLOAGCOMDonor>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codificaOLOAGCOMDonor&quot;/>&#xa;                            &lt;/codificaOLOAGCOMDonor>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/codificaOLONOWDonating&quot;>&#xa;                            &lt;codificaOLONOWDonating>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codificaOLONOWDonating&quot;/>&#xa;                            &lt;/codificaOLONOWDonating>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/codificaOLONOWDonor&quot;>&#xa;                            &lt;codificaOLONOWDonor>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codificaOLONOWDonor&quot;/>&#xa;                            &lt;/codificaOLONOWDonor>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/tipologiaScenario&quot;>&#xa;                            &lt;tipologiaScenario>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/tipologiaScenario&quot;/>&#xa;                            &lt;/tipologiaScenario>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/totaleOrdinePacchetto&quot;>&#xa;                            &lt;totaleOrdinePacchetto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/totaleOrdinePacchetto&quot;/>&#xa;                            &lt;/totaleOrdinePacchetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDCorrelazione&quot;>&#xa;                            &lt;IDCorrelazione>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDCorrelazione&quot;/>&#xa;                            &lt;/IDCorrelazione>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/numTelPrincipale&quot;>&#xa;                            &lt;numTelPrincipale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/numTelPrincipale&quot;/>&#xa;                            &lt;/numTelPrincipale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/codiceFatturazioneJPUB&quot;>&#xa;                            &lt;codiceFatturazioneJPUB>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codiceFatturazioneJPUB&quot;/>&#xa;                            &lt;/codiceFatturazioneJPUB>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/CRMEstrattore&quot;>&#xa;                            &lt;CRMEstrattore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/CRMEstrattore&quot;/>&#xa;                            &lt;/CRMEstrattore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDRichiestaOLD&quot;>&#xa;                            &lt;IDRichiestaOLD>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDRichiestaOLD&quot;/>&#xa;                            &lt;/IDRichiestaOLD>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/ns:Asset_Now/cliente)&quot;>&#xa;                            &lt;cliente>&#xa;                                &lt;IDAsset>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/cliente/IDAsset&quot;/>&#xa;                                &lt;/IDAsset>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/cliente/created&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:Asset_Now/cliente/lastUpdate&quot;>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/cliente/lastUpdate&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:Asset_Now/cliente/codiceFiscale&quot;>&#xa;         