                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignmentonline.crmws.main.ogg&quot; xmlns:ns1=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Attivazione.output&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;responseAttivazione&quot;/>&#xa;    &lt;xsl:template name=&quot;Ogg-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:Input_InsertUpdateOGG>&#xa;            &lt;ns1:OGG_Request>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Attivazione.output/ns1:OGG_Request/ns1:Stato)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Attivazione.output/ns1:OGG_Request/ns1:Stato&quot;>&#xa;                            &lt;ns1:Stato>&#xa;                                &lt;xsl:value-of select=&quot;$Attivazione.output/ns1:OGG_Request/ns1:Stato&quot;/>&#xa;                            &lt;/ns1:Stato>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$responseAttivazione/ns1:OGG_Request/ns1:Stato&quot;>&#xa;                            &lt;ns1:Stato>&#xa;                                &lt;xsl:value-of select=&quot;$responseAttivazione/ns1:OGG_Request/ns1:Stato&quot;/>&#xa;                            &lt;/ns1:Stato>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:TRANSACTION_ID&quot;>&#xa;                    &lt;ns1:TransactionID>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:TRANSACTION_ID&quot;