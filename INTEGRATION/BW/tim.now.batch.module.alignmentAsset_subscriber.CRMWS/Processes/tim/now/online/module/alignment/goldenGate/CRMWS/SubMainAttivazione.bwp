            xmlns:ptyp4="http://www.tim.com/NOW/wsdl/abstract/ProcessLog"
            xmlns:tns="http://xmlns.example.com/20170103182100"
            xmlns:vprop="http://docs.oasis-open.org/wsbpel/2.0/varprop"
            xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp:FindUpdateCase"/>
            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType1">
                <plnk:role name="use" portType="ptyp2:AllineamentoConsistenza"/>
            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType2">
                <plnk:role name="use" portType="ptyp3:AllineamentoConsistenza"/>
            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType3">
                <plnk:role name="use" portType="ptyp4:ProcessLog"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/"/>
            <wsdl:import namespace="http://www.tim.now/abstract/attivazione/allineamentoAsset.Crmws.ogg"/>
            <wsdl:import namespace="http://www.tim.now/abstract/variazione/allineamentoAsset.Crmws.ogg"/>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/ProcessLog"/>
        </wsdl:definitions>
