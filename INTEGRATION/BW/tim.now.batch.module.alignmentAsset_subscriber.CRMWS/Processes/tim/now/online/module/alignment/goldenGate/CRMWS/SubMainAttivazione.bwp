            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:ns1=&quot;www.tim.now.alignmentonline.crmws.main.ogg&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;Offerta&quot;/>&lt;xsl:param name=&quot;Asset&quot;/>&lt;xsl:param name=&quot;FindCase&quot;/>&lt;xsl:param name=&quot;trasCodifica&quot;/>&lt;xsl:template name=&quot;inputAttivazione&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Asset/IDRisorsa)>0&quot;>&lt;ns:Input>&lt;ns:IdOfferta>&lt;xsl:value-of select=&quot;xsd:int($Offerta/Record[1]/ID_OFFERTA)&quot;/>&lt;/ns:IdOfferta>&lt;xsl:if test=&quot;$Offerta/Record[1]/NOME_OFFERTA_ESTERNA&quot;>&lt;ns:NomeOffertaEsterna>&lt;xsl:value-of select=&quot;$Offerta/Record[1]/NOME_OFFERTA_ESTERNA&quot;/>&lt;/ns:NomeOffertaEsterna>&lt;/xsl:if>&lt;ns:NomeProcesso>&lt;xsl:value-of select=&quot;concat('tim.now.batch.module.alignmentAsset_subscriber.CRMWS/tim.now.online.module.alignment.goldenGate.CRMWS.attivazione.service.',$trasCodifica/ns:ProcessName)&quot;/>&lt;/ns:NomeProcesso>&lt;ns:CheckEsistenza>&lt;xsl:value-of select=&quot;&amp;quot;TRUE&amp;quot;&quot;/>&lt;/ns:CheckEsistenza>&lt;ns:CaseReference>&lt;xsl:value-of select=&quot;$FindCase/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO']/tns:CaseReference&quot;/>&lt;/ns:CaseReference>&lt;ns:Clob_CRMWS>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:message/ns1:Message/ns1:MESSAGGIO&quot;/>&lt;/ns:Clob_CRMWS>&lt;ns:Asset_Now>&lt;xsl:copy-of select=&quot;$Asset/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$Asset/@*&quot;/>&lt;xsl:copy-of select=&quot;$Asset/node()&quot;/>&lt;/ns:Asset_Now>&lt;/ns:Input>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:Input>&lt;ns:IdOfferta>&lt;xsl:value-of select=&quot;xsd:int($Offerta/Record[1]/ID_OFFERTA)&quot;/>&lt;/ns:IdOfferta>&lt;xsl:if test=&quot;$Offerta/Record[1]/NOME_OFFERTA_ESTERNA&quot;>&lt;ns:NomeOffertaEsterna>&lt;xsl:value-of select=&quot;$Offerta/Record[1]/NOME_OFFERTA_ESTERNA&quot;/>&lt;/ns:NomeOffertaEsterna>&lt;/xsl:if>&lt;ns:NomeProcesso>&lt;xsl:value-of select=&quot;concat('tim.now.batch.module.alignmentAsset_subscriber.CRMWS/tim.now.online.module.alignment.goldenGate.CRMWS.attivazione.service.',$trasCodifica/ns:ProcessName)&quot;/>&lt;/ns:NomeProcesso>&lt;ns:CheckEsistenza>&lt;xsl:value-of select=&quot;&amp;quot;FALSE&amp;quot;&quot;/>&lt;/ns:CheckEsistenza>&lt;ns:CaseReference>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:CaseReference>&lt;ns:Clob_CRMWS>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:message/ns1:Message/ns1:MESSAGGIO&quot;/>&lt;/ns:Clob_CRMWS>&lt;/ns:Input>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="inputAttivazione"
                    name="Input_Attivazione"
                    outputVariable="inputAttivazione"
                    tibex:xpdlId="56b202a4-4eea-4f13-85d3-e027c6b541e4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToInput_Attivazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Input_AttivazioneToCallProcess2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:ns1=&quot;www.tim.now.alignmentonline.crmws.main.ogg&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindCase.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;Offerta&quot;/>&#xa;    &lt;xsl:param name=&quot;Asset&quot;/>&#xa;    &lt;xsl:param name=&quot;trasCodifica&quot;/>&#xa;    &lt;xsl:template name=&quot;inputAttivazione&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($Asset/IDRisorsa)>0&quot;>&#xa;                &lt;ns:Input>&#xa;                    &lt;ns:IdOfferta>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Offerta/Record[1]/ID_OFFERTA)&quot;/>&#xa;                    &lt;/ns:IdOfferta>&#xa;                    &lt;xsl:if test=&quot;$Offerta/Record[1]/NOME_OFFERTA_ESTERNA&quot;>&#xa;                        &lt;ns:NomeOffertaEsterna>&#xa;                            &lt;xsl:value-of select=&quot;$Offerta/Record[1]/NOME_OFFERTA_ESTERNA&quot;/>&#xa;                        &lt;/ns:NomeOffertaEsterna>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:NomeProcesso>&#xa;                        &lt;xsl:value-of select=&quot;concat('tim.now.batch.module.alignmentAsset_subscriber.CRMWS/tim.now.online.module.alignment.goldenGate.CRMWS.attivazione.service.',$trasCodifica/ns:ProcessName)&quot;/>&#xa;                    &lt;/ns:NomeProcesso>&#xa;                    &lt;ns:CheckEsistenza>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TRUE&amp;quot;&quot;/>&#xa;                    &lt;/ns:CheckEsistenza>&#xa;                    &lt;ns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/statoAsset='ATTIVO']/tns:CaseReference&quot;/>&#xa;                    &lt;/ns:CaseReference>&#xa;                    &lt;ns:Clob_CRMWS>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:message/ns1:Message/ns1:MESSAGGIO&quot;/>&#xa;                    &lt;/ns:Clob_CRMWS>&#xa;                    &lt;ns:Asset_Now>&#xa;                        &lt;xsl:copy-of select=&quot;$Asset/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                        &lt;xsl:copy-of select=&quot;$Asset/@*&quot;/>&#xa;                        &lt;xsl:copy-of select=&quot;$Asset/node()&quot;/>&#xa;                    &lt;/ns:Asset_Now>&#xa;                &lt;/ns:Input>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:Input>&#xa;                    &lt;ns:IdOfferta>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Offerta/Record[1]/ID_OFFERTA)&quot;/>&#xa;                    &lt;/ns:IdOfferta>&#xa;                    &lt;xsl:if test=&quot;$Offerta/Record[1]/NOME_OFFERTA_ESTERNA&quot;>&#xa;                        &lt;ns:NomeOffertaEsterna>&#xa;                            &lt;xsl:value-of select=&quot;$Offerta/Record[1]/NOME_OFFERTA_ESTERNA&quot;/>&#xa;                        &lt;/ns:NomeOffertaEsterna>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:NomeProcesso>&#xa;                        &lt;xsl:value-of select=&quot;concat('tim.now.batch.module.alignmentAsset_subscriber.CRMWS/tim.now.online.module.alignment.goldenGate.CRMWS.attivazione.service.',$trasCodifica/ns:ProcessName)&quot;/>&#xa;                    &lt;/ns:NomeProcesso>&#xa;                    &lt;ns:CheckEsistenza>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FALSE&amp;quot;&quot;/>&#xa;                    &lt;/ns:CheckEsistenza>&#xa;                    &lt;ns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/ns:CaseReference>&#xa;                    &lt;ns:Clob_CRMWS>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:message/ns1:Message/ns1:MESSAGGIO&quot;/>&#xa;                    &lt;/ns:Clob_CRMWS>&#xa;                &lt;/ns:Input>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
