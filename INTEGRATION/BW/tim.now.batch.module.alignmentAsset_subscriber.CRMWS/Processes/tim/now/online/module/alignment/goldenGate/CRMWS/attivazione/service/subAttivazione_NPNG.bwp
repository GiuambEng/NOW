te&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="'ROUTINGNUMBER'"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:ROUTINGNUMBER"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:OPZIONETRAFFICO)&gt;0"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="&amp;quot;OPZIONETRAFFICO&amp;quot;"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:OPZIONETRAFFICO"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:TIPOPROVISIONING)&gt;0"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="&amp;quot;TIPOPROVISIONING&amp;quot;"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:TIPOPROVISIONING"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:RISORSA"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="&amp;quot;ATTIVO&amp;quot;"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="1"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;xsl:if test="$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:DEC"&gt;&lt;DESPrimoOrdine&gt;&lt;xsl:value-of select="$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:DEC"/&gt;&lt;/DESPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:DISTRETTO"&gt;&lt;distretto&gt;&lt;xsl:value-of select="$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:DISTRETTO"/&gt;&lt;/distretto&gt;&lt;/xsl:if&gt;&lt;CRMOrigine&gt;&lt;xsl:value-of select="'CRMWS'"/&gt;&lt;/CRMOrigine&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:RISORSA"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDOfferta&gt;&lt;xsl:value-of select="$Start/ns2:IdOfferta"/&gt;&lt;/IDOfferta&gt;&lt;CRMEstrattore&gt;&lt;xsl:value-of select="'CRMWS'"/&gt;&lt;/CRMEstrattore&gt;&lt;/tns:Asset&gt;&lt;/tns:Input&gt;&lt;/tns:Create&gt;&lt;/tns:Input&gt;&lt;/part1&gt;&lt;/ns:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns2=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPNG/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;caseModelVersion&quot;/>&#xa;    &lt;xsl:param name=&quot;caseType&quot;/>&#xa;    &lt;xsl:param name=&quot;Check1&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:template name=&quot;CreateCase-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Create>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:caseType>&#xa;                        &lt;xsl:value-of select=&quot;$caseType&quot;/>&#xa;                    &lt;/tns:caseType>&#xa;                    &lt;tns:caseModelVersion>&#xa;                        &lt;xsl:value-of select=&quot;$caseModelVersion&quot;/>&#xa;                    &lt;/tns:caseModelVersion>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:CODICEORDINEOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:CODICE_ORDINE_TI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:CODICE_ORDINE_TI&quot;/>