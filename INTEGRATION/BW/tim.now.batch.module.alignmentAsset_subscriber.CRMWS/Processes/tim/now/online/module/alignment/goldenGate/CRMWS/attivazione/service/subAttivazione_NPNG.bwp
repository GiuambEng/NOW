                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/" xmlns:tns="http://www.tim.com/NOW/xsd/FindUpdateCase/" xmlns:ns2="www.tim.now.dinamicprocess.allineamentoOggAsset" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPNG/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="caseModelVersion"/&gt;&lt;xsl:param name="caseType"/&gt;&lt;xsl:param name="Check1"/&gt;&lt;xsl:param name="ParseXml"/&gt;&lt;xsl:template name="CreateCase-input" match="/"&gt;&lt;ns:Request&gt;&lt;part1&gt;&lt;tns:Input&gt;&lt;tns:Create&gt;&lt;tns:Input&gt;&lt;tns:caseType&gt;&lt;xsl:value-of select="$caseType"/&gt;&lt;/tns:caseType&gt;&lt;tns:caseModelVersion&gt;&lt;xsl:value-of select="$caseModelVersion"/&gt;&lt;/tns:caseModelVersion&gt;&lt;tns:Asset&gt;&lt;codiceOrdineOLO&gt;&lt;xsl:value-of select="$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:CODICEORDINEOLO"/&gt;&lt;/codiceOrdineOLO&gt;&lt;xsl:if test="$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:CODICE_ORDINE_TI"&gt;&lt;codiceOrdineTI&gt;&lt;xsl:value-of select="$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/ns1:CODICE_ORDINE_TI"/&gt;&lt;/codiceOrdineTI&gt;&lt;/xsl:if&gt;&lt;codificaOLOAGCOM&gt;&lt;xsl:value-of select="$ParseXml/ns1:SERVIZIO/ns1:DESCOLO"/&gt;&lt;/codificaOLOAGCOM&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;IDContratto&gt;&lt;xsl:value-of select="xsd:int(xsd:decimal($Check1/ns2:IdContrattoNOW))"/&gt;&lt;/IDContratto&gt;&lt;statoAsset&gt;&lt;xsl:value-of select="'ATTIVO'"/&gt;&lt;/statoAsset&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="$ParseXml/ns1:SERVIZIO/ns1:NPNG/ns1:ATTIVAZIONE/