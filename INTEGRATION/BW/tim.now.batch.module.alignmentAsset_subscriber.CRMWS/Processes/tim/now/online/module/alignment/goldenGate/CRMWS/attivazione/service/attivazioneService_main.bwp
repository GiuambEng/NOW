                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEndLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AttivazioneIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;Attivazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:IdOfferta&quot;>&#xa;                &lt;ns:IdOfferta>&#xa;                    &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:IdOfferta&quot;/>&#xa;                &lt;/ns:IdOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:NomeOffertaEsterna&quot;>&#xa;                &lt;ns:NomeOffertaEsterna>&#xa;                    &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:NomeOffertaEsterna&quot;/>&#xa;                &lt;/ns:NomeOffertaEsterna>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:transactionId_CessatoVariato&quot;>&#xa;                &lt;ns:transactionId_CessatoVariato>&#xa;                    &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:transactionId_CessatoVariato&quot;/>&#xa;                &lt;/ns:transactionId_CessatoVariato>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Created_CessatoVariato&quot;>&#xa;                &lt;ns:Created_CessatoVariato>&#xa;                    &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Created_CessatoVariato&quot;/>&#xa;                &lt;/ns:Created_CessatoVariato>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:NomeProcesso>&#xa;                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:NomeProcesso&quot;/>&#xa;            &lt;/ns:NomeProcesso>&#xa;            &lt;ns:CheckEsistenza>&#xa;                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:CheckEsistenza&quot;/>&#xa;            &lt;/ns:CheckEsistenza>&#xa;            &lt;ns:CaseReference>&#xa;                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:CaseReference&quot;/>&#xa;            &lt;/ns:CaseReference>&#xa;            &lt;ns:Clob_CRMWS>&#xa;                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Clob_CRMWS&quot;/>&#xa;            &lt;/ns:Clob_CRMWS>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(xsd:string($AttivazioneIn.input/ns:Asset_Now/IDAsset))>0&quot;>&#xa;                    &lt;ns:Asset_Now>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/codiceOrdineOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/codiceOrdineTI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/codiceOrdineTI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/invariante&quot;>&#xa;                            &lt;invariante>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/invariante&quot;/>&#xa;                            &lt;/invariante>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/lastUpdate&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/IDRichiestaOLO&quot;>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/IDRichiestaOLO&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/IDPrimoOrdine&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/IDPrimoOrdine&quot;/>&#xa;                            &lt;/IDPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/IDContratto&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/DEC&quot;>&#xa;   