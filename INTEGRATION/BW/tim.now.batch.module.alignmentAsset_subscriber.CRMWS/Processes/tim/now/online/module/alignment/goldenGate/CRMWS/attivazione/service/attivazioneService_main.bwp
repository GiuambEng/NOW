stUpdate&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                        &lt;IDDettaglioAsset>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                        &lt;/IDDettaglioAsset>&#xa;                                    &lt;/attributidettaglioasset>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;IDRisorsaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                &lt;/IDRisorsaNOW>&#xa;                                &lt;IDDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                &lt;/IDDettaglioAsset>&#xa;                                &lt;statoDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                                &lt;/statoDettaglioAsset>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioasset>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/DESPrimoOrdine&quot;>&#xa;                            &lt;DESPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/DESPrimoOrdine&quot;/>&#xa;                            &lt;/DESPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/CAP&quot;>&#xa;                            &lt;CAP>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/CAP&quot;/>&#xa;                            &lt;/CAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/codiceISTATComune&quot;>&#xa;                            &lt;codiceISTATComune>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/codiceISTATComune&quot;/>&#xa;                            &lt;/codiceISTATComune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/codiceISTATProvincia&quot;>&#xa;                            &lt;codiceISTATProvincia>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/codiceISTATProvincia&quot;/>&#xa;                            &lt;/codiceISTATProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/codiceToponomastica&quot;>&#xa;                            &lt;codiceToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/codiceToponomastica&quot;/>&#xa;                            &lt;/codiceToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/comune&quot;>&#xa;                            &lt;comune>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/comune&quot;/>&#xa;                            &lt;/comune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/descrPartToponomastica&quot;>&#xa;                            &lt;descrPartToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/descrPartToponomastica&quot;/>&#xa;                            &lt;/descrPartToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/descrizioneVia&quot;>&#xa;                            &lt;descrizioneVia>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/descrizioneVia&quot;/>&#xa;                            &lt;/descrizioneVia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/localita&quot;>&#xa;                            &lt;localita>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/localita&quot;/>&#xa;                            &lt;/localita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:Asset_Now/numeroCivico&quot;>&#xa;                            &lt;numeroCivico>&#xa;                                &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Asset_Now/numeroCivico&quot;/>&#xa;                          