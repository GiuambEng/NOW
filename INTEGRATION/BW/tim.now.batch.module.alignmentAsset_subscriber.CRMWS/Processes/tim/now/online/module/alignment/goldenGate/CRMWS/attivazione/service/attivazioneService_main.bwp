                                <bpws:sources>
                                    <bpws:source linkName="AssignToReply"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AttivazioneIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&#xa;        &lt;ns:output>&#xa;            &lt;ns:FlagCorrelazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;            &lt;/ns:FlagCorrelazione>&#xa;            &lt;ns:OGG_Request>&#xa;                &lt;ns:Stato>&#xa;                    &lt;xsl:value-of select=&quot;'LAVORATO'&quot;/>&#xa;                &lt;/ns:Stato>&#xa;            &lt;/ns:OGG_Request>&#xa;            &lt;ns:OGG_Response>&#xa;                &lt;ns:ReturnCode>&#xa;                    &lt;xsl:value-of select=&quot;'99'&quot;/>&#xa;                &lt;/ns:ReturnCode>&#xa;                &lt;ns:Stato>&#xa;                    &lt;xsl:value-of select=&quot;'DA LAVORARE'&quot;/>&#xa;                &lt;/ns:Stato>&#xa;                &lt;ns:DescrErrore>&#xa;                    &lt;xsl:value-of select=&quot;'ERRORE GENERICO'&quot;/>&#xa;                &lt;/ns:DescrErrore>&#xa;                &lt;ns:Message>&#xa;                    &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:Clob_CRMWS&quot;/>&#xa;                &lt;/ns:Message>&#xa;                &lt;ns:ERROR_LOG>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(),true())&quot;/>&#xa;                &lt;/ns:ERROR_LOG>&#xa;            &lt;/ns:OGG_Response>&#xa;        &lt;/ns:output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
