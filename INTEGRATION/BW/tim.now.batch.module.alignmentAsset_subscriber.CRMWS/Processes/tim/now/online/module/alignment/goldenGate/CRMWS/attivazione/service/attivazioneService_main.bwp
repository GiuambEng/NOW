                        <bpws:reply name="Error" operation="Attivazione"
                            partnerLink="AllineamentoConsistenza"
                            portType="ns1:AllineamentoConsistenza"
                            tibex:xpdlId="f976c8f4-d079-4cd3-9780-1da22a0949f8" variable="Error-input">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.now/abstract/attivazione/allineamentoAsset.Crmws.ogg" xmlns:ns="www.tim.now.dinamicprocess.allineamentoOggAsset" version="2.0"&gt;&lt;xsl:param name="Output"/&gt;&lt;xsl:template name="Error-input" match="/"&gt;&lt;tns:Response&gt;&lt;output&gt;&lt;ns:output&gt;&lt;ns:FlagCorrelazione&gt;&lt;xsl:value-of select="$Output/ns:FlagCorrelazione"/&gt;&lt;/ns:FlagCorrelazione&gt;&lt;xsl:if test="$Output/ns:IdContrattoNOW"&gt;&lt;ns:IdContrattoNOW&gt;&lt;xsl:value-of select="$Output/ns:IdContrattoNOW"/&gt;&lt;/ns:IdContrattoNOW&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Output/ns:DN"&gt;&lt;ns:DN&gt;&lt;xsl:value-of select="$Output/ns:DN"/&gt;&lt;/ns:DN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Output/ns:IdAssetNow"&gt;&lt;ns:IdAssetNow&gt;&lt;xsl:value-of select="$Output/ns:IdAssetNow"/&gt;&lt;/ns:IdAssetNow&gt;&lt;/xsl:if&gt;&lt;xsl:copy-of select="$Output/ns:OGG_Request"/&gt;&lt;xsl:copy-of select="$Output/ns:OGG_Response"/&gt;&lt;/ns:output&gt;&lt;/output&gt;&lt;/tns:Response&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.now/abstract/attivazione/allineamentoAsset.Crmws.ogg&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Output&quot;/>&#xa;    &lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:output>&#xa;            &lt;ns:FlagCorrelazione>&#xa;                &lt;xsl:value-of select=&quot;$Output/ns:FlagCorrelazione&quot;/>&#xa;            &lt;/ns:FlagCorrelazione>&#xa;            &lt;xsl:if test=&quot;$Output/ns:IdContrattoNOW&quot;>&#xa;                &lt;ns:IdContrattoNOW>&#xa;                    &lt;xsl:value-of select=&quot;$Output/ns:IdContrattoNOW&quot;/>&#xa;                &lt;/ns:IdContrattoNOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Output/ns:DN&quot;>&#xa;                &lt;ns:DN>&#xa;                    &lt;xsl:value-of select=&quot;$Output/ns:DN&quot;/>&#xa;                &lt;/ns:DN>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Output/ns:IdAssetNow&quot;>&#xa;                &lt;ns:IdAssetNow>&#xa;                    &lt;xsl:value-of select=&quot;$Output/ns:IdAssetNow&quot;/>&#xa;                &lt;/ns:IdAssetNow>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:copy-of select=&quot;$Output/ns:OGG_Request&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Output/ns:OGG_Response&quot;/>&#xa;        &lt;/ns:output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="AssignToReply"/>
                            </bpws:targets>
                        </bpws:reply>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="AttivazioneInToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="EndLogToAttivazioneOut" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEndLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartLogToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToAttivazione" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:receive createInstance="yes" name="AttivazioneIn"
                operation="Attivazione"
                partnerLink="AllineamentoConsistenza"
                portType="ns1:AllineamentoConsistenza"
                tibex:xpdlId="f19f79a5-0b63-4a4c-a52b-51ede26906ce" variable="AttivazioneIn">
