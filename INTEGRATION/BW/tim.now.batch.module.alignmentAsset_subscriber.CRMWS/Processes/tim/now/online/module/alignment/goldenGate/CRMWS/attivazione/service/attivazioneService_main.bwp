                    <bpws:sources>
                        <bpws:source linkName="EndLogToAttivazioneOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AttivazioneIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:template name=&quot;EndLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AttivazioneService_main'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'AttivazioneService_main'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'AttivazioneService_main'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$AttivazioneIn.input/ns:transactionId_CessatoVariato&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$AttivazioneIn.input/ns:transactionId_CessatoVariato&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Processo AttivazioneService_main Terminato con Successo'&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AttivazioneIn&quot;/>&lt;xsl:template name=&quot;Attivazione-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:IdOfferta&quot;>&lt;ns:IdOfferta>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:IdOfferta&quot;/>&lt;/ns:IdOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:NomeOffertaEsterna&quot;>&lt;ns:NomeOffertaEsterna>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:NomeOffertaEsterna&quot;/>&lt;/ns:NomeOffertaEsterna>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:transactionId_CessatoVariato&quot;>&lt;ns:transactionId_CessatoVariato>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:transactionId_CessatoVariato&quot;/>&lt;/ns:transactionId_CessatoVariato>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Created_CessatoVariato&quot;>&lt;ns:Created_CessatoVariato>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Created_CessatoVariato&quot;/>&lt;/ns:Created_CessatoVariato>&lt;/xsl:if>&lt;ns:NomeProcesso>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:NomeProcesso&quot;/>&lt;/ns:NomeProcesso>&lt;ns:CheckEsistenza>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:CheckEsistenza&quot;/>&lt;/ns:CheckEsistenza>&lt;ns:CaseReference>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:CaseReference&quot;/>&lt;/ns:CaseReference>&lt;ns:Clob_CRMWS>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Clob_CRMWS&quot;/>&lt;/ns:Clob_CRMWS>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string($AttivazioneIn/input/ns:Input/ns:Asset_Now/IDAsset))>0&quot;>&lt;ns:Asset_Now>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/IDAsset&quot;>&lt;IDAsset>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/IDAsset&quot;/>&lt;/IDAsset>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/codiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/codiceOrdineTI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/codiceOrdineTI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/invariante&quot;>&lt;invariante>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/invariante&quot;/>&lt;/invariante>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/created&quot;/>&lt;/created>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/operatore&quot;/>&lt;/operatore>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/IDRichiestaOLO&quot;>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/IDPrimoOrdine&quot;>&lt;IDPrimoOrdine>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/IDPrimoOrdine&quot;/>&lt;/IDPrimoOrdine>&lt;/xsl:if>&lt;IDContratto>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/IDContratto&quot;/>&lt;/IDContratto>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/DEC&quot;>&lt;DEC>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/DEC&quot;/>&lt;/DEC>&lt;/xsl:if>&lt;statoAsset>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/statoAsset&quot;/>&lt;/statoAsset>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/numeroTelefonico&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/numeroTelefonico&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/IDAssetCRMWS&quot;>&lt;IDAssetCRMWS>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/IDAssetCRMWS&quot;/>&lt;/IDAssetCRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/IDAssetDa&quot;>&lt;IDAssetDa>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/IDAssetDa&quot;/>&lt;/IDAssetDa>&lt;/xsl:if>&lt;DES>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/DES&quot;/>&lt;/DES>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/ORA_DES&quot;>&lt;ORA_DES>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/ORA_DES&quot;/>&lt;/ORA_DES>&lt;/xsl:if>&lt;tipologiaAccesso>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/tipologiaAccesso&quot;/>&lt;/tipologiaAccesso>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/RO&quot;>&lt;RO>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/RO&quot;/>&lt;/RO>&lt;/xsl:if>&lt;offerta>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/offerta&quot;/>&lt;/offerta>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/lineaRiferimento&quot;>&lt;lineaRiferimento>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/lineaRiferimento&quot;/>&lt;/lineaRiferimento>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/complesso&quot;>&lt;complesso>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/complesso&quot;/>&lt;/complesso>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/interno&quot;>&lt;interno>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/interno&quot;/>&lt;/interno>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/piano&quot;>&lt;piano>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/piano&quot;/>&lt;/piano>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/scala&quot;>&lt;scala>&lt;xsl:value-of select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/scala&quot;/>&lt;/scala>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$AttivazioneIn/input/ns:Input/ns:Asset_Now/dettaglioasset&quot;>&lt;dettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&lt;IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&lt;/IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&lt;IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&lt;/IDDettaglioAssetRoot>&lt;/xsl:if>&lt;integrationID>&lt;xsl:value-of select=&quot;integrationID&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;nomeComponente&quot;/>&lt;/nomeComponente>&lt;xsl:for-each select=&quot