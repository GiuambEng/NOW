                                    sqlStatement="SELECT IDASSETRICARICA ,IDASSET,DATAINIZIO ,DATAFINE ,TIPOLOGIARICARICA ,STATOASSET ,FAMIGLIAASSET ,&#xd;&#xa;LASTUPDATE ,CREATED ,DATAACCENSIONE ,DATASPEGNIMENTO ,DATAANNULLAMENTO ,OPERATORE  &#xd;&#xa;FROM BDS_1_CASEDATA_ASSETRICARICA &#xd;&#xa;&#xd;&#xa;WHERE  IDASSET=? AND  STATOASSET IN ('ACCESA','SCHEDULATA')&#xd;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
