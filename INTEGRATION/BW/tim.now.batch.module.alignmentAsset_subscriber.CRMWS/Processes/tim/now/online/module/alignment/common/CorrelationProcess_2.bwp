                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a3c1fe8b-65b8-4f53-8275-eaba149d8583+input&quot; xmlns:ns=&quot;http://www.tim.now.WLR_CorrelationProcess&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;NumTelefonico_Tipol_1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;DISTRETTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:Asset/distretto)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:Asset/distretto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DISTRETTO>&lt;NUMEROTELEFONICO>&lt;xsl:value-of select=&quot;$Start/ns:Asset/IDRisorsa&quot;/>&lt;/NUMEROTELEFONICO>&lt;DISTRETT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:Asset/distretto)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:Asset/distretto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DISTRETT>&lt;NUM_TELEFONICO>&lt;xsl:value-of select=&quot;$Start/ns:Asset/IDRisorsa&quot;/>&lt;/NUM_TELEFONICO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="NumTelefonico_Tipol_1-input"
                    name="NumTelefonico_Tipol_1"
                    outputVariable="NumTelefonico_Tipol_1"
                    tibex:xpdlId="a3c1fe8b-65b8-4f53-8275-eaba149d8583" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartLogToEndLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToEndLog">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a3c1fe8b-65b8-4f53-8275-eaba149d8583+input&quot; xmlns:ns=&quot;http://www.tim.now.WLR_CorrelationProcess&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;NumTelefonico_Tipol_1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;DISTRETTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:Asset/distretto)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:Asset/distretto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DISTRETTO>&lt;NUMEROTELEFONICO>&lt;xsl:value-of select=&quot;$Start/ns:Asset/IDRisorsa&quot;/>&lt;/NUMEROTELEFONICO>&lt;DISTRETT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:Asset/distretto)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:Asset/distretto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DISTRETT>&lt;NUM_TELEFONICO>&lt;xsl:value-of select=&quot;$Start/ns:Asset/IDRisorsa&quot;/>&lt;/NUM_TELEFONICO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ASSET.IDRISORSACORRELATO, ASSET.BDS_ID&#xa;  FROM&#xa;       BDS_1_CASEDATA_ASSET ASSET JOIN BDS_1_CASEDATA_DETTAGLIOASSET DETT ON DETT.ASSET_DETTAGLIOASSET_BDSID = ASSET.BDS_ID JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ATTR ON ATTR.DTTGLSST_TTRBTIDTTGLISST_BDSID = DETT.BDS_ID&#xa;  WHERE (ASSET.DISTRETTO = ? AND ASSET.NUMEROTELEFONICO = ?&#xa;    AND ASSET.OFFERTA IN ('BITSTREAMGBEASIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOFLAT',&#xa;  'BITSTREAMATMASIMMETRICOHL', 'BITSTREAMATMASIMMETRICOLITE',&#xa;  'EASYIPBASEPLUSFLAT', 'EASYIPBASEPLUSLITE', 'EASYIPSPECIALPROFILEFLAT',&#xa;  'EASYIPSPECIALPROFILELITE', 'BITSTREAMNGAFTTCAB', 'BITSTREAMNGAFTTH',&#xa;  'VULAFTTCAB', 'VULAFTTH') AND ASSET.STATOASSET = 'ATTIVO'&#xa;    &#xa;    AND DETT.NOMECOMPONENTE IN ('ACCESSOATMASIMFLAT', 'ACCESSOATMASIMHL',&#xa;  'ACCESSOATMASIMLITE', 'ACCESSOEASYIPBASEPLUSFLAT', 'ACCESSOEASYIPBASEPLUSLITE',&#xa;  'ACCESSOEASYIPSPECIALPROFILEFLAT', 'ACCESSOEASYIPSPECIALPROFILELITE',&#xa;  'ACCESSOGBEASIMFLAT', 'ACCESSOVULAFTTH', 'ACCESSONGAFTTH', 'ACCESSOVULAFTTCAB',&#xa;  'ACCESSONGAFTTCAB') AND ATTR.NOMEATTRIBUTO = 'TIPOLINEA'&#xa;    AND ATTR.VALOREATTRIBUTO IN ('POTS', 'ISDN'))&#xa;UNION ALL&#xa;SELECT IDRISORSACORRELATO, BDS_ID&#xa;  FROM APPUSER.BDS_1_CASEDATA_ASSET ASSET&#xa;  WHERE  STATOASSET = 'ATTIVO'&#xa;    AND OFFERTA IN ('SHASENZAMANODOPERA', 'SHACONMANODOPERA') AND DISTRETTO = ?&#xa;    AND NUMEROTELEFONICO = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DISTRETTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROTELEFONICO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DISTRETT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUM_TELEFONICO"/>
                                    <columnMetadata
                                    columnName="IDRISORSACORRELATO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="BDS_ID"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
