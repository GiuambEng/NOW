                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ASSET.IDRISORSACORRELATO, ASSET.BDS_ID&#xd;&#xa;FROM BDS_1_CASEDATA_ASSET ASSET&#xd;&#xa;  JOIN BDS_1_CASEDATA_DETTAGLIOASSET DETT ON DETT.ASSET_DETTAGLIOASSET_BDSID = ASSET.BDS_ID&#xd;&#xa;  JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ATTR ON ATTR.DTTGLSST_TTRBTIDTTGLISST_BDSID = DETT.BDS_ID&#xd;&#xa;WHERE (ASSET.DISTRETTO = ? AND&#xd;&#xa;       ASSET.NUMEROTELEFONICO = ? AND&#xd;&#xa;       ASSET.OFFERTA IN ('BITSTREAMGBEASIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOFLAT',&#xd;&#xa;                        'BITSTREAMATMASIMMETRICOHL', 'BITSTREAMATMASIMMETRICOLITE',&#xd;&#xa;                        'EASYIPBASEPLUSFLAT', 'EASYIPBASEPLUSLITE', 'EASYIPSPECIALPROFILEFLAT',&#xd;&#xa;                        'EASYIPSPECIALPROFILELITE', 'BITSTREAMNGAFTTCAB', 'BITSTREAMNGAFTTH',&#xd;&#xa;                        'VULAFTTCAB', 'VULAFTTH') AND&#xd;&#xa;      ASSET.STATOASSET = 'ATTIVO'  AND&#xd;&#xa;&#x9;  ASSET.IDRISORSACORRELATO=? AND&#xd;&#xa;      DETT.NOMECOMPONENTE IN ('ACCESSOATMASIMFLAT', 'ACCESSOATMASIMHL',&#xd;&#xa;                              'ACCESSOATMASIMLITE', 'ACCESSOEASYIPBASEPLUSFLAT', 'ACCESSOEASYIPBASEPLUSLITE',&#xd;&#xa;                              'ACCESSOEASYIPSPECIALPROFILEFLAT', 'ACCESSOEASYIPSPECIALPROFILELITE',&#xd;&#xa;                              'ACCESSOGBEASIMFLAT', 'ACCESSOVULAFTTH', 'ACCESSONGAFTTH', 'ACCESSOVULAFTTCAB',&#xd;&#xa;                              'ACCESSONGAFTTCAB') AND&#xd;&#xa;      ATTR.NOMEATTRIBUTO = 'TIPOLINEA' AND&#xd;&#xa;      ATTR.VALOREATTRIBUTO IN ('POTS', 'ISDN'))&#xd;&#xa;UNION ALL&#xd;&#xa;SELECT ASSET.IDRISORSACORRELATO, ASSET.BDS_ID&#xd;&#xa;FROM BDS_1_CASEDATA_ASSET ASSET&#xd;&#xa;WHERE  ASSET.STATOASSET = 'ATTIVO'&#xd;&#xa;  AND ASSET.OFFERTA IN ('SHASENZAMANODOPERA', 'SHACONMANODOPERA') &#xd;&#xa;  AND ASSET.DISTRETTO = ? &#xd;&#xa;  AND ASSET.NUMEROTELEFONICO=?&#xd;&#xa;  AND ASSET.IDRISORSACORRELATO=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DISTRETTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROTELEFONICO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSACORRELATO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DISTRETT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUM_TELEFONICO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA_CORRELATO"/>
                                    <columnMetadata
                                    columnName="IDRISORSACORRELATO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="BDS_ID"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns=&quot;http://www.tim.now.WLR_CorrelationProcess&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;NumTelefonico_Tipol_2&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Log_Id_Risorsa-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'CorrelationProcess_2'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'CorrelationProcess_2'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'CorrelationProcess_2'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/ns:Transaction_id&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:Transaction_id&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($NumTelefonico_Tipol_2/Record)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('NumTelefonico_tipol_2',tib:render-xml($NumTelefonico_Tipol_2,true(),true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;'NumTelefonico_tipol_2 : record non trovato'&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/x