                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6c2cd208-cd2a-4a94-b391-43082bc51f1e+input&quot; xmlns:ns=&quot;http://www.tim.now.WLR_CorrelationProcess&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;NumTelefonico_Tipol_2-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;DISTRETTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:Asset/distretto)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:Asset/distretto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DISTRETTO>&lt;NUMEROTELEFONICO>&lt;xsl:value-of select=&quot;$Start/ns:Asset/IDRisorsa&quot;/>&lt;/NUMEROTELEFONICO>&lt;IDRISORSACORRELATO>&lt;xsl:value-of select=&quot;$Start/ns:Asset/IDRisorsa&quot;/>&lt;/IDRISORSACORRELATO>&lt;DISTRETT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:Asset/distretto)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:Asset/distretto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DISTRETT>&lt;NUM_TELEFONICO>&lt;xsl:value-of select=&quot;$Start/ns:Asset/IDRisorsa&quot;/>&lt;/NUM_TELEFONICO>&lt;ID_RISORSA_CORRELATO>&lt;xsl:value-of select=&quot;$Start/ns:Asset/IDRisorsa&quot;/>&lt;/ID_RISORSA_CORRELATO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="NumTelefonico_Tipol_2-input"
                    name="NumTelefonico_Tipol_2"
                    outputVariable="NumTelefonico_Tipol_2"
                    tibex:xpdlId="6c2cd208-cd2a-4a94-b391-43082bc51f1e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
