rt/ns2:Asset_Now/IDRisorsaOLD&quot;/>&lt;/IDRisorsaOLD>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDRisorsaCorrelato&quot;>&lt;IDRisorsaCorrelato>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDRisorsaCorrelato&quot;/>&lt;/IDRisorsaCorrelato>&lt;/xsl:if>&lt;/tns2:Asset>&lt;/tns2:Input>&lt;/tns2:Update>&lt;/tns2:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
