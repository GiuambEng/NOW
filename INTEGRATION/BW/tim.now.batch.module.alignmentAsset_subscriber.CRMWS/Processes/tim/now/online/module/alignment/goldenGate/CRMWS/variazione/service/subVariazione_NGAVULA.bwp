                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNGAVULA/&quot; xmlns:tns=&quot;www.tim.now.maxNumber&quot; xmlns:ns2=&quot;http://www.tim.now.WLR_CorrelationProcess&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseCRM&quot;/>&lt;xsl:param name=&quot;Check_Dati&quot;/>&lt;xsl:param name=&quot;Correlazione&quot;/>&lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&lt;ns:output>&lt;xsl:choose>&lt;xsl:when test=&quot;$Check_Dati/tns:Check[1]='KO'&quot;>&lt;ns:FlagCorrelazione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/ns:FlagCorrelazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$Correlazione/ns2:Output_Correlazione='Y'&quot;>&lt;ns:FlagCorrelazione>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/ns:FlagCorrelazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:FlagCorrelazione>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/ns:FlagCorrelazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$ParseCRM/ns1:SERVIZIO/ns1:VARIAZIONE/ns1:VULA_NGA/ns1:DN&quot;>&lt;ns:DN>&lt;xsl:value-of select=&quot;$ParseCRM/ns1:SERVIZIO/ns1:VARIAZIONE/ns1:VULA_NGA/ns1:DN&quot;/>&lt;/ns:DN>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDAsset&quot;>&lt;ns:IdAssetNow>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDAsset&quot;/>&lt;/ns:IdAssetNow>&lt;/xsl:if>&lt;ns:OGG_Request>&lt;xsl:choose>&lt;xsl:when test=&quot;$Check_Dati/tns:Check[1]='KO'&quot;>&lt;ns:Stato>&lt;xsl:value-of select=&quot;'LAVORATO CON CORRELAZIONE KO'&quot;/>&lt;/ns:Stato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:Stato>&lt;xsl:value-of select=&quot;'LAVORATO'&quot;/>&lt;/ns:Stato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:OGG_Request>&lt;ns:OGG_Response>&lt;ns:ReturnCode>&lt;xsl:value-of select=&quot;'00'&quot;/>&lt;/ns:ReturnCode>&lt;ns:Stato>&lt;xsl:value-of select=&quot;'DA LAVORARE'&quot;/>&lt;/ns:Stato>&lt;/ns:OGG_Response>&lt;/ns:output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
