sl:when test=&quot;$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:TIPOLINEA='LineaNonFonia' or upper-case($ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:TIPOLINEA)='LINEANONFONIA'&quot;/>&#xa;                            &lt;xsl:when test=&quot;$Correlazione/ns3:Output_Correlazione='Y'&quot;>&#xa;                                &lt;xsl:if test=&quot;$Correlazione/ns3:IdRisosaCorrelazione&quot;>&#xa;                                    &lt;IDRisorsaCorrelato>&#xa;                                        &lt;xsl:value-of select=&quot;$Correlazione/ns3:IdRisosaCorrelazione&quot;/>&#xa;                                    &lt;/IDRisorsaCorrelato>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDRisorsaCorrelato&quot;>&#xa;                                    &lt;IDRisorsaCorrelato>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDRisorsaCorrelato&quot;/>&#xa;                                    &lt;/IDRisorsaCorrelato>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:Asset>&#xa;                &lt;/tns2:Input>&#xa;            &lt;/tns2:Update>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
