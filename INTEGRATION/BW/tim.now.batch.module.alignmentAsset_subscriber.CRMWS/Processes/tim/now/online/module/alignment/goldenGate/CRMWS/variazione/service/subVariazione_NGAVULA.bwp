            <bpws:invoke inputVariable="UpdateCaseData-input"
                name="UpdateCaseData" operation="Invoke"
                outputVariable="UpdateCaseData"
                partnerLink="FindUpdateCase"
                portType="ns8:FindUpdateCase" tibex:xpdlId="adc70c32-91ad-4a85-8626-807eefe049ee">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.tim.com/NOW/xsd/FindUpdateCase/" xmlns:ns1="http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/" xmlns:ns2="www.tim.now.dinamicprocess.allineamentoOggAsset" xmlns:ns4="http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNGAVULA/" xmlns:ns="www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneNGA.xsd" xmlns:ns3="http://www.tim.now.WLR_CorrelationProcess" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="ParseCRM"/&gt;&lt;xsl:param name="FindContrattoOfferta"/&gt;&lt;xsl:param name="CreateDettaglioAsset"/&gt;&lt;xsl:param name="Correlazione"/&gt;&lt;xsl:param name="FindContrOff"/&gt;&lt;xsl:template name="UpdateCaseData-input" match="/"&gt;&lt;ns1:Request&gt;&lt;part1&gt;&lt;tns2:Input&gt;&lt;tns2:Update&gt;&lt;tns2:Input&gt;&lt;tns2:CaseReference&gt;&lt;xsl:value-of select="$Start/ns2:CaseReference"/&gt;&lt;/tns2:CaseReference&gt;&lt;tns2:Asset&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/IDAsset"&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDAsset"/&gt;&lt;/IDAsset&gt;&lt;/xsl:if&gt;&lt;codiceOrdineOLO&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:CODICEORDINEOLO"/&gt;&lt;/codiceOrdineOLO&gt;&lt;xsl:if test="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:CODICE_ORDINE_TI"&gt;&lt;codiceOrdineTI&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:CODICE_ORDINE_TI"/&gt;&lt;/codiceOrdineTI&gt;&lt;/xsl:if&gt;&lt;codificaOLOAGCOM&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/codificaOLOAGCOM"/&gt;&lt;/codificaOLOAGCOM&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/invariante"&gt;&lt;invariante&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/invariante"/&gt;&lt;/invariante&gt;&lt;/xsl:if&gt;&lt;created&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/created"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/operatore"/&gt;&lt;/operatore&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/IDPrimoOrdine"&gt;&lt;IDPrimoOrdine&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDPrimoOrdine"/&gt;&lt;/IDPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:SERVIZIO=('04', '05', '06', '07', '08', '09', '10', '11', '12', '13', '14','15')"&gt;&lt;IDContratto&gt;&lt;xsl:value-of select="xsd:int(xsd:decimal($FindContrOff/ns2:ID_CONTRATTO))"/&gt;&lt;/IDContratto&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;IDContratto&gt;&lt;xsl:value-of select="xsd:int(xsd:decimal($FindContrattoOfferta/ns2:ID_CONTRATTO))"/&gt;&lt;/IDContratto&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/DEC"&gt;&lt;DEC&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/DEC"/&gt;&lt;/DEC&gt;&lt;/xsl:if&gt;&lt;statoAsset&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/statoAsset"/&gt;&lt;/statoAsset&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:RISORSA"/&gt;&lt;/IDRisorsa&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Correlazione/ns3:Output_Correlazione='Y' and $Correlazione/ns3:Tipologia=&amp;quot;Tipologia_2&amp;quot; "&gt;&lt;numeroTelefonico&gt;&lt;xsl:value-of select="''"/&gt;&lt;/numeroTelefonico&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:DN)&gt;0 and $ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:TIPOLINEA=('POTS','ISDN') and $Correlazione/ns3:Output_Correlazione !='Y' and $Correlazione/ns3:Tipologia !=&amp;quot;Tipologia_2&amp;quot; "&gt;&lt;xsl:if test="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:DN"&gt;&lt;numeroTelefonico&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:DN"/&gt;&lt;/numeroTelefonico&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;numeroTelefonico&gt;&lt;xsl:value-of select="''"/&gt;&lt;/numeroTelefonico&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:ID_CRMWS)&gt;0"&gt;&lt;xsl:if test="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:ID_CRMWS"&gt;&lt;IDAssetCRMWS&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:ID_CRMWS"/&gt;&lt;/IDAssetCRMWS&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/IDAssetCRMWS"&gt;&lt;IDAssetCRMWS&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDAssetCRMWS"/&gt;&lt;/IDAssetCRMWS&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/IDAssetDa"&gt;&lt;IDAssetDa&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDAssetDa"/&gt;&lt;/IDAssetDa&gt;&lt;/xsl:if&gt;&lt;DES&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:DEC"/&gt;&lt;/DES&gt;&lt;ORA_DES&gt;&lt;xsl:value-of select="tib:parse-time(&amp;quot;yyyy-MM-dd&amp;quot;,xsd:string($ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:DEC ))"/&gt;&lt;/ORA_DES&gt;&lt;tipologiaAccesso&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/tipologiaAccesso"/&gt;&lt;/tipologiaAccesso&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/RO"&gt;&lt;RO&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/RO"/&gt;&lt;/RO&gt;&lt;/xsl:if&gt;&lt;offerta&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/offerta"/&gt;&lt;/offerta&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/lineaRiferimento"&gt;&lt;lineaRiferimento&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/lineaRiferimento"/&gt;&lt;/lineaRiferimento&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/complesso"&gt;&lt;complesso&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/complesso"/&gt;&lt;/complesso&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/interno"&gt;&lt;interno&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/interno"/&gt;&lt;/interno&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/piano"&gt;&lt;piano&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/piano"/&gt;&lt;/piano&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/scala"&gt;&lt;scala&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/scala"/&gt;&lt;/scala&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="$Start/ns2:Asset_Now/dettaglioasset[nomeComponente!='ACCESSONGAFTTCAB' and nomeComponente!='ACCESSONGAFTTH' and nomeComponente!='ACCESSOVULAFTTCAB' and nomeComponente!='ACCESSOVULAFTTH' and nomeComponente!='USERVLAN']"&gt;&lt;dettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;xsl:if test="IDDettaglioAssetParent"&gt;&lt;IDDettaglioAssetParent&gt;&lt;xsl:value-of select="IDDettaglioAssetParent"/&gt;&lt;/IDDettaglioAssetParent&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDDettaglioAssetRoot"&gt;&lt;IDDettaglioAssetRoot&gt;&lt;xsl:value-of select="IDDettaglioAssetRoot"/&gt;&lt;/IDDettaglioAssetRoot&gt;&lt;/xsl:if&gt;&lt;integrationID&gt;&lt;xsl:value-of select="integrationID"/&gt;&lt;/integrationID&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;nomeComponente&gt;&lt;xsl:value-of select="nomeComponente"/&gt;&lt;/nomeComponente&gt;&lt;xsl:copy-of select="attributidettaglioasset"/&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="statoDettaglioAsset"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="progressivo"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;xsl:choose&gt;&lt;xsl:when test="not(exists($ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA))"&gt;&lt;xsl:for-each select="$Start/ns2:Asset_Now/dettaglioasset[nomeComponente='ACCESSONGAFTTCAB' or nomeComponente='ACCESSONGAFTTH' or nomeComponente='ACCESSOVULAFTTCAB' or nomeComponente='ACCESSOVULAFTTH' ]"&gt;&lt;dettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;xsl:if test="IDDettaglioAssetParent"&gt;&lt;IDDettaglioAssetParent&gt;&lt;xsl:value-of select="IDDettaglioAssetParent"/&gt;&lt;/IDDettaglioAssetParent&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDDettaglioAssetRoot"&gt;&lt;IDDettaglioAssetRoot&gt;&lt;xsl:value-of select="IDDettaglioAssetRoot"/&gt;&lt;/IDDettaglioAssetRoot&gt;&lt;/xsl:if&gt;&lt;integrationID&gt;&lt;xsl:value-of select="integrationID"/&gt;&lt;/integrationID&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;nomeComponente&gt;&lt;xsl:value-of select="nomeComponente"/&gt;&lt;/nomeComponente&gt;&lt;xsl:for-each select="attributidettaglioasset"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="nomeAttributo"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="valoreAttributo"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="tipologiaDato"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="statoDettaglioAsset"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="progressivo"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:for-each select="$CreateDettaglioAsset/ns:DettaglioAsset[nomeComponente='ACCESSONGAFTTCAB' or nomeComponente='ACCESSONGAFTTH' or nomeComponente='ACCESSOVULAFTTCAB' or nomeComponente='ACCESSOVULAFTTH']"&gt;&lt;dettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;xsl:if test="IDDettaglioAssetParent"&gt;&lt;IDDettaglioAssetParent&gt;&lt;xsl:value-of select="IDDettaglioAssetParent"/&gt;&lt;/IDDettaglioAssetParent&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDDettaglioAssetRoot"&gt;&lt;IDDettaglioAssetRoot&gt;&lt;xsl:value-of select="IDDettaglioAssetRoot"/&gt;&lt;/IDDettaglioAssetRoot&gt;&lt;/xsl:if&gt;&lt;integrationID&gt;&lt;xsl:value-of select="integrationID"/&gt;&lt;/integrationID&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;nomeComponente&gt;&lt;xsl:value-of select="nomeComponente"/&gt;&lt;/nomeComponente&gt;&lt;xsl:copy-of select="attributidettaglioasset"/&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="statoDettaglioAsset"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="progressivo"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:USERVLAN)&gt;0"&gt;&lt;xsl:for-each select="$CreateDettaglioAsset/ns:DettaglioAsset[nomeComponente='USERVLAN']"&gt;&lt;dettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;xsl:if test="IDDettaglioAssetParent"&gt;&lt;IDDettaglioAssetParent&gt;&lt;xsl:value-of select="IDDettaglioAssetParent"/&gt;&lt;/IDDettaglioAssetParent&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDDettaglioAssetRoot"&gt;&lt;IDDettaglioAssetRoot&gt;&lt;xsl:value-of select="IDDettaglioAssetRoot"/&gt;&lt;/IDDettaglioAssetRoot&gt;&lt;/xsl:if&gt;&lt;integrationID&gt;&lt;xsl:value-of select="integrationID"/&gt;&lt;/integrationID&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;nomeComponente&gt;&lt;xsl:value-of select="nomeComponente"/&gt;&lt;/nomeComponente&gt;&lt;xsl:copy-of select="attributidettaglioasset"/&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="statoDettaglioAsset"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="progressivo"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:for-each select="$Start/ns2:Asset_Now/dettaglioasset[nomeComponente='USERVLAN']"&gt;&lt;dettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;xsl:if test="IDDettaglioAssetParent"&gt;&lt;IDDettaglioAssetParent&gt;&lt;xsl:value-of select="IDDettaglioAssetParent"/&gt;&lt;/IDDettaglioAssetParent&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDDettaglioAssetRoot"&gt;&lt;IDDettaglioAssetRoot&gt;&lt;xsl:value-of select="IDDettaglioAssetRoot"/&gt;&lt;/IDDettaglioAssetRoot&gt;&lt;/xsl:if&gt;&lt;integrationID&gt;&lt;xsl:value-of select="integrationID"/&gt;&lt;/integrationID&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;nomeComponente&gt;&lt;xsl:value-of select="nomeComponente"/&gt;&lt;/nomeComponente&gt;&lt;xsl:copy-of select="attributidettaglioasset"/&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="statoDettaglioAsset"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="progressivo"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/DESPrimoOrdine"&gt;&lt;DESPrimoOrdine&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/DESPrimoOrdine"/&gt;&lt;/DESPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/CAP"&gt;&lt;CAP&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/CAP"/&gt;&lt;/CAP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/codiceISTATComune"&gt;&lt;codiceISTATComune&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/codiceISTATComune"/&gt;&lt;/codiceISTATComune&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/codiceISTATProvincia"&gt;&lt;codiceISTATProvincia&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/codiceISTATProvincia"/&gt;&lt;/codiceISTATProvincia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/codiceToponomastica"&gt;&lt;codiceToponomastica&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/codiceToponomastica"/&gt;&lt;/codiceToponomastica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/comune"&gt;&lt;comune&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/comune"/&gt;&lt;/comune&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/descrPartToponomastica"&gt;&lt;descrPartToponomastica&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/descrPartToponomastica"/&gt;&lt;/descrPartToponomastica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/descrizioneVia"&gt;&lt;descrizioneVia&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/descrizioneVia"/&gt;&lt;/descrizioneVia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/localita"&gt;&lt;localita&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/localita"/&gt;&lt;/localita&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/numeroCivico"&gt;&lt;numeroCivico&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/numeroCivico"/&gt;&lt;/numeroCivico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/provincia"&gt;&lt;provincia&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/provincia"/&gt;&lt;/provincia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/siglaProvincia"&gt;&lt;siglaProvincia&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/siglaProvincia"/&gt;&lt;/siglaProvincia&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:DISTRETTO)=2"&gt;&lt;distretto&gt;&lt;xsl:value-of select="tib:pad-front($ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:DISTRETTO, 3, '0')"/&gt;&lt;/distretto&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:DISTRETTO)=3"&gt;&lt;xsl:if test="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:DISTRETTO"&gt;&lt;distretto&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:DISTRETTO"/&gt;&lt;/distretto&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:DISTRETTO)=4"&gt;&lt;distretto&gt;&lt;xsl:value-of select="substring($ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:DISTRETTO,2,3)"/&gt;&lt;/distretto&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:CLLI"&gt;&lt;CLLI&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:CLLI"/&gt;&lt;/CLLI&gt;&lt;/xsl:if&gt;&lt;CRMOrigine&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/CRMOrigine"/&gt;&lt;/CRMOrigine&gt;&lt;xsl:if test="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:SLA/ns4:SLAASSURANCE"&gt;&lt;codiceSLAAssurance&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:SLA/ns4:SLAASSURANCE"/&gt;&lt;/codiceSLAAssurance&gt;&lt;/xsl:if&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:RISORSA"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDOfferta&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDOfferta"/&gt;&lt;/IDOfferta&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/indirizzoEstesoNonCert"&gt;&lt;indirizzoEstesoNonCert&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/indirizzoEstesoNonCert"/&gt;&lt;/indirizzoEstesoNonCert&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:AGGIUNTIVO"&gt;&lt;numeroFittizio&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:AGGIUNTIVO"/&gt;&lt;/numeroFittizio&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/codificaOLOAGCOMDonating"&gt;&lt;codificaOLOAGCOMDonating&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/codificaOLOAGCOMDonating"/&gt;&lt;/codificaOLOAGCOMDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/codificaOLOAGCOMDonor"&gt;&lt;codificaOLOAGCOMDonor&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/codificaOLOAGCOMDonor"/&gt;&lt;/codificaOLOAGCOMDonor&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/codificaOLONOWDonating"&gt;&lt;codificaOLONOWDonating&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/codificaOLONOWDonating"/&gt;&lt;/codificaOLONOWDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/codificaOLONOWDonor"&gt;&lt;codificaOLONOWDonor&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/codificaOLONOWDonor"/&gt;&lt;/codificaOLONOWDonor&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/tipologiaScenario"&gt;&lt;tipologiaScenario&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/tipologiaScenario"/&gt;&lt;/tipologiaScenario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/totaleOrdinePacchetto"&gt;&lt;totaleOrdinePacchetto&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/totaleOrdinePacchetto"/&gt;&lt;/totaleOrdinePacchetto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/IDCorrelazione"&gt;&lt;IDCorrelazione&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDCorrelazione"/&gt;&lt;/IDCorrelazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/numTelPrincipale"&gt;&lt;numTelPrincipale&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/numTelPrincipale"/&gt;&lt;/numTelPrincipale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/codiceFatturazioneJPUB"&gt;&lt;codiceFatturazioneJPUB&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/codiceFatturazioneJPUB"/&gt;&lt;/codiceFatturazioneJPUB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/CRMEstrattore"&gt;&lt;CRMEstrattore&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/CRMEstrattore"/&gt;&lt;/CRMEstrattore&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/IDRichiestaOLD"&gt;&lt;IDRichiestaOLD&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDRichiestaOLD"/&gt;&lt;/IDRichiestaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($Start/ns2:Asset_Now/cliente)"&gt;&lt;cliente&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/cliente/IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/cliente/created"/&gt;&lt;/created&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/cliente/lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/cliente/lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/cliente/codiceFiscale"&gt;&lt;codiceFiscale&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/cliente/codiceFiscale"/&gt;&lt;/codiceFiscale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/cliente/cognomeRagioneSociale"&gt;&lt;cognomeRagioneSociale&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/cliente/cognomeRagioneSociale"/&gt;&lt;/cognomeRagioneSociale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/cliente/nome"&gt;&lt;nome&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/cliente/nome"/&gt;&lt;/nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/cliente/partitaIVA"&gt;&lt;partitaIVA&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/cliente/partitaIVA"/&gt;&lt;/partitaIVA&gt;&lt;/xsl:if&gt;&lt;/cliente&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/modalitaFatturazione"&gt;&lt;modalitaFatturazione&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/modalitaFatturazione"/&gt;&lt;/modalitaFatturazione&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:RISORSA_OLD)&gt;0"&gt;&lt;xsl:if test="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:RISORSA_OLD"&gt;&lt;IDRisorsaOLD&gt;&lt;xsl:value-of select="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:RISORSA_OLD"/&gt;&lt;/IDRisorsaOLD&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/IDRisorsaOLD"&gt;&lt;IDRisorsaOLD&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDRisorsaOLD"/&gt;&lt;/IDRisorsaOLD&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:TIPOLINEA='LineaNonFonia' or upper-case($ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:VULA_NGA/ns4:TIPOLINEA)='LINEANONFONIA'"/&gt;&lt;xsl:when test="$Correlazione/ns3:Output_Correlazione='Y'"&gt;&lt;xsl:if test="$Correlazione/ns3:IdRisosaCorrelazione"&gt;&lt;IDRisorsaCorrelato&gt;&lt;xsl:value-of select="$Correlazione/ns3:IdRisosaCorrelazione"/&gt;&lt;/IDRisorsaCorrelato&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/IDRisorsaCorrelato"&gt;&lt;IDRisorsaCorrelato&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDRisorsaCorrelato"/&gt;&lt;/IDRisorsaCorrelato&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns2:Asset&gt;&lt;/tns2:Input&gt;&lt;/tns2:Update&gt;&lt;/tns2:Input&gt;&lt;/part1&gt;&lt;/ns1:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:ns2=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:ns4=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNGAVULA/&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneNGA.xsd&quot; xmlns:ns3=&quot;http://www.tim.now.WLR_CorrelationProcess&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseCRM&quot;/>&#xa;    &lt;xsl:param name=&quot;FindContrattoOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateDettaglioAsset&quot;/>&#xa;    &lt;xsl:param name=&quot;Correlazione&quot;/>&#xa;    &lt;xsl:param name=&quot;FindContrOff&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateCaseData-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;tns2:Update>&#xa;                &lt;tns2:Input>&#xa;                    &lt;tns2:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns2:CaseReference&quot;/>&#xa;                    &lt;/tns2:CaseReference>&#xa;                    &lt;tns2:Asset>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:CODICEORDINEOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:CODICE_ORDINE_TI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:CODICE_ORDINE_TI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/invariante&quot;>&#xa;                            &lt;invariante>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/invariante&quot;/>&#xa;                            &lt;/invariante>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDPrimoOrdine&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDPrimoOrdine&quot;/>&#xa;                            &lt;/IDPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:SERVIZIO=('04', '05', '06', '07', '08', '09', '10', '11', '12', '13', '14','15')&quot;>&#xa;                                &lt;IDContratto>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($FindContrOff/ns2:ID_CONTRATTO))&quot;/>&#xa;                                &lt;/IDContratto>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;IDContratto>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($FindContrattoOfferta/ns2:ID_CONTRATTO))&quot;/>&#xa;                                &lt;/IDContratto>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/DEC&quot;>&#xa;                            &lt;DEC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/DEC&quot;/>&#xa;                            &lt;/DEC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/statoAsset&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns4:SERVIZIO/ns4:VARIAZIONE/ns4:RISORSA&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Correlazione/ns3:Output_Correlazione='Y' and $Correlazione/ns3:Tipologia=&amp;quot;Tipologia_2&amp;quot; &quot;>&#xa;                                &lt;numeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/numeroTelefonico>&#xa;                            &lt;/xsl:when>&#xa;                