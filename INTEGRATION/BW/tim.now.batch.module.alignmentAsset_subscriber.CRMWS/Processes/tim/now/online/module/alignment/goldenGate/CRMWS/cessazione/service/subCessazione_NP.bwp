;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/codificaOLONOWDonating"&gt;&lt;codificaOLONOWDonating&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/codificaOLONOWDonating"/&gt;&lt;/codificaOLONOWDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/codificaOLONOWDonor"&gt;&lt;codificaOLONOWDonor&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/codificaOLONOWDonor"/&gt;&lt;/codificaOLONOWDonor&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/tipologiaScenario"&gt;&lt;tipologiaScenario&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/tipologiaScenario"/&gt;&lt;/tipologiaScenario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/totaleOrdinePacchetto"&gt;&lt;totaleOrdinePacchetto&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/totaleOrdinePacchetto"/&gt;&lt;/totaleOrdinePacchetto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/IDCorrelazione"&gt;&lt;IDCorrelazione&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/IDCorrelazione"/&gt;&lt;/IDCorrelazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/numeroTelefonico"&gt;&lt;numTelPrincipale&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/numeroTelefonico"/&gt;&lt;/numTelPrincipale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/codiceFatturazioneJPUB"&gt;&lt;codiceFatturazioneJPUB&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/codiceFatturazioneJPUB"/&gt;&lt;/codiceFatturazioneJPUB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/CRMEstrattore"&gt;&lt;CRMEstrattore&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/CRMEstrattore"/&gt;&lt;/CRMEstrattore&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/IDRichiestaOLD"&gt;&lt;IDRichiestaOLD&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/IDRichiestaOLD"/&gt;&lt;/IDRichiestaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($FindAsset/part1/tns:Output/tns:Find/tns:Asset/cliente)"&gt;&lt;cliente&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/cliente/IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/cliente/created"/&gt;&lt;/created&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/cliente/lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/cliente/lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/cliente/codiceFiscale"&gt;&lt;codiceFiscale&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/cliente/codiceFiscale"/&gt;&lt;/codiceFiscale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/cliente/cognomeRagioneSociale"&gt;&lt;cognomeRagioneSociale&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/cliente/cognomeRagioneSociale"/&gt;&lt;/cognomeRagioneSociale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/cliente/nome"&gt;&lt;nome&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/cliente/nome"/&gt;&lt;/nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/cliente/partitaIVA"&gt;&lt;partitaIVA&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/cliente/partitaIVA"/&gt;&lt;/partitaIVA&gt;&lt;/xsl:if&gt;&lt;/cliente&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/LNA_LA"&gt;&lt;LNA_LA&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/LNA_LA"/&gt;&lt;/LNA_LA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/modalitaFatturazione"&gt;&lt;modalitaFatturazione&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/modalitaFatturazione"/&gt;&lt;/modalitaFatturazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/IDRisorsaOLD"&gt;&lt;IDRisorsaOLD&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/IDRisorsaOLD"/&gt;&lt;/IDRisorsaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/IDRisorsaCorrelato"&gt;&lt;IDRisorsaCorrelato&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/IDRisorsaCorrelato"/&gt;&lt;/IDRisorsaCorrelato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/operatoreRete"&gt;&lt;operatoreRete&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/operatoreRete"/&gt;&lt;/operatoreRete&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/opzioneDinamica"&gt;&lt;opzioneDinamica&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/opzioneDinamica"/&gt;&lt;/opzioneDinamica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/IDRisorsaOperatoreRete"&gt;&lt;IDRisorsaOperatoreRete&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/IDRisorsaOperatoreRete"/&gt;&lt;/IDRisorsaOperatoreRete&gt;&lt;/xsl:if&gt;&lt;/tns:Asset&gt;&lt;/tns:Input&gt;&lt;/tns:Update&gt;&lt;/tns:Input&gt;&lt;/part1&gt;&lt;/ns:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindAsset.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Update>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:CaseReference&quot;/>&#xa;                    &lt;/tns:CaseReference>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/codiceOrdineOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/codiceOrdineTI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/codiceOrdineTI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/invariante&quot;>&#xa;                            &lt;invariante>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/invariante&quot;/>&#xa;                            &lt;/invariante>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/IDPrimoOrdine&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/IDPrimoOrdine&quot;/>&#xa;                            &lt;/IDPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/IDContratto&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/DEC&quot;>&#xa;                            &lt;DEC>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/DEC&quot;/>&#xa;                            &lt;/DEC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/statoAsset&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/IDRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/numeroTelefonico&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/numeroTelefonico&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/IDAssetCRMWS&quot;>&#xa;                            &lt;IDAssetCRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/IDAssetCRMWS&quot;/>&#xa;                            &lt;/IDAssetCRMWS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/IDAssetDa&quot;>&#xa;                            &lt;IDAssetDa>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/IDAssetDa&quot;/>&#xa;                            &lt;/IDAssetDa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DES>&#xa;                            &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/DES&quot;/>&#xa;                        &lt;/DES>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/ORA_DES&quot;>&#xa;                            &lt;ORA_DES>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/ORA_DES&quot;/>&#xa;                            &lt;/ORA_DES>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/tipologiaAccesso&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/RO&quot;>&#xa;                            &lt;RO>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/RO&quot;/>&#xa;                            &lt;/RO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/offerta&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/lineaRiferimento&quot;>&#xa;                            &lt;lineaRiferimento>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/lineaRiferimento&quot;/>&#xa;                            &lt;/lineaRiferimento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/complesso&quot;>&#xa;                            &lt;complesso>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/complesso&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/interno&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/interno&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/piano&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/piano&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/scala&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/scala&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/dettaglioasset&quot;>&#xa;                            &lt;dettaglioasset>&#xa;                                &lt;IDAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                &lt;/IDAsset>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                                    &lt;IDDettaglioAssetParent>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                                    &lt;/IDDettaglioAssetParent>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                                    &lt;IDDettaglioAssetRoot>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                                    &lt;/IDDettaglioAssetRoot>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;integrationID>&#xa;                                    &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                &lt;/integrationID>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                                &lt;nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                &lt;/nomeComponente>&#xa;                                &lt;xsl:for-each select=&quot;attributidettaglioasset[nomeAttributo!='CAPOSERIE' and nomeAttributo!='RADICALE']&quot;>&#xa;                                    &lt;attributidettaglioasset>&#xa;                                        &lt;IDAsset>&#xa;                                            &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                        &lt;/IDAsset>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists(nomeAttributo='NUMEROTELEFONICOPRINCIPALE')&quot;>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/numeroTelefonico&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                        &lt;IDDettaglioAsset>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                        &lt;/IDDettaglioAsset>&#xa;                                    &lt;/attributidettaglioasset>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;IDRisorsaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                &lt;/IDRisorsaNOW>&#xa;                                &lt;IDDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                &lt;/IDDettaglioAsset>&#xa;                                &lt;statoDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                                &lt;/statoDettaglioAsset>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioasset>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/DESPrimoOrdine&quot;>&#xa;                            &lt;DESPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/DESPrimoOrdine&quot;/>&#xa;                            &lt;/DESPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/CAP&quot;>&#xa;                            &lt;CAP>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/CAP&quot;/>&#xa;                            &lt;/CAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/codiceISTATComune&quot;>&#xa;                            &lt;codiceISTATComune>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/codiceISTATComune&quot;/>&#xa;                            &lt;/codiceISTATComune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/codiceISTATProvincia&quot;>&#xa;                            &lt;codiceISTATProvincia>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/codiceISTATProvincia&quot;/>&#xa;                            &lt;/codiceISTATProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/codiceToponomastica&quot;>&#xa;                            &lt;codiceToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/codiceToponomastica&quot;/>&#xa;                            &lt;/codiceToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/comune&quot;>&#xa;                            &lt;comune>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[number($index)]/tns:Asset/comune&quot;/>&#xa;                            &lt;/comune>&#xa;     