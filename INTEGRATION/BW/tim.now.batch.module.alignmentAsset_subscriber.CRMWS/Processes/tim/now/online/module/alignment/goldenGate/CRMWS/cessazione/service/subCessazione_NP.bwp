test="IDDettaglioAssetParent"&gt;&lt;IDDettaglioAssetParent&gt;&lt;xsl:value-of select="IDDettaglioAssetParent"/&gt;&lt;/IDDettaglioAssetParent&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDDettaglioAssetRoot"&gt;&lt;IDDettaglioAssetRoot&gt;&lt;xsl:value-of select="IDDettaglioAssetRoot"/&gt;&lt;/IDDettaglioAssetRoot&gt;&lt;/xsl:if&gt;&lt;integrationID&gt;&lt;xsl:value-of select="integrationID"/&gt;&lt;/integrationID&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;nomeComponente&gt;&lt;xsl:value-of select="nomeComponente"/&gt;&lt;/nomeComponente&gt;&lt;xsl:for-each select="attributidettaglioasset[nomeAttributo!='CAPOSERIE' and nomeAttributo!='RADICALE']"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="nomeAttributo"/&gt;&lt;/nomeAttributo&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists(nomeAttributo='NUMEROTELEFONICOPRINCIPALE')"&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[number($index)]/tns:Asset/numeroTelefonico"/&gt;&lt;/valoreAttributo&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="valoreAttributo"/&gt;&lt;/valoreAttributo&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="tipologiaDato"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/I