turazione"/&gt;&lt;/modalitaFatturazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/IDRisorsaOLD"&gt;&lt;IDRisorsaOLD&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDRisorsaOLD"/&gt;&lt;/IDRisorsaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns:Asset_Now/IDRisorsaCorrelato"&gt;&lt;IDRisorsaCorrelato&gt;&lt;xsl:value-of select="$Start/ns:Asset_Now/IDRisorsaCorrelato"/&gt;&lt;/IDRisorsaCorrelato&gt;&lt;/xsl:if&gt;&lt;/tns:Asset&gt;&lt;/tns:Input&gt;&lt;/tns:Update&gt;&lt;/tns:Input&gt;&lt;/part1&gt;&lt;/ns1:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:ns2=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseCRM&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateCase-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Update>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:CaseReference&quot;/>&#xa;                    &lt;/tns:CaseReference>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns2:SERVIZIO/ns2:NPG/ns2:CESSAZIONE/ns2:CODICEORDINEOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns2:SERVIZIO/ns2:NPG/ns2:CESSAZIONE/ns2:CODICE_ORDINE_TI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns2:SERVIZIO/ns2:NPG/ns2:CESSAZIONE/ns2:CODICE_ORDINE_TI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/invariante&quot;>&#xa;                            &lt;invariante>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/invariante&quot;/>&#xa;                            &lt;/invariante>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDPrimoOrdine&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDPrimoOrdine&quot;/>&#xa;                            &lt;/IDPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDContratto&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns2:SERVIZIO/ns2:NPG/ns2:CESSAZIONE/ns2:DEC&quot;>&#xa;                            &lt;DEC>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns2:SERVIZIO/ns2:NPG/ns2:CESSAZIONE/ns2:DEC&quot;/>&#xa;                            &lt;/DEC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;'CESSATO'&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/numeroTelefonico&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/numeroTelefonico&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseCRM/ns2:SERVIZIO/ns2:NPG/ns2:CESSAZIONE/ns2:ID_CRMWS)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns2:SERVIZIO/ns2:NPG/ns2:CESSAZIONE/ns2:ID_CRMWS&quot;>&#xa;                                    &lt;IDAssetCRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns2:SERVIZIO/ns2:NPG/ns2:CESSAZIONE/ns2:ID_CRMWS&quot;/>&#xa;                                    &lt;/IDAssetCRMWS>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDAssetCRMWS&quot;>&#xa;                                    &lt;IDAssetCRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDAssetCRMWS&quot;/>&#xa;                                    &lt;/IDAssetCRMWS>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDAssetDa&quot;>&#xa;                            &lt;IDAssetDa>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDAssetDa&quot;/>&#xa;                            &lt;/IDAssetDa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DES>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns2:SERVIZIO/ns2:NPG/ns2:CESSAZIONE/ns2:DEC&quot;/>&#xa;                        &lt;/DES>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/ORA_DES&quot;>&#xa;                            &lt;ORA_DES>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/ORA_DES&quot;/>&#xa;                            &lt;/ORA_DES>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/tipologiaAccesso&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/RO&quot;>&#xa;                            &lt;RO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/RO&quot;/>&#xa;                            &lt;/RO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/offerta&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/lineaRiferimento&quot;>&#xa;                            &lt;lineaRiferimento>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/lineaRiferimento&quot;/>&#xa;                            &lt;/lineaRiferimento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/complesso&quot;>&#xa;                            &lt;complesso>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/complesso&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/interno&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/interno&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/piano&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/piano&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/scala&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/scala&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Start/ns:Asset_Now/dettaglioasset&quot;>&#xa;                            &lt;dettaglioasset>&#xa;                                &lt;IDAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                &lt;/IDAsset>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                                    &lt;IDDettaglioAssetParent>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                                    &lt;/IDDettaglioAssetParent>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                                    &lt;IDDettaglioAssetRoot>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                                    &lt;/IDDettaglioAssetRoot>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;integrationID>&#xa;                                    &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                &lt;/integrationID>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                                &lt;nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                &lt;/nomeComponente>&#xa;                                &lt;xsl:for-each select=&quot;attributidettaglioasset&quot;>&#xa;                                    &lt;attributidettaglioasset>&#xa;                                        &lt;IDAsset>&#xa;                                            &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                        &lt;/IDAsset>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                        &lt;IDDettaglioAsset>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                        &lt;/IDDettaglioAsset>&#xa;                                    &lt;/attributidettaglioasset>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;IDRisorsaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                &lt;/IDRisorsaNOW>&#xa;                                &lt;IDDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                &lt;/IDDettaglioAsset>&#xa;                                &lt;statoDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;'CESSATO'&quot;/>&#xa;                                &lt;/statoDettaglioAsset>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioasset>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/DESPrimoOrdine&quot;>&#xa;                            &lt;DESPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/DESPrimoOrdine&quot;/>&#xa;                            &lt;/DESPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/CAP&quot;>&#xa;                            &lt;CAP>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/CAP&quot;/>&#xa;                            &lt;/CAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/codiceISTATComune&quot;>&#xa;                            &lt;codiceISTATComune>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codiceISTATComune&quot;/>&#xa;                            &lt;/codiceISTATComune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/codiceISTATProvincia&quot;>&#xa;                            &lt;codiceISTATProvincia>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codiceISTATProvincia&quot;/>&#xa;                            &lt;/codiceISTATProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:Asset_Now/codiceToponomastica&quot;>&#xa;                            &lt;codiceToponomastica>&#xa;                                &lt;xsl:value-of sele