O)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseCRM/ns:SERVIZIO/ns:ATTIVAZIONE/ns:ATM) and string-length($ParseCRM/ns:SERVIZIO/ns:ATTIVAZIONE/ns:ATM/ns:TIPOLINEA)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseCRM/ns:SERVIZIO/ns:ATTIVAZIONE/ns:ATM) and string-length($ParseCRM/ns:SERVIZIO/ns:ATTIVAZIONE/ns:ATM/ns:PROFILOTECNICOLINEA)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseCRM/ns:SERVIZIO/ns:ATTIVAZIONE/ns:ATM) and string-length($ParseCRM/ns:SERVIZIO/ns:ATTIVAZIONE/ns:ATM/ns:DISTRETTOTELEFONICO)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Check>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Check>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:for-each select=&quot;$ParseCRM/ns:SERVIZIO/ns:ATTIVAZIONE/ns:ATM/ns:DATIVC&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(ns:IdRisorsaVC)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(ns:PROFILOVC) and string-length(ns:PROFILOVC/ns:TIPOPROFILOVC)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Check>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Check>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;/tns:Check_Dati>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
