ovincia>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Toponomastica/Record[1]/COUNT=1&quot;>&lt;codiceToponomastica>&lt;xsl:value-of select=&quot;concat($ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:ISTATPROV,'_',$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:CODICECOMUNE,'_',$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:CODESTRADA,'_',$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:CIVICO)&quot;/>&lt;/codiceToponomastica>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:PARTICELLATOPONOMASTICA&quot;>&lt;descrPartToponomastica>&lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:PARTICELLATOPONOMASTICA&quot;/>&lt;/descrPartToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:VIA&quot;>&lt;descrizioneVia>&lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:VIA&quot;/>&lt;/descrizioneVia>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:LOCALITA&quot;>&lt;localita>&lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:LOCALITA&quot;/>&lt;/localita>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:CIVICO&quot;>&lt;numeroCivico>&lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:CIVICO&quot;/>&lt;/numeroCivico>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Toponomastica/Record[1]/COUNT=1&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:PROVINCIA&quot;>&lt;provincia>&lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:PROVINCIA&quot;/>&lt;/provincia>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Toponomastica/Record[1]