                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeXDSLATM/&quot; xmlns:ns2=&quot;http://www.tim.now.WLR_CorrelationProcess&quot; xmlns:tns1=&quot;www.tim.now.maxNumber&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CreateCase&quot;/>&lt;xsl:param name=&quot;ParseCRM&quot;/>&lt;xsl:param name=&quot;Check_Dati&quot;/>&lt;xsl:param name=&quot;Correlazione&quot;/>&lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$CreateCase/part1/tns:Output/tns:Create/tns:Response/tns:Esito = &amp;quot;OK&amp;quot;&quot;>&lt;ns:output>&lt;xsl:choose>&lt;xsl:when test=&quot;$Check_Dati/tns1:Check[1]='KO'&quot;>&lt;ns:FlagCorrelazione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/ns:FlagCorrelazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$Correlazione/ns2:Output_Correlazione='Y'&quot;>&lt;ns:FlagCorrelazione>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/ns:FlagCorrelazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:FlagCorrelazione>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/ns:FlagCorrelazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:ATM/ns1:DN&quot;>&lt;ns:DN>&lt;xsl:value-of select=&quot;$ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:ATM/ns1:DN&quot;/>&lt;/ns:DN>&lt;/xsl:if>&lt;xsl:if test=&quot;$CreateCase/part1/tns:Output/tns:Create/tns:AssetNow&quot;>&lt;ns:IdAssetNow>&lt;xsl:value-of select=&quot;$CreateCase/part1/tns:Output/tns:Create/tns:AssetNow&quot;/>&lt;/ns:IdAssetNow>&lt;/xsl:if>&lt;ns:OGG_Request>&lt;xsl:choose>&lt;xsl:when test=&quot;$Check_Dati/tns1:Check[1]='KO'&quot;>&lt;ns:St