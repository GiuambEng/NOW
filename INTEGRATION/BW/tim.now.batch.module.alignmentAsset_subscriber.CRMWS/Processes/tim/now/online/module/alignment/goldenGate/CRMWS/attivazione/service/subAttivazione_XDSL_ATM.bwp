                   &lt;/ns:OGG_Response>&#xa;                &lt;/ns:output>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:output>&#xa;                    &lt;ns:FlagCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                    &lt;/ns:FlagCorrelazione>&#xa;                    &lt;ns:OGG_Request>&#xa;                        &lt;ns:Stato>&#xa;                            &lt;xsl:value-of select=&quot;'LAVORATO'&quot;/>&#xa;                        &lt;/ns:Stato>&#xa;                    &lt;/ns:OGG_Request>&#xa;                    &lt;ns:OGG_Response>&#xa;                        &lt;ns:ReturnCode>&#xa;                            &lt;xsl:value-of select=&quot;'99'&quot;/>&#xa;                        &lt;/ns:ReturnCode>&#xa;                        &lt;ns:Stato>&#xa;                            &lt;xsl:value-of select=&quot;'DA LAVORARE'&quot;/>&#xa;                        &lt;/ns:Stato>&#xa;                        &lt;ns:Message>&#xa;                            &lt;xsl:value-of select=&quot;'ERRORE GENERICO'&quot;/>&#xa;                        &lt;/ns:Message>&#xa;                    &lt;/ns:OGG_Response>&#xa;                &lt;/ns:output>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
