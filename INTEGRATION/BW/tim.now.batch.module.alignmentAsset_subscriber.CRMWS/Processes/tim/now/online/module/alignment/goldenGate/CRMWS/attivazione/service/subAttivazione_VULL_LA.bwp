M/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:DISTR_TELEFONICO)=3&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:DISTR_TELEFONICO&quot;>&#xa;                                    &lt;distretto>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:DISTR_TELEFONICO&quot;/>&#xa;                                    &lt;/distretto>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:DISTR_TELEFONICO)=4&quot;>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;substring($ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:DISTR_TELEFONICO,2,3)&quot;/>&#xa;                                &lt;/distretto>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:CLLI_CENTRALE&quot;>&#xa;                            &lt;CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:CLLI_CENTRALE&quot;/>&#xa;                            &lt;/CLLI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CRMOrigine>&#xa;                            &lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&#xa;                        &lt;/CRMOrigine>&#xa;                        &lt;IDRisorsaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:RISORSA&quot;/>&#xa;                        &lt;/IDRisorsaNOW>&#xa;                        &lt;IDOfferta>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:IdOf