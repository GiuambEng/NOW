reated>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;nomeComponente&quot;/>&lt;/nomeComponente>&lt;xsl:for-each select=&quot;attributidettaglioasset&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;/xsl:for-each>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&lt;/IDRisorsaNOW>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;statoDettaglioAsset>&lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&lt;/statoDettaglioAsset>&lt;progressivo>&lt;xsl:value-of select=&quot;progressivo&quot;/>&lt;/progressivo>&lt;/dettaglioasset>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/DESPrimoOrdine&quot;>&lt;DESPrimoOrdine>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/DESPrimoOrdine&quot;/>&lt;/DESPrimoOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/CAP&quot;>&lt;CAP>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/CAP&quot;/>&lt;/CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/codiceISTATComune&quot;>&lt;codiceISTATComune>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/codiceISTATComune&quot;/>&lt;/codiceISTATComune>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/codiceISTATProvincia&quot;>&lt;codiceISTATProvincia>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/codiceISTATProvincia&quot;/>&lt;/codiceISTATProvincia>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/codiceToponomastica&quot;>&lt;codiceToponomastica>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/codiceToponomastica&quot;/>&lt;/codiceToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/comune&quot;>&lt;comune>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/comune&quot;/>&lt;/comune>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/descrPartToponomastica&quot;>&lt;descrPartToponomastica>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/descrPartToponomastica&quot;/>&lt;/descrPartToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/descrizioneVia&quot;>&lt;descrizioneVia>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/descrizioneVia&quot;/>&lt;/descrizioneVia>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/localita&quot;>&lt;localita>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/localita&quot;/>&lt;/localita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/numeroCivico&quot;>&lt;numeroCivico>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/numeroCivico&quot;/>&lt;/numeroCivico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/provincia&quot;>&lt;provi