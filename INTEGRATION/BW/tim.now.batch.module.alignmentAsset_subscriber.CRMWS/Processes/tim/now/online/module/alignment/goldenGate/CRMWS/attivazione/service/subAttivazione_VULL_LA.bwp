se&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Toponomastica/Record[1]/COUNT=1"/&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:SEDE/ns3:LOCALITA"&gt;&lt;localita&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:SEDE/ns3:LOCALITA"/&gt;&lt;/localita&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Toponomastica/Record[1]/COUNT=1"/&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:SEDE/ns3:CIVICO"&gt;&lt;numeroCivico&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:SEDE/ns3:CIVICO"/&gt;&lt;/numeroCivico&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Toponomastica/Record[1]/COUNT=1"/&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:SEDE/ns3:PROVINCIA"&gt;&lt;provincia&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:SEDE/ns3:PROVINCIA"/&gt;&lt;/provincia&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Toponomastica/Record[1]/COUNT=1"/&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:SEDE/ns3:SIGLAPROVINCIA"&gt;&lt;siglaProvincia&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:SEDE/ns3:SIGLAPROVINCIA"/&gt;&lt;/siglaProvincia&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:DISTR_TELEFONICO)=2"&gt;&lt;distretto&gt;&lt;xsl:value-of select="tib:pad-front($ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:DISTR_TELEFONICO, 3, '0')"/&gt;&lt;/distretto&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:DISTR_TEL