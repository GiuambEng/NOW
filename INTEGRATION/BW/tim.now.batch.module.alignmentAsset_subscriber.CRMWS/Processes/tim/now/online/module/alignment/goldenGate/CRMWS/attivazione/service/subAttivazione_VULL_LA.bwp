                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tim.now.WLR_CorrelationProcess&quot; xmlns:ns2=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:template name=&quot;Correlazione-input&quot; match=&quot;/&quot;>&lt;ns1:Input_Main>&lt;ns1:IdAssetNow>&lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDAsset&quot;/>&lt;/ns1:IdAssetNow>&lt;ns1:Asset_Now>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/IDAsset&quot;>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/IDAsset&quot;/>&lt;/IDAsset>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/codiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/codiceOrdineTI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/codiceOrdineTI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/invariante&quot;>&lt;invariante>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/invariante&quot;/>&lt;/invariante>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/created&quot;/>&lt;/created>&lt;xsl:if test=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;$Mapper/tns:Create/tns:Input/tns:Asset/oper