&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:CAPOSTIPITE)&gt;0"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="&amp;quot;CAPOSTIPITE&amp;quot;"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:CAPOSTIPITE"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:RISORSA"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="&amp;quot;ATTIVO&amp;quot;"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="1"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:DEC"&gt;&lt;DESPrimoOrdine&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:DEC"/&gt;&lt;/DESPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Toponomastica/Record[1]/COUNT=1"/&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:SEDE/ns3:CAP"&gt;&lt;CAP&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:SEDE/ns3:CAP"/&gt;&lt;/CAP&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl