            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns2=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns3=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeVULL/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseCRM&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Toponomastica&quot;/>&lt;xsl:param name=&quot;caseType&quot;/>&lt;xsl:param name=&quot;Check1&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Create>&lt;tns:Input>&lt;tns:caseType>&lt;xsl:value-of select=&quot;$caseType&quot;/>&lt;/tns:caseType>&lt;tns:caseModelVersion>&lt;xsl:value-of select=&quot;$caseType&quot;/>&lt;/tns:caseModelVersion>&lt;tns:Asset>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:CODICEORDINEOLO&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:CODICE_ORDINE_TI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:VULL/ns3:ATT_VAR_ACCESSO/ns3:CODICE_ORDINE_TI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:DESCOLO&quot;/>&lt;/codificaOLOAGCOM>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDContratto>&lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Check1/ns2:IdContrattoNOW))&quot;/>&lt;/IDContratto>&lt;statoAsset>&lt;xsl:value-of select=&quot;&amp;