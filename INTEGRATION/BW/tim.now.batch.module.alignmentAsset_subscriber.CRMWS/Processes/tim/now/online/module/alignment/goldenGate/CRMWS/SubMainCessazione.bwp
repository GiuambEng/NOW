                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Cessazione.output&quot;/>&#xa;    &lt;xsl:template name=&quot;CessazioneOutput&quot; match=&quot;/&quot;>&#xa;        &lt;ns:output>&#xa;            &lt;ns:FlagCorrelazione>&#xa;                &lt;xsl:value-of select=&quot;$Cessazione.output/ns:FlagCorrelazione&quot;/>&#xa;            &lt;/ns:FlagCorrelazione>&#xa;            &lt;xsl:if test=&quot;$Cessazione.output/ns:IdContrattoNOW&quot;>&#xa;                &lt;ns:IdContrattoNOW>&#xa;                    &lt;xsl:value-of select=&quot;$Cessazione.output/ns:IdContrattoNOW&quot;/>&#xa;                &lt;/ns:IdContrattoNOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Cessazione.output/ns:DN&quot;>&#xa;                &lt;ns:DN>&#xa;                    &lt;xsl:value-of select=&quot;$Cessazione.output/ns:DN&quot;/>&#xa;                &lt;/ns:DN>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Cessazione.output/ns:IdAssetNow&quot;>&#xa;                &lt;ns:IdAssetNow>&#xa;                    &lt;xsl:value-of select=&quot;$Cessazione.output/ns:IdAssetNow&quot;/>&#xa;                &lt;/ns:IdAssetNow>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:copy-of select=&quot;$Cessazione.output/ns:OGG_Request&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Cessazione.output/ns:OGG_Response&quot;/>&#xa;        &lt;/ns:output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
