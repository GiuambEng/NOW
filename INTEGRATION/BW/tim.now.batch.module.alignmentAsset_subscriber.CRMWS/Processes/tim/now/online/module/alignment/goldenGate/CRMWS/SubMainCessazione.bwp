t;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/tipologiaAccesso&quot;/>&#xa;                    &lt;/tipologiaAccesso>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/RO&quot;>&#xa;                        &lt;RO>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/RO&quot;/>&#xa;                        &lt;/RO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/offerta&quot;/>&#xa;                    &lt;/offerta>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/lineaRiferimento&quot;>&#xa;                        &lt;lineaRiferimento>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/lineaRiferimento&quot;/>&#xa;                        &lt;/lineaRiferimento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/complesso&quot;>&#xa;                        &lt;complesso>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/complesso&quot;/>&#xa;                        &lt;/complesso>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/interno&quot;>&#xa;                        &lt;in