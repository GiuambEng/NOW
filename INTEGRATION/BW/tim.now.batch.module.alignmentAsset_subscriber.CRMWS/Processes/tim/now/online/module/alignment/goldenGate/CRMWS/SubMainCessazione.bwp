            <wsdl:import namespace="http://www.tim.now/abstract/variazione/allineamentoAsset.Crmws.ogg"/>
            <wsdl:import namespace="http://www.tim.now/abstract/cessazione/allineamentoAsset.Crmws.ogg"/>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/ProcessLog"/>
        </wsdl:definitions>
