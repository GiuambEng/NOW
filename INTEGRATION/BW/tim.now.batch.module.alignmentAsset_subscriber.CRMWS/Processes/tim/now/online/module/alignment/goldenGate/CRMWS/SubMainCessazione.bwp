                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Cessazione&quot;/>&lt;xsl:template name=&quot;CessazioneOutput&quot; match=&quot;/&quot;>&lt;ns:output>&lt;ns:FlagCorrelazione>&lt;xsl:value-of select=&quot;$Cessazione/output/ns:output/ns:FlagCorrelazione&quot;/>&lt;/ns:FlagCorrelazione>&lt;xsl:if test=&quot;$Cessazione/output/ns:output/ns:IdContrattoNOW&quot;>&lt;ns:IdContrattoNOW>&lt;xsl:value-of select=&quot;$Cessazione/output/ns:output/ns:IdContrattoNOW&quot;/>&lt;/ns:IdContrattoNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$Cessazione/output/ns:output/ns:DN&quot;>&lt;ns:DN>&lt;xsl:value-of select=&quot;$Cessazione/output/ns:output/ns:DN&quot;/>&lt;/ns:DN>&lt;/xsl:if>&lt;xsl:if test=&quot;$Cessazione/output/ns:output/ns:IdAssetNow&quot;>&lt;ns:IdAssetNow>&lt;xsl:value-of select=&quot;$Cessazione/output/ns:output/ns:IdAssetNow&quot;/>&lt;/ns:IdAssetNow>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$Cessazione/output/ns:output/ns:OGG_Request&quot;/>&lt;xsl:copy-of select=&quot;$Cessazione/output/ns:output/ns:OGG_Response&quot;/>&lt;/ns:output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
