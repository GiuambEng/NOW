t;ns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/ns:CaseReference>&#xa;                    &lt;ns:Clob_CRMWS>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:message/ns1:Message/ns1:MESSAGGIO&quot;/>&#xa;                    &lt;/ns:Clob_CRMWS>&#xa;                &lt;/ns:Input>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
