    xmlns:ns1="http://xmlns.example.com/20170103182100"
    xmlns:ns10="http://www.tim.com/NOW/xsd/FindUpdateCase/"
    xmlns:ns11="http://NOW.it.telecomitalia.it/casedata"
    xmlns:ns12="http://www.tibco.com/namespaces/tnt/plugins/jdbc+b5bc8236-9fe1-42a0-954d-6389e9789aad+input"
