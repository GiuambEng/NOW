/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/comune&quot;/>&#xa;                        &lt;/comune>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/descrPartToponomastica&quot;>&#xa;                        &lt;descrPartToponomastica>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/descrPartToponomastica&quot;/>&#xa;                        &lt;/descrPartToponomastica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/descrizioneVia&quot;>&#xa;                        &lt;descrizioneVia>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/descrizioneVia&quot;/>&#xa;                        &lt;/descrizioneVia>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/localita&quot;>&#xa;                        &lt;localita>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/localita&quot;/>&#xa;                        &lt;/localita>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/numeroCivico&quot;>&#xa;                        &lt;numeroCivico>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/numeroCivico&quot;/>&#xa;                  