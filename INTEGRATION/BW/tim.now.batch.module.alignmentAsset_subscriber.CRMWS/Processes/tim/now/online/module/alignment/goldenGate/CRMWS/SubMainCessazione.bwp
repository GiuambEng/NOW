e>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_NOW&quot;>&lt;tns:value>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_NOW&quot;/>&lt;/tns:value>&lt;/xsl:if>&lt;/tns:NamedParameterAssigned>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_CRMWS)>0 and (string-length($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_NOW)=0 or not(exists($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_NOW)) )&quot;>&lt;tns:NamedParameterAssigned>&lt;tns:name>&lt;xsl:value-of select=&quot;'IDassCRMWS'&quot;/>&lt;/tns:name>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_CRMWS&quot;>&lt;tns:value>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_CRMWS&quot;/>&lt;/tns:value>&lt;/xsl:if>&lt;/tns:NamedParameterAssigned>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:queryStringAPI>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
