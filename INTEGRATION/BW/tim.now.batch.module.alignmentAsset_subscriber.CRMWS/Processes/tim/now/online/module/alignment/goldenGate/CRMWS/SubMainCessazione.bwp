            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:ns1=&quot;www.tim.now.alignmentonline.crmws.main.ogg&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;www.tim.now.check.allineamentoconsistenze.querystring.main.ogg&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;Offerta&quot;/>&lt;xsl:param name=&quot;Asset&quot;/>&lt;xsl:param name=&quot;FindCase&quot;/>&lt;xsl:param name=&quot;trasCodifica&quot;/>&lt;xsl:param name=&quot;BDS_ID_Order&quot;/>&lt;xsl:param name=&quot;CaseType&quot;/>&lt;xsl:param name=&quot;caseModelVersion&quot;/>&lt;xsl:template name=&quot;inputCessazione&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;(count($FindCase/part1/tns:Output/tns:Find)=1 and $FindCase/part1/tns:Output/tns:Find[1]/tns:Asset/statoAsset='ATTIVO') or (count($FindCase/part1/tns:Output/tns:Find)>1 and $BDS_ID_Order/tns1:Record[1]/tns1:Stato='ATTIVO' ) &quot;>&lt;ns:Input>&lt;ns:IdOfferta>&lt;xsl:value-of select=&quot;xsd:int($Offerta/Record[1]/ID_OFFERTA)&quot;/>&lt;/ns:IdOfferta>&lt;xsl:if test=&quot;$Offerta/Record[1]/NOME_OFFERTA_ESTERNA&quot;>&lt;ns:NomeOffertaEsterna>&lt;xsl:value-of select=&quot;$Offerta/Record[1]/NOME_OFFERTA_ESTERNA&quot;/>&lt;/ns:NomeOffertaEsterna>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:message/ns1:Message/ns1:TRANSACTION_ID&quot;>&lt;ns:transactionId_CessatoVariato>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:message/ns1:Message/ns1:TRANSACTION_ID&quot;/>&lt;/ns:transactionId_CessatoVariato>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:message/ns1:Message/ns1:CREATED&quot;>&lt;ns:Created_CessatoVariato>&lt;xsl:value-of select=&quot;$JMSR