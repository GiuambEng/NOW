                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ASSET.IDRISORSACORRELATO, ASSET.IDASSET&#xa;FROM BDS_1_CASEDATA_ASSET ASSET&#xa;WHERE (ASSET.IDRISORSACORRELATO=? AND&#xa;       ASSET.DISTRETTO = ? AND&#xa;       ((ASSET.OFFERTA IN ('VULL','VULLLINEANONATTIVA',&#xa;                        'WLRLINEAATTIVA', 'WLRLINEANONATTIVA')) OR (ASSET.OFFERTA IN ('ULLLINEANONATTIVA', 'SLULINEANONATTIVA') AND&#xa;          ASSET.CODIFICAOLOAGCOM = 'TLC')) AND&#xa;          ASSET.STATOASSET = 'ATTIVO') " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSACORRELATO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DISTRETTO"/>
                                    <columnMetadata
                                    columnName="IDRISORSACORRELATO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
