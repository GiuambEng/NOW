                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ASSET.IDRISORSACORRELATO, ASSET.IDASSET,ASSET.IDRISORSA&#xa;FROM BDS_1_CASEDATA_ASSET ASSET&#xa;WHERE (ASSET.IDRISORSA=? AND&#xa;       ASSET.DISTRETTO = ? AND&#xa;       ((ASSET.OFFERTA IN ('VULL', 'VULLLINEANONATTIVA',&#xa;                        'WLRLINEAATTIVA', 'WLRLINEANONATTIVA')) OR (ASSET.OFFERTA IN ('ULLLINEANONATTIVA', 'SLULINEANONATTIVA') AND&#xa;          ASSET.CODIFICAOLOAGCOM = 'TLC')) AND&#xa;          ASSET.STATOASSET = 'ATTIVO') " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DISTRETTO"/>
                                    <columnMetadata
                                    columnName="IDRISORSACORRELATO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
