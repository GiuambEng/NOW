                            <bpws:transitionCondition><![CDATA[$Risorsa_TGU_Att/codificaOLOAGCOM='TLC' and ($Risorsa_TGU_Att/offerta='ULLLINEANONATTIVA' or $Risorsa_TGU_Att/offerta='SLULINEANONATTIVA' ) and $Risorsa_TGU_Att/distretto=$Start/ns0:Asset/distretto]]></bpws:transitionCondition>
