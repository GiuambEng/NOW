&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/" xmlns:tns="http://www.tim.com/NOW/xsd/FindUpdateCase/" xmlns:ns1="http://www.tim.now.WLR_CorrelationProcess" version="2.0"&gt;&lt;xsl:param name="FindCase_TGU"/&gt;&lt;xsl:param name="Risorsa_TGU_Att"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="UpdateCaseTGU-input" match="/"&gt;&lt;ns:Request&gt;&lt;part1&gt;&lt;tns:Input&gt;&lt;tns:Update&gt;&lt;tns:Input&gt;&lt;tns:CaseReference&gt;&lt;xsl:value-of select="$FindCase_TGU/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO']/tns:CaseReference"/&gt;&lt;/tns:CaseReference&gt;&lt;tns:Asset&gt;&lt;xsl:if test="$Risorsa_TGU_Att/IDAsset"&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/IDAsset"/&gt;&lt;/IDAsset&gt;&lt;/xsl:if&gt;&lt;codiceOrdineOLO&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/codiceOrdineOLO"/&gt;&lt;/codiceOrdineOLO&gt;&lt;xsl:if test="$Risorsa_TGU_Att/codiceOrdineTI"&gt;&lt;codiceOrdineTI&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/codiceOrdineTI"/&gt;&lt;/codiceOrdineTI&gt;&lt;/xsl:if&gt;&lt;codificaOLOAGCOM&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/codificaOLOAGCOM"/&gt;&lt;/codificaOLOAGCOM&gt;&lt;xsl:if test="$Risorsa_TGU_Att/invariante"&gt;&lt;invariante&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/invariante"/&gt;&lt;/invariante&gt;&lt;/xsl:if&gt;&lt;created&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/created"/&gt;&lt;/created&gt;&lt;xsl:if test="$Risorsa_TGU_Att/lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/operatore"/&gt;&lt;/operatore&gt;&lt;xsl:if test="$Risorsa_TGU_Att/IDRichiestaOLO"&gt;&lt;IDRichiestaOLO&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/IDRichiestaOLO"/&gt;&lt;/IDRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/IDPrimoOrdine"&gt;&lt;IDPrimoOrdine&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/IDPrimoOrdine"/&gt;&lt;/IDPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;IDContratto&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/IDContratto"/&gt;&lt;/IDContratto&gt;&lt;xsl:if test="$Risorsa_TGU_Att/DEC"&gt;&lt;DEC&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/DEC"/&gt;&lt;/DEC&gt;&lt;/xsl:if&gt;&lt;statoAsset&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/statoAsset"/&gt;&lt;/statoAsset&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;xsl:if test="$Risorsa_TGU_Att/numeroTelefonico"&gt;&lt;numeroTelefonico&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/numeroTelefonico"/&gt;&lt;/numeroTelefonico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/IDAssetCRMWS"&gt;&lt;IDAssetCRMWS&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/IDAssetCRMWS"/&gt;&lt;/IDAssetCRMWS&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/IDAssetDa"&gt;&lt;IDAssetDa&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/IDAssetDa"/&gt;&lt;/IDAssetDa&gt;&lt;/xsl:if&gt;&lt;DES&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/DES"/&gt;&lt;/DES&gt;&lt;xsl:if test="$Risorsa_TGU_Att/ORA_DES"&gt;&lt;ORA_DES&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/ORA_DES"/&gt;&lt;/ORA_DES&gt;&lt;/xsl:if&gt;&lt;tipologiaAccesso&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/tipologiaAccesso"/&gt;&lt;/tipologiaAccesso&gt;&lt;xsl:if test="$Risorsa_TGU_Att/RO"&gt;&lt;RO&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/RO"/&gt;&lt;/RO&gt;&lt;/xsl:if&gt;&lt;offerta&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/offerta"/&gt;&lt;/offerta&gt;&lt;xsl:if test="$Risorsa_TGU_Att/lineaRiferimento"&gt;&lt;lineaRiferimento&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/lineaRiferimento"/&gt;&lt;/lineaRiferimento&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/complesso"&gt;&lt;complesso&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/complesso"/&gt;&lt;/complesso&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/interno"&gt;&lt;interno&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/interno"/&gt;&lt;/interno&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/piano"&gt;&lt;piano&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/piano"/&gt;&lt;/piano&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/scala"&gt;&lt;scala&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/scala"/&gt;&lt;/scala&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="$Risorsa_TGU_Att/dettaglioasset"&gt;&lt;dettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;xsl:if test="IDDettaglioAssetParent"&gt;&lt;IDDettaglioAssetParent&gt;&lt;xsl:value-of select="IDDettaglioAssetParent"/&gt;&lt;/IDDettaglioAssetParent&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDDettaglioAssetRoot"&gt;&lt;IDDettaglioAssetRoot&gt;&lt;xsl:value-of select="IDDettaglioAssetRoot"/&gt;&lt;/IDDettaglioAssetRoot&gt;&lt;/xsl:if&gt;&lt;integrationID&gt;&lt;xsl:value-of select="integrationID"/&gt;&lt;/integrationID&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;nomeComponente&gt;&lt;xsl:value-of select="nomeComponente"/&gt;&lt;/nomeComponente&gt;&lt;xsl:for-each select="attributidettaglioasset"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="nomeAttributo"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="valoreAttributo"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="tipologiaDato"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="statoDettaglioAsset"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="progressivo"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$Risorsa_TGU_Att/DESPrimoOrdine"&gt;&lt;DESPrimoOrdine&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/DESPrimoOrdine"/&gt;&lt;/DESPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/CAP"&gt;&lt;CAP&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/CAP"/&gt;&lt;/CAP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/codiceISTATComune"&gt;&lt;codiceISTATComune&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/codiceISTATComune"/&gt;&lt;/codiceISTATComune&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/codiceISTATProvincia"&gt;&lt;codiceISTATProvincia&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/codiceISTATProvincia"/&gt;&lt;/codiceISTATProvincia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/codiceToponomastica"&gt;&lt;codiceToponomastica&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/codiceToponomastica"/&gt;&lt;/codiceToponomastica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/comune"&gt;&lt;comune&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/comune"/&gt;&lt;/comune&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/descrPartToponomastica"&gt;&lt;descrPartToponomastica&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/descrPartToponomastica"/&gt;&lt;/descrPartToponomastica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/descrizioneVia"&gt;&lt;descrizioneVia&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/descrizioneVia"/&gt;&lt;/descrizioneVia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/localita"&gt;&lt;localita&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/localita"/&gt;&lt;/localita&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/numeroCivico"&gt;&lt;numeroCivico&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/numeroCivico"/&gt;&lt;/numeroCivico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/provincia"&gt;&lt;provincia&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/provincia"/&gt;&lt;/provincia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/siglaProvincia"&gt;&lt;siglaProvincia&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/siglaProvincia"/&gt;&lt;/siglaProvincia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/distretto"&gt;&lt;distretto&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/distretto"/&gt;&lt;/distretto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/CLLI"&gt;&lt;CLLI&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/CLLI"/&gt;&lt;/CLLI&gt;&lt;/xsl:if&gt;&lt;CRMOrigine&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/CRMOrigine"/&gt;&lt;/CRMOrigine&gt;&lt;xsl:if test="$Risorsa_TGU_Att/codiceSLAAssurance"&gt;&lt;codiceSLAAssurance&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/codiceSLAAssurance"/&gt;&lt;/codiceSLAAssurance&gt;&lt;/xsl:if&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDOfferta&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/IDOfferta"/&gt;&lt;/IDOfferta&gt;&lt;xsl:if test="$Risorsa_TGU_Att/indirizzoEstesoNonCert"&gt;&lt;indirizzoEstesoNonCert&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/indirizzoEstesoNonCert"/&gt;&lt;/indirizzoEstesoNonCert&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/numeroFittizio"&gt;&lt;numeroFittizio&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/numeroFittizio"/&gt;&lt;/numeroFittizio&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/codificaOLOAGCOMDonating"&gt;&lt;codificaOLOAGCOMDonating&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/codificaOLOAGCOMDonating"/&gt;&lt;/codificaOLOAGCOMDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/codificaOLOAGCOMDonor"&gt;&lt;codificaOLOAGCOMDonor&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/codificaOLOAGCOMDonor"/&gt;&lt;/codificaOLOAGCOMDonor&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/codificaOLONOWDonating"&gt;&lt;codificaOLONOWDonating&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/codificaOLONOWDonating"/&gt;&lt;/codificaOLONOWDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/codificaOLONOWDonor"&gt;&lt;codificaOLONOWDonor&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/codificaOLONOWDonor"/&gt;&lt;/codificaOLONOWDonor&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/tipologiaScenario"&gt;&lt;tipologiaScenario&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/tipologiaScenario"/&gt;&lt;/tipologiaScenario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/totaleOrdinePacchetto"&gt;&lt;totaleOrdinePacchetto&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/totaleOrdinePacchetto"/&gt;&lt;/totaleOrdinePacchetto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/IDCorrelazione"&gt;&lt;IDCorrelazione&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/IDCorrelazione"/&gt;&lt;/IDCorrelazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/numTelPrincipale"&gt;&lt;numTelPrincipale&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/numTelPrincipale"/&gt;&lt;/numTelPrincipale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/codiceFatturazioneJPUB"&gt;&lt;codiceFatturazioneJPUB&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/codiceFatturazioneJPUB"/&gt;&lt;/codiceFatturazioneJPUB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/CRMEstrattore"&gt;&lt;CRMEstrattore&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/CRMEstrattore"/&gt;&lt;/CRMEstrattore&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/IDRichiestaOLD"&gt;&lt;IDRichiestaOLD&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/IDRichiestaOLD"/&gt;&lt;/IDRichiestaOLD&gt;&lt;/xsl:if&gt;&lt;cliente&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/cliente/IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/cliente/created"/&gt;&lt;/created&gt;&lt;xsl:if test="$Risorsa_TGU_Att/cliente/lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/cliente/lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/cliente/codiceFiscale"&gt;&lt;codiceFiscale&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/cliente/codiceFiscale"/&gt;&lt;/codiceFiscale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/cliente/cognomeRagioneSociale"&gt;&lt;cognomeRagioneSociale&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/cliente/cognomeRagioneSociale"/&gt;&lt;/cognomeRagioneSociale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/cliente/nome"&gt;&lt;nome&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/cliente/nome"/&gt;&lt;/nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/cliente/partitaIVA"&gt;&lt;partitaIVA&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/cliente/partitaIVA"/&gt;&lt;/partitaIVA&gt;&lt;/xsl:if&gt;&lt;/cliente&gt;&lt;xsl:if test="$Risorsa_TGU_Att/LNA_LA"&gt;&lt;LNA_LA&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/LNA_LA"/&gt;&lt;/LNA_LA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/modalitaFatturazione"&gt;&lt;modalitaFatturazione&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/modalitaFatturazione"/&gt;&lt;/modalitaFatturazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/IDRisorsaOLD"&gt;&lt;IDRisorsaOLD&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/IDRisorsaOLD"/&gt;&lt;/IDRisorsaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/ns1:Tipologia='Tipologia_1' and $Start/ns1:Asset/statoAsset='ATTIVO'"&gt;&lt;IDRisorsaCorrelato&gt;&lt;xsl:value-of select="$Start/ns1:Asset/IDRisorsa"/&gt;&lt;/IDRisorsaCorrelato&gt;&lt;/xsl:when&gt;&lt;xsl:when test="($Start/ns1:Tipologia='Tipologia_2' and $Start/ns1:Asset/statoAsset='ATTIVO' and string-length($Start/ns1:IdRisorsaOLD)&gt;0) or ($Start/ns1:Tipologia='Tipologia_1' and $Start/ns1:Asset/statoAsset='CESSATO' and string-length($Start/ns1:Id_Risorsa_Correlata)&gt;0) or ($Start/ns1:Tipologia='Tipologia_2' and $Start/ns1:Asset/statoAsset='CESSATO' and string-length($Start/ns1:IdRisorsaOLD)&gt;0)"/&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$Risorsa_TGU_Att/operatoreRete"&gt;&lt;operatoreRete&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/operatoreRete"/&gt;&lt;/operatoreRete&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Risorsa_TGU_Att/opzioneDinamica"&gt;&lt;opzioneDinamica&gt;&lt;xsl:value-of select="$Risorsa_TGU_Att/opzioneDinamica"/&gt;&lt;/opzioneDinamica&gt;&lt;/xsl:if&gt;&lt;/tns:Asset&gt;&lt;/tns:Input&gt;&lt;/tns:Update&gt;&lt;/tns:Input&gt;&lt;/part1&gt;&lt;/ns:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns1=&quot;http://www.tim.now.WLR_CorrelationProcess&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindCase_TGU.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Risorsa_TGU_Att&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateCaseTGU-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Update>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase_TGU.part1/tns:Find[tns:Asset/statoAsset='ATTIVO']/tns:CaseReference&quot;/>&#xa;                    &lt;/tns:CaseReference>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;xsl:if test=&quot;$Risorsa_TGU_Att/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$Risorsa_TGU_Att/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Risorsa_TGU_Att/codiceOrdineOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$Risorsa_TGU_Att/codiceOrdineTI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$Risorsa_TGU_Att/codiceOrdineTI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Risorsa_TGU_Att/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$Risorsa_TGU_Att/invariante&quot;>&#xa;                            &lt;invariante>&#xa;                                &lt;xsl:value-of select=&quot;$Risorsa_TGU_Att/invariante&quot;/>&#xa;                            &lt;/invariante>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$Risorsa_TGU_Att/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$Risorsa_TGU_Att/lastUpdate&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;$Risorsa_TGU_Att/lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Risorsa_TGU_Att/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$Risorsa_TGU_Att/IDRichiestaOLO&quot;>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;$Risorsa_TGU_Att/IDRichiestaOLO&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Risorsa_TGU_Att/IDPrimoOrdine&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$Risorsa_TGU_Att/IDPrimoOrdine&quot;/>&#xa;                            &lt;/IDPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;$Risorsa_TGU_Att/IDContratto&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        