t1/tns:Output/tns:Find[1]/tns:Asset/IDRichiestaOLD"&gt;&lt;IDRichiestaOLD&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/IDRichiestaOLD"/&gt;&lt;/IDRichiestaOLD&gt;&lt;/xsl:if&gt;&lt;cliente&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/cliente/IDAsset"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/cliente/created"/&gt;&lt;/created&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/cliente/lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/cliente/lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/cliente/codiceFiscale"&gt;&lt;codiceFiscale&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/cliente/codiceFiscale"/&gt;&lt;/codiceFiscale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/cliente/cognomeRagioneSociale"&gt;&lt;cognomeRagioneSociale&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/cliente/cognomeRagioneSociale"/&gt;&lt;/cognomeRagioneSociale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/cliente/nome"&gt;&lt;nome&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/cliente/nome"/&gt;&lt;/nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/cliente/partitaIVA"&gt;&lt;partitaIVA&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/cliente/partitaIVA"/&gt;&lt;/partitaIVA&gt;&lt;/xsl:if&gt;&lt;/cliente&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/LNA_LA"&gt;&lt;LNA_LA&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/LNA_LA"/&gt;&lt;/LNA_LA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/modalitaFatturazione"&gt;&lt;modalitaFatturazione&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/modalitaFatturazione"/&gt;&lt;/modalitaFatturazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/IDRisorsaOLD"&gt;&lt;IDRisorsaOLD&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/IDRisorsaOLD"/&gt;&lt;/IDRisorsaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/ns1:Tipologia='Tipologia_1' and $Start/ns1:Asset/statoAsset='ATTIVO'"&gt;&lt;IDRisorsaCorrelato&gt;&lt;xsl:value-of select="$Start/ns1:Asset/IDRisorsa"/&gt;&lt;/IDRisorsaCorrelato&gt;&lt;/xsl:when&gt;&lt;xsl:when test="($Start/ns1:Tipologia='Tipologia_2' and $Start/ns1:Asset/statoAsset='ATTIVO' and string-length($Start/ns1:IdRisorsaOLD)&gt;0) or ($Start/ns1:Tipologia='Tipologia_1' and $Start/ns1:Asset/statoAsset='CESSATO' and string-length($Start/ns1:Id_Risorsa_Correlata)&gt;0) or ($Start/ns1:Tipologia='Tipologia_2' and $Start/ns1:Asset/statoAsset='CESSATO' and string-length($Start/ns1:IdRisorsaOLD)&gt;0)"/&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/operatoreRete"&gt;&lt;operatoreRete&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/operatoreRete"/&gt;&lt;/operatoreRete&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/opzioneDinamica"&gt;&lt;opzioneDinamica&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/opzioneDinamica"/&gt;&lt;/opzioneDinamica&gt;&lt;/xsl:if&gt;&lt;/tns:Asset&gt;&lt;/tns:Input&gt;&lt;/tns:Update&gt;&lt;/tns:Input&gt;&lt;/part1&gt;&lt;/ns:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns1=&quot;http://www.tim.now.WLR_CorrelationProcess&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindCase_Correlato.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Update_Case_Corr-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Update>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:CaseReference&quot;/>&#xa;                    &lt;/tns:CaseReference>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;xsl:if test=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/codiceOrdineOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/codiceOrdineTI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/codiceOrdineTI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/invariante&quot;>&#xa;                            &lt;invariante>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/invariante&quot;/>&#xa;                            &lt;/invariante>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/lastUpdate&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/IDRichiestaOLO&quot;>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/IDRichiestaOLO&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCase_Correlato.part1/tns:Find[1]/tns:Asset/IDPrimoOrdine&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                 