                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="RisorsaDin_Att-input"
                    name="RisorsaDin_Att"
                    outputVariable="RisorsaDin_Att"
                    tibex:xpdlId="aed8b664-1045-4a1c-9e62-c2ecd5eb48d0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FindCase_DINToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RisorsaDin_AttToTGU_Din">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="RisorsaDin_AttToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$RisorsaDin_Att/codificaOLOAGCOM='TLC' and ($RisorsaDin_Att/offerta='ULLLINEANONATTIVA' or $RisorsaDin_Att/offerta='SLULINEANONATTIVA' ) and $RisorsaDin_Att/distretto=$Start/ns0:Asset/distretto" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$RisorsaDin_Att/codificaOLOAGCOM='TLC' and ($RisorsaDin_Att/offerta='ULLLINEANONATTIVA' or $RisorsaDin_Att/offerta='SLULINEANONATTIVA' ) and $RisorsaDin_Att/distretto=$Start/ns0:Asset/distretto]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindCase_DIN.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;RisorsaDin_Att-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:AssetElement>&#xa;            &lt;xsl:if test=&quot;$FindCase_DIN.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/IDAsset&quot;>&#xa;                &lt;IDAsset>&#xa;                    &lt;xsl:value-of select=&quot;$FindCase_DIN.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/IDAsset&quot;/>&#xa;                &lt;/IDAsset>&#xa;            &lt;/xsl:if>&#xa;            &lt;codiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;$FindCase_DIN.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/codiceOrdineOLO&quot;/>&#xa;            &lt;/codiceOrdineOLO>&#xa;            &lt;xsl:if test=&quot;$FindCase_DIN.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/codiceOrdineTI&quot;>&#xa;                &lt;codiceOrdineTI>&#xa;                    &lt;xsl:value-of select=&quot;$FindCase_DIN.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/codiceOrdineTI&quot;/>&#xa;                &lt;/codiceOrdineTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$FindCase_DIN.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/codificaOLOAGCOM&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$FindCase_DIN.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/invariante&quot;>&#xa;                &lt;invariante>&#xa;                    &lt;xsl:value-of select=&quot;$FindCase_DIN.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']