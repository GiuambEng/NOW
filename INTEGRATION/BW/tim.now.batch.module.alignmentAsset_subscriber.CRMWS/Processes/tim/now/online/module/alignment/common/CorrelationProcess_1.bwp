                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindCase_TGU.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;Risorsa_TGU_Att-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:AssetElement>&#xa;            &lt;xsl:if test=&quot;$FindCase_TGU.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/IDAsset&quot;>&#xa;                &lt;IDAsset>&#xa;                    &lt;xsl:value-of select=&quot;$FindCase_TGU.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/IDAsset&quot;/>&#xa;                &lt;/IDAsset>&#xa;            &lt;/xsl:if>&#xa;            &lt;codiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;$FindCase_TGU.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/codiceOrdineOLO&quot;/>&#xa;            &lt;/codiceOrdineOLO>&#xa;            &lt;xsl:if test=&quot;$FindCase_TGU.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/codiceOrdineTI&quot;>&#xa;                &lt;codiceOrdineTI>&#xa;                    &lt;xsl:value-of select=&quot;$FindCase_TGU.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/codiceOrdineTI&quot;/>&#xa;                &lt;/codiceOrdineTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$FindCase_TGU.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/codificaOLOAGCOM&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$FindCase_TGU.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO']/tns1:Asset/invariante&quot;>&#xa;                &lt;invariante>&#xa;                    &lt;xsl:value-of select=&quot;$FindCase_TGU.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO'