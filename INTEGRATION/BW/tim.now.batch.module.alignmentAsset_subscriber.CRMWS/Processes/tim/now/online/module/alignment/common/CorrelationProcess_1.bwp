;xsl:when test=&quot;($Start/ns1:Tipologia='Tipologia_2' and $Start/ns1:Asset/statoAsset='ATTIVO' and string-length($Start/ns1:IdRisorsaOLD)>0) or ($Start/ns1:Tipologia='Tipologia_1' and $Start/ns1:Asset/statoAsset='CESSATO' and string-length($Start/ns1:Id_Risorsa_Correlata)>0) or ($Start/ns1:Tipologia='Tipologia_2' and $Start/ns1:Asset/statoAsset='CESSATO' and string-length($Start/ns1:IdRisorsaOLD)>0)&quot;/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$Risorsa_TGU_Att/operatoreRete&quot;>&#xa;                            &lt;operatoreRete>&#xa;                                &lt;xsl:value-of select=&quot;$Risorsa_TGU_Att/operatoreRete&quot;/>&#xa;                            &lt;/operatoreRete>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Risorsa_TGU_Att/opzioneDinamica&quot;>&#xa;                            &lt;opzioneDinamica>&#xa;                                &lt;xsl:value-of select=&quot;$Risorsa_TGU_Att/opzioneDinamica&quot;/>&#xa;                            &lt;/opzioneDinamica>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:Asset>&#xa;                &lt;/tns:Input>&#xa;            &lt;/tns:Update>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
