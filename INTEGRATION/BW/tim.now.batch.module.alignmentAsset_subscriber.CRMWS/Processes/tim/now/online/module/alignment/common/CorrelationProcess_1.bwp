rt1/tns:Output/tns:Find[1]/tns:Asset/CRMOrigine"/&gt;&lt;/CRMOrigine&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/codiceSLAAssurance"&gt;&lt;codiceSLAAssurance&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/codiceSLAAssurance"/&gt;&lt;/codiceSLAAssurance&gt;&lt;/xsl:if&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDOfferta&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/IDOfferta"/&gt;&lt;/IDOfferta&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/indirizzoEstesoNonCert"&gt;&lt;indirizzoEstesoNonCert&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/indirizzoEstesoNonCert"/&gt;&lt;/indirizzoEstesoNonCert&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/numeroFittizio"&gt;&lt;numeroFittizio&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/numeroFittizio"/&gt;&lt;/numeroFittizio&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/codificaOLOAGCOMDonating"&gt;&lt;codificaOLOAGCOMDonating&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/codificaOLOAGCOMDonating"/&gt;&lt;/codificaOLOAGCOMDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/codificaOLOAGCOMDonor"&gt;&lt;codificaOLOAGCOMDonor&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/codificaOLOAGCOMDonor"/&gt;&lt;/codificaOLOAGCOMDonor&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/codificaOLONOWDonating"&gt;&lt;codificaOLONOWDonating&gt;&lt;xsl:value-of select="$FindCase_Correlato/part1/tns:Output/tns:Find[1]/tns:Asset/codificaOLONOWDonating"