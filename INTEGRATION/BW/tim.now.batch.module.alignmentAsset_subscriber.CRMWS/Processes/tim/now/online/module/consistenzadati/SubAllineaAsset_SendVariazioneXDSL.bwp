VC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:SCR_UP)>0 and $Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:SCR_UP!='COPY' and $Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:SCR_UP!='DELETE'&quot;>&lt;tns:SCR_UP>&lt;xsl:value-of select=&quot;concat(&amp;quot; ='&amp;quot;, $Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:SCR_UP,&amp;quot;'&amp;quot;)&quot;/>&lt;/tns:SCR_UP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SCR_UP>&lt;xsl:value-of select=&quot;' IS NULL'&quot;/>&lt;/tns:SCR_UP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:SCR_DOWN)>0 and $Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:SCR_DOWN!='COPY' and $Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:SCR_DOWN!='DELETE'&quot;>&lt;tns:SCR_DOWN>&lt;xsl:value-of select=&quot;concat(&amp;quot; ='&amp;quot;, $Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:SCR_DOWN,&amp;quot;'&amp;quot;)&quot;/>&lt;/tns:SCR_DOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SCR_DOWN>&lt;xsl:value-of select=&quot;' IS NULL'&quot;/>&lt;/tns:SCR_DOWN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:PCR_UP)>0 and $Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:PCR_UP!='COPY' and $Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:PCR_UP!='DELETE'&quot;>&lt;tns:PCR_UP>&lt;xsl:value-of select=&quot;concat(&amp;quot; ='&amp;quot;, $Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:PCR_UP,&amp;quot;'&amp;quot;)&quot;/>&lt;/tns:PCR_UP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:PCR_UP>&lt;xsl:value-of select=&quot;' IS NULL'&quot;/>&lt;/tns:PCR_UP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:PCR_DOWN)>0 and $Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:PCR_DOWN!='COPY' and $Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:PCR_DOWN!='DELETE'&quot;>&lt;tns:PCR_DOWN>&lt;xsl:value-of select=&quot;concat(&amp;quot; ='&amp;quot;, $Start/ns0:ATMVC[number($ConteggioComponenteAttributo2)]/ns0:ProfiloVC/ns0:PCR_DOWN,&amp;quot;'&amp;quot;)&quot;/>&lt;/tns:PCR_DOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:PCR_DOWN>&lt;xsl:value-of select=&quot;' IS NULL'&quot;/>&lt;/tns:PCR_DOWN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:profilo>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
