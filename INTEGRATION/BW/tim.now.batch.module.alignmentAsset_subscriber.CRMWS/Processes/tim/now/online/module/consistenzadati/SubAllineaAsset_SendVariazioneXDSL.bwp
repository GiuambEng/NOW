                                    name="CallProcessToAzzeraAttGBE" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign3ToAccumulate2" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart6"
                                tibex:group="groupStart" tibex:xpdlId="7383c614-8dda-4176-af9e-6d4d860639b0">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart6ToIterate7"/>
                                </bpws:sources>
