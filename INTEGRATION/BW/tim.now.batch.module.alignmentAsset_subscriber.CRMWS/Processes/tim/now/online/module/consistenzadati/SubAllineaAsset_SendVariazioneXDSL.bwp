                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneXDSL.xsd&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;www.tim.now.dettaglio.asset.customizzato&quot; xmlns:ns17=&quot;www.tim.now.checkXDSLATMVC&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DettAssetToModify&quot;/>&lt;xsl:param name=&quot;Accumulate2&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Accumulate1&quot;/>&lt;xsl:param name=&quot;Accumulate4&quot;/>&lt;xsl:param name=&quot;Accumulate3&quot;/>&lt;xsl:param name=&quot;Accumulate6&quot;/>&lt;xsl:param name=&quot;Accumulate5&quot;/>&lt;xsl:param name=&quot;CheckUpdateProtocollo&quot;/>&lt;xsl:param name=&quot;Updated_PROTOCOLLO&quot;/>&lt;xsl:param name=&quot;NEWPROTOCOLLO&quot;/>&lt;xsl:param name=&quot;CopyDettProtocollo&quot;/>&lt;xsl:param name=&quot;DettAssetProtocollo&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Input_DettaglioAsset>&lt;xsl:for-each select=&quot;$DettAssetToModify/tns:DettaglioAsset&quot;>&lt;tns:DettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&lt;IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&lt;/IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&lt;IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&lt;/IDDettaglioAssetRoot>&lt;/xsl:if>&lt;integrationID>&lt;xsl:value-of select=&quot;integrationID&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpda