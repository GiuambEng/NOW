                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>

                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_PROFILO_BMD&#xa;  FROM PROFILO_VLAN_BMD BMD&#xa;  WHERE PROFILO = ?&#xa;    AND ID_SOTTOFAMIG_OFFERTA IN &#xa;    (SELECT ID_SOTTOFAMIG_OFFERTA FROM OFFERTA WHERE ID_OFFERTA = &#xa;    (SELECT ID_OFFERTA FROM TRASCODFC_OFFERTA WHERE PROVENIENZA = 'CRMWS' AND NOME_OFFERTA_ESTERNA = ? ))&#xa;      AND IDTPLG_VLAN = 1" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROFILO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>

                                    <columnMetadata
                                    columnName="ID_PROFILO_BMD"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
