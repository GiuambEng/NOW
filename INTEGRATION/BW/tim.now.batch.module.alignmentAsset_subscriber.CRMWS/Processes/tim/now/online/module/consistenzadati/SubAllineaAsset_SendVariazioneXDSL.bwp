                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneXDSL.xsd&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;www.tim.now.checkXDSLATMVC&quot; xmlns:ns2=&quot;www.tim.now.dettaglio.asset.customizzato&quot; xmlns:ns3=&quot;www.tim.now.allileamentoconsistenze.NomeComponenteChoose&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IDDettaglio&quot;/>&lt;xsl:param name=&quot;IDDettaglio_GBE&quot;/>&lt;xsl:param name=&quot;ConteggioAttributoGBE&quot;/>&lt;xsl:param name=&quot;New_GBE&quot;/>&lt;xsl:param name=&quot;Accumulate2&quot;/>&lt;xsl:param name=&quot;ConteggioDettaglioGBE&quot;/>&lt;xsl:param name=&quot;Componente&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:template name=&quot;DettComp2&quot; match=&quot;/&quot;>&lt;ns:Input_DettaglioAsset>&lt;ns:DettaglioAsset>&lt;xsl:variable name=&quot;progressivo_da&quot; select=&quot;count($Accumulate2/ns2:DettaglioAsset_Customizzato)&quot;/>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:if test=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDDettaglioAsset&quot;>&lt;IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDDettaglioAsset&quot;>&lt;IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAssetRoot>&lt;/xsl:if>&lt;integrationID>&lt;xsl:value-of sel