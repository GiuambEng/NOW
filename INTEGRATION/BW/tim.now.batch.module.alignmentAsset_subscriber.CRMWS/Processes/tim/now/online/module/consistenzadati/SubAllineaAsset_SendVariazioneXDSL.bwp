            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Componente"
                    name="Componente" outputVariable="Componente"
                    tibex:xpdlId="a5cce597-2802-48ed-9a3c-66ab9a7a6ab3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToComponente"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ComponenteToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($Start/ns0:DettaglioAsset[nomeComponente=$Componente/ns1:NomeComponente1] and $Start/ns0:DettaglioAsset[nomeComponente=$Componente/ns1:NomeComponente2])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($Start/ns0:DettaglioAsset[nomeComponente=$Componente/ns1:NomeComponente1] and $Start/ns0:DettaglioAsset[nomeComponente=$Componente/ns1:NomeComponente2])]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allileamentoconsistenze.NomeComponenteChoose&quot; xmlns:ns1=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneXDSL.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Componente&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns1:AssetCRM/ns1:Servizio='30'&quot;>&lt;ns:Input>&lt;ns:NomeComponente1>&lt;xsl:value-of select=&quot;'ACCESSOGBESIMFLAT'&quot;/>&lt;/ns:NomeComponente1>&lt;ns:NomeComponente2>&lt;xsl:value-of select=&quot;'USERVLAN'&quot;/>&lt;/ns:NomeComponente2>&lt;/ns:Input>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns1:AssetCRM/ns1:Servizio='28'&quot;>&lt;ns:Input>&lt;ns:NomeComponente1>&lt;xsl:value-of select=&quot;'ACCESSOATMSIMHL'&quot;/>&lt;/ns:NomeComponente1>&lt;ns:NomeComponente2>&lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&lt;/ns:NomeComponente2>&lt;/ns:Input>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns1:AssetCRM/ns1:Servizio='29'&quot;>&lt;ns:Input>&lt;ns:NomeComponente1>&lt;xsl:value-of select=&quot;'ACCESSOATMSIMFLAT'&quot;/>&lt;/ns:NomeComponente1>&lt;ns:NomeComponente2>&lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&lt;/ns:NomeComponente2>&lt;/ns:Input>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns1:AssetCRM/ns1:Servizio='08'&quot;>&lt;ns:Input>&lt;ns:NomeComponente1>&lt;xsl:value-of select=&quot;'ACCESSOATMASIMFLAT'&quot;/>&lt;/ns:NomeComponente1>&lt;ns:NomeComponente2>&lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&lt;/ns:NomeComponente2>&lt;/ns:Input>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns1:AssetCRM/ns1:Servizio='09'&quot;>&lt;ns:Input>&lt;ns:NomeComponente1>&lt;xsl:value-of select=&quot;'ACCESSOATMASIMHL'&quot;/>&lt;/ns:NomeComponente1>&lt;ns:NomeComponente2>&lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&lt;/ns:NomeComponente2>&lt;/ns:Input>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns1:AssetCRM/ns1:Servizio='10'&quot;>&lt;ns:Input>&lt;ns:NomeComponente1>&lt;xsl:value-of select=&quot;'ACCESSOATMASIMLITE'&quot;/>&lt;/ns:NomeComponente1>&lt;ns:NomeComponente2>&lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&lt;/ns:NomeComponente2>&lt;/ns:Input>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns1:AssetCRM/ns1:Servizio='11'&quot;>&lt;ns:Input>&lt;ns:NomeComponente1>&lt;xsl:value-of select=&quot;'ACCESSOGBEASIMFLAT'&quot;/>&lt;/ns:NomeComponente1>&lt;ns:NomeComponente2>&lt;xsl:value-of select=&quot;'GBEVC'&quot;/>&lt;/ns:NomeComponente2>&lt;/ns:Input>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns1:AssetCRM/ns1:Servizio='12'&quot;>&lt;ns:Input>&lt;ns:NomeComponente1>&lt;xsl:value-of select=&quot;'ACCESSOEASYIPBASEPLUSFLAT'&quot;/>&lt;/ns:NomeComponente1>&lt;ns:NomeComponente2>&lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&lt;/ns:NomeComponente2>&lt;/ns:Input>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns1:AssetCRM/ns1:Servizio='13'&quot;>&lt;ns:Input>&lt;ns:NomeComponente1>&lt;xsl:value-of select=&quot;'ACCESSOEASYIPBASEPLUSLITE'&quot;/>&lt;/ns:NomeComponente1>&lt;ns:NomeComponente2>&lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&lt;/ns:NomeComponente2>&lt;/ns:Input>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns1:AssetCRM/ns1:Servizio='14'&quot;>&lt;ns:Input>&lt;ns:NomeComponente1>&lt;xsl:value-of select=&quot;'ACCESSOEASYIPSPECIALPROFILEFLAT'&quot;/>&lt;/ns:NomeComponente1>&lt;ns:NomeComponente2>&lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&lt;/ns:NomeComponente2>&lt;/ns:Input>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns1:AssetCRM/ns1:Servizio='15'&quot;>&lt;ns:Input>&lt;ns:NomeComponente1>&lt;xsl:value-of select=&quot;'ACCESSOEASYIPSPECIALPROFILELITE'&quot;/>&lt;/ns:NomeComponente1>&lt;ns:NomeComponente2>&lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&lt;/ns:NomeComponente2>&lt;/ns:Input>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbp