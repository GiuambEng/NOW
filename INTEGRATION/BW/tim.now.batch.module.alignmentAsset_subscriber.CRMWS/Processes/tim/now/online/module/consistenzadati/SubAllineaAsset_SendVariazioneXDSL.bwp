                            <bpws:scope name="While4"
                                tibex:group="while" tibex:xpdlId="cf72ff8c-6aae-4809-b696-3db99057baae">
                                <bpws:targets>
                                    <bpws:target linkName="GroupStart6ToIterate7"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Iterate7ToGroupEnd2">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
