                                <tibex:expression
                                    expression="count($DettAssetToModify/ns0:DettaglioAsset/attributidettaglioasset)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($DettAssetToModify/ns0:DettaglioAsset/attributidettaglioasset)>0]]></bpws:transitionCondition>
