                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/" xmlns:tns="http://www.tim.com/NOW/xsd/FindUpdateCase/" xmlns:ns2="www.tim.now.dinamicprocess.allineamentoOggAsset" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns3="http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="ParseCRM"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="caseModelVersion"/&gt;&lt;xsl:param name="caseType"/&gt;&lt;xsl:param name="Check1"/&gt;&lt;xsl:template name="CreateCase-input" match="/"&gt;&lt;ns:Request&gt;&lt;part1&gt;&lt;tns:Input&gt;&lt;tns:Create&gt;&lt;tns:Input&gt;&lt;tns:caseType&gt;&lt;xsl:value-of select="$caseType"/&gt;&lt;/tns:caseType&gt;&lt;tns:caseModelVersion&gt;&lt;xsl:value-of select="$caseModelVersion"/&gt;&lt;/tns:caseModelVersion&gt;&lt;tns:Asset&gt;&lt;codiceOrdineOLO&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CODICEORDINEOLO"/&gt;&lt;/codiceOrdineOLO&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CODICE_ORDINE_TI"&gt;&lt;codiceOrdineTI&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CODICE_ORDINE_TI"/&gt;&lt;/codiceOrdineTI&gt;&lt;/xsl:if&gt;&lt;codificaOLOAGCOM&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:DESCOLO"/&gt;&lt;/codificaOLOAGCOM&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;IDContratto&gt;&lt;xsl:value-of select="xsd:int(xsd:decimal($Check1/ns2:IdContrattoNOW))"/&gt;&lt;/IDContratto&gt;&lt;statoAsset&gt;&lt;xsl:value-of select="'ATTIVO'"/&gt;&lt;/statoAsset&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA"/&gt;&lt;/IDRisorsa&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA"&gt;&lt;numeroTelefonico&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA"/&gt;&lt;/numeroTelefonico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:ID_CRMWS"&gt;&lt;IDAssetCRMWS&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:ID_CRMWS"/&gt;&lt;/IDAssetCRMWS&gt;&lt;/xsl:if&gt;&lt;DES&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:DEC"/&gt;&lt;/DES&gt;&lt;ORA_DES&gt;&lt;xsl:value-of select="tib:parse-time(&amp;quot;yyyy-MM-dd&amp;quot;,xsd:string($ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:DEC ))"/&gt;&lt;/ORA_DES&gt;&lt;tipologiaAccesso&gt;&lt;xsl:value-of select="&amp;quot;FONIA&amp;quot;"/&gt;&lt;/tipologiaAccesso&gt;&lt;offerta&gt;&lt;xsl:value-of select="$Start/ns2:NomeOffertaEsterna"/&gt;&lt;/offerta&gt;&lt;dettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;integrationID&gt;&lt;xsl:value-of select="'0'"/&gt;&lt;/integrationID&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA"/&gt;&lt;/IDRisorsa&gt;&lt;nomeComponente&gt;&lt;xsl:value-of select="&amp;quot;NUMBERPORTABILITY&amp;quot;"/&gt;&lt;/nomeComponente&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="'NUMEROTELEFONICO'"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="'NUMEROTELEFONICOPRINCIPALE'"/&gt;&lt;/nomeAttributo&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:PRIMARY_NUMBER)&gt;0"&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:PRIMARY_NUMBER"/&gt;&lt;/valoreAttributo&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA"/&gt;&lt;/valoreAttributo&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="'CODICEOPERATOREDONOR'"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="'TLC'"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="&amp;quot;ROUTINGNUMBER&amp;quot;"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:ROUTING_NUMBER"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="&amp;quot;CODICEPIATTAFORMA&amp;quot;"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:PIATTAFORMA_COMMERCIALE"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RADICE_GNR)&gt;0"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="&amp;quot;RADICALE&amp;quot;"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RADICE_GNR"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CODICE_RO)&gt;0"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="&amp;quot;CODICERO&amp;quot;"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CODICE_RO"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;DATE&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CAPOSTIPITE)&gt;0"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="&amp;quot;CAPOSERIE&amp;quot;"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CAPOSTIPITE"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CODICEOLO_RETAILER)&gt;0"&gt;&lt;attributidettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;nomeAttributo&gt;&lt;xsl:value-of select="&amp;quot;OLORETAILER&amp;quot;"/&gt;&lt;/nomeAttributo&gt;&lt;valoreAttributo&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CODICEOLO_RETAILER"/&gt;&lt;/valoreAttributo&gt;&lt;tipologiaDato&gt;&lt;xsl:value-of select="&amp;quot;VARCHAR2&amp;quot;"/&gt;&lt;/tipologiaDato&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;/attributidettaglioasset&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="1"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="&amp;quot;ATTIVO&amp;quot;"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="1"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:DEC"&gt;&lt;DESPrimoOrdine&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:DEC"/&gt;&lt;/DESPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:DISTR_TELEFONICO)=2"&gt;&lt;distretto&gt;&lt;xsl:value-of select="tib:pad-front($ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:DISTR_TELEFONICO, 3, '0')"/&gt;&lt;/distretto&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:DISTR_TELEFONICO)=3"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:DISTR_TELEFONICO"&gt;&lt;distretto&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:DISTR_TELEFONICO"/&gt;&lt;/distretto&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:DISTR_TELEFONICO)=4"&gt;&lt;distretto&gt;&lt;xsl:value-of select="substring($ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:DISTR_TELEFONICO,2,3)"/&gt;&lt;/distretto&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;CRMOrigine&gt;&lt;xsl:value-of select="'CRMWS'"/&gt;&lt;/CRMOrigine&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDOfferta&gt;&lt;xsl:value-of select="$Start/ns2:IdOfferta"/&gt;&lt;/IDOfferta&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:PRIMARY_NUMBER)&gt;0"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:PRIMARY_NUMBER"&gt;&lt;numTelPrincipale&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:PRIMARY_NUMBER"/&gt;&lt;/numTelPrincipale&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA"&gt;&lt;numTelPrincipale&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA"/&gt;&lt;/numTelPrincipale&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;CRMEstrattore&gt;&lt;xsl:value-of select="'CRMWS'"/&gt;&lt;/CRMEstrattore&gt;&lt;cliente&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:CF"&gt;&lt;codiceFiscale&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:CF"/&gt;&lt;/codiceFiscale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:COGNOMERAGSOC"&gt;&lt;cognomeRagioneSociale&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:COGNOMERAGSOC"/&gt;&lt;/cognomeRagioneSociale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:NOME"&gt;&lt;nome&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:NOME"/&gt;&lt;/nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:PIVA"&gt;&lt;partitaIVA&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:PIVA"/&gt;&lt;/partitaIVA&gt;&lt;/xsl:if&gt;&lt;/cliente&gt;&lt;/tns:Asset&gt;&lt;/tns:Input&gt;&lt;/tns:Create&gt;&lt;/tns:Input&gt;&lt;/part1&gt;&lt;/ns:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns2=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns3=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseCRM&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;caseModelVersion&quot;/>&#xa;    &lt;xsl:param name=&quot;caseType&quot;/>&#xa;    &lt;xsl:param name=&quot;Check1&quot;/>&#xa;    &lt;xsl:template name=&quot;CreateCase-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Create>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:caseType>&#xa;                        &lt;xsl:value-of select=&quot;$caseType&quot;/>&#xa;                    &lt;/tns:caseType>&#xa;                    &lt;tns:caseModelVersion>&#xa;                        &lt;xsl:value-of select=&quot;$caseModelVersion&quot;/>&#xa;                    &lt;/tns:caseModelVersion>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CODICEORDINEOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CODICE_ORDINE_TI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:CODICE_ORDINE_TI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:DESCOLO&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Check1/ns2:IdContrattoNOW))&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;'ATTIVO'&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:ID_CRMWS&quot;>&#xa;                            &lt;IDAssetCRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:ID_CRMWS&quot;/>&#xa;                            &lt;/IDAssetCRMWS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DES>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:DEC&quot;/>&#xa;                        &lt;/DES>&#xa;                        &lt;ORA_DES>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-time(&amp;quot;yyyy-MM-dd&amp;quot;,xsd:string($ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:DEC ))&quot;/>&#xa;                        &lt;/ORA_DES>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FONIA&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:NomeOffertaEsterna&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;dettaglioasset>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                            &lt;integrationID>&#xa;                                &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                            &lt;/integrationID>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;NUMBERPORTABILITY&amp;quot;&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                            &lt;attributidettaglioasset>&#xa;                                &lt;IDAsset>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/IDAsset>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;nomeAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;'NUMEROTELEFONICO'&quot;/>&#xa;                                &lt;/nomeAttributo>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:NPG/ns3:ATTIVAZIONE/ns3:RISORSA&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                                &lt;tipologiaDato>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                &lt;/tipologiaDato>&#xa;                                &lt;ID