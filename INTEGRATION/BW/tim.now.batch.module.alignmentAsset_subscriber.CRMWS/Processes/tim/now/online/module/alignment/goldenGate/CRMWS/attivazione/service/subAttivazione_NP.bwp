                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.maxNumber&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseCRM&quot;/>&lt;xsl:template name=&quot;Check_Dati&quot; match=&quot;/&quot;>&lt;tns:Check_Dati>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ParseCRM/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:CODICEORDINEOLO)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:CODICE_ORDINE_TI)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:CONTRATTO)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:RISORSA)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(xsd:string($ParseCRM/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:DEC))=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:DISTR_TELEFONICO)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:ROUTING_NUMBER)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:TIPO_DN)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:TIPO_LINEA)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:PIATTAFORMA_COMMERCIALE)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseCRM/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:CLIENTE/ns:COGNOMERAGSOC)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Check>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Check>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Check_Dati>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
