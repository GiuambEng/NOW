    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartLogToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapQueryToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="QueryToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogQueryToSQLDirect" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogEndToEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogEndToThrow" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToStatement" tibex:linkType="SUCCESS"/>
                <bpws:link name="SQLDirectToLogEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="ef0e9775-f1ca-423f-b7ef-bb0c3c194700"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
