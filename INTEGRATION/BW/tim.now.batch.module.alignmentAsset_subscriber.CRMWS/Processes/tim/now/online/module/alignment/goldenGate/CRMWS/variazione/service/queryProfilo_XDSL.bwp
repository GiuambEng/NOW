                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.tim.now.cheprofiloVC.alignment.asset&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;MapQuery-input&quot; match=&quot;/&quot;>&lt;tns:CheckProfiloInput>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:MCR_DOWN)>0&quot;>&lt;tns:MCR_DOWN>&lt;xsl:value-of select=&quot;concat(&amp;quot; = '&amp;quot;,$Start/tns:MCR_DOWN,&amp;quot;'&amp;quot;)&quot;/>&lt;/tns:MCR_DOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:MCR_DOWN>&lt;xsl:value-of select=&quot;' IS NULL'&quot;/>&lt;/tns:MCR_DOWN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:MCR_UP)>0&quot;>&lt;tns:MCR_UP>&lt;xsl:value-of select=&quot;concat(&amp;quot; = '&amp;quot;,$Start/tns:MCR_UP,&amp;quot;'&amp;quot;)&quot;/>&lt;/tns:MCR_UP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:MCR_UP>&lt;xsl:value-of select=&quot;' IS NULL'&quot;/>&lt;/tns:MCR_UP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:PCR_DOWN)>0&quot;>&lt;tns:PCR_DOWN>&lt;xsl:value-of select=&quot;concat(&amp;quot; = '&amp;quot;,$Start/tns:PCR_DOWN,&amp;quot;'&amp;quot;)&quot;/>&lt;/tns:PCR_DOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:PCR_DOWN>&lt;xsl:value-of select=&quot;' IS NULL'&quot;/>&lt;/tns:PCR_DOWN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:PCR_UP)>0&quot;>&lt;tns:PCR_UP>&lt;xsl:value-of select=&quot;concat(&amp;quot; = '&amp;quot;,$Start/tns:PCR_UP,&amp;quot;'&amp;quot;)&quot;/>&lt;/tns:PCR_UP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:PCR_UP>&lt;xsl:value-of select=&quot;' IS NULL'&quot;/>&lt;/tns:PCR_UP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:SCR_DOWN)>0&quot;>&lt;tns:SCR_DOWN>&lt;xsl:value-of select=&quot;concat(&amp;quot; ='&amp;quot;, $Start/tns:SCR_DOWN,&amp;quot;'&amp;quot;)&quot;/>&lt;/tns:SCR_DOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SCR_DOWN>&lt;xsl:value-of select=&quot;' IS NULL'&quot;/>&lt;/tns:SCR_DOWN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:SCR_UP)>0&quot;>&lt;tns:SCR_UP>&lt;xsl:value-of select=&quot;concat(&amp;quot; ='&amp;quot;, $Start/tns:SCR_UP,&amp;quot;'&amp;quot;)&quot;/>&lt;/tns:SCR_UP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SCR_UP>&lt;xsl:value-of select=&quot;' IS NULL'&quot;/>&lt;/tns:SCR_UP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:CheckProfiloInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:www.tim.now.tim.now.cheprofiloVC.alignment.asset="www.tim.now.tim.now.cheprofiloVC.alignment.asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="www.tim.now.tim.now.cheprofiloVC.alignment.asset:CheckProfiloInput" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="queryString"
                    name="Statement" outputVariable="queryString"
                    tibex:xpdlId="b12e5f06-ac1f-436e-9dcf-cf9c8daa9fe8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToStatement"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="QueryToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat(&quot;SELECT ID_PRFL_VC FROM PROFILO_VC WHERE MCR_DOWN&quot;, $MapQuery/ns0:MCR_DOWN, &quot; AND MCR_UP&quot;, $MapQuery/ns0:MCR_UP, &quot; AND PCR_DOWN&quot;, $MapQuery/ns0:PCR_DOWN, &quot; AND PCR_UP&quot;, $MapQuery/ns0:PCR_UP, &quot; AND SCR_DOWN&quot;, $MapQuery/ns0:SCR_DOWN, &quot; AND SCR_UP&quot;, $MapQuery/ns0:SCR_UP, &quot; AND ID_OFFERTA = (SELECT ID_OFFERTA FROM TRASCODFC_OFFERTA WHERE NOME_OFFERTA_ESTERNA ='&quot;, $Start/ns0:Servizio, &quot;' AND PROVENIENZA = 'CRMWS')&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="queryString" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogQuery-input"
                    name="LogQuery"
                    tibex:xpdlId="570b2a37-b728-49fc-912e-be95a24930a6"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="QueryToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogQueryToSQLDirect"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.tim.now.cheprofiloVC.alignment.asset&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;queryString&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogQuery-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'queryProfilo_XDSL'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'queryProfilo_XDSL'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'queryProfilo_XDSL'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/ns:Transaction_id&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:Transaction_id&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Statement',$queryString)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="SQLDirect-input"
                    name="SQLDirect" outputVariable="SQLDirect"
                    tibex:xpdlId="a16c716c-118e-47c2-a7b1-f1c42240a170" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogQueryToSQLDirect"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SQLDirectToLogEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a16c716c-118e-47c2-a7b1-f1c42240a170+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;queryString&quot;/>&lt;xsl:template name=&quot;idProfilo-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInputType>&lt;statement>&lt;xsl:value-of select=&quot;$queryString&quot;/>&lt;/statement>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogEnd-input"
                    name="LogEnd"
                    tibex:xpdlId="f7f88037-8f71-40f3-8964-b789b8064f1c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SQLDirectToLogEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogEndToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogEndToThrow">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length(string($SQLDirect/unknownResultset[1]/row[1]/column[name='ID_PRFL_VC']/value))=0 or not(exists($SQLDirect/unknownResultset[1]/row[1]/column[name='ID_PRFL_VC']/value))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length(string($SQLDirect/unknownResultset[1]/row[1]/column[name='ID_PRFL_VC']/value))=0 or not(exists($SQLDirect/unknownResultset[1]/row[1]/column[name='ID_PRFL_VC']/value))]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns=&quot;www.tim.now.tim.now.cheprofiloVC.alignment.asset&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogEnd-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'queryProfilo_XDSL'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'queryProfilo_XDSL'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'queryProfilo_XDSL'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/ns:Transaction_id&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:Transaction_id&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('SQLDirect',tib:render-xml($SQLDirect))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:throw faultName="ns4:DefaultFault"
                faultVariable="Throw-input" name="Throw" tibex:xpdlId="345ed9cb-da98-40a9-a82c-f0aef4ff981f">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;> &lt;tns:DefaultFault/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogEndToThrow"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogMapQuery-input"
                    name="LogMapQuery"
                    tibex:xpdlId="ec0ae853-ebd2-437a-a795-207c1f61be46"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapQueryToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToStatement"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.tim.now.cheprofiloVC.alignment.asset&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;MapQuery&quot;/>&lt;xsl:template name=&quot;LogMapQuery-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'queryProfilo_XDSL'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'queryProfilo_XDSL'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'queryProfilo_XDSL'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/ns:Transaction_id&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:Transaction_id&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('MapQuery',tib:render-xml($MapQuery,true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
