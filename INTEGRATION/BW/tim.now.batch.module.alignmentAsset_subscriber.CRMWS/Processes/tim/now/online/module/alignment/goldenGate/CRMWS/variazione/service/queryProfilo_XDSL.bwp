        <bpws:variable element="ns0:CheckProfiloInput"
            name="MapQuery-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:CheckProfiloInput" name="MapQuery" sca-bpel:internal="true"/>
        <bpws:variable name="queryString" type="xsd:string"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogQuery-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:ActivityInputType"
            name="SQLDirect-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:jdbcGeneralActivityOutput"
            name="SQLDirect" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns1:CW_BUS_MESSAGE" name="LogEnd-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
