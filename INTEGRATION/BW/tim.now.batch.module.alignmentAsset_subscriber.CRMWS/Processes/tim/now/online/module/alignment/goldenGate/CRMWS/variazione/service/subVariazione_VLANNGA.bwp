                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns1=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateCaseData-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Update>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:CaseReference&quot;/>&#xa;                    &lt;/tns:CaseReference>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;xsl:if test=&quot;$Mapper/tns:Update/tns:Input/tns:Asset/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/tns:Update/tns:Input/tns:Asset/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/tns:Update/tns:Input/tns:Asset/codiceOrdineOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$Mapper/tns:Update/tns:Input/tns:Asset/codiceOrdineTI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/tns:Update/tns:Input/tns:Asset/codiceOrdineTI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Mappe