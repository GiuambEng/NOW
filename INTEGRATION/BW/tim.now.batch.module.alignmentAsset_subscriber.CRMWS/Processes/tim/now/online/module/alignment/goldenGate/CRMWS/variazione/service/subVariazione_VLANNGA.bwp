                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeVLANNGA/&quot; xmlns:ns1=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseCRM&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;ns1:checkCessazione_Input>&lt;xsl:if test=&quot;$ParseCRM/ns:SERVIZIO/ns:VLANNGA/ns:VARIAZIONE/ns:ID_CRMWS&quot;>&lt;ns1:IDAssetCRMWS>&lt;xsl:value-of select=&quot;$ParseCRM/ns:SERVIZIO/ns:VLANNGA/ns:VARIAZIONE/ns:ID_CRMWS&quot;/>&lt;/ns1:IDAssetCRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns1:transactionId_CessatoVariato&quot;>&lt;ns1:transactionId_CessatoVariato>&lt;xsl:value-of select=&quot;$Start/ns1:transactionId_CessatoVariato&quot;/>&lt;/ns1:transactionId_CessatoVariato>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns1:Created_CessatoVariato&quot;>&lt;ns1:Created_CessatoVariato>&lt;xsl:value-of select=&quot;$Start/ns1:Created_CessatoVariato&quot;/>&lt;/ns1:Created_CessatoVariato>&lt;/xsl:if>&lt;/ns1:checkCessazione_Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
