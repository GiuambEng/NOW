            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeVLANNGA/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseCRM&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Update>&lt;tns:Input>&lt;tns:CaseReference>&lt;xsl:value-of select=&quot;$Start/ns:CaseReference&quot;/>&lt;/tns:CaseReference>&lt;tns:Asset>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDAsset&quot;>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDAsset&quot;/>&lt;/IDAsset>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:CODICEORDINEOLO&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;$ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:CODICE_ORDINE_TI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;$ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:CODICE_ORDINE_TI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/invariante&quot;>&lt;invariante>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/invariante&quot;/>&lt;/invariante>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/operatore&quot;/>&lt;/operatore>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDRichiestaOLO&quot;>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDPrimoOrdine&quot;>&lt;IDPrimoOrdine>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDPrimoOrdine&quot;/>&lt;/IDPrimoOrdine>&lt;/xsl:if>&lt;IDContratto>&lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Start/ns:Asset_Now/IDContratto))&quot;/>&lt;/IDContratto>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/DEC&quot;>&lt;DEC>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/DEC&quot;/>&lt;/DEC>&lt;/xsl:if>&lt;statoAsset>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/statoAsset&quot;/>&lt;/statoAsset>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:RISORSA&quot;/>&lt;/IDRisorsa>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:ID_CRMWS)>0&quot;>&lt;xsl:if test=&quot;$ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:ID_CRMWS&quot;>&lt;IDAssetCRMWS>&lt;xsl:value-of select=&quot;$ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:ID_CRMWS&quot;/>&lt;/IDAssetCRMWS>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDAssetCRMWS&quot;>&lt;IDAssetCRMWS>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDAssetCRMWS&quot;/>&lt;/IDAssetCRMWS>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDAssetDa&quot;>&lt;IDAssetDa>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDAssetDa&quot;/>&lt;/IDAssetDa>&lt;/xsl:if>&lt;DES>&lt;xsl:value-of select=&quot;$ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:DEC&quot;/>&lt;/DES>&lt;tipologiaAccesso>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/tipologiaAccesso&quot;/>&lt;/tipologiaAccesso>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/RO&quot;>&lt;RO>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/RO&quot;/>&lt;/RO>&lt;/xsl:if>&lt;offerta>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/offerta&quot;/>&lt;/offerta>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/lineaRiferimento&quot;>&lt;lineaRiferimento>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/lineaRiferimento&quot;/>&lt;/lineaRiferimento>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/complesso&quot;>&lt;complesso>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/complesso&quot;/>&lt;/complesso>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/interno&quot;>&lt;interno>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/interno&quot;/>&lt;/interno>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/piano&quot;>&lt;piano>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/piano&quot;/>&lt;/piano>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/scala&quot;>&lt;scala>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/scala&quot;/>&lt;/scala>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/ns:Asset_Now/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]&quot;>&lt;dettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&lt;IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&lt;/IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&lt;IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&lt;/IDDettaglioAssetRoot>&lt;/xsl:if>&lt;integrationID>&lt;xsl:value-of select=&quot;integrationID&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;nomeComponente&quot;/>&lt;/nomeComponente>&lt;xsl:if test=&quot;(string-length($ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:TIPOLOGIACLUSTERVLAN)=0 and string-length($ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:FTTHONLY)=0) or (string-length($ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:TIPOLOGIACLUSTERVLAN)>0 and string-length($ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:FTTHONLY)>0)&quot;>&lt;xsl:for-each select=&quot;attributidettaglioasset[nomeAttributo!='IDENTIFICATIVOVLANOLO' and nomeAttributo!='IDENTIFICATIVOCAR'  and  nomeAttributo!= 'CODICETDKIT' and nomeAttributo!= 'PROFILOBMC'  and nomeAttributo!= 'VARIAZIONECONCORDATA' and nomeAttributo!= 'SUPERMACROAREA' and nomeAttributo!= 'TIPOLOGIACLUSTERVLAN' and nomeAttributo!= 'FTTHONLY']&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:TIPOLOGIACLUSTERVLAN)=0 or string-length($ParseCRM/ns1:SERVIZIO/ns1:VLANNGA/ns1:VARIAZIONE/ns1:FTTHONLY)=0&quot;>&lt;xsl:for-each select=&quot;attributidettaglioasset[nomeAttributo!='IDENTIFICATIVOVLANOLO' and nomeAttributo!='IDENTIFICATIVOCAR'  and  nomeAttributo!= 'CODICETDKIT' and nomeAttributo!= 'PROFILOBMC'  and nomeAttributo!= 'VARIAZIONECONCORDATA' and nomeAttributo!= 'SUPERMACROAREA' and nomeAttributo!= 'TIPOLOGIACLUSTERVLAN' and nomeAttributo!