                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNGAVULA/&quot; xmlns:tns1=&quot;www.tim.now.maxNumber&quot; xmlns:ns2=&quot;http://www.tim.now.WLR_CorrelationProcess&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateCase.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseCRM&quot;/>&#xa;    &lt;xsl:param name=&quot;Check_Dati&quot;/>&#xa;    &lt;xsl:param name=&quot;Correlazione&quot;/>&#xa;    &lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$CreateCase.part1/tns:Create/tns:Response/tns:Esito = &amp;quot;OK&amp;quot;&quot;>&#xa;                &lt;ns:output>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Check_Dati/tns1:Check[1]='KO'&quot;>&#xa;                            &lt;ns:FlagCorrelazione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                            &lt;/ns:FlagCorrelazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Correlazione/ns2:Output_Correlazione='Y'&quot;>&#xa;                            &lt;ns:FlagCorrelazione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                            &lt;/ns:FlagCorrelazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:FlagCorrelazione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/ns:FlagCorrelazione>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA/ns1:DN&quot;>&#xa;                        &lt;ns:DN>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA/ns1:DN&quot;/>&#xa;                        &lt;/ns:DN>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$CreateCase.part1/tns:Create/tns:AssetNow&quot;>&#xa;                        &lt;ns:IdAssetNow>&#xa;                            &lt;xsl:value-of select=&quot;$CreateCase.part1/tns:Create/tns:AssetNow&quot;/>&#xa;                        &lt;/ns:IdAssetNow>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:OGG_Request>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Check_Dati/tns1:Check[1]='KO'&quot;>&#xa;                                &lt;ns:Stato>&#xa;                                    &lt;xsl:value-of select=&quot;'LAVORATO CON CORRELAZIONE KO'&quot;/>&#xa;                                &lt;/ns:Stato>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns:Stato>&#xa;                                    &lt;xsl:value-of select=&quot;'LAVORATO'&quot;/>&#xa;                                &lt;/ns:Stato>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ns:OGG_Request>&#xa;                    &lt;ns:OGG_Response>&#xa;                        &lt;ns:ReturnCode>&#xa;                            &lt;xsl:value-of select=&quot;'00'&quot;/>&#xa;                        &lt;/ns:ReturnCode>&#xa;                        &lt;ns:Stato>&#xa;                            &lt;xsl:value-of select=&quot;'DA LAVORARE'&quot;/>&#xa;                        &lt;/ns:Stato>&#xa;                    &lt;/ns:OGG_Response>&#xa;                &lt;/ns:output>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:output>&#xa;                    &lt;ns:FlagCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/ns:FlagCorrelazione>&#xa;                    &lt;ns:OGG_Request>&#xa;                        &lt;ns:Stato>&#xa;                            &lt;xsl:value-of select=&quot;'LAVORATO'&quot;/>&#xa;                        &lt;/ns:Stato>&#xa;                    &lt;/ns:OGG_Request>&#xa;                    &lt;ns:OGG_Response>&#xa;                        &lt;ns:ReturnCode>&#xa;                            &lt;xsl:value-of select=&quot;'99'&quot;/>&#xa;                        &lt;/ns:ReturnCode>&#xa;                        &lt;ns:Stato>&#xa;                            &lt;xsl:value-of select=&quot;'DA LAVORARE'&quot;/>&#xa;                        &lt;/ns:Stato>&#xa;                        &lt;ns:Message>&#xa;                            &lt;xsl:value-of select=&quot;'ERRORE GENERICO'&quot;/>&#xa;                        &lt;/ns:Message>&#xa;                    &lt;/ns:OGG_Response>&#xa;                &lt;/ns:output>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
