AZIONE/ns1:NGAVULA/ns1:SERVIZIO)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA) and string-length($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA/ns1:TIPOLINEA)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA) and string-length($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA/ns1:TECNOLOGIA)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA) and string-length($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA/ns1:PROFILOTECNICOLINEA)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA) and string-length($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA/ns1:ENCAPSULATION)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA) and string-length($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA/ns1:UserVLAN_1_TAGGING)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA) and string-length($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA/ns1:SLAASSURANCE)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA) and string-length($ParseCRM/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:NGAVULA/ns1:DISTRETTOTELEFONICO)=0&quot;>&lt;tns:Check>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Check>&lt;/xsl:when>&lt;xsl:otherwise