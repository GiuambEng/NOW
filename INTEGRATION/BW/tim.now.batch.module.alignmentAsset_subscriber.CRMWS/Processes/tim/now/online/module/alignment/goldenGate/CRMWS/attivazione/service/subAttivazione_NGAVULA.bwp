s3:ATTIVAZIONE/ns3:CLLI"&gt;&lt;CLLI&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:CLLI"/&gt;&lt;/CLLI&gt;&lt;/xsl:if&gt;&lt;CRMOrigine&gt;&lt;xsl:value-of select="'CRMWS'"/&gt;&lt;/CRMOrigine&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:NGAVULA/ns3:SLAASSURANCE"&gt;&lt;codiceSLAAssurance&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:NGAVULA/ns3:SLAASSURANCE"/&gt;&lt;/codiceSLAAssurance&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:RISORSA_TI)&gt;0"&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:RISORSA_TI"/&gt;&lt;/IDRisorsaNOW&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:RISORSA"/&gt;&lt;/IDRisorsaNOW&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;IDOfferta&gt;&lt;xsl:value-of select="$Start/ns2:IdOfferta"/&gt;&lt;/IDOfferta&gt;&lt;xsl:if test="string-length($ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:NGAVULA/ns3:AGGIUNTIVO)&gt;0"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:NGAVULA/ns3:AGGIUNTIVO"&gt;&lt;numeroFittizio&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:NGAVULA/ns3:AGGIUNTIVO"/&gt;&lt;/numeroFittizio&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;CRMEstrattore&gt;&lt;xsl:value-of select="'CRMWS'"/&gt;&lt;/CRMEstrattore&gt;&lt;cliente&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="0"/&gt;&lt;/IDAsset&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:CF"&gt;&lt;codiceFiscale&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:CF"/&gt;&lt;/codiceFiscale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:CLIENTE/ns3:COGNOMERAG