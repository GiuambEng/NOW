            <bpws:invoke inputVariable="CreateCase-input"
                name="CreateCase" operation="Invoke"
                outputVariable="CreateCase" partnerLink="FindUpdateCase"
                portType="ns5:FindUpdateCase" tibex:xpdlId="622b106a-02d2-4024-925e-8f217fc10fe2">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/" xmlns:tns="http://www.tim.com/NOW/xsd/FindUpdateCase/" xmlns:ns2="www.tim.now.dinamicprocess.allineamentoOggAsset" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns3="http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNGAVULA/" xmlns:tns1="www.tim.now.maxNumber" xmlns:ns1="http://www.tim.now.WLR_CorrelationProcess" xmlns:ns4="www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneNGA.xsd" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="ParseCRM"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="Toponomastica"/&gt;&lt;xsl:param name="caseModelVersion"/&gt;&lt;xsl:param name="caseType"/&gt;&lt;xsl:param name="Check1"/&gt;&lt;xsl:param name="CodiceVlan"/&gt;&lt;xsl:param name="Correlazione"/&gt;&lt;xsl:param name="Sub"/&gt;&lt;xsl:param name="ID_TPLG_OPERATORE"/&gt;&lt;xsl:template name="CreateCase-input" match="/"&gt;&lt;ns:Request&gt;&lt;part1&gt;&lt;tns:Input&gt;&lt;tns:Create&gt;&lt;tns:Input&gt;&lt;tns:caseType&gt;&lt;xsl:value-of select="$caseType"/&gt;&lt;/tns:caseType&gt;&lt;tns:caseModelVersion&gt;&lt;xsl:value-of select="$caseModelVersion"/&gt;&lt;/tns:caseModelVersion&gt;&lt;tns:Asset&gt;&lt;codiceOrdineOLO&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:CODICEORDINEOLO"/&gt;&lt;/codiceOrdineOLO&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:CODICE_ORDINE_TI"&gt;&lt;codiceOrdineTI&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:CODICE_ORDINE_TI"/&gt;&lt;/codiceOrdineTI&gt;&lt;/xsl:if&gt;&lt;codificaOLOAGCOM&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:OLO_CODING"/&gt;&lt;/codificaOLOAGCOM&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;IDContratto&gt;&lt;xsl:value-of select="xsd:int(xsd:decimal($Check1/ns2:IdContrattoNOW))"/&gt;&lt;/IDContratto&gt;&lt;statoAsset&gt;&lt;xsl:value-of select="&amp;quot;ATTIVO&amp;quot;"/&gt;&lt;/statoAsset&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:RISORSA"/&gt;&lt;/IDRisorsa&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:NGAVULA/ns3:TIPOLINEA=('POTS','ISDN') and string-length($ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:NGAVULA/ns3:DN)&gt;0"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:NGAVULA/ns3:DN"&gt;&lt;numeroTelefonico&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:NGAVULA/ns3:DN"/&gt;&lt;/numeroTelefonico&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:ID_CRMWS"&gt;&lt;IDAssetCRMWS&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:ID_CRMWS"/&gt;&lt;/IDAssetCRMWS&gt;&lt;/xsl:if&gt;&lt;DES&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DEC"/&gt;&lt;/DES&gt;&lt;ORA_DES&gt;&lt;xsl:value-of select="tib:parse-time(&amp;quot;yyyy-MM-dd&amp;quot;,xsd:string($ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DEC ))"/&gt;&lt;/ORA_DES&gt;&lt;tipologiaAccesso&gt;&lt;xsl:value-of select="&amp;quot;DATI&amp;quot;"/&gt;&lt;/tipologiaAccesso&gt;&lt;offerta&gt;&lt;xsl:value-of select="$Start/ns2:NomeOffertaEsterna"/&gt;&lt;/offerta&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:COMPLESSO"&gt;&lt;complesso&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:COMPLESSO"/&gt;&lt;/complesso&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:INTERNO"&gt;&lt;interno&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ATTIVAZIONE/ns3:DATI_SEDE/ns3:INTERNO"/&gt;&lt;/interno&gt;&lt;/