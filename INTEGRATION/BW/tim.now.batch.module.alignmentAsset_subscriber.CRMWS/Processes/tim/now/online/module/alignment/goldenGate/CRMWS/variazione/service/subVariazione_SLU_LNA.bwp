                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&lt;ns:output>&lt;ns:FlagCorrelazione>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/ns:FlagCorrelazione>&lt;ns:OGG_Request>&lt;ns:Stato>&lt;xsl:value-of select=&quot;'LAVORATO'&quot;/>&lt;/ns:Stato>&lt;/ns:OGG_Request>&lt;ns:OGG_Response>&lt;ns:ReturnCode>&lt;xsl:value-of select=&quot;'00'&quot;/>&lt;/ns:ReturnCode>&lt;ns:Stato>&lt;xsl:value-of select=&quot;'DA LAVORARE'&quot;/>&lt;/ns:Stato>&lt;/ns:OGG_Response>&lt;/ns:output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
