oOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/DESPrimoOrdine&quot;/>&#xa;                            &lt;/DESPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:CAP&quot;>&#xa;                                    &lt;CAP>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:CAP&quot;/>&#xa;                                    &lt;/CAP>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/codiceISTATComune&quot;>&#xa;                                    &lt;codiceISTATComune>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/codiceISTATComune&quot;/>&#xa;                                    &lt;/codiceISTATComune>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:ISTATPROV&quot;>&#xa;                                    &lt;codiceISTATProvincia>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:ISTATPROV&quot;/>&#xa;                                    &lt;/codiceISTATProvincia>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=1&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:CODICEINDIRIZZO&quot;>&#xa;                                    &lt;codiceToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:CODICEINDIRIZZO&quot;/>&#xa;                                    &lt;/codiceToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/comune&quot;>&#xa;                            &lt;comune>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/comune&quot;/>&#xa;                            &lt;/comune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:PARTICELLATOPONOMASTICA&quot;>&#xa;                                    &lt;descrPartToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:PARTICELLATOPONOMASTICA&quot;/>&#xa;                                    &lt;/descrPartToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:VIA&quot;>&#xa;                                    &lt;descrizioneVia>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:VIA&quot;/>&#xa;                                    &lt;/descrizioneVia>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:LOCALITA&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:LOCALITA&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:CIVICO&quot;>&#xa;                                    &lt;numeroCivico>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:CIVICO&quot;/>&#xa;                                    &lt;/numeroCivico>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:PROVINCIA&quot;>&#xa;                                    &lt;provincia>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:PROVINCIA&quot;/>&#xa;                                    &lt;/provincia>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:SIGLAPROVINCIA&quot;>&#xa;                                    &lt;siglaProvincia>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:SIGLAPROVINCIA&quot;/>&#xa;                                    &lt;/siglaProvincia>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO)=2&quot;>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;tib:pad-front($ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO, 3, '0')&quot;/>&#xa;                                &lt;/distretto>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO)=3&quot;>&#xa;                                &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO&quot;>&#xa;                                    &lt;distretto>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO&quot;/>&#xa;                                    &lt;/distretto>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO)=4&quot;>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;substring($ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO,2,3)&quot;/>&#xa;                                &lt;/distretto>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CLLI_CENTRALE&quot;>&#xa;                            &lt;CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CLLI_CENTRALE&quot;/>&#xa;                            &lt;/CLLI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CRMOrigine>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/CRMOrigine&quot;/>&#xa;                        &lt;/CRMOrigine>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/codiceSLAAssurance&quot;>&#xa;                            &lt;codiceSLAAssurance>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/codiceSLAAssurance&quot;/>&#xa;                            &lt;/codiceSLAAssurance>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDRisorsaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:RISORSA&quot;/>&#xa;                        &lt;/IDRisorsaNOW>&#xa;                        &lt;IDOfferta>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDOfferta&quot;/>&#xa;                        &lt;/IDOfferta>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/indirizzoEstesoNonCert&quot;>&#xa;                            &lt;indirizzoEstesoNonCert>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/indirizzoEstesoNonCert&quot;/>&#xa;                            &lt;/indirizzoEstesoNonCert>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/numeroFittizio&quot;>&#xa;                            &lt;numeroFittizio>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/numeroFittizio&quot;/>&#xa;                            &lt;/numeroFittizio>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns2:Asset>&#xa;                &lt;/tns2:Input>&#xa;            &lt;/tns2:Update>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcessToUpdateCaseData"/>
                </bpws:targets>
