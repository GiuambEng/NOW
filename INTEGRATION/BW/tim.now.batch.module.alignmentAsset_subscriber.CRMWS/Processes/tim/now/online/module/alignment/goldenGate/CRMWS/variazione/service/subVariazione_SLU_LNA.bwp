test="$Start/ns2:Asset_Now/IDPrimoOrdine"&gt;&lt;IDPrimoOrdine&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDPrimoOrdine"/&gt;&lt;/IDPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;IDContratto&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDContratto"/&gt;&lt;/IDContratto&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/DEC"&gt;&lt;DEC&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/DEC"/&gt;&lt;/DEC&gt;&lt;/xsl:if&gt;&lt;statoAsset&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/statoAsset"/&gt;&lt;/statoAsset&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:RISORSA"/&gt;&lt;/IDRisorsa&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/numeroTelefonico"&gt;&lt;numeroTelefonico&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/numeroTelefonico"/&gt;&lt;/numeroTelefonico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:ID_CRMWS"&gt;&lt;IDAssetCRMWS&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:ID_CRMWS"/&gt;&lt;/IDAssetCRMWS&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/IDAssetDa"&gt;&lt;IDAssetDa&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDAssetDa"/&gt;&lt;/IDAssetDa&gt;&lt;/xsl:if&gt;&lt;DES&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DEC"/&gt;&lt;/DES&gt;&lt;tipologiaAccesso&gt;&lt;xsl:value-of select="'FONIA'"/&gt;&lt;/tipologiaAccesso&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/RO"&gt;&lt;RO&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/RO"/&gt;&lt;/RO&gt;&lt;/xsl:if&gt;&lt;offerta&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/offerta"/&gt;&lt;/offerta&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/lineaRiferimento"&gt;&lt;lineaRiferimento&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/lineaRiferimento"/&gt;&lt;/lineaRiferimento&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:COMPLESSO"&gt;&lt;complesso&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:COMPLESSO"/&gt;&lt;/complesso&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:INTERNO"&gt;&lt;interno&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:INTERNO"/&gt;&lt;/interno&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:PIANO"&gt;&lt;piano&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:PIANO"/&gt;&lt;/piano&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:SCALA"&gt;&lt;scala&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:SCALA"/&gt;&lt;/scala&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:SERVIZIO='01'"&gt;&lt;dettaglioasset&gt;&lt;xsl:copy-of select="$TipoServizio_01/ns:DettaglioAsset/ancestor-or-self::*/namespace::node()"/&gt;&lt;xsl:copy-of select="$TipoServizio_01/ns:DettaglioAsset/@*"/&gt;&lt;xsl:copy-of select="$TipoServizio_01/ns:DettaglioAsset/node()"/&gt;&lt;/dettaglioasset&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;dettaglioasset&gt;&lt;xsl:copy-of select="$TipoServizio_02/ns:DettaglioAsset/ancestor-or-self::*/namespace::node()"/&gt;&lt;xsl:copy-of select="$TipoServizio_02/ns:DettaglioAsset/@*"/&gt;&lt;xsl:copy-of select="$TipoServizio_02/ns:DettaglioAsset/node()"/&gt;&lt;/dettaglioasset&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/DESPrimoOrdine"&gt;&lt;DESPrimoOrdine&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/DESPrimoOrdine"/&gt;&lt;/DESPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:CAP"&gt;&lt;CAP&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:CAP"/&gt;&lt;/CAP&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/codiceISTATComune"&gt;&lt;codiceISTATComune&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/codiceISTATComune"/&gt;&lt;/codiceISTATComune&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:ISTATPROV"&gt;&lt;codiceISTATProvincia&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:ISTATPROV"/&gt;&lt;/codiceISTATProvincia&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=1"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:CODICEINDIRIZZO"&gt;&lt;codiceToponomastica&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:CODICEINDIRIZZO"/&gt;&lt;/codiceToponomastica&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/comune"&gt;&lt;comune&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/comune"/&gt;&lt;/comune&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:PARTICELLATOPONOMASTICA"&gt;&lt;descrPartToponomastica&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:PARTICELLATOPONOMASTICA"/&gt;&lt;/descrPartToponomastica&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:VIA"&gt;&lt;descrizioneVia&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:VIA"/&gt;&lt;/descrizioneVia&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:LOCALITA"&gt;&lt;localita&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:LOCALITA"/&gt;&lt;/localita&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:CIVICO"&gt;&lt;numeroCivico&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:CIVICO"/&gt;&lt;/numeroCivico&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:PROVINCIA"&gt;&lt;provincia&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:PROVINCIA"/&gt;&lt;/provincia&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:SIGLAPROVINCIA"&gt;&lt;siglaProvincia&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:SIGLAPROVINCIA"/&gt;&lt;/siglaProvincia&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO)=2"&gt;&lt;distretto&gt;&lt;xsl:value-of select="tib:pad-front($ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO, 3, '0')"/&gt;&lt;/distretto&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO)=3"&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO"&gt;&lt;distretto&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO"/&gt;&lt;/distretto&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO)=4"&gt;&lt;distretto&gt;&lt;xsl:value-of select="substring($ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DISTR_TELEFONICO,2,3)"/&gt;&lt;/distretto&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CLLI_CENTRALE"&gt;&lt;CLLI&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:CLLI_CENTRALE"/&gt;&lt;/CLLI&gt;&lt;/xsl:if&gt;&lt;CRMOrigine&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/CRMOrigine"/&gt;&lt;/CRMOrigine&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/codiceSLAAssurance"&gt;&lt;codiceSLAAssurance&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/codiceSLAAssurance"/&gt;&lt;/codiceSLAAssurance&gt;&lt;/xsl:if&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:RISORSA"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDOfferta&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/IDOfferta"/&gt;&lt;/IDOfferta&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/indirizzoEstesoNonCert"&gt;&lt;indirizzoEstesoNonCert&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/indirizzoEstesoNonCert"/&gt;&lt;/indirizzoEstesoNonCert&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns2:Asset_Now/numeroFittizio"&gt;&lt;numeroFittizio&gt;&lt;xsl:value-of select="$Start/ns2:Asset_Now/numeroFittizio"/&gt;&lt;/numeroFittizio&gt;&lt;/xsl:if&gt;&lt;/tns2:Asset&gt;&lt;/tns2:Input&gt;&lt;/tns2:Update&gt;&lt;/tns2:Input&gt;&lt;/part1&gt;&lt;/ns1:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsisstenze.DettaglioAsset.xsd&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:ns2=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:ns3=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeULLLNA/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseCRM&quot;/>&#xa;    &lt;xsl:param name=&quot;TipoServizio_01&quot;/>&#xa;    &lt;xsl:param name=&quot;TipoServizio_02&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryNumeCivico&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateCaseData-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;tns2:Update>&#xa;                &lt;tns2:Input>&#xa;                    &lt;tns2:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns2:CaseReference&quot;/>&#xa;                    &lt;/tns2:CaseReference>&#xa;                    &lt;tns2:Asset>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/codiceOrdineOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/codiceOrdineTI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/codiceOrdineTI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/invariante&quot;>&#xa;                            &lt;invariante>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/invariante&quot;/>&#xa;                            &lt;/invariante>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDPrimoOrdine&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDPrimoOrdine&quot;/>&#xa;                            &lt;/IDPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDContratto&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/DEC&quot;>&#xa;                            &lt;DEC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/DEC&quot;/>&#xa;                            &lt;/DEC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/statoAsset&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:RISORSA&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/numeroTelefonico&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/numeroTelefonico&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:ID_CRMWS&quot;>&#xa;                            &lt;IDAssetCRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:ID_CRMWS&quot;/>&#xa;                            &lt;/IDAssetCRMWS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/IDAssetDa&quot;>&#xa;                            &lt;IDAssetDa>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/IDAssetDa&quot;/>&#xa;                            &lt;/IDAssetDa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DES>&#xa;                            &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:DEC&quot;/>&#xa;                        &lt;/DES>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;'FONIA'&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/RO&quot;>&#xa;                            &lt;RO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/RO&quot;/>&#xa;                            &lt;/RO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/offerta&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:Asset_Now/lineaRiferimento&quot;>&#xa;                            &lt;lineaRiferimento>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:Asset_Now/lineaRiferimento&quot;/>&#xa;                            &lt;/lineaRiferimento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:COMPLESSO&quot;>&#xa;                            &lt;complesso>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:COMPLESSO&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:INTERNO&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:INTERNO&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VARIAZIONE/ns3:SEDE/ns3:PIANO&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;$ParseCRM/ns3:SERVIZIO/ns3:ULLLNA/ns3:VA