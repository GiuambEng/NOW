            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.WLR_CorrelationProcess&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CorrelationProcess_1-input&quot; match=&quot;/&quot;>&lt;ns:Input_1>&lt;xsl:choose>&lt;xsl:when test=&quot;(($Start/ns:Asset_Now/statoAsset='ATTIVO' or $Start/ns:Asset_Now/statoAsset='CESSATO') and string-length($Start/ns:Asset_Now/numeroTelefonico)>0 and ($Start/ns:Asset_Now/dettaglioasset[nomeComponente='ACCESSONGAFTTCAB' or nomeComponente='ACCESSONGAFTTH' or nomeComponente='ACCESSOVULAFTTCAB' or nomeComponente='ACCESSOVULAFTTH' or nomeComponente='ACCESSOATMASIMFLAT' or nomeComponente='ACCESSOATMASIMHL' or nomeComponente='ACCESSOATMASIMLITE' or nomeComponente='ACCESSOGBEASIMFLAT' or nomeComponente='ACCESSOEASYIPBASEPLUSFLAT' or nomeComponente='ACCESSOEASYIPBASEPLUSLITE' or nomeComponente='ACCESSOEASYIPSPECIALPROFILEFLAT' or nomeComponente='ACCESSOEASYIPSPECIALPROFILELITE' ]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo='POTS' or $Start/ns:Asset_Now/dettaglioasset[nomeComponente='ACCESSONGAFTTCAB' or nomeComponente='ACCESSONGAFTTH' or nomeComponente='ACCESSOVULAFTTCAB' or nomeComponente='ACCESSOVULAFTTH' or nomeComponente='ACCESSOATMASIMFLAT' or nomeComponente='ACCESSOATMASIMHL' or nomeComponente='ACCESSOATMASIMLITE' or nomeComponente='ACCESSOGBEASIMFLAT' or nomeComponente='ACCESSOEASYIPBASEPLUSFLAT' or nomeComponente='ACCESSOEASYIPBASEPLUSLITE' or nomeComponente='ACCESSOEASYIPSPECIALPROFILEFLAT' or nomeComponente='ACCESSOEASYIPSPECIALPROFILELITE']/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo='ISDN')) or (($Start/ns:Asset_Now/offerta='SHACONMANODOPERA' or $Start/ns:Asset_Now/offerta='SHASENZAMANODOPERA') and $Start/ns:Asset_Now/statoAsset='ATTIVO' and string-length($Start/ns:Asset_Now/numeroTelefonico)>0) or (($Start/ns:Asset_Now/offerta='SHACONMANODOPERA' or $Start/ns:Asset_Now/offerta='SHASENZAMANODOPERA') and $Start/ns:Asset_Now/statoAsset='CESSATO' and string-length($Start/ns:Asset_Now/IDRisorsaCorrelato)>0)&quot;>&lt;ns:Tipologia>&lt;xsl:value-of select=&quot;&amp;quot;Tipologia_1&amp;quot;&quot;/>&lt;/ns:Tipologia>&lt;/xsl:when>&lt;xsl:when test=&quot;(($Start/ns:Asset_Now/statoAsset='ATTIVO' or $Start/ns:Asset_Now/statoAsset='CESSATO') and($Start/ns:Asset_Now/dettaglioasset[nomeComponente='ACCESSONGAFTTCAB' or nomeComponente='ACCESSONGAFTTH' or nomeComponente='ACCESSOVULAFTTCAB' or nomeComponente='ACCESSOVULAFTTH' or nomeComponente='ACCESSOATMASIMFLAT' or nomeComponente='ACCESSOATMASIMHL' or nomeComponente='ACCESSOATMASIMLITE' or nomeComponente='ACCESSOGBEASIMFLAT' or nomeComponente='ACCESSOEASYIPBASEPLUSFLAT' or nomeComponente='ACCESSOEASYIPBASEPLUSLITE' or nomeComponente='ACCESSOEASYIPSPECIALPROFILEFLAT' or nomeComponente='ACCESSOEASYIPSPECIALPROFILELITE']/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo='LineaNonFonia') and string-length($Start/ns:Asset_Now/IDRisorsaOLD)>0)&quot;>&lt;ns:Tipologia>&lt;xsl:value-of select=&quot;&amp;quot;Tipologia_2&amp;quot;&quot;/>&lt;/ns:Tipologia>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:Tipologia>&lt;xsl:value-of select=&quot;&amp;quot;No_Tipologia&amp;quot;&quot;/>&lt;/ns:Tipologia>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ns:DN&quot;>&lt;ns:DN>&lt;xsl:value-of select=&quot;$Start/ns:DN&quot;/>&lt;/ns:DN>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Asset_Now/IDRisorsaOLD&quot;>&lt;ns:IdRisorsaOLD>&lt;xsl:value-of select=&quot;$Start/ns:Asset_Now/IDRisorsaOLD&quot;/>&lt;/ns:IdRisorsaOLD>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:Asset_Now/statoAsset='ATTIVO' and string-length($Start/ns:Asset_Now/numeroTelefonico)>0 and ($Start/ns:Asset_Now/dettaglioasset[nomeComponente='ACCESSONGAFTTCAB' or nomeComponente='ACCESSONGAFTTH' or nomeComponente='ACCESSOVULAFTTCAB' or