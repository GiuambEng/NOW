                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns1=&quot;www.tim.now.check.allineamentoconsistenze.querystring.main.ogg&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindCase.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;BDS_ID_Order&quot;/>&#xa;    &lt;xsl:template name=&quot;Asset-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($FindCase.part1/tns:Find)>1 and $BDS_ID_Order/tns1:Record[1]/tns1:Stato='ATTIVO'&quot;>&#xa;                &lt;ns:AssetElement>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/IDAsset&quot;>&#xa;                        &lt;IDAsset>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/IDAsset&quot;/>&#xa;                        &lt;/IDAsset>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/codiceOrdineOLO&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/codiceOrdineTI&quot;>&#xa;                        &lt;codiceOrdineTI>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/codiceOrdineTI&quot;/>&#xa;                        &lt;/codiceOrdineTI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/invariante&quot;>&#xa;                        &lt;invariante>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/invariante&quot;/>&#xa;                        &lt;/invariante>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/lastUpdate&quot;>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/lastUpdate&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/IDRichiestaOLO&quot;>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/ID