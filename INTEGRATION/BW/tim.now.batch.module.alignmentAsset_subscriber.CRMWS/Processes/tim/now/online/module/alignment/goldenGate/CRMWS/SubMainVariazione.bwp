                  &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:ROW_ID&quot;>&#xa;                    &lt;ns1:ROW_ID>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:ROW_ID&quot;/>&#xa;                    &lt;/ns1:ROW_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_RISORSA&quot;>&#xa;                    &lt;ns1:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_RISORSA&quot;/>&#xa;                    &lt;/ns1:ID_RISORSA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Variazione.output/ns1:OGG_Response/ns1:Message)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Variazione.output/ns1:OGG_Response/ns1:Message&quot;>&#xa;                            &lt;ns1:MESSAGGIO_KO>&#xa;                                &lt;xsl:value-of select=&quot;$Variazione.output/ns1:OGG_Response/ns1:Message&quot;/>&#xa;                            &lt;/ns1:MESSAGGIO_KO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$OutputVariazione/ns1:OGG_Response/ns1:Message&quot;>&#xa;                            &lt;ns1:MESSAGGIO_KO>&#xa;                                &lt;xsl:value-of select=&quot;$OutputVariazione/ns1:OGG_Response/ns1:Message&quot;/>&#xa;                            &lt;/ns1:MESSAGGIO_KO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Variazione.output/ns