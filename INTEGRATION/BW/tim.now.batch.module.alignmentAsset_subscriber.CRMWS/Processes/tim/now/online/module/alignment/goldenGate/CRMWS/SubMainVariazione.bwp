;                        &lt;numeroTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/numeroTelefonico&quot;/>&#xa;                        &lt;/numeroTelefonico>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/IDAssetCRMWS&quot;>&#xa;                        &lt;IDAssetCRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/IDAssetCRMWS&quot;/>&#xa;                        &lt;/IDAssetCRMWS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/IDAssetDa&quot;>&#xa;                        &lt;IDAssetDa>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/IDAssetDa&quot;/>&#xa;                        &lt;/IDAssetDa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;DES>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/DES&quot;/>&#xa;                    &lt;/DES>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/ORA_DES&quot;>&#xa;                        &lt;ORA_DES>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/ORA_DES&quot;/>&#xa;                        &lt;/ORA_DES>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tipologiaAccesso>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/tipologiaAccesso&quot;/>&#xa;                    &lt;/tipologiaAccesso>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/RO&quot;>&#xa;                        &lt;RO>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/RO&quot;/>&#xa;                        &lt;/RO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/offerta&quot;/>&#xa;                    &lt;/offerta>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/lineaRiferimento&quot;>&#xa;                        &lt;lineaRiferimento>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/lineaRiferimento&quot;/>&#xa;                        &lt;/lineaRiferimento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/complesso&quot;>&#xa;                        &lt;complesso>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/complesso&quot;/>&#xa;                        &lt;/complesso>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/interno&quot;>&#xa;                        &lt;interno>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/interno&quot;/>&#xa;                        &lt;/interno>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/piano&quot;>&#xa;                        &lt;piano>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/piano&quot;/>&#xa;                        &lt;/piano>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/scala&quot;>&#xa;                        &lt;scala>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/scala&quot;/>&#xa;                        &lt;/scala>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:copy-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/dettaglioasset&quot;/>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/DESPrimoOrdine&quot;>&#xa;                        &lt;DESPrimoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/DESPrimoOrdine&quot;/>&#xa;                        &lt;/DESPrimoOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:Asset/CAP&quot;>&#xa;                        &lt;CAP>&#xa;                  