                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;OutputVariazione&quot; match=&quot;/&quot;>&#xa;        &lt;ns:output>&#xa;            &lt;ns:FlagCorrelazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;            &lt;/ns:FlagCorrelazione>&#xa;            &lt;ns:OGG_Request>&#xa;                &lt;ns:Stato>&#xa;                    &lt;xsl:value-of select=&quot;'LAVORATO'&quot;/>&#xa;                &lt;/ns:Stato>&#xa;            &lt;/ns:OGG_Request>&#xa;            &lt;ns:OGG_Response>&#xa;                &lt;ns:ReturnCode>&#xa;                    &lt;xsl:value-of select=&quot;'00'&quot;/>&#xa;                &lt;/ns:ReturnCode>&#xa;                &lt;ns:Stato>&#xa;                    &lt;xsl:value-of select=&quot;'DA LAVORARE'&quot;/>&#xa;                &lt;/ns:Stato>&#xa;            &lt;/ns:OGG_Response>&#xa;        &lt;/ns:output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
