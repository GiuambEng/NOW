                        <bpws:source linkName="LogFindCaseToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($FindCase/part1/ns10:Output/ns10:Find[ns10:Asset/statoAsset='ATTIVO'])>1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
