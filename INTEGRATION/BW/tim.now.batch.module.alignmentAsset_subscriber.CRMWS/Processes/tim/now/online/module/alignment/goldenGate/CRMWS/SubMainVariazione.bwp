                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns=&quot;www.tim.now.alignmentonline.crmws.main.ogg&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindCase.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFindCase-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;concat('**SubMainVariazione**',$JMSReceiveMessage/Body/ns:message/ns:Message/ns:TRANSACTION_ID)&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SubMainVariazione'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SubMainVariazione'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:TRANSACTION_ID&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('FindCase',tib:render-xml($FindCase.part1))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.check.allineamentoconsistenze.querystring.main.ogg&quot; xmlns:ns=&quot;www.tim.now.alignmentonline.crmws.main.ogg&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;queryAPI-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:queryStringAPI>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_NOW)>0 and (string-length($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_CRMWS)=0 or not(exists($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_CRMWS)))&quot;>&#xa;                    &lt;tns:queryAPI>&#xa;                        &lt;xsl:value-of select=&quot;'IDAsset=:IDass'&quot;/>&#xa;                    &lt;/tns:queryAPI>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_CRMWS)>0 and (string-length($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_NOW)=0 or not(exists($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_NOW)))&quot;>&#xa;                    &lt;tns:queryAPI>&#xa;                        &lt;xsl:value-of select=&quot;'IDAssetCRMWS=:IDassCRMWS'&quot;/>&#xa;                    &lt;/tns:queryAPI>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_NOW)>0 and string-length($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_CRMWS)>0 &quot;>&#xa;                    &lt;tns:queryAPI>&#xa;                        &lt;xsl:value-of select=&quot;'IDAsset=:IDass'&quot;/>&#xa;                    &lt;/tns:queryAPI>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:queryAPI>&#xa;                        &lt;xsl:value-of select=&quot;'IDRisorsa=:ID'&quot;/>&#xa;                    &lt;/tns:queryAPI>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_NOW)>0 &quot;>&#xa;                    &lt;tns:NamedParameterAssigned>&#xa;                        &lt;tns:name>&#xa;                            &lt;xsl:value-of select=&quot;'IDass'&quot;/>&#xa;                        &lt;/tns:name>&#xa;                        &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_NOW&quot;>&#xa;                            &lt;tns:value>&#xa;                                &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_NOW&quot;/>&#xa;                            &lt;/tns:value>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:NamedParameterAssigned>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_CRMWS)>0 and (string-length($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_NOW)=0 or not(exists($JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_NOW)) )&quot;>&#xa;                    &lt;tns:NamedParameterAssigned>&#xa;                        &lt;tns:name>&#xa;                            &lt;xsl:value-of select=&quot;'IDassCRMWS'&quot;/>&#xa;                        &lt;/tns:name>&#xa;                        &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:ID_ASSET_CRMWS&quot;>&#xa;                            &lt;tns:value>&#xa;                      