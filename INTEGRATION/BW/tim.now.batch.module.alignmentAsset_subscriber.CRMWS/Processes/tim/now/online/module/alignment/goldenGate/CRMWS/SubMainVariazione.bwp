                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns1=&quot;www.tim.now.alignmentonline.crmws.main.ogg&quot; xmlns:tns1=&quot;www.tim.now.check.allineamentoconsistenze.querystring.main.ogg&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindCase.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Offerta&quot;/>&#xa;    &lt;xsl:param name=&quot;Asset&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;trasCodifica&quot;/>&#xa;    &lt;xsl:param name=&quot;BDS_ID_Order&quot;/>&#xa;    &lt;xsl:template name=&quot;InputVariazione&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;(count($FindCase.part1/tns:Find)>1 and $BDS_ID_Order/tns1:Record[1]/tns1:Stato='ATTIVO') or (count($FindCase.part1/tns:Find)=1 and $FindCase.part1/tns:Find[1]/tns:Asset/statoAsset='ATTIVO')&quot;>&#xa;                &lt;ns:Input>&#xa;                    &lt;ns:IdOfferta>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Offerta/Record[1]/ID_OFFERTA)&quot;/>&#xa;                    &lt;/ns:IdOfferta>&#xa;                    &lt;xsl:if test=&quot;$Offerta/Record[1]/NOME_OFFERTA_ESTERNA&quot;>&#xa;                        &lt;ns:NomeOffertaEsterna>&#xa;                            &lt;xsl:value-of select=&quot;$Offerta/Record[1]/NOME_OFFERTA_ESTERNA&quot;/>&#xa;                        &lt;/ns:NomeOffertaEsterna>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:message/ns1:Message/ns1:TRANSACTION_ID&quot;>&#xa;                        &lt;ns:transactionId_CessatoVariato>&#xa;                            &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:message/ns1:Message/ns1:TRANSACTION_ID&quot;/>&#xa;                        &lt;/ns:transactionId_CessatoVariato>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:message/ns1:Message/ns1:CREATED&quot;>&#xa;                        &lt;ns:Created_CessatoVariato>&#xa;                            &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:message/ns1:Message/ns1:CREATED&quot;/>&#xa;                        &lt;/ns:Created_CessatoVariato>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:NomeProcesso>&#xa;                        &lt;xsl:value-of select=&quot;concat('tim.now.batch.module.alignmentAsset_subscriber.CRMWS/tim.now.online.module.alignment.goldenGate.CRMWS.variazione.service.',$trasCodifica/ns:ProcessName)&quot;/>&#xa;                    &lt;/ns:NomeProcesso>&#xa;                    &lt;ns:CheckEsistenza>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TRUE&amp;quot;&quot;/>&#xa;                    &lt;/ns:CheckEsistenza>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($FindCase.part1/tns:Find)>1 and $BDS_ID_Order/tns1:Record[1]/tns1:Stato='ATTIVO'&quot;>&#xa;                            &lt;ns:CaseReference>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/IDAsset=$BDS_ID_Order/tns1:Record[1]/tns1:BDS_ID]/tns:CaseReference&quot;/>&#xa;                            &lt;/ns:CaseReference>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(count($FindCase.part1/tns:Find)=1 and $FindCase.part1/tns:Find[1]/tns:Asset/statoAsset='ATTIVO')&quot;>&#xa;                            &lt;ns:CaseReference>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase.part1/tns:Find[tns:Asset/statoAsset='ATTIVO']/tns:CaseReference&quot;/>&#xa;       