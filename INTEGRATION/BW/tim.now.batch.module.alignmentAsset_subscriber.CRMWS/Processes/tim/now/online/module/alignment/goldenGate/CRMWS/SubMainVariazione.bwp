            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.check.allineamentoconsistenze.querystring.main.ogg&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FindCase&quot;/>&lt;xsl:template name=&quot;BDS_ID_Order-input&quot; match=&quot;/&quot;>&lt;tns:AccumulateBDS_ID>&lt;xsl:for-each select=&quot;$FindCase/part1/tns1:Output/tns1:Find&quot;>&lt;xsl:if test=&quot;tns1:Asset/IDAsset&quot;>&lt;tns:BDS_ID>&lt;xsl:value-of select=&quot;tns1:Asset/IDAsset&quot;/>&lt;/tns:BDS_ID>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/tns:AccumulateBDS_ID>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="BDS_ID_Order-input"
                    name="BDS_ID_Order" outputVariable="BDS_ID_Order"
                    tibex:xpdlId="80c53909-7bb4-4657-b737-82163df18562"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogFindCaseToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="BDS_ID_OrderToAsset">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(count($FindCase/part1/ns10:Output/ns10:Find)>1 and $BDS_ID_Order/ns6:Record[1]/ns6:Stato='ATTIVO') or (count($FindCase/part1/ns10:Output/ns10:Find)=1 and $FindCase/part1/ns10:Output/ns10:Find[1]/ns10:Asset/statoAsset='ATTIVO')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(count($FindCase.part1/ns10:Find)>1 and $BDS_ID_Order/ns6:Record[1]/ns6:Stato='ATTIVO') or (count($FindCase.part1/ns10:Find)=1 and $FindCase.part1/ns10:Find[1]/ns10:Asset/statoAsset='ATTIVO')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="BDS_ID_OrderToInput_Variazione">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.check.allineamentoconsistenze.querystring.main.ogg&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindCase.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;BDS_ID_Order-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:AccumulateBDS_ID>&#xa;            &lt;xsl:for-each select=&quot;$FindCase.part1/tns1:Find&quot;>&#xa;                &lt;xsl:if test=&quot;tns1:Asset/IDAsset&quot;>&#xa;                    &lt;tns:BDS_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns1:Asset/IDAsset&quot;/>&#xa;                    &lt;/tns:BDS_ID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:AccumulateBDS_ID>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.online.module.alignment.common.query_OrderBy" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
