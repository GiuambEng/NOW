&lt;ns1:STATO>&#xa;                                &lt;xsl:value-of select=&quot;$Variazione.output/ns1:OGG_Response/ns1:Stato&quot;/>&#xa;                            &lt;/ns1:STATO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$OutputVariazione/ns1:OGG_Response/ns1:Stato&quot;>&#xa;                            &lt;ns1:STATO>&#xa;                                &lt;xsl:value-of select=&quot;$OutputVariazione/ns1:OGG_Response/ns1:Stato&quot;/>&#xa;                            &lt;/ns1:STATO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:TRANSACTION_ID&quot;>&#xa;                    &lt;ns1:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ns1:TRANSACTION_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:TRANSACTION_ID_PARENT&quot;>&#xa;                    &lt;ns1:TRANSACTION_ID_PARENT>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:TRANSACTION_ID_PARENT&quot;/>&#xa;                    &lt;/ns1:TRANSACTION_ID_PARENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:TRANSACTION_ID_ROOT&quot;>&#xa;                    &lt;ns1:TRANSACTION_ID_ROOT>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:TRANSACTION_ID_ROOT&quot;/>&#xa;                    &lt;/ns1:TRANSACTION_ID_ROOT>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns1:CREATED_BY>&#xa;                    &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                &lt;/ns1:CREATED_BY>&#xa;                &lt;ns1:LAST_UPD>&#xa;                    &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                &lt;/ns1:LAST_UPD>&#xa;                &lt;ns1:LAST_UPD_BY>&#xa;                    &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                &lt;/ns1:LAST_UPD_BY>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:MODIFICATION_NUMBER&quot;>&#xa;                    &lt;ns1:MODIFICATION_NUM>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:MODIFICATION_NUMBER&quot;/>&#xa;                    &lt;/ns1:MODIFICATION_NUM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:CONFLICT_ID&quot;>&#xa;                    &lt;ns1:CONFLICT_ID>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:message/ns:Message/ns:CONFLICT_ID&quot;/>&#xa;                    &lt;/ns1:CONFLICT_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns1:DB_LAST_UPD>&#xa;                    &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                &lt;/ns1:DB_LAST_UPD>&#xa;                &lt;ns1:DB_LAST_UPD_SRC>&#xa;                    &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                &lt;/ns1:DB_LAST_UPD_SRC>&#xa;            &lt;/ns1:OGG_Response>&#xa;        &lt;/ns1:Input_InsertUpdateOGG>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
