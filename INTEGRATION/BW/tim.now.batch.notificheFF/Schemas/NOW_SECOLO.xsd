<?xml version="1.0" encoding="UTF-8"?>
<!-- Prima emissione per servizio verifica Idrisorsa Metroweb-->
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_SECOLO/" targetNamespace="http://www.tim.com/NOW/xsd/NOW_SECOLO/" elementFormDefault="qualified">
	<element name="RequestCreate_token">
		<complexType>
			<sequence>
				<element name="CodificaOLOAGCOM" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="CodiceOrdineOLO" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="Funzione" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="ChiaveRiferimento" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="Operatore" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="IPClient" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="N_Recap_Cliente" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="N_Recap_Cliente_ALT" minOccurs="0" maxOccurs="1" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="ResponseCreate_token">
		<complexType>
			<sequence>
			<element name="Token" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="ESITO" minOccurs="1" maxOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DESCRIZIONE" minOccurs="0" maxOccurs="1" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="RequestDecode_token">
		<complexType>
			<sequence>
				<element name="CodificaOLOAGCOM" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="CodiceOrdineOLO" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="Funzione" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="ChiaveRiferimento" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="Operatore" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="IPClient" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="Token" minOccurs="0" maxOccurs="1" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="ResponseDecode_token">
		<complexType>
			<sequence>
				<element name="ESITO" minOccurs="1" maxOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DESCRIZIONE" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="N_Recap_Cliente" minOccurs="0" maxOccurs="1" type="string"/>
				<element name="N_Recap_Cliente_ALT" minOccurs="0" maxOccurs="1" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="Fault">
		<complexType>
			<sequence>
				<element name="RETURN_CODE" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="DESCRIZIONE" type="string" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
</schema>
