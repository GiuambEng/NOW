                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ParseXmlToJDBCQuery1_DE-TOKEN">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($ParseXml/richiesta/accessoGponLna/datiCliente/recapitoFissoCliente, 'kk') or starts-with($ParseXml/richiesta/accessoGponLna/datiCliente/recapitoMobileCliente, 'kk')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($ParseXml/richiesta/accessoGponLna/datiCliente/recapitoFissoCliente, 'kk') or starts-with($ParseXml/richiesta/accessoGponLna/datiCliente/recapitoMobileCliente, 'kk')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
