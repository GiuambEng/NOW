        <bpws:variable name="GenericJDBCTimeout"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Connections/JDBC/GenericJDBCTimeout" type="xsd:int"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogRecuperaNotifiche-input" sca-bpel:internal="true"/>
