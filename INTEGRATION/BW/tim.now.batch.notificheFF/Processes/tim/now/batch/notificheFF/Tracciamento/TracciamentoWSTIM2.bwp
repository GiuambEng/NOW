ers/tns1:TracciamentoInput/tns3:OL/tns3:TESTATA/tns3:IDMESSAGGIO)>0&quot;>&lt;xsl:if test=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns3:OL/tns3:TESTATA/tns3:IDMESSAGGIO&quot;>&lt;tns:IdMessaggio>&lt;xsl:value-of select=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns3:OL/tns3:TESTATA/tns3:IDMESSAGGIO&quot;/>&lt;/tns:IdMessaggio>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($operationIn/parameters/tns1:TracciamentoInput/tns4:NotificaAttivazione_Cessazione/tns4:TESTATA/tns4:IDMESSAGGIO)>0&quot;>&lt;xsl:if test=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns4:NotificaAttivazione_Cessazione/tns4:TESTATA/tns4:IDMESSAGGIO&quot;>&lt;tns:IdMessaggio>&lt;xsl:value-of select=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns4:NotificaAttivazione_Cessazione/tns4:TESTATA/tns4:IDMESSAGGIO&quot;/>&lt;/tns:IdMessaggio>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns4:Rifiuto/tns4:TESTATA/tns4:IDMESSAGGIO&quot;>&lt;tns:IdMessaggio>&lt;xsl:value-of select=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns4:Rifiuto/tns4:TESTATA/tns4:IDMESSAGGIO&quot;/>&lt;/tns:IdMessaggio>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:IdStatoElabStaging>&lt;xsl:value-of select=&quot;11&quot;/>&lt;/tns:IdStatoElabStaging>&lt;tns:TimstpRich>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TimstpRich>&lt;xsl:if test=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns1:EONW/tns2:IdRichiestaOLO&quot;>&lt;tns:IdRichOlo>&lt;xsl:value-of select=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns1:EONW/tns2:IdRichiestaOLO&quot;/>&lt;/tns:IdRichOlo>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($operationIn/parameters/tns1:TracciamentoInput/tns3:OL/tns3:TESTATA/tns3:IDNOTIFICA)>0&quot;>&lt;xsl:if test=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns3:OL/tns3:TESTATA/tns3:IDNOTIFICA&quot;>&lt;tns:IdNotf>&lt;xsl:value-of select=