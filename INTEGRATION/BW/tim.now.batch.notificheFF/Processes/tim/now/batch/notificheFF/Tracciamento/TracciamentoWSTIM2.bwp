entoInput/tns4:NotificaAttivazione_Cessazione/tns4:TESTATA/tns4:TIPOMESSAGGIO&quot;/>&lt;/tns:TipoMessaggio>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($operationIn/parameters/tns1:TracciamentoInput/tns4:Rifiuto/tns4:TESTATA/tns4:TIPOMESSAGGIO)>0&quot;>&lt;xsl:if test=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns4:Rifiuto/tns4:TESTATA/tns4:TIPOMESSAGGIO&quot;>&lt;tns:TipoMessaggio>&lt;xsl:value-of select=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns4:Rifiuto/tns4:TESTATA/tns4:TIPOMESSAGGIO&quot;/>&lt;/tns:TipoMessaggio>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$EONW/tns2:IdEONW&quot;>&lt;tns:IdEventoOrdnNowWhls>&lt;xsl:value-of select=&quot;$EONW/tns2:IdEONW&quot;/>&lt;/tns:IdEventoOrdnNowWhls>&lt;/xsl:if>&lt;xsl:if test=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns1:TransactionId&quot;>&lt;tns:Transaction_ID>&lt;xsl:value-of select=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns1:TransactionId&quot;/>&lt;/tns:Transaction_ID>&lt;/xsl:if>&lt;tns:Azione>&lt;xsl:value-of select=&quot;&amp;quot;Insert&amp;quot;&quot;/>&lt;/tns:Azione>&lt;/tns:InputInsertUpdate>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
