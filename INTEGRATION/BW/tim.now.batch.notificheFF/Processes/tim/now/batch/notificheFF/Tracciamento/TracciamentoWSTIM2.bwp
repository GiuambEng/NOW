                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/WSTIM2/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;operationIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;EONW&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($operationIn.parameters/tns1:InsertUpdateStaging)&quot;>&#xa;                &lt;tns:InputInsertUpdate>&#xa;                    &lt;xsl:if test=&quot;$operationIn.parameters/tns1:InsertUpdateStaging/tns:ContenutoRequest&quot;>&#xa;                        &lt;tns:ContenutoRequest>&#xa;                            &lt;xsl:value-of select=&quot;$operationIn.parameters/tns1:InsertUpdateStaging/tns:ContenutoRequest&quot;/>&#xa;                        &lt;/tns:ContenutoRequest>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$operationIn.parameters/tns1:InsertUpdateStaging/tns:ContenutoResponse&quot;>&#xa;                        &lt;tns:ContenutoResponse>&#xa;                            &lt;xsl:value-of select=&quot;$operationIn.parameters/tns1:InsertUpdateStaging/tns:ContenutoResponse&quot;/>&#xa;                        &lt;/tns:ContenutoResponse>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$operationIn.parameters/tns1:InsertUpdateStaging/tns:DescrErrore&quot;>&#xa;                        &lt;tns:DescrErrore>&#xa;                            &lt;xsl:value-of select=