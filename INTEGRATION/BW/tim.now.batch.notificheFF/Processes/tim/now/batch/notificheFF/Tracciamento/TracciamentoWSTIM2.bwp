                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/WSTIM2/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;operationIn&quot;/>&lt;xsl:param name=&quot;EONW&quot;/>&lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($operationIn/parameters/tns1:TracciamentoInput/tns1:InsertUpdateStaging)&quot;>&lt;tns:InputInsertUpdate>&lt;xsl:if test=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns1:InsertUpdateStaging/tns:ContenutoRequest&quot;>&lt;tns:ContenutoRequest>&lt;xsl:value-of select=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns1:InsertUpdateStaging/tns:ContenutoRequest&quot;/>&lt;/tns:ContenutoRequest>&lt;/xsl:if>&lt;xsl:if test=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns1:InsertUpdateStaging/tns:ContenutoResponse&quot;>&lt;tns:ContenutoResponse>&lt;xsl:value-of select=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns1:InsertUpdateStaging/tns:ContenutoResponse&quot;/>&lt;/tns:ContenutoResponse>&lt;/xsl:if>&lt;xsl:if test=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns1:InsertUpdateStaging/tns:DescrErrore&quot;>&lt;tns:DescrErrore>&lt;xsl:value-of select=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns1:InsertUpdateStaging/tns:DescrErrore&quot;/>&lt;/tns:DescrErrore>&lt;/xsl:if>&lt;xsl:if test=&quot;$operationIn/parameters/tns1:TracciamentoInput/tns1:InsertUpdateStaging/tns:HTTPResponse&quot;>&lt;tns:HTTPResponse>&lt;xsl:value-of select=&quot;$operationIn/parameters/tn