                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EventoOperatoreRete&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/WSTIM2/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/EONOWwhls&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;operationIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;EventoOperatoreRete-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($operationIn.parameters/tns1:EventoOperatoreRete)&quot;>&#xa;                &lt;tns:InputEOR>&#xa;                    &lt;xsl:copy-of select=&quot;$operationIn.parameters/tns1:EventoOperatoreRete/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$operationIn.parameters/tns1:EventoOperatoreRete/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$operationIn.parameters/tns1:EventoOperatoreRete/node()&quot;/>&#xa;                &lt;/tns:InputEOR>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:InputEOR>&#xa;                    &lt;tns:IdEventoOrdnNowWhls>&#xa;                        &lt;xsl:value-of select=&quot;$operationIn.parameters/tns1:IdEventoOrdineNowWhls&quot;/>&#xa;                    &lt;/tns:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($operationIn.parameters/tns2:OL/tns2:TESTATA/tns2:IDNOTIFICA)>0&quot;>&#xa;                            &lt;tns:IdNotf>&#xa;                                &lt;xsl:value-of select=&quot;$operationIn.parameters/tns2:OL/tns2:TESTATA/tns2: