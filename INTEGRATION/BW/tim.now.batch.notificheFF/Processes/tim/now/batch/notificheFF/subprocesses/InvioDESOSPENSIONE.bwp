                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EventoOperatoreRete&quot; xmlns:nslt2=&quot;urn:PegaRULES:SOAP:RiscontriOL:Services&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DeSospensione.riscontriOLResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:TracciamentoInput>&#xa;            &lt;tns1:InsertUpdateStaging>&#xa;                &lt;tns2:ContenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($DeSospensione.riscontriOLResponse)&quot;/>&#xa;                &lt;/tns2:ContenutoResponse>&#xa;                &lt;tns2:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;47&quot;/>&#xa;                &lt;/tns2:IdStatoElabStaging>&#xa;                &lt;tns2:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns2:TimstpRisposta>&#xa;                &lt;tns2:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns2:IdNotf>&#xa;                &lt;tns2:CodiceAckNack>&#xa;                    &lt;xsl:value-of select=&quot;$DeSospensione.riscontriOLResponse/risposta/esito/codice&quot;/>&#xa;                &lt;/tns2:CodiceAckNack>&#xa;                &lt;tns2:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns2:IdEventoOrdnNowWhls>&#xa;                &lt;tns2:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns2:Transaction_ID>&#xa;                &lt;tns2:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&#xa;                &lt;/tns2:Azione>&#xa;                &lt;tns2:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns4:NumTentativo+1)&quot;/>&#xa;                &lt;/tns2:NumTentativo>&#xa;            &lt;/tns1:InsertUpdateStaging>&#xa;            &lt;tns1:EventoOperatoreRete>&#xa;                &lt;tns3:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns3:IdEventoOrdnNowWhls>&#xa;                &lt;tns3:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns3:IdNotf>&#xa;                &lt;tns3:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdRichOlo&quot;/>&#xa;                &lt;/tns3:IdRichOlo>&#xa;                &lt;tns3:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/idMessaggio&quot;/>&#xa;                &lt;/tns3:IdMessaggio>&#xa;                &lt;tns3:TimstpInsmto>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns3:TimstpInsmto>&#xa;                &lt;tns3:IdEventoOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdEventoOperatoreRete>&#xa;                &lt;xsl:if test=&quot;string-length($ParseXml/richiesta/desospensione/dataDesospensione)>0&quot;>&#xa;                    &lt;tns3:DataDesospensione>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$ParseXml/richiesta/desospensione/dataDesospensione)&quot;/>&#xa;                    &lt;/tns3:DataDesospensione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/desospensione/nuovaFasciaOraria&quot;>&#xa;                    &lt;tns3:FasciaOrariaDai>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/desospensione/nuovaFasciaOraria&quot;/>&#xa;                    &lt;/tns3:FasciaOrariaDai>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/desospensione/note&quot;>&#xa;                    &lt;tns3:Note>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/desospensione/note&quot;/>&#xa;                    &lt;/tns3:Note>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($ParseXml/richiesta/desospensione/nuovaDAI)>0&quot;>&#xa;                    &lt;tns3:NuovaDai>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$ParseXml/richiesta/desospensione/nuovaDAI)&quot;/>&#xa;                    &lt;/tns3:NuovaDai>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns1:EventoOperatoreRete>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;tns1:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/tns1:StatoEsec>&#xa;            &lt;tns1:ContenutoResponse>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($DeSospensione.riscontriOLResponse)&quot;/>&#xa;            &lt;/tns1:ContenutoResponse>&#xa;            &lt;tns1:CodiceAckNack>