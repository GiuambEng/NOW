                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[contains($Start/ns0:ContenutoRequest, 'Rifiuto')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogStartToParseXml">
