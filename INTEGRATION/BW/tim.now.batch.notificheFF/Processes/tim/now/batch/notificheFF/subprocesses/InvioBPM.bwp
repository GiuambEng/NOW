                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WSTIM2/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;Procso_No_file&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseAttCess&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseRifiuto&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseOL&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateError-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:TracciamentoInput>&#xa;            &lt;xsl:if test=&quot;exists($ParseOL/tns4:TESTATA)&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$ParseOL&quot;/>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($ParseAttCess/tns2:TESTATA)&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$ParseAttCess&quot;/>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($ParseRifiuto/tns2:TESTATA)&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$ParseRifiuto&quot;/>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;tns1:IdEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Procso_No_file/Record[1]/ID_ESEC_PROCSO_NO_FILE)&quot;/>&#xa;            &lt;/tns1:IdEsecProcsoNoFile>&#xa;            &lt;xsl:if test=&quot;$Procso_No_file/Record[1]/COD_PROCSO_NO_FILE&quot;>&#xa;                &lt;tns1:CodProcsoFIle>&#xa;                    &lt;xsl:value-of select=&quot;$Procso_No_file/Record[1]/COD_PROCSO_NO_FILE&quot;/>&#xa;                &lt;/tns1:CodProcsoFIle>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;            &lt;/tns1:StatoEsec>&#xa;            &lt;tns1:DescrErrore>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(),true())&quot;/>&#xa;            &lt;/tns1:DescrErrore>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ParseAttCess/tns2:TESTATA)&quot;>&#xa;                    &lt;tns1:TransactionId>&#xa;                        &lt;xsl:value-of select=&quot;concat($ParseAttCess/tns2:TESTATA/tns2:IDNOTIFICA,&amp;quot;-&amp;quot;,$ParseAttCess/tns2:TESTATA/tns2:IDMESSAGGIO)&quot;/>&#xa;                    &lt;/tns1:TransactionId>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($ParseRifiuto/tns2:TESTATA)&quot;>&#xa;                    &lt;tns1:TransactionId>&#xa;                        &lt;xsl:value-of select=&quot;concat($ParseRifiuto/tns2:TESTATA/tns2:IDNOTIFICA,&amp;quot;-&amp;quot;,$ParseRifiuto/tns2:TESTATA/tns2:IDMESSAGGIO)&quot;/>&#xa;                    &lt;/tns1:TransactionId>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:TransactionId>&#xa;                        &lt;xsl:value-of select=&quot;concat($ParseOL/tns4:TESTATA/tns4:IDNOTIFICA,&amp;quot;-&amp;quot;,$ParseOL/tns4:TESTATA/tns4:IDMESSAGGIO)&quot;/>&#xa;                    &lt;/tns1:TransactionId>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:IdEventoOrdineNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns3:IdEventoOrdineNowWhls&quot;/>&#xa;            &lt;/tns1:IdEventoOrdineNowWhls>&#xa;        &lt;/tns1:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:sources>
                                    <bpws:source linkName="UpdateErrorToCallProcess"/>
                                    </bpws:sources>
                                </bpws:invoke>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;UpdateError&quot;/>&lt;xsl:template name=&quot;LogUpdateError-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.notificheFF.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'InvioBPM'&quot;/>&lt;/tns:Process>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Processo terminato con errore. Update effettuato: &amp;quot;&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($UpdateError/parameters/tns2:TracciamentoOutput)&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogUpdateError-input"
                                    name="LogUpdateError"
                                    tibex:xpdlId="b1c124c8-6b6f-4371-81ed-4cb95fefdc4a"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="UpdateErrorToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogUpdateErrorToAssign2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UpdateError.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogUpdateError-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.notificheFF.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'InvioBPM'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Processo terminato con errore. Update effettuato: &amp;quot;&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($UpdateError.parameters)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="true()"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="Variable"
                                    name="Assign2"
                                    outputVariable="Variable"
                                    tibex:xpdlId="e8a026cb-78ab-4534-8901-91c5da5af7f3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogUpdateErrorToAssign2"/>
                                    </bpws:targets>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:catchAll>
                </bpws:faultHandlers>
                <bpws:flow name="flow1">
                    <bpws:links>
                        <bpws:link name="GroupStartToCallProcess" tibex:linkType="SUCCESS"/>
                        <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                    </bpws:links>
                    <bpws:empty name="GroupStart"
                        tibex:group="groupStart" tibex:xpdlId="97541b96-e618-48b3-94fa-7526918a4db2">
                        <bpws:sources>
                            <bpws:source linkName="GroupStartToCallProcess"/>
                        </bpws:sources>
                    </bpws:empty>
                    <bpws:empty name="GroupEnd" tibex:group="groupEnd" tibex:xpdlId="afb8142a-2d3b-4d69-ad5d-77da29949218">
                        <bpws:targets>
                            <bpws:target linkName="CallProcessToGroupEnd"/>
                        </bpws:targets>
                    </bpws:empty>
                    <bpws:extensionActivity>
                        <tibex:extActivity
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/FF2BPM&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/WSTIM1/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WSTIM2/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseOL&quot;/>&lt;xsl:param name=&quot;ParseRifiuto&quot;/>&lt;xsl:param name=&quot;ParseAttCess&quot;/>&lt;xsl:template name=&quot;InvioBPM-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ParseAttCess/tns:ATTIVAZIONE/tns:ACQUISITO/tns:CODICEORDINEFLASHFIBER)>0&quot;>&lt;Q1:InputFF2BPM>&lt;Q1:NomeComponente>&lt;xsl:value-of select=&quot;&amp;quot;FFACQUISITO&amp;quot;&quot;/>&lt;/Q1:NomeComponente>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($ParseAttCess/tns:TESTATA/tns:CODICEORDINEOPERATORE, '_')&quot;>&lt;Q1:IdRichiestaOlo>&lt;xsl:value-of select=&quot;substring-before($ParseAttCess/tns:TESTATA/tns:CODICEORDINEOPERATORE, &amp;quot;_&amp;quot;)&quot;/>&lt;/Q1:IdRichiestaOlo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Q1:IdRichiestaOlo>&lt;xsl:value-of select=&quot;$ParseAttCess/tns:TESTATA/tns:CODICEORDINEOPERATORE&quot;/>&lt;/Q1:IdRichiestaOlo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;Q1:Attributi>&lt;xsl:if test=&quot;$ParseAttCess/tns:ATTIVAZIONE/tns:ACQUISITO/tns:CODICEORDINEFLASHFIBER&quot;>&lt;Q1:CODICEORDINEFLASHFIBER>&lt;xsl:value-of select=&quot;$ParseAttCess/tns:ATTIVAZIONE/tns:ACQUISITO/tns:CODICEORDINEFLASHFIBER&quot;/>&lt;/Q1:CODICEORDINEFLASHFIBER>&lt;/xsl:if>&lt;/Q1:Attributi>&lt;/Q1:InputFF2BPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseAttCess/tns:ATTIVAZIONE/tns:EMESSO)&quot;>&lt;Q1:InputFF2BPM>&lt;Q1:NomeComponente>&lt;xsl:value-of select=&quot;&amp;quot;FFEMESSO&amp;quot;&quot;/>&lt;/Q1:NomeComponente>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($ParseAttCess/tns:TESTATA/tns:CODICEORDINEOPERATORE, '_')&quot;