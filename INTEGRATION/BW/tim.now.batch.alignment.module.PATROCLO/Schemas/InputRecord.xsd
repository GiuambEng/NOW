<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/InputRecord" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/InputRecord">

    <element name="InputRecord" type="tns:inputRecord_type"/>

    <complexType name="inputRecords_type">
    	<sequence>
    		<element name="idRichiesta" type="long"/>
    		<element name="idSlucoOld" type="string"/>
    		<element name="idSlucoNew" type="string"/>
    		<element name="dataInvio" type="string"/>
    		<element name="numeroRecd" type="int"/>
    	</sequence>
    </complexType>

    <complexType name="inputRecord_type">
    	<sequence>
    		<element name="inputRecord" type="tns:inputRecords_type" minOccurs="0" maxOccurs="unbounded"></element>
    	</sequence>
    </complexType>
</schema>
