            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="ab4d780b-37c3-432d-b58d-29c49a3bade0">
                <bpws:targets>
                    <bpws:target linkName="CallProcess2ToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToCallProcess4"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$StartEstrazioni/ns2:InputData/ns2:DataForProcedure" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($StartEstrazioni/ns2:InputData/ns2:DataForProcedure)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns2:Iterate_Current_Element_DataForProcedure"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToCallProcess3" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="CallProcess3ToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="d16f42f7-81ea-4740-9007-92561e03f683" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToCallProcess3">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($StartEstrazioni/ns2:InputData/ns2:DataForProcedure)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($StartEstrazioni/ns2:InputData/ns2:DataForProcedure)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($StartEstrazioni/ns2:InputData/ns2:DataForProcedure)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="d701de6b-1f0b-435c-b9d6-fecf6ce313aa">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess3ToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:ns=&quot;www.tim.now.StarterEstrazioni.DataForProcedure&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcedure-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:InputData>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:CODICE_OLO&quot;>&#xa;                &lt;ns:CODICEOLO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:CODICE_OLO&quot;/>&#xa;                &lt;/ns:CODICEOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:FLUSSO_ESTRAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns:FLUSSO_DI_ESTRAZIONE&quot;/>&#xa;            &lt;/ns:FLUSSO_ESTRAZIONE>&#xa;            &lt;ns:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns:ID_FILE&quot;/>&#xa;            &lt;/ns:ID_FILE>&#xa;            &lt;ns:COD_INTRFC>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns:COD_INTRFC&quot;/>&#xa;            &lt;/ns:COD_INTRFC>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DATA_INIZIO&quot;>&#xa;                &lt;ns:DATA_INIZIO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DATA_INIZIO&quot;/>&#xa;                &lt;/ns:DATA_INIZIO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DATA_FINE&quot;>&#xa;                &lt;ns:DATA_FINE>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DATA_FINE&quot;/>&#xa;                &lt;/ns:DATA_FINE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($currentElement/tns:DATA_ESPLETAMENTO)>0&quot;>&#xa;                    &lt;ns:DATA_ESPLETAMENTO>&#xa;                        &lt;xsl:value-of select=&quot;format-date(xsd:date($currentElement/tns:DATA_ESPLETAMENTO), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&#xa;                    &lt;/ns:DATA_ESPLETAMENTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:DATA_ESPLETAMENTO>&#xa;                        &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&#xa;                    &lt;/ns:DATA_ESPLETAMENTO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DESCR_FLUSSO&quot;>&#xa;                &lt;ns:DESCR_FLUSSO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DESCR_FLUSSO&quot;/>&#xa;                &lt;/ns:DESCR_FLUSSO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:InputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallProcedure-input"
                                    name="CallProcedure"
                                    tibex:xpdlId="71f7f3d5-8063-4a77-97f8-2c45e1dad498"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCallProcess3"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess3ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:ns=&quot;www.tim.now.StarterEstrazioni.DataForProcedure&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcedure-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:InputData>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:CODICE_OLO&quot;>&#xa;                &lt;ns:CODICEOLO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:CODICE_OLO&quot;/>&#xa;                &lt;/ns:CODICEOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:FLUSSO_ESTRAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns:FLUSSO_DI_ESTRAZIONE&quot;/>&#xa;            &lt;/ns:FLUSSO_ESTRAZIONE>&#xa;            &lt;ns:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns:ID_FILE&quot;/>&#xa;            &lt;/ns:ID_FILE>&#xa;            &lt;ns:COD_INTRFC>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns:COD_INTRFC&quot;/>&#xa;            &lt;/ns:COD_INTRFC>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DATA_INIZIO&quot;>&#xa;                &lt;ns:DATA_INIZIO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DATA_INIZIO&quot;/>&#xa;                &lt;/ns:DATA_INIZIO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DATA_FINE&quot;>&#xa;                &lt;ns:DATA_FINE>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DATA_FINE&quot;/>&#xa;                &lt;/ns:DATA_FINE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($currentElement/tns:DATA_ESPLETAMENTO)>0&quot;>&#xa;                    &lt;ns:DATA_ESPLETAMENTO>&#xa;                        &lt;xsl:value-of select=&quot;format-date(xsd:date($currentElement/tns:DATA_ESPLETAMENTO), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&#xa;                    &lt;/ns:DATA_ESPLETAMENTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:DATA_ESPLETAMENTO>&#xa;                        &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&#xa;                    &lt;/ns:DATA_ESPLETAMENTO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DESCR_FLUSSO&quot;>&#xa;                &lt;ns:DESCR_FLUSSO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DESCR_FLUSSO&quot;/>&#xa;                &lt;/ns:DESCR_FLUSSO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:InputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.batch.alignment.module.PATROCLO.Estrazioni.Procedure" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
