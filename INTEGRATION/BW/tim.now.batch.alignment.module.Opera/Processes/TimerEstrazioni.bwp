            <bpws:scope name="ForEach" tibex:group="foreach" tibex:xpdlId="50a250f7-3767-4e90-bbf9-a4245c1bc593">
                <bpws:targets>
                    <bpws:target linkName="JDBCQueryToForEach"/>
