                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.Estrazioni&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;getDay&quot;/>&lt;xsl:param name=&quot;LogFileOUT&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;SequenceIDFileOut&quot;/>&lt;xsl:template name=&quot;CallProcedure-input&quot; match=&quot;/&quot;>&lt;ns:InputData>&lt;ns:COD_PROCESSO_FILE>&lt;xsl:value-of select=&quot;$LogFileOUT/part1/ns2:Output/ns2:Esito/ns2:COD_PROCSO_NO_FILE&quot;/>&lt;/ns:COD_PROCESSO_FILE>&lt;ns:DATA_INIZIO>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[number($index)]/DATA_INIZIO&quot;/>&lt;/ns:DATA_INIZIO>&lt;ns:DATA_FINE>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[number($index)]/DATA_FINE&quot;/>&lt;/ns:DATA_FINE>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[number($index)]/CODICE_OLO&quot;/>&lt;/ns:CODICEOLO>&lt;ns:GIORNO>&lt;xsl:value-of select=&quot;$getDay&quot;/>&lt;/ns:GIORNO>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;$SequenceIDFileOut/Record[1]/NEXTVAL&quot;/>&lt;/ns:ID_FILE>&lt;ns:ID_PROCESSO>&lt;xsl:value-of select=&quot;$LogFileOUT/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE&quot;/>&lt;/ns:ID_PROCESSO>&lt;ns:Estrazione>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[number($index)]/ESTRAZIONE&quot;/>&lt;/ns:Estrazione>&lt;/ns:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallProcedure-input"
                                    name="CallProcedure"
                                    tibex:xpdlId="067b65f9-a55a-470a-a9b3-48e4cac2c612"
