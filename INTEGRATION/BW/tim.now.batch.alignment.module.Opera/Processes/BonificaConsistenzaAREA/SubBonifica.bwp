                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.example.org/BonificaDataInput&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Path_error_file&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;RenameFile-input&quot; match=&quot;/&quot;>&lt;tns8:RenameActivityConfig>&lt;xsl:if test=&quot;$Start/tns1:FileName&quot;>&lt;fromFileName>&lt;xsl:value-of select=&quot;$Start/tns1:FileName&quot;/>&lt;/fromFileName>&lt;/xsl:if>&lt;toFileName>&lt;xsl:value-of select=&quot;concat($Path_error_file,'/',tokenize($Start/tns1:FileName,'/')[last()],'_',translate(substring(string(current-dateTime()),1,19),'-:T',''))&quot;/>&lt;/toFileName>&lt;/tns8:RenameActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
