                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_Error_InvioJPUB-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.alignment.module.Opera.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'BonificaConsistenzaAREA'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
