                    tibex:xpdlId="89227691-7b5d-4368-8c8f-b71e7932de7d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToQUERY_Verifica_EOF_Estrazioni"/>
