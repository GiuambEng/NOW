                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3b11f61b-6fff-4f22-8173-8a11fe55ea47+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FilePoller&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcUpdateActivityInput>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_FILE)&quot;/>&#xa;            &lt;/ID_FILE>&#xa;            &lt;SISTEMA>&#xa;                &lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&#xa;            &lt;/SISTEMA>&#xa;            &lt;FLUSSO>&#xa;                &lt;xsl:value-of select=&quot;'AllineamentoMonitoraggioGiacenze'&quot;/>&#xa;            &lt;/FLUSSO>&#xa;            &lt;DETAILS>&#xa;                &lt;xsl:value-of select=&quot;concat(substring-before($FilePoller/fileInfo/fileName, &amp;quot;.ctr&amp;quot;),&amp;quot;.csv&amp;quot;)&quot;/>&#xa;            &lt;/DETAILS>&#xa;            &lt;DESCR_ERRORE>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&#xa;            &lt;/DESCR_ERRORE>&#xa;            &lt;STATO>&#xa;                &lt;xsl:value-of select=&quot;'KO TECNICO'&quot;/>&#xa;            &lt;/STATO>&#xa;            &lt;ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO_FILE>&#xa;        &lt;/tns1:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STATO_ALLINEAMENTI (ID_FILE, SISTEMA, FLUSSO,&#xa;  DETAILS, DESCR_ERRORE, FLAG_LETTURA, STATO, ID_ESEC_PROCSO_FILE)&#xa;  VALUES (?, ?, ?, ?, ?, 'Y', ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SISTEMA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLUSSO"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DETAILS"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DESCR_ERRORE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO"/>
                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_ESEC_PROCSO_FILE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="Var_PathFileError"
                                name="Error_RenameFile"
                                outputVariable="Var_PathFileError"
                                tibex:xpdlId="fdff3505-637e-472c-a05c-8baa6452ea62" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="JDBCUpdate1ToAssign"/>
                                    <bpws:target linkName="Empty1ToAssign"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="AssignToRenameFile1"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="concat($PathFileError,$NomeFileError,format-date(current-date(), &quot;[Y0001][M01][D01]&quot;), $EstensioneError)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Var_PathFileError" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:empty name="Empty1" tibex:xpdlId="393fc280-81a8-4e42-95be-32226cb2c15e">
                            <bpws:targets>
                                <bpws:target linkName="JDBCUpdate1ToEmpty1"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="Empty1ToAssign"/>
                            </bpws:sources>
                        </bpws:empty>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="RenameFile_Error-input"
                                name="RenameFile_Error"
                                outputVariable="RenameFile_Error"
                                tibex:xpdlId="3c952d45-8aa8-4ff5-92b9-0d63d691ba1c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToRenameFile1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="RenameFile1ToExit2"/>
                                    <bpws:source
                                    linkName="RenameFile1ToCallProcess5"
                                    tibex:faultDetailsVar="RenameFile_Error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Var_PathFileError&quot;/>&#xa;    &lt;xsl:param name=&quot;FindFile&quot;/>&#xa;    &lt;xsl:template name=&quot;RenameFile_Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RenameActivityConfig>&#xa;            &lt;xsl:if test=&quot;$FindFile/tns:FullName&quot;>&#xa;                &lt;fromFileName>&#xa;                    &lt;xsl:value-of select=&quot;$FindFile/tns:FullName&quot;/>&#xa;                &lt;/fromFileName>&#xa;            &lt;/xsl:if>&#xa;            &lt;toFileName>&#xa;                &lt;xsl:value-of select=&quot;$Var_PathFileError&quot;/>&#xa;            &lt;/toFileName>&#xa;        &lt;/tns2:RenameActivityConfig>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.file.rename"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//RenameFile"/>
                                    <value xsi:type="file:RenameFile"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:exit name="Exit2" tibex:xpdlId="5025dfa4-5999-4f48-a5ee-b12d77e9b775">
                            <bpws:targets>
                                <bpws:target linkName="RenameFile1ToExit2"/>
                                <bpws:target linkName="CallProcess5ToExit2"/>
                            </bpws:targets>
                        </bpws:exit>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="NoRename-input"
                                name="NoRename"
                                tibex:xpdlId="144c6313-281e-4b8e-b35c-9113928c1013"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="RenameFile1ToCallProcess5"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="CallProcess5ToExit2"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName_AllineamentoMonitoraggioGiacenze&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevelError&quot;/>&#xa;    &lt;xsl:template name=&quot;NoRename-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.alignment.module.Opera.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoMonitoraggioGiacenze'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;'***RENAME FILE ERROR - FILE NON TROVATO O CORROTTO***'&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName_AllineamentoMonitoraggioGiacenze&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevelError&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="FilePollerToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="FindFileToExit" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="FindFileToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Input_ProcessLoggerToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInput_ProcessLoggerToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="Invoke_ProcessLoggerToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogOutput_LoggerProcessToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="Invoke_InsertProcLogToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="Input_CounterToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="Input_Log_CounterToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="InvokeToExit1" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="FilePoller"
                    tibex:xpdlId="3e310eaa-6d70-4be5-80d9-5d6b1d254339"
                    variable="FilePoller" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="FilePollerToCallProcess">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <bpws:correlations/>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.file.poller"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="fileName" processProperty="FilePath_MonitGiac"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//FilePoller"/>
                                    <value contentAs="text"
                                    createEvent="true"
                                    excludeContent="true"
                                    includeCurrent="true"
                                    mode="only-files"
                                    modifyEvent="true"
                                    pollInterval="5"
                                    sortby="Date Modified"
                                    sortorder="ascending" xsi:type="file:FilePoller"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Start-input"
                    name="Start"
                    tibex:xpdlId="dc75fe0f-4200-4438-ad6f-3282614ec46c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FilePollerToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName_AllineamentoMonitoraggioGiacenze&quot;/>&#xa;    &lt;xsl:param name=&quot;FilePoller&quot;/>&#xa;    &lt;xsl:template name=&quot;Start-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.alignment.module.Opera.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoMonitoraggioGiacenze'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Start Allineamento Monitoraggio Giacenza', tib:render-xml($FilePoller, true(), true()))&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName_AllineamentoMonitoraggioGiacenze&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="FindFile-input"
                    name="FindFile" outputVariable="FindFile"
                    tibex:xpdlId="f43c8235-b8be-4b11-829b-df45ce918cad"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FindFileToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$FindFile/ns2:Esito='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$FindFile/ns2:Esito='KO']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="FindFileToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;FilePoller&quot;/>&lt;xsl:param name=&quot;LoggerName_AllineamentoMonitoraggioGiacenze&quot;/>&lt;xsl:param name=&quot;Id_Interfaccia&quot;/>&lt;xsl:param name=&quot;Id_Procso_file&quot;/>&lt;xsl:template name=&quot;FindFile-input&quot; match=&quot;/&quot;>&lt;tns:InputFileTappo>&lt;tns:FileName>&lt;xsl:value-of select=&quot;$FilePoller/fileInfo/fullName&quot;/>&lt;/tns:FileName>&lt;tns:LogName>&lt;xsl:value-of select=&quot;$LoggerName_AllineamentoMonitoraggioGiacenze&quot;/>&lt;/tns:LogName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:ApplicationName>&lt;xsl:value-of select=&quot;'tim.now.batch.alignment.module.Opera.application'&quot;/>&lt;/tns:ApplicationName>&lt;tns:ID_PROCSO_FILE>&lt;xsl:value-of select=&quot;$Id_Procso_file&quot;/>&lt;/tns:ID_PROCSO_FILE>&lt;tns:ID_INTRFC>&lt;xsl:value-of select=&quot;$Id_Interfaccia&quot;/>&lt;/tns:ID_INTRFC>&lt;tns:Estensione>&lt;xsl:value-of select=&quot;'.csv'&quot;/>&lt;/tns:Estensione>&lt;/tns:InputFileTappo>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ReadFile.ReadFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="38313271-3a40-4448-baed-f4e6402773e0">
                <bpws:targets>
                    <bpws:target linkName="FindFileToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Var_InputProcessLogger"
                    name="Input_ProcessLogger"
                    outputVariable="Var_InputProcessLogger"
                    tibex:xpdlId="87a0fef4-c9ff-4583-a3bd-523003cbb9dc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FindFileToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Input_ProcessLoggerToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Id_Interfaccia&quot;/>&#xa;    &lt;xsl:param name=&quot;Id_Procso_file&quot;/>&#xa;    &lt;xsl:param name=&quot;VersoDelFile&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoEsec&quot;/>&#xa;    &lt;xsl:param name=&quot;IdTipolgFile&quot;/>&#xa;    &lt;xsl:param name=&quot;FindFile&quot;/>&#xa;    &lt;xsl:param name=&quot;DescrStatoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Var_InputProcessLogger&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:Input>&#xa;            &lt;ns1:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns1:TipologiaProcesso>&#xa;            &lt;ns1:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/ns1:TipologiaOperazione>&#xa;            &lt;ns1:ProcFile>&#xa;                &lt;ns1:ID_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$Id_Procso_file&quot;/>&#xa;                &lt;/ns1:ID_PROCSO_FILE>&#xa;            &lt;/ns1:ProcFile>&#xa;            &lt;ns1:FileProcessato>&#xa;                &lt;xsl:if test=&quot;$FindFile/tns:LastModified&quot;>&#xa;                    &lt;ns1:DATA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$FindFile/tns:LastModified&quot;/>&#xa;                    &lt;/ns1:DATA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns1:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$DescrStatoFile&quot;/>&#xa;                &lt;/ns1:DESCR_STATO_FILE>&#xa;                &lt;ns1:ID_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Id_Interfaccia)&quot;/>&#xa;                &lt;/ns1:ID_INTRFC>&#xa;                &lt;ns1:IDTPLG_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($IdTipolgFile)&quot;/>&#xa;                &lt;/ns1:IDTPLG_FILE>&#xa;                &lt;xsl:if test=&quot;$FindFile/tns:FileName&quot;>&#xa;                    &lt;ns1:NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$FindFile/tns:FileName&quot;/>&#xa;                    &lt;/ns1:NOME_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns1:TIMSTP_APERTURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns1:TIMSTP_APERTURA_FILE>&#xa;                &lt;ns1:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$VersoDelFile&quot;/>&#xa;                &lt;/ns1:VERSO_DEL_FILE>&#xa;            &lt;/ns1:FileProcessato>&#xa;            &lt;ns1:FileProcessatoInput>&#xa;                &lt;ns1:DATA_ARRIVO>&#xa;                    &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                &lt;/ns1:DATA_ARRIVO>&#xa;                &lt;ns1:DIMENSIONE_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($FindFile/tns:Size)&quot;/>&#xa;                &lt;/ns1:DIMENSIONE_FILE>&#xa;            &lt;/ns1:FileProcessatoInput>&#xa;            &lt;ns1:EsecuzioneFile>&#xa;                &lt;ns1:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;$StatoEsec&quot;/>&#xa;                &lt;/ns1:STATO_ESEC>&#xa;                &lt;ns1:TMSP_INIZIO_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns1:TMSP_INIZIO_ELAB>&#xa;            &lt;/ns1:EsecuzioneFile>&#xa;            &lt;ns1:ContenutoFile>&#xa;                &lt;ns1:ID_CONTENUTO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                &lt;/ns1:ID_CONTENUTO_FILE>&#xa;                &lt;xsl:if test=&quot;$FindFile/tns:FullName&quot;>&#xa;                    &lt;ns1:FullName>&#xa;                        &lt;xsl:value-of select=&quot;$FindFile/tns:FullName&quot;/>&#xa;                    &lt;/ns1:FullName>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns1:ContenutoFile>&#xa;        &lt;/ns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Var_InputProcessLogger" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogInput_ProcessLogger-input"
                    name="LogInput_ProcessLogger"
                    tibex:xpdlId="f17897e1-2a04-4fe6-b78d-e9297fc62a49"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Input_ProcessLoggerToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInput_ProcessLoggerToInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Var_InputProcessLogger&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName_AllineamentoMonitoraggioGiacenze&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput_ProcessLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.alignment.module.Opera.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoMonitoraggioGiacenze'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Var_InputProcessLogger, true(), true())&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName_AllineamentoMonitoraggioGiacenze&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="Invoke_ProcessLogger-input"
                name="Invoke_ProcessLogger" operation="Insert"
                outputVariable="Invoke_ProcessLogger"
                partnerLink="Logger" portType="ns4:ProcessLog" tibex:xpdlId="c28c0d5b-fbcb-4def-bf35-9635da351a7e">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" version="2.0"&gt;
    &lt;xsl:param name="Var_InputProcessLogger"/&gt;
    &lt;xsl:template name="Invoke_ProcessLogger-input" match="/"&gt;
        &lt;tns1:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns1:Input&gt;
                    &lt;ns1:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:TipologiaProcesso"/&gt;
                    &lt;/ns1:TipologiaProcesso&gt;
                    &lt;ns1:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:TipologiaOperazione"/&gt;
                    &lt;/ns1:TipologiaOperazione&gt;
                    &lt;ns1:ProcFile&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:ProcFile/ns1:ID_PROCSO_FILE"&gt;
                            &lt;ns1:ID_PROCSO_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:ProcFile/ns1:ID_PROCSO_FILE"/&gt;
                            &lt;/ns1:ID_PROCSO_FILE&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns1:ProcFile&gt;
                    &lt;ns1:FileProcessato&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessato/ns1:COD_OLO"&gt;
                            &lt;ns1:COD_OLO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessato/ns1:COD_OLO"/&gt;
                            &lt;/ns1:COD_OLO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessato/ns1:CODFC_OLO_AGCOM"&gt;
                            &lt;ns1:CODFC_OLO_AGCOM&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessato/ns1:CODFC_OLO_AGCOM"/&gt;
                            &lt;/ns1:CODFC_OLO_AGCOM&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessato/ns1:DATA_FILE"&gt;
                            &lt;ns1:DATA_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessato/ns1:DATA_FILE"/&gt;
                            &lt;/ns1:DATA_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessato/ns1:DESCR_STATO_FILE"&gt;
                            &lt;ns1:DESCR_STATO_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessato/ns1:DESCR_STATO_FILE"/&gt;
                            &lt;/ns1:DESCR_STATO_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessato/ns1:ESITO"&gt;
                            &lt;ns1:ESITO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessato/ns1:ESITO"/&gt;
                            &lt;/ns1:ESITO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessato/ns1:ID_ESEC_PROCSO_FILE"&gt;
                            &lt;ns1:ID_ESEC_PROCSO_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessato/ns1:ID_ESEC_PROCSO_FILE"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessato/ns1:ID_FILE"&gt;
                            &lt;ns1:ID_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessato/ns1:ID_FILE"/&gt;
                            &lt;/ns1:ID_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessato/ns1:ID_INTRFC"&gt;
                            &lt;ns1:ID_INTRFC&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessato/ns1:ID_INTRFC"/&gt;
                            &lt;/ns1:ID_INTRFC&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessato/ns1:IDTPLG_FILE"&gt;
                            &lt;ns1:IDTPLG_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessato/ns1:IDTPLG_FILE"/&gt;
                            &lt;/ns1:IDTPLG_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessato/ns1:NOME_FILE"&gt;
                            &lt;ns1:NOME_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessato/ns1:NOME_FILE"/&gt;
                            &lt;/ns1:NOME_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessato/ns1:TIMSTP_APERTURA_FILE"&gt;
                            &lt;ns1:TIMSTP_APERTURA_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessato/ns1:TIMSTP_APERTURA_FILE"/&gt;
                            &lt;/ns1:TIMSTP_APERTURA_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessato/ns1:TIMSTP_CHIUSURA_FILE"&gt;
                            &lt;ns1:TIMSTP_CHIUSURA_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessato/ns1:TIMSTP_CHIUSURA_FILE"/&gt;
                            &lt;/ns1:TIMSTP_CHIUSURA_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessato/ns1:VERSO_DEL_FILE"&gt;
                            &lt;ns1:VERSO_DEL_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessato/ns1:VERSO_DEL_FILE"/&gt;
                            &lt;/ns1:VERSO_DEL_FILE&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns1:FileProcessato&gt;
                    &lt;ns1:FileProcessatoInput&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:DATA_ARRIVO"&gt;
                            &lt;ns1:DATA_ARRIVO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:DATA_ARRIVO"/&gt;
                            &lt;/ns1:DATA_ARRIVO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:DIMENSIONE_FILE"&gt;
                            &lt;ns1:DIMENSIONE_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:DIMENSIONE_FILE"/&gt;
                            &lt;/ns1:DIMENSIONE_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:ID_CAUS_SCARTO"&gt;
                            &lt;ns1:ID_CAUS_SCARTO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:ID_CAUS_SCARTO"/&gt;
                            &lt;/ns1:ID_CAUS_SCARTO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:ID_FILE_PROCSTO_INPUT"&gt;
                            &lt;ns1:ID_FILE_PROCSTO_INPUT&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:ID_FILE_PROCSTO_INPUT"/&gt;
                            &lt;/ns1:ID_FILE_PROCSTO_INPUT&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:QT_RECD_KO"&gt;
                            &lt;ns1:QT_RECD_KO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:QT_RECD_KO"/&gt;
                            &lt;/ns1:QT_RECD_KO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:QT_RECD_OK"&gt;
                            &lt;ns1:QT_RECD_OK&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:QT_RECD_OK"/&gt;
                            &lt;/ns1:QT_RECD_OK&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:QT_RECD_TOTALI"&gt;
                            &lt;ns1:QT_RECD_TOTALI&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessatoInput/ns1:QT_RECD_TOTALI"/&gt;
                            &lt;/ns1:QT_RECD_TOTALI&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns1:FileProcessatoInput&gt;
                    &lt;ns1:EsecuzioneFile&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:EsecuzioneFile/ns1:COD_PROCSO_FILE"&gt;
                            &lt;ns1:COD_PROCSO_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:EsecuzioneFile/ns1:COD_PROCSO_FILE"/&gt;
                            &lt;/ns1:COD_PROCSO_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:EsecuzioneFile/ns1:ID_ESEC_PROCSO_FILE"&gt;
                            &lt;ns1:ID_ESEC_PROCSO_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:EsecuzioneFile/ns1:ID_ESEC_PROCSO_FILE"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:EsecuzioneFile/ns1:ID_PROCSO_FILE"&gt;
                            &lt;ns1:ID_PROCSO_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:EsecuzioneFile/ns1:ID_PROCSO_FILE"/&gt;
                            &lt;/ns1:ID_PROCSO_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:EsecuzioneFile/ns1:STATO_ESEC"&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:EsecuzioneFile/ns1:STATO_ESEC"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:EsecuzioneFile/ns1:TMSP_FINE_ELAB"&gt;
                            &lt;ns1:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:EsecuzioneFile/ns1:TMSP_FINE_ELAB"/&gt;
                            &lt;/ns1:TMSP_FINE_ELAB&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:EsecuzioneFile/ns1:TMSP_INIZIO_ELAB"&gt;
                            &lt;ns1:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:EsecuzioneFile/ns1:TMSP_INIZIO_ELAB"/&gt;
                            &lt;/ns1:TMSP_INIZIO_ELAB&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns1:EsecuzioneFile&gt;
                    &lt;ns1:LogFileProcessato&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:COD_PROCSO"&gt;
                            &lt;ns1:COD_PROCSO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:COD_PROCSO"/&gt;
                            &lt;/ns1:COD_PROCSO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:ID_ESEC_PROCSO"&gt;
                            &lt;ns1:ID_ESEC_PROCSO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:ID_ESEC_PROCSO"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:ID_FILE"&gt;
                            &lt;ns1:ID_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:ID_FILE"/&gt;
                            &lt;/ns1:ID_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:LOG_LEVEL"&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:LOG_LEVEL"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:LOG_MESSAGE"&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:LOG_MESSAGE"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:TIMSTP_INSMTO"&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:TIMSTP_INSMTO"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns1:LogFileProcessato&gt;
                    &lt;ns1:FileProcessatoOutput&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessatoOutput/ns1:DIMENSIONE_FILE"&gt;
                            &lt;ns1:DIMENSIONE_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessatoOutput/ns1:DIMENSIONE_FILE"/&gt;
                            &lt;/ns1:DIMENSIONE_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessatoOutput/ns1:ESITO_INVIO"&gt;
                            &lt;ns1:ESITO_INVIO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessatoOutput/ns1:ESITO_INVIO"/&gt;
                            &lt;/ns1:ESITO_INVIO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessatoOutput/ns1:ID_FILE_PROCSTO_OUTPUT"&gt;
                            &lt;ns1:ID_FILE_PROCSTO_OUTPUT&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessatoOutput/ns1:ID_FILE_PROCSTO_OUTPUT"/&gt;
                            &lt;/ns1:ID_FILE_PROCSTO_OUTPUT&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessatoOutput/ns1:QT_RECD_TOTALI"&gt;
                            &lt;ns1:QT_RECD_TOTALI&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessatoOutput/ns1:QT_RECD_TOTALI"/&gt;
                            &lt;/ns1:QT_RECD_TOTALI&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessatoOutput/ns1:TIMSTP_CREZIONE_FILE"&gt;
                            &lt;ns1:TIMSTP_CREZIONE_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessatoOutput/ns1:TIMSTP_CREZIONE_FILE"/&gt;
                            &lt;/ns1:TIMSTP_CREZIONE_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:FileProcessatoOutput/ns1:TIMSTP_INVIO"&gt;
                            &lt;ns1:TIMSTP_INVIO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:FileProcessatoOutput/ns1:TIMSTP_INVIO"/&gt;
                            &lt;/ns1:TIMSTP_INVIO&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns1:FileProcessatoOutput&gt;
                    &lt;ns1:ContenutoFile&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:ContenutoFile/ns1:ID_CONTENUTO_FILE"&gt;
                            &lt;ns1:ID_CONTENUTO_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:ContenutoFile/ns1:ID_CONTENUTO_FILE"/&gt;
                            &lt;/ns1:ID_CONTENUTO_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:ContenutoFile/ns1:ID_FILE"&gt;
                            &lt;ns1:ID_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:ContenutoFile/ns1:ID_FILE"/&gt;
                            &lt;/ns1:ID_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:ContenutoFile/ns1:FullName"&gt;
                            &lt;ns1:FullName&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:ContenutoFile/ns1:FullName"/&gt;
                            &lt;/ns1:FullName&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns1:ContenutoFile&gt;
                &lt;/ns1:Input&gt;
            &lt;/part1&gt;
        &lt;/tns1:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Var_InputProcessLogger&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke_ProcessLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:Input>&#xa;            &lt;ns1:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;$Var_InputProcessLogger/ns1:TipologiaProcesso&quot;/>&#xa;            &lt;/ns1:TipologiaProcesso>&#xa;            &lt;ns1:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;$Var_InputProcessLogger/ns1:TipologiaOperazione&quot;/>&#xa;            &lt;/ns1:TipologiaOperazione>&#xa;            &lt;ns1:ProcFile>&#xa;                &lt;xsl:if test=&quot;$Var_InputProcessLogger/ns1:ProcFile/ns1:ID_PROCSO_FILE&quot;>&#xa;                    &lt;ns1:ID_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InputProcessLogger/ns1:ProcFile/ns1:ID_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns1:ID_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns1:ProcFile>&#xa;            &lt;ns1:FileProcessato>&#xa;                &lt;xsl:if test=&quot;$Var_InputProcessLogger/ns1:FileProcessato/ns1:COD_OLO&quot;>&#xa;                    &lt;ns1:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InputProcessLogger/ns1:FileProcessato/ns1:COD_OLO&quot;/>&#xa;                    &lt;/ns1:COD_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InputProcessLogger/ns1:FileProcessato/ns1:CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;ns1:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InputProcessLogger/ns1:FileProcessato/ns1:CODFC_OL