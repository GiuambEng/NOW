                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; xmlns:ns1=&quot;http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; xmlns:ns3=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Var_InputCounter&quot;/>&#xa;    &lt;xsl:param name=&quot;FindFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:contaRecord_Input>&#xa;            &lt;ns2:in>&#xa;                &lt;xsl:value-of select=&quot;$Var_InputCounter/ns:in&quot;/>&#xa;            &lt;/ns2:in>&#xa;            &lt;ns2:TipoSeparatore>&#xa;                &lt;xsl:value-of select=&quot;$Var_InputCounter/ns:TipoSeparatore&quot;/>&#xa;            &lt;/ns2:TipoSeparatore>&#xa;            &lt;ns2:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($Invoke_ProcessLogger.part1/ns3:Esito/ns3:ID_FILE)&quot;/>&#xa;            &lt;/ns2:ID_FILE>&#xa;            &lt;xsl:if test=&quot;$FindFile/tns:FullName&quot;>&#xa;                &lt;ns2:FULLNAME>&#xa;                    &lt;xsl:value-of select=&quot;$FindFile/tns:FullName&quot;/>&#xa;                &lt;/ns2:FULLNAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$FindFile/tns:FileName&quot;>&#xa;                &lt;ns2:FILENAME>&#xa;                    &lt;xsl:value-of select=&quot;$FindFile/tns:FileName&quot;/>&#xa;                &lt;/ns2:FILENAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns2:ID_ESEC_PROCSO_FILE>&#xa;           