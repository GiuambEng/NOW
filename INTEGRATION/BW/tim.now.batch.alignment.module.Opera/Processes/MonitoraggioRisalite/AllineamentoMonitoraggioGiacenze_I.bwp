                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:ID_FILE"/&gt;
                            &lt;/ns1:ID_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:LOG_LEVEL"&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:LOG_LEVEL"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:LOG_MESSAGE"&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:LOG_MESSAGE"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:TIMSTP_INSMTO"&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns1:LogFileProcessato/ns1:TIMSTP_INSMTO"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns1:LogFileProcessato&gt;
                &lt;/ns1:Input&gt;
            &lt;/part1&gt;
        &lt;/tns1:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
