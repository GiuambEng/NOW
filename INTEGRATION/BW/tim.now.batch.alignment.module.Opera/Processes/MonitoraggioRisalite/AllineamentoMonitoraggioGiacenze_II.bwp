        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="Output_Log_counterToNumeroRecord" tibex:linkType="SUCCESS"/>
                <bpws:link name="NumeroRecordToUpCount" tibex:linkType="SUCCESS"/>
