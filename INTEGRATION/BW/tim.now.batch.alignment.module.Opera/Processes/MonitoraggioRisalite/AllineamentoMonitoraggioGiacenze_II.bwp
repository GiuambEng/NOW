                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToUpCount">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($JMSReceiveMessage/Body/ns44:queueResponse/ns44:EsitoConteggio='OK' and $Numero=0) or $JMSReceiveMessage/Body/ns44:queueResponse/ns44:EsitoConteggio='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($JMSReceiveMessage/Body/ns44:queueResponse/ns44:EsitoConteggio='OK' and $Numero=0) or $JMSReceiveMessage/Body/ns44:queueResponse/ns44:EsitoConteggio='KO']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
