            <bpws:invoke inputVariable="Update_ChiusuraFile-input"
                name="Update_ChiusuraFile" operation="Insert"
                outputVariable="Update_ChiusuraFile"
                partnerLink="Logger" portType="ns4:ProcessLog" tibex:xpdlId="5031ecc3-8e66-4a6d-bb3c-84e313d02afd">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://www.tim.now.sharedlibrary.SelectCountRecord" xmlns:ns2="www.tim.now.contarecord_jms.response" version="2.0"&gt;&lt;xsl:param name="VersoDelFile"/&gt;&lt;xsl:param name="SelectCountRecord"/&gt;&lt;xsl:param name="JMSReceiveMessage"/&gt;&lt;xsl:template name="Update_ChiusuraFile-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:FileProcessato&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/ns:ESITO&gt;&lt;xsl:if test="$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="$VersoDelFile"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/ns:FileProcessato&gt;&lt;ns:FileProcessatoInput&gt;&lt;xsl:if test="$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE"&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;/xsl:if&gt;&lt;ns:QT_RECD_KO&gt;&lt;xsl:value-of select="xsd:integer($SelectCountRecord/ns1:NumeroRecordKO)"/&gt;&lt;/ns:QT_RECD_KO&gt;&lt;ns:QT_RECD_OK&gt;&lt;xsl:value-of select="xsd:integer($SelectCountRecord/ns1:NumeroRecordOK)"/&gt;&lt;/ns:QT_RECD_OK&gt;&lt;/ns:FileProcessatoInput&gt;&lt;ns:EsecuzioneFile&gt;&lt;xsl:if test="$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.SelectCountRecord&quot; xmlns:ns2=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VersoDelFile&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCountRecord&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;Update_ChiusuraFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;ns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_ESEC_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;ns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$VersoDelFile&quot;/>&#xa;                &lt;/ns:VERSO_DEL_FILE>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:FileProcessatoInput>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:QT_RECD_KO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($SelectCountRecord/ns1:NumeroRecordKO)&quot;/>&#xa;                &lt;/ns:QT_RECD_KO>&#xa;                &lt;ns:QT_RECD_OK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($SelectCountRecord/ns1:NumeroRecordOK)&quot;/>&#xa;                &lt;/ns:QT_RECD_OK>&#xa;            &lt;/ns:FileProcessatoInput>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_ESEC_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_FINE_ELAB>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="SelectCountRecordToUpdate_ChiusuraFile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Update_ChiusuraFileToCallProcess"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
