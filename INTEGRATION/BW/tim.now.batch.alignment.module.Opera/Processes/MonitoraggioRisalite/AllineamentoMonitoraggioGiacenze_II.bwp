                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_MON_OPR_EV_NOTF_NOW_FL (AMBITO_OFFERTA,&#xa;  CAUS_EVENTO, COD_CICLO_LAVORAZ, COD_OL, COD_ORDN_TI, CODFC_OLO_AGCOM,&#xa;  CONTENUTO_RECD, DAC, DAC_INIZIALE, DAC_RIMODULATA, DAC_RIMODULAZIONE,&#xa;  DATA_APP_MAX, DATA_APP_MIN, DATA_EVENTO, DESC_STATO_ORD, DESC_TIPOLG_ACCS,&#xa;  DESC_TIPOLG_LAVRZ, ID_ORDN, ID_RISORSA, ID_SO_DTU, ID_FILE_PROCSTO_INPUT,&#xa;  ID_RICH, ID_STATO_ELAB_STAG, INFO_ANA_DLV, MICRO_OWNER, NUM_TENTATIVI,&#xa;  NUMERO_RECD, NUMERO_NPNN, SISTEMA_ORIGINE, TIPO_EVENTO, TIPOLG_EVENTO,&#xa;  TMSP_INSMTO, ATM_STATO_ATOM, ATM_MACROSTATE)&#xa;  VALUES (?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)), ?, ?,&#xa;    ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,&#xa;    ?, ?, SYSDATE, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

