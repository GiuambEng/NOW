                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_MonitoraggioGiacenze_Subprocess&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_MonitoraggioGiacenze_Tracciato&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;Passo_AllineamentoMonitoraggioGiacenze&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;Var_InputSub&quot; match=&quot;/&quot;>&lt;tns:MonitoraggioGiacenze>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:MonitoraggioGiacenzeDetail)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:MonitoraggioGiacenzeDetail&quot;>&lt;tns:MonitoraggioGiacenzeDetail>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_AllineamentoMonitoraggioGiacenze* ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:ID_EVENTO&quot;>&lt;tns:ID_EVENTO>&lt;xsl:value-of select=&quot;tns1:ID_EVENTO&quot;/>&lt;/tns:ID_EVENTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:AMBITO_OFFERTA&quot;>&lt;tns:AMBITO_OFFERTA>&lt;xsl:value-of select=&quot;tns1:AMBITO_OFFERTA&quot;/>&lt;/tns:AMBITO_OFFERTA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ID_ORDINE&quot;>&lt;tns:ID_ORDINE>&lt;xsl:value-of select=&quot;tns1:ID_ORDINE&quot;/>&lt;/tns:ID_ORDINE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ID_SO_DTU&quot;>&lt;tns:ID_SO_DTU>&lt;xsl:value-of select=&quot;tns1:ID_SO_DTU&quot;/>&lt;/tns:ID_SO_DTU>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_ORDINE_TI&quot;>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;tns1:CODICE_ORDINE_TI&quot;/>&lt;