                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Id_Procso_file&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;Var_InputProcessLogger&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:TipologiaProcesso>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/ns:TipologiaProcesso>&lt;ns:TipologiaOperazione>&lt;xsl:value-of select=&quot;&amp;quot;LOG&amp;quot;&quot;/>&lt;/ns:TipologiaOperazione>&lt;ns:ProcFile>&lt;ns:ID_PROCSO_FILE>&lt;xsl:value-of select=&quot;$Id_Procso_file&quot;/>&lt;/ns:ID_PROCSO_FILE>&lt;/ns:ProcFile>&lt;ns:LogFileProcessato>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:COD_PROCSO_FILE&quot;>&lt;ns:COD_PROCSO>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:COD_PROCSO_FILE&quot;/>&lt;/ns:COD_PROCSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_ESEC_PROCSO_FILE&quot;>&lt;ns:ID_ESEC_PROCSO>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_ESEC_PROCSO_FILE&quot;/>&lt;/ns:ID_ESEC_PROCSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&lt;/ns:ID_FILE>&lt;/xsl:if>&lt;ns:LOG_LEVEL>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/ns:LOG_LEVEL>&lt;ns:LOG_MESSAGE>&lt;xsl:value-of select=&quot;&amp;quot;LAVORAZIONE FILE INPUT ESEGUITA CON SUCCESSO&amp;quot;&quot;/>&lt;/ns:LOG_MESSAGE>&lt;ns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_INSMTO>&lt;/ns:LogFileProcessato>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Var_InputProcessLogger" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="Invoke_UPLog-input"
