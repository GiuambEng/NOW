r/tns:Id_File&quot;>&lt;tns1:Id_File>&lt;xsl:value-of select=&quot;$var/tns:Id_File&quot;/>&lt;/tns1:Id_File>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;(($var/tns:TIPO_EVENTO='C' or $var/tns:TIPO_EVENTO='R' or $var/tns:TIPO_EVENTO='S' ) and string-length($var/tns:DATA_EVENTO)=0)&quot;>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;'DATA_EVENTO OBBLIGATORIO SE TIPO_EVENTO DIVERSO DA A'&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:when test=&quot;(($var/tns:TIPO_EVENTO='C' or $var/tns:TIPO_EVENTO='R' or $var/tns:TIPO_EVENTO='S' ) and string-length($var/tns:CAUSALE_EVENTO)=0)&quot;>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;'CAUSALE_EVENTO OBBLIGATORIO PER TIPO_EVENTO DIVERSO DA A'&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($var/tns:Flag_Validita)>0&quot;>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;'Record non confome'&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;(($var/tns:TIPO_EVENTO='C' or $var/tns:TIPO_EVENTO='R' or $var/tns:TIPO_EVENTO='S' ) and string-length($var/tns:DATA_EVENTO)=0)&quot;>&lt;tns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$KO_ELAB_STAG&quot;/>&lt;/tns1:ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:when test=&quot;(($var/tns:TIPO_EVENTO='C' or $var/tns:TIPO_EVENTO='R' or $var/tns:TIPO_EVENTO='S' ) and string-length($var/tns:CAUSALE_EVENTO)=0)&quot;>&lt;tns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$KO_ELAB_STAG&quot;/>&lt;/tns1:ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($var/tns:Flag_Validita)>0&quot;>&lt;tns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$KO_ELAB_STAG&quot;/>&lt;/tns1:ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_STAG&quot;/>&lt;/tns1:ID_STATO_ELAB_STAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:MonitoraggioGiacenze_Staging_Dettaglio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
