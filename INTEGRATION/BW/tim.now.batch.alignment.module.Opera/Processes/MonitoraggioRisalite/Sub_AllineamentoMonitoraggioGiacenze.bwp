                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.MONIT_OPERA_EV_NOTF_NOW (AMBITO_OFFERTA, ATM_MACROSTATE,&#xa;  ATM_STATO_ATOM, CAUS_EVENTO, COD_CICLO_LAVORAZ, COD_OL, COD_ORDN_TI,&#xa;  CODFC_OLO_AGCOM, DAC, DAC_INIZIALE, DAC_RIMODULATA, DAC_RIMODULAZIONE,&#xa;  DATA_APP_MAX, DATA_APP_MIN, DATA_EVENTO, DESC_STATO_ORD, DESC_TIPOLG_ACCS,&#xa;  DESC_TIPOLG_LAVRZ, ID_ORDN, ID_RISORSA, ID_SO_DTU, ID_RICH,&#xa;  INFO_ANA_DLV, MICRO_OWNER, NUM_TENTATIVI, NUMERO_NPNN, SISTEMA_ORIGINE,&#xa;  TIPO_EVENTO, TIPOLG_EVENTO, TMSP_INSMTO)&#xa;  VALUES (?,?,?,?,?,?,?,?,?,?,?,?,TO_DATE(?,'DD-MM-YYYY'),TO_DATE(?,'DD-MM-YYYY'),TO_DATE(?,'DD-MM-YYYY'),?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
