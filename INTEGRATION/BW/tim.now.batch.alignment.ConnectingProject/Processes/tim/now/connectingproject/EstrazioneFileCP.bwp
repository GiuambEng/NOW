                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/SFTPGetJavaCode/" xmlns:tns4="http://www.tim.com/NOW/xsd/SFTP_GetJavaCode" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="Path"/&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="Password"/&gt;&lt;xsl:param name="RemoteFolderDelimiter"/&gt;&lt;xsl:param name="FileNameSenzaTappo"/&gt;&lt;xsl:template name="SFTP_Get-input" match="/"&gt;&lt;tns3:SftGetJavaCodeOperationRequest&gt;&lt;SftpGetInput&gt;&lt;tns4:SFTP_GetJavaCodeInput&gt;&lt;xsl:choose&gt;&lt;xsl:when test="ends-with($Path/Record[$index]/REMOTE_PATH, $RemoteFolderDelimiter)"&gt;&lt;tns4:RemoteFile&gt;&lt;xsl:value-of select="concat($Path/Record[$index]/REMOTE_PATH, $FileNameSenzaTappo)"/&gt;&lt;/tns4:RemoteFile&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:RemoteFile&gt;&lt;xsl:value-of select="concat($Path/Record[$index]/REMOTE_PATH, $RemoteFolderDelimiter, $FileNameSenzaTappo)"/&gt;&lt;/tns4:RemoteFile&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="ends-with($Path/Record[$index]/LOCAL_PATH, $RemoteFolderDelimiter)"&gt;&lt;tns4:LocalFile&gt;&lt;xsl:value-of select="concat($Path/Record[$index]/LOCAL_PATH, $FileNameSenzaTappo)"/&gt;&lt;/tns4:LocalFile&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:LocalFile&gt;&lt;xsl:value-of select="concat($Path/Record[$index]/LOCAL_PATH, $RemoteFolderDelimiter, $FileNameSenzaTappo)"/&gt;&lt;/tns4:LocalFile&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns4:credenziali&gt;&lt;tns4:Host&gt;&lt;xsl:value-of select="$Path/Record[$index]/NOME_HOST"/&gt;&lt;/tns4:Host&gt;&lt;tns4:Port&gt;&lt;xsl:value-of select="xsd:int($Path/Record[$index]/PORT)"/&gt;&lt;/tns4:Port&gt;&lt;tns4:Password&gt;&lt;xsl:value-of select="$Password"/&gt;&lt;/tns4:Password&gt;&lt;tns4:User&gt;&lt;xsl:value-of select="$Path/Record[$index]/UTENZA"/&gt;&lt;/tns4:User&gt;&lt;/tns4:credenziali&gt;&lt;/tns4:SFTP_GetJavaCodeInput&gt;&lt;/SftpGetInput&gt;&lt;/tns3:SftGetJavaCodeOperationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/SFTPGetJavaCode/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/SFTP_GetJavaCode&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Path&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Password&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoteFolderDelimiter&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameSenzaTappo&quot;/>&#xa;    &lt;xsl:template name=&quot;SFTP_Get-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:SFTP_GetJavaCodeInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with($Path/Record[$index]/REMOTE_PATH, $RemoteFolderDelimiter)&quot;>&#xa;                    &lt;tns4:RemoteFile>&#xa;                        &lt;xsl:value-of select=&quot;concat($Path/Record[$index]/REMOTE_PATH, $FileNameSenzaTappo)&quot;/>&#xa;                    &lt;/tns4:RemoteFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:RemoteFile>&#xa;                        &lt;xsl:value-of select=&quot;concat($Path/Record[$index]/REMOTE_PATH, $RemoteFolderDelimiter, $FileNameSenzaTappo)&quot;/>&#xa;                    &lt;/tns4:RemoteFile>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with($Path/Record[$index]/LOCAL_PATH, $RemoteFolderDelimiter)&quot;>&#xa;                    &lt;tns4:LocalFile>&#xa;                        &lt;xsl:value-of select=&quot;concat($Path/Record[$index]/LOCAL_PATH, $FileNameSenzaTappo)&quot;/>&#xa;                    &lt;/tns4:LocalFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:LocalFile>&#xa;                        &lt;xsl:value-of select=&quot;concat($Path/Record[$index]/LOCAL_PATH, $RemoteFolderDelimiter, $FileNameSenzaTappo)&quot;/>&#xa;                    &lt;/tns4:LocalFile>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns4:credenziali>&#xa;                &lt;tns4:Host>&#xa;                    &lt;xsl:value-of select=&quot;$Path/Record[$index]/NOME_HOST&quot;/>&#xa;                &lt;/tns4:Host>&#xa;                &lt;tns4:Port>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Path/Record[$index]/PORT)&quot;/>&#xa;                &lt;/tns4:Port>&#xa;                &lt;tns4:Password>&#xa;                    &lt;xsl:value-of select=&quot;$Password&quot;/>&#xa;                &lt;/tns4:Password>&#xa;                &lt;tns4:User>&#xa;                    &lt;xsl:value-of select=&quot;$Path/Record[$index]/UTENZA&quot;/>&#xa;                &lt;/tns4:User>&#xa;            &lt;/tns4:credenziali>&#xa;        &lt;/tns4:SFTP_GetJavaCodeInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
