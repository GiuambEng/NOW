                                    expression="if (contains($STFP_Dir.SftpDirOutput/tns:File[$index1],'.zip')) then concat(substring-before($STFP_Dir.SftpDirOutput/tns:File[$index1],'.'),'.csv.zip') else if(contains($STFP_Dir.SftpDirOutput/tns:File[$index1],'.ZIP')) then concat(substring-before($STFP_Dir.SftpDirOutput/tns:File[$index1],'.'),'csv.ZIP') else concat(substring-before($STFP_Dir.SftpDirOutput/tns:File[$index1],'.'),'.csv')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
