                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Path&quot;/>&lt;xsl:param name=&quot;RemoteFolderDelimiter&quot;/>&lt;xsl:param name=&quot;FileNameSenzaTappo&quot;/>&lt;xsl:template name=&quot;ListFiles1-input&quot; match=&quot;/&quot;>&lt;tns12:ListFilesActivityConfig>&lt;xsl:choose>&lt;xsl:when test=&quot;ends-with($Path/Record[$index]/LOCAL_PATH, $RemoteFolderDelimiter)&quot;>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Path/Record[$index]/LOCAL_PATH, $FileNameSenzaTappo)&quot;/>&lt;/fileName>&lt;/xsl:when>&lt;xsl:otherwise>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Path/Record[$index]/LOCAL_PATH, $RemoteFolderDelimiter, $FileNameSenzaTappo)&quot;/>&lt;/fileName>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns12:ListFilesActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
