            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Path-input"
                    name="Path" outputVariable="Path"
                    tibex:xpdlId="91cd75ce-2330-4323-a9cf-b1673dd5299c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Confirm1ToPath"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SisIDQueryToLogPath"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns13=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+91cd75ce-2330-4323-a9cf-b1673dd5299c+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns13:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT SIS_INT.CODFC_OLO_AGCOM, SIS_INT.IP, SIS_INT.LOCAL_PATH,&#xd;&#xa;  SIS_INT.NOME_HOST, SIS_INT.PORT, SIS_INT.REMOTE_PATH, SIS_INT.UTENZA, INTFC.VERSO, INTFC.COD_INTRFC, OL.COD_OLO, SIS_INT.STORAGE_PATH, SIS.DESCR_SISTEMA_NOME_SISTEMA as sistema&#xd;&#xa;  FROM SISTEMA SIS, SISTEMA_IP_INTRFC SIS_INT, INTRFC INTFC, OLO OL&#xd;&#xa;  WHERE SIS.ID_SISTEMA = SIS_INT.ID_SISTEMA AND SIS_INT.ID_INTRFC = INTFC.ID_INTRFC&#xd;&#xa;     AND INTFC.VERSO = 'OUTPUT' AND SIS.DESCR_SISTEMA_NOME_SISTEMA IN ('WDC') &#xd;&#xa;     AND INTFC.COD_INTRFC IN ('ID456')&#xd;&#xa;     AND OL.CODFC_OLO_AGCOM = SIS_INT.CODFC_OLO_AGCOM AND SIS_INT.FLAG_ENABLED='Y'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata columnIndex="1"
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="IP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="LOCAL_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="NOME_HOST"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="PORT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="REMOTE_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="7"
                                    columnName="UTENZA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="8"
                                    columnName="VERSO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="9"
                                    columnName="COD_INTRFC"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="10"
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="11"
                                    columnName="STORAGE_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="12"
