                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:dataformat=&quot;http://ns.tibco.com/bw/palette/dataformat/4514554e-ac20-4503-9bd4-6314ba27a4b3&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1599647222717&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlRoom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Codice&quot;/>&lt;xsl:param name=&quot;Attributo&quot;/>&lt;xsl:param name=&quot;Frequenza&quot;/>&lt;xsl:param name=&quot;TimeReq&quot;/>&lt;xsl:param name=&quot;MsgKO&quot;/>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;AppenderCR&quot;/>&lt;xsl:template name=&quot;Copy_2_WriteControlRoom-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;tns1:ControlRoomAppender>&lt;xsl:value-of select=&quot;$AppenderCR&quot;/>&lt;/tns1:ControlRoomAppender>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LogName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns1:Application>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;$Codice&quot;/>&lt;/tns1:Codice>&lt;tns1:Attributo>&lt;xsl:value-of select=&quot;$Attributo&quot;/>&lt;/tns1:Attributo>&lt;tns1:Valore>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns1:Valore>&lt;tns1:Frequenza>&lt;xsl:value-of select=&quot;$Frequenza&quot;/>&lt;/tns1:Frequenza>&lt;tns1:Sistema>&lt;xsl:value-of select=&quot;bw:getHostName()&quot;/>&lt;/tns1:Sistema>&lt;xsl:if test=&quot;$TimeReq/tns:Data&quot;>&lt;tns1:dataVal>&lt;xsl:value-of select=&quot;$TimeReq/tns:Data&quot;/>&lt;/tns1:dataVal>&lt;/xsl:if>&lt;xsl:if test=&quot;$TimeReq/tns:Ora&qu