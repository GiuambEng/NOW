            <import namespace="http://www.example.org/ContenutoRecdAnagraficaContratti"/>
            <complexType name="Rows">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" ref="Q1:ContenutoRecordAnagraficaContratti"/>
                </sequence>
            </complexType>
            <element name="Rows" type="tns:Rows"/>
        </schema>
