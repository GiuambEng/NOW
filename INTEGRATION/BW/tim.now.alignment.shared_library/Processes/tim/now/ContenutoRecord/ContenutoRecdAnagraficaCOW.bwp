                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/render/xsd/+e8563960-92c9-4efa-9f58-e07ffb22f3e2+input&quot; xmlns:tns1=&quot;http://www.example.org/ContenutoRecdAnagraficaCOW&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Renderdata-input&quot; match=&quot;/&quot;>&lt;tns:Rows>&lt;tns1:ContenutoRecdAllineamentoCOW>&lt;xsl:variable name=&quot;var&quot; select=&quot;$Start/tns1:ContenutoRecordAllineamentoCOW_input[number($index)]&quot;/>&lt;xsl:if test=&quot;$var/tns1:Tipo_record&quot;>&lt;tns1:Tipo_record>&lt;xsl:value-of select=&quot;$var/tns1:Tipo_record&quot;/>&lt;/tns1:Tipo_record>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:CODICE_COW&quot;>&lt;tns1:CODICE_COW>&lt;xsl:value-of select=&quot;$var/tns1:CODICE_COW&quot;/>&lt;/tns1:CODICE_COW>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:CODICE_PADRE&quot;>&lt;tns1:CODICE_PADRE>&lt;xsl:value-of select=&quot;$var/tns1:CODICE_PADRE&quot;/>&lt;/tns1:CODICE_PADRE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:CREATED&quot;>&lt;tns1:CREATED>&lt;xsl:value-of select=&quot;$var/tns1:CREATED&quot;/>&lt;/tns1:CREATED>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:Flag_Validita&quot;>&lt;tns1:Flag_Validita>&lt;xsl:value-of select=&quot;$var/tns1:Flag_Validita&quot;/>&lt;/tns1:Flag_Validita>&lt;/xsl:if>&lt;/tns1:ContenutoRecdAllineamentoCOW>&lt;/tns:Rows>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
