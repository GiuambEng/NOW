                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/ContenutoRecdMigrazioneUllSlu&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Renderdata&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns2:Output_ContenutoRecord>&lt;tns2:Valore>&lt;xsl:value-of select=&quot;$Renderdata&quot;/>&lt;/tns2:Valore>&lt;tns2:Posizione>&lt;xsl:value-of select=&quot;xsd:int($Start/tns1:ContenutoRecordMigrazioneUllSlu_input[number($index)]/tns1:NumeroRecord)&quot;/>&lt;/tns2:Posizione>&lt;/tns2:Output_ContenutoRecord>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
