                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://tns.tibco.com/bw/activity/render/xsd/+3a42dce4-9066-471d-ba61-98f90d3f0c05+input&quot; xmlns:tns1=&quot;http://www.example.org/ContenutoRecdMigrazioneUllSlu&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Renderdata-input&quot; match=&quot;/&quot;>&lt;tns3:Rows>&lt;tns1:ContenutoRecdMigrazioneUllSlu>&lt;xsl:variable name=&quot;var&quot; select=&quot;$Start/tns1:ContenutoRecordMigrazioneUllSlu_input[number($index)]&quot;/>&lt;xsl:if test=&quot;$var/tns1:Clli&quot;>&lt;tns1:Clli>&lt;xsl:value-of select=&quot;$var/tns1:Clli&quot;/>&lt;/tns1:Clli>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:DistrettoTelefono&quot;>&lt;tns1:DistrettoTelefono>&lt;xsl:value-of select=&quot;$var/tns1:DistrettoTelefono&quot;/>&lt;/tns1:DistrettoTelefono>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:StatoLineaNow&quot;>&lt;tns1:StatoLineaNow>&lt;xsl:value-of select=&quot;$var/tns1:StatoLineaNow&quot;/>&lt;/tns1:StatoLineaNow>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:ServizioNow&quot;>&lt;tns1:ServizioNow>&lt;xsl:value-of select=&quot;$var/tns1:ServizioNow&quot;/>&lt;/tns1:ServizioNow>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:DettaglioLineaNow&quot;>&lt;tns1:DettaglioLineaNow>&lt;xsl:value-of select=&quot;$var/tns1:DettaglioLineaNow&quot;/>&lt;/tns1:DettaglioLineaNow>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:SegmentoLineaNow&quot;>&lt;tns1:SegmentoLineaNow>&lt;xsl:value-of select=&quot;$var/tns1:SegmentoLineaNow&quot;/>&lt;/tns1:SegmentoLineaNow>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:PosizOrizPermUnicaC&quot;>&lt;tns1:PosizOrizPermUnicaC>&lt;xsl:value-of select=&quot;$var/tns1:PosizOrizPermUnicaC&quot;/>&lt;/tns1:PosizOrizPermUnicaC>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:PosizOrizPerm