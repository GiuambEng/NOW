                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/render/xsd/+6f942f4c-9fec-4bce-962f-9fe2bec09307+input&quot; xmlns:tns2=&quot;http://www.example.org/ContenutoRecdAggiornamentoClusterComuni&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Renderdata-input&quot; match=&quot;/&quot;>&lt;tns:Rows>&lt;tns2:ContenutoRecdAggiornamentoClusterComuni>&lt;xsl:variable name=&quot;var&quot; select=&quot;$Start/tns2:ContenutoRecordAggiornamentoClusterComuni_input[number($index)]&quot;/>&lt;xsl:if test=&quot;$var/tns2:CODICE_ISTAT_COMUNE&quot;>&lt;tns2:CODICE_ISTAT_COMUNE>&lt;xsl:value-of select=&quot;$var/tns2:CODICE_ISTAT_COMUNE&quot;/>&lt;/tns2:CODICE_ISTAT_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns2:TIPOLOGIA_CLUSTER_COMUNE&quot;>&lt;tns2:TIPOLOGIA_CLUSTER_COMUNE>&lt;xsl:value-of select=&quot;$var/tns2:TIPOLOGIA_CLUSTER_COMUNE&quot;/>&lt;/tns2:TIPOLOGIA_CLUSTER_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns2:CODICE_PRICING&quot;>&lt;tns2:CODICE_PRICING>&lt;xsl:value-of select=&quot;$var/tns2:CODICE_PRICING&quot;/>&lt;/tns2:CODICE_PRICING>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns2:VERSIONING&quot;>&lt;tns2:VERSIONING>&lt;xsl:value-of select=&quot;$var/tns2:VERSIONING&quot;/>&lt;/tns2:VERSIONING>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns2:DATA_INIZIO_VALIDITA&quot;>&lt;tns2:DATA_INIZIO_VALIDITA>&lt;xsl:value-of select=&quot;$var/tns2:DATA_INIZIO_VALIDITA&quot;/>&lt;/tns2:DATA_INIZIO_VALIDITA>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns2:DATA_FINE_VALIDITA&quot;>&lt;tns2:DATA_FINE_VALIDITA>&lt;xsl:value-of select=&quot;$var/tns2:DATA_FINE_VALIDITA&quot;/>&lt;/tns2:DATA_FINE_VALIDITA>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns2:DESCRIZIONE_COMUNE&quot;>&lt;tns2:DESCRIZIONE_COMUNE>&lt;xsl:value-of select=&quot;$var/tns2:DESCRIZIONE_COMUNE&quot;/>&lt;/tns2:DESCRIZIONE_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns2:OFFERTA&quot;>&lt;tns2:OFFERTA>&lt;xsl:value-of select=&quot;$var/tns2:OFFERTA&quot;/>&lt;/tns2:OFFERTA>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns2:DATA_INIZIO_LIBERALIZZAZIONE&quot;>&lt;tns2:DATA_INIZIO_LIBERALIZZAZIONE>&lt;xsl:value-of select=&quot;$var/tns2:DATA_INIZIO_LIBERALIZZAZIONE&quot;/>&lt;/tns2:DATA_INIZIO_LIBERALIZZAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns2:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI&quot;>&lt;tns2:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&lt;xsl:value-of select=&quot;$var/tns2:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI&quot;/>&lt;/tns2:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns2:DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;>&lt;tns2:DATA_INIZIO_MARCAGGIO_PREGRESSO>&lt;xsl:value-of select=&quot;$var/tns2:DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;/>&lt;/tns2:DATA_INIZIO_MARCAGGIO_PREGRESSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns2:Flag_Validita&quot;>&lt;tns2:Flag_Validita>&lt;xsl:value-of select=&quot;$var/tns2:Flag_Validita&quot;/>&lt;/tns2:Flag_Validita>&lt;/xsl:if>&lt;/tns2:ContenutoRecdAggiornamentoClusterComuni>&lt;/tns:Rows>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.parse.renderdata"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:parse="http://ns.tibco.com/bw/palette/parse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
