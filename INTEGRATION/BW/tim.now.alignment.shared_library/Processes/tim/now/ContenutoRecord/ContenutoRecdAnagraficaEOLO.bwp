                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://tns.tibco.com/bw/activity/render/xsd/+127bad67-2049-4355-8cba-7ec8da3f0840+input&quot; xmlns:tns1=&quot;http://www.example.org/ContenutoRecdAnagraficaEOLO&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Renderdata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Rows>&#xa;            &lt;tns1:ContenutoRecdAnagraficaEOLO>&#xa;                &lt;xsl:variable name=&quot;var&quot; select=&quot;$Start/tns1:ContenutoRecordAnagraficaEOLO_input[number($index)]&quot;/>&#xa;                &lt;xsl:if test=&quot;$var/tns1:DESCR_PROV&quot;>&#xa;                    &lt;tns1:DESCR_PROV>&#xa;                        &lt;xsl:value-of select=&quot;$var/tns1:DESCR_PROV&quot;/>&#xa;                    &lt;/tns1:DESCR_PROV>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$var/tns1:COD_ISTAT_PROV&quot;>&#xa;                    &lt;tns1:COD_ISTAT_PROV>&#xa;                        &lt;xsl:value-of select=&quot;$var/tns1:COD_ISTAT_PROV&quot;/>&#xa;                    &lt;/tns1:COD_ISTAT_PROV>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$var/tns1:DESCR_COMUNE&quot;>&#xa;                    &lt;tns1:DESCR_COMUNE>&#xa;                        &lt;xsl:value-of select=&quot;$var/tns1:DESCR_COMUNE&quot;/>&#xa;                    &lt;/tns1:DESCR_COMUNE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$var/tns1:COD_ISTAT_COMUNE&quot;>&#xa;                    &lt;tns1:COD_ISTAT_COMUNE>&#xa;                        &lt;xsl:value-of select=&quot;$var/tns1:COD_ISTAT_COMUNE&quot;/>&#xa;                    &lt;/tns1:COD_ISTAT_COMUNE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl: