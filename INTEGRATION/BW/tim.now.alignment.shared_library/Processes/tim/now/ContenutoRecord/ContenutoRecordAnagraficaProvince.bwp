            <xs:import namespace="www.tim.now.migration.OutputContenutoRecd"/>
            <xs:element name="AccumulatedOutput" type="tns:AccumulatedOutputType"/>
            <xs:complexType name="AccumulatedOutputType">
                <xs:sequence maxOccurs="1" minOccurs="0">
                    <xs:element maxOccurs="unbounded" minOccurs="0" ref="Q1:Output_ContenutoRecord"/>
                </xs:sequence>
            </xs:complexType>
        </xs:schema>
        <schema
            targetNamespace="http://tns.tibco.com/bw/activity/render/xsd/+cd1549e0-31c3-4a9c-8762-5feecda66e08+input"
