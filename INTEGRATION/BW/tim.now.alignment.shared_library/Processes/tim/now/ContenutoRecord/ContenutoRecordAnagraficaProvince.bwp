                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/render/xsd/+cd1549e0-31c3-4a9c-8762-5feecda66e08+input&quot; xmlns:tns1=&quot;tim.now.migration.ContenutoRecordProvince&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Renderdata-input&quot; match=&quot;/&quot;>&lt;tns:Rows>&lt;tns1:ContenutoRecordProvince>&lt;xsl:variable name=&quot;var&quot; select=&quot;$Start/tns1:ContenutoRecordProvince_Input[number($index)]&quot;/>&lt;xsl:if test=&quot;$var/tns1:CODICE_PROVINCIA&quot;>&lt;tns1:CODICE_PROVINCIA>&lt;xsl:value-of select=&quot;$var/tns1:CODICE_PROVINCIA&quot;/>&lt;/tns1:CODICE_PROVINCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:ISTAT_PROV&quot;>&lt;tns1:ISTAT_PROV>&lt;xsl:value-of select=&quot;$var/tns1:ISTAT_PROV&quot;/>&lt;/tns1:ISTAT_PROV>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:DESCRIZIONE&quot;>&lt;tns1:DESCRIZIONE>&lt;xsl:value-of select=&quot;$var/tns1:DESCRIZIONE&quot;/>&lt;/tns1:DESCRIZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:SIGLA_PROV&quot;>&lt;tns1:SIGLA_PROV>&lt;xsl:value-of select=&quot;$var/tns1:SIGLA_PROV&quot;/>&lt;/tns1:SIGLA_PROV>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:COD_DISTRETTO&quot;>&lt;tns1:COD_DISTRETTO>&lt;xsl:value-of select=&quot;$var/tns1:COD_DISTRETTO&quot;/>&lt;/tns1:COD_DISTRETTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:FLAG_OPERAZIONE&quot;>&lt;tns1:FLAG_OPERAZIONE>&lt;xsl:value-of select=&quot;$var/tns1:FLAG_OPERAZIONE&quot;/>&lt;/tns1:FLAG_OPERAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:LATITUDINE&quot;>&lt;tns1:LATITUDINE>&lt;xsl:value-of select=&quot;$var/tns1:LATITUDINE&quot;/>&lt;/tns1:LATITUDINE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:LONGITUDINE&quot;>&lt;tns1:LONGITUDINE>&lt;xsl:value-of select=&quot;$var/tns1:LONGITUDINE&quot;/>&lt;/tns1:LONGITUDINE>&lt;/xsl:if>&lt;/tns1:ContenutoRecordProvince>&lt;/tns:Rows>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.parse.renderdata"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:parse="http://ns.tibco.com/bw/palette/parse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/parse#//RenderData"/>
                                    <value
                                    dataFormat="dataFormatResource" xsi:type="parse:RenderData"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="0d80a1d9-9f2d-44b8-8c86-37fd19649b33" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderdataToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:tns1=&quot;tim.now.migration.ContenutoRecordProvince&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Renderdata&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Output_ContenutoRecord>&#xa;            &lt;tns2:Valore>&#xa;                &lt;xsl:value-of select=&quot;$Renderdata&quot;/>&#xa;            &lt;/tns2:Valore>&#xa;            &lt;tns2:Posizione>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Start/tns1:ContenutoRecordProvince_Input[number($index)]/tns1:NumeroRecord)&quot;/>&#xa;            &lt;/tns2:Posizione>&#xa;        &lt;/tns2:Output_ContenutoRecord>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:www.tim.now.migration.OutputContenutoRecd="www.tim.now.migration.OutputContenutoRecd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="www.tim.now.migration.OutputContenutoRecd:Output_ContenutoRecord" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
