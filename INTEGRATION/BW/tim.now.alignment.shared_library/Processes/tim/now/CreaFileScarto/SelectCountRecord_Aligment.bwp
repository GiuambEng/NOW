                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="concat('SELECT ID_STATO_ELAB_STAG,  COUNT(*) FROM ', $Start/ns1:NomeTabella,' where ID_FILE_PROCSTO_INPUT= ',$Start/ns1:IdFile,' and (ID_STATO_ELAB_STAG= ',xsd:string(3),' or ID_STATO_ELAB_STAG= ',xsd:string(5), ' or ID_STATO_ELAB_STAG= ',xsd:string(6),')  GROUP BY ID_STATO_ELAB_STAG  ORDER BY ID_STATO_ELAB_STAG ')"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="StatementRecord"
                    name="StatementCountRecordKO"
                    outputVariable="StatementRecord"
                    tibex:xpdlId="b5e49a99-421b-4c41-83b0-e1b57e45c985" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToSQLDirect"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StatementCountRecordKOToStatementCountRecordOK"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat('SELECT ID_STATO_ELAB_STAG,  COUNT(*) FROM ', $Start/ns1:NomeTabella,' where ID_FILE_PROCSTO_INPUT= ',$Start/ns1:IdFile,' and (ID_STATO_ELAB_STAG= ',xsd:string(3),' or ID_STATO_ELAB_STAG= ',xsd:string(5), ' or ID_STATO_ELAB_STAG= ',xsd:string(6),')  GROUP BY ID_STATO_ELAB_STAG  ORDER BY ID_STATO_ELAB_STAG ')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
