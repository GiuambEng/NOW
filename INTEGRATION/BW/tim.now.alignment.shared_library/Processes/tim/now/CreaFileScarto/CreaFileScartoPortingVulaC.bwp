                </complexType>
            </element>
        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+e2e3d505-755f-474c-bbff-e0f13a7e2e1a+output"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+e2e3d505-755f-474c-bbff-e0f13a7e2e1a+output">
            <element name="resultSet">
