                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogStagToScritturaFileScartoPortingVulaC"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.example.org/CreaFileScarto_New&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCStaging&quot;/>&lt;xsl:template name=&quot;LogStag-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/tns1:Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'CreaFileScartoPortingVulaC'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($JDBCStaging, true(), true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns1:LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns1:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="ScritturaFileScartoPortingVulaC-input"
                                    name="ScritturaFileScartoPortingVulaC"
                                    tibex:xpdlId="0c4d3441-9386-4aed-86b2-30a055f2f07f"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogStagToScritturaFileScartoPortingVulaC"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ScritturaFileScartoPortingVulaCToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/InputScrivifile&quot; xmlns:tns1=&quot;http://www.example.org/CreaFileScarto_New&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCStaging&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ScritturaFileScartoPortingVulaC-input&quot; match=&quot;/&quot;>&lt;tns3:Record>&lt;xsl:for-each select=&quot;$JDBCStaging/Record&quot;>&lt;tns3:Riga>&lt;tns3:Contenuto>&lt;xsl:value-of select=&quot;concat(tib:substring-before-last(CONTENUTO_RCD, ';'),';',DESCRIZIONE_ERRORE)&quot;/>&lt;/tns3:Contenuto>&lt;/tns3:Riga>&lt;/xsl:for-each>&lt;tns3:NomeFile>&lt;xsl:value-of select=&quot;$Start/tns1:NomeFile&quot;/>&lt;/tns3:NomeFile>&lt;tns3:PathFile>&lt;xsl:value-of select=&quot;$Start/tns1:PathFile&quot;/>&lt;/tns3:PathFile>&lt;tns3:Application>&lt;xsl:value-of select=&quot;$Start/tns1:Application&quot;/>&lt;/tns3:Application>&lt;tns3:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns1:LogName&quot;/>&lt;/tns3:LoggerName>&lt;tns3:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns1:LogLevel&quot;/>&lt;/tns3:LogLevel>&lt;/tns3:Record>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.CreaFileScarto.ScritturaFileScartoPortingVulaC" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$JDBCStaging/lastSubset=true()]]></bpws:condition>
                    </bpws:repeatUntil>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="WriteTappo-input" name="WriteTappo"
                    outputVariable="WriteTappo"
                    tibex:xpdlId="fc53fc88-6f55-401f-aa3f-b60c8109a7bc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WriteFileToWriteTappo"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="WriteTappoToSFTP_Put_New"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.example.org/CreaFileScarto_New&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;WriteTappo-input&quot; match=&quot;/&quot;>&lt;tns4:WriteActivityInputTextClass>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Start/tns1:PathFile,substring-before($Start/tns1:NomeFile, '.csv'),'.ctr')&quot;/>&lt;/fileName>&lt;textContent>&lt;xsl:value-of select=&quot;' '&quot;/>&lt;/textContent>&lt;/tns4:WriteActivityInputTextClass>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.write"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//WriteFile"/>
                                    <value compressFile="None"
                                    createMissingDirectories="true"
                                    encoding="text" xsi:type="file:WriteFile"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogFine-input"
                    name="LogFine"
                    tibex:xpdlId="a3354089-68c9-4c47-9746-40bebeb54fed"
