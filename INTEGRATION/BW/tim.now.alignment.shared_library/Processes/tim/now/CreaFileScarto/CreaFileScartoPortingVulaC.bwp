                <bpws:link name="InviaDatiToGenericLogger" tibex:linkType="ERROR"/>
                <bpws:link name="GenericLoggerToEnd1" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
