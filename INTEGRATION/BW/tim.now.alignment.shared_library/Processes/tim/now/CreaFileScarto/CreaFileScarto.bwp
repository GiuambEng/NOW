    xmlns:ns1="http://www.tim.com/NOW/xsd/GenericLogger"
    xmlns:ns2="http://www.tibco.com/namespaces/tnt/plugins/jdbc+83a54c42-b712-4d59-93aa-ebcd19cf6fd2+input"
