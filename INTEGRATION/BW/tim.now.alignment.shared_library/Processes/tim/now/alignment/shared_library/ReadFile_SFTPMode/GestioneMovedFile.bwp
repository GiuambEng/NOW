                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.example.org/GestioneErrore" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/SFTPRenameJavaCode/" xmlns:tns2="http://www.tim.com/NOW/xsd/SFTP_RenameJavaCode" xmlns:tns3="http://www.example.org/GestioneMovedFile" version="2.0"&gt;&lt;xsl:param name="FullPathMoved"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="MovedFile-input" match="/"&gt;&lt;tns1:SftRenameJavaCodeOperationRequest&gt;&lt;SftpRenameInput&gt;&lt;tns2:SFTP_RenameJavaCodeInput&gt;&lt;tns2:source&gt;&lt;xsl:value-of select="$Start/tns3:FullPathOrigine"/&gt;&lt;/tns2:source&gt;&lt;tns2:dest&gt;&lt;xsl:value-of select="$FullPathMoved"/&gt;&lt;/tns2:dest&gt;&lt;tns2:credenziali&gt;&lt;tns2:Host&gt;&lt;xsl:value-of select="$Start/tns3:SFTP/tns3:Host"/&gt;&lt;/tns2:Host&gt;&lt;tns2:Port&gt;&lt;xsl:value-of select="$Start/tns3:SFTP/tns3:Port"/&gt;&lt;/tns2:Port&gt;&lt;tns2:Password&gt;&lt;xsl:value-of select="$Start/tns3:SFTP/tns3:Password"/&gt;&lt;/tns2:Password&gt;&lt;tns2:User&gt;&lt;xsl:value-of select="$Start/tns3:SFTP/tns3:User"/&gt;&lt;/tns2:User&gt;&lt;/tns2:credenziali&gt;&lt;/tns2:SFTP_RenameJavaCodeInput&gt;&lt;/SftpRenameInput&gt;&lt;/tns1:SftRenameJavaCodeOperationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/GestioneErrore&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/SFTPRenameJavaCode/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SFTP_RenameJavaCode&quot; xmlns:tns3=&quot;http://www.example.org/GestioneMovedFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FullPathMoved&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;MovedFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:SFTP_RenameJavaCodeInput>&#xa;            &lt;tns2:source>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns3:FullPathOrigine&quot;/>&#xa;            &lt;/tns2:source>&#xa;            &lt;tns2:dest>&#xa;                &lt;xsl:value-of select=&quot;$FullPathMoved&quot;/>&#xa;            &lt;/tns2:dest>&#xa;            &lt;tns2:credenziali>&#xa;                &lt;tns2:Host>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns3:SFTP/tns3:Host&quot;/>&#xa;                &lt;/tns2:Host>&#xa;                &lt;tns2:Port>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns3:SFTP/tns3:Port&quot;/>&#xa;                &lt;/tns2:Port>&#xa;                &lt;tns2:Password>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns3:SFTP/tns3:Password&quot;/>&#xa;                &lt;/tns2:Password>&#xa;                &lt;tns2:User>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns3:SFTP/tns3:User&quot;/>&#xa;                &lt;/tns2:User>&#xa;            &lt;/tns2:credenziali>&#xa;        &lt;/tns2:SFTP_RenameJavaCodeInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="AssignToMovedFile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="MovedFileToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$MovedFile/SftpRenameOutput/tns:SFTP_RenameJavaCodeOutput/tns:Status='KO' " expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$MovedFile.SftpRenameOutput/tns:Status='KO' ]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="MovedFileToCallProcess1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$MovedFile/SftpRenameOutput/tns:SFTP_RenameJavaCodeOutput/tns:Status='OK' and string-length(string($Start/tns1:ID_TRACK))>0 and ($Start/tns1:Flag_Outbound=false() or string-length(string($Start/tns1:Flag_Outbound))=0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$MovedFile.SftpRenameOutput/tns:Status='OK' and string-length(string($Start/tns1:ID_TRACK))>0 and ($Start/tns1:Flag_Outbound=false() or string-length(string($Start/tns1:Flag_Outbound))=0)]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="MovedFileToCallProcess2">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="MovedFileToEmpty"
                        tibex:faultDetailsVar="MovedFile" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="MovedFileToUpdFolderOUT">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$MovedFile/SftpRenameOutput/tns:SFTP_RenameJavaCodeOutput/tns:Status='OK' and string-length(string($Start/tns1:ID_TRACK))>0 and $Start/tns1:Flag_Outbound=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$MovedFile.SftpRenameOutput/tns:Status='OK' and string-length(string($Start/tns1:ID_TRACK))>0 and $Start/tns1:Flag_Outbound=true()]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="concat($Start/tns1:FolderDestinazione,$Start/tns1:NomeFile)"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="FullPathMoved"
                    name="SetFullPathMoved"
                    outputVariable="FullPathMoved"
                    tibex:xpdlId="38f26ad9-f832-44d1-9d9a-622a073ef8eb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToMovedFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToMovedFile">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SetFullPathMovedToCallProcess1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns1:FullPathOrigine=$FullPathMoved" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/tns1:FullPathOrigine=$FullPathMoved]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat($Start/tns1:FolderDestinazione,$Start/tns1:NomeFile)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="FullPathMoved" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SFTP_RenameJavaCode&quot; xmlns:tns3=&quot;http://www.example.org/GestioneMovedFile&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FullPathMoved&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;MovedFile&quot;/>&lt;xsl:param name=&quot;_error_MovedFile&quot;/>&lt;xsl:template name=&quot;LogKOMoved-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/tns3:Log/tns3:LoggerName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/tns3:Log/tns3:LoggerName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$MovedFile/SftpRenameOutput/tns2:SFTP_RenameJavaCodeOutput/tns2:Status='KO' &quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('**ERROR MOVED IN SFTP, da ', $Start/tns3:FullPathOrigine, ' a ' , $FullPathMoved, ' Descr Message ', $MovedFile/SftpRenameOutput/tns2:SFTP_RenameJavaCodeOutput/tns2:Message)&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($_error_MovedFile)&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns3:Log/tns3:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns3:Log/tns3:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns3:Log/tns3:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns3:Log/tns3:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogKOMoved-input" name="LogKOMoved"
                    tibex:xpdlId="b66cdc5a-f9fe-4d97-a59c-57a4ff99888f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MovedFileToCallProcess"/>
                        <bpws:target linkName="EmptyToLogKOMoved"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SFTP_RenameJavaCode&quot; xmlns:tns3=&quot;http://www.example.org/GestioneMovedFile&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MovedFile.SftpRenameOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;FullPathMoved&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_MovedFile&quot;/>&#xa;    &lt;xsl:template name=&quot;LogKOMoved-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;xsl:if test=&quot;$Start/tns3:Log/tns3:LoggerName&quot;>&#xa;                    &lt;tns:Application>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns3:Log/tns3:LoggerName&quot;/>&#xa;                    &lt;/tns:Application>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$MovedFile.SftpRenameOutput/tns2:Status='KO' &quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('**ERROR MOVED IN SFTP, da ', $Start/tns3:FullPathOrigine, ' a ' , $FullPathMoved, ' Descr Message ', $MovedFile.SftpRenameOutput/tns2:Message)&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($_error_MovedFile)&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Start/tns3:Log/tns3:LoggerName&quot;>&#xa;                    &lt;tns:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns3:Log/tns3:LoggerName&quot;/>&#xa;                    &lt;/tns:LoggerName>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns3:Log/tns3:LogLevel&quot;>&#xa;                    &lt;tns:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns3:Log/tns3:LogLevel&quot;/>&#xa;                    &lt;/tns:LogLevel>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; xmlns:tns1=&quot;http://www.example.org/GestioneMovedFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FullPathMoved&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;UpdFolderIN-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Update>&lt;tns:FOLDER>&lt;xsl:value-of select=&quot;$FullPathMoved&quot;/>&lt;/tns:FOLDER>&lt;xsl:if test=&quot;$Start/tns1:ID_TRACK&quot;>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;$Start/tns1:ID_TRACK&quot;/>&lt;/tns:ID_TRACK>&lt;/xsl:if>&lt;tns:LogElement>&lt;xsl:if test=&quot;$Start/tns1:Log/tns1:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns1:Log/tns1:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:Log/tns1:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns1:Log/tns1:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;/tns:LogElement>&lt;/tns:Update>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="UpdFolderIN-input" name="UpdFolderIN"
                    tibex:xpdlId="dc4ff213-0045-4f4b-99ab-940f7b219f3c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MovedFileToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdFolderToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; xmlns:tns1=&quot;http://www.example.org/GestioneMovedFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FullPathMoved&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;UpdFolderIN-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Update>&lt;tns:FOLDER>&lt;xsl:value-of select=&quot;$FullPathMoved&quot;/>&lt;/tns:FOLDER>&lt;xsl:if test=&quot;$Start/tns1:ID_TRACK&quot;>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;$Start/tns1:ID_TRACK&quot;/>&lt;/tns:ID_TRACK>&lt;/xsl:if>&lt;tns:LogElement>&lt;xsl:if test=&quot;$Start/tns1:Log/tns1:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns1:Log/tns1:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:Log/tns1:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns1:Log/tns1:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;/tns:LogElement>&lt;/tns:Update>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ReadFile.TrackFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/GestioneMovedFile&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FullPathMoved&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogOKMoved-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/tns1:Log/tns1:LoggerName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/tns1:Log/tns1:LoggerName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('**OK MOVED , da ', $Start/tns1:FullPathOrigine, ' a ' , $FullPathMoved)&quot;/>&lt;/tns:Message>&lt;xsl:if test=&quot;$Start/tns1:Log/tns1:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns1:Log/tns1:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:Log/tns1:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns1:Log/tns1:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogOKMoved-input" name="LogOKMoved"
                    tibex:xpdlId="ac974000-4ad3-4b50-bd10-1acd570aaee3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdFolderToCallProcess"/>
                        <bpws:target linkName="MovedFileToCallProcess2"/>
                        <bpws:target linkName="UpdFolderOUTToLogOKMoved"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/GestioneMovedFile&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FullPathMoved&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogOKMoved-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/tns1:Log/tns1:LoggerName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/tns1:Log/tns1:LoggerName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('**OK MOVED , da ', $Start/tns1:FullPathOrigine, ' a ' , $FullPathMoved)&quot;/>&lt;/tns:Message>&lt;xsl:if test=&quot;$Start/tns1:Log/tns1:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns1:Log/tns1:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:Log/tns1:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns1:Log/tns1:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
