            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita_UpdateStati&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns1:Output>&lt;xsl:if test=&quot;$Start/tns:Output/tns:STATO&quot;>&lt;tns1:STATO>&lt;xsl:value-of select=&quot;$Start/tns:Output/tns:STATO&quot;/>&lt;/tns1:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Output/tns:SOURCE_FILE&quot;>&lt;tns1:SOURCE_FILE>&lt;xsl:value-of select=&quot;$Start/tns:Output/tns:SOURCE_FILE&quot;/>&lt;/tns1:SOURCE_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Output/tns:ID_TRACK&quot;>&lt;tns1:ID_TRACK>&lt;xsl:value-of select=&quot;$Start/tns:Output/tns:ID_TRACK&quot;/>&lt;/tns1:ID_TRACK>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Output/tns:DATA_FILE&quot;>&lt;tns1:DATA_FILE>&lt;xsl:value-of select=&quot;$Start/tns:Output/tns:DATA_FILE&quot;/>&lt;/tns1:DATA_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Output/tns:FILE_SIZE&quot;>&lt;tns1:FILE_SIZE>&lt;xsl:value-of select=&quot;$Start/tns:Output/tns:FILE_SIZE&quot;/>&lt;/tns1:FILE_SIZE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Output/tns:NOME_FILE&quot;>&lt;tns1:NOME_FILE>&lt;xsl:value-of select=&quot;$Start/tns:Output/tns:NOME_FILE&quot;/>&lt;/tns1:NOME_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Output/tns:ID_FILE&quot;>&lt;tns1:ID_FILE>&lt;xsl:value-of select=&quot;$Start/tns:Output/tns:ID_FILE&quot;/>&lt;/tns1:ID_FILE>&lt;/xsl:if>&lt;/tns1:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
