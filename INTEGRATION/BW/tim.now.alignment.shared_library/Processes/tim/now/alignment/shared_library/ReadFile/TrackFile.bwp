                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO ALIGN_FILE_TRACKING (SYSTEM, FLOW, FILE_NAME,&#xa;  DATA_FILE, FOLDER, FLAG_LAVORATO, STATO, DATA_INSERIMENTO, ID_TRACK, ID_FLOW, CORRELATION_KEY, &#xa;  DESCR_ERROR, FILE_SIZE, ID_AGGIUNTIVO, FILE_INNESCO)&#xa;  VALUES (?, ?, ?, TO_DATE(?,'YYYYMMDD HH24MISS'), ?, ?, ?, SYSDATE,?, ?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
