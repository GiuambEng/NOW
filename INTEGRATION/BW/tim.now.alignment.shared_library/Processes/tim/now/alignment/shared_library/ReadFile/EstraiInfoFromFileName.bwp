                                    expression="$Start/tns:SISTEMA=('CRMR','CRMB') and contains($Start/tns:NOME_FILE, 'QUADRATURA')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/tns:SISTEMA=('CRMR','CRMB') and contains($Start/tns:NOME_FILE, 'QUADRATURA')]]></bpws:transitionCondition>
                        </bpws:source>
