                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; xmlns:ns11=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MoveFileSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseDetails&quot;/>&lt;xsl:param name=&quot;PathRename&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:param name=&quot;MoveFile&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:ChiusuraAllineamenti>&lt;tns:OutputData>&lt;xsl:if test=&quot;($Start/tns:InputData/tns:RECORD_TRG_KO+$Start/tns:InputData/tns:RECORD_STG_KO)>0&quot;>&lt;tns:PATH_FILE_SCARTO>&lt;xsl:value-of select=&quot;concat($ParseDetails/ns11:InputDetails[ns11:NOME='PathFileScarto']/ns11:VALORE,$ParseDetails/ns11:InputDetails[ns11:NOME='NomeFileScarto']/ns11:VALORE,  format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;), '.csv')&quot;/>&lt;/tns:PATH_FILE_SCARTO>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($_error/StackTrace)=0 and $MoveFile/tns1:Status='OK'&quot;>&lt;tns:PATH_FILE_MOVED>&lt;xsl:value-of select=&quot;$PathRename&quot;/>&lt;/tns:PATH_FILE_MOVED>&lt;/xsl:if>&lt;/tns:OutputData>&lt;/tns:ChiusuraAllineamenti>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
