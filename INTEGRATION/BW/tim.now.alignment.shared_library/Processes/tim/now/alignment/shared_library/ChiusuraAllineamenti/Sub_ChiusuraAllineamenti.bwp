                    <bpws:sources>
                        <bpws:source linkName="ScartoUtentiAMToUpdChiusuraFile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; xmlns:tns=&quot;http://www.example.org/CreaFileScarto_New&quot; xmlns:ns11=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseDetails&quot;/>&lt;xsl:template name=&quot;ScartoUtentiAM-input&quot; match=&quot;/&quot;>&lt;tns:Input_CreaFileRecordKO_New>&lt;tns:Subset>&lt;xsl:value-of select=&quot;xsd:int($ParseDetails/ns11:InputDetails[ns11:NOME='Offset']/ns11:VALORE)&quot;/>&lt;/tns:Subset>&lt;tns:Id_File>&lt;xsl:value-of select=&quot;$Start/ns1:InputData/ns1:ID_FILE&quot;/>&lt;/tns:Id_File>&lt;tns:PathFile>&lt;xsl:value-of select=&quot;$ParseDetails/ns11:InputDetails[ns11:NOME='PathFileScarto']/ns11:VALORE&quot;/>&lt;/tns:PathFile>&lt;tns:NomeFile>&lt;xsl:value-of select=&quot;$ParseDetails/ns11:InputDetails[ns11:NOME='NomeFileScarto']/ns11:VALORE&quot;/>&lt;/tns:NomeFile>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/ns1:InputData/ns1:LogInfo/ns1:ApplicationName&quot;/>&lt;/tns:Application>&lt;tns:LogName>&lt;xsl:value-of select=&quot;$Start/ns1:InputData/ns1:LogInfo/ns1:LogName&quot;/>&lt;/tns:LogName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/ns1:InputData/ns1:LogInfo/ns1:LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:TipoSeparatore>&lt;xsl:value-of select=&quot;&amp;quot;CampoSeparatore&amp;quot;&quot;/>&lt;/tns:TipoSeparatore>&lt;/tns:Input_CreaFileRecordKO_New>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
