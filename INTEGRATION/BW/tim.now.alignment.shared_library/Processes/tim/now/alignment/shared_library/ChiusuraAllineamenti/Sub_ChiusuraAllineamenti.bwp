            <bpws:empty name="CheckScarto" tibex:xpdlId="3d3253e5-9c58-4cc5-9e58-a05a758f04ae">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToCheckScarto"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckScartoToPortale">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0 and $Start/ns1:InputData/ns1:SISTEMA='Portale'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0 and $Start/ns1:InputData/ns1:SISTEMA='Portale']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckScartoToUnicaRA">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and $Start/ns1:InputData/ns1:SISTEMA='UnicaRA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and $Start/ns1:InputData/ns1:SISTEMA='UnicaRA']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckScartoToUpdChiusuraFile">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckScartoToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and ($Start/ns1:InputData/ns1:SISTEMA='CRMR' or $Start/ns1:InputData/ns1:SISTEMA='CRMBW')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and ($Start/ns1:InputData/ns1:SISTEMA='CRMR' or $Start/ns1:InputData/ns1:SISTEMA='CRMBW')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckScartoToEmpty1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and $Start/ns1:InputData/ns1:SISTEMA='DBSS'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and $Start/ns1:InputData/ns1:SISTEMA='DBSS']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckScartoToEmpty2">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0 and $Start/ns1:InputData/ns1:SISTEMA='CRMWS'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0 and $Start/ns1:InputData/ns1:SISTEMA='CRMWS']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckScartoToEmpty3">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_STG_KO+$Start/ns1:InputData/ns1:RECORD_TRG_KO)>0 and $Start/ns1:InputData/ns1:SISTEMA='Diogene'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns1:InputData/ns1:RECORD_STG_KO+$Start/ns1:InputData/ns1:RECORD_TRG_KO)>0 and $Start/ns1:InputData/ns1:SISTEMA='Diogene']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckScartoToEmpty4">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and $Start/ns1:InputData/ns1:SISTEMA=&quot;JIVE&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and $Start/ns1:InputData/ns1:SISTEMA="JIVE"]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogStart-input"
                    name="LogStart"
                    tibex:xpdlId="7a01bffa-5521-46d4-858c-1b50fdb114ee"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToParseDetails"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/ns1:InputData/ns1:LogInfo/ns1:ApplicationName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/ns1:InputData/ns1:LogInfo/ns1:ApplicationName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Sub_ChiusuraAllineamenti'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Avvio Chiusura Allineamento per SISTEMA : ', $Start/ns1:InputData/ns1:SISTEMA, ' FLUSSO : ', $Start/ns1:InputData/ns1:FLUSSO, &amp;quot; ID_FILE : &amp;quot;,string($Start/ns1:InputData/ns1:ID_FILE),'          ',tib:render-xml($Start, true(), true()))&quot;/>&lt;/tns:Message>&lt;xsl:if test=&quot;$Start/ns1:InputData/ns1:LogInfo/ns1:LogName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/ns1:InputData/ns1:LogInfo/ns1:LogName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns1:InputData/ns1:LogInfo/ns1:LogInfoLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/ns1:InputData/ns1:LogInfo/ns1:LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="ScartoUtentiAM-input"
                    name="ScartoUtentiAM"
                    tibex:xpdlId="8549fd2a-eecc-4e12-8367-f7aa21033092"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PortaleToScartoUtentiAM"/>
