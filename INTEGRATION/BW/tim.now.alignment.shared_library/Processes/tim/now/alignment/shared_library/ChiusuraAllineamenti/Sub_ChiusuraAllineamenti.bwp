                portType="ns5:ProcessLog" tibex:xpdlId="673ee7e3-0e78-4eb0-97d7-a4f631be7045">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns1="www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="UpdChiusuraFile-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'FILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:FileProcessato&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/ns:ESITO&gt;&lt;xsl:if test="$Start/ns1:InputData/ns1:ID_ESEC_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$Start/ns1:InputData/ns1:ID_ESEC_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/ns1:InputData/ns1:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Start/ns1:InputData/ns1:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="'INPUT'"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/ns:FileProcessato&gt;&lt;ns:FileProcessatoInput&gt;&lt;xsl:if test="$Start/ns1:InputData/ns1:ID_FILE"&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="$Start/ns1:InputData/ns1:ID_FILE"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;/xsl:if&gt;&lt;ns:QT_RECD_KO&gt;&lt;xsl:value-of select="$Start/ns1:InputData/ns1:RECORD_STG_KO+$Start/ns1:InputData/ns1:RECORD_TRG_KO"/&gt;&lt;/ns:QT_RECD_KO&gt;&lt;xsl:if test="$Start/ns1:InputData/ns1:RECORD_TRG_OK"&gt;&lt;ns:QT_RECD_OK&gt;&lt;xsl:value-of select="$Start/ns1:InputData/ns1:RECORD_TRG_OK"/&gt;&lt;/ns:QT_RECD_OK&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoInput&gt;&lt;ns:EsecuzioneFile&gt;&lt;xsl:if test="$Start/ns1:InputData/ns1:ID_ESEC_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$Start/ns1:InputData/ns1:ID_ESEC_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdChiusuraFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;'FILE'&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;ns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:InputData/ns1:ID_ESEC_FILE&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:InputData/ns1:ID_ESEC_FILE&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:InputData/ns1:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:InputData/ns1:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;