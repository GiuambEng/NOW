                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:tns1=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FindFile&quot;/>&lt;xsl:template name=&quot;Moved-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;xsl:if test=&quot;$FindFile/tns:FullName&quot;>&lt;tns1:FullPathOrigine>&lt;xsl:value-of select=&quot;$FindFile/tns:FullName&quot;/>&lt;/tns1:FullPathOrigine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:PathError&quot;>&lt;tns1:FolderDestinazione>&lt;xsl:value-of select=&quot;$Start/tns:PathError&quot;/>&lt;/tns1:FolderDestinazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindFile/tns:FileName&quot;>&lt;tns1:NomeFile>&lt;xsl:value-of select=&quot;$FindFile/tns:FileName&quot;/>&lt;/tns1:NomeFile>&lt;/xsl:if>&lt;tns1:LogInput>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns:LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$Start/tns:LogName&quot;/>&lt;/tns1:LogName>&lt;/tns1:LogInput>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Moved-input" name="Moved"
                    outputVariable="Moved"
                    tibex:xpdlId="c7561e5a-0fe2-473e-8496-205c0d62a778"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InputTrackToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MovedToInputTrackKO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:tns1=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FindFile&quot;/>&lt;xsl:template name=&quot;Moved-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;xsl:if test=&quot;$FindFile/tns:FullName&quot;>&lt;tns1:FullPathOrigine>&lt;xsl:value-of select=&quot;$FindFile/tns:FullName&quot;/>&lt;/tns1:FullPathOrigine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:PathError&quot;>&lt;tns1:FolderDestinazione>&lt;xsl:value-of select=&quot;$Start/tns:PathError&quot;/>&lt;/tns1:FolderDestinazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindFile/tns:FileName&quot;>&lt;tns1:NomeFile>&lt;xsl:value-of select=&quot;$FindFile/tns:FileName&quot;/>&lt;/tns1:NomeFile>&lt;/xsl:if>&lt;tns1:LogInput>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns:LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$Start/tns:LogName&quot;/>&lt;/tns1:LogName>&lt;/tns1:LogInput>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
