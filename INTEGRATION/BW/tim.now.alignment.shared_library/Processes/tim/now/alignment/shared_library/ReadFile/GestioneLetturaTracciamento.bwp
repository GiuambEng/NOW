                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToInsert_Track"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Start&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.alignment.shared_library.ReadFile.FindFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FindFile&quot;/>&lt;xsl:template name=&quot;InputTrackFile&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:INSERT>&lt;xsl:if test=&quot;$Start/tns1:Sistema&quot;>&lt;tns:SISTEMA>&lt;xsl:value-of select=&quot;$Start/tns1:Sistema&quot;/>&lt;/tns:SISTEMA>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Flusso, 'ERROR') and $FindFile/tns1:Esito='ERROR'&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;concat($Start/tns1:Flusso,&amp;quot; AND NO_FILE_FOUND&amp;quot;)&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:Flusso&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$Start/tns1:Flusso&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$FindFile/tns1:FileName&quot;>&lt;tns:NOME_FILE>&lt;xsl:value-of select=&quot;$FindFile/tns1:FileName&quot;/>&lt;/tns:NOME_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindFile/tns1:FullName&quot;>&lt;tns:PATH_SORGENTE>&lt;xsl:value-of select=&quot;$FindFile/tns1:FullName&quot;/>&lt;/tns:PATH_SORGENTE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Flusso, 'ERROR') and $FindFile/tns1:Esito='OK'&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:STATO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:STATO>&lt;xsl:value-of select=&quot;$FindFile/tns1:Esito&quot;/>&lt;/tns:STATO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Flusso, 'ERROR') &quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;if (contains($Start/tns1:Flusso,'ERROR_DATA_FILE'))  then&amp;#xD;&amp;#xA; concat(&amp;quot;***ERRORE: DATA NON VALIDA NEL NOME DEL FILE &amp;quot; , $FindFile/tns1:FileName, &amp;quot; &amp;quot;, $FindFile/tns1:DESCR_ERRORE)&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;else  concat(&amp;quot;***ERRORE: NAMING CONVENTION DEL FILE NON RISPETTATA  &amp;quot; , $FindFile/tns1:FileName, &amp;quot; &amp;quot;, $FindFile/tns1:DESCR_ERRORE)&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$FindFile/tns1:DESCR_ERRORE&quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;$FindFile/tns1:DESCR_ERRORE&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($FindFile/tns1:Size)>0&quot;>&lt;tns:FILE_SIZE>&lt;xsl:value-of select=&quot;xsd:int($FindFile/tns1:Size)&quot;/>&lt;/tns:FILE_SIZE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:Flusso='Bonifica ISTAT COMUNE da file'&quot;>&lt;xsl:if test=&quot;$Start/tns1:IgAnagBonificaCluster&quot;>&lt;tns:ID_AGGIUNTIVO>&lt;xsl:value-of select=&quot;$Start/tns1:IgAnagBonificaCluster&quot;/>&lt;/tns:ID_AGGIUNTIVO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:Flag_parent&quot;>&lt;tns:FLAG_PARENT>&lt;xsl:value-of select=&quot;$Start/tns1:Flag_parent&quot;/>&lt;/tns:FLAG_PARENT>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindFile/tns1:PathFileTappo&quot;>&lt;tns:PATH_FILEINNESCO>&lt;xsl:value-of select=&quot;$FindFile/tns1:PathFileTappo&quot;/>&lt;/tns:PATH_FILEINNESCO>&lt;/xsl:if>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns1:LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns1:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:INSERT>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="InputTrackFile" name="InputTrack"
                    outputVariable="InputTrackFile"
                    tibex:xpdlId="12618d81-ea2c-433b-ac70-f05aa90a2919" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToInsert_Track"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign1ToTrackFile">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="InputTrackToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$InputTrackFile/ns1:INSERT/ns1:STATO='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$InputTrackFile/ns1:INSERT/ns1:STATO='KO']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FindFile&quot;/>&lt;xsl:template name=&quot;InputTrackFile&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:INSERT>&lt;xsl:if test=&quot;$Start/tns1:Sistema&quot;>&lt;tns:SISTEMA>&lt;xsl:value-of select=&quot;$Start/tns1:Sistema&quot;/>&lt;/tns:SISTEMA>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Flusso, 'ERROR') and $FindFile/tns1:Esito='ERROR'&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;concat($Start/tns1:Flusso,&amp;quot; AND NO_FILE_FOUND&amp;quot;)&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:Flusso&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$Start/tns1:Flusso&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$FindFile/tns1:FileName&quot;>&lt;tns:NOME_FILE>&lt;xsl:value-of select=&quot;$FindFile/tns1:FileName&quot;/>&lt;/tns:NOME_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindFile/tns1:FullName&quot;>&lt;tns:PATH_SORGENTE>&lt;xsl:value-of select=&quot;$FindFile/tns1:FullName&quot;/>&lt;/tns:PATH_SORGENTE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Flusso, 'ERROR') and $FindFile/tns1:Esito='OK'&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:STATO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:STATO>&lt;xsl:value-of select=&quot;$FindFile/tns1:Esito&quot;/>&lt;/tns:STATO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Flusso, 'ERROR') &quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;if (contains($Start/tns1:Flusso,'ERROR_DATA_FILE'))  then&amp;#xD;&amp;#xA; concat(&amp;quot;***ERRORE: DATA NON VALIDA NEL NOME DEL FILE &amp;quot; , $FindFile/tns1:FileName, &amp;quot; &amp;quot;, $FindFile/tns1:DESCR_ERRORE)&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;else  concat(&amp;quot;***ERRORE: NAMING CONVENTION DEL FILE NON RISPETTATA  &amp;quot; , $FindFile/tns1:FileName, &amp;quot; &amp;quot;, $FindFile/tns1:DESCR_ERRORE)&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$FindFile/tns1:DESCR_ERRORE&quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;$FindFile/tns1:DESCR_ERRORE&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($FindFile/tns1:Size)>0&quot;>&lt;tns:FILE_SIZE>&lt;xsl:value-of select=&quot;xsd:int($FindFile/tns1:Size)&quot;/>&lt;/tns:FILE_SIZE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:Flusso='Bonifica ISTAT COMUNE da file'&quot;>&lt;xsl:if test=&quot;$Start/tns1:IgAnagBonificaCluster&quot;>&lt;tns:ID_AGGIUNTIVO>&lt;xsl:value-of select=&quot;$Start/tns1:IgAnagBonificaCluster&quot;/>&lt;/tns:ID_AGGIUNTIVO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:Flag_parent&quot;>&lt;tns:FLAG_PARENT>&lt;xsl:value-of select=&quot;$Start/tns1:Flag_parent&quot;/>&lt;/tns:FLAG_PARENT>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindFile/tns1:PathFileTappo&quot;>&lt;tns:PATH_FILEINNESCO>&lt;xsl:value-of select=&quot;$FindFile/tns1:PathFileTappo&quot;/>&lt;/tns:PATH_FILEINNESCO>&lt;/xsl:if>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns1:LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns1:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:INSERT>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
