        <bpws:variable element="ns5:RenameActivityOutput"
            name="MoveFile" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:ErrorLinkHandlerFaultData"
            name="_error_MoveFile" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogOKMoved-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogNOMoved-input" sca-bpel:internal="true"/>
