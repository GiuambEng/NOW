                            activityTypeID="bw.file.rename"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//RenameFile"/>
                                    <value xsi:type="file:RenameFile"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ManageMoveFile&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FullPathMoved&quot;/>&lt;xsl:template name=&quot;LogOKMoved-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;xsl:if test=&quot;$Start/tns:LogInput/tns:LogName&quot;>&lt;tns1:Application>&lt;xsl:value-of select=&quot;$Start/tns:LogInput/tns:LogName&quot;/>&lt;/tns1:Application>&lt;/xsl:if>&lt;tns1:Message>&lt;xsl:value-of select=&quot;concat('**OK MOVED , da ', $Start/tns:FullPathOrigine, ' a ' , $FullPathMoved)&quot;/>&lt;/tns1:Message>&lt;xsl:if test=&quot;$Start/tns:LogInput/tns:LogName&quot;>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns:LogInput/tns:LogName&quot;/>&lt;/tns1:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:LogInput/tns:LogLevel&quot;>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns:LogInput/tns:LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;/xsl:if>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogOKMoved-input" name="LogOKMoved"
