                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.example.org/ManageMoveFile&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FullPathMoved&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;_error_MoveFile&quot;/>&lt;xsl:template name=&quot;LogKOMoved-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/tns1:LogInput/tns1:LogName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/tns1:LogInput/tns1:LogName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('**ERROR MOVED , da ', $Start/tns1:FullPathOrigine, ' a ' , $FullPathMoved, ' Descr Message ', tib:render-xml($_error_MoveFile))&quot;/>&lt;/tns:Message>&lt;xsl:if test=&quot;$Start/tns1:LogInput/tns1:LogName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns1:LogInput/tns1:LogName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:LogInput/tns1:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns1:LogInput/tns1:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
