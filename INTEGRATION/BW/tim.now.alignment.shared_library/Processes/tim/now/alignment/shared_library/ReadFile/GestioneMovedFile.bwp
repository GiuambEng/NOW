        <bpws:variable name="FullPathMoved" type="xsd:string"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogKOMoved-input" sca-bpel:internal="true"/>
        <bpws:variable element="tns2:OutputData" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns4:Input" name="UpdFolder-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:RenameActivityConfig"
