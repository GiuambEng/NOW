    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToMovedFile" tibex:linkType="SUCCESS"/>
                <bpws:link name="SetFullPathMovedToRenameFile" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="RenameFileToLogKOMoved" tibex:linkType="ERROR"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
