            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MoveFile&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:OutputData>&#xa;            &lt;xsl:if test=&quot;string-length($MoveFile/fileInfo/fullName) > 0&quot;>&#xa;                &lt;tns:FullPathMovedFile>&#xa;                    &lt;xsl:value-of select=&quot;$MoveFile/fileInfo/fullName&quot;/>&#xa;                &lt;/tns:FullPathMovedFile>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:OutputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
