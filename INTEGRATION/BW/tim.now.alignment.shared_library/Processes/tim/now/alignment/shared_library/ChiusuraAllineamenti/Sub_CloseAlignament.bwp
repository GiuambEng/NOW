                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length(string($Start/ns1:InputData/ns1:ID_TRACK))>0 and ($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0 and not($Start/ns1:InputData/ns1:FLUSSO='AllineamentoFF' or $Start/ns1:InputData/ns1:FLUSSO='AssetFlashFiber' or $Start/ns1:InputData/ns1:FLUSSO='AssetFiberCop' or $Start/ns1:InputData/ns1:FLUSSO='AllineamentoPatroclo' or $Start/ns1:InputData/ns1:FLUSSO='POSTOOPERATORE_CRMB' or $Start/ns1:InputData/ns1:FLUSSO='Bonifica Consistenza CAB' or $Start/ns1:InputData/ns1:FLUSSO='Bonifica Consistenza CLLI' or $Start/ns1:InputData/ns1:FLUSSO='Aggiornamento Cluster Comuni' or $Start/ns1:InputData/ns1:FLUSSO='AnagraficaCodiciNMU')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="MovedStoricoToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
