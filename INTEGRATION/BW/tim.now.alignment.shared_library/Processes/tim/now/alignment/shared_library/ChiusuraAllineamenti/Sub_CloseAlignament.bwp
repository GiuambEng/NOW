                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ParseDetails-input&quot; match=&quot;/&quot;>&lt;tns:xmlString>&lt;xsl:value-of select=&quot;$Start/ns1:InputData/ns1:DETTAGLI&quot;/>&lt;/tns:xmlString>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.xml.parsexml"
                            version="6.0.0.20121128"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette"
                            xmlns:www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details="www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//ParseXml"/>
                                    <value inputStyle="text"
                                    outputElementQName="www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details:Details"
                                    validateOutput="true" xsi:type="palettexml:ParseXml"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="CheckScarto" tibex:xpdlId="3d3253e5-9c58-4cc5-9e58-a05a758f04ae">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToCheckScarto"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckScartoToPortale">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0 and $Start/ns1:InputData/ns1:SISTEMA='Portale'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0 and $Start/ns1:InputData/ns1:SISTEMA='Portale']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckScartoToUnicaRA">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and $Start/ns1:InputData/ns1:SISTEMA='UnicaRA' and not($Start/ns1:InputData/ns1:FLUSSO='AssetFlashFiber') and not($Start/ns1:InputData/ns1:FLUSSO='Bonifica Consistenza CAB') and not($Start/ns1:InputData/ns1:FLUSSO='AssetFiberCop') and not($Start/ns1:InputData/ns1:FLUSSO='AnagraficaGPON')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and $Start/ns1:InputData/ns1:SISTEMA='UnicaRA' and not($Start/ns1:InputData/ns1:FLUSSO='AssetFlashFiber') and not($Start/ns1:InputData/ns1:FLUSSO='Bonifica Consistenza CAB') and not($Start/ns1:InputData/ns1:FLUSSO='AssetFiberCop') and not($Start/ns1:InputData/ns1:FLUSSO='AnagraficaGPON')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckScartoToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckScartoToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and ($Start/ns1:InputData/ns1:SISTEMA='CRMR' or $Start/ns1:InputData/ns1:SISTEMA='CRMBW')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and ($Start/ns1:InputData/ns1:SISTEMA='CRMR' or $Start/ns1:InputData/ns1:SISTEMA='CRMBW')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckScartoToEmpty1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and $Start/ns1:InputData/ns1:SISTEMA='DBSS'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and $Start/ns1:InputData/ns1:SISTEMA='DBSS']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckScartoToEmpty2">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0 and $Start/ns1:InputData/ns1:SISTEMA='CRMWS' and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICAADR') and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICAKITADRCAR') and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICAKITVLAN') and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICACENTRALENGA') and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICACENTRALEGBE') and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICACENTRALEPDC') and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICACENTRALENODO' and not($Start/ns1:InputData/ns1:FLUSSO='Allineamento MA FISICA COMMERCIALE'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0 and $Start/ns1:InputData/ns1:SISTEMA='CRMWS' and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICAADR') and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICAKITADRCAR') and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICAKITVLAN') and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICACENTRALENGA') and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICACENTRALEGBE') and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICACENTRALEPDC') and not($Start/ns1:InputData/ns1:FLUSSO='ANAGRAFICACENTRALENODO' and not($Start/ns1:InputData/ns1:FLUSSO='Allineamento MA FISICA COMMERCIALE'))]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckScartoToEmpty3">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_STG_KO+$Start/ns1:InputData/ns1:RECORD_TRG_KO)>0 and $Start/ns1:InputData/ns1:SISTEMA='Diogene'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns1:InputData/ns1:RECORD_STG_KO+$Start/ns1:InputData/ns1:RECORD_TRG_KO)>0 and $Start/ns1:InputData/ns1:SISTEMA='Diogene']]></bpws:transitionCondition>
