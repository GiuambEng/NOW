                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns1:InputData/ns1:RECORD_TRG_KO+$Start/ns1:InputData/ns1:RECORD_STG_KO)>0  and $Start/ns1:InputData/ns1:SISTEMA='JIVE_ALL'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
