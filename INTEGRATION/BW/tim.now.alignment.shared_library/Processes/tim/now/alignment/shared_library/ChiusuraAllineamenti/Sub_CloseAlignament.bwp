            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="3b6cdcb7-ae4e-4522-befd-3002a045fb43" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TrackFolderScartiToEnd"/>
                        <bpws:target linkName="Empty1ToEnd"/>
                        <bpws:target linkName="RemoveFile1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; xmlns:ns11=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details&quot; xmlns:tns2=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseDetails&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;MovedStorico&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:ChiusuraAllineamenti>&lt;tns:OutputData>&lt;xsl:if test=&quot;($Start/tns:InputData/tns:RECORD_TRG_KO+$Start/tns:InputData/tns:RECORD_STG_KO)>0 and not($Start/tns:InputData/tns:FLUSSO = 'POSTOOPERATORE_CRMB') and not($Start/tns:InputData/tns:FLUSSO='ANAGRAFICAADR') and not($Start/tns:InputData/tns:FLUSSO='ANAGRAFICAKITADRCAR') and not($Start/tns:InputData/tns:FLUSSO='ANAGRAFICAKITVLAN') and not($Start/tns:InputData/tns:FLUSSO='ANAGRAFICACENTRALENGA') and not($Start/tns:InputData/tns:FLUSSO='ANAGRAFICACENTRALEGBE') and not($Start/tns:InputData/tns:FLUSSO='ANAGRAFICACENTRALEPDC') and not($Start/tns:InputData/tns:FLUSSO='ANAGRAFICACENTRALENODO') and not($Start/tns:InputData/tns:FLUSSO='Allineamento MA FISICA COMMERCIALE') and not($Start/tns:InputData/tns:FLUSSO='RiscontriGSRI_NPNG')&quot;>&lt;tns:PATH_FILE_SCARTO>&lt;xsl:value-of select=&quot;concat($ParseDetails/ns11:InputDetails[ns11:NOME='PathFileScarto']/ns11:VALORE,$ParseDetails/ns11:InputDetails[ns11:NOME='NomeFileScarto']/ns11:VALORE,  format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;), '.csv')&quot;/>&lt;/tns:PATH_FILE_SCARTO>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($MovedStorico/tns2:FullPathMovedFile)>0 &quot;>&lt;xsl:if test=&quot;$MovedStorico/tns2:FullPathMovedFile&quot;>&lt;tns:PATH_FILE_MOVED>&lt;xsl:value-of select=&quot;$MovedStorico/tns2:FullPathMovedFile&quot;/>&lt;/tns:PATH_FILE_MOVED>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns:OutputData>&lt;/tns:ChiusuraAllineamenti>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
