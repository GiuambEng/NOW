            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="VerificaPresenzaTuttiFigli-input"
                    name="VerificaPresenzaTuttiFigli"
                    outputVariable="VerificaPresenzaTuttiFigli"
                    tibex:xpdlId="88ae4a31-8891-4046-abd8-b7903d3d4184" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckToVerificaPresenzaTuttiFigli"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="VerificaPresenzaTuttiFigliToCallProcess1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($VerificaFlusso/Record[1]/NUM_RETRY&lt;$VerificaParentele/Record[1]/MAX_RETRY or string-length(string($VerificaFlusso/Record[1]/NUM_RETRY))=0) and count($VerificaPresenzaTuttiFigli/Record)&lt;$Start/tns:NUMERO_CORRELAZIONI" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($VerificaFlusso/Record[1]/NUM_RETRY<$VerificaParentele/Record[1]/MAX_RETRY or string-length(string($VerificaFlusso/Record[1]/NUM_RETRY))=0) and count($VerificaPresenzaTuttiFigli/Record)<$Start/tns:NUMERO_CORRELAZIONI]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaPresenzaTuttiFigliToCallProcess3">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$VerificaFlusso/Record[1]/NUM_RETRY>=$VerificaParentele/Record[1]/MAX_RETRY and count($VerificaPresenzaTuttiFigli/Record)&lt;$Start/tns:NUMERO_CORRELAZIONI" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$VerificaFlusso/Record[1]/NUM_RETRY>=$VerificaParentele/Record[1]/MAX_RETRY and count($VerificaPresenzaTuttiFigli/Record)<$Start/tns:NUMERO_CORRELAZIONI]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaPresenzaTuttiFigliToCallProcess2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+88ae4a31-8891-4046-abd8-b7903d3d4184+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaFlusso&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaPresenzaTuttiFigli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;CORRELATION_KEY>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaFlusso/Record[1]/CORRELATION_KEY)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/CORRELATION_KEY&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CORRELATION_KEY>&#xa;            &lt;sistema>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaFlusso/Record[1]/SYSTEM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/SYSTEM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/sistema>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_TRACK&#xa;  FROM ALIGN_FILE_TRACKING &#xa;  where correlation_key=? and SYSTEM=?&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="CORRELATION_KEY"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="sistema"/>
                                    <columnMetadata
                                    columnName="ID_TRACK"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
