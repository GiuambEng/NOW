                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length(string($VerificaParentele/Record[1]/ID_PARENT))=0 and $Start/tns:FLAG_PARENT=true()]]></bpws:transitionCondition>
                    </bpws:source>
