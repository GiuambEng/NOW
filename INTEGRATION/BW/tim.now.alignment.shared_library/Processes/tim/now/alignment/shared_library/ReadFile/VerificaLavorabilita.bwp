            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="VerificaFlusso-input"
                    name="VerificaFlusso"
                    outputVariable="VerificaFlusso"
                    tibex:xpdlId="66392923-d0d2-4c61-9e59-9155bab7db12" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="VerificaFlussoToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaFlussoToCallProcess1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$VerificaFlusso/Record[1]/FLAG_REWORK='Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$VerificaFlusso/Record[1]/FLAG_REWORK='Y']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaFlussoToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($VerificaFlusso/Record)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($VerificaFlusso/Record)=0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaFlussoToSetWait">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:FLAG_WAIT=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/tns:FLAG_WAIT=true()]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+66392923-d0d2-4c61-9e59-9155bab7db12+input&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaFlusso-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;ID_FLUSSO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:ID_FLOW)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:ID_FLOW&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_FLUSSO>&#xa;            &lt;ID_FLOW>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:ID_FLOW)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:ID_FLOW&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_FLOW>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_TRACK, CORRELATION_KEY, NUM_RETRY, FLAG_REWORK, FOLDER, FILE_SIZE, DATA_FILE, FILE_NAME, SYSTEM, ID_AGGIUNTIVO, ID_FILE_INPUT,STATO&#xd;&#xa;FROM ALIGN_FILE_TRACKING AFT&#xd;&#xa;  JOIN (SELECT MIN(DATA_FILE) MIN_FILE FROM ALIGN_FILE_TRACKING WHERE ID_FLOW = ? AND ((FLAG_LAVORATO = 'N'  AND  STATO  in ('IN ATTESA', 'DA LAVORARE')) OR  FLAG_REWORK='Y') ) MIN_AFT ON AFT.DATA_FILE = MIN_AFT.MIN_FILE&#xd;&#xa;WHERE ID_FLOW = ? AND ((FLAG_LAVORATO = 'N'  AND  STATO  in ('IN ATTESA', 'DA LAVORARE')) OR  FLAG_REWORK='Y')"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FLUSSO"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FLOW"/>
                                    <columnMetadata
                                    columnName="ID_TRACK"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="CORRELATION_KEY"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NUM_RETRY"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLAG_REWORK"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FOLDER"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FILE_SIZE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DATA_FILE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="FILE_NAME"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="SYSTEM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_AGGIUNTIVO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_FILE_INPUT"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="STATO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Check" tibex:xpdlId="bcf75bd8-98db-4caa-8bf7-66deae0e9bdc">
