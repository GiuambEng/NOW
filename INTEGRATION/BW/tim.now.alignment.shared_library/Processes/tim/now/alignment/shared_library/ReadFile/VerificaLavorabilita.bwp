                                <tibex:expression
                                    expression="$CheckLavorazioneInCorso/Record[1]/COUNT1>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
