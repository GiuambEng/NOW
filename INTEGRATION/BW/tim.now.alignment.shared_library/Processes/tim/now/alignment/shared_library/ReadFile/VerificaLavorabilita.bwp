                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LavorazioneManuale&quot;/>&lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($LavorazioneManuale/tns:STATO)>0&quot;>&lt;xsl:if test=&quot;$LavorazioneManuale/tns:STATO&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;$LavorazioneManuale/tns:STATO&quot;/>&lt;/tns:STATO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:STATO>&lt;xsl:value-of select=&quot;'WAIT'&quot;/>&lt;/tns:STATO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Output" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="VerificaStatoBlocchiPrecedenti-input"
                    name="VerificaStatoBlocchiPrecedenti"
                    outputVariable="VerificaStatoBlocchiPrecedenti"
                    tibex:xpdlId="59a17f97-81fa-48c4-b6a6-25d3bb59365c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckParentToVerificaStatoBlocchiPrecedenti"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="VerificaStatoBlocchiPrecedentiToLavorazioneManuale">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($VerificaStatoBlocchiPrecedenti/Record[STATO = (&quot;KO&quot;,&quot;LAVORAZIONE MANUALE&quot;,&quot;ERROR&quot;)]) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($VerificaStatoBlocchiPrecedenti/Record[STATO = ("KO","LAVORAZIONE MANUALE","ERROR")]) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaStatoBlocchiPrecedentiToLogInCorso">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($VerificaStatoBlocchiPrecedenti/Record[STATO = (&quot;IN LAVORAZIONE&quot;, &quot;IN ATTESA&quot;,&quot;DA LAVORARE&quot;)]) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($VerificaStatoBlocchiPrecedenti/Record[STATO = ("IN LAVORAZIONE", "IN ATTESA","DA LAVORARE")]) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaStatoBlocchiPrecedentiToVerificaParentele">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+59a17f97-81fa-48c4-b6a6-25d3bb59365c+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaFlusso&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaStatoBlocchiPrecedenti-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;SYSTEM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaFlusso/Record[1]/SYSTEM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/SYSTEM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/SYSTEM>&#xa;            &lt;CORRELATION_KEY>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaFlusso/Record[1]/CORRELATION_KEY)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/CORRELATION_KEY&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CORRELATION_KEY>&#xa;            &lt;CORRELATION_KEY_1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaFlusso/Record[1]/CORRELATION_KEY)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/CORRELATION_KEY&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CORRELATION_KEY_1>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STATO&#xa;  FROM ALIGN_FILE_TRACKING WHERE &#xa;   CORRELATION_KEY = (SELECT correlation_key&#xa;                          FROM ALIGN_FILE_TRACKING INNER_AFT&#xa;                          WHERE SYSTEM=? AND CORRELATION_KEY &lt;> ?&#xa;                          AND CORRELATION_KEY&lt;?&#xa;                          ORDER BY DATA_FILE DESC&#xa;                          FETCH FIRST 1 ROWS ONLY)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SYSTEM"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="CORRELATION_KEY"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="CORRELATION_KEY_1"/>
                                    <columnMetadata
                                    columnName="STATO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="WaitFather-input"
                    name="WaitFather" outputVariable="WaitFather"
                    tibex:xpdlId="d9141e6e-a17e-4540-87e0-e86336534cf5"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="VerificaStatoPadreToWai"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="WaiToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/VerificaLavorabilita_UpdateStati&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaFlusso&quot;/>&#xa;    &lt;xsl:template name=&quot;Wai-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:INPUT>&#xa;            &lt;tns2:InfoTrackFile>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'IN ATTESA'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;                &lt;tns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VerificaFlusso/Record[1]/ID_TRACK)&quot;/>&#xa;                &lt;/tns2:ID_TRACK>&#xa;                &lt;tns2:LogElement>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LoggerName&quot;>&#xa;                        &lt;tns2:LoggerName>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LoggerName&quot;/>&#xa;                        &lt;/tns2:LoggerName>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LogLevel&quot;>&#xa;                        &lt;tns2:LogLevel>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LogLevel&quot;/>&#xa;                        &lt;/tns2:LogLevel>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:MessageForLogs>&#xa;                        &lt;xsl:value-of select=&quot;concat('FLUSSO ', $Start/tns:FLUSSO, ' ID_TRACK= ', string($VerificaFlusso/Record[1]/ID_TRACK), ' IN ATTESA DI LAVORAZIONE O FINE LAVORAZIONE DEL PADRE')&quot;/>&#xa;                    &lt;/tns2:MessageForLogs>&#xa;                &lt;/tns2:LogElement>&#xa;            &lt;/tns2:InfoTrackFile>&#xa;            &lt;tns2:Output>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'WAIT'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;            &lt;/tns2:Output>&#xa;        &lt;/tns2:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.alignment.shared_library.ReadFile.Sub_UpdStatusVerificaLavorabilità" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="WaithFatherAndRetry-input"
                    name="WaithFatherAndRetry"
                    outputVariable="WaithFatherAndRetry"
                    tibex:xpdlId="774ee8ae-bb7b-4bee-ae5a-e8b2e5a78f67"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="VerificaStatoPadreToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="WAITAndRetryToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/VerificaLavorabilita_UpdateStati&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaFlusso&quot;/>&#xa;    &lt;xsl:template name=&quot;WAITAndRetry-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:INPUT>&#xa;            &lt;tns2:InfoTrackFile>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'IN ATTESA'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;                &lt;tns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VerificaFlusso/Record[1]/ID_TRACK)&quot;/>&#xa;                &lt;/tns2:ID_TRACK>&#xa;                &lt;tns2:NUM_RETRY>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:NUM_RETRY>&#xa;                &lt;tns2:LogElement>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LoggerName&quot;>&#xa;                        &lt;tns2:LoggerName>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LoggerName&quot;/>&#xa;                        &lt;/tns2:LoggerName>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LogLevel&quot;>&#xa;                        &lt;tns2:LogLevel>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LogLevel&quot;/>&#xa;                        &lt;/tns2:LogLevel>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:MessageForLogs>&#xa;                        &lt;xsl:value-of select=&quot;concat('FLUSSO ', $Start/tns:FLUSSO, ' ID_TRACK= ', string($VerificaFlusso/Record[1]/ID_TRACK), ' IN ATTESA ARRIVO PADRE')&quot;/>&#xa;                    &lt;/tns2:MessageForLogs>&#xa;                &lt;/tns2:LogElement>&#xa;            &lt;/tns2:InfoTrackFile>&#xa;            &lt;tns2:Output>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'WAIT'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;            &lt;/tns2:Output>&#xa;        &lt;/tns2:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.alignment.shared_library.ReadFile.Sub_UpdStatusVerificaLavorabilità" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="OKSons-input"
                    name="OKSons" outputVariable="OKSons"
                    tibex:xpdlId="398e5d53-f944-4391-bb43-3d35768cac99"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="VerificaStatoPadreToCallProcess2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToAssign1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/VerificaLavorabilita_UpdateStati&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaFlusso&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:INPUT>&#xa;            &lt;tns2:InfoTrackFile>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'IN LAVORAZIONE'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;                &lt;tns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VerificaFlusso/Record[1]/ID_TRACK)&quot;/>&#xa;                &lt;/tns2:ID_TRACK>&#xa;                &lt;tns2:LogElement>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LoggerName&quot;>&#xa;                        &lt;tns2:LoggerName>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LoggerName&quot;/>&#xa;                        &lt;/tns2:LoggerName>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LogLevel&quot;>&#xa;                        &lt;tns2:LogLevel>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LogLevel&quot;/>&#xa;                        &lt;/tns2:LogLevel>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:MessageForLogs>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;***INIZIO LAVORAZIONE PER FLUSSO &amp;quot;, $Start/tns:FLUSSO, &amp;quot; ID TRACK= &amp;quot; , string($VerificaFlusso/Record[1]/ID_TRACK))&quot;/>&#xa;                    &lt;/tns2:MessageForLogs>&#xa;                &lt;/tns2:LogElement>&#xa;            &lt;/tns2:InfoTrackFile>&#xa;            &lt;tns2:Output>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;                &lt;xsl:if test=&quot;$VerificaFlusso/Record[1]/FOLDER&quot;>&#xa;                    &lt;tns2:SOURCE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/FOLDER&quot;/>&#xa;                    &lt;/tns2:SOURCE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VerificaFlusso/Record[1]/ID_TRACK)&quot;/>&#xa;                &lt;/tns2:ID_TRACK>&#xa;                &lt;xsl:if test=&quot;$VerificaFlusso/Record[1]/DATA_FILE&quot;>&#xa;                    &lt;tns2:DATA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/DATA_FILE&quot;/>&#xa;                    &lt;/tns2:DATA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:FILE_SIZE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VerificaFlusso/Record[1]/FILE_SIZE)&quot;/>&#xa;                &lt;/tns2:FILE_SIZE>&#xa;                &lt;xsl:if test=&quot;$VerificaFlusso/Record[1]/FILE_NAME&quot;>&#xa;                    &lt;tns2:NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/FILE_NAME&quot;/>&#xa;                    &lt;/tns2:NOME_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:Output>&#xa;        &lt;/tns2:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.alignment.shared_library.ReadFile.Sub_UpdStatusVerificaLavorabilità" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Output"
                    name="Assign" outputVariable="Output"
                    tibex:xpdlId="bdcf6549-b177-42aa-ad98-47b8ab2757fe" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WAITAndRetryToAssign"/>
                        <bpws:target linkName="WaiToAssign"/>
                        <bpws:target linkName="CallProcessToAssign1"/>
                        <bpws:target linkName="KOSonsToAssign"/>
                        <bpws:target linkName="KONumRetryToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLogResult1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;KOWaitFather&quot;/>&lt;xsl:param name=&quot;KOSons&quot;/>&lt;xsl:param name=&quot;OKSons&quot;/>&lt;xsl:param name=&quot;WaitFather&quot;/>&lt;xsl:param name=&quot;WaithFatherAndRetry&quot;/>&lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($WaithFatherAndRetry/tns:STATO) > 0&quot;>&lt;xsl:copy-of select=&quot;$WaithFatherAndRetry&quot;/>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($WaitFather/tns:STATO) > 0&quot;>&lt;xsl:copy-of select=&quot;$WaitFather&quot;/>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($OKSons/tns:STATO)>0&quot;>&lt;xsl:copy-of select=&quot;$OKSons&quot;/>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($KOSons/tns:STATO)>0&quot;>&lt;xsl:copy-of select=&quot;$KOSons&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:copy-of select=&quot;$KOWaitFather&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Output" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="KOSons-input"
                    name="KOSons" outputVariable="KOSons"
                    tibex:xpdlId="7243989f-3820-4029-a08c-5b3a0f0241fd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="VerificaStatoPadreToCallProcess11"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="KOSonsToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/VerificaLavorabilita_UpdateStati&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaFlusso&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaParentele&quot;/>&#xa;    &lt;xsl:template name=&quot;KOSons-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:INPUT>&#xa;            &lt;tns2:InfoTrackFile>&#xa;                &lt;tns2:FLAG_LAVORAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:FLAG_LAVORAZIONE>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;                &lt;tns2:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;concat( 'FLUSSO PADRE IN KO, CON ID_FLOW = ', string($VerificaParentele/Record[1]/ID_PARENT), ' CORRELATION_KEY= ', string($VerificaFlusso/Record[1]/CORRELATION_KEY))&quot;/>&#xa;                &lt;/tns2:DESCR_ERRORE>&#xa;                &lt;tns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VerificaFlusso/Record[1]/ID_TRACK)&quot;/>&#xa;                &lt;/tns2:ID_TRACK>&#xa;                &lt;tns2:LogElement>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LoggerName&quot;>&#xa;                        &lt;tns2:LoggerName>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LoggerName&quot;/>&#xa;                        &lt;/tns2:LoggerName>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LogLevel&quot;>&#xa;                        &lt;tns2:LogLevel>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LogLevel&quot;/>&#xa;                        &lt;/tns2:LogLevel>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:MessageForLogs>&#xa;                        &lt;xsl:value-of select=&quot;concat('FLUSSO ', $Start/tns:FLUSSO, ' ID_TRACK= ', string($VerificaFlusso/Record[1]/ID_TRACK), ' IN KO PER KO DEL FLUSSO PADRE')&quot;/>&#xa;                    &lt;/tns2:MessageForLogs>&#xa;                &lt;/tns2:LogElement>&#xa;            &lt;/tns2:InfoTrackFile>&#xa;            &lt;tns2:Output>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;                &lt;xsl:if test=&quot;$VerificaFlusso/Record[1]/FOLDER&quot;>&#xa;                    &lt;tns2:SOURCE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/FOLDER&quot;/>&#xa;                    &lt;/tns2:SOURCE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VerificaFlusso/Record[1]/ID_TRACK)&quot;/>&#xa;                &lt;/tns2:ID_TRACK>&#xa;                &lt;xsl:if test=&quot;$VerificaFlusso/Record[1]/FILE_NAME&quot;>&#xa;                    &lt;tns2:NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/FILE_NAME&quot;/>&#xa;                    &lt;/tns2:NOME_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:Output>&#xa;        &lt;/tns2:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.alignment.shared_library.ReadFile.Sub_UpdStatusVerificaLavorabilità" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="KOWaitFather-input"
                    name="KOWaitFather" outputVariable="KOWaitFather"
                    tibex:xpdlId="15b97d0b-2a8c-403f-8c1e-1617bb641e54"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="VerificaStatoPadreToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="KONumRetryToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/VerificaLavorabilita_UpdateStati&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaFlusso&quot;/>&#xa;    &lt;xsl:template name=&quot;KOWaitFather-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:INPUT>&#xa;            &lt;tns2:InfoTrackFile>&#xa;                &lt;tns2:FLAG_LAVORAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:FLAG_LAVORAZIONE>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;                &lt;tns2:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;'SUPERATA MASSIMA ATTESA FLUSSO PADRE'&quot;/>&#xa;                &lt;/tns2:DESCR_ERRORE>&#xa;                &lt;tns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VerificaFlusso/Record[1]/ID_TRACK)&quot;/>&#xa;                &lt;/tns2:ID_TRACK>&#xa;                &lt;tns2:LogElement>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LoggerName&quot;>&#xa;                        &lt;tns2:LoggerName>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LoggerName&quot;/>&#xa;                        &lt;/tns2:LoggerName>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LogLevel&quot;>&#xa;                        &lt;tns2:LogLevel>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LogLevel&quot;/>&#xa;                        &lt;/tns2:LogLevel>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:MessageForLogs>&#xa;                        &lt;xsl:value-of select=&quot;concat('FLUSSO ', $Start/tns:FLUSSO, ' ID_TRACK= ', string($VerificaFlusso/Record[1]/ID_TRACK), ' IN KO PER TIMEOUT ATTESA PRESENZA PADRE')&quot;/>&#xa;                    &lt;/tns2:MessageForLogs>&#xa;                &lt;/tns2:LogElement>&#xa;            &lt;/tns2:InfoTrackFile>&#xa;            &lt;tns2:Output>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;                &lt;xsl:if test=&quot;$VerificaFlusso/Record[1]/FOLDER&quot;>&#xa;                    &lt;tns2:SOURCE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/FOLDER&quot;/>&#xa;                    &lt;/tns2:SOURCE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VerificaFlusso/Record[1]/ID_TRACK)&quot;/>&#xa;                &lt;/tns2:ID_TRACK>&#xa;                &lt;xsl:if test=&quot;$VerificaFlusso/Record[1]/FILE_NAME&quot;>&#xa;                    &lt;tns2:NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/FILE_NAME&quot;/>&#xa;                    &lt;/tns2:NOME_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:Output>&#xa;        &lt;/tns2:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.alignment.shared_library.ReadFile.Sub_UpdStatusVerificaLavorabilità" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LavorazioneManuale-input"
                    name="LavorazioneManuale"
                    outputVariable="LavorazioneManuale"
                    tibex:xpdlId="e907254d-cf1d-4016-bcb1-bcf10a3e166f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="VerificaStatoBlocchiPrecedentiToLavorazioneManuale"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LavorazioneManualeToAttesa"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/VerificaLavorabilita_UpdateStati&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaFlusso&quot;/>&#xa;    &lt;xsl:template name=&quot;LavorazioneManuale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:INPUT>&#xa;            &lt;tns2:InfoTrackFile>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'LAVORAZIONE MANUALE'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;                &lt;tns2:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;'FLUSSI DEI BLOCCHI PRECEDENTI IN ERRORE - IN ATTESA DI VERIFICHE PER SBLOCCO MANUALE'&quot;/>&#xa;                &lt;/tns2:DESCR_ERRORE>&#xa;                &lt;tns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VerificaFlusso/Record[1]/ID_TRACK)&quot;/>&#xa;                &lt;/tns2:ID_TRACK>&#xa;                &lt;tns2:LogElement>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LoggerName&quot;>&#xa;                        &lt;tns2:LoggerName>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LoggerName&quot;/>&#xa;                        &lt;/tns2:LoggerName>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LogLevel&quot;>&#xa;                        &lt;tns2:LogLevel>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LogLevel&quot;/>&#xa;                        &lt;/tns2:LogLevel>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:MessageForLogs>&#xa;                        &lt;xsl:value-of select=&quot;concat('PRESENTI  LAVORAZIONI PRECEDENTI IN ERRORE PER IL FLUSSO : ', $Start/tns:FLUSSO, ' BLOCCO IN LAVORAZIONE MANUALE')&quot;/>&#xa;                    &lt;/tns2:MessageForLogs>&#xa;                &lt;/tns2:LogElement>&#xa;            &lt;/tns2:InfoTrackFile>&#xa;            &lt;tns2:Output>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'MANUALE'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;            &lt;/tns2:Output>&#xa;        &lt;/tns2:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.alignment.shared_library.ReadFile.Sub_UpdStatusVerificaLavorabilità" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="KOWaitingSons-input"
                    name="KOWaitingSons" outputVariable="KOWaitingSons"
                    tibex:xpdlId="212ff03e-063e-4331-9817-1eae6737f89e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="VerificaPresenzaTuttiFigliToCallProcess3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="KOWaitingSonsToKO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/VerificaLavorabilita_UpdateStati&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaFlusso&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaParentele&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:INPUT>&#xa;            &lt;tns2:InfoTrackFile>&#xa;                &lt;tns2:FLAG_LAVORAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:FLAG_LAVORAZIONE>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;                &lt;tns2:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;'**ATTESA PRESENZA FIGLI TERMINATA**'&quot;/>&#xa;                &lt;/tns2:DESCR_ERRORE>&#xa;                &lt;tns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VerificaFlusso/Record[1]/ID_TRACK)&quot;/>&#xa;                &lt;/tns2:ID_TRACK>&#xa;                &lt;tns2:LogElement>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LoggerName&quot;>&#xa;                        &lt;tns2:LoggerName>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LoggerName&quot;/>&#xa;                        &lt;/tns2:LoggerName>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:LogElement/tns:LogLevel&quot;>&#xa;                        &lt;tns2:LogLevel>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LogLevel&quot;/>&#xa;                        &lt;/tns2:LogLevel>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:MessageForLogs>&#xa;                        &lt;xsl:value-of select=&quot;concat('***TIMEOUT ATTESA FIGLI, FLUSSO ' ,$Start/tns:FLUSSO , 'ID_TRACK= ', string($VerificaFlusso/Record[1]/ID_TRACK)  ,&amp;quot; IN KO , NUMERO TENTATIVI DI ATTESA,&amp;quot;, string($VerificaFlusso/Record[1]/NUM_RETRY) , &amp;quot; MASSIMO TENTATIVI = &amp;quot;,string($VerificaParentele/Record[1]/MAX_RETRY) )&quot;/>&#xa;                    &lt;/tns2:MessageForLogs>&#xa;                &lt;/tns2:LogElement>&#xa;            &lt;/tns2:InfoTrackFile>&#xa;            &lt;tns2:Output>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;                &lt;xsl:if test=&quot;$VerificaFlusso/Record[1]/FOLDER&quot;>&#xa;                    &lt;tns2:SOURCE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/FOLDER&quot;/>&#xa;                    &lt;/tns2:SOURCE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VerificaFlusso/Record[1]/ID_TRACK)&quot;/>&#xa;                &lt;/tns2:ID_TRACK>&#xa;                &lt;xsl:if test=&quot;$VerificaFlusso/Record[1]/FILE_NAME&quot;>&#xa;                    &lt;tns2:NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/FILE_NAME&quot;/>&#xa;                    &lt;/tns2:NOME_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:Output>&#xa;        &lt;/tns2:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.alignment.shared_library.ReadFile.Sub_UpdStatusVerificaLavorabilità" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
