            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="UpdateAttesa-input"
                    name="UpdateAttesa"
                    tibex:xpdlId="73cb7c24-6fd2-42e5-995d-c40f18c5da77"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToUpdateAttesa"/>
                        <bpws:target linkName="LogInCorsoToUpdateAttesa"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToWait"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/InputTrackFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaFlusso&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;tns2:Update>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'IN ATTESA'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;                &lt;tns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VerificaFlusso/Record[1]/ID_TRACK)&quot;/>&#xa;                &lt;/tns2:ID_TRACK>&#xa;                &lt;tns2:NUM_RETRY>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:NUM_RETRY>&#xa;                &lt;tns2:LogElement/>&#xa;            &lt;/tns2:Update>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
