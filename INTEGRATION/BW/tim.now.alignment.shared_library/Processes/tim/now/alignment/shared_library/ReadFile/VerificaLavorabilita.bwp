            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="VerificaStatoPadre-input"
                    name="VerificaStatoPadre"
                    outputVariable="VerificaStatoPadre"
                    tibex:xpdlId="f5e38eba-1a65-4f0b-be0b-28a922ccab85" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckToVerificaStatoPadre"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="VerificaStatoPadreToWai">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$VerificaStatoPadre/Record[1]/STATO_PADRE=('IN ATTESA', 'IN LAVORAZIONE','DA LAVORARE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$VerificaStatoPadre/Record[1]/STATO_PADRE=('IN ATTESA', 'IN LAVORAZIONE','DA LAVORARE')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaStatoPadreToCallProcess11">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$VerificaStatoPadre/Record[1]/STATO_PADRE=('KO','KO_NUMERO_RECORD','ERROR')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$VerificaStatoPadre/Record[1]/STATO_PADRE=('KO','KO_NUMERO_RECORD','ERROR')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaStatoPadreToCallProcess2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$VerificaStatoPadre/Record[1]/STATO_PADRE='COMPLETATO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$VerificaStatoPadre/Record[1]/STATO_PADRE='COMPLETATO']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaStatoPadreToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($VerificaStatoPadre/Record[1]/STATO_PADRE)=0 and ($VerificaFlusso/Record[1]/NUM_RETRY&lt;$VerificaParentele/Record[1]/MAX_RETRY or string-length(string($VerificaFlusso/Record[1]/NUM_RETRY))=0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($VerificaStatoPadre/Record[1]/STATO_PADRE)=0 and ($VerificaFlusso/Record[1]/NUM_RETRY<$VerificaParentele/Record[1]/MAX_RETRY or string-length(string($VerificaFlusso/Record[1]/NUM_RETRY))=0)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaStatoPadreToCallProcess1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f5e38eba-1a65-4f0b-be0b-28a922ccab85+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaFlusso&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaParentele&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaStatoPadre-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;CORRELATION_KEY>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaFlusso/Record[1]/CORRELATION_KEY)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaFlusso/Record[1]/CORRELATION_KEY&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CORRELATION_KEY>&#xa;            &lt;ID_FLUSSO_PADRE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaParentele/Record[1]/ID_PARENT)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaParentele/Record[1]/ID_PARENT&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_FLUSSO_PADRE>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STATO as STATO_PADRE&#xa;FROM ALIGN_FILE_TRACKING AFT&#xa; WHERE CORRELATION_KEY=?&#xa; AND&#xa; ID_FLOW=?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="CORRELATION_KEY"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FLUSSO_PADRE"/>
                                    <columnMetadata
                                    columnName="STATO_PADRE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
