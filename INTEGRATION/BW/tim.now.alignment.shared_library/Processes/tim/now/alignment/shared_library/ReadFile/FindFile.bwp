                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[contains($Start/tns:FileName, ".ctr") or contains($Start/tns:FileName, ".OK") or contains($Start/tns:FileName,".TAPPO") or contains($Start/tns:FileName,".CTR") or contains($Start/tns:FileName,".tappo")]]></bpws:transitionCondition>
