    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="FileToFileCSV" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesToLogListFile" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogListFileToRemoveFile" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="FileCSVToListFiles" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesToEnd" tibex:linkType="ERROR"/>
                <bpws:link name="AssignToFileCSV" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesToSetKOFileNotFound" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogEndErrorToRemoveFile" tibex:linkType="SUCCESS"/>
                <bpws:link name="SetKOFileNotFoundToLogEndError" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToLogListFile" tibex:linkType="SUCCESS"/>
                <bpws:link name="SetKOErrorFileToLogEndError" tibex:linkType="SUCCESS"/>
                <bpws:link name="RemoveFileToCallProcess" tibex:linkType="ERROR"/>
                <bpws:link name="CallProcessToMapEND" tibex:linkType="SUCCESS"/>
                <bpws:link name="RemoveFileToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogListFileToRenameFile" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="RenameFileToMapEND" tibex:linkType="SUCCESS"/>
                <bpws:link name="RenameFileToCallProcess" tibex:linkType="ERROR"/>
                <bpws:link name="LogKORenameToMapEND" tibex:linkType="SUCCESS"/>
                <bpws:link name="ControlloFlussoToMapEND" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="ControlloFlussoToCallProcess1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcess1ToRemoveFile1" tibex:linkType="SUCCESS"/>
                <bpws:link name="RemoveFile1ToListFiles1" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFiles1ToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="ListFiles1ToAssign1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ListFiles1ToAssign2" tibex:linkType="ERROR"/>
                <bpws:link name="AssignToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Assign1ToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="Assign2ToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess1ToMapEND" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToMapEND1" tibex:linkType="SUCCESS"/>
                <bpws:link name="RemoveFile1ToCallProcess2" tibex:linkType="ERROR"/>
                <bpws:link name="CallProcess2ToListFiles1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Copy_1_LogListFileToRenameEstensione" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Copy_1_LogListFileToRenameEstensione2" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartToCopy_1_LogListFile" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogStartToCopy_1_MapEND" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="MapENDToCopy_1_LogSetOKFileZip" tibex:linkType="SUCCESS"/>
                <bpws:link name="Copy_1_MapENDToCopy_1_LogSetOKFileZip" tibex:linkType="SUCCESS"/>
                <bpws:link name="Copy_1_LogSetOKFileZipToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="d8986acc-6613-443c-9abb-1138fed14933"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCopy_1_LogListFile"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="956ef50e-cb8a-4ee2-9aaf-2b20fe34fa73" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Copy_1_LogSetOKFileZipToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapEND&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$MapEND&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="NomeFile"
                    name="RenameEstensione2" outputVariable="NomeFile"
                    tibex:xpdlId="65146542-6e43-4801-bb1e-c9643bcd7c0b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Copy_1_LogListFileToRenameEstensione2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FileToFileCSV"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if ($Start/tns:Flusso='AnagraficaGPON') &#xd;&#xa;then concat(substring-before($Start/tns:FileName, '.'),'.csv',$Start/tns:Estensione) &#xd;&#xa;else if ($Start/tns:Flusso='ConsistenzeFWAconModem' or $Start/tns:Flusso='RiscontriGSRI_NPNG' or $Start/tns:Flusso='AnagraficaCodiciNMU') &#xd;&#xa;then concat(tib:substring-before-last($Start/tns:FileName,'.'),$Start/tns:Estensione)&#xd;&#xa;else if ($Start/tns:Flusso='BonificaGPON')&#xd;&#xa;then concat(tib:substring-before-last(tib:substring-before-last($Start/tns:FileName,'.'),'.'),$Start/tns:Estensione) &#xd;&#xa;else concat(substring-before($Start/tns:FileName, '.'), $Start/tns:Estensione)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="NomeFile" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ListFiles-input"
                    name="ListFiles" outputVariable="ListFiles"
                    tibex:xpdlId="203e49ca-1499-47d3-bd77-a65a9760919c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FileCSVToListFiles"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListFilesToLogListFile">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ListFilesToEnd"
                            tibex:faultDetailsVar="ListFiles" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ListFilesToSetKOFileNotFound">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($ListFiles/files/fileInfo)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($ListFiles/files/fileInfo)=0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NomeFile&quot;/>&lt;xsl:template name=&quot;ListFiles-input&quot; match=&quot;/&quot;>&lt;tns:ListFilesActivityConfig>&lt;fileName>&lt;xsl:value-of select=&quot;$NomeFile&quot;/>&lt;/fileName>&lt;/tns:ListFilesActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.list"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//ListFiles"/>
                                    <value mode="files-and-directories" xsi:type="file:ListFiles"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="FileCSV-input"
                    name="FileCSV"
                    tibex:xpdlId="354e86d9-a943-4b6b-a1fa-6ff336f44dd7"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FileToFileCSV"/>
                        <bpws:target linkName="AssignToFileCSV"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FileCSVToListFiles">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;NomeFile&quot;/>&lt;xsl:template name=&quot;FileCSV-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;$Start/tns:ApplicationName&quot;/>&lt;/tns1:Application>&lt;tns1:Process>&lt;xsl:value-of select=&quot;'ReadFile'&quot;/>&lt;/tns1:Process>&lt;tns1:MsgCode>&lt;xsl:value-of select=&quot;$NomeFile&quot;/>&lt;/tns1:MsgCode>&lt;tns1:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;LogFileCSV: &amp;quot;,$NomeFile)&quot;/>&lt;/tns1:Message>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns:LogName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns:LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
