    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd_NoSFTPProtocol"
                    tibex:label="No SFTP Protocol" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Log_StartToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="Invoke_SFTP_DirToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToLog_End" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="Invoke_SFTP_DirToLog_NoFiles" tibex:linkType="ERROR"/>
                <bpws:link name="Log_NoFilesToLog_End" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="5e023bc3-6d4d-4ce6-854c-b9459120a772"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEnd_NoSFTPProtocol">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns1:InputData/ns1:TypeOfProtocol = 'SFTP'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns1:InputData/ns1:TypeOfProtocol = 'SFTP']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="845eb99b-5512-4273-b57c-8d10b55ced01" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd_NoSFTPProtocol"/>
                        <bpws:target linkName="CallProcessToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Log_Start-input"
                    name="Log_Start"
                    tibex:xpdlId="a15de382-69a2-4704-a5aa-c3fb0a083db7"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_StartToInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_RemoveJavaCode&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Log_Start-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Sub_DeleteFiles'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Start sub_DeleteFiles'&quot;/>&lt;/tns:Message>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Log_End-input"
                    name="Log_End"
                    tibex:xpdlId="b333f246-d231-4b1d-beb6-ffa4a2bbe134"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToLog_End"/>
                        <bpws:target linkName="Log_NoFilesToLog_End"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_RemoveJavaCode&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Log_End-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Sub_DeleteFiles'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'SFTP Remove terminata.'&quot;/>&lt;/tns:Message>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="Invoke_SFTP_Dir-input"
                name="Invoke_SFTP_Dir"
                operation="SftDirJavaCodeOperation"
                outputVariable="Invoke_SFTP_Dir" partnerLink="STFP_Dir"
                portType="ns4:SFTPDirJavaCode" tibex:xpdlId="6ba35729-375a-4dad-a9e2-949d3ea24456">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="www.tim.now.alignment.sharedlibrary.DataEstrazioni" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/SFTPDirJavaCode/" xmlns:tns1="http://www.tim.com/NOW/xsd/SFTP_DirJavaCode" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;tns:SftDirJavaCodeOperationRequest&gt;&lt;SftpDirInput&gt;&lt;tns1:SFTP_DirJavaCodeInput&gt;&lt;tns1:path&gt;&lt;xsl:value-of select="$Start/ns:InputData/ns:SourceDirectory"/&gt;&lt;/tns1:path&gt;&lt;tns1:credenziali&gt;&lt;tns1:Host&gt;&lt;xsl:value-of select="$Start/ns:InputData/ns:SFTP/ns:HOST"/&gt;&lt;/tns1:Host&gt;&lt;tns1:Port&gt;&lt;xsl:value-of select="$Start/ns:InputData/ns:SFTP/ns:PORT"/&gt;&lt;/tns1:Port&gt;&lt;xsl:if test="$Start/ns:InputData/ns:SFTP/ns:PASSOWRD"&gt;&lt;tns1:Password&gt;&lt;xsl:value-of select="$Start/ns:InputData/ns:SFTP/ns:PASSOWRD"/&gt;&lt;/tns1:Password&gt;&lt;/xsl:if&gt;&lt;tns1:User&gt;&lt;xsl:value-of select="$Start/ns:InputData/ns:SFTP/ns:USERNAME"/&gt;&lt;/tns1:User&gt;&lt;/tns1:credenziali&gt;&lt;/tns1:SFTP_DirJavaCodeInput&gt;&lt;/SftpDirInput&gt;&lt;/tns:SftDirJavaCodeOperationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/SFTPDirJavaCode/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_DirJavaCode&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SFTP_DirJavaCodeInput>&#xa;            &lt;tns1:path>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SourceDirectory&quot;/>&#xa;            &lt;/tns1:path>&#xa;            &lt;tns1:credenziali>&#xa;                &lt;tns1:Host>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:HOST&quot;/>&#xa;                &lt;/tns1:Host>&#xa;                &lt;tns1:Port>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:PORT&quot;/>&#xa;                &lt;/tns1:Port>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:SFTP/ns:PASSOWRD&quot;>&#xa;                    &lt;tns1:Password>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:PASSOWRD&quot;/>&#xa;                    &lt;/tns1:Password>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:User>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:USERNAME&quot;/>&#xa;                &lt;/tns1:User>&#xa;            &lt;/tns1:credenziali>&#xa;        &lt;/tns1:SFTP_DirJavaCodeInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Log_StartToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Invoke_SFTP_DirToCallProcess"/>
                    <bpws:source linkName="Invoke_SFTP_DirToLog_NoFiles"
                        tibex:faultDetailsVar="Invoke_SFTP_Dir" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="a4615b05-be33-440c-8679-1034d0faaeb7">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToLog_End"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt; count($Invoke_SFTP_Dir/SftpDirOutput/tns:SFTP_DirJavaCodeOutput/tns:File)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index < count($Invoke_SFTP_Dir.SftpDirOutput/tns:File)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToSourceDirectory" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="SourceDirectoryToInvoke" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Invoke_SFTP_RemoveToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="53d660cb-0b32-465b-af07-7b54993981b6">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToSourceDirectory"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="f4b17701-ec9c-4b96-b19f-a4412c5103d7">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="concat($Start/ns1:InputData/ns1:SourceDirectory, $Invoke_SFTP_Dir/SftpDirOutput/tns:SFTP_DirJavaCodeOutput/tns:File[number($index)])"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="SourceDirectory"
                                    name="SourceDirectory"
                                    outputVariable="SourceDirectory"
                                    tibex:xpdlId="041bf58c-3797-4d53-b678-c940b374b77d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToSourceDirectory"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SourceDirectoryToInvoke"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="concat($Start/ns1:InputData/ns1:SourceDirectory, $Invoke_SFTP_Dir.SftpDirOutput/tns:File[number($index)])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="SourceDirectory" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="Invoke_SFTP_Remove-input"
                                name="Invoke_SFTP_Remove"
                                operation="SftRemoveJavaCodeOperation"
                                outputVariable="Invoke_SFTP_Remove"
                                partnerLink="SFTPRemoveJavaCode"
                                portType="ns2:SFTPRemoveJavaCode" tibex:xpdlId="6b7f7419-0e21-4147-b70e-ab7448a11987">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/SFTPRemoveJavaCode/" xmlns:tns1="http://www.tim.com/NOW/xsd/SFTP_RemoveJavaCode" xmlns:ns="www.tim.now.alignment.sharedlibrary.DataEstrazioni" version="2.0"&gt;&lt;xsl:param name="SourceDirectory"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;tns:SftRemoveJavaCodeOperationRequest&gt;&lt;SftpRemoveInput&gt;&lt;tns1:SFTP_RemoveJavaCodeInput&gt;&lt;tns1:RemoteFile&gt;&lt;xsl:value-of select="$SourceDirectory"/&gt;&lt;/tns1:RemoteFile&gt;&lt;tns1:credenziali&gt;&lt;tns1:Host&gt;&lt;xsl:value-of select="$Start/ns:InputData/ns:SFTP/ns:HOST"/&gt;&lt;/tns1:Host&gt;&lt;tns1:Port&gt;&lt;xsl:value-of select="$Start/ns:InputData/ns:SFTP/ns:PORT"/&gt;&lt;/tns1:Port&gt;&lt;xsl:if test="$Start/ns:InputData/ns:SFTP/ns:PASSOWRD"&gt;&lt;tns1:Password&gt;&lt;xsl:value-of select="$Start/ns:InputData/ns:SFTP/ns:PASSOWRD"/&gt;&lt;/tns1:Password&gt;&lt;/xsl:if&gt;&lt;tns1:User&gt;&lt;xsl:value-of select="$Start/ns:InputData/ns:SFTP/ns:USERNAME"/&gt;&lt;/tns1:User&gt;&lt;/tns1:credenziali&gt;&lt;/tns1:SFTP_RemoveJavaCodeInput&gt;&lt;/SftpRemoveInput&gt;&lt;/tns:SftRemoveJavaCodeOperationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/SFTPRemoveJavaCode/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_RemoveJavaCode&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SourceDirectory&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SFTP_RemoveJavaCodeInput>&#xa;            &lt;tns1:RemoteFile>&#xa;                &lt;xsl:value-of select=&quot;$SourceDirectory&quot;/>&#xa;            &lt;/tns1:RemoteFile>&#xa;            &lt;tns1:credenziali>&#xa;                &lt;tns1:Host>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:HOST&quot;/>&#xa;                &lt;/tns1:Host>&#xa;                &lt;tns1:Port>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:PORT&quot;/>&#xa;                &lt;/tns1:Port>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:SFTP/ns:PASSOWRD&quot;>&#xa;                    &lt;tns1:Password>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:PASSOWRD&quot;/>&#xa;                    &lt;/tns1:Password>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:User>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:USERNAME&quot;/>&#xa;                &lt;/tns1:User>&#xa;            &lt;/tns1:credenziali>&#xa;        &lt;/tns1:SFTP_RemoveJavaCodeInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="SourceDirectoryToInvoke"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Invoke_SFTP_RemoveToCallProcess"/>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:extActivity
