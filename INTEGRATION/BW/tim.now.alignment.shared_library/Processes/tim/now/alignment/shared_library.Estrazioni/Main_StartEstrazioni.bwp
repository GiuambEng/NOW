                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsProcessInstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate1&quot;/>&#xa;    &lt;xsl:template name=&quot;DataForProcedure-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:root>&#xa;            &lt;tns:InputData>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;1=2 and $currentElement/COD_INTRFC=('ID308','ID309','ID310')&quot;>&#xa;                        &lt;xsl:copy-of select=&quot;$Accumulate1/tns:root/tns:InputData/tns:DataForProcedure&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:DataForProcedure>&#xa;                            &lt;xsl:if test=&quot;$currentElement/DATAESECUZIONE&quot;>&#xa;                                &lt;tns:DATAESECUZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;$currentElement/DATAESECUZIONE&quot;/>&#xa;                                &lt;/tns:DATAESECUZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:FLUSSO_DI_ESTRAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/ESTRAZIONE&quot;/>&#xa;                            &lt;/tns:FLUSSO_DI_ESTRAZIONE>&#xa;                            &lt;tns:COD_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/COD_INTRFC&quot;/>&#xa;                            &lt;/tns:COD_INTRFC>&#xa;                            &lt;xsl:if test=&quot;string-length($InsProcessInstance.part1/ns:Esito/ns:ID_FILE)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$InsProcessInstance.part1/ns:Esito/ns:ID_FILE&quot;>&#xa;                                    &lt;tns:ID_FILE>&#xa;                                        &lt;xsl:value-of select=&quot;$InsProcessInstance.part1/ns:Esito/ns:ID_FILE&quot;/>&#xa;                                    &lt;/tns:ID_FILE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$currentElement/CODICE_OLO&quot;>&#xa;                                &lt;tns:CODICE_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;$currentElement/CODICE_OLO&quot;/>&#xa;                                &lt;/tns:CODICE_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:DATA_INIZIO>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string($currentElement/DATA_INIZIO), &amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DATA_INIZIO>&#xa;                            &lt;tns:DATA_FINE>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string($currentElement/DATA_FINE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DATA_FINE>&#xa;                            &lt;tns:DATA_ESPLETAMENTO>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string($currentElement/DATA_ESPLETAMENTO), &amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DATA_ESPLETAMENTO>&#xa;                            &lt;xsl:if test=&quot;string-length($currentElement/GENERIC_PARAM)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$currentElement/GENERIC_PARAM&quot;>&#xa;                                    &lt;tns:GENERIC_PARAM>&#xa;                                        &lt;xsl:value-of select=&quot;$currentElement/GENERIC_PARAM&quot;/>&#xa;                                    &lt;/tns:GENERIC_PARAM>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:DataForProcedure>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:InputData>&#xa;        &lt;/tns:root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
