                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SourceDirectory&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Send_SFTP-input&quot; match=&quot;/&quot;>&lt;tns:SFTP_Put_Input>&lt;tns:FileToBeSend>&lt;xsl:value-of select=&quot;$SourceDirectory&quot;/>&lt;/tns:FileToBeSend>&lt;tns:RomoteDirectory>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:DestinationDirectory&quot;/>&lt;/tns:RomoteDirectory>&lt;tns:Credentials>&lt;tns:Host>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:HOST&quot;/>&lt;/tns:Host>&lt;tns:Port>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:PORT&quot;/>&lt;/tns:Port>&lt;tns:User>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:USERNAME&quot;/>&lt;/tns:User>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:SFTP/ns:PASSOWRD&quot;>&lt;tns:Password>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:PASSOWRD&quot;/>&lt;/tns:Password>&lt;/xsl:if>&lt;/tns:Credentials>&lt;/tns:SFTP_Put_Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
