            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="0887b536-3b14-4935-9ca6-c8d0402d56f9"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns1:InputData/ns1:TypeOfProtocol='SFTP' and not(starts-with($Start/ns1:InputData/ns1:NomeFile, 'QDR_NOW_'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns1:InputData/ns1:TypeOfProtocol='SFTP' and not(starts-with($Start/ns1:InputData/ns1:NomeFile, 'QDR_NOW_'))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToLog_End">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
