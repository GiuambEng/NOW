                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="SourceDirectory" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="LogFileInviato-input"
                name="LogFileInviato" operation="Insert"
                outputVariable="LogFileInviato" partnerLink="Logger"
                portType="ns6:ProcessLog" tibex:xpdlId="480b9b29-56dd-4d11-9392-70bf8738a41c">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="www.tim.now.alignment.sharedlibrary.DataEstrazioni" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="getID_ESEC"/&gt;&lt;xsl:template name="LogFileInviato-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'FILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile/&gt;&lt;ns:FileProcessato&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="'INVIATO'"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="'INVIO FILE AVVENUTO CON SUCCESSO'"/&gt;&lt;/ns:ESITO&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="xsd:integer($getID_ESEC/Record[1]/ID_ESEC_PROCSO_FILE)"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:if test="$Start/ns2:InputData/ns2:IDFile"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Start/ns2:InputData/ns2:IDFile"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="'OUTPUT'"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/ns:FileProcessato&gt;&lt;ns:EsecuzioneFile&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="xsd:integer($getID_ESEC/Record[1]/ID_ESEC_PROCSO_FILE)"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON SUCCESSO&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneFile&gt;&lt;ns:FileProcessatoOutput&gt;&lt;ns:ESITO_INVIO&gt;&lt;xsl:value-of select="'FILE INVIATO CON SUCCESSO'"/&gt;&lt;/ns:ESITO_INVIO&gt;&lt;xsl:if test="$Start/ns2:InputData/ns2:IDFile"&gt;&lt;ns:ID_FILE_PROCSTO_OUTPUT&gt;&lt;xsl:value-of select="$Start/ns2:InputData/ns2:IDFile"/&gt;&lt;/ns:ID_FILE_PROCSTO_OUTPUT&gt;&lt;/xsl:if&gt;&lt;ns:TIMSTP_INVIO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INVIO&gt;&lt;/ns:FileProcessatoOutput&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;getID_ESEC&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFileInviato-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;'FILE'&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile/>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;ns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;'INVIATO'&quot;/>&#xa;                &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;'INVIO FILE AVVENUTO CON SUCCESSO'&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($getID_ESEC/Record[1]/ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:if test=&quot;$Start/ns2:InputData/ns2:IDFile&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns2:InputData/ns2:IDFile&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;ns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;'OUTPUT'&quot;/>&#xa;                &lt;/ns:VERSO_DEL_FILE>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($getID_ESEC/Record[1]/ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON SUCCESSO&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_FINE_ELAB>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;            &lt;ns:FileProcessatoOutput>&#xa;                &lt;ns:ESITO_INVIO>&#xa;                    &lt;xsl:value-of select=&quot;'FILE INVIATO CON SUCCESSO'&quot;/>&#xa;                &lt;/ns:ESITO_INVIO>&#xa;                &lt;xsl:if test=&quot;$Start/ns2:InputData/ns2:IDFile&quot;>&#xa;                    &lt;ns:ID_FILE_PROCSTO_OUTPUT>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns2:InputData/ns2:IDFile&quot;/>&#xa;                    &lt;/ns:ID_FILE_PROCSTO_OUTPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:TIMSTP_INVIO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_INVIO>&#xa;            &lt;/ns:FileProcessatoOutput>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
