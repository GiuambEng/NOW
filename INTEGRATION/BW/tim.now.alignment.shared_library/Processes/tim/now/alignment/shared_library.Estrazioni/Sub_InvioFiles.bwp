&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns2="www.tim.now.alignment.sharedlibrary.DataEstrazioni" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="LogKO-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'FILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'LOG'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$Start/ns2:InputData/ns2:IDFile"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Start/ns2:InputData/ns2:IDFile"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'ERROR'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="'FINE LAVORAZIONE FILE OUTPUT PER INVIO FALLITO'"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns2=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogKO-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;'FILE'&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;'LOG'&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$Start/ns2:InputData/ns2:IDFile&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns2:InputData/ns2:IDFile&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:LOG_LEVEL>&#xa;                    &lt;xsl:value-of select=&quot;'ERROR'&quot;/>&#xa;                &lt;/ns:LOG_LEVEL>&#xa;                &lt;ns:LOG_MESSAGE>&#xa;                    &lt;xsl:value-of select=&quot;'FINE LAVORAZIONE FILE OUTPUT PER INVIO FALLITO'&quot;/>&#xa;                &lt;/ns:LOG_MESSAGE>&#xa;                &lt;ns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_INSMTO>&#xa;            &lt;/ns:LogFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="InvokeToInvoke11"/>
                            </bpws:targets>
                        </bpws:invoke>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="LogK-input" name="LogK"
                                tibex:xpdlId="6e9587fa-6589-474f-ad4f-182c3881e6b3"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
