                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+183812ae-5264-4d25-a2f2-32364b6b541a+input&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:param name=&quot;Send_SFTP&quot;/>&lt;xsl:template name=&quot;UpdateStatoFailed-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;DESCR_ERRORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists( if (exists($_error)) then  substring(tib:render-xml($_error,true(), true()), 1, 1990) else if ($Send_SFTP/tns1:Status='KO') then $Send_SFTP/tns1:Message else  'Errore generico nel send file')&quot;>&lt;xsl:value-of select=&quot; if (exists($_error)) then  substring(tib:render-xml($_error,true(), true()), 1, 1990) else if ($Send_SFTP/tns1:Status='KO') then $Send_SFTP/tns1:Message else  'Errore generico nel send file'&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCR_ERRORE>&lt;NOMEFILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:InputData/ns:NomeFile)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:NomeFile&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOMEFILE>&lt;IDFILE>&lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&lt;/IDFILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
