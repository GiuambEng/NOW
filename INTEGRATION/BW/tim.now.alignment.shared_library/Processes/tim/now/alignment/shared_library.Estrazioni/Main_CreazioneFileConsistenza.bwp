                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="UpdStatoLoad-input"
                                    name="UpdStatoLoad"
                                    outputVariable="UpdStatoLoad"
                                    tibex:xpdlId="97b8ca68-af33-45f5-a9ea-931f8389c1f3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToInvioFile"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToInvioFile">
                                    <tibex:DesignExpression>
