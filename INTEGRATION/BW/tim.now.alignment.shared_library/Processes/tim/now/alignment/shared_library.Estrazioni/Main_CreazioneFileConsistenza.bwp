                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InvioFileNODHGEToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentCreatedFile&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;INCONTRACPSDestination&quot;/>&lt;xsl:template name=&quot;InvioFileNODHGE-input&quot; match=&quot;/&quot;>&lt;ns:root>&lt;ns:InputData>&lt;ns:NomeFile>&lt;xsl:value-of select=&quot;$currentCreatedFile/NOME_FILE&quot;/>&lt;/ns:NomeFile>&lt;ns:IDFile>&lt;xsl:value-of select=&quot;xsd:integer($currentCreatedFile/ID_FILE)&quot;/>&lt;/ns:IDFile>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:SystemName&quot;>&lt;ns:SystemName>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SystemName&quot;/>&lt;/ns:SystemName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:SourceDirectory&quot;>&lt;ns:SourceDirectory>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SourceDirectory&quot;/>&lt;/ns:SourceDirectory>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($currentCreatedFile/NOME_FILE,'NOW_INCONTRA_CPS')&quot;>&lt;ns:DestinationDirectory>&lt;xsl:value-of select=&quot;$INCONTRACPSDestination&quot;/>&lt;/ns:DestinationDirectory>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:DestinationDirectory&quot;>&lt;ns:DestinationDirectory>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:DestinationDirectory&quot;/>&lt;/ns:DestinationDirectory>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:TypeOfProtocol&quot;>&lt;ns:TypeOfProtocol>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:TypeOfProtocol&quot;/>&lt;/ns:TypeOfProtocol>&lt;/xsl:if>&lt;ns:Flag_TAPPO>&lt;xsl:value-of select=&quot;if ((contains($currentCreatedFile/NOME_FILE, 'BTS_F') and (contains($currentCreatedFile/NOME_FILE, '.TXT') or contains($currentCreatedFile/NOME_FILE, '.txt'))) or contains($currentCreatedFile/NOME_FILE, '_NOW.csv') or&amp;#xD;&amp;#xA;$Start/ns:InputData/ns:SystemName=('INCONTRA','RAC') ) then 'Y' else 'N'&quot;/>&lt;/ns:Flag_TAPPO>&lt;xsl:copy-of select=&quot;$Start/ns:InputData/ns:LogInfo&quot;/>&lt;xsl:copy-of select=&quot;$Start/ns:InputData/ns:SFTP&quot;/>&lt;/ns:InputData>&lt;/ns:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
