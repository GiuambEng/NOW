                                    <tibex:activityExtension
                                    inputVariable="UpdateStatoLoad-input"
                                    name="UpdateStatoLoad"
                                    outputVariable="UpdateStatoLoad"
                                    tibex:xpdlId="80a17e87-8432-438a-a370-a41e81fb49f3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToUpdateStatoLoad"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="UpdateStatoLoadToUpdateInfoFile"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+80a17e87-8432-438a-a370-a41e81fb49f3+input&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentRecordOK&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;UpdateStatoLoad-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;SYSTEM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:InputData/ns:SystemName)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SystemName&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SYSTEM>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($currentRecordOK/ID_FILE)&quot;/>&lt;/ID_FILE>&lt;NOME_FILE>&lt;xsl:value-of select=&quot;$currentRecordOK/NOME_FILE&quot;/>&lt;/NOME_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
