                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($GetRecordEstratti/Record[STATUS='OK'])[number($idx)]]]></bpws:from>
