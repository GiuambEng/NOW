                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bd08ae5f-3ee0-4f35-9377-e1db518c971c+input&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentRecordOK&quot;/>&lt;xsl:template name=&quot;UpdateInfoFile-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;NOME_FILE>&lt;xsl:value-of select=&quot;$currentRecordOK/NOME_FILE&quot;/>&lt;/NOME_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($currentRecordOK/NOME_FILE, '.txt') or contains($currentRecordOK/NOME_FILE, '.TXT')&quot;>&lt;IDTPLG_FILE>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDTPLG_FILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDTPLG_FILE>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/IDTPLG_FILE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($currentRecordOK/ID_FILE)&quot;/>&lt;/ID_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout_Estrazioni"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE FILE_PROCSTO&#xa;  SET NOME_FILE = ?, IDTPLG_FILE=?&#xa;  WHERE ID_FILE=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_FILE"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="IDTPLG_FILE"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FILE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="CreazioneFile-input"
                                    name="CreazioneFile"
                                    tibex:xpdlId="f297be03-8dbe-4c2f-b13f-fce2790cc974"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="UpdateInfoFileToCreazioneFile"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CreazioneFileToEmpty"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentRecordOK&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CreazioneFile-input&quot; match=&quot;/&quot;>&lt;ns:root>&lt;ns:InputData>&lt;ns:NomeFile>&lt;xsl:value-of select=&quot;$currentRecordOK/NOME_FILE&quot;/>&lt;/ns:NomeFile>&lt;ns:IDFile>&lt;xsl:value-of select=&quot;xsd:integer($currentRecordOK/ID_FILE)&quot;/>&lt;/ns:IDFile>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:SystemName&quot;>&lt;ns:SystemName>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SystemName&quot;/>&lt;/ns:SystemName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:SourceDirectory&quot;>&lt;ns:SourceDirectory>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SourceDirectory&quot;/>&lt;/ns:SourceDirectory>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:TypeOfProtocol&quot;>&lt;ns:TypeOfProtocol>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:TypeOfProtocol&quot;/>&lt;/ns:TypeOfProtocol>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:MaxRowEstraction&quot;>&lt;ns:MaxRowEstraction>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:MaxRowEstraction&quot;/>&lt;/ns:MaxRowEstraction>&lt;/xsl:if>&lt;ns:Flag_ZIP>&lt;xsl:value-of select=&quot;if (( contains($currentRecordOK/NOME_FILE, 'BTS_F') and contains(upper-case($currentRecordOK/NOME_FILE), '.TXT') )&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#x9;$Start/ns:InputData/ns:SystemName = 'GUI'   )&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#x9;$Start/ns:InputData/ns:SystemName = 'UNICAC'   )&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#x9;contains($currentRecordOK/NOME_FILE, 'NOW_ESTRAZIONE_IRIDEOS_'))&amp;#xD;&amp;#xA;    or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#x9;contains($currentRecordOK/NOME_FILE, 'QDR_NOW')&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#x9;contains($currentRecordOK/NOME_FILE, 'NOW_JPUB_BONIFICA_ACCESSI_')&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#x9;contains($currentRecordOK/NOME_FILE, 'NOW_JPUB_BONIFICA_ISTATCOMUNE_')&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#x9;contains($currentRecordOK/NOME_FILE, 'DECOMMISSIONING')&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#x9;contains($currentRecordOK/NOME_FILE, 'NOW_JPUB_DECO_SWITCHOFF')&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#x9;contains($currentRecordOK/NOME_FILE, 'NOW_Bonifica_MA'))&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;($Start/ns:InputData/ns:SystemName = 'RA')&amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;then 'Y' else 'N'&quot;/>&lt;/ns:Flag_ZIP>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:FlagOrdine&quot;>&lt;ns:FlagOrdine>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:FlagOrdine&quot;/>&lt;/ns:FlagOrdine>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$Start/ns:InputData/ns:LogInfo&quot;/>&lt;xsl:copy-of select=&quot;$Start/ns:InputData/ns:SFTP&quot;/>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:TransactionID&quot;>&lt;ns:TransactionID>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:TransactionID&quot;/>&lt;/ns:TransactionID>&lt;/xsl:if>&lt;/ns:InputData>&lt;/ns:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.alignment.shared_library.Estrazioni.Sub_CreazioneFiles" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:empty name="Referente" tibex:xpdlId="88b29ee6-0257-4981-9e93-e778e6e77ba6">
                                    <bpws:targets>
                                    <bpws:target linkName="CreazioneFileToEmpty"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="EmptyToGroupEnd1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyToJDBCUpdate">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($Start/ns0:InputData/ns0:FlagReferente)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($Start/ns0:InputData/ns0:FlagReferente)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="UpdateProcsoFile-input"
                                    name="UpdateProcsoFile"
                                    outputVariable="UpdateProcsoFile"
                                    tibex:xpdlId="707d619a-822b-413a-bda3-0b86cb4ec2af" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToJDBCUpdate"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+707d619a-822b-413a-bda3-0b86cb4ec2af+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentRecordOK&quot;/>&lt;xsl:template name=&quot;UpdateProcsoFile-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;TIMSTP_CHIUSURA_FILE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_CHIUSURA_FILE>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($currentRecordOK/ID_FILE)&quot;/>&lt;/ID_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout_Estrazioni"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE FILE_PROCSTO&#xa;  SET DESCR_STATO_FILE = 'CHIUSO', ESITO ='OK',TIMSTP_CHIUSURA_FILE=?&#xa;  WHERE  ID_FILE = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_CHIUSURA_FILE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:scope name="Iterate2" tibex:group="iterate" tibex:xpdlId="4ad6166e-b6d2-4636-8f1b-e61f9eeb0e96">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToIterate2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Iterate2ToEnd"/>
                </bpws:sources>
                <bpws:sequence name="sequence2" tibex:group="iterate">
                    <bpws:empty name="GroupInit2" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate2"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$GetRecordEstratti/Record[STATUS=('KO','IN CREAZIONE','LOADING')]" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($GetRecordEstratti/Record[STATUS=('KO','IN CREAZIONE','LOADING')])]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope2">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns3:Iterate2_Current_Element_Record"
                                    name="currentKORecord" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow3">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStart2ToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="GroupStart2ToCallProcess1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="CallProcessToGroupEnd2" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogProcedureErrorToGroupEnd2" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart2"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="32756058-9afa-409e-b762-0f8ca2c0a9a7" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart2ToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$currentKORecord/STATUS = 'KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$currentKORecord/STATUS = 'KO']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart2ToCallProcess1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($GetRecordEstratti/Record[STATUS=('KO','IN CREAZIONE','LOADING')])[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentKORecord"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd2"
                                    tibex:group="groupEnd" tibex:xpdlId="1925c7c1-bea9-4d8f-81f7-6bd07624a9f1">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd2"/>
                                    <bpws:target linkName="LogProcedureErrorToGroupEnd2"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogProcedureError-input"
                                    name="LogProcedureError"
                                    tibex:xpdlId="50650329-79d0-41fc-8093-9ac8a2f6d2fa"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart2ToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogProcedureErrorToGroupEnd2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;currentKORecord&quot;/>&lt;xsl:template name=&quot;LogProcedureError-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:TransactionID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:TransactionID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Procedura Estrazione IN KO  per Nome File = ', $currentKORecord/NOME_FILE)&quot;/>&lt;/tns:Message>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogEstrazioneInElab-input"
                                    name="LogEstrazioneInElab"
                                    tibex:xpdlId="f3564132-9b96-47f1-96be-7bff22db1455"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart2ToCallProcess1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;currentKORecord&quot;/>&lt;xsl:template name=&quot;LogEstrazioneInElab-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:TransactionID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:TransactionID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Procedura Estrazione IN ELABORAZIONE  per Nome File = ', $currentKORecord/NOME_FILE)&quot;/>&lt;/tns:Message>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:empty name="Lavorati" tibex:xpdlId="7fd2cd54-1a70-4a04-9901-d42feccac154">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToLavorati"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LavoratiToEnd"/>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogStart-input"
                    name="LogStart"
                    tibex:xpdlId="4e1045b8-b573-4f5c-8cd5-338f7050cfb8"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToGetRecordEstratti"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:TransactionID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:TransactionID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Start batch Ricerca Dati Estrazione  per creazione file consistenza, SISTEMA:  ', $Start/ns:InputData/ns:SystemName)&quot;/>&lt;/tns:Message>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogNORecordFound-input"
                    name="LogNORecordFound"
                    tibex:xpdlId="03896147-e9f7-42eb-b425-e2aef465eaa6"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToLogNORecordFound"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogNORecordFound-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:TransactionID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:TransactionID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Nessuna Procedura Estrazione trovata per il giorno :  ', $Start/ns:InputData/ns:DateEstrazione)&quot;/>&lt;/tns:Message>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="EndLog-input"
                    name="EndLog"
                    tibex:xpdlId="29446857-29fd-447d-bd97-ccfdec40874c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Iterate1ToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;EndLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:TransactionID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:TransactionID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('END Ricerca Dati Estrazione  per creazione file consistenza, SISTEMA:  ', $Start/ns:InputData/ns:SystemName)&quot;/>&lt;/tns:Message>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogGetRecordEstratti-input"
                    name="LogGetRecordEstratti"
                    tibex:xpdlId="3f543d6f-77e1-4ec1-bd96-c37639e9e31f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetRecordEstrattiToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToIterate1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($GetRecordEstratti/Record[STATUS='OK'])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($GetRecordEstratti/Record[STATUS='OK'])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToIterate2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($GetRecordEstratti/Record[STATUS=('KO','IN CREAZIONE','LOADING')])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($GetRecordEstratti/Record[STATUS=('KO','IN CREAZIONE','LOADING')])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToIterate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($GetRecordEstratti/Record[STATUS=('DELETED','KO_DELETED')])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($GetRecordEstratti/Record[STATUS=('DELETED','KO_DELETED')])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToLogNORecordFound">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($GetRecordEstratti/Record)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($GetRecordEstratti/Record)=0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToLavorati">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;GetRecordEstratti&quot;/>&lt;xsl:template name=&quot;LogGetRecordEstratti-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'Main_CreazioneFileConsistenza'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:TransactionID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:TransactionID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($GetRecordEstratti/Record)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Record GetRecordEstratti trovati:',tib:render-xml($GetRecordEstratti,true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;'GetRecordEstratti ecord non trovati'&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
