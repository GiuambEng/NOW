                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($GetRecordEstratti/Record[STATUS='OK'])]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope1">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns3:Iterate1_Current_Element_Record"
                                    name="currentRecordOK" sca-bpel:internal="true"/>
