                <bpws:link name="CallProcessToLogNORecordFound" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToIterate2" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Iterate2ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToLavorati" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LavoratiToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToGetRecordEstratti" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
