                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="4167331f-afbf-449d-a0ec-b4244a1e762d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IterateToEnd"/>
                        <bpws:target linkName="Iterate2ToEnd"/>
                        <bpws:target linkName="LavoratiToEnd"/>
                        <bpws:target linkName="CallProcessToEnd"/>
                        <bpws:target linkName="CallProcessToEnd1"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:root>&#xa;            &lt;xsl:copy-of select=&quot;$Start/ns:InputData&quot;/>&#xa;        &lt;/ns:root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="GetRecordEstratti-input"
                    name="GetRecordEstratti"
                    outputVariable="GetRecordEstratti"
                    tibex:xpdlId="2fc4ae9b-6d3e-408b-ad0d-914cf5c4910c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToGetRecordEstratti"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GetRecordEstrattiToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2fc4ae9b-6d3e-408b-ad0d-914cf5c4910c+input&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;GetRecordEstratti-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;Sistema>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:InputData/ns:SystemName)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SystemName&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Sistema>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout_Estrazioni"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NOME_FILE, STATUS, DESCR_ERRORE, ID_FILE&#xa;FROM STATO_ESTRAZIONI WHERE TRUNC(CREATED)=TRUNC(SYSDATE) AND ID_FILE IN&#xa;(SELECT ID_FILE FROM FILE_PROCSTO WHERE ID_INTRFC IN&#xa;  (SELECT ID_INTRFC FROM INTRFC WHERE COD_INTRFC IN&#xa;  (SELECT substr(COD_INTRFC, 1, 5) FROM CFG_START_ESTRAZIONI WHERE SISTEMA = ?)))" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Sistema"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATUS"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_ERRORE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="69869265-961d-4271-8851-168c502563e0">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToEnd"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="indCreate" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$GetRecordEstratti/Record[STATUS=('DELETED','KO_DELETED')]" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($GetRecordEstratti/Record[STATUS=('DELETED','KO_DELETED')])]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns3:Iterate_Current_Element_Record"
                                    name="currentCreatedFile" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToInvioFile" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="InvioFileToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="JDBCUpdateToInvioFile" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="UpdStatoLoadToCallProcess1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="InvioFileNODHGEToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="473a5a01-1ca5-459f-934c-4ef87af4cbee" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToInvioFile"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($GetRecordEstratti/Record[STATUS=('DELETED','KO_DELETED')])[number($indCreate)]]]></bpws:from>
                                    <bpws:to variable="currentCreatedFile"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="582e37be-8004-4343-907d-10212f304951">
                                    <bpws:targets>
                                    <bpws:target linkName="InvioFileToGroupEnd"/>
                                    <bpws:target linkName="InvioFileNODHGEToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="InvioFile-input"
                                    name="InvioFile"
                                    tibex:xpdlId="5deeb2a3-9fde-4ae6-b6ab-72e242df9211"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateToInvioFile"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InvioFileToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentCreatedFile&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;TipoProtocolloQuadratoriJPUB&quot;/>&lt;xsl:param name=&quot;UNICARADestinationIRIDEOS&quot;/>&lt;xsl:param name=&quot;UNICARADestinationCAB&quot;/>&lt;xsl:template name=&quot;InvioFile-input&quot; match=&quot;/&quot;>&lt;ns:root>&lt;ns:InputData>&lt;ns:NomeFile>&lt;xsl:value-of select=&quot;$currentCreatedFile/NOME_FILE&quot;/>&lt;/ns:NomeFile>&lt;ns:IDFile>&lt;xsl:value-of select=&quot;xsd:integer($currentCreatedFile/ID_FILE)&quot;/>&lt;/ns:IDFile>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:SystemName&quot;>&lt;ns:SystemName>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SystemName&quot;/>&lt;/ns:SystemName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:SourceDirectory&quot;>&lt;ns:SourceDirectory>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SourceDirectory&quot;/>&lt;/ns:SourceDirectory>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:InputData/ns:SystemName = 'UNICARA' and starts-with($currentCreatedFile/NOME_FILE, 'NOW_ESTRAZIONE_IRIDEOS_')&quot;>&lt;ns:DestinationDirectory>&lt;xsl:value-of select=&quot;$UNICARADestinationIRIDEOS&quot;/>&lt;/ns:DestinationDirectory>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns:InputData/ns:SystemName = 'UNICARA' and starts-with($currentCreatedFile/NOME_FILE, 'NOW_ESTRAZIONE_CONSISTENZA_CAB_')&quot;>&lt;ns:DestinationDirectory>&lt;xsl:value-of select=&quot;$UNICARADestinationCAB&quot;/>&lt;/ns:DestinationDirectory>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns:InputData/ns:SystemName = 'RA' and starts-with($currentCreatedFile/NOME_FILE, 'NOW_NGAVULA')&quot;>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:DestinationDirectoryRA_NGAVULA&quot;>&lt;ns:DestinationDirectory>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:DestinationDirectoryRA_NGAVULA&quot;/>&lt;/ns:DestinationDirectory>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns:InputData/ns:SystemName = 'RA' and starts-with($currentCreatedFile/NOME_FILE, 'NOW_xDSL')&quot;>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:DestinationDirectoryRA_XDSL&quot;>&lt;ns:DestinationDirectory>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:DestinationDirectoryRA_XDSL&quot;/>&lt;/ns:DestinationDirectory>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns:InputData/ns:SystemName = 'RA' and starts-with($currentCreatedFile/NOME_FILE, 'NOW_REGOLATORIO')&quot;>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:DestinationDirectoryRA_REG&quot;>&lt;ns:DestinationDirectory>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:DestinationDirectoryRA_REG&quot;/>&lt;/ns:DestinationDirectory>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns:InputData/ns:SystemName = 'RA' and starts-with($currentCreatedFile/NOME_FILE, 'NOTIFICHE_NOW')&quot;>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:DestinationDirectoryNOTF&quot;>&lt;ns:DestinationDirectory>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:DestinationDirectoryNOTF&quot;/>&lt;/ns:DestinationDirectory>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:DestinationDirectory&quot;>&lt;ns:DestinationDirectory>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:DestinationDirectory&quot;/>&lt;/ns:DestinationDirectory>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($currentCreatedFile/NOME_FILE, 'NOW_ESTRAZIONE_IRIDEOS_') &amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;($Start/ns:InputData/ns:SystemName='JPUB' &amp;#xD;&amp;#xA;and &amp;#xD;&amp;#xA;(starts-with($currentCreatedFile/NOME_FILE, 'BONIFICA_WLR_ISDNMULTINUMERO') &amp;#xD;&amp;#xA;or starts-with($currentCreatedFile/NOME_FILE, 'NOW_JPUB_WILL_PENALI') &amp;#xD;&amp;#xA;or starts-with($currentCreatedFile/NOME_FILE, 'NOW_JPUB_WILL_CONTRIBUTO_CESSAZIONE')))&quot;>&lt;ns:TypeOfProtocol>&lt;xsl:value-of select=&quot;'SFTP'&quot;/>&lt;/ns:TypeOfProtocol>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($currentCreatedFile/NOME_FILE, 'QDR_NOW_')&quot;>&lt;ns:TypeOfProtocol>&lt;xsl:value-of select=&quot;$TipoProtocolloQuadratoriJPUB&quot;/>&lt;/ns:TypeOfProtocol>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:TypeOfProtocol&quot;>&lt;ns:TypeOfProtocol>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:TypeOfProtocol&quot;/>&lt;/ns:TypeOfProtocol>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:Flag_TAPPO>&lt;xsl:value-of select=&quot;if ((contains($currentCreatedFile/NOME_FILE, 'BTS_F') &amp;#xD;&amp;#xA;&amp;#x9;and (contains($currentCreatedFile/NOME_FILE, '.TXT') &amp;#xD;&amp;#xA;or contains($currentCreatedFile/NOME_FILE, '.txt'))) &amp;#xD;&amp;#xA;or contains($currentCreatedFile/NOME_FILE, '_NOW.csv') &amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;$Start/ns:InputData/ns:SystemName=('INCONTRA','RAC','FRMSFRAUD','SAP','RA') &amp;#xD;&amp;#xA;or starts-with($currentCreatedFile/NOME_FILE, 'NOW_ESTRAZIONE_IRIDEOS_')&amp;#xD;&amp;#xA;or starts-with($currentCreatedFile/NOME_FILE, 'NOW_JPUB_WILL_CONTRIBUTO_CESSAZIONE') &amp;#xD;&amp;#xA;or starts-with($currentCreatedFile/NOME_FILE, 'NOW_ESTRAZIONE_CONSISTENZA_CAB_')) then 'Y' else 'N'&quot;/>&lt;/ns:Flag_TAPPO>&lt;xsl:copy-of select=&quot;$Start/ns:InputData/ns:LogInfo&quot;/>&lt;xsl:copy-of select=&quot;$Start/ns:InputData/ns:SFTP&quot;/>&lt;/ns:InputData>&lt;/ns:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.alignment.shared_library.Estrazioni.Sub_InvioFiles" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
