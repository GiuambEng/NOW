            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogExternalCommand-input"
                    name="LogExternalCommand"
                    tibex:xpdlId="285e9626-9d9e-4d34-8b22-eada01194b98"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ExternalCommandToCallProcess"/>
                        <bpws:target linkName="Empty2ToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogExternalCommandToCopy_1_UpdInfoFileRA">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogExternalCommandToSpostaFile_CONSISTENZECAB">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_ESTRAZIONE_CONSISTENZA_CAB_')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_ESTRAZIONE_CONSISTENZA_CAB_')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_ExternalCommand&quot;/>&#xa;    &lt;xsl:param name=&quot;ExternalCommand&quot;/>&#xa;    &lt;xsl:template name=&quot;LogExternalCommand-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&#xa;                    &lt;tns3:Application>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&#xa;                    &lt;/tns3:Application>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Sub_CreazioneFiles'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($_error_ExternalCommand)&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('***KO OUTPUT CHIAMATA ALLA SHELL: ', tib:render-xml($_error_ExternalCommand))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('OUTPUT CHIAMATA ALLA SHELL: return code ',string($ExternalCommand/returnCode))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&#xa;                    &lt;tns3:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&#xa;                    &lt;/tns3:LoggerName>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&#xa;                    &lt;tns3:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&#xa;                    &lt;/tns3:LogLevel>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogSSH-input"
                    name="LogSSH"
                    tibex:xpdlId="db13ca98-6530-4398-8df6-9b4696962088"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SSHCommandToCallProcess"/>
                        <bpws:target linkName="Empty3ToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogSSHToInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogSSHToUpInfoFileRASSH">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:InputData/ns0:SystemName = 'JPUB' and (contains($Start/ns0:InputData/ns0:NomeFile, 'QDR_NOW_') or contains($Start/ns0:InputData/ns0:NomeFile, 'DECOMMISSIONING') or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_Bonifica_MA'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
