pdateActivityInput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/ns:InputData/ns:Flag_ZIP='Y' and not(contains($Start/ns:InputData/ns:NomeFile, 'QDR_NOW_'))&quot;>&#xa;                &lt;tns3:jdbcUpdateActivityInput>&#xa;                    &lt;PathFile>&#xa;                        &lt;xsl:value-of select=&quot;concat($PathRA,'.gz')&quot;/>&#xa;                    &lt;/PathFile>&#xa;                    &lt;NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:NomeFile,'.gz')&quot;/>&#xa;                    &lt;/NOME_FILE>&#xa;                    &lt;IDFILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&#xa;                    &lt;/IDFILE>&#xa;                &lt;/tns3:jdbcUpdateActivityInput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, 'QDR_NOW_')&quot;>&#xa;                &lt;tns3:jdbcUpdateActivityInput>&#xa;                    &lt;PathFile>&#xa;                        &lt;xsl:value-of select=&quot;$PathJPUB&quot;/>&#xa;                    &lt;/PathFile>&#xa;                    &lt;NOME_FILE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/ns:InputData/ns:NomeFile)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:NomeFile&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/NOME_FILE>&#xa;                    &lt;IDFILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&#xa;                    &lt;/IDFILE>&#xa;                &lt;/tns3:jdbcUpdateActivityInput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns3:jdbcUpdateActivityInput>&#xa;                    &lt;PathFile>&#xa;                        &lt;xsl:value-of select=&quot;$PathRA&quot;/>&#xa;                    &lt;/PathFile>&#xa;                    &lt;NOME_FILE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/ns:InputData/ns:NomeFile)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:NomeFile&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/NOME_FILE>&#xa;                    &lt;IDFILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&#xa;                    &lt;/IDFILE>&#xa;                &lt;/tns3:jdbcUpdateActivityInput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
