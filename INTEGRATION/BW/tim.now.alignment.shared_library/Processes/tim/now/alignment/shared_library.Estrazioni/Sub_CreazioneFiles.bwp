                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="SelectIDASSET-input"
                                    name="SelectIDASSET"
                                    outputVariable="SelectIDASSET"
                                    tibex:xpdlId="a29c543e-9576-4c3e-9468-49afbc4b72f2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToMIG_OLO_ASSET_OUTPUT_FILE"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery1ToMIG_OLO_ASSET_OUTPUT_FILE">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="count($SelectIDASSET/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($SelectIDASSET/Record)>0]]></bpws:transitionCondition>
