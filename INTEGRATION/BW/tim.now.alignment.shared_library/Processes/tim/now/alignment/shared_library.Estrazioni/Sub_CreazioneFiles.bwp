                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ShellCommand&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Host_SSH&quot;/>&#xa;    &lt;xsl:param name=&quot;User_SSH&quot;/>&#xa;    &lt;xsl:param name=&quot;Port_SSH&quot;/>&#xa;    &lt;xsl:param name=&quot;Password_SSH&quot;/>&#xa;    &lt;xsl:param name=&quot;CommandShell&quot;/>&#xa;    &lt;xsl:template name=&quot;SSHCommand-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Input_ShellCommand>&#xa;            &lt;tns3:Host>&#xa;                &lt;xsl:value-of select=&quot;$Host_SSH&quot;/>&#xa;            &lt;/tns3:Host>&#xa;            &lt;tns3:User>&#xa;                &lt;xsl:value-of select=&quot;$User_SSH&quot;/>&#xa;            &lt;/tns3:User>&#xa;            &lt;tns3:Password>&#xa;                &lt;xsl:value-of select=&quot;$Password_SSH&quot;/>&#xa;            &lt;/tns3:Password>&#xa;            &lt;tns3:Port>&#xa;                &lt;xsl:value-of select=&quot;$Port_SSH&quot;/>&#xa;            &lt;/tns3:Port>&#xa;            &lt;tns3:Command>&#xa;                &lt;xsl:value-of select=&quot;$CommandShell&quot;/>&#xa;            &lt;/tns3:Command>&#xa;        &lt;/tns3:Input_ShellCommand>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
