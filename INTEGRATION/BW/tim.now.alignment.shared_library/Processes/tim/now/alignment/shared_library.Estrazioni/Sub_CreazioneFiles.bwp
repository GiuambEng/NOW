                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="CommandShell"
                    name="Assign1" outputVariable="CommandShell"
                    tibex:xpdlId="6f36a3dc-1c23-417a-a9dc-d9211d35e813" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
