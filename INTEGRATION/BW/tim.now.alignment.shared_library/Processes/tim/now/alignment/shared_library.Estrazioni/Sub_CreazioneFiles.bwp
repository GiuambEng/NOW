                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogNoInsert-input"
                                    name="LogNoInsert"
                                    tibex:xpdlId="632344d2-bcc6-4678-8d46-e6f9b0d234d2"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SelectIDRICHOLOToGenericLogger"/>
                                    <bpws:target linkName="SelectIDASSETToGenericLogger"/>
                                    <bpws:target linkName="Empty3ToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLoggerToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;indexRecord&quot;/>&#xa;    &lt;xsl:param name=&quot;FindDataNoHeader&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectIDRICHOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;LogNoInsert-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&#xa;                    &lt;tns3:Application>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&#xa;                    &lt;/tns3:Application>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Sub_CreazioneFiles'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;not(substring-before($FindDataNoHeader/Record[$indexRecord]/RIGA, '|#')!='IDRISORSA' and $FindDataNoHeader/Record[$indexRecord]/RIGA!='EOF')&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('SubsetIndex: ',string($index),' - indexRecord: ', string($indexRecord),' Riga di testa o di coda')&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;not(count($SelectIDRICHOLO/Record)>0 and string-length($SelectIDRICHOLO/Record[1]/ID_RICH_OLO_GENERATA)>0)&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('SubsetIndex: ',string($index),' - indexRecord: ', string($indexRecord),' ID RICH OLO GENERATA non trovata su MIG OLO ASSET')&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('SubsetIndex: ',string($index),' - indexRecord: ', string($indexRecord),' Non trovato Asset')&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$FindDataNoHeader/Record[$indexRecord]/RIGA&quot;>&#xa;                    &lt;tns3:Payload>&#xa;                        &lt;xsl:value-of select=&quot;$FindDataNoHeader/Record[$indexRecord]/RIGA&quot;/>&#xa;                    &lt;/tns3:Payload>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&#xa;                    &lt;tns3:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&#xa;                    &lt;/tns3:LoggerName>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&#xa;                    &lt;tns3:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&#xa;                    &lt;/tns3:LogLevel>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>

                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                    </bpws:scope>
                                    </bpws:forEach>
                                </bpws:sequence>
                            </bpws:scope>
                        </bpws:flow>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[ $FindDataNoHeader/lastSubset=true()]]></bpws:condition>
                    </bpws:repeatUntil>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UpdStatoAndInfoFile-input"
                    name="UpdStatoAndInfoFile"
                    outputVariable="UpdStatoAndInfoFile"
                    tibex:xpdlId="c7b2be1c-7fbb-4943-91b8-5412740e6c7c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Up_CfgStart_LastUpdToUpdStatoAndInfoFile"/>
                        <bpws:target linkName="LogCreateOKToUpdStatoAndInfoFile"/>
                        <bpws:target linkName="SpostaFileNPAggToUpdStatoAndInfoFile"/>
                        <bpws:target linkName="SpostaFileTappoToUpdStatoAndInfoFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdStatoCreatoToUpdFileProcso"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c7b2be1c-7fbb-4943-91b8-5412740e6c7c+input&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFileZipped&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFile&quot;/>&#xa;    &lt;xsl:param name=&quot;DataFile&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateEmptyFile&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFileEmptyCompressed&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdStatoAndInfoFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$DataFile='NO DATA' and string-length($WriteFileEmptyCompressed/fileInfo/fileName)>0&quot;>&#xa;                &lt;tns3:jdbcUpdateActivityInput>&#xa;                    &lt;PathFile>&#xa;                        &lt;xsl:value-of select=&quot;$WriteFileEmptyCompressed/fileInfo/fullName&quot;/>&#xa;                    &lt;/PathFile>&#xa;                    &lt;NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$WriteFileEmptyCompressed/fileInfo/fileName&quot;/>&#xa;                    &lt;/NOME_FILE>&#xa;                    &lt;IDFILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&#xa;                    &lt;/IDFILE>&#xa;                &lt;/tns3:jdbcUpdateActivityInput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$DataFile='NO DATA' and string-length($CreateEmptyFile/fileInfo/fileName)>0&quot;>&#xa;                &lt;tns3:jdbcUpdateActivityInput>&#xa;                    &lt;PathFile>&#xa;                        &lt;xsl:value-of select=&quot;$CreateEmptyFile/fileInfo/fullName&quot;/>&#xa;                    &lt;/PathFile>&#xa;                    &lt;NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$CreateEmptyFile/fileInfo/fileName&quot;/>&#xa;                    &lt;/NOME_FILE>&#xa;                    &lt;IDFILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&#xa;                    &lt;/IDFILE>&#xa;                &lt;/tns3:jdbcUpdateActivityInput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length($WriteFileZipped/fileInfo/fileName)>0 and $Start/ns:InputData/ns:Flag_ZIP='Y'&quot;>&#xa;                &lt;tns3:jdbcUpdateActivityInput>&#xa;                    &lt;PathFile>&#xa;                        &lt;xsl:value-of select=&quot;$WriteFileZipped/fileInfo/fullName&quot;/>&#xa;                    &lt;/PathFile>&#xa;                    &lt;NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$WriteFileZipped/fileInfo/fileName&quot;/>&#xa;                    &lt;/NOME_FILE>&#xa;                    &lt;IDFILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&#xa;                    &lt;/IDFILE>&#xa;                &lt;/tns3:jdbcUpdateActivityInput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns3:jdbcUpdateActivityInput>&#xa;                    &lt;PathFile>&#xa;                        &lt;xsl:value-of select=&quot;$WriteFile/fileInfo/fullName&quot;/>&#xa;                    &lt;/PathFile>&#xa;                    &lt;NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$WriteFile/fileInfo/fileName&quot;/>&#xa;                    &lt;/NOME_FILE>&#xa;                    &lt;IDFILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&#xa;                    &lt;/IDFILE>&#xa;                &lt;/tns3:jdbcUpdateActivityInput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout_Estrazioni"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE STATO_ESTRAZIONI&#xd;&#xa;  SET STATUS = 'CREATED', PATH_FILE=?, NOME_FILE=?&#xd;&#xa;  WHERE  ID_FILE=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PathFile"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_FILE"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="IDFILE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UpdFileProcso-input"
                    name="UpdFileProcso" outputVariable="UpdFileProcso"
                    tibex:xpdlId="865c73f4-1bfb-42f9-91eb-ec95d96ef679" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdStatoCreatoToUpdFileProcso"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdate1ToInvoke">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+865c73f4-1bfb-42f9-91eb-ec95d96ef679+input&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileSize&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;CountRows&quot;/>&#xa;    &lt;xsl:param name=&quot;DataFile&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdFileProcso-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$DataFile='NO DATA'&quot;>&#xa;                    &lt;DIMENSIONE>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/DIMENSIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DIMENSIONE>&#xa;                        &lt;xsl:value-of select=&quot;$FileSize&quot;/>&#xa;                    &lt;/DIMENSIONE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$DataFile='NO DATA'&quot;>&#xa;                    &lt;RECORD_TOT>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/RECORD_TOT>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;RECORD_TOT>&#xa;                        &lt;xsl:value-of select=&quot;$CountRows&quot;/>&#xa;                    &lt;/RECORD_TOT>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/ns:InputData/ns:IDFile)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:IDFile&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_FILE>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout_Estrazioni"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE FILE_PROCSTO_OUTPUT SET DIMENSIONE_FILE=?, QT_RECD_TOTALI=?&#xa;WHERE ID_FILE_PROCSTO_OUTPUT=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="DIMENSIONE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="RECORD_TOT"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="LogFileProcso-input"
                name="LogFileProcso" operation="Insert"
                outputVariable="LogFileProcso" partnerLink="Logger"
                portType="ns5:ProcessLog" tibex:xpdlId="43fdd2c2-3a8f-4579-b919-9b9f5c7d4df1">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns="www.tim.now.alignment.sharedlibrary.DataEstrazioni" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:template name="LogFileProcso-input" match="/"&gt;
        &lt;tns3:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns2:Input&gt;
                    &lt;ns2:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="'FILE'"/&gt;
                    &lt;/ns2:TipologiaProcesso&gt;
                    &lt;ns2:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="'LOG'"/&gt;
                    &lt;/ns2:TipologiaOperazione&gt;
                    &lt;ns2:LogFileProcessato&gt;
                        &lt;xsl:if test="$Start/ns:InputData/ns:IDFile"&gt;
                            &lt;ns2:ID_FILE&gt;
                                &lt;xsl:value-of select="$Start/ns:InputData/ns:IDFile"/&gt;
                            &lt;/ns2:ID_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;ns2:LOG_LEVEL&gt;
                            &lt;xsl:value-of select="'INFO'"/&gt;
                        &lt;/ns2:LOG_LEVEL&gt;
                        &lt;ns2:LOG_MESSAGE&gt;
                            &lt;xsl:value-of select="&amp;quot;CREATO FILE OUTPUT DA INVIARE&amp;quot;"/&gt;
                        &lt;/ns2:LOG_MESSAGE&gt;
                        &lt;ns2:TIMSTP_INSMTO&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns2:TIMSTP_INSMTO&gt;
                    &lt;/ns2:LogFileProcessato&gt;
                &lt;/ns2:Input&gt;
            &lt;/part1&gt;
        &lt;/tns3:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFileProcso-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:Input>&#xa;            &lt;ns2:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;'FILE'&quot;/>&#xa;            &lt;/ns2:TipologiaProcesso>&#xa;            &lt;ns2:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;'LOG'&quot;/>&#xa;            &lt;/ns2:TipologiaOperazione>&#xa;            &lt;ns2:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:IDFile&quot;>&#xa;                    &lt;ns2:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:IDFile&quot;/>&#xa;                    &lt;/ns2:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns2:LOG_LEVEL>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/ns2:LOG_LEVEL>&#xa;                &lt;ns2:LOG_MESSAGE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CREATO FILE OUTPUT DA INVIARE&amp;quot;&quot;/>&#xa;                &lt;/ns2:LOG_MESSAGE>&#xa;                &lt;ns2:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns2:TIMSTP_INSMTO>&#xa;            &lt;/ns2:LogFileProcessato>&#xa;        &lt;/ns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="JDBCUpdate1ToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LogFileProcsoToJDBCCallProcedure">
                        <tibex:DesignExpression/>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogStart-input"
                    name="LogStart"
