                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns="www.tim.now.alignment.sharedlibrary.DataEstrazioni" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="GetID_ESEC"/&gt;
    &lt;xsl:template name="Invoke-input" match="/"&gt;
        &lt;tns3:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns2:Input&gt;
                    &lt;ns2:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;
                    &lt;/ns2:TipologiaProcesso&gt;
                    &lt;ns2:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;LOG&amp;quot;"/&gt;
                    &lt;/ns2:TipologiaOperazione&gt;
                    &lt;ns2:LogFileProcessato&gt;
                        &lt;ns2:ID_ESEC_PROCSO&gt;
                            &lt;xsl:value-of select="xsd:integer($GetID_ESEC/Record[1]/ID_ESEC_PROCSO_FILE)"/&gt;
                        &lt;/ns2:ID_ESEC_PROCSO&gt;
                        &lt;xsl:if test="$Start/ns:InputData/ns:IDFile"&gt;
                            &lt;ns2:ID_FILE&gt;
                                &lt;xsl:value-of select="$Start/ns:InputData/ns:IDFile"/&gt;
                            &lt;/ns2:ID_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;ns2:LOG_LEVEL&gt;
                            &lt;xsl:value-of select="'ERROR'"/&gt;
                        &lt;/ns2:LOG_LEVEL&gt;
                        &lt;ns2:LOG_MESSAGE&gt;
                            &lt;xsl:value-of select="&amp;quot;FINE LAVORAZIONE FILE OUTPUT PER INVIO FALLITO&amp;quot;"/&gt;
                        &lt;/ns2:LOG_MESSAGE&gt;
                        &lt;ns2:TIMSTP_INSMTO&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns2:TIMSTP_INSMTO&gt;
                    &lt;/ns2:LogFileProcessato&gt;
                &lt;/ns2:Input&gt;
            &lt;/part1&gt;
        &lt;/tns3:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
