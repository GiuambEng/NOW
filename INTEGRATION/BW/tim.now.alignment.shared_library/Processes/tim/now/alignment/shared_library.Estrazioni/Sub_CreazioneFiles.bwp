                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://tns.tibco.com/bw/activity/externalcommand/xsd/input&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;PathRoot&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;PathRootUnica&quot;/>&#xa;    &lt;xsl:param name=&quot;PathRootJpub&quot;/>&#xa;    &lt;xsl:param name=&quot;CommandShell&quot;/>&#xa;    &lt;xsl:template name=&quot;ExternalCommand-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CmdInput>&#xa;            &lt;command>&#xa;                &lt;xsl:value-of select=&quot;$CommandShell&quot;/>&#xa;            &lt;/command>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, 'NOW_ESTRAZIONE_CONSISTENZA_CAB_')&quot;>&#xa;                    &lt;workingDirectory>&#xa;                        &lt;xsl:value-of select=&quot;$PathRootUnica&quot;/>&#xa;                    &lt;/workingDirectory>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/ns:InputData/ns:SystemName='JPUB'&quot;>&#xa;                    &lt;workingDirectory>&#xa;                        &lt;xsl:value-of select=&quot;concat($PathRootJpub,'/Sh/')&quot;/>&#xa;                    &lt;/workingDirectory>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;workingDirectory>&#xa;                        &lt;xsl:value-of select=&quot;$PathRoot&quot;/>&#xa;                    &lt;/workingDirectory>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:CmdInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
