                    <bpws:sources>
                        <bpws:source linkName="LogCreateOKToUp_CfgStart_LastUpd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="((contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_NGAVULA_') or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_xDSL_') or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_REGOLATORIO')) and ($Start/ns0:InputData/ns0:SystemName='RA')) or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_ESTRAZIONE_IRIDEOS_')&#xd;&#xa;or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_INCONTRA_CPS_')&#xd;&#xa;or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_FRMSFRAUD_CPS_') or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_WILL_CONTRIBUTO_CESSAZIONE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[((contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_NGAVULA_') or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_xDSL_') or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_REGOLATORIO')) and ($Start/ns0:InputData/ns0:SystemName='RA')) or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_ESTRAZIONE_IRIDEOS_')
or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_INCONTRA_CPS_')
or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_FRMSFRAUD_CPS_') or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_WILL_CONTRIBUTO_CESSAZIONE')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogCreateOKToUpdStatoAndInfoFile">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogCreateOKToCallProcess_Name">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($Start/ns0:InputData/ns0:NomeFile, 'JPUB_NPAGG_') or starts-with($Start/ns0:InputData/ns0:NomeFile, 'JPUB_NOW_CAMBIOTECNOLOGIA') or starts-with($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_BONIFICA_ISTATCOMUNE_') or starts-with($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_BONIFICA_ACCESSI_')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($Start/ns0:InputData/ns0:NomeFile, 'JPUB_NPAGG_') or starts-with($Start/ns0:InputData/ns0:NomeFile, 'JPUB_NOW_CAMBIOTECNOLOGIA') or starts-with($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_BONIFICA_ISTATCOMUNE_') or starts-with($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_BONIFICA_ACCESSI_')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Path&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&#xa;                    &lt;tns3:Application>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&#xa;                    &lt;/tns3:Application>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Sub_CreazioneFiles'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;File correttamente creato e scrito al path &amp;quot;,$Path)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&#xa;                    &lt;tns3:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&#xa;                    &lt;/tns3:LoggerName>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&#xa;                    &lt;tns3:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&#xa;                    &lt;/tns3:LogLevel>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogEnd-input"
