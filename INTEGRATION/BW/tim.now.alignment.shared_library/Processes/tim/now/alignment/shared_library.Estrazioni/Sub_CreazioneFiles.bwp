                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if ($Start/ns0:InputData/ns0:SystemName='JPUB' and (contains($Start/ns0:InputData/ns0:NomeFile, 'DECOMMISSIONING') or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_DECO_SWITCHOFF'))) then concat(&quot;export PATH_ROOT=&quot;, $PathRootJpub, &quot;; cd &quot;, $PathRootJpub, &quot;/Sh/; ./lancio_estr_JPUB_INV.ksh&quot;, &quot; &quot;, string($Start/ns0:InputData/ns0:IDFile), &quot; &quot;, $PathJPUB, &quot; &quot;, $Start/ns0:InputData/ns0:Flag_ZIP, &quot;  > /dev/null 2>&amp;1 &amp;&quot;)&#xd;&#xa;else if ($Start/ns0:InputData/ns0:SystemName='JPUB' and (contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_Bonifica_MA'))) then concat(&quot;export PATH_ROOT=&quot;, $PathRootJpub, &quot;; cd &quot;, $PathRootJpub, &quot;/Sh/; ./lancio_estr_JPUB_MCRAREA.ksh&quot;, &quot; &quot;, string($Start/ns0:InputData/ns0:IDFile), &quot; &quot;, $PathJPUB, &quot; &quot;, $Start/ns0:InputData/ns0:Flag_ZIP, &quot;  > /dev/null 2>&amp;1 &amp;&quot;)&#xd;&#xa;else if (contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_ESTRAZIONE_CONSISTENZA_CAB_')) then concat(&quot;export PATH_ROOT=&quot;, $PathRootUnica, &quot;; cd &quot;, $PathRootUnica, &quot;/Sh/; ./start_estrazioni.sh&quot;, &quot; &quot;, string($Start/ns0:InputData/ns0:IDFile), &quot; &quot;, $PathUNICA, &quot; &quot;, $Start/ns0:InputData/ns0:Flag_ZIP, &quot;  > /dev/null 2>&amp;1 &amp;&quot;)&#xd;&#xa;else if ($Start/ns0:InputData/ns0:SystemName='JPUB' and not(contains($Start/ns0:InputData/ns0:NomeFile, 'DECOMMISSIONING'))) then concat(&quot;export PATH_ROOT=&quot;, $PathRootJpub, &quot;; cd &quot;, $PathRootJpub, &quot;/Sh/; ./lancio_estr_quadra_jpub.ksh&quot;, &quot; &quot;, string($Start/ns0:InputData/ns0:IDFile), &quot; &quot;, $PathJPUB, &quot; &quot;, $Start/ns0:InputData/ns0:Flag_ZIP, &quot;  > /dev/null 2>&amp;1 &amp;&quot;)&#xd;&#xa;else concat(&quot;export PATH_ROOT=&quot;, $PathRoot, &quot;; cd &quot;, $PathRoot, &quot;/Sh/; ./start_estrazioni.sh&quot;, &quot; &quot;, string($Start/ns0:InputData/ns0:IDFile), &quot; &quot;, $PathRA, &quot; &quot;, $Start/ns0:InputData/ns0:Flag_ZIP, &quot;  > /dev/null 2>&amp;1 &amp;&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
