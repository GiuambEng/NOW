            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="SpostaFileNPAgg-input"
                    name="SpostaFileNPAgg"
                    outputVariable="SpostaFileNPAgg"
                    tibex:xpdlId="619810b1-0b49-4091-ae97-3ba49c488db7"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogCreateOKToCallProcess_Name"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SpostaFileNPAggToUpdStatoAndInfoFile"/>
                        <bpws:source linkName="SpostaFileNPAggToSpostaFileTappo">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($Start/ns0:InputData/ns0:NomeFile, 'JPUB_NOW_CAMBIOTECNOLOGIA') or starts-with($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_BONIFICA_ISTATCOMUNE_') or starts-with($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_BONIFICA_ACCESSI_')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($Start/ns0:InputData/ns0:NomeFile, 'JPUB_NOW_CAMBIOTECNOLOGIA') or starts-with($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_BONIFICA_ISTATCOMUNE_') or starts-with($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_BONIFICA_ACCESSI_')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Path&quot;/>&#xa;    &lt;xsl:param name=&quot;PathRoot&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;PathDestinazioneJPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;PathDestinazioneJPUBBonificaIstatComune&quot;/>&#xa;    &lt;xsl:param name=&quot;PathDestinazioneJPUBBonificaAccessiPregressi&quot;/>&#xa;    &lt;xsl:param name=&quot;PathDestinazioneJPUBBonificaAccessiOL&quot;/>&#xa;    &lt;xsl:template name=&quot;SpostaFileNPAgg-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:SFTP_Put_Input>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($Start/ns:InputData/ns:NomeFile, 'NOW_JPUB_BONIFICA_ISTATCOMUNE_') or starts-with($Start/ns:InputData/ns:NomeFile, 'NOW_JPUB_BONIFICA_ACCESSI_')&quot;>&#xa;                    &lt;tns3:FileToBeSend>&#xa;                        &lt;xsl:value-of select=&quot;concat($Path,'.gz')&quot;/>&#xa;                    &lt;/tns3:FileToBeSend>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:FileToBeSend>&#xa;                        &lt;xsl:value-of select=&quot;$Path&quot;/>&#xa;                    &lt;/tns3:FileToBeSend>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($Start/ns:InputData/ns:NomeFile, 'JPUB_NOW_CAMBIOTECNOLOGIA')&quot;>&#xa;                    &lt;tns3:RomoteDirectory>&#xa;                        &lt;xsl:value-of select=&quot;concat($PathDestinazioneJPUB,$Start/ns:InputData/ns:NomeFile)&quot;/>&#xa;                    &lt;/tns3:RomoteDirectory>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;starts-with($Start/ns:InputData/ns:NomeFile, 'NOW_JPUB_BONIFICA_ISTATCOMUNE_')&quot;>&#xa;                    &lt;tns3:RomoteDirectory>&#xa;                        &lt;xsl:value-of select=&quot;concat($PathDestinazioneJPUBBonificaIstatComune, $Start/ns:InputData/ns:NomeFile, &amp;quot;.gz&amp;quot;)&quot;/>&#xa;                    &lt;/tns3:RomoteDirectory>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;starts-with($Start/ns:InputData/ns:NomeFile, 'NOW_JPUB_BONIFICA_ACCESSI_PREGRESSO_')&quot;>&#xa;                    &lt;tns3:RomoteDirectory>&#xa;                        &lt;xsl:value-of select=&quot;concat($PathDestinazioneJPUBBonificaAccessiPregressi, $Start/ns:InputData/ns:NomeFile, &amp;quot;.gz&amp;quot;)&quot;/>&#xa;                    &lt;/tns3:RomoteDirectory>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;starts-with($Start/ns:InputData/ns:NomeFile, 'NOW_JPUB_BONIFICA_ACCESSI_')&quot;>&#xa;                    &lt;tns3:RomoteDirectory>&#xa;                        &lt;xsl:value-of select=&quot;concat($PathDestinazioneJPUBBonificaAccessiOL, $Start/ns:InputData/ns:NomeFile, &amp;quot;.gz&amp;quot;)&quot;/>&#xa;                    &lt;/tns3:RomoteDirectory>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:RomoteDirectory>&#xa;                        &lt;xsl:value-of select=&quot;concat($PathRoot,$Start/ns:InputData/ns:NomeFile)&quot;/>&#xa;                    &lt;/tns3:RomoteDirectory>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns3:Credentials>&#xa;                &lt;tns3:Host>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:HOST&quot;/>&#xa;                &lt;/tns3:Host>&#xa;                &lt;tns3:Port>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:PORT&quot;/>&#xa;                &lt;/tns3:Port>&#xa;                &lt;tns3:User>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:USERNAME&quot;/>&#xa;                &lt;/tns3:User>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:SFTP/ns:PASSOWRD&quot;>&#xa;                    &lt;tns3:Password>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:PASSOWRD&quot;/>&#xa;                    &lt;/tns3:Password>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:Credentials>&#xa;        &lt;/tns3:SFTP_Put_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="SFTP.SFTP_Put_New" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="WriteTappo-input" name="WriteTappo"
                    outputVariable="WriteTappo"
                    tibex:xpdlId="21362895-3b2d-4315-b082-4a021c64aa2e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
