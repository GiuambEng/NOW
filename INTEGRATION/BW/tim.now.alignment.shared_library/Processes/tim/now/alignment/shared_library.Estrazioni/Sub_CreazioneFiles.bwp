                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="WriteFile1ToFileSize"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Path&quot;/>&#xa;    &lt;xsl:template name=&quot;WriteTappo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:WriteActivityInputTextClass>&#xa;            &lt;fileName>&#xa;                &lt;xsl:value-of select=&quot;concat(substring-before($Path, '.csv'),'.ctr')&quot;/>&#xa;            &lt;/fileName>&#xa;            &lt;textContent>&#xa;                &lt;xsl:value-of select=&quot;' '&quot;/>&#xa;            &lt;/textContent>&#xa;        &lt;/tns3:WriteActivityInputTextClass>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.write"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//WriteFile"/>
                                    <value compressFile="None"
                                    createMissingDirectories="true"
                                    encoding="text" xsi:type="file:WriteFile"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="SpostaFileTappo-input"
                    name="SpostaFileTappo"
                    outputVariable="SpostaFileTappo"
                    tibex:xpdlId="e7858442-74bc-47ee-b233-3a352c3a5a09"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SpostaFileNPAggToSpostaFileTappo"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SpostaFileTappoToUpdStatoAndInfoFile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Path&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;PathDestinazioneJPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;PathDestinazioneJPUBBonificaIstatComune&quot;/>&#xa;    &lt;xsl:param name=&quot;PathDestinazioneJPUBBonificaAccessiPregressi&quot;/>&#xa;    &lt;xsl:param name=&quot;PathDestinazioneJPUBBonificaAccessiOL&quot;/>&#xa;    &lt;xsl:template name=&quot;SpostaFileTappo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:SFTP_Put_Input>&#xa;            &lt;xsl:variable name=&quot;NomeFileTappo&quot; select=&quot;concat(substring-before($Start/ns:InputData/ns:NomeFile, '.csv'),'.ctr')&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($Start/ns:InputData/ns:NomeFile, 'NOW_JPUB_BONIFICA_ISTATCOMUNE_') or starts-with($Start/ns:InputData/ns:NomeFile, 'NOW_JPUB_BONIFICA_ACCESSI_')&quot;>&#xa;                    &lt;tns3:FileToBeSend>&#xa;                        &lt;xsl:value-of select=&quot;concat($Path,'.END')&quot;/>&#xa;                    &lt;/tns3:FileToBeSend>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:FileToBeSend>&#xa;                        &lt;xsl:value-of select=&quot;concat(substring-before($Path, '.csv'),'.ctr')&quot;/>&#xa;                    &lt;/tns3:FileToBeSend>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($Start/ns:InputData/ns:NomeFile, 'NOW_JPUB_BONIFICA_ISTATCOMUNE_')&quot;>&#xa;                    &lt;tns3:RomoteDirectory>&#xa;                        &lt;xsl:value-of select=&quot;concat($PathDestinazioneJPUBBonificaIstatComune, $Start/ns:InputData/ns:NomeFile, &amp;quot;.END&amp;quot;)&quot;/>&#xa;                    &lt;/tns3:RomoteDirectory>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;starts-with($Start/ns:InputData/ns:NomeFile, 'NOW_JPUB_BONIFICA_ACCESSI_PREGRESSO_')&quot;>&#xa;                    &lt;tns3:RomoteDirectory>&#xa;                        &lt;xsl:value-of select=&quot;concat($PathDestinazioneJPUBBonificaAccessiPregressi, $Start/ns:InputData/ns:NomeFile, &amp;quot;.END&amp;quot;)&quot;/>&#xa;                    &lt;/tns3:RomoteDirectory>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;starts-with($Start/ns:InputData/ns:NomeFile, 'NOW_JPUB_BONIFICA_ACCESSI_')&quot;>&#xa;                    &lt;tns3:RomoteDirectory>&#xa;                        &lt;xsl:value-of select=&quot;concat($PathDestinazioneJPUBBonificaAccessiOL, $Start/ns:InputData/ns:NomeFile, &amp;quot;.END&amp;quot;)&quot;/>&#xa;                    &lt;/tns3:RomoteDirectory>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:RomoteDirectory>&#xa;                        &lt;xsl:value-of select=&quot;concat($PathDestinazioneJPUB,$NomeFileTappo)&quot;/>&#xa;                    &lt;/tns3:RomoteDirectory>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns3:Credentials>&#xa;                &lt;tns3:Host>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:HOST&quot;/>&#xa;                &lt;/tns3:Host>&#xa;                &lt;tns3:Port>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:PORT&quot;/>&#xa;                &lt;/tns3:Port>&#xa;                &lt;tns3:User>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:USERNAME&quot;/>&#xa;                &lt;/tns3:User>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:SFTP/ns:PASSOWRD&quot;>&#xa;                    &lt;tns3:Password>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SFTP/ns:PASSOWRD&quot;/>&#xa;                    &lt;/tns3:Password>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:Credentials>&#xa;        &lt;/tns3:SFTP_Put_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="SFTP.SFTP_Put_New" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
