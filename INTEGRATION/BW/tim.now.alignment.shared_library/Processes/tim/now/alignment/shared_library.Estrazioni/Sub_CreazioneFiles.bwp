    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails1"
                tibex:faultNameVar="FaultName1" tibex:xpdlId="8d873ab4-3404-4825-9cb4-06aa342aa763">
                <bpws:scope name="scope2">
                    <bpws:flow name="flow4">
                        <bpws:links>
                            <bpws:link name="logKOProcstoToExit" tibex:linkType="SUCCESS"/>
                            <bpws:link name="UpdStatoErrorToEmpty" tibex:linkType="ERROR"/>
                            <bpws:link name="EmptyToGetID_ESEC" tibex:linkType="SUCCESS"/>
                            <bpws:link name="LogErrorToUpdStatoError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="UpdStatoErrorToCallProcess" tibex:linkType="SUCCESS"/>
                            <bpws:link name="GetID_ESECToInvoke" tibex:linkType="SUCCESS"/>
                            <bpws:link name="UpdKOProcstoToInvoke" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="UpdStatoError-input"
                                name="UpdStatoError"
                                outputVariable="UpdStatoError"
                                tibex:xpdlId="80bfdf9b-e611-4757-a7ee-2010eb75c8e2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="LogErrorToUpdStatoError"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="UpdStatoErrorToCallProcess"/>
                                    <bpws:source
                                    linkName="UpdStatoErrorToEmpty"
                                    tibex:faultDetailsVar="UpdStatoError" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+80bfdf9b-e611-4757-a7ee-2010eb75c8e2+input&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdStatoError-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;DESCR_ERROR>&#xa;                &lt;xsl:value-of select=&quot;substring(tib:render-xml($FaultDetails1),1, 999)&quot;/>&#xa;            &lt;/DESCR_ERROR>&#xa;            &lt;NOMEFILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/ns:InputData/ns:NomeFile)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:NomeFile&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOMEFILE>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&#xa;            &lt;/ID_FILE>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout_Estrazioni"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE STATO_ESTRAZIONI&#xa;  SET STATUS = 'KO_CREATE', DESCR_ERRORE=?&#xa;  WHERE &#xa;  NOME_FILE= ?&#xa;  AND ID_FILE=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_ERROR"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOMEFILE"/>
                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FILE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="LogError-input"
                                name="LogError"
                                tibex:xpdlId="f8f57ab9-5feb-4c6c-b52c-71514f1d0580"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LogErrorToUpdStatoError"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:template name=&quot;LogError-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&#xa;                    &lt;tns3:Application>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&#xa;                    &lt;/tns3:Application>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Sub_CreazioneFiles'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Errore nella creazione file   ',  $Start/ns:InputData/ns:NomeFile, '    ',   ' ID_FILE= ', string($Start/ns:InputData/ns:IDFile), '      ',  tib:render-xml($FaultDetails1))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&#xa;                    &lt;tns3:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&#xa;                    &lt;/tns3:LoggerName>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&#xa;                    &lt;tns3:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&#xa;                    &lt;/tns3:LogLevel>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:empty name="Empty" tibex:xpdlId="d6035433-019c-4d1c-a7e8-bebb892c34f2">
                            <bpws:targets>
                                <bpws:target linkName="UpdStatoErrorToEmpty"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="EmptyToGetID_ESEC"/>
                            </bpws:sources>
                        </bpws:empty>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="GetID_ESEC-input"
                                name="GetID_ESEC"
                                outputVariable="GetID_ESEC"
                                tibex:xpdlId="9f8c80e7-dbae-4c91-8053-ac9ed2f42811" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="UpdStatoErrorToCallProcess"/>
                                    <bpws:target linkName="EmptyToGetID_ESEC"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="GetID_ESECToInvoke"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9f8c80e7-dbae-4c91-8053-ac9ed2f42811+input&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;GetID_ESEC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&#xa;            &lt;/ID_FILE>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout_Estrazioni"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_ESEC_PROCSO_FILE&#xa;  FROM FILE_PROCSTO WHERE ID_FILE=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FILE"/>
                                    <columnMetadata
                                    columnName="ID_ESEC_PROCSO_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:invoke inputVariable="UpdKOProcsto-input"
                            name="UpdKOProcsto" operation="Insert"
                            outputVariable="UpdKOProcsto"
                            partnerLink="Logger"
                            portType="ns5:ProcessLog" tibex:xpdlId="26273b71-602d-4e93-a1c1-1e0b85cb89c5">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns="www.tim.now.alignment.sharedlibrary.DataEstrazioni" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="GetID_ESEC"/&gt;
    &lt;xsl:template name="UpdKOProcsto-input" match="/"&gt;
        &lt;tns3:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns2:Input&gt;
                    &lt;ns2:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;
                    &lt;/ns2:TipologiaProcesso&gt;
                    &lt;ns2:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                    &lt;/ns2:TipologiaOperazione&gt;
                    &lt;ns2:FileProcessato&gt;
                        &lt;ns2:DESCR_STATO_FILE&gt;
                            &lt;xsl:value-of select="'NON INVIATO'"/&gt;
                        &lt;/ns2:DESCR_STATO_FILE&gt;
                        &lt;ns2:ESITO&gt;
                            &lt;xsl:value-of select="'ERRORE CREAZIONE FILE'"/&gt;
                        &lt;/ns2:ESITO&gt;
                        &lt;ns2:ID_ESEC_PROCSO_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer($GetID_ESEC/Record[1]/ID_ESEC_PROCSO_FILE)"/&gt;
                        &lt;/ns2:ID_ESEC_PROCSO_FILE&gt;
                        &lt;xsl:if test="$Start/ns:InputData/ns:IDFile"&gt;
                            &lt;ns2:ID_FILE&gt;
                                &lt;xsl:value-of select="$Start/ns:InputData/ns:IDFile"/&gt;
                            &lt;/ns2:ID_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;ns2:TIMSTP_CHIUSURA_FILE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns2:TIMSTP_CHIUSURA_FILE&gt;
                        &lt;ns2:VERSO_DEL_FILE&gt;
                            &lt;xsl:value-of select="'OUTPUT'"/&gt;
                        &lt;/ns2:VERSO_DEL_FILE&gt;
                    &lt;/ns2:FileProcessato&gt;
                    &lt;ns2:EsecuzioneFile&gt;
                        &lt;ns2:ID_ESEC_PROCSO_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer($GetID_ESEC/Record[1]/ID_ESEC_PROCSO_FILE)"/&gt;
                        &lt;/ns2:ID_ESEC_PROCSO_FILE&gt;
                        &lt;xsl:if test="$Start/ns:InputData/ns:IDFile"&gt;
                            &lt;ns2:ID_PROCSO_FILE&gt;
                                &lt;xsl:value-of select="$Start/ns:InputData/ns:IDFile"/&gt;
                            &lt;/ns2:ID_PROCSO_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;ns2:STATO_ESEC&gt;
                            &lt;xsl:value-of select="'PROCESSO ESEGUITO CON ERRORE'"/&gt;
                        &lt;/ns2:STATO_ESEC&gt;
                        &lt;ns2:TMSP_FINE_ELAB&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns2:TMSP_FINE_ELAB&gt;
                    &lt;/ns2:EsecuzioneFile&gt;
                    &lt;ns2:LogFileProcessato/&gt;
                    &lt;ns2:FileProcessatoOutput&gt;
                        &lt;ns2:ESITO_INVIO&gt;
                            &lt;xsl:value-of select="'KO'"/&gt;
                        &lt;/ns2:ESITO_INVIO&gt;
                    &lt;/ns2:FileProcessatoOutput&gt;
                &lt;/ns2:Input&gt;
            &lt;/part1&gt;
        &lt;/tns3:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;GetID_ESEC&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdKOProcsto-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:Input>&#xa;            &lt;ns2:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns2:TipologiaProcesso>&#xa;            &lt;ns2:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/ns2:TipologiaOperazione>&#xa;            &lt;ns2:FileProcessato>&#xa;                &lt;ns2:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;'NON INVIATO'&quot;/>&#xa;                &lt;/ns2:DESCR_STATO_FILE>&#xa;                &lt;ns2:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;'ERRORE CREAZIONE FILE'&quot;/>&#xa;                &lt;/ns2:ESITO>&#xa;                &lt;ns2:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($GetID_ESEC/Record[1]/ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns2:ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:IDFile&quot;>&#xa;                    &lt;ns2:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:IDFile&quot;/>&#xa;                    &lt;/ns2:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns2:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns2:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;ns2:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;'OUTPUT'&quot;/>&#xa;                &lt;/ns2:VERSO_DEL_FILE>&#xa;            &lt;/ns2:FileProcessato>&#xa;            &lt;ns2:EsecuzioneFile>&#xa;                &lt;ns2:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($GetID_ESEC/Record[1]/ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns2:ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:IDFile&quot;>&#xa;                    &lt;ns2:ID_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:IDFile&quot;/>&#xa;                    &lt;/ns2:ID_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns2:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;'PROCESSO ESEGUITO CON ERRORE'&quot;/>&#xa;                &lt;/ns2:STATO_ESEC>&#xa;                &lt;ns2:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns2:TMSP_FINE_ELAB>&#xa;            &lt;/ns2:EsecuzioneFile>&#xa;            &lt;ns2:LogFileProcessato/>&#xa;            &lt;ns2:FileProcessatoOutput>&#xa;                &lt;ns2:ESITO_INVIO>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/ns2:ESITO_INVIO>&#xa;            &lt;/ns2:FileProcessatoOutput>&#xa;        &lt;/ns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
