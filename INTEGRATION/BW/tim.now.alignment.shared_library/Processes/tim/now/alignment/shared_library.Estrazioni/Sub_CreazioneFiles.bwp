                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+208b4c2f-f72e-47f0-b774-365649204118+input&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Path&quot;/>&lt;xsl:param name=&quot;PathJPUB&quot;/>&lt;xsl:template name=&quot;UpInfoFileRASSH-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, 'DECOMMISSIONING') or contains($Start/ns:InputData/ns:NomeFile, 'NOW_JPUB_DECO_SWITCHOFF') or contains($Start/ns:InputData/ns:NomeFile, 'NOW_Bonifica_MA')&quot;>&lt;tns2:jdbcUpdateActivityInput>&lt;PathFile>&lt;xsl:value-of select=&quot;$PathJPUB&quot;/>&lt;/PathFile>&lt;NOME_FILE>&lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:NomeFile,'.gz')&quot;/>&lt;/NOME_FILE>&lt;IDFILE>&lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&lt;/IDFILE>&lt;/tns2:jdbcUpdateActivityInput>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns:InputData/ns:Flag_ZIP='Y' and not(contains($Start/ns:InputData/ns:NomeFile, 'QDR_NOW_'))&quot;>&lt;tns2:jdbcUpdateActivityInput>&lt;PathFile>&lt;xsl:value-of select=&quot;concat($Path,'.gz')&quot;/>&lt;/PathFile>&lt;NOME_FILE>&lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:NomeFile,'.gz')&quot;/>&lt;/NOME_FILE>&lt;IDFILE>&lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&lt;/IDFILE>&lt;/tns2:jdbcUpdateActivityInput>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, 'QDR_NOW_')&quot;>&lt;tns2:jdbcUpdateActivityInput>&lt;PathFile>&lt;xsl:value-of select=&quot;$PathJPUB&quot;/>&lt;/PathFile>&lt;NOME_FILE>&lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:NomeFile,'.gz')&quot;/>&lt;/NOME_FILE>&lt;IDFILE>&lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&lt;/IDFILE>&lt;/tns2:jdbcUpdateActivityInput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:jdbcUpdateActivityInput>&lt;PathFile>&lt;xsl:value-of select=&quot;$Path&quot;/>&lt;/PathFile>&lt;NOME_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:InputData/ns:NomeFile)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:NomeFile&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME_FILE>&lt;IDFILE>&lt;xsl:value-of select=&quot;xsd:int($Start/ns:InputData/ns:IDFile)&quot;/>&lt;/IDFILE>&lt;/tns2:jdbcUpdateActivityInput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
