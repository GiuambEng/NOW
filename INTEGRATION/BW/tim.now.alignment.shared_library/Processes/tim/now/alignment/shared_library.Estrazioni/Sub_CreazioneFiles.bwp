            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Up_CfgStart_LastUpd-input"
                    name="Up_CfgStart_LastUpd"
                    outputVariable="Up_CfgStart_LastUpd"
                    tibex:xpdlId="63b68c16-565b-4c54-8e6b-316b4c3b6471" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogCreateOKToUp_CfgStart_LastUpd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Up_CfgStart_LastUpdToUpdStatoAndInfoFile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+63b68c16-565b-4c54-8e6b-316b4c3b6471+input&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Up_CfgStart_LastUpd-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;LAST_UPDATE>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/LAST_UPDATE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, 'NOW_JPUB_WILL_CONTRIBUTO_CESSAZIONE')&quot;>&#xa;                    &lt;COD_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ID374&amp;quot;&quot;/>&#xa;                    &lt;/COD_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, 'NOW_INCONTRA_CPS_')&quot;>&#xa;                    &lt;COD_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;'ID320'&quot;/>&#xa;                    &lt;/COD_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, 'NOW_FRMSFRAUD_CPS_')&quot;>&#xa;                    &lt;COD_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;'ID317'&quot;/>&#xa;                    &lt;/COD_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, 'NOW_ESTRAZIONE_IRIDEOS_') and $Start/ns:InputData/ns:SystemName = 'UNICARA'&quot;>&#xa;                    &lt;COD_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;'ID282'&quot;/>&#xa;                    &lt;/COD_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, 'NOW_ESTRAZIONE_IRIDEOS_') and $Start/ns:InputData/ns:SystemName = 'UNICAC'&quot;>&#xa;                    &lt;COD_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;'ID281'&quot;/>&#xa;                    &lt;/COD_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, 'NOW_ESTRAZIONE_IRIDEOS_') and $Start/ns:InputData/ns:SystemName = 'NACS'&quot;>&#xa;                    &lt;COD_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;'ID283'&quot;/>&#xa;                    &lt;/COD_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, 'NOW_ESTRAZIONE_IRIDEOS_') and $Start/ns:InputData/ns:SystemName = 'DINAMYC'&quot;>&#xa;                    &lt;COD_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;'ID284'&quot;/>&#xa;                    &lt;/COD_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, 'NOW_NGAVULA_')&quot;>&#xa;                    &lt;COD_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;'ID130N'&quot;/>&#xa;                    &lt;/COD_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, 'NOW_xDSL_')&quot;>&#xa;                    &lt;COD_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;'ID130X'&quot;/>&#xa;                    &lt;/COD_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;COD_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;'ID130R'&quot;/>&#xa;                    &lt;/COD_INTRFC>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;SISTEMA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/ns:InputData/ns:SystemName)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SystemName&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/SISTEMA>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout_Estrazioni"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE CFG_START_ESTRAZIONI&#xa;  SET LAST_UPDATE = ?&#xa;  WHERE COD_INTRFC = ? AND SISTEMA=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="LAST_UPDATE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_INTRFC"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SISTEMA"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="CheckRA-IRIDEOS" tibex:xpdlId="308bd6d2-c7a2-487e-851d-2559a18392ab">
                <bpws:targets>
                    <bpws:target linkName="VerificaPresenzaDatiToEmpty2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty2ToRepeat">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckRA-IRIDEOSToAssign_RAConsistenzeCABQuadratoriJPUB">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns0:InputData/ns0:SystemName = ('RA'))&#xd;&#xa;or ($Start/ns0:InputData/ns0:SystemName = 'JPUB' and (contains($Start/ns0:InputData/ns0:NomeFile, 'QDR_NOW_') &#xd;&#xa;or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_DECOMMISSIONING_') &#xd;&#xa;or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_Bonifica_MA'))) &#xd;&#xa;or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_ESTRAZIONE_CONSISTENZA_CAB_')&#xd;&#xa;or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_DECO_SWITCHOFF_')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns0:InputData/ns0:SystemName = ('RA'))
or ($Start/ns0:InputData/ns0:SystemName = 'JPUB' and (contains($Start/ns0:InputData/ns0:NomeFile, 'QDR_NOW_') 
or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_DECOMMISSIONING_') 
or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_Bonifica_MA'))) 
or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_ESTRAZIONE_CONSISTENZA_CAB_')
or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_DECO_SWITCHOFF_')]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
