            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogCreateOK-input"
                    name="LogCreateOK"
                    tibex:xpdlId="83943fae-d962-4fd9-a91b-af6d3481cb95"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Assign1ToLogCreateOK"/>
                        <bpws:target linkName="FileSizeToLogCreateOK"/>
