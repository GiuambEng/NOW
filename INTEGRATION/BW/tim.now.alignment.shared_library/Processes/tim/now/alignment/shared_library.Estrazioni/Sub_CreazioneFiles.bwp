                        <bpws:source linkName="AssignToCopy_1_LogExternalCommand"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_ESTRAZIONE_CONSISTENZA_CAB_'))&#xd;&#xa;then concat(&quot;./load_estrazioni.sh &quot;,$PathRootUnica,&quot; &quot;,string($Start/ns0:InputData/ns0:IDFile),&quot; &quot;,$PathUNICA,&quot; &quot;,$Start/ns0:InputData/ns0:Flag_ZIP)&#xd;&#xa;else if ($Start/ns0:InputData/ns0:SystemName='JPUB' and (contains($Start/ns0:InputData/ns0:NomeFile, 'DECOMMISSIONING') or contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_JPUB_DECO_SWITCHOFF'))) &#xd;&#xa;then concat(&quot;./lancio_estr_JPUB_INV.ksh &quot;,string($Start/ns0:InputData/ns0:IDFile),&quot; &quot;,$PathJPUB,&quot; &quot;,$Start/ns0:InputData/ns0:Flag_ZIP)&#xd;&#xa;else if ($Start/ns0:InputData/ns0:SystemName='JPUB' and (contains($Start/ns0:InputData/ns0:NomeFile, 'NOW_Bonifica_MA'))) then concat(&quot;./lancio_estr_JPUB_MCRAREA.ksh &quot;,string($Start/ns0:InputData/ns0:IDFile),&quot; &quot;,$PathJPUB,&quot; &quot;,$Start/ns0:InputData/ns0:Flag_ZIP) &#xd;&#xa;else if ($Start/ns0:InputData/ns0:SystemName='JPUB' and not(contains($Start/ns0:InputData/ns0:NomeFile, 'DECOMMISSIONING'))) then  concat(&quot;./lancio_estr_quadra_jpub.ksh &quot;,string($Start/ns0:InputData/ns0:IDFile),&quot; &quot;,$PathJPUB,&quot; &quot;,$Start/ns0:InputData/ns0:Flag_ZIP)&#xd;&#xa;else concat(&quot;./load_estrazioni.sh &quot;,$PathRoot,&quot; &quot;,string($Start/ns0:InputData/ns0:IDFile),&quot; &quot;,$PathRA,&quot; &quot;,$Start/ns0:InputData/ns0:Flag_ZIP)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
