                    <bpws:sources>
                        <bpws:source linkName="CallProcessToSetPathFile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&#xa;                    &lt;tns3:Application>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&#xa;                    &lt;/tns3:Application>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Sub_CreazioneFiles'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Inizio Processo Scrittura File con nome   ',  $Start/ns:InputData/ns:NomeFile, ' ID_FILE= ', string($Start/ns:InputData/ns:IDFile))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&#xa;                    &lt;tns3:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&#xa;                    &lt;/tns3:LoggerName>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&#xa;                    &lt;tns3:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&#xa;                    &lt;/tns3:LogLevel>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
