$Port_SSH&quot;/>&#xa;                &lt;/tns1:Port>&#xa;                &lt;tns1:Password>&#xa;                    &lt;xsl:value-of select=&quot;$Password_SSH&quot;/>&#xa;                &lt;/tns1:Password>&#xa;                &lt;tns1:User>&#xa;                    &lt;xsl:value-of select=&quot;$User_SSH&quot;/>&#xa;                &lt;/tns1:User>&#xa;            &lt;/tns1:credenziali>&#xa;        &lt;/tns1:SFTP_GetJavaCodeInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
