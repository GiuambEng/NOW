<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/ContenutoRecdBonificaMacroArea" xmlns:tns="http://www.example.org/ContenutoRecdBonificaMacroArea" elementFormDefault="qualified">

<element name="ContenutoRecdBonificaMacroArea">
    	<complexType>
			<sequence>  		
				<element maxOccurs="1" minOccurs="0" name="CODICECLLI" type="string">
				</element>
				<element maxOccurs="1" minOccurs="0" name="OFFERTA" type="string">
				</element>
				<element maxOccurs="1" minOccurs="0" name="MACROAREA" type="string">
				</element>
				<element maxOccurs="1" minOccurs="0" name="Flag_Validita" type="string">
				</element>
			</sequence>
		</complexType>
</element>

<element name="InputBonificaMacroArea_ContenutoRecord">
    <complexType>
    	<sequence>
    		<element maxOccurs="unbounded" minOccurs="0"
    			ref="tns:ContenutoRecordBonificaMacroArea_input">
    		</element>
    	</sequence>
    </complexType>
</element>
	
<element name="ContenutoRecordBonificaMacroArea_input">
    <complexType>
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="CODICECLLI" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="OFFERTA" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="MACROAREA" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="Flag_Validita" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="NumeroRecord" type="string"/>
		</sequence>
    </complexType>
</element>
</schema>

