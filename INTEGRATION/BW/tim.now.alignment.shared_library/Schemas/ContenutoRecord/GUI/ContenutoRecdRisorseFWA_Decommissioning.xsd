<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/ContenutoRecdRisorseFWA_Decommissioning" xmlns:tns="http://www.example.org/ContenutoRecdRisorseFWA_Decommissioning" elementFormDefault="qualified">

<element name="ContenutoRecdRisorseFWA_Decommissioning">
    	<complexType>
			<sequence>  		
				<element maxOccurs="1" minOccurs="0" name="ID_RISORSA_SWITCHOFF" type="string">
				</element>
				<element maxOccurs="1" minOccurs="0" name="DATA_SCADENZA_SWITCHOFF" type="string">
				</element>
				<element maxOccurs="1" minOccurs="0" name="Flag_Validita" type="string">
				</element>
			</sequence>
		</complexType>
</element>

<element name="InputRisorseFWA_Decommissioning_ContenutoRecord">
    <complexType>
    	<sequence>
    		<element maxOccurs="unbounded" minOccurs="0"
    			ref="tns:ContenutoRecdRisorseFWA_Decommissioning_input">
    		</element>
    	</sequence>
    </complexType>
</element>
	
<element name="ContenutoRecdRisorseFWA_Decommissioning_input">
    <complexType>
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="ID_RISORSA_SWITCHOFF" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="DATA_SCADENZA_SWITCHOFF" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="Flag_Validita" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="NumeroRecord" type="string"/>
		</sequence>
    </complexType>
</element>
</schema>

