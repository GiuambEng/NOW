<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xs:schema xmlns:ns1="www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details" xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details">
	<xs:element name="Details">
		<xs:complexType>
			<xs:sequence>
				<xs:element maxOccurs="unbounded" name="InputDetails">
					<xs:complexType>
						<xs:sequence>
							<xs:element minOccurs="0" name="NOME">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:enumeration value="NomeFileScarto"/>
										<xs:enumeration value="NomeTabellaScarto"/>
										<xs:enumeration value="DestinationPathFile"/>
										<xs:enumeration value="SourcePathFile"/>
										<xs:enumeration value="Offset"/>
										<xs:enumeration value="PathFileScarto"/>
										<xs:enumeration value="NameFile"/>
										<xs:enumeration value="ErrorPathFile"/>

									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element minOccurs="0" name="VALORE" type="xs:string"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
            </xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
