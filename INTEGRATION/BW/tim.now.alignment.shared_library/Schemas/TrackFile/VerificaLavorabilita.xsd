<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VerificaLavorabilita" xmlns:tns="http://www.example.org/VerificaLavorabilita" elementFormDefault="qualified">
<element name="Input">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="FLUSSO" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="NUMERO_CORRELAZIONI" type="int"/>
    			<element maxOccurs="1" minOccurs="0" name="ID_FLOW" type="int"/>
    			<element maxOccurs="1" minOccurs="0" name="FLAG_PARENT" type="boolean"/>
    			<element maxOccurs="1" minOccurs="0" name="FLAG_WAIT" type="boolean"/>
    				<element name="LogElement">
								<complexType>
									<sequence>
										<element name="LoggerName"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
										<element name="LogLevel"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
									</sequence>
								</complexType>
							</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Output">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="STATO" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="SOURCE_FILE" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="ID_TRACK" type="int"/>
    			<element name="DATA_FILE" type="string" minOccurs="0"/>
    			<element name="FILE_SIZE" type="int" minOccurs="0"/>
    			<element maxOccurs="1" minOccurs="0" name="NOME_FILE" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="int"/>

    		</sequence>
    	</complexType>
    </element>


</schema>