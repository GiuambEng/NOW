<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VerificaLavorabilita_UpdateStati" xmlns:tns="http://www.example.org/VerificaLavorabilita_UpdateStati" elementFormDefault="qualified">
<element name="INPUT">
<complexType>
<sequence>

<element name="InfoTrackFile">
					<complexType>
						<sequence>
							<element name="FLAG_LAVORAZIONE"
								type="boolean" minOccurs="0" />
							<element name="FOLDER" type="string"
								minOccurs="0" />
							<element name="STATO" type="string"
								maxOccurs="1" minOccurs="0"/>
							<element name="DESCR_ERRORE" type="string"
								maxOccurs="1" minOccurs="0"/>
							<element name="NOME_FILE" type="string"
								maxOccurs="1" minOccurs="0"/>
								<element name="ID_TRACK" type="int"
								maxOccurs="1" minOccurs="0"/>
								<element name="NUM_RETRY" type="boolean"
								maxOccurs="1" minOccurs="0"/>
								<element name="ID_FILE" type="int" minOccurs="0"/>
								<element name="FOLDER_SCARTO" type="string" minOccurs="0"/>
							<element name="LogElement">
								<complexType>
									<sequence>
										<element name="LoggerName"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
										<element name="LogLevel"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
										<element name="MessageForLogs"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
									</sequence>
								</complexType>
							</element>
						</sequence>
					</complexType>
				</element>
    <element name="Output">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="STATO" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="SOURCE_FILE" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="ID_TRACK" type="int"/>
    			<element name="DATA_FILE" type="string" minOccurs="0"/>
    			<element name="FILE_SIZE" type="int" minOccurs="0"/>
    			<element maxOccurs="1" minOccurs="0" name="NOME_FILE" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="int"/>

    		</sequence>
    	</complexType>
    </element>
    </sequence>
    </complexType>
    </element>
</schema>