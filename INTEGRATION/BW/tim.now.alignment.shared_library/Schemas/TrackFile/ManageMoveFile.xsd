<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/ManageMoveFile" xmlns:tns="http://www.example.org/ManageMoveFile" elementFormDefault="qualified">
<element name="InputData">
<complexType>
<sequence>
<element name="FullPathOrigine" type="string" minOccurs="0"/>
<element name="FolderDestinazione" type="string" minOccurs="0"/>
<element name="NomeFile" type="string" minOccurs="0"/>
<element name="ID_TRACK" type="int" minOccurs="0"/>
<element name="LogInput">
	<complexType>
	<sequence>
	<element name="LogLevel" type="string" minOccurs="0"/>
	<element name="LogName" type="string" minOccurs="0"/>
	</sequence>
	</complexType>
	</element>
</sequence>
</complexType>
</element>

<element name="OutputData">
<complexType>
<sequence>
<element name="FullPathMovedFile" type="string" minOccurs="0"/>
</sequence>
</complexType>
</element>



</schema>