<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/WriteContenutoFile" elementFormDefault="qualified" targetNamespace="http://www.example.org/WriteContenutoFile">

    <element name="InputWriteContenutoFile">
    	<complexType>
    		<sequence>
    			<element name="FileName" type="string"/>
    			<element name="IDFile" type="string"/>
    			<element name="LoggerName" type="string"/>
    			<element name="LoggerLevel" type="string"/>
    		</sequence>
    	</complexType>
    </element>

    <element name="OutputWriteContenutoFile">
    	<complexType>
    		<sequence>    
    			<element maxOccurs="1" name="Esito">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="OK"/>
    						<enumeration value="KO"/>
    						<enumeration value="ERROR"/>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>
