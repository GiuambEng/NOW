<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/InputScrivifile" xmlns:tns="http://www.example.org/InputScrivifile" elementFormDefault="qualified">
<element name="Record">
    	<complexType>
    		<sequence>
    			<element name="Riga" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="Contenuto" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="NomeFile" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="PathFile" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="Application" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="LoggerName" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="LogLevel" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="TipoSeparatore" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="Posizionale"></enumeration>
    						<enumeration value="CampoSeparatore"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>



</schema>