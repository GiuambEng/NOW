								type="xs:string" minOccurs="0" />
							<xs:element name="DateEstrazione"
								type="xs:string" minOccurs="0" />
							<xs:element name="Status" type="xs:string"
								maxOccurs="1" minOccurs="0">
							</xs:element>
							<xs:element name="FlagOrdine"
								type="xs:string" maxOccurs="1" minOccurs="0">
							</xs:element>
							<xs:element name="LogInfo" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element
											name="ApplicationName" type="xs:string" minOccurs="0" />
										<xs:element name="LoggerName"
											type="xs:string" minOccurs="0" />
