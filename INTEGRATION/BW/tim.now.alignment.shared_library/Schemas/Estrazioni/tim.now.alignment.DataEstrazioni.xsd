							<xs:element name="FlagReferente"
								type="xs:string" maxOccurs="1" minOccurs="0">
							</xs:element>
							<xs:element name="TransactionID"
								type="xs:string" maxOccurs="1" minOccurs="0">
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
