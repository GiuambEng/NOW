											type="xs:string" minOccurs="0" />
										<xs:element name="DATA_INIZIO"
											type="xs:string" minOccurs="0" />
										<xs:element name="DATA_FINE"
											type="xs:string" minOccurs="0" />
										<xs:element
											name="DATA_ESPLETAMENTO" type="xs:string" minOccurs="0" />
										<xs:element name="DESCR_FLUSSO"
											type="xs:string" minOccurs="0" />
										<xs:element name="ID_PPS"
											type="xs:string" maxOccurs="1" minOccurs="0">
