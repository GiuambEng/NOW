targetNamespace="www.tim.now.StarterEstrazioni.MapperFileName"
xmlns="www.tim.now.StarterEstrazioni.MapperFileName"
xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="root">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="FileName" minOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="nome" type="xs:string"/>
							<xs:element name="ID_File" type="xs:integer" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
