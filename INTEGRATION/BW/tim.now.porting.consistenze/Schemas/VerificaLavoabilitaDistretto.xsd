<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VerificaLavoabilitaDistretto" xmlns:tns="http://www.example.org/VerificaLavoabilitaDistretto" elementFormDefault="qualified">
<element name="Input">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="NOME_FILE" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="ID_TRACK" type="int"/>
    				<element name="LogElement">
								<complexType>
									<sequence>
										<element name="LoggerName"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
										<element name="LogLevel"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
									</sequence>
								</complexType>
							</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Output">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="STATO" type="string"/>
    		</sequence>
    	</complexType>
    </element>

</schema>