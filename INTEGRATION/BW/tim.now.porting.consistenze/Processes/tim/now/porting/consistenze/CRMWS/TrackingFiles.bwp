    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="SFTP_CheckInneschiCRMWToIterate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="IterateToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="SFTP_CheckInneschiCRMWToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="GenericLoggerToSFTP_CheckInneschiCRMW" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="Timer"
                    tibex:xpdlId="5ec46b4c-e944-452d-9271-ae6f1b79f3b2"
                    variable="Timer" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerToGenericLogger"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="Start1"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="IntervalloMinuti1"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="endTime" processProperty="End"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value endPolicy="END_TIME"
                                    intervalUnit="Minute" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="SFTP_CheckInneschiCRMW-input"
                    name="SFTP_CheckInneschiCRMW"
                    outputVariable="SFTP_CheckInneschiCRMW"
                    tibex:xpdlId="1c4b6026-c740-4dca-bde8-2c629df003e3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToSFTP_CheckInneschiCRMW"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SFTP_CheckInneschiCRMWToIterate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SFTP_CheckInneschiCRMW/ns1:ListOfFiles)>0 and $SFTP_CheckInneschiCRMW/ns1:Status='OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($SFTP_CheckInneschiCRMW/ns1:ListOfFiles)>0 and $SFTP_CheckInneschiCRMW/ns1:Status='OK']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SFTP_CheckInneschiCRMWToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SFTP_Host&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Port&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_User&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Password&quot;/>&#xa;    &lt;xsl:param name=&quot;FilePathTappoCRMWS&quot;/>&#xa;    &lt;xsl:template name=&quot;SFTP_CheckInneschiCRMW-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input_SFTP_DirDetail>&#xa;            &lt;tns1:Credentials>&#xa;                &lt;tns1:Host>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Host&quot;/>&#xa;                &lt;/tns1:Host>&#xa;                &lt;tns1:User>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_User&quot;/>&#xa;                &lt;/tns1:User>&#xa;                &lt;tns1:Password>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Password&quot;/>&#xa;                &lt;/tns1:Password>&#xa;                &lt;tns1:Port>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Port&quot;/>&#xa;                &lt;/tns1:Port>&#xa;            &lt;/tns1:Credentials>&#xa;            &lt;tns1:RequestType>&#xa;                &lt;tns1:ListOfFilesDetails>&#xa;                    &lt;tns1:DirectoryPath>&#xa;                        &lt;xsl:value-of select=&quot;$FilePathTappoCRMWS&quot;/>&#xa;                    &lt;/tns1:DirectoryPath>&#xa;                    &lt;tns1:FileExtensionToFilter>&#xa;                        &lt;xsl:value-of select=&quot;'.ctr'&quot;/>&#xa;                    &lt;/tns1:FileExtensionToFilter>&#xa;                &lt;/tns1:ListOfFilesDetails>&#xa;            &lt;/tns1:RequestType>&#xa;        &lt;/tns1:Input_SFTP_DirDetail>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="SFTP.STFP_DirDetail" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="113b209a-1094-4b2d-83ee-68bc2021368c">
                <bpws:targets>
                    <bpws:target linkName="IterateToExit"/>
                    <bpws:target linkName="SFTP_CheckInneschiCRMWToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="5efda876-1a18-4e0d-a042-7ccf50d7682f">
                <bpws:targets>
                    <bpws:target linkName="SFTP_CheckInneschiCRMWToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$SFTP_CheckInneschiCRMW/ns1:ListOfFiles" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($SFTP_CheckInneschiCRMW/ns1:ListOfFiles)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns1:Iterate_Current_Element_ListOfFiles"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="Track_CRMWFilesToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStartToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Track_CRMWFilesToCallProcess" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToTrack_CRMWFiles" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="39cbe980-021e-43c6-8fba-fa8ff8909d42" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToCallProcess"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($SFTP_CheckInneschiCRMW/ns1:ListOfFiles)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="8fd306cf-d389-4758-b6a1-a7646033f2df">
                                    <bpws:targets>
                                    <bpws:target linkName="Track_CRMWFilesToGroupEnd"/>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="Track_CRMWFiles-input"
                                    name="Track_CRMWFiles"
                                    tibex:xpdlId="a12047d3-5af9-48da-848b-95327630c2b3"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToTrack_CRMWFiles"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Track_CRMWFilesToGroupEnd"/>
                                    <bpws:source
                                    linkName="Track_CRMWFilesToCallProcess"
                                    tibex:faultDetailsVar="Track_CRMWFiles" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/FileTappo&quot; xmlns:tns1=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; xmlns:tns2=&quot;http://www.example.org/CheckNomeFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SFTP_Host&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Port&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_User&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Password&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;PathStoricoTappoCRMWS&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloNomeFile&quot;/>&#xa;    &lt;xsl:param name=&quot;PathError&quot;/>&#xa;    &lt;xsl:template name=&quot;Track_CRMWFiles-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:InputFileTappo>&#xa;            &lt;tns3:FileName>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns1:FullName&quot;/>&#xa;            &lt;/tns3:FileName>&#xa;            &lt;tns3:LogName>&#xa;                &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;            &lt;/tns3:LogName>&#xa;            &lt;tns3:LogLevel>&#xa;                &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;            &lt;/tns3:LogLevel>&#xa;            &lt;tns3:ApplicationName>&#xa;                &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;            &lt;/tns3:ApplicationName>&#xa;            &lt;tns3:Estensione>&#xa;                &lt;xsl:value-of select=&quot;'.csv.gz'&quot;/>&#xa;            &lt;/tns3:Estensione>&#xa;            &lt;tns3:Sistema>&#xa;                &lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&#xa;            &lt;/tns3:Sistema>&#xa;            &lt;tns3:Flusso>&#xa;                &lt;xsl:value-of select=&quot;$ControlloNomeFile/tns2:FLUSSO&quot;/>&#xa;            &lt;/tns3:Flusso>&#xa;            &lt;tns3:PathError>&#xa;                &lt;xsl:value-of select=&quot;$PathError&quot;/>&#xa;            &lt;/tns3:PathError>&#xa;            &lt;tns3:PathMovedTappo>&#xa;                &lt;xsl:value-of select=&quot;$PathStoricoTappoCRMWS&quot;/>&#xa;            &lt;/tns3:PathMovedTappo>&#xa;            &lt;tns3:Flag_SFTP_Mode>&#xa;                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;            &lt;/tns3:Flag_SFTP_Mode>&#xa;            &lt;tns3:SFTPInputData>&#xa;                &lt;tns3:Host>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Host&quot;/>&#xa;                &lt;/tns3:Host>&#xa;                &lt;tns3:Port>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Port&quot;/>&#xa;                &lt;/tns3:Port>&#xa;                &lt;tns3:User>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_User&quot;/>&#xa;                &lt;/tns3:User>&#xa;                &lt;tns3:Password>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Password&quot;/>&#xa;                &lt;/tns3:Password>&#xa;            &lt;/tns3:SFTPInputData>&#xa;        &lt;/tns3:InputFileTappo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile_SFTPMode.GestioneLetturaTracciamento" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="logKOTrackCRMW-input"
                                    name="logKOTrackCRMW"
                                    tibex:xpdlId="47e86903-4c8e-4bae-8685-0a812d362cb1"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Track_CRMWFilesToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;logKOTrackCRMW-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($_error)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="ControlloNomeFile-input"
                                    name="ControlloNomeFile"
                                    outputVariable="ControlloNomeFile"
                                    tibex:xpdlId="b72706d4-0eca-42dc-87e5-ad574c923449"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToTrack_CRMWFiles"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/CheckNomeFile&quot; xmlns:tns1=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;ControlloNomeFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;tns2:FILE_NAME>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns1:FileName&quot;/>&#xa;            &lt;/tns2:FILE_NAME>&#xa;            &lt;tns2:SYSTEM>&#xa;                &lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&#xa;            &lt;/tns2:SYSTEM>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.porting.consistenze.common.ControlloNomeFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="GenericLogger-input"
                    name="GenericLogger"
                    tibex:xpdlId="e4b355ec-46d6-4974-94d0-eefd164b1f7a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToSFTP_CheckInneschiCRMW"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Avviato processo CRMWS TrackingFiles'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
