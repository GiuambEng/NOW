                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns1=&quot;http://www.example.org/GestioneMovedFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SourcePath&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Host&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Port&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_User&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Password&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:InputData>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns2:SOURCE_FILE&quot;>&#xa;                &lt;tns1:FullPathOrigine>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns2:SOURCE_FILE&quot;/>&#xa;                &lt;/tns1:FullPathOrigine>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:FolderDestinazione>&#xa;                &lt;xsl:value-of select=&quot;$SourcePath&quot;/>&#xa;            &lt;/tns1:FolderDestinazione>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns2:NOME_FILE&quot;>&#xa;                &lt;tns1:NomeFile>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns2:NOME_FILE&quot;/>&#xa;                &lt;/tns1:NomeFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns2:ID_TRACK&quot;>&#xa;                &lt;tns1:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns2:ID_TRACK&quot;/>&#xa;                &lt;/tns1:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:SFTP>&#xa;                &lt;tns1:Host>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Host&quot;/>&#xa;                &lt;/tns1:Host>&#xa;                &lt;tns1:Port>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Port&quot;/>&#xa;                &lt;/tns1:Port>&#xa;                &lt;tns1:User>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_User&quot;/>&#xa;                &lt;/tns1:User>&#xa;                &lt;tns1:Password>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Password&quot;/>&#xa;                &lt;/tns1:Password>&#xa;            &lt;/tns1:SFTP>&#xa;            &lt;tns1:Log>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;            &lt;/tns1:Log>&#xa;        &lt;/tns1:InputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
