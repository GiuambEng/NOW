                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;SFTP_Host&quot;/>&lt;xsl:param name=&quot;SFTP_User&quot;/>&lt;xsl:param name=&quot;Command&quot;/>&lt;xsl:param name=&quot;PortingRoot&quot;/>&lt;xsl:param name=&quot;Flag_SSH&quot;/>&lt;xsl:template name=&quot;LogCommand-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;xsl:choose>&lt;xsl:when test=&quot;$Flag_SSH='N'&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;***COMANDO PER INVOCAZIONE SHELL: &amp;quot;, $Command )&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;***COMANDO PER INVOCAZIONE SSH SHELL: &amp;quot;, $Command , &amp;quot; PARAMETRI DI CONFIGURAZIONE SSH - HOST:&amp;quot;, $SFTP_Host, &amp;quot; USER: &amp;quot;, $SFTP_User, &amp;quot; PORTING_ROOT=&amp;quot;, $PortingRoot)&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
