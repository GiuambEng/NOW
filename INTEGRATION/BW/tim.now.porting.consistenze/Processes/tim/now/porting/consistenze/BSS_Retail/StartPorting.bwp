                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogCommand-input"
                                    name="LogCommand"
                                    tibex:xpdlId="ee2036a1-623d-4803-8371-18d38b7835b4"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
