                                    <bpws:link
                                    name="TrackKOToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogStartToVerificaLavorabilita" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToGroupEnd1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="SetCommandToLogCommand" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="EmptyToMovedSource" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="EmptyToSetCodInterfaccia" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="LogCommandToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallShellToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToGroupEnd11" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="MovedSourceToEmpty2" tibex:linkType="ERROR"/>
                                    <bpws:link name="Empty2ToTrackKO" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="e8d778f6-2fa2-417b-b3b8-15bc24ddcacc" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToCallProcess"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($BSSFlowsName/Record)[number($index)]]]></bpws:from>
