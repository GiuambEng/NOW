                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/SetCommand&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;PortingRoot&quot;/>&#xa;    &lt;xsl:param name=&quot;Flag_SSH&quot;/>&#xa;    &lt;xsl:param name=&quot;Command&quot;/>&#xa;    &lt;xsl:template name=&quot;CallShell-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;tns1:Command>&#xa;                &lt;xsl:value-of select=&quot;$Command&quot;/>&#xa;            &lt;/tns1:Command>&#xa;            &lt;tns1:WorkingDirectory>&#xa;                &lt;xsl:value-of select=&quot;$PortingRoot&quot;/>&#xa;            &lt;/tns1:WorkingDirectory>&#xa;            &lt;tns1:FlagSSH>&#xa;                &lt;xsl:value-of select=&quot;$Flag_SSH&quot;/>&#xa;            &lt;/tns1:FlagSSH>&#xa;        &lt;/tns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
