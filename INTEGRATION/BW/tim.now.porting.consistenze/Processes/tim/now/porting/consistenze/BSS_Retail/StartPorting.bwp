                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="UpdKOLogger-input"
                                    name="UpdKOLogger"
                                    outputVariable="UpdKOLogger"
                                    tibex:xpdlId="848b7a44-b9b6-4e79-a874-c499b4796d76"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallShellToUpdKOLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="UpdKOLoggerToMovedInError"/>
                                    <bpws:source
                                    linkName="UpdKOLoggerToEmpty1"
                                    tibex:faultDetailsVar="UpdKOLogger" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/CreateFileID&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateIDFile&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdKOLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;tns1:DataIn>&#xa;                &lt;tns1:Update>&#xa;                    &lt;tns1:InputFile>&#xa;                        &lt;xsl:if test=&quot;$CreateIDFile/tns1:ID_FILE&quot;>&#xa;                            &lt;tns1:ID_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$CreateIDFile/tns1:ID_FILE&quot;/>&#xa;                            &lt;/tns1:ID_FILE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:STATO_ESEC>&#xa;                            &lt;xsl:value-of select=&quot;'PROCESSO ESEGUITO CON ERRORE'&quot;/>&#xa;                        &lt;/tns1:STATO_ESEC>&#xa;                        &lt;tns1:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns1:ESITO>&#xa;                        &lt;tns1:DESCR_STATO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                        &lt;/tns1:DESCR_STATO_FILE>&#xa;                        &lt;tns1:LOG_MESSAGE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE INPUT CORROTTO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:LOG_MESSAGE>&#xa;                    &lt;/tns1:InputFile>&#xa;                &lt;/tns1:Update>&#xa;            &lt;/tns1:DataIn>&#xa;            &lt;tns1:LogElement>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;            &lt;/tns1:LogElement>&#xa;        &lt;/tns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.ProcessLoggerTrack" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="TrackKO-input"
                                    name="TrackKO"
                                    tibex:xpdlId="a12ba670-520a-4f64-ba5c-6f8c78ab588a"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToTrackKO"/>
                                    <bpws:target linkName="CallProcessToTrackKO1"/>
                                    <bpws:target linkName="Empty2ToTrackKO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="TrackKOToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/InputTrackFile&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns3=&quot;http://www.example.org/GestioneMovedFile&quot; xmlns:tns4=&quot;http://www.example.org/SetCommand&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:param name=&quot;MovedSource&quot;/>&#xa;    &lt;xsl:param name=&quot;CallShell&quot;/>&#xa;    &lt;xsl:template name=&quot;TrackKO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;tns2:Update>&#xa;                &lt;tns2:FLAG_LAVORAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:FLAG_LAVORAZIONE>&#xa;                &lt;tns2:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/tns2:STATO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$CallShell/tns4:Esito = &amp;quot;KO&amp;quot;&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallShell/tns4:DescrError&quot;>&#xa;                            &lt;tns2:DESCR_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$CallShell/tns4:DescrError&quot;/>&#xa;                            &lt;/tns2:DESCR_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($MovedSource/tns3:FullPathMovedFile)=0 and $VerificaLavorabilita/tns1:STATO='IN RILAVORAZIONE'&quot;>&#xa;                        &lt;tns2:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;'***ERROR - IMPOSSIBILE RI-LAVORARE FILE IN QUANTO NON SPOSTATO NELLA FOLDER SORGENTE**'&quot;/>&#xa;                        &lt;/tns2:DESCR_ERRORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($_error)&quot;/>&#xa;                        &lt;/tns2:DESCR_ERRORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&#xa;                    &lt;tns2:ID_TRACK>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;/>&#xa;                    &lt;/tns2:ID_TRACK>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:LogElement>&#xa;                    &lt;tns2:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                    &lt;/tns2:LoggerName>&#xa;                    &lt;tns2:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                    &lt;/tns2:LogLevel>&#xa;                &lt;/tns2:LogElement>&#xa;            &lt;/tns2:Update>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.TrackFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="CreateIDFile-input"
                                    name="CreateIDFile"
                                    outputVariable="CreateIDFile"
                                    tibex:xpdlId="e6aa8e06-1f09-4b1c-8542-70ff814f7351"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToCreateIDFile"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CreateIDFileToCallSQLDR"/>
                                    <bpws:source
                                    linkName="CreateIDFileToMovedInError"
                                    tibex:faultDetailsVar="CreateIDFile" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/CreateFileID&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceInterfaccia&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;CreateIDFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;tns2:DataIn>&#xa;                &lt;tns2:Insert>&#xa;                    &lt;tns2:InputFile>&#xa;                        &lt;tns2:CODICE_INTERFACCIA>&#xa;                            &lt;xsl:value-of select=&quot;$CodiceInterfaccia&quot;/>&#xa;                        &lt;/tns2:CODICE_INTERFACCIA>&#xa;                        &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;>&#xa;                            &lt;tns2:NOME_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;/>&#xa;                            &lt;/tns2:NOME_FILE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:DATA_FILE&quot;>&#xa;                            &lt;tns2:DATA_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:DATA_FILE&quot;/>&#xa;                            &lt;/tns2:DATA_FILE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:FILE_SIZE&quot;>&#xa;                            &lt;tns2:SIZE>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:FILE_SIZE&quot;/>&#xa;                            &lt;/tns2:SIZE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&#xa;                            &lt;tns2:ID_TRACK>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;/>&#xa;                            &lt;/tns2:ID_TRACK>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns2:InputFile>&#xa;                &lt;/tns2:Insert>&#xa;            &lt;/tns2:DataIn>&#xa;            &lt;tns2:LogElement>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;            &lt;/tns2:LogElement>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.ProcessLoggerTrack" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="CodiceInterfaccia"
                                    name="SetCodInterfaccia"
                                    outputVariable="CodiceInterfaccia"
                                    tibex:xpdlId="e300b879-c898-432b-9a68-61f36f03afa7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToSetCodInterfaccia"/>
                                    <bpws:target linkName="MovedSourceToSetCodInterfaccia"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCreateIDFile">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if ($currentFlow/FLOW = (&quot;Porting Consistenze&quot;,&quot;Allineamento Consistenze&quot;)) then &quot;ID215&quot; else if ($currentFlow/FLOW = (&quot;Porting Anagrafica&quot;,&quot;Allineamento Anagrafica&quot;)) then &quot;ID216&quot;  else &quot;No Flow Found From FileName&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="CodiceInterfaccia" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="VerificaLavorabilita-input"
                                    name="VerificaLavorabilita"
                                    outputVariable="VerificaLavorabilita"
                                    tibex:xpdlId="d89c192d-f9b8-4d1b-94bf-c40d61175a2f"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogStartToVerificaLavorabilita"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VerificaLavorabilitaToGroupEnd1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$VerificaLavorabilita/ns2:STATO = (&quot;WAIT&quot;,'NOFOUND')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$VerificaLavorabilita/ns2:STATO = ("WAIT",'NOFOUND')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VerificaLavorabilitaToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$VerificaLavorabilita/ns2:STATO ='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$VerificaLavorabilita/ns2:STATO ='KO']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VerificaLavorabilitaToEmpty">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavoabilitaDistretto&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;currentFlow&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloBDS_ID&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaLavorabilita-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;xsl:if test=&quot;$currentFlow/FLOW&quot;>&#xa;                &lt;tns2:FLUSSO>&#xa;                    &lt;xsl:value-of select=&quot;$currentFlow/FLOW&quot;/>&#xa;                &lt;/tns2:FLUSSO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:ID_FLOW>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($currentFlow/ID_FLOW)&quot;/>&#xa;            &lt;/tns2:ID_FLOW>&#xa;            &lt;tns2:FLAG_WAIT>&#xa;                &lt;xsl:value-of select=&quot;if ($ControlloBDS_ID/tns1:STATO = &amp;quot;WAIT&amp;quot;) then true() else false()&quot;/>&#xa;            &lt;/tns2:FLAG_WAIT>&#xa;            &lt;tns2:LogElement>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;            &lt;/tns2:LogElement>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.VerificaLavorabilita" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="MovedInError-input"
                                    name="MovedInError"
                                    outputVariable="MovedInError"
                                    tibex:xpdlId="e72b4b14-26cf-4ea8-a984-3ac9a20bcb7a"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VerificaLavorabilitaToCallProcess"/>
                                    <bpws:target linkName="UpdKOLoggerToMovedInError"/>
                                    <bpws:target linkName="CreateIDFileToMovedInError"/>
                                    <bpws:target linkName="Empty1ToMovedInError"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToTrackKO">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns1=&quot;http://www.example.org/GestioneMovedFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SFTP_Host&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Port&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_User&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Password&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorPath&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;MovedSource&quot;/>&#xa;    &lt;xsl:template name=&quot;MovedInError-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:InputData>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($MovedSource/tns1:FullPathMovedFile)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$MovedSource/tns1:FullPathMovedFile&quot;>&#xa;                        &lt;tns1:FullPathOrigine>&#xa;                            &lt;xsl:value-of select=&quot;$MovedSource/tns1:FullPathMovedFile&quot;/>&#xa;                        &lt;/tns1:FullPathOrigine>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$VerificaLavorabilita/tns2:SOURCE_FILE&quot;>&#xa;                        &lt;tns1:FullPathOrigine>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns2:SOURCE_FILE&quot;/>&#xa;                        &lt;/tns1:FullPathOrigine>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:FolderDestinazione>&#xa;                &lt;xsl:value-of select=&quot;$ErrorPath&quot;/>&#xa;            &lt;/tns1:FolderDestinazione>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns2:NOME_FILE&quot;>&#xa;                &lt;tns1:NomeFile>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns2:NOME_FILE&quot;/>&#xa;                &lt;/tns1:NomeFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns2:ID_TRACK&quot;>&#xa;                &lt;tns1:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns2:ID_TRACK&quot;/>&#xa;                &lt;/tns1:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:SFTP>&#xa;                &lt;tns1:Host>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Host&quot;/>&#xa;                &lt;/tns1:Host>&#xa;                &lt;tns1:Port>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Port&quot;/>&#xa;                &lt;/tns1:Port>&#xa;                &lt;tns1:User>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_User&quot;/>&#xa;                &lt;/tns1:User>&#xa;                &lt;tns1:Password>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Password&quot;/>&#xa;                &lt;/tns1:Password>&#xa;            &lt;/tns1:SFTP>&#xa;            &lt;tns1:Log>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;            &lt;/tns1:Log>&#xa;        &lt;/tns1:InputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile_SFTPMode.GestioneMovedFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:empty name="Empty1" tibex:xpdlId="9631b109-e2b2-4d05-923e-fac923d0ca10">
                                    <bpws:targets>
                                    <bpws:target linkName="UpdKOLoggerToEmpty1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Empty1ToMovedInError">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="1=2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[1=2]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogStart-input"
                                    name="LogStart"
                                    tibex:xpdlId="c9d08a9c-028a-47be-899c-3b1b47679951"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogStartToVerificaLavorabilita"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;currentFlow&quot;/>&lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('***INIZIO VERIFICHE LAVORABILITA PER FLUSSO ',$currentFlow/FLOW, ' ID_FLUSSO= ',string($currentFlow/ID_FLOW))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogKO-input"
                                    name="LogKO"
                                    tibex:xpdlId="c66827e4-28c8-4ee1-ba8e-7db15d80b9a9"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
