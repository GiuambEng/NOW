                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/StartPorting&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;Ouput&quot; match=&quot;/&quot;>&lt;tns:OutputData>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Esito>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($_error/StackTrace)>0&quot;>&lt;tns:DescrError>&lt;xsl:value-of select=&quot;concat('***ERROR - IMPOSSIBILE LAVORARE/RI-LAVORARE FILE IN QUANTO NON SPOSTATO NELLA FOLDER SORGENTE**' , tib:render-xml($_error))&quot;/>&lt;/tns:DescrError>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DescrError>&lt;xsl:value-of select=&quot;'***ERROR - IMPOSSIBILE LAVORARE/RI-LAVORARE FILE IN QUANTO NON SPOSTATO NELLA FOLDER SORGENTE**' &quot;/>&lt;/tns:DescrError>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:OutputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
