            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable name="LogLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LogLevel" type="xsd:string"/>
        <bpws:variable name="SSH_Host" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/SFTP/Machine/Host" type="xsd:string"/>
        <bpws:variable name="SSH_Port" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/SFTP/Machine/Port" type="xsd:int"/>
        <bpws:variable name="SSH_User" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/SFTP/Machine/User" type="xsd:string"/>
        <bpws:variable name="SSH_Password" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/SFTP/Machine/Password" type="tibprop:password"/>
        <bpws:variable name="Flag_SSH" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/SSH/Flag_SSH" type="xsd:string"/>
        <bpws:variable name="SourceFolder" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/PathFolder/File_Innesco/InnescoCRMW" type="xsd:string"/>
        <bpws:variable name="Codice_Interfaccia" type="xsd:string"/>
        <bpws:variable element="ns2:Input" name="CreateID_FILE-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:Output" name="CreateID_FILE" sca-bpel:internal="true"/>
        <bpws:variable name="Command" type="xsd:string"/>
        <bpws:variable name="PortingRoot" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/PathFolder/Root/PORTING_ROOT" type="xsd:string"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogSetCommand-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE" name="LogOK-input" sca-bpel:internal="true"/>
