        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="VerificaLavorabilitaDistrettoToCheckFolder" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckFolderToCallProcess1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CheckFolderToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="SetCodIntrfcToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CreateID_FILEToEmpty1" tibex:linkType="SUCCESS"/>
                <bpws:link name="SetCommandToLogSetCommand" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogSetCommandToCallShell" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallShellToLogOK" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogOKToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToKOMoved" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CreateID_FILEToAssign" tibex:linkType="ERROR"/>
                <bpws:link name="CallShellToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="SetErrorToUpdateKOLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="KOCallShellToUpdateKOLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpdateKOLoggerToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="KOMovedToTrackKO" tibex:linkType="SUCCESS"/>
                <bpws:link name="TrackKOToLogKO" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogKOToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="CallProcessToVerificaLavorabilitaDistretto" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEmpty" tibex:linkType="ERROR"/>
                <bpws:link name="EmptyToKOMoved" tibex:linkType="SUCCESS"/>
                <bpws:link name="MovedInSourceToSetCodIntrfc" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToTrackKO" tibex:linkType="SUCCESS"/>
                <bpws:link name="Empty1ToSetCommand" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="29a89a64-37ed-41bc-a4ec-a2c734c432a3"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess1"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="43dce873-669c-41d1-bdc1-f0910877df50" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogOKToEnd"/>
                        <bpws:target linkName="LogKOToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/StartPorting&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Ouput&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Ouput/tns:DescrError)>0&quot;>&lt;xsl:copy-of select=&quot;$Ouput&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OutputData>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Esito>&lt;/tns:OutputData>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="VerificaLavorabilitaDistretto-input"
                    name="VerificaLavorabilitaDistretto"
                    outputVariable="VerificaLavorabilitaDistretto"
                    tibex:xpdlId="71a91c94-3d1c-4d3b-a5b4-d58db1a4747c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToVerificaLavorabilitaDistretto"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="VerificaLavorabilitaDistrettoToCheckFolder"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/StartPorting&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavoabilitaDistretto&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;VerificaLavorabilitaDistretto-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;xsl:if test=&quot;$Start/tns:NOME_FILE&quot;>&lt;tns1:NOME_FILE>&lt;xsl:value-of select=&quot;$Start/tns:NOME_FILE&quot;/>&lt;/tns1:NOME_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:ID_TRACK&quot;>&lt;tns1:ID_TRACK>&lt;xsl:value-of select=&quot;$Start/tns:ID_TRACK&quot;/>&lt;/tns1:ID_TRACK>&lt;/xsl:if>&lt;tns1:LogElement>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;/tns1:LogElement>&lt;/tns1:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.porting.consistenze.CRMWS.VerificaLavorabilitaDistretto" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="CheckFolder" tibex:xpdlId="9bc6e460-2872-41de-aefc-a5c63ae54d62">
                <bpws:targets>
                    <bpws:target linkName="VerificaLavorabilitaDistrettoToCheckFolder"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckFolderToCallProcess1">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckFolderToAssign">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="contains($Start/tns:FOLDER_FILE, $SourceFolder)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[contains($Start/tns:FOLDER_FILE, $SourceFolder)]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Codice_Interfaccia"
                    name="SetCodIntrfc"
                    outputVariable="Codice_Interfaccia"
                    tibex:xpdlId="3002eefe-b071-43b1-a1c2-822c011fce0e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckFolderToAssign"/>
                        <bpws:target linkName="MovedInSourceToSetCodIntrfc"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SetCodIntrfcToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if ($Start/tns:FLOW = &quot;Porting ULL&quot;) then &quot;ID217&quot; else if ($Start/tns:FLOW = &quot;Porting ULLD&quot;) then &quot;ID218&quot; else if ($Start/tns:FLOW = &quot;Porting SLU&quot;) then &quot;ID219&quot; else if ($Start/tns:FLOW = &quot;Porting NP&quot;) then &quot;ID220&quot; else if ($Start/tns:FLOW = &quot;Porting Accessi ATM EASYIP&quot;) then &quot;ID221&quot; else if ($Start/tns:FLOW = &quot;Porting VC ATM EASYIP&quot;) then &quot;ID222&quot; else if ($Start/tns:FLOW = &quot;Porting Accessi GBE&quot;) then &quot;ID223&quot; else if ($Start/tns:FLOW = &quot;Porting VC GBE&quot;) then &quot;ID224&quot; else if ($Start/tns:FLOW = &quot;Porting Accessi NGA VULA&quot;) then &quot;ID225&quot; else if ($Start/tns:FLOW = &quot;Porting UserVLAN NGA VULA&quot;) then &quot;ID226&quot; else if ($Start/tns:FLOW = &quot;Porting WLR&quot;) then &quot;ID227&quot; else if ($Start/tns:FLOW = &quot;Porting STS WLR&quot;) then &quot;ID228&quot; else if ($Start/tns:FLOW = &quot;Porting Aggiuntivi WLR&quot;) then &quot;ID229&quot; else if ($Start/tns:FLOW = &quot;Porting VULL&quot;) then &quot;ID230&quot; else if ($Start/tns:FLOW = &quot;Porting SHA&quot;) then &quot;ID231&quot; else if ($Start/tns:FLOW = &quot;Porting CPS&quot;) then &quot;ID280&quot;&#xd;&#xa; else if ($Start/tns:FLOW = &quot;Porting ATM Simmetrico&quot;) then &quot;ID251&quot; &#xd;&#xa;else if ($Start/tns:FLOW = &quot;Porting ATM VC Simmetrico&quot;) then &quot;ID252&quot;&#xd;&#xa; else if ($Start/tns:FLOW = &quot;Porting GBE Simmetrico&quot;) then &quot;ID253&quot; &#xd;&#xa;else if ($Start/tns:FLOW = &quot;Porting GBE VC Simmetrico&quot;) then &quot;ID254&quot;&#xd;&#xa;else if ($Start/tns:FLOW = &quot;Porting VLAN NGA&quot;) then &quot;ID326&quot;&#xd;&#xa;else if ($Start/tns:FLOW = &quot;Porting VLAN GBE&quot;) then &quot;ID327&quot;&#xd;&#xa;else if ($Start/tns:FLOW = &quot;Porting VLAN VULA&quot;) then &quot;ID328&quot;&#xd;&#xa;else if ($Start/tns:FLOW = &quot;Porting VP&quot;) then &quot;ID336&quot;&#xd;&#xa;else if ($Start/tns:FLOW = &quot;Porting NPNG&quot;) then &quot;ID370&quot;&#xd;&#xa;else &quot;No Flow Found From FileName&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Codice_Interfaccia" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="CreateID_FILE-input"
                    name="CreateID_FILE" outputVariable="CreateID_FILE"
                    tibex:xpdlId="d2553287-7e98-4277-ac21-c75e19782766"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SetCodIntrfcToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CreateID_FILEToEmpty1"/>
                        <bpws:source linkName="CreateID_FILEToAssign"
                            tibex:faultDetailsVar="CreateID_FILE" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; xmlns:tns1=&quot;http://www.example.org/StartPorting&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Codice_Interfaccia&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CreateID_FILE-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:DataIn>&lt;tns:Insert>&lt;tns:InputFile>&lt;tns:CODICE_INTERFACCIA>&lt;xsl:value-of select=&quot;$Codice_Interfaccia&quot;/>&lt;/tns:CODICE_INTERFACCIA>&lt;xsl:if test=&quot;$Start/tns1:NOME_FILE&quot;>&lt;tns:NOME_FILE>&lt;xsl:value-of select=&quot;$Start/tns1:NOME_FILE&quot;/>&lt;/tns:NOME_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:DATA_FILE&quot;>&lt;tns:DATA_FILE>&lt;xsl:value-of select=&quot;$Start/tns1:DATA_FILE&quot;/>&lt;/tns:DATA_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:FILE_SIZE&quot;>&lt;tns:SIZE>&lt;xsl:value-of select=&quot;$Start/tns1:FILE_SIZE&quot;/>&lt;/tns:SIZE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:ID_TRACK&quot;>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;$Start/tns1:ID_TRACK&quot;/>&lt;/tns:ID_TRACK>&lt;/xsl:if>&lt;/tns:InputFile>&lt;/tns:Insert>&lt;/tns:DataIn>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ReadFile.ProcessLoggerTrack" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Command"
                    name="SetCommand" outputVariable="Command"
                    tibex:xpdlId="3ed1bd98-c42a-404f-8a1c-89add19b6bf9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToSetCommand"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SetCommandToLogSetCommand"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if( $Flag_SSH='Y') then&#xd;&#xa;concat(&quot;export PORTING_ROOT=&quot;, $PortingRoot,&quot;; cd &quot;, $PortingRoot,&quot;/CRMWS/Ksh/; nohup ./now_start_porting_crmws.sh&quot;, &quot; &quot;, $Start/tns:NOME_FILE, &quot; &quot;, string($CreateID_FILE/ns2:ID_FILE), &quot; 0 > /dev/null 2>&amp;1 &amp;&quot;)&#xd;&#xa;else&#xd;&#xa;concat('start_porting.sh CRMWS ', $PortingRoot, ' ', $Start/tns:NOME_FILE, ' ' ,string($CreateID_FILE/ns2:ID_FILE),' 0')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Command" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogSetCommand-input"
                    name="LogSetCommand"
                    tibex:xpdlId="3d6e4f05-270d-4857-b6ae-bd4adf3acc1b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SetCommandToLogSetCommand"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogSetCommandToCallShell"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;SSH_Host&quot;/>&lt;xsl:param name=&quot;SSH_User&quot;/>&lt;xsl:param name=&quot;Flag_SSH&quot;/>&lt;xsl:param name=&quot;PortingRoot&quot;/>&lt;xsl:param name=&quot;Command&quot;/>&lt;xsl:template name=&quot;LogSetCommand-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:Application>&lt;xsl:choose>&lt;xsl:when test=&quot;$Flag_SSH='N'&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;***COMANDO PER INVOCAZIONE SHELL: &amp;quot;, $Command )&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;***COMANDO PER INVOCAZIONE SSH SHELL: &amp;quot;, $Command , &amp;quot; PARAMETRI DI CONFIGURAZIONE SSH - HOST:&amp;quot;, $SSH_Host, &amp;quot; USER:&amp;quot;, $SSH_User, &amp;quot; PORTING_ROOT=&amp;quot;, $PortingRoot)&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
