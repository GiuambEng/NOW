    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="Iterate1ToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="SFTP_CheckInnescoCRMRetailToIterate1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="SFTP_CheckInnescoCRMRetailToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link
                    name="GenericLoggerToSFTP_CheckInnescoCRMRetail" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="Timer"
                    tibex:xpdlId="5ec46b4c-e944-452d-9271-ae6f1b79f3b2"
                    variable="Timer" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerToGenericLogger"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="Start2"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="IntervalloMinuti1"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="endTime" processProperty="End"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value endPolicy="END_TIME"
                                    intervalUnit="Minute" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="SFTP_CheckInnescoCRMRetail-input"
                    name="SFTP_CheckInnescoCRMRetail"
                    outputVariable="SFTP_CheckInnescoCRMRetail"
                    tibex:xpdlId="6138aaaa-e659-4e3d-98d4-53ed9f277276"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToSFTP_CheckInnescoCRMRetail"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SFTP_CheckInnescoCRMRetailToIterate1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SFTP_CheckInnescoCRMRetail/ns1:ListOfFiles)>0 and $SFTP_CheckInnescoCRMRetail/ns1:Status='OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($SFTP_CheckInnescoCRMRetail/ns1:ListOfFiles)>0 and $SFTP_CheckInnescoCRMRetail/ns1:Status='OK']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SFTP_CheckInnescoCRMRetailToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SFTP_Host&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Port&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_User&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Password&quot;/>&#xa;    &lt;xsl:param name=&quot;FilePathTappoCRMRetail&quot;/>&#xa;    &lt;xsl:template name=&quot;SFTP_CheckInnescoCRMRetail-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input_SFTP_DirDetail>&#xa;            &lt;tns1:Credentials>&#xa;                &lt;tns1:Host>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Host&quot;/>&#xa;                &lt;/tns1:Host>&#xa;                &lt;tns1:User>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_User&quot;/>&#xa;                &lt;/tns1:User>&#xa;                &lt;tns1:Password>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Password&quot;/>&#xa;                &lt;/tns1:Password>&#xa;                &lt;tns1:Port>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Port&quot;/>&#xa;                &lt;/tns1:Port>&#xa;            &lt;/tns1:Credentials>&#xa;            &lt;tns1:RequestType>&#xa;                &lt;tns1:ListOfFilesDetails>&#xa;                    &lt;tns1:DirectoryPath>&#xa;                        &lt;xsl:value-of select=&quot;$FilePathTappoCRMRetail&quot;/>&#xa;                    &lt;/tns1:DirectoryPath>&#xa;                    &lt;tns1:FileExtensionToFilter>&#xa;                        &lt;xsl:value-of select=&quot;'.TAPPO'&quot;/>&#xa;                    &lt;/tns1:FileExtensionToFilter>&#xa;                &lt;/tns1:ListOfFilesDetails>&#xa;            &lt;/tns1:RequestType>&#xa;        &lt;/tns1:Input_SFTP_DirDetail>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="SFTP.STFP_DirDetail" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="113b209a-1094-4b2d-83ee-68bc2021368c">
                <bpws:targets>
                    <bpws:target linkName="Iterate1ToExit"/>
                    <bpws:target linkName="SFTP_CheckInnescoCRMRetailToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:scope name="Iterate1" tibex:group="iterate" tibex:xpdlId="c8f2f00d-c4a2-4287-aa04-f7e6a90fb8d5">
                <bpws:targets>
                    <bpws:target linkName="SFTP_CheckInnescoCRMRetailToIterate1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Iterate1ToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence1" tibex:group="iterate">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate1"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$SFTP_CheckInnescoCRMRetail/ns1:ListOfFiles" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($SFTP_CheckInnescoCRMRetail/ns1:ListOfFiles)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope1">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns1:Iterate1_Current_Element_ListOfFiles"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow2">
                                <bpws:links>
                                    <bpws:link
                                    name="Track_CRMRetail_FilesToGroupEnd1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart1ToAssign" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="SetSystemFromNameToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Track_CRMRetail_FilesToCallProcess" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="CallProcessToGroupEnd1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToTrack_CRMRetail_Files" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart1"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="b77145b1-9c60-4794-96d2-a7f79e28328a" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToAssign"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($SFTP_CheckInnescoCRMRetail/ns1:ListOfFiles)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd1"
                                    tibex:group="groupEnd" tibex:xpdlId="04333b49-3706-499b-85e0-c7413e49d247">
                                    <bpws:targets>
                                    <bpws:target linkName="Track_CRMRetail_FilesToGroupEnd1"/>
                                    <bpws:target linkName="CallProcessToGroupEnd1"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="Track_CRMRetail_Files-input"
                                    name="Track_CRMRetail_Files"
                                    tibex:xpdlId="3cef5d16-0579-4b53-bb9c-5cdd6a5bb583"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToTrack_CRMRetail_Files"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Track_CRMRetail_FilesToGroupEnd1"/>
                                    <bpws:source
                                    linkName="Track_CRMRetail_FilesToCallProcess"
                                    tibex:faultDetailsVar="Track_CRMRetail_Files" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:tns2=&quot;http://www.example.org/CheckNomeFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Host&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Port&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_User&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Password&quot;/>&#xa;    &lt;xsl:param name=&quot;System&quot;/>&#xa;    &lt;xsl:param name=&quot;PathStoricoTappoCRMRetail&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliNomeFile&quot;/>&#xa;    &lt;xsl:param name=&quot;PathError&quot;/>&#xa;    &lt;xsl:template name=&quot;Track_CRMRetail_Files-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:InputFileTappo>&#xa;            &lt;tns1:FileName>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns3:FullName&quot;/>&#xa;            &lt;/tns1:FileName>&#xa;            &lt;tns1:LogName>&#xa;                &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;            &lt;/tns1:LogName>&#xa;            &lt;tns1:LogLevel>&#xa;                &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;            &lt;/tns1:LogLevel>&#xa;            &lt;tns1:ApplicationName>&#xa;                &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;            &lt;/tns1:ApplicationName>&#xa;            &lt;tns1:Estensione>&#xa;                &lt;xsl:value-of select=&quot;'.csv'&quot;/>&#xa;            &lt;/tns1:Estensione>&#xa;            &lt;tns1:Sistema>&#xa;                &lt;xsl:value-of select=&quot;$System&quot;/>&#xa;            &lt;/tns1:Sistema>&#xa;            &lt;tns1:Flusso>&#xa;                &lt;xsl:value-of select=&quot;$ControlliNomeFile/tns2:FLUSSO&quot;/>&#xa;            &lt;/tns1:Flusso>&#xa;            &lt;tns1:PathError>&#xa;                &lt;xsl:value-of select=&quot;$PathError&quot;/>&#xa;            &lt;/tns1:PathError>&#xa;            &lt;tns1:PathMovedTappo>&#xa;                &lt;xsl:value-of select=&quot;$PathStoricoTappoCRMRetail&quot;/>&#xa;            &lt;/tns1:PathMovedTappo>&#xa;            &lt;tns1:Flag_SFTP_Mode>&#xa;                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;            &lt;/tns1:Flag_SFTP_Mode>&#xa;            &lt;tns1:SFTPInputData>&#xa;                &lt;tns1:Host>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Host&quot;/>&#xa;                &lt;/tns1:Host>&#xa;                &lt;tns1:Port>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Port&quot;/>&#xa;                &lt;/tns1:Port>&#xa;                &lt;tns1:User>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_User&quot;/>&#xa;                &lt;/tns1:User>&#xa;                &lt;tns1:Password>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Password&quot;/>&#xa;                &lt;/tns1:Password>&#xa;            &lt;/tns1:SFTPInputData>&#xa;        &lt;/tns1:InputFileTappo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile_SFTPMode.GestioneLetturaTracciamento" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="System"
                                    name="SetSystemFromName"
                                    outputVariable="System"
                                    tibex:xpdlId="f5be0fc4-221c-4cdb-8c0f-06c50d23bbed" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SetSystemFromNameToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (contains($currentElement/ns1:FileName, '_CRMB_')) then 'CRMB'&#xd;&#xa;else if (contains($currentElement/ns1:FileName, '_CBCRMR') or  contains($currentElement/ns1:FileName, '_CRMRW')) then 'CRMR' else 'ERROR FIND SYSTEM'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="System" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogKOTrackBSS-input"
                                    name="LogKOTrackBSS"
                                    tibex:xpdlId="5c8006e7-242f-4097-9ee1-6051c8dfb29a"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Track_CRMRetail_FilesToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;LogKOTrackBSS-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($_error)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="ControlliNomeFile-input"
                                    name="ControlliNomeFile"
                                    outputVariable="ControlliNomeFile"
                                    tibex:xpdlId="23239858-dc06-44c3-b467-9051028ffcc8"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SetSystemFromNameToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToTrack_CRMRetail_Files"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; xmlns:tns1=&quot;http://www.example.org/CheckNomeFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;System&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;tns1:FILE_NAME>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns2:FileName&quot;/>&#xa;            &lt;/tns1:FILE_NAME>&#xa;            &lt;tns1:SYSTEM>&#xa;                &lt;xsl:value-of select=&quot;$System&quot;/>&#xa;            &lt;/tns1:SYSTEM>&#xa;        &lt;/tns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.porting.consistenze.common.ControlloNomeFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="GenericLogger-input"
                    name="GenericLogger"
                    tibex:xpdlId="6c83025f-ca90-4499-949d-50c65d1a6b9b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToSFTP_CheckInnescoCRMRetail"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Avviato processo BSS TrackingFiles'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
