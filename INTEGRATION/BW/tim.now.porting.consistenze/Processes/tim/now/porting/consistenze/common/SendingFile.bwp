                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+49c2e710-3a2b-492d-94fd-9c2604e6b6f9+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/EstraiDataFile&quot; xmlns:tns2=&quot;http://www.example.org/FileRiscontro&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FindIDFlow&quot;/>&lt;xsl:param name=&quot;GetDataFile&quot;/>&lt;xsl:param name=&quot;Flow_Name&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;UpdTrack-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;FLOW>&lt;xsl:value-of select=&quot;$Flow_Name&quot;/>&lt;/FLOW>&lt;DATA_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GetDataFile/tns1:DATA_FILE)&quot;>&lt;xsl:value-of select=&quot;$GetDataFile/tns1:DATA_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATA_FILE>&lt;ID_FLOW>&lt;xsl:value-of select=&quot;xsd:int($FindIDFlow/Record[1]/ID_FLOW)&quot;/>&lt;/ID_FLOW>&lt;ID_TRACK>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:ID_TRACK)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:ID_TRACK&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_TRACK>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE APPUSER.ALIGN_RESULT_TRACKING&#xa;  SET FLOW = ?, LAST_UPDATE = SYSDATE, DATA_FILE = TO_DATE(?,'YYYYMMDD HH24MISS'),&#xa;   ID_FLOW = ?, DATA_INSERIMENTO=SYSDATE&#xa;   WHERE ID_TRACK=?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLOW"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATA_FILE"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FLOW"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_TRACK"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if (contains($Start/ns7:NOME_FILE, 'PORTINGULL_')) then 'Porting ULL'&#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGULLD_')) then 'Porting ULLD' &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGSLU_')) then 'Porting SLU' &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGNP_')) then 'Porting NP'  &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGATM_')) then 'Porting Accessi ATM EASYIP' &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGATMVC_')) then 'Porting VC ATM EASYIP' &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGGBE_'))  then 'Porting Accessi GBE' &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGGBEVC_'))  then 'Porting VC GBE'&#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGNGA_'))  then 'Porting Accessi NGA VULA' &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGNGAUV_'))  then 'Porting UserVLAN NGA VULA' &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGWLR_')) then 'Porting WLR' &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGWLRSTS_'))  then 'Porting STS WLR'&#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGWLRAGG_'))  then 'Porting Aggiuntivi WLR'&#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGVULL_'))  then 'Porting VULL' &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGSHA_'))  then 'Porting SHA' &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGGBESIMM_'))  then 'Porting GBE Simmetrico' &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGATMSIMM_'))  then 'Porting ATM Simmetrico' &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGATMSIMMVC_'))  then 'Porting ATM VC Simmetrico' &#xd;&#xa;else if (contains($Start/ns7:NOME_FILE, 'PORTINGGBESIMMVC_'))  then 'Porting GBE VC Simmetrico' &#xd;&#xa;else 'No Flow Found From FileName'"
