        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+9028184d-468b-4593-a6b7-c454a20aae5c+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+9028184d-468b-4593-a6b7-c454a20aae5c+input">
            <element name="jdbcUpdateActivityInput">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record">
                            <complexType>
