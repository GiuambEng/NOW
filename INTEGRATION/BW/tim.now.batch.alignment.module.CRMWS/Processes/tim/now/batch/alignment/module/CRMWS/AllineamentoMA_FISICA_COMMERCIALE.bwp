                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="JDBCUpdate1-input"
                                name="JDBCUpdate1"
                                outputVariable="JDBCUpdate1"
                                tibex:xpdlId="23437313-58b9-4f73-b214-8152c974b5dd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="Err_LogToJDBCUpdate1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="JDBCUpdate1ToGestioneMovedFile"/>
                                    <bpws:source
                                    linkName="JDBCUpdate1ToEmpty1"
                                    tibex:faultDetailsVar="JDBCUpdate1" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+23437313-58b9-4f73-b214-8152c974b5dd+input&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE)&quot;/>&lt;/ID_FILE>&lt;SISTEMA>&lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&lt;/SISTEMA>&lt;FLUSSO>&lt;xsl:value-of select=&quot;'AnagraficaCOW'&quot;/>&lt;/FLUSSO>&lt;DETAILS>&lt;xsl:value-of select=&quot;concat(substring-before($JMSReceiveMessage/Body/ns1:queueResponse/ns1:FILENAME, &amp;quot;.ctr&amp;quot;),&amp;quot;.csv&amp;quot;)&quot;/>&lt;/DETAILS>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&lt;/DESCR_ERRORE>&lt;STATO>&lt;xsl:value-of select=&quot;'KO TECNICO'&quot;/>&lt;/STATO>&lt;ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ID_ESEC_PROCSO_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBC_Timeout"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STATO_ALLINEAMENTI (ID_FILE, SISTEMA, FLUSSO,&#xa;  DETAILS, DESCR_ERRORE, FLAG_LETTURA, STATO, ID_ESEC_PROCSO_FILE, CREATED)&#xa;  VALUES (?, ?, ?, ?, ?, 'Y', ?, ?, SYSDATE)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SISTEMA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLUSSO"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DETAILS"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DESCR_ERRORE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO"/>
                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_ESEC_PROCSO_FILE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
