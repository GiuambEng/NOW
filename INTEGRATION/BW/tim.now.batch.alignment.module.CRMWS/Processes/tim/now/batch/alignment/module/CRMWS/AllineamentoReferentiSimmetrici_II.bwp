D_NOW&quot;/>&lt;/tns2:ID_ASSET>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:ID_CRMWS&quot;>&lt;tns2:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;tns3:ID_CRMWS&quot;/>&lt;/tns2:ID_ASSET_CRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:QUALIFICA_REF&quot;>&lt;tns2:QUALIF_REFERENTE>&lt;xsl:value-of select=&quot;tns3:QUALIFICA_REF&quot;/>&lt;/tns2:QUALIF_REFERENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:COGNOME_REF&quot;>&lt;tns2:COGN_REFERENTE>&lt;xsl:value-of select=&quot;tns3:COGNOME_REF&quot;/>&lt;/tns2:COGN_REFERENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:NOME_REF&quot;>&lt;tns2:NOME_REFERENTE>&lt;xsl:value-of select=&quot;tns3:NOME_REF&quot;/>&lt;/tns2:NOME_REFERENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:FISSO_REF&quot;>&lt;tns2:TEL_FISSO_REFERENTE>&lt;xsl:value-of select=&quot;tns3:FISSO_REF&quot;/>&lt;/tns2:TEL_FISSO_REFERENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:MOBILE_REF&quot;>&lt;tns2:TEL_MOBILE_REFERENTE>&lt;xsl:value-of select=&quot;tns3:MOBILE_REF&quot;/>&lt;/tns2:TEL_MOBILE_REFERENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:EMAIL_REF&quot;>&lt;tns2:EMAIL_REFERENTE>&lt;xsl:value-of select=&quot;tns3:EMAIL_REF&quot;/>&lt;/tns2:EMAIL_REFERENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;>&lt;tns2:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;/>&lt;/tns2:CONTENUTO_RECD>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&lt;tns2:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&lt;/tns2:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;tns2:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_FILE&quot;/>&lt;/tns2:ID_STATO_ELAB_STAG>&lt;tns2:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var1&quot;/>&lt;/tns2:NUMERO_RECD>&lt;tns2:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns2:TMSP_INSMTO>&lt;/tns2:R