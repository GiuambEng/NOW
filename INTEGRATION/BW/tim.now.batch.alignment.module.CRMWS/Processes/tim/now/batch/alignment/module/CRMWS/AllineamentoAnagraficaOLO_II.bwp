                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_ANAG_OLO (COD_OLO, COD_OLO_ACCORPANTE,&#xa;  CODFC_AGCOM_OLO_ACCORPANTE, CODFC_OLO_AGCOM, CODFC_OLO_RETE,&#xa;  DATA_ACCORPTO, FLAG_OLO_ACCORPANTE, FLAG_SAN_MARINO, ID_FILE_PROCSTO_INPUT,&#xa;  ID_STATO_ELAB_STAG, INDIRIZZO_EMAIL, MOROSO, NOME, NUMERO_RECD,&#xa;  PARTITA_IVA, RAGIONE_SOCIALE, STATO_ACCORPTO, TIPOLG_OLO, TMSP_INSMTO,&#xa;  CONTENUTO_RECD)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,&#xa;    ?, RTRIM(?, CHR(10) || CHR(13)))" xsi:type="jdbcPalette:JDBCUpdateActivity">

