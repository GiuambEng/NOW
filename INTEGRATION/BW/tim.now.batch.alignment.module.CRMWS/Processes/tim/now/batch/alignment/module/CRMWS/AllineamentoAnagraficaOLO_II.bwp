L>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:OLO_ACCORPANTE_FLAG&quot;>&lt;tns:OLO_ACCORPANTE_FLAG>&lt;xsl:value-of select=&quot;tns1:OLO_ACCORPANTE_FLAG&quot;/>&lt;/tns:OLO_ACCORPANTE_FLAG>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_OLO_ACCORPANTE&quot;>&lt;tns:CODICE_OLO_ACCORPANTE>&lt;xsl:value-of select=&quot;tns1:CODICE_OLO_ACCORPANTE&quot;/>&lt;/tns:CODICE_OLO_ACCORPANTE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_ALFANUMERICO_OLO_ACCORPANTE&quot;>&lt;tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE>&lt;xsl:value-of select=&quot;tns1:CODICE_ALFANUMERICO_OLO_ACCORPANTE&quot;/>&lt;/tns:CODICE_ALFANUMERICO_OLO_ACCORPANTE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:STATO_ACCORPAMENTO&quot;>&lt;tns:STATO_ACCORPAMENTO>&lt;xsl:value-of select=&quot;tns1:STATO_ACCORPAMENTO&quot;/>&lt;/tns:STATO_ACCORPAMENTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DATA_ACCORPAMENTO&quot;>&lt;tns:DATA_ACCORPAMENTO>&lt;xsl:value-of select=&quot;tns1:DATA_ACCORPAMENTO&quot;/>&lt;/tns:DATA_ACCORPAMENTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Flag_Validita&quot;>&lt;tns:Flag_Validita>&lt;xsl:value-of select=&quot;tns1:Flag_Validita&quot;/>&lt;/tns:Flag_Validita>&lt;/xsl:if>&lt;tns:NumeroRecd>&lt;xsl:value-of select=&quot;(($Passo_AnagraficaOLO * ($index -1)) + position())&quot;/>&lt;/tns:NumeroRecd>&lt;/tns:AnagOLO_inputContenutoRecd>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:InputContenutoRecdAnagraficaOLO>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
