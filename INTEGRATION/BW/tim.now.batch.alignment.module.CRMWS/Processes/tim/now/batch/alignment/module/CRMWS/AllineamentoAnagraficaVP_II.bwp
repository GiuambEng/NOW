                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVP_SubProcess&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVP_Tracciato&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;Passo_CRMWS_VP&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;Input_Sub&quot; match=&quot;/&quot;>&lt;tns:AllineamentoVP_Noval>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($DetailNoVal/Rows/tns2:AllineamentoVP_Dettaglio_Noval[1]/tns2:Tipo_record)>0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns2:AllineamentoVP_Dettaglio_Noval&quot;>&lt;tns:AllineamentoVP_Dettaglio_Noval>&lt;xsl:if test=&quot;tns2:Tipo_record&quot;>&lt;tns:Tipo_record>&lt;xsl:value-of select=&quot;tns2:Tipo_record&quot;/>&lt;/tns:Tipo_record>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:ID_RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;tns2:ID_RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:STATO&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;tns2:STATO&quot;/>&lt;/tns:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:MOD_FATT&quot;>&lt;tns:MOD_FATT>&lt;xsl:value-of select=&quot;tns2:MOD_FATT&quot;/>&lt;/tns:MOD_FATT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:TIPO&quot;>&lt;tns:TIPO>&lt;xsl:value-of select=&quot;tns2:TIPO&quot;/>&lt;/tns:TIPO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:BANDA_MCR&quot;>&lt;tns:BANDA_MCR>&lt;xsl:value-of select=&quot;tns2:BANDA_MCR&quot;/>&lt;/tns:BANDA_MCR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:BANDA