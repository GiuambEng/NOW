s2:DESC_ADR&quot;/>&lt;/tns:DESC_ADR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:TD_KIT&quot;>&lt;tns:TD_KIT>&lt;xsl:value-of select=&quot;tns2:TD_KIT&quot;/>&lt;/tns:TD_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:VPI_RETE&quot;>&lt;tns:VPI_RETE>&lt;xsl:value-of select=&quot;tns2:VPI_RETE&quot;/>&lt;/tns:VPI_RETE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:VPI&quot;>&lt;tns:VPI>&lt;xsl:value-of select=&quot;tns2:VPI&quot;/>&lt;/tns:VPI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:OLO_CODING&quot;>&lt;tns:OLO_CODING>&lt;xsl:value-of select=&quot;tns2:OLO_CODING&quot;/>&lt;/tns:OLO_CODING>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:OLO_CODE&quot;>&lt;tns:OLO_CODE>&lt;xsl:value-of select=&quot;tns2:OLO_CODE&quot;/>&lt;/tns:OLO_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:TIPO_TRASPORTO&quot;>&lt;tns:TIPO_TRASPORTO>&lt;xsl:value-of select=&quot;tns2:TIPO_TRASPORTO&quot;/>&lt;/tns:TIPO_TRASPORTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:CLLI&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;tns2:CLLI&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:NOME_CENTRALE&quot;>&lt;tns:NOME_CENTRALE>&lt;xsl:value-of select=&quot;tns2:NOME_CENTRALE&quot;/>&lt;/tns:NOME_CENTRALE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:DEC_ATT&quot;>&lt;tns:DEC_ATT>&lt;xsl:value-of select=&quot;tns2:DEC_ATT&quot;/>&lt;/tns:DEC_ATT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:DEC&quot;>&lt;tns:DEC>&lt;xsl:value-of select=&quot;tns2:DEC&quot;/>&lt;/tns:DEC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:FlagValidita&quot;>&lt;tns:FlagValidita>&lt;xsl:value-of select=&quot;tns2:FlagValidita&quot;/>&lt;/tns:FlagValidita>&lt;/xsl:if>&lt;tns:Numero_Record>&lt;xsl:value-of select=&quot;(($Passo_CRMWS_VP * ($index -1)) + position())&quot;/>&lt;/tns:Numero_Record>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&lt;/tns:ID_FILE>&lt;/xsl:if>&lt;/tns:AllineamentoVP_Dettaglio_Noval>&lt;/xsl:for-each>&lt;/xsl:o