                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_ANAG_VP_FILE (BANDA_MCR, BANDA_PCR, CLLI,&#xa;  COD_AREA_RACCOLTA, COD_KIT, COD_OLO, COD_VP, CODFC_OLO_AGCOM,&#xa;  CONTENUTO_RECD, DEC, DEC_ATTIVAZIONE, DESC_AREA_RACCOLTA, ID_FILE_PROCSTO_INPUT,&#xa;  ID_STATO_ELAB_STAG, MODALITA_FATTURAZIONE, NOME_CENTRALE, NUMERO_MAX_VC,&#xa;  NUMERO_RECD, STATO, TIPO, TIPO_TRASPORTO, TMSP_INSMTO, VPI,&#xa;  VPI_RETE)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)), ?, ?, ?, ?, ?, ?, ?, ?, ?,&#xa;    ?, ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

