                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5e56bc39-aeb7-4fae-a29d-b4f68df5ae5a+input&quot; xmlns:tns1=&quot;http://www.tim.com/log/AnagraficaContratti_Staging&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_InputStaging&quot;/>&lt;xsl:template name=&quot;Update_Staging-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Var_InputStaging/tns1:AnagraficaContratti_dettaglio&quot;>&lt;Record>&lt;COD_CONTRATTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:COD_CONTRATTO)&quot;>&lt;xsl:value-of select=&quot;tns1:COD_CONTRATTO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_CONTRATTO>&lt;COD_CONTRATTO_CRMWS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:COD_CONTRATTO_CRMWS)&quot;>&lt;xsl:value-of select=&quot;tns1:COD_CONTRATTO_CRMWS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_CONTRATTO_CRMWS>&lt;COD_CONTRATTO_PADRE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:COD_CONTRATTO_PADRE)&quot;>&lt;xsl:value-of select=&quot;tns1:COD_CONTRATTO_PADRE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_CONTRATTO_PADRE>&lt;COD_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:COD_OLO)&quot;>&lt;xsl:value-of select=&quot;tns1:COD_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_OLO>&lt;C