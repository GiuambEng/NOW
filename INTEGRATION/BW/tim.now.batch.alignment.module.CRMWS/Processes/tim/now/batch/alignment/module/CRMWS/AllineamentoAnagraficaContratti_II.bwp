                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/log/tim.now.xsd.AnagraficaContratti_InputSubProcess&quot; xmlns:tns1=&quot;http://www.tim.com/log/AnagraficaContratti_Tracciato&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;Passo_AnagraficaContratti&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;Var_InputSub&quot; match=&quot;/&quot;>&lt;tns:AnagraficaContratti>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($DetailNoVal/Rows/tns1:AnagraficaContratti_dettaglio[1]/tns1:Tipo_record)>0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AnagraficaContratti_dettaglio&quot;>&lt;tns:AnagraficaContratti_dettaglio>&lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&lt;tns:Tipo_record>&lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&lt;/tns:Tipo_record>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:AGREE_NUMBER&quot;>&lt;tns:AGREE_NUMBER>&lt;xsl:value-of select=&quot;tns1:AGREE_NUMBER&quot;/>&lt;/tns:AGREE_NUMBER>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:AGREE_ID_CRMWS&quot;>&lt;tns:AGREE_ID_CRMWS>&lt;xsl:value-of select=&quot;tns1:AGREE_ID_CRMWS&quot;/>&lt;/tns:AGREE_ID_CRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:AGREE_NAME&quot;>&lt;tns:AGREE_NAME>&lt;xsl:value-of select=&quot;tns1:AGREE_NAME&quot;/>&lt;/tns:AGREE_NAME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_OLO&quot;>&lt;tns:CODICE_OLO>&lt;xsl:value-of select=&quot;tns1:CODICE_OLO&quot;/>&lt;/tns:CODICE_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_OLO_CRMWS&quot;>&lt;tns:CODICE_OLO_CRMWS>&lt;xsl:value-of select=&quot;tns1:CODICE_OLO_CRMWS&quot;/>&lt;/tns:CODICE_OLO_CRMWS>&lt;/xsl:if>&lt;xsl:if test=&q