                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/log/AnagraficaContratti_Staging&quot; xmlns:tns1=&quot;http://www.tim.com/log/AnagraficaContratti_Tracciato&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;OK_ELAB_FILE&quot;/>&lt;xsl:param name=&quot;Passo_AnagraficaContratti&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ContenutoRecord&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;Var_InputStaging&quot; match=&quot;/&quot;>&lt;tns:AnagraficaContratti>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:AnagraficaContratti_dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AnagraficaContratti_dettaglio&quot;>&lt;tns:AnagraficaContratti_dettaglio>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_AnagraficaContratti * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:AGREE_NUMBER&quot;>&lt;tns:COD_CONTRATTO>&lt;xsl:value-of select=&quot;tns1:AGREE_NUMBER&quot;/>&lt;/tns:COD_CONTRATTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:AGREE_ID_CRMWS&quot;>&lt;tns:COD_CONTRATTO_CRMWS>&lt;xsl:value-of select=&quot;tns1:AGREE_ID_CRMWS&quot;/>&lt;/tns:COD_CONTRATTO_CRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ID_TEMPLATE_PADRE&quot;>&lt;tns:COD_CONTRATTO_PADRE>&lt;xsl:value-of select=&quot;tns1:ID_TEMPLATE_PADRE&quot;/>&lt;/tns:COD_CONTRATTO_PADRE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_OLO_CRMWS&quot;>&lt;tns:COD_OLO>&lt;xsl:value-of select=&quot;tns1:CODICE_OLO_CRMWS&quot;/>&lt;/tns:COD_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_OLO&quot;>&lt;tns:CODF