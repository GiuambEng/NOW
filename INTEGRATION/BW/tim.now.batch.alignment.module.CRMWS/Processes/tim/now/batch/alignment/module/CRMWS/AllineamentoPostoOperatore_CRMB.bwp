                <bpws:link name="CallProcessToThrow" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToInsert" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="TrackFileToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpCountToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogEndToExit1" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToMapDetails" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapDetailsToCallProcess1" tibex:linkType="SUCCESS"/>
