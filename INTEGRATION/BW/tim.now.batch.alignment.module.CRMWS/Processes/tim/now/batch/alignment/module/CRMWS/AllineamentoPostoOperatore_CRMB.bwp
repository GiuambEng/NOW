    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="JMSReceiveMessageToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEmpty" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="EmptyToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess1ToCallProcess2" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess2ToCallProcess3" tibex:linkType="SUCCESS"/>
