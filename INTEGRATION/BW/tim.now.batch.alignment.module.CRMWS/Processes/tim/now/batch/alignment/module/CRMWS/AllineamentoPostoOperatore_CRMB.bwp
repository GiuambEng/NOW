            </bpws:exit>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="df918f51-faa8-4d63-ae23-88d23a43accd">
                <bpws:targets>
                    <bpws:target linkName="UpCountToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToMapDetails">
                        <tibex:DesignExpression/>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;((($JMSReceiveMessage/Body/ns3:queueResponse/ns3:NumeroRecord) div $PassoAllineamentoPostoOperatore) +1)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <((($JMSReceiveMessage/Body/ns3:queueResponse/ns3:NumeroRecord) div $PassoAllineamentoPostoOperatore) +1)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToParseData" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="GroupStartToParseData1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="DetailNoValToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="DetailUltimi_NoValToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="StartElaborazioneToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty1ToCallProcess1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="LogRecordFinitiToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Input_StagingToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Empty1ToStartElaborazione" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="ContenutoRecordToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcess1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogStagingToJDBCUpdate" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCUpdateToLogOKStaging" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="3fc43fbd-11d9-49e0-a6eb-ce1866d261ba">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToParseData">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index &lt;= (($JMSReceiveMessage/Body/ns3:queueResponse/ns3:NumeroRecord) div $PassoAllineamentoPostoOperatore)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$index <= (($JMSReceiveMessage/Body/ns3:queueResponse/ns3:NumeroRecord) div $PassoAllineamentoPostoOperatore)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToParseData1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="441ed69c-4a89-4f23-9af5-5c7359b5b15b">
                                <bpws:targets>
                                    <bpws:target linkName="LogRecordFinitiToGroupEnd"/>
                                    <bpws:target linkName="CallProcess1ToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="DetailNoVal-input"
                                    name="DetailNoVal"
                                    outputVariable="DetailNoVal"
                                    tibex:xpdlId="0b6dcf2b-d8b7-4b7f-a211-78ba2e137dff" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToParseData"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DetailNoValToEmpty1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/parse/xsd/+0b6dcf2b-d8b7-4b7f-a211-78ba2e137dff+input&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PassoAllineamentoPostoOperatore&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;DetailNoVal-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;fileName>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;/>&lt;/fileName>&lt;startRecord>&lt;xsl:value-of select=&quot;($index -1) * $PassoAllineamentoPostoOperatore +2&quot;/>&lt;/startRecord>&lt;noOfRecords>&lt;xsl:value-of select=&quot;$PassoAllineamentoPostoOperatore&quot;/>&lt;/noOfRecords>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.parse.parsedata"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:parse="http://ns.tibco.com/bw/palette/parse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/parse#//ParseData"/>
                                    <value
                                    continueOnError="true"
                                    dataFormat="dataFormatResource"
                                    encoding="ASCII"
                                    inputType="File"
                                    manuallySpecifiedStartRecord="true"
                                    skipBlankSpaces="true" xsi:type="parse:ParseData"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="DetailUltimi_NoVal-input"
                                    name="DetailUltimi_NoVal"
                                    outputVariable="DetailUltimi_NoVal"
                                    tibex:xpdlId="7cefbdcb-27f5-42e9-8176-67458255352c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToParseData1"/>
