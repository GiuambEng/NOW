            <plnk:partnerLinkType name="partnerLinkType4">
                <plnk:role name="use" portType="ptyp6:CreaFile"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/ProcessLog"/>
            <wsdl:import namespace="http://www.tibco.com/AllineamentoBatch/ContaRecord_Concrete/"/>
            <wsdl:import namespace="http://www.tibco.com/AllineamentoBatch/ContaRecord/"/>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/"/>
            <wsdl:import namespace="http://xmlns.example.com/1463585496988"/>
        </wsdl:definitions>
