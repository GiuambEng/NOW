                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_ANAG_SLA_ASSRCE_FILE (COD_CONTRATTO,&#xa;  CONTENUTO_RECD, COPERTURA_ORARIA, DATAINZ_NOL,&#xa;  ID_RISORSA, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG, NUMERO_RECD,&#xa;  OFFERTA_SLA, TIPO_AZIONE, TIPO_SLA, TIPOLG_CONTRATTO, TMSP_INSMTO)&#xa;  VALUES (?, RTRIM(?, CHR(10) || CHR(13)), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

