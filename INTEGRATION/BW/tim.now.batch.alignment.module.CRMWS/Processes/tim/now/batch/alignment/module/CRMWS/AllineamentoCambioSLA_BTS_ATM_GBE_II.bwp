                                    sqlStatement="UPDATE STAG_ANAG_SLA_ASSRCE_FILE&#xa;  SET DESCR_ERRORE = ?, ID_STATO_ELAB_STAG = ?&#xa;  WHERE ID_RISORSA = ? AND ID_FILE_PROCSTO_INPUT = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

