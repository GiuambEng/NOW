                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=(($JMSReceiveMessage/Body/ns27:queueResponse/ns27:NumeroRecord div $Passo_AllineamentoOloPrevalenti) +1)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=(($JMSReceiveMessage/Body/ns27:queueResponse/ns27:NumeroRecord div $Passo_AllineamentoOloPrevalenti) +1)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="CallProcessToCallProcess11" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToCallProcess" tibex:linkType="SUCCESS"/>
