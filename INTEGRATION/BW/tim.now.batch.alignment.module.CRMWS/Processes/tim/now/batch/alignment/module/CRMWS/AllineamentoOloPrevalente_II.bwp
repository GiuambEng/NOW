            targetNamespace="http://xmlns.example.com/20160822111627PLT"
            xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype"
            xmlns:ptyp="http://www.tim.com/NOW/wsdl/abstract/ProcessLog"
