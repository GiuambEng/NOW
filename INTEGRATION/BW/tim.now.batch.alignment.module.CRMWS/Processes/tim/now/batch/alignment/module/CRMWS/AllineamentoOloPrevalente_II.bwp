            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="22bc43e9-b905-4fac-b639-dfab10834cb3">
                <bpws:targets>
                    <bpws:target linkName="UpCountToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToMapDetails"/>
                </bpws:sources>
                <bpws:variables>
