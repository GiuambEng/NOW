                                <bpws:link name="AssignToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcess1ToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Empty2ToContenutoRecord" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Empty2ToCallProcess2" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="DetailNoValToStartElaborazione" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="StartElaborazioneToEmpty2" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="DetailUltimi_NoValToStartElaborazione" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess5ToDetailNoVal" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess6ToDetailUltimi_NoVal" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Invoke_SubprocessToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcess2ToGroupEnd" tibex:linkType="SUCCESS"/>
