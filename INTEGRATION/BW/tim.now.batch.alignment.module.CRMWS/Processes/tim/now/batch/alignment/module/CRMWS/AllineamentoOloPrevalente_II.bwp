                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3b11f61b-6fff-4f22-8173-8a11fe55ea47+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE)&quot;/>&lt;/ID_FILE>&lt;SISTEMA>&lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&lt;/SISTEMA>&lt;FLUSSO>&lt;xsl:value-of select=&quot;'AllineamentoOloPrevalente'&quot;/>&lt;/FLUSSO>&lt;DETAILS>&lt;xsl:value-of select=&quot;concat(substring-before($JMSReceiveMessage/Body/ns1:queueResponse/ns1:FILENAME, &amp;quot;.ctr&amp;quot;),&amp;quot;.csv&amp;quot;)&quot;/>&lt;/DETAILS>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&lt;/DESCR_ERRORE>&lt;STATO>&lt;xsl:value-of select=&quot;'KO TECNICO'&quot;/>&lt;/STATO>&lt;ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ID_ESEC_PROCSO_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
