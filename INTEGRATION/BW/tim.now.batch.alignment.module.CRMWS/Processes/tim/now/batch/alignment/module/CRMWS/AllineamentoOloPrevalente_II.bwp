                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoOloPrevalente_Subprocess&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoOloPrevalente_Tracciato&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;Passo_AllineamentoOloPrevalenti&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;Var_InputSub&quot; match=&quot;/&quot;>&lt;tns:AllineamentoOloPrevalente>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:AllineamentoOloPrevalenteDettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AllineamentoOloPrevalenteDettaglio&quot;>&lt;tns:AllineamentoOloPrevalenteTracciato>&lt;xsl:if test=&quot;tns1:Tipo_Record&quot;>&lt;tns:Tipo_Record>&lt;xsl:value-of select=&quot;tns1:Tipo_Record&quot;/>&lt;/tns:Tipo_Record>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_ISP&quot;>&lt;tns:CODICE_ISP>&lt;xsl:value-of select=&quot;tns1:CODICE_ISP&quot;/>&lt;/tns:CODICE_ISP>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_OLO&quot;>&lt;tns:CODICE_OLO>&lt;xsl:value-of select=&quot;tns1:CODICE_OLO&quot;/>&lt;/tns:CODICE_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FlagValidita&quot;>&lt;tns:FlagValidita>&lt;xsl:value-of select=&quot;tns1:FlagValidita&quot;/>&lt;/tns:FlagValidita>&lt;/xsl:if>&lt;tns:Numero_Record>&lt;xsl:value-of select=&quot;(($Passo_AllineamentoOloPrevalenti * ($index -1)) + position())&quot;/>&lt;/tns:Numero_Record>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&lt;tns:Id_File>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&lt;/tns:Id_File>&lt;/xsl:if>&lt;/tns:AllineamentoOloPrevalenteTracciato>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:AllineamentoOloPrevalenteDettaglio&quot;>&lt;tns:AllineamentoOloPrevalenteTracciato>&lt;xsl:if test=&quot;tns1:Tipo_Record&quot;>&lt;tns:Tipo_Record>&lt;xsl:value-of select=&quot;tns1:Tipo_Record&quot;/>&lt;/tns:Tipo_Record>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_ISP&quot;>&lt;tns:CODICE_ISP>&lt;xsl:value-of select=&quot;tns1:CODICE_ISP&quot;/>&lt;/tns:CODICE_ISP>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_OLO&quot;>&lt;tns:CODICE_OLO>&lt;xsl:value-of select=&quot;tns1:CODICE_OLO&quot;/>&lt;/tns:CODICE_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FlagValidita&quot;>&lt;tns:FlagValidita>&lt;xsl:value-of select=&quot;tns1:FlagValidita&quot;/>&lt;/tns:FlagValidita>&lt;/xsl:if>&lt;tns:Numero_Record>&lt;xsl:value-of select=&quot;(($Passo_AllineamentoOloPrevalenti * ($index -1)) + position())&quot;/>&lt;/tns:Numero_Record>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&lt;tns:Id_File>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&lt;/tns:Id_File>&lt;/xsl:if>&lt;/tns:AllineamentoOloPrevalenteTracciato>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:AllineamentoOloPrevalente>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
