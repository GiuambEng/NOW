                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6c0f9157-4108-4d6f-9460-d08216c0210a+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoOloPrevalente_Staging&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_InputStaging&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Var_InputStaging/tns1:AllineamentoOloPrevalente_Dettaglio&quot;>&lt;Record>&lt;COD_OLO_NUMERICO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:COD_OLO_NUMERICO)&quot;>&lt;xsl:value-of select=&quot;tns1:COD_OLO_NUMERICO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_OLO_NUMERICO>&lt;CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:CODFC_OLO_AGCOM)&quot;>&lt;xsl:value-of select=&quot;tns1:CODFC_OLO_AGCOM&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODFC_OLO_AGCOM>&lt;CONTENUTO_RECD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:CONTENUTO_RECD)&quot;>&lt;xsl:value-of select=&quot;tns1:CONTENUTO_RECD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONTENUTO_RECD>&lt;DESCR_ERRORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:DESCR_ERRORE)&quot;>&lt;xsl:value-of select=&quot;tns1:DESCR_ERRORE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCR_ERRORE>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal(tns1:ID_FILE_PROCSTO_INPUT)&quot;/>&lt;/ID_FILE_PROCSTO_INPUT>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:decimal(tns1:ID_STATO_ELAB_STAG)&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:decimal(tns1:NUMERO_RECD)&quot;/>&lt;/NUMERO_RECD>&lt;TMSP_INSMTO>&lt;xsl:value-of select=&quot;xsd:dateTime(tns1:TMSP_INSMTO)&quot;/>&lt;/TMSP_INSMTO>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBC_Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_OLO_PREVALENTE_FILE (COD_OLO_NUMERICO,&#xa;  CODFC_OLO_AGCOM, CONTENUTO_RECD, DESCR_ERRORE, ID_FILE_PROCSTO_INPUT,&#xa;  ID_STATO_ELAB_STAG, NUMERO_RECD, TMSP_INSMTO)&#xa;  VALUES (?, ?, RTRIM(?, CHR(10) || CHR(13)), ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO_NUMERICO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CONTENUTO_RECD"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_ERRORE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE_PROCSTO_INPUT"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_STATO_ELAB_STAG"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="NUMERO_RECD"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TMSP_INSMTO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
