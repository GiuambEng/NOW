                                    <bpws:source linkName="GroupStart1ToParseData">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index &lt;= (($JMSReceiveMessage/Body/ns30:queueResponse/ns30:NumeroRecord) div$Passo_ContattiOLO)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$index <= (($JMSReceiveMessage/Body/ns30:queueResponse/ns30:NumeroRecord) div$Passo_ContattiOLO)]]></bpws:transitionCondition>
