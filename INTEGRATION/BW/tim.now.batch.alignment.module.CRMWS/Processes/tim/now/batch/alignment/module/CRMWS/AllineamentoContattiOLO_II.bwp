                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/log/ContattiOLO_Staging&quot; xmlns:tns1=&quot;http://www.tim.com/log/ContattiOLO_Tracciato&quot; xmlns:ns1=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:ns2=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;OK_ELAB_FILE&quot;/>&lt;xsl:param name=&quot;Passo_ContattiOLO&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;Var_InputStaging&quot; match=&quot;/&quot;>&lt;tns:AllineamentoContattiOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:AllineamentoContattiOLO_dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AllineamentoContattiOLO_dettaglio&quot;>&lt;tns:AllineamentoContattiOLO_dettaglio>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_ContattiOLO * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:CAP&quot;>&lt;tns:CAP>&lt;xsl:value-of select=&quot;tns1:CAP&quot;/>&lt;/tns:CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_ISTAT_COMUNE&quot;>&lt;tns:COD_ISTAT_COMUNE>&lt;xsl:value-of select=&quot;tns1:COD_ISTAT_COMUNE&quot;/>&lt;/tns:COD_ISTAT_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_ISTAT_INDIRIZZO&quot;>&lt;tns:COD_ISTAT_INDIRIZZO>&lt;xsl:value-of select=&quot;tns1:COD_ISTAT_INDIRIZZO&quot;/>&lt;/tns:COD_ISTAT_INDIRIZZO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_ISTAT_PROVINCIA&quot;>&lt;tns:COD_ISTAT_PROV>&lt;xsl:value-of select=&quot;tns1:COD_ISTAT_PROVINCIA&quot;/>&lt;/tns:COD_ISTAT_PROV>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_REFERENTE&quot;>&lt;tns:COD_REFTE>&lt;xsl:value-of select=&quot;tns1:CODICE_REFERENTE&quot;/>&lt;/tns: