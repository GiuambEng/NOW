                    <bpws:sequence name="sequence" tibex:group="while">
                        <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                        <bpws:while name="while" tibex:counterName="index">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$index &lt;((($JMSReceiveMessage/Body/ns30:queueResponse/ns30:NumeroRecord) div$Passo_ContattiOLO) +1)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <((($JMSReceiveMessage/Body/ns30:queueResponse/ns30:NumeroRecord) div$Passo_ContattiOLO) +1)]]></bpws:condition>
