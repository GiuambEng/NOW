                                    name="StartElaborazioneToEmpty1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Empty1ToCallProcess4" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="CallProcess4ToGroupEnd1" tibex:linkType="SUCCESS"/>
