io_Noval&quot;>&lt;ns:AllineamentoKitDiConsegna_dettaglio>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo_CRMWS_KitDiConsegna * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns:CLLI_SEDE&quot;>&lt;ns:CLLI>&lt;xsl:value-of select=&quot;tns:CLLI_SEDE&quot;/>&lt;/ns:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ADR_CODE&quot;>&lt;ns:COD_AREA_RACCOLTA>&lt;xsl:value-of select=&quot;tns:ADR_CODE&quot;/>&lt;/ns:COD_AREA_RACCOLTA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TD_KIT&quot;>&lt;ns:COD_KIT>&lt;xsl:value-of select=&quot;tns:TD_KIT&quot;/>&lt;/ns:COD_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:OLO_CODE&quot;>&lt;ns:COD_OLO>&lt;xsl:value-of select=&quot;tns:OLO_CODE&quot;/>&lt;/ns:COD_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:OLO_CODING&quot;>&lt;ns:CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;tns:OLO_CODING&quot;/>&lt;/ns:CODFC_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DEC&quot;>&lt;ns:DEC>&lt;xsl:value-of select=&quot;tns:DEC&quot;/>&lt;/ns:DEC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DEC_ATT&quot;>&lt;ns:DEC_ATTIVAZIONE>&lt;xsl:value-of select=&quot;tns:DEC_ATT&quot;/>&lt;/ns:DEC_ATTIVAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ADR_DESC&quot;>&lt;ns:DESC_AREA_RACCOLTA>&lt;xsl:value-of select=&quot;tns:ADR_DESC&quot;/>&lt;/ns:DESC_AREA_RACCOLTA>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns3:queueResponse/ns3:ID_FILE&quot;>&lt;ns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns3:queueResponse/ns3:ID_FILE&quot;/>&lt;/ns:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TD_KIT_PRIME_CONTRACTOR&quot;>&lt;ns:ID_PRIME_CONTRACTOR>&lt;xsl:value-of select=&quot;tns:TD_KIT_PRIME_CONTRACTOR&quot;/>&lt;/ns:ID_PRIME_CONTRACTOR>&lt;/xsl: