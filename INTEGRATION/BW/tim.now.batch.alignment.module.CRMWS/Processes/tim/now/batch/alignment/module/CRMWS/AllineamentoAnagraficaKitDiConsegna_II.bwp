                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a95b5d7b-6951-470d-aece-e62319314aac+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns=&quot;http://www.tim.com/log/AllineamentoKitDiConsegna_Staging/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InputStaging&quot;/>&lt;xsl:template name=&quot;InsertStag-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$InputStaging/ns:AllineamentoKitDiConsegna_dettaglio&quot;>&lt;Record>&lt;CLLI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:CLLI)&quot;>&lt;xsl:value-of select=&quot;ns:CLLI&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CLLI>&lt;COD_AREA_RACCOLTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:COD_AREA_RACCOLTA)&quot;>&lt;xsl:value-of select=&quot;ns:COD_AREA_RACCOLTA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_AREA_RACCOLTA>&lt;COD_KIT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:COD_KIT)&quot;>&lt;xsl:value-of select=&quot;ns:COD_KIT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_KIT>&lt;COD_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:COD_OLO)&quot;>&lt;xsl:value-of select=&quot;ns:COD_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_OLO>&lt;CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:CODFC_OLO_AGCOM)&quot;>&lt;xsl:value-of select=