    			<element name="NUMERO_TELEFONICO" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="DATA_ESPLETAMENTO" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Flag_Validita" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>