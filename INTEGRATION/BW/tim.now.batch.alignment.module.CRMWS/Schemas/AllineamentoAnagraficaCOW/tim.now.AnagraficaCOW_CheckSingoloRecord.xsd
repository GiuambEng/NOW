<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.example.org/tim.now.AnagraficaCOW_CheckSingoloRecord" 
xmlns:tns="http://www.example.org/tim.now.AnagraficaCOW_CheckSingoloRecord" 
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
	<element name="AllineamentoAnagraficaCOW">
		<complexType>
			<sequence>
				<element ref="tns:AllineamentoAnagraficaCOW_dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AllineamentoAnagraficaCOW_dettaglio">
		<complexType>
			<sequence>
				<element name="Tipo_record" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="2"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
                <element name="CODICE_COW" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1" />
							<maxLength value="3" />
						</restriction>
					</simpleType>
				</element>
                <element name="CODICE_PADRE" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="3"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CREATED" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="14"/>
						</restriction>
					</simpleType>
				</element>
				<element name="Timestamp" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="NUMERO_RECD" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="ID_FILE" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="Flag_Validita" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>