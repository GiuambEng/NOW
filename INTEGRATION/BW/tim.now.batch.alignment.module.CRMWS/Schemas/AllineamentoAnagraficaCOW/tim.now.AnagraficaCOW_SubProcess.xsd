<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.example.org/tim.now.AnagraficaCOW_SubProcess" 
xmlns:tns="http://www.example.org/tim.now.AnagraficaCOW_SubProcess" 
elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="AnagraficaCOW">
		<complexType>
			<sequence>
				<element ref="tns:AnagraficaCOW_dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AnagraficaCOW_dettaglio">
		<complexType>
			<sequence>
				<element name="Tipo_record" type="string" maxOccurs="1"	minOccurs="0" />
                <element name="CODICE_COW" type="string" maxOccurs="1" minOccurs="0" />
                <element name="CODICE_PADRE" type="string" maxOccurs="1"	minOccurs="0" />
				<element name="CREATED" type="string" maxOccurs="1"	minOccurs="0" />
				<element name="Flag_Validita" type="string" maxOccurs="1"	minOccurs="0" />
				<element name="Record" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="ID_FILE" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AnagraficaCOW_output">
		<complexType>
			<sequence>
				<element name="Esito" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>