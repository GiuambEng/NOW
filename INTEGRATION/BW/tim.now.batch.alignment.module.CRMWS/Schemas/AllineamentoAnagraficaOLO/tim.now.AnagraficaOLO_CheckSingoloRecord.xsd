<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/log/AnagraficaOLO_CheckSingoloRecord"  xmlns:tns="http://www.tim.com/log/AnagraficaOLO_CheckSingoloRecord" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="AllineamentoAnagraficaOLO">
		<complexType>
			<sequence>
				<element ref="tns:AllineamentoAnagraficaOLO_dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AllineamentoAnagraficaOLO_dettaglio">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="DENOMINAZIONE_OLO">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="RAGIONE_SOCIALE">
					<simpleType>
						<restriction base="string">
							<maxLength value="100" />
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="P.IVA">
					<simpleType>
						<restriction base="string">
							<maxLength value="30" />
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="CODICE_NUMERICO_OLO">
					<simpleType>
						<restriction base="string">
							<maxLength value="3" />
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="CODICE_ALFANUMERICO_OLO">
					<simpleType>
						<restriction base="string">
							<maxLength value="3" />
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="CODICE_OLO_RETE">
					<simpleType>
						<restriction base="string">
							<maxLength value="5" />
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="TIPOLOGIA_GESTORE">
					<simpleType>
						<restriction base="string">
							<maxLength value="30" />
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="FLAG_OLO_MOROSO">
					<simpleType>
						<restriction base="string">
							<length value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="FLAG_SANMARINO">
					<simpleType>
						<restriction base="string">
							<length value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="EMAIL">
					<simpleType>
						<restriction base="string">
							<maxLength value="50" />
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="OLO_ACCORPANTE_FLAG">
					<simpleType>
						<restriction base="string">
							<length value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="CODICE_OLO_ACCORPANTE">
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="CODICE_ALFANUMERICO_OLO_ACCORPANTE">
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="STATO_ACCORPAMENTO">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="DATA_ACCORPAMENTO" >
					<simpleType>
						<restriction base="string">
							<pattern value="\d\d\d\d\-\d\d-\d\d"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Timestamp" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="NUMERO_RECD" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Flag_Validita" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>