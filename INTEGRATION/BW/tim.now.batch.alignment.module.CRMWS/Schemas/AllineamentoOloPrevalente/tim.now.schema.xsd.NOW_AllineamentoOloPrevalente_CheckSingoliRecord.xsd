<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoOloPrevalente_CheckSingoliRecord" xmlns:tns="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoOloPrevalente_CheckSingoliRecord" elementFormDefault="qualified">

    <element name="AllineamentoOloPrevalente">
    	<complexType>
    		<sequence>
    			<element ref="tns:AllineamentoOloPrevalente_Dettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="AllineamentoOloPrevalente_Dettaglio">
    	<complexType>
    		<sequence>
    			<element name="Tipo_Record" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<minLength value="1"></minLength>
    						<enumeration value="2"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CODICE_ISP" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CODICE_OLO" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TimeStamp" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="FlagValidita" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Numero_Record" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Id_File" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>