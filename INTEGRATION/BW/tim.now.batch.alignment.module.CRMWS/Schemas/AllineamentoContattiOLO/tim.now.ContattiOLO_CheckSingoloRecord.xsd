<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/log/ContattiOLO_CheckSingoloRecord"  xmlns:tns="http://www.tim.com/log/ContattiOLO_CheckSingoloRecord" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="AllineamentoContattiOLO">
		<complexType>
			<sequence>
				<element ref="tns:AllineamentoContattiOLO_dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AllineamentoContattiOLO_dettaglio">
		<complexType>
			<sequence>

				<element maxOccurs="1" minOccurs="1" name="ID_CONTATTO">
					<simpleType>
						<restriction base="string">
							<maxLength value="15" />
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="ID_INDIRIZZO">
					<simpleType>
						<restriction base="string">
							<maxLength value="15" />
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="NOME">
					<simpleType>
						<restriction base="string">
							<maxLength value="50" />
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="COGNOME">
					<simpleType>
						<restriction base="string">
							<maxLength value="50" />
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="FLAG_PRIMARIO">
					<simpleType>
						<restriction base="string">
							<length value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="CODICE_OLO">
					<simpleType>
						<restriction base="string">
							<maxLength value="3" />
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="TITOLO">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="EMAIL">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="TIPO_CONTATTO">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
							<enumeration value="CONTATTI"/>
							<enumeration value="CONTATTO REG"/>
							<enumeration value="CONTATTO XDSL"/>
							<enumeration value="SEDE"/>
							<enumeration value="SEDE E CONTATTI"/>
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="COMUNE">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="INDIRIZZO">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="P.TOPONOMASTICA">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="COD_ISTAT_INDIRIZZO">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="NUMERO_CIVICO">
					<simpleType>
						<restriction base="string">
							<maxLength value="10"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="COD_ISTAT_COMUNE">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="PROVINCIA">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="COD_ISTAT_PROVINCIA">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="CAP">
					<simpleType>
						<restriction base="string">
							<maxLength value="5"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="FAX">
					<simpleType>
						<restriction base="string">
							<maxLength value="20"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="PREFISSO_MOBILE">
					<simpleType>
						<restriction base="string">
							<maxLength value="5"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="NUMERO_MOBILE">
					<simpleType>
						<restriction base="string">
							<maxLength value="20"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="MOBILE_ALTERNATIVO">
					<simpleType>
						<restriction base="string">
							<maxLength value="20"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="PREFISSO_FISSO">
					<simpleType>
						<restriction base="string">
							<maxLength value="5"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="NUMERO_FISSO">
					<simpleType>
						<restriction base="string">
							<maxLength value="20"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="FISSO_ALTERNATIVO">
					<simpleType>
						<restriction base="string">
							<maxLength value="20"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="CODICE_REFERENTE">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Timestamp" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="NUMERO_RECD" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Flag_Validita" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>