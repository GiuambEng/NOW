<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.example.org/tim.now.AnagraficaCentraleNODO_SubProcess" 
xmlns:tns="http://www.example.org/tim.now.AnagraficaCentraleNODO_SubProcess" 
elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="AnagraficaCentraleNODO">
		<complexType>
			<sequence>
				<element ref="tns:AnagraficaCentraleNODO_dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AnagraficaCentraleNODO_dettaglio">
		<complexType>
			<sequence>
				<element name="Tipo_record" type="string" maxOccurs="1"	minOccurs="0" />
                <element name="ID_CENTRALE_NODO_CRMWS" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="ID_ADR_CRMWS" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="CODICE_NODO" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="CODICE_CLLI" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="DESCRIZIONE_CENTRALE" type="string" maxOccurs="1" minOccurs="0"/>	
				<element name="Flag_Validita" type="string" maxOccurs="1"	minOccurs="0" />
				<element name="Record" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="ID_FILE" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AnagraficaCentraleNODO_output">
		<complexType>
			<sequence>
				<element name="Esito" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>