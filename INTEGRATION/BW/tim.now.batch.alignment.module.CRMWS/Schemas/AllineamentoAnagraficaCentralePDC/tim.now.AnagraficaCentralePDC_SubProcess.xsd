<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.example.org/tim.now.AnagraficaCentralePDC_SubProcess" 
xmlns:tns="http://www.example.org/tim.now.AnagraficaCentralePDC_SubProcess" 
elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="AnagraficaCentralePDC">
		<complexType>
			<sequence>
				<element ref="tns:AnagraficaCentralePDC_dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AnagraficaCentralePDC_dettaglio">
		<complexType>
			<sequence>
				<element name="Tipo_record" type="string" maxOccurs="1"	minOccurs="0" />
                <element name="ID_CENTRALE_PDC_CRMWS" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="ID_ADR_CRMWS" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="ID_MACROAREA_CRMWS" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="CODICE_PDC" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="NOME_CENTRALE_PDC" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="RO_PDC" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="VIA_PDC" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="COMUNE" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="CODICE_CLLI_PDC" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="DESCRIZIONE_CLLI_PDC" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="CODICE_IDBRE" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="REGIONE_PDC" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="PROVINCIA" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="STATO" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="IDONEITA_POP_PDC" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="IDONEITA_NGA_PDC" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="RACCOLTA_TERMINATING_PDC" type="string" maxOccurs="1" minOccurs="0"/>		
				<element name="Flag_Validita" type="string" maxOccurs="1"	minOccurs="0" />
				<element name="Record" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="ID_FILE" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AnagraficaCentralePDC_output">
		<complexType>
			<sequence>
				<element name="Esito" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>