<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoKitDiConsegna" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoKitDiConsegna">

    <element name="Allineamentokitdiconsegna">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:Allineamentokitdiconsegna_Dettaglio">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Allineamentokitdiconsegna_Dettaglio">
    	<complexType>
    		<sequence>
    			<element name="Tipo_record" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="2"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TD_KIT" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="STATO" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="Active"></enumeration>
    						<enumeration value="Inactive"></enumeration>
    						<enumeration value="Temporary"></enumeration>
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DEC_ATT" type="date" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			<element name="DEC" type="date" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			<element name="CLLI_SEDE" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="10"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ADR_CODE" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ADR_DESC" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="255"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="OLO_CODING" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="OLO_CODE" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TD_KIT_PRIME_CONTRACTOR" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Timestamp" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="FlagValidita" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="ID_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Numero_Record" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>