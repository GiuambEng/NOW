<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.example.org/tim.now.AnagraficaCentraleGBE_CheckSingoloRecord" 
xmlns:tns="http://www.example.org/tim.now.AnagraficaCentraleGBE_CheckSingoloRecord" 
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
	<element name="AllineamentoAnagraficaCentraleGBE">
		<complexType>
			<sequence>
				<element ref="tns:AllineamentoAnagraficaCentraleGBE_dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AllineamentoAnagraficaCentraleGBE_dettaglio">
		<complexType>
			<sequence>
				<element name="Tipo_record" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="2"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
                <element name="ID_CENTRALE_GBE_CRMWS" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1" />
							<maxLength value="30" />
						</restriction>
					</simpleType>
				</element>
                <element name="ID_ADR_CRMWS" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="COMUNE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DISTRETTO" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="TIPOLOGIA_DSLAM" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="NOME_CENTRALE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CODICE_CLLI" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CODICE_IDBRE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="10"/>
						</restriction>
					</simpleType>
				</element>
				<element name="ID_CENTRALE_PDC_CRMWS" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DESCRIZIONE_CLLI" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="STATO" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="FLAG_QNQ" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="3"/>
						</restriction>
					</simpleType>
				</element>
				<element name="FLAG_LONG_DISTANCE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DATA_ATTIVAZIONE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="15"/>
						</restriction>
					</simpleType>
				</element>
				<element name="FLAG_PRONTO_VENDITA" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element name="Timestamp" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="NUMERO_RECD" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="ID_FILE" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="Flag_Validita" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>