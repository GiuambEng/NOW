<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.example.org/tim.now.ReferentiSimmetrici_CheckSingoloRecord" 
xmlns:tns="http://www.example.org/tim.now.ReferentiSimmetrici_CheckSingoloRecord" 
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
	<element name="ReferentiSimmetrici">
		<complexType>
			<sequence>
				<element ref="tns:AllineamentoReferentiSimmetrici_dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AllineamentoReferentiSimmetrici_dettaglio">
		<complexType>
			<sequence>
				<element name="Tipo_record" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="2"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
				<element maxOccurs="1" minOccurs="0" name="ID_NOW" type="string"/>
                <element name="ID_CRMWS" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1" />
							<maxLength value="50" />
						</restriction>
					</simpleType>
				</element>
                <element name="QUALIFICA_REF" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="2"/>
							<enumeration value="CF"></enumeration>
							<enumeration value="O"></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element name="COGNOME_REF" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="NOME_REF" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>				
				<element name="FISSO_REF" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>	
				<element name="MOBILE_REF" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>	
				<element name="EMAIL_REF" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>			

				
				<element name="Timestamp" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="NUMERO_RECD" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="ID_FILE" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="Flag_Validita" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>