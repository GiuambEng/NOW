<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.example.org/tim.now.ReferentiSimmetrici_Tracciato" 
xmlns:tns="http://www.example.org/tim.now.ReferentiSimmetrici_Tracciato" 
elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="ReferentiSimmetrici">
		<complexType>
			<sequence>
				<element ref="tns:ReferentiSimmetrici_dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="ReferentiSimmetrici_dettaglio">
		<complexType>
			<sequence>
				<element name="Tipo_record" type="string" maxOccurs="1" minOccurs="0"/>
				
				<element name="ID_NOW" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="ID_CRMWS" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="QUALIFICA_REF" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="COGNOME_REF" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="NOME_REF" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="FISSO_REF" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="MOBILE_REF" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="EMAIL_REF" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="Flag_Validita" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>