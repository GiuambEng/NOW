<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.example.org/tim.now.AnagraficaKIT_VLAN_CheckSingoloRecord" 
xmlns:tns="http://www.example.org/tim.now.AnagraficaKIT_VLAN_CheckSingoloRecord" 
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
	<element name="AllineamentoAnagraficaKIT_VLAN">
		<complexType>
			<sequence>
				<element ref="tns:AllineamentoAnagraficaKIT_VLAN_dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AllineamentoAnagraficaKIT_VLAN_dettaglio">
		<complexType>
			<sequence>
				<element name="Tipo_record" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="2"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
                <element name="CLLI" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1" />
							<maxLength value="30" />
						</restriction>
					</simpleType>
				</element>
                <element name="CODICE_KIT" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CODIFICA_OLO_AGCOM" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CODICE_OLO_NUMERICO" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DEC" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DEC_ATTIVAZIONE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="STATO" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="MODELLO_KIT" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="ABILITATO_NGA" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element name="ID_PRIME_CONTRACTOR" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="FAMIGLIA_KIT" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="5"/>
						</restriction>
					</simpleType>
				</element>
				<element name="VLAN_TRANSLATION" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element name="Timestamp" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="NUMERO_RECD" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="ID_FILE" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="Flag_Validita" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>