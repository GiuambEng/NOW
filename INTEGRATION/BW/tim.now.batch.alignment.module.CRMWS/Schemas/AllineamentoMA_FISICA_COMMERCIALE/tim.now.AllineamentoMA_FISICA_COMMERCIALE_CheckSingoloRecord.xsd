<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.example.org/tim.now.AllineamentoMA_FISICA_COMMERCIALE_CheckSingoloRecord" 
xmlns:tns="http://www.example.org/tim.now.AllineamentoMA_FISICA_COMMERCIALE_CheckSingoloRecord" 
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
	<element name="AllineamentoAllineamentoMA_FISICA_COMMERCIALE">
		<complexType>
			<sequence>
				<element ref="tns:AllineamentoAllineamentoMA_FISICA_COMMERCIALE_dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AllineamentoAllineamentoMA_FISICA_COMMERCIALE_dettaglio">
		<complexType>
			<sequence>
				<element name="Tipo_record" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="2"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="IDENTIFICATIVO_ASS_MACRO_AREA" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1" />
							<maxLength value="30" />
						</restriction>
					</simpleType>
				</element>
                <element name="IDENTIFICATIVO_CRMWS_MACRO_AREA_FISICA" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1" />
							<maxLength value="30" />
						</restriction>
					</simpleType>
				</element>
                <element name="IDENTIFICATIVO_CRMWS_MACRO_AREA_COMM_CC" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="IDENTIFICATIVO_CRMWS_MACRO_AREA_COMM_LIB" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DATA_INIZIO_VALIDITA_ASSOCIAZIONE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="10"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DATA_FINE_VALIDITA_ASSOCIAZIONE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"/>
							<maxLength value="10"/>
						</restriction>
					</simpleType>
				</element>
				
				<element name="Timestamp" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="NUMERO_RECD" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="ID_FILE" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="Flag_Validita" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>