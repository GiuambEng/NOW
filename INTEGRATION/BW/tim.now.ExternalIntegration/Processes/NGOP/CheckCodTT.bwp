    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="26b03bbb-f919-4f71-8730-5b2edb976444">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="LogErrorToJDBCUpdate" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link name="LogErrorToReply" tibex:linkType="SUCCESSWITHNOCONDITION"/>
