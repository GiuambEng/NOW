                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d138697d-1a7b-490c-9519-3bd818cc2f6f+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/VerificaCodiceTT&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;IDESEC&quot;/>&lt;xsl:param name=&quot;VerificaCodiceTT&quot;/>&lt;xsl:param name=&quot;ParseJSON&quot;/>&lt;xsl:template name=&quot;UpdStag-input&quot; match=&quot;/&quot;>&lt;tns7:jdbcUpdateActivityInput>&lt;CONTENUTO_RESPONSE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaCodiceTT/MessageBody/asciiContent)&quot;>&lt;xsl:value-of select=&quot;$VerificaCodiceTT/MessageBody/asciiContent&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONTENUTO_RESPONSE>&lt;ID_STATO_ELAB_STAGING>&lt;xsl:value-of select=&quot;27&quot;/>&lt;/ID_STATO_ELAB_STAGING>&lt;ESITO>&lt;xsl:copy-of select=&quot;$ParseJSON/tns3:Body/tns3:Esito/@xsi:nil&quot;/>&lt;xsl:value-of select=&quot;$ParseJSON/tns3:Body/tns3:Esito&quot;/>&lt;/ESITO>&lt;RESULTCODE>&lt;xsl:copy-of select=&quot;$ParseJSON/tns3:Body/tns3:resultCode/@xsi:nil&quot;/>&lt;xsl:value-of select=&quot;$ParseJSON/tns3:Body/tns3:resultCode&quot;/>&lt;/RESULTCODE>&lt;RESULTDESC>&lt;xsl:copy-of select=&quot;$ParseJSON/tns3:Body/tns3:resultDesc/@xsi:nil&quot;/>&lt;xsl:value-of select=&quot;$ParseJSON/tns3:Body/tns3:resultDesc&quot;/>&lt;/RESULTDESC>&lt;ID_ESEC_PROCESSO_NOFILE>&lt;xsl:value-of select=&quot;xsd:decimal($IDESEC)&quot;/>&lt;/ID_ESEC_PROCESSO_NOFILE>&lt;/tns7:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
