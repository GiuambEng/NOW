            </bpws:receive>
            <bpws:reply name="CheckCodTTOut" operation="CheckCodTT"
                partnerLink="CheckCodTT" portType="ns1:CheckCodTT"
                tibex:xpdlId="bc1ce9a6-ce01-426c-b5da-e5d23fb703c0" variable="CheckCodTTOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/CheckCodTT/" xmlns:ns="http://www.tim.com/NGOP/xsd/CheckCodTT/" xmlns:tns3="http://www.tim.com/NOW/xsd/VerificaCodiceTT" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;&lt;xsl:param name="ParseJSON"/&gt;&lt;xsl:template name="CheckCodTTOut-input" match="/"&gt;&lt;tns:CheckCodTTResponse&gt;&lt;parameters&gt;&lt;ns:CheckCodTTResponse&gt;&lt;Esito&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/Esito&gt;&lt;xsl:if test="not((string($ParseJSON/tns3:Body/tns3:Esito/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($ParseJSON/tns3:Body/tns3:Esito/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($ParseJSON/tns3:Body/tns3:Esito)"&gt;&lt;flagCheckTtDown&gt;&lt;xsl:value-of select="$ParseJSON/tns3:Body/tns3:Esito"/&gt;&lt;/flagCheckTtDown&gt;&lt;/xsl:if&gt;&lt;/ns:CheckCodTTResponse&gt;&lt;/parameters&gt;&lt;/tns:CheckCodTTResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
