                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCESSO_NOFILE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
