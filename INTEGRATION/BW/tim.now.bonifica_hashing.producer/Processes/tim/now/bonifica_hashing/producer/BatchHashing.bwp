                                <bpws:target linkName="JDBCUpdateToExit1"/>
                                <bpws:target linkName="ErrorLogToExit1"/>
                            </bpws:targets>
                        </bpws:exit>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
