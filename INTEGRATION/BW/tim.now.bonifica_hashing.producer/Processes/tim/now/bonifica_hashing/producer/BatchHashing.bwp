                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT SEQ_ID_PROC_BATTENTE.NEXTVAL AS ID_PROC&#xa;  FROM DUAL&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_PROC"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UpdateID_PROCeSTATO-input"
                    name="UpdateID_PROCeSTATO"
                    outputVariable="UpdateID_PROCeSTATO"
                    tibex:xpdlId="4d22dcf3-0192-473e-85ca-df17a2f10c82" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLogger1ToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateToGenericLogger2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4d22dcf3-0192-473e-85ca-df17a2f10c82+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelectGenerateIdProc&quot;/>&lt;xsl:param name=&quot;SelectGestioneHashing&quot;/>&lt;xsl:template name=&quot;UpdateID_PROCeSTATO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_PROC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SelectGenerateIdProc/Record[1]/ID_PROC)&quot;>&lt;xsl:value-of select=&quot;$SelectGenerateIdProc/Record[1]/ID_PROC&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_PROC>&lt;DATA_AGGIORNAMENTO>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/DATA_AGGIORNAMENTO>&lt;NUM_REC_BATTENTE_SECOLO>&lt;xsl:value-of select=&quot;$SelectGestioneHashing/Record[1]/NUM_REC_BATTENTE_SECOLO+1&quot;/>&lt;/NUM_REC_BATTENTE_SECOLO>&lt;ENTITA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SelectGestioneHashing/Record[1]/ENTITA)&quot;>&lt;xsl:value-of select=&quot;$SelectGestioneHashing/Record[1]/ENTITA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ENTITA>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
