                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE APPUSER.STORICO_BATTENTE_HASHING&#xa;  SET ID_PROC = ?, STATO = 'ID_PROC GENERATO', DATA_AGGIORNAMENTO = ?&#xa;  WHERE STATO = 'RECORD DA ELABORARE' AND ROWNUM &lt; ? AND  ENTITA = ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_PROC"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_AGGIORNAMENTO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="NUM_REC_BATTENTE_SECOLO"/>
