NGITUDINE&quot;/>&lt;/LONGITUDINE>&lt;NUMERO_CIVICO>&lt;xsl:value-of select=&quot;ns:NUMERO_CIVICO&quot;/>&lt;/NUMERO_CIVICO>&lt;NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:decimal(ns:NUMERO_RECD)&quot;/>&lt;/NUMERO_RECD>&lt;PRECISIONE>&lt;xsl:value-of select=&quot;ns:PRECISIONE&quot;/>&lt;/PRECISIONE>&lt;TIPO_ELEMENTO>&lt;xsl:value-of select=&quot;ns:TIPO_ELEMENTO&quot;/>&lt;/TIPO_ELEMENTO>&lt;TMSP_INSMTO>&lt;xsl:value-of select=&quot;xsd:dateTime(ns:TMSP_INSMTO)&quot;/>&lt;/TMSP_INSMTO>&lt;CONTENUTO_RECD>&lt;xsl:value-of select=&quot;ns:CONTENUTO_RECD&quot;/>&lt;/CONTENUTO_RECD>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
