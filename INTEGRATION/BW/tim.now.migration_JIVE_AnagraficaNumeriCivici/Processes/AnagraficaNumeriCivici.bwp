              &lt;/ns1:LogName>&#xa;                    &lt;ns1:ApplicationName>&#xa;                        &lt;xsl:value-of select=&quot;'tim.now.migration_JIVE_AnagraficaNumeriCivici.application'&quot;/>&#xa;                    &lt;/ns1:ApplicationName>&#xa;                &lt;/ns1:LogInfo>&#xa;            &lt;/ns1:InputData>&#xa;            &lt;xsl:for-each select=&quot;$MapDetails1/ns11:InputDetails&quot;>&#xa;                &lt;ns1:InputDetails>&#xa;                    &lt;xsl:if test=&quot;ns11:NOME&quot;>&#xa;                        &lt;ns1:NOME>&#xa;                            &lt;xsl:value-of select=&quot;ns11:NOME&quot;/>&#xa;                        &lt;/ns1:NOME>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns11:VALORE&quot;>&#xa;                        &lt;ns1:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;ns11:VALORE&quot;/>&#xa;                        &lt;/ns1:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns1:InputDetails>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns1:ChiusuraAllineamenti>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
