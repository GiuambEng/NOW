                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/parse/xsd/+da6efada-ac14-4f2e-99cd-22873d12fba0+input&quot; xmlns:ns22=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_Counter.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;File&quot;/>&#xa;    &lt;xsl:param name=&quot;PassoCiclo&quot;/>&#xa;    &lt;xsl:template name=&quot;Noval_Detail_Last-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;fileName>&#xa;                &lt;xsl:value-of select=&quot;$File/tns1:FullName&quot;/>&#xa;            &lt;/fileName>&#xa;            &lt;startRecord>&#xa;                &lt;xsl:value-of select=&quot;($index -1) *$PassoCiclo +1&quot;/>&#xa;            &lt;/startRecord>&#xa;            &lt;noOfRecords>&#xa;                &lt;xsl:value-of select=&quot;$Invoke_Counter.part1/ns22:NumeroRecord mod $PassoCiclo&quot;/>&#xa;            &lt;/noOfRecords>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.parse.parsedata"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:parse="http://ns.tibco.com/bw/palette/parse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/parse#//ParseData"/>
                                    <value
                                    continueOnError="true"
                                    dataFormat="dataFormatResourceProperty"
                                    encoding="ASCII"
                                    inputType="File"
                                    manuallySpecifiedStartRecord="true"
                                    skipBlankSpaces="true" xsi:type="parse:ParseData"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/parse/xsd/+a42413e9-ab48-4307-8b80-d556de2e8acc+input&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;File&quot;/>&lt;xsl:param name=&quot;PassoCiclo&quot;/>&lt;xsl:template name=&quot;Noval_Details-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;fileName>&lt;xsl:value-of select=&quot;$File/tns1:FullName&quot;/>&lt;/fileName>&lt;startRecord>&lt;xsl:value-of select=&quot;($index -1) *$PassoCiclo +1&quot;/>&lt;/startRecord>&lt;noOfRecords>&lt;xsl:value-of select=&quot;$PassoCiclo&quot;/>&lt;/noOfRecords>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
