                            <bpws:empty name="Empty" tibex:xpdlId="cf3cf435-246e-4ba2-98e2-c4fe82ffffbf">
                                <bpws:targets>
                                    <bpws:target linkName="Noval_DetailsToEmpty"/>
                                    <bpws:target linkName="Noval_Detail_LastToEmpty"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="EmptyToIns">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(($index = (($Invoke_Counter/part1/ns22:contaRecord_Output/ns22:NumeroRecord)) div $PassoCiclo +1)) and (count($Noval_Detail_Last/Rows/tns1:AnagraficaNumeriCiviciNoval_dettaglio)=0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(($index = (($Invoke_Counter.part1/ns22:NumeroRecord)) div $PassoCiclo +1)) and (count($Noval_Detail_Last/Rows/tns1:AnagraficaNumeriCiviciNoval_dettaglio)=0)]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.subProcessMigrzioneJiveCivici&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.AnagraficaNumeriCivici_Noval&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PassoCiclo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Noval_Detail_Last&quot;/>&lt;xsl:param name=&quot;File&quot;/>&lt;xsl:param name=&quot;Invoke_ProcessLogger&quot;/>&lt;xsl:param name=&quot;Noval_Details&quot;/>&lt;xsl:param name=&quot;OK_ELAB_FILE&quot;/>&lt;xsl:template name=&quot;Ins-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:InfoFile>&lt;ns:NomeFile>&lt;xsl:value-of select=&quot;$File/tns:FullName&quot;/>&lt;/ns:NomeFile>&lt;ns:StartRecord>&lt;xsl:value-of select=&quot;($index - 1) * $PassoCiclo + 2&quot;/>&lt;/ns:StartRecord>&lt;ns:Passo>&lt;xsl:value-of select=&quot;$PassoCiclo&quot;/>&lt;/ns:Passo>&lt;/ns:InfoFile>&lt;xsl:if test=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:COD_PROCSO_FILE&quot;>&lt;ns:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:COD_PROCSO_FILE&quot;/>&lt;/ns:COD_PROCSO_FILE>&lt;/xsl:if>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE))&quot;/>&lt;/ns:ID_FILE>&lt;ns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE))&quot;/>&lt;/ns:ID_ESEC_PROCSO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Noval_Detail_Last/Rows/tns1:AnagraficaNumeriCiviciNoval_dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$Noval_Details/Rows/tns1:AnagraficaNumeriCiviciNoval_dettaglio&quot;>&lt;ns:Record>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($PassoCiclo* ($index - 1)) + position())&quot;/>&lt;ns:ADC>&lt;xsl:value-of select=&quot;tib:trim(tns1:ADC)&quot;/>&lt;/ns:ADC>&lt;ns:CAP>&lt;xsl:value-of select=&quot;tib:trim(tns1:CAP)&quot;/>&lt;/ns:CAP>&lt;ns:CATEGORIA>&lt;xsl:value-of select=&quot;tib:trim(tns1:TIPO_CATEGORIA)&quot;/>&lt;/ns:CATEGORIA>&lt;ns:CLLI>&lt;xsl:value-of select=&quot;tib:trim(tns1:CLLI)&quot;/>&lt;/ns:CLLI>&lt;ns:COD_VIA>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_VIA)&quot;/>&lt;/ns:COD_VIA>&lt;ns:COD_NUMERO_CIVICO>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_CIVICO)&quot;/>&lt;/ns:COD_NUMERO_CIVICO>&lt;ns:COD_STRADA>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_STRADA)&quot;/>&lt;/ns:COD_STRADA>&lt;ns:COD_TOPON>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_TOPONOMASTICA)&quot;/>&lt;/ns:COD_TOPON>&lt;ns:DR>&lt;xsl:value-of select=&quot;tib:trim(tns1:DR)&quot;/>&lt;/ns:DR>&lt;ns:FLAG_OPA>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPA)&quot;/>&lt;/ns:FLAG_OPA>&lt;ns:FLAG_OPERAZIONE>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPERAZIONE)&quot;/>&lt;/ns:FLAG_OPERAZIONE>&lt;ns:FONTE>&lt;xsl:value-of select=&quot;tib:trim(tns1:TIPO_FONTE)&quot;/>&lt;/ns:FONTE>&lt;ns:GAT>&lt;xsl:value-of select=&quot;tib:trim(tns1:GAT)&quot;/>&lt;/ns:GAT>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;/>&lt;/ns:ID_FILE>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_FILE&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:LATITUDINE>&lt;xsl:value-of select=&quot;tib:trim(tns1:LATITUDINE)&quot;/>&lt;/ns:LATITUDINE>&lt;ns:LONGITUDINE>&lt;xsl:value-of select=&quot;tib:trim(tns1:LONGITUDINE)&quot;/>&lt;/ns:LONGITUDINE>&lt;ns:NUMERO_CIVICO>&lt;xsl:value-of select=&quot;tib:trim(tns1:CIVICO)&quot;/>&lt;/ns:NUMERO_CIVICO>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var&quot;/>&lt;/ns:NUMERO_RECD>&lt;ns:PRECISIONE>&lt;xsl:value-of select=&quot;tib:trim(tns1:PRECISIONE)&quot;/>&lt;/ns:PRECISIONE>&lt;ns:TIPO_ELEMENTO>&lt;xsl:value-of select=&quot;tib:trim(tns1:TIPO_ELEMENTO)&quot;/>&lt;/ns:TIPO_ELEMENTO>&lt;ns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INSMTO>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;concat(tns1:CODICE_CIVICO, tns1:CODICE_STRADA,tns1:COD_VIA,tns1:CIVICO,tns1:ADC,tns1:GAT,tns1:CLLI,tns1:TIPO_ELEMENTO,tns1:CAP,tns1:FLAG_OPA,tns1:FLAG_OPERAZIONE,tns1:LATITUDINE,tns1:LONGITUDINE,tns1:TIPO_FONTE,tns1:TIPO_CATEGORIA,tns1:PRECISIONE,tns1:DR,tns1:CODICE_TOPONOMASTICA)&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/ns:Record>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$Noval_Detail_Last/Rows/tns1:AnagraficaNumeriCiviciNoval_dettaglio&quot;>&lt;ns:Record>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($PassoCiclo* ($index - 1)) + position())&quot;/>&lt;ns:ADC>&lt;xsl:value-of select=&quot;tib:trim(tns1:ADC)&quot;/>&lt;/ns:ADC>&lt;ns:CAP>&lt;xsl:value-of select=&quot;tib:trim(tns1:CAP)&quot;/>&lt;/ns:CAP>&lt;ns:CATEGORIA>&lt;xsl:value-of select=&quot;tib:trim(tns1:TIPO_CATEGORIA)&quot;/>&lt;/ns:CATEGORIA>&lt;ns:CLLI>&lt;xsl:value-of select=&quot;tib:trim(tns1:CLLI)&quot;/>&lt;/ns:CLLI>&lt;ns:COD_VIA>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_VIA)&quot;/>&lt;/ns:COD_VIA>&lt;ns:COD_NUMERO_CIVICO>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_CIVICO)&quot;/>&lt;/ns:COD_NUMERO_CIVICO>&lt;ns:COD_STRADA>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_STRADA)&quot;/>&lt;/ns:COD_STRADA>&lt;ns:COD_TOPON>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_TOPONOMASTICA)&quot;/>&lt;/ns:COD_TOPON>&lt;ns:DR>&lt;xsl:value-of select=&quot;tib:trim(tns1:DR)&quot;/>&lt;/ns:DR>&lt;ns:FLAG_OPA>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPA)&quot;/>&lt;/ns:FLAG_OPA>&lt;ns:FLAG_OPERAZIONE>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPERAZIONE)&quot;/>&lt;/ns:FLAG_OPERAZIONE>&lt;ns:FONTE>&lt;xsl:value-of select=&quot;tib:trim(tns1:TIPO_FONTE)&quot;/>&lt;/ns:FONTE>&lt;ns:GAT>&lt;xsl:value-of select=&quot;tib:trim(tns1:GAT)&quot;/>&lt;/ns:GAT>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;/>&lt;/ns:ID_FILE>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_FILE&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:LATITUDINE>&lt;xsl:value-of select=&quot;tib:trim(tns1:LATITUDINE)&quot;/>&lt;/ns:LATITUDINE>&lt;ns:LONGITUDINE>&lt;xsl:value-of select=&quot;tib:trim(tns1:LONGITUDINE)&quot;/>&lt;/ns:LONGITUDINE>&lt;ns:NUMERO_CIVICO>&lt;xsl:value-of select=&quot;tib:trim(tns1:CIVICO)&quot;/>&lt;/ns:NUMERO_CIVICO>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var1&quot;/>&lt;/ns:NUMERO_RECD>&lt;ns:PRECISIONE>&lt;xsl:value-of select=&quot;tib:trim(tns1:PRECISIONE)&quot;/>&lt;/ns:PRECISIONE>&lt;ns:TIPO_ELEMENTO>&lt;xsl:value-of select=&quot;tib:trim(tns1:TIPO_ELEMENTO)&quot;/>&lt;/ns:TIPO_ELEMENTO>&lt;ns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INSMTO>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;concat(tns1:CODICE_CIVICO, tns1:CODICE_STRADA,tns1:COD_VIA,tns1:CIVICO,tns1:ADC,tns1:GAT,tns1:CLLI,tns1:TIPO_ELEMENTO,tns1:CAP,tns1:FLAG_OPA,tns1:FLAG_OPERAZIONE,tns1:LATITUDINE,tns1:LONGITUDINE,tns1:TIPO_FONTE,tns1:TIPO_CATEGORIA,tns1:PRECISIONE,tns1:DR,tns1:CODICE_TOPONOMASTICA)&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/ns:Record>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Ins-input" name="Ins"
                                    tibex:xpdlId="7885b5b0-d1a3-411d-b099-54d518ec8b5f"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToIns"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.subProcessMigrzioneJiveCivici&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.AnagraficaNumeriCivici_Noval&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;PassoCiclo&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Noval_Detail_Last&quot;/>&#xa;    &lt;xsl:param name=&quot;File&quot;/>&#xa;    &lt;xsl:param name=&quot;Noval_Details&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELAB_FILE&quot;/>&#xa;    &lt;xsl:template name=&quot;Ins-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:InfoFile>&#xa;                &lt;ns:NomeFile>&#xa;                    &lt;xsl:value-of select=&quot;$File/tns:FullName&quot;/>&#xa;                &lt;/ns:NomeFile>&#xa;                &lt;ns:StartRecord>&#xa;                    &lt;xsl:value-of select=&quot;($index - 1) * $PassoCiclo + 2&quot;/>&#xa;                &lt;/ns:StartRecord>&#xa;                &lt;ns:Passo>&#xa;                    &lt;xsl:value-of select=&quot;$PassoCiclo&quot;/>&#xa;                &lt;/ns:Passo>&#xa;            &lt;/ns:InfoFile>&#xa;            &lt;xsl:if test=&quot;$Invoke_ProcessLogger.part1/ns1:Esito/ns1:COD_PROCSO_FILE&quot;>&#xa;                &lt;ns:COD_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke_ProcessLogger.part1/ns1:Esito/ns1:COD_PROCSO_FILE&quot;/>&#xa;                &lt;/ns:COD_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_FILE))&quot;/>&#xa;            &lt;/ns:ID_FILE>&#xa;            &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE))&quot;/>&#xa;            &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Noval_Detail_Last/Rows/tns1:AnagraficaNumeriCiviciNoval_dettaglio)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$Noval_Details/Rows/tns1:AnagraficaNumeriCiviciNoval_dettaglio&quot;>&#xa;                        &lt;ns:Record>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($PassoCiclo* ($index - 1)) + position())&quot;/>&#xa;                            &lt;ns:ADC>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ADC)&quot;/>&#xa;                            &lt;/ns:ADC>&#xa;                            &lt;ns:CAP>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CAP)&quot;/>&#xa;                            &lt;/ns:CAP>&#xa;                            &lt;ns:CATEGORIA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:TIPO_CATEGORIA)&quot;/>&#xa;                            &lt;/ns:CATEGORIA>&#xa;                            &lt;ns:CLLI>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CLLI)&quot;/>&#xa;                            &lt;/ns:CLLI>&#xa;                            &lt;ns:COD_VIA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_VIA)&quot;/>&#xa;                            &lt;/ns:COD_VIA>&#xa;                            &lt;ns:COD_NUMERO_CIVICO>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_CIVICO)&quot;/>&#xa;              