            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f40c34ae-5fea-4223-8ba7-d9f5bfda4c5d+input&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ID_PROCSO_FILE&quot;/>&lt;xsl:param name=&quot;Invoke_ProcessLogger&quot;/>&lt;xsl:param name=&quot;Invoke_Counter&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;RECORD_STG_OK>&lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_Counter/part1/ns1:contaRecord_Output/ns1:NumeroRecord))&quot;/>&lt;/RECORD_STG_OK>&lt;COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;$ID_PROCSO_FILE&quot;/>&lt;/COD_PROCSO_FILE>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&lt;/ID_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBCUpdate-input" name="JDBCUpdate"
                    outputVariable="JDBCUpdate"
                    tibex:xpdlId="f40c34ae-5fea-4223-8ba7-d9f5bfda4c5d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
