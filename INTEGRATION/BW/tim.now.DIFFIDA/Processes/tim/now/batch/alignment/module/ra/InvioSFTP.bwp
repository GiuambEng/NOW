            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a29fbd5a-20e2-4740-958d-a8a9797dc912+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioSFTP&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SistemaIPInterfaccia-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;COD_INTRFC>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceInterfaccia&quot;/>&lt;/COD_INTRFC>&lt;DESCR_SISTEMA_NOME_SISTEMA>&lt;xsl:value-of select=&quot;&amp;quot;OLO&amp;quot;&quot;/>&lt;/DESCR_SISTEMA_NOME_SISTEMA>&lt;CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:CodificaOLOAgcom&quot;/>&lt;/CODFC_OLO_AGCOM>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SistemaIPInterfaccia-input"
                    name="SistemaIPInterfaccia"
                    outputVariable="SistemaIPInterfaccia"
                    tibex:xpdlId="a29fbd5a-20e2-4740-958d-a8a9797dc912" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SistemaIPInterfacciaToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SistemaIPInterfaccia/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($SistemaIPInterfaccia/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a29fbd5a-20e2-4740-958d-a8a9797dc912+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioSFTP&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SistemaIPInterfaccia-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;COD_INTRFC>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceInterfaccia&quot;/>&lt;/COD_INTRFC>&lt;DESCR_SISTEMA_NOME_SISTEMA>&lt;xsl:value-of select=&quot;&amp;quot;OLO&amp;quot;&quot;/>&lt;/DESCR_SISTEMA_NOME_SISTEMA>&lt;CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:CodificaOLOAgcom&quot;/>&lt;/CODFC_OLO_AGCOM>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NTR.IP, NTR.LOCAL_PATH, NTR.NOME_HOST, NTR.PORT, NTR.REMOTE_PATH, NTR.UTENZA&#xa; FROM SISTEMA_IP_INTRFC NTR, SISTEMA SIS&#xa; WHERE NTR.ID_SISTEMA = SIS.ID_SISTEMA AND ID_INTRFC=(SELECT ID_INTRFC FROM INTRFC WHERE COD_INTRFC=?) AND DESCR_SISTEMA_NOME_SISTEMA = ? AND CODFC_OLO_AGCOM=? &#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_INTRFC"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_SISTEMA_NOME_SISTEMA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <columnMetadata columnName="IP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="LOCAL_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_HOST"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PORT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="REMOTE_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="UTENZA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioSFTP&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SistemaIPInterfaccia&quot;/>&lt;xsl:param name=&quot;PasswordSFTP&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;PutFile-input&quot; match=&quot;/&quot;>&lt;tns:SFTP_Put_Input>&lt;tns:FileToBeSend>&lt;xsl:value-of select=&quot;$Start/tns1:FileFullName&quot;/>&lt;/tns:FileToBeSend>&lt;tns:RomoteDirectory>&lt;xsl:value-of select=&quot;$SistemaIPInterfaccia/Record[1]/REMOTE_PATH&quot;/>&lt;/tns:RomoteDirectory>&lt;tns:Credentials>&lt;tns:Host>&lt;xsl:value-of select=&quot;$SistemaIPInterfaccia/Record[1]/NOME_HOST&quot;/>&lt;/tns:Host>&lt;tns:Port>&lt;xsl:value-of select=&quot;xsd:int($SistemaIPInterfaccia/Record[1]/PORT)&quot;/>&lt;/tns:Port>&lt;tns:User>&lt;xsl:value-of select=&quot;$SistemaIPInterfaccia/Record[1]/UTENZA&quot;/>&lt;/tns:User>&lt;tns:Password>&lt;xsl:value-of select=&quot;$PasswordSFTP&quot;/>&lt;/tns:Password>&lt;/tns:Credentials>&lt;/tns:SFTP_Put_Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="PutFile-input" name="PutFile"
                    outputVariable="PutFile"
                    tibex:xpdlId="a508c47f-1a13-42bb-a850-682640a2473f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SistemaIPInterfacciaToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="PutFileToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$PutFile/ns2:Status=&quot;OK&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$PutFile/ns2:Status="OK"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PutFileToCallProcess1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
