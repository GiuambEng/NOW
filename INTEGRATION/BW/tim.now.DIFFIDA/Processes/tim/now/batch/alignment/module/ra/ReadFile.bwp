&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns1="http://www.example.org/FileTappo" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="NomeFile"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="ListFiles"/&gt;&lt;xsl:template name="InsErrorFileProcs-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'FILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'INSERT'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile&gt;&lt;xsl:if test="$Start/tns1:ID_PROCSO_FILE"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$Start/tns1:ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;/ns:ProcFile&gt;&lt;ns:FileProcessato&gt;&lt;ns:DATA_FILE&gt;&lt;xsl:value-of select="current-date()"/&gt;&lt;/ns:DATA_FILE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($ListFiles/files/fileInfo)=0"&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="'ERRORE APERTURA FILE'"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="'ERRORE NUMERO RECORD'"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="'KO'"/&gt;&lt;/ns:ESITO&gt;&lt;ns:ID_INTRFC&gt;&lt;xsl:value-of select="xsd:integer($Start/tns1:ID_INTRFC)"/&gt;&lt;/ns:ID_INTRFC&gt;&lt;ns:IDTPLG_FILE&gt;&lt;xsl:value-of select="2"/&gt;&lt;/ns:IDTPLG_FILE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains($NomeFile, &amp;quot;/&amp;quot;)"&gt;&lt;ns:NOME_FILE&gt;&lt;xsl:value-of select="tib:substring-after-last($NomeFile, '/')"/&gt;&lt;/ns:NOME_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:NOME_FILE&gt;&lt;xsl:value-of select="tib:substring-after-last($NomeFile, '\')"/&gt;&lt;/ns:NOME_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:TIMSTP_APERTURA_FILE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_APERTURA_FILE&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="'INPUT'"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/ns:FileProcessato&gt;&lt;ns:FileProcessatoInput&gt;&lt;ns:DATA_ARRIVO&gt;&lt;xsl:value-of select="current-date()"/&gt;&lt;/ns:DATA_ARRIVO&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($ListFiles/files/fileInfo)=0"&gt;&lt;ns:ID_CAUS_SCARTO&gt;&lt;xsl:value-of select="1"/&gt;&lt;/ns:ID_CAUS_SCARTO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_CAUS_SCARTO&gt;&lt;xsl:value-of select="2"/&gt;&lt;/ns:ID_CAUS_SCARTO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns:FileProcessatoInput&gt;&lt;ns:EsecuzioneFile&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NomeFile&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ListFiles&quot;/>&#xa;    &lt;xsl:template name=&quot;InsErrorFileProcs-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;'FILE'&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:ID_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:ID_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;ns:DATA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                &lt;/ns:DATA_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($ListFiles/files/fileInfo)=0&quot;>&#xa;                        &lt;ns:DESCR_STATO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;'ERRORE APERTURA FILE'&quot;/>&#xa;                        &lt;/ns:DESCR_STATO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:DESCR_STATO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;'ERRORE NUMERO RECORD'&quot;/>&#xa;                        &lt;/ns:DESCR_STATO_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt;ns:ID_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Start/tns1:ID_INTRFC)&quot;/>&#xa;                &lt;/ns:ID_INTRFC>&#xa;                &lt;ns:IDTPLG_FILE>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/ns:IDTPLG_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($NomeFile, &amp;quot;/&amp;quot;)&quot;>&#xa;                        &lt;ns:NOME_FILE>&#xa;                            &lt;xsl:value-of select=&quot;tib:substring-after-last($NomeFile, '/')&quot;/>&#xa;                        &lt;/ns:NOME_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:NOME_FILE>&#xa;                            &lt;xsl:value-of select=&quot;tib:substring-after-last($NomeFile, '\')&quot;/>&#xa;                        &lt;/ns:NOME_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:TIMSTP_APERTURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_APERTURA_FILE>&#xa;                &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;ns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;'INPUT'&quot;/>&#xa;                &lt;/ns:VERSO_DEL_FILE>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:FileProcessatoInput>&#xa;                &lt;ns:DATA_ARRIVO>&#xa;                    &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                &lt;/ns:DATA_ARRIVO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($ListFiles/files/fileInfo)=0&quot;>&#xa;                        &lt;ns:ID_CAUS_SCARTO>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/ns:ID_CAUS_SCARTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ID_CAUS_SCARTO>&#xa;                            &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                        &lt;/ns:ID_CAUS_SCARTO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ns:FileProcessatoInput>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;ns:TMSP_INIZIO_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_INIZIO_ELAB>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
