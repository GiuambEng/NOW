                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="11fd280c-9c2e-47c6-8836-2284cdfd4dd0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RemoveTempFileToEnd"/>
                        <bpws:target linkName="JDBC_SISTEMA_NWSToEnd"/>
                        <bpws:target linkName="PutNWSToEnd"/>
                        <bpws:target linkName="ReadFileToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+32b0d3f7-341f-44a9-a287-3d56f9cd05bd+input&quot; xmlns:tns2=&quot;http://www.example.org/WriteToCrmws&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBC_SISTEMA_NWS-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CodInterface>&lt;xsl:value-of select=&quot;&amp;quot;ID256&amp;quot;&quot;/>&lt;/CodInterface>&lt;DescrizioneSistema>&lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&lt;/DescrizioneSistema>&lt;CodOLOAgcom>&lt;xsl:value-of select=&quot;$Start/tns2:CodOloAGCOM&quot;/>&lt;/CodOLOAgcom>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_SISTEMA_NWS-input"
                    name="JDBC_SISTEMA_NWS"
                    outputVariable="JDBC_SISTEMA_NWS"
                    tibex:xpdlId="32b0d3f7-341f-44a9-a287-3d56f9cd05bd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($JDBC_SISTEMA_NWS/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($JDBC_SISTEMA_NWS/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBC_SISTEMA_NWSToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+32b0d3f7-341f-44a9-a287-3d56f9cd05bd+input&quot; xmlns:tns2=&quot;http://www.example.org/WriteToCrmws&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBC_SISTEMA_NWS-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CodInterface>&lt;xsl:value-of select=&quot;&amp;quot;ID256&amp;quot;&quot;/>&lt;/CodInterface>&lt;DescrizioneSistema>&lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&lt;/DescrizioneSistema>&lt;CodOLOAgcom>&lt;xsl:value-of select=&quot;$Start/tns2:CodOloAGCOM&quot;/>&lt;/CodOLOAgcom>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NTR.IP, NTR.LOCAL_PATH, NTR.NOME_HOST, NTR.PORT, NTR.REMOTE_PATH, NTR.UTENZA&#xa; FROM SISTEMA_IP_INTRFC NTR, SISTEMA SIS&#xa; WHERE NTR.ID_SISTEMA = SIS.ID_SISTEMA AND ID_INTRFC=(SELECT ID_INTRFC FROM INTRFC WHERE COD_INTRFC=?) AND DESCR_SISTEMA_NOME_SISTEMA = ? AND CODFC_OLO_AGCOM=? &#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodInterface"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DescrizioneSistema"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodOLOAgcom"/>
                                    <columnMetadata columnName="IP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="LOCAL_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_HOST"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PORT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="REMOTE_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="UTENZA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/WriteToCrmws&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_SISTEMA_NWS&quot;/>&#xa;    &lt;xsl:param name=&quot;NWSPassword&quot;/>&#xa;    &lt;xsl:template name=&quot;PutCRMWS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SFTP_Put_Input>&#xa;            &lt;tns1:FileToBeSend>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns2:FileFullName&quot;/>&#xa;            &lt;/tns1:FileToBeSend>&#xa;            &lt;tns1:RomoteDirectory>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_SISTEMA_NWS/Record[1]/REMOTE_PATH&quot;/>&#xa;            &lt;/tns1:RomoteDirectory>&#xa;            &lt;tns1:Credentials>&#xa;                &lt;tns1:Host>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_SISTEMA_NWS/Record[1]/NOME_HOST&quot;/>&#xa;                &lt;/tns1:Host>&#xa;                &lt;tns1:Port>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_SISTEMA_NWS/Record[1]/PORT)&quot;/>&#xa;                &lt;/tns1:Port>&#xa;                &lt;tns1:User>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_SISTEMA_NWS/Record[1]/UTENZA&quot;/>&#xa;                &lt;/tns1:User>&#xa;                &lt;tns1:Password>&#xa;                    &lt;xsl:value-of select=&quot;$NWSPassword&quot;/>&#xa;                &lt;/tns1:Password>&#xa;            &lt;/tns1:Credentials>&#xa;        &lt;/tns1:SFTP_Put_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="PutNWS-input" name="PutNWS"
                    outputVariable="PutNWS"
                    tibex:xpdlId="bb8a9a8f-afdf-4d4e-9b9e-22545b0fa077"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WriteFileToPutNWS"/>
                        <bpws:target linkName="ReadFileToPutNWS1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="PutCRMWSToCreateFile">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$PutNWS/ns3:Status=&quot;OK&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$PutNWS/ns3:Status="OK"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PutNWSToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/WriteToCrmws&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_SISTEMA_NWS&quot;/>&#xa;    &lt;xsl:param name=&quot;NWSPassword&quot;/>&#xa;    &lt;xsl:template name=&quot;PutCRMWS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SFTP_Put_Input>&#xa;            &lt;tns1:FileToBeSend>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns2:FileFullName&quot;/>&#xa;            &lt;/tns1:FileToBeSend>&#xa;            &lt;tns1:RomoteDirectory>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_SISTEMA_NWS/Record[1]/REMOTE_PATH&quot;/>&#xa;            &lt;/tns1:RomoteDirectory>&#xa;            &lt;tns1:Credentials>&#xa;                &lt;tns1:Host>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_SISTEMA_NWS/Record[1]/NOME_HOST&quot;/>&#xa;                &lt;/tns1:Host>&#xa;                &lt;tns1:Port>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_SISTEMA_NWS/Record[1]/PORT)&quot;/>&#xa;                &lt;/tns1:Port>&#xa;                &lt;tns1:User>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_SISTEMA_NWS/Record[1]/UTENZA&quot;/>&#xa;                &lt;/tns1:User>&#xa;                &lt;tns1:Password>&#xa;                    &lt;xsl:value-of select=&quot;$NWSPassword&quot;/>&#xa;                &lt;/tns1:Password>&#xa;            &lt;/tns1:Credentials>&#xa;        &lt;/tns1:SFTP_Put_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="SFTP.SFTP_Put_New" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WriteTo_start&quot; xmlns:tns2=&quot;http://www.example.org/WriteToCrmws&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Estensione&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CreateTempFileTappoCrmws-input&quot; match=&quot;/&quot;>&lt;tns:CreateActivityInputClass>&lt;fileName>&lt;xsl:value-of select=&quot;concat(substring-before($Start/tns2:FileFullName,$Estensione),'.tp')&quot;/>&lt;/fileName>&lt;/tns:CreateActivityInputClass>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CreateTempFileTappoNws-input"
                    name="CreateTempFileTappoNws"
                    outputVariable="CreateTempFileTappoNws"
                    tibex:xpdlId="080c8f4f-87bb-4cdc-b8ed-9365dcbb7fe7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PutCRMWSToCreateFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CreateTempFileTappoCrmwsToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WriteTo_start&quot; xmlns:tns2=&quot;http://www.example.org/WriteToCrmws&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Estensione&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CreateTempFileTappoCrmws-input&quot; match=&quot;/&quot;>&lt;tns:CreateActivityInputClass>&lt;fileName>&lt;xsl:value-of select=&quot;concat(substring-before($Start/tns2:FileFullName,$Estensione),'.tp')&quot;/>&lt;/fileName>&lt;/tns:CreateActivityInputClass>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.file.create"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//CreateFile"/>
                                    <value
                                    createMissingDirectories="true"
                                    overwrite="true" xsi:type="file:CreateFile"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateTempFileTappoNws&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_SISTEMA_NWS&quot;/>&#xa;    &lt;xsl:param name=&quot;NWSPassword&quot;/>&#xa;    &lt;xsl:template name=&quot;PutTappoCRMWS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:SFTP_Put_Input>&#xa;            &lt;tns:FileToBeSend>&#xa;                &lt;xsl:value-of select=&quot;$CreateTempFileTappoNws/fileInfo/fullName&quot;/>&#xa;            &lt;/tns:FileToBeSend>&#xa;            &lt;tns:RomoteDirectory>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_SISTEMA_NWS/Record[1]/REMOTE_PATH&quot;/>&#xa;            &lt;/tns:RomoteDirectory>&#xa;            &lt;tns:Credentials>&#xa;                &lt;tns:Host>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_SISTEMA_NWS/Record[1]/NOME_HOST&quot;/>&#xa;                &lt;/tns:Host>&#xa;                &lt;tns:Port>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_SISTEMA_NWS/Record[1]/PORT)&quot;/>&#xa;                &lt;/tns:Port>&#xa;                &lt;tns:User>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_SISTEMA_NWS/Record[1]/UTENZA&quot;/>&#xa;                &lt;/tns:User>&#xa;                &lt;tns:Password>&#xa;                    &lt;xsl:value-of select=&quot;$NWSPassword&quot;/>&#xa;                &lt;/tns:Password>&#xa;            &lt;/tns:Credentials>&#xa;        &lt;/tns:SFTP_Put_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="PutTappoNWS-input" name="PutTappoNWS"
                    outputVariable="PutTappoNWS"
                    tibex:xpdlId="8883b1bf-fe4f-4f17-b24b-a96bde209cc0"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CreateTempFileTappoCrmwsToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="PutTappoCRMWSToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateTempFileTappoNws&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_SISTEMA_NWS&quot;/>&#xa;    &lt;xsl:param name=&quot;NWSPassword&quot;/>&#xa;    &lt;xsl:template name=&quot;PutTappoCRMWS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:SFTP_Put_Input>&#xa;            &lt;tns:FileToBeSend>&#xa;                &lt;xsl:value-of select=&quot;$CreateTempFileTappoNws/fileInfo/fullName&quot;/>&#xa;            &lt;/tns:FileToBeSend>&#xa;            &lt;tns:RomoteDirectory>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_SISTEMA_NWS/Record[1]/REMOTE_PATH&quot;/>&#xa;            &lt;/tns:RomoteDirectory>&#xa;            &lt;tns:Credentials>&#xa;                &lt;tns:Host>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_SISTEMA_NWS/Record[1]/NOME_HOST&quot;/>&#xa;                &lt;/tns:Host>&#xa;                &lt;tns:Port>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_SISTEMA_NWS/Record[1]/PORT)&quot;/>&#xa;                &lt;/tns:Port>&#xa;                &lt;tns:User>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_SISTEMA_NWS/Record[1]/UTENZA&quot;/>&#xa;                &lt;/tns:User>&#xa;                &lt;tns:Password>&#xa;                    &lt;xsl:value-of select=&quot;$NWSPassword&quot;/>&#xa;                &lt;/tns:Password>&#xa;            &lt;/tns:Credentials>&#xa;        &lt;/tns:SFTP_Put_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="SFTP.SFTP_Put_New" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;PutNWS&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateTempFileTappoNws&quot;/>&#xa;    &lt;xsl:param name=&quot;PutTappoNWS&quot;/>&#xa;    &lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: AnalyzeOloRequest | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;stato put crmws : &amp;quot;, $PutNWS/tns1:Status, &amp;quot;&amp;#xD;&amp;#xA;messaggio put crmws : &amp;quot;, $PutNWS/tns1:Message, &amp;quot;&amp;#xD;&amp;#xA;stato put tappo crmws : &amp;quot;, $PutTappoNWS/tns1:Status, &amp;quot;&amp;#xD;&amp;#xA; messaggio put tappo crmws : &amp;quot;, $PutTappoNWS/tns1:Message, &amp;quot;&amp;#xD;&amp;#xA;File tappo creato in locale al percorso &amp;quot;, $CreateTempFileTappoNws/fileInfo/fullName)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Log-input" name="Log"
                    tibex:xpdlId="1abe6c60-6b5f-45e3-8057-8e89f9ae8697" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PutTappoCRMWSToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToRemoveFile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;PutNWS&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateTempFileTappoNws&quot;/>&#xa;    &lt;xsl:param name=&quot;PutTappoNWS&quot;/>&#xa;    &lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: AnalyzeOloRequest | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;stato put crmws : &amp;quot;, $PutNWS/tns1:Status, &amp;quot;&amp;#xD;&amp;#xA;messaggio put crmws : &amp;quot;, $PutNWS/tns1:Message, &amp;quot;&amp;#xD;&amp;#xA;stato put tappo crmws : &amp;quot;, $PutTappoNWS/tns1:Status, &amp;quot;&amp;#xD;&amp;#xA; messaggio put tappo crmws : &amp;quot;, $PutTappoNWS/tns1:Message, &amp;quot;&amp;#xD;&amp;#xA;File tappo creato in locale al percorso &amp;quot;, $CreateTempFileTappoNws/fileInfo/fullName)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Debug"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateTempFileTappoNws&quot;/>&#xa;    &lt;xsl:template name=&quot;RemoveTempFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RemoveActivityInputClass>&#xa;            &lt;fileName>&#xa;                &lt;xsl:value-of select=&quot;$CreateTempFileTappoNws/fileInfo/fullName&quot;/>&#xa;            &lt;/fileName>&#xa;        &lt;/tns:RemoveActivityInputClass>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="RemoveTempFile-input"
                    name="RemoveTempFile"
