                                    expression="exists($EstrazioneDati/Record[OLO_RICHIEDENTE=$OloArray/ns9:OLO[number($index)] and STATO='ELABORATA' and COMPETENZA='NOW'])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($EstrazioneDati/Record[OLO_RICHIEDENTE=$OloArray/ns9:OLO[number($index)] and STATO='ELABORATA' and COMPETENZA='NOW'])]]></bpws:transitionCondition>
                                    </bpws:source>
