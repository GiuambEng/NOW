                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/render/xsd/+8faf5117-6aa6-473f-ba41-dd14b4504bc3+input&quot; xmlns:tns1=&quot;http://www.example.org/OutputTracciato1&quot; xmlns:tns2=&quot;http://www.example.org/OloDistinti&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;EstrazioneDati&quot;/>&lt;xsl:param name=&quot;OloArray&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;Renderdata-input&quot; match=&quot;/&quot;>&lt;tns:Rows>&lt;xsl:for-each select=&quot;$EstrazioneDati/Record[OLO_RICHIEDENTE=$OloArray/tns2:OLO[number($index)] and STATO='ELABORATA' and COMPETENZA='NOW']&quot;>&lt;tns1:root>&lt;tns1:IdRichiesta>&lt;xsl:value-of select=&quot;ID_RICH&quot;/>&lt;/tns1:IdRichiesta>&lt;tns1:CodiceOrdineOlo>&lt;xsl:value-of select=&quot;COD_ORDN_OLO&quot;/>&lt;/tns1:CodiceOrdineOlo>&lt;tns1:Olo>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns1:Olo>&lt;tns1:CodiceOrdineTI>&lt;xsl:value-of select=&quot;COD_ORDN_TI&quot;/>&lt;/tns1:CodiceOrdineTI>&lt;tns1:TipoNotifica>&lt;xsl:value-of select=&quot;COD_TIPOLG_NOTF&quot;/>&lt;/tns1:TipoNotifica>&lt;tns1:FileNotifica>&lt;xsl:value-of select=&quot;NOME_FILE_NOTF&quot;/>&lt;/tns1:FileNotifica>&lt;tns1:DataInvioNotifica>&lt;xsl:value-of select=&quot;DATA_INVIO_NOTF&quot;/>&lt;/tns1:DataInvioNotifica>&lt;tns1:MotivoRifiuto>&lt;xsl:value-of select=&quot;MOTIVO_RIFIUTO&quot;/>&lt;/tns1:MotivoRifiuto>&lt;tns1:CodiceEsito>&lt;xsl:value-of select=&quot;COD_ESITO&quot;/>&lt;/tns1:CodiceEsito>&lt;tns1:TracciatoFile>&lt;xsl:value-of select=&quot;concat(TRACCIATO_FILE,&amp;quot;|&amp;quot;)&quot;/>&lt;/tns1:TracciatoFile>&lt;/tns1:root>&lt;/xsl:for-each>&lt;/tns:Rows>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
