eXml/DRO"/&gt;&lt;/DRO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/IDNotifica"&gt;&lt;IDNotifica&gt;&lt;xsl:value-of select="$ParseXml/IDNotifica"/&gt;&lt;/IDNotifica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codificaOLOAGCOMDonating"&gt;&lt;codificaOLOAGCOMDonating&gt;&lt;xsl:value-of select="$ParseXml/codificaOLOAGCOMDonating"/&gt;&lt;/codificaOLOAGCOMDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codificaOLOAGCOMDonor"&gt;&lt;codificaOLOAGCOMDonor&gt;&lt;xsl:value-of select="$ParseXml/codificaOLOAGCOMDonor"/&gt;&lt;/codificaOLOAGCOMDonor&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codificaOLONOWDonating"&gt;&lt;codificaOLONOWDonating&gt;&lt;xsl:value-of select="$ParseXml/codificaOLONOWDonating"/&gt;&lt;/codificaOLONOWDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codificaOLONOWDonor"&gt;&lt;codificaOLONOWDonor&gt;&lt;xsl:value-of select="$ParseXml/codificaOLONOWDonor"/&gt;&lt;/codificaOLONOWDonor&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/numeroTelefonico"&gt;&lt;numeroTelefonico&gt;&lt;xsl:value-of select="$ParseXml/numeroTelefonico"/&gt;&lt;/numeroTelefonico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/tipologiaScenario"&gt;&lt;tipologiaScenario&gt;&lt;xsl:value-of select="$ParseXml/tipologiaScenario"/&gt;&lt;/tipologiaScenario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/DAC"&gt;&lt;DAC&gt;&lt;xsl:value-of select="$ParseXml/DAC"/&gt;&lt;/DAC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/progressivoNotificaDTU"&gt;&lt;progressivoNotificaDTU&gt;&lt;xsl:value-of select="$ParseXml/progressivoNotificaDTU"/&gt;&lt;/progressivoNotificaDTU&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codificaOLOAGCOMRic"&gt;&lt;codificaOLOAGCOMRic&gt;&lt;xsl:value-of select="$ParseXml/codificaOLOAGCOMRic"/&gt;&lt;/codificaOLOAGCOMRic&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/IDNotificaDonor"&gt;&lt;IDNotificaDonor&gt;&lt;xsl:value-of select="$ParseXml/IDNotificaDonor"/&gt;&lt;/IDNotificaDonor&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/IDNotificaDonating"&gt;&l