 select="flagInLavorazione"/&gt;&lt;/flagInLavorazione&gt;&lt;/assetTarget&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$ParseXml/operatoreRete"&gt;&lt;operatoreRete&gt;&lt;xsl:value-of select="$ParseXml/operatoreRete"/&gt;&lt;/operatoreRete&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/transactionIDLocator"&gt;&lt;transactionIDLocator&gt;&lt;xsl:value-of select="$ParseXml/transactionIDLocator"/&gt;&lt;/transactionIDLocator&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/flagNumAggiuntive"&gt;&lt;flagNumAggiuntive&gt;&lt;xsl:value-of select="$ParseXml/flagNumAggiuntive"/&gt;&lt;/flagNumAggiuntive&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/IDAnagraficaCausaleGUI"&gt;&lt;IDAnagraficaCausaleGUI&gt;&lt;xsl:value-of select="$ParseXml/IDAnagraficaCausaleGUI"/&gt;&lt;/IDAnagraficaCausaleGUI&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codiceRifiutoDonating"&gt;&lt;codiceRifiutoDonating&gt;&lt;xsl:value-of select="$ParseXml/codiceRifiutoDonating"/&gt;&lt;/codiceRifiutoDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/DACFile"&gt;&lt;DACFile&gt;&lt;xsl:value-of select="$ParseXml/DACFile"/&gt;&lt;/DACFile&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/tipologiaSottolav"&gt;&lt;tipologiaSottolav&gt;&lt;xsl:value-of select="$ParseXml/tipologiaSottolav"/&gt;&lt;/tipologiaSottolav&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codiceRifiuto"&gt;&lt;codiceRifiuto&gt;&lt;xsl:value-of select="$ParseXml/codiceRifiuto"/&gt;&lt;/codiceRifiuto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/routingNumber"&gt;&lt;routingNumber&gt;&lt;xsl:value-of select="$ParseXml/routingNumber"/&gt;&lt;/routingNumber&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/progressivoEmissioneDTU"&gt;&lt;progressivoEmissioneDTU&gt;&lt;xsl:value-of select="$ParseXml/progressivoEmissioneDTU"/&gt;&lt;/progressivoEmissioneDTU&gt;&lt;/xsl:if&gt;&lt;/ns:RichiestaElement&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($EstrazioneDati/Record[number($index)]/COD_TIPOLG_NOTF)&gt;0"&gt;&lt;ns011:TipologiaNotifica&gt;&lt;xsl:value-of select="$EstrazioneDati/Record[number($index)]/COD_TIPOLG_NOTF"/&gt;&lt;/ns011:TipologiaNotifica&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns011:TipologiaNotifica&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/ns011:TipologiaNotifica&gt;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            &lt;!--Scelto valore di default KO per evitare di passare null--&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns011:TipologiaOLODestinatario&gt;&lt;xsl:value-of select="upper-case($EstrazioneDati/Record[number($index)]/TIPOLG_DESTNRIO)"/&gt;&lt;/ns011:TipologiaOLODestinatario&gt;&lt;xsl:if test="$EstrazioneDati/Record[number($index)]/CODFC_OLO_AGCOM_DESTNRIO"&gt;&lt;ns011:CodificaOLOAGCOMDestinatario&gt;&lt;xsl:value-of select="$EstrazioneDati/Record[number($index)]/CODFC_OLO_AGCOM_DESTNRIO"/&gt;&lt;/ns011:CodificaOLOAGCOMDestinatario&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$CheckDoppioDonating/tns:DoppioDonating=true() and $index1=1"&gt;&lt;ns011:IDAssetConsistenza&gt;&lt;xsl:value-of select="xsd:long($ParseXml/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo)"/&gt;&lt;/ns011:IDAssetConsistenza&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$CheckDoppioDonating/tns:DoppioDonating=true() and $index1=2"&gt;&lt;ns011:IDAssetConsistenza&gt;&lt;xsl:value-of select="xsd:long($ParseXml/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo)"/&gt;&lt;/ns011:IDAssetConsistenza&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;/ns011:GenerazioneNotifiche&gt;&lt;/ns011:ReinvioDaFILE&gt;&lt;/ns011:ReinvioSchedulerRequest&gt;&lt;/ReinvioSchedulerInput&gt;&lt;/ns2:ReinvioSchedulerRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns011=&quot;http://www.tim.com/NOW/xsd/ReinvioScheduler&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/wsdl/concrete/ReinvioScheduler/&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1519384645923&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;EstrazioneDati&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckDoppioDonating&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:template name=&quot;GenerazioneNotifica-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns011:ReinvioSchedulerRequest>&#xa;            &lt;ns011:ReinvioDaFILE>&#xa;                &lt;ns011:GenerazioneNotifiche>&#xa;                    &lt;ns:RichiestaElement>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/lastUpdate&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/IDRichiestaOLO&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;statoRichiestaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/statoRichiestaNOW&quot;/>&#xa;                        &lt;/statoRichiestaNOW>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/statoRichiestaPrecedNOW&quot;>&#xa;                            &lt;statoRichiestaPrecedNOW>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/statoRichiestaPrecedNOW&quot;/>&#xa;                            &lt;/statoRichiestaPrecedNOW>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/statoRichiestaOLO&quot;>&#xa;                            &lt;statoRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/statoRichiestaOLO&quot;/>&#xa;                            &lt;/statoRichiestaOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/statoRichiestaPrecedOLO&quot;>&#xa;                            &lt;statoRichiestaPrecedOLO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/statoRichiestaPrecedOLO&quot;/>&#xa;                            &lt;/statoRichiestaPrecedOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/sottostatoLavorManuale&quot;>&#xa;                            &lt;sottostatoLavorManuale>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/sottostatoLavorManuale&quot;/>&#xa;                            &lt;/sottostatoLavorManuale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/IDFileInput&quot;>&#xa;                            &lt;IDFileInput>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/IDFileInput&quot;/>&#xa;                            &lt;/IDFileInput>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/IDFileOutput&quot;>&#xa;                            &lt;IDFileOutput>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/IDFileOutput&quot;/>&#xa;                            &lt;/IDFileOutput>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/ambito&quot;>&#xa;                            &lt;ambito>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/ambito&quot;/>&#xa;                            &lt;/ambito>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;canaleRichiesta>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/canaleRichiesta&quot;/>&#xa;                        &lt;/canaleRichiesta>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/lavorazione&quot;>&#xa;                            &lt;lavorazione>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/lavorazione&quot;/>&#xa;                            &lt;/lavorazione>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/progressivoRichiestaFile&quot;>&#xa;                            &lt;progressivoRichiestaFile>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/progressivoRichiestaFile&quot;/>&#xa;                            &lt;/progressivoRichiestaFile>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;strutturaRichiesta>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/strutturaRichiesta&quot;/>&#xa;                        &lt;/strutturaRichiesta>&#xa;                        &lt;tipoRichiesta>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/tipoRichiesta&quot;/>&#xa;                        &lt;/tipoRichiesta>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/IDRisorsa&quot;>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/IDRisorsa&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;