/xsl:if>&#xa;                                &lt;xsl:if test=&quot;noteCliente&quot;>&#xa;                                    &lt;noteCliente>&#xa;                                        &lt;xsl:value-of select=&quot;noteCliente&quot;/>&#xa;                                    &lt;/noteCliente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;notedaSistema&quot;>&#xa;                                    &lt;notedaSistema>&#xa;                                        &lt;xsl:value-of select=&quot;notedaSistema&quot;/>&#xa;                                    &lt;/notedaSistema>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;totaleOrdRilevPacchetto&quot;>&#xa;                                    &lt;totaleOrdRilevPacchetto>&#xa;                                        &lt;xsl:value-of select=&quot;totaleOrdRilevPacchetto&quot;/>&#xa;                                    &lt;/totaleOrdRilevPacchetto>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;CLLI&quot;>&#xa;                                    &lt;CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;CLLI&quot;/>&#xa;                                    &lt;/CLLI>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;codificaOLONOW>&#xa;                                    &lt;xsl:value-of select=&quot;codificaOLONOW&quot;/>&#xa;                                &lt;/codificaOLONOW>&#xa;                                &lt;xsl:if test=&quot;codiceOrdineOLO&quot;>&#xa;                                    &lt;codiceOrdineOLO>&#xa;                                        &lt;xsl:value-of select=&quot;codiceOrdineOLO&quot;/>&#xa;                                    &lt;/codiceOrdineOLO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;codiceOrdineOLOPadre&quot;>&#xa;                                    &lt;codiceOrdineOLOPadre>&#xa;                                        &lt;xsl:value-of select=&quot;codiceOrdineOLOPadre&quot;/>&#xa;                                    &lt;/codiceOrdineOLOPadre>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;codiceOrdineTI&quot;>&#xa;                                    &lt;codiceOrdineTI>&#xa;                                        &lt;xsl:value-of select=&quot;codiceOrdineTI&quot;/>&#xa;                                    &lt;/codiceOrdineTI>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;codiceProgetto&quot;>&#xa;                                    &lt;codiceProgetto>&#xa;                                        &lt;xsl:value-of select=&quot;codiceProgetto&quot;/>&#xa;                                    &lt;/codiceProgetto>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;codificaOLOAGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;codificaOLOAGCOM&quot;/>&#xa;                                &lt;/codificaOLOAGCOM>&#xa;                                &lt;xsl:if test=&quot;DADRimodulata&quot;>&#xa;                                    &lt;DADRimodulata>&#xa;                                        &lt;xsl:value-of select=&quot;DADRimodulata&quot;/>&#xa;                                    &lt;/DADRimodulata>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;DEC&quot;>&#xa;                                    &lt;DEC>&#xa;                                        &lt;xsl:value-of select=&quot;DEC&quot;/>&#xa;                                    &lt;/DEC>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;DES&quot;>&#xa;                                    &lt;DES>&#xa;                                        &lt;xsl:value-of select=&quot;DES&quot;/>&#xa;                                    &lt;/DES>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ORA_DES&quot;>&#xa;                                    &lt;ORA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;ORA_DES&quot;/>&#xa;                                    &lt;/ORA_DES>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                                    &lt;IDRisorsa>&#xa;                                        &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                    &lt;/IDRisorsa>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;tipologiaLavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;tipologiaLavorazione&quot;/>&#xa;                                &lt;/tipologiaLavorazione>&#xa;                                &lt;xsl:if test=&quot;tipologiaSottolav&quot;>&#xa;                                    &lt;tipologiaSottolav>&#xa;                                        &lt;xsl:value-of select=&quot;tipologiaSottolav&quot;/>&#xa;                                    &lt;/tipologiaSottolav>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;LNA_LA&quot;>&#xa;                                    &lt;LNA_LA>&#xa;                                        &lt;xsl:value-of select=&quot;LNA_LA&quot;/>&#xa;                                    &lt;/LNA_LA>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;modalitaFatturazione&quot;>&#xa;                                    &lt;modalitaFatturazione>&#xa;                                        &lt;xsl:value-of select=&quot;modalitaFatturazione&quot;/>&#xa;                                    &lt;/modalitaFatturazione>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;operatore&quot;>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;RO&quot;>&#xa;                                    &lt;RO>&#xa;                                        &lt;xsl:value-of select=&quot;RO&quot;/>&#xa;                                    &lt;/RO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tipoPacchetto&quot;>&#xa;                                    &lt;tipoPacchetto>&#xa;                                        &lt;xsl:value-of select=&quot;tipoPacchetto&quot;/>&#xa;                                    &lt;/tipoPacchetto>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;dataInvioOrdineADelivery&quot;>&#xa;                                    &lt;dataInvioOrdineADelivery>&#xa;                                        &lt;xsl:value-of select=&quot;dataInvioOrdineADelivery&quot;/>&#xa;                                    &lt;/dataInvioOrdineADelivery>&#xa;                                &lt;/xsl:if>&#xa;                            