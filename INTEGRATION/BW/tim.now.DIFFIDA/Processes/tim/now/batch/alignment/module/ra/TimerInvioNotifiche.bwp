                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.example.org/OloDistinti&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Renderdata&quot;/>&lt;xsl:param name=&quot;PathFileOutput&quot;/>&lt;xsl:param name=&quot;Estensione&quot;/>&lt;xsl:param name=&quot;OloArray&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;RootPath&quot;/>&lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&lt;tns:WriteActivityInputTextClass>&lt;fileName>&lt;xsl:value-of select=&quot;concat($RootPath,$OloArray/tns1:OLO[number($index)],$PathFileOutput,$OloArray/tns1:OLO[number($index)],'_',format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;),'_RESPONSE_NOW', $Estensione)&quot;/>&lt;/fileName>&lt;textContent>&lt;xsl:value-of select=&quot;concat(&amp;quot;Id richiesta|Codice ordine OLO|OLO|Codice Ordine TI|Tipo Notifica|Nome File Notifica|Data invio notifica|Motivo rifiuto|Esito notifica|Testo notifica|&amp;#xD;&amp;#xA;&amp;quot;,$Renderdata)&quot;/>&lt;/textContent>&lt;/tns:WriteActivityInputTextClass>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
