         &lt;xsl:if test=&quot;nome&quot;>&#xa;                                    &lt;nome>&#xa;                                        &lt;xsl:value-of select=&quot;nome&quot;/>&#xa;                                    &lt;/nome>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;CF&quot;>&#xa;                                    &lt;CF>&#xa;                                        &lt;xsl:value-of select=&quot;CF&quot;/>&#xa;                                    &lt;/CF>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;PIVA&quot;>&#xa;                                    &lt;PIVA>&#xa;                                        &lt;xsl:value-of select=&quot;PIVA&quot;/>&#xa;                                    &lt;/PIVA>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;IDSLUCo&quot;>&#xa;                                    &lt;IDSLUCo>&#xa;                                        &lt;xsl:value-of select=&quot;IDSLUCo&quot;/>&#xa;                                    &lt;/IDSLUCo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;IDULLCo&quot;>&#xa;                                    &lt;IDULLCo>&#xa;                                        &lt;xsl:value-of select=&quot;IDULLCo&quot;/>&#xa;                                    &lt;/IDULLCo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;codiceDelivery&quot;>&#xa;                                    &lt;codiceDelivery>&#xa;                                        &lt;xsl:value-of select=&quot;codiceDelivery&quot;/>&#xa;                                    &lt;/codiceDelivery>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;DNOLOCollaudo&quot;>&#xa;                                    &lt;DNOLOC