ormat:root[number($index)]/OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodOLOdestinatario>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($JDBCQuery/Record[1]/CODIFICAOLOAGCOM)>0&quot;>&#xa;                    &lt;CodfcOloAgcom>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery/Record[1]/CODIFICAOLOAGCOM)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODIFICAOLOAGCOM&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CodfcOloAgcom>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CodfcOloAgcom xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ParseData/Rows/dataformat:root[number($index)]/CodiceOrdineTI)>0&quot;>&#xa;                    &lt;CodOrdineTI>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($ParseData/Rows/dataformat:root[number($index)]/CodiceOrdineTI)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$ParseData/Rows/dataformat:root[number($index)]/CodiceOrdineTI&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CodOrdineTI>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CodOrdineTI xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ParseData/Rows/dataformat:root[number($index)]/CodiceOrdineOLO)=0 and string-length($ParseData/Rows/dataformat:root[number($index)]/CodiceOrdineTI)=0&quot;>&#xa;                    &lt;Competenza xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(string-length($ParseData/Rows/dataformat:root[number($index)]/CodiceOrdineOLO)>0 or string-length($ParseData/Rows/dataformat:root[number($index)]/CodiceOrdineTI)>0) and count($JDBCQuery/Record)>0&quot;>&#xa;                    &lt;Competenza>&#xa;                        &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                    &lt;/Competenza>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Competenza>&#xa;                        &lt;xsl:value-of select=&quot;'NWS'&quot;/>&#xa;                    &lt;/Competenza>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ParseData/Rows/dataformat:root[number($index)]/CodiceOrdineOLO)=0 and string-length($ParseData/Rows/dataformat:root[number($index)]/CodiceOrdineTI)=0&quot;>&#xa;                    &lt;Stato xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(string-length($ParseData/Rows/dataformat:root[number($index)]/CodiceOrdineOLO)>0 or string-length($ParseData/Rows/dataformat:root[number($index)]/