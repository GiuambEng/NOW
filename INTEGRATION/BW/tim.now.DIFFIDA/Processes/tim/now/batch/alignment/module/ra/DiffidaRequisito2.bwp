                                    sqlStatement="INSERT INTO DIFD_AGCRICRSP_NTFORD&#xa;(MOTIVO_RIFIUTO,COD_ESITO,ID_RICH,COD_ORDN_OLO,CODFC_OLO_AGCOM,CODFC_OLO_AGCOM_DESTNRIO,COD_OLO_NUMERICO,COD_ORDN_TI,TIMSTP_INSMTO,COMPETENZA,STATO,ID_FILE_PROCSTO_INPUT,NUMERO_RECD,CONTENUTO_RECD)&#xa;SELECT  ?,'00012',?,NULL,NULL,?,NULL,NULL,SYSDATE,NULL,'ELABORATA',?,?,?&#xa;FROM DUAL&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

