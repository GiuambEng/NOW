                 &lt;xsl:value-of select=&quot;$ParseData/Rows/dataformat:root[number($index)]/OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodAgcomDest>&#xa;            &lt;IdFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($InvokeProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;            &lt;/IdFile>&#xa;            &lt;NumRecd>&#xa;                &lt;xsl:value-of select=&quot;$index&quot;/>&#xa;            &lt;/NumRecd>&#xa;            &lt;ContenutoRecd>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($ParseData/Rows/dataformat:root[number($index)])&quot;/>&#xa;            &lt;/ContenutoRecd>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
