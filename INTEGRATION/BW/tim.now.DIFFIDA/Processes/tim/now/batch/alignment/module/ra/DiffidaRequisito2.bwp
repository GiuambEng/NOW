                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty1"
                                    sqlStatement="SELECT r.BDS_ID, r.CODIFICAOLOAGCOM FROM bds_1_casedata_ordine r WHERE  r.CODICEORDINETI=? OR (r.CODICEORDINEOLO=? AND r.CODIFICAOLOAGCOM=? )&#xa;UNION SELECT a.BDS_ID, a.CODIFICAOLOAGCOM FROM bds_1_casedata_richiesta a WHERE  (a.CODICEORDINETI=? OR (a.CODICEORDINEOLO=? AND a.CODIFICAOLOAGCOM=?)) AND a.TIPORICHIESTA='ORDINE' AND a.STATORICHIESTANOW='SCARTATO' &#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOrdineTI"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOrdineOLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOrdineTI_"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOrdineOLO_"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>

                                    <columnMetadata
                                    columnName="BDS_ID"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
