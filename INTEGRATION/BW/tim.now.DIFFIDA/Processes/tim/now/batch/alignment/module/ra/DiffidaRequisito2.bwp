                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+68680e4a-46aa-4dd0-92fb-d45cc7a5c0ec+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FindFile&quot;/>&#xa;    &lt;xsl:template name=&quot;FileProcstoScarto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;Esito>&#xa;                &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;            &lt;/Esito>&#xa;            &lt;NomeFile>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($FindFile/tns1:FileName)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$FindFile/tns1:FileName&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NomeFile>&#xa;            &lt;IdFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($InvokeProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;            &lt;/IdFile>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty1"
                                    sqlStatement="UPDATE FILE_PROCSTO&#xa;  SET ESITO = ?, DESCR_STATO_FILE ='SCARTATO'&#xa;  WHERE NOME_FILE = ? AND ID_FILE = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Esito"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NomeFile"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IdFile"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="OLO"
                    name="SetOLO" outputVariable="OLO"
                    tibex:xpdlId="e177866c-b04d-49c5-8ae5-8f812747f8dc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign1ToPathBadFile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(starts-with($FilePoller/fileInfo/fileName,$Costante)) then substring($FilePoller/fileInfo/fileName,string-length($Costante)+2,3) else substring($FilePoller/fileInfo/fileName,1,3)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="OLO" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="TracciaDuplicato-input"
                name="TracciaDuplicato" operation="Insert"
                outputVariable="TracciaDuplicato" partnerLink="Logger"
                portType="ns10:ProcessLog" tibex:xpdlId="2ad20ecc-06b5-4a78-ba1e-d22708af7aab">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" version="2.0"&gt;&lt;xsl:param name="ID_PROCSO_FILE"/&gt;&lt;xsl:param name="Input_ProcessLogger"/&gt;&lt;xsl:param name="WriteBadDuplicato"/&gt;&lt;xsl:template name="TracciaDuplicato-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/ns:ProcFile&gt;&lt;ns:FileProcessato&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO"&gt;&lt;ns:COD_OLO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO"/&gt;&lt;/ns:COD_OLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM"&gt;&lt;ns:CODFC_OLO_AGCOM&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM"/&gt;&lt;/ns:CODFC_OLO_AGCOM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE"&gt;&lt;ns:DATA_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE"/&gt;&lt;/ns:DATA_FILE&gt;&lt;/xsl:if&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="&amp;quot;DA INVIARE&amp;quot;"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/ns:ESITO&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:ID_INTRFC"&gt;&lt;ns:ID_INTRFC&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:ID_INTRFC"/&gt;&lt;/ns:ID_INTRFC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE"&gt;&lt;ns:IDTPLG_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE"/&gt;&lt;/ns:IDTPLG_FILE&gt;&lt;/xsl:if&gt;&lt;ns:NOME_FILE&gt;&lt;xsl:value-of select="$WriteBadDuplicato/fileInfo/fileName"/&gt;&lt;/ns:NOME_FILE&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"&gt;&lt;ns:TIMSTP_APERTURA_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"/&gt;&lt;/ns:TIMSTP_APERTURA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;/xsl:if&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="&amp;quot;OUTPUT&amp;quot;"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/ns:FileProcessato&gt;&lt;ns:EsecuzioneFile&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneFile&gt;&lt;ns:FileProcessatoOutput&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$WriteBadDuplicato/fileInfo/size"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;ns:TIMSTP_CREZIONE_FILE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_CREZIONE_FILE&gt;&lt;/ns:FileProcessatoOutput&gt;&lt;ns:ContenutoFile&gt;&lt;ns:ID_CONTENUTO_FILE&gt;&lt;xsl:value-of select="&amp;quot;1&amp;quot;"/&gt;&lt;/ns:ID_CONTENUTO_FILE&gt;&lt;ns:FullName&gt;&lt;xsl:value-of select="$WriteBadDuplicato/fileInfo/fullName"/&gt;&lt;/ns:FullName&gt;&lt;/ns:ContenutoFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;Input_ProcessLogger&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteBadDuplicato&quot;/>&#xa;    &lt;xsl:template name=&quot;TracciaDuplicato-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;ns:ID_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ID_PROCSO_FILE&quot;/>&#xa;                &lt;/ns:ID_PROCSO_FILE>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO&quot;>&#xa;                    &lt;ns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO&quot;/>&#xa;                    &lt;/ns:COD_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;ns:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CODFC_OLO_AGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE&quot;>&#xa;                    &lt;ns:DATA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE&quot;/>&#xa;                    &lt;/ns:DATA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&#xa;                &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:ID_INTRFC&quot;>&#xa;                    &lt;ns:ID_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:ID_INTRFC&quot;/>&#xa;                    &lt;/ns:ID_INTRFC>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE&quot;>&#xa;                    &lt;ns:IDTPLG_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE&quot;/>&#xa;                    &lt;/ns:IDTPLG_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:NOME_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$WriteBadDuplicato/fileInfo/fileName&quot;/>&#xa;                &lt;/ns:NOME_FILE>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;>&#xa;                    &lt;ns:TIMSTP_APERTURA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;/>&#xa;                    &lt;/ns:TIMSTP_APERTURA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;>&#xa;                    &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;/>&#xa;                    &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OUTPUT&amp;quot;&quot;/>&#xa;                &lt;/ns:VERSO_DEL_FILE>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_INIZIO_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_INIZIO_ELAB>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;            &lt;ns:FileProcessatoOutput>&#xa;                &lt;ns:DIMENSIONE_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$WriteBadDuplicato/fileInfo/size&quot;/>&#xa;                &lt;/ns:DIMENSIONE_FILE>&#xa;                &lt;ns:TIMSTP_CREZIONE_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_CREZIONE_FILE>&#xa;            &lt;/ns:FileProcessatoOutput>&#xa;            &lt;ns:ContenutoFile>&#xa;                &lt;ns:ID_CONTENUTO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                &lt;/ns:ID_CONTENUTO_FILE>&#xa;                &lt;ns:FullName>&#xa;                    &lt;xsl:value-of select=&quot;$WriteBadDuplicato/fileInfo/fullName&quot;/>&#xa;                &lt;/ns:FullName>&#xa;            &lt;/ns:ContenutoFile>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
