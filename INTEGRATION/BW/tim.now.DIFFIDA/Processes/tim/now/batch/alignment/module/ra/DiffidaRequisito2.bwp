            &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:DATA_ARRIVO&quot;>&#xa;                    &lt;ns:DATA_ARRIVO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:DATA_ARRIVO&quot;/>&#xa;                    &lt;/ns:DATA_ARRIVO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:DIMENSIONE_FILE&quot;>&#xa;                    &lt;ns:DIMENSIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:DIMENSIONE_FILE&quot;/>&#xa;                    &lt;/ns:DIMENSIONE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO&quot;>&#xa;                    &lt;ns:ID_CAUS_SCARTO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO&quot;/>&#xa;                    &lt;/ns:ID_CAUS_SCARTO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT&quot;>&#xa;                    &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT&quot;/>&#xa;                    &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_KO&quot;>&#xa;                    &lt;ns:QT_RECD_KO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_KO&quot;/>&#xa;                    &lt;/ns:QT_RECD_KO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_OK&quot;>&#xa;                    &lt;ns:QT_RECD_OK>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_OK&quot;/>&#xa;                    &lt;/ns:QT_RECD_OK>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_TOTALI&quot;>&#xa;                    &lt;ns:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_TOTALI&quot;/>&#xa;                    &lt;/ns:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessatoInput>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:COD_PROCSO_FILE&quot;>&#xa;                    &lt;ns:COD_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:COD_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:COD_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:STATO_ESEC&quot;>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:STATO_ESEC&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB&quot;>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB&quot;>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO&quot;>&#xa;                    &lt;ns:COD_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO&quot;/>&#xa;                    &lt;/ns:COD_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL&quot;>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE&quot;>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO&quot;>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:LogFileProcessato>&#xa;            &lt;ns:FileProcessatoOutput>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE&quot;>&#xa;                    &lt;ns:DIMENSIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE&quot;/>&#xa;                    &lt;/ns:DIMENSIONE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ESITO_INVIO&quot;>&#xa;                    &lt;ns:ESITO_INVIO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ESITO_INVIO&quot;/>&#xa;                    &lt;/ns:ESITO_INVIO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT&quot;>&#xa;                    &lt;ns:ID_FILE_PROCSTO_OUTPUT>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT&quot;/>&#xa;                    &lt;/ns:ID_FILE_PROCSTO_OUTPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI&quot;>&#xa;                    &lt;ns:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI&quot;/>&#xa;                    &lt;/ns:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE&quot;>&#xa;                    &lt;ns:TIMSTP_CREZIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE&quot;/>&#xa;                    &lt;/ns:TIMSTP_CREZIONE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_INVIO&quot;>&#xa;                    &lt;ns:TIMSTP_INVIO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_INVIO&quot;/>&#xa;                    &lt;/ns:TIMSTP_INVIO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessatoOutput>&#xa;            &lt;ns:ContenutoFile>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:ContenutoFile/ns:ID_CONTENUTO_FILE&quot;>&#xa;                    &lt;ns:ID_CONTENUTO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:ContenutoFile/ns:ID_CONTENUTO_FILE&quot;/>&#xa;                    &lt;/ns:ID_CONTENUTO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:ContenutoFile/ns:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:ContenutoFile/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:ContenutoFile/ns:FullName&quot;>&#xa;                    &lt;ns:FullName>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:ContenutoFile/ns:FullName&quot;/>&#xa;                    &lt;/ns:FullName>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:ContenutoFile>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
