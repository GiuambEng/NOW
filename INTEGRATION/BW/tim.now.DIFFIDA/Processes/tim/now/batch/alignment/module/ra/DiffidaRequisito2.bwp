            </bpws:invoke>
            <bpws:invoke inputVariable="Invoke-input" name="Invoke"
                operation="Insert" outputVariable="Invoke"
                partnerLink="Logger" portType="ns10:ProcessLog" tibex:xpdlId="1f23fbfd-993f-449d-911c-7729c3a5621b">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="ID_PROCSO_FILE"/&gt;&lt;xsl:param name="WriteFile"/&gt;&lt;xsl:param name="OLO"/&gt;&lt;xsl:param name="Id_Tipologia_File"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/ns:ProcFile&gt;&lt;ns:FileProcessato&gt;&lt;ns:CODFC_OLO_AGCOM&gt;&lt;xsl:value-of select="$OLO"/&gt;&lt;/ns:CODFC_OLO_AGCOM&gt;&lt;ns:DATA_FILE&gt;&lt;xsl:value-of select="current-date()"/&gt;&lt;/ns:DATA_FILE&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="&amp;quot;DA INVIARE&amp;quot;"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/ns:ESITO&gt;&lt;ns:ID_INTRFC&gt;&lt;xsl:value-of select="144"/&gt;&lt;/ns:ID_INTRFC&gt;&lt;ns:IDTPLG_FILE&gt;&lt;xsl:value-of select="xsd:integer($Id_Tipologia_File)"/&gt;&lt;/ns:IDTPLG_FILE&gt;&lt;ns:NOME_FILE&gt;&lt;xsl:value-of select="$WriteFile/fileInfo/fileName"/&gt;&lt;/ns:NOME_FILE&gt;&lt;ns:TIMSTP_APERTURA_FILE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_APERTURA_FILE&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="&amp;quot;OUTPUT&amp;quot;"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/ns:FileProcessato&gt;&lt;ns:EsecuzioneFile&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneFile&gt;&lt;ns:FileProcessatoOutput&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$WriteFile/fileInfo/size"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;ns:TIMSTP_CREZIONE_FILE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_CREZIONE_FILE&gt;&lt;/ns:FileProcessatoOutput&gt;&lt;ns:ContenutoFile&gt;&lt;ns:ID_CONTENUTO_FILE&gt;&lt;xsl:value-of select="&amp;quot;1&amp;quot;"/&gt;&lt;/ns:ID_CONTENUTO_FILE&gt;&lt;ns:FullName&gt;&lt;xsl:value-of select="$WriteFile/fileInfo/fullName"/&gt;&lt;/ns:FullName&gt;&lt;/ns:ContenutoFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFile&quot;/>&#xa;    &lt;xsl:param name=&quot;OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;Id_Tipologia_File&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;ns:ID_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ID_PROCSO_FILE&quot;/>&#xa;                &lt;/ns:ID_PROCSO_FILE>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;ns:CODFC_OLO_AGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$OLO&quot;/>&#xa;                &lt;/ns:CODFC_OLO_AGCOM>&#xa;                &lt;ns:DATA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                &lt;/ns:DATA_FILE>&#xa;                &lt;ns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&#xa;                &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt