    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName1" tibex:xpdlId="bccbf654-b812-47c5-8e43-962bc120dd05">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link
                                name="Error_RenameFileToOutput_RinameFile" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="CallProcessToError_RenameFile" tibex:linkType="SUCCESS"/>
                            <bpws:link name="RenameFile1ToExit3" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="RenameFile1ToOutput_RinameFile" tibex:linkType="ERROR"/>
                            <bpws:link name="NoRenameToExit3" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="JDBCUpdateToError_RenameFile" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCUpdateToEmpty1" tibex:linkType="ERROR"/>
                            <bpws:link name="Empty1ToError_RenameFile" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:exit name="Exit3" tibex:xpdlId="853b06b6-95e4-4515-8207-1c36ca57cb4e">
                            <bpws:targets>
                                <bpws:target linkName="RenameFile1ToExit3"/>
                                <bpws:target linkName="NoRenameToExit3"/>
                            </bpws:targets>
                        </bpws:exit>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="Var_PathFileError"
                                name="Error_RenameFile"
                                outputVariable="Var_PathFileError"
                                tibex:xpdlId="e8736ee2-9325-4846-a740-7bd75347082c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateToError_RenameFile"/>
                                    <bpws:target linkName="Empty1ToError_RenameFile"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Error_RenameFileToOutput_RinameFile"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="concat($PathFileError,format-date(current-date(), &quot;[Y0001][M01][D01]&quot;), $Estensione)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
