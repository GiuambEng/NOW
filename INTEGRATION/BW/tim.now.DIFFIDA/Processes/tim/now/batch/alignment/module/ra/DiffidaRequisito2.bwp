                        <bpws:source linkName="LogOutput_LoggerProcessToWriteBadDuplicato">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($FindFile/ns26:DESCR_ERRORE,&quot;***FILE NON LAVORATO IN QUANTO GIA' PRESENTE&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($FindFile/ns26:DESCR_ERRORE,"***FILE NON LAVORATO IN QUANTO GIA' PRESENTE")]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
