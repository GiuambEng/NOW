                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_PathBadFile&quot;/>&lt;xsl:param name=&quot;ParseData&quot;/>&lt;xsl:template name=&quot;WriteFile1-input&quot; match=&quot;/&quot;>&lt;tns:WriteActivityInputTextClass>&lt;fileName>&lt;xsl:value-of select=&quot;$Var_PathBadFile&quot;/>&lt;/fileName>&lt;textContent>&lt;xsl:value-of select=&quot;tib:render-xml($ParseData/ErrorRows)&quot;/>&lt;/textContent>&lt;/tns:WriteActivityInputTextClass>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.file.write"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//WriteFile"/>
                                    <value append="true"
                                    compressFile="None"
                                    createMissingDirectories="true"
                                    encoding="text" xsi:type="file:WriteFile"/>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:activityExtension inputVariable="FlagBad"
                        name="Assign" outputVariable="FlagBad"
                        tibex:xpdlId="71918088-1c1d-40e2-bd37-68c8707f8b25" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="WriteFile1ToAssign"/>
                        </bpws:targets>
                        <tibex:inputBindings>
                            <tibex:inputBinding expression="'Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.generalactivities.bwassign"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="FlagBad" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:extActivity inputVariable="WriteToNWS-input"
                        name="WriteToNWS"
                        tibex:xpdlId="dfac7364-c114-448b-8b5e-159fb3def9f2"
                        type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="WhileToGroupEnd1"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="WriteToNWSToGroupEnd1">
                                <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:DesignExpression>
                                <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                            </bpws:source>
                            <bpws:source linkName="WriteToNWSToListBadFiles">
                                <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$FlagBad=&quot;Y&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:DesignExpression>
                                <bpws:transitionCondition><![CDATA[$FlagBad="Y"]]></bpws:transitionCondition>
                            </bpws:source>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding coercion=""
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/WriteToCrmws&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReadFile&quot;/>&#xa;    &lt;xsl:param name=&quot;RootPath&quot;/>&#xa;    &lt;xsl:param name=&quot;OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;PathFileCRMWS&quot;/>&#xa;    &lt;xsl:template name=&quot;WriteToNWS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:CodOloAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$OLO&quot;/>&#xa;            &lt;/tns:CodOloAGCOM>&#xa;            &lt;tns:FileName>&#xa;                &lt;xsl:value-of select=&quot;$ReadFile/fileInfo/fileName&quot;/>&#xa;            &lt;/tns:FileName>&#xa;            &lt;tns:FileFullName>&#xa;                &lt;xsl:value-of select=&quot;concat($RootPath, $OLO, $PathFileCRMWS, $ReadFile/fileInfo/fileName)&quot;/>&#xa;            &lt;/tns:FileFullName>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:CallProcess spawn="true"
                            subProcessName="tim.now.batch.alignment.module.ra.WriteToNWS" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:extActivity>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:extActivity
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioSFTP&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OLO&quot;/>&lt;xsl:param name=&quot;WriteBad&quot;/>&lt;xsl:param name=&quot;TracciaBad&quot;/>&lt;xsl:template name=&quot;Invio-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:CodificaOLOAgcom>&lt;xsl:value-of select=&quot;$OLO&quot;/>&lt;/tns:CodificaOLOAgcom>&lt;tns:FileFullName>&lt;xsl:value-of select=&quot;$WriteBad/fileInfo/fullName&quot;/>&lt;/tns:FileFullName>&lt;tns:CodiceInterfaccia>&lt;xsl:value-of select=&quot;&amp;quot;ID175&amp;quot;&quot;/>&lt;/tns:CodiceInterfaccia>&lt;tns:IDFile>&lt;xsl:value-of select=&quot;xsd:int($TracciaBad/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&lt;/tns:IDFile>&lt;tns:IdEsecProcsoFile>&lt;xsl:value-of select=&quot;xsd:int($TracciaBad/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&lt;/tns:IdEsecProcsoFile>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                        inputVariable="Invio-input" name="Invio"
                        tibex:xpdlId="2eacebd4-96d6-4613-a727-a37cf75ec810"
                        type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="Invoke1ToInvio"/>
                        </bpws:targets>
                        <tibex:inputBindings>
                            <tibex:inputBinding coercion=""
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioSFTP&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TracciaBad.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteBad&quot;/>&#xa;    &lt;xsl:template name=&quot;Invio-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:CodificaOLOAgcom>&#xa;                &lt;xsl:value-of select=&quot;$OLO&quot;/>&#xa;            &lt;/tns:CodificaOLOAgcom>&#xa;            &lt;tns:FileFullName>&#xa;                &lt;xsl:value-of select=&quot;$WriteBad/fileInfo/fullName&quot;/>&#xa;            &lt;/tns:FileFullName>&#xa;            &lt;tns:CodiceInterfaccia>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ID175&amp;quot;&quot;/>&#xa;            &lt;/tns:CodiceInterfaccia>&#xa;            &lt;tns:IDFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($TracciaBad.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;            &lt;/tns:IDFile>&#xa;            &lt;tns:IdEsecProcsoFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($TracciaBad.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;            &lt;/tns:IdEsecProcsoFile>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:CallProcess spawn="true"
                            subProcessName="tim.now.batch.alignment.module.ra.InvioSFTP" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:extActivity>
                </bpws:extensionActivity>
                <bpws:invoke inputVariable="TracciaBad-input"
                    name="TracciaBad" operation="Insert"
                    outputVariable="TracciaBad" partnerLink="Logger"
                    portType="ns10:ProcessLog" tibex:xpdlId="61ec3b62-8b76-4131-bbdd-eb41493eab53">
                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" version="2.0"&gt;
    &lt;xsl:param name="ID_PROCSO_FILE"/&gt;
    &lt;xsl:param name="Input_ProcessLogger"/&gt;
    &lt;xsl:param name="ListBadFiles"/&gt;
    &lt;xsl:template name="Invoke1-input" match="/"&gt;
        &lt;tns:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns:Input&gt;
                    &lt;ns:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;
                    &lt;/ns:TipologiaProcesso&gt;
                    &lt;ns:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/ns:TipologiaOperazione&gt;
                    &lt;ns:ProcFile&gt;
                        &lt;ns:ID_PROCSO_FILE&gt;
                            &lt;xsl:value-of select="$ID_PROCSO_FILE"/&gt;
                        &lt;/ns:ID_PROCSO_FILE&gt;
                    &lt;/ns:ProcFile&gt;
                    &lt;ns:FileProcessato&gt;
                        &lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO"&gt;
                            &lt;ns:COD_OLO&gt;
                                &lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO"/&gt;
                            &lt;/ns:COD_OLO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM"&gt;
                            &lt;ns:CODFC_OLO_AGCOM&gt;
                                &lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM"/&gt;
                            &lt;/ns:CODFC_OLO_AGCOM&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE"&gt;
                            &lt;ns:DATA_FILE&gt;
                                &lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE"/&gt;
                            &lt;/ns:DATA_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;ns:DESCR_STATO_FILE&gt;
                            &lt;xsl:value-of select="&amp;quot;DA INVIARE&amp;quot;"/&gt;
                        &lt;/ns:DESCR_STATO_FILE&gt;
                        &lt;ns:ESITO&gt;
                            &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                        &lt;/ns:ESITO&gt;
                        &lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:ID_INTRFC"&gt;
                            &lt;ns:ID_INTRFC&gt;
                                &lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:ID_INTRFC"/&gt;
                            &lt;/ns:ID_INTRFC&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE"&gt;
                            &lt;ns:IDTPLG_FILE&gt;
                                &lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE"/&gt;
                            &lt;/ns:IDTPLG_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ListBadFiles/files/fileInfo[1]/fileName"&gt;
                            &lt;ns:NOME_FILE&gt;
                                &lt;xsl:value-of select="$ListBadFiles/files/fileInfo[1]/fileName"/&gt;
                            &lt;/ns:NOME_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"&gt;
                            &lt;ns:TIMSTP_APERTURA_FILE&gt;
                                &lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"/&gt;
                            &lt;/ns:TIMSTP_APERTURA_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"&gt;
                            &lt;ns:TIMSTP_CHIUSURA_FILE&gt;
                                &lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"/&gt;
                            &lt;/ns:TIMSTP_CHIUSURA_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;ns:VERSO_DEL_FILE&gt;
                            &lt;xsl:value-of select="&amp;quot;OUTPUT&amp;quot;"/&gt;
                        &lt;/ns:VERSO_DEL_FILE&gt;
                    &lt;/ns:FileProcessato&gt;
                    &lt;ns:EsecuzioneFile&gt;
                        &lt;ns:STATO_ESEC&gt;
                            &lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;
                        &lt;/ns:STATO_ESEC&gt;
                        &lt;ns:TMSP_INIZIO_ELAB&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns:TMSP_INIZIO_ELAB&gt;
                    &lt;/ns:EsecuzioneFile&gt;
                    &lt;ns:FileProcessatoOutput&gt;
                        &lt;xsl:if test="$ListBadFiles/files/fileInfo[1]/size"&gt;
                            &lt;ns:DIMENSIONE_FILE&gt;
                                &lt;xsl:value-of select="$ListBadFiles/files/fileInfo[1]/size"/&gt;
                            &lt;/ns:DIMENSIONE_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;ns:TIMSTP_CREZIONE_FILE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns:TIMSTP_CREZIONE_FILE&gt;
                    &lt;/ns:FileProcessatoOutput&gt;
                    &lt;ns:ContenutoFile&gt;
                        &lt;ns:ID_CONTENUTO_FILE&gt;
                            &lt;xsl:value-of select="&amp;quot;1&amp;quot;"/&gt;
                        &lt;/ns:ID_CONTENUTO_FILE&gt;
                        &lt;xsl:if test="$ListBadFiles/files/fileInfo[1]/fullName"&gt;
                            &lt;ns:FullName&gt;
                                &lt;xsl:value-of select="$ListBadFiles/files/fileInfo[1]/fullName"/&gt;
                            &lt;/ns:FullName&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns:ContenutoFile&gt;
                &lt;/ns:Input&gt;
            &lt;/part1&gt;
        &lt;/tns:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                    <tibex:inputBindings>
                        <tibex:partBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;Input_ProcessLogger&quot;/>&#xa;    &lt;xsl:param name=&quot;ListBadFiles&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke1-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;ns:ID_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ID_PROCSO_FILE&quot;/>&#xa;                &lt;/ns:ID_PROCSO_FILE>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO&quot;>&#xa;                    &lt;ns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO&quot;/>&#xa;                    &lt;/ns:COD_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;ns:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CODFC_OLO_AGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE&quot;>&#xa;                    &lt;ns:DATA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE&quot;/>&#xa;                    &lt;/ns:DATA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&#xa;                &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:ID_INTRFC&quot;>&#xa;                    &lt;ns:ID_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:ID_INTRFC&quot;/>&#xa;                    &lt;/ns:ID_INTRFC>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE&quot;>&#xa;                    &lt;ns:IDTPLG_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE&quot;/>&#xa;                    &lt;/ns:IDTPLG_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ListBadFiles/files/fileInfo[1]/fileName&quot;>&#xa;                    &lt;ns:NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ListBadFiles/files/fileInfo[1]/fileName&quot;/>&#xa;                    &lt;/ns:NOME_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;>&#xa;                    &lt;ns:TIMSTP_APERTURA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;/>&#xa;                    &lt;/ns:TIMSTP_APERTURA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;>&#xa;                    &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;/>&#xa;                    &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OUTPUT&amp;quot;&quot;/>&#xa;                &lt;/ns:VERSO_DEL_FILE>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_INIZIO_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_INIZIO_ELAB>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;            &lt;ns:FileProcessatoOutput>&#xa;                &lt;xsl:if test=&quot;$ListBadFiles/files/fileInfo[1]/size&quot;>&#xa;                    &lt;ns:DIMENSIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ListBadFiles/files/fileInfo[1]/size&quot;/>&#xa;                    &lt;/ns:DIMENSIONE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:TIMSTP_CREZIONE_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_CREZIONE_FILE>&#xa;            &lt;/ns:FileProcessatoOutput>&#xa;            &lt;ns:ContenutoFile>&#xa;                &lt;ns:ID_CONTENUTO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                &lt;/ns:ID_CONTENUTO_FILE>&#xa;                &lt;xsl:if test=&quot;$ListBadFiles/files/fileInfo[1]/fullName&quot;>&#xa;                    &lt;ns:FullName>&#xa;                        &lt;xsl:value-of select=&quot;$ListBadFiles/files/fileInfo[1]/fullName&quot;/>&#xa;                    &lt;/ns:FullName>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:ContenutoFile>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <bpws:targets>
                        <bpws:target linkName="ListFilesToInvoke1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Invoke1ToInvio"/>
                    </bpws:sources>
                </bpws:invoke>
                <bpws:extensionActivity>
                    <tibex:activityExtension
                        inputVariable="ListBadFiles-input"
                        name="ListBadFiles"
                        outputVariable="ListBadFiles"
                        tibex:xpdlId="5c946a30-a599-41fa-a108-b74de9ca6c74" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="WriteToNWSToListBadFiles"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="ListFilesToInvoke1">
                                <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($ListBadFiles/files/fileInfo) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:DesignExpression>
                                <bpws:transitionCondition><![CDATA[count($ListBadFiles/files/fileInfo) > 0]]></bpws:transitionCondition>
                            </bpws:source>
                            <bpws:source linkName="ListFilesToGroupEnd1"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_PathBadFile&quot;/>&lt;xsl:template name=&quot;ListFiles-input&quot; match=&quot;/&quot;>&lt;tns:ListFilesActivityConfig>&lt;fileName>&lt;xsl:value-of select=&quot;$Var_PathBadFile&quot;/>&lt;/fileName>&lt;/tns:ListFilesActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.file.list"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//ListFiles"/>
                                    <value mode="only-files" xsi:type="file:ListFiles"/>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
