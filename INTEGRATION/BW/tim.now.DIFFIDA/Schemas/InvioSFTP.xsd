<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/InvioSFTP" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/InvioSFTP">

    <complexType name="InputType">
    	<sequence>
    		<element name="CodificaOLOAgcom">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="3"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="FileFullName" type="string"></element>
    		<element name="CodiceInterfaccia" type="string"></element>
    		<element name="IDFile" type="int" minOccurs="0"></element>
    		<element name="IdEsecProcsoFile" type="int" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="OutputType">
    	<sequence>
    		<element name="StatoInvio">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="OK"></enumeration>
    					<enumeration value="KO"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    	</sequence>
    </complexType>

    <element name="Input" type="tns:InputType"></element>

    <element name="Output" type="tns:OutputType"></element>
</schema>