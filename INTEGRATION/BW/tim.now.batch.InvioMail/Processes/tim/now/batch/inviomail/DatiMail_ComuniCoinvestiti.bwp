                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COINV.NOME_FILE, COINV.ID_CONTRATTO, COINV.COD_OLO_AGCOM,&#xa;  TRACK.STATO&#xa;  FROM&#xa;       APPUSER.ASS_FILE_COMUNI_COINV COINV JOIN APPUSER.ALIGN_FILE_TRACKING TRACK ON COINV.IDFILE = TRACK.ID_FILE_INPUT&#xa;  WHERE COINV.IDFILE = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
