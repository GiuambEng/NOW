                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ELABORAZIONE, BODY_PARAM, SUBJECT_PARAM, DEST, CC, CCN&#xa;FROM EMAIL_CONFIG&#xa;WHERE COD_MAIL = ?&#xa;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODMAIL"/>
