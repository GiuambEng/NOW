                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="SendMail-input"
                                    name="SendMail"
                                    tibex:xpdlId="de4854bb-45e6-41c8-8e53-e19eb9c47aaa" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ElaborazioneToSendMail_CasoSTANDARD"/>
                                    <bpws:target linkName="DatiMail_EstrazioneJPUBToSendMail"/>
                                    <bpws:target linkName="DatiMail_ComuniCoinvestitiToSendMail"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SendMailToLogEmailOK"/>
                                    <bpws:source
                                    linkName="SendMailToLogKO"
                                    tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/sendmail/xsd/input+de4854bb-45e6-41c8-8e53-e19eb9c47aaa+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RecuperoDatiInvioMail&quot; xmlns:tns2=&quot;http://xmlns.tibco.com/encodings/mimefile&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;smtpPropertyFrom&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;RecuperaMailDaInviare&quot;/>&lt;xsl:param name=&quot;RecuperaConfigMail&quot;/>&lt;xsl:param name=&quot;DatiMail_EstrazioneJPUB&quot;/>&lt;xsl:param name=&quot;CalceMail&quot;/>&lt;xsl:param name=&quot;DatiMail_ComuniCoinvestiti&quot;/>&lt;xsl:template name=&quot;SendMail-input&quot; match=&quot;/&quot;>&lt;tns:mailActivityInput>&lt;from>&lt;xsl:value-of select=&quot;$smtpPropertyFrom&quot;/>&lt;/from>&lt;xsl:if test=&quot;$RecuperaConfigMail/Record[1]/DEST&quot;>&lt;to>&lt;xsl:value-of select=&quot;$RecuperaConfigMail/Record[1]/DEST&quot;/>&lt;/to>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperaConfigMail/Record[1]/CC&quot;>&lt;cc>&lt;xsl:value-of select=&quot;$RecuperaConfigMail/Record[1]/CC&quot;/>&lt;/cc>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperaConfigMail/Record[1]/CCN&quot;>&lt;bcc>&lt;xsl:value-of select=&quot;$RecuperaConfigMail/Record[1]/CCN&quot;/>&lt;/bcc>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperaConfigMail/Record[1]/ELABORAZIONE = 'ALL_COMUNI_COINVESTITI_FLOW_94'&quot;>&lt;subject>&lt;xsl:value-of select=&quot;$DatiMail_ComuniCoinvestiti/tns1:SUBJECT&quot;/>&lt;/subject>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperaConfigMail/Record[1]/ELABORAZIONE = 'ESTRAZIONE_JPUB_ID374'&quot;>&lt;subject>&lt;xsl:value-of select=&quot;$DatiMail_EstrazioneJPUB/tns1:SUBJECT&quot;/>&lt;/subject>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$RecuperaConfigMail/Record[1]/SUBJECT_PARAM&quot;>&lt;subject>&lt;xsl:value-of select=&quot;$RecuperaConfigMail/Record[1]/SUBJECT_PARAM&quot;/>&lt;/subject>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;bodyElement>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperaConfigMail/Record[1]/ELABORAZIONE = 'ALL_COMUNI_COINVESTITI_FLOW_94'&quot;>&lt;bodyText>&lt;xsl:value-of select=&quot;concat($DatiMail_ComuniCoinvestiti/tns1:BODY,&amp;quot;&amp;lt;br/>&amp;quot;,&amp;quot;&amp;lt;br/>&amp;quot;,&amp;quot;&amp;lt;br/>&amp;quot;,$CalceMail)&quot;/>&lt;/bodyText>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperaConfigMail/Record[1]/ELABORAZIONE = 'ESTRAZIONE_JPUB_ID374'&quot;>&lt;bodyText>&lt;xsl:value-of select=&quot;concat($DatiMail_EstrazioneJPUB/tns1:BODY,&amp;quot;&amp;lt;br/>&amp;quot;,&amp;quot;&amp;lt;br/>&amp;quot;,&amp;quot;&amp;lt;br/>&amp;quot;,$CalceMail)&quot;/>&lt;/bodyText>&lt;/xsl:when>&lt;xsl:otherwise>&lt;bodyText>&lt;xsl:value-of select=&quot;concat($RecuperaConfigMail/Record[1]/BODY_PARAM,&amp;quot;&amp;lt;br/>&amp;quot;,&amp;quot;&amp;lt;br/>&amp;quot;,&amp;quot;&amp;lt;br/>&amp;quot;,$CalceMail)&quot;/>&lt;/bodyText>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/bodyElement>&lt;Headers>&lt;Content-Type>&lt;xsl:value-of select=&quot;&amp;quot;text/html; charset=UTF-8&amp;quot;&quot;/>&lt;/Content-Type>&lt;/Headers>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperaConfigMail/Record[1]/ELABORAZIONE = 'ESTRAZIONE_JPUB_ID374' and ($DatiMail_EstrazioneJPUB/tns1:QTRECDTOTALI -1)>0&quot;>&lt;tns2:mimeEnvelopeElement>&lt;mimePart>&lt;mimeHeaders>&lt;content-disposition>&lt;xsl:value-of select=&quot;concat(&amp;quot;*;filename=&amp;quot;, substring-before(tib:substring-after-last($RecuperaMailDaInviare/Record[$index]/PATH_ALLEGATO, &amp;quot;/&amp;quot;),&amp;quot;.csv&amp;quot;))&quot;/>&lt;/content-disposition>&lt;content-type>&lt;xsl:value-of select=&quot;&amp;quot;text/plain&amp;quot;&quot;/>&lt;/content-type>&lt;/mimeHeaders>&lt;fileName>&lt;xsl:value-of select=&quot;$RecuperaMailDaInviare/Record[$index]/PATH_ALLEGATO&quot;/>&lt;/fileName>&lt;/mimePart>&lt;/tns2:mimeEnvelopeElement>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:mimeEnvelopeElement/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:mailActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.mail.send"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
