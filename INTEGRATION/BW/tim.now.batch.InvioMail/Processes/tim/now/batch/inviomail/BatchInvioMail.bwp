                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+27e7f6bf-b4e4-487e-8474-498243bc2e76+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RecuperoDatiInvioMail&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;RecuperaMailDaInviare&quot;/>&lt;xsl:param name=&quot;DatiMail_EstrazioneJPUB&quot;/>&lt;xsl:param name=&quot;RecuperaConfigMail&quot;/>&lt;xsl:param name=&quot;DatiMail_ComuniCoinvestiti&quot;/>&lt;xsl:template name=&quot;UpdateInviata-input&quot; match=&quot;/&quot;>&lt;tns3:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperaConfigMail/Record[1]/ELABORAZIONE = 'ALL_COMUNI_COINVESTITI_FLOW_94'&quot;>&lt;BODY>&lt;xsl:value-of select=&quot;$DatiMail_ComuniCoinvestiti/tns1:BODY&quot;/>&lt;/BODY>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperaConfigMail/Record[1]/ELABORAZIONE = 'ESTRAZIONE_JPUB_ID374'&quot;>&lt;BODY>&lt;xsl:value-of select=&quot;$DatiMail_EstrazioneJPUB/tns1:BODY&quot;/>&lt;/BODY>&lt;/xsl:when>&lt;xsl:otherwise>&lt;BODY>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperaConfigMail/Record[1]/BODY_PARAM)&quot;>&lt;xsl:value-of select=&quot;$RecuperaConfigMail/Record[1]/BODY_PARAM&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/BODY>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;LASTUPDATE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/LASTUPDATE>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperaConfigMail/Record[1]/ELABORAZIONE = 'ALL_COMUNI_COINVESTITI_FLOW_94'&quot;>&lt;SUBJECT>&lt;xsl:value-of select=&quot;$DatiMail_ComuniCoinvestiti/tns1:SUBJECT&quot;/>&lt;/SUBJECT>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperaConfigMail/Record[1]/ELABORAZIONE = 'ESTRAZIONE_JPUB_ID374'&quot;>&lt;SUBJECT>&lt;xsl:value-of select=&quot;$DatiMail_EstrazioneJPUB/tns1:SUBJECT&quot;/>&lt;/SUBJECT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;SUBJECT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperaConfigMail/Record[1]/SUBJECT_PARAM)&quot;>&lt;xsl:value-of select=&quot;$RecuperaConfigMail/Record[1]/SUBJECT_PARAM&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SUBJECT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IDMAIL>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperaMailDaInviare/Record[$index]/ID_MAIL)&quot;>&lt;xsl:value-of select=&quot;$RecuperaMailDaInviare/Record[$index]/ID_MAIL&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDMAIL>&lt;/tns3:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
