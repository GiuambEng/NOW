                                    tibex:label="Caso STANDARD" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="DatiMail_EstrazioneJPUBToSendMail" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="ElaborazioneToDatiMail_RU1301"
                                    tibex:label="RU_1301" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="DatiMail_ComuniCoinvestitiToSendMail" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="DatiMail_ComuniCoinvestitiToLogKO" tibex:linkType="ERROR"/>
                            </bpws:links>
