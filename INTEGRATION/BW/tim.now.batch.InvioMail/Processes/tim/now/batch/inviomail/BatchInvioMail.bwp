                                <bpws:targets>
                                    <bpws:target linkName="UpdateInviataToGroupEnd"/>
                                    <bpws:target linkName="UpdateErrorToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="UpdateInInvio-input"
                                    name="UpdateInInvio"
                                    outputVariable="UpdateInInvio"
                                    tibex:xpdlId="ac1e8f00-6d78-4bde-a060-3a3eeb9512ae" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToUpdateInInvio"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="UpdateInInvioToRecuperaConfigMail"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ac1e8f00-6d78-4bde-a060-3a3eeb9512ae+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaMailDaInviare&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateInInvio-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;LASTUPDATE>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/LASTUPDATE>&#xa;            &lt;IDMAIL>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RecuperaMailDaInviare/Record[$index]/ID_MAIL)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperaMailDaInviare/Record[$index]/ID_MAIL&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDMAIL>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="GenericJDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE EMAIL_STATO&#xa;SET STATO = 'IN INVIO', LAST_UPDATE = ?&#xa;WHERE ID_MAIL = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="LASTUPDATE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDMAIL"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="DatiMail_EstrazioneJPUB-input"
                                    name="DatiMail_EstrazioneJPUB"
                                    outputVariable="DatiMail_EstrazioneJPUB"
                                    tibex:xpdlId="483f73d6-f1c3-43f4-8d25-2342802bbfe2"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ElaborazioneToDatiMail_RU1294"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source
                                    linkName="DatiMail_EstrazioneJPUBToLogKO"
                                    tibex:faultDetailsVar="DatiMail_EstrazioneJPUB" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="DatiMail_EstrazioneJPUBToSendMail"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RecuperoDatiInvioMail&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaConfigMail&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaMailDaInviare&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiMail_EstrazioneJPUB-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:InputDati_InvioMail>&#xa;            &lt;tns1:BODYPARAM>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaConfigMail/Record[1]/BODY_PARAM&quot;/>&#xa;            &lt;/tns1:BODYPARAM>&#xa;            &lt;tns1:SUBJECTPARAM>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaConfigMail/Record[1]/SUBJECT_PARAM&quot;/>&#xa;            &lt;/tns1:SUBJECTPARAM>&#xa;            &lt;tns1:IDESEC>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperaMailDaInviare/Record[$index]/ID_ESEC)&quot;/>&#xa;            &lt;/tns1:IDESEC>&#xa;        &lt;/tns1:InputDati_InvioMail>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.batch.inviomail.DatiMail_EstrazioneJPUB" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
