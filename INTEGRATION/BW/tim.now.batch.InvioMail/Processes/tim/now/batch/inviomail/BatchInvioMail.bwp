                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_MAIL, ID_ESEC, COD_MAIL_CONFIG, PATH_ALLEGATO&#xd;&#xa;FROM EMAIL_STATO&#xd;&#xa;WHERE STATO = 'DA INVIARE'&#xd;&#xa;ORDER BY TIMSTP_INSERIMENTO ASC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_MAIL"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_ESEC"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_MAIL_CONFIG"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PATH_ALLEGATO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogRecuperaMailDaInviare-input"
                    name="LogRecuperaMailDaInviare"
                    tibex:xpdlId="3f56aac8-a9ce-4600-bc2d-3a32661fafae"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RecuperaMailDaInviareToLogRecuperaMailDaInviare"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogRecuperaMailDaInviareToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaMailDaInviare&quot;/>&#xa;    &lt;xsl:template name=&quot;LogRecuperaMailDaInviare-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.InvioMail.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'BatchInvioMail'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($RecuperaMailDaInviare/Record)>0&quot;>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Numero di Mail da inviare: ', string(count($RecuperaMailDaInviare/Record)))&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Nessuna Mail da inviare'&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while"
                tibex:indexToGlobal="false" tibex:xpdlId="03d208cf-f247-42d9-9f45-b4ae154dfc0d">
                <bpws:targets>
                    <bpws:target linkName="LogRecuperaMailDaInviareToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToLogEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($RecuperaMailDaInviare/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($RecuperaMailDaInviare/Record)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="UpdateInInvioToRecuperaConfigMail" tibex:linkType="SUCCESS"/>
                                <bpws:link
