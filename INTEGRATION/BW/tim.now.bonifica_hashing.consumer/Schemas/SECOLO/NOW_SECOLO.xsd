<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Prima emissione per servizio verifica Idrisorsa Metroweb--><schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_SECOLO/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/NOW_SECOLO/">
	<element name="RequestCreate_token">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="CodificaOLOAGCOM" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="CodiceOrdineOLO" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Funzione" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="ChiaveRiferimento" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Operatore" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="IPClient" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="N_Recap_Cliente" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="N_Recap_Cliente_ALT" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Note" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Nome" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="CognomeRagioneSociale" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="CodiceFiscale" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="PIVA" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="TOKENIZZAZIONE">
			<simpleType>
						<restriction base="string">
							<enumeration value="C2PLUS"/>
							<enumeration value="D420"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="ResponseCreate_token">
		<complexType>
			<sequence>
			<element maxOccurs="1" minOccurs="0" name="Token" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="N_Recap_Cliente" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="N_Recap_Cliente_ALT" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="Note" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="Nome" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="CognomeRagioneSociale" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="CodiceFiscale" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="PIVA" type="string"/>
				<element maxOccurs="1" minOccurs="1" name="ESITO">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="DESCRIZIONE" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="RequestDecode_token">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="CodificaOLOAGCOM" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="CodiceOrdineOLO" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Funzione" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="ChiaveRiferimento" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Operatore" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="IPClient" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Token" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="ResponseDecode_token">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="ESITO">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="DESCRIZIONE" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="N_Recap_Cliente" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="N_Recap_Cliente_ALT" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Note" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Nome" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="CognomeRagioneSociale" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="CodiceFiscale" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="PIVA" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="Fault">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="RETURN_CODE" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="DESCRIZIONE" type="string"/>
			</sequence>
		</complexType>
	</element>
    <element name="operationRequest">
    <complexType>
      <sequence>
        <element name="in" type="string"/>
      </sequence>
    </complexType>
  </element>
</schema>
