                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Secolo_Hash-input"
                                    name="Secolo_Hash"
                                    outputVariable="Secolo_Hash"
                                    tibex:xpdlId="bdbc8dc4-79ff-4b0b-a292-1368d6981d96"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLoggerToSecolo_Hash"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Secolo_HashToMapper">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    <bpws:source
                                    linkName="Secolo_HashToUpdateEsitoKOHash"
                                    tibex:faultDetailsVar="Secolo_Hash" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_HASH/&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1649150622499&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Clienti&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;GetLocalIP&quot;/>&lt;xsl:param name=&quot;OperatoreSecolo&quot;/>&lt;xsl:param name=&quot;ClientiDetokenizzati&quot;/>&lt;xsl:template name=&quot;Secolo_Hash-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$index &amp;lt;= (count($ClientiDetokenizzati/tns1:DettaglioCliente/tns1:ID_CLIENTE) div 20)&quot;>&lt;tns:RequestGet_Multiple_Hash_Secolo>&lt;tns:Funzione>&lt;xsl:value-of select=&quot;concat(&amp;quot;BONIFICA_&amp;quot;, $Clienti/tns1:DettaglioCliente[1]/tns1:ENTITA)&quot;/>&lt;/tns:Funzione>&lt;tns:ChiaveRiferimento>&lt;xsl:value-of select=&quot;concat(string-join(subsequence($ClientiDetokenizzati/tns1:DettaglioCliente/tns1:ID_DETTAGLIO_CLIENTE, (($index - 1) * 20 + 1), 20), &amp;quot;-&amp;quot;),&amp;quot;-&amp;quot;, xsd:string(tib:timestamp()))&quot;/>&lt;/tns:ChiaveRiferimento>&lt;tns:Operatore>&lt;xsl:value-of select=&quot;$OperatoreSecolo&quot;/>&lt;/tns:Operatore>&lt;xsl:if test=&quot;$GetLocalIP/tns2:IPAddress&quot;>&lt;tns:IPClient>&lt;xsl:value-of select=&quot;$GetLocalIP/tns2:IPAddress&quot;/>&lt;/tns:IPClient>&lt;/xsl:if>&lt;xsl:for-each select=&quot;subsequence($ClientiDetokenizzati/tns1:DettaglioCliente/tns1:ID_CLIENTE, (($index - 1) * 20 + 1), 20)&quot;>&lt;tns:HashIN>&lt;xsl:if test=&quot;../tns1:KEY_HASH&quot;>&lt;tns:key>&lt;xsl:value-of select=&quot;../tns1:KEY_HASH&quot;/>&lt;/tns:key>&lt;/xsl:if>&lt;xsl:if test=&quot;../tns1:VALORE&quot;>&lt;tns:value>&lt;xsl:value-of select=&quot;../tns1:VALORE&quot;/>&lt;/tns:value>&lt;/xsl:if>&lt;/tns:HashIN>&lt;/xsl:for-each>&lt;tns:Bonifica>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:Bonifica>&lt;/tns:RequestGet_Multiple_Hash_Secolo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:RequestGet_Multiple_Hash_Secolo>&lt;tns:Funzione>&lt;xsl:value-of select=&quot;concat(&amp;quot;BONIFICA_&amp;quot;, $ClientiDetokenizzati/tns1:DettaglioCliente[1]/tns1:ENTITA)&quot;/>&lt;/tns:Funzione>&lt;tns:ChiaveRiferimento>&lt;xsl:value-of select=&quot;concat(string-join(subsequence($ClientiDetokenizzati/tns1:DettaglioCliente/tns1:ID_DETTAGLIO_CLIENTE, (($index - 1) * 20 + 1), (count($ClientiDetokenizzati/tns1:DettaglioCliente/tns1:ID_DETTAGLIO_CLIENTE) mod 20)), &amp;quot;-&amp;quot;),&amp;quot;-&amp;quot;, xsd:string(tib:timestamp()))&quot;/>&lt;/tns:ChiaveRiferimento>&lt;tns:Operatore>&lt;xsl:value-of select=&quot;$OperatoreSecolo&quot;/>&lt;/tns:Operatore>&lt;xsl:if test=&quot;$GetLocalIP/tns2:IPAddress&quot;>&lt;tns:IPClient>&lt;xsl:value-of select=&quot;$GetLocalIP/tns2:IPAddress&quot;/>&lt;/tns:IPClient>&lt;/xsl:if>&lt;xsl:for-each select=&quot;subsequence($ClientiDetokenizzati/tns1:DettaglioCliente/tns1:ID_CLIENTE, (($index - 1) * 20 + 1), (count($ClientiDetokenizzati/tns1:DettaglioCliente/tns1:ID_CLIENTE) mod 20))&quot;>&lt;tns:HashIN>&lt;xsl:if test=&quot;../tns1:KEY_HASH&quot;>&lt;tns:key>&lt;xsl:value-of select=&quot;../tns1:KEY_HASH&quot;/>&lt;/tns:key>&lt;/xsl:if>&lt;xsl:if test=&quot;../tns1:VALORE&quot;>&lt;tns:value>&lt;xsl:value-of select=&quot;../tns1:VALORE&quot;/>&lt;/tns:value>&lt;/xsl:if>&lt;/tns:HashIN>&lt;/xsl:for-each>&lt;tns:Bonifica>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:Bonifica>&lt;/tns:RequestGet_Multiple_Hash_Secolo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2