                                    outputVariable="AccumulateClientiHashati"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="f2c5340f-3da6-448c-8982-65eddec35d58" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLoggerToAccumulateClientiHashati"/>
                                    <bpws:target linkName="GenericLogger1ToAccumulateClientiHashati"/>
