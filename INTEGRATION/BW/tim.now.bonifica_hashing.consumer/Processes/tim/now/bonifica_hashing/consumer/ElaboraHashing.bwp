                                    sqlStatement="UPDATE APPUSER.STORICO_BATTENTE_HASHING_DETT&#xa;SET VALORE_HASH = ?, DATA_AGGIORNAMENTO = SYSDATE&#xa;WHERE KEY_HASH = ? AND ID_STORICO_BATTENTE_HASHING IN (SELECT ID FROM STORICO_BATTENTE_HASHING WHERE ID_PROC = ? AND STATO = 'HASHING IN CORSO')" xsi:type="jdbcPalette:JDBCUpdateActivity">
