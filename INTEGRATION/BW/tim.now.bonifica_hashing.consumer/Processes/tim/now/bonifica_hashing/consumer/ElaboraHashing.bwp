            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1649239208384&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1649150622499&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Clienti&quot;/>&lt;xsl:template name=&quot;MapperIdClienti-input&quot; match=&quot;/&quot;>&lt;tns:MapperInput>&lt;xsl:for-each-group select=&quot;$Clienti/tns1:DettaglioCliente/tns1:ID_CLIENTE&quot; group-by=&quot;.&quot;>&lt;SingoloCliente>&lt;ID_CLIENTE>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/ID_CLIENTE>&lt;xsl:if test=&quot;../tns1:TOKEN&quot;>&lt;TOKEN>&lt;xsl:value-of select=&quot;../tns1:TOKEN&quot;/>&lt;/TOKEN>&lt;/xsl:if>&lt;/SingoloCliente>&lt;/xsl:for-each-group>&lt;/tns:MapperInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
