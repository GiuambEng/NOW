                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OperatoreSecolo&quot;/>&lt;xsl:param name=&quot;GetLocalIP&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;MapperIdClienti&quot;/>&lt;xsl:template name=&quot;CallSecolo_Detok-input&quot; match=&quot;/&quot;>&lt;tns:RequestDecode_token>&lt;tns:Funzione>&lt;xsl:value-of select=&quot;'BONIFICA_HASH'&quot;/>&lt;/tns:Funzione>&lt;tns:ChiaveRiferimento>&lt;xsl:value-of select=&quot;xsd:string(tib:timestamp())&quot;/>&lt;/tns:ChiaveRiferimento>&lt;tns:Operatore>&lt;xsl:value-of select=&quot;$OperatoreSecolo&quot;/>&lt;/tns:Operatore>&lt;xsl:if test=&quot;$GetLocalIP/tns1:IPAddress&quot;>&lt;tns:IPClient>&lt;xsl:value-of select=&quot;$GetLocalIP/tns1:IPAddress&quot;/>&lt;/tns:IPClient>&lt;/xsl:if>&lt;xsl:if test=&quot;$MapperIdClienti/SingoloCliente[$index]/TOKEN&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$MapperIdClienti/SingoloCliente[$index]/TOKEN&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/tns:RequestDecode_token>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallSecolo_Detok-input"
                                    name="CallSecolo_Detok"
                                    outputVariable="CallSecolo_Detok"
                                    tibex:xpdlId="851664c2-51ac-4c42-b0a7-b3a101dbdc14"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCallSecolo_Detok"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallSecolo_DetokToMapper">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    <bpws:source
                                    linkName="CallSecolo_DetokToJDBCUpdate"
                                    tibex:faultDetailsVar="CallSecolo_Detok" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
