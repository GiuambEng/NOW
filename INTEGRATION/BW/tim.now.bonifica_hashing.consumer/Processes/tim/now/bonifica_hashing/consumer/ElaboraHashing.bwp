            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="40f3c815-a7d6-46f9-b070-17dab0de03dd">
                <bpws:targets>
                    <bpws:target linkName="GenericLoggerToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToGenericLogger"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:assign name="GroupInit1"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+f2c5340f-3da6-448c-8982-65eddec35d58" version="2.0"> <xsl:template name="AccumulateClientiHashati" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="AccumulateClientiHashati"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt; ((count($ClientiDetokenizzati/ns7:DettaglioCliente/ns7:ID_CLIENTE) div 20)+1)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index < ((count($ClientiDetokenizzati/ns7:DettaglioCliente/ns7:ID_CLIENTE) div 20)+1)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStart1ToGenericLogger" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Secolo_HashToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Secolo_HashToUpdateEsitoKOHash" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="GenericLoggerToSecolo_Hash" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="MapperHashToGenericLogger" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="UpdateEsitoKOHashToGenericLogger1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GenericLoggerToAccumulateClientiHashati" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GenericLogger1ToAccumulateClientiHashati" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty1ToMapperHash" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
