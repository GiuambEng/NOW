                                tibex:group="groupStart" tibex:xpdlId="7e3efcda-5f7a-4fef-a507-b797e3d526a2">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToGenericLogger"/>
                                </bpws:sources>
                            </bpws:empty>
