                                    action="illegalStateFault"
                                    messageDirection="FAULT"
                                    messageQName="pt:illegalStateFault" wsdlLocation="platform:/resource/tim.now.batch.alignment.GSRI/Service%20Descriptors/BPM_API/processManagement.wsdl">
                                    <messagePartConfigurations
                                    partElementName="processManagerType:illegalStateFault"
                                    partName="fault" xsi:type="axis2:BodyPartConfiguration"/>
