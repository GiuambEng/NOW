            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="74498742-5d40-4858-9c31-e38d53de6efd">
                <bpws:targets>
                    <bpws:target linkName="LoggerNoFileToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToUpdateLogger"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($JDBCQueryRecord/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($JDBCQueryRecord/Record)]]></bpws:condition>
                        <bpws:flow name="flow2">
