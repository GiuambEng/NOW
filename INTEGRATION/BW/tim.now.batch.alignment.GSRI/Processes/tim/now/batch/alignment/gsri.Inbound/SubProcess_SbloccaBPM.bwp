                                <bpws:link
                                    name="InvokeBPMToCopy_2_LogJDBCUpdateStag" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogInvokeBPMToEventoOrdineNOWwhls" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogDettaglioOrdineToInvokeBPM" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="QueryIDAnagCausToInvokeBPM" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="EventoOrdineNOWwhlsToJDBCUpdateStagOK" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="a573bce0-31f5-4b13-bf54-d0c68696a601">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToCheckRichieste"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="fbf0068f-a80f-452c-a15c-7928e91f53d4">
                                <bpws:targets>
                                    <bpws:target linkName="LogJDBCUpdateStagToGroupEnd"/>
                                    <bpws:target linkName="JDBCUInsEVENTO_GSRSIToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="CheckRichieste-input"
                                    name="CheckRichieste"
                                    outputVariable="CheckRichieste"
                                    tibex:xpdlId="14a55e0c-4287-45b5-8a34-07e437e4adc7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCheckRichieste"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CheckRichiesteToCopy_1_LogJDBCQueryRecord"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+14a55e0c-4287-45b5-8a34-07e437e4adc7+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;JDBCQueryRecord&quot;/>&lt;xsl:template name=&quot;CheckRichieste-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQueryRecord/Record[$index]/CODE_ABBONATO)&quot;>&lt;xsl:value-of select=&quot;$JDBCQueryRecord/Record[$index]/CODE_ABBONATO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select IDRISORSA,IDRICHIESTAOLO,STATORICHIESTANOW&#xa;from bds_1_casedata_richiesta&#xa;where STATORICHIESTANOW in ('ACQUISITO','INVIATOADELIVERY','LAVORAZIONEHD') and IDRISORSA=?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogCheckRichieste-input"
                                    name="LogCheckRichieste"
                                    tibex:xpdlId="094acc8a-71c7-42e1-81e5-50e363a2a2f5"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CheckRichiesteToCopy_1_LogJDBCQueryRecord"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogCheckRichiesteToJDBCUpdate">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogCheckRichiesteToMapper">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($CheckRichieste/Record)>0 and &#xd;&#xa;$JDBCQueryRecord/Record[$index]/CAUS_ORDINE=('0','2') and&#xd;&#xa;(($CheckRichieste/Record[1]/STATORICHIESTANOW=('ACQUISITO') and $JDBCQueryRecord/Record[$index]/STATO_ORDINE='0') or ($CheckRichieste/Record[1]/STATORICHIESTANOW=('INVIATOADELIVERY') and $JDBCQueryRecord/Record[$index]/STATO_ORDINE='1'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($CheckRichieste/Record)>0 and 
$JDBCQueryRecord/Record[$index]/CAUS_ORDINE=('0','2') and
(($CheckRichieste/Record[1]/STATORICHIESTANOW=('ACQUISITO') and $JDBCQueryRecord/Record[$index]/STATO_ORDINE='0') or ($CheckRichieste/Record[1]/STATORICHIESTANOW=('INVIATOADELIVERY') and $JDBCQueryRecord/Record[$index]/STATO_ORDINE='1'))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;JDBCQueryRecord&quot;/>&lt;xsl:param name=&quot;CheckRichieste&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;LogCheckRichieste-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.alignment.GSRI.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SbloccaBPM&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('LogCheckRichieste per CODE-ABBONATO : ',$JDBCQueryRecord/Record[$index]/CODE_ABBONATO,' - ',tib:render-xml($CheckRichieste))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
