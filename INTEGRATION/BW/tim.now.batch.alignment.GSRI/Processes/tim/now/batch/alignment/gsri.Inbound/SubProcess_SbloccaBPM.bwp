                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+aa717fff-3bde-4037-9582-f078c6531f1e+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQueryRecord&quot;/>&lt;xsl:param name=&quot;CheckRichieste&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;LoggerNoFile&quot;/>&lt;xsl:template name=&quot;JDBCUpdateStag-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;count($CheckRichieste/Record)=0&quot;>&lt;STATO_CHIAMATA_BPM>&lt;xsl:value-of select=&quot;'NON TROVATO'&quot;/>&lt;/STATO_CHIAMATA_BPM>&lt;/xsl:when>&lt;xsl:when test=&quot;count($CheckRichieste/Record)>0 and $CheckRichieste/Record[1]/STATORICHIESTANOW='LAVORAZIONEHD'  &quot;>&lt;STATO_CHIAMATA_BPM>&lt;xsl:value-of select=&quot;'LAVORAZIONEHD'&quot;/>&lt;/STATO_CHIAMATA_BPM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;STATO_CHIAMATA_BPM>&lt;xsl:value-of select=&quot;'ELABORATO_MANUALE'&quot;/>&lt;/STATO_CHIAMATA_BPM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_ESECUZIONE_PROCESSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($LoggerNoFile/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE)&quot;/>&lt;/ID_ESECUZIONE_PROCESSO_NO_FILE>&lt;TIMESTAMP_AGG>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMESTAMP_AGG>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQueryRecord/Record[$index]/ID_FILE_PROCSTO_INPUT)&quot;>&lt;xsl:value-of select=&quot;$JDBCQueryRecord/Record[$index]/ID_FILE_PROCSTO_INPUT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/