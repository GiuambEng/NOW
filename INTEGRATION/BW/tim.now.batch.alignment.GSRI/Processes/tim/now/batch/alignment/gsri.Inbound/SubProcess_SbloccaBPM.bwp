            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogStart-input"
                    name="LogStart"
                    tibex:xpdlId="7d96f510-0370-4fb5-a726-f6edd5321456"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLogStart"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStartToJDBCQueryRecord"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1617028717590&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.alignment.GSRI.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SbloccaBPM&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Start SbloccaBPM ',xsd:string($Start/tns1:IDFile ))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQueryRecord-input"
                    name="JDBCQueryRecord"
                    outputVariable="JDBCQueryRecord"
                    tibex:xpdlId="e50db2a9-8bcf-479c-a5d3-4a24bfbf9207" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartToJDBCQueryRecord"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToCopy_1_LogElabOK"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e50db2a9-8bcf-479c-a5d3-4a24bfbf9207+input&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1617028717590&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;JDBCQueryRecord-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;TIPO_RECORD>&lt;xsl:value-of select=&quot;&amp;quot;02&amp;quot;&quot;/>&lt;/TIPO_RECORD>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;4&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;STATO_CHIAMATA_BPM>&lt;xsl:value-of select=&quot;&amp;quot;DA ELABORARE&amp;quot;&quot;/>&lt;/STATO_CHIAMATA_BPM>&lt;STATO>&lt;xsl:value-of select=&quot;&amp;quot;COMPLETATO&amp;quot;&quot;/>&lt;/STATO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STG.ID_FILE_PROCSTO_INPUT,STG.ID_STATO_ELAB_STAG, STG.NUMERO_RECORD, STG.CODE_ABBONATO, STG.SAC_NVIE, STG.CAUS_ORDINE, STG.STATO_ORDINE, STG.TIPO_PORTAB, STG.DATA_EMISSIONE, STG.DATA_CUT_OVER, STG.ORA_CUT_OVER, STG.DATA_ESPL, STG.ORA_ESPL, STG.TIPO_RECORD,STG.CODICE_STATO, STG.DESC_STATO,STG.TIPO_MOVIM&#xa;FROM STAG_GSRI_NOW_FILE STG, STATO_ALLINEAMENTI STA &#xa;WHERE STG.ID_FILE_PROCSTO_INPUT=STA.ID_FILE&#xa;AND STG.TIPO_RECORD = ? AND STG.ID_STATO_ELAB_STAG = ? AND STG.STATO_CHIAMATA_BPM=? AND STA.STATO=?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO_RECORD"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_STATO_ELAB_STAG"/>
                                    <PreparedParameters
                                    DataType="12"
