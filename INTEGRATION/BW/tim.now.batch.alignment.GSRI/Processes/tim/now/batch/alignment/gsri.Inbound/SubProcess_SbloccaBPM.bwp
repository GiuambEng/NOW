                                    sqlStatement="UPDATE STAG_GSRI_NOW_FILE&#xa;  SET STATO_CHIAMATA_BPM = ?, ID_ESECUZIONE_PROCESSO_NO_FILE = ?, TIMESTAMP_AGG=?&#xa; where ID_FILE_PROCSTO_INPUT= ? and NUMERO_RECORD = ?"
