                                    <messagePartConfigurations
                                    partElementName="processManagerType:operationFailedFault"
                                    partName="fault" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <context>
                                    <inputMapping/>
                                    <outputMapping direction="OUTPUT"/>
                                    <faultMappings direction="FAULT" faultName="illegalArgumentFault"/>
                                    <faultMappings direction="FAULT" faultName="illegalStateFault"/>
                                    <faultMappings direction="FAULT" faultName="operationFailedFault"/>
                                    </context>
                                </operationConfiguration>
                                <outboundConfiguration
                                    httpClient="tim.now.batch.alignment.gsri.BPM_API_HttpClientResource" xsi:type="axis2:HttpTransportConfiguration"/>
                            </scaext:binding>
                            <scact:bindingAdjunct bindingName="SOAPReferenceBinding">
