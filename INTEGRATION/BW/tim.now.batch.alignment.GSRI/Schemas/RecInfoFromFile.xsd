<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/RecInfoFromFile" xmlns:tns="http://www.example.org/RecInfoFromFile" elementFormDefault="qualified">


    <complexType name="RecInfoFromFile_Input">
    	<sequence>
    		<element name="NomeFile" type="string" minOccurs="1" maxOccurs="1"></element>
    		<element name="IDFile" type="string" minOccurs="1" maxOccurs="1"></element>
    	</sequence>
    </complexType>

    <complexType name="RecInfoFromFile_Output">
    	<sequence>
    		<element name="IdContratto" type="string" minOccurs="0" maxOccurs="1"></element>
			<element name="CodOloAgcom" type="string" minOccurs="0" maxOccurs="1"></element>
			<element name="CodiceOLO" type="string" minOccurs="0" maxOccurs="1"></element>
    	</sequence>
    </complexType>

    <element name="Input" type="tns:RecInfoFromFile_Input"></element>

    <element name="Output" type="tns:RecInfoFromFile_Output"></element>
</schema>