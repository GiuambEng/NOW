<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/EONOWwhls" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/EONOWwhls">


    
    <complexType name="input_type">
    	<sequence>
    		<element name="SistemaDestinatario" type="string"
    			minOccurs="0" maxOccurs="1">
    		</element>
    		<element name="SistemaMittente" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="IdRichiestaOLO" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="TipologiaEvento" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="Transaction_ID" type="string" minOccurs="0" maxOccurs="1"></element>
    	</sequence>
    </complexType>

    <complexType name="output_type">
    	<sequence>
    		<element name="IdEONW" type="int" minOccurs="0" maxOccurs="1"></element>
    	</sequence>
    </complexType>

    <element name="Input" type="tns:input_type"></element>

    <element name="Output" type="tns:output_type"></element>
</schema>