ILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns:ID_TRACK"&gt;&lt;ns1:ID_TRACK&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns:ID_TRACK"/&gt;&lt;/ns1:ID_TRACK&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$GetFlowRetail/Record[number($index)]/ID_FLOW=112"&gt;&lt;ns1:NomeProcesso&gt;&lt;xsl:value-of select="'allineamentoAnagraficaCodiciNMU.GEM'"/&gt;&lt;/ns1:NomeProcesso&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns1:NomeProcesso&gt;&lt;xsl:value-of select="''"/&gt;&lt;/ns1:NomeProcesso&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns1:contaRecord_Input&gt;&lt;/part1&gt;&lt;/ns:Conta_Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
