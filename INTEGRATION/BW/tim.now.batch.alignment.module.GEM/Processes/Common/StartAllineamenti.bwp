                                    <tibex:expression
                                    expression="$VerificaLavorabilita/ns5:STATO=('WAIT','NOFOUND')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$VerificaLavorabilita/ns5:STATO=('WAIT','NOFOUND')]]></bpws:transitionCondition>
