                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToVerificaLavorabilita1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VerificaLavorabilitaToGenericLogger1">
                                    <tibex:DesignExpression>
