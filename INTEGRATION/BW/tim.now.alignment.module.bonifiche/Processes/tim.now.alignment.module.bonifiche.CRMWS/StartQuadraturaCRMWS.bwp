                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns1=&quot;http://www.example.org/GestioneMovedFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SFTP_Host&quot;/>&lt;xsl:param name=&quot;SFTP_Port&quot;/>&lt;xsl:param name=&quot;SFTP_User&quot;/>&lt;xsl:param name=&quot;SFTP_Password&quot;/>&lt;xsl:param name=&quot;ErrorPath&quot;/>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;MovedSource&quot;/>&lt;xsl:template name=&quot;MovedInError-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MovedSource/tns1:FullPathMovedFile)>0&quot;>&lt;xsl:if test=&quot;$MovedSource/tns1:FullPathMovedFile&quot;>&lt;tns1:FullPathOrigine>&lt;xsl:value-of select=&quot;$MovedSource/tns1:FullPathMovedFile&quot;/>&lt;/tns1:FullPathOrigine>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;>&lt;tns1:FullPathOrigine>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;/>&lt;/tns1:FullPathOrigine>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:FolderDestinazione>&lt;xsl:value-of select=&quot;$ErrorPath&quot;/>&lt;/tns1:FolderDestinazione>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;>&lt;tns1:NomeFile>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;/>&lt;/tns1:NomeFile>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;>&lt;tns1:ID_TRACK>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;/>&lt;/tns1:ID_TRACK>&lt;/xsl:if>&lt;tns1:SFTP>&lt;tns1:Host>&lt;xsl:value-of select=&quot;$SFTP_Host&quot;/>&lt;/tns1:Host>&lt;tns1:Port>&lt;xsl:value-of select=&quot;$SFTP_Port&quot;/>&lt;/tns1:Port>&lt;tns1:User>&lt;xsl:value-of select=&quot;$SFTP_User&quot;/>&lt;/tns1:User>&lt;tns1:Password>&lt;xsl:value-of select=&quot;$SFTP_Password&quot;/>&lt;/tns1:Password>&lt;/tns1:SFTP>&lt;tns1:Log>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;/tns1:Log>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
