                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ShellCommand&quot; xmlns:tns3=&quot;http://www.example.org/GestioneMovedFile&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns4=&quot;http://www.example.org/Set_Command&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:param name=&quot;MovedSource&quot;/>&lt;xsl:param name=&quot;CallShell&quot;/>&lt;xsl:template name=&quot;TrackKO-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Update>&lt;tns:FLAG_LAVORAZIONE>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:FLAG_LAVORAZIONE>&lt;tns:STATO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:STATO>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallShell/tns4:Esito='KO'&quot;>&lt;xsl:if test=&quot;$CallShell/tns4:DescrError&quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;$CallShell/tns4:DescrError&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($MovedSource/tns3:FullPathMovedFile)=0 and $VerificaLavorabilita/tns1:STATO='IN RILAVORAZIONE'&quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;'***ERROR - IMPOSSIBILE RI-LAVORARE FILE IN QUANTO NON SPOSTATO NELLA FOLDER SORGENTE**' &quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($_error)&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;/>&lt;/tns:ID_TRACK>&lt;/xsl:if>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:Update>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
