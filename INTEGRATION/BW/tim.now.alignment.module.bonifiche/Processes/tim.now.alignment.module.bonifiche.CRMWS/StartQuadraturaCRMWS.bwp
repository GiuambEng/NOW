                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;currentFlow&quot;/>&lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('***INIZIO VERIFICHE LAVORABILITA PER FLUSSO ',$currentFlow/FLOW, ' ID_FLUSSO= ',string($currentFlow/ID_FLOW))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogKO-input"
                                    name="LogKO"
                                    tibex:xpdlId="c66827e4-28c8-4ee1-ba8e-7db15d80b9a9"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="TrackKOToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ShellCommand&quot; xmlns:tns3=&quot;http://www.example.org/GestioneMovedFile&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns4=&quot;http://www.example.org/Set_Command&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:param name=&quot;MovedSource&quot;/>&lt;xsl:param name=&quot;CallShell&quot;/>&lt;xsl:template name=&quot;LogKO-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot; if( $CallShell/tns4:Esito='KO') then concat(&amp;quot;***ERROR***  &amp;quot; ,$CallShell/tns4:DescrError) else if (string-length($MovedSource/tns3:FullPathMovedFile)=0 and $VerificaLavorabilita/tns1:STATO='IN RILAVORAZIONE') then '***ERROR - IMPOSSIBILE RI-LAVORARE FILE IN QUANTO NON SPOSTATO NELLA FOLDER SORGENTE**' else tib:render-xml($_error)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Command"
                                    name="SetCommand"
                                    outputVariable="Command"
                                    tibex:xpdlId="43bd487e-6a23-403d-85fd-e90ad7f31b00" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CreateIDFileToCallSQLDR"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SetCommandToLogCommand"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if( $Flag_ssh='Y') then concat(&quot;export QUADRATURE_ROOT=&quot;, $Root, &quot;; cd &quot;, $Root, &quot;/TOOL_QUADRATURA/Sh/; nohup ./load_tool_quadratura.sh&quot;, &quot; &quot;, $VerificaLavorabilita/ns2:NOME_FILE, &quot; &quot;, string($CreateIDFile/ns4:ID_FILE), &quot; > /dev/null 2>&amp;1 &amp;&quot;)&#xd;&#xa;else &#xd;&#xa;concat('./start_loading.sh ', $Root, ' ', $VerificaLavorabilita/ns2:NOME_FILE, ' ' ,string($CreateIDFile/ns4:ID_FILE))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Command" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogCommand-input"
                                    name="LogCommand"
                                    tibex:xpdlId="ee2036a1-623d-4803-8371-18d38b7835b4"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SetCommandToLogCommand"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogCommandToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;SFTP_Host&quot;/>&lt;xsl:param name=&quot;SFTP_User&quot;/>&lt;xsl:param name=&quot;Command&quot;/>&lt;xsl:param name=&quot;Root&quot;/>&lt;xsl:param name=&quot;Flag_ssh&quot;/>&lt;xsl:template name=&quot;LogCommand-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;xsl:choose>&lt;xsl:when test=&quot;$Flag_ssh='Y'&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;***COMANDO PER BONIFICA NP DA LANCIARE IN SSH NELLA SHELL: &amp;quot;, $Command, &amp;quot; PARAMETRI DI CONFIGURAZIONE SSH - HOST:&amp;quot;, $SFTP_Host, &amp;quot; USER: &amp;quot;, $SFTP_User, &amp;quot;ROOT=&amp;quot;, $Root)&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;***COMANDO PER BONIFICA NP DA LANCIARE NELLA SHELL: &amp;quot;, $Command)&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogOKStartBonifica-input"
                                    name="LogOKStartBonifica"
                                    tibex:xpdlId="20653477-5c27-499d-9716-52c7acb58e9c"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToLogOKStartBonifica"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogOKStartPortingToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;currentFlow&quot;/>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:template name=&quot;LogOKStartBonifica-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('***STARTATA CORRETTAMENTE BONIFICA NP PER SISTEMA ', $currentFlow/SYSTEM, ' ID_TRACK', string( $VerificaLavorabilita/tns1:ID_TRACK))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="MovedSource-input"
                                    name="MovedSource"
                                    outputVariable="MovedSource"
                                    tibex:xpdlId="4b9f6228-f7fe-4d6f-8ab0-e63ad91ca0fe"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SetCodInterfacciaToCallProcess1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToCreateIDFile1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($MovedSource/ns9:FullPathMovedFile)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($MovedSource/ns9:FullPathMovedFile)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallProcessToTrackKO1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns1=&quot;http://www.example.org/GestioneMovedFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SourcePath&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Host&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Port&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_User&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_Password&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:InputData>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;>&#xa;                &lt;tns1:FullPathOrigine>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;/>&#xa;                &lt;/tns1:FullPathOrigine>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:FolderDestinazione>&#xa;                &lt;xsl:value-of select=&quot;$SourcePath&quot;/>&#xa;            &lt;/tns1:FolderDestinazione>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;>&#xa;                &lt;tns1:NomeFile>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;/>&#xa;                &lt;/tns1:NomeFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;>&#xa;                &lt;tns1:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;/>&#xa;                &lt;/tns1:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:SFTP>&#xa;                &lt;tns1:Host>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Host&quot;/>&#xa;                &lt;/tns1:Host>&#xa;                &lt;tns1:Port>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Port&quot;/>&#xa;                &lt;/tns1:Port>&#xa;                &lt;tns1:User>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_User&quot;/>&#xa;                &lt;/tns1:User>&#xa;                &lt;tns1:Password>&#xa;                    &lt;xsl:value-of select=&quot;$SFTP_Password&quot;/>&#xa;                &lt;/tns1:Password>&#xa;            &lt;/tns1:SFTP>&#xa;            &lt;tns1:Log>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;            &lt;/tns1:Log>&#xa;        &lt;/tns1:InputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile_SFTPMode.GestioneMovedFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="CallShell-input"
                                    name="CallShell"
                                    outputVariable="CallShell"
                                    tibex:xpdlId="9efab2f2-2303-4790-a79d-2abb2584ed27"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogCommandToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToUpdKOLogger">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallProcessToLogOKStartBonifica">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallShell/tns2:Esito='OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallShell/tns2:Esito='OK']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Set_Command&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Root&quot;/>&lt;xsl:param name=&quot;Flag_ssh&quot;/>&lt;xsl:param name=&quot;Command&quot;/>&lt;xsl:template name=&quot;CallShell-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Command>&lt;xsl:value-of select=&quot;$Command&quot;/>&lt;/tns:Command>&lt;tns:WorkingDirectory>&lt;xsl:value-of select=&quot;$Root&quot;/>&lt;/tns:WorkingDirectory>&lt;tns:FlagSSH>&lt;xsl:value-of select=&quot;$Flag_ssh&quot;/>&lt;/tns:FlagSSH>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.alignment.module.bonifiche.common.CallShell" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
