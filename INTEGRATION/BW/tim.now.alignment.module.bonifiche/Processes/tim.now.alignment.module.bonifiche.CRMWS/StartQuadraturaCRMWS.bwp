    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="IterateToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="CRMWSFlowsNameToIterate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="BSSFlowsNameToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="Timer"
                    tibex:xpdlId="5fe36381-0066-4ec3-8efa-c189cd5f9609"
                    variable="Timer" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerToCallProcess"/>
                    </bpws:sources>
                    <bpws:correlations/>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="StartBonifica"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="IntervaloMinuti"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="endTime" processProperty="EndBonifica"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value endPolicy="END_TIME"
                                    intervalUnit="Minute" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="GetQuadratureCRMWS-input"
                    name="GetQuadratureCRMWS"
                    outputVariable="GetQuadratureCRMWS"
                    tibex:xpdlId="b60d6013-047e-404f-a784-50649a39ee2a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CRMWSFlowsNameToIterate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($GetQuadratureCRMWS/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($GetQuadratureCRMWS/Record) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="BSSFlowsNameToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b60d6013-047e-404f-a784-50649a39ee2a+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_FLOW, FLOW, SYSTEM FROM ALIGN_FILE_TRACKING where &#xd;&#xa;(STATO in ('DA LAVORARE','IN ATTESA') OR FLAG_REWORK='Y')&#xd;&#xa;AND SYSTEM ='CRMWS' AND ID_FLOW = 63&#xd;&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_FLOW"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLOW"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="SYSTEM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="fd4aef78-bad5-40ae-a354-8574b466299d">
                <bpws:targets>
                    <bpws:target linkName="IterateToExit"/>
                    <bpws:target linkName="BSSFlowsNameToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:empty name="GroupEnd" tibex:group="groupEnd" tibex:xpdlId="c2f27a52-d8a9-46ee-9945-770403a856c2"/>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="14d143be-0694-4664-9695-d5f7d45de095">
                <bpws:targets>
                    <bpws:target linkName="CRMWSFlowsNameToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$GetQuadratureCRMWS/Record" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($GetQuadratureCRMWS/Record)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns0:Iterate_Current_Element_Record"
                                    name="currentFlow" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="UpdKOLoggerToMovedInError" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CreateIDFileToCallSQLDR" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CreateIDFileToMovedInError" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="AssignToCreateIDFile" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="VerificaLavorabilitaToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="CallProcessToTrackKO" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="VerificaLavorabilitaToSetCodInterfaccia" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="CallProcessToUpdKOLogger" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="GroupStartToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="SetCodInterfacciaToCallProcess1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="CallProcessToCreateIDFile1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="CallProcessToTrackKO1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="UpdKOLoggerToEmpty1" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="Empty1ToMovedInError" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="VerificaLavorabilitaToGroupEnd1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="TrackKOToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToLogOKStartBonifica" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="LogStartToVerificaLavorabilita" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToGroupEnd1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="SetCommandToLogCommand" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogCommandToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogOKStartPortingToGroupEnd1" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="e8d778f6-2fa2-417b-b3b8-15bc24ddcacc" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToCallProcess"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($GetQuadratureCRMWS/Record)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentFlow"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd1"
                                    tibex:group="groupEnd" tibex:xpdlId="3b62a43c-3505-4c75-840c-e613ec4a6b69">
                                    <bpws:targets>
                                    <bpws:target linkName="VerificaLavorabilitaToGroupEnd1"/>
                                    <bpws:target linkName="CallProcessToGroupEnd1"/>
                                    <bpws:target linkName="LogOKStartPortingToGroupEnd1"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="UpdKOLogger-input"
                                    name="UpdKOLogger"
                                    outputVariable="UpdKOLogger"
                                    tibex:xpdlId="848b7a44-b9b6-4e79-a874-c499b4796d76"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToUpdKOLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="UpdKOLoggerToMovedInError"/>
                                    <bpws:source
                                    linkName="UpdKOLoggerToEmpty1"
                                    tibex:faultDetailsVar="UpdKOLogger" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CreateIDFile&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;UpdKOLogger-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:DataIn>&lt;tns:Update>&lt;tns:InputFile>&lt;xsl:if test=&quot;$CreateIDFile/tns:ID_FILE&quot;>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;$CreateIDFile/tns:ID_FILE&quot;/>&lt;/tns:ID_FILE>&lt;/xsl:if>&lt;tns:STATO_ESEC>&lt;xsl:value-of select=&quot;'PROCESSO ESEGUITO CON ERRORE'&quot;/>&lt;/tns:STATO_ESEC>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:ESITO>&lt;tns:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&lt;/tns:DESCR_STATO_FILE>&lt;tns:LOG_MESSAGE>&lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE INPUT CORROTTO&amp;quot;&quot;/>&lt;/tns:LOG_MESSAGE>&lt;/tns:InputFile>&lt;/tns:Update>&lt;/tns:DataIn>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
