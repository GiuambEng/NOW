                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceInterfaccia&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;CreateIDFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:DataIn>&#xa;                &lt;tns:Insert>&#xa;                    &lt;tns:InputFile>&#xa;                        &lt;tns:CODICE_INTERFACCIA>&#xa;                            &lt;xsl:value-of select=&quot;$CodiceInterfaccia&quot;/>&#xa;                        &lt;/tns:CODICE_INTERFACCIA>&#xa;                        &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;>&#xa;                            &lt;tns:NOME_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;/>&#xa;                            &lt;/tns:NOME_FILE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:DATA_FILE&quot;>&#xa;                            &lt;tns:DATA_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:DATA_FILE&quot;/>&#xa;                            &lt;/tns:DATA_FILE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:FILE_SIZE&quot;>&#xa;                            &lt;tns:SIZE>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:FILE_SIZE&quot;/>&#xa;                            &lt;/tns:SIZE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&#xa;                            &lt;tns:ID_TRACK>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;/>&#xa;                            &lt;/tns:ID_TRACK>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:InputFile>&#xa;                &lt;/tns:Insert>&#xa;            &lt;/tns:DataIn>&#xa;            &lt;tns:LogElement>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;            &lt;/tns:LogElement>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
