                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputSubProcess_SFTP&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/SFTPGetJavaCode/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SFTP_GetJavaCode&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;SFTP_GET-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:SFTP_GetJavaCodeInput>&#xa;            &lt;tns2:RemoteFile>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:FileToBeSend&quot;/>&#xa;            &lt;/tns2:RemoteFile>&#xa;            &lt;tns2:LocalFile>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Directory&quot;/>&#xa;            &lt;/tns2:LocalFile>&#xa;            &lt;tns2:credenziali>&#xa;                &lt;tns2:Host>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Credentials/tns:Host&quot;/>&#xa;                &lt;/tns2:Host>&#xa;                &lt;tns2:Port>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Credentials/tns:Port&quot;/>&#xa;                &lt;/tns2:Port>&#xa;                &lt;xsl:if test=&quot;$Start/tns:Credentials/tns:Password&quot;>&#xa;                    &lt;tns2:Password>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Credentials/tns:Password&quot;/>&#xa;                    &lt;/tns2:Password>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:User>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Credentials/tns:User&quot;/>&#xa;                &lt;/tns2:User>&#xa;            &lt;/tns2:credenziali>&#xa;        &lt;/tns2:SFTP_GetJavaCodeInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
