                        xmlns:pt="http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/"
                        xmlns:sca="http://www.osoa.org/xmlns/sca/1.0"
                        xmlns:scact="http://xsd.tns.tibco.com/amf/models/sca/componentType"
                        xmlns:scaext="http://xsd.tns.tibco.com/amf/models/sca/extensions" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <referenceBinding name="Conta" xsi:type="scact:Reference">
                            <sca:interface.wsdl
                                interface="http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/#wsdl.interface(Conta)" scaext:wsdlLocation="../../../../../../../../tim.now.shared_library/Service%20Descriptors/Migrazione_Batch/ContaRecord_JMS_Concrete.wsdl"/>
                            <scaext:binding
                                destination="tim.now.alignment.shared.conta.record.jms"
                                modelVersion="1.2.0"
                                name="SOAPReferenceBinding"
                                portName="ContaConcreteSOAP"
                                portTypeQName="pt:Conta"
                                portTypeWSDLLocation="platform:/resource/tim.now.shared_library/Service%20Descriptors/Migrazione_Batch/ContaRecord_JMS_Concrete.wsdl"
                                serviceBindingQName="pt:SOAPBinding_JMS_SSL_ContaServer"
                                serviceQName="pt:ContaConcrete"
                                transportBindingType="JMS"
                                wsdlLocation="platform:/resource/tim.now.shared_library/Service%20Descriptors/Migrazione_Batch/ContaRecord_JMS_Concrete.wsdl" xsi:type="axis2:SOAPReferenceBinding">
                                <bindingType style="DOCUMENT"/>
                                <operationConfiguration
