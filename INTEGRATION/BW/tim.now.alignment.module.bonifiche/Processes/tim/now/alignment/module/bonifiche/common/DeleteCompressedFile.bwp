                <bpws:link name="CallProcessToTryToMove" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToTryToRemove" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
