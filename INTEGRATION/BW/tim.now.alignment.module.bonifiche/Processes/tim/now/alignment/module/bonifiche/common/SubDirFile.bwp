        <bpws:variable element="ns4:Output_SFTP_DirDetail"
            name="DirDetails" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogStartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToLogEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="DirDetailsToEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="DirDetailsToEmpty" tibex:linkType="ERROR"/>
                <bpws:link name="EmptyToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="2dd37e3d-597a-4eee-b0fd-e045d4c15c35"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputSubProcess_SFTP&quot; xmlns:tns1=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DirDetails&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DirDetails/tns1:ListOfFiles) > 0 and $DirDetails/tns1:Status = &amp;quot;OK&amp;quot;&quot;>&lt;tns:Output_SFTP_DirDetail>&lt;tns:Status>&lt;xsl:value-of select=&quot;$DirDetails/tns1:Status&quot;/>&lt;/tns:Status>&lt;xsl:for-each select=&quot;$DirDetails/tns1:ListOfFiles&quot;>&lt;tns:ListOfFiles>&lt;tns:FileName>&lt;xsl:value-of select=&quot;tns1:FileName&quot;/>&lt;/tns:FileName>&lt;tns:FullName>&lt;xsl:value-of select=&quot;tns1:FullName&quot;/>&lt;/tns:FullName>&lt;tns:Size>&lt;xsl:value-of select=&quot;tns1:Size&quot;/>&lt;/tns:Size>&lt;tns:LastModified>&lt;xsl:value-of select=&quot;tns1:LastModified&quot;/>&lt;/tns:LastModified>&lt;/tns:ListOfFiles>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$DirDetails/tns1:Message&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;$DirDetails/tns1:Message&quot;/>&lt;/tns:Message>&lt;/xsl:if>&lt;/tns:Output_SFTP_DirDetail>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Output_SFTP_DirDetail>&lt;tns:Status>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Status>&lt;/tns:Output_SFTP_DirDetail>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="6c26207f-b93a-4574-9d2a-3c5e0660889c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToEnd"/>
                        <bpws:target linkName="DirDetailsToEnd"/>
                        <bpws:target linkName="EmptyToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputSubProcess_SFTP&quot; xmlns:tns1=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DirDetails&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DirDetails/tns1:ListOfFiles) > 0 and $DirDetails/tns1:Status = &amp;quot;OK&amp;quot;&quot;>&lt;tns:Output_SFTP_DirDetail>&lt;tns:Status>&lt;xsl:value-of select=&quot;$DirDetails/tns1:Status&quot;/>&lt;/tns:Status>&lt;xsl:for-each select=&quot;$DirDetails/tns1:ListOfFiles&quot;>&lt;tns:ListOfFiles>&lt;tns:FileName>&lt;xsl:value-of select=&quot;tns1:FileName&quot;/>&lt;/tns:FileName>&lt;tns:FullName>&lt;xsl:value-of select=&quot;tns1:FullName&quot;/>&lt;/tns:FullName>&lt;tns:Size>&lt;xsl:value-of select=&quot;tns1:Size&quot;/>&lt;/tns:Size>&lt;tns:LastModified>&lt;xsl:value-of select=&quot;tns1:LastModified&quot;/>&lt;/tns:LastModified>&lt;/tns:ListOfFiles>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$DirDetails/tns1:Message&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;$DirDetails/tns1:Message&quot;/>&lt;/tns:Message>&lt;/xsl:if>&lt;/tns:Output_SFTP_DirDetail>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Output_SFTP_DirDetail>&lt;tns:Status>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Status>&lt;/tns:Output_SFTP_DirDetail>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.example.org/InputSubProcess_SFTP&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'SubDirFile'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('StartSubDirFile : ' ,$Start/tns1:FileToBeSend,$Start/tns1:Directory,tib:render-xml($Start/tns1:Credentials,true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogStart-input" name="LogStart"
                    tibex:xpdlId="85456c8f-4b02-41a8-943b-2daa8045c4ed"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStartToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.example.org/InputSubProcess_SFTP&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'SubDirFile'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('StartSubDirFile : ' ,$Start/tns1:FileToBeSend,$Start/tns1:Directory,tib:render-xml($Start/tns1:Credentials,true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_DirJavaCode&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;DirDetails&quot;/>&lt;xsl:template name=&quot;LogEnd-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'SubDirFile'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('EndSubDirFile: ',$DirDetails/tns2:Status,$DirDetails/tns2:Message)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogEnd-input" name="LogEnd"
                    tibex:xpdlId="8792ea03-7310-4add-9df4-68978d13c94e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToLogEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess1ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_DirJavaCode&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;DirDetails&quot;/>&lt;xsl:template name=&quot;LogEnd-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'SubDirFile'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('EndSubDirFile: ',$DirDetails/tns2:Status,$DirDetails/tns2:Message)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputSubProcess_SFTP&quot; xmlns:tns1=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;DirDetails-input&quot; match=&quot;/&quot;>&lt;tns1:Input_SFTP_DirDetail>&lt;tns1:Credentials>&lt;tns1:Host>&lt;xsl:value-of select=&quot;$Start/tns:Credentials/tns:Host&quot;/>&lt;/tns1:Host>&lt;tns1:User>&lt;xsl:value-of select=&quot;$Start/tns:Credentials/tns:User&quot;/>&lt;/tns1:User>&lt;xsl:if test=&quot;$Start/tns:Credentials/tns:Password&quot;>&lt;tns1:Password>&lt;xsl:value-of select=&quot;$Start/tns:Credentials/tns:Password&quot;/>&lt;/tns1:Password>&lt;/xsl:if>&lt;tns1:Port>&lt;xsl:value-of select=&quot;$Start/tns:Credentials/tns:Port&quot;/>&lt;/tns1:Port>&lt;/tns1:Credentials>&lt;tns1:RequestType>&lt;tns1:SingleFileDetail>&lt;xsl:value-of select=&quot;$Start/tns:Directory&quot;/>&lt;/tns1:SingleFileDetail>&lt;/tns1:RequestType>&lt;/tns1:Input_SFTP_DirDetail>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="DirDetails-input" name="DirDetails"
                    outputVariable="DirDetails"
                    tibex:xpdlId="a133fc29-f827-4c9e-a048-5febaa8a7cfb"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToLogEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($DirDetails/ns4:ListOfFiles) > 0 and $DirDetails/ns4:Status = &quot;OK&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($DirDetails/ns4:ListOfFiles) > 0 and $DirDetails/ns4:Status = "OK"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="DirDetailsToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="DirDetailsToEmpty"
                            tibex:faultDetailsVar="DirDetails" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputSubProcess_SFTP&quot; xmlns:tns1=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;DirDetails-input&quot; match=&quot;/&quot;>&lt;tns1:Input_SFTP_DirDetail>&lt;tns1:Credentials>&lt;tns1:Host>&lt;xsl:value-of select=&quot;$Start/tns:Credentials/tns:Host&quot;/>&lt;/tns1:Host>&lt;tns1:User>&lt;xsl:value-of select=&quot;$Start/tns:Credentials/tns:User&quot;/>&lt;/tns1:User>&lt;xsl:if test=&quot;$Start/tns:Credentials/tns:Password&quot;>&lt;tns1:Password>&lt;xsl:value-of select=&quot;$Start/tns:Credentials/tns:Password&quot;/>&lt;/tns1:Password>&lt;/xsl:if>&lt;tns1:Port>&lt;xsl:value-of select=&quot;$Start/tns:Credentials/tns:Port&quot;/>&lt;/tns1:Port>&lt;/tns1:Credentials>&lt;tns1:RequestType>&lt;tns1:SingleFileDetail>&lt;xsl:value-of select=&quot;$Start/tns:Directory&quot;/>&lt;/tns1:SingleFileDetail>&lt;/tns1:RequestType>&lt;/tns1:Input_SFTP_DirDetail>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="SFTP.STFP_DirDetail" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="76dffbc5-31ad-403f-8de5-09f7e4f3678a">
                <bpws:targets>
                    <bpws:target linkName="DirDetailsToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToEnd"/>
                </bpws:sources>
            </bpws:empty>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
