                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SetCommand&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.example.org/Set_Command&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ExternalCommand&quot;/>&lt;xsl:param name=&quot;_error_ExternalCommand&quot;/>&lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&lt;tns1:Output>&lt;xsl:choose>&lt;xsl:when test=&quot;$ExternalCommand/returnCode=0&quot;>&lt;tns1:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns1:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($_error_ExternalCommand)&quot;>&lt;tns1:DescrError>&lt;xsl:value-of select=&quot;tib:render-xml($_error_ExternalCommand)&quot;/>&lt;/tns1:DescrError>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ExternalCommand/error[1])>0&quot;>&lt;tns1:DescrError>&lt;xsl:value-of select=&quot;tib:render-xml($ExternalCommand)&quot;/>&lt;/tns1:DescrError>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns1:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
