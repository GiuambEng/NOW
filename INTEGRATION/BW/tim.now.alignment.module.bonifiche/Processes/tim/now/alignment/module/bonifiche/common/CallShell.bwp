    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/ShellCommand"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/Set_Command"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns5:Output" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="LoggerName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable name="LogLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LogLevel" type="xsd:string"/>
        <bpws:variable element="ns0:CmdInput"
            name="ExternalCommand-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CmdOutputWithActivityOutput"
            name="ExternalCommand" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:Input_ShellCommand"
            name="SSHCommand-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:Output_ShellCommand"
            name="SSHCommand" sca-bpel:internal="true"/>
        <bpws:variable name="SSHHost" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/SFTP/Machine/Host" type="xsd:string"/>
        <bpws:variable name="SSHPort" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/SFTP/Machine/Port" type="xsd:int"/>
        <bpws:variable name="SSHUser" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/SFTP/Machine/User" type="xsd:string"/>
        <bpws:variable name="SSHPassword" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/SFTP/Machine/Password" type="tibprop:password"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogOuput-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogOutputSSH-input" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:ErrorLinkHandlerFaultData"
            name="_error_ExternalCommand" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:Output" name="Output"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToExternalCommand" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartToSSHCommand" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="ExternalCommandToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="SSHCommandToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="ExternalCommandToEmpty" tibex:linkType="ERROR"/>
                <bpws:link name="EmptyToLogOuput" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogOuputToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="Empty1ToLogOutputSSH" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogOutputSSHToAssign1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Assign1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="SSHCommandToEmpty1" tibex:linkType="ERROR"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="8d4a4f75-bb4c-4d69-b4af-6b9a349ad76d"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToExternalCommand">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns5:FlagSSH='N'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns5:FlagSSH='N']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToSSHCommand">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="7f9324f5-36ac-4115-9e41-702e512fc580" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToEnd"/>
                        <bpws:target linkName="Assign1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SetCommand&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Output&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Output&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ExternalCommand-input"
                    name="ExternalCommand"
                    outputVariable="ExternalCommand"
                    tibex:xpdlId="167916c6-dacf-4a82-9f9f-8c3526d52a3f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToExternalCommand"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ExternalCommandToCallProcess"/>
                        <bpws:source linkName="ExternalCommandToEmpty"
                            tibex:faultDetailsVar="ExternalCommand" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/externalcommand/xsd/input&quot; xmlns:tns1=&quot;http://www.example.org/SetCommand&quot; xmlns:tns2=&quot;http://www.example.org/Set_Command&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ExternalCommand-input&quot; match=&quot;/&quot;>&lt;tns:CmdInput>&lt;command>&lt;xsl:value-of select=&quot;$Start/tns2:Command&quot;/>&lt;/command>&lt;xsl:if test=&quot;$Start/tns2:WorkingDirectory&quot;>&lt;workingDirectory>&lt;xsl:value-of select=&quot;$Start/tns2:WorkingDirectory&quot;/>&lt;/workingDirectory>&lt;/xsl:if>&lt;/tns:CmdInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.externalcommand"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//ExternalCommand"/>
                                    <value outputCommandOutput="true"
                                    outputLineSplittingMode="OSDefault" xsi:type="generalactivities:ExternalCommand"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="SSHCommand-input"
                    name="SSHCommand" outputVariable="SSHCommand"
                    tibex:xpdlId="08679091-87b2-43cb-acb1-980563c1e80a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToSSHCommand"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SSHCommandToCallProcess1"/>
                        <bpws:source linkName="SSHCommandToEmpty1"
                            tibex:faultDetailsVar="SSHCommand" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ShellCommand&quot; xmlns:tns1=&quot;http://www.example.org/SetCommand&quot; xmlns:tns2=&quot;http://www.example.org/Set_Command&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SSHHost&quot;/>&lt;xsl:param name=&quot;SSHPort&quot;/>&lt;xsl:param name=&quot;SSHUser&quot;/>&lt;xsl:param name=&quot;SSHPassword&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SSHCommand-input&quot; match=&quot;/&quot;>&lt;tns:Input_ShellCommand>&lt;tns:Host>&lt;xsl:value-of select=&quot;$SSHHost&quot;/>&lt;/tns:Host>&lt;tns:User>&lt;xsl:value-of select=&quot;$SSHUser&quot;/>&lt;/tns:User>&lt;tns:Password>&lt;xsl:value-of select=&quot;$SSHPassword&quot;/>&lt;/tns:Password>&lt;tns:Port>&lt;xsl:value-of select=&quot;$SSHPort&quot;/>&lt;/tns:Port>&lt;tns:Command>&lt;xsl:value-of select=&quot;$Start/tns2:Command&quot;/>&lt;/tns:Command>&lt;/tns:Input_ShellCommand>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="SFTP.ExecShellCommand" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOuput-input"
                    name="LogOuput"
                    tibex:xpdlId="f690073d-574e-409c-bf43-eaa0c30be5e8"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
