            tibex:propertySource="/Log/LogLevel" type="xsd:string"/>
        <bpws:variable name="ApplicationName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable name="PathFileScarto" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/PathFile/Quadratura_CRMR-B/PathScarto" type="xsd:string"/>
        <bpws:variable name="PathFileError" sca-bpel:hotUpdate="false"
