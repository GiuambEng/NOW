        <bpws:variable element="ns7:OutputData" name="MovedInScarto" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:InputData" name="MovedInError-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:OutputData" name="MovedInError" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:InputData"
            name="MoveInStorico-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:OutputData" name="MoveInStorico" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:Input"
            name="UpdFileProcstoKO_Tecnico-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:Output"
            name="UpdFileProcstoKO_Tecnico" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:Input" name="UpdFileProcstoOK-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:Output" name="UpdFileProcstoOK" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:Input"
            name="UpdateFileProcstoKO_NumRecord-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:Output"
            name="UpdateFileProcstoKO_NumRecord" sca-bpel:internal="true"/>
        <bpws:variable name="IntervaloMinuti" sca-bpel:hotUpdate="false"
