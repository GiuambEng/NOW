    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/CreateFileID"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/GestioneMovedFile"/>
    <bpws:partnerLinks>
        <bpws:partnerLink name="SFTP_Rename"
            partnerLinkType="ns3:partnerLinkType" partnerRole="use"
            sca-bpel:ignore="true" sca-bpel:reference="SFTP_Rename" sca-bpel:wiredByImpl="false">
            <tibex:ReferenceWire dynamic="false" inline="false"
                processConfigurationName=""
                processName="SFTP.SFTP_Rename" serviceName="SFTPRenameJavaCode"/>
        </bpws:partnerLink>
    </bpws:partnerLinks>
    <bpws:variables>
