                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($CheckStatusFiles/Record[STATO = 'OK_SHADOW'])]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope2">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns2:Iterate2_Current_Element_Record"
                                    name="currentRecordOK" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow3">
                                <bpws:links>
