        <bpws:variable name="EndBonifica" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Timer/Quadratura_CRMR-B/EndBonifica" type="xsd:dateTime"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckStatusFilesToIterate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="IterateToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="Iterate1ToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckStatusFilesToIterate1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CheckStatusFilesToIterate2" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CheckStatusFilesToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Iterate2ToExit" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="Timer"
                    tibex:xpdlId="88811863-47fc-43e6-b817-305f0e78db3f"
                    variable="Timer" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="IntervaloMinuti"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="StartBonifica"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="endTime" processProperty="EndBonifica"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value endPolicy="END_TIME"
                                    intervalUnit="Minute" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b28f122d-f0ee-4947-9b87-4b34837d94fb+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CheckStatusFiles-input"
                    name="CheckStatusFiles"
                    outputVariable="CheckStatusFiles"
                    tibex:xpdlId="b28f122d-f0ee-4947-9b87-4b34837d94fb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckStatusFilesToIterate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($CheckStatusFiles/Record[STATO='KO_NUMERO_RECORD'])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($CheckStatusFiles/Record[STATO='KO_NUMERO_RECORD'])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckStatusFilesToIterate1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($CheckStatusFiles/Record[STATO = ('KO_STAGING','KO_SHADOW')])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($CheckStatusFiles/Record[STATO = ('KO_STAGING','KO_SHADOW')])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckStatusFilesToIterate2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($CheckStatusFiles/Record[STATO = 'OK_SHADOW'])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($CheckStatusFiles/Record[STATO = 'OK_SHADOW'])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckStatusFilesToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b28f122d-f0ee-4947-9b87-4b34837d94fb+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_TRACK, STATO, SYSTEM, FLOW, FOLDER, FILE_NAME, ID_FILE_INPUT&#xd;&#xa;FROM ALIGN_FILE_TRACKING&#xd;&#xa;WHERE ID_FLOW IN (61,62)  AND &#xd;&#xa;STATO in ('OK_SHADOW', 'KO_SHADOW', 'KO_STAGING','KO_NUMERO_RECORD','OK_TARGET')&#xd;&#xa;AND (FLAG_LAVORATO='N' OR FLAG_LAVORATO IS NULL)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_TRACK"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="STATO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="SYSTEM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLOW"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FOLDER"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FILE_NAME"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_FILE_INPUT"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="38d7f3eb-964d-4ff3-acc2-0c38f8c42ce1">
                <bpws:targets>
                    <bpws:target linkName="CheckStatusFilesToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$CheckStatusFiles/Record[STATO='KO_NUMERO_RECORD']" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($CheckStatusFiles/Record[STATO='KO_NUMERO_RECORD'])]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns2:Iterate_Current_Element_Record"
                                    name="currentKOFunz" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToUpdateFileProcsto" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="UpdateFileProcstoKO_NumRecordToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="MovedInScartoToTrackFileKOFuncional" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="TrackFileKOFuncionalToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="00583318-5767-467a-89ed-a52e7adbf337" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToUpdateFileProcsto"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($CheckStatusFiles/Record[STATO='KO_NUMERO_RECORD'])[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentKOFunz"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="c5b8e891-1bf1-4c9c-ab20-9dc3e26cc3cd">
                                    <bpws:targets>
                                    <bpws:target linkName="TrackFileKOFuncionalToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentKOFunz&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;UpdateFileProcstoKO_NumRecord-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:DataIn>&lt;tns:Update>&lt;tns:InputFile>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($currentKOFunz/ID_FILE_INPUT)&quot;/>&lt;/tns:ID_FILE>&lt;tns:STATO_ESEC>&lt;xsl:value-of select=&quot;'PROCESSO ESEGUITO CON ERRORE'&quot;/>&lt;/tns:STATO_ESEC>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:ESITO>&lt;tns:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;'ERRORE NUMERO RECORD'&quot;/>&lt;/tns:DESCR_STATO_FILE>&lt;tns:LOG_MESSAGE>&lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE INPUT PER NUMERO RECORD INCONGRUENTE&amp;quot;&quot;/>&lt;/tns:LOG_MESSAGE>&lt;/tns:InputFile>&lt;/tns:Update>&lt;/tns:DataIn>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="UpdateFileProcstoKO_NumRecord-input"
                                    name="UpdateFileProcstoKO_NumRecord"
                                    outputVariable="UpdateFileProcstoKO_NumRecord"
                                    tibex:xpdlId="7a217e98-11ae-4cfb-9cd9-f420e1a64224"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToUpdateFileProcsto"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="UpdateFileProcstoKO_NumRecordToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentKOFunz&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;UpdateFileProcstoKO_NumRecord-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:DataIn>&lt;tns:Update>&lt;tns:InputFile>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($currentKOFunz/ID_FILE_INPUT)&quot;/>&lt;/tns:ID_FILE>&lt;tns:STATO_ESEC>&lt;xsl:value-of select=&quot;'PROCESSO ESEGUITO CON ERRORE'&quot;/>&lt;/tns:STATO_ESEC>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:ESITO>&lt;tns:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;'ERRORE NUMERO RECORD'&quot;/>&lt;/tns:DESCR_STATO_FILE>&lt;tns:LOG_MESSAGE>&lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE INPUT PER NUMERO RECORD INCONGRUENTE&amp;quot;&quot;/>&lt;/tns:LOG_MESSAGE>&lt;/tns:InputFile>&lt;/tns:Update>&lt;/tns:DataIn>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.ProcessLoggerTrack" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
