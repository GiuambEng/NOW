                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:tns2=&quot;http://www.example.org/CheckNomeFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;SFTP_Host&quot;/>&lt;xsl:param name=&quot;SFTP_Port&quot;/>&lt;xsl:param name=&quot;SFTP_User&quot;/>&lt;xsl:param name=&quot;SFTP_Password&quot;/>&lt;xsl:param name=&quot;System&quot;/>&lt;xsl:param name=&quot;PathError&quot;/>&lt;xsl:param name=&quot;PathStoricoTappo&quot;/>&lt;xsl:param name=&quot;CheckFileNme&quot;/>&lt;xsl:template name=&quot;Track-input&quot; match=&quot;/&quot;>&lt;tns1:InputFileTappo>&lt;tns1:FileName>&lt;xsl:value-of select=&quot;$currentElement/tns:FullName&quot;/>&lt;/tns1:FileName>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LogName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:ApplicationName>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns1:ApplicationName>&lt;tns1:Estensione>&lt;xsl:value-of select=&quot;'.csv'&quot;/>&lt;/tns1:Estensione>&lt;tns1:Sistema>&lt;xsl:value-of select=&quot;$System&quot;/>&lt;/tns1:Sistema>&lt;tns1:Flusso>&lt;xsl:value-of select=&quot;$CheckFileNme/tns2:FLUSSO&quot;/>&lt;/tns1:Flusso>&lt;tns1:PathError>&lt;xsl:value-of select=&quot;$PathError&quot;/>&lt;/tns1:PathError>&lt;tns1:PathMovedTappo>&lt;xsl:value-of select=&quot;$PathStoricoTappo&quot;/>&lt;/tns1:PathMovedTappo>&lt;tns1:Flag_SFTP_Mode>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Flag_SFTP_Mode>&lt;tns1:SFTPInputData>&lt;tns1:Host>&lt;xsl:value-of select=&quot;$SFT