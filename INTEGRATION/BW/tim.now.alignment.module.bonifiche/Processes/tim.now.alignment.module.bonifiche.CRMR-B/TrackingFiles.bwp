    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Iterate1ToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="SFTP_CheckInnescoCRMRetailToIterate1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="SFTP_CheckInnescoCRMRetailToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="Timer"
                    tibex:xpdlId="5ec46b4c-e944-452d-9271-ae6f1b79f3b2"
                    variable="Timer" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerToCallProcess1"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="StartBonifica"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="IntervaloMinuti"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="endTime" processProperty="EndBonifica"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value endPolicy="END_TIME"
                                    intervalUnit="Minute" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SFTP_Host&quot;/>&lt;xsl:param name=&quot;SFTP_Port&quot;/>&lt;xsl:param name=&quot;SFTP_User&quot;/>&lt;xsl:param name=&quot;SFTP_Password&quot;/>&lt;xsl:param name=&quot;FilePathTappo&quot;/>&lt;xsl:template name=&quot;SFTP_CheckInnesco-input&quot; match=&quot;/&quot;>&lt;tns:Input_SFTP_DirDetail>&lt;tns:Credentials>&lt;tns:Host>&lt;xsl:value-of select=&quot;$SFTP_Host&quot;/>&lt;/tns:Host>&lt;tns:User>&lt;xsl:value-of select=&quot;$SFTP_User&quot;/>&lt;/tns:User>&lt;tns:Password>&lt;xsl:value-of select=&quot;$SFTP_Password&quot;/>&lt;/tns:Password>&lt;tns:Port>&lt;xsl:value-of select=&quot;$SFTP_Port&quot;/>&lt;/tns:Port>&lt;/tns:Credentials>&lt;tns:RequestType>&lt;tns:ListOfFilesDetails>&lt;tns:DirectoryPath>&lt;xsl:value-of select=&quot;$FilePathTappo&quot;/>&lt;/tns:DirectoryPath>&lt;tns:FileExtensionToFilter>&lt;xsl:value-of select=&quot;'.TAPPO'&quot;/>&lt;/tns:FileExtensionToFilter>&lt;/tns:ListOfFilesDetails>&lt;/tns:RequestType>&lt;/tns:Input_SFTP_DirDetail>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SFTP_CheckInnesco-input"
                    name="SFTP_CheckInnesco"
                    outputVariable="SFTP_CheckInnesco"
                    tibex:xpdlId="6138aaaa-e659-4e3d-98d4-53ed9f277276"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SFTP_CheckInnescoCRMRetailToIterate1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SFTP_CheckInnesco/ns1:ListOfFiles) > 0 and $SFTP_CheckInnesco/ns1:Status = &quot;OK&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($SFTP_CheckInnesco/ns1:ListOfFiles) > 0 and $SFTP_CheckInnesco/ns1:Status = "OK"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SFTP_CheckInnescoCRMRetailToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SFTP_Host&quot;/>&lt;xsl:param name=&quot;SFTP_Port&quot;/>&lt;xsl:param name=&quot;SFTP_User&quot;/>&lt;xsl:param name=&quot;SFTP_Password&quot;/>&lt;xsl:param name=&quot;FilePathTappo&quot;/>&lt;xsl:template name=&quot;SFTP_CheckInnesco-input&quot; match=&quot;/&quot;>&lt;tns:Input_SFTP_DirDetail>&lt;tns:Credentials>&lt;tns:Host>&lt;xsl:value-of select=&quot;$SFTP_Host&quot;/>&lt;/tns:Host>&lt;tns:User>&lt;xsl:value-of select=&quot;$SFTP_User&quot;/>&lt;/tns:User>&lt;tns:Password>&lt;xsl:value-of select=&quot;$SFTP_Password&quot;/>&lt;/tns:Password>&lt;tns:Port>&lt;xsl:value-of select=&quot;$SFTP_Port&quot;/>&lt;/tns:Port>&lt;/tns:Credentials>&lt;tns:RequestType>&lt;tns:ListOfFilesDetails>&lt;tns:DirectoryPath>&lt;xsl:value-of select=&quot;$FilePathTappo&quot;/>&lt;/tns:DirectoryPath>&lt;tns:FileExtensionToFilter>&lt;xsl:value-of select=&quot;'.TAPPO'&quot;/>&lt;/tns:FileExtensionToFilter>&lt;/tns:ListOfFilesDetails>&lt;/tns:RequestType>&lt;/tns:Input_SFTP_DirDetail>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="SFTP.STFP_DirDetail" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="113b209a-1094-4b2d-83ee-68bc2021368c">
                <bpws:targets>
                    <bpws:target linkName="Iterate1ToExit"/>
                    <bpws:target linkName="SFTP_CheckInnescoCRMRetailToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:scope name="Iterate1" tibex:group="iterate" tibex:xpdlId="c8f2f00d-c4a2-4287-aa04-f7e6a90fb8d5">
                <bpws:targets>
                    <bpws:target linkName="SFTP_CheckInnescoCRMRetailToIterate1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Iterate1ToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence1" tibex:group="iterate">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate1"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$SFTP_CheckInnesco/ns1:ListOfFiles" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($SFTP_CheckInnesco/ns1:ListOfFiles)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope1">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns1:Iterate1_Current_Element_ListOfFiles"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow2">
                                <bpws:links>
                                    <bpws:link
                                    name="Track_CRMRetail_FilesToGroupEnd1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart1ToAssign" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="SetSystemFromNameToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Track_CRMRetail_FilesToCallProcess" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="CallProcessToGroupEnd1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToTrack_CRMRetail_Files" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart1"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="b77145b1-9c60-4794-96d2-a7f79e28328a" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToAssign"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($SFTP_CheckInnesco/ns1:ListOfFiles)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd1"
