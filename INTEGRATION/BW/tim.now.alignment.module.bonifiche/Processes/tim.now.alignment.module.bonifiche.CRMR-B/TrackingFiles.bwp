                                    outputVariable="System"
                                    tibex:xpdlId="f5be0fc4-221c-4cdb-8c0f-06c50d23bbed" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SetSystemFromNameToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (contains($currentElement/ns1:FileName, '_CRMB')) then 'CRMB'&#xd;&#xa;else if (contains($currentElement/ns1:FileName, '_CRMR')) then 'CRMR'&#xd;&#xa;else 'ERROR FIND SYSTEM'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
