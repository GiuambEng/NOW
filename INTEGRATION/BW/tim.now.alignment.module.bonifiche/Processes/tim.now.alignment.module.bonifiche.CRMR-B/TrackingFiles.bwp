                        <element maxOccurs="1" minOccurs="1" name="Size"
                            nillable="false" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="LastModified" nillable="false" type="string"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
