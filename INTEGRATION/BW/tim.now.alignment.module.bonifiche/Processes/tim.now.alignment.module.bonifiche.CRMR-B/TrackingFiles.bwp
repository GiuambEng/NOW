                                    subProcessName="tim.now.alignment.shared_library.ReadFile_SFTPMode.GestioneLetturaTracciamento" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="if (contains($currentElement/ns1:FileName, '_CRMB')) then 'CRMB'&#xd;&#xa;else if (contains($currentElement/ns1:FileName, '_CRMR')) then 'CRMR'&#xd;&#xa;else 'ERROR FIND SYSTEM'"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="System"
