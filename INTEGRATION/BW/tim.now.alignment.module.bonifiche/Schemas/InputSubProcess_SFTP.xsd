<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/InputSubProcess_SFTP" xmlns:tns="http://www.example.org/InputSubProcess_SFTP" elementFormDefault="qualified">
<element name="SFTP_Input">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="FileToBeSend" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="Directory" type="string"/>
                <element name="Credentials">
    				<complexType>
    					<sequence>
				   			<element maxOccurs="1" minOccurs="0" name="Host" type="string"/>
				   			<element maxOccurs="1" minOccurs="0" name="Port" type="int"/>
				   			<element maxOccurs="1" minOccurs="0" name="User" type="string"/>
				   			<element maxOccurs="1" minOccurs="0" name="Password" type="string"/>
				   			
                        </sequence>
    				</complexType>
    			</element>
            </sequence>
    	</complexType>
    </element>
    
    <element name="SFTP_Output">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="Status" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="Message" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="Dir" type="string"/>
    		</sequence>
    	</complexType>
    </element>










 <element name="Output_SFTP_DirDetail">
    	<complexType>
    		<sequence>
    			<element name="Status" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element maxOccurs="unbounded" minOccurs="0"
    				name="ListOfFiles">
    				<complexType>
    					<sequence>
    						<element name="FileName" type="string" maxOccurs="1" minOccurs="0"/>
    						<element name="FullName" type="string" maxOccurs="1" minOccurs="0"/>
    						<element name="Size" type="string" maxOccurs="1" minOccurs="0"/>
    						<element name="LastModified" type="string" maxOccurs="1" minOccurs="0"/>
    					</sequence>
    				</complexType>
    			</element>

    			<element name="Message" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
  </element>
</schema>