<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/CheckNomeFile" elementFormDefault="qualified" targetNamespace="http://www.example.org/CheckNomeFile">
	<element name="Input">
		<complexType>
			<sequence>
				<element minOccurs="1" name="FILE_NAME" type="string"/>
				<element minOccurs="1" name="SYSTEM" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="Output">
		<complexType>
			<sequence>
				<element minOccurs="1" name="FLUSSO" type="string"/>	
			</sequence>
		</complexType>
	</element>
	<element name="ControlDate">
		<complexType>
			<sequence>
				<element minOccurs="0" name="DateTime">
					<simpleType>
						<restriction base="string">
							<pattern value="((000[1-9])|(00[1-9][0-9])|(0[1-9][0-9]{2})|([1-9][0-9]{3}))((0[1-9])|(1[012]))((0[1-9])|([12][0-9])|(3[01]))(([01][0-9])|(2[0-3]))([0-5][0-9])([0-5][0-9])"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="Date">
					<simpleType>
						<restriction base="string">
							<pattern value="((000[1-9])|(00[1-9][0-9])|(0[1-9][0-9]{2})|([1-9][0-9]{3}))((0[1-9])|(1[012]))((0[1-9])|([12][0-9])|(3[01]))"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="CheckFile">
		<complexType>
			<sequence>
				<element minOccurs="0" name="NomeFile" type="string" maxOccurs="unbounded" />
				<element minOccurs="0" name="NomeFileTappo" type="string" maxOccurs="unbounded" />
				<element minOccurs="0" name="Check_Esistenza" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="WorkFile">
		<complexType>
			<sequence>
				<element name="File" minOccurs="0">
					<complexType>
						<sequence>
							<element minOccurs="0" name="NomeFile" type="string"/>
							<element minOccurs="0" name="Check_Esistenza" type="string"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
		<element name="File_Tappo">
		<complexType>
			<sequence>
				<element name="FileTappo" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element minOccurs="0" name="Check_CoerenzaTappo" type="string"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>
