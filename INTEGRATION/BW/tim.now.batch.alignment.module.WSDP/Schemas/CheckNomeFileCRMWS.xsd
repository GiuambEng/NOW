<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/CheckNomeFileCRMWS" xmlns:tns="http://www.example.org/CheckNomeFileCRMWS" elementFormDefault="qualified">
<element name="Input">
<complexType>
<sequence>
		<element name="FILE_NAME" minOccurs="1" type="string"></element>
	
</sequence>
</complexType>
</element>
<element name="Output">
<complexType>
<sequence>
		<element name="FLUSSO" minOccurs="1" type="string"></element>	
</sequence>
</complexType>
</element>
<element name="ControlDate" >
<complexType>
<sequence>
		<element name="DateTime" minOccurs="0" >
		 <simpleType>
        <restriction base="string">
         <pattern
          value="((000[1-9])|(00[1-9][0-9])|(0[1-9][0-9]{2})|([1-9][0-9]{3}))((0[1-9])|(1[012]))((0[1-9])|([12][0-9])|(3[01]))(([01][0-9])|(2[0-3]))([0-5][0-9])([0-5][0-9])" />
        </restriction>
       </simpleType>
       </element>
       <element name="Date" minOccurs="0" >
		 <simpleType>
        <restriction base="string">
         <pattern
          value="((000[1-9])|(00[1-9][0-9])|(0[1-9][0-9]{2})|([1-9][0-9]{3}))((0[1-9])|(1[012]))((0[1-9])|([12][0-9])|(3[01]))" />
        </restriction>
       </simpleType>
       </element>
       <element name="DateTime_SLA" minOccurs="0" >
		 <simpleType>
        <restriction base="string">
         <pattern
          value="((0[1-9])|([12][0-9])|(3[01]))-((0[1-9])|(1[012]))-((000[1-9])|(00[1-9][0-9])|(0[1-9][0-9]{2})|([1-9][0-9]{3}))_(([01][0-9])|(2[0-3]))_([0-5][0-9])_([0-5][0-9])" />
        </restriction>
       </simpleType>
       </element>
</sequence>
</complexType>
</element>
</schema>