                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.AnagraficaKIT_ADR_CAR_SubProcess&quot; xmlns:tns4=&quot;http://www.example.org/tim.now.AnagraficaKIT_ADR_CAR_Staging&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;OK_ELAB_STAG&quot;/>&lt;xsl:param name=&quot;KO_ELAB_STAG&quot;/>&lt;xsl:template name=&quot;Var_InputStaging&quot; match=&quot;/&quot;>&lt;tns4:AnagraficaKIT_ADR_CAR_dettaglio>&lt;xsl:if test=&quot;$currentElement/tns1:ID_KIT_AREA_CAR&quot;>&lt;tns4:ID_KIT_AREA_CAR>&lt;xsl:value-of select=&quot;$currentElement/tns1:ID_KIT_AREA_CAR&quot;/>&lt;/tns4:ID_KIT_AREA_CAR>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:CODICE_KIT&quot;>&lt;tns4:CODICE_KIT>&lt;xsl:value-of select=&quot;$currentElement/tns1:CODICE_KIT&quot;/>&lt;/tns4:CODICE_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:STATO&quot;>&lt;tns4:STATO>&lt;xsl:value-of select=&quot;$currentElement/tns1:STATO&quot;/>&lt;/tns4:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:ID_ADR_CRMWS&quot;>&lt;tns4:ID_ADR_CRMWS>&lt;xsl:value-of select=&quot;$currentElement/tns1:ID_ADR_CRMWS&quot;/>&lt;/tns4:ID_ADR_CRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:TIPOLOGIA_ADR&quot;>&lt;tns4:TIPOLOGIA_ADR>&lt;xsl:value-of select=&quot;$currentElement/tns1:TIPOLOGIA_ADR&quot;/>&lt;/tns4:TIPOLOGIA_ADR>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:NOME_AGGREGATO&quot;>&lt;tns4:NOME_AGGREGATO>&lt;xsl:value-of select=&quot;$currentElement/tns1:NOME_AGGREGATO&quot;/>&lt;/tns4:NOME_AGGREGATO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:CODICE_CAR&quot;>&lt;tns4:CODICE_CAR>&lt;xsl:value-of select=&quot;$currentElement/tns1:CODICE_CAR&quot;/>&lt;/tns4:CODICE_CA