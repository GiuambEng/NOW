                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns1="http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/" xmlns:ns2="http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.example.org/VerificaLavorabilita" xmlns:tns2="http://www.example.org/CreateFileID" version="2.0"&gt;&lt;xsl:param name="VerificaLavorabilita"/&gt;&lt;xsl:param name="InsertLogger"/&gt;&lt;xsl:param name="TipoSeparatore"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;ns1:Conta_Request&gt;&lt;part1&gt;&lt;ns2:contaRecord_Input&gt;&lt;xsl:variable name="varQueue" select="if(contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;ANAGRAFICAKITVLANADRCAR_WSDP_TO_NOW_&amp;quot;)) then 'allineamentoAnagraficaKIT_ADR_CAR.WSDP'&amp;#xD;&amp;#xA;else if(contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;ANAGRAFICAKITVLAN_WSDP_TO_NOW_&amp;quot;)) then 'allineamentoAnagraficaKIT_VLAN.WSDP'&amp;#xD;&amp;#xA;else 'NoQueueFound'"/&gt;&lt;ns2:in&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:SOURCE_FILE"/&gt;&lt;/ns2:in&gt;&lt;ns2:TipoSeparatore&gt;&lt;xsl:value-of select="$TipoSeparatore"/&gt;&lt;/ns2:TipoSeparatore&gt;&lt;ns2:Flusso&gt;&lt;xsl:value-of select="'AnagraficheWSDP'"/&gt;&lt;/ns2:Flusso&gt;&lt;xsl:if test="$InsertLogger/tns2:ID_FILE"&gt;&lt;ns2:ID_FILE&gt;&lt;xsl:value-of select="$InsertLogger/tns2:ID_FILE"/&gt;&lt;/ns2:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:SOURCE_FILE"&gt;&lt;ns2:FULLNAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:SOURCE_FILE"/&gt;&lt;/ns2:FULLNAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:NOME_FILE"&gt;&lt;ns2:FILENAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:NOME_FILE"/&gt;&lt;/ns2:FILENAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InsertLogger/tns2:ID_ESEC"&gt;&lt;ns2:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertLogger/tns2:ID_ESEC"/&gt;&lt;/ns2:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InsertLogger/tns2:COD_PROCSO_FILE"&gt;&lt;ns2:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertLogger/tns2:COD_PROCSO_FILE"/&gt;&lt;/ns2:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:ID_TRACK"&gt;&lt;ns2:ID_TRACK&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:ID_TRACK"/&gt;&lt;/ns2:ID_TRACK&gt;&lt;/xsl:if&gt;&lt;ns2:NomeProcesso&gt;&lt;xsl:value-of select="$varQueue"/&gt;&lt;/ns2:NomeProcesso&gt;&lt;/ns2:contaRecord_Input&gt;&lt;/part1&gt;&lt;/ns1:Conta_Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns2=&quot;http://www.example.org/CreateFileID&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertLogger&quot;/>&#xa;    &lt;xsl:param name=&quot;TipoSeparatore&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:contaRecord_Input>&#xa;            &lt;xsl:variable name=&quot;varQueue&quot; select=&quot;if(contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;ANAGRAFICAKITVLANADRCAR_WSDP_TO_NOW_&amp;quot;)) then 'allineamentoAnagraficaKIT_ADR_CAR.WSDP'&amp;#xD;&amp;#xA;else if(contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;ANAGRAFICAKITVLAN_WSDP_TO_NOW_&amp;quot;)) then 'allineamentoAnagraficaKIT_VLAN.WSDP'&amp;#xD;&amp;#xA;else 'NoQueueFound'&quot;/>&#xa;            &lt;ns2:in>&#xa;                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;/>&#xa;            &lt;/ns2:in>&#xa;            &lt;ns2:TipoSeparatore>&#xa;                &lt;xsl:value-of select=&quot;$TipoSeparatore&quot;/>&#xa;            &lt;/ns2:TipoSeparatore>&#xa;            &lt;ns2:Flusso>&#xa;                &lt;xsl:value-of select=&quot;'AnagraficheWSDP'&quot;/>&#xa;            &lt;/ns2:Flusso>&#xa;            &lt;xsl:if test=&quot;$InsertLogger/tns2:ID_FILE&quot;>&#xa;                &lt;ns2:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertLogger/tns2:ID_FILE&quot;/>&#xa;                &lt;/ns2:ID_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;>&#xa;                &lt;ns2:FULLNAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;/>&#xa;                &lt;/ns2:FULLNAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;>&#xa;                &lt;ns2:FILENAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;/>&#xa;                &lt;/ns2:FILENAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertLogger/tns2:ID_ESEC&quot;>&#xa;                &lt;ns2:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertLogger/tns2:ID_ESEC&quot;/>&#xa;                &lt;/ns2:ID_ESEC_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertLogger/tns2:COD_PROCSO_FILE&quot;>&#xa;                &lt;ns2:COD_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertLogger/tns2:COD_PROCSO_FILE&quot;/>&#xa;                &lt;/ns2:COD_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&#xa;                &lt;ns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;/>&#xa;                &lt;/ns2:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns2:NomeProcesso>&#xa;                &lt;xsl:value-of select=&quot;$varQueue&quot;/>&#xa;            &lt;/ns2:NomeProcesso>&#xa;        &lt;/ns2:contaRecord_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToInvoke"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InvokeToGroupEnd"/>
                                    </bpws:sources>
                                    <bpws:correlations/>
                                </bpws:invoke>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:exit name="Exit1" tibex:xpdlId="998e008a-7db9-4e21-a331-775e7ff801e0">
                <bpws:targets>
                    <bpws:target linkName="IterateToExit1"/>
                    <bpws:target linkName="JDBCQueryToExit1"/>
                </bpws:targets>
            </bpws:exit>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
