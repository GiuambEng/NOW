                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns3=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;PathFileError&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:InputData>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;>&#xa;                &lt;tns3:FullPathOrigine>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;/>&#xa;                &lt;/tns3:FullPathOrigine>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns3:FolderDestinazione>&#xa;                &lt;xsl:value-of select=&quot;$PathFileError&quot;/>&#xa;            &lt;/tns3:FolderDestinazione>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;>&#xa;                &lt;tns3:NomeFile>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;/>&#xa;                &lt;/tns3:NomeFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&#xa;                &lt;tns3:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;/>&#xa;                &lt;/tns3:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns3:LogInput>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns3:LogName>&#xa;            &lt;/tns3:LogInput>&#xa;        &lt;/tns3:InputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
