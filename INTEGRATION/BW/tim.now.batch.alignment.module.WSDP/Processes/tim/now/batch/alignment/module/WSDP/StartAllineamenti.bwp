                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/CreateFileID&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:template name=&quot;InsertLogger-input&quot; match=&quot;/&quot;>&lt;tns2:Input>&lt;tns2:DataIn>&lt;tns2:Insert>&lt;tns2:InputFile>&lt;xsl:variable name=&quot;varCodice&quot; select=&quot;if(contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;ANAGRAFICAKITVLANADRCAR_WSDP_TO_NOW_&amp;quot;)) then 'ID445'&amp;#xD;&amp;#xA;else if(contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;ANAGRAFICAKITVLAN_WSDP_TO_NOW_&amp;quot;)) then 'ID446'&amp;#xD;&amp;#xA;else 'NoCodeFound'&quot;/>&lt;tns2:CODICE_INTERFACCIA>&lt;xsl:value-of select=&quot;$varCodice&quot;/>&lt;/tns2:CODICE_INTERFACCIA>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;>&lt;tns2:NOME_FILE>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;/>&lt;/tns2:NOME_FILE>&lt;/xsl:if>&lt;tns2:DATA_FILE>&lt;xsl:value-of select=&quot;substring($VerificaLavorabilita/tns1:DATA_FILE,1, 10)&quot;/>&lt;/tns2:DATA_FILE>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:FILE_SIZE&quot;>&lt;tns2:SIZE>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:FILE_SIZE&quot;/>&lt;/tns2:SIZE>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&lt;tns2:ID_TRACK>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;/>&lt;/tns2:ID_TRACK>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;>&lt;tns2:FULL_NAME>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;/>&lt;/tns2:FULL_NAME>&lt;/xsl:if>&lt;tns2:FLAG_CONTENUTO_FILE>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns2:FLAG_CONTENUTO_FILE>&lt;/tns2:InputFile>&lt;/tns2:Insert>&lt;/tns2:DataIn>&lt;tns2:LogElement>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;/tns2:LogElement>&lt;/tns2:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
