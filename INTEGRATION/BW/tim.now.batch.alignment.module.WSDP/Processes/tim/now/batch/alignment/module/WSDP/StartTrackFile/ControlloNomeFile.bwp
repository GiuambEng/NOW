    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/CheckNomeFileCRMWS"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="tns:Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="tns:Output" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="DataLength" type="xsd:string"/>
        <bpws:variable element="tns:ControlDate" name="Date"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable name="Flusso" type="xsd:string"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="CheckFileNameToDate" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="DateToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartToCheckFlow" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckFileNameToEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="DateToEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CheckDateToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckDateToAssign" tibex:linkType="ERROR"/>
                <bpws:link name="AssignToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="e5cb44b8-7b66-43dc-a07f-82f8462d6989"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCheckFlow">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="e053a2aa-ae1b-45b1-9923-aba219f360ac" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckFileNameToEnd"/>
                        <bpws:target linkName="DateToEnd"/>
                        <bpws:target linkName="CheckDateToEnd"/>
                        <bpws:target linkName="AssignToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CheckNomeFile&quot; xmlns:tns1=&quot;http://www.example.org/CheckNomeFileCRMWS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DataLength&quot;/>&lt;xsl:param name=&quot;Flusso&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns1:Output>&lt;xsl:choose>&lt;xsl:when test=&quot;$DataLength='ERROR' or$Flusso='ERROR'&quot;>&lt;tns1:FLUSSO>&lt;xsl:value-of select=&quot;if($DataLength='ERROR') then 'ERROR_DATA_FILE' else 'ERROR_NOME_FILE'&quot;/>&lt;/tns1:FLUSSO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:FLUSSO>&lt;xsl:value-of select=&quot;$Flusso&quot;/>&lt;/tns1:FLUSSO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="DataLength"
                    name="DateLength" outputVariable="DataLength"
                    tibex:xpdlId="cb856310-7b09-4d4b-b4d3-5e7ba87be361" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckFileNameToDate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DateToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$DataLength='OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$DataLength='OK']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="DateToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if ($Flusso=('Allineamento Anagrafica COW','Allineamento OLO Prevalente')) then &#xd;&#xa;&#x9;if(string-length(substring-before(tokenize($Start/tns:FILE_NAME, &quot;_&quot;)[6], &quot;.&quot;))=8) then 'OK' else 'ERROR'&#xd;&#xa;else if ($Flusso='Allineamento Contatto OLO') then &#xd;&#xa;&#x9;if(string-length(substring-before(tokenize($Start/tns:FILE_NAME, &quot;_&quot;)[5], &quot;.&quot;))=8) then 'OK' else 'ERROR'&#x9;&#xd;&#xa;&#x9;else if ($Flusso='Allineamento SLA') then &#xd;&#xa;if( string-length(substring($Start/tns:FILE_NAME, 9,19))= 19) then 'OK' else 'ERROR'&#xd;&#xa;else if ($Flusso='POSTOOPERATORE_CRMB') then &#xd;&#xa;&#x9;if(string-length(substring-before(tokenize($Start/tns:FILE_NAME, &quot;_&quot;)[5], &quot;.&quot;))=8) then 'OK' else 'ERROR'&#xd;&#xa;else if ($Flusso='Allineamento Referenti Simmetrici') then &#xd;&#xa;&#x9;if(string-length(substring-before(tokenize($Start/tns:FILE_NAME, &quot;_&quot;)[7], &quot;.&quot;))=8) then 'OK' else 'ERROR'&#xd;&#xa;&#x9;&#x9; else &#xd;&#xa;&#x9;if(string-length(substring-before(tokenize($Start/tns:FILE_NAME, &quot;_&quot;)[5], &quot;.&quot;))=14) then 'OK' else 'ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="DataLength" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Date"
                    name="CheckDate" outputVariable="Date"
                    tibex:xpdlId="d6a6f214-de79-475b-af84-aafd296fcb83" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DateToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckDateToEnd"/>
                        <bpws:source linkName="CheckDateToAssign"
                            tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/CheckNomeFileCRMWS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Flusso&quot;/>&lt;xsl:template name=&quot;Date&quot; match=&quot;/&quot;>&lt;tns1:ControlDate>&lt;xsl:if test=&quot;$Flusso=('Allineamento Anagrafica OLO','Allineamento Anagrafica KIT ATM','Allineamento Anagrafica VLAN','Allineamento Anagrafica VP',  'Allineamento Contratto')&quot;>&lt;tns1:DateTime>&lt;xsl:value-of select=&quot;substring-before(tokenize($Start/tns1:FILE_NAME, &amp;quot;_&amp;quot;)[5], &amp;quot;.&amp;quot;)&quot;/>&lt;/tns1:DateTime>&lt;/xsl:if>&lt;xsl:if test=&quot;$Flusso=('Allineamento Anagrafica COW','Allineamento OLO Prevalente','Allineamento Contatto OLO', 'Allineamento Referenti Simmetrici','POSTOOPERATORE_CRMB')&quot;>&lt;tns1:Date>&lt;xsl:value-of select=&quot;if ($Flusso=('Allineamento Contatto OLO','POSTOOPERATORE_CRMB'))  then&amp;#xD;&amp;#xA;substring-before(tokenize($Start/tns1:FILE_NAME, &amp;quot;_&amp;quot;)[5], &amp;quot;.&amp;quot;) &amp;#xD;&amp;#xA;else if ($Flusso='Allineamento Referenti Simmetrici')  then&amp;#xD;&amp;#xA;substring-before(tokenize($Start/tns1:FILE_NAME, &amp;quot;_&amp;quot;)[7], &amp;quot;.&amp;quot;) &amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;substring-before(tokenize($Start/tns1:FILE_NAME, &amp;quot;_&amp;quot;)[6], &amp;quot;.&amp;quot;) &quot;/>&lt;/tns1:Date>&lt;/xsl:if>&lt;xsl:if test=&quot;$Flusso= 'Allineamento SLA'&quot;>&lt;tns1:DateTime_SLA>&lt;xsl:value-of select=&quot;substring($Start/tns1:FILE_NAME, 9,19)&quot;/>&lt;/tns1:DateTime_SLA>&lt;/xsl:if>&lt;/tns1:ControlDate>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Date" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Flusso"
                    name="CheckFlow" outputVariable="Flusso"
                    tibex:xpdlId="5d1136e7-86ac-4f8a-a48c-1bf818155991" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCheckFlow"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckFileNameToDate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckFileNameToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Flusso='ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Flusso='ERROR']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(contains($Start/tns:FILE_NAME, &quot;ANAGRAFICAKITVLANADRCAR_WSDP_TO_NOW_&quot;)) then 'ANAGRAFICAKITADRCARWSDP' &#xd;&#xa;else if(contains($Start/tns:FILE_NAME, &quot;ANAGRAFICAKITVLAN_WSDP_TO_NOW_&quot;)) then 'ANAGRAFICAKITVLANWSDP' &#xd;&#xa;else 'ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Flusso" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="DataLength"
                    name="AssignError" outputVariable="DataLength"
                    tibex:xpdlId="660ba4c5-c279-4b6f-85f9-1e3790687036" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckDateToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="'ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="DataLength" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
