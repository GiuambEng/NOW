            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6c09e2a7-e631-425f-bde9-2058d48a70f2+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.com/log/InsertInizialeStaging/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Insert_Staging-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Start/ns:Input&quot;>&lt;Record>&lt;COD_DISTR>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:COD_DISTR)&quot;>&lt;xsl:value-of select=&quot;ns:COD_DISTR&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_DISTR>&lt;COD_PROV>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:COD_PROV)&quot;>&lt;xsl:value-of select=&quot;ns:COD_PROV&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_PROV>&lt;DESCR_PROV>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:DESCR_PROV)&quot;>&lt;xsl:value-of select=&quot;ns:DESCR_PROV&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCR_PROV>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal(ns:ID_FILE)&quot;/>&lt;/ID_FILE_PROCSTO_INPUT>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:decimal(ns:ID_STATO_ELAB_STAG)&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;ISTAT_PROV>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:ISTAT_PROV)&quot;>&lt;xsl:value-of select=&quot;ns:ISTAT_PROV&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ISTAT_PROV>&lt;NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:decimal(ns:NUMERO_RECD)&quot;/>&lt;/NUMERO_RECD>&lt;SIGLA_PROV>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:SIGLA_PROV)&quot;>&lt;xsl:value-of select=&quot;ns:SIGLA_PROV&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SIGLA_PROV>&lt;TMSP_INSMTO>&lt;xsl:value-of select=&quot;xsd:dateTime(ns:TMSP_INSMTO)&quot;/>&lt;/TMSP_INSMTO>&lt;TIPOLG_OPERAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:FLAG_OPERAZIONE)&quot;>&lt;xsl:value-of select=&quot;ns:FLAG_OPERAZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIPOLG_OPERAZIONE>&lt;CONTENUTO_RECD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:CONTENUTO_RECD)&quot;>&lt;xsl:value-of select=&quot;ns:CONTENUTO_RECD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONTENUTO_RECD>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Insert_Staging-input"
                    name="Insert_Staging"
