                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:while name="while" tibex:counterName="index">
                    <tibex:DesignExpression>
                        <tibex:expression
                            expression="$index &lt;= (($Invoke/part1/ns20:contaRecord_Output/ns20:NumeroRecord )div $Passo) +1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= (($Invoke.part1/ns20:NumeroRecord )div $Passo) +1]]></bpws:condition>
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="EmptyToIns" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            <bpws:link name="EmptyToGroupEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
