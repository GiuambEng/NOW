                                    <bpws:transitionCondition><![CDATA[(($index = (($Invoke.part1/ns20:NumeroRecord)) div $Passo +1)) and (count($Noval_Detail_Last/Rows/tns1:AnagraficaProvince_Noval_dettaglio)=0)]]></bpws:transitionCondition>
                                </bpws:source>
