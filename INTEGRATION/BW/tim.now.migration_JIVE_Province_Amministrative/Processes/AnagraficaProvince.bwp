                        </bpws:empty>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/log/InsertInizialeStaging/&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.AnagraficaProvince.noval&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ReadFile&quot;/>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Noval_Detail_Last&quot;/>&lt;xsl:param name=&quot;Noval_Details&quot;/>&lt;xsl:param name=&quot;FileRead&quot;/>&lt;xsl:param name=&quot;Offset_PROVINCE&quot;/>&lt;xsl:param name=&quot;Invoke_ProcessLogger&quot;/>&lt;xsl:template name=&quot;Ins-input&quot; match=&quot;/&quot;>&lt;ns:root>&lt;ns:FileInfo>&lt;ns:NomeFile>&lt;xsl:value-of select=&quot;$ReadFile/tns:FullName&quot;/>&lt;/ns:NomeFile>&lt;ns:StartRecord>&lt;xsl:value-of select=&quot;($index - 1) * $Passo + 2&quot;/>&lt;/ns:StartRecord>&lt;ns:Passo>&lt;xsl:value-of select=&quot;$Passo&quot;/>&lt;/ns:Passo>&lt;/ns:FileInfo>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Noval_Detail_Last/Rows/tns1:AnagraficaProvince_Noval_dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$Noval_Details/Rows/tns1:AnagraficaProvince_Noval_dettaglio&quot;>&lt;ns:Input>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Offset_PROVINCE * ($index -1)) + position())&quot;/>&lt;ns:COD_DISTR>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_DISTRETTO)&quot;/>&lt;/ns:COD_DISTR>&lt;ns:COD_PROV>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_PROVINCIA)&quot;/>&lt;/ns:COD_PROV>&lt;ns:DESCR_PROV>&lt;xsl:value-of select=&quot;tib:trim(tns1:DESCRIZIONE)&quot;/>&lt;/ns:DESCR_PROV>&lt;ns:FLAG_OPERAZIONE>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPERAZIONE)&quot;/>&lt;/ns:FLAG_OPERAZIONE>&lt;ns:NOME_FILE>&lt;xsl:value-of select=&quot;$FileRead/fileInfo/fileName&quot;/>&lt;/ns:NOME_FILE>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;'2'&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:ISTAT_PROV>&lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_PROV)&quot;/>&lt;/ns:ISTAT_PROV>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var&quot;/>&lt;/ns:NUMERO_RECD>&lt;ns:SIGLA_PROV>&lt;xsl:value-of select=&quot;tib:trim(tns1:SIGLA_PROV)&quot;/>&lt;/ns:SIGLA_PROV>&lt;ns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INSMTO>&lt;xsl:if test=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;/>&lt;/ns:ID_FILE>&lt;/xsl:if>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;concat(tns1:CODICE_PROVINCIA,tns1:ISTAT_PROV,tns1:DESCRIZIONE,tns1:SIGLA_PROV,tns1:COD_DISTRETTO,tns1:FLAG_OPERAZIONE)&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/ns:Input>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$Noval_Detail_Last/Rows/tns1:AnagraficaProvince_Noval_dettaglio&quot;>&lt;ns:Input>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Offset_PROVINCE * ($index -1)) + position())&quot;/>&lt;ns:COD_DISTR>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_DISTRETTO)&quot;/>&lt;/ns:COD_DISTR>&lt;ns:COD_PROV>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_PROVINCIA)&quot;/>&lt;/ns:COD_PROV>&lt;ns:DESCR_PROV>&lt;xsl:value-of select=&quot;tib:trim(tns1:DESCRIZIONE)&quot;/>&lt;/ns:DESCR_PROV>&lt;xsl:if test=&quot;tns1:FLAG_OPERAZIONE&quot;>&lt;ns:FLAG_OPERAZIONE>&lt;xsl:value-of select=&quot;tns1:FLAG_OPERAZIONE&quot;/>&lt;/ns:FLAG_OPERAZIONE>&lt;/xsl:if>&lt;ns:NOME_FILE>&lt;xsl:value-of select=&quot;$FileRead/fileInfo/fileName&quot;/>&lt;/ns:NOME_FILE>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;'2'&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:ISTAT_PROV>&lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_PROV)&quot;/>&lt;/ns:ISTAT_PROV>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var1&quot;/>&lt;/ns:NUMERO_RECD>&lt;ns:SIGLA_PROV>&lt;xsl:value-of select=&quot;tib:trim(tns1:SIGLA_PROV)&quot;/>&lt;/ns:SIGLA_PROV>&lt;ns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INSMTO>&lt;xsl:if test=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;/>&lt;/ns:ID_FILE>&lt;/xsl:if>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;concat(tns1:CODICE_PROVINCIA,tns1:ISTAT_PROV,tns1:DESCRIZIONE,tns1:SIGLA_PROV,tns1:COD_DISTRETTO,tns1:FLAG_OPERAZIONE)&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/ns:Input>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:root>&lt;/xsl:template>&lt;/xsl:stylesheet>"
