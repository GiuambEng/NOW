                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_PathFileError&quot;/>&lt;xsl:param name=&quot;ReadFile&quot;/>&lt;xsl:template name=&quot;RenameFile_Error-input&quot; match=&quot;/&quot;>&lt;tns:RenameActivityConfig>&lt;xsl:if test=&quot;$ReadFile/tns1:FullName&quot;>&lt;fromFileName>&lt;xsl:value-of select=&quot;$ReadFile/tns1:FullName&quot;/>&lt;/fromFileName>&lt;/xsl:if>&lt;toFileName>&lt;xsl:value-of select=&quot;$Var_PathFileError&quot;/>&lt;/toFileName>&lt;/tns:RenameActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>"
