                                <bpws:source linkName="EmptyToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(($index = (($Invoke/part1/ns20:contaRecord_Output/ns20:NumeroRecord)) div $Passo +1)) and (count($Noval_Detail_Last/Rows/tns1:AnagraficaProvince_Noval_dettaglio)=0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
