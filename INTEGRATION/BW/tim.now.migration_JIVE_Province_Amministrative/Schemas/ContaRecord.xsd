<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/ContaRecord" xmlns:tns="http://www.example.org/ContaRecord" elementFormDefault="qualified">

    <element name="ContaR">
    	<complexType>
    		<sequence>
    			<element name="Record" type="string"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Conta">
    	<complexType>
    		<sequence>
    			<element ref="tns:ContaR" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>