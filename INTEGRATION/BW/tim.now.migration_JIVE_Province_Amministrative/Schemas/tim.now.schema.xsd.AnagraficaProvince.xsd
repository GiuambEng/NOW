<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AnagraficaProvince" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/AnagraficaProvince">


    <element name="AnagraficaProvince">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:AnagraficaProvince_dettaglio">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="AnagraficaProvince_dettaglio">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1"
    				name="CODICE_PROVINCIA">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="11"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="ISTAT_PROV">
    			<simpleType>
    			<restriction base="string">
    			<maxLength value="3"></maxLength>
    			</restriction>
    			</simpleType>
        </element>
    			<element maxOccurs="1" minOccurs="1" name="DESCRIZIONE">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="80"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="SIGLA_PROV">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="COD_DISTRETTO">
    			<simpleType>
    			<restriction base="string">
    			<maxLength value="10"></maxLength>
    			</restriction>
    			</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="FLAG_OPERAZIONE">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"/>
    						<enumeration value="I"/>
    						<enumeration value="U"/>
    						<enumeration value="Z"/>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>
