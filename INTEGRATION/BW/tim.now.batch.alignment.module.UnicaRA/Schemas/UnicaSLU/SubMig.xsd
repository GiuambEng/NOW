<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
targetNamespace="www.tim.now.subProcessMigrzioneSLU"
xmlns="www.tim.now.subProcessMigrzioneSLU"
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
	<xs:element name="Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element name='InfoFile'>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="NomeFile" type="xs:string" minOccurs="1"/>
							<xs:element name="StartRecord" type="xs:integer" minOccurs="1"/>
							<xs:element name="Passo" type="xs:integer" minOccurs="1"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="COD_PROCSO_FILE" type="xs:string" minOccurs="0"/>
				<xs:element name="ID_FILE" type="xs:int" minOccurs="0"/>
				<xs:element name="ID_ESEC_PROCSO_FILE" type="xs:int" minOccurs="0"/>
				<xs:element name="Record" minOccurs="0" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="CONTENUTO_RECD" type="xs:string" minOccurs="0"/>
							<xs:element name="DEC_ATTIVAZIONE" type="xs:string" minOccurs="0"/>
							<xs:element name="DEC_CESSAZIONE" type="xs:string" minOccurs="0"/>
							<xs:element name="ID_RISORSA_UNICA_RA" type="xs:string" minOccurs="0"/>
							<xs:element name="ID_FILE_PROCSTO_INPUT" type="xs:integer" minOccurs="0"/>
							<xs:element name="ID_STATO_ELAB_STAG" type="xs:integer" minOccurs="0"/>
							<xs:element name="NUMERO_RECD" type="xs:integer" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>