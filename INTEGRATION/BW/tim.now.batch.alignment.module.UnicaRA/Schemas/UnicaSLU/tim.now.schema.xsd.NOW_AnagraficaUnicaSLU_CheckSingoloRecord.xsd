<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/tim.now.schema.xsd.NOW_AnagraficaUnicaSLU_CheckSingoloRecord" xmlns:tns="http://www.example.org/tim.now.schema.xsd.NOW_AnagraficaUnicaSLU_CheckSingoloRecord" elementFormDefault="qualified">

    <element name="AnagraficaUnicaSlu_Dettaglio">
    	<complexType>
    		<sequence>
    			<element name="Tipo_record" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="2"></enumeration>
    						<maxLength value="1"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ID_RISORSA" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DEC_ATT" type="string" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			<element name="DEC_CES" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="Timestamp" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="FlagValidita" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="ID_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Numero_Record" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="AnagraficaUnicaSlu">
    	<complexType>
    		<sequence>
    			<element ref="tns:AnagraficaUnicaSlu_Dettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>
</schema>