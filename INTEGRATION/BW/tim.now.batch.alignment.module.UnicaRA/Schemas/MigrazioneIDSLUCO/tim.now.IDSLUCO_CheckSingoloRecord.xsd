<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"  targetNamespace="http://www.tim.com/NOW/xsd/AllineamentoIDSLUCO_TIM_CheckSingoloRecord"  xmlns:tns="http://www.tim.com/NOW/xsd/AllineamentoIDSLUCO_TIM_CheckSingoloRecord"  elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="IDSLUCO_TIM">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0"	ref="tns:IDSLUCO_TIM_Dettaglio"/>
			</sequence>
		</complexType>
	</element>
	<element name="IDSLUCO_TIM_Dettaglio">
		<complexType>
			<sequence>
				<element name="IDSLUCO" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="OPERATORE" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CLLI" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DATA_CONSEGNA_OLO"	type="string" maxOccurs="1" minOccurs="1"/>
				<element name="ID_RICHIESTA" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="int">
							<totalDigits value="10"/>
						</restriction>
					</simpleType>
				</element>
				<element name="COPPIA_DA" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
							<enumeration value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element name="COPPIA_A" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
							<enumeration value="500"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DATA_INVIO"  type="string" maxOccurs="1" minOccurs="1"/>
				<element name="TESTARMADIO" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="T1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Timestamp" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Numero_record" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="FlagValidita" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="string"/>				
			</sequence>
		</complexType>
	</element>
	
</schema>