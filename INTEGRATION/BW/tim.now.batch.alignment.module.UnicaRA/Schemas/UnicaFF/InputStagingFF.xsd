    </complexType>

    <complexType name="FFStaging_type">
    	<sequence>
    		<element name="InputStagingFF" type="tns:InputStagingFF_type" minOccurs="0" maxOccurs="unbounded"></element>
    	</sequence>
    </complexType>
    
    <element name="FFStaging" type="tns:FFStaging_type"></element>
</schema>