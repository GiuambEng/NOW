<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/InputStagingFF" xmlns:tns="http://www.example.org/InputStagingFF" elementFormDefault="qualified">

    <element name="InputStagingFF" type="tns:InputStagingFF_type"></element>

    <complexType name="InputStagingFF_type">
    	<sequence>
    		<element name="idRisorsa" type="string" minOccurs="0"></element>
    		<element name="idFileProcsoInput" type="int"
    			minOccurs="0">
    		</element>
    		<element name="idStatoElabStag" type="int" minOccurs="0"></element>
    		<element name="tmpInsmto" type="dateTime" minOccurs="0"></element>
