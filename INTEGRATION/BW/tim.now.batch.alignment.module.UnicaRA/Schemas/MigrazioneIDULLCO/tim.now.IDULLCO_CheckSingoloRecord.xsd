<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"  xmlns:tns="http://www.tim.com/NOW/xsd/AllineamentoIDULLCO_TIM_CheckSingoloRecord/"  targetNamespace="http://www.tim.com/NOW/xsd/AllineamentoIDULLCO_TIM_CheckSingoloRecord/" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="IDULLCO_TIM">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0"	ref="tns:IDULLCO_TIM_Dettaglio"/>
			</sequence>
		</complexType>
	</element>
	<element name="IDULLCO_TIM_Dettaglio">
		<complexType>
			<sequence>
				<element name="IDULLCO" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="OLO" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
							<enumeration value="TLC"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CLLI" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DATA_CONSEGNA_OLO"	type="string" maxOccurs="1" minOccurs="1"/>
				<element name="DATA_FINE_VALIDITA"	type="string" maxOccurs="1" minOccurs="0"/>
				<element name="DATA_INVIO" type="string"	maxOccurs="1" minOccurs="1"/>
				<element name="Nome" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="255"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DRCP" maxOccurs="1"	minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="Codice_GAT" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="6"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Tipo_Colocazione">
					<simpleType>
						<restriction base="string">
							<maxLength value="4"/>
							<enumeration value="0"/>
							<enumeration value="1"/>
							<enumeration value="2"/>
							<enumeration value="3"/>
							<enumeration value="4"/>
							<enumeration value=""/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Timestamp" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Numero_record" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="FlagValidita" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="string"/>
			</sequence>
		</complexType>
	</element>
	
</schema>