                        <bpws:source linkName="CallProcessToExit"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.alignment.module.UnicaRA.application'&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Nessuna procedura trovata per assettizzare'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:exit name="LA" tibex:xpdlId="861ec399-dd2b-49a4-825d-33f459342641">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToExit"/>
                    <bpws:target linkName="IterateToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="QueryStatoAllineamento-input"
                    name="QueryStatoAllineamento"
                    outputVariable="QueryStatoAllineamento"
                    tibex:xpdlId="279861b2-8cb6-497d-af53-832f37e81a9c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartToLogQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToLogQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($QueryStatoAllineamento/Record[STATO='CHECK_OK'])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($QueryStatoAllineamento/Record[STATO='CHECK_OK'])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="QueryStatoAllineamentoToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+279861b2-8cb6-497d-af53-832f37e81a9c+input&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;QueryStatoAllineamento-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;FLUSSO>&lt;xsl:value-of select=&quot;&amp;quot;AnagraficaSLU&amp;quot;&quot;/>&lt;/FLUSSO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT S.ID_FILE, S.ID_ESEC_PROCSO_FILE, S.SISTEMA, S.FLUSSO,&#xa;  S.COD_PROCSO_FILE, S.RECORD_TRG_OK, S.STATO, S.ID_TRACK, AL.FOLDER,&#xa;  AL.FILE_NAME&#xa;  FROM APPUSER.STATO_ALLINEAMENTI S, APPUSER.ALIGN_FILE_TRACKING AL&#xa;  WHERE S.STATO = 'CHECK_OK' AND S.FLUSSO = ? AND S.FLAG_LETTURA IS NULL&#xa;    AND AL.FLAG_LAVORATO = 'N' AND S.ID_FILE = AL.ID_FILE_INPUT&#xa;    AND (S.SISTEMA = 'UnicaRA')&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLUSSO"/>
                                    <columnMetadata
                                    columnName="ID_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_ESEC_PROCSO_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="SISTEMA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLUSSO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_PROCSO_FILE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="RECORD_TRG_OK"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="STATO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_TRACK"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FOLDER"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FILE_NAME"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Mapper-input"
                    name="Mapper" outputVariable="Mapper"
                    tibex:xpdlId="b45c9e69-986c-49b1-8a48-d2df39a66ccb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogQueryToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToIterate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Assettizzazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryStatoAllineamento&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:Assettizzazione>&lt;xsl:for-each select=&quot;$QueryStatoAllineamento/Record[STATO='CHECK_OK']&quot;>&lt;tns:Assettizzazione_Input>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;ID_FILE&quot;/>&lt;/tns:ID_FILE>&lt;xsl:if test=&quot;FLUSSO&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;FLUSSO&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;xsl:if test=&quot;SISTEMA&quot;>&lt;tns:SISTEMA>&lt;xsl:value-of select=&quot;SISTEMA&quot;/>&lt;/tns:SISTEMA>&lt;/xsl:if>&lt;tns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;ID_ESEC_PROCSO_FILE&quot;/>&lt;/tns:ID_ESEC_PROCSO_FILE>&lt;xsl:if test=&quot;COD_PROCSO_FILE&quot;>&lt;tns:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;COD_PROCSO_FILE&quot;/>&lt;/tns:COD_PROCSO_FILE>&lt;/xsl:if>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:Application>&lt;tns:LogName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LogName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;xsl:if test=&quot;RECORD_TRG_OK&quot;>&lt;tns:NumTotRecord>&lt;xsl:value-of select=&quot;RECORD_TRG_OK&quot;/>&lt;/tns:NumTotRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;ID_TRACK&quot;>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;ID_TRACK&quot;/>&lt;/tns:ID_TRACK>&lt;/xsl:if>&lt;xsl:if test=&quot;FILE_NAME&quot;>&lt;tns:FILE_NAME>&lt;xsl:value-of select=&quot;FILE_NAME&quot;/>&lt;/tns:FILE_NAME>&lt;/xsl:if>&lt;xsl:if test=&quot;FOLDER&quot;>&lt;tns:FOLDER>&lt;xsl:value-of select=&quot;FOLDER&quot;/>&lt;/tns:FOLDER>&lt;/xsl:if>&lt;/tns:Assettizzazione_Input>&lt;/xsl:for-each>&lt;/tns:Assettizzazione>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:Assettizzazione="http://www.example.org/Assettizzazione"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="Assettizzazione:Assettizzazione" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="ForEach" tibex:group="foreach" tibex:xpdlId="53e55518-0ac3-427b-84e9-a223953b566c">
                <bpws:targets>
                    <bpws:target linkName="MapperToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToExit"/>
                </bpws:sources>
                <bpws:forEach counterName="index" name="forEach"
                    parallel="no" tibex:group="foreach">
                    <tibex:DesignExpression name="final">
                        <tibex:expression
                            expression="count($Mapper/ns3:Assettizzazione_Input)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Mapper/ns3:Assettizzazione_Input)]]></bpws:finalCounterValue>
                    <bpws:scope name="innerScope">
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="LogToAssettizzazione" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToLog" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="AssettizzazioneToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQueryToAssettizzazione" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="bfd8159e-98cd-4817-b587-8c3ab6ed65cb">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToLog"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="907ebf94-4507-4353-9718-cbad59050be9">
                                <bpws:targets>
                                    <bpws:target linkName="AssettizzazioneToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="Assettizzazione-input"
                                    name="Assettizzazione"
                                    tibex:xpdlId="aff08c31-1b25-4ea2-9781-27d023fc64a3"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToAssettizzazione"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssettizzazioneToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Assettizzazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:param name=&quot;NumRecord&quot;/>&lt;xsl:template name=&quot;Assettizzazione-input&quot; match=&quot;/&quot;>&lt;tns:Assettizzazione_Input>&lt;xsl:variable name=&quot;var&quot; select=&quot;$Mapper/tns:Assettizzazione_Input[number($index)]&quot;/>&lt;xsl:if test=&quot;$var/tns:ID_FILE&quot;>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;$var/tns:ID_FILE&quot;/>&lt;/tns:ID_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:FLUSSO&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$var/tns:FLUSSO&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:SISTEMA&quot;>&lt;tns:SISTEMA>&lt;xsl:value-of select=&quot;$var/tns:SISTEMA&quot;/>&lt;/tns:SISTEMA>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:ID_ESEC_PROCSO_FILE&quot;>&lt;tns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;$var/tns:ID_ESEC_PROCSO_FILE&quot;/>&lt;/tns:ID_ESEC_PROCSO_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:COD_PROCSO_FILE&quot;>&lt;tns:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;$var/tns:COD_PROCSO_FILE&quot;/>&lt;/tns:COD_PROCSO_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:Application&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$var/tns:Application&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:LogName&quot;>&lt;tns:LogName>&lt;xsl:value-of select=&quot;$var/tns:LogName&quot;/>&lt;/tns:LogName>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$var/tns:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;xsl:if test=&quot;$NumRecord/Record[1]/COUNT1&quot;>&lt;tns:NumTotRecord>&lt;xsl:value-of select=&quot;$NumRecord/Record[1]/COUNT1&quot;/>&lt;/tns:NumTotRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:ID_TRACK&quot;>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;$var/tns:ID_TRACK&quot;/>&lt;/tns:ID_TRACK>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:FILE_NAME&quot;>&lt;tns:FILE_NAME>&lt;xsl:value-of select=&quot;$var/tns:FILE_NAME&quot;/>&lt;/tns:FILE_NAME>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:FOLDER&quot;>&lt;tns:FOLDER>&lt;xsl:value-of select=&quot;$var/tns:FOLDER&quot;/>&lt;/tns:FOLDER>&lt;/xsl:if>&lt;/tns:Assettizzazione_Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.batch.alignment.module.AnagraficaSLU.Assettizzazione" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="Log-input" name="Log"
                                    tibex:xpdlId="d017173e-6663-44d8-8675-117c2fbb2083"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToLog"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogToAssettizzazione"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.alignment.module.UnicaRA.application'&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($Mapper, true(), true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="NumRecord-input"
                                    name="NumRecord"
                                    outputVariable="NumRecord"
                                    tibex:xpdlId="83e7a3f7-c49b-4b8f-b328-7f2da6511534" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogToAssettizzazione"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToAssettizzazione"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+83e7a3f7-c49b-4b8f-b328-7f2da6511534+input&quot; xmlns:tns1=&quot;http://www.example.org/Assettizzazione&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:template name=&quot;NumRecord-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal($Mapper/tns1:Assettizzazione_Input[number($index)]/tns1:ID_FILE)&quot;/>&lt;/ID_FILE_PROCSTO_INPUT>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select count(1) from STAG_UNICARA_SLU where ID_STATO_ELAB_STAG= 14 and ID_FILE_PROCSTO_INPUT=?&#xa;&#xa;&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE_PROCSTO_INPUT"/>
                                    <columnMetadata
                                    columnName="COUNT(1)"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:forEach>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
