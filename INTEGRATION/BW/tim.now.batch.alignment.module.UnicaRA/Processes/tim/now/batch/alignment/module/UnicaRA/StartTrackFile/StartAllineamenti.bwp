        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:FaultDetail" name="FaultDetails" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:CW_BUS_MESSAGE"
            name="LogError-input" sca-bpel:internal="true"/>
        <bpws:variable name="StartTimer" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Timer/StartAllineamenti/StartTimer" type="xsd:dateTime"/>
        <bpws:variable name="Intervallo" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Timer/StartAllineamenti/Intervallo" type="xsd:int"/>
        <bpws:variable name="CodIntrfcFF" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Interfaccia/COD_INTRFC_UNICAFF" type="xsd:string"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="b91a8148-1ced-4c95-987e-f3d2f0ede094">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links/>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="LogError-input"
                                name="LogError"
                                tibex:xpdlId="58f87121-8678-4536-a178-f451f30aa04d"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="getFlowToIterate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="IterateToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="getFlowToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="Timer"
                    tibex:xpdlId="d0048e88-9382-4e44-a927-beead50fa16c"
                    variable="Timer" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="StartTimer"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="Intervallo"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value
                                    endTime="2017-02-22T12:16:17.153+0100"
                                    intervalUnit="Minute" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="getFlow-input"
                    name="getFlow" outputVariable="getFlow"
                    tibex:xpdlId="9d997480-b82e-4690-8e01-4085f2c13803" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="getFlowToIterate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($getFlow/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($getFlow/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="getFlowToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9d997480-b82e-4690-8e01-4085f2c13803+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_FLOW, FLOW FROM ALIGN_FILE_TRACKING where &#xa;(STATO in ('DA LAVORARE','IN ATTESA') OR FLAG_REWORK='Y')&#xa;AND SYSTEM = 'UNICA RA' AND ID_FLOW IN (12,13,14,69,91,92)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_FLOW"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLOW"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="ForEach" tibex:group="foreach" tibex:xpdlId="c63ef6d1-6828-45dd-af6a-4913ce69fc1a">
                <bpws:targets>
                    <bpws:target linkName="getFlowToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToExit"/>
                </bpws:sources>
                <bpws:forEach counterName="index" name="forEach"
                    parallel="no" tibex:group="foreach">
                    <tibex:DesignExpression name="final">
                        <tibex:expression
                            expression="count($getFlow/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($getFlow/Record)]]></bpws:finalCounterValue>
                    <bpws:scope name="innerScope">
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToVerificaLavorabilita" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="VerificaLavorabilitaToInsLogger" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="VerificaLavorabilitaToGroupEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="VerificaLavorabilitaToMovedError" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="MovedErrorToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InsLoggerToContaRecord" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ContaRecordToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="e4d59eb3-f86a-449f-9fe4-7c1ac0de147d">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToVerificaLavorabilita"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="2cdf26e3-4136-49dc-92be-ff3dd5ddd617">
                                <bpws:targets>
                                    <bpws:target linkName="VerificaLavorabilitaToGroupEnd"/>
                                    <bpws:target linkName="MovedErrorToGroupEnd"/>
                                    <bpws:target linkName="ContaRecordToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="VerificaLavorabilita-input"
                                    name="VerificaLavorabilita"
                                    outputVariable="VerificaLavorabilita"
                                    tibex:xpdlId="053c85c9-927c-49aa-945c-e317c29d7f3b"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToVerificaLavorabilita"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VerificaLavorabilitaToInsLogger">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VerificaLavorabilitaToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$VerificaLavorabilita/ns3:STATO=('WAIT','NOFOUND')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$VerificaLavorabilita/ns3:STATO=('WAIT','NOFOUND')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VerificaLavorabilitaToMovedError">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$VerificaLavorabilita/ns3:STATO='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$VerificaLavorabilita/ns3:STATO='KO']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;getFlow&quot;/>&lt;xsl:template name=&quot;VerificaLavorabilita-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;xsl:if test=&quot;$getFlow/Record[number($index)]/FLOW&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$getFlow/Record[number($index)]/FLOW&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;tns:ID_FLOW>&lt;xsl:value-of select=&quot;xsd:int($getFlow/Record[number($index)]/ID_FLOW)&quot;/>&lt;/tns:ID_FLOW>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.VerificaLavorabilita" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="InsLogger-input"
                                    name="InsLogger"
                                    outputVariable="InsLogger"
                                    tibex:xpdlId="1927831d-61c2-4c68-838a-c67a706f30fd"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VerificaLavorabilitaToInsLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InsLoggerToContaRecord"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:param name=&quot;CodIntrfcIDULLCO&quot;/>&lt;xsl:param name=&quot;CodIntrfcIDSLUCO&quot;/>&lt;xsl:param name=&quot;CodIntrfcSLU&quot;/>&lt;xsl:param name=&quot;CodIntrfcFF&quot;/>&lt;xsl:template name=&quot;InsLogger-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:DataIn>&lt;tns:Insert>&lt;tns:InputFile>&lt;xsl:variable name=&quot;varCodIntrfc&quot; select=&quot;if(contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;IDSLUCO_UNICARA_TO_NOW_&amp;quot;)) then $CodIntrfcIDSLUCO&amp;#xD;&amp;#xA;else if(contains($VerificaLavorabilita/tns1:NOME_FILE,&amp;quot;IDULLCO_UNICARA_TO_NOW_&amp;quot;)) then $CodIntrfcIDULLCO&amp;#xD;&amp;#xA;else if(contains($VerificaLavorabilita/tns1:NOME_FILE,&amp;quot;TIM_VARIAZIONE_ASSET_FCOP&amp;quot;)) then 'ID342' &amp;#xD;&amp;#xA;else if(contains($VerificaLavorabilita/tns1:NOME_FILE,&amp;quot;TIM_VARIAZIONE_ASSET&amp;quot;)) then $CodIntrfcFF &amp;#xD;&amp;#xA;else $CodIntrfcSLU&quot;/>&lt;tns:CODICE_INTERFACCIA>&lt;xsl:value-of select=&quot;$varCodIntrfc&quot;/>&lt;/tns:CODICE_INTERFACCIA>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;>&lt;tns:NOME_FILE>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;/>&lt;/tns:NOME_FILE>&lt;/xsl:if>&lt;tns:DATA_FILE>&lt;xsl:value-of select=&quot;substring($VerificaLavorabilita/tns1:DATA_FILE, 1,10)&quot;/>&lt;/tns:DATA_FILE>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:FILE_SIZE&quot;>&lt;tns:SIZE>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:FILE_SIZE&quot;/>&lt;/tns:SIZE>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;/>&lt;/tns:ID_TRACK>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;>&lt;tns:FULL_NAME>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;/>&lt;/tns:FULL_NAME>&lt;/xsl:if>&lt;tns:FLAG_CONTENUTO_FILE>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:FLAG_CONTENUTO_FILE>&lt;/tns:InputFile>&lt;/tns:Insert>&lt;/tns:DataIn>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.ProcessLoggerTrack" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="MovedError-input"
                                    name="MovedError"
                                    outputVariable="MovedError"
                                    tibex:xpdlId="a250a749-1c11-4d59-be0a-8fe170761780"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VerificaLavorabilitaToMovedError"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MovedErrorToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns1=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:param name=&quot;PathError&quot;/>&lt;xsl:template name=&quot;MovedError-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;>&lt;tns1:FullPathOrigine>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;/>&lt;/tns1:FullPathOrigine>&lt;/xsl:if>&lt;tns1:FolderDestinazione>&lt;xsl:value-of select=&quot;$PathError&quot;/>&lt;/tns1:FolderDestinazione>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;>&lt;tns1:NomeFile>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;/>&lt;/tns1:NomeFile>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;>&lt;tns1:ID_TRACK>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;/>&lt;/tns1:ID_TRACK>&lt;/xsl:if>&lt;tns1:LogInput>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LogName>&lt;/tns1:LogInput>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneMovedFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="ContaRecord-input"
                                name="ContaRecord"
                                operation="ContaRecord"
                                partnerLink="Conta" portType="ns7:Conta" tibex:xpdlId="64587dc3-a2d5-43d2-8ecf-22019403e00f">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/" xmlns:tns1="http://www.example.org/VerificaLavorabilita" xmlns:ns="http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/" xmlns:tns2="http://www.example.org/CreateFileID" version="2.0"&gt;&lt;xsl:param name="VerificaLavorabilita"/&gt;&lt;xsl:param name="InsLogger"/&gt;&lt;xsl:template name="ContaRecord-input" match="/"&gt;&lt;tns:Conta_Request&gt;&lt;part1&gt;&lt;ns:contaRecord_Input&gt;&lt;xsl:variable name="varQueue" select="if(contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;IDSLUCO_UNICARA_TO_NOW_&amp;quot;)) then 'allineamento.idsluco.unicaRa'&amp;#xD;&amp;#xA;else if(contains($VerificaLavorabilita/tns1:NOME_FILE,&amp;quot;IDULLCO_UNICARA_TO_NOW_&amp;quot;)) then 'allineamento.idullco.unicaRa'&amp;#xD;&amp;#xA;else if(contains($VerificaLavorabilita/tns1:NOME_FILE,&amp;quot;GPON&amp;quot;)) then 'allineamento.anagraficagpon.unicaRa'&amp;#xD;&amp;#xA;else if(contains($VerificaLavorabilita/tns1:NOME_FILE,&amp;quot;TIM_VARIAZIONE_ASSET_&amp;quot;)) then&amp;#xD;&amp;#xA;&amp;#x9;(if(contains($VerificaLavorabilita/tns1:NOME_FILE,&amp;quot;FCOP&amp;quot;)) then 'allineamento.fc.unicaRa' else 'allineamento.ff.unicaRa')&amp;#xD;&amp;#xA;else 'allineamento.unicaslu'"/&gt;&lt;ns:in&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:SOURCE_FILE"/&gt;&lt;/ns:in&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;TIM_VARIAZIONE_ASSET_&amp;quot;) or contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;NOW_UNICARA_GPON_&amp;quot;)"&gt;&lt;ns:TipoSeparatore&gt;&lt;xsl:value-of select="&amp;quot;POSIZIONALE&amp;quot;"/&gt;&lt;/ns:TipoSeparatore&gt;&lt;/xsl:when&gt;&lt;xsl:when test="contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;ANAGRAFICA_SLU_UNICA_TO_NOW_&amp;quot;)"&gt;&lt;ns:TipoSeparatore&gt;&lt;xsl:value-of select="&amp;quot;ContaRecord_PipeCancelletto&amp;quot;"/&gt;&lt;/ns:TipoSeparatore&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:TipoSeparatore&gt;&lt;xsl:value-of select="&amp;quot;ContaRecord_DoppioPipe&amp;quot;"/&gt;&lt;/ns:TipoSeparatore&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$InsLogger/tns2:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$InsLogger/tns2:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:SOURCE_FILE"&gt;&lt;ns:FULLNAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:SOURCE_FILE"/&gt;&lt;/ns:FULLNAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:NOME_FILE"&gt;&lt;ns:FILENAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:NOME_FILE"/&gt;&lt;/ns:FILENAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InsLogger/tns2:ID_ESEC"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsLogger/tns2:ID_ESEC"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InsLogger/tns2:COD_PROCSO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsLogger/tns2:COD_PROCSO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:ID_TRACK"&gt;&lt;ns:ID_TRACK&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:ID_TRACK"/&gt;&lt;/ns:ID_TRACK&gt;&lt;/xsl:if&gt;&lt;ns:NomeProcesso&gt;&lt;xsl:value-of select="$varQueue"/&gt;&lt;/ns:NomeProcesso&gt;&lt;/ns:contaRecord_Input&gt;&lt;/part1&gt;&lt;/tns:Conta_Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; xmlns:tns2=&quot;http://www.example.org/CreateFileID&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:param name=&quot;InsLogger&quot;/>&#xa;    &lt;xsl:template name=&quot;ContaRecord-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:contaRecord_Input>&#xa;            &lt;xsl:variable name=&quot;varQueue&quot; select=&quot;if(contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;IDSLUCO_UNICARA_TO_NOW_&amp;quot;)) then 'allineamento.idsluco.unicaRa'&amp;#xD;&amp;#xA;else if(contains($VerificaLavorabilita/tns1:NOME_FILE,&amp;quot;IDULLCO_UNICARA_TO_NOW_&amp;quot;)) then 'allineamento.idullco.unicaRa'&amp;#xD;&amp;#xA;else if(contains($VerificaLavorabilita/tns1:NOME_FILE,&amp;quot;GPON&amp;quot;)) then 'allineamento.anagraficagpon.unicaRa'&amp;#xD;&amp;#xA;else if(contains($VerificaLavorabilita/tns1:NOME_FILE,&amp;quot;TIM_VARIAZIONE_ASSET_&amp;quot;)) then&amp;#xD;&amp;#xA;&amp;#x9;(if(contains($VerificaLavorabilita/tns1:NOME_FILE,&amp;quot;FCOP&amp;quot;)) then 'allineamento.fc.unicaRa' else 'allineamento.ff.unicaRa')&amp;#xD;&amp;#xA;else 'allineamento.unicaslu'&quot;/>&#xa;            &lt;ns:in>&#xa;                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;/>&#xa;            &lt;/ns:in>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;TIM_VARIAZIONE_ASSET_&amp;quot;) or contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;NOW_UNICARA_GPON_&amp;quot;)&quot;>&#xa;                    &lt;ns:TipoSeparatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;POSIZIONALE&amp;quot;&quot;/>&#xa;                    &lt;/ns:TipoSeparatore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($VerificaLavorabilita/tns1:NOME_FILE, &amp;quot;ANAGRAFICA_SLU_UNICA_TO_NOW_&amp;quot;)&quot;>&#xa;                    &lt;ns:TipoSeparatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ContaRecord_PipeCancelletto&amp;quot;&quot;/>&#xa;                    &lt;/ns:TipoSeparatore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:TipoSeparatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ContaRecord_DoppioPipe&amp;quot;&quot;/>&#xa;                    &lt;/ns:TipoSeparatore>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$InsLogger/tns2:ID_FILE&quot;>&#xa;                &lt;ns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsLogger/tns2:ID_FILE&quot;/>&#xa;                &lt;/ns:ID_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;>&#xa;                &lt;ns:FULLNAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;/>&#xa;                &lt;/ns:FULLNAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;>&#xa;                &lt;ns:FILENAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;/>&#xa;                &lt;/ns:FILENAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsLogger/tns2:ID_ESEC&quot;>&#xa;                &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsLogger/tns2:ID_ESEC&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsLogger/tns2:COD_PROCSO_FILE&quot;>&#xa;                &lt;ns:COD_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsLogger/tns2:COD_PROCSO_FILE&quot;/>&#xa;                &lt;/ns:COD_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&#xa;                &lt;ns:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;/>&#xa;                &lt;/ns:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:NomeProcesso>&#xa;                &lt;xsl:value-of select=&quot;$varQueue&quot;/>&#xa;            &lt;/ns:NomeProcesso>&#xa;        &lt;/ns:contaRecord_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="InsLoggerToContaRecord"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ContaRecordToGroupEnd"/>
                                </bpws:sources>
                                <bpws:correlations/>
                            </bpws:invoke>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:forEach>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="b7b85d0f-13c8-402a-83e0-5e445cfb61ba">
