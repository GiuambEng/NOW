                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Set_Command&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns2=&quot;http://www.example.org/CreateFileID&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FlagSSH&quot;/>&lt;xsl:param name=&quot;PathLocationShell&quot;/>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:param name=&quot;PathDestinazioneOracle&quot;/>&lt;xsl:param name=&quot;UsernameSh&quot;/>&lt;xsl:param name=&quot;SysCode&quot;/>&lt;xsl:param name=&quot;DBName&quot;/>&lt;xsl:param name=&quot;InsLogger&quot;/>&lt;xsl:param name=&quot;FlagCrmsInterface&quot;/>&lt;xsl:template name=&quot;CallShell-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Command>&lt;xsl:value-of select=&quot;concat('./now_asset_car_unicara.ksh ',$VerificaLavorabilita/tns1:NOME_FILE,' ',$UsernameSh,' ',$SysCode,' ',$DBName,' ',$PathDestinazioneOracle,' ',$FlagCrmsInterface,' ',string($InsLogger/tns2:ID_FILE))&quot;/>&lt;/tns:Command>&lt;tns:CommandSSH>&lt;xsl:value-of select=&quot;concat('export PATH_ROOT=', $PathLocationShell, '; cd ', $PathLocationShell, '; nohup ./now_asset_car_unicara.sh ',$VerificaLavorabilita/tns1:NOME_FILE,' ',$UsernameSh,' ',$SysCode,' ',$DBName,' ',$PathDestinazioneOracle,' ',$FlagCrmsInterface,' ',string($InsLogger/tns2:ID_FILE), ' > Lancio_now_asset_car_unicara.log &amp;amp;')&quot;/>&lt;/tns:CommandSSH>&lt;tns:WorkingDirectory>&lt;xsl:value-of select=&quot;$PathLocationShell&quot;/>&lt;/tns:WorkingDirectory>&lt;tns:FlagSSH>&lt;xsl:value-of select=&quot;$FlagSSH&quot;/>&lt;/tns:FlagSSH>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
