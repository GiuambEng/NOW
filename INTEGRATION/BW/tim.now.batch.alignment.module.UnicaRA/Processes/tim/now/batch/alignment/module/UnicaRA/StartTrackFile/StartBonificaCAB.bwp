                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:ns11=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InsLogger&quot;/>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Details&quot;/>&lt;xsl:template name=&quot;InsValueInTable-input&quot; match=&quot;/&quot;>&lt;ns1:ChiusuraAllineamenti>&lt;ns1:InputData>&lt;xsl:if test=&quot;$InsLogger/tns:ID_FILE&quot;>&lt;ns1:ID_FILE>&lt;xsl:value-of select=&quot;$InsLogger/tns:ID_FILE&quot;/>&lt;/ns1:ID_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsLogger/tns:ID_ESEC&quot;>&lt;ns1:ID_ESEC_FILE>&lt;xsl:value-of select=&quot;$InsLogger/tns:ID_ESEC&quot;/>&lt;/ns1:ID_ESEC_FILE>&lt;/xsl:if>&lt;ns1:SISTEMA>&lt;xsl:value-of select=&quot;&amp;quot;UnicaRA&amp;quot;&quot;/>&lt;/ns1:SISTEMA>&lt;ns1:FLUSSO>&lt;xsl:value-of select=&quot;'Bonifica Consistenza CAB'&quot;/>&lt;/ns1:FLUSSO>&lt;xsl:if test=&quot;$InsLogger/tns:COD_PROCSO_FILE&quot;>&lt;ns1:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;$InsLogger/tns:COD_PROCSO_FILE&quot;/>&lt;/ns1:COD_PROCSO_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&lt;ns1:ID_TRACK>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;/>&lt;/ns1:ID_TRACK>&lt;/xsl:if>&lt;ns1:LogInfo>&lt;ns1:LogInfoLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/ns1:LogInfoLevel>&lt;ns1:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/ns1:LogName>&lt;ns1:ApplicationName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/ns1:ApplicationName>&lt;/ns1:LogInfo>&lt;/ns1:InputData>&lt;xsl:for-each select=&quot;$Details/ns11:InputDetails&quot;>&lt;ns1:InputDetails>&lt;xsl:if test=&quot;ns11:NOME&quot;>&lt;ns1:NOME>&lt;xsl:value-of select=&quot;ns11:NOME&quot;/>&lt;/ns1:NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;ns11:VALORE&quot;>&lt;ns1:VALORE>&lt;xsl:value-of select=&quot;ns11:VALORE&quot;/>&lt;/ns1:VALORE>&lt;/xsl:if>&lt;/ns1:InputDetails>&lt;/xsl:for-each>&lt;/ns1:ChiusuraAllineamenti>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
