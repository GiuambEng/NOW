                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:tim.now.schema.xsd.NOW_AnagraficaUnicaSLU_SubProcess="http://www.example.org/tim.now.schema.xsd.NOW_AnagraficaUnicaSLU_SubProcess" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
