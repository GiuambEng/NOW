                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.schema.xsd.NOW_AnagraficaUnicaSLU_SubProcess&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ControlloDettaglio-input&quot; match=&quot;/&quot;>&lt;tns:AnagraficaUnicaSlu>&lt;tns:AnagraficaUnicaSlu_Dettaglio>&lt;xsl:if test=&quot;$Start/tns:AnagraficaUnicaSlu_Dettaglio[number($index)]/tns:Tipo_record&quot;>&lt;tns:Tipo_record>&lt;xsl:value-of select=&quot;$Start/tns:AnagraficaUnicaSlu_Dettaglio[number($index)]/tns:Tipo_record&quot;/>&lt;/tns:Tipo_record>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:AnagraficaUnicaSlu_Dettaglio[number($index)]/tns:ID_RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$Start/tns:AnagraficaUnicaSlu_Dettaglio[number($index)]/tns:ID_RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:AnagraficaUnicaSlu_Dettaglio[number($index)]/tns:DEC_ATT&quot;>&lt;tns:DEC_ATT>&lt;xsl:value-of select=&quot;$Start/tns:AnagraficaUnicaSlu_Dettaglio[number($index)]/tns:DEC_ATT&quot;/>&lt;/tns:DEC_ATT>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:AnagraficaUnicaSlu_Dettaglio[number($index)]/tns:DEC_CES&quot;>&lt;tns:DEC_CES>&lt;xsl:value-of select=&quot;$Start/tns:AnagraficaUnicaSlu_Dettaglio[number($index)]/tns:DEC_CES&quot;/>&lt;/tns:DEC_CES>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:AnagraficaUnicaSlu_Dettaglio[number($index)]/tns:FlagValidita&quot;>&lt;tns:FlagValidita>&lt;xsl:value-of select=&quot;$Start/tns:AnagraficaUnicaSlu_Dettaglio[number($index)]/tns:FlagValidita&quot;/>&lt;/tns:FlagValidita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:AnagraficaUnicaSlu_Dettaglio[number($index)]/tns:Numero_Record&quot;>&lt;tns:Numero_Record>&lt;xsl:value-of select=&quot;$Start/tns:AnagraficaUnicaSlu_Detta