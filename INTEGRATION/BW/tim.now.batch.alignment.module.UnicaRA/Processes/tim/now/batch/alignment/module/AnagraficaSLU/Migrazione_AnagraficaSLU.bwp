                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" version="2.0"&gt;&lt;xsl:param name="Var_InputProcessLogger"/&gt;&lt;xsl:template name="Invoke_End_Log-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:TipologiaProcesso"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:TipologiaOperazione"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL"&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE"&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO"&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO"/&