                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:ns=&quot;www.tim.now.subProcessMigrzioneSLU&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.example.org/tim.now.schema.xsd.NOW_AnagraficaUnicaSLU_Tracciato&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FindFile&quot;/>&lt;xsl:param name=&quot;Passo_SLU&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Invoke_ProcessLogger&quot;/>&lt;xsl:param name=&quot;DetailUltimiNoval&quot;/>&lt;xsl:param name=&quot;OK_ELAB_RECORD&quot;/>&lt;xsl:param name=&quot;DetailNoval&quot;/>&lt;xsl:template name=&quot;Ins-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:InfoFile>&lt;ns:NomeFile>&lt;xsl:value-of select=&quot;$FindFile/tns1:FullName&quot;/>&lt;/ns:NomeFile>&lt;ns:StartRecord>&lt;xsl:value-of select=&quot;($index - 1) * $Passo_SLU + 2&quot;/>&lt;/ns:StartRecord>&lt;ns:Passo>&lt;xsl:value-of select=&quot;$Passo_SLU&quot;/>&lt;/ns:Passo>&lt;/ns:InfoFile>&lt;xsl:if test=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:COD_PROCSO_FILE&quot;>&lt;ns:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:COD_PROCSO_FILE&quot;/>&lt;/ns:COD_PROCSO_FILE>&lt;/xsl:if>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE))&quot;/>&lt;/ns:ID_FILE>&lt;ns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE))&quot;/>&lt;/ns:ID_ESEC_PROCSO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimiNoval/Rows/tns3:AnagraficaUnicaSlu_Dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoval/Rows/tns3:AnagraficaUnicaSlu_Dettaglio&quot;>&lt;ns:Record>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_SLU* ($index - 1)) + position())&quot;/>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;concat(tns3:Tipo_record,'|#',tns3:ID_RISORSA,'|#',tns3:DEC_ATT,'|#',tns3:DEC_CES,'|#',tns3:FlagValidita)&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;xsl:if test=&quot;tns3:DEC_ATT&quot;>&lt;ns:DEC_ATTIVAZIONE>&lt;xsl:value-of select=&quot;tns3:DEC_ATT&quot;/>&lt;/ns:DEC_ATTIVAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:DEC_CES&quot;>&lt;ns:DEC_CESSAZIONE>&lt;xsl:value-of select=&quot;tns3:DEC_CES&quot;/>&lt;/ns:DEC_CESSAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:ID_RISORSA&quot;>&lt;ns:ID_RISORSA_UNICA_RA>&lt;xsl:value-of select=&quot;tns3:ID_RISORSA&quot;/>&lt;/ns:ID_RISORSA_UNICA_RA>&lt;/xsl:if>&lt;ns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE))&quot;/>&lt;/ns:ID_FILE_PROCSTO_INPUT>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($OK_ELAB_RECORD))&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var&quot;/>&lt;/ns:NUMERO_RECD>&lt;/ns:Record>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimiNoval/Rows/tns3:AnagraficaUnicaSlu_Dettaglio&quot;>&lt;ns:Record>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo_SLU* ($index - 1)) + position())&quot;/>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;concat(tns3:Tipo_record,'|#',tns3:ID_RISORSA,'|#',tns3:DEC_ATT,'|#',tns3:DEC_CES,'|#',tns3:FlagValidita)&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;xsl:if test=&quot;tns3:DEC_ATT&quot;>&lt;ns:DEC_ATTIVAZIONE>&lt;xsl:value-of select=&quot;tns3:DEC_ATT&quot;/>&lt;/ns:DEC_ATTIVAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:DEC_CES&quot;>&lt;ns:DEC_CESSAZIONE>&lt;xsl:value-of select=&quot;tns3:DEC_CES&quot;/>&lt;/ns:DEC_CESSAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:ID_RISORSA&quot;>&lt;ns:ID_RISORSA_UNICA_RA>&lt;xsl:value-of select=&quot;tns3:ID_RISORSA&quot;/>&lt;/ns:ID_RISORSA_UNICA_RA>&lt;/xsl:if>&lt;ns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE))&quot;/>&lt;/ns:ID_FILE_PROCSTO_INPUT>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($OK_ELAB_RECORD))&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var1&quot;/>&lt;/ns:NUMERO_RECD>&lt;/ns:Record>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Ins-input" name="Ins"
                                    tibex:xpdlId="8ec9fb92-96e4-4049-8b19-30338968b789"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty1ToCallProcess11"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess1ToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:ns=&quot;www.tim.now.subProcessMigrzioneSLU&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.example.org/tim.now.schema.xsd.NOW_AnagraficaUnicaSLU_Tracciato&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FindFile&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo_SLU&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailUltimiNoval&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELAB_RECORD&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoval&quot;/>&#xa;    &lt;xsl:template name=&quot;Ins-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:InfoFile>&#xa;                &lt;ns:NomeFile>&#xa;                    &lt;xsl:value-of select=&quot;$FindFile/tns1:FullName&quot;/>&#xa;                &lt;/ns:NomeFile>&#xa;                &lt;ns:StartRecord>&#xa;                    &lt;xsl:value-of select=&quot;($index - 1) * $Passo_SLU + 2&quot;/>&#xa;                &lt;/ns:StartRecord>&#xa;                &lt;ns:Passo>&#xa;                    &lt;xsl:value-of select=&quot;$Passo_SLU&quot;/>&#xa;                &lt;/ns:Passo>&#xa;            &lt;/ns:InfoFile>&#xa;            &lt;xsl:if test=&quot;$Invoke_ProcessLogger.part1/ns1:Esito/ns1:COD_PROCSO_FILE&quot;>&#xa;                &lt;ns:COD_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke_ProcessLogger.part1/ns1:Esito/ns1:COD_PROCSO_FILE&quot;/>&#xa;                &lt;/ns:COD_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_FILE))&quot;/>&#xa;            &lt;/ns:ID_FILE>&#xa;            &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE))&quot;/>&#xa;            &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($DetailUltimiNoval/Rows/tns3:AnagraficaUnicaSlu_Dettaglio)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoval/Rows/tns3:AnagraficaUnicaSlu_Dettaglio&quot;>&#xa;                        &lt;ns:Record>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_SLU* ($index - 1)) + position())&quot;/>&#xa;                            &lt;ns:CONTENUTO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;concat(tns3:Tipo_record,'|#',tns3:ID_RISORSA,'|#',tns3:DEC_ATT,'|#',tns3:DEC_CES,'|#',tns3:FlagValidita)&quot;/>&#xa;                            &lt;/ns:CONTENUTO_RECD>&#xa;                            &lt;xsl:if test=&quot;tns3:DEC_ATT&quot;>&#xa;                                &lt;ns:DEC_ATTIVAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns3:DEC_ATT&quot;/>&#xa;                                &lt;/ns:DEC_ATTIVAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns3:DEC_CES&quot;>&#xa;                                &lt;ns:DEC_CESSAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns3:DEC_CES&quot;/>&#xa;                                &lt;/ns:DEC_CESSAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns3:ID_RISORSA&quot;>&#xa;                                &lt;ns:ID_RISORSA_UNICA_RA>&#xa;                                    &lt;xsl:value-of select=&quot;tns3:ID_RISORSA&quot;/>&#xa;                                &lt;/ns:ID_RISORSA_UNICA_RA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_FILE))&quot;/>&#xa;                            &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($OK_ELAB_RECORD))&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                        &lt;/ns:Record>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimiNoval/Rows/tns3:AnagraficaUnicaSlu_Dettaglio&quot;>&#xa;                        &lt;ns:Record>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo_SLU* ($index - 1)) + position())&quot;/>&#xa;                            &lt;ns:CONTENUTO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;concat(tns3:Tipo_record,'|#',tns3:ID_RISORSA,'|#',tns3:DEC_ATT,'|#',tns3:DEC_CES,'|#',tns3:FlagValidita)&quot;/>&#xa;                            &lt;/ns:CONTENUTO_RECD>&#xa;                            &lt;xsl:if test=&quot;tns3:DEC_ATT&quot;>&#xa;                                &lt;ns:DEC_ATTIVAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns3:DEC_ATT&quot;/>&#xa;                                &lt;/ns:DEC_ATTIVAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns3:DEC_CES&quot;>&#xa;                                &lt;ns:DEC_CESSAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns3:DEC_CES&quot;/>&#xa;                                &lt;/ns:DEC_CESSAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns3:ID_RISORSA&quot;>&#xa;                                &lt;ns:ID_RISORSA_UNICA_RA>&#xa;                                    &lt;xsl:value-of select=&quot;tns3:ID_RISORSA&quot;/>&#xa;                                &lt;/ns:ID_RISORSA_UNICA_RA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_FILE))&quot;/>&#xa;                            &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($OK_ELAB_RECORD))&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                        &lt;/ns:Record>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.batch.alignment.module.AnagraficaSLU.Sub_Insert_MigSLU" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
