                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+936e7c81-4e61-4d0b-9876-4a3de98e0dc2+input&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a46b845d-fd97-45f9-b1c4-22d01462d6bc+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Invoke_Counter.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Id_Prcso_file&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcUpdateActivityInput>&#xa;            &lt;RECORD_STG_OK>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_Counter.part1/ns1:NumeroRecord))&quot;/>&#xa;            &lt;/RECORD_STG_OK>&#xa;            &lt;COD_PROCSO_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Id_Prcso_file&quot;/>&#xa;            &lt;/COD_PROCSO_FILE>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($Invoke_ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;            &lt;/ID_FILE>&#xa;        &lt;/tns1:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
