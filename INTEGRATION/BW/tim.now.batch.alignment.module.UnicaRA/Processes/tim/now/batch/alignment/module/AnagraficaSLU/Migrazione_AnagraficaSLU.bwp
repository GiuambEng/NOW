                    name="FindFile" outputVariable="FindFile"
                    tibex:xpdlId="399b3017-2150-4fbb-9ef1-d906a2647b2a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FindFileToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="FindFileToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$FindFile/ns3:Esito='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$FindFile/ns3:Esito='KO']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Id_Prcso_file&quot;/>&lt;xsl:param name=&quot;Id_Intrfc&quot;/>&lt;xsl:param name=&quot;FilePoller&quot;/>&lt;xsl:template name=&quot;FindFile-input&quot; match=&quot;/&quot;>&lt;tns1:InputFileTappo>&lt;tns1:FileName>&lt;xsl:value-of select=&quot;$FilePoller/fileInfo/fullName&quot;/>&lt;/tns1:FileName>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns1:LogName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:ApplicationName>&lt;xsl:value-of select=&quot;'tim.now.batch.alignment.module.UnicaRA.application'&quot;/>&lt;/tns1:ApplicationName>&lt;tns1:ID_PROCSO_FILE>&lt;xsl:value-of select=&quot;$Id_Prcso_file&quot;/>&lt;/tns1:ID_PROCSO_FILE>&lt;tns1:ID_INTRFC>&lt;xsl:value-of select=&quot;$Id_Intrfc&quot;/>&lt;/tns1:ID_INTRFC>&lt;tns1:Estensione>&lt;xsl:value-of select=&quot;'.csv'&quot;/>&lt;/tns1:Estensione>&lt;/tns1:InputFileTappo>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ReadFile.ReadFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Var_InputProcessLogger" name="Assign"
                    outputVariable="Var_InputProcessLogger"
                    tibex:xpdlId="3c744b51-b871-428b-b63a-45909673c7c7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FindFileToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FindFile&quot;/>&lt;xsl:param name=&quot;Id_Prcso_file&quot;/>&lt;xsl:param name=&quot;Id_Intrfc&quot;/>&lt;xsl:param name=&quot;Desc_Stato_file&quot;/>&lt;xsl:param name=&quot;Verso_Del_File&quot;/>&lt;xsl:param name=&quot;Id_Tipologia_file&quot;/>&lt;xsl:param name=&quot;Stato_Esec&quot;/>&lt;xsl:template name=&quot;Var_InputProcessLogger&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:TipologiaProcesso>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/ns:TipologiaProcesso>&lt;ns:TipologiaOperazione>&lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&lt;/ns:TipologiaOperazione>&lt;ns:ProcFile>&lt;ns:ID_PROCSO_FILE>&lt;xsl:value-of select=&quot;$Id_Prcso_file&quot;/>&lt;/ns:ID_PROCSO_FILE>&lt;/ns:ProcFile>&lt;ns:FileProcessato>&lt;xsl:if test=&quot;$FindFile/tns:LastModified&quot;>&lt;ns:DATA_FILE>&lt;xsl:value-of select=&quot;$FindFile/tns:LastModified&quot;/>&lt;/ns:DATA_FILE>&lt;/xsl:if>&lt;ns:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;$Desc_Stato_file&quot;/>&lt;/ns:DESCR_STATO_FILE>&lt;ns:ID_INTRFC>&lt;xsl:value-of select=&quot;xsd:integer($Id_Intrfc)&quot;/>&lt;/ns:ID_INTRFC>&lt;ns:IDTPLG_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Id_Tipologia_file)&quot;/>&lt;/ns:IDTPLG_FILE>&lt;xsl:if test=&quot;$FindFile/tns:FileName&quot;>&lt;ns:NOME_FILE>&lt;xsl:value-of select=&quot;$FindFile/tns:FileName&quot;/>&lt;/ns:NOME_FILE>&lt;/xsl:if>&lt;ns:TIMSTP_APERTURA_FILE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_APERTURA_FILE>&lt;ns:VERSO_DEL_FILE>&lt;xsl:value-of select=&quot;$Verso_Del_File&quot;/>&lt;/ns:VERSO_DEL_FILE>&lt;/ns:FileProcessato>&lt;ns:FileProcessatoInput>&lt;ns:DATA_ARRIVO>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/ns:DATA_ARRIVO>&lt;ns:DIMENSIONE_FILE>&lt;xsl:value-of select=&quot;xsd:integer($FindFile/tns:Size)&quot;/>&lt;/ns:DIMENSIONE_FILE>&lt;/ns:FileProcessatoInput>&lt;ns:EsecuzioneFile>&lt;ns:STATO_ESEC>&lt;xsl:value-of select=&quot;$Stato_Esec&quot;/>&lt;/ns:STATO_ESEC>&lt;ns:TMSP_INIZIO_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INIZIO_ELAB>&lt;/ns:EsecuzioneFile>&lt;ns:ContenutoFile>&lt;ns:ID_CONTENUTO_FILE>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/ns:ID_CONTENUTO_FILE>&lt;xsl:if test=&quot;$FindFile/tns:FullName&quot;>&lt;ns:FullName>&lt;xsl:value-of select=&quot;$FindFile/tns:FullName&quot;/>&lt;/ns:FullName>&lt;/xsl:if>&lt;/ns:ContenutoFile>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Var_InputProcessLogger" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="56d6eb6a-fe1d-4193-8816-4767086177fd">
                <bpws:targets>
                    <bpws:target linkName="FindFileToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogInput_ProcessLogger-input"
                    name="LogInput_ProcessLogger"
                    tibex:xpdlId="b8a89aac-08c9-4b86-abf7-4e1f2bd6b764"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInput_ProcessLoggerToInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Var_InputProcessLogger&quot;/>&lt;xsl:template name=&quot;LogInput_ProcessLogger-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.alignment.module.UnicaRA.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Migrazione_AnagraficaSLU'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($Var_InputProcessLogger, true(), true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="Invoke_ProcessLogger-input"
                name="Invoke_ProcessLogger" operation="Insert"
                outputVariable="Invoke_ProcessLogger"
                partnerLink="Logger" portType="ns5:ProcessLog" tibex:xpdlId="ae7fd1a1-3849-4482-8196-84467cd00bc7">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" version="2.0"&gt;&lt;xsl:param name="Var_InputProcessLogger"/&gt;&lt;xsl:template name="Invoke_ProcessLogger-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:TipologiaProcesso"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:TipologiaOperazione"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:ProcFile/ns:ID_PROCSO_FILE"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:ProcFile/ns:ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;/ns:ProcFile&gt;&lt;ns:FileProcessato&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessato/ns:COD_OLO"&gt;&lt;ns:COD_OLO&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessato/ns:COD_OLO"/&gt;&lt;/ns:COD_OLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM"&gt;&lt;ns:CODFC_OLO_AGCOM&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM"/&gt;&lt;/ns:CODFC_OLO_AGCOM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessato/ns:DATA_FILE"&gt;&lt;ns:DATA_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessato/ns:DATA_FILE"/&gt;&lt;/ns:DATA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessato/ns:DESCR_STATO_FILE"&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessato/ns:DESCR_STATO_FILE"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessato/ns:ESITO"&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessato/ns:ESITO"/&gt;&lt;/ns:ESITO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessato/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessato/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessato/ns:ID_INTRFC"&gt;&lt;ns:ID_INTRFC&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessato/ns:ID_INTRFC"/&gt;&lt;/ns:ID_INTRFC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE"&gt;&lt;ns:IDTPLG_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE"/&gt;&lt;/ns:IDTPLG_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessato/ns:NOME_FILE"&gt;&lt;ns:NOME_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessato/ns:NOME_FILE"/&gt;&lt;/ns:NOME_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"&gt;&lt;ns:TIMSTP_APERTURA_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"/&gt;&lt;/ns:TIMSTP_APERTURA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessato/ns:VERSO_DEL_FILE"&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessato/ns:VERSO_DEL_FILE"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessato&gt;&lt;ns:FileProcessatoInput&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:DATA_ARRIVO"&gt;&lt;ns:DATA_ARRIVO&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:DATA_ARRIVO"/&gt;&lt;/ns:DATA_ARRIVO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:DIMENSIONE_FILE"&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:DIMENSIONE_FILE"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO"&gt;&lt;ns:ID_CAUS_SCARTO&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO"/&gt;&lt;/ns:ID_CAUS_SCARTO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT"&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_KO"&gt;&lt;ns:QT_RECD_KO&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_KO"/&gt;&lt;/ns:QT_RECD_KO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_OK"&gt;&lt;ns:QT_RECD_OK&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_OK"/&gt;&lt;/ns:QT_RECD_OK&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_TOTALI"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_TOTALI"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoInput&gt;&lt;ns:EsecuzioneFile&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:EsecuzioneFile/ns:COD_PROCSO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:EsecuzioneFile/ns:COD_PROCSO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:EsecuzioneFile/ns:ID_PROCSO_FILE"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:EsecuzioneFile/ns:ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:EsecuzioneFile/ns:STATO_ESEC"&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:EsecuzioneFile/ns:STATO_ESEC"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB"&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB"&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:if&gt;&lt;/ns:EsecuzioneFile&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns: