                        <bpws:source linkName="Output_Log_counterToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Invoke_Counter/part1/ns6:contaRecord_Output/ns6:out='KO' or($Invoke_Counter/part1/ns6:contaRecord_Output/ns6:out='OK' and$Invoke_Counter/part1/ns6:contaRecord_Output/ns6:NumeroRecord=0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
