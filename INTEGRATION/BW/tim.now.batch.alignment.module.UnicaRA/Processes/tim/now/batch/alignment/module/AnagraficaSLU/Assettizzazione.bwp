                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; xmlns:tns1=&quot;http://www.example.org/Assettizzazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ProcessLoggerTrack-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:DataIn>&lt;tns:Update>&lt;tns:InputFile>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($Start/tns1:ID_FILE)&quot;/>&lt;/tns:ID_FILE>&lt;tns:STATO_ESEC>&lt;xsl:value-of select=&quot;'PROCESSO ESEGUITO CON ERRORE'&quot;/>&lt;/tns:STATO_ESEC>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:ESITO>&lt;tns:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&lt;/tns:DESCR_STATO_FILE>&lt;tns:LOG_MESSAGE>&lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE INPUT CORROTTO&amp;quot;&quot;/>&lt;/tns:LOG_MESSAGE>&lt;/tns:InputFile>&lt;/tns:Update>&lt;/tns:DataIn>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
