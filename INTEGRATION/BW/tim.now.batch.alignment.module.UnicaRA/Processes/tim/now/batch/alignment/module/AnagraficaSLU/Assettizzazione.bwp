                                    <tibex:inputBindings>

                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Assettizzazione&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource_JMS/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;caseModelVersion&quot;/>&#xa;    &lt;xsl:param name=&quot;caseType&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectIDRisorsa&quot;/>&#xa;    &lt;xsl:param name=&quot;i&quot;/>&#xa;    &lt;xsl:template name=&quot;FindCase-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:FindCaseJMS_Align>&#xa;            &lt;tns1:IdFile>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:ID_FILE&quot;/>&#xa;            &lt;/tns1:IdFile>&#xa;            &lt;tns1:TotaliRecord>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Start/tns:NumTotRecord,'.'))&quot;/>&#xa;            &lt;/tns1:TotaliRecord>&#xa;            &lt;tns1:FindCaseJMS_Align_Input>&#xa;                &lt;tns1:caseModelVersion>&#xa;                    &lt;xsl:value-of select=&quot;$caseModelVersion&quot;/>&#xa;                &lt;/tns1:caseModelVersion>&#xa;                &lt;tns1:caseType>&#xa;                    &lt;xsl:value-of select=&quot;$caseType&quot;/>&#xa;                &lt;/tns1:caseType>&#xa;                &lt;tns1:Criteria>&#xa;                    &lt;tns1:queryString>&#xa;                        &lt;xsl:value-of select=&quot;'IDRisorsa=:ID'&quot;/>&#xa;                    &lt;/tns1:queryString>&#xa;                    &lt;tns1:NamedParameterAssigned>&#xa;                        &lt;tns1:name>&#xa;                            &lt;xsl:value-of select=&quot;'ID'&quot;/>&#xa;                        &lt;/tns1:name>&#xa;                        &lt;xsl:if test=&quot;$SelectIDRisorsa/Record[number($i)]/ID_RISORSA_UNICA_RA&quot;>&#xa;                            &lt;tns1:value>&#xa;                                &lt;xsl:value-of select=&quot;$SelectIDRisorsa/Record[number($i)]/ID_RISORSA_UNICA_RA&quot;/>&#xa;                            &lt;/tns1:value>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns1:NamedParameterAssigned>&#xa;                &lt;/tns1:Criteria>&#xa;            &lt;/tns1:FindCaseJMS_Align_Input>&#xa;        &lt;/tns1:FindCaseJMS_Align>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
