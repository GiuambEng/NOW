                <bpws:link name="Iterate2ToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFiles_IDULLCOToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="ListFiles_SLUToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CallProcessToIterate" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess1ToIterate2" tibex:linkType="SUCCESS"/>
                <bpws:link name="TimerToListFiles1" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToIterate1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Iterate1ToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFiles_FFToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="TimerToListFiles_BonificaCAB" tibex:linkType="SUCCESS"/>
