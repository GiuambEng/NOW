    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToListFiles" tibex:linkType="SUCCESS"/>
                <bpws:link name="TimerToListFiles2" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFiles_IDULLCOToIterate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ListFiles_SLUToIterate2" tibex:linkType="SUCCESSWITHCONDITION"/>
