                        <bpws:source linkName="Output_Log_counterToLog_KO_Counter">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$JMSReceiveMessage/Body/ns45:queueResponse/ns45:EsitoConteggio='KO' or($JMSReceiveMessage/Body/ns45:queueResponse/ns45:EsitoConteggio='OK' and$JMSReceiveMessage/Body/ns45:queueResponse/ns45:NumeroRecord=0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$JMSReceiveMessage/Body/ns45:queueResponse/ns45:EsitoConteggio='KO' or($JMSReceiveMessage/Body/ns45:queueResponse/ns45:EsitoConteggio='OK' and$JMSReceiveMessage/Body/ns45:queueResponse/ns45:NumeroRecord=0)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Output_Log_counterToThrow">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$JMSReceiveMessage/Body/ns45:queueResponse/ns45:EsitoConteggio='ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
