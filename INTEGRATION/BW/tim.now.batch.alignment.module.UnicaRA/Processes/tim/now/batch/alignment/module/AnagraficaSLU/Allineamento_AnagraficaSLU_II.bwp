                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NOME_STAG_ANAG_SLU&quot;/>&lt;xsl:param name=&quot;Offset&quot;/>&lt;xsl:param name=&quot;MoveFile&quot;/>&lt;xsl:param name=&quot;NomeFileScarto_SLU&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;PathFileError&quot;/>&lt;xsl:param name=&quot;PathFileScarto&quot;/>&lt;xsl:template name=&quot;MapDetails-input&quot; match=&quot;/&quot;>&lt;tns:Details>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;NomeFileScarto&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$NomeFileScarto_SLU&quot;/>&lt;/tns:VALORE>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;ErrorPathFile&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$PathFileError&quot;/>&lt;/tns:VALORE>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;PathFileScarto&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$PathFileScarto&quot;/>&lt;/tns:VALORE>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;DestinationPathFile&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$MoveFile&quot;/>&lt;/tns:VALORE>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;NameFile&amp;quot;&quot;/>&lt;/tns:NOME>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;/>&lt;/tns:VALORE>&lt;/xsl:if>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;NomeTabellaScarto&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$NOME_STAG_ANAG_SLU&quot;/>&lt;/tns:VALORE>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;SourcePathFile&amp;quot;&quot;/>&lt;/tns:NOME>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;/>&lt;/tns:VALORE>&lt;/xsl:if>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;Offset&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$Offset&quot;/>&lt;/tns:VALORE>&lt;/tns:InputDetails>&lt;/tns:Details>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
