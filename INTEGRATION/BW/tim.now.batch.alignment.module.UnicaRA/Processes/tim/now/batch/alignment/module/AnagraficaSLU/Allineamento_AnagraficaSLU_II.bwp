                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:ns1=&quot;www.tim.now.subProcessMigrzioneSLU&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.org/tim.now.schema.xsd.NOW_AnagraficaUnicaSLU_Tracciato&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;Passo_SLU&quot;/>&lt;xsl:param name=&quot;OK_ELAB_RECORD&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;DetailNoval&quot;/>&lt;xsl:param name=&quot;DetailUltimiNoval&quot;/>&lt;xsl:template name=&quot;InsStag-input&quot; match=&quot;/&quot;>&lt;ns1:Input>&lt;ns1:InfoFile>&lt;ns1:NomeFile>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;/>&lt;/ns1:NomeFile>&lt;ns1:StartRecord>&lt;xsl:value-of select=&quot;($index - 1) * $Passo_SLU + 2&quot;/>&lt;/ns1:StartRecord>&lt;ns1:Passo>&lt;xsl:value-of select=&quot;$Passo_SLU&quot;/>&lt;/ns1:Passo>&lt;/ns1:InfoFile>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:COD_PROCSO_FILE&quot;>&lt;ns1:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:COD_PROCSO_FILE&quot;/>&lt;/ns1:COD_PROCSO_FILE>&lt;/xsl:if>&lt;ns1:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&lt;/ns1:ID_FILE>&lt;ns1:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ns1:ID_ESEC_PROCSO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimiNoval/Rows/tns:AnagraficaUnicaSlu_Dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoval/Rows/tns:AnagraficaUnicaSlu_Dettaglio&quot;>&lt;ns1:Record>&lt;ns1:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;concat(tns:Tipo_record, '|#',tns:ID_RISORSA,'|#',tns:DEC_ATT,'|#',tns:DEC_CES)&quot;/>&lt;/ns1:CONTENUTO_RECD>&lt;xsl:if test=&quot;tns:DEC_ATT&quot;>&lt;ns1:DEC_ATTIVAZIONE>&lt;xsl:value-of select=&quot;tns:DEC_ATT&quot;/>&lt;/ns1:DEC_ATTIVAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DEC_CES&quot;>&lt;ns1:DEC_CESSAZIONE>&lt;xsl:value-of select=&quot;tns:DEC_CES&quot;/>&lt;/ns1:DEC_CESSAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ID_RISORSA&quot;>&lt;ns1:ID_RISORSA_UNICA_RA>&lt;xsl:value-of select=&quot;tns:ID_RISORSA&quot;/>&lt;/ns1:ID_RISORSA_UNICA_RA>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&lt;ns1:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&lt;/ns1:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;ns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:integer($OK_ELAB_RECORD)&quot;/>&lt;/ns1:ID_STATO_ELAB_STAG>&lt;ns1:NUMERO_RECD>&lt;xsl:value-of select=&quot;(($Passo_SLU* ($index - 1)) + position())&quot;/>&lt;/ns1:NUMERO_RECD>&lt;/ns1:Record>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimiNoval/Rows/tns:AnagraficaUnicaSlu_Dettaglio&quot;>&lt;ns1:Record>&lt;ns1:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;concat(tns:Tipo_record,'|#', tns:ID_RISORSA,'|#',tns:DEC_ATT,'|#',tns:DEC_CES)&quot;/>&lt;/ns1:CONTENUTO_RECD>&lt;xsl:if test=&quot;tns:DEC_ATT&quot;>&lt;ns1:DEC_ATTIVAZIONE>&lt;xsl:value-of select=&quot;tns:DEC_ATT&quot;/>&lt;/ns1:DEC_ATTIVAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DEC_CES&quot;>&lt;ns1:DEC_CESSAZIONE>&lt;xsl:value-of select=&quot;tns:DEC_CES&quot;/>&lt;/ns1:DEC_CESSAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ID_RISORSA&quot;>&lt;ns1:ID_RISORSA_UNICA_RA>&lt;xsl:value-of select=&quot;tns:ID_RISORSA&quot;/>&lt;/ns1:ID_RISORSA_UNICA_RA>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&lt;ns1:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&lt;/ns1:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;ns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:integer($OK_ELAB_RECORD)&quot;/>&lt;/ns1:ID_STATO_ELAB_STAG>&lt;ns1:NUMERO_RECD>&lt;xsl:value-of select=&quot;(($Passo_SLU* ($index - 1)) + position())&quot;/>&lt;/ns1:NUMERO_RECD>&lt;/ns1:Record>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns1:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
