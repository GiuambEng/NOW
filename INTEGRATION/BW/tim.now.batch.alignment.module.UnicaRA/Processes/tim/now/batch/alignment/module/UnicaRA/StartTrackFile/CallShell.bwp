    xmlns:ns1="http://tns.tibco.com/bw/activity/externalcommand/xsd"
    xmlns:ns2="http://www.tim.com/NOW/xsd/GenericLogger"
    xmlns:ns3="http://tns.tibco.com/bw/palette/internal/errorlinkhandler+e88b3100-1cb5-4a40-863f-7b4dab56ddfe"
    xmlns:ns4="http://www.tim.com/NOW/xsd/ShellCommand"
