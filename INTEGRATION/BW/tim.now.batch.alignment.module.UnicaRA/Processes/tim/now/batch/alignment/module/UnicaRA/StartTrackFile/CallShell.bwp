    name="tim.now.batch.alignment.module.UnicaRA.StartTrackFile.CallShell"
    suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20190618121653"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
