                                    <bpws:targets>
                                    <bpws:target linkName="Mapper1ToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>DettaglioRecord</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="ControlloDettaglio-input"
                                    name="ControlloDettaglio"
                                    outputVariable="ControlloDettaglio"
                                    tibex:xpdlId="51f2f91a-502a-4d29-b130-6860d4d5e7e0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToAssign"/>
                                    <bpws:source
                                    linkName="MapperToAssign1"
                                    tibex:faultDetailsVar="ControlloDettaglio" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoIDULLCO_TIM_CheckSingoloRecord/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoIDULLCO_TIM_subProcess&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;ControlloDettaglio-input&quot; match=&quot;/&quot;>&lt;tns:IDULLCO_TIM_Dettaglio>&lt;tns:IDULLCO>&lt;xsl:value-of select=&quot;$currentElement/tns1:IDULLCO&quot;/>&lt;/tns:IDULLCO>&lt;tns:OLO>&lt;xsl:value-of select=&quot;$currentElement/tns1:OLO&quot;/>&lt;/tns:OLO>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$currentElement/tns1:CLLI&quot;/>&lt;/tns:CLLI>&lt;tns:DATA_CONSEGNA_OLO>&lt;xsl:value-of select=&quot;$currentElement/tns1:DATA_CONSEGNA_OLO&quot;/>&lt;/tns:DATA_CONSEGNA_OLO>&lt;xsl:if test=&quot;$currentElement/tns1:DATA_FINE_VALIDITA&quot;>&lt;tns:DATA_FINE_VALIDITA>&lt;xsl:value-of select=&quot;$currentElement/tns1:DATA_FINE_VALIDITA&quot;/>&lt;/tns:DATA_FINE_VALIDITA>&lt;/xsl:if>&lt;tns:DATA_INVIO>&lt;xsl:value-of select=&quot;$currentElement/tns1:DATA_INVIO&quot;/>&lt;/tns:DATA_INVIO>&lt;tns:Nome>&lt;xsl:value-of select=&quot;$currentElement/tns1:Nome&quot;/>&lt;/tns:Nome>&lt;xsl:if test=&quot;$currentElement/tns1:DRCP&quot;>&lt;tns:DRCP>&lt;xsl:value-of select=&quot;$currentElement/tns1:DRCP&quot;/>&lt;/tns:DRCP>&lt;/xsl:if>&lt;tns:Codice_GAT>&lt;xsl:value-of select=&quot;$currentElement/tns1:Codice_GAT&quot;/>&lt;/tns:Codice_GAT>&lt;xsl:if test=&quot;$currentElement/tns1:TIPO_COLOCAZIONE&quot;>&lt;tns:Tipo_Colocazione>&lt;xsl:value-of select=&quot;$currentElement/tns1:TIPO_COLOCAZIONE&quot;/>&lt;/tns:Tipo_Colocazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:Numero_record&quot;>&lt;tns:Numero_record>&lt;xsl:value-of select=&quot;$currentElement/tns1:Numero_record&quot;/>&lt;/tns:Numero_record>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:FlagValidita&quot;>&lt;tns:FlagValidita>&lt;xsl:value-of select=&quot;$currentElement/tns1:FlagValidita&quot;/>&lt;/tns:FlagValidita>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:ID_FILE&quot;>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;$currentElement/tns1:ID_FILE&quot;/>&lt;/tns:ID_FILE>&lt;/xsl:if>&lt;/tns:IDULLCO_TIM_Dettaglio>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:AllineamentoIDULLCO_TIM_CheckSingoloRecord="http://www.tim.com/NOW/xsd/AllineamentoIDULLCO_TIM_CheckSingoloRecord/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="AllineamentoIDULLCO_TIM_CheckSingoloRecord:IDULLCO_TIM_Dettaglio" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="DettaglioRecord-input"
                                    name="DettaglioRecord"
                                    outputVariable="DettaglioRecord"
                                    tibex:xpdlId="233ba18e-18d4-4542-9ff7-88b43b76b49f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToMapper1"/>
                                    <bpws:target linkName="Assign1ToMapper1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
