            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns0:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:AllineamentoIDULLCO_Dettaglio" name="VarInputStaging"/>
        <bpws:variable name="OK_ELAB_STAGING" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Tipologiche/StatoElabStaging/OK_ELABORAZIONE_STAGING" type="xsd:string"/>
        <bpws:variable name="KO_ELAB_STAGING" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Tipologiche/StatoElabStaging/KO_ELABORAZIONE_STAGING" type="xsd:string"/>
        <bpws:variable element="ns9:AccumulatedOutput" name="Accumulate" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns1:Response" name="Reply-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns10:CW_BUS_MESSAGE"
            name="StartLog-input" sca-bpel:internal="true"/>
        <bpws:variable name="LogLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/ConfigurationLog/LogLevel" type="xsd:string"/>
        <bpws:variable name="LoggerName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/ConfigurationLog/LoggerName" type="xsd:string"/>
        <bpws:variable element="ns10:CW_BUS_MESSAGE" name="End-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns10:CW_BUS_MESSAGE"
            name="CallProcess-input" sca-bpel:internal="true"/>
        <bpws:variable name="Timeout" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/JDBCPerformance/Timeout" type="xsd:int"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="IterateToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpdateStagingToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToIterate" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToUpdateStaging" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToReply" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:receive createInstance="yes" name="Start"
                operation="Invoke" partnerLink="MigrazioneIDULLCO"
                portType="ns1:MigrazioneIDULLCO"
                tibex:xpdlId="39077368-9909-4a4d-b5f5-1686d4bd087e" variable="InvokeIn">
                <bpws:sources>
                    <bpws:source linkName="StartToCallProcess"/>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:receive>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UpdateStaging-input"
                    name="UpdateStaging" outputVariable="UpdateStaging"
                    tibex:xpdlId="3f11015b-d495-46ee-bcb9-e6054d06ba38" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToUpdateStaging"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdateStagingToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3f11015b-d495-46ee-bcb9-e6054d06ba38+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.com/log/InsertStagingIDULLCO_Allineamento/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;UpdateStaging-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Accumulate/ns:AllineamentoIDULLCO_Dettaglio&quot;>&lt;Record>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(ns:DESCR_ERRORE)>0&quot;>&lt;DESCR_ERRORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:DESCR_ERRORE)&quot;>&lt;xsl:value-of select=&quot;ns:DESCR_ERRORE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_ERRORE xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_STATO_ELAB_STAG>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:ID_STATO_ELAB_STAG)&quot;>&lt;xsl:value-of select=&quot;ns:ID_STATO_ELAB_STAG&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_STATO_ELAB_STAG>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal(ns:ID_FILE_PROCSTO_INPUT)&quot;/>&lt;/ID_FILE_PROCSTO_INPUT>&lt;NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:decimal(ns:NUMERO_RECD)&quot;/>&lt;/NUMERO_RECD>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE STAG_CLC_IDULLCO_FILE&#xa;  SET DESCR_ERRORE = ?, ID_STATO_ELAB_STAG = TO_NUMBER(?,'9')&#xa;  WHERE ID_FILE_PROCSTO_INPUT = ? AND NUMERO_RECD = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_ERRORE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_STATO_ELAB_STAG"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE_PROCSTO_INPUT"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="NUMERO_RECD"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="3413ee91-52d5-4a7f-b1a0-956856edfdd3">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToCallProcess"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+37397c47-697a-448d-8ebe-35fb0a30b87f" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$InvokeIn/part1/tns:IDULLCO_TIM/tns:IDULLCO_TIM_Dettaglio" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($InvokeIn.part1/tns:IDULLCO_TIM_Dettaglio)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="tns:IDULLCO_TIM_Dettaglio"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link name="MapperToAssign" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="MapperToAssign1" tibex:linkType="ERROR"/>
                                    <bpws:link name="AssignToMapper1" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="Assign1ToMapper1" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="GroupStartToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="Mapper1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="f243a508-c7da-4585-8c50-33f245628c7e" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToMapper"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($InvokeIn.part1/tns:IDULLCO_TIM_Dettaglio)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
