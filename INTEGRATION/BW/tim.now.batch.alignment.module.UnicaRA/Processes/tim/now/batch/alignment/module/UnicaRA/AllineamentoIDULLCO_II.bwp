                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="FaultToJDBCUpdate" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCUpdateToExit2" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCUpdateToEmpty" tibex:linkType="ERROR"/>
                            <bpws:link name="EmptyToMoveError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="MoveErrorToCallProcess2" tibex:linkType="SUCCESS"/>
                            <bpws:link name="CallProcess2ToCallProcess3" tibex:linkType="SUCCESS"/>
                            <bpws:link name="CallProcess3ToExit2" tibex:linkType="SUCCESS"/>
