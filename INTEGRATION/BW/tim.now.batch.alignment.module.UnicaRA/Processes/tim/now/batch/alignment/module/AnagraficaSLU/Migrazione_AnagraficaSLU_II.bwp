                                    <bpws:source linkName="RenameFile1ToExit"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_PathFileError&quot;/>&lt;xsl:param name=&quot;Details&quot;/>&lt;xsl:template name=&quot;RenameFile1-input&quot; match=&quot;/&quot;>&lt;tns:RenameActivityConfig>&lt;xsl:if test=&quot;$Details/ns1:InputDetails[ns1:NOME='SourcePathFile']/ns1:VALORE&quot;>&lt;fromFileName>&lt;xsl:value-of select=&quot;$Details/ns1:InputDetails[ns1:NOME='SourcePathFile']/ns1:VALORE&quot;/>&lt;/fromFileName>&lt;/xsl:if>&lt;toFileName>&lt;xsl:value-of select=&quot;$Var_PathFileError&quot;/>&lt;/toFileName>&lt;/tns:RenameActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
