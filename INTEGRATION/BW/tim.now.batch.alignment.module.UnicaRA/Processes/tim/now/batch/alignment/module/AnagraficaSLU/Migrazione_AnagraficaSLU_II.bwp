                                    messageQName="pt:Conta_Response" wsdlLocation="platform:/resource/tim.now.batch.alignment.module.UnicaRA/Service%20Descriptors/Concrete/Conta_concrete_Retail.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="contaRecord:contaRecord_Output"
                                    partName="part1" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <context>
                                    <inputMapping/>
                                    <outputMapping direction="OUTPUT"/>
                                    </context>
                                </operationConfiguration>
                                <outboundConfiguration
                                    httpClient="tim.now.batch.alignment.module.UnicaRA.HttpClientResource" xsi:type="axis2:HttpTransportConfiguration"/>
                            </scaext:binding>
                            <scact:bindingAdjunct bindingName="SOAPReferenceBinding"/>
                        </referenceBinding>
