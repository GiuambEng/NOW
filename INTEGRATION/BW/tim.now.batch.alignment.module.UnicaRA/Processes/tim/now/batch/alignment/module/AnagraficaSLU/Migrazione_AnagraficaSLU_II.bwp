                                wsdlLocation="platform:/resource/tim.now.batch.alignment.module.UnicaRA/Service%20Descriptors/Concrete/Conta_concrete_Retail.wsdl" xsi:type="axis2:SOAPReferenceBinding">
                                <bindingType style="DOCUMENT"/>
                                <operationConfiguration
