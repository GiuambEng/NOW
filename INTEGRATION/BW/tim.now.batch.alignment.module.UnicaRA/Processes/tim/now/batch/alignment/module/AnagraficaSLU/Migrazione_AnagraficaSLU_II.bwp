            <bpws:from>
                <bpws:literal>ERROR_AnagraficaSLU_NOW_TO_UNICARA_</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns50:inputs"
            name="JDBCCallAllineamento-input" sca-bpel:internal="true"/>
