                                    name="DettaglioRecord"
                                    outputVariable="DettaglioRecord"
                                    tibex:xpdlId="bb49452e-a198-448a-9d90-170cc3228bca" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToMapper1"/>
                                    <bpws:target linkName="Assign1ToMapper1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/log/InsertStagingIDSLUCO_Allineamento/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VarInputStaging&quot;/>&lt;xsl:template name=&quot;DettaglioRecord-input&quot; match=&quot;/&quot;>&lt;tns:AllineamentoIDSLUCO>&lt;tns:AllineamentoIDSLUCO_Dettaglio>&lt;xsl:if test=&quot;$VarInputStaging/tns:COD_CLLI_CENTRALE&quot;>&lt;tns:COD_CLLI_CENTRALE>&lt;xsl:value-of select=&quot;$VarInputStaging/tns:COD_CLLI_CENTRALE&quot;/>&lt;/tns:COD_CLLI_CENTRALE>&lt;/xsl:if>&lt;xsl:if test=&quot;$VarInputStaging/tns:CODFC_OLO_AGCOM&quot;>&lt;tns:CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;$VarInputStaging/tns:CODFC_OLO_AGCOM&quot;/>&lt;/tns:CODFC_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$VarInputStaging/tns:CONTENUTO_RECD&quot;>&lt;tns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$VarInputStaging/tns:CONTENUTO_RECD&quot;/>&lt;/tns:CONTENUTO_RECD>&lt;/xsl:if>&lt;xsl:if test=&quot;$VarInputStaging/tns:COPPIA_A&quot;>&lt;tns:COPPIA_A>&lt;xsl:value-of select=&quot;$VarInputStaging/tns:COPPIA_A&quot;/>&lt;/tns:COPPIA_A>&lt;/xsl:if>&lt;xsl:if test=&quot;$VarInputStaging/tns:COPPIA_DA&quot;>&lt;tns:COPPIA_DA>&lt;xsl:value-of select=&quot;$VarInputStaging/tns:COPPIA_DA&quot;/>&lt;/tns:COPPIA_DA>&lt;/xsl:if>&lt;xsl:if test=&quot;$VarInputStaging/tns:DATAINZ_VALID&quot;>&lt;tns:DATAINZ_VALID>&lt;xsl:value-of select=&quot;$VarInputStaging/tns:DATAINZ_VALID&quot;/>&lt;/tns:DATAINZ_VALID>&lt;/xsl:if>&lt;xsl:if test=&quot;$VarInputStaging/tns:DATA_INVIO_RICH&quot;>&lt;tns:DATA_INVIO_RICH>&lt;xsl:value-of select=&quot;$VarInputStaging/tns:DATA_INVIO_RICH&quot;/>&lt;/tns:DATA_INVIO_RICH>&lt;/xsl:if>&lt;xsl:if test=&quot;$VarInputStaging/tns:DESCR_ERRORE&quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;$VarInputStaging/tns:DESCR_ERRORE&quot;/>&lt;/tns:DESCR_E