                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="ControlloDettaglio-input"
                                    name="ControlloDettaglio"
                                    outputVariable="ControlloDettaglio"
                                    tibex:xpdlId="6610675a-033f-4abd-a415-87a3f6d6d920" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToAssign"/>
                                    <bpws:source
                                    linkName="MapperToAssign1"
                                    tibex:faultDetailsVar="ControlloDettaglio" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoIDSLUCO_TIM_CheckSingoloRecord&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoIDSLUCO_TIM_subProcess&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;ControlloDettaglio-input&quot; match=&quot;/&quot;>&lt;tns:IDSLUCO_TIM_Dettaglio>&lt;tns:IDSLUCO>&lt;xsl:value-of select=&quot;$currentElement/tns1:IDSLUCO&quot;/>&lt;/tns:IDSLUCO>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$currentElement/tns1:OPERATORE&quot;/>&lt;/tns:OPERATORE>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$currentElement/tns1:CLLI&quot;/>&lt;/tns:CLLI>&lt;tns:DATA_CONSEGNA_OLO>&lt;xsl:value-of select=&quot;$currentElement/tns1:DATA_CONSEGNA_OLO&quot;/>&lt;/tns:DATA_CONSEGNA_OLO>&lt;tns:ID_RICHIESTA>&lt;xsl:value-of select=&quot;xsd:int($currentElement/tns1:ID_RICHIESTA)&quot;/>&lt;/tns:ID_RICHIESTA>&lt;tns:COPPIA_DA>&lt;xsl:value-of select=&quot;$currentElement/tns1:COPPIA_DA&quot;/>&lt;/tns:COPPIA_DA>&lt;tns:COPPIA_A>&lt;xsl:value-of select=&quot;$currentElement/tns1:COPPIA_A&quot;/>&lt;/tns:COPPIA_A>&lt;tns:DATA_INVIO>&lt;xsl:value-of select=&quot;$currentElement/tns1:DATA_INVIO&quot;/>&lt;/tns:DATA_INVIO>&lt;tns:TESTARMADIO>&lt;xsl:value-of select=&quot;$currentElement/tns1:TESTARMADIO&quot;/>&lt;/tns:TESTARMADIO>&lt;xsl:if test=&quot;$currentElement/tns1:Numero_record&quot;>&lt;tns:Numero_record>&lt;xsl:value-of select=&quot;$currentElement/tns1:Numero_record&quot;/>&lt;/tns:Numero_record>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:FlagValidita&quot;>&lt;tns:FlagValidita>&lt;xsl:value-of select=&quot;$currentElement/tns1:FlagValidita&quot;/>&lt;/tns:FlagValidita>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:ID_FILE&quot;>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;$currentElement/tns1:ID_FILE&quot;/>&lt;/tns:ID_FILE>&lt;/xsl:if>&lt;/tns:IDSLUCO_TIM_Dettaglio>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
