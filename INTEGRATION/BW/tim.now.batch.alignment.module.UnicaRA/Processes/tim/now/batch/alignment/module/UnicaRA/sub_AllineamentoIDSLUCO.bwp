                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($InvokeIn.part1/tns:IDSLUCO_TIM_Dettaglio)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="tns:IDSLUCO_TIM_Dettaglio"
                                    name="currentElement" sca-bpel:internal="true"/>
