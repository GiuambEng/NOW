                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+55d43405-ec5f-4224-b6e2-2ad9e2f5bde9+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns0=&quot;http://www.example.org/InputStagingAnagraficaGPON&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Variable1&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Variable1/tns0:InputStagingAnagraficaGPON&quot;>&lt;Record>&lt;IDENTIFICATIVO_GPON>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns0:IDGPON)&quot;>&lt;xsl:value-of select=&quot;tns0:IDGPON&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDENTIFICATIVO_GPON>&lt;CODICE_AREA_CENTRALE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns0:CODICEAREACENTRALE)&quot;>&lt;xsl:value-of select=&quot;tns0:CODICEAREACENTRALE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_AREA_CENTRALE>&lt;PUNTO_INTERCONNESSIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns0:PUNTOINTERCONNESSIONE)&quot;>&lt;xsl:value-of select=&quot;tns0:PUNTOINTERCONNESSIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PUNTO_INTERCONNESSIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 and (tns0:OLO='FWE' or tns0:OLO='FWB')&quot;>&lt;CODIFICA_OLO_AGCOM>&lt;xsl:value-of select=&quot;'MTW'&quot;/>&lt;/CODIFICA_OLO_AGCOM>&lt;/xsl:when>&