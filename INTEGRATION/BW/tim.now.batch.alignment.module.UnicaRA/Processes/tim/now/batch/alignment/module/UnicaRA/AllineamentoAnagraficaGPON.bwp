                                    <bpws:source linkName="Input_StagingToCallProcess1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns0=&quot;http://www.example.org/InputStagingAnagraficaGPON&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/RecuperoAnagraficaGPON&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo_AnagraficaGPON&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoRecord&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable1&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns2:RecuperoAnagraficaGPON)=0&quot;>&#xa;                &lt;tns0:AnagraficaGPONStaging>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns2:RecuperoAnagraficaGPON&quot;>&#xa;                        &lt;tns0:InputStagingAnagraficaGPON>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_AnagraficaGPON * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns2:IDGPON&quot;>&#xa;                                &lt;tns0:IDGPON>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:IDGPON&quot;/>&#xa;                                &lt;/tns0:IDGPON>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:CODICEAREACENTRALE&quot;>&#xa;                                &lt;tns0:CODICEAREACENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:CODICEAREACENTRALE&quot;/>&#xa;                                &lt;/tns0:CODICEAREACENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:PUNTOINTERCONNESSIONE&quot;>&#xa;                                &lt;tns0:PUNTOINTERCONNESSIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:PUNTOINTERCONNESSIONE&quot;/>&#xa;                                &lt;/tns0:PUNTOINTERCONNESSIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:OLO&quot;>&#xa;                                &lt;tns0:OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:OLO&quot;/>&#xa;                                &lt;/tns0:OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:TIPOACCESSO&quot;>&#xa;                                &lt;tns0:TIPOACCESSO>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:TIPOACCESSO&quot;/>&#xa;                                &lt;/tns0:TIPOACCESSO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:COINVESTIMENTO&quot;>&#xa;                                &lt;tns0:COINVESTIMENTO>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:COINVESTIMENTO&quot;/>&#xa;                                &lt;/tns0:COINVESTIMENTO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:FATTORE_DI_SPLITTING&quot;>&#xa;                                &lt;tns0:FATTORE_DI_SPLITTING>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:FATTORE_DI_SPLITTING&quot;/>&#xa;                                &lt;/tns0:FATTORE_DI_SPLITTING>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:DATA_REG_FATTORE_SPLITTING&quot;>&#xa;                                &lt;tns0:DATA_REG_FATTORE_SPLITTING>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:DATA_REG_FATTORE_SPLITTING&quot;/>&#xa;                                &lt;/tns0:DATA_REG_FATTORE_SPLITTING>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;>&#xa;                                &lt;tns0:CONTENUTORECORD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;/>&#xa;                                &lt;/tns0:CONTENUTORECORD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns0:NUMERORECORD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/tns0:NUMERORECORD>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&#xa;                                &lt;tns0:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&#xa;                                &lt;/tns0:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns0:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                            &lt;/tns0:ID_STATO_ELAB_STAG>&#xa;                            &lt;tns0:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns0:TMSP_INSMTO>&#xa;                        &lt;/tns0:InputStagingAnagraficaGPON>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns0:AnagraficaGPONStaging>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns0:AnagraficaGPONStaging>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns2:RecuperoAnagraficaGPON&quot;>&#xa;                        &lt;tns0:InputStagingAnagraficaGPON>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo_AnagraficaGPON * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns2:IDGPON&quot;>&#xa;                                &lt;tns0:IDGPON>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:IDGPON&quot;/>&#xa;                                &lt;/tns0:IDGPON>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:CODICEAREACENTRALE&quot;>&#xa;                                &lt;tns0:CODICEAREACENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:CODICEAREACENTRALE&quot;/>&#xa;                                &lt;/tns0:CODICEAREACENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:PUNTOINTERCONNESSIONE&quot;>&#xa;                                &lt;tns0:PUNTOINTERCONNESSIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:PUNTOINTERCONNESSIONE&quot;/>&#xa;                                &lt;/tns0:PUNTOINTERCONNESSIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:OLO&quot;>&#xa;                                &lt;tns0:OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:OLO&quot;/>&#xa;                                &lt;/tns0:OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:TIPOACCESSO&quot;>&#xa;                                &lt;tns0:TIPOACCESSO>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:TIPOACCESSO&quot;/>&#xa;                                &lt;/tns0:TIPOACCESSO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:COINVESTIMENTO&quot;>&#xa;                                &lt;tns0:COINVESTIMENTO>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:COINVESTIMENTO&quot;/>&#xa;                                &lt;/tns0:COINVESTIMENTO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:FATTORE_DI_SPLITTING&quot;>&#xa;                                &lt;tns0:FATTORE_DI_SPLITTING>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:FATTORE_DI_SPLITTING&quot;/>&#xa;                                &lt;/tns0:FATTORE_DI_SPLITTING>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:DATA_REG_FATTORE_SPLITTING&quot;>&#xa;                                &lt;tns0:DATA_REG_FATTORE_SPLITTING>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:DATA_REG_FATTORE_SPLITTING&quot;/>&#xa;                                &lt;/tns0:DATA_REG_FATTORE_SPLITTING>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;>&#xa;                                &lt;tns0:CONTENUTORECORD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;/>&#xa;                                &lt;/tns0:CONTENUTORECORD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns0:NUMERORECORD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/tns0:NUMERORECORD>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&#xa;                                &lt;tns0:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&#xa;                                &lt;/tns0:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns0:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                            &lt;/tns0:ID_STATO_ELAB_STAG>&#xa;                            &lt;tns0:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns0:TMSP_INSMTO>&#xa;                        &lt;/tns0:InputStagingAnagraficaGPON>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns0:AnagraficaGPONStaging>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
