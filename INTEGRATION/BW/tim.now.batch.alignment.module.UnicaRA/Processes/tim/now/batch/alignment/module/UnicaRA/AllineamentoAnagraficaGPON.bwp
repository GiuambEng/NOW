                                    inputVariable="Variable1"
                                    name="Input_Staging"
                                    outputVariable="Variable1"
                                    tibex:xpdlId="73599cd2-0419-4253-b63f-43ed865e2adc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
