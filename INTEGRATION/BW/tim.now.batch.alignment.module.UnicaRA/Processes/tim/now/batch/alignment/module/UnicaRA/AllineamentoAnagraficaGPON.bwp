                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.STAG_ANAGRAFICA_GPON_FL (IDENTIFICATIVO_GPON,&#xa;  CODICE_AREA_CENTRALE, PUNTO_INTERCONNESSIONE, CODIFICA_OLO_AGCOM,&#xa;  TIPO_ACCESSO, COINVESTIMENTO, FATTORE_SPLITTING, DT_REG_FATTORE_SPLITTING,&#xa;  ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG, NUMERO_RECORD, TIMESTAMP_INS,&#xa;  CONTENUTO_RECORD)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)))" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDENTIFICATIVO_GPON"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_AREA_CENTRALE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PUNTO_INTERCONNESSIONE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICA_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO_ACCESSO"/>

