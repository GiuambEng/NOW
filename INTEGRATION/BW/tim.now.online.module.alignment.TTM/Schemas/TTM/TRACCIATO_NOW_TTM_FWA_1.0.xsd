<xs:schema xmlns="http://www.openaccess.it/assurancewholesale/will/" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.openaccess.it/assurancewholesale/will/" elementFormDefault="unqualified" attributeFormDefault="unqualified">
	<xs:element name="REQUEST">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="IDRISORSA">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="16"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="SERVIZIO">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="FIXEDWIRELESSACCESS"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="MSISDN" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="50"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="IMEI" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="50"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="IMSI" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="50"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RESPONSE">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ESITO">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="OK"/>
							<xs:enumeration value="KO"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="CODICE_ESITO" maxOccurs="1" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="1"/>
							<xs:enumeration value="2"/>
							<xs:enumeration value="3"/>
							<xs:enumeration value="4"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
