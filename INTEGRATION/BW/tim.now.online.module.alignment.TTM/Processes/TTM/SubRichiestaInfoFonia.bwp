t=&quot;string-length($JDBCCallProcedure/outputSet/TESTATA/DEC_TECNICA)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/DEC_TECNICA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/DEC_TECNICA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/DEC_TECNICA)&quot;>&#xa;                                        &lt;DEC_TECNICA>&#xa;                                            &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/DEC_TECNICA&quot;/>&#xa;                                        &lt;/DEC_TECNICA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;CODE_GEST>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/CODE_GEST&quot;/>&#xa;                                &lt;/CODE_GEST>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/TIPO_COLOCAZIONE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/TIPO_COLOCAZIONE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/TIPO_COLOCAZIONE)&quot;>&#xa;                                    &lt;TIPO_COLOCAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/TIPO_COLOCAZIONE&quot;/>&#xa;                                    &lt;/TIPO_COLOCAZIONE>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/ID_RISORSA_CO_SL/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/ID_RISORSA_CO_SL/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/ID_RISORSA_CO_SL)&quot;>&#xa;                                    &lt;ID_RISORSA_CO_SL>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/ID_RISORSA_CO_SL&quot;/>&#xa;                                    &lt;/ID_RISORSA_CO_SL>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/ID_RISORSA_PA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/ID_RISORSA_PA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/ID_RISORSA_PA)&quot;>&#xa;                                    &lt;ID_RISORSA_PA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/ID_RISORSA_PA&quot;/>&#xa;                                    &lt;/ID_RISORSA_PA>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/POS_SL_CP1/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/POS_SL_CP1/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/POS_SL_CP1)&quot;>&#xa;                                    &lt;POS_SL_CP1>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/POS_SL_CP1&quot;/>&#xa;                                    &lt;/POS_SL_CP1>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/POS_SL_CP2/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/POS_SL_CP2/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/POS_SL_CP2)&quot;>&#xa;                                    &lt;POS_SL_CP2>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/POS_SL_CP2&quot;/>&#xa;                                    &lt;/POS_SL_CP2>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/CODE_SEDE_GAT/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/CODE_SEDE_GAT/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/CODE_SEDE_GAT)&quot;>&#xa;                                    &lt;CODE_SEDE_GAT>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/CODE_SEDE_GAT&quot;/>&#xa;                                    &lt;/CODE_SEDE_GAT>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/BIT_RATE_UP_TI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/BIT_RATE_UP_TI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/BIT_RATE_UP_TI)&quot;>&#xa;                                    &lt;BIT_RATE_UP_TI>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/BIT_RATE_UP_TI&quot;/>&#xa;                                    &lt;/BIT_RATE_UP_TI>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/BIT_RATE_UP_OLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/BIT_RATE_UP_OLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/BIT_RATE_UP_OLO)&quot;>&#xa;                                    &lt;BIT_RATE_UP_OLO>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/BIT_RATE_UP_OLO&quot;/>&#xa;                                    &lt;/BIT_RATE_UP_OLO>&#xa;         