                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_TTM_FONIA/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/TTM_FONIA/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FONIAIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCCallProcedure&quot;/>&#xa;    &lt;xsl:template name=&quot;FONIAOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$JDBCCallProcedure/outputSet/CODICE_ESITO='0' &quot;>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;TESTATA>&#xa;                        &lt;ID_RISORSA_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/ID_RISORSA_CRMWS&quot;/>&#xa;                        &lt;/ID_RISORSA_CRMWS>&#xa;                        &lt;CODICE_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/CODICE_ESITO&quot;/>&#xa;                        &lt;/CODICE_ESITO>&#xa;                        &lt;DESC_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/DESC_ESITO&quot;/>&#xa;                        &lt;/DESC_ESITO>&#xa;                    &lt;/TESTATA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FONIAIn.parameters/RESOURCE/TIPO_SERV='CPS'&quot;>&#xa;                            &lt;CPS>&#xa;                                &lt;DN>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/DN&quot;/>&#xa;                                &lt;/DN>&#xa;                                &lt;STATO_SISTEMA>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/STATO_SISTEMA&quot;/>&#xa;                                &lt;/STATO_SISTEMA>&#xa;                                &lt;STATO_PS>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/STATO_PS&quot;/>&#xa;                                &lt;/STATO_PS>&#xa;                                &lt;DATA_ULTIMA_MOVIMENTAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/DATA_ULTIMA_MOVIMETAZIONE&quot;/>&#xa;                                &lt;/DATA_ULTIMA_MOVIMENTAZIONE>&#xa;                                &lt;CODE_GEST>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/CODE_GEST&quot;/>&#xa;                                &lt;/CODE_GEST>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/TESTATA/CODE_CARRIIER)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/CODE_CARRIIER/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/CODE_CARRIIER/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/CODE_CARRIIER)&quot;>&#xa;                                            &lt;CODE_CARRIER>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/CODE_CARRIIER&quot;/>&#xa;                                            &lt;/CODE_CARRIER>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/CPS>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;REGOLATORIO>&#xa;                                &lt;ID_RISORSA_TTM>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/ID_RISORSA_TTM&quot;/>&#xa;                                &lt;/ID_RISORSA_TTM>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/DEST_USO_OLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/DEST_USO_OLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/DEST_USO_OLO)&quot;>&#xa;                                    &lt;DEST_USO_OLO>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/DEST_USO_OLO&quot;/>&#xa;                                    &lt;/DEST_USO_OLO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/NUM_COPPIE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/NUM_COPPIE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/NUM_COPPIE)&quot;>&#xa;                                    &lt;NUM_COPPIE>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/NUM_COPPIE&quot;/>&#xa;                                    &lt;/NUM_COPPIE>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/DN/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/DN/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/DN)&quot;>&#xa;                                    &lt;DN>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/DN&quot;/>&#xa;                          