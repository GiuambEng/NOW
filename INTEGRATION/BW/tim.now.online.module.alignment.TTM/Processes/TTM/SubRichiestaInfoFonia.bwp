                          &lt;CAP_CF>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/CAP_CF&quot;/>&#xa;                                    &lt;/CAP_CF>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/NUM_CIVICO_CF/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/NUM_CIVICO_CF/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/NUM_CIVICO_CF)&quot;>&#xa;                                    &lt;NUM_CIVICO_CF>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/NUM_CIVICO_CF&quot;/>&#xa;                                    &lt;/NUM_CIVICO_CF>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/COMPLESSO_CF/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/COMPLESSO_CF/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/COMPLESSO_CF)&quot;>&#xa;                                    &lt;COMPLESSO_CF>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/COMPLESSO_CF&quot;/>&#xa;                                    &lt;/COMPLESSO_CF>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/TESTATA/SCALA_CF/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/TESTATA/SCALA_CF/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/TESTATA/SCALA_CF)&quot;>&#xa;                                    &lt;SCALA_CF>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/TESTATA/SCALA_C