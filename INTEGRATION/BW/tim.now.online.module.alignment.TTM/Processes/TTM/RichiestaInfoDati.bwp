                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;ResponseError&quot;/>&lt;xsl:template name=&quot;LogResponseError-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'RichiestaInfoDati'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($ResponseError, true(),true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/StagingTTMFONIA&quot; xmlns:ns2=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ResponseError&quot;/>&#xa;    &lt;xsl:param name=&quot;Error&quot;/>&#xa;    &lt;xsl:template name=&quot;StagError-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:INPUT>&#xa;            &lt;tns2:Update>&#xa;                &lt;tns2:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ResponseError, true(),true())&quot;/>&#xa;                &lt;/tns2:CONTENUTO_RESPONSE>&#xa;                &lt;tns2:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns2:TIMSTP_RISPOSTA>&#xa;                &lt;tns2:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;'21'&quot;/>&#xa;                &lt;/tns2:ID_STATO_ELAB_STAG>&#xa;                &lt;xsl:if test=&quot;$Error/part1/ns2:Output/ns2:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                    &lt;tns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Error/part1/ns2:Output/ns2:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                    &lt;/tns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:COD_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($ResponseError/testata/codice_esito)&quot;/>&#xa;                &lt;/tns2:COD_ESITO>&#xa;                &lt;tns2:DESCR_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;$ResponseError/testata/desc_esito&quot;/>&#xa;                &lt;/tns2:DESCR_ESITO>&#xa;            &lt;/tns2:Update>&#xa;        &lt;/tns2:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="StagError-input"
                                name="StagError"
                                tibex:xpdlId="7dc1621a-93a7-4094-bb86-5b0f1af6ab12"
