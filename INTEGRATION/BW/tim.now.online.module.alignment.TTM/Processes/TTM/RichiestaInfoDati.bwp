                        &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer(substring-before($ProcessInstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, &amp;quot;.&amp;quot;))"/&gt;
