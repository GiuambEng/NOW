            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:JMS>&#xa;            &lt;/tns4:LogInfo>&#xa;            &lt;tns4:InputDataUserLog>&#xa;                &lt;tns4:APPLICAZIONE_CLIENT>&#xa;                    &lt;xsl:value-of select=&quot;'RICHIESTA ONLINE INFO DATI DA TTM A NOW'&quot;/>&#xa;                &lt;/tns4:APPLICAZIONE_CLIENT>&#xa;                &lt;tns4:COD_FUNZIONE>&#xa;                    &lt;xsl:value-of select=&quot;'Monitoraggio Accessi M2M'&quot;/>&#xa;                &lt;/tns4:COD_FUNZIONE>&#xa;                &lt;tns4:COD_PROFILO>&#xa;                    &lt;xsl:value-of select=&quot;'M2M'&quot;/>&#xa;                &lt;/tns4:COD_PROFILO>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns3:remoteaddress&quot;>&#xa;                    &lt;tns4:HOSTNAME_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns3:remoteaddress&quot;/>&#xa;                    &lt;/tns4:HOSTNAME_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns3:remoteaddress&quot;>&#xa;                    &lt;tns4:IP_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns3:remoteaddress&quot;/>&#xa;                    &lt;/tns4:IP_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns2:IPAddress&quot;>&#xa;                    &lt;tns4:IP_SERVER>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns2:IPAddress&quot;/>&#xa;                    &lt;/tns4:IP_SERVER>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:OS_USER>&#xa;                    &lt;xsl:value-of select=&quot;bw:getSystemProperty(&amp;quot;os.name&amp;quot;)&quot;/>&#xa;                &lt;/tns4:OS_USER>&#xa;                &lt;tns4:SERVER_NAME>&#xa;                    &lt;xsl:value-of select=&quot;bw:getHostName()&quot;/>&#xa;                &lt;/tns4:SERVER_NAME>&#xa;                &lt;tns4:COD_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;'TTM_INFO_DATI_OL'&quot;/>&#xa;                &lt;/tns4:COD_INTRFC>&#xa;                &lt;tns4:SESSION_ID>&#xa;                    &lt;xsl:value-of select=&quot;concat('RichiestaInfoDati_',$DATIIn.parameters/resource/id_risorsa)&quot;/>&#xa;                &lt;/tns4:SESSION_ID>&#xa;                &lt;tns4:TIPO_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LOGIN&amp;quot;&quot;/>&#xa;                &lt;/tns4:TIPO_OPERAZIONE>&#xa;                &lt;tns4:SISTEMA_CHIAMANTE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;TTM&amp;quot;&quot;/>&#xa;                &lt;/tns4:SISTEMA_CHIAMANTE>&#xa;                &lt;xsl:if test=&quot;$ProcessInstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                    &lt;tns4:ID_ESE_PROC_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ProcessInstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                    &lt;/tns4:ID_ESE_PROC_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:NOME_TAB_STAGING>&#xa;                    &lt;xsl:value-of select=&quot;'STAG_TTM_TO_NOW_NO_FILE'&quot;/>&#xa;                &lt;/tns4:NOME_TAB_STAGING>&#xa;            &lt;/tns4:InputDataUserLog>&#xa;        &lt;/tns4:LoggerSecurityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
