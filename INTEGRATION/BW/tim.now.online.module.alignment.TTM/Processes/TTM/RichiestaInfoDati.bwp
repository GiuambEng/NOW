                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/StagingTTMFONIA&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IviaEsitoOk&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessInstance&quot;/>&#xa;    &lt;xsl:param name=&quot;Response_OK&quot;/>&#xa;    &lt;xsl:template name=&quot;UpStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:INPUT>&#xa;            &lt;tns2:Update>&#xa;                &lt;tns2:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Response_OK)&quot;/>&#xa;                &lt;/tns2:CONTENUTO_RESPONSE>&#xa;                &lt;tns2:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns2:TIMSTP_RISPOSTA>&#xa;                &lt;tns2:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$IviaEsitoOk&quot;/>&#xa;                &lt;/tns2:ID_STATO_ELAB_STAG>&#xa;                &lt;tns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessInstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/tns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;tns2:COD_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Response_OK/testata/codice_esito)&quot;/>&#xa;                &lt;/tns2:COD_ESITO>&#xa;                &lt;tns2:DESCR_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;$Response_OK/testata/desc_esito&quot;/>&#xa;                &lt;/tns2:DESCR_ESITO>&#xa;            &lt;/tns2:Update>&#xa;        &lt;/tns2:INP