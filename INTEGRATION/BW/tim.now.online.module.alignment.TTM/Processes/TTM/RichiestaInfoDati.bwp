            <bpws:invoke inputVariable="SecurityLogger-input"
                name="SecurityLogger" operation="NewOperation"
                outputVariable="SecurityLogger"
                partnerLink="LogAccessiUtenti"
                portType="ns2:ServiceSecurity" tibex:xpdlId="f9c0397a-3a2b-4e9f-b969-968608bf1b64">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tibco.com/LoggerServiceSecurityDataServices/" xmlns:tns4="http://www.example.org/ServicesSecurityData" xmlns:ns3="www.tim.now.HeaderConnection" xmlns:ns="http://www.openaccess.it/wholesale/manager/" xmlns:tns2="http://www.example.com/namespaces/tns/1564740682912" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:bw="http://www.tibco.com/bw/xpath/bw-custom-functions" version="2.0"&gt;
    &lt;xsl:param name="LoggerName"/&gt;
    &lt;xsl:param name="LogLevel"/&gt;
    &lt;xsl:param name="GetContext"/&gt;
    &lt;xsl:param name="DATIIn"/&gt;
    &lt;xsl:param name="GetLocalIP"/&gt;
    &lt;xsl:param name="ProcessInstance"/&gt;
    &lt;xsl:template name="SecurityLogger-input" match="/"&gt;
        &lt;tns3:NewOperationRequest&gt;
            &lt;parameters&gt;
                &lt;tns4:LoggerSecurityInput&gt;
                    &lt;tns4:LogInfo&gt;
                        &lt;tns4:LoggerName&gt;
                            &lt;xsl:value-of select="$LoggerName"/&gt;
                        &lt;/tns4:LoggerName&gt;
                        &lt;tns4:Application&gt;
                            &lt;xsl:value-of select="$LoggerName"/&gt;
                        &lt;/tns4:Application&gt;
                        &lt;tns4:LogLevel&gt;
                            &lt;xsl:value-of select="$LogLevel"/&gt;
                        &lt;/tns4:LogLevel&gt;
                        &lt;tns4:ServiceName&gt;
                            &lt;xsl:value-of select="'NOW_TTM_DATI'"/&gt;
                        &lt;/tns4:ServiceName&gt;
                        &lt;tns4:Operation&gt;
                            &lt;xsl:value-of select="'DATI'"/&gt;
                        &lt;/tns4:Operation&gt;
                        &lt;tns4:JMS&gt;
                            &lt;xsl:value-of select="false()"/&gt;
                        &lt;/tns4:JMS&gt;
                    &lt;/tns4:LogInfo&gt;
                    &lt;tns4:InputDataUserLog&gt;
                        &lt;tns4:APPLICAZIONE_CLIENT&gt;
                            &lt;xsl:value-of select="'RICHIESTA ONLINE INFO DATI DA TTM A NOW'"/&gt;
                        &lt;/tns4:APPLICAZIONE_CLIENT&gt;
                        &lt;tns4:COD_FUNZIONE&gt;
                            &lt;xsl:value-of select="'Monitoraggio Accessi M2M'"/&gt;
                        &lt;/tns4:COD_FUNZIONE&gt;
                        &lt;tns4:COD_PROFILO&gt;
                            &lt;xsl:value-of select="'M2M'"/&gt;
                        &lt;/tns4:COD_PROFILO&gt;
                        &lt;xsl:if test="$GetContext/ns3:remoteaddress"&gt;
                            &lt;tns4:HOSTNAME_CLIENT&gt;
                                &lt;xsl:value-of select="$GetContext/ns3:remoteaddress"/&gt;
                            &lt;/tns4:HOSTNAME_CLIENT&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$GetContext/ns3:remoteaddress"&gt;
                            &lt;tns4:IP_CLIENT&gt;
                                &lt;xsl:value-of select="$GetContext/ns3:remoteaddress"/&gt;
                            &lt;/tns4:IP_CLIENT&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$GetLocalIP/tns2:IPAddress"&gt;
                            &lt;tns4:IP_SERVER&gt;
                                &lt;xsl:value-of select="$GetLocalIP/tns2:IPAddress"/&gt;
                            &lt;/tns4:IP_SERVER&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns4:OS_USER&gt;
                            &lt;xsl:value-of select="bw:getSystemProperty(&amp;quot;os.name&amp;quot;)"/&gt;
                        &lt;/tns4:OS_USER&gt;
                        &lt;tns4:SERVER_NAME&gt;
                            &lt;xsl:value-of select="bw:getHostName()"/&gt;
                        &lt;/tns4:SERVER_NAME&gt;
                        &lt;tns4:COD_INTRFC&gt;
                            &lt;xsl:value-of select="'TTM_INFO_DATI_OL'"/&gt;
                        &lt;/tns4:COD_INTRFC&gt;
                        &lt;tns4:SESSION_ID&gt;
                            &lt;xsl:value-of select="concat('RichiestaInfoDati_',$DATIIn/parameters/ns:ResourceRequest/resource/id_risorsa)"/&gt;
                        &lt;/tns4:SESSION_ID&gt;
                        &lt;tns4:TIPO_OPERAZIONE&gt;
                            &lt;xsl:value-of select="&amp;quot;LOGIN&amp;quot;"/&gt;
                        &lt;/tns4:TIPO_OPERAZIONE&gt;
                        &lt;tns4:SISTEMA_CHIAMANTE&gt;
                            &lt;xsl:value-of select="&amp;quot;TTM&amp;quot;"/&gt;
                        &lt;/tns4:SISTEMA_CHIAMANTE&gt;
                        &lt;xsl:if test="$ProcessInstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;
