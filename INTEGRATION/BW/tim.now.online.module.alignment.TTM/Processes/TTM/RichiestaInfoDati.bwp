            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.example.org/RequestNOWtoCRMWS&quot; xmlns:ns=&quot;http://www.openaccess.it/wholesale/manager/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ProcessInstance&quot;/>&lt;xsl:param name=&quot;DATIIn&quot;/>&lt;xsl:template name=&quot;CallWSDP-input&quot; match=&quot;/&quot;>&lt;tns1:ResourceRequestNOWtoCRMWS>&lt;tns1:RESOURCE>&lt;tns1:ID_RISORSA>&lt;xsl:value-of select=&quot;$DATIIn/parameters/ns:ResourceRequest/resource/id_risorsa&quot;/>&lt;/tns1:ID_RISORSA>&lt;tns1:TIPO_SERV>&lt;xsl:value-of select=&quot;$DATIIn/parameters/ns:ResourceRequest/resource/tipo_serv&quot;/>&lt;/tns1:TIPO_SERV>&lt;/tns1:RESOURCE>&lt;xsl:if test=&quot;$ProcessInstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&lt;tns1:TTM_RICHIESTA>&lt;xsl:value-of select=&quot;$ProcessInstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&lt;/tns1:TTM_RICHIESTA>&lt;/xsl:if>&lt;/tns1:ResourceRequestNOWtoCRMWS>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CallWSDP-input" name="CallWSDP"
                    outputVariable="CallWSDP"
