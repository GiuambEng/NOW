                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;LogErrorRischiestaInfoDati-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'RichiestaInfoDati'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(),true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:invoke inputVariable="Error-input"
                            name="Error" operation="Invoke"
                            outputVariable="Error"
                            partnerLink="GestioneErrore"
                            portType="ns8:GenericError" tibex:xpdlId="0f5fc0ea-37c4-4c78-953f-c50caa170820">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/1469551322714" xmlns:ns2="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:param name="ProcessInstance"/&gt;
    &lt;xsl:template name="Error-input" match="/"&gt;
        &lt;tns2:Input&gt;
            &lt;part1&gt;
                &lt;ns2:Input&gt;
                    &lt;ns2:ActivityName&gt;
                        &lt;xsl:value-of select="'RichiestaInfoDati'"/&gt;
                    &lt;/ns2:ActivityName&gt;
                    &lt;ns2:Error&gt;
                        &lt;ns2:ActivityName&gt;
                            &lt;xsl:value-of select="$FaultDetails/ActivityName"/&gt;
                        &lt;/ns2:ActivityName&gt;
                        &lt;xsl:for-each select="$FaultDetails/Data"&gt;
                            &lt;ns2:Data/&gt;
                        &lt;/xsl:for-each&gt;
                        &lt;ns2:Msg&gt;
                            &lt;xsl:value-of select="$FaultDetails/Msg"/&gt;
                        &lt;/ns2:Msg&gt;
                        &lt;ns2:MsgCode&gt;
                            &lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;
                        &lt;/ns2:MsgCode&gt;
                        &lt;ns2:ProcessStack&gt;
                            &lt;xsl:value-of select="$FaultDetails/ProcessStack"/&gt;
                        &lt;/ns2:ProcessStack&gt;
                        &lt;ns2:StackTrace&gt;
                            &lt;xsl:value-of select="$FaultDetails/StackTrace"/&gt;
                        &lt;/ns2:StackTrace&gt;
                    &lt;/ns2:Error&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($ProcessInstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;
                            &lt;xsl:if test="$ProcessInstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;
                                &lt;ns2:ID_Esec_Proc&gt;
                                    &lt;xsl:value-of select="$ProcessInstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;
                                &lt;/ns2:ID_Esec_Proc&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                    &lt;ns2:ID_PROCSO_NOFILE&gt;
                        &lt;xsl:value-of select="69"/&gt;
                    &lt;/ns2:ID_PROCSO_NOFILE&gt;
                &lt;/ns2:Input&gt;
            &lt;/part1&gt;
        &lt;/tns2:Input&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns2=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessInstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:Input>&#xa;            &lt;ns2:ActivityName>&#xa;                &lt;xsl:value-of select=&quot;'RichiestaInfoDati'&quot;/>&#xa;            &lt;/ns2:ActivityName>&#xa;            &lt;ns2:Error>&#xa;                &lt;ns2:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ActivityName&quot;/>&#xa;                &lt;/ns2:ActivityName>&#xa;                &lt;xsl:for-each select=&quot;$FaultDetails/Data&quot;>&#xa;                    &lt;ns2:Data/>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;ns2:Msg>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                &lt;/ns2:Msg>&#xa;                &lt;ns2:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/ns2:MsgCode>&#xa;                &lt;ns2:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                &lt;/ns2:ProcessStack>&#xa;                &lt;ns2:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                &lt;/ns2:StackTrace>&#xa;            &lt;/ns2:Error>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ProcessInstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessInstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns2:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessInstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns2:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns2:ID_PROCSO_NOFILE>&#xa;                &lt;xsl:value-of select=&quot;69&quot;/>&#xa;            &lt;/ns2:ID_PROCSO_NOFILE>&#xa;        &lt;/ns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="CallProcessToInvoke"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="InvokeToMapper"/>
                                <bpws:source
                                    linkName="InvokeToCallProcess4"
                                    tibex:faultDetailsVar="Error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                        </bpws:invoke>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.openaccess.it/wholesale/manager/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DATIIn&quot;/>&#xa;    &lt;xsl:template name=&quot;ResponseError-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:ResourceResponse>&#xa;            &lt;testata>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($DATIIn/parameters/ns:ResourceRequest/resource/id_risorsa)>0&quot;>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$DATIIn/parameters/ns:ResourceRequest/resource/id_risorsa&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;'NULL'&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;codice_esito>&#xa;                    &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                &lt;/codice_esito>&#xa;                &lt;desc_esito>&#xa;                    &lt;xsl:value-of select=&quot;'Errore interno al NOW'&quot;/>&#xa;                &lt;/desc_esito>&#xa;            &lt;/testata>&#xa;        &lt;/ns:ResourceResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="ResponseError-input"
                                name="ResponseError"
                                outputVariable="ResponseError"
                                tibex:xpdlId="be43e071-7b95-4225-990f-baea9989956d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="InvokeToMapper"/>
                                    <bpws:target linkName="CallProcess4ToMapper"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="MapperToCallProcess1"/>
                                    <bpws:source linkName="MapperToCallProcess2"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.openaccess.it/wholesale/manager/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DATIIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ResponseError-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:ResourceResponse>&#xa;            &lt;testata>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($DATIIn.parameters/resource/id_risorsa)>0&quot;>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$DATIIn.parameters/resource/id_risorsa&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;'NULL'&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;codice_esito>&#xa;                    &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                &lt;/codice_esito>&#xa;                &lt;desc_esito>&#xa;                    &lt;xsl:value-of select=&quot;'Errore interno al NOW'&quot;/>&#xa;                &lt;/desc_esito>&#xa;            &lt;/testata>&#xa;        &lt;/ns:ResourceResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
