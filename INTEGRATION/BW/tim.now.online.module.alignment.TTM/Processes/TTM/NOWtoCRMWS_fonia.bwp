                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RequestNOWtoCRMWS&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/NOW_Sub/TTMNOWREG&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CRMWS.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ResourceResponseFonia>&#xa;            &lt;tns:TESTATA>&#xa;                &lt;tns:ID_RISORSA_CRMWS>&#xa;                    &lt;xsl:value-of select=&quot;$CRMWS.part1/TESTATA/ID_RISORSA_CRMWS&quot;/>&#xa;                &lt;/tns:ID_RISORSA_CRMWS>&#xa;                &lt;tns:CODICE_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;$CRMWS.part1/TESTATA/CODICE_ESITO&quot;/>&#xa;                &lt;/tns:CODICE_ESITO>&#xa;                &lt;tns:DESC_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;$CRMWS.part1/TESTATA/DESC_ESITO&quot;/>&#xa;                &lt;/tns:DESC_ESITO>&#xa;            &lt;/tns:TESTATA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CRMWS.part1/CPS/DN)>0&quot;>&#xa;                    &lt;tns:CPS>&#xa;                        &lt;tns:DN>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWS.part1/CPS/DN&quot;/>&#xa;                        &lt;/tns:DN>&#xa;                        &lt;tns:STATO_SISTEMA>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWS.part1/CPS/STATO_SISTEMA&quot;/>&#xa;                        &lt;/tns:STATO_SISTEMA>&#xa;                        &lt;tns:STATO_PS>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWS.part1/CPS/STATO_PS&quot;/>&#xa;                        &lt;/tns:STATO_PS>&#xa;                        &lt;tns:DATA_ULTIMA_MOVIMENTAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWS.part1/CPS/DATA_ULTIMA_