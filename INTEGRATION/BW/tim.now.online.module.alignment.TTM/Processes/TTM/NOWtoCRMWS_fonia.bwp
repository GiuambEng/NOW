            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp3:ProcessLog"/>
            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType2">
                <plnk:role name="use" portType="ptyp4:GetResourceNow"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://xmlns.example.com/1481886334901"/>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/ProcessLog"/>
            <wsdl:import namespace="http://xmlns.example.com/1496391054893"/>
        </wsdl:definitions>
    </tibex:Types>
