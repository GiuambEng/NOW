                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="StartLog-input"
                    name="StartLog"
                    tibex:xpdlId="1ab6d5c9-c8c5-4689-a4f1-4c2e04df4e9f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartLogToJDBCUpdate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:Insert/ns0:ID_ESEC_PROCSO_NO_FILE)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Start/ns0:Insert/ns0:ID_ESEC_PROCSO_NO_FILE)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartLogToJDBCUpdate1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:Update/ns0:ID_ESEC_PROCSO_NO_FILE)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Start/ns0:Update/ns0:ID_ESEC_PROCSO_NO_FILE)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartLogToJDBCUpdate2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:UpdateOnError/ns0:ID_ESEC_PROCSO_NO_FILE)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
