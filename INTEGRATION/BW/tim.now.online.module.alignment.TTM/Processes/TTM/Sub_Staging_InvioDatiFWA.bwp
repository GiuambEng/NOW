    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartLogToJDBCUpdate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartLogToJDBCUpdate1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartLogToJDBCUpdate2" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="JDBCUpdateToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCUpdate1ToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCUpdate2ToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpdateOnErrorStagingToCallProcess" tibex:linkType="ERROR"/>
                <bpws:link name="CallProcessToEnd1" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartLogToEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="b6af784c-d173-4e77-814f-38418aa22310"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
