            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if ($FlagTransitorio ='Y') then 'NOW'&#xd;&#xa;&#xd;&#xa;else if ($ESITO_NOW='3' and $ESITO_CRMWS='3') then 'ERRORE'&#xd;&#xa;else if ($ESITO_NOW ='3' and $ESITO_CRMWS !='3') then 'CRMWS'&#xd;&#xa;else if ($ESITO_CRMWS ='3' and $ESITO_NOW !='3') then 'NOW'&#xd;&#xa;&#xd;&#xa;else if ($ESITO_CRMWS =('1','2') and $ESITO_NOW ='0') then 'NOW'&#xd;&#xa;else if ($ESITO_CRMWS ='0' and $ESITO_NOW =('1','2')) then 'CRMWS'&#xd;&#xa;else if (($ESITO_CRMWS ='1' and $ESITO_NOW ='1') or  ($ESITO_CRMWS ='2' and $ESITO_NOW ='2')) then 'INDIFFERENTE'&#xd;&#xa;else if ($ESITO_CRMWS ='2' and $ESITO_NOW ='1') then 'NOW'&#xd;&#xa;else if ($ESITO_CRMWS ='1' and $ESITO_NOW ='2') then 'NOW'&#xd;&#xa;&#xd;&#xa;else if ($ESITO_CRMWS ='0' and $ESITO_NOW ='0') &#xd;&#xa;        then (if($FONIAIn/parameters/ns7:ResourceRequest/RESOURCE/TIPO_SERV='CPS') then 'NOW' else&#xd;&#xa;&#x9;&#x9;if ($SubRichiestaInfoFonia/parameters/ns7:ResourceResponse/REGOLATORIO/CODE_STATO =('9','6','99')) then 'CRMWS' &#xd;&#xa;                  else if ($ChiamataAlCRMWS/ns14:REGOLATORIO/ns14:CODE_STATO =('9','6','99')) then 'NOW'&#xd;&#xa;                  else if ($SubRichiestaInfoFonia/parameters/ns7:ResourceResponse/REGOLATORIO/CODE_STATO =('1','7','10') &#xd;&#xa;                              and  $ChiamataAlCRMWS/ns14:REGOLATORIO/ns14:CODE_STATO =('1','7','10')) then 'CONTROLLO_DES'&#xd;&#xa;                    else 'ERRORE_DECISIONALE_1')&#xd;&#xa;              else 'ERRORE_DECISIONALE_2'"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="RESULT" name="Assign"
                    outputVariable="RESULT"
                    tibex:xpdlId="df61883e-95c5-4fdc-8fc1-9900e3e81c1f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToAssign1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLog_Result"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if ($FlagTransitorio ='Y') then 'NOW'&#xd;&#xa;&#xd;&#xa;else if ($ESITO_NOW='3' and $ESITO_CRMWS='3') then 'ERRORE'&#xd;&#xa;else if ($ESITO_NOW ='3' and $ESITO_CRMWS !='3') then 'CRMWS'&#xd;&#xa;else if ($ESITO_CRMWS ='3' and $ESITO_NOW !='3') then 'NOW'&#xd;&#xa;&#xd;&#xa;else if ($ESITO_CRMWS =('1','2') and $ESITO_NOW ='0') then 'NOW'&#xd;&#xa;else if ($ESITO_CRMWS ='0' and $ESITO_NOW =('1','2')) then 'CRMWS'&#xd;&#xa;else if (($ESITO_CRMWS ='1' and $ESITO_NOW ='1') or  ($ESITO_CRMWS ='2' and $ESITO_NOW ='2')) then 'INDIFFERENTE'&#xd;&#xa;else if ($ESITO_CRMWS ='2' and $ESITO_NOW ='1') then 'NOW'&#xd;&#xa;else if ($ESITO_CRMWS ='1' and $ESITO_NOW ='2') then 'NOW'&#xd;&#xa;&#xd;&#xa;else if ($ESITO_CRMWS ='0' and $ESITO_NOW ='0') &#xd;&#xa;        then (if($FONIAIn.parameters/RESOURCE/TIPO_SERV='CPS') then 'NOW' else&#xd;&#xa;&#x9;&#x9;if ($SubRichiestaInfoFonia.parameters/REGOLATORIO/CODE_STATO =('9','6','99')) then 'CRMWS' &#xd;&#xa;                  else if ($ChiamataAlCRMWS/ns14:REGOLATORIO/ns14:CODE_STATO =('9','6','99')) then 'NOW'&#xd;&#xa;                  else if ($SubRichiestaInfoFonia.parameters/REGOLATORIO/CODE_STATO =('1','7','10') &#xd;&#xa;                              and  $ChiamataAlCRMWS/ns14:REGOLATORIO/ns14:CODE_STATO =('1','7','10')) then 'CONTROLLO_DES'&#xd;&#xa;                    else 'ERRORE_DECISIONALE_1')&#xd;&#xa;              else 'ERRORE_DECISIONALE_2'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="RESULT" xsi:type="generalactivities:BWAssign"/>
