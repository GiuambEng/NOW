                    expression="if (string-length($ChiamataAlCRMWS/ns14:REGOLATORIO/ns14:DEC_TECNICA)>0 and  string-length($SubRichiestaInfoFonia/parameters/ns7:ResourceResponse/REGOLATORIO/DEC_TECNICA)=0) then 'CRMWS'&#xd;&#xa;&#xd;&#xa;else if (string-length($ChiamataAlCRMWS/ns14:REGOLATORIO/ns14:DEC_TECNICA)=0 and  string-length($SubRichiestaInfoFonia/parameters/ns7:ResourceResponse/REGOLATORIO/DEC_TECNICA)>0) then 'NOW'&#xd;&#xa;&#xd;&#xa;else if (string-length($ChiamataAlCRMWS/ns14:REGOLATORIO/ns14:DEC_TECNICA)=0 and  string-length($SubRichiestaInfoFonia/parameters/ns7:ResourceResponse/REGOLATORIO/DEC_TECNICA)=0) then 'NOW'&#xd;&#xa;&#xd;&#xa;else if (string-length($ChiamataAlCRMWS/ns14:REGOLATORIO/ns14:DEC_TECNICA)>0 and  string-length($SubRichiestaInfoFonia/parameters/ns7:ResourceResponse/REGOLATORIO/DEC_TECNICA)>0)&#xd;&#xa;  then (&#xd;&#xa;    if(&#xd;&#xa;    tib:compare-date(xsd:date($ChiamataAlCRMWS/ns14:REGOLATORIO/ns14:DEC_TECNICA),xsd:date($SubRichiestaInfoFonia/parameters/ns7:ResourceResponse/REGOLATORIO/DEC_TECNICA))= (-1,0)&#xd;&#xa;    )&#xd;&#xa;    then 'NOW'&#xd;&#xa;    else 'CRMWS'&#xd;&#xa;   )&#xd;&#xa;else 'ERRORE_DECISIONALE_3'"
