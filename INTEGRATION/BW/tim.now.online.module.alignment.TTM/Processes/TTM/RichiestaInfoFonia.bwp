       &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:JMS>&#xa;            &lt;/tns1:LogInfo>&#xa;            &lt;tns1:InputDataUserLog>&#xa;                &lt;tns1:APPLICAZIONE_CLIENT>&#xa;                    &lt;xsl:value-of select=&quot;'RICHIESTA ONLINE INFO FONIA DA TTM A NOW'&quot;/>&#xa;                &lt;/tns1:APPLICAZIONE_CLIENT>&#xa;                &lt;tns1:COD_FUNZIONE>&#xa;                    &lt;xsl:value-of select=&quot;'Monitoraggio Accessi M2M'&quot;/>&#xa;                &lt;/tns1:COD_FUNZIONE>&#xa;                &lt;tns1:COD_PROFILO>&#xa;                    &lt;xsl:value-of select=&quot;'M2M'&quot;/>&#xa;                &lt;/tns1:COD_PROFILO>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns:remoteaddress&quot;>&#xa;                    &lt;tns1:HOSTNAME_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns:remoteaddress&quot;/>&#xa;                    &lt;/tns1:HOSTNAME_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns:remoteaddress&quot;>&#xa;                    &lt;tns1:IP_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns:remoteaddress&quot;/>&#xa;                    &lt;/tns1:IP_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns2:IPAddress&quot;>&#xa;                    &lt;tns1:IP_SERVER>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns2:IPAddress&quot;/>&#xa;                    &lt;/tns1:IP_SERVER>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:OS_USER>&#xa;                    &lt;xsl:value-of select=&quot;bw:getSystemProperty(&amp;quot;os.name&amp;quot;)&quot;/>&#xa;                &lt;/tns1:OS_USER>&#xa;                &lt;tns1:SERVER_NAME>&#xa;                    &lt;xsl:value-of select=&quot;bw:getHostName()&quot;/>&#xa;                &lt;/tns1:SERVER_NAME>&#xa;                &lt;tns1:COD_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;'TTM_INFO_FONIA_OL'&quot;/>&#xa;                &lt;/tns1:COD_INTRFC>&#xa;                &lt;tns1:SESSION_ID>&#xa;                    &lt;xsl:value-of select=&quot;concat('RichiestaInfoFonia_',$FONIAIn.parameters/RESOURCE/ID_RISORSA)&quot;/>&#xa;                &lt;/tns1:SESSION_ID>&#xa;                &lt;tns1:TIPO_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LOGIN&amp;quot;&quot;/>&#xa;                &lt;/tns1:TIPO_OPERAZIONE>&#xa;                &lt;tns1:SISTEMA_CHIAMANTE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;TTM&amp;quot;&quot;/>&#xa;                &lt;/tns1:SISTEMA_CHIAMANTE>&#xa;                &lt;xsl:if test=&quot;$ProcessIstance.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                    &lt;tns1:ID_ESE_PROC_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ProcessIstance.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                    &lt;/tns1:ID_ESE_PROC_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:NOME_TAB_STAGING>&#xa;                    &lt;xsl:value-of select=&quot;'STAG_TTM_TO_NOW_NO_FILE'&quot;/>&#xa;                &lt;/tns1:NOME_TAB_STAGING>&#xa;            &lt;/tns1:InputDataUserLog>&#xa;        &lt;/tns1:LoggerSecurityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
