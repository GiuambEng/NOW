    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="ad938500-d905-40ad-81bb-ac62cfe22deb">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link
                                name="ErroreRichiestaInfoFoniaToInvoke" tibex:linkType="SUCCESS"/>
                            <bpws:link name="MapperToCallProcess2" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link name="MapperToCallProcess1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            <bpws:link name="CallProcess2ToCallProcess3" tibex:linkType="ERROR"/>
                            <bpws:link name="CallProcess1ToReply" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="CallProcess3ToLogResponseError" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="StagingErrorToLogResponseError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="InvokeToFault" tibex:linkType="ERROR"/>
                            <bpws:link name="CallProcessToResponseError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="InvokeToResponseError" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="ErroreRichiestaInfoFonia-input"
                                name="ErroreRichiestaInfoFonia"
                                tibex:xpdlId="8e625474-09f6-4624-bde8-d37726dd33c5"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="ErroreRichiestaInfoFoniaToInvoke"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;ErroreRichiestaInfoFonia-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'RichiestaInfoFonia'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'NOW_TTM_FONIA'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'FONIA'&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(),true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="LogResponseError-input"
                                name="LogResponseError"
                                tibex:xpdlId="c0f3c1d1-14c3-4d4a-b432-6508d4bba1af"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="MapperToCallProcess1"/>
                                    <bpws:target linkName="StagingErrorToLogResponseError"/>
                                    <bpws:target linkName="CallProcess3ToLogResponseError"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="CallProcess1ToReply"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;ResponseError&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LogResponseError-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'RichiestaInfoFonia'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'NOW_TTM_FONIA'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'FONIA'&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($ResponseError, true(),true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/StagingTTMFONIA&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ResponseError&quot;/>&lt;xsl:param name=&quot;Error&quot;/>&lt;xsl:template name=&quot;StagingError-input&quot; match=&quot;/&quot;>&lt;tns:INPUT>&lt;tns:Update>&lt;tns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($ResponseError, true(),true())&quot;/>&lt;/tns:CONTENUTO_RESPONSE>&lt;tns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_RISPOSTA>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;'21'&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;xsl:if test=&quot;$Error/part1/ns1:Output/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&lt;tns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;$Error/part1/ns1:Output/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&lt;/tns:ID_ESEC_PROCSO_NO_FILE>&lt;/xsl:if>&lt;tns:COD_ESITO>&lt;xsl:value-of select=&quot;xsd:int($ResponseError/TESTATA/CODICE_ESITO)&quot;/>&lt;/tns:COD_ESITO>&lt;tns:DESCR_ESITO>&lt;xsl:value-of select=&quot;$ResponseError/TESTATA/DESC_ESITO&quot;/>&lt;/tns:DESCR_ESITO>&lt;/tns:Update>&lt;/tns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="StagingError-input"
                                name="StagingError"
                                tibex:xpdlId="d78b274f-59fa-4680-a4f6-e7e9440e4db9"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="MapperToCallProcess2"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source
                                    linkName="CallProcess2ToCallProcess3"
                                    tibex:faultDetailsVar="StagingError" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="StagingErrorToLogResponseError"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/StagingTTMFONIA&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Error.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ResponseError&quot;/>&#xa;    &lt;xsl:template name=&quot;StagingError-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:INPUT>&#xa;            &lt;tns:Update>&#xa;                &lt;tns:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ResponseError, true(),true())&quot;/>&#xa;                &lt;/tns:CONTENUTO_RESPONSE>&#xa;                &lt;tns:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_RISPOSTA>&#xa;                &lt;tns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;'21'&quot;/>&#xa;                &lt;/tns:ID_STATO_ELAB_STAG>&#xa;                &lt;xsl:if test=&quot;$Error.part1/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                    &lt;tns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Error.part1/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                    &lt;/tns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:COD_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($ResponseError/TESTATA/CODICE_ESITO)&quot;/>&#xa;                &lt;/tns:COD_ESITO>&#xa;                &lt;tns:DESCR_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;$ResponseError/TESTATA/DESC_ESITO&quot;/>&#xa;                &lt;/tns:DESCR_ESITO>&#xa;            &lt;/tns:Update>&#xa;        &lt;/tns:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    subProcessName="TTM.Sub_Staging" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
