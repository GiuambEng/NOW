_UP_OLO&quot;>&#xa;                                    &lt;BIT_RATE_UP_OLO>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:BIT_RATE_UP_OLO&quot;/>&#xa;                                    &lt;/BIT_RATE_UP_OLO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:NP_NUM_AGG_X_ISDN&quot;>&#xa;                                    &lt;NP_NUM_AGG_X_ISDN>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:NP_NUM_AGG_X_ISDN&quot;/>&#xa;                                    &lt;/NP_NUM_AGG_X_ISDN>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODE_RN&quot;>&#xa;                                    &lt;CODE_RN>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODE_RN&quot;/>&#xa;                                    &lt;/CODE_RN>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODICE_PROGETTO&quot;>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODICE_PROGETTO&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODICE_PIATTAFORMA&quot;>&#xa;                                    &lt;CODICE_PIATTAFORMA>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODICE_PIATTAFORMA&quot;/>&#xa;                                    &lt;/CODICE_PIATTAFORMA>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODICE_CATEGORIA&quot;>&#xa;                                    &lt;CODICE_CATEGORIA>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODICE_CATEGORIA&quot;/>&#xa;                                    &lt;/CODICE_CATEGORIA>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODICE_DELIVERY&quot;>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODICE_DELIVERY&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODICE_IMPRESA&quot;>&#xa;                                    &lt;CODICE_IMPRESA>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODICE_IMPRESA&quot;/>&#xa;                                    &lt;/CODICE_IMPRESA>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:ID_RISORSA_TI&quot;>&#xa;                                    &lt;ID_RISORSA_TI>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:ID_RISORSA_TI&quot;/>&#xa;                                    &lt;/ID_RISORSA_TI>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODE_GEST_WLRH&quot;>&#xa;                                    &lt;CODE_GEST_WLRH>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODE_GEST_WLRH&quot;/>&#xa;                                    &lt;/CODE_GEST_WLRH>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:ID_RISORSA_OLD&quot;>&#xa;                                    &lt;ID_RISORSA_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:ID_RISORSA_OLD&quot;/>&#xa;                                    &lt;/ID_RISORSA_OLD>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:VIRTUAL_ULL&quot;>&#xa;                                    &lt;VIRTUAL_ULL>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:VIRTUAL_ULL&quot;/>&#xa;                                    &lt;/VIRTUAL_ULL>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODE_STATO&quot;>&#xa;                                    &lt;CODE_STATO>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:CODE_STATO&quot;/>&#xa;                                    &lt;/CODE_STATO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:DESC_STATO&quot;>&#xa;                                    &lt;DESC_STATO>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:DESC_STATO&quot;/>&#xa;                                    &lt;/DESC_STATO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:WHOLESALER&quot;>&#xa;                                    &lt;WHOLESALER>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:WHOLESALER&quot;/>&#xa;                                    &lt;/WHOLESALER>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:diffidato&quot;>&#xa;                                    &lt;diffidato>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:REGOLATORIO/tns:diffidato&quot;/>&#xa;                                    &lt;/diffidato>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/REGOLATORIO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CPS>&#xa;                                &lt;DN>&#xa;                                    &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:CPS/tns:DN&quot;/>&#xa;                                &lt;/DN>&#xa;                                &lt;STATO_SISTEMA>&#xa;                                    &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:CPS/tns:STATO_SISTEMA&quot;/>&#xa;                                &lt;/STATO_SISTEMA>&#xa;                                &lt;STATO_PS>&#xa;                                    &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:CPS/tns:STATO_PS&quot;/>&#xa;                                &lt;/STATO_PS>&#xa;                                &lt;DATA_ULTIMA_MOVIMENTAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:CPS/tns:DATA_ULTIMA_MOVIMENTAZIONE&quot;/>&#xa;                                &lt;/DATA_ULTIMA_MOVIMENTAZIONE>&#xa;                                &lt;CODE_GEST>&#xa;                                    &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:CPS/tns:CODE_GEST&quot;/>&#xa;                                &lt;/CODE_GEST>&#xa;                                &lt;xsl:if test=&quot;$ChiamataAlCRMWS/tns:CPS/tns:CODE_CARRIER&quot;>&#xa;                                    &lt;CODE_CARRIER>&#xa;                                        &lt;xsl:value-of select=&quot;$ChiamataAlCRMWS/tns:CPS/tns:CODE_CARRIER&quot;/>&#xa;                                    &lt;/CODE_CARRIER>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/CPS>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ns:ResourceResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;TESTATA>&#xa;                        &lt;ID_RISORSA_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$SubRichiestaInfoFonia.parameters/TESTATA/ID_RISORSA_CRMWS&quot;/>&#xa;                        &lt;/ID_RISORSA_CRMWS>&#xa;                        &lt;CODICE_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$SubRichiestaInfoFonia.parameters/TESTATA/CODICE_ESITO&quot;/>&#xa;                        &lt;/CODICE_ESITO>&#xa;                        &lt;DESC_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$SubRichiestaInfoFonia.parameters/TESTATA/DESC_ESITO&quot;/>&#xa;                        &lt;/DESC_ESITO>&#xa;                    &lt;/TESTATA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SubRichiestaInfoFonia.parameters/REGOLATORIO)&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;$SubRichiestaInfoFonia.parameters/REGOLATORIO&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:copy-of select=&quot;$SubRichiestaInfoFonia.parameters/CPS&quot;/>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ns:ResourceResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
