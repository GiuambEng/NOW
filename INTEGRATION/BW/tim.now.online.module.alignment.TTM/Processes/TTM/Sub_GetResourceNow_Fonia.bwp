                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/NOW_Sub/TTMNOWREG&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/CRMWS/TTMNOWREG&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CrmWs.GetResourceResp&quot;/>&#xa;    &lt;xsl:template name=&quot;ResponseCRMWS&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$CrmWs.GetResourceResp/TESTATA/CODICE_ESITO='3'&quot;>&#xa;                &lt;ns1:ResourceResponse>&#xa;                    &lt;TESTATA>&#xa;                        &lt;ID_RISORSA_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/TESTATA/ID_RISORSA_CRMWS&quot;/>&#xa;                        &lt;/ID_RISORSA_CRMWS>&#xa;                        &lt;CODICE_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/TESTATA/CODICE_ESITO&quot;/>&#xa;                        &lt;/CODICE_ESITO>&#xa;                        &lt;DESC_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/TESTATA/DESC_ESITO&quot;/>&#xa;                        &lt;/DESC_ESITO>&#xa;                    &lt;/TESTATA>&#xa;                &lt;/ns1:ResourceResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns1:ResourceResponse>&#xa;                    &lt;TESTATA>&#xa;                        &lt;ID_RISORSA_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/TESTATA/ID_RISORSA_CRMWS&quot;/>&#xa;                        &lt;/ID_RISORSA_CRMWS>&#xa;                        &lt;CODICE_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/TESTATA/CODICE_ESITO&quot;/>&#xa;                        &lt;/CODICE_ESITO>&#xa;                        &lt;DESC_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/TESTATA/DESC_ESITO&quot;/>&#xa;                        &lt;/DESC_ESITO>&#xa;                    &lt;/TESTATA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($CrmWs.GetResourceResp/CPS/DN)>0&quot;>&#xa;                            &lt;CPS>&#xa;                                &lt;DN>&#xa;                                    &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/CPS/DN&quot;/>&#xa;                                &lt;/DN>&#xa;                                &lt;STATO_SISTEMA>&#xa;                                    &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/CPS/STATO_SISTEMA&quot;/>&#xa;                                &lt;/STATO_SISTEMA>&#xa;                                &lt;STATO_PS>&#xa;                                    &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/CPS/STATO_PS&quot;/>&#xa;                                &lt;/STATO_PS>&#xa;                                &lt;DATA_ULTIMA_MOVIMENTAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/CPS/DATA_ULTIMA_MOVIMENTAZIONE&quot;/>&#xa;                                &lt;/DATA_ULTIMA_MOVIMENTAZIONE>&#xa;                                &lt;CODE_GEST>&#xa;                                    &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/CPS/CODE_GEST&quot;/>&#xa;                                &lt;/CODE_GEST>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/CPS/CODE_CARRIER&quot;>&#xa;                                    &lt;CODE_CARRIER>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/CPS/CODE_CARRIER&quot;/>&#xa;                                    &lt;/CODE_CARRIER>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/CPS>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($CrmWs.GetResourceResp/REGOLATORIO/ID_RISORSA_TTM)>0&quot;>&#xa;                            &lt;REGOLATORIO>&#xa;                                &lt;ID_RISORSA_TTM>&#xa;                                    &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/ID_RISORSA_TTM&quot;/>&#xa;                                &lt;/ID_RISORSA_TTM>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/DEST_USO_OLO&quot;>&#xa;                                    &lt;DEST_USO_OLO>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/DEST_USO_OLO&quot;/>&#xa;                                    &lt;/DEST_USO_OLO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/NUM_COPPIE&quot;>&#xa;                                    &lt;NUM_COPPIE>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/NUM_COPPIE&quot;/>&#xa;                                    &lt;/NUM_COPPIE>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/DN&quot;>&#xa;                                    &lt;DN>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/DN&quot;/>&#xa;                                    &lt;/DN>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/OPZ_NP&quot;>&#xa;                                    &lt;OPZ_NP>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/OPZ_NP&quot;/>&#xa;                                    &lt;/OPZ_NP>&#xa;                                &lt;/xsl:if>&#xa;        