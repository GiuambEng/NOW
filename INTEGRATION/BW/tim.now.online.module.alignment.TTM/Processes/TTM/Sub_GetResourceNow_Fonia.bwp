rmWs.GetResourceResp/REGOLATORIO/CODICE_PROGETTO&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:for-each select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/CODE_STS&quot;>&#xa;                                    &lt;CODE_STS>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/CODE_STS>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/CODICE_PIATTAFORMA&quot;>&#xa;                                    &lt;CODICE_PIATTAFORMA>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/CODICE_PIATTAFORMA&quot;/>&#xa;                                    &lt;/CODICE_PIATTAFORMA>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/CODICE_CATEGORIA&quot;>&#xa;                                    &lt;CODICE_CATEGORIA>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/CODICE_CATEGORIA&quot;/>&#xa;                                    &lt;/CODICE_CATEGORIA>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/CODICE_DELIVERY&quot;>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/CODICE_DELIVERY&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/CODICE_IMPRESA&quot;>&#xa;                                    &lt;CODICE_IMPRESA>&#xa;         