                                &lt;CODE_STATO>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/CODE_STATO&quot;/>&#xa;                                    &lt;/CODE_STATO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/DESC_STATO&quot;>&#xa;                                    &lt;DESC_STATO>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/DESC_STATO&quot;/>&#xa;                                    &lt;/DESC_STATO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/WHOLESALER&quot;>&#xa;                                    &lt;WHOLESALER>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/WHOLESALER&quot;/>&#xa;                                    &lt;/WHOLESALER>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;string-length($CrmWs.GetResourceResp/REGOLATORIO/diffidato)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/diffidato&quot;>&#xa;                                        &lt;diffidato>&#xa;                                            &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/diffidato&quot;/>&#xa;                                        &lt;/diffidato>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/REGOLATORIO>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ns1:ResourceResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn: