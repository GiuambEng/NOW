             &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/CAP_CF&quot;>&#xa;                                    &lt;CAP_CF>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/CAP_CF&quot;/>&#xa;                                    &lt;/CAP_CF>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/NUM_CIVICO_CF&quot;>&#xa;                                    &lt;NUM_CIVICO_CF>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/NUM_CIVICO_CF&quot;/>&#xa;                                    &lt;/NUM_CIVICO_CF>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/COMPLESSO_CF&quot;>&#xa;                                    &lt;COMPLESSO_CF>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/COMPLESSO_CF&quot;/>&#xa;                                    &lt;/COMPLESSO_CF>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/SCALA_CF&quot;>&#xa;                                    &lt;SCALA_CF>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/SCALA_CF&quot;/>&#xa;                                    &lt;/SCALA_CF>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/PIANO_CF&quot;>&#xa;                                    &lt;PIANO_CF>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/PIANO_CF&quot;/>&#xa;                                    &lt;/PIANO_CF>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/INTERNO_CF&quot;>&#xa;                                    &lt;INTERNO_CF>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/INTERNO_CF&quot;/>&#xa;                                    &lt;/INTERNO_CF>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/COD_COMUNE_CF&quot;>&#xa;                                    &lt;COD_COMUNE_CF>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/COD_COMUNE_CF&quot;/>&#xa;                                    &lt;/COD_COMUNE_CF>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;string-length($CrmWs.GetResourceResp/REGOLATORIO/DEC_TECNICA)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/DEC_TECNICA&quot;>&#xa;                                        &lt;DEC_TECNICA>&#xa;                                            &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/DEC_TECNICA&quot;/>&#xa;                                        &lt;/DEC_TECNICA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;CODE_GEST>&#xa;                                    &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/CODE_GEST&quot;/>&#xa;                                &lt;/CODE_GEST>&#xa;                                &lt;xsl:if test=&quot;$CrmWs.GetResourceResp/REGOLATORIO/TIPO_COLOCAZIONE&quot;>&#xa;                                    &lt;TIPO_COLOCAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;$CrmWs.GetResourceResp/REGOLATORIO/TIPO_COLOCAZIONE&quot;/>&#xa;                                    &lt;/TIPO_COLOCAZIONE>&#xa;       