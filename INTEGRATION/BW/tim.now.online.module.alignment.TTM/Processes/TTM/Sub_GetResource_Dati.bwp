                            tibex:xpdlId="d8717bd5-f738-4e8d-b36f-cd1ef701b5c7" variable="Reply-input">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1496408583427" xmlns:ns0="http://xsd.telecomitalia.it/NOW_DATI/NOWTTM" version="2.0"&gt;
    &lt;xsl:param name="invokeIn"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
