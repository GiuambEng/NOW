                        <bpws:invoke inputVariable="Up_Logger-input"
                            name="Up_Logger" operation="Insert"
                            outputVariable="Up_Logger"
                            partnerLink="Logger"
                            portType="ns5:ProcessLog" tibex:xpdlId="09fc7b22-ed0c-4e83-a3ec-6c56c6e68111">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns0="http://xsd.telecomitalia.it/NOW_DATI/NOWTTM" version="2.0"&gt;
    &lt;xsl:param name="invokeIn"/&gt;
    &lt;xsl:template name="Up_Logger-input" match="/"&gt;
        &lt;tns1:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns2:Input&gt;
                    &lt;ns2:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                    &lt;/ns2:TipologiaProcesso&gt;
                    &lt;ns2:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                    &lt;/ns2:TipologiaOperazione&gt;
                    &lt;ns2:EsecuzioneNOFileProcessato&gt;
                        &lt;ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$invokeIn/part1/ns0:ResourceRequest/resource/id_esec_procso"/&gt;
                        &lt;/ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                        &lt;ns2:STATO_ESEC&gt;
                            &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;
                        &lt;/ns2:STATO_ESEC&gt;
                        &lt;ns2:TMSP_FINE_ELAB&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns2:TMSP_FINE_ELAB&gt;
                    &lt;/ns2:EsecuzioneNOFileProcessato&gt;
                &lt;/ns2:Input&gt;
            &lt;/part1&gt;
        &lt;/tns1:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/NOW_DATI/NOWTTM&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;invokeIn.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;Up_Logger-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:Input>&#xa;            &lt;ns2:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;            &lt;/ns2:TipologiaProcesso>&#xa;            &lt;ns2:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/ns2:TipologiaOperazione>&#xa;            &lt;ns2:EsecuzioneNOFileProcessato>&#xa;                &lt;ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$invokeIn.part1/resource/id_esec_procso&quot;/>&#xa;                &lt;/ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns2:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                &lt;/ns2:STATO_ESEC>&#xa;                &lt;ns2:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns2:TMSP_FINE_ELAB>&#xa;            &lt;/ns2:EsecuzioneNOFileProcessato>&#xa;        &lt;/ns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
