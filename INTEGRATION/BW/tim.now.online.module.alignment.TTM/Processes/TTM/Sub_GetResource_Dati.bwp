                <bpws:correlations/>
            </bpws:receive>
            <bpws:reply name="End" operation="invoke"
                partnerLink="crmwsDataServiceNow"
                portType="ns1:crmwsDataServiceNow"
                tibex:xpdlId="b7853207-0e57-4fc0-859d-03fbfc523f21" variable="invokeOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1496408583427" xmlns:ns="http://xsd.telecomitalia.it/CRMWS/NOWTTM" xmlns:ns0="http://xsd.telecomitalia.it/NOW_DATI/NOWTTM" version="2.0"&gt;
    &lt;xsl:param name="Crmws"/&gt;
    &lt;xsl:template name="invokeOut-input" match="/"&gt;
        &lt;tns:response&gt;
            &lt;part1&gt;
                &lt;ns0:ResourceResponse&gt;
                    &lt;xsl:copy-of select="$Crmws/GetResourceResp/ns:ResourceResponse/testata"/&gt;
                    &lt;xsl:copy-of select="$Crmws/GetResourceResp/ns:ResourceResponse/bs_asim_atm_gbe"/&gt;
                    &lt;xsl:copy-of select="$Crmws/GetResourceResp/ns:ResourceResponse/bs_ftth_fttcab"/&gt;
                    &lt;xsl:copy-of select="$Crmws/GetResourceResp/ns:ResourceResponse/bs_simm_atm_gbe"/&gt;
                    &lt;xsl:copy-of select="$Crmws/GetResourceResp/ns:ResourceResponse/easy_ip"/&gt;
                    &lt;xsl:copy-of select="$Crmws/GetResourceResp/ns:ResourceResponse/easy_ip_fibra"/&gt;
                    &lt;xsl:copy-of select="$Crmws/GetResourceResp/ns:ResourceResponse/kitbit"/&gt;
                    &lt;xsl:copy-of select="$Crmws/GetResourceResp/ns:ResourceResponse/managed_ip"/&gt;
                    &lt;xsl:copy-of select="$Crmws/GetResourceResp/ns:ResourceResponse/sdt"/&gt;
                    &lt;xsl:copy-of select="$Crmws/GetResourceResp/ns:ResourceResponse/vlanbs"/&gt;
                    &lt;xsl:copy-of select="$Crmws/GetResourceResp/ns:ResourceResponse/vp"/&gt;
                &lt;/ns0:ResourceResponse&gt;
            &lt;/part1&gt;
        &lt;/tns:response&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1496408583427&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/CRMWS/NOWTTM&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/NOW_DATI/NOWTTM&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Crmws.GetResourceResp&quot;/>&#xa;    &lt;xsl:template name=&quot;invokeOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:ResourceResponse>&#xa;            &lt;xsl:copy-of select=&quot;$Crmws.GetResourceResp/testata&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Crmws.GetResourceResp/bs_asim_atm_gbe&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Crmws.GetResourceResp/bs_ftth_fttcab&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Crmws.GetResourceResp/bs_simm_atm_gbe&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Crmws.GetResourceResp/easy_ip&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Crmws.GetResourceResp/easy_ip_fibra&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Crmws.GetResourceResp/kitbit&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Crmws.GetResourceResp/managed_ip&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Crmws.GetResourceResp/sdt&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Crmws.GetResourceResp/vlanbs&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Crmws.GetResourceResp/vp&quot;/>&#xa;        &lt;/ns0:ResourceResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
