                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/StagingTTMFONIA&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/NOW_DATI/NOWTTM&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;invokeIn&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;UpError-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:INPUT>&#xa;            &lt;tns1:UpdateOnError>&#xa;                &lt;tns1:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails)&quot;/>&#xa;                &lt;/tns1:DESCR_ERRORE>&#xa;                &lt;tns1:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:TIMSTP_RISPOSTA>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;'21'&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;tns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$invokeIn/part1/ns0:ResourceRequest/resource/id_esec_procso&quot;/>&#xa;                &lt;/tns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;tns1:COD_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                &lt;/tns1:COD_ESITO>&#xa;                &lt;tns1:DESCR_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;'Errore interno al NOW'&quot;/>&#xa;                &lt;/tns1:DESCR_ESITO>&#xa;            &lt;/tns1:UpdateOnError>&#xa;        &lt;/tns1:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
