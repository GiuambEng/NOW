                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.openaccess.it/wholesale/manager/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/NOW_DATI/NOWTTM&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CRMWS.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;ResponseCRMWS&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:ResourceResponse>&#xa;            &lt;testata>&#xa;                &lt;id_risorsa_crmws>&#xa;                    &lt;xsl:value-of select=&quot;$CRMWS.part1/testata/id_risorsa_crmws&quot;/>&#xa;                &lt;/id_risorsa_crmws>&#xa;                &lt;codice_esito>&#xa;                    &lt;xsl:value-of select=&quot;$CRMWS.part1/testata/codice_esito&quot;/>&#xa;                &lt;/codice_esito>&#xa;                &lt;desc_esito>&#xa;                    &lt;xsl:value-of select=&quot;$CRMWS.part1/testata/desc_esito&quot;/>&#xa;                &lt;/desc_esito>&#xa;            &lt;/testata>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CRMWS.part1/kitbit/id_risorsa_richiesta)>0&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$CRMWS.part1/kitbit&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CRMWS.part1/bs_simm_atm_gbe/id_risorsa_richiesta)>0&quot;>&#xa;                    &lt;bs_simm_atm_gbe>&#xa;                        &lt;id_risorsa_richiesta>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWS.part1/bs_simm_atm_gbe/id_risorsa_richiesta&quot;/>&#xa;                        &lt;/id_risorsa_richiesta>&#xa;                        &lt;codice_olo>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWS.part1/bs_simm_atm_gbe/codice_olo&quot;/>&#xa;                        &lt;/codice_olo>&#xa;                        &lt;xsl:if test=&quot;$CRMWS.pa