uot;$CRMWS.part1/bs_asim_atm_gbe/desc_sla&quot;/>&#xa;                            &lt;/desc_sla>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$CRMWS.part1/bs_asim_atm_gbe/code_copertura_oraria&quot;>&#xa;                            &lt;code_copertura_oraria>&#xa;                                &lt;xsl:value-of select=&quot;$CRMWS.part1/bs_asim_atm_gbe/code_copertura_oraria&quot;/>&#xa;                            &lt;/code_copertura_oraria>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$CRMWS.part1/bs_asim_atm_gbe/desc_copertura_oraria&quot;>&#xa;                            &lt;desc_copertura_oraria>&#xa;                                &lt;xsl:value-of select=&quot;$CRMWS.part1/bs_asim_atm_gbe/desc_copertura_oraria&quot;/>&#xa;                            &lt;/desc_copertura_oraria>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$CRMWS.part1/bs_asim_atm_gbe/data_sla&quot;>&#xa;                            &lt;data_sla>&#xa;                                &lt;xsl:value-of select=&quot;$CRMWS.part1/bs_asim_atm_gbe/data_sla&quot;/>&#xa;                            &lt;/data_sla>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;data_ricezione_ordine>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWS.part1/bs_asim_atm_gbe/data_ricezione_ordine&quot;/>&#xa;                        &lt;/data_ricezione_ordine>&#xa;                        &lt;xsl:if test=&quot;string-length($CRMWS.part1/bs_asim_atm_gbe/data_espletamento)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$CRMWS.part1/bs_asim_atm_gbe/data_espletamento&quot;>&#xa;                                &lt;data_espletamento>&#xa;                                    &lt;xsl:value-of select=&quot;$CRMWS.part1/bs_asim_atm_gbe/data_espletamento&quot;/>&#xa;                                &lt;/data_espletamento>&#xa;                          