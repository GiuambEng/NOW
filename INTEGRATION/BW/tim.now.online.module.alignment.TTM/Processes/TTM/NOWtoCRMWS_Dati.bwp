                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.example.org/RequestNOWtoCRMWS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;logStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'NOWtoCRMWS'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('START CHIAMATA AL CRMWS con di_richiesta_ttm_now:   ', $Start/tns1:TTM_RICHIESTA,tib:render-xml($Start,true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="logger-input" name="logger"
                operation="Insert" outputVariable="logger"
                partnerLink="ProcessLog" portType="ns1:ProcessLog" tibex:xpdlId="0d338548-163d-4574-a121-f32740469940">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" version="2.0"&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="72"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;72&quot;/>&#xa;                &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_INIZIO_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_INIZIO_ELAB>&#xa;            &lt;/ns:EsecuzioneNOFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcessToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="loggerToCallProcess1"/>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;logger&quot;/>&lt;xsl:template name=&quot;LogOutLogger-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'NOWtoCRMWS'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('LOGGER OUT CHIAMATA AL CRMWS              ',tib:render-xml($logger/part1/ns:Output, true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogOutLogger-input"
                    name="LogOutLogger"
                    tibex:xpdlId="0a3318c5-86e8-4884-9146-212e9ea6566b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="loggerToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess1ToCallProcess7"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOutLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'NOWtoCRMWS'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('LOGGER OUT CHIAMATA AL CRMWS              ',tib:render-xml($logger.part1, true(),true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.openaccess.it/wholesale/manager/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/NOW_DATI/NOWTTM&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CRMWS&quot;/>&lt;xsl:template name=&quot;ResponseCRMWS&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$CRMWS/part1/ns2:ResourceResponse/testata/codice_esito=&amp;quot;0&amp;quot;&quot;>&lt;ns1:ResourceResponse>&lt;testata>&lt;id_risorsa_crmws>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/testata/id_risorsa_crmws&quot;/>&lt;/id_risorsa_crmws>&lt;codice_esito>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/testata/codice_esito&quot;/>&lt;/codice_esito>&lt;desc_esito>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/testata/desc_esito&quot;/>&lt;/desc_esito>&lt;/testata>&lt;easy_ip>&lt;xsl:copy-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/vc&quot;/>&lt;id_risorsa_richiesta>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/id_risorsa_richiesta&quot;/>&lt;/id_risorsa_richiesta>&lt;codice_olo>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/codice_olo&quot;/>&lt;/codice_olo>&lt;xsl:if test=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/codice_progetto&quot;>&lt;codice_progetto>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/codice_progetto&quot;/>&lt;/codice_progetto>&lt;/xsl:if>&lt;code_stato>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/code_stato&quot;/>&lt;/code_stato>&lt;desc_stato>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/desc_stato&quot;/>&lt;/desc_stato>&lt;xsl:if test=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/nome&quot;>&lt;nome>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/nome&quot;/>&lt;/nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/cognome&quot;>&lt;cognome>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/cognome&quot;/>&lt;/cognome>&lt;/xsl:if>&lt;xsl:if test=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/ragione_sociale&quot;>&lt;ragione_sociale>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/ragione_sociale&quot;/>&lt;/ragione_sociale>&lt;/xsl:if>&lt;localita>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/localita&quot;/>&lt;/localita>&lt;xsl:if test=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/cap&quot;>&lt;cap>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/cap&quot;/>&lt;/cap>&lt;/xsl:if>&lt;xsl:if test=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/indirizzo&quot;>&lt;indirizzo>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/indirizzo&quot;/>&lt;/indirizzo>&lt;/xsl:if>&lt;xsl:if test=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/numero_civico&quot;>&lt;numero_civico>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/numero_civico&quot;/>&lt;/numero_civico>&lt;/xsl:if>&lt;code_comm_servizio>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/code_comm_servizio&quot;/>&lt;/code_comm_servizio>&lt;desc_comm_servizio>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/desc_comm_servizio&quot;/>&lt;/desc_comm_servizio>&lt;code_tipo_servizio>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/code_tipo_servizio&quot;/>&lt;/code_tipo_servizio>&lt;desc_tipo_servizio>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/desc_tipo_servizio&quot;/>&lt;/desc_tipo_servizio>&lt;xsl:if test=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/code_consegna&quot;>&lt;code_consegna>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/easy_ip/code_consegna&quot;/>&lt;/code_consegna>&lt;/