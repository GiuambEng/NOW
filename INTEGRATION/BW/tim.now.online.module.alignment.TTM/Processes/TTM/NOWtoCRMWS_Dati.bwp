                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.openaccess.it/wholesale/manager/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/NOW_DATI/NOWTTM&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CRMWS&quot;/>&lt;xsl:template name=&quot;ResponseCRMWS&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$CRMWS/part1/ns2:ResourceResponse/testata/codice_esito = &amp;quot;0&amp;quot;&quot;>&lt;ns1:ResourceResponse>&lt;testata>&lt;id_risorsa_crmws>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/testata/id_risorsa_crmws&quot;/>&lt;/id_risorsa_crmws>&lt;codice_esito>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/testata/codice_esito&quot;/>&lt;/codice_esito>&lt;desc_esito>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/testata/desc_esito&quot;/>&lt;/desc_esito>&lt;/testata>&lt;bs_ftth_fttcab>&lt;id_risorsa_richiesta>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/bs_ftth_fttcab/id_risorsa_richiesta&quot;/>&lt;/id_risorsa_richiesta>&lt;codice_olo>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/bs_ftth_fttcab/codice_olo&quot;/>&lt;/codice_olo>&lt;xsl:if test=&quot;$CRMWS/part1/ns2:ResourceResponse/bs_ftth_fttcab/codice_progetto&quot;>&lt;codice_progetto>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/bs_ftth_fttcab/codice_progetto&quot;/>&lt;/codice_progetto>&lt;/xsl:if>&lt;code_stato>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/bs_ftth_fttcab/code_stato&quot;/>&lt;/code_stato>&lt;desc_stato>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/bs_ftth_fttcab/desc_stato&quot;/>&lt;/desc_stato>&lt;xsl:if test=&quot;$CRMWS/part1/ns2:ResourceResponse/bs_ftth_fttcab/nome&quot;>&lt;nome>&lt;xsl:value-of select=&quot;$CRMWS/part1/ns2:ResourceResponse/bs_ftth_fttcab/nome&quot;/>&lt;/nome>