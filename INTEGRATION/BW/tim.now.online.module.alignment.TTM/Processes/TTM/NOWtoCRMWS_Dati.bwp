                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[contains(upper-case($Start/ns7:RESOURCE/ns7:TIPO_SERV), 'BIT_ASIM') and $CRMWS.part1/testata/codice_esito!='3']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogCRMWSToAssign2">
                            <tibex:DesignExpression>
                                <tibex:expression
