            xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp3:ProcessLog"/>
            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType3">
                <plnk:role name="use" portType="ptyp5:crmwsDataServiceNow"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://xmlns.example.com/1481886334901"/>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/ProcessLog"/>
            <wsdl:import namespace="http://xmlns.example.com/1481813326693"/>
            <wsdl:import namespace="http://xmlns.example.com/1496408583427"/>
        </wsdl:definitions>
    </tibex:Types>
