                        </bpws:source>
                        <bpws:source linkName="CallProcessToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToBIT_FTTX">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="contains(upper-case($Start/ns7:RESOURCE/ns7:TIPO_SERV), 'BIT_FTTX') and $CRMWS/part1/ns13:ResourceResponse/testata/codice_esito!='3'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[contains(upper-case($Start/ns7:RESOURCE/ns7:TIPO_SERV), 'BIT_FTTX') and $CRMWS.part1/testata/codice_esito!='3']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToEASYIP">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($Start/ns7:RESOURCE/ns7:TIPO_SERV) = 'EASYIP' and $CRMWS/part1/ns13:ResourceResponse/testata/codice_esito !='3'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[upper-case($Start/ns7:RESOURCE/ns7:TIPO_SERV) = 'EASYIP' and $CRMWS.part1/testata/codice_esito !='3']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToBIT_ASIM">
