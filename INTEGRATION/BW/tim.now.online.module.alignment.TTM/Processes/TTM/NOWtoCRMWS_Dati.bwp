             &lt;ns1:ResourceResponse>&#xa;                    &lt;testata>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWS.part1/testata/id_risorsa_crmws&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                        &lt;codice_esito>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWS.part1/testata/codice_esito&quot;/>&#xa;                        &lt;/codice_esito>&#xa;                        &lt;desc_esito>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWS.part1/testata/desc_esito&quot;/>&#xa;                        &lt;/desc_esito>&#xa;                    &lt;/testata>&#xa;                &lt;/ns1:ResourceResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
