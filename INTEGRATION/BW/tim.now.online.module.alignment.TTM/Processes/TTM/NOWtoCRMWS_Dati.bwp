                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$CRMWS/part1/ns13:ResourceResponse/testata/codice_esito='3' and $CRMWS/part1/ns13:ResourceResponse/testata/stato!='ERRORE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
