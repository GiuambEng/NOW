($BIT_SIM/outputSet/TESTATA/RAGIONE_SOCIALE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/RAGIONE_SOCIALE)&quot;>&#xa;                            &lt;ragione_sociale>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/RAGIONE_SOCIALE&quot;/>&#xa;                            &lt;/ragione_sociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;localita>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/LOCALITA&quot;/>&#xa;                        &lt;/localita>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/CAP/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/CAP/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/CAP)&quot;>&#xa;                            &lt;cap>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/CAP&quot;/>&#xa;                            &lt;/cap>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/INDIRIZZO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/INDIRIZZO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/INDIRIZZO)&quot;>&#xa;                            &lt;indirizzo>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/INDIRIZZO&quot;/>&#xa;                            &lt;/indirizzo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/NUMERO_CIVICO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/NUMERO_CIVICO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/NUMERO_CIVICO)&quot;>&#xa;                            &lt;numero_civico>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/NUMERO_CIVICO&quot;/>&#xa;                            &lt;/numero_civico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;code_comm_servizio>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/CODE_COMM_SERVIZIO&quot;/>&#xa;                        &lt;/code_comm_servizio>&#xa;                        &lt;desc_comm_servizio>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/DESC_COMM_SERVIZIO&quot;/>&#xa;                        &lt;/desc_comm_servizio>&#xa;                        &lt;code_tipo_servizio>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/CODE_TIPO_SERVIZIO&quot;/>&#xa;                        &lt;/code_tipo_servizio>&#xa;                        &lt;desc_tipo_servizio>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/DESC_TIPO_SERVIZIO&quot;/>&#xa;                        &lt;/desc_tipo_servizio>&#xa;                        &lt;tecnologia>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/TECNOLOGIA&quot;/>&#xa;                        &lt;/tecnologia>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/CODE_SLA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/CODE_SLA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/CODE_SLA)&quot;>&#xa;                            &lt;code_sla>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/CODE_SLA&quot;/>&#xa;                            &lt;/code_sla>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/DESC_SLA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/DESC_SLA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/DESC_SLA)&quot;>&#xa;                            &lt;desc_sla>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/DESC_SLA&quot;/>&#xa;                            &lt;/desc_sla>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/CODE_COPERTURA_ORARIA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/CODE_COPERTURA_ORARIA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/CODE_COPERTURA_ORARIA)&quot;>&#xa;                            &lt;code_copertura_oraria>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/CODE_COPERTURA_ORARIA&quot;/>&#xa;                            &lt;/code_copertura_oraria>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/DESC_COPERTURA_ORARIA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/DESC_COPERTURA_ORARIA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/DESC_COPERTURA_ORARIA)&quot;>&#xa;                            &lt;desc_copertura_oraria>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/DESC_COPERTURA_ORARIA&quot;/>&#xa;                            &lt;/desc_copertura_oraria>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/DATA_SLA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/DATA_SLA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/DATA_SLA)&quot;>&#xa;                            &lt;data_sla>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/DATA_SLA&quot;/>&#xa;                            &lt;/data_sla>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;banda>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/BANDA&quot;/>&#xa;                        &lt;/banda>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/CODE_PROTOCOLLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/CODE_PROTOCOLLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/CODE_PROTOCOLLO)&quot;>&#xa;                            &lt;code_protocollo>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/CODE_PROTOCOLLO&quot;/>&#xa;                            &lt;/code_protocollo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/DESC_PROTOCOLLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/DESC_PROTOCOLLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/DESC_PROTOCOLLO)&quot;>&#xa;                            &lt;desc_protocollo>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/DESC_PROTOCOLLO&quot;/>&#xa;                            &lt;/desc_protocollo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/NUM_VC_ABR/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/NUM_VC_ABR/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/NUM_VC_ABR)&quot;>&#xa;                            &lt;num_vc_abr>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/NUM_VC_ABR&quot;/>&#xa;                            &lt;/num_vc_abr>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/NUM_VC_VBR/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/NUM_VC_VBR/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/NUM_VC_VBR)&quot;>&#xa;                            &lt;num_vc_vbr>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/NUM_VC_VBR&quot;/>&#xa;                            &lt;/num_vc_vbr>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($BIT_SIM/outputSet/TESTATA/DATA_ESPLETAMENTO)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/DATA_ESPLETAMENTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/DATA_ESPLETAMENTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/DATA_ESPLETAMENTO)&quot;>&#xa;                                &lt;data_espletamento>&#xa;                                    &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/DATA_ESPLETAMENTO&quot;/>&#xa;                                &lt;/data_espletamento>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/CODICE_DELIVERY/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/CODICE_DELIVERY/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/CODICE_DELIVERY)&quot;>&#xa;                            &lt;codice_delivery>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/CODICE_DELIVERY&quot;/>&#xa;                            &lt;/codice_delivery>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/IMPRESA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/IMPRESA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/IMPRESA)&quot;>&#xa;                            &lt;impresa>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/IMPRESA&quot;/>&#xa;                            &lt;/impresa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/NUM_USER_VLAN/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/NUM_USER_VLAN/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/NUM_USER_VLAN)&quot;>&#xa;                            &lt;num_user_vlan>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/NUM_USER_VLAN&quot;/>&#xa;                            &lt;/num_user_vlan>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/MODEM_TI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/MODEM_TI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/MODEM_TI)&quot;>&#xa;                            &lt;modem_ti>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/MODEM_TI&quot;/>&#xa;                            &lt;/modem_ti>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/TIPO_MODEM/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/TIPO_MODEM/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/TIPO_MODEM)&quot;>&#xa;                            &lt;tipo_modem>&#xa;                                &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/TIPO_MODEM&quot;/>&#xa;                            &lt;/tipo_modem>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($BIT_SIM/outputSet/TESTATA/NUM_COPPIE_MODEM)>0&quot;>&#xa;                            &lt;num_coppie_modem>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer($BIT_SIM/outputSet/TESTATA/NUM_COPPIE_MODEM)&quot;/>&#xa;                            &lt;/num_coppie_modem>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$BIT_SIM/outputSet/VLANS/APPUSER.TTTM_CRMWS_BTS_SIMM_VLANS&quot;>&#xa;                            &lt;xsl:if test=&quot;string-length(USER_VLAN)>0 and string(number(USER_VLAN)) !='NaN'&quot;>&#xa;                                &lt;user_vlan>&#xa;                                    &lt;user_vlan>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:integer(USER_VLAN)&quot;/>&#xa;                                    &lt;/user_vlan>&#xa;                                    &lt;xsl:if test=&quot;not((string(SVLAN/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(SVLAN/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(SVLAN)&quot;>&#xa;                                        &lt;svlan>&#xa;                                            &lt;xsl:value-of select=&quot;SVLAN&quot;/>&#xa;                                        &lt;/svlan>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;cvlan>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(CVLAN)&quot;/>&#xa;                                    &lt;/cvlan>&#xa;                                &lt;/user_vlan>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;diffidato>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/DIFFIDATO&quot;/>&#xa;                        &lt;/diffidato>&#xa;                        &lt;xsl:if test=&quot;string-length($BIT_SIM/outputSet/TESTATA/TIPOLOGIA_CLUSTER_COMUNE)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/TIPOLOGIA_CLUSTER_COMUNE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/TIPOLOGIA_CLUSTER_COMUNE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/TIPOLOGIA_CLUSTER_COMUNE)&quot;>&#xa;                                &lt;tipologia_cluster_comune>&#xa;                                    &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/TIPOLOGIA_CLUSTER_COMUNE&quot;/>&#xa;                                &lt;/tipologia_cluster_comune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($BIT_SIM/outputSet/TESTATA/ASSETBT)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/ASSETBT/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/ASSETBT/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/ASSETBT)&quot;>&#xa;                                    &lt;AssetBT>&#xa;                                        &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/ASSETBT&quot;/>&#xa;                                    &lt;/AssetBT>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;string-length($BIT_SIM/outputSet/TESTATA/FLAGEQUIVALENZAPRODOTTI)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/FLAGEQUIVALENZAPRODOTTI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_SIM/outputSet/TESTATA/FLAGEQUIVALENZAPRODOTTI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_SIM/outputSet/TESTATA/FLAGEQUIVALENZAPRODOTTI)&quot;>&#xa;                                &lt;FLAGEQUIVALENZAPRODOTTI>&#xa;                                    &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/FLAGEQUIVALENZAPRODOTTI&quot;/>&#xa;                                &lt;/FLAGEQUIVALENZAPRODOTTI>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/bs_simm_atm_gbe>&#xa;                &lt;/ns:ResourceResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$BIT_SIM/outputSet/CODICE_ESITO = &amp;quot;1&amp;quot;&quot;>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;testata>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$DATIIn.parameters/resource/id_risorsa&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                        &lt;codice_esito>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/CODICE_ESITO&quot;/>&#xa;                        &lt;/codice_esito>&#xa;                        &lt;desc_esito>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/DESC_ESITO&quot;/>&#xa;                        &lt;/desc_esito>&#xa;                    &lt;/testata>&#xa;                &lt;/ns:ResourceResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$BIT_SIM/outputSet/CODICE_ESITO = &amp;quot;2&amp;quot;&quot;>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;testata>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$DATIIn.parameters/resource/id_risorsa&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                        &lt;codice_esito>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/CODICE_ESITO&quot;/>&#xa;                        &lt;/codice_esito>&#xa;                        &lt;desc_esito>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/DESC_ESITO&quot;/>&#xa;                        &lt;/desc_esito>&#xa;                    &lt;/testata>&#xa;                &lt;/ns:ResourceResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;testata>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$DATIIn.parameters/resource/id_risorsa&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                        &lt;codice_esito>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/CODICE_ESITO&quot;/>&#xa;                        &lt;/codice_esito>&#xa;                        &lt;desc_esito>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/DESC_ESITO&quot;/>&#xa;                        &lt;/desc_esito>&#xa;                    &lt;/testata>&#xa;                &lt;/ns:ResourceResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Response" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="substring($DATIIn/parameters/ns2:ResourceRequest/resource/id_risorsa, 1,9)"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
