                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.openaccess.it/wholesale/manager/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DATIIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;BIT_SIM&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$BIT_SIM/outputSet/CODICE_ESITO = &amp;quot;0&amp;quot;&quot;>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;testata>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$DATIIn.parameters/resource/id_risorsa&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                        &lt;codice_esito>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/CODICE_ESITO&quot;/>&#xa;                        &lt;/codice_esito>&#xa;                        &lt;desc_esito>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/DESC_ESITO&quot;/>&#xa;                        &lt;/desc_esito>&#xa;                    &lt;/testata>&#xa;                    &lt;bs_simm_atm_gbe>&#xa;                        &lt;id_risorsa_richiesta>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/ID_RISORSA_RICHIESTA&quot;/>&#xa;                        &lt;/id_risorsa_richiesta>&#xa;                        &lt;codice_olo>&#xa;                            &lt;xsl:value-of select=&quot;$BIT_SIM/outputSet/TESTATA/CODICE_OLO&quot;/>&#xa;                        &lt;/codice_olo>&#xa;                        &lt;xsl:if test=&quot;not((string($BIT_SIM/outputSet/TESTATA/CODICE_PROGETTO/@xsi:nil