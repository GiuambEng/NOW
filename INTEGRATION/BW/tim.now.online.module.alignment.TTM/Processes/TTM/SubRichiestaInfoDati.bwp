                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartLogToDATIOut">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($DATIIn/parameters/ns2:ResourceRequest/resource/tipo_serv) = 'EASYIP'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[upper-case($DATIIn.parameters/resource/tipo_serv) = 'EASYIP']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartLogToJDBCCallProcedure">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="contains(upper-case($DATIIn/parameters/ns2:ResourceRequest/resource/tipo_serv), 'BIT_ASIM')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[contains(upper-case($DATIIn.parameters/resource/tipo_serv), 'BIT_ASIM')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartLogToJDBCCallProcedure3">
