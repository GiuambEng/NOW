                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.openaccess.it/wholesale/manager/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;BIT_FTTX&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$BIT_FTTX/outputSet/CODICE_ESITO='0'&quot;>&lt;ns:ResourceResponse>&lt;testata>&lt;id_risorsa_crmws>&lt;xsl:value-of select=&quot;$BIT_FTTX/outputSet/ID_RISORSA_CRMWS&quot;/>&lt;/id_risorsa_crmws>&lt;codice_esito>&lt;xsl:value-of select=&quot;$BIT_FTTX/outputSet/CODICE_ESITO&quot;/>&lt;/codice_esito>&lt;desc_esito>&lt;xsl:value-of select=&quot;$BIT_FTTX/outputSet/DESC_ESITO&quot;/>&lt;/desc_esito>&lt;/testata>&lt;bs_ftth_fttcab>&lt;id_risorsa_richiesta>&lt;xsl:value-of select=&quot;$BIT_FTTX/outputSet/TESTATA/ID_RISORSA_RICHIESTA&quot;/>&lt;/id_risorsa_richiesta>&lt;codice_olo>&lt;xsl:value-of select=&quot;$BIT_FTTX/outputSet/TESTATA/CODICE_OLO&quot;/>&lt;/codice_olo>&lt;xsl:if test=&quot;not((string($BIT_FTTX/outputSet/TESTATA/CODICE_PROGETTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_FTTX/outputSet/TESTATA/CODICE_PROGETTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($BIT_FTTX/outputSet/TESTATA/CODICE_PROGETTO)&quot;>&lt;codice_progetto>&lt;xsl:value-of select=&quot;$BIT_FTTX/outputSet/TESTATA/CODICE_PROGETTO&quot;/>&lt;/codice_progetto>&lt;/xsl:if>&lt;code_stato>&lt;xsl:value-of select=&quot;$BIT_FTTX/outputSet/TESTATA/CODE_STATO&quot;/>&lt;/code_stato>&lt;desc_stato>&lt;xsl:value-of select=&quot;$BIT_FTTX/outputSet/TESTATA/DESC_STATO&quot;/>&lt;/desc_stato>&lt;xsl:if test=&quot;not((string($BIT_FTTX/outputSet/TESTATA/NOME/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($BIT_FTTX/ou