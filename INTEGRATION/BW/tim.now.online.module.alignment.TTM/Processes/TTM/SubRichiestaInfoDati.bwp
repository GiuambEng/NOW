            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.openaccess.it/wholesale/manager/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DATIIn&quot;/>&#xa;    &lt;xsl:param name=&quot;FWA&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;ns:ResourceResponse>&#xa;            &lt;testata>&#xa;                &lt;id_risorsa_crmws>&#xa;                    &lt;xsl:value-of select=&quot;$DATIIn/parameters/ns:ResourceRequest/resource/id_risorsa&quot;/>&#xa;                &lt;/id_risorsa_crmws>&#xa;                &lt;codice_esito>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/CODICE_ESITO&quot;/>&#xa;                &lt;/codice_esito>&#xa;                &lt;desc_esito>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/DESC_ESITO&quot;/>&#xa;                &lt;/desc_esito>&#xa;            &lt;/testata>&#xa;            &lt;fixed_Wireless_Access>&#xa;                &lt;id_risorsa_richiesta>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/ID_RISORSA_RICHIESTA&quot;/>&#xa;                &lt;/id_risorsa_richiesta>&#xa;                &lt;codice_olo>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/CODICE_OLO&quot;/>&#xa;                &lt;/codice_olo>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/CODICE_PROGETTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/CODICE_PROGETTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/CODICE_PROGETTO)&quot;>&#xa;                    &lt;codice_progetto>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/CODICE_PROGETTO&quot;/>&#xa;                    &lt;/codice_progetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;code_stato>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/CODE_STATO&quot;/>&#xa;                &lt;/code_stato>&#xa;                &lt;desc_stato>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/DESC_STATO&quot;/>&#xa;                &lt;/desc_stato>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/NOME/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/NOME/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/NOME)&quot;>&#xa;                    &lt;nome>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/NOME&quot;/>&#xa;                    &lt;/nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/COGNOME/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/COGNOME/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/COGNOME)&quot;>&#xa;                    &lt;cognome>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/COGNOME&quot;/>&#xa;                    &lt;/cognome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/RAGIONE_SOCIALE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/RAGIONE_SOCIALE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/RAGIONE_SOCIALE)&quot;>&#xa;                    &lt;ragione_sociale>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/RAGIONE_SOCIALE&quot;/>&#xa;                    &lt;/ragione_sociale>&#xa;                &lt;/xsl:if>&#xa;                &lt;localita>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/LOCALITA&quot;/>&#xa;                &lt;/localita>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/CAP/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/CAP/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/CAP)&quot;>&#xa;                    &lt;cap>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/CAP&quot;/>&#xa;                    &lt;/cap>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/INDIRIZZO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/INDIRIZZO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/INDIRIZZO)&quot;>&#xa;                    &lt;indirizzo>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/INDIRIZZO&quot;/>&#xa;                    &lt;/indirizzo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/NUMERO_CIVICO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/NUMERO_CIVICO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/NUMERO_CIVICO)&quot;>&#xa;                    &lt;numero_civico>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/NUMERO_CIVICO&quot;/>&#xa;                    &lt;/numero_civico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/COMPLESSO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/COMPLESSO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/COMPLESSO)&quot;>&#xa;                    &lt;complesso>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/COMPLESSO&quot;/>&#xa;                    &lt;/complesso>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/SCALA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/SCALA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/SCALA)&quot;>&#xa;                    &lt;scala>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/SCALA&quot;/>&#xa;                    &lt;/scala>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/PIANO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/PIANO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/PIANO)&quot;>&#xa;                    &lt;piano>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/PIANO&quot;/>&#xa;                    &lt;/piano>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/INTERNO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/INTERNO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/INTERNO)&quot;>&#xa;                    &lt;interno>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/INTERNO&quot;/>&#xa;                    &lt;/interno>&#xa;                &lt;/xsl:if>&#xa;                &lt;code_comm_servizio>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/CODE_COMM_SERVIZIO&quot;/>&#xa;                &lt;/code_comm_servizio>&#xa;                &lt;desc_comm_servizio>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/DESC_COMM_SERVIZIO&quot;/>&#xa;                &lt;/desc_comm_servizio>&#xa;                &lt;code_tipo_servizio>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/CODE_TIPO_SERVIZIO&quot;/>&#xa;                &lt;/code_tipo_servizio>&#xa;                &lt;desc_tipo_servizio>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/DESC_TIPO_SERVIZIO&quot;/>&#xa;                &lt;/desc_tipo_servizio>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/CODE_SLA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/CODE_SLA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/CODE_SLA)&quot;>&#xa;                    &lt;code_sla>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/CODE_SLA&quot;/>&#xa;                    &lt;/code_sla>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/DESC_SLA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/DESC_SLA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/DESC_SLA)&quot;>&#xa;                    &lt;desc_sla>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/DESC_SLA&quot;/>&#xa;                    &lt;/desc_sla>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/CODE_COPERTURA_ORARIA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/CODE_COPERTURA_ORARIA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/CODE_COPERTURA_ORARIA)&quot;>&#xa;                    &lt;code_copertura_oraria>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/CODE_COPERTURA_ORARIA&quot;/>&#xa;                    &lt;/code_copertura_oraria>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/DESC_COPERTURA_ORARIA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/DESC_COPERTURA_ORARIA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/DESC_COPERTURA_ORARIA)&quot;>&#xa;                    &lt;desc_copertura_oraria>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/DESC_COPERTURA_ORARIA&quot;/>&#xa;                    &lt;/desc_copertura_oraria>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/DATA_SLA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/DATA_SLA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/DATA_SLA)&quot;>&#xa;                    &lt;data_sla>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/DATA_SLA&quot;/>&#xa;                    &lt;/data_sla>&#xa;                &lt;/xsl:if>&#xa;                &lt;data_ricezione_ordine>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/DATA_RICEZIONE_ORDINE&quot;/>&#xa;                &lt;/data_ricezione_ordine>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/DATA_ESPLETAMENTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/DATA_ESPLETAMENTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/DATA_ESPLETAMENTO)&quot;>&#xa;                    &lt;data_espletamento>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/DATA_ESPLETAMENTO&quot;/>&#xa;                    &lt;/data_espletamento>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/TIPO_PROFILO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/TIPO_PROFILO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/TIPO_PROFILO)&quot;>&#xa;                    &lt;tipo_profilo>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/TIPO_PROFILO&quot;/>&#xa;                    &lt;/tipo_profilo>&#xa;                &lt;/xsl:if>&#xa;                &lt;msisdn>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/MSISDN&quot;/>&#xa;                &lt;/msisdn>&#xa;                &lt;serial_number>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/SERIAL_NUMBER&quot;/>&#xa;                &lt;/serial_number>&#xa;                &lt;imei>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/IMEI&quot;/>&#xa;                &lt;/imei>&#xa;                &lt;imsi>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/IMSI&quot;/>&#xa;                &lt;/imsi>&#xa;                &lt;cod_nmu>&#xa;                    &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/COD_NMU&quot;/>&#xa;                &lt;/cod_nmu>&#xa;                &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/ADC/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/ADC/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/ADC)&quot;>&#xa;                    &lt;adc>&#xa;                        &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/ADC&quot;/>&#xa;                    &lt;/adc>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;count($FWA/outputSet/PROFILES/APPUSER.TTTM_CRMWS_FWA_PROFILES) > 0&quot;>&#xa;                    &lt;profilo>&#xa;                        &lt;vel_up>&#xa;                            &lt;xsl:value-of select=&quot;$FWA/outputSet/PROFILES/APPUSER.TTTM_CRMWS_FWA_PROFILES[1]/VEL_UP&quot;/>&#xa;                        &lt;/vel_up>&#xa;                        &lt;vel_down>&#xa;                            &lt;xsl:value-of select=&quot;$FWA/outputSet/PROFILES/APPUSER.TTTM_CRMWS_FWA_PROFILES[1]/VEL_DOWN&quot;/>&#xa;                        &lt;/vel_down>&#xa;                    &lt;/profilo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($FWA/outputSet/TESTATA/ASSETBT)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;not((string($FWA/outputSet/TESTATA/ASSETBT/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($FWA/outputSet/TESTATA/ASSETBT/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($FWA/outputSet/TESTATA/ASSETBT)&quot;>&#xa;                        &lt;AssetBT>&#xa;                            &lt;xsl:value-of select=&quot;$FWA/outputSet/TESTATA/ASSETBT&quot;/>&#xa;                        &lt;/AssetBT>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;            &lt;/fixed_Wireless_Access>&#xa;        &lt;/ns:ResourceResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
