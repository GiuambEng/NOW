                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/NOW_TTM_DATI/" xmlns:ns="http://www.openaccess.it/wholesale/manager/" version="2.0"&gt;&lt;xsl:param name="Response"/&gt;&lt;xsl:template name="DATIOut-input" match="/"&gt;&lt;tns:DATIResponse&gt;&lt;parameters&gt;&lt;xsl:copy-of select="$Response"/&gt;&lt;/parameters&gt;&lt;/tns:DATIResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
