                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;VP&quot;/>&lt;xsl:template name=&quot;LogVP-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'SubRichiestaInfoDati'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('DOPO PROCEDURA VP     ',tib:render-xml($VP/outputSet, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Response"
                    name="AssignVLAN" outputVariable="Response"
                    tibex:xpdlId="b93c7c0e-4f15-4050-8ced-6095ba041bb2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogVLANToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignVLANToDATIOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.openaccess.it/wholesale/manager/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VLAN&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$VLAN/outputSet/CODICE_ESITO='0'&quot;>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;testata>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/ID_RISORSA_CRMWS&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                        &lt;codice_esito>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/CODICE_ESITO&quot;/>&#xa;                        &lt;/codice_esito>&#xa;                        &lt;desc_esito>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/DESC_ESITO&quot;/>&#xa;                        &lt;/desc_esito>&#xa;                    &lt;/testata>&#xa;                    &lt;vlanbs>&#xa;                        &lt;id_risorsa_richiesta>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/TESTATA/ID_RISORSA_RICHIESTA&quot;/>&#xa;                        &lt;/id_risorsa_richiesta>&#xa;                        &lt;codice_olo>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/TESTATA/CODICE_OLO&quot;/>&#xa;                        &lt;/codice_olo>&#xa;                        &lt;id_vlan_commerciale>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/ID_VLAN_COMMERCIALE&quot;/>&#xa;                        &lt;/id_vlan_commerciale>&#xa;                        &lt;code_stato>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/TESTATA/CODE_STATO&quot;/>&#xa;                        &lt;/code_stato>&#xa;                        &lt;desc_stato>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/TESTATA/DESC_STATO&quot;/>&#xa;                        &lt;/desc_stato>&#xa;                        &lt;xsl:if test=&quot;not((string($VLAN/outputSet/TESTATA/CODICE_PROGETTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VLAN/outputSet/TESTATA/CODICE_PROGETTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VLAN/outputSet/TESTATA/CODICE_PROGETTO)&quot;>&#xa;                            &lt;codice_progetto>&#xa;                                &lt;xsl:value-of select=&quot;$VLAN/outputSet/TESTATA/CODICE_PROGETTO&quot;/>&#xa;                            &lt;/codice_progetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/LOCALITA_ORG/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/LOCALITA_ORG/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/LOCALITA_ORG)&quot;>&#xa;                            &lt;localita_origine>&#xa;                                &lt;xsl:value-of select=&quot;$VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/LOCALITA_ORG&quot;/>&#xa;                            &lt;/localita_origine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/NOME_AREA_RACCOLTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/NOME_AREA_RACCOLTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/NOME_AREA_RACCOLTA)&quot;>&#xa;                            &lt;nome_area_raccolta>&#xa;                                &lt;xsl:value-of select=&quot;$VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/NOME_AREA_RACCOLTA&quot;/>&#xa;                            &lt;/nome_area_raccolta>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/LOCALITA_DEST/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/LOCALITA_DEST/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/LOCALITA_DEST)&quot;>&#xa;                            &lt;localita_destinazione>&#xa;                                &lt;xsl:value-of select=&quot;$VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/LOCALITA_DEST&quot;/>&#xa;                            &lt;/localita_destinazione>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/NOME_PUNTO_CONSEGNA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/NOME_PUNTO_CONSEGNA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/NOME_PUNTO_CONSEGNA)&quot;>&#xa;                            &lt;nome_punto_consegna>&#xa;                                &lt;xsl:value-of select=&quot;$VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/NOME_PUNTO_CONSEGNA&quot;/>&#xa;                            &lt;/nome_punto_consegna>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;td_kit>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/TD_KIT&quot;/>&#xa;                        &lt;/td_kit>&#xa;                        &lt;xsl:if test=&quot;not((string($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/ID_VLAN_TECNICO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/ID_VLAN_TECNICO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/ID_VLAN_TECNICO)&quot;>&#xa;                            &lt;id_vlan_tecnico>&#xa;                                &lt;xsl:value-of select=&quot;$VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/ID_VLAN_TECNICO&quot;/>&#xa;                            &lt;/id_vlan_tecnico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($VLAN/outputSet/TESTATA/DATA_ESPLETAMENTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VLAN/outputSet/TESTATA/DATA_ESPLETAMENTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VLAN/outputSet/TESTATA/DATA_ESPLETAMENTO)&quot;>&#xa;                            &lt;data_espletamento>&#xa;                                &lt;xsl:value-of select=&quot;$VLAN/outputSet/TESTATA/DATA_ESPLETAMENTO&quot;/>&#xa;                            &lt;/data_espletamento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;cos>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/COS&quot;/>&#xa;                        &lt;/cos>&#xa;                        &lt;velocita_trasmissiva_vlan>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VLAN_BSS[1]/VELOCITA_TRASMISSIVA_VLAN&quot;/>&#xa;                        &lt;/velocita_trasmissiva_vlan>&#xa;                        &lt;xsl:if test=&quot;not((string($VLAN/outputSet/TESTATA/ASSETBT/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VLAN/outputSet/TESTATA/ASSETBT/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VLAN/outputSet/TESTATA/ASSETBT)&quot;>&#xa;                            &lt;AssetBT>&#xa;                                &lt;xsl:value-of select=&quot;$VLAN/outputSet/TESTATA/ASSETBT&quot;/>&#xa;                            &lt;/AssetBT>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/vlanbs>&#xa;                &lt;/ns:ResourceResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;testata>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/ID_RISORSA_CRMWS&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                        &lt;codice_esito>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/CODICE_ESITO&quot;/>&#xa;                        &lt;/codice_esito>&#xa;                        &lt;desc_esito>&#xa;                            &lt;xsl:value-of select=&quot;$VLAN/outputSet/DESC_ESITO&quot;/>&#xa;                        &lt;/desc_esito>&#xa;                    &lt;/testata>&#xa;                &lt;/ns:ResourceResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Response" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Response"
                    name="AssignVP" outputVariable="Response"
                    tibex:xpdlId="12120c48-84e3-428c-abd5-9c0f0fa7c678" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogVPToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignVPToDATIOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.openaccess.it/wholesale/manager/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VP&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$VP/outputSet/CODICE_ESITO='0'&quot;>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;testata>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$VP/outputSet/ID_RISORSA_CRMWS&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                        &lt;codice_esito>&#xa;                            &lt;xsl:value-of select=&quot;$VP/outputSet/CODICE_ESITO&quot;/>&#xa;                        &lt;/codice_esito>&#xa;                        &lt;desc_esito>&#xa;                            &lt;xsl:value-of select=&quot;$VP/outputSet/DESC_ESITO&quot;/>&#xa;                        &lt;/desc_esito>&#xa;                    &lt;/testata>&#xa;                    &lt;vp>&#xa;                        &lt;id_risorsa_richiesta>&#xa;                            &lt;xsl:value-of select=&quot;$VP/outputSet/TESTATA/ID_RISORSA_RICHIESTA&quot;/>&#xa;                        &lt;/id_risorsa_richiesta>&#xa;                        &lt;codice_olo>&#xa;                            &lt;xsl:value-of select=&quot;$VP/outputSet/TESTATA/CODICE_OLO&quot;/>&#xa;                        &lt;/codice_olo>&#xa;                        &lt;id_vp_commerciale>&#xa;                            &lt;xsl:value-of select=&quot;$VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/ID_VP_COMMERCIALE&quot;/>&#xa;                        &lt;/id_vp_commerciale>&#xa;                        &lt;xsl:if test=&quot;not((string($VP/outputSet/TESTATA/CODICE_PROGETTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VP/outputSet/TESTATA/CODICE_PROGETTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VP/outputSet/TESTATA/CODICE_PROGETTO)&quot;>&#xa;                            &lt;codice_progetto>&#xa;                                &lt;xsl:value-of select=&quot;$VP/outputSet/TESTATA/CODICE_PROGETTO&quot;/>&#xa;                            &lt;/codice_progetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;code_stato>&#xa;                            &lt;xsl:value-of select=&quot;$VP/outputSet/TESTATA/CODE_STATO&quot;/>&#xa;                        &lt;/code_stato>&#xa;                        &lt;desc_stato>&#xa;                            &lt;xsl:value-of select=&quot;$VP/outputSet/TESTATA/DESC_STATO&quot;/>&#xa;                        &lt;/desc_stato>&#xa;                        &lt;code_tipo_servizio>&#xa;                            &lt;xsl:value-of select=&quot;$VP/outputSet/TESTATA/CODE_TIPO_SERVIZIO&quot;/>&#xa;                        &lt;/code_tipo_servizio>&#xa;                        &lt;desc_tipo_servizio>&#xa;                            &lt;xsl:value-of select=&quot;$VP/outputSet/TESTATA/DESC_TIPO_SERVIZIO&quot;/>&#xa;                        &lt;/desc_tipo_servizio>&#xa;                        &lt;xsl:if test=&quot;not((string($VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/MCR/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/MCR/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/MCR)&quot;>&#xa;                            &lt;mcr>&#xa;                                &lt;xsl:value-of select=&quot;$VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/MCR&quot;/>&#xa;                            &lt;/mcr>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/PCR/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/PCR/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/PCR)&quot;>&#xa;                            &lt;pcr>&#xa;                                &lt;xsl:value-of select=&quot;$VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/PCR&quot;/>&#xa;                            &lt;/pcr>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($VP/outputSet/TESTATA/DATA_ESPLETAMENTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VP/outputSet/TESTATA/DATA_ESPLETAMENTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VP/outputSet/TESTATA/DATA_ESPLETAMENTO)&quot;>&#xa;                            &lt;data_espletamento>&#xa;                                &lt;xsl:value-of select=&quot;$VP/outputSet/TESTATA/DATA_ESPLETAMENTO&quot;/>&#xa;                            &lt;/data_espletamento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/NOME_PUNTO_CONSEGNA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/NOME_PUNTO_CONSEGNA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/NOME_PUNTO_CONSEGNA)&quot;>&#xa;                            &lt;nome_punto_consegna>&#xa;                                &lt;xsl:value-of select=&quot;$VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/NOME_PUNTO_CONSEGNA&quot;/>&#xa;                            &lt;/nome_punto_consegna>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;not((string($VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/NOME_AREA_RACCOLTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VP/outputSet/VLAN_BSS/APPUSER.TTTM_CRMWS_VP_BSS[1]/NOME_AREA_RACCOLTA/@xsi:nil)=(&amp;quot;1&amp;quot;))