            <bpws:invoke inputVariable="LogInsNoFile-input"
                name="LogInsNoFile" operation="Insert"
                outputVariable="LogInsNoFile" partnerLink="Logger"
                portType="ns2:ProcessLog" tibex:xpdlId="64fab235-1d96-424c-8159-267568c106f1">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
