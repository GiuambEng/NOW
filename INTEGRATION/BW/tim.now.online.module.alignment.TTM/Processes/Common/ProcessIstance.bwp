                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/ProcessIstance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertNoFile.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInsNoFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;'LOG'&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$InsertNoFile.part1/ns:Esito/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                    &lt;ns:COD_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$InsertNoFile.part1/ns:Esito/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                    &lt;/ns:COD_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:ID_ESEC_PROCSO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($InsertNoFile.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE, &amp;quot;.&amp;quot;))&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO>&#xa;                &lt;ns:LOG_LEVEL>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/ns:LOG_LEVEL>&#xa;                &lt;xsl:if test=&quot;$Start/tns2:Insert/tns2:LOG_MESSAGE&quot;>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:Insert/tns2:LOG_MESSAGE&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_INSMTO>&#xa;            &lt;/ns:LogFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="InsertNoFileToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LogInsNoFileToEnd"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:invoke inputVariable="UpdNoFile-input"
