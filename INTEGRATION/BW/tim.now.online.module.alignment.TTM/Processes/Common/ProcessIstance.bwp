    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToProcessIstance" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="InsertNoFileToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInsNoFileToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToInvoke" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="UpdNoFileToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogUodNoFileToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="a0d1bb55-83c0-4ef7-b17b-caf3deb9e1ff"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToProcessIstance">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length(string($Start/ns3:Insert/ns3:ID_PROCSO_NO_FILE))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length(string($Start/ns3:Insert/ns3:ID_PROCSO_NO_FILE))>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length(string($Start/ns3:Update/ns3:ID_ESEC_PROCSO_NO_FILE))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length(string($Start/ns3:Update/ns3:ID_ESEC_PROCSO_NO_FILE))>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
