                portType="ns2:ProcessLog" tibex:xpdlId="d3d24d94-5c5f-4911-be37-77c33ccd162f">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://www.example.com/namespaces/ProcessIstance" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="UpdNoFile-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$Start/tns2:Update/tns2:ID_ESEC_PROCSO_NO_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$Start/tns2:Update/tns2:ID_ESEC_PROCSO_NO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns2:Update/tns2:STATO_ESEC"&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="$Start/tns2:Update/tns2:STATO_ESEC"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:if&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/ProcessIstance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdNoFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:EsecuzioneNOFileProcessato>&#xa;                &lt;xsl:if test=&quot;$Start/tns2:Update/tns2:ID_ESEC_PROCSO_NO_FILE&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:Update/tns2:ID_ESEC_PROCSO_NO_FILE&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns2:Update/tns2:STATO_ESEC&quot;>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:Update/tns2:STATO_ESEC&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_FINE_ELAB>&#xa;            &lt;/ns:EsecuzioneNOFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
