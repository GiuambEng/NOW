<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/AllineamentoAnagraficaVie_CheckSingoloRecord" elementFormDefault="qualified"    attributeFormDefault="unqualified"  xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AllineamentoAnagraficaVie_CheckSingoloRecord">
	<element name="AnagraficaVie_Dettaglio">
		<complexType>
			<sequence>
				<element name="CODICE_STRADA" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="COD_COMUNE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="ISTAT_COMUNE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="ISTAT_PROVINCIA" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="COD_VIA" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="DESC_VIA" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="80"/>
						</restriction>
					</simpleType>
				</element>
				<element name="COD_PART_TOP" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="FLAG_MULTICAP" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="1" />
							<enumeration value="Y" />
							<enumeration value="N"></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element name="CAP" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="FLAG_UFF" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="1" />
							<enumeration value="Y" />
							<enumeration value="N"></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element name="CODICE_DISTRETTO" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="FLAG_OPERAZIONE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="1"/>
							<enumeration value="I"/>
							<enumeration value="U"/>
							<enumeration value="Z"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Timestamp" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Numero_record" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="FlagValidita" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="AnagraficaVie">
		<complexType>
			<sequence>
				<element ref="tns:AnagraficaVie_Dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>