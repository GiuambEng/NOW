   <xs:sequence>
    <xs:element name="ProcessIstance" type="xs:integer"/>
    <xs:element name="COD_PROCSO_FILE" type="xs:string"/>
   </xs:sequence>
  </xs:complexType>
 </xs:element>
 <xs:element name="Output">
  <xs:complexType>
   <xs:sequence>
    <xs:element name="Esito" type="xs:string"/>
   </xs:sequence>
  </xs:complexType>
 </xs:element>
 <xs:element name="Errore">
  <xs:complexType>
   <xs:sequence>
    <xs:element name="CodeErrore" type="xs:string"/>
    <xs:element name="DescErrore" type="xs:string"/>
   </xs:sequence>
  </xs:complexType>
 </xs:element>
</xs:schema>