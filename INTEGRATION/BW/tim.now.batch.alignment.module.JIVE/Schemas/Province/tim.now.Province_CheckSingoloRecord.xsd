<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AllineamentoAnagraficaProvince_CheckSingoloRecord" elementFormDefault="qualified" attributeFormDefault="unqualified" targetNamespace="http://www.tim.com/NOW/xsd/AllineamentoAnagraficaProvince_CheckSingoloRecord">
	<element name="AnagraficaProvince">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0" ref="tns:AnagraficaProvince_dettaglio"/>
			</sequence>
		</complexType>
	</element>
	<element name="AnagraficaProvince_dettaglio">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="CODICE_PROVINCIA">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="ISTAT_PROV">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="DESCRIZIONE">
					<simpleType>
						<restriction base="string">
							<maxLength value="80"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="SIGLA_PROV">
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="COD_DISTRETTO">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="FLAG_OPERAZIONE">
					<simpleType>
						<restriction base="string">
							<maxLength value="1"/>
							<enumeration value="I"/>
							<enumeration value="U"/>
							<enumeration value="Z"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Timestamp" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Numero_record" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="FlagValidita" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>