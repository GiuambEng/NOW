<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/AllineamentoAnagraficaProvince_Tracciato"  xmlns:tns="http://www.tim.com/NOW/xsd/AllineamentoAnagraficaProvince_Tracciato" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="AnagraficaProvince">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0"	ref="tns:AnagraficaProvince_dettaglio"/>
			</sequence>
		</complexType>
	</element>
	<element name="AnagraficaProvince_dettaglio">
		<complexType>
			<sequence>
			    <element name="CODICE_PROVINCIA" type="string"	maxOccurs="1" minOccurs="0"/>
				<element name="ISTAT_PROV" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="DESCRIZIONE" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="SIGLA_PROV" type="string" maxOccurs="1"	minOccurs="0"/>
				<element name="COD_DISTRETTO" type="string"	maxOccurs="1" minOccurs="0"/>
				<element name="FLAG_OPERAZIONE" type="string"	maxOccurs="1" minOccurs="0"/>
				<element name="LATITUDINE" type="string"	maxOccurs="1" minOccurs="0"/>
				<element name="LONGITUDINE" type="string"	maxOccurs="1" minOccurs="0"/>
				<element maxOccurs="1" minOccurs="0" name="FlagValidita" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>