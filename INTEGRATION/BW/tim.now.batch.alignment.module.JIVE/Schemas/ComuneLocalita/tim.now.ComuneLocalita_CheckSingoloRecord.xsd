<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/AllineamentoAnagraficaComuneLocalita_CheckSingoloRecord" elementFormDefault="qualified"  attributeFormDefault="unqualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AllineamentoAnagraficaComuneLocalita_CheckSingoloRecord">
	<element name="AnagraficaComuneLocalitaDettaglio">
		<complexType>
			<sequence>
				<element name="COD_EGON" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="DESC_LOCALITA" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="80"/>
						</restriction>
					</simpleType>
				</element>
				<element name="ISTAT_COMUNE" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="ISTAT_PROVINCIA" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="COD_DISTRETTO" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="COD_CATASTALE" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="4"/>
						</restriction>
					</simpleType>
				</element>
				<element name="FLAG_COMUNE" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element name="FLAG_LOCALITA" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element name="FLAG_OPERAZIONE" maxOccurs="1"	minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="1"/>
							<enumeration value="I"/>
							<enumeration value="U"/>
							<enumeration value="Z"/>
						</restriction>
					</simpleType>
				</element>
				<element name="FLAG_BILINGUE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Timestamp" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Numero_record" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="FlagValidita" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="AnagraficaComuneLocalita">
		<complexType>
			<sequence>
				<element ref="tns:AnagraficaComuneLocalitaDettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>