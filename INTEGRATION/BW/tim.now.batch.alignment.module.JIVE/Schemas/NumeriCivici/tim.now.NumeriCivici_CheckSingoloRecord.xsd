<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/AllineamentoAnagraficaNumeriCivici_CheckSingoloRecord" elementFormDefault="qualified"     attributeFormDefault="unqualified"   xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AllineamentoAnagraficaNumeriCivici_CheckSingoloRecord">
	<element name="AnagraficaNumeriCiviciDettaglio">
