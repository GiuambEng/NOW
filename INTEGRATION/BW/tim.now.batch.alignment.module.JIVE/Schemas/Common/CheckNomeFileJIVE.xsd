<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/CheckNomeFileJIVE" xmlns:tns="http://www.example.org/CheckNomeFileJIVE" elementFormDefault="qualified">
<element name="Input">
<complexType>
<sequence>
		<element name="FILE_NAME" minOccurs="1" type="string"></element>

</sequence>
</complexType>
</element>
<element name="Output">
<complexType>
<sequence>
		<element name="FLUSSO" minOccurs="1" type="string"></element>	
</sequence>
</complexType>
</element>
<element name="ControlDate">
<complexType>
<sequence>
		<element name="Date" minOccurs="1" >
		 <simpleType>
        <restriction base="string">
         <pattern
          value="((000[1-9])|(00[1-9][0-9])|(0[1-9][0-9]{2})|([1-9][0-9]{3}))((0[1-9])|(1[012]))((0[1-9])|([12][0-9])|(3[01]))_(([01][0-9])|(2[0-3]))([0-5][0-9])" />
        </restriction>
       </simpleType>
       </element>
</sequence>
</complexType>
</element>


</schema>