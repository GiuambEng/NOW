                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/" xmlns:ns="http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/" xmlns:tns1="http://www.example.org/VerificaLavorabilita" xmlns:tns2="http://www.example.org/CreateFileID" version="2.0"&gt;&lt;xsl:param name="TipoSeparatore"/&gt;&lt;xsl:param name="VerificaLavorabilita"/&gt;&lt;xsl:param name="CreateIDFile"/&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="GetFLOWJive"/&gt;&lt;xsl:template name="ContaRecord-input" match="/"&gt;&lt;tns:Conta_Request&gt;&lt;part1&gt;&lt;ns:contaRecord_Input&gt;&lt;xsl:variable name="varNome" select="if($GetFLOWJive/Record[number($index)]/FLOW='Province') then 'allineamentoProvincia.Jive'&amp;#xD;&amp;#xA;else if ($GetFLOWJive/Record[number($index)]/FLOW='Civici') then 'allineamentoCivici.Jive'&amp;#xD;&amp;#xA;else if ($GetFLOWJive/Record[number($index)]/FLOW='Comune') then 'allineamentoComune.Jive'&amp;#xD;&amp;#xA;else if ($GetFLOWJive/Record[number($index)]/FLOW='Vie') then 'allineamentoVie.Jive'&amp;#xD;&amp;#xA;else if($GetFLOWJive/Record[number($index)]/FLOW='Particella Toponomastica') then 'allineamentoPToponomastica.Jive'&amp;#xD;&amp;#xA;else 'allineamentoVarAmministrativa.Jive'"/&gt;&lt;ns:in&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:SOURCE_FILE"/&gt;&lt;/ns:in&gt;&lt;ns:TipoSeparatore&gt;&lt;xsl:value-of select="$TipoSeparatore"/&gt;&lt;/ns:TipoSeparatore&gt;&lt;xsl:if test="$CreateIDFile/tns2:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$CreateIDFile/tns2:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:SOURCE_FILE"&gt;&lt;ns:FULLNAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:SOURCE_FILE"/&gt;&lt;/ns:FULLNAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:NOME_FILE"&gt;&lt;ns:FILENAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:NOME_FILE"/&gt;&lt;/ns:FILENAME&gt;&lt;/xsl:i