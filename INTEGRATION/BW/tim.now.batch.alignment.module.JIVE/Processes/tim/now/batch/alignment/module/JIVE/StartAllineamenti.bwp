        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+d06deb02-aca1-44cf-a03f-342d6ac83229+output"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+d06deb02-aca1-44cf-a03f-342d6ac83229+output">
            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record">
                            <complexType>
                                <sequence>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="ID_FLOW" nillable="false" type="decimal"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="FLOW" nillable="false" type="string"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
            <element name="Iterate_Current_Element_Record">
                <complexType>
                    <sequence maxOccurs="1" minOccurs="1">
                        <element maxOccurs="1" minOccurs="0"
                            name="ID_FLOW" nillable="false" type="decimal"/>
                        <element maxOccurs="1" minOccurs="0" name="FLOW"
                            nillable="false" type="string"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
