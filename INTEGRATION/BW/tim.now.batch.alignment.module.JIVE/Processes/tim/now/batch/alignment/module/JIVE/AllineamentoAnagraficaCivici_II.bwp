                                    sqlStatement="INSERT INTO STAG_NUMERO_CIVICO (ADC, CAP, CATEGORIA, CLLI,&#xa;  COD_VIA, COD_NUMERO_CIVICO, COD_STRADA, COD_TOPON, DESCR_ERRORE,&#xa;  DR, FLAG_OPA, TIPOLG_OPERAZIONE, FONTE, GAT, ID_FILE_PROCSTO_INPUT,&#xa;  ID_STATO_ELAB_STAG, LATITUDINE, LONGITUDINE, NUMERO_CIVICO,&#xa;  NUMERO_RECD, PRECISIONE, TIPO_ELEMENTO, TMSP_INSMTO, CONTENUTO_RECD)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,&#xa;    ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)))" xsi:type="jdbcPalette:JDBCUpdateActivity">

