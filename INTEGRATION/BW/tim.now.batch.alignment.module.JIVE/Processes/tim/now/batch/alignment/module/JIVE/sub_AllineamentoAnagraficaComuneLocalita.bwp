                                    <activityNames>DettaglioRecord</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/InsertStagingAnagraficaComuneLocalita_Allineamento&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaComuneLocalita_subProcess&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;InvokeIn&quot;/>&lt;xsl:param name=&quot;OK_ELAB_STAGING&quot;/>&lt;xsl:param name=&quot;KO_ELAB_STAGING&quot;/>&lt;xsl:template name=&quot;VarInputStaging&quot; match=&quot;/&quot;>&lt;ns:AllineamentoComuneLocalita_Dettaglio>&lt;xsl:variable name=&quot;var&quot; select=&quot;$InvokeIn/part1/tns:AnagraficaComuneLocalita/tns:AnagraficaComuneLocalita_dettaglio[number($index)]&quot;/>&lt;xsl:if test=&quot;$var/tns:COD_CATASTALE&quot;>&lt;ns:COD_CATAST_COMUNE>&lt;xsl:value-of select=&quot;$var/tns:COD_CATASTALE&quot;/>&lt;/ns:COD_CATAST_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:COD_EGON&quot;>&lt;ns:COD_COMUNE>&lt;xsl:value-of select=&quot;$var/tns:COD_EGON&quot;/>&lt;/ns:COD_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:COD_DISTRETTO&quot;>&lt;ns:COD_DISTR>&lt;xsl:value-of select=&quot;$var/tns:COD_DISTRETTO&quot;/>&lt;/ns:COD_DISTR>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($var/tns:FlagValidita)>0&quot;>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;tib:render-xml($var)&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:DESC_LOCALITA&quot;>&lt;ns:DESCR_COMUNE>&lt;xsl:value-of select=&quot;$var/tns:DESC_LOCALITA&quot;/>&lt;/ns:DESCR_COMUNE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($var/tns:FlagValidita)>0 and ($var/tns:FlagValidita!=&amp;quot;&amp;#xD;&amp;quot;)&quot;>&lt;ns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;'Formato record non conforme'&quot;/>&lt;/ns:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$var/tns:FLAG_BILINGUE&quot;>&lt;ns:FLAG_BILINGUE>&lt;xsl:value-of select=&quot;$var/tns:FLAG_BILINGUE&quot;/>&lt;/ns:FLAG_BILINGUE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:FLAG_COMUNE&quot;>&lt;ns:FLAG_COMUNE>&lt;xsl:value-of select=&quot;$var/tns:FLAG_COMUNE&quot;/>&lt;/ns:FLAG_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:FLAG_LOCALITA&quot;>&lt;ns:FLAG_LOCALITA>&lt;xsl:value-of select=&quot;$var/tns:FLAG_LOCALITA&quot;/>&lt;/ns:FLAG_LOCALITA>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:FLAG_OPERAZIONE&quot;>&lt;ns:FLAG_OPERAZIONE>&lt;xsl:value-of select=&quot;$var/tns:FLAG_OPERAZIONE&quot;/>&lt;/ns:FLAG_OPERAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:ID_FILE&quot;>&lt;ns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$var/tns:ID_FILE&quot;/>&lt;/ns:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($var/tns:FlagValidita)>0  and ($var/tns:FlagValidita!=&amp;quot;&amp;#xD;&amp;quot;)&quot;>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$KO_ELAB_STAGING&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_STAGING&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$var/tns:ISTAT_COMUNE&quot;>&lt;ns:ISTAT_COMUNE>&lt;xsl:value-of select=&quot;$var/tns:ISTAT_COMUNE&quot;/>&lt;/ns:ISTAT_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:ISTAT_PROVINCIA&quot;>&lt;ns:ISTAT_PROV>&lt;xsl:value-of select=&quot;$var/tns:ISTAT_PROVINCIA&quot;/>&lt;/ns:ISTAT_PROV>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:Numero_record&quot;>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var/tns:Numero_record&quot;/>&lt;/ns:NUMERO_RECD>&lt;/xsl:if>&lt;/ns:AllineamentoComuneLocalita_Dettaglio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VarInputStaging"
                                    name="Check_OK"
                                    outputVariable="VarInputStaging"
                                    tibex:xpdlId="6da1b746-4699-4383-b87d-9c11ffa29e37" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToMapper1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/InsertStagingAnagraficaComuneLocalita_Allineamento&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaComuneLocalita_subProcess&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELAB_STAGING&quot;/>&#xa;    &lt;xsl:param name=&quot;KO_ELAB_STAGING&quot;/>&#xa;    &lt;xsl:template name=&quot;VarInputStaging&quot; match=&quot;/&quot;>&#xa;        &lt;ns:AllineamentoComuneLocalita_Dettaglio>&#xa;            &lt;xsl:variable name=&quot;var&quot; select=&quot;$InvokeIn.part1/tns:AnagraficaComuneLocalita_dettaglio[number($index)]&quot;/>&#xa;            &lt;xsl:if test=&quot;$var/tns:COD_CATASTALE&quot;>&#xa;                &lt;ns:COD_CATAST_COMUNE>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns:COD_CATASTALE&quot;/>&#xa;                &lt;/ns:COD_CATAST_COMUNE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns:COD_EGON&quot;>&#xa;                &lt;ns:COD_COMUNE>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns:COD_EGON&quot;/>&#xa;                &lt;/ns:COD_COMUNE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns:COD_DISTRETTO&quot;>&#xa;                &lt;ns:COD_DISTR>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns:COD_DISTRETTO&quot;/>&#xa;                &lt;/ns:COD_DISTR>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($var/tns:FlagValidita)>0&quot;>&#xa;                &lt;ns:CONTENUTO_RECD>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($var)&quot;/>&#xa;                &lt;/