                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/InsertStagingAnagraficaProvince_Allineamento&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaProvince_subProcess&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;InvokeIn&quot;/>&lt;xsl:param name=&quot;OK_ELAB_STAGING&quot;/>&lt;xsl:param name=&quot;KO_ELAB_STAGING&quot;/>&lt;xsl:template name=&quot;VarInputStaging&quot; match=&quot;/&quot;>&lt;ns:AllineamentoProvince_Dettaglio>&lt;xsl:variable name=&quot;var&quot; select=&quot;$InvokeIn/part1/tns:AnagraficaProvince/tns:AnagraficaProvince_dettaglio[number($index)]&quot;/>&lt;xsl:if test=&quot;$var/tns:COD_DISTRETTO&quot;>&lt;ns:COD_DISTR>&lt;xsl:value-of select=&quot;$var/tns:COD_DISTRETTO&quot;/>&lt;/ns:COD_DISTR>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:CODICE_PROVINCIA&quot;>&lt;ns:COD_PROV>&lt;xsl:value-of select=&quot;$var/tns:CODICE_PROVINCIA&quot;/>&lt;/ns:COD_PROV>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($var/tns:FlagValidita)>0 and ($var/tns:FlagValidita!=&amp;quot;&amp;#xD;&amp;quot;)&quot;>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;tib:render-xml($var)&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($var/tns:FlagValidita)>0 and  ($var/tns:FlagValidita!=&amp;quot;&amp;#xD;&amp;quot;)&quot;>&lt;ns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;'Formato record non conforme'&quot;/>&lt;/ns:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$var/tns:DESCRIZIONE&quot;>&lt;ns:DESCR_PROV>&lt;xsl:value-of select=&quot;$var/tns:DESCRIZIONE&quot;/>&lt;/ns:DESCR_PROV>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns:FLAG_OPERAZIONE&quot;>&lt;ns:FLAG_OPERAZIONE>&lt;xsl:v