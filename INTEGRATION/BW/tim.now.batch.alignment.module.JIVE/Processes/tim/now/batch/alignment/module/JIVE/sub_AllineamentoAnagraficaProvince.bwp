                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/InsertStagingAnagraficaProvince_Allineamento&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaProvince_subProcess&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELAB_STAGING&quot;/>&#xa;    &lt;xsl:param name=&quot;KO_ELAB_STAGING&quot;/>&#xa;    &lt;xsl:template name=&quot;VarInputStaging&quot; match=&quot;/&quot;>&#xa;        &lt;ns:AllineamentoProvince_Dettaglio>&#xa;            &lt;xsl:variable name=&quot;var&quot; select=&quot;$InvokeIn.part1/tns:AnagraficaProvince_dettaglio[number($index)]&quot;/>&#xa;            &lt;xsl:if test=&quot;$var/tns:COD_DISTRETTO&quot;>&#xa;                &lt;ns:COD_DISTR>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns:COD_DISTRETTO&quot;/>&#xa;                &lt;/ns:COD_DISTR>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns:CODICE_PROVINCIA&quot;>&#xa;                &lt;ns:COD_PROV>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns:CODICE_PROVINCIA&quot;/>&#xa;                &lt;/ns:COD_PROV>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($var/tns:FlagValidita)>0 and ($var/tns:FlagValidita!=&amp;quot;&amp;#xD;&amp;quot;)&quot;>&#xa;                &lt;ns:CONTENUTO_RECD>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($var)&quot;/>&#xa;                &lt;/ns:CONTENUTO_RECD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($var/tns:FlagValidita)>0 and  ($var/tns:FlagValidita!=&amp;quot;&amp;#xD;&amp;quot;)&quot;