       &lt;/ns:ISTAT_PROV>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns:Numero_record&quot;>&#xa;                &lt;ns:NUMERO_RECD>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns:Numero_record&quot;/>&#xa;                &lt;/ns:NUMERO_RECD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$var/tns:SIGLA_PROV&quot;>&#xa;                &lt;ns:SIGLA_PROV>&#xa;                    &lt;xsl:value-of select=&quot;$var/tns:SIGLA_PROV&quot;/>&#xa;                &lt;/ns:SIGLA_PROV>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:AllineamentoProvince_Dettaglio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
