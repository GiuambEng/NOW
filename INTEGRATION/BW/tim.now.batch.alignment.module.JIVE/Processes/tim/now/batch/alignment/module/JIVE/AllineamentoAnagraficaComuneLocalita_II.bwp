                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.migration.ContenutoRecordComuneLocalita&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaComuneLocalita_Tracciato&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;Passo_ComLoc&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;ContenutoRecord-input&quot; match=&quot;/&quot;>&lt;tns:InputContenutoRecordComuneLocalita>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:AnagraficaComuneLocalita_dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AnagraficaComuneLocalita_dettaglio&quot;>&lt;tns:ContenutoRecordComuneLocalita_Input>&lt;xsl:if test=&quot;tns1:COD_EGON&quot;>&lt;tns:COD_EGON>&lt;xsl:value-of select=&quot;tns1:COD_EGON&quot;/>&lt;/tns:COD_EGON>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DESC_LOCALITA&quot;>&lt;tns:DESC_LOCALITA>&lt;xsl:value-of select=&quot;tns1:DESC_LOCALITA&quot;/>&lt;/tns:DESC_LOCALITA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ISTAT_COMUNE&quot;>&lt;tns:ISTAT_COMUNE>&lt;xsl:value-of select=&quot;tns1:ISTAT_COMUNE&quot;/>&lt;/tns:ISTAT_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ISTAT_PROVINCIA&quot;>&lt;tns:ISTAT_PROVINCIA>&lt;xsl:value-of select=&quot;tns1:ISTAT_PROVINCIA&quot;/>&lt;/tns:ISTAT_PROVINCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_DISTRETTO&quot;>&lt;tns:COD_DISTRETTO>&lt;xsl:value-of select=&quot;tns1:COD_DISTRETTO&quot;/>&lt;/tns:COD_DISTRETTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_CATASTALE&quot;>&lt;tns:COD_CATASTALE>&lt;xsl:value-of select=&quot;tns1:COD_CATASTALE&quot;/>&lt;/tns:COD_CATASTALE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_COMUNE&quot;>&lt;tns:FLAG_COMUNE>&lt;xsl:value-of select=&quot;tns1:FLAG_COMUNE&quot;/>&lt;/tns:FLAG_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_LOCALITA&quot;>&lt;tns:FLAG_LOCALITA>&lt;xsl:value-of select=&quot;tns1:FLAG_LOCALITA&quot;/>&lt;/tns:FLAG_LOCALITA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_OPERAZIONE&quot;>&lt;tns:FLAG_OPERAZIONE>&lt;xsl:value-of select=&quot;tns1:FLAG_OPERAZIONE&quot;/>&lt;/tns:FLAG_OPERAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_BILINGUE&quot;>&lt;tns:FLAG_BILINGUE>&lt;xsl:value-of select=&quot;tns1:FLAG_BILINGUE&quot;/>&lt;/tns:FLAG_BILINGUE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:LATITUDINE&quot;>&lt;tns:LATITUDINE>&lt;xsl:value-of select=&quot;tns1:LATITUDINE&quot;/>&lt;/tns:LATITUDINE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:LONGITUDINE&quot;>&lt;tns:LONGITUDINE>&lt;xsl:value-of select=&quot;tns1:LONGITUDINE&quot;/>&lt;/tns:LONGITUDINE>&lt;/xsl:if>&lt;tns:NumeroRecord>&lt;xsl:value-of select=&quot;(($Passo_ComLoc * ($index -1)) + position())&quot;/>&lt;/tns:NumeroRecord>&lt;/tns:ContenutoRecordComuneLocalita_Input>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:AnagraficaComuneLocalita_dettaglio&quot;>&lt;tns:ContenutoRecordComuneLocalita_Input>&lt;xsl:if test=&quot;tns1:COD_EGON&quot;>&lt;tns:COD_EGON>&lt;xsl:value-of select=&quot;tns1:COD_EGON&quot;/>&lt;/tns:COD_EGON>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DESC_LOCALITA&quot;>&lt;tns:DESC_LOCALITA>&lt;xsl:value-of select=&quot;tns1:DESC_LOCALITA&quot;/>&lt;/tns:DESC_LOCALITA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ISTAT_COMUNE&quot;>&lt;tns:ISTAT_COMUNE>&lt;xsl:value-of select=&quot;tns1:ISTAT_COMUNE&quot;/>&lt;/tns:ISTAT_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ISTAT_PROVINCIA&quot;>&lt;tns:ISTAT_PROVINCIA>&lt;xsl:value-of select=&quot;tns1:ISTAT_PROVINCIA&quot;/>&lt;/tns:ISTAT_PROVINCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_DISTRETTO&quot;>&lt;tns:COD_DISTRETTO>&lt;xsl:value-of select=&quot;tns1:COD_DISTRETTO&quot;/>&lt;/tns:COD_DISTRETTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_CATASTALE&quot;>&lt;tns:COD_CATASTALE>&lt;xsl:value-of select=&quot;tns1:COD_CATASTALE&quot;/>&lt;/tns:COD_CATASTALE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_COMUNE&quot;>&lt;tns:FLAG_COMUNE>&lt;xsl:value-of select=&quot;tns1:FLAG_COMUNE&quot;/>&lt;/tns:FLAG_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_LOCALITA&quot;>&lt;tns:FLAG_LOCALITA>&lt;xsl:value-of select=&quot;tns1:FLAG_LOCALITA&quot;/>&lt;/tns:FLAG_LOCALITA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_OPERAZIONE&quot;>&lt;tns:FLAG_OPERAZIONE>&lt;xsl:value-of select=&quot;tns1:FLAG_OPERAZIONE&quot;/>&lt;/tns:FLAG_OPERAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_BILINGUE&quot;>&lt;tns:FLAG_BILINGUE>&lt;xsl:value-of select=&quot;tns1:FLAG_BILINGUE&quot;/>&lt;/tns:FLAG_BILINGUE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:LATITUDINE&quot;>&lt;tns:LATITUDINE>&lt;xsl:value-of select=&quot;tns1:LATITUDINE&quot;/>&lt;/tns:LATITUDINE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:LONGITUDINE&quot;>&lt;tns:LONGITUDINE>&lt;xsl:value-of select=&quot;tns1:LONGITUDINE&quot;/>&lt;/tns:LONGITUDINE>&lt;/xsl:if>&lt;tns:NumeroRecord>&lt;xsl:value-of select=&quot;(($Passo_ComLoc * ($index -1)) + position())&quot;/>&lt;/tns:NumeroRecord>&lt;/tns:ContenutoRecordComuneLocalita_Input>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:InputContenutoRecordComuneLocalita>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.ContenutoRecord.ContenutoRecordAnagraficaComuneLocalita" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:empty name="Empty1" tibex:xpdlId="bf391747-6bdd-4dd9-a63f-819aeb4f8885">
                                    <bpws:targets>
                                    <bpws:target linkName="DetailUltimi_NoValToEmpty1"/>
                                    <bpws:target linkName="DetailNoValToEmpty1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Empty1ToContenutoRecord">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty1ToStartElaborazione">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(($index=((($JMSReceiveMessage/Body/ns37:queueResponse/ns37:NumeroRecord) div ($Passo_ComLoc))+1)) and ((count($DetailUltimi_NoVal/Rows/tns:AnagraficaComuneLocalita_dettaglio))=0))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(($index=((($JMSReceiveMessage/Body/ns37:queueResponse/ns37:NumeroRecord) div ($Passo_ComLoc))+1)) and ((count($DetailUltimi_NoVal/Rows/tns:AnagraficaComuneLocalita_dettaglio))=0))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                </bpws:empty>
                            </bpws:flow>
                        </bpws:while>
                    </bpws:sequence>
                </bpws:scope>
            </bpws:flow>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ComuneLocalita-input"
                    name="ComuneLocalita"
                    outputVariable="ComuneLocalita"
                    tibex:xpdlId="956bbdbf-8a88-4d21-8947-5dab1e5ebcf8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess6ToComuneLocalita"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ComuneLocalitaToCallProcess10"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+956bbdbf-8a88-4d21-8947-5dab1e5ebcf8+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;ComuneLocalita-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:inputs>&#xa;            &lt;inputSet>&#xa;                &lt;PROCEDURE_NAME>&#xa;                    &lt;xsl:value-of select=&quot;'PKG_ALLINEA_JIVE.SP_ALLINEA_COMUNE_LOCALITA'&quot;/>&#xa;                &lt;/PROCEDURE_NAME>&#xa;                &lt;IDFILE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/IDFILE>&#xa;            &lt;/inputSet>&#xa;        &lt;/tns3:inputs>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCCallProcedure"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBC_Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCCallProcedureActivity"/>
                                    <value catalogOrPackage="PKG_JOBS"
                                    procedureOrFunctionName="CREATE_JOB"
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:JDBCCallProcedureActivity">
                                    <preparedParamters DataType="12"
                                    DataTypeDisplayValue="VARCHAR2"
                                    ParameterName="PROCEDURE_NAME" ProcedureParamterType="1"/>
                                    <preparedParamters DataType="2"
                                    DataTypeDisplayValue="NUMBER"
                                    ParameterName="IDFILE" ProcedureParamterType="1"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="UpCount-input" name="UpCount"
                operation="Insert" outputVariable="UpCount"
                partnerLink="Logger" portType="ns3:ProcessLog" tibex:xpdlId="2f895ce6-e834-4012-a7e9-9eb3b981b2e7">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="www.tim.now.contarecord_jms.response" version="2.0"&gt;
    &lt;xsl:param name="JMSReceiveMessage"/&gt;
    &lt;xsl:template name="UpCount-input" match="/"&gt;
        &lt;tns3:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns:Input&gt;
                    &lt;ns:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;
                    &lt;/ns:TipologiaProcesso&gt;
                    &lt;ns:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;COUNTER&amp;quot;"/&gt;
                    &lt;/ns:TipologiaOperazione&gt;
                    &lt;ns:FileProcessatoInput&gt;
                        &lt;xsl:if test="$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE"&gt;
                            &lt;ns:ID_FILE_PROCSTO_INPUT&gt;
                                &lt;xsl:value-of select="$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE"/&gt;
                            &lt;/ns:ID_FILE_PROCSTO_INPUT&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord"&gt;
                            &lt;ns:QT_RECD_TOTALI&gt;
                                &lt;xsl:value-of select="$JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord"/&gt;
                            &lt;/ns:QT_RECD_TOTALI&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns:FileProcessatoInput&gt;
                &lt;/ns:Input&gt;
            &lt;/part1&gt;
        &lt;/tns3:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;UpCount-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;COUNTER&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:FileProcessatoInput>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord&quot;>&#xa;                    &lt;ns:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord&quot;/>&#xa;                    &lt;/ns:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessatoInput>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Output_Log_counterToUpCount"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Invoke2ToLocalTransaction"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="Output_Log_counter-input"
                    name="Output_Log_counter"
                    tibex:xpdlId="198bf7e0-4f7a-4211-9bdf-440ce53f70ff"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JMSReceiveMessageToOutput_Log_counter"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Output_Log_counterToCopy_1_Output_Log_counter">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$JMSReceiveMessage/Body/ns37:queueResponse/ns37:EsitoConteggio='KO' or ($JMSReceiveMessage/Body/ns37:queueResponse/ns37:NumeroRecord=0 and $JMSReceiveMessage/Body/ns37:queueResponse/ns37:EsitoConteggio='OK')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$JMSReceiveMessage/Body/ns37:queueResponse/ns37:EsitoConteggio='KO' or ($JMSReceiveMessage/Body/ns37:queueResponse/ns37:NumeroRecord=0 and $JMSReceiveMessage/Body/ns37:queueResponse/ns37:EsitoConteggio='OK')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Output_Log_counterToUpCount">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Output_Log_counterToThrow">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$JMSReceiveMessage/Body/ns37:queueResponse/ns37:EsitoConteggio='ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$JMSReceiveMessage/Body/ns37:queueResponse/ns37:EsitoConteggio='ERROR']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;Output_Log_counter-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.alignment.module.JIVE.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoAnagraficaComuneLocalita'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($JMSReceiveMessage/Body/ns1:queueResponse,true(),true())&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Log_KO_Counter-input"
                    name="Log_KO_Counter"
                    tibex:xpdlId="b2d54cb1-e320-4022-863c-a9669bf5ae0e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Output_Log_counterToCopy_1_Output_Log_counter"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_KO_CounterToCallProcess1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;Copy_1_Output_Log_counter-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.alignment.module.JIVE.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoAnagraficaComuneLocalita'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Invoke Counter KO'&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="JMSReceiveMessage"
                    tibex:xpdlId="4cf7c5d9-0e1a-409c-84cd-203ffe50af75"
                    variable="JMSReceiveMessage" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets/>
                    <bpws:sources>
                        <bpws:source linkName="JMSReceiveMessageToOutput_Log_counter"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.jms.receive"
                            version="6.0.0.20132205"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jms="http://ns.tibco.com/bw/palette/jms"
                            xmlns:www.tim.now.contarecord_jms.response="www.tim.now.contarecord_jms.response" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
