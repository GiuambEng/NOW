                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://tns.tibco.com/bw/activity/parse/xsd/+16f8a175-b3ea-4ff6-b6dc-ec58edc53032+input&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo_ComLoc&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;DetailUltimi_NoVal-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Input>&#xa;            &lt;fileName>&#xa;                &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FULLNAME&quot;/>&#xa;            &lt;/fileName>&#xa;            &lt;startRecord>&#xa;                &lt;xsl:value-of select=&quot;($index - 1) * $Passo_ComLoc + 1&quot;/>&#xa;            &lt;/startRecord>&#xa;            &lt;noOfRecords>&#xa;                &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord mod $Passo_ComLoc&quot;/>&#xa;            &lt;/noOfRecords>&#xa;        &lt;/tns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
