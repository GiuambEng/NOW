            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapDetails-input" name="MapDetails"
                    outputVariable="MapDetails"
                    tibex:xpdlId="9c8a5e50-94b1-494f-96ca-0e5f0d4a1acd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess4ToComuneLocalita"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToComuneLocalita"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NomeFileScarto&quot;/>&#xa;    &lt;xsl:param name=&quot;PATH_FILE_MOVE&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;PathFileError&quot;/>&#xa;    &lt;xsl:param name=&quot;PathFileScarto&quot;/>&#xa;    &lt;xsl:param name=&quot;Nome_Staging_Comune&quot;/>&#xa;    &lt;xsl:param name=&quot;Offset_ComuneLocalita&quot;/>&#xa;    &lt;xsl:template name=&quot;MapDetails-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Details>&#xa;            &lt;tns3:InputDetails>&#xa;                &lt;tns3:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NomeFileScarto&amp;quot;&quot;/>&#xa;                &lt;/tns3:NOME>&#xa;                &lt;tns3:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;$NomeFileScarto&quot;/>&#xa;                &lt;/tns3:VALORE>&#xa;            &lt;/tns3:InputDetails>&#xa;            &lt;tns3:InputDetails>&#xa;                &lt;tns3:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Offset&amp;quot;&quot;/>&#xa;                &lt;/tns3:NOME>&#xa;                &lt;tns3:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;$Offset_ComuneLocalita&quot;/>&#xa;                &lt;/tns3:VALORE>&#xa;            &lt;/tns3:InputDetails>&#xa;            &lt;tns3:InputDetails>&#xa;                &lt;tns3:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DestinationPathFile&amp;quot;&quot;/>&#xa;                &lt;/tns3:NOME>&#xa;                &lt;tns3:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;$PATH_FILE_MOVE&quot;/>&#xa;                &lt;/tns3:VALORE>&#xa;            &lt;/tns3:InputDetails>&#xa;            &lt;tns3:InputDetails>&#xa;                &lt;tns3:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SourcePathFile&amp;quot;&quot;/>&#xa;                &lt;/tns3:NOME>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FULLNAME&quot;>&#xa;                    &lt;tns3:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FULLNAME&quot;/>&#xa;                    &lt;/tns3:VALORE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:InputDetails>&#xa;            &lt;tns3:InputDetails>&#xa;                &lt;tns3:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NomeTabellaScarto&amp;quot;&quot;/>&#xa;                &lt;/tns3:NOME>&#xa;                &lt;tns3:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;$Nome_Staging_Comune&quot;/>&#xa;                &lt;/tns3:VALORE>&#xa;            &lt;/tns3:InputDetails>&#xa;            &lt;tns3:InputDetails>&#xa;                &lt;tns3:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PathFileScarto&amp;quot;&quot;/>&#xa;                &lt;/tns3:NOME>&#xa;                &lt;tns3:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;$PathFileScarto&quot;/>&#xa;                &lt;/tns3:VALORE>&#xa;            &lt;/tns3:InputDetails>&#xa;            &lt;tns3:InputDetails>&#xa;                &lt;tns3:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NameFile&amp;quot;&quot;/>&#xa;                &lt;/tns3:NOME>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FILENAME&quot;>&#xa;                    &lt;tns3:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FILENAME&quot;/>&#xa;                    &lt;/tns3:VALORE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:InputDetails>&#xa;            &lt;tns3:InputDetails>&#xa;                &lt;tns3:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ErrorPathFile&amp;quot;&quot;/>&#xa;                &lt;/tns3:NOME>&#xa;                &lt;tns3:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;$PathFileError&quot;/>&#xa;                &lt;/tns3:VALORE>&#xa;            &lt;/tns3:InputDetails>&#xa;        &lt;/tns3:Details>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details="www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details:Details" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
