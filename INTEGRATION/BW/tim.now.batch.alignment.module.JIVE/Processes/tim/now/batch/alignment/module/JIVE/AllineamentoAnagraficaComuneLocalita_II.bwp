&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ISTAT_COMUNE&quot;>&lt;tns2:ISTAT_COMUNE>&lt;xsl:value-of select=&quot;tns1:ISTAT_COMUNE&quot;/>&lt;/tns2:ISTAT_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ISTAT_PROVINCIA&quot;>&lt;tns2:ISTAT_PROVINCIA>&lt;xsl:value-of select=&quot;tns1:ISTAT_PROVINCIA&quot;/>&lt;/tns2:ISTAT_PROVINCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_DISTRETTO&quot;>&lt;tns2:COD_DISTRETTO>&lt;xsl:value-of select=&quot;tns1:COD_DISTRETTO&quot;/>&lt;/tns2:COD_DISTRETTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_CATASTALE&quot;>&lt;tns2:COD_CATASTALE>&lt;xsl:value-of select=&quot;tns1:COD_CATASTALE&quot;/>&lt;/tns2:COD_CATASTALE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_COMUNE&quot;>&lt;tns2:FLAG_COMUNE>&lt;xsl:value-of select=&quot;tns1:FLAG_COMUNE&quot;/>&lt;/tns2:FLAG_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_LOCALITA&quot;>&lt;tns2:FLAG_LOCALITA>&lt;xsl:value-of select=&quot;tns1:FLAG_LOCALITA&quot;/>&lt;/tns2:FLAG_LOCALITA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_OPERAZIONE&quot;>&lt;tns2:FLAG_OPERAZIONE>&lt;xsl:value-of select=&quot;tns1:FLAG_OPERAZIONE&quot;/>&lt;/tns2:FLAG_OPERAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_BILINGUE&quot;>&lt;tns2:FLAG_BILINGUE>&lt;xsl:value-of select=&quot;tns1:FLAG_BILINGUE&quot;/>&lt;/tns2:FLAG_BILINGUE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:LATITUDINE&quot;>&lt;tns2:LATITUDINE>&lt;xsl:value-of select=&quot;tns1:LATITUDINE&quot;/>&lt;/tns2:LATITUDINE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:LONGITUDINE&quot;>&lt;tns2:LONGITUDINE>&lt;xsl:value-of select=&quot;tns1:LONGITUDINE&quot;/>&lt;/tns2:LONGITUDINE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FlagValidita&quot;>&lt;tns2:FlagValidita>&lt;xsl:value-of select=&quot;tns1:FlagValidita&quot;/>&lt;/tns2:FlagValidita>&lt;/xsl:if>&lt;tns2:Numero_record>&lt;xsl:value-of select=&quot;(($Passo_ComLoc * ($index -1)) + position())&quot;/>&lt;/tns2:Numero_record>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&lt;tns2:ID_FILE>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&lt;/tns2:ID_FILE>&lt;/xsl:if>&lt;/tns2:AnagraficaComuneLocalita_dettaglio>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:AnagraficaComuneLocalita>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
