                                    <bpws:sources>
                                    <bpws:source linkName="Input_StagingToLog_InputStaging"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/InsertStagingAnagraficaComuneLocalita_Allineamento&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaComuneLocalita_Tracciato&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo_ComLoc&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELAB_RECORD_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoRecord&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;Input_Staging&quot; match=&quot;/&quot;>&#xa;        &lt;ns:AllineamentoComuneLocalita>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:AnagraficaComuneLocalita_dettaglio)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AnagraficaComuneLocalita_dettaglio&quot;>&#xa;                        &lt;ns:AllineamentoComuneLocalita_Dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_ComLoc * ($index -1)) + position())&quot;/>&#xa;                            &lt;ns:COD_CATAST_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_CATASTALE)&quot;/>&#xa;                            &lt;/ns:COD_CATAST_COMUNE>&#xa;                            &lt;ns:COD_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_EGON)&quot;/>&#xa;                            &lt;/ns:COD_COMUNE>&#xa;                            &lt;ns:COD_DISTR>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_DISTRETTO)&quot;/>&#xa;                            &lt;/ns:COD_DISTR>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;>&#xa;                                &lt;ns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;/>&#xa;                                &lt;/ns:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:DESCR_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:DESC_LOCALITA)&quot;/>&#xa;                            &lt;/ns:DESCR_COMUNE>&#xa;                            &lt;ns:FLAG_BILINGUE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_BILINGUE)&quot;/>&#xa;                            &lt;/ns:FLAG_BILINGUE>&#xa;                            &lt;ns:FLAG_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_COMUNE)&quot;/>&#xa;                            &lt;/ns:FLAG_COMUNE>&#xa;                            &lt;ns:FLAG_LOCALITA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_LOCALITA)&quot;/>&#xa;                            &lt;/ns:FLAG_LOCALITA>&#xa;                            &lt;ns:FLAG_OPERAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPERAZIONE)&quot;/>&#xa;                            &lt;/ns:FLAG_OPERAZIONE>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&#xa;                                &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&#xa;                                &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;ns:ISTAT_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_COMUNE)&quot;/>&#xa;                            &lt;/ns:ISTAT_COMUNE>&#xa;                            &lt;ns:ISTAT_PROV>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_PROVINCIA)&quot;/>&#xa;                            &lt;/ns:ISTAT_PROV>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;ns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TMSP_INSMTO>&#xa;                        &lt;/ns:AllineamentoComuneLocalita_Dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:AnagraficaComuneLocalita_dettaglio&quot;>&#xa;                        &lt;ns:AllineamentoComuneLocalita_Dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo_ComLoc * ($index -1)) + position())&quot;/>&#xa;                            &lt;ns:COD_CATAST_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_CATASTALE)&quot;/>&#xa;                            &lt;/ns:COD_CATAST_COMUNE>&#xa;                            &lt;ns:COD_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_EGON)&quot;/>&#xa;                            &lt;/ns:COD_COMUNE>&#xa;                            &lt;ns:COD_DISTR>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_DISTRETTO)&quot;/>&#xa;                            &lt;/ns:COD_DISTR>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;>&#xa;                                &lt;ns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;/>&#xa;                                &lt;/ns:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:DESCR_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:DESC_LOCALITA)&quot;/>&#xa;                            &lt;/ns:DESCR_COMUNE>&#xa;                            &lt;ns:FLAG_BILINGUE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_BILINGUE)&quot;/>&#xa;                            &lt;/ns:FLAG_BILINGUE>&#xa;                            &lt;ns:FLAG_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_COMUNE)&quot;/>&#xa;                            &lt;/ns:FLAG_COMUNE>&#xa;                            &lt;ns:FLAG_LOCALITA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_LOCALITA)&quot;/>&#xa;                            &lt;/ns:FLAG_LOCALITA>&#xa;                            &lt;ns:FLAG_OPERAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPERAZIONE)&quot;/>&#xa;                            &lt;/ns:FLAG_OPERAZIONE>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&#xa;                                &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&#xa;                                &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;ns:ISTAT_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_COMUNE)&quot;/>&#xa;                            &lt;/ns:ISTAT_COMUNE>&#xa;                            &lt;ns:ISTAT_PROV>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_PROVINCIA)&quot;/>&#xa;                            &lt;/ns:ISTAT_PROV>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;ns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TMSP_INSMTO>&#xa;                        &lt;/ns:AllineamentoComuneLocalita_Dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns:AllineamentoComuneLocalita>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
