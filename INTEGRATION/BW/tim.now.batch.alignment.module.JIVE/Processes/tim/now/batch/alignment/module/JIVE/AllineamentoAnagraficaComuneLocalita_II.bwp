                            </tibex:DesignExpression>
                            <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= ((( $JMSReceiveMessage/Body/ns37:queueResponse/ns37:NumeroRecord ) div $Passo_ComLoc) + 1)]]></bpws:condition>
