                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_COMUNE (COD_CATAST_COMUNE, COD_COMUNE,&#xa;  COD_DISTR, DESCR_COMUNE, DESCR_ERRORE, FLAG_BILINGUE, FLAG_COMUNE,&#xa;  FLAG_LOCALITA, TIPOLG_OPERAZIONE, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG,&#xa;  ISTAT_COMUNE, ISTAT_PROV, NUMERO_RECD, TMSP_INSMTO, CONTENUTO_RECD)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)))" xsi:type="jdbcPalette:JDBCUpdateActivity">

