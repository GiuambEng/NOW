             &lt;xsl:when test=&quot;exists(ns:FLAG_BILINGUE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:FLAG_BILINGUE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/FLAG_BILINGUE>&#xa;                    &lt;FLAG_COMUNE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:FLAG_COMUNE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:FLAG_COMUNE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/FLAG_COMUNE>&#xa;                    &lt;FLAG_LOCALITA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:FLAG_LOCALITA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:FLAG_LOCALITA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/FLAG_LOCALITA>&#xa;                    &lt;TIPOLG_OPERAZIONE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:FLAG_OPERAZIONE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:FLAG_OPERAZIONE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIPOLG_OPERAZIONE>&#xa;                    &lt;ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;xsd:decimal(ns:ID_FILE_PROCSTO_INPUT)&quot;/>&#xa;                    &lt;/ID_FILE_PROCSTO_INPUT>&#xa;                    &lt;ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;xsd:decimal(ns:ID_STATO_ELAB_STAG)&quot;/>&#xa;                    &lt;/ID_STATO_ELAB_STAG>&#xa;                    &lt;ISTAT_COMUNE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:ISTAT_COMUNE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:ISTAT_COMUNE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ISTAT_COMUNE>&#xa;                    &lt;ISTAT_PROV>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:ISTAT_PROV)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:ISTAT_PROV&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ISTAT_PROV>&#xa;                    &lt;NUMERO_RECD>&#xa;                        &lt;xsl:value-of select=&quot;xsd:decimal(ns:NUMERO_RECD)&quot;/>&#xa;                    &lt;/NUMERO_RECD>&#xa;                    &lt;TMSP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:dateTime(ns:TMSP_INSMTO)&quot;/>&#xa;                    &lt;/TMSP_INSMTO>&#xa;                    &lt;CONTENUTO_RECD>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:CONTENUTO_RECD)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:CONTENUTO_RECD&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CONTENUTO_RECD>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
