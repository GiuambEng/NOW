                                    partnerLink="sub_AllineamentoAnagraficaComuneLocalita"
                                    portType="ns8:ComuneLocalita" tibex:xpdlId="02d5fbbf-61b1-4711-bbb0-af23a210f315">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/xsd/AllineamentoAnagraficaComuneLocalita_subProcess" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/sub_ComuneLocalita" version="2.0"&gt;
    &lt;xsl:param name="Input_Sub"/&gt;
    &lt;xsl:template name="Invoke-input" match="/"&gt;
        &lt;tns4:Request&gt;
            &lt;part1&gt;
                &lt;tns2:AnagraficaComuneLocalita&gt;
                    &lt;xsl:copy-of select="$Input_Sub/tns2:AnagraficaComuneLocalita_dettaglio"/&gt;
                &lt;/tns2:AnagraficaComuneLocalita&gt;
            &lt;/part1&gt;
        &lt;/tns4:Request&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
