                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaComuneLocalita_subProcess&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaComuneLocalita_Tracciato&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;Passo_ComLoc&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;Input_Sub&quot; match=&quot;/&quot;>&lt;tns2:AnagraficaComuneLocalita>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:AnagraficaComuneLocalita_dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AnagraficaComuneLocalita_dettaglio&quot;>&lt;tns2:AnagraficaComuneLocalita_dettaglio>&lt;xsl:if test=&quot;tns1:COD_EGON&quot;>&lt;tns2:COD_EGON>&lt;xsl:value-of select=&quot;tns1:COD_EGON&quot;/>&lt;/tns2:COD_EGON>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DESC_LOCALITA&quot;>&lt;tns2:DESC_LOCALITA>&lt;xsl:value-of select=&quot;tns1:DESC_LOCALITA&quot;/>&lt;/tns2:DESC_LOCALITA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ISTAT_COMUNE&quot;>&lt;tns2:ISTAT_COMUNE>&lt;xsl:value-of select=&quot;tns1:ISTAT_COMUNE&quot;/>&lt;/tns2:ISTAT_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ISTAT_PROVINCIA&quot;>&lt;tns2:ISTAT_PROVINCIA>&lt;xsl:value-of select=&quot;tns1:ISTAT_PROVINCIA&quot;/>&lt;/tns2:ISTAT_PROVINCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_DISTRETTO&quot;>&lt;tns2:COD_DISTRETTO>&lt;xsl:value-of select=&quot;tns1:COD_DISTRETTO&quot;/>&lt;/tns2:COD_DISTRETTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_CATASTALE&quot;>&lt;tns2:COD_CATASTALE>&lt;xsl:value-of select=&quot;tns1:COD_CATASTALE&quot;/>&lt;/tns2:COD_CATASTALE>&lt