                                    sqlStatement="INSERT INTO STAG_PROV (COD_DISTR, COD_PROV, DESCR_ERRORE,&#xa;  DESCR_PROV, TIPOLG_OPERAZIONE, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG,&#xa;  ISTAT_PROV, NUMERO_RECD, SIGLA_PROV, TMSP_INSMTO, CONTENUTO_RECD)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)))" xsi:type="jdbcPalette:JDBCUpdateActivity">

