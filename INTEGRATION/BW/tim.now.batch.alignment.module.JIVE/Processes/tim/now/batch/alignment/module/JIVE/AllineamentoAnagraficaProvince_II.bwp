                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:tns3=&quot;http://www.example.org/ManageMoveFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;PathFileError&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess6-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:InputData>&#xa;            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FULLNAME&quot;>&#xa;                &lt;tns3:FullPathOrigine>&#xa;                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FULLNAME&quot;/>&#xa;                &lt;/tns3:FullPathOrigine>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns3:FolderDestinazione>&#xa;                &lt;xsl:value-of select=&quot;$PathFileError&quot;/>&#xa;            &lt;/tns3:FolderDestinazione>&#xa;            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FILENAME&quot;>&#xa;                &lt;tns3:NomeFile>&#xa;                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FILENAME&quot;/>&#xa;                &lt;/tns3:NomeFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_TRACK)>0&quot;>&#xa;                &lt;tns3:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_TRACK)&quot;/>&#xa;                &lt;/tns3:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns3:LogInput>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LogName>&#xa;            &lt;/tns3:LogInput>&#xa;        &lt;/tns3:InputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
