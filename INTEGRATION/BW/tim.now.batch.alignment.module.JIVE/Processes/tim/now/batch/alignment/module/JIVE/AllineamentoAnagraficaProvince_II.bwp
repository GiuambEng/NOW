                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/InsertStagingAnagraficaProvince_Allineamento&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaProvince_Tracciato&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELAB_RECORD_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;current-dateTime&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo_PROVINCE&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoRecord&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;Input_Staging&quot; match=&quot;/&quot;>&#xa;        &lt;ns:AllineamentoProvince>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:AnagraficaProvince_dettaglio)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AnagraficaProvince_dettaglio&quot;>&#xa;                        &lt;ns:AllineamentoProvince_Dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_PROVINCE * ($index -1)) + position())&quot;/>&#xa;                            &lt;ns:COD_DISTR>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_DISTRETTO)&quot;/>&#xa;                            &lt;/ns:COD_DISTR>&#xa;                            &lt;ns:COD_PROV>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_PROVINCIA)&quot;/>&#xa;                            &lt;/ns:COD_PROV>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;>&#xa;                                &lt;ns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;/>&#xa;                                &lt;/ns:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:DESCR_PROV>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:DESCRIZIONE)&quot;/>&#xa;                            &lt;/ns:DESCR_PROV>&#xa;                            &lt;ns:FLAG_OPERAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPERAZIONE)&quot;/>&#xa;                            &lt;/ns:FLAG_OPERAZIONE>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&#xa;                                &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&#xa;                                &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;ns:ISTAT_PROV>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_PROV)&quot;/>&#xa;                            &lt;/ns:ISTAT_PROV>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;ns:SIGLA_PROV>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:SIGLA_PROV)&quot;/>&#xa;                            &lt;/ns:SIGLA_PROV>&#xa;                            &lt;ns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TMSP_INSMTO>&#xa;                        &lt;/ns:AllineamentoProvince_Dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:AnagraficaProvince_dettaglio&quot;>&#xa;                        &lt;ns:AllineamentoProvince_Dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo_PROVINCE * ($index -1)) + position())&quot;/>&#xa;                            &lt;ns:COD_DISTR>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_DISTRETTO)&quot;/>&#xa;                            &lt;/ns:COD_DISTR>&#xa;                            &lt;ns:COD_PROV>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_PROVINCIA)&quot;/>&#xa;                            &lt;/ns:COD_PROV>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;>&#xa;                                &lt;ns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;/>&#xa;                                &lt;/ns:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:DESCR_PROV>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:DESCRIZIONE)&quot;/>&#xa;                            &lt;/ns:DESCR_PROV>&#xa;                            &lt;ns:FLAG_OPERAZIONE>&#xa;                    