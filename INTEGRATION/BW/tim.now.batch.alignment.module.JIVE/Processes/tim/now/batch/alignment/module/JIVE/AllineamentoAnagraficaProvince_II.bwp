:LATITUDINE&quot;>&lt;tns2:LATITUDINE>&lt;xsl:value-of select=&quot;tns1:LATITUDINE&quot;/>&lt;/tns2:LATITUDINE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:LONGITUDINE&quot;>&lt;tns2:LONGITUDINE>&lt;xsl:value-of select=&quot;tns1:LONGITUDINE&quot;/>&lt;/tns2:LONGITUDINE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FlagValidita&quot;>&lt;tns2:FlagValidita>&lt;xsl:value-of select=&quot;tns1:FlagValidita&quot;/>&lt;/tns2:FlagValidita>&lt;/xsl:if>&lt;tns2:Numero_record>&lt;xsl:value-of select=&quot;(($Passo_PROVINCE * ($index -1)) + position())&quot;/>&lt;/tns2:Numero_record>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&lt;tns2:ID_FILE>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&lt;/tns2:ID_FILE>&lt;/xsl:if>&lt;/tns2:AnagraficaProvince_dettaglio>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:AnagraficaProvince>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
