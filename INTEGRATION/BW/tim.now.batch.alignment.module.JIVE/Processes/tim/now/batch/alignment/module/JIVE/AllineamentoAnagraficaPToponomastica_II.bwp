aging_PToponomastica&quot;/>&lt;/tns:VALORE>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;PathFileScarto&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$PathFileScarto&quot;/>&lt;/tns:VALORE>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;NameFile&amp;quot;&quot;/>&lt;/tns:NOME>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;/>&lt;/tns:VALORE>&lt;/xsl:if>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;ErrorPathFile&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$PathFileError&quot;/>&lt;/tns:VALORE>&lt;/tns:InputDetails>&lt;/tns:Details>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
