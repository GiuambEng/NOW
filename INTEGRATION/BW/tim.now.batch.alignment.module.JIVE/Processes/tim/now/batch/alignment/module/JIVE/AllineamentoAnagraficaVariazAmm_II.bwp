                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4d2d94c5-ac5c-41d3-ab85-c13f3f0c9fd5+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaVariazioniAmministrative_Tracciato&quot; xmlns:ns2=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELAB_RECORD_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo_VarAmm&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:VariazioniAmministrative_Dettaglio)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:VariazioniAmministrative_Dettaglio&quot;>&#xa;                        &lt;Record>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_VarAmm * ($index -1)) + position())&quot;/>&#xa;                            &lt;COD_VIA_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_VIA_NEW)&quot;/>&#xa;                            &lt;/COD_VIA_NEW>&#xa;                            &lt;COD_VIA_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_VIA_OLD)&quot;/>&#xa;                            &lt;/COD_VIA_OLD>&#xa;                            &lt;COD_COMUNE_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_COMUNE_NEW)&quot;/>&#xa;                            &lt;/COD_COMUNE_NEW>&#xa;                            &lt;COD_COMUNE_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_COMUNE_OLD)&quot;/>&#xa;                            &lt;/COD_COMUNE_OLD>&#xa;                            &lt;COD_NUMERO_CIVICO_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_CIVICO_NEW)&quot;/>&#xa;                            &lt;/COD_NUMERO_CIVICO_NEW>&#xa;                            &lt;COD_NUMERO_CIVICO_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_CIVICO_OLD)&quot;/>&#xa;                            &lt;/COD_NUMERO_CIVICO_OLD>&#xa;                            &lt;COD_STRADA_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_STRADA_NEW)&quot;/>&#xa;                            &lt;/COD_STRADA_NEW>&#xa;                            &lt;COD_STRADA_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_VIA_OLD)&quot;/>&#xa;                            &lt;/COD_STRADA_OLD>&#xa;                            &lt;DESCR_ERRORE xsi:nil=&quot;true&quot;/>&#xa;                            &lt;ID_FILE_PROCSTO_INPUT>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;xsd:decimal($OK_ELAB_RECORD_FILE)&quot;/>&#xa;                            &lt;/ID_STATO_ELAB_STAG>&#xa;                            &lt;ISTAT_COMUNE_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_ISTAT_COMUNE_NEW)&quot;/>&#xa;                            &lt;/ISTAT_COMUNE_NEW>&#xa;                            &lt;ISTAT_COMUNE_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_ISTAT_COMUNE_OLD)&quot;/>&#xa;                            &lt;/ISTAT_COMUNE_OLD>&#xa;                            &lt;ISTAT_PROV_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_ISTAT_PROV_NEW)&quot;/>&#xa;                            &lt;/ISTAT_PROV_NEW>&#xa;                            &lt;ISTAT_PROV_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_ISTAT_PROV_OLD)&quot;/>&#xa;                            &lt;/ISTAT_PROV_OLD>&#xa;                            &lt;NUMERO_CIVICO_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CIVICO_NEW)&quot;/>&#xa;                            &lt;/NUMERO_CIVICO_NEW>&#xa;                            &lt;NUMERO_CIVICO_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CIVICO_OLD)&quot;/>&#xa;                            &lt;/NUMERO_CIVICO_OLD>&#xa;                            &lt;NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/NUMERO_RECD>&#xa;                            &lt;TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/TMSP_INSMTO>&#xa;                            &lt;CONTENUTO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;concat(tns1:CODICE_CIVICO_NEW,tns1:CIVICO_NEW,tns1:CODICE_STRADA_NEW,tns1:CODICE_ISTAT_PROV_NEW,tns1:CODICE_ISTAT_COMUNE_NEW,tns1:CODICE_VIA_NEW,tns1:CODICE_COMUNE_NEW,tns1:CODICE_CIVICO_OLD,tns1:CIVICO_OLD,tns1:CODICE_STRADA_OLD,tns1:CODICE_ISTAT_PROV_OLD,tns1:CODICE_ISTAT_COMUNE_OLD,tns1:CODICE_VIA_OLD,tns1:CODICE_COMUNE_OLD)&quot;/>&#xa;                            &lt;/CONTENUTO_RECD>&#xa;                        &lt;/Record>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:VariazioniAmministrative_Dettaglio&quot;>&#xa;                        &lt;Record>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo_VarAmm * ($index -1)) + position())&quot;/>&#xa;                            &lt;COD_VIA_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_VIA_NEW)&quot;/>&#xa;                            &lt;/COD_VIA_NEW>&#xa;                            &lt;COD_VIA_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_VIA_OLD)&quot;/>&#xa;                            &lt;/COD_VIA_OLD>&#xa;                            &lt;COD_COMUNE_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_COMUNE_NEW)&quot;/>&#xa;                            &lt;/COD_COMUNE_NEW>&#xa;                            &lt;COD_COMUNE_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_COMUNE_OLD)&quot;/>&#xa;                            &lt;/COD_COMUNE_OLD>&#xa;                            &lt;COD_NUMERO_CIVICO_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_CIVICO_NEW)&quot;/>&#xa;                            &lt;/COD_NUMERO_CIVICO_NEW>&#xa;                            &lt;COD_NUMERO_CIVICO_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_CIVICO_OLD)&quot;/>&#xa;                            &lt;/COD_NUMERO_CIVICO_OLD>&#xa;                            &lt;COD_STRADA_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_STRADA_NEW)&quot;/>&#xa;                            &lt;/COD_STRADA_NEW>&#xa;                            &lt;COD_STRADA_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_STRADA_OLD)&quot;/>&#xa;                            &lt;/COD_STRADA_OLD>&#xa;                            &lt;DESCR_ERRORE xsi:nil=&quot;true&quot;/>&#xa;                            &lt;ID_FILE_PROCSTO_INPUT>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;xsd:decimal($OK_ELAB_RECORD_FILE)&quot;/>&#xa;                            &lt;/ID_STATO_ELAB_STAG>&#xa;                            &lt;ISTAT_COMUNE_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_ISTAT_COMUNE_NEW)&quot;/>&#xa;                            &lt;/ISTAT_COMUNE_NEW>&#xa;                            &lt;ISTAT_COMUNE_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_ISTAT_COMUNE_OLD)&quot;/>&#xa;                            &lt;/ISTAT_COMUNE_OLD>&#xa;                            &lt;ISTAT_PROV_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_ISTAT_PROV_NEW)&quot;/>&#xa;                            &lt;/ISTAT_PROV_NEW>&#xa;                            &lt;ISTAT_PROV_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_ISTAT_PROV_OLD)&quot;/>&#xa;                            &lt;/ISTAT_PROV_OLD>&#xa;                            &lt;NUMERO_CIVICO_NEW>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CIVICO_NEW)&quot;/>&#xa;                            &lt;/NUMERO_CIVICO_NEW>&#xa;                            &lt;NUMERO_CIVICO_OLD>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CIVICO_OLD)&quot;/>&#xa;                            &lt;/NUMERO_CIVICO_OLD>&#xa;                            &lt;NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/NUMERO_RECD>&#xa;                            &lt;TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/TMSP_INSMTO>&#xa;                            &lt;CONTENUTO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;concat(tns1:CODICE_CIVICO_NEW,tns1:CIVICO_NEW,tns1:CODICE_STRADA_NEW,tns1:CODICE_ISTAT_PROV_NEW,tns1:CODICE_ISTAT_COMUNE_NEW,tns1:CODICE_VIA_NEW,tns1:CODICE_COMUNE_NEW,tns1:CODICE_CIVICO_OLD,tns1:CIVICO_OLD,tns1:CODICE_STRADA_OLD,tns1:CODICE_ISTAT_PROV_OLD,tns1:CODICE_ISTAT_COMUNE_OLD,tns1:CODICE_VIA_OLD,tns1:CODICE_COMUNE_OLD)&quot;/>&#xa;                            &lt;/CONTENUTO_RECD>&#xa;                        &lt;/Record>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
