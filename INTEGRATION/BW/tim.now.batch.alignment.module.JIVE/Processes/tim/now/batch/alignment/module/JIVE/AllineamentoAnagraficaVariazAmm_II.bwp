                            &lt;/xsl:for-each&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:for-each select="$DetailUltimi_NoVal/Rows/tns2:VariazioniAmministrative_Dettaglio"&gt;
                                &lt;tns:VariazioniAmministrative_Dettaglio&gt;
