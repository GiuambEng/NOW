                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns2:CODICE_ISTAT_COMUNE_NEW"&gt;
                                        &lt;tns:CODICE_ISTAT_COMUNE_NEW&gt;
                                            &lt;xsl:value-of select="tns2:CODICE_ISTAT_COMUNE_NEW"/&gt;
                                        &lt;/tns:CODICE_ISTAT_COMUNE_NEW&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns2:CODICE_VIA_NEW"&gt;
                                        &lt;tns:CODICE_VIA_NEW&gt;
                                            &lt;xsl:value-of select="tns2:CODICE_VIA_NEW"/&gt;
                                        &lt;/tns:CODICE_VIA_NEW&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns2:CODICE_COMUNE_NEW"&gt;
                                        &lt;tns:CODICE_COMUNE_NEW&gt;
                                            &lt;xsl:value-of select="tns2:CODICE_COMUNE_NEW"/&gt;
                                        &lt;/tns:CODICE_COMUNE_NEW&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns2:CODICE_CIVICO_OLD"&gt;
                                        &lt;tns:CODICE_CIVICO_OLD&gt;
                                            &lt;xsl:value-of select="tns2:CODICE_CIVICO_OLD"/&gt;
                                        &lt;/tns:CODICE_CIVICO_OLD&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns2:CIVICO_OLD"&gt;
                                        &lt;tns:CIVICO_OLD&gt;
                                            &lt;xsl:value-of select="tns2:CIVICO_OLD"/&gt;
                                        &lt;/tns:CIVICO_OLD&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns2:CODICE_STRADA_OLD"&gt;
                                        &lt;tns:CODICE_STRADA_OLD&gt;
                                            &lt;xsl:value-of select="tns2:CODICE_STRADA_OLD"/&gt;
                                        &lt;/tns:CODICE_STRADA_OLD&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns2:CODICE_ISTAT_PROV_OLD"&gt;
                                        &lt;tns:CODICE_ISTAT_PROV_OLD&gt;
                                            &lt;xsl:value-of select="tns2:CODICE_ISTAT_PROV_OLD"/&gt;
                                        &lt;/tns:CODICE_ISTAT_PROV_OLD&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns2:CODICE_ISTAT_COMUNE_OLD"&gt;
                                        &lt;tns:CODICE_ISTAT_COMUNE_OLD&gt;
                                            &lt;xsl:value-of select="tns2:CODICE_ISTAT_COMUNE_OLD"/&gt;
                                        &lt;/tns:CODICE_ISTAT_COMUNE_OLD&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns2:CODICE_VIA_OLD"&gt;
                                        &lt;tns:CODICE_VIA_OLD&gt;
                                            &lt;xsl:value-of select="tns2:CODICE_VIA_OLD"/&gt;
                                        &lt;/tns:CODICE_VIA_OLD&gt;
