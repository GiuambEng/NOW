                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaVariazioniAmministrative_subProcess&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/sub_VarAmm&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaVariazioniAmministrative_Tracciato&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo_VarAmm&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke_SubProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:VariazioniAmministrative>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns2:VariazioniAmministrative_Dettaglio)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns2:VariazioniAmministrative_Dettaglio&quot;>&#xa;                        &lt;tns:VariazioniAmministrative_Dettaglio>&#xa;                            &lt;xsl:if test=&quot;tns2:CODICE_CIVICO_NEW&quot;>&#xa;                                &lt;tns:CODICE_CIVICO_NEW>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:CODICE_CIVICO_NEW&quot;/>&#xa;                                &lt;/tns:CODICE_CIVICO_NEW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:CIVICO_NEW&quot;>&#xa;                                &lt;tns:CIVICO_NEW>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:CIVICO_NEW&quot;/>&#xa;                                &lt;/tns:CIVICO_NEW>&#xa;                            &lt;/xsl:if>