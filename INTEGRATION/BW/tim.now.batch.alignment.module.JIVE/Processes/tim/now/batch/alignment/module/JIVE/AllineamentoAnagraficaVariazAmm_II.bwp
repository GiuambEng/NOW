            <bpws:invoke inputVariable="UpCount-input" name="UpCount"
                operation="Insert" outputVariable="UpCount"
                partnerLink="Logger" portType="ns3:ProcessLog" tibex:xpdlId="edeb4024-035e-436f-b594-7667b752b0e6">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://www.tim.com/NOW/AllineamentiBatch/contaRecord/" xmlns:ns2="www.tim.now.contarecord_jms.response" version="2.0"&gt;&lt;xsl:param name="JMSReceiveMessage"/&gt;&lt;xsl:template name="UpCount-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;COUNTER&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:FileProcessatoInput&gt;&lt;xsl:if test="$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE"&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$JMSReceiveMessage/Body/ns2:queueResponse/ns2:NumeroRecord"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$JMSReceiveMessage/Body/ns2:queueResponse/ns2:NumeroRecord"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoInput&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; xmlns:ns2=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;UpCount-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;COUNTER&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:FileProcessatoInput>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:NumeroRecord&quot;>&#xa;                    &lt;ns:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:NumeroRecord&quot;/>&#xa;                    &lt;/ns:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessatoInput>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
