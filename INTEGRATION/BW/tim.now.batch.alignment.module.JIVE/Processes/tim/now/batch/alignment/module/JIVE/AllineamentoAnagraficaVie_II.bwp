                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_VIA (CAP, COD_VIA, COD_COMUNE, COD_DISTR,&#xa;  COD_PARTICELLA_TOPON, COD_STRADA, DESCR_ERRORE, DESCR_VIA, FLAG_MULTICAP,&#xa;  TIPOLG_OPERAZIONE, FLAG_UFF, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG,&#xa;  ISTAT_COMUNE, ISTAT_PROV, NUMERO_RECD, TMSP_INSMTO, CONTENUTO_RECD)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)))" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CAP"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_VIA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_COMUNE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_DISTR"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_PARTICELLA_TOPON"/>

                                    <PreparedParameters
