                    </bpws:targets>
                </bpws:empty>
                <bpws:scope name="While" tibex:group="while" tibex:xpdlId="9d68eae4-b7e3-4338-8035-1e92081b9b9f">
                    <bpws:targets>
                        <bpws:target linkName="GroupStart1ToWhile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="WhileToGroupEnd1"/>
                    </bpws:sources>
                    <bpws:variables>
                        <bpws:variable name="index"
                            sca-bpel:internal="true" type="xsd:int">
                            <bpws:from>
                                <bpws:literal>1</bpws:literal>
                            </bpws:from>
                        </bpws:variable>
                        <bpws:variable name="current-dateTime" type="xsd:string"/>
