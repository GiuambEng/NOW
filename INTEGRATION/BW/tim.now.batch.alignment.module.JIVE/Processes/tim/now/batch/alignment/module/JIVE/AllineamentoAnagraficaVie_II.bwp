lt;/tns3:InputDetails>&#xa;            &lt;tns3:InputDetails>&#xa;                &lt;tns3:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ErrorPathFile&amp;quot;&quot;/>&#xa;                &lt;/tns3:NOME>&#xa;                &lt;tns3:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;$PathFileError&quot;/>&#xa;                &lt;/tns3:VALORE>&#xa;            &lt;/tns3:InputDetails>&#xa;        &lt;/tns3:Details>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
