               &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/FLAG_MULTICAP>&#xa;                    &lt;TIPOLG_OPERAZIONE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns4:FLAG_OPERAZIONE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns4:FLAG_OPERAZIONE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIPOLG_OPERAZIONE>&#xa;                    &lt;FLAG_UFF>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns4:FLAG_UFF)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns4:FLAG_UFF&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/FLAG_UFF>&#xa;                    &lt;ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;xsd:decimal(tns4:ID_FILE_PROCSTO_INPUT)&quot;/>&#xa;                    &lt;/ID_FILE_PROCSTO_INPUT>&#xa;                    &lt;ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;xsd:decimal(tns4:ID_STATO_ELAB_STAG)&quot;/>&#xa;                    &lt;/ID_STATO_ELAB_STAG>&#xa;                    &lt;ISTAT_COMUNE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns4:ISTAT_COMUNE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns4:ISTAT_COMUNE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ISTAT_COMUNE>&#xa;                    &lt;ISTAT_PROV>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns4:ISTAT_PROV)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns4:ISTAT_PROV&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ISTAT_PROV>&#xa;                    &lt;NUMERO_RECD>&#xa;                        &lt;xsl:value-of select=&quot;xsd:decimal(tns4:NUMERO_RECD)&quot;/>&#xa;                    &lt;/NUMERO_RECD>&#xa;                    &lt;TMSP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:dateTime(tns4:TMSP_INSMTO)&quot;/>&#xa;                    &lt;/TMSP_INSMTO>&#xa;                    &lt;CONTENUTO_RECD>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns4:CONTENUTO_RECD)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns4:CONTENUTO_RECD&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CONTENUTO_RECD>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
