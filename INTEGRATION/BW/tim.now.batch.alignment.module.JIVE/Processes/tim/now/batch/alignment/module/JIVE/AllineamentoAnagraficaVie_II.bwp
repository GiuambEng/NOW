                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Input_Staging"
                                    name="Input_Staging"
                                    outputVariable="Input_Staging"
                                    tibex:xpdlId="f0d4c757-3f90-4877-a1d1-85967e5e1ee5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign2ToAssign3"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Input_StagingToLog_InputStaging"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InsertStagingAnagraficaVie_Allineamento&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaVie_Tracciato&quot; xmlns:ns=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo_VIE&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELAB_RECORD_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoRecod&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;Input_Staging&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:AllineamentoAnagraficaVie>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:AnagraficaVie_Dettaglio)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AnagraficaVie_Dettaglio&quot;>&#xa;                        &lt;tns3:AllineamentoAnagraficaVie_Dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_VIE * ($index -1)) + position())&quot;/>&#xa;                            &lt;tns3:COD_STRADA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_STRADA)&quot;/>&#xa;                            &lt;/tns3:COD_STRADA>&#xa;                            &lt;tns3:COD_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_COMUNE)&quot;/>&#xa;                            &lt;/tns3:COD_COMUNE>&#xa;                            &lt;tns3:ISTAT_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_COMUNE)&quot;/>&#xa;                            &lt;/tns3:ISTAT_COMUNE>&#xa;                            &lt;tns3:ISTAT_PROV>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_PROVINCIA)&quot;/>&#xa;                            &lt;/tns3:ISTAT_PROV>&#xa;                            &lt;tns3:COD_VIA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_VIA)&quot;/>&#xa;                            &lt;/tns3:COD_VIA>&#xa;                            &lt;tns3:DESCR_VIA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:DESC_VIA)&quot;/>&#xa;                            &lt;/tns3:DESCR_VIA>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecod/ns:Output_ContenutoRecord[ns:Posizione=$var]/ns:Valore&quot;>&#xa;                                &lt;tns3:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecod/ns:Output_ContenutoRecord[ns:Posizione=$var]/ns:Valore&quot;/>&#xa;                                &lt;/tns3:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns3:COD_PARTICELLA_TOPON>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_PART_TOP)&quot;/>&#xa;                            &lt;/tns3:COD_PARTICELLA_TOPON>&#xa;                            &lt;tns3:FLAG_MULTICAP>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_MULTICAP)&quot;/>&#xa;                            &lt;/tns3:FLAG_MULTICAP>&#xa;                            &lt;tns3:CAP>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CAP)&quot;/>&#xa;                            &lt;/tns3:CAP>&#xa;                            &lt;tns3:FLAG_UFF>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_UFF)&quot;/>&#xa;                            &lt;/tns3:FLAG_UFF>&#xa;                            &lt;tns3:COD_DISTR>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_DISTRETTO)&quot;/>&#xa;                            &lt;/tns3:COD_DISTR>&#xa;                            &lt;tns3:FLAG_OPERAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPERAZIONE)&quot;/>&#xa;                            &lt;/tns3:FLAG_OPERAZIONE>&#xa;                            &lt;tns3:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/tns3:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&#xa;                                &lt;tns3:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&#xa;                                &lt;/tns3:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns3:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&#xa;                            &lt;/tns3:ID_STATO_ELAB_STAG>&#xa;                            &lt;tns3:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns3:TMSP_INSMTO>&#xa;                        &lt;/tns3:AllineamentoAnagraficaVie_Dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:AnagraficaVie_Dettaglio&quot;>&#xa;                        &lt;tns3:AllineamentoAnagraficaVie_Dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo_VIE * ($index -1)) + position())&quot;/>&#xa;                            &lt;tns3:COD_STRADA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_STRADA)&quot;/>&#xa;                            &lt;/tns3:COD_STRADA>&#xa;                            &lt;tns3:COD_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_COMUNE)&quot;/>&#xa;                            &lt;/tns3:COD_COMUNE>&#xa;                            &lt;tns3:ISTAT_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_COMUNE)&quot;/>&#xa;                            &lt;/tns3:ISTAT_COMUNE>&#xa;                            &lt;tns3:ISTAT_PROV>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_PROVINCIA)&quot;/>&#xa;                            &lt;/tns3:ISTAT_PROV>&#xa;                            &lt;tns3:COD_VIA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_VIA)&quot;/>&#xa;                            &lt;/tns3:COD_VIA>&#xa;                            &lt;tns3:DESCR_VIA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:DESC_VIA)&quot;/>&#xa;                            &lt;/tns3:DESCR_VIA>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecod/ns:Output_ContenutoRecord[ns:Posizione=$var1]/ns:Valore&quot;>&#xa;                                &lt;tns3:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecod/ns:Output_ContenutoRecord[ns:Posizione=$var1]/ns:Valore&quot;/>&#xa;                                &lt;/tns3:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns3:COD_PARTICELLA_TOPON>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_PART_TOP)&quot;/>&#xa;                            &lt;/tns3:COD_PARTICELLA_TOPON>&#xa;                            &lt;tns3:FLAG_MULTICAP>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_MULTICAP)&quot;/>&#xa;                            &lt;/tns3:FLAG_MULTICAP>&#xa;                            &lt;tns3:CAP>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CAP)&quot;/>&#xa;                            &lt;/tns3:CAP>&#xa;                            &lt;tns3:FLAG_UFF>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_UFF)&quot;/>&#xa;                            &lt;/tns3:FLAG_UFF>&#xa;                            &lt;tns3:COD_DISTR>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_DISTRETTO)&quot;/>&#xa;                            &lt;/tns3:COD_DISTR>&#xa;                            &lt;tns3:FLAG_OPERAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPERAZIONE)&quot;/>&#xa;                            &lt;/tns3:FLAG_OPERAZIONE>&#xa;                            &lt;tns3:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/tns3:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&#xa;                                &lt;tns3:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&#xa;                                &lt;/tns3:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns3:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&#xa;                            &lt;/tns3:ID_STATO_ELAB_STAG>&#xa;                            &lt;tns3:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns3:TMSP_INSMTO>&#xa;                        &lt;/tns3:AllineamentoAnagraficaVie_Dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:AllineamentoAnagraficaVie>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
