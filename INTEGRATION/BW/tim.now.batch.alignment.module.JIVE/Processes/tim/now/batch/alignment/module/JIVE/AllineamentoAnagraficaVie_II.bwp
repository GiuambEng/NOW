                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaVie_subProcess&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoAnagraficaVie_Tracciato&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;Passo_VIE&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;Input_Sub&quot; match=&quot;/&quot;>&lt;tns2:AnagraficaVie>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:AnagraficaVie_Dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AnagraficaVie_Dettaglio&quot;>&lt;tns2:AnagraficaVie_Dettaglio>&lt;xsl:if test=&quot;tns1:CODICE_STRADA&quot;>&lt;tns2:CODICE_STRADA>&lt;xsl:value-of select=&quot;tns1:CODICE_STRADA&quot;/>&lt;/tns2:CODICE_STRADA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_COMUNE&quot;>&lt;tns2:COD_COMUNE>&lt;xsl:value-of select=&quot;tns1:COD_COMUNE&quot;/>&lt;/tns2:COD_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ISTAT_COMUNE&quot;>&lt;tns2:ISTAT_COMUNE>&lt;xsl:value-of select=&quot;tns1:ISTAT_COMUNE&quot;/>&lt;/tns2:ISTAT_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ISTAT_PROVINCIA&quot;>&lt;tns2:ISTAT_PROVINCIA>&lt;xsl:value-of select=&quot;tns1:ISTAT_PROVINCIA&quot;/>&lt;/tns2:ISTAT_PROVINCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_VIA&quot;>&lt;tns2:COD_VIA>&lt;xsl:value-of select=&quot;tns1:COD_VIA&quot;/>&lt;/tns2:COD_VIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DESC_VIA&quot;>&lt;tns2:DESC_VIA>&lt;xsl:value-of select=&quot;tns1:DESC_VIA&quot;/>&lt;/tns2:DESC_VIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_PART_TOP&quot;>&lt;tns2:COD_PART_TOP>&lt;xsl:value-of select=&quot;tns1:COD_PART_TOP&quot;/>&lt;/tns2:COD_PART_TOP>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_MULTICAP&quot;>&lt;tns2:FLAG_MULTICAP>&lt;xsl:value-of select=&quot;tns1:FLAG_MULTICAP&quot;/>&lt;/tns2:FLAG_MULTICAP>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CAP&quot;>&lt;tns2:CAP>&lt;xsl:value-of select=&quot;tns1:CAP&quot;/>&lt;/tns2:CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_UFF&quot;>&lt;tns2:FLAG_UFF>&lt;xsl:value-of select=&quot;tns1:FLAG_UFF&quot;/>&lt;/tns2:FLAG_UFF>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_DISTRETTO&quot;>&lt;tns2:CODICE_DISTRETTO>&lt;xsl:value-of select=&quot;tns1:CODICE_DISTRETTO&quot;/>&lt;/tns2:CODICE_DISTRETTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_OPERAZIONE&quot;>&lt;tns2:FLAG_OPERAZIONE>&lt;xsl:value-of select=&quot;tns1:FLAG_OPERAZIONE&quot;/>&lt;/tns2:FLAG_OPERAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:LATITUDINE&quot;>&lt;tns2:LATITUDINE>&lt;xsl:value-of select=&quot;tns1:LATITUDINE&quot;/>&lt;/tns2:LATITUDINE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:LONGITUDINE&quot;>&lt;tns2:LONGITUDINE>&lt;xsl:value-of select=&quot;tns1:LONGITUDINE&quot;/>&lt;/tns2:LONGITUDINE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FlagValidita&quot;>&lt;tns2:FlagValidita>&lt;xsl:value-of select=&quot;tns1:FlagValidita&quot;/>&lt;/tns2:FlagValidita>&lt;/xsl:if>&lt;tns2:Numero_record>&lt;xsl:value-of select=&quot;(($Passo_VIE * ($index -1)) + position())&quot;/>&lt;/tns2:Numero_record>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&lt;tns2:ID_FILE>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&lt;/tns2:ID_FILE>&lt;/xsl:if>&lt;/tns2:AnagraficaVie_Dettaglio>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:AnagraficaVie_Dettaglio&quot;>&lt;tns2:AnagraficaVie_Dettaglio>&lt;xsl:if test=&quot;tns1:CODICE_STRADA&quot;>&lt;tns2:CODICE_STRADA>&lt;xsl:value-of select=&quot;tns1:CODICE_STRADA&quot;/>&lt;/tns2:CODICE_STRADA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_COMUNE&quot;>&lt;tns2:COD_COMUNE>&lt;xsl:value-of select=&quot;tns1:COD_COMUNE&quot;/>&lt;/tns2:COD_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ISTAT_COMUNE&quot;>&lt;tns2:ISTAT_COMUNE>&lt;xsl:value-of select=&quot;tns1:ISTAT_COMUNE&quot;/>&lt;/tns2:ISTAT_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ISTAT_PROVINCIA&quot;>&lt;tns2:ISTAT_PROVINCIA>&lt;xsl:value-of select=&quot;tns1:ISTAT_PROVINCIA&quot;/>&lt;/tns2:ISTAT_PROVINCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_VIA&quot;>&lt;tns2:COD_VIA>&lt;xsl:value-of select=&quot;tns1:COD_VIA&quot;/>&lt;/tns2:COD_VIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DESC_VIA&quot;>&lt;tns2:DESC_VIA>&lt;xsl:value-of select=&quot;tns1:DESC_VIA&quot;/>&lt;/tns2:DESC_VIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:COD_PART_TOP&quot;>&lt;tns2:COD_PART_TOP>&lt;xsl:value-of select=&quot;tns1:COD_PART_TOP&quot;/>&lt;/tns2:COD_PART_TOP>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_MULTICAP&quot;>&lt;tns2:FLAG_MULTICAP>&lt;xsl:value-of select=&quot;tns1:FLAG_MULTICAP&quot;/>&lt;/tns2:FLAG_MULTICAP>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CAP&quot;>&lt;tns2:CAP>&lt;xsl:value-of select=&quot;tns1:CAP&quot;/>&lt;/tns2:CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_UFF&quot;>&lt;tns2:FLAG_UFF>&lt;xsl:value-of select=&quot;tns1:FLAG_UFF&quot;/>&lt;/tns2:FLAG_UFF>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_DISTRETTO&quot;>&lt;tns2:CODICE_DISTRETTO>&lt;xsl:value-of select=&quot;tns1:CODICE_DISTRETTO&quot;/>&lt;/tns2:CODICE_DISTRETTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FLAG_OPERAZIONE&quot;>&lt;tns2:FLAG_OPERAZIONE>&lt;xsl:value-of select=&quot;tns1:FLAG_OPERAZIONE&quot;/>&lt;/tns2:FLAG_OPERAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:LATITUDINE&quot;>&lt;tns2:LATITUDINE>&lt;xsl:value-of select=&quot;tns1:LATITUDINE&quot;/>&lt;/tns2:LATITUDINE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:LONGITUDINE&quot;>&lt;tns2:LONGITUDINE>&lt;xsl:value-of select=&quot;tns1:LONGITUDINE&quot;/>&lt;/tns2:LONGITUDINE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FlagValidita&quot;>&lt;tns2:FlagValidita>&lt;xsl:value-of select=&quot;tns1:FlagValidita&quot;/>&lt;/tns2:FlagValidita>&lt;/xsl:if>&lt;tns2:Numero_record>&lt;xsl:value-of select=&quot;(($Passo_VIE * ($index -1)) + position())&quot;/>&lt;/tns2:Numero_record>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&lt;tns2:ID_FILE>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&lt;/tns2:ID_FILE>&lt;/xsl:if>&lt;/tns2:AnagraficaVie_Dettaglio>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:AnagraficaVie>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
