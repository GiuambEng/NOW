                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NomeFileScarto&quot;/>&#xa;    &lt;xsl:param name=&quot;OffsetVie&quot;/>&#xa;    &lt;xsl:param name=&quot;PATH_FILE_MOVE&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;Nome_Staging_Vie&quot;/>&#xa;    &lt;xsl:param name=&quot;PathFileError&quot;/>&#xa;    &lt;xsl:param name=&quot;PathFileScarto&quot;/>&#xa;    &lt;xsl:template name=&quot;MapDetails-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Details>&#xa;            &lt;tns3:InputDetails>&#xa;                &lt;tns3:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NomeFileScarto&amp;quot;&quot;/>&#xa;                &lt;/tns3:NOME>&#xa;                &lt;tns3:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;$NomeFileScarto&quot;/>&#xa;                &lt;/tns3:VALORE>&#xa;            &lt;/tns3:InputDetails>&#xa;            &lt;tns3:InputDetails>&#xa;                &lt;tns3:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Offset&amp;quot;&quot;/>&#xa;                &lt;/tns3:NOME>&#xa;                &lt;tns3:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;$OffsetVie&quot;/>&#xa;                &lt;/tns3:VALORE>&#xa;            &lt;/tns3:InputDetails>&#xa;            &lt;tns3:InputDetails>&#xa;                &lt;tns3:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DestinationPathFile&amp;quot;&quot;/>&#xa;                &lt;/tns3:NOME>&#xa;                &lt;tns3:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;$PATH_FILE_MOVE&quot;/>&#xa;                &lt;/tns3: