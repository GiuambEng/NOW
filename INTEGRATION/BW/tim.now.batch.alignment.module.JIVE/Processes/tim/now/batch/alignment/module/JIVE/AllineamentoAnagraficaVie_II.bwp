                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="CallProcess9-input"
                    name="CallProcess9"
                    tibex:xpdlId="97ef584e-9419-459a-829b-003cbecbbceb"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess5ToCallProcess9"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess9ToExit1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.org/InputTrackFile&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;CallProcess4&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess9-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Input>&#xa;            &lt;tns4:Update>&#xa;                &lt;tns4:FLAG_LAVORAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:FLAG_LAVORAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='KO'&quot;>&#xa;                        &lt;tns4:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'KO_NUMERO_RECORD'&quot;/>&#xa;                        &lt;/tns4:STATO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'COMPLETATO'&quot;/>&#xa;                        &lt;/tns4:STATO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='KO'&quot;>&#xa;                    &lt;tns4:DESCR_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;concat('***ERRORE NUMERO RECORD, RECORD CONTATI= ',string($JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord))&quot;/>&#xa;                    &lt;/tns4:DESCR_ERRORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_TRACK)&quot;/>&#xa;                &lt;/tns4:ID_TRACK>&#xa;                &lt;xsl:if test=&quot;string-length($CallProcess4/tns3:FullPathMovedFile) > 0 and $JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='KO'&quot;>&#xa;                    &lt;xsl:if test=&quot;$CallProcess4/tns3:FullPathMovedFile&quot;>&#xa;                        &lt;tns4:FOLDER_SCARTO>&#xa;                            &lt;xsl:value-of select=&quot;$CallProcess4/tns3:FullPathMovedFile&quot;/>&#xa;                        &lt;/tns4:FOLDER_SCARTO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:LogElement>&#xa;                    &lt;tns4:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                    &lt;/tns4:LoggerName>&#xa;                    &lt;tns4:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                    &lt;/tns4:LogLevel>&#xa;                &lt;/tns4:LogElement>&#xa;            &lt;/tns4:Update>&#xa;        &lt;/tns4:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ReadFile.TrackFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:throw faultName="ns39:DefaultFault"
                faultVariable="Throw-input" name="Throw" tibex:xpdlId="2aa32c2c-17f7-4c44-892d-ed5f98c35df9">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:DefaultFault>&#xa;            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:descrErrore&quot;>&#xa;                &lt;message>&#xa;                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:descrErrore&quot;/>&#xa;                &lt;/message>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns3:DefaultFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Output_Log_counterToThrow"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogProcedura-input"
                    name="LogProcedura"
                    tibex:xpdlId="7ee5aba1-6787-4724-bb32-1ec3144d9cdc"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LocalTransactionToJDBCCallProcedure"/>
