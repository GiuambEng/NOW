                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:ns3=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; xmlns:ns11=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;MapDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;InsValueInTable-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:ChiusuraAllineamenti>&#xa;            &lt;ns3:InputData>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&#xa;                    &lt;ns3:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&#xa;                    &lt;/ns3:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_ESEC_PROCSO_FILE&quot;>&#xa;                    &lt;ns3:ID_ESEC_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns3:ID_ESEC_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns3:SISTEMA>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;JIVE_ALL&amp;quot;&quot;/>&#xa;                &lt;/ns3:SISTEMA>&#xa;                &lt;ns3:FLUSSO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Allineamento_AnagraficaVie&amp;quot;&quot;/>&#xa;                &lt;/ns3:FLUSSO>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:COD_PROCSO_FILE&quot;>&#xa;                    &lt;ns3:COD_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:COD_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns3:COD_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns3:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_TRACK)&quot;/>&#xa;                &lt;/ns3:ID_TRACK>&#xa;                &lt;ns3:LogInfo>&#xa;                    &lt;ns3:LogInfoLevel>&#xa;                        &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                    &lt;/ns3:LogInfoLevel>&#xa;                    &lt;ns3:LogName>&#xa;                        &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                    &lt;/ns3:LogName>&#xa;                    &lt;ns3:ApplicationName>&#xa;                        &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                    &lt;/ns3:ApplicationName>&#xa;                &lt;/ns3:LogInfo>&#xa;            &lt;/ns3:InputData>&#xa;            &lt;xsl:for-each select=&quot;$MapDetails/ns11:InputDetails&quot;>&#xa;                &lt;ns3:InputDetails>&#xa;                    &lt;xsl:if test=&quot;ns11:NOME&quot;>&#xa;                        &lt;ns3:NOME>&#xa;                            &lt;xsl:value-of select=&quot;ns11:NOME&quot;/>&#xa;                        &lt;/ns3:NOME>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns11:VALORE&quot;>&#xa;                        &lt;ns3:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;ns11:VALORE&quot;/>&#xa;                        &lt;/ns3:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns3:InputDetails>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns3:ChiusuraAllineamenti>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ChiusuraAllineamenti.Sub_InsDataInStatoAllineamenti" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
