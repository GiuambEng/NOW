                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="JDBCUpdate-input"
                                name="JDBCUpdate"
                                outputVariable="JDBCUpdate"
                                tibex:xpdlId="dd101ff3-bff9-4e77-b642-22806e69ec46" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="logErrorToError_RenameFile"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToCallProcess1"/>
                                    <bpws:source
                                    linkName="JDBCUpdateToEmpty1"
                                    tibex:faultDetailsVar="JDBCUpdate" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+dd101ff3-bff9-4e77-b642-22806e69ec46+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE)&quot;/>&#xa;            &lt;/ID_FILE>&#xa;            &lt;SISTEMA>&#xa;                &lt;xsl:value-of select=&quot;'JIVE'&quot;/>&#xa;            &lt;/SISTEMA>&#xa;            &lt;FLUSSO>&#xa;                &lt;xsl:value-of select=&quot;'AnagraficaVie'&quot;/>&#xa;            &lt;/FLUSSO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/ns1:queueResponse/ns1:FILENAME)>0&quot;>&#xa;                    &lt;DETAILS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JMSReceiveMessage/Body/ns1:queueResponse/ns1:FILENAME)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FILENAME&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DETAILS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DETAILS>&#xa;                        &lt;xsl:value-of select=&quot;'AnagraficaVie'&quot;/>&#xa;                    &lt;/DETAILS>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;DESCR_ERRORE>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&#xa;            &lt;/DESCR_ERRORE>&#xa;            &lt;STATO>&#xa;                &lt;xsl:value-of select=&quot;'KO TECNICO'&quot;/>&#xa;            &lt;/STATO>&#xa;            &lt;ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO_FILE>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBC_Timeout"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STATO_ALLINEAMENTI (ID_FILE, SISTEMA, FLUSSO,&#xa;  DETAILS, DESCR_ERRORE, FLAG_LETTURA, STATO, ID_ESEC_PROCSO_FILE,&#xa;  CREATED)&#xa;  VALUES (?, ?, ?, ?, ?, 'Y', ?, ?, SYSDATE)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SISTEMA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLUSSO"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DETAILS"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DESCR_ERRORE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO"/>
                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_ESEC_PROCSO_FILE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
