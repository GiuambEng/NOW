        <bpws:variable element="ns2:CW_BUS_MESSAGE"
            name="StartLog-input" sca-bpel:internal="true"/>
        <bpws:variable name="Day" type="xsd:string"/>
        <bpws:variable element="ns1:root" name="StartEstrazioni-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:root" name="StartEstrazioni" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:InputData"
            name="CallProcedure-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:CW_BUS_MESSAGE" name="LogEnd-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:CW_BUS_MESSAGE" name="Log-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartLogToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="SetDayToMain_StartEstrazioni" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartEstrazioniToIterate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="IterateToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogEndToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartEstrazioniToLog" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogToLogEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="Timer"
                    tibex:xpdlId="e9e1fbab-161d-4728-bedd-7796202123fd"
                    variable="Timer" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerToGenericLogger"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="DataTime"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="Interval"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value
                                    endTime="2021-11-08T10:35:42.529+0100" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:template name=&quot;StartLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'TimerEstrazioniSAP'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Start processo estrazioni SAP'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="StartLog-input" name="StartLog"
                    tibex:xpdlId="030d12eb-a3ec-4714-9974-e265037915d6"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartLogToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:template name=&quot;StartLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'TimerEstrazioniSAP'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Start processo estrazioni SAP'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="tib:pad-front(string(day-from-date(current-date())), 2, '0')"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="Day" name="SetDay"
                    outputVariable="Day"
                    tibex:xpdlId="7743f920-9614-42f8-96ce-73ecd3c17469" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartLogToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SetDayToMain_StartEstrazioni"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="tib:pad-front(string(day-from-date(current-date())), 2, '0')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Day" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SystemName&quot;/>&#xa;    &lt;xsl:param name=&quot;Day&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;IdSystem&quot;/>&#xa;    &lt;xsl:template name=&quot;StartEstrazioni-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:root>&#xa;            &lt;ns:InputData>&#xa;                &lt;ns:SystemName>&#xa;                    &lt;xsl:value-of select=&quot;$SystemName&quot;/>&#xa;                &lt;/ns:SystemName>&#xa;                &lt;ns:IDSystem>&#xa;                    &lt;xsl:value-of select=&quot;$IdSystem&quot;/>&#xa;                &lt;/ns:IDSystem>&#xa;                &lt;ns:DayEstrazione>&#xa;                    &lt;xsl:value-of select=&quot;$Day&quot;/>&#xa;                &lt;/ns:DayEstrazione>&#xa;                &lt;ns:LogInfo>&#xa;                    &lt;ns:ApplicationName>&#xa;                        &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                    &lt;/ns:ApplicationName>&#xa;                    &lt;ns:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                    &lt;/ns:LoggerName>&#xa;                    &lt;ns:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                    &lt;/ns:LogLevel>&#xa;                &lt;/ns:LogInfo>&#xa;            &lt;/ns:InputData>&#xa;        &lt;/ns:root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="StartEstrazioni-input"
                    name="StartEstrazioni"
                    outputVariable="StartEstrazioni"
                    tibex:xpdlId="f9a0dde9-cc10-4c6c-a3f9-26a8fb705132"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SetDayToMain_StartEstrazioni"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartEstrazioniToIterate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($StartEstrazioni/ns1:InputData/ns1:DataForProcedure)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($StartEstrazioni/ns1:InputData/ns1:DataForProcedure)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartEstrazioniToLog">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SystemName&quot;/>&#xa;    &lt;xsl:param name=&quot;Day&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;IdSystem&quot;/>&#xa;    &lt;xsl:template name=&quot;StartEstrazioni-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:root>&#xa;            &lt;ns:InputData>&#xa;                &lt;ns:SystemName>&#xa;                    &lt;xsl:value-of select=&quot;$SystemName&quot;/>&#xa;                &lt;/ns:SystemName>&#xa;                &lt;ns:IDSystem>&#xa;                    &lt;xsl:value-of select=&quot;$IdSystem&quot;/>&#xa;                &lt;/ns:IDSystem>&#xa;                &lt;ns:DayEstrazione>&#xa;                    &lt;xsl:value-of select=&quot;$Day&quot;/>&#xa;                &lt;/ns:DayEstrazione>&#xa;                &lt;ns:LogInfo>&#xa;                    &lt;ns:ApplicationName>&#xa;                        &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                    &lt;/ns:ApplicationName>&#xa;                    &lt;ns:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                    &lt;/ns:LoggerName>&#xa;                    &lt;ns:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                    &lt;/ns:LogLevel>&#xa;                &lt;/ns:LogInfo>&#xa;            &lt;/ns:InputData>&#xa;        &lt;/ns:root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.Estrazioni.Main_StartEstrazioni" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate"
                tibex:indexOriginalName="index"
                tibex:indexToGlobal="false" tibex:xpdlId="d8b8ead4-882e-4cd9-a31a-e88729b30d28">
                <bpws:targets>
                    <bpws:target linkName="StartEstrazioniToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToGenericLogger"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$StartEstrazioni/ns1:InputData/ns1:DataForProcedure" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($StartEstrazioni/ns1:InputData/ns1:DataForProcedure)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns1:Iterate_Current_Element_DataForProcedure"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToSub_CallProcedure" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Sub_CallProcedureToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="73a0f4d5-03d7-4315-b7db-d2c9ec896df2" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToSub_CallProcedure"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($StartEstrazioni/ns1:InputData/ns1:DataForProcedure)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="c24be192-8165-49e2-b79f-fa03b8e2cc2a">
                                    <bpws:targets>
                                    <bpws:target linkName="Sub_CallProcedureToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:ns=&quot;www.tim.now.StarterEstrazioni.DataForProcedure&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcedure-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:InputData>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:CODICE_OLO&quot;>&#xa;                &lt;ns:CODICEOLO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:CODICE_OLO&quot;/>&#xa;                &lt;/ns:CODICEOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:FLUSSO_ESTRAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns:FLUSSO_DI_ESTRAZIONE&quot;/>&#xa;            &lt;/ns:FLUSSO_ESTRAZIONE>&#xa;            &lt;ns:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns:ID_FILE&quot;/>&#xa;            &lt;/ns:ID_FILE>&#xa;            &lt;ns:COD_INTRFC>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns:COD_INTRFC&quot;/>&#xa;            &lt;/ns:COD_INTRFC>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DATA_INIZIO&quot;>&#xa;                &lt;ns:DATA_INIZIO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DATA_INIZIO&quot;/>&#xa;                &lt;/ns:DATA_INIZIO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DATA_FINE&quot;>&#xa;                &lt;ns:DATA_FINE>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DATA_FINE&quot;/>&#xa;                &lt;/ns:DATA_FINE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DATA_ESPLETAMENTO&quot;>&#xa;                &lt;ns:DATA_ESPLETAMENTO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DATA_ESPLETAMENTO&quot;/>&#xa;                &lt;/ns:DATA_ESPLETAMENTO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DESCR_FLUSSO&quot;>&#xa;                &lt;ns:DESCR_FLUSSO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DESCR_FLUSSO&quot;/>&#xa;                &lt;/ns:DESCR_FLUSSO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DESCR_PPS&quot;>&#xa;                &lt;ns:DESCR_PPS>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DESCR_PPS&quot;/>&#xa;                &lt;/ns:DESCR_PPS>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:ID_PPS&quot;>&#xa;                &lt;ns:ID_PPS>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:ID_PPS&quot;/>&#xa;                &lt;/ns:ID_PPS>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:InputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallProcedure-input"
                                    name="CallProcedure"
                                    tibex:xpdlId="44ea780e-4eb5-4929-933b-926e7d466611"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToSub_CallProcedure"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Sub_CallProcedureToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:ns=&quot;www.tim.now.StarterEstrazioni.DataForProcedure&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcedure-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:InputData>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:CODICE_OLO&quot;>&#xa;                &lt;ns:CODICEOLO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:CODICE_OLO&quot;/>&#xa;                &lt;/ns:CODICEOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:FLUSSO_ESTRAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns:FLUSSO_DI_ESTRAZIONE&quot;/>&#xa;            &lt;/ns:FLUSSO_ESTRAZIONE>&#xa;            &lt;ns:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns:ID_FILE&quot;/>&#xa;            &lt;/ns:ID_FILE>&#xa;            &lt;ns:COD_INTRFC>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/tns:COD_INTRFC&quot;/>&#xa;            &lt;/ns:COD_INTRFC>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DATA_INIZIO&quot;>&#xa;                &lt;ns:DATA_INIZIO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DATA_INIZIO&quot;/>&#xa;                &lt;/ns:DATA_INIZIO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DATA_FINE&quot;>&#xa;                &lt;ns:DATA_FINE>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DATA_FINE&quot;/>&#xa;                &lt;/ns:DATA_FINE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DATA_ESPLETAMENTO&quot;>&#xa;                &lt;ns:DATA_ESPLETAMENTO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DATA_ESPLETAMENTO&quot;/>&#xa;                &lt;/ns:DATA_ESPLETAMENTO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DESCR_FLUSSO&quot;>&#xa;                &lt;ns:DESCR_FLUSSO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DESCR_FLUSSO&quot;/>&#xa;                &lt;/ns:DESCR_FLUSSO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:DESCR_PPS&quot;>&#xa;                &lt;ns:DESCR_PPS>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:DESCR_PPS&quot;/>&#xa;                &lt;/ns:DESCR_PPS>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$currentElement/tns:ID_PPS&quot;>&#xa;                &lt;ns:ID_PPS>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns:ID_PPS&quot;/>&#xa;                &lt;/ns:ID_PPS>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:InputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.batch.alignment.sap.outbound.Sub_CallProcedure" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:template name=&quot;LogEnd-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'TimerEstrazioniSAP'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'End processo estrazione SAP'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogEnd-input" name="LogEnd"
                    tibex:xpdlId="ee9ff089-f6f1-4827-a5c6-28bcc6e65f07"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IterateToGenericLogger"/>
                        <bpws:target linkName="LogToLogEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogEndToExit"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:template name=&quot;LogEnd-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'TimerEstrazioniSAP'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'End processo estrazione SAP'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="a81eb0a3-c843-485e-b9cf-0f763a2e1af3">
                <bpws:targets>
                    <bpws:target linkName="LogEndToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'TimerEstrazioniSAP'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Nessun dato estratto per il sistema SAP' &quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Log-input" name="Log"
                    tibex:xpdlId="9266fb28-97e1-4a6d-8b45-9c7efbc4be4b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartEstrazioniToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToLogEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'TimerEstrazioniSAP'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Nessun dato estratto per il sistema SAP' &quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
