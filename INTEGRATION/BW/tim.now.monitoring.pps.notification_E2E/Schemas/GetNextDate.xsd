<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/GetNextDate" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/GetNextDate">
    <element name="Request">
    <complexType>
    <sequence>
    <element name="inputDate" type="date"/>
    <element name="NomeCalendario" type="string" minOccurs="0" maxOccurs="1"></element>
    <choice>
<element name="inputDuration" type="string"/>
<element name="GiorniLavorativi" type="int"/>
    </choice>
    </sequence>
    </complexType>
  </element>
    <element name="Response">
    <complexType>
    <sequence>
    <element name="outputDate" type="date"/>
    </sequence>
    </complexType>
  </element>
    <element name="Fault">
    <complexType>
    <sequence>
    <element name="messageCode" type="string"/>
    <element name="errorDescription" type="string"/>
    </sequence>
    </complexType>
  </element>
    <element name="CalcRequest">
    <complexType>
    <sequence>
    <element name="inputDate" type="date"/>
    <element maxOccurs="1" minOccurs="0" name="inputDuration" type="string"/>
    <element maxOccurs="1" minOccurs="0" name="TipoData" type="string"/>
    </sequence>
    </complexType>
    </element>
    <element name="calcNextUsefulDate">
<complexType>
<sequence>
<element name="inputDate" type="date"></element>
<element name="GiorniLavorativi" type="int"></element>
</sequence>
</complexType>
</element>
<element name="calcDeadLineRequest">
	<complexType>
		<sequence>
			<element name="StartDateTime" type="dateTime" />
			<element name="Duration" type="string"/>
		</sequence>
	</complexType>
</element>
<element name="calcDeadLineResponse">
	<complexType>
		<sequence>
			<element name="EndDateTime" type="dateTime" />
		</sequence>
	</complexType>
</element>
<element name="substractWorkingDateRequest">
	<complexType>
		<sequence>
			<element name="StartDate" type="date" />
			<element name="Days" type="int"/>
		</sequence>
	</complexType>
</element>
<element name="substractWorkingDateResponse">
	<complexType>
		<sequence>
			<element name="EndDate" type="date" />
		</sequence>
	</complexType>
</element>
</schema>
