<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/tim.now.schema.xsd.MonitoraggioNATIVINOW_IDRISORSA_Subprocess" xmlns:tns="http://www.example.org/tim.now.schema.xsd.MonitoraggioNATIVINOW_IDRISORSA_Subprocess" elementFormDefault="qualified">

    <element name="MonitoraggioNATIVINOW_IDRISORSA">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:MonitoraggioNATIVINOW_IDRISORSA_Dettaglio">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="MonitoraggioNATIVINOW_IDRISORSA_Dettaglio">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="1" name="TIPO_RECORD"
    				type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1" name="ID_RISORSA"
    				type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1" name="STATO_ASSET"
    				type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1" name="DEC"
    				type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1"
    				name="CODICE_OLO_AGCOM" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1"
    				name="CRMWS_SERVICE" type="string">
    			</element>
    			<element name="FlagValidita" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="NumeroRecord" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="ID_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="MonitoraggioNATIVINOW_IDRISORSA_Output">
    	<complexType>
    		<sequence>
    			<element name="Esito" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>