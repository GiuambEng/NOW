<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/CheckActiveJob" xmlns:tns="http://www.example.org/CheckActiveJob" elementFormDefault="qualified">
<element name="Input">
    	<complexType>
    		<sequence>
    		<element name="ID_PPS" type="string" maxOccurs="1" minOccurs="1"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="Output">
    	<complexType>
    		<sequence>
    		<element name="RESULT" maxOccurs="1" minOccurs="0">


    			<simpleType>
    				<restriction base="string">
    					<enumeration value="OK"></enumeration>
    					<enumeration value="WAIT"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>

    		</sequence>
    	</complexType>
    </element>


</schema>