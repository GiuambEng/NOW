<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/AccumulateAllegato" xmlns:tns="http://www.example.org/AccumulateAllegato" elementFormDefault="qualified">

    <element name="INPUT">
    	<complexType>
    		<sequence>
    			<element name="ID_MAIL" type="int" maxOccurs="1" minOccurs="1"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="OUTPUT">
    	<complexType>
    		<sequence>
    			<element name="Accumulate" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="fullname" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="filename" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>