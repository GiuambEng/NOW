              </xs:annotation>
            </xs:attribute>
          </xs:extension>
        </xs:complexContent>
      </xs:complexType>
      <xs:complexType name="XmlDynOrgEntityId">
        <xs:complexContent>
          <xs:extension base="ns4:XmlModelEntityId">
            <xs:sequence minOccurs="0">
              <xs:element name="dynamic-id-attr" type="ns4:XmlDynamicIdField" minOccurs="0" maxOccurs="unbounded">
