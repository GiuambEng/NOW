                                    sqlStatement="SELECT  pps.id_pps&#xa;FROM CFG_E2E_TIME_INTERVAL cfg , CFG_START_E2E_REPORT pps&#xa;where  cfg.start_ora=?&#xa;and cfg.id_pps=pps.id_pps&#xa;and pps.periodicita IN ('G','O') and &#xa;(pps.FLAG_LETTURA = 'Y' OR pps.FLAG_LETTURA IS NULL)&#xa;and pps.flag_stop is null&#xa;and pps.id_pps like 'E2E%'"
