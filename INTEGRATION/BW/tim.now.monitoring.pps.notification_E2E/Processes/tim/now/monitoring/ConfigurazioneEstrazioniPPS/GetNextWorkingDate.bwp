&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://services.dac.n2.tibco.com/BusinessDeadlineService_1.7.0" xmlns:ns="http://deadline.api.dac.n2.tibco.com" xmlns:tns1="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="calcNextDateByDuration"/&gt;&lt;xsl:param name="DurationNEW"/&gt;&lt;xsl:param name="nomeCalendario"/&gt;&lt;xsl:template name="calcDeadlineDateByDuration-input" match="/"&gt;&lt;tns:calcDeadlineRequest&gt;&lt;parameters&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($calcNextDateByDuration/parameters/tns1:Request/tns1:inputDuration) and string-length($calcNextDateByDuration/parameters/tns1:Request/tns1:inputDuration)&gt;0"&gt;&lt;ns:calcDeadline&gt;&lt;xsl:attribute name="duration"&gt;&lt;xsl:value-of select="xsd:dayTimeDuration($calcNextDateByDuration/parameters/tns1:Request/tns1:inputDuration)"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="start-date-time"&gt;&lt;xsl:value-of select="dateTime(xsd:date(tib:left(string($calcNextDateByDuration/parameters/tns1:Request/tns1:inputDate), 10)), xsd:time(&amp;quot;04:00:00&amp;quot;))"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($calcNextDateByDuration/parameters/tns1:Request/tns1:NomeCalendario) and string-length($calcNextDateByDuration/parameters/tns1:Request/tns1:NomeCalendario)&gt;0"&gt;&lt;calendar-lookup&gt;&lt;xsl:if test="$calcNextDateByDuration/parameters/tns1:Request/tns1:NomeCalendario"&gt;&lt;calendar-ref&gt;&lt;xsl:value-of select="$calcNextDateByDuration/parameters/tns1:Request/tns1:NomeCalendario"/&gt;&lt;/calendar-ref&gt;&lt;/xsl:if&gt;&lt;/calendar-lookup&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;calendar-lookup&gt;&lt;calendar-ref&gt;&lt;xsl:value-of select="$nomeCalendario"/&gt;&lt;/calendar-ref&gt;&lt;/calendar-lookup&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns:calcDeadline&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:calcDeadline&gt;&lt;xsl:attribute name="duration"&gt;&lt;xsl:value-of select="xsd:dayTimeDuration($DurationNEW)"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="start-date-time"&gt;&lt;xsl:value-of select="dateTime(xsd:date(tib:left(string($calcNextDateByDuration/parameters/tns1:Request/tns1:inputDate), 10)), xsd:time(&amp;quot;04:00:00&amp;quot;))"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($calcNextDateByDuration/parameters/tns1:Request/tns1:NomeCalendario) and string-length($calcNextDateByDuration/parameters/tns1:Request/tns1:NomeCalendario)&gt;0"&gt;&lt;calendar-lookup&gt;&lt;xsl:if test="$calcNextDateByDuration/parameters/tns1:Request/tns1:NomeCalendario"&gt;&lt;calendar-ref&gt;&lt;xsl:value-of select="$calcNextDateByDuration/parameters/tns1:Request/tns1:NomeCalendario"/&gt;&lt;/calendar-ref&gt;&lt;/xsl:if&gt;&lt;/calendar-lookup&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;calendar-lookup&gt;&lt;calendar-ref&gt;&lt;xsl:value-of select="$nomeCalendario"/&gt;&lt;/calendar-ref&gt;&lt;/calendar-lookup&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns:calcDeadline&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/parameters&gt;&lt;/tns:calcDeadlineRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://services.dac.n2.tibco.com/BusinessDeadlineService_1.7.0&quot; xmlns:ns=&quot;http://deadline.api.dac.n2.tibco.com&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;calcNextDateByDuration.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DurationNEW&quot;/>&#xa;    &lt;xsl:param name=&quot;nomeCalendario&quot;/>&#xa;    &lt;xsl:template name=&quot;calcDeadlineDateByDuration-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($calcNextDateByDuration.parameters/tns1:inputDuration) and string-length($calcNextDateByDuration.parameters/tns1:inputDuration)>0&quot;>&#xa;                &lt;ns:calcDeadline>&#xa;                    &lt;xsl:attribute name=&quot;duration&quot;>&#xa;                        &lt;xsl:value-of select=&quot;xsd:dayTimeDuration($calcNextDateByDuration.parameters/tns1:inputDuration)&quot;/>&#xa;                    &lt;/xsl:attribute>&#xa;                    &lt;xsl:attribute name=&quot;start-date-time&quot;>&#xa;                        &lt;xsl:value-of select=&quot;dateTime(xsd:date(tib:left(string($calcNextDateByDuration.parameters/tns1:inputDate), 10)), xsd:time(&amp;quot;04:00:00&amp;quot;))&quot;/>&#xa;                    &lt;/xsl:attribute>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($calcNextDateByDuration.parameters/tns1:NomeCalendario) and string-length($calcNextDateByDuration.parameters/tns1:NomeCalendario)>0&quot;>&#xa;                            &lt;calendar-lookup>&#xa;                                &lt;xsl:if test=&quot;$calcNextDateByDuration.parameters/tns1:NomeCalendario&quot;>&#xa;                                    &lt;calendar-ref>&#xa;                                        &lt;xsl:value-of select=&quot;$calcNextDateByDuration.parameters/tns1:NomeCalendario&quot;/>&#xa;                                    &lt;/calendar-ref>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/calendar-lookup>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;calendar-lookup>&#xa;                                &lt;calendar-ref>&#xa;                                    &lt;xsl:value-of select=&quot;$nomeCalendario&quot;/>&#xa;                                &lt;/calendar-ref>&#xa;                            &lt;/calendar-lookup>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ns:calcDeadline>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:calcDeadline>&#xa;                    &lt;xsl:attribute name=&quot;duration&quot;>&#xa;                        &lt;xsl:value-of select=&quot;xsd:dayTimeDuration($DurationNEW)&quot;/>&#xa;                    &lt;/xsl:attribute>&#xa;                    &lt;xsl:attribute name=&quot;start-date-time&quot;>&#xa;                        &lt;xsl:value-of select=&quot;dateTime(xsd:date(tib:left(string($calcNextDateByDuration.parameters/tns1:inputDate), 10)), xsd:time(&amp;quot;04:00:00&amp;quot;))&quot;/>&#xa;                    &lt;/xsl:attribute>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($calcNextDateByDuration.parameters/tns1:NomeCalendario) and string-length($calcNextDateByDuration.parameters/tns1:NomeCalendario)>0&quot;>&#xa;                            &lt;calendar-lookup>&#xa;                                &lt;xsl:if test=&quot;$calcNextDateByDuration.parameters/tns1:NomeCalendario&quot;>&#xa;                                    &lt;calendar-ref>&#xa;                                        &lt;xsl:value-of select=&quot;$calcNextDateByDuration.parameters/tns1:NomeCalendario&quot;/>&#xa;                                    &lt;/calendar-ref>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/calendar-lookup>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;calendar-lookup>&#xa;                                &lt;calendar-ref>&#xa;                                    &lt;xsl:value-of select=&quot;$nomeCalendario&quot;/>&#xa;                                &lt;/calendar-ref>&#xa;                            &lt;/calendar-lookup>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ns:calcDeadline>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="LOG_Duration"/>
                                    <bpws:target linkName="GiorniLavorativiTocalcDeadlineDateByDuration"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="calcDeadlineDateByDurationToCallProcess"/>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="concat('P0Y0M',string($calcNextDateByDuration/parameters/tns:Request/tns:GiorniLavorativi -1),'DT23H0M0S')"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="DurationNEW"
                                    name="GiorniLavorativi"
                                    outputVariable="DurationNEW"
                                    tibex:xpdlId="09c2dcf7-adc6-45e5-959a-02196736d2bc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LOG_InputDateByDurationToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GiorniLavorativiTocalcDeadlineDateByDuration"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="concat('P0Y0M',string($calcNextDateByDuration.parameters/tns:GiorniLavorativi -1),'DT23H0M0S')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
