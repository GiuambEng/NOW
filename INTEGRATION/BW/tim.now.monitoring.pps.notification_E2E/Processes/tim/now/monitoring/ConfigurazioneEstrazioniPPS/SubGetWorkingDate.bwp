                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetWorkingDate.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_GiornoDopo_Festivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SubGetWorkingDate'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;GetWorkingDate : &amp;quot;, xsd:string($GetWorkingDate.parameters/tns1:outputDate))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="GetCurrentWorkingDate-input"
                name="GetCurrentWorkingDate"
                operation="calcNextDateByDuration"
                outputVariable="GetCurrentWorkingDate"
                partnerLink="GetNextWorkingDate"
                portType="ns6:GetNextDatePortType" tibex:xpdlId="5bd7a6d6-dd49-4dbc-95e3-29e5f401d1ad">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/GetNextDateService/" xmlns:tns1="http://www.tim.com/NOW/xsd/GetNextDate" version="2.0"&gt;&lt;xsl:param name="NomeCalendario"/&gt;&lt;xsl:template name="GetCurrentWorkingDate-input" match="/"&gt;&lt;tns:calcNextDateByDurationRequest&gt;&lt;parameters&gt;&lt;tns1:Request&gt;&lt;tns1:inputDate&gt;&lt;xsl:value-of select="current-date()"/&gt;&lt;/tns1:inputDate&gt;&lt;tns1:NomeCalendario&gt;&lt;xsl:value-of select="$NomeCalendario"/&gt;&lt;/tns1:NomeCalendario&gt;&lt;tns1:inputDuration&gt;&lt;xsl:value-of select="'PT9H'"/&gt;&lt;/tns1:inputDuration&gt;&lt;/tns1:Request&gt;&lt;/parameters&gt;&lt;/tns:calcNextDateByDurationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/GetNextDateService/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NomeCalendario&quot;/>&#xa;    &lt;xsl:template name=&quot;GetCurrentWorkingDate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Request>&#xa;            &lt;tns1:inputDate>&#xa;                &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;            &lt;/tns1:inputDate>&#xa;            &lt;tns1:NomeCalendario>&#xa;                &lt;xsl:value-of select=&quot;$NomeCalendario&quot;/>&#xa;            &lt;/tns1:NomeCalendario>&#xa;            &lt;tns1:inputDuration>&#xa;                &lt;xsl:value-of select=&quot;'PT9H'&quot;/>&#xa;            &lt;/tns1:inputDuration>&#xa;        &lt;/tns1:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="StartLogToGetCurrentWorkingDate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="GetCurrentWorkingDateToLog_GiornoFestivo">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="current-date() != $GetCurrentWorkingDate/parameters/tns:Response/tns:outputDate" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[current-date() != $GetCurrentWorkingDate.parameters/tns:outputDate]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="GetCurrentWorkingDateToLog_Giorno_Lavorativo">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="current-date() = $GetCurrentWorkingDate/parameters/tns:Response/tns:outputDate" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[current-date() = $GetCurrentWorkingDate.parameters/tns:outputDate]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:invoke inputVariable="GetWorkingDate-input"
                name="GetWorkingDate" operation="calcNextDateByDuration"
                outputVariable="GetWorkingDate"
                partnerLink="GetNextWorkingDate"
                portType="ns6:GetNextDatePortType" tibex:xpdlId="5b6918f2-2321-44df-bd35-f5e2cd681cdc">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/GetNextDateService/" xmlns:tns1="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="NomeCalendario"/&gt;&lt;xsl:template name="GetWorkingDate-input" match="/"&gt;&lt;tns:calcNextDateByDurationRequest&gt;&lt;parameters&gt;&lt;tns1:Request&gt;&lt;tns1:inputDate&gt;&lt;xsl:value-of select="tib:add-to-date(current-date(), 0,0, -1)"/&gt;&lt;/tns1:inputDate&gt;&lt;tns1:NomeCalendario&gt;&lt;xsl:value-of select="$NomeCalendario"/&gt;&lt;/tns1:NomeCalendario&gt;&lt;tns1:inputDuration&gt;&lt;xsl:value-of select="'PT9H'"/&gt;&lt;/tns1:inputDuration&gt;&lt;/tns1:Request&gt;&lt;/parameters&gt;&lt;/tns:calcNextDateByDurationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/GetNextDateService/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NomeCalendario&quot;/>&#xa;    &lt;xsl:template name=&quot;GetWorkingDate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Request>&#xa;            &lt;tns1:inputDate>&#xa;                &lt;xsl:value-of select=&quot;tib:add-to-date(current-date(), 0,0, -1)&quot;/>&#xa;            &lt;/tns1:inputDate>&#xa;            &lt;tns1:NomeCalendario>&#xa;                &lt;xsl:value-of select=&quot;$NomeCalendario&quot;/>&#xa;            &lt;/tns1:NomeCalendario>&#xa;            &lt;tns1:inputDuration>&#xa;                &lt;xsl:value-of select=&quot;'PT9H'&quot;/>&#xa;            &lt;/tns1:inputDuration>&#xa;        &lt;/tns1:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Log_Giorno_LavorativoToGetWorkingDate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="GetWorkingDateToLogGiorno_Lavorativo">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="GetWorkingDateToLog_GiornoDopo_Festivo">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$GetWorkingDate/parameters/tns:Response/tns:outputDate = $GetCurrentWorkingDate/parameters/tns:Response/tns:outputDate" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$GetWorkingDate.parameters/tns:outputDate = $GetCurrentWorkingDate.parameters/tns:outputDate]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
