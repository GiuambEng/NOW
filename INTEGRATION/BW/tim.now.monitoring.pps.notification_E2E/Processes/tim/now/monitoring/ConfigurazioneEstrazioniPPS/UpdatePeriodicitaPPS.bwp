                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE CFG_START_E2E_REPORT&#xa;set PERIODICITA='G'&#xa;WHERE ID_PPS=?&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
