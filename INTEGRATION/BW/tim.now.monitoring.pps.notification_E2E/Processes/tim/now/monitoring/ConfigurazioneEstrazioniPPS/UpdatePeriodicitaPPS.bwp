            <bpws:invoke inputVariable="GetWorkingCurrentDate-input"
                name="GetWorkingCurrentDate"
                operation="calcNextDateByDuration"
                outputVariable="GetWorkingCurrentDate"
                partnerLink="GetNextWorkingDate"
                portType="ns8:GetNextDatePortType" tibex:xpdlId="8dd24865-bac3-47c8-9d6d-4ea53636f4ee">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/GetNextDateService/" xmlns:tns1="http://www.tim.com/NOW/xsd/GetNextDate" version="2.0"&gt;&lt;xsl:param name="NomeCalendario"/&gt;&lt;xsl:template name="GetWorkingCurrentDate-input" match="/"&gt;&lt;tns:calcNextDateByDurationRequest&gt;&lt;parameters&gt;&lt;tns1:Request&gt;&lt;tns1:inputDate&gt;&lt;xsl:value-of select="current-date()"/&gt;&lt;/tns1:inputDate&gt;&lt;tns1:NomeCalendario&gt;&lt;xsl:value-of select="$NomeCalendario"/&gt;&lt;/tns1:NomeCalendario&gt;&lt;tns1:inputDuration&gt;&lt;xsl:value-of select="'PT9H'"/&gt;&lt;/tns1:inputDuration&gt;&lt;/tns1:Request&gt;&lt;/parameters&gt;&lt;/tns:calcNextDateByDurationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/GetNextDateService/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NomeCalendario&quot;/>&#xa;    &lt;xsl:template name=&quot;GetWorkingCurrentDate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Request>&#xa;            &lt;tns1:inputDate>&#xa;                &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;            &lt;/tns1:inputDate>&#xa;            &lt;tns1:NomeCalendario>&#xa;                &lt;xsl:value-of select=&quot;$NomeCalendario&quot;/>&#xa;            &lt;/tns1:NomeCalendario>&#xa;            &lt;tns1:inputDuration>&#xa;                &lt;xsl:value-of select=&quot;'PT9H'&quot;/>&#xa;            &lt;/tns1:inputDuration>&#xa;        &lt;/tns1:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogStartToGetWorkingCurrentDate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="GetWorkingCurrentDateToLog_End_Festivo">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="current-date() != $GetWorkingCurrentDate/parameters/tns:Response/tns:outputDate" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[current-date() != $GetWorkingCurrentDate.parameters/tns:outputDate]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="GetWorkingCurrentDateToGetWorkindDay1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="current-date() = $GetWorkingCurrentDate/parameters/tns:Response/tns:outputDate" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[current-date() = $GetWorkingCurrentDate.parameters/tns:outputDate]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:invoke inputVariable="GetWorkindDay-input"
                name="GetWorkindDay" operation="calcNextDateByDuration"
                outputVariable="GetWorkindDay"
                partnerLink="GetNextWorkingDate"
                portType="ns8:GetNextDatePortType" tibex:xpdlId="3add331e-875c-47da-81c1-3f5bf643ba94">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/GetNextDateService/" xmlns:tns1="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="NomeCalendario"/&gt;&lt;xsl:template name="GetWorkindDay-input" match="/"&gt;&lt;tns:calcNextDateByDurationRequest&gt;&lt;parameters&gt;&lt;tns1:Request&gt;&lt;tns1:inputDate&gt;&lt;xsl:value-of select="tib:add-to-date(current-date(), 0,0, -1)"/&gt;&lt;/tns1:inputDate&gt;&lt;tns1:NomeCalendario&gt;&lt;xsl:value-of select="$NomeCalendario"/&gt;&lt;/tns1:NomeCalendario&gt;&lt;tns1:inputDuration&gt;&lt;xsl:value-of select="'PT9H'"/&gt;&lt;/tns1:inputDuration&gt;&lt;/tns1:Request&gt;&lt;/parameters&gt;&lt;/tns:calcNextDateByDurationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/GetNextDateService/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NomeCalendario&quot;/>&#xa;    &lt;xsl:template name=&quot;GetWorkindDay-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Request>&#xa;            &lt;tns1:inputDate>&#xa;                &lt;xsl:value-of select=&quot;tib:add-to-date(current-date(), 0,0, -1)&quot;/>&#xa;            &lt;/tns1:inputDate>&#xa;            &lt;tns1:NomeCalendario>&#xa;                &lt;xsl:value-of select=&quot;$NomeCalendario&quot;/>&#xa;            &lt;/tns1:NomeCalendario>&#xa;            &lt;tns1:inputDuration>&#xa;                &lt;xsl:value-of select=&quot;'PT9H'&quot;/>&#xa;            &lt;/tns1:inputDuration>&#xa;        &lt;/tns1:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="GetWorkingCurrentDateToGetWorkindDay1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="GetWorkindDayToLog_End_Festivo">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$GetWorkindDay/parameters/tns:Response/tns:outputDate = $GetWorkingCurrentDate/parameters/tns:Response/tns:outputDate" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$GetWorkindDay.parameters/tns:outputDate = $GetWorkingCurrentDate.parameters/tns:outputDate]]></bpws:transitionCondition>
                    </bpws:source>
