        <bpws:variable element="ns8:jdbcUpdateActivityInput"
            name="UpdFlagAndCounter-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:jdbcUpdateActivityOutput"
            name="UpdFlagAndCounter" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:InputCallProcedurePPS"
            name="MonitoraggioNotificheE2E-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
