                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8ba095f1-4488-4007-9a97-b50c60da1600+input&quot; xmlns:tns1=&quot;http://www.example.org/SendMail&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Querycopianascosta-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;FLUSSO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:FLUSSO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:FLUSSO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/FLUSSO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
