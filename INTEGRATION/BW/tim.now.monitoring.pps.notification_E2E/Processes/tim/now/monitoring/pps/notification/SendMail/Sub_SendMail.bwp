            tibex:propertySource="/ConfigurationLogger/Application" type="xsd:string"/>
        <bpws:variable name="LogName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/ConfigurationLogger/LoggerName" type="xsd:string"/>
        <bpws:variable element="ns3:jdbcUpdateActivityInput"
            name="UpdMailInviata-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:jdbcUpdateActivityOutput"
            name="UpdMailInviata" sca-bpel:internal="true"/>
