                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/sendmail/xsd/input+e9c6a07c-c95b-4f45-9c9c-e5797cf9bde8+input&quot; xmlns:tns1=&quot;http://www.example.org/SendMail&quot; xmlns:tns2=&quot;http://www.example.org/AccumulateAllegato&quot; xmlns:tns3=&quot;http://xmlns.tibco.com/encodings/mimefile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;CheckAllegato&quot;/>&lt;xsl:param name=&quot;Querycopianascosta&quot;/>&lt;xsl:template name=&quot;SendMail1-input&quot; match=&quot;/&quot;>&lt;tns:mailActivityInput>&lt;xsl:if test=&quot;$Start/tns1:USERNAME&quot;>&lt;username>&lt;xsl:value-of select=&quot;$Start/tns1:USERNAME&quot;/>&lt;/username>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:PASSWORD&quot;>&lt;password>&lt;xsl:value-of select=&quot;$Start/tns1:PASSWORD&quot;/>&lt;/password>&lt;/xsl:if>&lt;from>&lt;xsl:value-of select=&quot;$Start/tns1:FROM&quot;/>&lt;/from>&lt;xsl:if test=&quot;$Start/tns1:TO&quot;>&lt;to>&lt;xsl:value-of select=&quot;$Start/tns1:TO&quot;/>&lt;/to>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:CC&quot;>&lt;cc>&lt;xsl:value-of select=&quot;$Start/tns1:CC&quot;/>&lt;/cc>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:FLUSSO=('E2ExM01_I','E2ExM02_I','E2ExM01_P','E2ExM02_P','E2ExM01_U','E2ExM02_U') and count($Querycopianascosta/Record)>0&quot;>&lt;xsl:if test=&quot;$Querycopianascosta/Record[1]/INVIA_CCN&quot;>&lt;bcc>&lt;xsl:value-of select=&quot;$Querycopianascosta/Record[1]/INVIA_CCN&quot;/>&lt;/bcc>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:SUBJECT&quot;>&lt;subject>&lt;xsl:value-of select=&quot;$Start/tns1:SUBJECT&quot;/>&lt;/subject>&lt;/xsl:if>&lt;bodyElement>&lt;xsl:if test=&quot;$Start/tns1:CONTENUTO_EMAIL&quot;>&lt;bodyText>&lt;xsl:value-of select=&quot;$Start/tns1:CONTENUTO_EMAIL&quot;/>&lt;/bodyText>&lt;/xsl:if>&lt;/bodyElement>&lt;Headers>&lt;Content-Type>&lt;xsl:value-of select=&quot;&amp;quot;text/html; charset=UTF-8&amp;quot;&quot;/>&lt;/Content-Type>&lt;/Headers>&lt;tns3:mimeEnvelopeElement>&lt;xsl:for-each select=&quot;$CheckAllegato/tns2:Accumulate&quot;>&lt;mimePart>&lt;mimeHeaders>&lt;content-disposition>&lt;xsl:value-of select=&quot;concat(&amp;quot;*;filename=&amp;quot;,tns2:filename) &quot;/>&lt;/content-disposition>&lt;content-type>&lt;xsl:value-of select=&quot;&amp;quot;text/plain&amp;quot;&quot;/>&lt;/content-type>&lt;/mimeHeaders>&lt;fileName>&lt;xsl:value-of select=&quot;tns2:fullname&quot;/>&lt;/fileName>&lt;/mimePart>&lt;/xsl:for-each>&lt;/tns3:mimeEnvelopeElement>&lt;/tns:mailActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.mail.send"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:input="http://tns.tibco.com/bw/activity/sendmail/xsd/input+e9c6a07c-c95b-4f45-9c9c-e5797cf9bde8+input"
                            xmlns:mail="http://ns.tibco.com/bw/palette/mail" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
