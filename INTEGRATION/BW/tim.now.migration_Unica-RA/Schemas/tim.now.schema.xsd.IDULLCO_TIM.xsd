<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/IDULLCO_TIM/" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/IDULLCO_TIM/">
	<element name="IDULLCO_TIM">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0" ref="tns:IDULLCO_TIM_Dettaglio"/>
			</sequence>
		</complexType>
	</element>
	<element name="IDULLCO_TIM_Dettaglio">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="Tipo_record">
					<simpleType>
						<restriction base="string">
							<enumeration value="2"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="IDULLCO">
					<simpleType>
						<restriction base="string">
							<maxLength value="100" />
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="OLO">
					<simpleType>
						<restriction base="string">
							<maxLength value="3" />
							<enumeration value="TLC" />
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="CLLI">
					<simpleType>
						<restriction base="string">
							<maxLength value="100" />
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1"
					name="DATA_CONSEGNA_OLO">
					<simpleType>
						<restriction base="string">
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0"
					name="DATA_FINE_VALIDITA">
					<simpleType>
						<restriction base="string">

						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1"
					name="DATA_INVIO">
					<simpleType>
						<restriction base="string">
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="Nome">
					<simpleType>
						<restriction base="string">
							<maxLength value="255" />
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="DRCP">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="Codice_GAT">
					<simpleType>
						<restriction base="string">
							<maxLength value="6" />
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Tipo_Colocazione">
					<simpleType>
						<restriction base="string">
							<maxLength value="4"/>
							<enumeration value="0"/>
							<enumeration value="1"/>
							<enumeration value="2"/>
							<enumeration value="3"/>
							<enumeration value="4"/>
							<enumeration value=""/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	
</schema>
