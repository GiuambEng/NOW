<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.example.org/tim.now.schema.xsd.IDSLUCO_TIM" 
xmlns:tns="http://www.example.org/tim.now.schema.xsd.IDSLUCO_TIM" 
elementFormDefault="qualified"
attributeFormDefault="unqualified">

    <element name="IDSLUCO_TIM">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:IDSLUCO_TIM_Dettaglio">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="IDSLUCO_TIM_Dettaglio">
    	<complexType>
    	<sequence>
							<element name="Tipo_record" maxOccurs="1"
								minOccurs="1">
								<simpleType>
									<restriction base="string">
										<enumeration value="2"></enumeration>
									</restriction>
								</simpleType>
							</element>
							<element name="IDSLUCO" maxOccurs="1"
								minOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"></maxLength>
										<minLength value="1"></minLength>
									</restriction>
								</simpleType>
							</element>
							<element name="OPERATORE" maxOccurs="1"
								minOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="3"></maxLength>
										<minLength value="1"></minLength>
									</restriction>
								</simpleType>
							</element>
							<element name="CLLI" maxOccurs="1"
								minOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"></maxLength>
										<minLength value="1"></minLength>
									</restriction>
								</simpleType>
							</element>
							<element name="DATA_CONSEGNA_OLO"
								maxOccurs="1" minOccurs="1">
								<simpleType>
									<restriction base="string">
										<minLength value="1"></minLength>
									</restriction>
								</simpleType>
							</element>
							<element name="ID_RICHIESTA" maxOccurs="1"
								minOccurs="1">
								<simpleType>
									<restriction base="int">
										<totalDigits value="10"></totalDigits>
										<minExclusive value="1"></minExclusive>
									</restriction>
								</simpleType>
							</element>
							<element name="COPPIA_DA" maxOccurs="1"
								minOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="3"></maxLength>
										<enumeration value="1"></enumeration>
										<minLength value="1"></minLength>
									</restriction>
								</simpleType>
							</element>
                            <element name="COPPIA_A" maxOccurs="1" minOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="3"></maxLength>
										<enumeration value="500"></enumeration>
										<minLength value="1"></minLength>
									</restriction>
								</simpleType>
                            </element>
                            <element name="DATA_INVIO" maxOccurs="1"
                            	minOccurs="1">

                            	<simpleType>
                            		<restriction base="string">
                            			<minLength value="1"></minLength>
                            		</restriction>
                            	</simpleType>
                            </element>
                            <element name="TESTARMADIO" maxOccurs="1"
								minOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="2"></maxLength>
										<enumeration value="T1"></enumeration>
									</restriction>
								</simpleType>
                            </element>
						</sequence>
					</complexType>
				</element>

  
<simpleType name="datanewtime">
		<restriction base="string"> <pattern
                                          value="((0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-(1[0-9][0-9][0-9]|2[0]\d\d))" /></restriction>
	</simpleType>

</schema>
