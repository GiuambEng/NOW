<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/NewXMLSchema" elementFormDefault="qualified" targetNamespace="http://www.example.org/NewXMLSchema">


  <element name="IDSLUCO_TIM">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:IDSLUCO_TIM_Dettaglio">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="IDSLUCO_TIM_Dettaglio">
    	<complexType>
    	<sequence>
							<element maxOccurs="1" minOccurs="1" name="Tipo_record">
								<simpleType>
									<restriction base="string">
										<enumeration value="2"/>
									</restriction>
								</simpleType>
							</element>
							<element maxOccurs="1" minOccurs="1" name="IDSLUCO">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element maxOccurs="1" minOccurs="1" name="OPERATORE">
								<simpleType>
									<restriction base="string">
										<maxLength value="3"/>
									</restriction>
								</simpleType>
							</element>
							<element maxOccurs="1" minOccurs="1" name="CLLI">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element maxOccurs="1" minOccurs="1" name="DATA_CONSEGNA_OLO" type="tns:datanewtime">
							</element>
							<element maxOccurs="1" minOccurs="1" name="ID_RICHIESTA">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element maxOccurs="1" minOccurs="1" name="COPPIA_DA">
								<simpleType>
									<restriction base="string">
										<maxLength value="3"/>
										<enumeration value="1"/>
									</restriction>
								</simpleType>
							</element>
                            <element maxOccurs="1" minOccurs="1" name="COPPIA_A">
								<simpleType>
									<restriction base="string">
										<maxLength value="3"/>
										<enumeration value="500"/>
									</restriction>
								</simpleType>
                            </element>
                            <element maxOccurs="1" minOccurs="1" name="DATA_INVIO">
                            <simpleType>
                            <restriction base="string">
                            <pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"/>
            </restriction>
          </simpleType>
							</element>
                            <element maxOccurs="1" minOccurs="1" name="TESTARMADIO">
								<simpleType>
									<restriction base="string">
										<maxLength value="2"/>
										<enumeration value="T1"/>
									</restriction>
								</simpleType>
                            </element>
						</sequence>
					</complexType>
				</element>

  
<simpleType name="datanewtime">
		<restriction base="string"> <pattern value="((0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-(1[0-9][0-9][0-9]|2[0]\d\d))"/>
    </restriction>
	</simpleType>
	
	</schema>
