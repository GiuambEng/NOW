<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/tim.now.schema.xsd.NOW_AnagraficaUnicaSLU_SubProcess" xmlns:tns="http://www.example.org/tim.now.schema.xsd.NOW_AnagraficaUnicaSLU_SubProcess" elementFormDefault="qualified">

<element name="AnagraficaUnicaSlu_Dettaglio">
    	<complexType>
    		<sequence>
    			<element name="Tipo_record" maxOccurs="1" minOccurs="0"
    				type="string">
    			</element>
    			<element name="ID_RISORSA" maxOccurs="1" minOccurs="0"
    				type="string">
    			</element>
    			<element name="DEC_ATT" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="DEC_CES" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="FlagValidita" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="Numero_Record" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="ID_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="AnagraficaUnicaSlu">
    	<complexType>
    		<sequence>
    			<element ref="tns:AnagraficaUnicaSlu_Dettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>






    <element name="AnagraficaUnicaSlu_output">
    	<complexType>
    		<sequence>
    			<element name="Esito" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>