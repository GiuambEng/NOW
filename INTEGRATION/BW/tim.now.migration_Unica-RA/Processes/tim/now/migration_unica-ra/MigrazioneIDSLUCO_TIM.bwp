;xsl:value-of select=&quot;xsd:dateTime(ns:TMSP_INSMTO)&quot;/>&lt;/TMSP_INSMTO>&lt;CONTENUTO_RECD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:CONTENUTO_RECD)&quot;>&lt;xsl:value-of select=&quot;ns:CONTENUTO_RECD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONTENUTO_RECD>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
