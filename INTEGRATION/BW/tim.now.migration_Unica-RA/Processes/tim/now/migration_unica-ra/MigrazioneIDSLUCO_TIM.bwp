                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.STAG_ANAG_IDSLUCO_FILE (COD_CLLI_CENTRALE,&#xa;  CODFC_OLO_AGCOM, COPPIA_A, COPPIA_DA, DATAINZ_VALID, DATA_INVIO_RICH,&#xa;  ID_FILE_PROCSTO_INPUT, ID_RICH_FATTIB, ID_STATO_ELAB_STAG, IDSLUCO,&#xa;  NUMERO_RECD, PROGRS, TESTARMADIO, TMSP_INSMTO, CONTENUTO_RECD)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)))"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
