                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/log/InsertStagingIDSLUCO/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/IDSLUCO_TIM_Noval&quot; xmlns:ns1=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OK_ELAB_FILE&quot;/>&lt;xsl:param name=&quot;NoVal_Last_Detail&quot;/>&lt;xsl:param name=&quot;NoVal_Detail&quot;/>&lt;xsl:param name=&quot;ContenutoRecord&quot;/>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Invoke_ProcessLogger&quot;/>&lt;xsl:template name=&quot;Var_InsStag&quot; match=&quot;/&quot;>&lt;ns:root>&lt;xsl:choose>&lt;xsl:when test=&quot;count($NoVal_Last_Detail/Rows/tns:IDSLUCO_TIM_DettaglioNoval)=0&quot;>&lt;xsl:for-each select=&quot;$NoVal_Detail/Rows/tns:IDSLUCO_TIM_DettaglioNoval&quot;>&lt;ns:Input>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns:CLLI&quot;>&lt;ns:COD_CLLI_CENTRALE>&lt;xsl:value-of select=&quot;tns:CLLI&quot;/>&lt;/ns:COD_CLLI_CENTRALE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:OPERATORE&quot;>&lt;ns:CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;tns:OPERATORE&quot;/>&lt;/ns:CODFC_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COPPIA_A&quot;>&lt;ns:COPPIA_A>&lt;xsl:value-of select=&quot;tns:COPPIA_A&quot;/>&lt;/ns:COPPIA_A>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COPPIA_DA&quot;>&lt;ns:COPPIA_DA>&lt;xsl:value-of select=&quot;tns:COPPIA_DA&quot;/>&lt;/ns:COPPIA_DA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DATA_CONSEGNA_OLO&quot;>&lt;ns:DATAINZ_VALID>&lt;xsl:value-of select=&quot;tns:DATA_CONSEGNA_OLO&quot;/>&lt;/ns:DATAINZ_VALID>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DATA_INVIO&quot;>&lt;ns:DATA_INVIO_RICH>&lt;xsl:value-of select=&quot;tns:DATA_INVIO&quot;/>&lt;/ns:DATA_INVIO_RICH>&lt;/xsl:if>&lt;ns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal($Invoke_ProcessLogger/part1/ns2:Output/ns2:Esito/ns2:ID_FILE)&quot;/>&lt;/ns:ID_FILE_PROCSTO_INPUT>&lt;xsl:if test=&quot;tns:ID_RICHIESTA&quot;>&lt;ns:ID_RICH_FATTIB>&lt;xsl:value-of select=&quot;tns:ID_RICHIESTA&quot;/>&lt;/ns:ID_RICH_FATTIB>&lt;/xsl:if>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_FILE&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;xsl:if test=&quot;tns:IDSLUCO&quot;>&lt;ns:IDSLUCO>&lt;xsl:value-of select=&quot;tns:IDSLUCO&quot;/>&lt;/ns:IDSLUCO>&lt;/xsl:if>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var&quot;/>&lt;/ns:NUMERO_RECD>&lt;ns:PROGRS>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/ns:PROGRS>&lt;xsl:if test=&quot;tns:TESTARMADIO&quot;>&lt;ns:TESTARMADIO>&lt;xsl:value-of select=&quot;tns:TESTARMADIO&quot;/>&lt;/ns:TESTARMADIO>&lt;/xsl:if>&lt;ns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INSMTO>&lt;xsl:if test=&quot;$ContenutoRecord/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$ContenutoRecord/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/xsl:if>&lt;/ns:Input>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$NoVal_Last_Detail/Rows/tns:IDSLUCO_TIM_DettaglioNoval&quot;>&lt;ns:Input>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns:CLLI&quot;>&lt;ns:COD_CLLI_CENTRALE>&lt;xsl:value-of select=&quot;tns:CLLI&quot;/>&lt;/ns:COD_CLLI_CENTRALE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:OPERATORE&quot;>&lt;ns:CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;tns:OPERATORE&quot;/>&lt;/ns:CODFC_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COPPIA_A&quot;>&lt;ns:COPPIA_A>&lt;xsl:value-of select=&quot;tns:COPPIA_A&quot;/>&lt;/ns:COPPIA_A>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COPPIA_DA&quot;>&lt;ns:COPPIA_DA>&lt;xsl:value-of select=&quot;tns:COPPIA_DA&quot;/>&lt;/ns:COPPIA_DA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DATA_CONSEGNA_OLO&quot;>&lt;ns:DATAINZ_VALID>&lt;xsl:value-of select=&quot;tns:DATA_CONSEGNA_OLO&quot;/>&lt;/ns:DATAINZ_VALID>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DATA_INVIO&quot;>&lt;ns:DATA_INVIO_RICH>&lt;xsl:value-of select=&quot;tns:DATA_INVIO&quot;/>&lt;/ns:DATA_INVIO_RICH>&lt;/xsl:if>&lt;ns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal($Invoke_ProcessLogger/part1/ns2:Output/ns2:Esito/ns2:ID_FILE)&quot;/>&lt;/ns:ID_FILE_PROCSTO_INPUT>&lt;xsl:if test=&quot;tns:ID_RICHIESTA&quot;>&lt;ns:ID_RICH_FATTIB>&lt;xsl:value-of select=&quot;tns:ID_RICHIESTA&quot;/>&lt;/ns:ID_RICH_FATTIB>&lt;/xsl:if>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_FILE&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;xsl:if test=&quot;tns:IDSLUCO&quot;>&lt;ns:IDSLUCO>&lt;xsl:value-of select=&quot;tns:IDSLUCO&quot;/>&lt;/ns:IDSLUCO>&lt;/xsl:if>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var1&quot;/>&lt;/ns:NUMERO_RECD>&lt;ns:PROGRS>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/ns:PROGRS>&lt;xsl:if test=&quot;tns:TESTARMADIO&quot;>&lt;ns:TESTARMADIO>&lt;xsl:value-of select=&quot;tns:TESTARMADIO&quot;/>&lt;/ns:TESTARMADIO>&lt;/xsl:if>&lt;ns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INSMTO>&lt;xsl:if test=&quot;$ContenutoRecord/ns1:Output_ContenutoRecord[ns1:Posizione=$var1]/ns1:Valore&quot;>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$ContenutoRecord/ns1:Output_ContenutoRecord[ns1:Posizione=$var1]/ns1:Valore&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/xsl:if>&lt;/ns:Input>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:root>&lt;/xsl:template>&lt;/xsl:stylesheet>"
