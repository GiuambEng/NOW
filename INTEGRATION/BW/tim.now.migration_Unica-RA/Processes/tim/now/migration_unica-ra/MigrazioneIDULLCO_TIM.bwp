l:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:DATA_ARRIVO"/&gt;&lt;/ns:DATA_ARRIVO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoInput/ns:DIMENSIONE_FILE"&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:DIMENSIONE_FILE"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO"&gt;&lt;ns:ID_CAUS_SCARTO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO"/&gt;&lt;/ns:ID_CAUS_SCARTO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT"&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_KO"&gt;&lt;ns:QT_RECD_KO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_KO"/&gt;&lt;/ns:QT_RECD_KO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_OK"&gt;&lt;ns:QT_RECD_OK&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_OK"/&gt;&lt;/ns:QT_RECD_OK&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_TOTALI"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_TOTALI"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoInput&gt;&lt;ns:EsecuzioneFile&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneFile/ns:COD_PROCSO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneFile/ns:COD_PROCSO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_PROCSO_FILE"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneFile/ns:STATO_ESEC"&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneFile/ns:STATO_ESEC"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB"&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB"&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:if&gt;&lt;/ns:EsecuzioneFile&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL"&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger