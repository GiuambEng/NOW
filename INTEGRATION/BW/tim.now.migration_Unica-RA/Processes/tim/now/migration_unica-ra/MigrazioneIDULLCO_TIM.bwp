&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NOW_UNICA-RA_IDULLCO_TIM/" xmlns:tns1="http://www.tim.com/NOW/xsd/IDULLCO_TIM_Noval" xmlns:ns19="http://www.tim.com/NOW/AllineamentiBatch/contaRecord/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="Passo"/&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="NoVal_Detail"/&gt;&lt;xsl:param name="NoVal_Last_Detail"/&gt;&lt;xsl:param name="Invoke_Counter"/&gt;&lt;xsl:param name="Invoke_ProcessLogger"/&gt;&lt;xsl:template name="DetailControl-input" match="/"&gt;&lt;tns:ControlDetailIDULLCO_TIMRequest&gt;&lt;parameters&gt;&lt;tns1:IDULLCO_TIM&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$index &amp;lt;=(($Invoke_Counter/part1/ns19:contaRecord_Output/ns19:NumeroRecord ) div $Passo)"&gt;&lt;xsl:for-each select="$NoVal_Detail/Rows/tns1:IDULLCO_TIM_Dettaglio"&gt;&lt;tns1:IDULLCO_TIM_Dettaglio&gt;&lt;xsl:if test="tns1:Tipo_record"&gt;&lt;tns1:Tipo_record&gt;&lt;xsl:value-of select="tns1:Tipo_record"/&gt;&lt;/tns1:Tipo_record&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:IDULLCO"&gt;&lt;tns1:IDULLCO&gt;&lt;xsl:value-of select="tns1:IDULLCO"/&gt;&lt;/tns1:IDULLCO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:OLO"&gt;&lt;tns1:OLO&gt;&lt;xsl:value-of select="tns1:OLO"/&gt;&lt;/tns1:OLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:CLLI"&gt;&lt;tns1:CLLI&gt;&lt;xsl:value-of select="tns1:CLLI"/&gt;&lt;/tns1:CLLI&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:DATA_CONSEGNA_OLO"&gt;&lt;tns1:DATA_CONSEGNA_OLO&gt;&lt;xsl:value-of select="tns1:DATA_CONSEGNA_OLO"/&gt;&lt;/tns1:DATA_CONSEGNA_OLO&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(tns1:DATA_FINE_VALIDITA)&gt;0"&gt;&lt;xsl:if test="tns1:DATA_FINE_VALIDITA"&gt;&lt;tns1:DATA_FINE_VALIDITA&gt;&lt;xsl:value-of select="tns1:DATA_FINE_VALIDITA"/&gt;&lt;/tns1:DATA_FINE_VALIDITA&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:DATA_FINE_VALIDITA&gt;&lt;xsl:value-of select="'01-01-2999'"/&gt;&lt;/tns1:DATA_FINE_VALIDITA&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="tns1:DATA_INVIO"&gt;&lt;tns1:DATA_INVIO&gt;&lt;xsl:value-of select="tns1:DATA_INVIO"/&gt;&lt;/tns1:DATA_INVIO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:Nome"&gt;&lt;tns1:Nome&gt;&lt;xsl:value-of select="tns1:Nome"/&gt;&lt;/tns1:Nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:DRCP"&gt;&lt;tns1:DRCP&gt;&lt;xsl:value-of select="tns1:DRCP"/&gt;&lt;/tns1:DRCP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:Codice_GAT"&gt;&lt;tns1:Codice_GAT&gt;&lt;xsl:value-of select="tns1:Codice_GAT"/&gt;&lt;/tns1:Codice_GAT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:TIPO_COLOCAZIONE"&gt;&lt;tns1:TIPO_COLOCAZIONE&gt;&lt;xsl:value-of select="tns1:TIPO_COLOCAZIONE"/&gt;&lt;/tns1:TIPO_COLOCAZIONE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:Stato"&gt;&lt;tns1:Stato&gt;&lt;xsl:value-of select="tns1:Stato"/&gt;&lt;/tns1:Stato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:Descrizione_Errore"&gt;&lt;tns1:Descrizione_Errore&gt;&lt;xsl:value-of select="tns1:Descrizione_Errore"/&gt;&lt;/tns1:Descrizione_Errore&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:Flag_Validita"&gt;&lt;tns1:Flag_Validita&gt;&lt;xsl:value-of select="tns1:Flag_Validita"/&gt;&lt;/tns1:Flag_Validita&gt;&lt;/xsl:if&gt;&lt;tns1:NUMERO_RECD&gt;&lt;xsl:value-of select="(($Passo * ($index -1)) + position())"/&gt;&lt;/tns1:NUMERO_RECD&gt;&lt;tns1:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="xsd:decimal($Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;&lt;/tns1:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:if test="tns1:Record"&gt;&lt;tns1:Record&gt;&lt;xsl:value-of select="tns1:Record"/&gt;&lt;/tns1:Record&gt;&lt;/xsl:if&gt;&lt;/tns1:IDULLCO_TIM_Dettaglio&gt;&lt;/xsl:for-each&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:for-each select="$NoVal_Last_Detail/Rows/tns1:IDULLCO_TIM_Dettaglio"&gt;&lt;tns1:IDULLCO_TIM_Dettaglio&gt;&lt;xsl:if test="tns1:Tipo_record"&gt;&lt;tns1:Tipo_record&gt;&lt;xsl:value-of select="tns1:Tipo_record"/&gt;&lt;/tns1:Tipo_record&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:IDULLCO"&gt;&lt;tns1:IDULLCO&gt;&lt;xsl:value-of select="tns1:IDULLCO"/&gt;&lt;/tns1:IDULLCO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:OLO"&gt;&lt;tns1:OLO&gt;&lt;xsl:value-of select="tns1:OLO"/&gt;&lt;/tns1:OLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:CLLI"&gt;&lt;tns1:CLLI&gt;&lt;xsl:value-of select="tns1:CLLI"/&gt;&lt;/tns1:CLLI&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:DATA_CONSEGNA_OLO"&gt;&lt;tns1:DATA_CONSEGNA_OLO&gt;&lt;xsl:value-of select="tns1:DATA_CONSEGNA_OLO"/&gt;&lt;/tns1:DATA_CONSEGNA_OLO&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(tns1:DATA_FINE_VALIDITA)&gt;0"&gt;&lt;xsl:if test="tns1:DATA_FINE_VALIDITA"&gt;&lt;tns1:DATA_FINE_VALIDITA&gt;&lt;xsl:value-of select="tns1:DATA_FINE_VALIDITA"/&gt;&lt;/tns1:DATA_FINE_VALIDITA&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:DATA_FINE_VALIDITA&gt;&lt;xsl:value-of select="'01-01-2999'"/&gt;&lt;/tns1:DATA_FINE_VALIDITA&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="tns1:DATA_INVIO"&gt;&lt;tns1:DATA_INVIO&gt;&lt;xsl:value-of select="tns1:DATA_INVIO"/&gt;&lt;/tns1:DATA_INVIO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:Nome"&gt;&lt;tns1:Nome&gt;&lt;xsl:value-of select="tns1:Nome"/&gt;&lt;/tns1:Nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:DRCP"&gt;&lt;tns1:DRCP&gt;&lt;xsl:value-of select="tns1:DRCP"/&gt;&lt;/tns1:DRCP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:Codice_GAT"&gt;&lt;tns1:Codice_GAT&gt;&lt;xsl:value-of select="tns1:Codice_GAT"/&gt;&lt;/tns1:Codice_GAT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:TIPO_COLOCAZIONE"&gt;&lt;tns1:TIPO_COLOCAZIONE&gt;&lt;xsl:value-of select="tns1:TIPO_COLOCAZIONE"/&gt;&lt;/tns1:TIPO_COLOCAZIONE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:Stato"&gt;&lt;tns1:Stato&gt;&lt;xsl:value-of select="tns1:Stato"/&gt;&lt;/tns1:Stato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:Descrizione_Errore"&gt;&lt;tns1:Descrizione_Errore&gt;&lt;xsl:value-of select="tns1:Descrizione_Errore"/&gt;&lt;/tns1:Descrizione_Errore&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:Flag_Validita"&gt;&lt;tns1:Flag_Validita&gt;&lt;xsl:value-of select="tns1:Flag_Validita"/&gt;&lt;/tns1:Flag_Validita&gt;&lt;/xsl:if&gt;&lt;tns1:NUMERO_RECD&gt;&lt;xsl:value-of select="(($Passo * ($index -1)) + position())"/&gt;&lt;/tns1:NUMERO_RECD&gt;&lt;tns1:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="xsd:decimal($Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;&lt;/tns1:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:if test="tns1:Record"&gt;&lt;tns1:Record&gt;&lt;xsl:value-of select="tns1:Record"/&gt;&lt;/tns1:Record&gt;&lt;/xsl:if&gt;&lt;/tns1:IDULLCO_TIM_Dettaglio&gt;&lt;/xsl:for-each&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns1:IDULLCO_TIM&gt;&lt;/parameters&gt;&lt;/tns:ControlDetailIDULLCO_TIMRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_UNICA-RA_IDULLCO_TIM/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/IDULLCO_TIM_Noval&quot; xmlns:ns19=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Invoke_Counter.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;NoVal_Detail&quot;/>&#xa;    &lt;xsl:param name=&quot;NoVal_Last_Detail&quot;/>&#xa;    &lt;xsl:template name=&quot;DetailControl-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:IDULLCO_TIM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$index &amp;lt;=(($Invoke_Counter.part1/ns19:NumeroRecord ) div $Passo)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$NoVal_Detail/Rows/tns1:IDULLCO_TIM_Dettaglio&quot;>&#xa;                        &lt;tns1:IDULLCO_TIM_Dettaglio>&#xa;                            &lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&#xa;                                &lt;tns1:Tipo_record>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&#xa;                                &lt;/tns1:Tipo_record>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:IDULLCO&quot;>&#xa;                                &lt;tns1:IDULLCO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:IDULLCO&quot;/>&#xa;                                &lt;/tns1:IDULLCO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO&quot;>&#xa;                                &lt;tns1:OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO&quot;/>&#xa;                                &lt;/tns1:OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CLLI&quot;>&#xa;                                &lt;tns1:CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&#xa;                                &lt;/tns1:CLLI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DATA_CONSEGNA_OLO&quot;>&#xa;                                &lt;tns1:DATA_CONSEGNA_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_CONSEGNA_OLO&quot;/>&#xa;                                &lt;/tns1:DATA_CONSEGNA_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(tns1:DATA_FINE_VALIDITA)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns1:DATA_FINE_VALIDITA&quot;>&#xa;                                        &lt;tns1:DATA_FINE_VALIDITA>&#xa;                                            &lt;xsl:value-of select=&quot;tns1:DATA_FINE_VALIDITA&quot;/>&#xa;                                        &lt;/tns1:DATA_FINE_VALIDITA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns1:DATA_FINE_VALIDITA>&#xa;                                        &lt;xsl:value-of select=&quot;'01-01-2999'&quot;/>&#xa;                                    &lt;/tns1:DATA_FINE_VALIDITA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;tns1:DATA_INVIO&quot;>&#xa;                                &lt;tns1:DATA_INVIO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_INVIO&quot;/>&#xa;                                &lt;/tns1:DATA_INVIO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Nome&quot;>&#xa;                                &lt;tns1:Nome>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Nome&quot;/>&#xa;                                &lt;/tns1:Nome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DRCP&quot;>&#xa;                                &lt;tns1:DRCP>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DRCP&quot;/>&#xa;                                &lt;/tns1:DRCP>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Codice_GAT&quot;>&#xa;                                &lt;tns1:Codice_GAT>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Codice_GAT&quot;/>&#xa;                                &lt;/tns1:Codice_GAT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TIPO_COLOCAZIONE&quot;>&#xa;                                &lt;tns1:TIPO_COLOCAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TIPO_COLOCAZIONE&quot;/>&#xa;                                &lt;/tns1:TIPO_COLOCAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Stato&quot;>&#xa;                                &lt;tns1:Stato>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Stato&quot;/>&#xa;                                &lt;/tns1:Stato>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Descrizione_Errore&quot;>&#xa;                                &lt;tns1:Descrizione_Errore>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Descrizione_Errore&quot;/>&#xa;                                &lt;/tns1:Descrizione_Errore>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Flag_Validita&quot;>&#xa;                                &lt;tns1:Flag_Validita>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Flag_Validita&quot;/>&#xa;                                &lt;/tns1:Flag_Validita>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;/tns1:NUMERO_RECD>&#xa;                            &lt;tns1:ID_FILE_PROCSTO_INPUT>&#xa;                                &lt;xsl:value-of select=&quot;xsd:decimal($Invoke_ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                            &lt;/tns1:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;xsl:if test=&quot;tns1:Record&quot;>&#xa;                                &lt;tns1:Record>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record&quot;/>&#xa;                                &lt;/tns1:Record>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:IDULLCO_TIM_Dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$NoVal_Last_Detail/Rows/tns1:IDULLCO_TIM_Dettaglio&quot;>&#xa;                        &lt;tns1:IDULLCO_TIM_Dettaglio>&#xa;                            &lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&#xa;                                &lt;tns1:Tipo_record>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&#xa;                                &lt;/tns1:Tipo_record>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:IDULLCO&quot;>&#xa;                                &lt;tns1:IDULLCO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:IDULLCO&quot;/>&#xa;                                &lt;/tns1:IDULLCO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO&quot;>&#xa;                                &lt;tns1:OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO&quot;/>&#xa;                                &lt;/tns1:OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CLLI&quot;>&#xa;                                &lt;tns1:CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&#xa;                                &lt;/tns1:CLLI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DATA_CONSEGNA_OLO&quot;>&#xa;                                &lt;tns1:DATA_CONSEGNA_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_CONSEGNA_OLO&quot;/>&#xa;                                &lt;/tns1:DATA_CONSEGNA_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(tns1:DATA_FINE_VALIDITA)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns1:DATA_FINE_VALIDITA&quot;>&#xa;                                        &lt;tns1:DATA_FINE_VALIDITA>&#xa;                                            &lt;xsl:value-of select=&quot;tns1:DATA_FINE_VALIDITA&quot;/>&#xa;                                        &lt;/tns1:DATA_FINE_VALIDITA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns1:DATA_FINE_VALIDITA>&#xa;                                        &lt;xsl:value-of select=&quot;'01-01-2999'&quot;/>&#xa;                                    &lt;/tns1:DATA_FINE_VALIDITA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;tns1:DATA_INVIO&quot;>&#xa;                                &lt;tns1:DATA_INVIO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DATA_INVIO&quot;/>&#xa;                                &lt;/tns1:DATA_INVIO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Nome&quot;>&#xa;                                &lt;tns1:Nome>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Nome&quot;/>&#xa;                                &lt;/tns1:Nome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DRCP&quot;>&#xa;                                &lt;tns1:DRCP>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DRCP&quot;/>&#xa;                                &lt;/tns1:DRCP>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Codice_GAT&quot;>&#xa;                                &lt;tns1:Codice_GAT>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Codice_GAT&quot;/>&#xa;                                &lt;/tns1:Codice_GAT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TIPO_COLOCAZIONE&quot;>&#xa;                                &lt;tns1:TIPO_COLOCAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TIPO_COLOCAZIONE&quot;/>&#xa;                                &lt;/tns1:TIPO_COLOCAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Stato&quot;>&#xa;                                &lt;tns1:Stato>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Stato&quot;/>&#xa;                                &lt;/tns1:Stato>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Descrizione_Errore&quot;>&#xa;                                &lt;tns1:Descrizione_Errore>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Descrizione_Errore&quot;/>&#xa;                                &lt;/tns1:Descrizione_Errore>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Flag_Validita&quot;>&#xa;                                &lt;tns1:Flag_Validita>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Flag_Validita&quot;/>&#xa;                                &lt;/tns1:Flag_Validita>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;/tns1:NUMERO_RECD>&#xa;                            &lt;tns1:ID_FILE_PROCSTO_INPUT>&#xa;                                &lt;xsl:value-of select=&quot;xsd:decimal($Invoke_ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                            &lt;/tns1:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;xsl:if test=&quot;tns1:Record&quot;>&#xa;                                &lt;tns1:Record>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record&quot;/>&#xa;                                &lt;/tns1:Record>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:IDULLCO_TIM_Dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:IDULLCO_TIM>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
