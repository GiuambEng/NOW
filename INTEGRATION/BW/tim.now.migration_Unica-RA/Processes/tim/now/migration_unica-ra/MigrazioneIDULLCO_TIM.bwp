                    outputVariable="Input_ProcessLogger"
                    tibex:xpdlId="fec4dc68-8158-4d45-bc5d-9dbcbeb7e4e7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess4ToInput_ProcessLogger"/>
