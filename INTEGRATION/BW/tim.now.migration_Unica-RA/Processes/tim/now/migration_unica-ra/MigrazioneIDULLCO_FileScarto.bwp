       &lt;xsl:value-of select=&quot;ns:column[ns:name='DATAINZ_VALID']/ns:value&quot;/>&#xa;                        &lt;/ns1:DATA_CONSEGNA_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:column[ns:name='ID_RICH_FATTIB']/ns:value&quot;>&#xa;                        &lt;ns1:ID_RICHIESTA>&#xa;                            &lt;xsl:value-of select=&quot;ns:column[ns:name='ID_RICH_FATTIB']/ns:value&quot;/>&#xa;                        &lt;/ns1:ID_RICHIESTA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:column[ns:name='COPPIA_DA']/ns:value&quot;>&#xa;                        &lt;ns1:COPPIA_DA>&#xa;                            &lt;xsl:value-of select=&quot;ns:column[ns:name='COPPIA_DA']/ns:value&quot;/>&#xa;                        &lt;/ns1:COPPIA_DA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:column[ns:name='COPPIA_A']/ns:value&quot;>&#xa;                        &lt;ns1:COPPIA_A>&#xa;                            &lt;xsl:value-of select=&quot;ns:column[ns:name='COPPIA_A']/ns:value&quot;/>&#xa;                        &lt;/ns1:COPPIA_A>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:column[ns:name='DATA_INVIO_RICH']/ns:value&quot;>&#xa;                        &lt;ns1:DATA_INVIO>&#xa;                            &lt;xsl:value-of select=&quot;ns:column[ns:name='DATA_INVIO_RICH']/ns:value&quot;/>&#xa;                        &lt;/ns1:DATA_INVIO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:column[ns:name='TESTARMADIO']/ns:value&quot;>&#xa;                        &lt;ns1:TESTARMADIO>&#xa;                            &lt;xsl:value-of select=&quot;ns:column[ns:name='TESTARMADIO']/ns:value&quot;/>&#xa;                        &lt;/ns1:TESTARMADIO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns1:IDSLUCO_TIM_Dettaglio>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:Rows>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.parse.renderdata"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:parse="http://ns.tibco.com/bw/palette/parse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/parse#//RenderData"/>
                                    <value
                                    dataFormat="dataFormatResourceProperty" xsi:type="parse:RenderData"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="concat($PathFileScarto,$NomeFileScarto_IDULLCO, format-date(current-date(), &quot;[Y0001][M01][D01][H01]&quot;), $Estensione)"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="Var_PathFile" name="PathFileIDULLCO"
                    outputVariable="Var_PathFile"
                    tibex:xpdlId="1fa26d66-7a5a-43a4-9315-fce94404b6d4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IDULLCOToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="PathFileIDULLCOToWriteFile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat($PathFileScarto,$NomeFileScarto_IDULLCO, format-date(current-date(), &quot;[Y0001][M01][D01][H01]&quot;), $Estensione)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Var_PathFile" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="concat($PathFileScarto, $NomeFileScarto_IDSLUCO, format-dateTime(current-dateTime(), &quot;[Y0001][M01][D01][H01][m01][s01][f001]&quot;), $Estensione)"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="Var_PathFile" name="PathFileIDSLUCO"
                    outputVariable="Var_PathFile"
                    tibex:xpdlId="903ca970-15b4-4cfd-97a8-0771ac5e2f5b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IDSLUCOToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="PathFileIDSLUCOToWriteFile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat($PathFileScarto, $NomeFileScarto_IDSLUCO, format-dateTime(current-dateTime(), &quot;[Y0001][M01][D01][H01][m01][s01][f001]&quot;), $Estensione)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Var_PathFile" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:ns=&quot;www.tim.now.common.Migrazioni.Unica.CreazioneFileScarto.Common&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_PathFile&quot;/>&lt;xsl:param name=&quot;IDSLUCO&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IDULLCO&quot;/>&lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&lt;tns:WriteActivityInputTextClass>&lt;fileName>&lt;xsl:value-of select=&quot;$Var_PathFile&quot;/>&lt;/fileName>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:NomeFlusso ='IDULLCO'&quot;>&lt;textContent>&lt;xsl:value-of select=&quot;$IDULLCO&quot;/>&lt;/textContent>&lt;/xsl:when>&lt;xsl:otherwise>&lt;textContent>&lt;xsl:value-of select=&quot;$IDSLUCO&quot;/>&lt;/textContent>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:WriteActivityInputTextClass>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="WriteFile-input" name="WriteFile"
                    outputVariable="WriteFile"
                    tibex:xpdlId="21f8c6f7-4405-47ce-9a0b-722498be6d24" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PathFileIDULLCOToWriteFile"/>
                        <bpws:target linkName="PathFileIDSLUCOToWriteFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="WriteFileToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:ns=&quot;www.tim.now.common.Migrazioni.Unica.CreazioneFileScarto.Common&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_PathFile&quot;/>&lt;xsl:param name=&quot;IDSLUCO&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IDULLCO&quot;/>&lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&lt;tns:WriteActivityInputTextClass>&lt;fileName>&lt;xsl:value-of select=&quot;$Var_PathFile&quot;/>&lt;/fileName>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:NomeFlusso ='IDULLCO'&quot;>&lt;textContent>&lt;xsl:value-of select=&quot;$IDULLCO&quot;/>&lt;/textContent>&lt;/xsl:when>&lt;xsl:otherwise>&lt;textContent>&lt;xsl:value-of select=&quot;$IDSLUCO&quot;/>&lt;/textContent>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:WriteActivityInputTextClass>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.write"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//WriteFile"/>
                                    <value compressFile="None"
                                    encoding="text" xsi:type="file:WriteFile"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
