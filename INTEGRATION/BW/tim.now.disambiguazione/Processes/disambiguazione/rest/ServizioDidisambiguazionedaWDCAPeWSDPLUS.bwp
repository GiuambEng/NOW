                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ServizioDidisambiguazionedaWDCAPeWSDPLUS&quot; xmlns:tns12=&quot;http://www.example.org/VerificaIDRisorsaWSDPLUS&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseJSON&quot;/>&#xa;    &lt;xsl:param name=&quot;Query_CodIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;Query_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;Query_TI&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$post.item/tns:Servizio=('KIT MULTISERVIZIO','Porta Gbe su KIT MS per TE su FO','Terminating Ethernet','CAR Terminating Ethernet','KIT VULA')&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($JDBCQuery/Record)=0&quot;>&#xa;                        &lt;tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSOutput>&#xa;                            &lt;tns:IDRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:IDRichiesta&quot;/>&#xa;                            &lt;/tns:IDRichiesta>&#xa;                            &lt;tns:CodificaOloAgcom>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:CodificaOloAgcom&quot;/>&#xa;                            &lt;/tns:CodificaOloAgcom>&#xa;                            &lt;tns:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:Servizio&quot;/>&#xa;                            &lt;/tns:Servizio>&#xa;                            &lt;tns:CodiceLavorazione>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:CodiceLavorazione&quot;/>&#xa;                            &lt;/tns:CodiceLavorazione>&#xa;                            &lt;tns:OwnerOrdine>&#xa;                                &lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&#xa;                            &lt;/tns:OwnerOrdine>&#xa;                            &lt;tns:CodiceEsito>&#xa;                                &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                            &lt;/tns:CodiceEsito>&#xa;                            &lt;tns:DescrizioneEsito>&#xa;                                &lt;xsl:value-of select=&quot;'OK - Regola di Roll out Gestita'&quot;/>&#xa;                            &lt;/tns:DescrizioneEsito>&#xa;                        &lt;/tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSOutput>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0 and $post.item/tns:CodiceLavorazione='1'&quot;>&#xa;                        &lt;tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSOutput>&#xa;                            &lt;tns:IDRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:IDRichiesta&quot;/>&#xa;                            &lt;/tns:IDRichiesta>&#xa;                            &lt;tns:CodificaOloAgcom>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:CodificaOloAgcom&quot;/>&#xa;                            &lt;/tns:CodificaOloAgcom>&#xa;                            &lt;tns:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:Servizio&quot;/>&#xa;                            &lt;/tns:Servizio>&#xa;                            &lt;tns:CodiceLavorazione>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:CodiceLavorazione&quot;/>&#xa;                            &lt;/tns:CodiceLavorazione>&#xa;                            &lt;tns:OwnerOrdine>&#xa;                                &lt;xsl:value-of select=&quot;'WSDPLUS'&quot;/>&#xa;                            &lt;/tns:OwnerOrdine>&#xa;                            &lt;tns:CodiceEsito>&#xa;                                &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                            &lt;/tns:CodiceEsito>&#xa;                            &lt;tns:DescrizioneEsito>&#xa;                                &lt;xsl:value-of select=&quot;'OK - Regola di Roll out Gestita'&quot;/>&#xa;                            &lt;/tns:DescrizioneEsito>&#xa;                        &lt;/tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSOutput>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0 and $post.item/tns:CodiceLavorazione!='1' and string-length($post.item/tns:IDRisorsa)=0&quot;>&#xa;                        &lt;tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSOutput>&#xa;                            &lt;tns:IDRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:IDRichiesta&quot;/>&#xa;                            &lt;/tns:IDRichiesta>&#xa;                            &lt;tns:CodificaOloAgcom>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:CodificaOloAgcom&quot;/>&#xa;                            &lt;/tns:CodificaOloAgcom>&#xa;                            &lt;tns:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:Servizio&quot;/>&#xa;                            &lt;/tns:Servizio>&#xa;                            &lt;tns:CodiceLavorazione>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:CodiceLavorazione&quot;/>&#xa;                            &lt;/tns:CodiceLavorazione>&#xa;                            &lt;tns:CodiceEsito>&#xa;                                &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                            &lt;/tns:CodiceEsito>&#xa;                            &lt;tns:DescrizioneEsito>&#xa;                                &lt;xsl:value-of select=&quot;'ID Risorsa obbligatorio per lavorazio