;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$post.item/tns:CodiceLavorazione=('5','6','7','8','17','18','29')&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($post.item/tns:CodiceOrdineOLOTarget)>0 or string-length($post.item/tns:CodiceOrdineTITarget)>0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Query_TI/Record)>0 or count($Query_OLO/Record)>0&quot;>&#xa;                                        &lt;tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSOutput>&#xa;                                            &lt;tns:IDRichiesta>&#xa;                                                &lt;xsl:value-of select=&quot;$post.item/tns:IDRichiesta&quot;/>&#xa;                                            &lt;/tns:IDRichiesta>&#xa;                                            &lt;tns:CodificaOloAgcom>&#xa;                                                &lt;xsl:value-of select=&quot;$post.item/tns:CodificaOloAgcom&quot;/>&#xa;                                            &lt;/tns:CodificaOloAgcom>&#xa;                                            &lt;tns:Servizio>&#xa;                                                &lt;xsl:value-of select=&quot;$post.item/tns:Servizio&quot;/>&#xa;                                            &lt;/tns:Servizio>&#xa;                                            &lt;tns:CodiceLavorazione>&#xa;                                                &lt;xsl:value-of select=&quot;$post.item/tns:CodiceLavorazione&quot;/>&#xa;                                            &lt;/tns:CodiceLavorazione>&#xa;                                            &lt;xsl:if test=&quot;$post.item/tns:CodiceIstatComune&quot;>&#xa;                                                &lt;tns:CodiceIstatComune>&#xa;                                                    &lt;xsl:value-of selec