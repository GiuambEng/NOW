io>&lt;xsl:value-of select=&quot;$post/item/tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSInput/tns:Servizio&quot;/>&lt;/tns:Servizio>&lt;tns:CodiceLavorazione>&lt;xsl:value-of select=&quot;$post/item/tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSInput/tns:CodiceLavorazione&quot;/>&lt;/tns:CodiceLavorazione>&lt;xsl:if test=&quot;$post/item/tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSInput/tns:CodiceIstatComune&quot;>&lt;tns:CodiceIstatComune>&lt;xsl:value-of select=&quot;$post/item/tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSInput/tns:CodiceIstatComune&quot;/>&lt;/tns:CodiceIstatComune>&lt;/xsl:if>&lt;tns:OwnerOrdine>&lt;xsl:value-of select=&quot;'WSDPLUS'&quot;/>&lt;/tns:OwnerOrdine>&lt;tns:CodiceEsito>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns:CodiceEsito>&lt;tns:DescrizioneEsito>&lt;xsl:value-of select=&quot;'OK - Regola di Roll out Gestita'&quot;/>&lt;/tns:DescrizioneEsito>&lt;/tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Query_CodIstat/Record) > 0 and $post/item/tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSInput/tns:CodiceLavorazione !=&amp;quot;1&amp;quot; and string-length($post/item/tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSInput/tns:IDRisorsa) = 0&quot;>&lt;tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSOutput>&lt;tns:IDRichiesta>&lt;xsl:value-of select=&quot;$post/item/tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSInput/tns:IDRichiesta&quot;/>&lt;/tns:IDRichiesta>&lt;tns:CodificaOloAgcom>&lt;xsl:value-of select=&quot;$post/item/tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSInput/tns:CodificaOloAgcom&quot;/>&lt;/tns:CodificaOloAgcom>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;$post/item/tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSInput/tns:Servizio&quot;/>&lt;/tns:Servizio>&lt;tns:CodiceLavorazione>&lt;xsl:value-of select=&quot;$post/item/tns:ServizioDidisambiguazionedaWDCAPeWSDPLUSInput/tns:CodiceLavorazione&quot;/>&lt;/tns:CodiceLavorazione>&lt;xsl:if test=&quot;$post/item/tns:ServizioDidisambiguazionedaW