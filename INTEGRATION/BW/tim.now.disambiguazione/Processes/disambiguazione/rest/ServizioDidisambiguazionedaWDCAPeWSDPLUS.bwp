                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT *&#xa;FROM ROLLOUT_LOCZRE_WSDPLUS &#xa;WHERE CODIFICA_OLO_AGCOM=?&#xa;AND SERVIZIO=?&#xa;AND COD_LAVRZ=?&#xa;AND CODICE_ISTAT_COMUNE=?&#xa;AND (DATAFI>SYSDATE AND DATAINZ&lt;SYSDATE)&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

