                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="td"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
