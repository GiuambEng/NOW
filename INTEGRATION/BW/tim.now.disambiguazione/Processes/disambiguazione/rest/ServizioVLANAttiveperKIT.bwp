                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5a511a30-b8d9-4369-8624-da9d38ab1a66+input&quot; xmlns:tns1=&quot;http://www.example.org/ServizioVLANAttiveperKIT&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect_KitVLAN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post.item/tns1:Modello)>0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT CODICE_KIT, STATO, FAMIGLIA_KIT, MODELLO_KIT, CLLI from   ANAGRAFICA_KIT_VLAN WHERE CODICE_KIT  =&amp;quot;,&amp;quot;'&amp;quot;, $post.item/tns1:Td,&amp;quot;'&amp;quot;,&amp;quot; AND UPPER(STATO) IN (&amp;quot;,&amp;quot;'&amp;quot;,'ACTIVE',&amp;quot;','&amp;quot;, 'TEMPORARY',&amp;quot;','&amp;quot;, 'IN PROGRESS',&amp;quot;'&amp;quot;,&amp;quot;) AND FAMIGLIA_KIT = CASE &amp;quot;,&amp;quot;'&amp;quot;,$post.item/tns1:tipoKit,&amp;quot;'&amp;quot;,&amp;quot; WHEN &amp;quot;,&amp;quot;'&amp;quot;,'KIT VULA',&amp;quot;'&amp;quot;,&amp;quot; THEN &amp;quot;,&amp;quot;'&amp;quot;,'VULA',&amp;quot;'&amp;quot;, &amp;quot; WHEN &amp;quot;,&amp;quot;'&amp;quot;,'KIT MULTISERVIZIO',&amp;quot;'&amp;quot;, &amp;quot; THEN &amp;quot;,&amp;quot;'&amp;quot;,'NGA',&amp;quot;'&amp;quot;,&amp;quot; END AND MODELLO_KIT =&amp;quot;,&amp;quot;'&amp;quot;,$post.item/tns1:Modello,&amp;quot;'&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT CODICE_KIT, STATO, FAMIGLIA_KIT, MODELLO_KIT, CLLI from   ANAGRAFICA_KIT_VLAN WHERE CODICE_KIT  =&amp;quot;,&amp;quot;'&amp;quot;, $post.item/tns1:Td,&amp;quot;'&amp;quot;,&amp;quot; AND UPPER(STATO) IN (&amp;quot;,&amp;quot;'&amp;quot;,'ACTIVE',&amp;quot;','&amp;quot;, 'TEMPORARY',&amp;quot;','&amp;quot;, 'IN PROGRESS',&amp;quot;'&amp;quot;,&amp;quot;) AND FAMIGLIA_KIT = CASE &amp;quot;,&amp;quot;'&amp;quot;,$post.item/tns1:tipoKit,&amp;quot;'&amp;quot;,&amp;quot; WHEN &amp;quot;,&amp;quot;'&amp;quot;,'KIT VULA',&amp;quot;'&amp;quot;,&amp;quot; THEN &amp;quot;,&amp;quot;'&amp;quot;,'VULA',&amp;quot;'&amp;quot;, &amp;quot; WHEN &amp;quot;,&amp;quot;'&amp;quot;,'KIT MULTISERVIZIO',&amp;quot;'&amp;quot;, &amp;quot; THEN &amp;quot;,&amp;quot;'&amp;quot;,'NGA',&amp;quot;'&amp;quot;,&amp;quot; END&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns4:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
