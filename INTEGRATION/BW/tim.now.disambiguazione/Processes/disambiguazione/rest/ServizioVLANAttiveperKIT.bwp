                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT R.IDRICHIESTAOLO FROM APPUSER.BDS_1_CASEDATA_RICHIESTA R,APPUSER.BDS_1_CASEDATA_ORDINE O,APPUSER.BDS_1_CASEDATA_DETTAGLIOORDINE D,APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN A WHERE  R.IDRICHIESTAOLO = O.IDRICHIESTAOLO AND O.BDS_ID = D.ORDINE_DETTAGLIOORDINE_BDSID AND D.BDS_ID = A.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID AND R.STATORICHIESTANOW NOT IN ('SCARTATO', 'SCARTATOB2B', 'ESPLETAMENTOTECNICOKO','ANNULLATO', 'ANNULLATOB2B', 'CHIUSO', 'CHIUSOB2B','FATTURAZIONEKO', 'ESPLETAMENTOTECNICO','ESPLETAMENTOTECNICOB2B', 'INVIATOAFATTURAZIONE') AND D.NOMECOMPONENTE  = 'RACCOLTAVULA' AND A.NOMEATTRIBUTO  = 'CODICETDKIT' AND A.VALOREATTRIBUTO =?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

