<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/CheckCodiceOrdineOLONOW" xmlns:tns="http://www.example.org/CheckCodiceOrdineOLONOW" elementFormDefault="qualified">

    <element name="CheckCodiceOrdineOLONOWInput">
    	<complexType>
    		<sequence>
    			<element name="idRichiesta" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="codiceOrdineOLO" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="codiceEsito" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="10"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="descrizioneEsito" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="255"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="CheckCodiceOrdineOLONOWOutput">
    	<complexType>
    		<sequence>
    			<element name="codiceEsito" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="10"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="descrizioneEsito" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="255"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>