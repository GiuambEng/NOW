<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/RichiestaListaLavorazioniperOLOeServizio" xmlns:tns="http://www.example.org/RichiestaListaLavorazioniperOLOeServizio" elementFormDefault="qualified">
<element name="RichiestaListaLavorazioniperOLOeServizioOutput">
    	<complexType>
    		<sequence>
    			<element name="IDRichiesta" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CodificaOloAgcom" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Servizio" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ListaCodiciLavorazioni" maxOccurs="unbounded"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CodiceEsito" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="10"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DescrizioneEsito" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="255"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>