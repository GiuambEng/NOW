<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/tim.now.schema.xsd.AnagraficaPToponomastica" xmlns:tns="http://www.tim.com/NOW/xsd/tim.now.schema.xsd.AnagraficaPToponomastica" elementFormDefault="qualified">


    <element name="AnagraficaPToponomastica_Dettaglio">
    	<complexType>
    		<sequence>
    			<element name="ID_PART_TOPON" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="int">
    						<totalDigits value="5"></totalDigits>
    					</restriction>
    				</simpleType>
    			</element>
                <element name="DESC_PART_TOPON" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
            </sequence>
    	</complexType></element>

    <element name="AnagraficaPToponomastica">
    	<complexType>
    		<sequence>
    			<element ref="tns:AnagraficaPToponomastica_Dettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>


</schema>