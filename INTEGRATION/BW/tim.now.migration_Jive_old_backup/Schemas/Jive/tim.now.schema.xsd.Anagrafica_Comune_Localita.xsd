<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/Anagrafica_Comune_Localita" elementFormDefault="qualified"  attributeFormDefault="unqualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/Anagrafica_Comune_Localita">

    <element name="AnagraficaComuneLocalitaDettaglio">
    	<complexType>
    		<sequence>
    			<element name="COD_EGON" maxOccurs="1" minOccurs="1">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="11"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DESC_LOCALITA" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="80"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ISTAT_COMUNE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="int">
    						<totalDigits value="6"></totalDigits>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ISTAT_PROVINCIA" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="int">
    						<totalDigits value="3"></totalDigits>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="COD_DISTRETTO" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="int">
    						<totalDigits value="10"></totalDigits>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="COD_CATASTALE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="4"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="FLAG_COMUNE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="FLAG_LOCALITA" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="FLAG_OPERAZIONE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="I"></enumeration>
    						<enumeration value="U"></enumeration>
    						<enumeration value="Z"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="FLAG_BILINGUE" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType></element>

    <element name="AnagraficaComuneLocalita">
    	<complexType>
    		<sequence>
    			<element ref="tns:AnagraficaComuneLocalitaDettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>