    xmlns:ns0="http://tns.tibco.com/bw/activity/timer/xsd/output"
    xmlns:ns1="www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment"
    xmlns:ns2="http://www.tim.com/NOW/xsd/GenericLogger"
