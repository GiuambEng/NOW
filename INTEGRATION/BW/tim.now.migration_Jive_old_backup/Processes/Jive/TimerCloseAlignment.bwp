                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($CallCloseAlign/ns1:OutputData[ns1:SISTEMA="JIVE"  and ns1:FLUSSO="AnagraficaComune"  and ns1:Result/ns1:Esito='OK' ])]]></bpws:finalCounterValue>
