    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="d44f68da-5a3e-431b-90ee-8ef00c6af8e1">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="FaultToJDBCUpdate1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCUpdate1ToAssign" tibex:linkType="SUCCESS"/>
                            <bpws:link name="AssignToRenameFile" tibex:linkType="SUCCESS"/>
