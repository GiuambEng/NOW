                                    sqlStatement="UPDATE STATO_ALLINEAMENTI&#xa;  SET STATO = 'end_BATCH', LAST_UPD = SYSTIMESTAMP&#xa;  WHERE COD_PROCSO_FILE = ? AND ID_ESEC_PROCSO_FILE = ? AND ID_FILE = ?"
