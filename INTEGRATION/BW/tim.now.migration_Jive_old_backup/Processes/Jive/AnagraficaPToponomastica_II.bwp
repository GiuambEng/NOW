                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns43=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+58195039-0182-42f1-9232-f2580b5da9f2+input&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;Select&quot;/>&lt;xsl:param name=&quot;Details&quot;/>&lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcUpdateActivityInput>&lt;ID_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Select/Record[1]/ID_FILE)&quot;>&lt;xsl:value-of select=&quot;$Select/Record[1]/ID_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_FILE>&lt;SISTEMA>&lt;xsl:value-of select=&quot;&amp;quot;JIVE&amp;quot;&quot;/>&lt;/SISTEMA>&lt;FLUSSO>&lt;xsl:value-of select=&quot;&amp;quot;AnagraficaPToponomastica&amp;quot;&quot;/>&lt;/FLUSSO>&lt;DETAILS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Details/ns43:InputDetails[ns43:NOME='NameFile']/ns43:VALORE)&quot;>&lt;xsl:value-of select=&quot;$Details/ns43:InputDetails[ns43:NOME='NameFile']/ns43:VALORE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DETAILS>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails)&quot;/>&lt;/DESCR_ERRORE>&lt;FLAG_LETTURA>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/FLAG_LETTURA>&lt;STATO>&lt;xsl:value-of select=&quot;&amp;quot;KO_TECNICO&amp;quot;&quot;/>&lt;/STATO>&lt;ID_ESEC_PROCSO_FILE