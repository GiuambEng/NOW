                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/log/InsertInizialeStaging_JivePTop&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.PToponomastica&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns1=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Noval_Detail_Last&quot;/>&#xa;    &lt;xsl:param name=&quot;Noval_Details&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Ins-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:root>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Noval_Detail_Last/Rows/tns1:AnagraficaPToponomastica_Dettaglio_Noval)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$Noval_Details/Rows/tns1:AnagraficaPToponomastica_Dettaglio_Noval&quot;>&#xa;                        &lt;ns:Input>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;ns:ID_PART_TOPON>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ID_PART_TOPON)&quot;/>&#xa;                            &lt;/ns:ID_PART_TOPON>&#xa;                            &lt;ns:DESC_PART_TOPON>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:DESC_PART_TOPON)&quot;/>&#xa;                            &lt;/ns:DESC_PART_TOPON>&#xa;                            &lt;xsl:if test=&quot;$Invoke_ProcessLogger.part1/ns2:Esito/ns2:ID_FILE&quot;>&#xa;                                &lt;ns:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$Invoke_ProcessLogger.part1/ns2:Esito/ns2:ID_FILE&quot;/>&#xa;                                &lt;/ns:ID_FILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;ns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TMSP_INSMTO>&#xa;                            &lt;ns:CONTENUTO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;concat(tns1:ID_PART_TOPON,tns1:DESC_PART_TOPON)&quot;/>&#xa;                            &lt;/ns:CONTENUTO_RECD>&#xa;                        &lt;/ns:Input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$Noval_Detail_Last/Rows/tns1:AnagraficaPToponomastica_Dettaglio_Noval&quot;>&#xa;                        &lt;ns:Input>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;ns:ID_PART_TOPON>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ID_PART_TOPON)&quot;/>&#xa;                            &lt;/ns:ID_PART_TOPON>&#xa;                            &lt;ns:DESC_PART_TOPON>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:DESC_PART_TOPON)&quot;/>&#xa;                            &lt;/ns:DESC_PART_TOPON>&#xa;                            &lt;xsl:if test=&quot;$Invoke_ProcessLogger.part1/ns2:Esito/ns2:ID_FILE&quot;>&#xa;                                &lt;ns:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$Invoke_ProcessLogger.part1/ns2:Esito/ns2:ID_FILE&quot;/>&#xa;                                &lt;/ns:ID_FILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;ns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TMSP_INSMTO>&#xa;                            &lt;ns:CONTENUTO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;concat(tns1:ID_PART_TOPON,tns1:DESC_PART_TOPON)&quot;/>&#xa;                            &lt;/ns:CONTENUTO_RECD>&#xa;                        &lt;/ns:Input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:FileInfo>&#xa;                &lt;ns:NomeFile>&#xa;                    &lt;xsl:value-of select=&quot;$ReadFile/tns:FullName&quot;/>&#xa;                &lt;/ns:NomeFile>&#xa;                &lt;ns:StartRecord>&#xa;                    &lt;xsl:value-of select=&quot;($index - 1) * $Passo + 2&quot;/>&#xa;                &lt;/ns:StartRecord>&#xa;                &lt;ns:Passo>&#xa;                    &lt;xsl:value-of select=&quot;$Passo&quot;/>&#xa;                &lt;/ns:Passo>&#xa;            &lt;/ns:FileInfo>&#xa;        &lt;/ns:root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
