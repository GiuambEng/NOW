            <bpws:invoke inputVariable="Invoke_ProcessLogger-input"
                name="Invoke_ProcessLogger" operation="Insert"
                outputVariable="Invoke_ProcessLogger"
                partnerLink="Logger" portType="ns19:ProcessLog" tibex:xpdlId="590522dd-d3d0-4393-8c25-6e6dc2528b4b">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" version="2.0"&gt;&lt;xsl:param name="Input_ProcessLogger"/&gt;&lt;xsl:template name="Invoke_ProcessLogger-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:TipologiaOperazione"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:ProcFile/ns:ID_PROCSO_FILE"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:ProcFile/ns:ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;/ns:ProcFile&gt;&lt;ns:FileProcessato&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO"&gt;&lt;ns:COD_OLO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO"/&gt;&lt;/ns:COD_OLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM"&gt;&lt;ns:CODFC_OLO_AGCOM&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM"/&gt;&lt;/ns:CODFC_OLO_AGCOM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE"&gt;&lt;ns:DATA_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE"/&gt;&lt;/ns:DATA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:DESCR_STATO_FILE"&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:DESCR_STATO_FILE"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:ESITO"&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:ESITO"/&gt;&lt;/ns:ESITO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:ID_INTRFC"&gt;&lt;ns:ID_INTRFC&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:ID_INTRFC"/&gt;&lt;/ns:ID_INTRFC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE"&gt;&lt;ns:IDTPLG_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE"/&gt;&lt;/ns:IDTPLG_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:NOME_FILE"&gt;&lt;ns:NOME_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:NOME_FILE"/&gt;&lt;/ns:NOME_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"&gt;&lt;ns:TIMSTP_APERTURA_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"/&gt;&lt;/ns:TIMSTP_APERTURA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessato/ns:VERSO_DEL_FILE"&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessato/ns:VERSO_DEL_FILE"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessato&gt;&lt;ns:FileProcessatoInput&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoInput/ns:DATA_ARRIVO"&gt;&lt;ns:DATA_ARRIVO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:DATA_ARRIVO"/&gt;&lt;/ns:DATA_ARRIVO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoInput/ns:DIMENSIONE_FILE"&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:DIMENSIONE_FILE"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO"&gt;&lt;ns:ID_CAUS_SCARTO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO"/&gt;&lt;/ns:ID_CAUS_SCARTO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT"&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_KO"&gt;&lt;ns:QT_RECD_KO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_KO"/&gt;&lt;/ns:QT_RECD_KO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_OK"&gt;&lt;ns:QT_RECD_OK&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_OK"/&gt;&lt;/ns:QT_RECD_OK&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_TOTALI"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_TOTALI"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoInput&gt;&lt;ns:EsecuzioneFile&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneFile/ns:COD_PROCSO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneFile/ns:COD_PROCSO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_PROCSO_FILE"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneFile/ns:STATO_ESEC"&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneFile/ns:STATO_ESEC"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB"&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB"&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:if&gt;&lt;/ns:EsecuzioneFile&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL"&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE"&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO"&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/xsl:if&gt;&lt;/ns:LogFileProcessato&gt;&lt;ns:FileProcessatoOutput&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE"&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ESITO_INVIO"&gt;&lt;ns:ESITO_INVIO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ESITO_INVIO"/&gt;&lt;/ns:ESITO_INVIO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT"&gt;&lt;ns:ID_FILE_PROCSTO_OUTPUT&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT"/&gt;&lt;/ns:ID_FILE_PROCSTO_OUTPUT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE"&gt;&lt;ns:TIMSTP_CREZIONE_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE"/&gt;&lt;/ns:TIMSTP_CREZIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_INVIO"&gt;&lt;ns:TIMSTP_INVIO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_INVIO"/&gt;&lt;/ns:TIMSTP_INVIO&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoOutput&gt;&lt;ns:ContenutoFile&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:ContenutoFile/ns:ID_CONTENUTO_FILE"&gt;&lt;ns:ID_CONTENUTO_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:ContenutoFile/ns:ID_CONTENUTO_FILE"/&gt;&lt;/ns:ID_CONTENUTO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:ContenutoFile/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:ContenutoFile/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:ContenutoFile/ns:FullName"&gt;&lt;ns:FullName&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:ContenutoFile/ns:FullName"/&gt;&lt;/ns:FullName&gt;&lt;/xsl:if&gt;&lt;/ns:ContenutoFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Input_ProcessLogger&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke_ProcessLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:TipologiaOperazione&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:ProcFile/ns:ID_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:ProcFile/ns:ID_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO&quot;>&#xa;                    &lt;ns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO&quot;/>&#xa;                    &lt;/ns:COD_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;ns:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CODFC_OLO_AGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE&quot;>&#xa;                    &lt;ns:DATA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:DATA_FILE&quot;/>&#xa;                    &lt;/ns:DATA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:DESCR_STATO_FILE&quot;>&#xa;                    &lt;ns:DESCR_STATO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:DESCR_STATO_FILE&quot;/>&#xa;                    &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:ESITO&quot;>&#xa;                    &lt;ns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:ESITO&quot;/>&#xa;                    &lt;/ns:ESITO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:ID_INTRFC&quot;>&#xa;                    &lt;ns:ID_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:ID_INTRFC&quot;/>&#xa;                    &lt;/ns:ID_INTRFC>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE&quot;>&#xa;                    &lt;ns:IDTPLG_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:IDTPLG_FILE&quot;/>&#xa;                    &lt;/ns:IDTPLG_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:NOME_FILE&quot;>&#xa;                    &lt;ns:NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:NOME_FILE&quot;/>&#xa;                    &lt;/ns:NOME_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;>&#xa;                    &lt;ns:TIMSTP_APERTURA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;/>&#xa;                    &lt;/ns:TIMSTP_APERTURA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;>&#xa;                    &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;/>&#xa;                    &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:VERSO_DEL_FILE&quot;>&#xa;                    &lt;ns:VERSO_DEL_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:VERSO_DEL_FILE&quot;/>&#xa;                    &lt;/ns:VERSO_DEL_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:FileProcessatoInput>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:DATA_ARRIVO&quot;>&#xa;                    &lt;ns:DATA_ARRIVO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:DATA_ARRIVO&quot;/>&#xa;                    &lt;/ns:DATA_ARRIVO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:DIMENSIONE_FILE&quot;>&#xa;                    &lt;ns:DIMENSIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:DIMENSIONE_FILE&quot;/>&#xa;                    &lt;/ns:DIMENSIONE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO&quot;>&#xa;                    &lt;ns:ID_CAUS_SCARTO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO&quot;/>&#xa;                    &lt;/ns:ID_CAUS_SCARTO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT&quot;>&#xa;                    &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT&quot;/>&#xa;                    &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_KO&quot;>&#xa;                    &lt;ns:QT_RECD_KO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_KO&quot;/>&#xa;                    &lt;/ns:QT_RECD_KO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_OK&quot;>&#xa;                    &lt;ns:QT_RECD_OK>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_OK&quot;/>&#xa;                    &lt;/ns:QT_RECD_OK>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_TOTALI&quot;>&#xa;                    &lt;ns:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessatoInput/ns:QT_RECD_TOTALI&quot;/>&#xa;                    &lt;/ns:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessatoInput>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:COD_PROCSO_FILE&quot;>&#xa;                    &lt;ns:COD_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:COD_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:COD_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:ID_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:STATO_ESEC&quot;>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:EsecuzioneFile/ns:STATO_ESEC&quot;/>&#xa;                    