                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bd64b0a5-5952-4fc5-bbaa-605f907fc39d+input&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Invoke_ProcessLogger&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;FilePoller&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&lt;/DESCR_ERRORE>&lt;DETAILS>&lt;xsl:value-of select=&quot;concat(substring-before($FilePoller/fileInfo/fileName, &amp;quot;.ctr&amp;quot;),&amp;quot;.csv&amp;quot;)&quot;/>&lt;/DETAILS>&lt;FLUSSO>&lt;xsl:value-of select=&quot;&amp;quot;AnagraficaComune&amp;quot;&quot;/>&lt;/FLUSSO>&lt;ID_ESEC_PROCSO>&lt;xsl:value-of select=&quot;xsd:decimal($Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ID_ESEC_PROCSO>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&lt;/ID_FILE>&lt;SISTEMA>&lt;xsl:value-of select=&quot;'JIVE'&quot;/>&lt;/SISTEMA>&lt;STATO>&lt;xsl:value-of select=&quot;'KO TECNICO'&quot;/>&lt;/STATO>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="JDBCUpdate-input"
                                name="JDBCUpdate"
                                outputVariable="JDBCUpdate"
                                tibex:xpdlId="bd64b0a5-5952-4fc5-bbaa-605f907fc39d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
