                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bd64b0a5-5952-4fc5-bbaa-605f907fc39d+input&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;FilePoller&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;DESCR_ERRORE>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&#xa;            &lt;/DESCR_ERRORE>&#xa;            &lt;DETAILS>&#xa;                &lt;xsl:value-of select=&quot;concat(substring-before($FilePoller/fileInfo/fileName, &amp;quot;.ctr&amp;quot;),&amp;quot;.csv&amp;quot;)&quot;/>&#xa;            &lt;/DETAILS>&#xa;            &lt;FLUSSO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;AnagraficaComune&amp;quot;&quot;/>&#xa;            &lt;/FLUSSO>&#xa;            &lt;ID_ESEC_PROCSO>&#xa;                &lt;xsl:value-of select=&quot;xsd:decimal($Invoke_ProcessLogger.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:decimal($Invoke_ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;            &lt;/ID_FILE>&#xa;            &lt;SISTEMA>&#xa;                &lt;xsl:value-of select=&quot;'JIVE'&quot;/>&#xa;            &lt;/SISTEMA>&#xa;            &lt;STATO>&#xa;                &lt;xsl:value-of select=&quot;'KO TECNICO'&quot;/>&#xa;            &lt;/STATO>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
