                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:ns=&quot;http://www.tim.com/log/InsertInizialeStaging_JiveCOM&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.AnagraficaComuneLocalita.Noval&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ReadFile&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;DettaglioLast&quot;/>&lt;xsl:param name=&quot;Dettaglio&quot;/>&lt;xsl:param name=&quot;OK_ELAB_File&quot;/>&lt;xsl:param name=&quot;Invoke_ProcessLogger&quot;/>&lt;xsl:template name=&quot;Ins-input&quot; match=&quot;/&quot;>&lt;ns:root>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DettaglioLast/Rows/tns1:AnagraficaComuneLocalitaNoval_dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$Dettaglio/Rows/tns1:AnagraficaComuneLocalitaNoval_dettaglio&quot;>&lt;ns:Input>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;ns:COD_CATAST_COMUNE>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_CATASTALE)&quot;/>&lt;/ns:COD_CATAST_COMUNE>&lt;ns:COD_COMUNE>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_EGON)&quot;/>&lt;/ns:COD_COMUNE>&lt;ns:COD_DISTR>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_DISTRETTO)&quot;/>&lt;/ns:COD_DISTR>&lt;ns:DESCR_COMUNE>&lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_COMUNE)&quot;/>&lt;/ns:DESCR_COMUNE>&lt;ns:FLAG_BILINGUE>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_BILINGUE)&quot;/>&lt;/ns:FLAG_BILINGUE>&lt;ns:FLAG_COMUNE>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_COMUNE)&quot;/>&lt;/ns:FLAG_COMUNE>&lt;ns:FLAG_LOCALITA>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_LOCALITA)&quo