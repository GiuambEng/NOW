>&#xa;                            &lt;/ns:COD_DISTR>&#xa;                            &lt;ns:DESCR_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:DESC_LOCALITA)&quot;/>&#xa;                            &lt;/ns:DESCR_COMUNE>&#xa;                            &lt;ns:FLAG_BILINGUE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_BILINGUE)&quot;/>&#xa;                            &lt;/ns:FLAG_BILINGUE>&#xa;                            &lt;ns:FLAG_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_COMUNE)&quot;/>&#xa;                            &lt;/ns:FLAG_COMUNE>&#xa;                            &lt;ns:FLAG_LOCALITA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_LOCALITA)&quot;/>&#xa;                            &lt;/ns:FLAG_LOCALITA>&#xa;                            &lt;ns:FLAG_OPERAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPERAZIONE)&quot;/>&#xa;                            &lt;/ns:FLAG_OPERAZIONE>&#xa;                            &lt;xsl:if test=&quot;$Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;>&#xa;                                &lt;ns:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;/>&#xa;                                &lt;/ns:ID_FILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$OK_ELAB_File&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;ns:ISTAT_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_COMUNE)&quot;/>&#xa;                            &lt;/ns:ISTAT_COMUNE>&#xa;                            &lt;ns:ISTAT_PROVINCIA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_PROVINCIA)&quot;/>&#xa;                            &lt;/ns:ISTAT_PROVINCIA>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;ns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TMSP_INSMTO>&#xa;                            &lt;ns:CONTENUTO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;concat(tns1:COD_EGON,tns1:DESC_LOCALITA,tns1:ISTAT_COMUNE,tns1:ISTAT_PROVINCIA,tns1:COD_DISTRETTO,tns1:COD_CATASTALE,tns1:FLAG_COMUNE,tns1:FLAG_LOCALITA,tns1:FLAG_OPERAZIONE,tns1:FLAG_BILINGUE)&quot;/>&#xa;                            &lt;/ns:CONTENUTO_RECD>&#xa;                        &lt;/ns:Input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:FileInfo>&#xa;                &lt;ns:NomeFile>&#xa;                    &lt;xsl:value-of select=&quot;$ReadFile/tns:FullName&quot;/>&#xa;                &lt;/ns:NomeFile>&#xa;                &lt;ns:StartRecord>&#xa;                    &lt;xsl:value-of select=&quot;($index - 1) * $Passo + 2&quot;/>&#xa;                &lt;/ns:StartRecord>&#xa;                &lt;ns:Passo>&#xa;                    &lt;xsl:value-of select=&quot;$Passo&quot;/>&#xa;                &lt;/ns:Passo>&#xa;            &lt;/ns:FileInfo>&#xa;        &lt;/ns:root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
