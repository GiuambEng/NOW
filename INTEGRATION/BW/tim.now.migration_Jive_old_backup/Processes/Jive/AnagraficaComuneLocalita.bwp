                                    sqlStatement="INSERT INTO STATO_ALLINEAMENTI ( DESCR_ERRORE,&#xa;  DETAILS, FLAG_LETTURA, FLUSSO, ID_ESEC_PROCSO_FILE, ID_FILE,&#xa;  SISTEMA, STATO, CREATED)&#xa;  VALUES (?, ?, 'Y', ?, ?,?, ?, ?, SYSDATE)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
