                                    <bpws:transitionCondition><![CDATA[(($index = (($Invoke_Counter.part1/ns20:NumeroRecord) div $Passo +1)) and (count($DettaglioLast/Rows/tns1:AnagraficaComuneLocalitaNoval_dettaglio)=0))]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
