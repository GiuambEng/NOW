                            expression="concat(&quot;SELECT CODICE_SERVIZIO, CODICE_OLO, CREATED, ROW_ID, ID_ASSET_CRMWS, ID_ASSET_NOW, ID_ORDINE, ID_RISORSA, LAVORAZIONE, MESSAGGIO,STATO, TRANSACTION_ID, TRANSACTION_ID_PARENT, TRANSACTION_ID_ROOT,CREATED_BY, LAST_UPD, LAST_UPD_BY, MODIFICATION_NUM, CONFLICT_ID,DB_LAST_UPD, DB_LAST_UPD_SRC FROM OGG_ALMTO_COSTZ_DACRMWS_REQ WHERE STATO =&quot;,&quot;'&quot;,&quot;DA LAVORARE&quot;,&quot;'&quot;,&quot; ORDER BY CREATED ASC FETCH FIRST &quot;, xsd:string($PassoEstrazioneOGG), &quot; ROWS ONLY &quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
