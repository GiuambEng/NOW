                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="ErrorLogToInvoke" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link name="InvokeToExit1" tibex:linkType="SUCCESS"/>
