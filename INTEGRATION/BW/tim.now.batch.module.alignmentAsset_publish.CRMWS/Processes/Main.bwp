                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dinamicprocess.allineamentoOggAsset&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;SQLDirect&quot;/>&#xa;    &lt;xsl:template name=&quot;Ogg-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input_InsertUpdateOGG>&#xa;            &lt;ns:OGG_Request>&#xa;                &lt;ns:Stato>&#xa;                    &lt;xsl:value-of select=&quot;'LAVORATO'&quot;/>&#xa;                &lt;/ns:Stato>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value)&quot;>&#xa;                    &lt;ns:TransactionID>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value&quot;/>&#xa;                    &lt;/ns:TransactionID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:OGG_Request>&#xa;            &lt;ns:OGG_Response>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='CODICE_SERVIZIO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='CODICE_SERVIZIO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='CODICE_SERVIZIO']/value)&quot;>&#xa;                    &lt;ns:COD_SRVZ>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='CODICE_SERVIZIO']/value&quot;/>&#xa;                    &lt;/ns:COD_SRVZ>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='CODICE_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='CODICE_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='CODICE_OLO']/value)&quot;>&#xa;                    &lt;ns:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='CODICE_OLO']/value&quot;/>&#xa;                    &lt;/ns:CODFC_OLO_AGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:CREATED>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:CREATED>&#xa;                &lt;ns:DESC_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;'ERRORE GENERICO'&quot;/>&#xa;                &lt;/ns:DESC_ERRORE>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='ROW_ID']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='ROW_ID']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='ROW_ID']/value)&quot;>&#xa;                    &lt;ns:ROW_ID>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='ROW_ID']/value&quot;/>&#xa;                    &lt;/ns:ROW_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='ID_RISORSA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='ID_RISORSA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='ID_RISORSA']/value)&quot;>&#xa;                    &lt;ns:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='ID_RISORSA']/value&quot;/>&#xa;                    &lt;/ns:ID_RISORSA>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:MESSAGGIO_KO>&#xa;                    &lt;xsl:value-of select=&quot;'ERRORE'&quot;/>&#xa;                &lt;/ns:MESSAGGIO_KO>&#xa;                &lt;ns:RETURN_CODE>&#xa;                    &lt;xsl:value-of select=&quot;'99'&quot;/>&#xa;                &lt;/ns:RETURN_CODE>&#xa;                &lt;ns:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'DA LAVORARE'&quot;/>&#xa;                &lt;/ns:STATO>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value)&quot;>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID_PARENT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID_PARENT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID_PARENT']/value)&quot;>&#xa;                    &lt;ns:TRANSACTION_ID_PARENT>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID_PARENT']/value&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID_PARENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID_ROOT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID_ROOT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID_ROOT']/value)&quot;>&#xa;                    &lt;ns:TRANSACTION_ID_ROOT>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID_ROOT']/value&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID_ROOT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='CREATED_BY']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='CREATED_BY']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='CREATED_BY']/value)&quot;>&#xa;                    &lt;ns:CREATED_BY>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='CREATED_BY']/value&quot;/>&#xa;                    &lt;/ns:CREATED_BY>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='LAST_UPD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='LAST_UPD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='LAST_UPD']/value)&quot;>&#xa;                    &lt;ns:LAST_UPD>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='LAST_UPD']/value&quot;/>&#xa;                    &lt;/ns:LAST_UPD>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='LAST_UPD_BY']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='LAST_UPD_BY']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='LAST_UPD_BY']/value)&quot;>&#xa;                    &lt;ns:LAST_UPD_BY>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='LAST_UPD_BY']/value&quot;/>&#xa;                    &lt;/ns:LAST_UPD_BY>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='MODIFICATION_NUM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='MODIFICATION_NUM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='MODIFICATION_NUM']/value)&quot;>&#xa;                    &lt;ns:MODIFICATION_NUM>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='MODIFICATION_NUM']/value&quot;/>&#xa;                    &lt;/ns:MODIFICATION_NUM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='CONFLICT_ID']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='CONFLICT_ID']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='CONFLICT_ID']/value)&quot;>&#xa;                    &lt;ns:CONFLICT_ID>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='CONFLICT_ID']/value&quot;/>&#xa;                    &lt;/ns:CONFLICT_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='DB_LAST_UPD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='DB_LAST_UPD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='DB_LAST_UPD']/value)&quot;>&#xa;                    &lt;ns:DB_LAST_UPD>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='DB_LAST_UPD']/value&quot;/>&#xa;                    &lt;/ns:DB_LAST_UPD>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='DB_LAST_UPD_SRC']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='DB_LAST_UPD_SRC']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='DB_LAST_UPD_SRC']/value)&quot;>&#xa;                    &lt;ns:DB_LAST_UPD_SRC>&#xa;                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='DB_LAST_UPD_SRC']/value&quot;/>&#xa;                    &lt;/ns:DB_LAST_UPD_SRC>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:OGG_Response>&#xa;        &lt;/ns:Input_InsertUpdateOGG>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasi