                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;
    &lt;xsl:param name="SQLDirect"/&gt;
    &lt;xsl:param name="index1"/&gt;
    &lt;xsl:template name="ProcessLogger-input" match="/"&gt;
        &lt;tns:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns:Input&gt;
                    &lt;ns:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                    &lt;/ns:TipologiaProcesso&gt;
                    &lt;ns:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/ns:TipologiaOperazione&gt;
                    &lt;ns:EsecuzioneNOFileProcessato&gt;
                        &lt;ns:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="13"/&gt;
                        &lt;/ns:ID_PROCSO_NO_FILE&gt;
                        &lt;ns:STATO_ESEC&gt;
                            &lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;
                        &lt;/ns:STATO_ESEC&gt;
                        &lt;ns:TMSP_INIZIO_ELAB&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns:TMSP_INIZIO_ELAB&gt;
                        &lt;xsl:if test="not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value)"&gt;
                            &lt;ns:TRANSACTION_ID&gt;
                                &lt;xsl:value-of select="$SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value"/&gt;
                            &lt;/ns:TRANSACTION_ID&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns:EsecuzioneNOFileProcessato&gt;
                &lt;/ns:Input&gt;
            &lt;/part1&gt;
        &lt;/tns:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:param name=&quot;index1&quot;/>&lt;xsl:template name=&quot;ProcessLogger-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:TipologiaProcesso>&lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&lt;/ns:TipologiaProcesso>&lt;ns:TipologiaOperazione>&lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&lt;/ns:TipologiaOperazione>&lt;ns:EsecuzioneNOFileProcessato>&lt;ns:ID_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;13&quot;/>&lt;/ns:ID_PROCSO_NO_FILE>&lt;ns:STATO_ESEC>&lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&lt;/ns:STATO_ESEC>&lt;ns:TMSP_INIZIO_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INIZIO_ELAB>&lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value)&quot;>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[number($index1)]/column[name='TRANSACTION_ID']/value&quot;/>&lt;/ns:TRANSACTION_ID>&lt;/xsl:if>&lt;/ns:EsecuzioneNOFileProcessato>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart2ToProcessLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ProcessLoggerToSetProcessName"/>
                                    </bpws:sources>
                                    </bpws:invoke>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessLogger&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;SQLDirect&quot;/>&#xa;    &lt;xsl:template name=&quot;LogProcessLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;xsl:variable name=&quot;Record&quot; select=&quot;$SQLDirect/unknownResultset/row[number($index1)]&quot;/>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Main'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'MainAllineamentoOGG_Asset'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'MainAllineamentoOGG_Asset'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;not((string($Record/column[name='TRANSACTION_ID']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Record/column[name='TRANSACTION_ID']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($Record/column[name='TRANSACTION_ID']/value)&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Record/column[name='TRANSACTION_ID']/value&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('PROCESS LOGGER: ', tib:render-xml($ProcessLogger/part1/ns:Output/ns:Esito, true(),true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogProcessLogger-input"
                                    name="LogProcessLogger"
                                    tibex:xpdlId="0f2c22ca-88f1-4f01-ab98-48743995367f"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SetProcessNameToLogProcessLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
