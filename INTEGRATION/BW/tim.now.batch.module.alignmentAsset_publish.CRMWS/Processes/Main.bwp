            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogSTATEMENT-input"
                    name="LogSTATEMENT"
                    tibex:xpdlId="e52873de-ca1d-4334-a007-5bb1b69c2df0"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
