                        <element maxOccurs="1" minOccurs="0"
                            name="ID_FILE" nillable="false" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="CODICE_OLO" nillable="false" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="DATA_INIZIO" nillable="false" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="DATA_FINE" nillable="false" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="DATA_ESPLETAMENTO" nillable="false" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="DESCR_FLUSSO" nillable="false" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="ID_PPS" nillable="false" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="DESCR_PPS" nillable="false" type="string"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
    </tibex:Types>
