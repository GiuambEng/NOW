            name="StartLog-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:root" name="StartEstrazioni-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:root" name="StartEstrazioni" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE" name="EndLog-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE" name="Log-input" sca-bpel:internal="true"/>
