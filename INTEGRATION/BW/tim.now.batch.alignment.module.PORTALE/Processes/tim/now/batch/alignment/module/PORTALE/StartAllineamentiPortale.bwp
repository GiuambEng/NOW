                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="IntervalloMinuti"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value
                                    endTime="2016-11-19T20:54:09.260+0100"
                                    intervalUnit="Minute" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4d116903-5ca3-421c-9dca-5a48bbb02c75+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="GetPortaleFlow-input"
                    name="GetPortaleFlow"
                    outputVariable="GetPortaleFlow"
                    tibex:xpdlId="4d116903-5ca3-421c-9dca-5a48bbb02c75" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToVerificaLavorabilita"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GetPortaleFlowToIterate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($GetPortaleFlow/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($GetPortaleFlow/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="GetPortaleFlowToExit1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4d116903-5ca3-421c-9dca-5a48bbb02c75+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_FLOW, FLOW FROM ALIGN_FILE_TRACKING where &#xd;&#xa;(STATO in ('DA LAVORARE','IN ATTESA') OR FLAG_REWORK='Y')&#xd;&#xa;AND SYSTEM = 'PORTALE' AND ID_FLOW IN (1,2,3,4,5)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_FLOW"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLOW"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="c8958ef2-85c3-404b-9af8-1d543a35b6e4">
                <bpws:targets>
                    <bpws:target linkName="GetPortaleFlowToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToExit1"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$GetPortaleFlow/Record" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($GetPortaleFlow/Record)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns9:Iterate_Current_Element_Record"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link name="InvokeToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="InsertLoggerToInvoke" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="VerificaLavorabilitaToInsertLogger" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="VerificaLavorabilitaToMovedInError" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="MovedInErrorToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="GroupStartToStart" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="StartToVerificaLavorabilita" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="VerificaLavorabilitaToGroupEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="726dbff5-8671-4378-bd4d-98ef4153b9de" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToStart"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($GetPortaleFlow/Record)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="788e08ac-61f1-4247-9f93-3c4c3ca645ec">
                                    <bpws:targets>
                                    <bpws:target linkName="MovedInErrorToGroupEnd"/>
                                    <bpws:target linkName="InvokeToGroupEnd"/>
                                    <bpws:target linkName="VerificaLavorabilitaToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;Start-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.alignment.module.PORTALE.application'&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('***INIZIO VERIFICHE LAVORABILITA PER FLUSSO ',$currentElement/FLOW, ' ID_FLUSSO= ',string($currentElement/ID_FLOW))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Start-input"
                                    name="Start"
                                    tibex:xpdlId="f1e1b761-dc95-457f-9e44-6f03ec7081f9"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToStart"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="StartToVerificaLavorabilita"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;Start-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.alignment.module.PORTALE.application'&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('***INIZIO VERIFICHE LAVORABILITA PER FLUSSO ',$currentElement/FLOW, ' ID_FLUSSO= ',string($currentElement/ID_FLOW))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:invoke
                                    inputVariable="Invoke-input"
                                    name="Invoke"
                                    operation="ContaRecord"
                                    partnerLink="Conta"
                                    portType="ns2:Conta" tibex:xpdlId="29fcfbfc-071b-48df-9185-4565586c3db4">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/" xmlns:ns1="http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.example.org/CreateFileID" xmlns:tns2="http://www.example.org/VerificaLavorabilita" version="2.0"&gt;&lt;xsl:param name="TipoSeparatore"/&gt;&lt;xsl:param name="InsertLogger"/&gt;&lt;xsl:param name="VerificaLavorabilita"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;ns:Conta_Request&gt;&lt;part1&gt;&lt;ns1:contaRecord_Input&gt;&lt;ns1:in&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns2:SOURCE_FILE"/&gt;&lt;/ns1:in&gt;&lt;ns1:TipoSeparatore&gt;&lt;xsl:value-of select="$TipoSeparatore"/&gt;&lt;/ns1:TipoSeparatore&gt;&lt;xsl:if test="$InsertLogger/tns1:ID_FILE"&gt;&lt;ns1:ID_FILE&gt;&lt;xsl:value-of select="$InsertLogger/tns1:ID_FILE"/&gt;&lt;/ns1:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns2:SOURCE_FILE"&gt;&lt;ns1:FULLNAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns2:SOURCE_FILE"/&gt;&lt;/ns1:FULLNAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns2:NOME_FILE"&gt;&lt;ns1:FILENAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns2:NOME_FILE"/&gt;&lt;/ns1:FILENAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InsertLogger/tns1:ID_ESEC"&gt;&lt;ns1:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertLogger/tns1:ID_ESEC"/&gt;&lt;/ns1:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InsertLogger/tns1:COD_PROCSO_FILE"&gt;&lt;ns1:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertLogger/tns1:COD_PROCSO_FILE"/&gt;&lt;/ns1:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns2:ID_TRACK"&gt;&lt;ns1:ID_TRACK&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns2:ID_TRACK"/&gt;&lt;/ns1:ID_TRACK&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains($VerificaLavorabilita/tns2:NOME_FILE, 'NOW_UTENTI_OLO_')"&gt;&lt;ns1:NomeProcesso&gt;&lt;xsl:value-of select="'AllineamentoUtentiOLO.PORTALE'"/&gt;&lt;/ns1:NomeProcesso&gt;&lt;/xsl:when&gt;&lt;xsl:when test="contains($VerificaLavorabilita/tns2:NOME_FILE, 'NOW_UTENTI_TI_')"&gt;&lt;ns1:NomeProcesso&gt;&lt;xsl:value-of select="'AllineamentoUtentiTI.PORTALE'"/&gt;&lt;/ns1:NomeProcesso&gt;&lt;/xsl:when&gt;&lt;xsl:when test="contains($VerificaLavorabilita/tns2:NOME_FILE, 'NOW_PORTAFOGLIO_AM_')"&gt;&lt;ns1:NomeProcesso&gt;&lt;xsl:value-of select="'AllineamentoPortafoglioAM.PORTALE'"/&gt;&lt;/ns1:NomeProcesso&gt;&lt;/xsl:when&gt;&lt;xsl:when test="contains($VerificaLavorabilita/tns2:NOME_FILE, 'ACRONIMIMAPPING_')"&gt;&lt;ns1:NomeProcesso&gt;&lt;xsl:value-of select="'AllineamentoAcronimiMapping.PORTALE'"/&gt;&lt;/ns1:NomeProcesso&gt;&lt;/xsl:when&gt;&lt;xsl:when test="contains($VerificaLavorabilita/tns2:NOME_FILE, 'NOW_CODICE_PROGETTO_')"&gt;&lt;ns1:NomeProcesso&gt;&lt;xsl:value-of select="'AllineamentoCodiciProgetto.PORTALE'"/&gt;&lt;/ns1:NomeProcesso&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns1:NomeProcesso&gt;&lt;xsl:value-of select="'NESSUNPROCESSO'"/&gt;&lt;/ns1:NomeProcesso&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns1:contaRecord_Input&gt;&lt;/part1&gt;&lt;/ns:Conta_Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/CreateFileID&quot; xmlns:tns2=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TipoSeparatore&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertLogger&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:contaRecord_Input>&#xa;            &lt;ns1:in>&#xa;                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns2:SOURCE_FILE&quot;/>&#xa;            &lt;/ns1:in>&#xa;            &lt;ns1:TipoSeparatore>&#xa;                &lt;xsl:value-of select=&quot;$TipoSeparatore&quot;/>&#xa;            &lt;/ns1:TipoSeparatore>&#xa;            &lt;xsl:if test=&quot;$InsertLogger/tns1:ID_FILE&quot;>&#xa;                &lt;ns1:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertLogger/tns1:ID_FILE&quot;/>&#xa;                &lt;/ns1:ID_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns2:SOURCE_FILE&quot;>&#xa;                &lt;ns1:FULLNAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns2:SOURCE_FILE&quot;/>&#xa;                &lt;/ns1:FULLNAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns2:NOME_FILE&quot;>&#xa;                &lt;ns1:FILENAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns2:NOME_FILE&quot;/>&#xa;                &lt;/ns1:FILENAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertLogger/tns1:ID_ESEC&quot;>&#xa;                &lt;ns1:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertLogger/tns1:ID_ESEC&quot;/>&#xa;                &lt;/ns1:ID_ESEC_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertLogger/tns1:COD_PROCSO_FILE&quot;>&#xa;                &lt;ns1:COD_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertLogger/tns1:COD_PROCSO_FILE&quot;/>&#xa;                &lt;/ns1:COD_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns2:ID_TRACK&quot;>&#xa;                &lt;ns1:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns2:ID_TRACK&quot;/>&#xa;                &lt;/ns1:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($VerificaLavorabilita/tns2:NOME_FILE, 'NOW_UTENTI_OLO_')&quot;>&#xa;                    &lt;ns1:NomeProcesso>&#xa;                        &lt;xsl:value-of select=&quot;'AllineamentoUtentiOLO.PORTALE'&quot;/>&#xa;                    &lt;/ns1:NomeProcesso>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($VerificaLavorabilita/tns2:NOME_FILE, 'NOW_UTENTI_TI_')&quot;>&#xa;                    &lt;ns1:NomeProcesso>&#xa;                        &lt;xsl:value-of select=&quot;'AllineamentoUtentiTI.PORTALE'&quot;/>&#xa;                    &lt;/ns1:NomeProcesso>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($VerificaLavorabilita/tns2:NOME_FILE, 'NOW_PORTAFOGLIO_AM_')&quot;>&#xa;                    &lt;ns1:NomeProcesso>&#xa;                        &lt;xsl:value-of select=&quot;'AllineamentoPortafoglioAM.PORTALE'&quot;/>&#xa;                    &lt;/ns1:NomeProcesso>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($VerificaLavorabilita/tns2:NOME_FILE, 'ACRONIMIMAPPING_')&quot;>&#xa;                    &lt;ns1:NomeProcesso>&#xa;                        &lt;xsl:value-of select=&quot;'AllineamentoAcronimiMapping.PORTALE'&quot;/>&#xa;                    &lt;/ns1:NomeProcesso>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($VerificaLavorabilita/tns2:NOME_FILE, 'NOW_CODICE_PROGETTO_')&quot;>&#xa;                    &lt;ns1:NomeProcesso>&#xa;                        &lt;xsl:value-of select=&quot;'AllineamentoCodiciProgetto.PORTALE'&quot;/>&#xa;                    &lt;/ns1:NomeProcesso>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns1:NomeProcesso>&#xa;                        &lt;xsl:value-of select=&quot;'NESSUNPROCESSO'&quot;/>&#xa;                    &lt;/ns1:NomeProcesso>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns1:contaRecord_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="InsertLoggerToInvoke"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InvokeToGroupEnd"/>
                                    </bpws:sources>
                                </bpws:invoke>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
