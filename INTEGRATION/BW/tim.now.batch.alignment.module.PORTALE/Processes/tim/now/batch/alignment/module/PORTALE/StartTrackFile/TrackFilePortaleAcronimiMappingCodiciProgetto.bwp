        <bpws:variable element="ns3:Output" name="CheckFileName" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToListFiles" tibex:linkType="SUCCESS"/>
                <bpws:link name="ForEachToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="TimerToListFiles1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Iterate1ToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesAcronimiMappingToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="ListFilesCodicProgettoToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToIterate" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesAcronimiMappingToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToIterate1" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="Timer"
                    tibex:xpdlId="b42f8cbd-458f-4e71-b740-65ed86853ac2"
                    variable="Timer" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerToListFiles"/>
                        <bpws:source linkName="TimerToListFiles1"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="TimeStartTrackingFiles"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="IntervalStartTrackingFiles"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value
                                    endTime="2016-12-14T12:33:43.502+0100"
                                    intervalUnit="Minute" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ListFilesCodicProgetto-input"
                    name="ListFilesCodicProgetto"
                    outputVariable="ListFilesCodicProgetto"
                    tibex:xpdlId="48287b49-5759-4b09-a4ac-2fe80d3e0a7b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToListFiles"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListFilesToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ListFilesCodicProgettoToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($ListFilesCodicProgetto/files/fileInfo) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($ListFilesCodicProgetto/files/fileInfo) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;filepathCodiciProgetto&quot;/>&#xa;    &lt;xsl:template name=&quot;ListFiles-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ListFilesActivityConfig>&#xa;            &lt;fileName>&#xa;                &lt;xsl:value-of select=&quot;$filepathCodiciProgetto&quot;/>&#xa;            &lt;/fileName>&#xa;        &lt;/tns:ListFilesActivityConfig>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.list"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//ListFiles"/>
                                    <value mode="files-and-directories" xsi:type="file:ListFiles"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="b2b01661-1884-40d2-9f01-341cea43d904">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ForEachToExit"/>
                </bpws:sources>
                <bpws:forEach counterName="index" name="iterate"
                    parallel="no" tibex:group="iterate">
                    <tibex:DesignExpression name="variableList">
                        <tibex:expression
                            expression="$ListFilesCodicProgetto/files/fileInfo" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ListFilesCodicProgetto/files/fileInfo)]]></bpws:finalCounterValue>
                    <bpws:scope name="innerScope">
                        <bpws:variables>
                            <bpws:variable
                                element="ns0:Iterate_Current_Element_fileInfo"
                                name="currentFileCodiciProgetto" sca-bpel:internal="true"/>
                        </bpws:variables>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="StartTrackToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToStartTrack" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:assign name="GroupStart"
                                tibex:group="groupStart"
                                tibex:xpdlId="82b50d82-53ee-4656-b0ab-8afe99c10ac0" validate="no">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToCallProcess"/>
                                </bpws:sources>
                                <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($ListFilesCodicProgetto/files/fileInfo)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentFileCodiciProgetto"/>
                                </bpws:copy>
                            </bpws:assign>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="eb2b1ca4-c9f8-4b3a-8e2f-8ab090c48a82">
                                <bpws:targets>
                                    <bpws:target linkName="StartTrackToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="StartTrack-input"
                                    name="StartTrack"
                                    tibex:xpdlId="9d678064-1a62-4751-81c2-14380c5eb5e0"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToStartTrack"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="StartTrackToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:tns1=&quot;http://www.example.org/CheckFileNamePortale&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;PathMovedFileTappo&quot;/>&lt;xsl:param name=&quot;currentFileCodiciProgetto&quot;/>&lt;xsl:param name=&quot;PathError&quot;/>&lt;xsl:param name=&quot;CheckFileName&quot;/>&lt;xsl:template name=&quot;StartTrack-input&quot; match=&quot;/&quot;>&lt;tns:InputFileTappo>&lt;tns:FileName>&lt;xsl:value-of select=&quot;$currentFileCodiciProgetto/fullName&quot;/>&lt;/tns:FileName>&lt;tns:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LogName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:ApplicationName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:ApplicationName>&lt;tns:Estensione>&lt;xsl:value-of select=&quot;'.csv'&quot;/>&lt;/tns:Estensione>&lt;tns:Sistema>&lt;xsl:value-of select=&quot;'PORTALE'&quot;/>&lt;/tns:Sistema>&lt;tns:Flusso>&lt;xsl:value-of select=&quot;$CheckFileName/tns1:FLUSSO&quot;/>&lt;/tns:Flusso>&lt;tns:PathError>&lt;xsl:value-of select=&quot;$PathError&quot;/>&lt;/tns:PathError>&lt;tns:PathMovedTappo>&lt;xsl:value-of select=&quot;$PathMovedFileTappo&quot;/>&lt;/tns:PathMovedTappo>&lt;tns:Flag_parent>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Flag_parent>&lt;/tns:InputFileTappo>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneLetturaTracciamento" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CheckFileName-input"
                                    name="CheckFileName"
                                    outputVariable="CheckFileName"
                                    tibex:xpdlId="98f4af54-a29b-4956-a368-29fcc3a75d49"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToStartTrack"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CheckFileNamePortale&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentFileCodiciProgetto&quot;/>&lt;xsl:template name=&quot;CheckFileName-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:FILE_NAME>&lt;xsl:value-of select=&quot;$currentFileCodiciProgetto/fileName&quot;/>&lt;/tns:FILE_NAME>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.batch.alignment.module.PORTALE.StartTrackFile.ControlloNomeFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:forEach>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="a3bc61c5-1206-45a1-8485-a03063076fda">
                <bpws:targets>
                    <bpws:target linkName="ForEachToExit"/>
                    <bpws:target linkName="ListFilesToExit"/>
                    <bpws:target linkName="Iterate1ToExit"/>
                    <bpws:target linkName="ListFilesAcronimiMappingToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ListFilesAcronimiMapping-input"
                    name="ListFilesAcronimiMapping"
                    outputVariable="ListFilesAcronimiMapping"
                    tibex:xpdlId="66f048bd-aef2-4694-a0f6-0c349b8157d4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToListFiles1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListFilesAcronimiMappingToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ListFilesAcronimiMappingToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($ListFilesAcronimiMapping/files/fileInfo) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($ListFilesAcronimiMapping/files/fileInfo) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;filepathAcronimiMapping&quot;/>&lt;xsl:template name=&quot;ListFilesAcronimiMapping-input&quot; match=&quot;/&quot;>&lt;tns:ListFilesActivityConfig>&lt;fileName>&lt;xsl:value-of select=&quot;$filepathAcronimiMapping&quot;/>&lt;/fileName>&lt;/tns:ListFilesActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.list"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//ListFiles"/>
                                    <value mode="files-and-directories" xsi:type="file:ListFiles"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate1" tibex:group="iterate" tibex:xpdlId="7edd847d-c556-4cd4-817f-f2f6b70f9fce">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToIterate1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Iterate1ToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate1"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$ListFilesAcronimiMapping/files/fileInfo" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ListFilesAcronimiMapping/files/fileInfo)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope1">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns0:Iterate1_Current_Element_fileInfo"
                                    name="currentFileAcronimiMapping" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow2">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStart1ToCallProcess1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToGroupEnd1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToStarTrackAcronimiMapping" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart1"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="94b9548d-788b-4252-94b1-f0b96fb3cb43" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToCallProcess1"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($ListFilesAcronimiMapping/files/fileInfo)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentFileAcronimiMapping"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd1"
                                    tibex:group="groupEnd" tibex:xpdlId="42591bc7-8ea2-4e83-8d4b-052d5f0505bc">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd1"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="StarTrackAcronimiMapping-input"
                                    name="StarTrackAcronimiMapping"
                                    tibex:xpdlId="a95ff452-aaf8-43ad-8f11-a11b552ed012"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToStarTrackAcronimiMapping"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:tns1=&quot;http://www.example.org/CheckFileNamePortale&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;PathMovedFileTappo&quot;/>&lt;xsl:param name=&quot;currentFileAcronimiMapping&quot;/>&lt;xsl:param name=&quot;PathError&quot;/>&lt;xsl:param name=&quot;ControlloNomeFile&quot;/>&lt;xsl:template name=&quot;StarTrackAcronimiMapping-input&quot; match=&quot;/&quot;>&lt;tns:InputFileTappo>&lt;tns:FileName>&lt;xsl:value-of select=&quot;$currentFileAcronimiMapping/fullName&quot;/>&lt;/tns:FileName>&lt;tns:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LogName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:ApplicationName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:ApplicationName>&lt;tns:Estensione>&lt;xsl:value-of select=&quot;'.csv'&quot;/>&lt;/tns:Estensione>&lt;tns:Sistema>&lt;xsl:value-of select=&quot;'PORTALE'&quot;/>&lt;/tns:Sistema>&lt;tns:Flusso>&lt;xsl:value-of select=&quot;$ControlloNomeFile/tns1:FLUSSO&quot;/>&lt;/tns:Flusso>&lt;tns:PathError>&lt;xsl:value-of select=&quot;$PathError&quot;/>&lt;/tns:PathError>&lt;tns:PathMovedTappo>&lt;xsl:value-of select=&quot;$PathMovedFileTappo&quot;/>&lt;/tns:PathMovedTappo>&lt;tns:Flag_parent>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Flag_parent>&lt;/tns:InputFileTappo>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneLetturaTracciamento" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="ControlloNomeFile-input"
                                    name="ControlloNomeFile"
                                    outputVariable="ControlloNomeFile"
                                    tibex:xpdlId="88bffb50-ac44-48ec-a437-c9353ef64dce"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToCallProcess1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToStarTrackAcronimiMapping"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CheckFileNamePortale&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentFileAcronimiMapping&quot;/>&lt;xsl:template name=&quot;ControlloNomeFile-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:FILE_NAME>&lt;xsl:value-of select=&quot;$currentFileAcronimiMapping/fileName&quot;/>&lt;/tns:FILE_NAME>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.batch.alignment.module.PORTALE.StartTrackFile.ControlloNomeFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogListFileCodiciProgetto-input"
                    name="LogListFileCodiciProgetto"
                    tibex:xpdlId="37293d68-94b8-4e70-be82-ef85c849cde3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ListFilesCodicProgettoToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToIterate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;ListFilesCodicProgetto&quot;/>&lt;xsl:template name=&quot;LogListFileCodiciProgetto-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'TrackFilePortaleAcronimiMappingCodiciProgetto'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Start Allineamento Codici Progetto',tib:render-xml($ListFilesCodicProgetto,true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogListFileAcronimiMapping-input"
                    name="LogListFileAcronimiMapping"
                    tibex:xpdlId="6cff3b82-5673-4901-94db-63852445b7cf"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ListFilesAcronimiMappingToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToIterate1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;ListFilesAcronimiMapping&quot;/>&lt;xsl:template name=&quot;LogListFileAcronimiMapping-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'TrackFilePortaleAcronimiMappingCodiciProgetto'&quot;/>&lt;/tns:Process>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;concat('Start Portale allineamento AcronimiMapping', tib:render-xml($ListFilesAcronimiMapping, true(), true()))&quot;/>&lt;/tns:MsgCode>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
