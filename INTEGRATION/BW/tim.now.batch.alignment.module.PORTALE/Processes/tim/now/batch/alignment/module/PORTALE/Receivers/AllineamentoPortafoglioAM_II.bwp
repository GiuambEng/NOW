                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.ContenutoRecordUtentiAM&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoPortafoglioAccount_Tracciato&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;Passo_PORTALE_UtentiAM&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;ContenutoRecord-input&quot; match=&quot;/&quot;>&lt;ns:InputRecordContenutoRecordUtentiAM>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns:MigrazionePortafoglioAccountDettaglio_Noval)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns:MigrazionePortafoglioAccountDettaglio_Noval&quot;>&lt;ns:ContenutoRecordUtentiAM_Input>&lt;xsl:if test=&quot;tns:Tipo_record&quot;>&lt;ns:TipoRecord>&lt;xsl:value-of select=&quot;tns:Tipo_record&quot;/>&lt;/ns:TipoRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AM_USER_ALIAS&quot;>&lt;ns:AM_USER_ALIAS>&lt;xsl:value-of select=&quot;tns:AM_USER_ALIAS&quot;/>&lt;/ns:AM_USER_ALIAS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AM_NOME&quot;>&lt;ns:AM_NOME>&lt;xsl:value-of select=&quot;tns:AM_NOME&quot;/>&lt;/ns:AM_NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AM_COGNOME&quot;>&lt;ns:AM_COGNOME>&lt;xsl:value-of select=&quot;tns:AM_COGNOME&quot;/>&lt;/ns:AM_COGNOME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AM_USER_ID_UNICO&quot;>&lt;ns:AM_USER_ID_UNICO>&lt;xsl:value-of select=&quot;tns:AM_USER_ID_UNICO&quot;/>&lt;/ns:AM_USER_ID_UNICO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COMPANY_NAME&quot;>&lt;ns:AM_COMPANY_NAME>&lt;xsl:value-of select=&quot;tns:COMPANY_NAME&quot;/>&lt;/ns:AM_COMPANY_NAME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COMPANY_CODE&quot;>&lt;ns:AM_COMPANY_CODE>&lt;xsl:value-of select=&quot;tns:COMPANY_CODE&quot;/>&lt;/ns:AM_COMPANY_CODE>&lt;/xsl:if>&lt;ns:NumeroRecord>&lt;xsl:value-of select=&quot;(($Passo_PORTALE_UtentiAM * ($index -1)) + position())&quot;/>&lt;/ns:NumeroRecord>&lt;/ns:ContenutoRecordUtentiAM_Input>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns:MigrazionePortafoglioAccountDettaglio_Noval&quot;>&lt;ns:ContenutoRecordUtentiAM_Input>&lt;xsl:if test=&quot;tns:Tipo_record&quot;>&lt;ns:TipoRecord>&lt;xsl:value-of select=&quot;tns:Tipo_record&quot;/>&lt;/ns:TipoRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AM_USER_ALIAS&quot;>&lt;ns:AM_USER_ALIAS>&lt;xsl:value-of select=&quot;tns:AM_USER_ALIAS&quot;/>&lt;/ns:AM_USER_ALIAS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AM_NOME&quot;>&lt;ns:AM_NOME>&lt;xsl:value-of select=&quot;tns:AM_NOME&quot;/>&lt;/ns:AM_NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AM_COGNOME&quot;>&lt;ns:AM_COGNOME>&lt;xsl:value-of select=&quot;tns:AM_COGNOME&quot;/>&lt;/ns:AM_COGNOME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AM_USER_ID_UNICO&quot;>&lt;ns:AM_USER_ID_UNICO>&lt;xsl:value-of select=&quot;tns:AM_USER_ID_UNICO&quot;/>&lt;/ns:AM_USER_ID_UNICO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COMPANY_NAME&quot;>&lt;ns:AM_COMPANY_NAME>&lt;xsl:value-of select=&quot;tns:COMPANY_NAME&quot;/>&lt;/ns:AM_COMPANY_NAME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COMPANY_CODE&quot;>&lt;ns:AM_COMPANY_CODE>&lt;xsl:value-of select=&quot;tns:COMPANY_CODE&quot;/>&lt;/ns:AM_COMPANY_CODE>&lt;/xsl:if>&lt;ns:NumeroRecord>&lt;xsl:value-of select=&quot;(($Passo_PORTALE_UtentiAM * ($index -1)) + position())&quot;/>&lt;/ns:NumeroRecord>&lt;/ns:ContenutoRecordUtentiAM_Input>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:InputRecordContenutoRecordUtentiAM>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
