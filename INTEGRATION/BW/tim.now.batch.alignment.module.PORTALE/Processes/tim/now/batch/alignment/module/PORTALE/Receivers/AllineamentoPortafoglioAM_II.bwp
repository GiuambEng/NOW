                                    <tibex:expression
                                    expression="(($index = (($JMSReceiveMessage/Body/ns8:queueResponse/ns8:NumeroRecord)) div $Passo_PORTALE_UtentiAM +1)) and (count($DetailUltimi_NoVal/Rows/tns:MigrazionePortafoglioAccountDettaglio_Noval)=0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
