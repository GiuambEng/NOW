                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6fa03a31-a07c-4aad-9729-de709b762550+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoCodiciProgetto_Staging&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InputStaging&quot;/>&lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$InputStaging/tns1:AllinemanetoCodiciProgetto_dettaglio&quot;>&lt;Record>&lt;CODE_OPERATORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:CODE_OPERATORE)&quot;>&lt;xsl:value-of select=&quot;tns1:CODE_OPERATORE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODE_OPERATORE>&lt;CODPRGT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:CODPRGT)&quot;>&lt;xsl:value-of select=&quot;tns1:CODPRGT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODPRGT>&lt;DATAFI_PROV>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:DATFI_PROV)&quot;>&lt;xsl:value-of select=&quot;tns1:DATFI_PROV&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATAFI_PROV>&lt;DATAINZ_PROV>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:DATAINZ_PROV)&quot;>&lt;xsl:value-of select=&quot;tns1:DATAINZ_PROV&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATAINZ_PROV>&lt;FITTIZIO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:FITTIZIO)&quot;>&lt;xsl:value-of select=&quot;tns1:FITTIZIO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/FITTIZIO>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal(tns1:ID_FILE_PROCSTO_INPUT)&quot;/>&lt;/ID_FILE_PROCSTO_INPUT>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:decimal(tns1:ID_STATO_ELAB_STAG)&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:decimal(tns1:NUMERO_RECD)&quot;/>&lt;/NUMERO_RECD>&lt;REPORT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:REPORT)&quot;>&lt;xsl:value-of select=&quot;tns1:REPORT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/REPORT>&lt;TMSP_INSMTO>&lt;xsl:value-of select=&quot;xsd:dateTime(tns1:TMSP_INSMTO)&quot;/>&lt;/TMSP_INSMTO>&lt;CONTENUTO_RECD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:CONTENUTO_RECD)&quot;>&lt;xsl:value-of select=&quot;tns1:CONTENUTO_RECD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONTENUTO_RECD>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
