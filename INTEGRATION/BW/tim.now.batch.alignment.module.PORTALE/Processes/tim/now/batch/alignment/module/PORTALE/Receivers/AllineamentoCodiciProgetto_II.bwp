                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoCodiciProgetto_Staging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoCodiciProgetto_Tracciato&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:ns2=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;current-dateTime&quot;/>&lt;xsl:param name=&quot;OK_ELAB_RECORD_FILE&quot;/>&lt;xsl:param name=&quot;Passo_PORTALE_CodiciProgetto&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ContenutoRecord&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;InputStaging&quot; match=&quot;/&quot;>&lt;tns:AllinemanetoCodiciProgetto>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:Dettaglio_Noval)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:Dettaglio_Noval&quot;>&lt;tns:AllinemanetoCodiciProgetto_dettaglio>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_PORTALE_CodiciProgetto * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:CODICE_OPERATORE&quot;>&lt;tns:CODE_OPERATORE>&lt;xsl:value-of select=&quot;tns1:CODICE_OPERATORE&quot;/>&lt;/tns:CODE_OPERATORE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CODICE_PROGETTO&quot;>&lt;tns:CODPRGT>&lt;xsl:value-of select=&quot;tns1:CODICE_PROGETTO&quot;/>&lt;/tns:CODPRGT>&lt;/xsl:if>&lt;xsl:if test=&quot;$ContenutoRecord/ns:Output_ContenutoRecord[ns:Posizione=$var]/ns:Valore&quot;>&lt;tns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$ContenutoRecord/ns:Output_ContenutoRecord[ns:Posizione=$var]/ns:Valore&quot;/>&lt;/tns:CONTENUTO_RECD>&lt;/xs