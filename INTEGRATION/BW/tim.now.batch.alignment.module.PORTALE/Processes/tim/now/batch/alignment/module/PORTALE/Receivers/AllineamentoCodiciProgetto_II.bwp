                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess5-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Update>&#xa;                &lt;tns:FLAG_LAVORAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:FLAG_LAVORAZIONE>&#xa;                &lt;tns:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/tns:STATO>&#xa;                &lt;tns:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&#xa;                &lt;/tns:DESCR_ERRORE>&#xa;                &lt;tns:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_TRACK)&quot;/>&#xa;                &lt;/tns:ID_TRACK>&#xa;                &lt;tns:LogElement>&#xa;                    &lt;tns:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                    &lt;/tns:LoggerName>&#xa;                    &lt;tns:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                    &lt;/tns:LogLevel>&#xa;                &lt;/tns:LogElement>&#xa;            &lt;/tns:Update>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
