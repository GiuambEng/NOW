                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="ContenutoRecord-input"
                                    name="ContenutoRecord"
                                    outputVariable="ContenutoRecord"
                                    tibex:xpdlId="0922d542-68e0-4dab-941b-23bd3e09e149"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty1ToContenutoRecord"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToDateTime"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.migration.ContenutoRecordUtentiOLO&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoUtentiOLO_Tracciato&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;Passo_PORTALE_UtentiOLO&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;ContenutoRecord-input&quot; match=&quot;/&quot;>&lt;ns:InputRecordContenutoRecordUtentiOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns:MigrazioneUtentiOLO_dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns:MigrazioneUtentiOLO_dettaglio&quot;>&lt;ns:ContenutoRecordUtentiOLO_Input>&lt;xsl:if test=&quot;tns:Tipo_record&quot;>&lt;ns:TipoRecord>&lt;xsl:value-of select=&quot;tns:Tipo_record&quot;/>&lt;/ns:TipoRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:USER_ID_UNICO&quot;>&lt;ns:USER_ID_UNICO>&lt;xsl:value-of select=&quot;tns:USER_ID_UNICO&quot;/>&lt;/ns:USER_ID_UNICO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:NOME&quot;>&lt;ns:NOME>&lt;xsl:value-of select=&quot;tns:NOME&quot;/>&lt;/ns:NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COGNOME&quot;>&lt;ns:COGNOME>&lt;xsl:value-of select=&quot;tns:COGNOME&quot;/>&lt;/ns:COGNOME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:USER_ALIAS&quot;>&lt;ns:USER_ALIAS>&lt;xsl:value-of select=&quot;tns:USER_ALIAS&quot;/>&lt;/ns:USER_ALIAS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:MATRICOLA&quot;>&lt;ns:MATRICOLA>&lt;xsl:value-of select=&quot;tns:MATRICOLA&quot;/>&lt;/ns:MATRICOLA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DISABILITATO&quot;>&lt;ns:DISABILITATO>&lt;xsl:value-of select=&quot;tns:DISABILITATO&quot;/>&lt;/ns:DISABILITATO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:PROFILO152&quot;>&lt;ns:PROFILO152>&lt;xsl:value-of select=&quot;tns:PROFILO152&quot;/>&lt;/ns:PROFILO152>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COMPANY_CODE&quot;>&lt;ns:COMPANY_CODE>&lt;xsl:value-of select=&quot;tns:COMPANY_CODE&quot;/>&lt;/ns:COMPANY_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:PROFILO_UTENTI_TI&quot;>&lt;ns:PROFILO_UTENTI_TI>&lt;xsl:value-of select=&quot;tns:PROFILO_UTENTI_TI&quot;/>&lt;/ns:PROFILO_UTENTI_TI>&lt;/xsl:if>&lt;ns:NumeroRecord>&lt;xsl:value-of select=&quot;(($Passo_PORTALE_UtentiOLO * ($index -1)) + position())&quot;/>&lt;/ns:NumeroRecord>&lt;/ns:ContenutoRecordUtentiOLO_Input>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns:MigrazioneUtentiOLO_dettaglio&quot;>&lt;ns:ContenutoRecordUtentiOLO_Input>&lt;xsl:if test=&quot;tns:Tipo_record&quot;>&lt;ns:TipoRecord>&lt;xsl:value-of select=&quot;tns:Tipo_record&quot;/>&lt;/ns:TipoRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:USER_ID_UNICO&quot;>&lt;ns:USER_ID_UNICO>&lt;xsl:value-of select=&quot;tns:USER_ID_UNICO&quot;/>&lt;/ns:USER_ID_UNICO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:NOME&quot;>&lt;ns:NOME>&lt;xsl:value-of select=&quot;tns:NOME&quot;/>&lt;/ns:NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COGNOME&quot;>&lt;ns:COGNOME>&lt;xsl:value-of select=&quot;tns:COGNOME&quot;/>&lt;/ns:COGNOME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:USER_ALIAS&quot;>&lt;ns:USER_ALIAS>&lt;xsl:value-of select=&quot;tns:USER_ALIAS&quot;/>&lt;/ns:USER_ALIAS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:MATRICOLA&quot;>&lt;ns:MATRICOLA>&lt;xsl:value-of select=&quot;tns:MATRICOLA&quot;/>&lt;/ns:MATRICOLA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DISABILITATO&quot;>&lt;ns:DISABILITATO>&lt;xsl:value-of select=&quot;tns:DISABILITATO&quot;/>&lt;/ns:DISABILITATO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:PROFILO152&quot;>&lt;ns:PROFILO152>&lt;xsl:value-of select=&quot;tns:PROFILO152&quot;/>&lt;/ns:PROFILO152>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COMPANY_CODE&quot;>&lt;ns:COMPANY_CODE>&lt;xsl:value-of select=&quot;tns:COMPANY_CODE&quot;/>&lt;/ns:COMPANY_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:PROFILO_UTENTI_TI&quot;>&lt;ns:PROFILO_UTENTI_TI>&lt;xsl:value-of select=&quot;tns:PROFILO_UTENTI_TI&quot;/>&lt;/ns:PROFILO_UTENTI_TI>&lt;/xsl:if>&lt;ns:NumeroRecord>&lt;xsl:value-of select=&quot;(($Passo_PORTALE_UtentiOLO * ($index -1)) + position())&quot;/>&lt;/ns:NumeroRecord>&lt;/ns:ContenutoRecordUtentiOLO_Input>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:InputRecordContenutoRecordUtentiOLO>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.ContenutoRecord.ContenutoRecordUtentiOLO" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
