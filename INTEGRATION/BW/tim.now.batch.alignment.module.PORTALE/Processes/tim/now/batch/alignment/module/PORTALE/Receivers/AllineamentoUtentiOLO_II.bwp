                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+65a8bc20-7c36-41b0-a739-4c9f4efc5f8a+input&quot; xmlns:ns=&quot;http://www.tim.com/log/AllineamentoPortafoglioAM_Staging/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InputStaging&quot;/>&lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$InputStaging/ns:AllineamentoUtente_dettaglio&quot;>&lt;Record>&lt;COGNOME>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:COGNOME)&quot;>&lt;xsl:value-of select=&quot;ns:COGNOME&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COGNOME>&lt;COMPANY_CODE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:COMPANY_CODE)&quot;>&lt;xsl:value-of select=&quot;ns:COMPANY_CODE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COMPANY_CODE>&lt;COMPANY_NAME>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:COMPANY_NAME)&quot;>&lt;xsl:value-of select=&quot;ns:COMPANY_NAME&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COMPANY_NAME>&lt;CONTENUTO_RECD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:CONTENUTO_RECD)&quot;>&lt;xsl:value-of select=&quot;ns:CONTENUTO_RECD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONTENUTO_RECD>&lt;DATAFI_ELAB>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:DATAFI_ELAB)&qu