                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_ANAG_UTENTE (COGNOME, COMPANY_CODE, COMPANY_NAME,&#xa;  CONTENUTO_RECD, DATAFI_ELAB,  DESCR_ERRORE, DISABL,&#xa;  FUNZIONE, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG, MATRICOLA,&#xa;  NOME, NUMERO_RECD, PROFILO_UTENTI_TI, PROFILO152, &#xa;  TMSP_INSMTO, USER_ALIAS, USER_ID_UNICO)&#xa;  VALUES (?,?,?,RTRIM(?, CHR(10) || CHR(13)), ?, ?, ?, ?, ?, ?, ?,  ?, ?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

