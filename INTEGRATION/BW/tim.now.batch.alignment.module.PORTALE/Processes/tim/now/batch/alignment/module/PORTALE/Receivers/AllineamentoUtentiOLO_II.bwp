                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="StartElaborazione-input"
                                    name="StartElaborazione"
                                    tibex:xpdlId="2cf1e1c3-026a-47aa-9d8a-cf622fdcf102"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
