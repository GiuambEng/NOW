        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+4c82e364-27ca-4b93-9079-70e16daf8967+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+4c82e364-27ca-4b93-9079-70e16daf8967+input">
            <element name="jdbcUpdateActivityInput">
                <complexType>
                    <sequence>
                        <element maxOccurs="1" minOccurs="1"
                            name="ID_FILE" nillable="true" type="int"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="SISTEMA" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="FLUSSO" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="DETAILS" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="DESCR_ERRORE" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="STATO" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
