                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="Log_ErrorToJDBCUpdate" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCUpdateToEmpty" tibex:linkType="ERROR"/>
                            <bpws:link name="EmptyToCallProcess1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="MovedErrorToLoggerKO" tibex:linkType="SUCCESS"/>
