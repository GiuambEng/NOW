                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;MovedInScarto&quot;/>&lt;xsl:template name=&quot;TrackKOFunct-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Update>&lt;tns:FLAG_LAVORAZIONE>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:FLAG_LAVORAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;'KO_NUMERO_RECORD'&quot;/>&lt;/tns:STATO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:STATO>&lt;xsl:value-of select=&quot;'COMPLETATO'&quot;/>&lt;/tns:STATO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat('***ERRORE NUMERO RECORD, RECORD CONTATI= ',string($JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord))&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:if>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_TRACK)&quot;/>&lt;/tns:ID_TRACK>&lt;xsl:if test=&quot;string-length($MovedInScarto/tns1:FullPathMovedFile)>0 and $JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&lt;xsl:if test=&quot;$MovedInScarto/tns1:FullPathMovedFile&quot;>&lt;tns:FOLDER_SCARTO>&lt;xsl:value-of select=&quot;$MovedInScarto/tns1:FullPathMovedFile&quot;/>&lt;/tns:FOLDER_SCARTO>&lt;/xsl:if>&lt;/xsl:if>&lt;tns:LogElement/>&lt;/tns:Update>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
