<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="www.tim.now.common.Migrazioni.Portale.CreazioneFileScarto.Common" targetNamespace="www.tim.now.common.Migrazioni.Portale.CreazioneFileScarto.Common" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="NomeTabella" type="xs:string" minOccurs="0"/>
				<xs:element name="IdFile" type="xs:string" minOccurs="0"/>
				<xs:element name="Passo" type="xs:integer" minOccurs="0"/>
				<xs:element name="NomeFlusso">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="UtentiOLO"/>
							<xs:enumeration value="UtentiTI"/>
							<xs:enumeration value="UtentiAM"/>
							<xs:enumeration value="CodiciProgetto"/>
							<xs:enumeration value="AcronimiMapping"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>