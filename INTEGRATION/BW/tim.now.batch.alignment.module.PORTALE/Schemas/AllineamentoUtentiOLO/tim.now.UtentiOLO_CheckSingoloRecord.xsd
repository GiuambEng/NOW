<schema xmlns="http://www.w3.org/2001/XMLSchema"
xmlns:tns="http://www.tim.com/NOW/xsd/tim.now.UtentiOLO_CheckSingoloRecord"
elementFormDefault="qualified"
attributeFormDefault="unqualified"
targetNamespace="http://www.tim.com/NOW/xsd/tim.now.UtentiOLO_CheckSingoloRecord">
<element name="MigrazioneUtentiOLO">
	<complexType>
		<sequence>
			<element ref="tns:MigrazioneUtentiOLO_dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
<element name="MigrazioneUtentiOLO_dettaglio">
	<complexType>
		<sequence>
			<element name="USER_ID_UNICO" maxOccurs="1" minOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="100" />
					</restriction>
				</simpleType>
			</element>
			<element name="NOME" maxOccurs="1" minOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="100" />
					</restriction>
				</simpleType>
			</element>
			<element name="COGNOME" maxOccurs="1" minOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="100" />
					</restriction>
				</simpleType>
			</element>
			<element name="USER_ALIAS" maxOccurs="1" minOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="100" />
					</restriction>
				</simpleType>
			</element>
			<element name="MATRICOLA" type="string" maxOccurs="1"
				minOccurs="0" />
			<element name="DISABILITATO" maxOccurs="1" minOccurs="1">
				<simpleType>
					<restriction base="int">
						<totalDigits value="1" />
						<enumeration value="0" />
						<enumeration value="1" />
					</restriction>
				</simpleType>
			</element>
			<element name="PROFILO152" maxOccurs="1" minOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="100" />
					</restriction>
				</simpleType>
			</element>
			<element name="COMPANY_CODE" maxOccurs="1" minOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="100" />
					</restriction>
				</simpleType>
			</element>
			<element name="PROFILO_UTENTI_TI" maxOccurs="1"
				minOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="100" />
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="Timestamp"
				type="string" />
			<element maxOccurs="1" minOccurs="0" name="FlagValidita"
				type="string" />
			<element maxOccurs="1" minOccurs="0" name="ID_FILE"
				type="string" />
			<element name="Numero_Record" type="string" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>
	</element>
</schema>