<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/tim.now.PortafoglioAM_CheckSingoloRecord"
	elementFormDefault="qualified"
	attributeFormDefault="unqualified"
	targetNamespace="http://www.tim.com/NOW/xsd/tim.now.PortafoglioAM_CheckSingoloRecord">
				<element name="MigrazionePortafoglioAccount">
					<complexType>
						<sequence>
							<element ref="tns:MigrazionePortafoglioAccountDettaglio" maxOccurs="unbounded" minOccurs="0">
							</element>
						</sequence>
					</complexType>
				</element>
	<simpleType name="String100">
		<restriction base="string">
			<maxLength value="100" />
		</restriction>
	</simpleType>
	<simpleType name="String3">
		<restriction base="string">
			<maxLength value="3" />
		</restriction>
	</simpleType>
	<element name="MigrazionePortafoglioAccountDettaglio">
		<complexType>
			<sequence>
				<element minOccurs="1" maxOccurs="1"
					name="AM_USER_ALIAS" type="tns:String100" />
				<element minOccurs="1" maxOccurs="1" name="AM_NOME"
					type="tns:String100" />
				<element minOccurs="1" maxOccurs="1" name="AM_COGNOME"
					type="tns:String100" />
				<element minOccurs="1" maxOccurs="1"
					name="AM_USER_ID_UNICO" type="tns:String100" />
				<element minOccurs="1" maxOccurs="1" name="COMPANY_NAME"
					type="tns:String100" />
				<element minOccurs="1" maxOccurs="1" name="COMPANY_CODE"
					type="tns:String3" />
				<element maxOccurs="1" minOccurs="0" name="Timestamp"
					type="string" />
				<element maxOccurs="1" minOccurs="0" name="FlagValidita"
					type="string" />
				<element maxOccurs="1" minOccurs="0" name="ID_FILE"
					type="string" />
				<element name="Numero_Record" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
</schema>