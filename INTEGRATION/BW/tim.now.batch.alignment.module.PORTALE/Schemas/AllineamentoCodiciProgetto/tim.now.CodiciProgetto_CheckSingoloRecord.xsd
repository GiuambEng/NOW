<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"   
targetNamespace="http://www.tim.com/NOW/xsd/tim.now.CodiciProgetto_CheckSingoloRecord"  
xmlns:tns="http://www.tim.com/NOW/xsd/tim.now.CodiciProgetto_CheckSingoloRecord"
elementFormDefault="qualified"     
attributeFormDefault="unqualified">
	<element name="Root">
		<complexType>
			<sequence>
				<element name="MigrazioneCodiciProgetto" maxOccurs="unbounded" minOccurs="0">
					<complexType>
						<sequence>
							<element ref="tns:Dettaglio"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<simpleType name="String100">
		<restriction base="string">
			<maxLength value="100"/>
		</restriction>
	</simpleType>
	<simpleType name="String3">
		<restriction base="string">
			<maxLength value="3"/>
		</restriction>
	</simpleType>
	<simpleType name="String2">
		<restriction base="string" />
	</simpleType>
	<element name="Dettaglio">
		<complexType>
			<sequence>
				<element minOccurs="1" maxOccurs="1"
					name="CODICE_PROGETTO" type="tns:String100" />
				<element minOccurs="1" maxOccurs="1"
					name="CODE_OPERATORE" type="tns:String3" />
				<element minOccurs="1" maxOccurs="1"
					name="DATA_INIZIO_PROV" type="string" />
				<element minOccurs="1" maxOccurs="1"
					name="DATA_FINE_PROV" type="string" />
				<element minOccurs="1" maxOccurs="1" name="FITTIZIO">
					<simpleType>
						<restriction base="tns:String2">
							<enumeration value="SI" />
							<enumeration value="NO" />
							<maxLength value="2" />
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="1" maxOccurs="1" name="REPORT">
					<simpleType>
						<restriction base="tns:String2">
							<enumeration value="SI" />
							<enumeration value="NO" />
							<maxLength value="2" />
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Timestamp"
					type="string" />
				<element maxOccurs="1" minOccurs="0" name="FlagValidita"
					type="string" />
				<element maxOccurs="1" minOccurs="0" name="ID_FILE"
					type="string" />
				<element name="Numero_record" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
</schema>
