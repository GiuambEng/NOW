<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
 xmlns:tns="http://www.tim.com/NOW/xsd/tim.now.xsd.CodiciProgetto_InputSubProcess" 
 attributeFormDefault="unqualified" 
 elementFormDefault="qualified" 
 targetNamespace="http://www.tim.com/NOW/xsd/tim.now.xsd.CodiciProgetto_InputSubProcess">
	<element name="MigrazioneCodiciProgetto">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0" ref="tns:Dettaglio_Noval"/>
			</sequence>
		</complexType>
	</element>
	<element name="Dettaglio_Noval">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="Tipo_record" type="string" />
				<element maxOccurs="1" minOccurs="0" name="CODICE_PROGETTO" type="string" />
				<element maxOccurs="1" minOccurs="0" name="CODICE_OPERATORE" type="string" />
				<element maxOccurs="1" minOccurs="0" name="DATA_INIZIO_PROV" type="string" />
				<element maxOccurs="1" minOccurs="0" name="DATA_FINE_PROV" type="string" />
				<element maxOccurs="1" minOccurs="0" name="FITTIZIO" type="string" />
				<element maxOccurs="1" minOccurs="0" name="REPORT" type="string" />
				<element  minOccurs="0" name="FlagValidita" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Numero_Record" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="string"/>	
			</sequence>
		</complexType>
	</element>
	 <element name="AllineamentoCodiciProgetto_output">
  <complexType>
   <sequence>
    <element name="Esito" type="string" maxOccurs="1" minOccurs="0"/>
   </sequence>
  </complexType>
 </element>
</schema>