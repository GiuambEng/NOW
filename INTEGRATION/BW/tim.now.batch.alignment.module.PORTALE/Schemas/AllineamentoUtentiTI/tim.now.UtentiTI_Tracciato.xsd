				<element name="COGNOME" maxOccurs="1" minOccurs="0" type="string"/>
				<element name="USER_ALIAS" maxOccurs="1" minOccurs="0" type="string"/>
				<element name="DIS_FLAG" maxOccurs="1" minOccurs="0" type="string"/>
				<element name="FUNZIONE" maxOccurs="1" minOccurs="0" type="string"/>
				<element name="PROFILO152" maxOccurs="1" minOccurs="0" type="string"/>
				<element  minOccurs="0" name="FlagValidita" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>