<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.tim.com/NOW/xsd/tim.now.UtentiTI_CheckSingoloRecord" 
xmlns:tns="http://www.tim.com/NOW/xsd/tim.now.UtentiTI_CheckSingoloRecord" 
attributeFormDefault="unqualified"
elementFormDefault="qualified">
    <element name="MigrazioneUtentiTI">
    	<complexType>
    		<sequence>
    			<element ref="tns:MigrazioneUtentiTI_dettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>
    <element name="MigrazioneUtentiTI_dettaglio">
    	<complexType>
    		<sequence>
    			<element name="USER_ID_UNICO" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="NOME" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="COGNOME" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="USER_ALIAS" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DIS_FLAG" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="int">
    						<totalDigits value="1" />
    						<enumeration value="0" />
    						<enumeration value="1" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="FUNZIONE" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="PROFILO152" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="Timestamp"
    				type="string" />
    			<element maxOccurs="1" minOccurs="0" name="FlagValidita"
    				type="string" />
    			<element maxOccurs="1" minOccurs="0" name="ID_FILE"
    				type="string" />
    			<element name="Numero_Record" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>