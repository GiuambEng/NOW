<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
xmlns:tns="http://www.tim.com/NOW/xsd/tim.now.AcronimiMapping_CheckSingoloRecord/" 
targetNamespace="http://www.tim.com/NOW/xsd/tim.now.AcronimiMapping_CheckSingoloRecord/"
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
<element name="MigrazioneAcronimiMapping">
	<complexType>
		<sequence>
			<element maxOccurs="unbounded" minOccurs="0" ref="tns:MigrazioneAcronimiMappingDettaglio"/>
		</sequence>
	</complexType>
</element>
	<simpleType name="String3">
		<restriction base="string">
			<maxLength value="3" />
			<minLength value="1"></minLength>
		</restriction>
	</simpleType>
	<simpleType name="String100">
		<restriction base="string">
			<maxLength value="100" />
			<minLength value="1"></minLength>
		</restriction>
	</simpleType>
	<element name="MigrazioneAcronimiMappingDettaglio">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="COMPANY_CODE"
					type="tns:String3" />
				<element maxOccurs="1" minOccurs="1" name="COMPANY_NAME"
					type="tns:String100" />
				<element maxOccurs="1" minOccurs="1" name="CODICE_OP"
					type="tns:String100" />
				<element maxOccurs="1" minOccurs="1" name="RAGIONE_OP"
					type="tns:String100" />
				<element maxOccurs="1" minOccurs="1" name="SISTEMA"
					type="tns:String100" />
				<element maxOccurs="1" minOccurs="1" name="DESC_SISTEMA"
					type="tns:String100" />
				<element maxOccurs="1" minOccurs="0" name="Timestamp"
					type="string" />
				<element maxOccurs="1" minOccurs="0" name="FlagValidita"
					type="string" />
				<element maxOccurs="1" minOccurs="0" name="ID_FILE"
					type="string" />
				<element name="Numero_Record" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
</schema>