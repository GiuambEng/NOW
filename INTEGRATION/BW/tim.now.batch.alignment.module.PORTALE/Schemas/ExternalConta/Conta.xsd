<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xs:schema xmlns="http://www.tim.com/NOW/contaRecord/" xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/contaRecord/">
	<xs:complexType name="contaRecordInput_type">
		<xs:sequence>
			<xs:element name="in" type="xs:string"/>
			<xs:element name="TipoSeparatore">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="ContaRecord_DoppioPipe"/>
						<xs:enumeration value="ContaRecord_PipeCancelletto"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="contaRecordOutput_type">
		<xs:sequence>
			<xs:element minOccurs="0" name="out" type="xs:string"/>
			<xs:element minOccurs="0" name="NumeroRecord" type="xs:integer"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="contaRecord_Input" type="contaRecordInput_type"/>
	<xs:element name="contaRecord_Output" type="contaRecordOutput_type"/>
</xs:schema>
