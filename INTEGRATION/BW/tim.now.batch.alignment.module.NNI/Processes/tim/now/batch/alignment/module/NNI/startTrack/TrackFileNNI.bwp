            namespace="http://www.example.org/FileTappo" prefix="tns1"/>
    </tibex:NamespaceRegistry>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/FileTappo"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:TimerOutputSchema" name="Timer" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ListFilesActivityConfig"
            name="ListFilesDNRisorsa-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ListFilesActivityOutput"
            name="ListFilesDNRisorsa" sca-bpel:internal="true"/>
        <bpws:variable name="filepathDNRisorsa"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/FilePoller/PathInnescoAssDN_IDRis" type="xsd:string"/>
        <bpws:variable element="ns0:ListFilesActivityConfig"
            name="ListFilesVlanRetail-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ListFilesActivityOutput"
            name="ListFilesVlanRetail" sca-bpel:internal="true"/>
        <bpws:variable name="filepathVLANRetail"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/FilePoller/PathInnescoAnagVLAN" type="xsd:string"/>
        <bpws:variable name="LoggerName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/ConfigurationLog/LoggerName" type="xsd:string"/>
        <bpws:variable name="LogLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/ConfigurationLog/LogLevel" type="xsd:string"/>
        <bpws:variable name="PathMovedFileTappo"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/FilePoller/PathFileMove" type="xsd:string"/>
        <bpws:variable element="ns2:InputFileTappo"
            name="StartTrack-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:InputFileTappo"
            name="StarttrackVlanRetail-input" sca-bpel:internal="true"/>
        <bpws:variable name="StartAllineamenti"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Timer/StartAllineamenti" type="xsd:dateTime"/>
        <bpws:variable name="IntervalloMinuti"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Timer/IntervalloMinuti" type="xsd:int"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogListFilesDNRisorsa-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogListFilesVlanRetail-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToListFiles" tibex:linkType="SUCCESS"/>
                <bpws:link name="IterateToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="TimerToListFiles1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Iterate1ToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFiles1ToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="ListFilesDNRisorsaToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToIterate" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesVlanRetailToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogListFilesVlanRetailToIterate1" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="Timer"
                    tibex:xpdlId="dc1c89b4-2435-4a11-a703-6a73326c9db5"
                    variable="Timer" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerToListFiles"/>
                        <bpws:source linkName="TimerToListFiles1"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="StartAllineamenti"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="IntervalloMinuti"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value
                                    endTime="2017-01-23T10:25:31.961+0100"
                                    intervalUnit="Minute" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ListFilesDNRisorsa-input"
                    name="ListFilesDNRisorsa"
                    outputVariable="ListFilesDNRisorsa"
                    tibex:xpdlId="b27af3db-277a-40ae-9bcf-cb51dfb24f78" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToListFiles"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListFilesToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ListFilesDNRisorsaToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($ListFilesDNRisorsa/files/fileInfo)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($ListFilesDNRisorsa/files/fileInfo)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;filepathDNRisorsa&quot;/>&#xa;    &lt;xsl:template name=&quot;ListFilesDNRisorsa-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ListFilesActivityConfig>&#xa;            &lt;fileName>&#xa;                &lt;xsl:value-of select=&quot;$filepathDNRisorsa&quot;/>&#xa;            &lt;/fileName>&#xa;        &lt;/tns2:ListFilesActivityConfig>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.list"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//ListFiles"/>
                                    <value mode="files-and-directories" xsi:type="file:ListFiles"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate"
                tibex:indexToGlobal="false" tibex:xpdlId="ac3f1c66-17dc-49b8-b8f2-e3ac9caac91a">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$ListFilesDNRisorsa/files/fileInfo" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ListFilesDNRisorsa/files/fileInfo)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns0:Iterate_Current_Element_fileInfo"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="e608dc46-ae64-4a5c-8e5d-a3890b55d9af" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToCallProcess"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($ListFilesDNRisorsa/files/fileInfo)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="db74045b-3146-4c8d-9e61-658f458b9236">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="StartTrack-input"
                                    name="StartTrack"
                                    tibex:xpdlId="cd34b573-4717-44fe-9438-41ff3bf049b1"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;PathMovedFileTappo&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;StartTrack-input&quot; match=&quot;/&quot;>&lt;tns1:InputFileTappo>&lt;tns1:FileName>&lt;xsl:value-of select=&quot;$currentElement/fullName&quot;/>&lt;/tns1:FileName>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LogName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:ApplicationName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:ApplicationName>&lt;tns1:Estensione>&lt;xsl:value-of select=&quot;&amp;quot;.csv&amp;quot;&quot;/>&lt;/tns1:Estensione>&lt;tns1:Sistema>&lt;xsl:value-of select=&quot;'NNI'&quot;/>&lt;/tns1:Sistema>&lt;tns1:Flusso>&lt;xsl:value-of select=&quot;'Anagrafica DN'&quot;/>&lt;/tns1:Flusso>&lt;tns1:PathMovedTappo>&lt;xsl:value-of select=&quot;$PathMovedFileTappo&quot;/>&lt;/tns1:PathMovedTappo>&lt;/tns1:InputFileTappo>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneLetturaTracciamento" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="45d21daa-364d-4a84-bc16-ff513197a357">
                <bpws:targets>
                    <bpws:target linkName="IterateToExit"/>
                    <bpws:target linkName="ListFilesToExit"/>
                    <bpws:target linkName="Iterate1ToExit"/>
                    <bpws:target linkName="ListFiles1ToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ListFilesVlanRetail-input"
                    name="ListFilesVlanRetail"
                    outputVariable="ListFilesVlanRetail"
                    tibex:xpdlId="a55422e6-91ce-42ad-a460-1f45a97dac0b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToListFiles1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListFiles1ToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ListFilesVlanRetailToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($ListFilesVlanRetail/files/fileInfo) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($ListFilesVlanRetail/files/fileInfo) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;filepathVLANRetail&quot;/>&#xa;    &lt;xsl:template name=&quot;ListFilesVlanRetail-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ListFilesActivityConfig>&#xa;            &lt;fileName>&#xa;                &lt;xsl:value-of select=&quot;$filepathVLANRetail&quot;/>&#xa;            &lt;/fileName>&#xa;        &lt;/tns2:ListFilesActivityConfig>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.list"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//ListFiles"/>
                                    <value mode="files-and-directories" xsi:type="file:ListFiles"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate1" tibex:group="iterate" tibex:xpdlId="ea987b15-99ec-444b-984c-5f608a98b894">
                <bpws:targets>
                    <bpws:target linkName="LogListFilesVlanRetailToIterate1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Iterate1ToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence1" tibex:group="iterate">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate1"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$ListFilesVlanRetail/files/fileInfo" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ListFilesVlanRetail/files/fileInfo)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope1">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns0:Iterate1_Current_Element_fileInfo"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow2">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStart1ToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToGroupEnd1" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart1"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="efdaf7ce-8518-48e4-b83c-78babcfb4043" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToCallProcess"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($ListFilesVlanRetail/files/fileInfo)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd1"
                                    tibex:group="groupEnd" tibex:xpdlId="43c7d730-9ebf-4cea-a1a3-bcafd66f63d0">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd1"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="StarttrackVlanRetail-input"
                                    name="StarttrackVlanRetail"
                                    tibex:xpdlId="f14490c1-f810-49f5-baa2-dc255df4f805"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;PathMovedFileTappo&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;StarttrackVlanRetail-input&quot; match=&quot;/&quot;>&lt;tns1:InputFileTappo>&lt;tns1:FileName>&lt;xsl:value-of select=&quot;$currentElement/fullName&quot;/>&lt;/tns1:FileName>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LogName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:ApplicationName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:ApplicationName>&lt;tns1:Estensione>&lt;xsl:value-of select=&quot;&amp;quot;.csv&amp;quot;&quot;/>&lt;/tns1:Estensione>&lt;tns1:Sistema>&lt;xsl:value-of select=&quot;'NNI'&quot;/>&lt;/tns1:Sistema>&lt;tns1:Flusso>&lt;xsl:value-of select=&quot;'Anagrafica VLAN Retail'&quot;/>&lt;/tns1:Flusso>&lt;tns1:PathMovedTappo>&lt;xsl:value-of select=&quot;$PathMovedFileTappo&quot;/>&lt;/tns1:PathMovedTappo>&lt;/tns1:InputFileTappo>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneLetturaTracciamento" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogListFilesDNRisorsa-input"
                    name="LogListFilesDNRisorsa"
                    tibex:xpdlId="39434799-ffe1-40ae-8f63-b31962026973"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ListFilesDNRisorsaToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToIterate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;ListFilesDNRisorsa&quot;/>&lt;xsl:template name=&quot;LogListFilesDNRisorsa-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'TrackFileNNI'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Start Allineamento nni - DN RISORSA', tib:render-xml($ListFilesDNRisorsa,true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogListFilesVlanRetail-input"
                    name="LogListFilesVlanRetail"
                    tibex:xpdlId="4ac4deef-89b5-4abb-aecf-fe4aed011eec"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ListFilesVlanRetailToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogListFilesVlanRetailToIterate1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;ListFilesVlanRetail&quot;/>&lt;xsl:template name=&quot;LogListFilesVlanRetail-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'TrackFileNNI'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Start Allineamento nni VlanRetail', tib:render-xml($ListFilesVlanRetail, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
