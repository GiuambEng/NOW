                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ee31d220-3480-4fa9-8f71-63a897ec67f0+input&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;InsertStatoAllineamenti-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcUpdateActivityInput>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&lt;/ID_FILE>&lt;SISTEMA>&lt;xsl:value-of select=&quot;'NNI'&quot;/>&lt;/SISTEMA>&lt;FLUSSO>&lt;xsl:value-of select=&quot;'AssociazioneDN_IDRisorsa'&quot;/>&lt;/FLUSSO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME)>0&quot;>&lt;DETAILS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME)&quot;>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DETAILS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DETAILS xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true())&quot;/>&lt;/DESCR_ERRORE>&lt;STATO>&lt;xsl:value-of select=&quot;'KO_BW'&quot;/>&lt;/STATO>&lt;ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ID_ESEC_PROCSO_FILE>&lt;/tns1:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
