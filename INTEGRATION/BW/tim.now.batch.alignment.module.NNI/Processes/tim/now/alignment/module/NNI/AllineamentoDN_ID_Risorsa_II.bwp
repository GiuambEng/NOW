                                    inputVariable="LogInsertStag-input"
                                    name="LogInsertStag"
                                    tibex:xpdlId="09df35f1-e1dc-498c-a5ed-56e6d3cef3cf"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
