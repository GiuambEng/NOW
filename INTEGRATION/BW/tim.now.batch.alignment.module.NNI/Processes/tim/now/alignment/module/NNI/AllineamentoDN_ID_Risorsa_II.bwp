                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/ManageMoveFile&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;PathMove&quot;/>&#xa;    &lt;xsl:param name=&quot;ScartoPath&quot;/>&#xa;    &lt;xsl:template name=&quot;GestioneMoved-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:InputData>&#xa;            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;>&#xa;                &lt;tns2:FullPathOrigine>&#xa;                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;/>&#xa;                &lt;/tns2:FullPathOrigine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&#xa;                    &lt;tns2:FolderDestinazione>&#xa;                        &lt;xsl:value-of select=&quot;$ScartoPath&quot;/>&#xa;                    &lt;/tns2:FolderDestinazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:FolderDestinazione>&#xa;                        &lt;xsl:value-of select=&quot;$PathMove&quot;/>&#xa;                    &lt;/tns2:FolderDestinazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;>&#xa;                &lt;tns2:NomeFile>&#xa;                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;/>&#xa;                &lt;/tns2:NomeFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:ID_TRACK>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_TRACK)&quot;/>&#xa;            &lt;/tns2:ID_TRACK>&#xa;            &lt;tns2:LogInput>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LogName>&#xa;            &lt;/tns2:LogInput>&#xa;        &lt;/tns2:InputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
