                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="JDBCUpdate-input"
                                    name="JDBCUpdate"
                                    outputVariable="JDBCUpdate"
                                    tibex:xpdlId="6522c2df-7842-4c04-8a54-4ea20d373308" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogInsertStagToGroupEnd"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6522c2df-7842-4c04-8a54-4ea20d373308+input&quot; xmlns:tns3=&quot;http://www.example.org/tim.now.schema.xsd.AllineamentoDN_ID_Risorsa_Staging&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStag&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_Elab_Stag&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$InsertStag/tns3:AllineamentoDN_IDRisorsa_Dettaglio_Staging&quot;>&#xa;                &lt;Record>&#xa;                    &lt;CONTENUTO_RECD>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns3:Contenuto_Record)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns3:Contenuto_Record&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CONTENUTO_RECD>&#xa;                    &lt;DISTR>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns3:Distretto)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns3:Distretto&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DISTR>&#xa;                    &lt;ID_RISORSA_DIN>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns3:ID_RISORSA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns3:ID_RISORSA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA_DIN>&#xa;                    &lt;ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;xsd:decimal(tns3:ID_FILE)&quot;/>&#xa;                    &lt;/ID_FILE_PROCSTO_INPUT>&#xa;                    &lt;ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;xsd:decimal($OK_Elab_Stag)&quot;/>&#xa;                    &lt;/ID_STATO_ELAB_STAG>&#xa;                    &lt;NUMERO_RECD>&#xa;                        &lt;xsl:value-of select=&quot;xsd:decimal(tns3:Numero_Record)&quot;/>&#xa;                    &lt;/NUMERO_RECD>&#xa;                    &lt;NUMERO_TELEFONICO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns3:ORDER_NUM)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns3:ORDER_NUM&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/NUMERO_TELEFONICO>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBC_Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_ASSCZ_DN_IDRIS_DINFL (CONTENUTO_RECD,&#xa;  DISTR, ID_RISORSA_DIN, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG,&#xa;  NUMERO_RECD, NUMERO_TELEFONICO, TIMSTP_INSMTO)&#xa;  VALUES (RTRIM(?, CHR(10) || CHR(13)), ?, ?, ?, ?, ?, ?, SYSDATE)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CONTENUTO_RECD"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DISTR"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA_DIN"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE_PROCSTO_INPUT"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_STATO_ELAB_STAG"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="NUMERO_RECD"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMERO_TELEFONICO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:empty name="Empty" tibex:xpdlId="4b7f50dc-566c-4a8f-aca7-d5bdc58f70de">
                                <bpws:targets>
                                    <bpws:target linkName="Empty1ToEmpty"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="EmptyToLogContenuto">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(($index=((($NumeroRec) div ($PassoCiclo))+1)) and ((count($DettaglioLast/Rows/tns:AllineamentoDN_IDRisorsa_Dettaglio_NoVal))=0))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(($index=((($NumeroRec) div ($PassoCiclo))+1)) and ((count($DettaglioLast/Rows/tns:AllineamentoDN_IDRisorsa_Dettaglio_NoVal))=0))]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogRecordFiniti-input"
                                    name="LogRecordFiniti"
                                    tibex:xpdlId="2747f1c7-404c-4abe-83a2-842c73adf1dc"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogRecordFinitiToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
