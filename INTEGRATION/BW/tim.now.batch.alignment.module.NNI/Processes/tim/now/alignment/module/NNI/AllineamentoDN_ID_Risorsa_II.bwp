                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="InsertStag"
                                    name="Assign_InsertStag"
                                    outputVariable="InsertStag"
                                    tibex:xpdlId="569459b1-20ce-45de-9f2f-877923bf691f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess5ToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCallProcess6"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/tim.now.schema.xsd.AllineamentoDN_ID_Risorsa_Staging&quot; xmlns:tns3=&quot;http://www.example.org/tim.now.schema.xsd.AllineamentoDN_ID_Risorsa_Noval&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DettaglioLast&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;Dettaglio&quot;/>&#xa;    &lt;xsl:param name=&quot;PassoCiclo&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStag&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($DettaglioLast/Rows/tns3:AllineamentoDN_IDRisorsa_Dettaglio_NoVal)=0&quot;>&#xa;                &lt;tns2:AllineamentoDN_IDRisorsa_Staging>&#xa;                    &lt;xsl:for-each select=&quot;$Dettaglio/Rows/tns3:AllineamentoDN_IDRisorsa_Dettaglio_NoVal&quot;>&#xa;                        &lt;tns2:AllineamentoDN_IDRisorsa_Dettaglio_Staging>&#xa;                            &lt;xsl:variable name=&quot;DstrReale&quot; select=&quot;if (starts-with(tns3:Distretto, '00')) &amp;#xD;&amp;#xA;then string(substring(tns3:Distretto, 2)) &amp;#xD;&amp;#xA;else if (not(starts-with(tns3:Distretto, '0'))) &amp;#xD;&amp;#xA;then string(concat('0', tns3:Distretto)) &amp;#xD;&amp;#xA;else string(tns3:Distretto)&quot;/>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($PassoCiclo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns3:Distretto&quot;>&#xa;                                &lt;tns2:Distretto>&#xa;                                    &lt;xsl:value-of select=&quot;tns3:Distretto&quot;/>&#xa;                                &lt;/tns2:Distretto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with(substring(tns3:ID_RISORSA, 4), $DstrReale)&quot;>&#xa;                                    &lt;tns2:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;substring(tns3:ID_RISORSA, 4)&quot;/>&#xa;                                    &lt;/tns2:ID_RISORSA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;tns3:ID_RISORSA&quot;>&#xa;                                        &lt;tns2:ID_RISORSA>&#xa;                                            &lt;xsl:value-of select=&quot;tns3:ID_RISORSA&quot;/>&#xa;                                        &lt;/tns2:ID_RISORSA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;tns3:ORDER_NUM&quot;>&#xa;                                &lt;tns2:ORDER_NUM>&#xa;                                    &lt;xsl:value-of select=&quot;tns3:ORDER_NUM&quot;/>&#xa;                                &lt;/tns2:ORDER_NUM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns2:Contenuto_Record>&#xa;                                &lt;xsl:value-of select=&quot;concat(tns3:Distretto,';',tns3:ID_RISORSA,';',tns3:ORDER_NUM)&quot;/>&#xa;                            &lt;/tns2:Contenuto_Record>&#xa;                            &lt;tns2:Numero_Record>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/tns2:Numero_Record>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&#xa;                                &lt;tns2:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&#xa;                                &lt;/tns2:ID_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns2:AllineamentoDN_IDRisorsa_Dettaglio_Staging>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns2:AllineamentoDN_IDRisorsa_Staging>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns2:AllineamentoDN_IDRisorsa_Staging>&#xa;                    &lt;xsl:for-each select=&quot;$DettaglioLast/Rows/tns3:AllineamentoDN_IDRisorsa_Dettaglio_NoVal&quot;>&#xa;                        &lt;tns2:AllineamentoDN_IDRisorsa_Dettaglio_Staging>&#xa;                            &lt;xsl:variable name=&quot;DstrRealeLast&quot; select=&quot;if (starts-with(tns3:Distretto, '00')) &amp;#xD;&amp;#xA;then string(substring(tns3:Distretto, 2)) &amp;#xD;&amp;#xA;else if (not(starts-with(tns3:Distretto, '0'))) &amp;#xD;&amp;#xA;then string(concat('0', tns3:Distretto)) &amp;#xD;&amp;#xA;else string(tns3:Distretto)&quot;/>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($PassoCiclo* ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns3:Distretto&quot;>&#xa;                                &lt;tns2:Distretto>&#xa;                                    &lt;xsl:value-of select=&quot;tns3:Distretto&quot;/>&#xa;                                &lt;/tns2:Distretto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with(substring(tns3:ID_RISORSA, 4), $DstrRealeLast)&quot;>&#xa;                                    &lt;tns2:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;substring(tns3:ID_RISORSA, 4)&quot;/>&#xa;                                    &lt;/tns2:ID_RISORSA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;tns3:ID_RISORSA&quot;>&#xa;                                        &lt;tns2:ID_RISORSA>&#xa;                                            &lt;xsl:value-of select=&quot;tns3:ID_RISORSA&quot;/>&#xa;                                        &lt;/tns2:ID_RISORSA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;tns3:ORDER_NUM&quot;>&#xa;                                &lt;tns2:ORDER_NUM>&#xa;                                    &lt;xsl:value-of select=&quot;tns3:ORDER_NUM&quot;/>&#xa;                                &lt;/tns2:ORDER_NUM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns2:Contenuto_Record>&#xa;                                &lt;xsl:value-of select=&quot;concat(tns3:Distretto,';',tns3:ID_RISORSA,';',tns3:ORDER_NUM)&quot;/>&#xa;                            &lt;/tns2:Contenuto_Record>&#xa;                            &lt;tns2:Numero_Record>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/tns2:Numero_Record>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&#xa;                                &lt;tns2:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&#xa;                                &lt;/tns2:ID_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns2:AllineamentoDN_IDRisorsa_Dettaglio_Staging>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns2:AllineamentoDN_IDRisorsa_Staging>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="InsertStag" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
