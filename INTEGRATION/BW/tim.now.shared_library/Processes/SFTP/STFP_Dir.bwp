                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+5e2b28bc-31e3-4f4a-a9a8-bc122e6c7580+JavaInvokeActivityInput&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SFTP_DirJavaCode&quot; xmlns:tns1=&quot;http://www.example.org/Decryption&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SftDirJavaCodeOperationIn.SftpDirInput&quot;/>&#xa;    &lt;xsl:param name=&quot;Decrypter&quot;/>&#xa;    &lt;xsl:param name=&quot;flagKeyAuthentication&quot;/>&#xa;    &lt;xsl:param name=&quot;id_rsaFile&quot;/>&#xa;    &lt;xsl:param name=&quot;ChannelConnectionTimeout&quot;/>&#xa;    &lt;xsl:template name=&quot;Java_Code_SFTP_Dir-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:JavaInvokeActivityInput>&#xa;            &lt;host>&#xa;                &lt;xsl:value-of select=&quot;$SftDirJavaCodeOperationIn.SftpDirInput/tns2:credenziali/tns2:Host&quot;/>&#xa;            &lt;/host>&#xa;            &lt;port>&#xa;                &lt;xsl:value-of select=&quot;$SftDirJavaCodeOperationIn.SftpDirInput/tns2:credenziali/tns2:Port&quot;/>&#xa;            &lt;/port>&#xa;            &lt;user>&#xa;                &lt;xsl:value-of select=&quot;$SftDirJavaCodeOperationIn.SftpDirInput/tns2:credenziali/tns2:User&quot;/>&#xa;            &lt;/user>&#xa;            &lt;xsl:if test=&quot;string-length($Decrypter/tns1:DecryptedPassword)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Decrypter/tns1:DecryptedPassword&quot;>&#xa;                    &lt;pass>&#xa;                        &lt;xsl:value-of select=&quot;$Decrypter/tns1:DecryptedPassword&quot;/>&#xa;                    &lt;/pass>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;path>&#xa;                &lt;xsl:value-of select=&quot;$SftDirJavaCodeOperationIn.SftpDirInput/tns2:path&quot;/>&#xa;            &lt;/path>&#xa;            &lt;flagKeyAuthentication>&#xa;                &lt;xsl:value-of select=&quot;$flagKeyAuthentication&quot;/>&#xa;            &lt;/flagKeyAuthentication>&#xa;            &lt;id_rsaFile>&#xa;                &lt;xsl:value-of select=&quot;$id_rsaFile&quot;/>&#xa;            &lt;/id_rsaFile>&#xa;            &lt;channel_timeout>&#xa;                &lt;xsl:value-of select=&quot;$ChannelConnectionTimeout&quot;/>&#xa;            &lt;/channel_timeout>&#xa;        &lt;/tns:JavaInvokeActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
