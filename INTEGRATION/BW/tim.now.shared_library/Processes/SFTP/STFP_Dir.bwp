            <bpws:scope name="RepeatOnError" tibex:group="repeatOnError" tibex:xpdlId="3cb5abf2-a47e-48db-a8ba-5a302597c8d7">
                <bpws:targets>
                    <bpws:target linkName="LogKeyToRepeatOnError"/>
                    <bpws:target linkName="Log3ToRepeatOnError"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatOnErrorToAssignFault"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable name="repeatOnError_success_flag"
                        sca-bpel:internal="true" type="xsd:boolean"/>
                    <bpws:variable name="FaultName1"
                        sca-bpel:internal="true" type="xsd:string"/>
                    <bpws:variable element="ns:FaultDetail"
                        name="FaultDetails1" sca-bpel:internal="true"/>
                </bpws:variables>
                <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                    <tibex:DesignExpression>
                        <tibex:expression
                            expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:scope name="innerScope">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails1" tibex:faultNameVar="FaultName1">
                                <bpws:if name="if">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index>$MaxRetrials" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index>$MaxRetrials]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow"/>
                                    <bpws:else>
                                    <bpws:assign name="Assign" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                </bpws:if>
                            </bpws:catchAll>
                        </bpws:faultHandlers>
                        <bpws:flow name="flow3">
                            <bpws:links>
                                <bpws:link
                                    name="Java_Code_SFTP_DirToLog" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToJava_Code_SFTP_Dir" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogToGroupEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="LogToLog2" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Log2ToThrow" tibex:linkType="SUCCESS"/>
                                <bpws:link name="SleepToThrow" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
