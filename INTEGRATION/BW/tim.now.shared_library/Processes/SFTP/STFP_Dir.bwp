                        <bpws:source linkName="AssignFaultToReplyFault_nofiles">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Java_Code_SFTP_Dir/list) = 0 and $FaultError/ns7:code = 'OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Java_Code_SFTP_Dir/list) = 0 and $FaultError/ns7:code = 'OK']]></bpws:transitionCondition>
