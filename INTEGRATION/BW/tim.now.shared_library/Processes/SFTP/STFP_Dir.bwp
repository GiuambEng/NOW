            <element name="JavaInvokeActivityInput" type="tns:MutTypeMethodInputRoot"/>
            <complexType name="MutTypeMethodInputRoot">
                <sequence>
                    <element form="unqualified" maxOccurs="1"
                        minOccurs="1" name="host" type="string"/>
                    <element form="unqualified" maxOccurs="1"
                        minOccurs="1" name="port" type="int"/>
                    <element form="unqualified" maxOccurs="1"
                        minOccurs="1" name="user" type="string"/>
                    <element form="unqualified" maxOccurs="1"
                        minOccurs="0" name="pass" type="string"/>
                    <element form="unqualified" maxOccurs="1"
                        minOccurs="1" name="path" type="string"/>
                    <element form="unqualified" maxOccurs="1"
                        minOccurs="0" name="flagKeyAuthentication" type="boolean"/>
                    <element form="unqualified" maxOccurs="1"
                        minOccurs="0" name="id_rsaFile" type="string"/>
                    <element form="unqualified" maxOccurs="1"
                        minOccurs="1" name="channel_timeout" type="int"/>
                </sequence>
            </complexType>
        </schema>
        <schema attributeFormDefault="unqualified"
            elementFormDefault="qualified"
            targetNamespace="www.tibco.com/plugin/java/JavaInvokeActivityOutput+5e2b28bc-31e3-4f4a-a9a8-bc122e6c7580+JavaInvokeActivityOutput"
