                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+5e2b28bc-31e3-4f4a-a9a8-bc122e6c7580+JavaInvokeActivityInput&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SFTP_DirJavaCode&quot; xmlns:tns1=&quot;http://www.example.org/Decryption&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SftDirJavaCodeOperationIn&quot;/>&lt;xsl:param name=&quot;Decrypter&quot;/>&lt;xsl:param name=&quot;flagKeyAuthentication&quot;/>&lt;xsl:param name=&quot;id_rsaFile&quot;/>&lt;xsl:param name=&quot;ChannelConnectionTimeout&quot;/>&lt;xsl:template name=&quot;Java_Code_SFTP_Dir-input&quot; match=&quot;/&quot;>&lt;tns:JavaInvokeActivityInput>&lt;host>&lt;xsl:value-of select=&quot;$SftDirJavaCodeOperationIn/SftpDirInput/tns2:SFTP_DirJavaCodeInput/tns2:credenziali/tns2:Host&quot;/>&lt;/host>&lt;port>&lt;xsl:value-of select=&quot;$SftDirJavaCodeOperationIn/SftpDirInput/tns2:SFTP_DirJavaCodeInput/tns2:credenziali/tns2:Port&quot;/>&lt;/port>&lt;user>&lt;xsl:value-of select=&quot;$SftDirJavaCodeOperationIn/SftpDirInput/tns2:SFTP_DirJavaCodeInput/tns2:credenziali/tns2:User&quot;/>&lt;/user>&lt;xsl:if test=&quot;string-length($Decrypter/tns1:DecryptedPassword)>0&quot;>&lt;xsl:if test=&quot;$Decrypter/tns1:DecryptedPassword&quot;>&lt;pass>&lt;xsl:value-of select=&quot;$Decrypter/tns1:DecryptedPassword&quot;/>&lt;/pass>&lt;/xsl:if>&lt;/xsl:if>&lt;path>&lt;xsl:value-of select=&quot;$SftDirJavaCodeOperationIn/SftpDirInput/tns2:SFTP_DirJavaCodeInput/tns2:path&quot;/>&lt;/path>&lt;flagKeyAuthentication>&lt;xsl:value-of select=&quot;$flagKeyAuthentication&quot;/>&lt;/flagKeyAuthentication>&lt;id_rsaFile>&lt;xsl:value-of select=&quot;$id_rsaFile&quot;/>&lt;/id_rsaFile>&lt;channel_timeout>&lt;xsl:value-of select=&quot;$ChannelConnectionTimeout&quot;/>&lt;/channel_timeout>&lt;/tns:JavaInvokeActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Java_Code_SFTP_Dir-input"
                                    name="Java_Code_SFTP_Dir"
                                    outputVariable="Java_Code_SFTP_Dir"
                                    tibex:xpdlId="5e2b28bc-31e3-4f4a-a9a8-bc122e6c7580" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
