                                </bpws:copy>
                            </bpws:assign>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+99aa7c3f-dc77-4b68-8e1a-f4cb39f02f94+JavaInvokeActivityInput&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/SFTP_GetJavaCode&quot; xmlns:tns1=&quot;http://www.example.org/Decryption&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SftGetJavaCodeOperationIn&quot;/>&lt;xsl:param name=&quot;Decrypter&quot;/>&lt;xsl:param name=&quot;flagKeyAuthentication&quot;/>&lt;xsl:param name=&quot;id_rsaFile&quot;/>&lt;xsl:param name=&quot;ChannelConnectionTimeout&quot;/>&lt;xsl:template name=&quot;Java_Code_SFTP_Get-input&quot; match=&quot;/&quot;>&lt;tns:JavaInvokeActivityInput>&lt;host>&lt;xsl:value-of select=&quot;$SftGetJavaCodeOperationIn/SftpGetInput/tns3:SFTP_GetJavaCodeInput/tns3:credenziali/tns3:Host&quot;/>&lt;/host>&lt;port>&lt;xsl:value-of select=&quot;$SftGetJavaCodeOperationIn/SftpGetInput/tns3:SFTP_GetJavaCodeInput/tns3:credenziali/tns3:Port&quot;/>&lt;/port>&lt;user>&lt;xsl:value-of select=&quot;$SftGetJavaCodeOperationIn/SftpGetInput/tns3:SFTP_GetJavaCodeInput/tns3:credenziali/tns3:User&quot;/>&lt;/user>&lt;xsl:if test=&quot;string-length($Decrypter/tns1:DecryptedPassword)>0&quot;>&lt;xsl:if test=&quot;$Decrypter/tns1:DecryptedPassword&quot;>&lt;pass>&lt;xsl:value-of select=&quot;$Decrypter/tns1:DecryptedPassword&quot;/>&lt;/pass>&lt;/xsl:if>&lt;/xsl:if>&lt;RemotFile>&lt;xsl:value-of select=&quot;$SftGetJavaCodeOperationIn/SftpGetInput/tns3:SFTP_GetJavaCodeInput/tns3:RemoteFile&quot;/>&lt;/RemotFile>&lt;LocalFile>&lt;xsl:value-of select=&quot;$SftGetJavaCodeOperationIn/SftpGetInput/tns3:SFTP_GetJavaCodeInput/tns3:LocalFile&quot;/>&lt;/LocalFile>&lt;flagKeyAuthentication>&lt;xsl:value-of select=&quot;$flagKeyAuthentication&quot;/>&lt;/flagKeyAuthentication>&lt;id_rsaFile>&lt;xsl:value-of select=&quot;$id_rsaFile&quot;/>&lt;/id_rsaFile>&lt;channel_timeout>&lt;xsl:value-of select=&quot;$ChannelConnectionTimeout&quot;/>&lt;/channel_timeout>&lt;/tns:JavaInvokeActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
