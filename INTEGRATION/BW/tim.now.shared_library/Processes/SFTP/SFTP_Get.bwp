                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+99aa7c3f-dc77-4b68-8e1a-f4cb39f02f94+JavaInvokeActivityInput&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/SFTP_GetJavaCode&quot; xmlns:tns1=&quot;http://www.example.org/Decryption&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SftGetJavaCodeOperationIn.SftpGetInput&quot;/>&#xa;    &lt;xsl:param name=&quot;Decrypter&quot;/>&#xa;    &lt;xsl:param name=&quot;flagKeyAuthentication&quot;/>&#xa;    &lt;xsl:param name=&quot;id_rsaFile&quot;/>&#xa;    &lt;xsl:param name=&quot;ChannelConnectionTimeout&quot;/>&#xa;    &lt;xsl:template name=&quot;Java_Code_SFTP_Get-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:JavaInvokeActivityInput>&#xa;            &lt;host>&#xa;                &lt;xsl:value-of select=&quot;$SftGetJavaCodeOperationIn.SftpGetInput/tns3:credenziali/tns3:Host&quot;/>&#xa;            &lt;/host>&#xa;            &lt;port>&#xa;                &lt;xsl:value-of select=&quot;$SftGetJavaCodeOperationIn.SftpGetInput/tns3:credenziali/tns3:Port&quot;/>&#xa;            &lt;/port>&#xa;            &lt;user>&#xa;                &lt;xsl:value-of select=&quot;$SftGetJavaCodeOperationIn.SftpGetInput/tns3:credenziali/tns3:User&quot;/>&#xa;            &lt;/user>&#xa;            &lt;xsl:if test=&quot;string-length($Decrypter/tns1:DecryptedPassword)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Decrypter/tns1:DecryptedPassword&quot;>&#xa;                    &lt;pass>&#xa;                        &lt;xsl:value-of select=&quot;$Decrypter/tns1:DecryptedPassword&quot;/>&#xa;                    &lt;/pass>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;RemotFile>&#xa;                &lt;xsl:value-of select=&quot;$SftGetJavaCodeOperationIn.SftpGetInput/tns3:RemoteFile&