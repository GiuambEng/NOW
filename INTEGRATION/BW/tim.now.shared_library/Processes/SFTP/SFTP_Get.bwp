                        minOccurs="1" name="LocalFile" type="string"/>
                    <element form="unqualified" maxOccurs="1"
                        minOccurs="0" name="flagKeyAuthentication" type="boolean"/>
                    <element form="unqualified" maxOccurs="1"
                        minOccurs="0" name="id_rsaFile" type="string"/>
                    <element form="unqualified" maxOccurs="1"
                        minOccurs="1" name="channel_timeout" type="int"/>
                </sequence>
            </complexType>
        </schema>
        <schema attributeFormDefault="unqualified"
            elementFormDefault="qualified"
            targetNamespace="www.tibco.com/plugin/java/JavaInvokeActivityOutput+99aa7c3f-dc77-4b68-8e1a-f4cb39f02f94+JavaInvokeActivityOutput"
