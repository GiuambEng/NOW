    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/Decryption"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/ShellCommand"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:Input_ShellCommand" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns1:JavaInvokeActivityInput"
            name="InvokeShellCommand-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:JavaInvokeActivityOutput"
            name="InvokeShellCommand" sca-bpel:internal="true"/>
        <bpws:variable element="tns:Input" name="Decrypt_Password-input" sca-bpel:internal="true"/>
        <bpws:variable element="tns:Output" name="Decrypt_Password" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:Output_ShellCommand" name="Result"/>
        <bpws:variable element="ns3:Output_ShellCommand"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns4:ActivityInput"
            name="LogPassword-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:ActivityInput" name="LogKey-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:ActivityInput"
            name="LogPasswordKO-input" sca-bpel:internal="true"/>
        <bpws:variable name="flagKeyAuthentication"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Connections/SFTP/flagKeyAuthentication" type="xsd:boolean"/>
        <bpws:variable name="id_rsaFile" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connections/SFTP/id_rsaFile" type="xsd:string"/>
        <bpws:variable name="ChannelConnectionTimeout"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Connections/SFTP/ChannelConnectionTimeout" type="xsd:int"/>
        <bpws:variable element="ns4:ActivityInput" name="Log-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:SleepInputSchema" name="Sleep-input" sca-bpel:internal="true"/>
        <bpws:variable name="MaxRetrials" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connections/SFTP/MaxRetrials" type="xsd:int"/>
        <bpws:variable name="SleepTime_ms" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connections/SFTP/SleepTime_ms" type="xsd:int"/>
        <bpws:variable element="ns6:DefaultFault" name="Throw-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:CW_BUS_MESSAGE"
            name="TrackingApplicativo-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:ActivityInput" name="Log1-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="LogToDecrypt_Password" tibex:linkType="SUCCESS"/>
                <bpws:link name="Decrypt_PasswordToRepeatOnError" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="RepeatOnErrorToAssignOK" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="RepeatOnErrorToAssignKO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Decrypt_PasswordToAssign2" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="AssignToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignKODecryToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToLog" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartToLog1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartToLog2" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Log2ToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignOnPassMissingToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogKeyToRepeatOnError" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignKOToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="4cc5f855-1688-4d1c-86f8-65fa9a0322e0"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets/>
                    <bpws:sources>
                        <bpws:source linkName="StartToLog1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$flagKeyAuthentication=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$flagKeyAuthentication=true()]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToLog2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToLog">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="not($flagKeyAuthentication=true()) and string-length($Start/ns3:Password)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[not($flagKeyAuthentication=true()) and string-length($Start/ns3:Password)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="b34fe1b0-6e2f-4442-b0a3-36c912036ebd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToEnd"/>
                        <bpws:target linkName="CallProcessToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ShellCommand&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ShellCommand&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Result&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns1:Output_ShellCommand>&lt;tns1:Status>&lt;xsl:value-of select=&quot;$Result/tns1:Status&quot;/>&lt;/tns1:Status>&lt;xsl:if test=&quot;$Result/tns1:Message&quot;>&lt;tns1:Message>&lt;xsl:value-of select=&quot;$Result/tns1:Message&quot;/>&lt;/tns1:Message>&lt;/xsl:if>&lt;/tns1:Output_ShellCommand>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="Decrypt_Password-input"
                    name="Decrypt_Password"
                    outputVariable="Decrypt_Password"
                    tibex:xpdlId="f418fc2d-dc45-45ff-a9be-41d154660038"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToDecrypt_Password"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Decrypt_PasswordToRepeatOnError">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Decrypt_Password/tns:Status = 'OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Decrypt_Password/tns:Status = 'OK']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Decrypt_PasswordToAssign2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ShellCommand&quot; xmlns:tns1=&quot;http://www.example.org/Decryption&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ShellCommand&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Decrypt_Password-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;tns1:EncryptedPassword>&lt;xsl:value-of select=&quot;$Start/tns2:Password&quot;/>&lt;/tns1:EncryptedPassword>&lt;/tns1:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="JavaUtil.TibcoPasswordDecripter" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Result"
                    name="AssignOK" outputVariable="Result"
                    tibex:xpdlId="5c9b7562-872f-4196-ab7e-252fd4ea59b9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatOnErrorToAssignOK"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
