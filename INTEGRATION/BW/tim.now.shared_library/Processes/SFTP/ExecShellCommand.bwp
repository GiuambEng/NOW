                                    parameterName="port" parameterType="IN"/>

                                    <javaActivityParameter
                                    parameterCardinality="Required"
                                    parameterDataType="int"
                                    parameterName="channel_timeout" parameterType="IN"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
