    xmlns:ns2="www.tibco.com/plugin/java/JavaInvokeActivityOutput+38f944e6-193f-4167-9026-fd272bfc70a8+JavaInvokeActivityOutput"
    xmlns:ns3="http://www.tim.com/NOW/xsd/ShellCommand"
