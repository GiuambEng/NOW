<bpws:process exitOnStandardFault="no" name="SFTP.ExecShellCommand"
    suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20161215152518"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
