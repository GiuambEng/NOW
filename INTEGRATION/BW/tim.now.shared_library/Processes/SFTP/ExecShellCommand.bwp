            <bpws:scope name="RepeatOnError" tibex:group="repeatOnError" tibex:xpdlId="5e502481-2e8b-4a8d-9a4e-3c0e546389f8">
                <bpws:targets>
                    <bpws:target linkName="LogKeyToRepeatOnError"/>
                    <bpws:target linkName="Decrypt_PasswordToRepeatOnError"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatOnErrorToAssignOK">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$InvokeShellCommand/Status = &quot;OK&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$InvokeShellCommand/Status = "OK"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="RepeatOnErrorToAssignKO">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable name="repeatOnError_success_flag"
                        sca-bpel:internal="true" type="xsd:boolean"/>
                    <bpws:variable name="FaultName"
                        sca-bpel:internal="true" type="xsd:string"/>
                    <bpws:variable element="ns:FaultDetail"
                        name="FaultDetails" sca-bpel:internal="true"/>
                </bpws:variables>
                <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                    <tibex:DesignExpression>
                        <tibex:expression
                            expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:scope name="innerScope">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails" tibex:faultNameVar="FaultName">
                                <bpws:if name="if">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index>$MaxRetrials" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index>$MaxRetrials]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow"/>
                                    <bpws:else>
                                    <bpws:assign name="Assign" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                </bpws:if>
                            </bpws:catchAll>
                        </bpws:faultHandlers>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToInvokeShellCommand" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="InvokeShellCommandToLog" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="LogToSleep" tibex:linkType="SUCCESS"/>
                                <bpws:link name="SleepToThrow" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="InvokeShellCommandToLog1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log1ToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="c6563e62-dc6d-485e-96dd-aae8cba2a19d">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToInvokeShellCommand"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:assign name="GroupEnd"
                                tibex:group="groupEnd"
                                tibex:xpdlId="e71880cf-0c7b-4d0d-aed2-dec8c0fd502d" validate="no">
                                <bpws:targets>
                                    <bpws:target linkName="Log1ToGroupEnd"/>
                                </bpws:targets>
                                <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[true()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                </bpws:copy>
                            </bpws:assign>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="InvokeShellCommand-input"
                                    name="InvokeShellCommand"
                                    outputVariable="InvokeShellCommand"
                                    tibex:xpdlId="38f944e6-193f-4167-9026-fd272bfc70a8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToInvokeShellCommand"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InvokeShellCommandToLog">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$InvokeShellCommand/Status='KO' and $index&lt;=$MaxRetrials" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$InvokeShellCommand/Status='KO' and $index<=$MaxRetrials]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="InvokeShellCommandToLog1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+38f944e6-193f-4167-9026-fd272bfc70a8+JavaInvokeActivityInput&quot; xmlns:tns2=&quot;http://www.example.org/Decryption&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ShellCommand&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Decrypt_Password&quot;/>&lt;xsl:param name=&quot;flagKeyAuthentication&quot;/>&lt;xsl:param name=&quot;id_rsaFile&quot;/>&lt;xsl:param name=&quot;ChannelConnectionTimeout&quot;/>&lt;xsl:template name=&quot;InvokeShellCommand-input&quot; match=&quot;/&quot;>&lt;tns:JavaInvokeActivityInput>&lt;Host>&lt;xsl:value-of select=&quot;$Start/tns3:Host&quot;/>&lt;/Host>&lt;User>&lt;xsl:value-of select=&quot;$Start/tns3:User&quot;/>&lt;/User>&lt;xsl:if test=&quot;string-length($Decrypt_Password/tns2:DecryptedPassword)>0&quot;>&lt;xsl:if test=&quot;$Decrypt_Password/tns2:DecryptedPassword&quot;>&lt;Password>&lt;xsl:value-of select=&quot;$Decrypt_Password/tns2:DecryptedPassword&quot;/>&lt;/Password>&lt;/xsl:if>&lt;/xsl:if>&lt;Command>&lt;xsl:value-of select=&quot;$Start/tns3:Command&quot;/>&lt;/Command>&lt;flagKeyAuthentication>&lt;xsl:value-of select=&quot;$flagKeyAuthentication&quot;/>&lt;/flagKeyAuthentication>&lt;id_rsaFile>&lt;xsl:value-of select=&quot;$id_rsaFile&quot;/>&lt;/id_rsaFile>&lt;port>&lt;xsl:value-of select=&quot;$Start/tns3:Port&quot;/>&lt;/port>&lt;channel_timeout>&lt;xsl:value-of select=&quot;$ChannelConnectionTimeout&quot;/>&lt;/channel_timeout>&lt;/tns:JavaInvokeActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.java.javamethod"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:java="http://ns.tibco.com/bw/palette/java" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/java#//JavaMethod"/>
                                    <value
                                    className="tim.now.shared_library.SftpUtility.ShellCommand"
                                    isMultipleOutput="true"
                                    isNew="true"
                                    isNewActivity="true"
                                    methodName="invoke"
                                    methodReturn="void" xsi:type="java:JavaMethod">
                                    <exceptionTypes>java.lang.Exception</exceptionTypes>

                                    <javaActivityParameter
                                    parameterCardinality="Optional"
                                    parameterDataType="string"
                                    parameterName="Host" parameterType="IN"/>

                                    <javaActivityParameter
                                    parameterCardinality="Required"
                                    parameterDataType="string"
                                    parameterName="User" parameterType="IN"/>

                                    <javaActivityParameter
                                    parameterCardinality="Optional"
                                    parameterDataType="string"
                                    parameterName="Password" parameterType="IN"/>

                                    <javaActivityParameter
                                    parameterCardinality="Required"
                                    parameterDataType="string"
                                    parameterName="Command" parameterType="IN"/>

                                    <javaActivityParameter
                                    parameterCardinality="Required"
                                    parameterDataType="string"
                                    parameterName="Status" parameterType="OUT"/>

                                    <javaActivityParameter
                                    parameterCardinality="Optional"
                                    parameterDataType="string"
                                    parameterName="Message" parameterType="OUT"/>

                                    <javaActivityParameter
                                    parameterCardinality="Optional"
                                    parameterDataType="boolean"
