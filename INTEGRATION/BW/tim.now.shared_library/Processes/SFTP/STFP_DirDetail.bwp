            name="LogPassword-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:ActivityInput"
            name="LogPasswordKO-input" sca-bpel:internal="true"/>
        <bpws:variable name="ChannelConnectionTimeout"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Connections/SFTP/ChannelConnectionTimeout" type="xsd:int"/>
        <bpws:variable element="ns6:JavaInvokeActivityInput"
            name="Invoke_SFTP_DirDetail-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:JavaInvokeActivityOutput"
            name="Invoke_SFTP_DirDetail" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:ErrorLinkHandlerFaultData"
            name="_error_InvokeSFTP_DirDetail" sca-bpel:internal="true"/>
        <bpws:variable name="MaxRetrials" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connections/SFTP/MaxRetrials" type="xsd:int"/>
        <bpws:variable name="SleepTime_ms" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connections/SFTP/SleepTime_ms" type="xsd:int"/>
        <bpws:variable element="ns4:ActivityInput" name="Log-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns9:SleepInputSchema" name="Sleep-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns10:DefaultFault" name="Throw-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns11:CW_BUS_MESSAGE"
            name="TrackingApplicativo-input" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:ErrorLinkHandlerFaultData"
            name="_error_Invoke_SFTP_DirDetail" sca-bpel:internal="true"/>
        <bpws:variable name="ErrorFault" type="xsd:string"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="PasswordDecripterToLog" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="AssignErrorOnDecripterToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToAssign1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="PasswordDecripterToRepeatOnError" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogToAssign2" tibex:linkType="SUCCESS"/>
                <bpws:link name="RepeatOnErrorToLogSFTP_DirDetail" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="StartToLog1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartToLog2" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartToLog3" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Log2ToPasswordDecripter" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log3ToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogKeyToRepeatOnError" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToEnd1" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignKOToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="RepeatOnErrorToAssign1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Assign1ToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="89a62018-3154-47b5-9677-7380c384aa35"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLog1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$flagKeyAuthentication=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$flagKeyAuthentication=true()]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToLog2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="not($flagKeyAuthentication=true()) and string-length($Start/ns0:Credentials/ns0:Password)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[not($flagKeyAuthentication=true()) and string-length($Start/ns0:Credentials/ns0:Password)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToLog3">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="99a94285-35cc-4ee0-9e17-61e03d5a03af" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToEnd"/>
                        <bpws:target linkName="CallProcessToEnd"/>
                        <bpws:target linkName="Assign1ToEnd"/>
                        <bpws:target linkName="AssignToEnd1"/>
                        <bpws:target linkName="AssignErrorOnDecripterToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Result&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Output_SFTP_DirDetail>&lt;tns:Status>&lt;xsl:value-of select=&quot;$Result/tns:Status&quot;/>&lt;/tns:Status>&lt;xsl:for-each select=&quot;$Result/tns:ListOfFiles&quot;>&lt;tns:ListOfFiles>&lt;tns:FileName>&lt;xsl:value-of select=&quot;tns:FileName&quot;/>&lt;/tns:FileName>&lt;tns:FullName>&lt;xsl:value-of select=&quot;tns:FullName&quot;/>&lt;/tns:FullName>&lt;tns:Size>&lt;xsl:value-of select=&quot;tns:Size&quot;/>&lt;/tns:Size>&lt;tns:LastModified>&lt;xsl:value-of select=&quot;tns:LastModified&quot;/>&lt;/tns:LastModified>&lt;/tns:ListOfFiles>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$Result/tns:Message&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;$Result/tns:Message&quot;/>&lt;/tns:Message>&lt;/xsl:if>&lt;/tns:Output_SFTP_DirDetail>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="PasswordDecripter-input"
                    name="PasswordDecripter"
                    outputVariable="PasswordDecripter"
                    tibex:xpdlId="2fb5f962-7b54-43f1-a99a-9c42207892aa"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log2ToPasswordDecripter"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="PasswordDecripterToLog">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PasswordDecripterToRepeatOnError">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$PasswordDecripter/ns1:Status = 'OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$PasswordDecripter/ns1:Status = 'OK']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; xmlns:tns1=&quot;http://www.example.org/Decryption&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;PasswordDecripter-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;tns1:EncryptedPassword>&lt;xsl:value-of select=&quot;$Start/tns:Credentials/tns:Password&quot;/>&lt;/tns1:EncryptedPassword>&lt;/tns1:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="JavaUtil.TibcoPasswordDecripter" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Result"
                    name="AssignOK" outputVariable="Result"
                    tibex:xpdlId="2fa1b252-edcd-4e21-9ada-6ee0fcb804ea" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_SFTP_DirDetail&quot;/>&#xa;    &lt;xsl:template name=&quot;Result&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Output_SFTP_DirDetail>&#xa;            &lt;tns:Status>&#xa;                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;            &lt;/tns:Status>&#xa;            &lt;xsl:for-each select=&quot;$Invoke_SFTP_DirDetail/ListOfFiles&quot;>&#xa;                &lt;tns:ListOfFiles>&#xa;                    &lt;tns:FileName>&#xa;                        &lt;xsl:value-of select=&quot;substring-before( . , '|')&quot;/>&#xa;                    &lt;/tns:FileName>&#xa;                    &lt;tns:FullName>&#xa;                        &lt;xsl:value-of select=&quot;substring-after(substring-before( . , '||'), '|')&quot;/>&#xa;                    &lt;/tns:FullName>&#xa;                    &lt;tns:Size>&#xa;                        &lt;xsl:value-of select=&quot;substring-after(substring-before( . , '|||'), '||')&quot;/>&#xa;                    &lt;/tns:Size>&#xa;                    &lt;tns:LastModified>&#xa;                        &lt;xsl:value-of select=&quot;substring-after(. , '|||')&quot;/>&#xa;                    &lt;/tns:LastModified>&#xa;                &lt;/tns:ListOfFiles>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:Output_SFTP_DirDetail>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Result" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Result"
                    name="AssignKO" outputVariable="Result"
                    tibex:xpdlId="ce3cd7a2-382c-4998-96e0-9315ec3ad136" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToAssign1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignKOToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Invoke_SFTP_DirDetail&quot;/>&lt;xsl:param name=&quot;ErrorFault&quot;/>&lt;xsl:template name=&quot;Result&quot; match=&quot;/&quot;>&lt;tns:Output_SFTP_DirDetail>&lt;tns:Status>&lt;xsl:value-of select=&quot;$Invoke_SFTP_DirDetail/Status&quot;/>&lt;/tns:Status>&lt;xsl:if test=&quot;if(string-length($Invoke_SFTP_DirDetail/Message)>0 )then $Invoke_SFTP_DirDetail/Message&amp;#xD;&amp;#xA;else $ErrorFault&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;if(string-length($Invoke_SFTP_DirDetail/Message)>0 )then $Invoke_SFTP_DirDetail/Message&amp;#xD;&amp;#xA;else $ErrorFault&quot;/>&lt;/tns:Message>&lt;/xsl:if>&lt;/tns:Output_SFTP_DirDetail>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Result" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Result"
                    name="AssignErrorOnDecripter"
                    outputVariable="Result"
                    tibex:xpdlId="7e5b39fe-0331-4feb-bb68-2bc4ab4b9f87" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToAssign2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignErrorOnDecripterToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; xmlns:tns1=&quot;http://www.example.org/Decryption&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PasswordDecripter&quot;/>&lt;xsl:template name=&quot;Result&quot; match=&quot;/&quot;>&lt;tns:Output_SFTP_DirDetail>&lt;tns:Status>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Status>&lt;xsl:if test=&quot;$PasswordDecripter/tns1:ErrorDesc&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;$PasswordDecripter/tns1:ErrorDesc&quot;/>&lt;/tns:Message>&lt;/xsl:if>&lt;/tns:Output_SFTP_DirDetail>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Result" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogSFTP_DirDetail-input"
                    name="LogSFTP_DirDetail"
                    tibex:xpdlId="c5ef22d7-bf32-491a-a21a-312b41dcbb3a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatOnErrorToLogSFTP_DirDetail"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToAssign1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Invoke_SFTP_DirDetail/Status = &quot;OK&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Invoke_SFTP_DirDetail/Status = "OK"]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Invoke_SFTP_DirDetail&quot;/>&lt;xsl:param name=&quot;ErrorFault&quot;/>&lt;xsl:template name=&quot;LogSFTP_DirDetail-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;if(string-length($Invoke_SFTP_DirDetail/Status)>0) then $Invoke_SFTP_DirDetail/Message&amp;#xD;&amp;#xA;else $ErrorFault&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ErrLogPassDecripter-input"
                    name="ErrLogPassDecripter"
                    tibex:xpdlId="d41d34d2-9cc4-457e-bfbc-17dd9298a036" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PasswordDecripterToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToAssign2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
