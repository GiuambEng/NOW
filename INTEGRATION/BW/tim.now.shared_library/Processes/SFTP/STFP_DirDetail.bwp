            <bpws:scope name="RepeatOnError" tibex:group="repeatOnError" tibex:xpdlId="e44e3144-ee2b-4f62-ba33-8e19dc3db7ca">
                <bpws:targets>
                    <bpws:target linkName="PasswordDecripterToRepeatOnError"/>
                    <bpws:target linkName="LogKeyToRepeatOnError"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatOnErrorToLogSFTP_DirDetail">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="RepeatOnErrorToAssign1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="contains($ErrorFault,&quot;Output data error in field [ListOfFiles]&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[contains($ErrorFault,"Output data error in field [ListOfFiles]")]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable name="repeatOnError_success_flag"
                        sca-bpel:internal="true" type="xsd:boolean"/>
                    <bpws:variable name="FaultName"
                        sca-bpel:internal="true" type="xsd:string"/>
                    <bpws:variable element="ns:FaultDetail"
                        name="FaultDetails" sca-bpel:internal="true"/>
                </bpws:variables>
                <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                    <tibex:DesignExpression>
                        <tibex:expression
                            expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:scope name="innerScope">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails" tibex:faultNameVar="FaultName">
                                <bpws:if name="if">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index>$MaxRetrials" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index>$MaxRetrials]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow"/>
                                    <bpws:else>
                                    <bpws:assign name="Assign1" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                </bpws:if>
                            </bpws:catchAll>
                        </bpws:faultHandlers>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToInvoke_SFTP_DirDetail" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Invoke_SFTP_DirDetailToGroupEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="Invoke_SFTP_DirDetailToLog" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="LogToSleep" tibex:linkType="SUCCESS"/>
                                <bpws:link name="SleepToThrow" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Invoke_SFTP_DirDetailToEmpty" tibex:linkType="ERROR"/>
                                <bpws:link name="EmptyToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="b2a5b262-c312-4b9a-be82-62a1dd6c6d3f">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToInvoke_SFTP_DirDetail"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:assign name="GroupEnd"
                                tibex:group="groupEnd"
                                tibex:xpdlId="c8a7dc7a-14c0-423c-a9c1-2d722a6c9b6f" validate="no">
                                <bpws:targets>
                                    <bpws:target linkName="Invoke_SFTP_DirDetailToGroupEnd"/>
                                    <bpws:target linkName="Assign1ToGroupEnd"/>
                                </bpws:targets>
                                <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[true()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                </bpws:copy>
                            </bpws:assign>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Invoke_SFTP_DirDetail-input"
                                    name="Invoke_SFTP_DirDetail"
                                    outputVariable="Invoke_SFTP_DirDetail"
                                    tibex:xpdlId="144ba8be-23db-4c4a-9a36-3a764f397fde" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToInvoke_SFTP_DirDetail"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Invoke_SFTP_DirDetailToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Invoke_SFTP_DirDetailToLog">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Invoke_SFTP_DirDetail/Status='KO' and $index&lt;=$MaxRetrials" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Invoke_SFTP_DirDetail/Status='KO' and $index<=$MaxRetrials]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source
                                    linkName="Invoke_SFTP_DirDetailToEmpty"
                                    tibex:faultDetailsVar="Invoke_SFTP_DirDetail" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+9d2af5cd-c0f8-4b2c-b370-0cfe5f893602+JavaInvokeActivityInput&quot; xmlns:tns1=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; xmlns:tns2=&quot;http://www.example.org/Decryption&quot; xmlns:tns3=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+144ba8be-23db-4c4a-9a36-3a764f397fde+JavaInvokeActivityInput&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;flagKeyAuthentication&quot;/>&lt;xsl:param name=&quot;id_rsaFile&quot;/>&lt;xsl:param name=&quot;PasswordDecripter&quot;/>&lt;xsl:param name=&quot;ChannelConnectionTimeout&quot;/>&lt;xsl:template name=&quot;Invoke_SFTP_DirDetail-input&quot; match=&quot;/&quot;>&lt;tns3:JavaInvokeActivityInput>&lt;Host>&lt;xsl:value-of select=&quot;$Start/tns1:Credentials/tns1:Host&quot;/>&lt;/Host>&lt;User>&lt;xsl:value-of select=&quot;$Start/tns1:Credentials/tns1:User&quot;/>&lt;/User>&lt;xsl:if test=&quot;string-length($PasswordDecripter/tns2:DecryptedPassword)>0&quot;>&lt;xsl:if test=&quot;$PasswordDecripter/tns2:DecryptedPassword&quot;>&lt;Password>&lt;xsl:value-of select=&quot;$PasswordDecripter/tns2:DecryptedPassword&quot;/>&lt;/Password>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:RequestType/tns1:ListOfFilesDetails/tns1:DirectoryPath!=''&quot;>&lt;DirectoryPath>&lt;xsl:value-of select=&quot;$Start/tns1:RequestType/tns1:ListOfFilesDetails/tns1:DirectoryPath&quot;/>&lt;/DirectoryPath>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DirectoryPath>&lt;xsl:value-of select=&quot;$Start/tns1:RequestType/tns1:SingleFileDetail&quot;/>&lt;/DirectoryPath>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;Filter>&lt;xsl:value-of select=&quot;$Start/tns1:RequestType/tns1:ListOfFilesDetails/tns1:FileExtensionToFilter&quot;/>&lt;/Filter>&lt;flagKeyAuthentication>&lt;xsl:value-of select=&quot;$flagKeyAuthentication&quot;/>&lt;/flagKeyAuthentication>&lt;id_rsaFile>&lt;xsl:value-of select=&quot;$id_rsaFile&quot;/>&lt;/id_rsaFile>&lt;channel_timeout>&lt;xsl:value-of select=&quot;$ChannelConnectionTimeout&quot;/>&lt;/channel_timeout>&lt;Port>&lt;xsl:value-of select=&quot;$Start/tns1:Credentials/tns1:Port&quot;/>&lt;/Port>&lt;/tns3:JavaInvokeActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.java.javamethod"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:java="http://ns.tibco.com/bw/palette/java" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/java#//JavaMethod"/>
                                    <value
                                    className="tim.now.shared_library.SftpUtility.SFTP_DirDetailJavaCode"
                                    isMultipleOutput="true"
                                    isNew="true"
                                    isNewActivity="true"
                                    methodName="invoke"
                                    methodReturn="void" xsi:type="java:JavaMethod">
                                    <exceptionTypes>java.lang.Exception</exceptionTypes>

                                    <javaActivityParameter
                                    parameterCardinality="Required"
                                    parameterDataType="string"
                                    parameterName="Host" parameterType="IN"/>

                                    <javaActivityParameter
                                    parameterCardinality="Required"
                                    parameterDataType="string"
                                    parameterName="User" parameterType="IN"/>

                                    <javaActivityParameter
                                    parameterCardinality="Optional"
                                    parameterDataType="string"
                                    parameterName="Password" parameterType="IN"/>

                                    <javaActivityParameter
                                    parameterCardinality="Required"
                                    parameterDataType="string"
                                    parameterName="DirectoryPath" parameterType="IN"/>

                                    <javaActivityParameter
                                    parameterCardinality="Required"
                                    parameterDataType="string"
                                    parameterName="Filter" parameterType="IN"/>

                                    <javaActivityParameter
                                    parameterCardinality="Optional"
                                    parameterDataType="boolean"
                                    parameterName="flagKeyAuthentication" parameterType="IN"/>

                                    <javaActivityParameter
                                    parameterCardinality="Optional"
                                    parameterDataType="string"
                                    parameterName="id_rsaFile" parameterType="IN"/>

                                    <javaActivityParameter
                                    parameterCardinality="Optional"
                                    parameterDataType="int"
                                    parameterName="channel_timeout" parameterType="IN"/>

                                    <javaActivityParameter
                                    parameterCardinality="Required"
                                    parameterDataType="string"
                                    parameterName="Status" parameterType="OUT"/>

                                    <javaActivityParameter
                                    parameterCardinality="Repeating"
                                    parameterDataType="string"
                                    parameterName="ListOfFiles" parameterType="OUT"/>

                                    <javaActivityParameter
                                    parameterCardinality="Optional"
                                    parameterDataType="string"
                                    parameterName="Message" parameterType="OUT"/>

                                    <javaActivityParameter
                                    parameterCardinality="Optional"
                                    parameterDataType="int"
                                    parameterName="Port" parameterType="IN"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Log-input" name="Log"
                                    tibex:xpdlId="5ee69ded-032d-4a6c-91ef-778c44f4921a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Invoke_SFTP_DirDetailToLog"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogToSleep"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Tentativo di DirDetail &amp;quot;,string($index),&amp;quot; in errore&amp;quot;)&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Sleep-input"
                                    name="Sleep"
                                    tibex:xpdlId="aa3f6ffe-897f-44fa-910c-5c6244bc0c7f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogToSleep"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SleepToThrow"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/sleep/xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SleepTime_ms&quot;/>&lt;xsl:template name=&quot;Sleep-input&quot; match=&quot;/&quot;>&lt;tns:SleepInputSchema>&lt;IntervalInMillisec>&lt;xsl:value-of select=&quot;$SleepTime_ms&quot;/>&lt;/IntervalInMillisec>&lt;/tns:SleepInputSchema>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.sleep"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Sleep"/>
                                    <value xsi:type="generalactivities:Sleep"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:throw faultName="ns10:DefaultFault"
                                faultVariable="Throw-input" name="Throw" tibex:xpdlId="4b3b490f-8ef9-4113-92f0-5a58f5db6f74">
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Invoke_SFTP_DirDetail&quot;/>&lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&lt;tns:DefaultFault>&lt;xsl:if test=&quot;$Invoke_SFTP_DirDetail/Message&quot;>&lt;message>&lt;xsl:value-of select=&quot;$Invoke_SFTP_DirDetail/Message&quot;/>&lt;/message>&lt;/xsl:if>&lt;msgCode>&lt;xsl:value-of select=&quot;&amp;quot;Errore SFTP_DirDetail&amp;quot;&quot;/>&lt;/msgCode>&lt;/tns:DefaultFault>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="SleepToThrow"/>
                                </bpws:targets>
                            </bpws:throw>
                            <bpws:empty name="Empty" tibex:xpdlId="04d3a6b8-9e80-45ce-a434-803cac53d5f3">
                                <bpws:targets>
                                    <bpws:target linkName="Invoke_SFTP_DirDetailToEmpty"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="EmptyToGroupEnd"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ErrorFault"
                                    name="ERROR"
                                    outputVariable="ErrorFault"
                                    tibex:xpdlId="f28a1fa2-5093-40c2-babd-4278cc625cd4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToGroupEnd"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="tib:render-xml($_error)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ErrorFault" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[boolean($repeatOnError_success_flag)]]></bpws:condition>
                </bpws:repeatUntil>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="TrackingApplicativo-input"
                    name="TrackingApplicativo"
                    tibex:xpdlId="4e53f407-eb91-4050-a73a-773d71d3322a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignKOToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Result&quot;/>&lt;xsl:template name=&quot;TrackingApplicativo-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SFTP_DirDetail&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.shared_library.SFTP_DirDetail&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Insert&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:MsgCode>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Errore tecnico nella DirDetail SFTP', $Result/tns2:Message)&quot;/>&lt;/tns:Message>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;&amp;quot;Error&amp;quot;&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.shared_library.SFTP_DirDetail&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Insert&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;SFTP_DirDetail_ERROR&amp;quot;&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;&amp;quot;SFTP_DirDetail&amp;quot;&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;tns:ErrorLog>&lt;tns:TimeStamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TimeStamp>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Errore su SFTP_DirDetail&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:ErrorReport>&lt;tns:Msg>&lt;xsl:value-of select=&quot;&amp;quot;Errore su SFTP_DirDetail&amp;quot;&quot;/>&lt;/tns:Msg>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:MsgCode>&lt;tns:Data/>&lt;/tns:ErrorReport>&lt;/tns:ErrorLog>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Result"
                    name="SetKONOFILE" outputVariable="Result"
                    tibex:xpdlId="2e807943-ba05-4449-baaf-b50fb5366120" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatOnErrorToAssign1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign1ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SFTP_DirDetailJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Result&quot; match=&quot;/&quot;>&lt;tns:Output_SFTP_DirDetail>&lt;tns:Status>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Status>&lt;tns:Message>&lt;xsl:value-of select=&quot;'FILE NON TROVATO'&quot;/>&lt;/tns:Message>&lt;/tns:Output_SFTP_DirDetail>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Result" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
