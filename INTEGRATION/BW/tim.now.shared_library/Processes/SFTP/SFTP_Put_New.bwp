            <bpws:scope name="RepeatOnError" tibex:group="repeatOnError" tibex:xpdlId="1d0294f3-d152-4380-8272-801bff6b2695">
                <bpws:targets>
                    <bpws:target linkName="Decrypt_PasswordToRepeatOnError"/>
                    <bpws:target linkName="LogKeyToRepeatOnError"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatOnErrorToAssignOK">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Call_SFTP/Status = 'OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Call_SFTP/Status = 'OK']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="RepeatOnErrorToAssignKO">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable name="repeatOnError_success_flag"
                        sca-bpel:internal="true" type="xsd:boolean"/>
                    <bpws:variable name="FaultName"
                        sca-bpel:internal="true" type="xsd:string"/>
                    <bpws:variable element="ns:FaultDetail"
                        name="FaultDetails" sca-bpel:internal="true"/>
                </bpws:variables>
                <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                    <tibex:DesignExpression>
                        <tibex:expression
                            expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:scope name="innerScope">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails" tibex:faultNameVar="FaultName">
                                <bpws:if name="if">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index>$MaxRetrials" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index>$MaxRetrials]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow"/>
                                    <bpws:else>
                                    <bpws:assign name="Assign1" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                </bpws:if>
                            </bpws:catchAll>
                        </bpws:faultHandlers>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToCall_SFTP" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Call_SFTPToLog1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Call_SFTPToLog" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="LogToSleep" tibex:linkType="SUCCESS"/>
                                <bpws:link name="SleepToThrow" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log1ToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="28dbab26-13d8-4154-bc88-636c65fee84e">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToCall_SFTP"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:assign name="GroupEnd"
                                tibex:group="groupEnd"
                                tibex:xpdlId="27d6dcd8-7655-403b-9eed-c5298d260d4f" validate="no">
                                <bpws:targets>
                                    <bpws:target linkName="Log1ToGroupEnd"/>
                                </bpws:targets>
                                <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[true()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                </bpws:copy>
                            </bpws:assign>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Call_SFTP-input"
                                    name="Call_SFTP"
                                    outputVariable="Call_SFTP"
                                    tibex:xpdlId="3b8229be-38c1-4f95-af89-2f78f1c92a72" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCall_SFTP"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Call_SFTPToLog1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Call_SFTP/Status = 'OK' or $index>$MaxRetrials" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Call_SFTP/Status = 'OK' or $index>$MaxRetrials]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Call_SFTPToLog">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+3b8229be-38c1-4f95-af89-2f78f1c92a72+JavaInvokeActivityInput&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; xmlns:tns2=&quot;http://www.example.org/Decryption&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Decrypt_Password&quot;/>&lt;xsl:param name=&quot;flagKeyAuthentication&quot;/>&lt;xsl:param name=&quot;id_rsaFile&quot;/>&lt;xsl:param name=&quot;ChannelConnectionTimeout&quot;/>&lt;xsl:template name=&quot;Call_SFTP-input&quot; match=&quot;/&quot;>&lt;tns:JavaInvokeActivityInput>&lt;FileToBeSend>&lt;xsl:value-of select=&quot;$Start/tns1:FileToBeSend&quot;/>&lt;/FileToBeSend>&lt;RomoteDirectory>&lt;xsl:value-of select=&quot;$Start/tns1:RomoteDirectory&quot;/>&lt;/RomoteDirectory>&lt;Host>&lt;xsl:value-of select=&quot;$Start/tns1:Credentials/tns1:Host&quot;/>&lt;/Host>&lt;Port>&lt;xsl:value-of select=&quot;$Start/tns1:Credentials/tns1:Port&quot;/>&lt;/Port>&lt;User>&lt;xsl:value-of select=&quot;$Start/tns1:Credentials/tns1:User&quot;/>&lt;/User>&lt;xsl:if test=&quot;string-length($Decrypt_Password/tns2:DecryptedPassword)>0&quot;>&lt;xsl:if test=&quot;$Decrypt_Password/tns2:DecryptedPassword&quot;>&lt;Password>&lt;xsl:value-of select=&quot;$Decrypt_Password/tns2:DecryptedPassword&quot;/>&lt;/Password>&lt;/xsl:if>&lt;/xsl:if>&lt;id_rsaFile>&lt;xsl:value-of select=&quot;$id_rsaFile&quot;/>&lt;/id_rsaFile>&lt;flagKeyAuthentication>&lt;xsl:value-of select=&quot;$flagKeyAuthentication&quot;/>&lt;/flagKeyAuthentication>&lt;channel_timeout>&lt;xsl:value-of select=&quot;$ChannelConnectionTimeout&quot;/>&lt;/channel_timeout>&lt;/tns:JavaInvokeActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
