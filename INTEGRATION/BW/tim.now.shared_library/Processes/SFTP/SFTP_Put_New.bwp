                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Call_SFTP&quot;/>&lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&lt;tns:SFTP_Put_Output>&lt;tns:Status>&lt;xsl:value-of select=&quot;$Call_SFTP/Status&quot;/>&lt;/tns:Status>&lt;xsl:if test=&quot;$Call_SFTP/Message&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;$Call_SFTP/Message&quot;/>&lt;/tns:Message>&lt;/xsl:if>&lt;/tns:SFTP_Put_Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
