                            </bpws:assign>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="InvokeSFTP_DirDetail-input"
                                    name="InvokeSFTP_DirDetail"
                                    outputVariable="InvokeSFTP_DirDetail"
                                    tibex:xpdlId="382f9218-08aa-4b63-ae34-b738ed58e3ee" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToInvokeSFTP_DirDetail"/>
