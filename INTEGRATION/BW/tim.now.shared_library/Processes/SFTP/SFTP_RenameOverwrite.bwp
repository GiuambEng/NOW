                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="InvokeSFTP_DirDetailToLog">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$InvokeSFTP_DirDetail/result=1 and $index&lt;=$MaxRetrials" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$InvokeSFTP_DirDetail/result=1 and $index<=$MaxRetrials]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+382f9218-08aa-4b63-ae34-b738ed58e3ee+JavaInvokeActivityInput&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_RenameJavaCode&quot; xmlns:tns2=&quot;http://www.example.org/Decryption&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;flagKeyAuthentication&quot;/>&lt;xsl:param name=&quot;id_rsaFile&quot;/>&lt;xsl:param name=&quot;ChannelConnectionTimeout&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;PasswordDecripter&quot;/>&lt;xsl:template name=&quot;InvokeSFTP_DirDetail-input&quot; match=&quot;/&quot;>&lt;tns:JavaInvokeActivityInput>&lt;host>&lt;xsl:value-of select=&quot;$Start/tns1:credenziali/tns1:Host&quot;/>&lt;/host>&lt;port>&lt;xsl:value-of select=&quot;$Start/tns1:credenziali/tns1:Port&quot;/>&lt;/port>&lt;user>&lt;xsl:value-of select=&quot;$Start/tns1:credenziali/tns1:User&quot;/>&lt;/user>&lt;xsl:if test=&quot;string-length($PasswordDecripter/tns2:DecryptedPassword)>0&quot;>&lt;xsl:if test=&quot;$PasswordDecripter/tns2:DecryptedPassword&quot;>&lt;pass>&lt;xsl:value-of select=&quot;$PasswordDecripter/tns2:DecryptedPassword&quot;/>&lt;/pass>&lt;/xsl:if>&lt;/xsl:if>&lt;source>&lt;xsl:value-of select=&quot;$Start/tns1:source&quot;/>&lt;/source>&lt;dest>&lt;xsl:value-of select=&quot;$Start/tns1:dest&quot;/>&lt;/dest>&lt;id_rsaFile>&lt;xsl:value-of select=&quot;$id_rsaFile&quot;/>&lt;/id_rsaFile>&lt;flagKeyAuthentication>&lt;xsl:value-of select=&quot;$flagKeyAuthentication&quot;/>&lt;/flagKeyAuthentication>&lt;channel_timeout>&lt;xsl:value-of select=&quot;$ChannelConnectionTimeout&quot;/>&lt;/channel_timeout>&lt;/tns:JavaInvokeActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.java.javamethod"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
