    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/Decryption"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/SFTP_RenameJavaCode"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ActivityInput" name="LogKey-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ActivityInput"
            name="LogPassword-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ActivityInput"
            name="LogPasswordKO-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:JavaInvokeActivityInput"
            name="InvokeSFTP_DirDetail-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:JavaInvokeActivityOutput"
            name="InvokeSFTP_DirDetail" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ActivityInput"
            name="LogSFTP_DirDetail-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:Input"
            name="PasswordDecripter-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:Output" name="PasswordDecripter" sca-bpel:internal="true"/>
        <bpws:variable name="flagKeyAuthentication"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Connections/SFTP/flagKeyAuthentication" type="xsd:boolean"/>
        <bpws:variable element="tns:SFTP_RenameJavaCodeInput"
            name="Start" sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:ActivityInput"
            name="ErrLogPassDecripter-input" sca-bpel:internal="true"/>
        <bpws:variable element="tns:SFTP_RenameJavaCodeOutput" name="Result"/>
        <bpws:variable element="tns:SFTP_RenameJavaCodeOutput"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="id_rsaFile" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connections/SFTP/id_rsaFile" type="xsd:string"/>
        <bpws:variable name="ChannelConnectionTimeout"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Connections/SFTP/ChannelConnectionTimeout" type="xsd:int"/>
        <bpws:variable element="ns0:ActivityInput" name="Log-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:SleepInputSchema" name="Sleep-input" sca-bpel:internal="true"/>
        <bpws:variable name="MaxRetrials" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connections/SFTP/MaxRetrials" type="xsd:int"/>
        <bpws:variable name="SleepTime_ms" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connections/SFTP/SleepTime_ms" type="xsd:int"/>
        <bpws:variable element="ns6:DefaultFault" name="Throw-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:CW_BUS_MESSAGE"
            name="TrackingApplicativo-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToLog" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartToLog1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartToLog2" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Log1ToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="PasswordDecripterToRepeatOnError" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="RepeatOnErrorToLogSFTP_DirDetail" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log3ToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Log2ToAssign1" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogKeyToRepeatOnError" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log3ToAssign3" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Assign3ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="PasswordKOToTrackingApplicativo" tibex:linkType="SUCCESS"/>
                <bpws:link name="PasswordDecripterToLog" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogToAssign4" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="AssignErrorOnDecripterToTrackingApplicativo" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignKOToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="084bef4c-4724-4bda-bb6f-edb68f7adc7e"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLog">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$flagKeyAuthentication=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$flagKeyAuthentication=true()]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToLog1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="not($flagKeyAuthentication=true()) and string-length($Start/tns:credenziali/tns:Password)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[not($flagKeyAuthentication=true()) and string-length($Start/tns:credenziali/tns:Password)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToLog2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="e41d9ec4-3b80-4f20-8e7d-bd511175f9ee" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Assign3ToEnd"/>
                        <bpws:target linkName="CallProcessToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SFTP_RenameJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Result&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:SFTP_RenameJavaCodeOutput>&lt;xsl:if test=&quot;$Result/tns:Status&quot;>&lt;tns:Status>&lt;xsl:value-of select=&quot;$Result/tns:Status&quot;/>&lt;/tns:Status>&lt;/xsl:if>&lt;xsl:if test=&quot;$Result/tns:Message&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;$Result/tns:Message&quot;/>&lt;/tns:Message>&lt;/xsl:if>&lt;/tns:SFTP_RenameJavaCodeOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogKey-input"
                    name="LogKey"
                    tibex:xpdlId="a08a0800-58ec-4d84-be12-fb4e603285d8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogKeyToRepeatOnError"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;LogKey-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;Public Key Authentication&amp;quot;&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogPassword-input" name="LogPassword"
                    tibex:xpdlId="226d0ca0-c606-4238-aa2d-f1683f713829" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLog1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log1ToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;LogPassword-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;Begin to Encrypt Password&amp;quot;&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
