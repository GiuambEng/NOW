        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToStartFileScarto" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartFileScartoToIterate" tibex:linkType="SUCCESS"/>
                <bpws:link name="IterateToLog2" tibex:linkType="SUCCESS"/>
                <bpws:link name="EndFileScartoToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="606297f8-a144-4b35-9092-9e8b0e97e8db"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToStartFileScarto"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="6a557af7-70c9-4021-a08f-2adf8dcc7b8a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EndFileScartoToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.dinamicSubProcess.FileScarto&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Esito>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="StartFileScarto-input"
                    name="StartFileScarto"
                    tibex:xpdlId="fe6b1981-e75a-407c-a915-105b033fd1f1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToStartFileScarto"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartFileScartoToIterate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;'Inizio scrittura'&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="9c1416b9-a45c-4cce-98ff-618490ff11f1">
                <bpws:targets>
                    <bpws:target linkName="StartFileScartoToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToLog2"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$Start/ns1:row" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/ns1:row)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns1:Iterate_Current_Element_row"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link name="GroupStartToVLAN" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="VLANToAssign" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="PathFileToWriteFile" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="WriteFileToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="c74a2e05-fbd0-4452-9d20-600a3ec5c3ea" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToVLAN"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns1:row)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="fcfd81a3-e742-4881-b0f3-84bb850dcd8a">
                                    <bpws:targets>
                                    <bpws:target linkName="WriteFileToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="VLAN-input"
                                    name="VLAN"
                                    outputVariable="VLAN"
                                    tibex:xpdlId="db9bf511-e703-4113-b0f3-abe150019fe6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToVLAN"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VLANToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.crea.file.scarto&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/render/xsd/+db9bf511-e703-4113-b0f3-abe150019fe6+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVLAN_Noval&quot; xmlns:tns2=&quot;www.tim.now.dinamicSubProcess.FileScarto&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVLAN_FileScarto&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;VLAN-input&quot; match=&quot;/&quot;>&lt;tns:Rows>&lt;tns3:AllineamentoVLAN_Dettaglio_FileScarto>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='COD_VLAN']/tns2:value&quot;>&lt;tns3:IDVLAN>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='COD_VLAN']/tns2:value&quot;/>&lt;/tns3:IDVLAN>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='TIPO_BANDA']/tns2:value&quot;>&lt;tns3:TIPO_BANDA>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='TIPO_BANDA']/tns2:value&quot;/>&lt;/tns3:TIPO_BANDA>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='TIPO_COS']/tns2:value&quot;>&lt;tns3:TIPO_COS>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='TIPO_COS']/tns2:value&quot;/>&lt;/tns3:TIPO_COS>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='CODFC_OLO_AGCOM']/tns2:value&quot;>&lt;tns3:OLO_CODING>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='CODFC_OLO_AGCOM']/tns2:value&quot;/>&lt;/tns3:OLO_CODING>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='COD_OLO']/tns2:value&quot;>&lt;tns3:OLO_CODE>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='COD_OLO']/tns2:value&quot;/>&lt;/tns3:OLO_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='CODFC_OLO_AGCOM_SUB']/tns2:value&quot;>&lt;tns3:OLO_CONDIG_SUB>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='CODFC_OLO_AGCOM_SUB']/tns2:value&quot;/>&lt;/tns3:OLO_CONDIG_SUB>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='COD_OLO_SUB']/tns2:value&quot;>&lt;tns3:OLO_CODE_SUB>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='COD_OLO_SUB']/tns2:value&quot;/>&lt;/tns3:OLO_CODE_SUB>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='STATO_SUB']/tns2:value&quot;>&lt;tns3:STATO_SUB>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='STATO_SUB']/tns2:value&quot;/>&lt;/tns3:STATO_SUB>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='DATA_ATTIVAZIONE_SUB']/tns2:value&quot;>&lt;tns3:DATA_ATTIVAZIOE_SUB>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='DATA_ATTIVAZIONE_SUB']/tns2:value&quot;/>&lt;/tns3:DATA_ATTIVAZIOE_SUB>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='DATA_CESSAZIONE_SUB']/tns2:value&quot;>&lt;tns3:DATA_CESSAZIONE_SUB>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='DATA_CESSAZIONE_SUB']/tns2:value&quot;/>&lt;/tns3:DATA_CESSAZIONE_SUB>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='FLAG_ENCAPSULATION']/tns2:value&quot;>&lt;tns3:ENCAPSULATION>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='FLAG_ENCAPSULATION']/tns2:value&quot;/>&lt;/tns3:ENCAPSULATION>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='TIPOLG']/tns2:value&quot;>&lt;tns3:TIPOLOGIA>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='TIPOLG']/tns2:value&quot;/>&lt;/tns3:TIPOLOGIA>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='STATO']/tns2:value&quot;>&lt;tns3:STATO>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='STATO']/tns2:value&quot;/>&lt;/tns3:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='NOME']/tns2:value&quot;>&lt;tns3:NOME>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='NOME']/tns2:value&quot;/>&lt;/tns3:NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='CLLI']/tns2:value&quot;>&lt;tns3:CLLI>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='CLLI']/tns2:value&quot;/>&lt;/tns3:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='NOME_CENTRALE']/tns2:value&quot;>&lt;tns3:NOME_CENTRALE>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='NOME_CENTRALE']/tns2:value&quot;/>&lt;/tns3:NOME_CENTRALE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='COD_KIT']/tns2:value&quot;>&lt;tns3:TD_KIT>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='COD_KIT']/tns2:value&quot;/>&lt;/tns3:TD_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='DEC']/tns2:value&quot;>&lt;tns3:DEC>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='DEC']/tns2:value&quot;/>&lt;/tns3:DEC>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='DEC_ATTIVAZIONE']/tns2:value&quot;>&lt;tns3:DEC_ATT>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='DEC_ATTIVAZIONE']/tns2:value&quot;/>&lt;/tns3:DEC_ATT>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='COD_AREA_RACCOLTA']/tns2:value&quot;>&lt;tns3:ADR_CODE>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='COD_AREA_RACCOLTA']/tns2:value&quot;/>&lt;/tns3:ADR_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='DESC_AREA_RACCOLTA']/tns2:value&quot;>&lt;tns3:ADR_DESC>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='DESC_AREA_RACCOLTA']/tns2:value&quot;/>&lt;/tns3:ADR_DESC>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='COD_MACRO_AREA']/tns2:value&quot;>&lt;tns3:MACRO_AREA_CODE>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='COD_MACRO_AREA']/tns2:value&quot;/>&lt;/tns3:MACRO_AREA_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='DESC_MACRO_AREA']/tns2:value&quot;>&lt;tns3:MACRO_AREA_DESC>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='DESC_MACRO_AREA']/tns2:value&quot;/>&lt;/tns3:MACRO_AREA_DESC>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='COD_SUPER_MACRO_AREA']/tns2:value&quot;>&lt;tns3:SUPER_MACRO_AREA_CODE>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='COD_SUPER_MACRO_AREA']/tns2:value&quot;/>&lt;/tns3:SUPER_MACRO_AREA_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='DESC_SUPER_MACRO_AREA']/tns2:value&quot;>&lt;tns3:SUPER_MACRO_AREA_DESC>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='DESC_SUPER_MACRO_AREA']/tns2:value&quot;/>&lt;/tns3:SUPER_MACRO_AREA_DESC>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='TIPO_TRASPORTO']/tns2:value&quot;>&lt;tns3:TIPO_TRASPORTO>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='TIPO_TRASPORTO']/tns2:value&quot;/>&lt;/tns3:TIPO_TRASPORTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='ID_VLAN_OLO']/tns2:value&quot;>&lt;tns3:IDVLANOLO>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='ID_VLAN_OLO']/tns2:value&quot;/>&lt;/tns3:IDVLANOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='FLAG_VLAN_TRANSLATION']/tns2:value&quot;>&lt;tns3:FLAG_VLAN_TRANSLATION>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='FLAG_VLAN_TRANSLATION']/tns2:value&quot;/>&lt;/tns3:FLAG_VLAN_TRANSLATION>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns2:column[tns2:name='DSLAM_TYPE']/tns2:value&quot;>&lt;tns3:DSLAM_TYPE>&lt;xsl:value-of select=&quot;$currentElement/tns2:column[tns2:name='DSLAM_TYPE']/tns2:value&quot;/>&lt;/tns3:DSLAM_TYPE>&lt;/xsl:if>&lt;/tns3:AllineamentoVLAN_Dettaglio_FileScarto>&lt;/tns:Rows>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.parse.renderdata"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:parse="http://ns.tibco.com/bw/palette/parse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/parse#//RenderData"/>
                                    <value
                                    dataFormat="dataFormatResourceProperty" xsi:type="parse:RenderData"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="PathFile"
                                    name="PathFile"
                                    outputVariable="PathFile"
                                    tibex:xpdlId="8ebde82f-db40-4721-a151-e9d769843a04" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VLANToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="PathFileToWriteFile"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if($Start/ns1:Tipologia_Processo='ALLINEAMENTO') then (concat($PathFileScarto_Allineamento, $NomeFileScarto, format-date(current-date(), &quot;[Y0001][M01][D01]&quot;), $Estensione)) else (concat($PathFileScartoVLAN, $NomeFileScarto, format-date(current-date(), &quot;[Y0001][M01][D01]&quot;), $Estensione))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="PathFile" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="WriteFile-input"
                                    name="WriteFile"
                                    outputVariable="WriteFile"
                                    tibex:xpdlId="4e257aa8-48aa-455a-9cd6-2f31ba2695f0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="PathFileToWriteFile"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="WriteFileToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PathFile&quot;/>&lt;xsl:param name=&quot;VLAN&quot;/>&lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&lt;tns:WriteActivityInputTextClass>&lt;fileName>&lt;xsl:value-of select=&quot;$PathFile&quot;/>&lt;/fileName>&lt;textContent>&lt;xsl:value-of select=&quot;$VLAN&quot;/>&lt;/textContent>&lt;/tns:WriteActivityInputTextClass>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.file.write"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//WriteFile"/>
                                    <value
                                    append="true"
                                    compressFile="None"
                                    encoding="text" xsi:type="file:WriteFile"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="EndFileScarto-input"
                    name="EndFileScarto"
                    tibex:xpdlId="6144e013-981e-4756-afd6-7112beea5d90" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IterateToLog2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="EndFileScartoToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Log2-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;'fine scrittura file di scarto'&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
