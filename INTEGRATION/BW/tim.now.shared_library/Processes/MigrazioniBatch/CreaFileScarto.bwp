    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="CondizioneCicloToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="StarToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="FineSelectToReply" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:receive createInstance="yes" name="Start"
                operation="Invoke" partnerLink="CreaFile"
                portType="ns1:CreaFile"
                tibex:xpdlId="b3f165fd-d941-4444-92df-05f9323b9ed9" variable="InvokeIn">
                <bpws:sources>
                    <bpws:source linkName="StartToAssign"/>
                </bpws:sources>
                <bpws:correlations/>
