                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogToCreaFileScarto"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_Dinamic&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;$Var_Dinamic&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="FineSelect-input" name="FineSelect"
                    tibex:xpdlId="a3e37d99-865d-4f8a-b9bf-295fbd6e07b6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FineSelectToReply"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;FineSelect-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;'End selct per generazione file di scarto'&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:reply name="Reply" operation="Invoke"
                partnerLink="CreaFile" portType="ns1:CreaFile"
                tibex:xpdlId="df39ae83-152d-4c08-9f82-b98642fdcd36" variable="Reply-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="www.tim.now.output.parse" xmlns:tns="http://xmlns.example.com/1463585496988" xmlns:ns1="http://www.tim.now.sharedlibrary.crea.file.scarto" version="2.0"&gt;&lt;xsl:param name="Accumulate"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:Response&gt;&lt;part1&gt;&lt;ns1:FileScartoOutput&gt;&lt;xsl:for-each select="$Accumulate/ns:Output/ns:row"&gt;&lt;ns1:row&gt;&lt;xsl:for-each select="ns:column"&gt;&lt;ns1:column&gt;&lt;ns1:name&gt;&lt;xsl:value-of select="ns:name"/&gt;&lt;/ns1:name&gt;&lt;ns1:value&gt;&lt;xsl:value-of select="ns:value"/&gt;&lt;/ns1:value&gt;&lt;/ns1:column&gt;&lt;/xsl:for-each&gt;&lt;/ns1:row&gt;&lt;/xsl:for-each&gt;&lt;/ns1:FileScartoOutput&gt;&lt;/part1&gt;&lt;/tns:Response&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.output.parse&quot; xmlns:tns=&quot;http://xmlns.example.com/1463585496988&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.crea.file.scarto&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:FileScartoOutput>&#xa;            &lt;xsl:for-each select=&quot;$Accumulate/ns:Output/ns:row&quot;>&#xa;                &lt;ns1:row>&#xa;                    &lt;xsl:for-each select=&quot;ns:column&quot;>&#xa;                        &lt;ns1:column>&#xa;                            &lt;ns1:name>&#xa;                                &lt;xsl:value-of select=&quot;ns:name&quot;/>&#xa;                            &lt;/ns1:name>&#xa;                            &lt;ns1:value>&#xa;                                &lt;xsl:value-of select=&quot;ns:value&quot;/>&#xa;                            &lt;/ns1:value>&#xa;                        &lt;/ns1:column>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/ns1:row>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns1:FileScartoOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="FineSelectToReply"/>
                </bpws:targets>
            </bpws:reply>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
