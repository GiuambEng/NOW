    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:Output" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns3:Rows" name="Renderdata-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:Text" name="Renderdata" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:WriteActivityInputTextClass"
            name="WriteFile-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:WriteActivityOutputClass"
            name="WriteFile" sca-bpel:internal="true"/>
        <bpws:variable name="dataFormatResourceProperty"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://ns.tibco.com/bw/palette/dataformat}DataFormat" type="xsd:string">
            <bpws:from>
                <bpws:literal>FileScarto.DataFormat_VarAmm</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="PathFile" type="xsd:string"/>
        <bpws:variable name="Estensione" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/FileScarto/Jive/Estensione" type="xsd:string"/>
        <bpws:variable name="PathFileScarto" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/FileScarto/Jive/PathFileScarto" type="xsd:string"/>
        <bpws:variable name="NomeFileScarto" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/FileScarto/Jive/AllineamentoVarAmm/NomeFile" type="xsd:string"/>
        <bpws:variable element="ns4:ActivityInput"
            name="Start_Scrittura-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:ActivityInput"
            name="End_Scrittura-input" sca-bpel:internal="true"/>
        <bpws:variable name="PathFileScartoAllineamento"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/FileScarto/Jive/PathFileScarto_Allineamento" type="xsd:string"/>
    </bpws:variables>
