    <bpws:import importType="http://www.w3.org/2001/XMLSchema"
        location="../../Schemas/CreaFileScarto/dinamicSubProcess.xsd" namespace="www.tim.now.dinamicSubProcess.FileScarto"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ActivityInput"
            name="StartFileScarto-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:Rows" name="VP-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:Text" name="VP" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable name="dataFormatResourceProperty"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://ns.tibco.com/bw/palette/dataformat}DataFormat" type="xsd:string">
            <bpws:from>
                <bpws:literal>FileScarto.DataFormat_AnagraficaVP</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="PathFile" type="xsd:string"/>
        <bpws:variable name="PathFileScartoVP"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/FileScarto/CRMWS/PathFileScarto" type="xsd:string"/>
        <bpws:variable name="Estensione" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/FileScarto/CRMWS/Estensione" type="xsd:string"/>
        <bpws:variable name="NomeFileScarto" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/FileScarto/CRMWS/AllineamentoVP/NomeFile" type="xsd:string"/>
        <bpws:variable element="ns4:WriteActivityInputTextClass"
            name="WriteFile-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:WriteActivityOutputClass"
            name="WriteFile" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ActivityInput"
            name="EndFileScarto-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:Output" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="PathFileScarto_Allineamento"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/FileScarto/CRMWS/PathFileScarto_Allineamento" type="xsd:string"/>
    </bpws:variables>
