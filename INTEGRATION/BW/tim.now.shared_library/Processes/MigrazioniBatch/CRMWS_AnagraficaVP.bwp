            <bpws:links>
                <bpws:link name="StartToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToIterate" tibex:linkType="SUCCESS"/>
                <bpws:link name="IterateToLog2" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log2ToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="e987e604-65e1-4379-a63c-2f7f692ca97a"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLog"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="5a1a6cf6-31a9-47c6-ad4a-99a54499f98b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log2ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.dinamicSubProcess.FileScarto&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Esito>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="StartFileScarto-input"
                    name="StartFileScarto"
                    tibex:xpdlId="b440884b-4300-4397-a452-43f08281687a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToIterate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;'Inizio scrittura'&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="4b724b54-9f93-4ddb-9cba-cdfe173dba6d">
                <bpws:targets>
                    <bpws:target linkName="LogToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToLog2"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$Start/ns2:row" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/ns2:row)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns2:Iterate_Current_Element_row"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link name="GroupStartToVP" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="VPToAssign" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="PathFileToWriteFile" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="WriteFileToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="c71fed2d-a65c-4ed5-96a2-82a77066bdc8" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToVP"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns2:row)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="91348878-c5a3-48d1-b3b3-528dba708022">
                                    <bpws:targets>
                                    <bpws:target linkName="WriteFileToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="VP-input"
                                    name="VP" outputVariable="VP"
                                    tibex:xpdlId="6720fd8a-4435-401b-a573-13477095e888" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToVP"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VPToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.crea.file.scarto&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/render/xsd/+6720fd8a-4435-401b-a573-13477095e888+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVP_Tracciato&quot; xmlns:tns1=&quot;www.tim.now.dinamicSubProcess.FileScarto&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/tim.now.schema.xsd.NOW_AllineamentoVP_FileScarto&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;VP-input&quot; match=&quot;/&quot;>&lt;tns:Rows>&lt;tns3:AllineamentoVP_Dettaglio_FileScarto>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='COD_VP']/tns1:value&quot;>&lt;tns3:ID_RISORSA>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='COD_VP']/tns1:value&quot;/>&lt;/tns3:ID_RISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='STATO']/tns1:value&quot;>&lt;tns3:STATO>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='STATO']/tns1:value&quot;/>&lt;/tns3:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='MODALITA_FATTURAZIONE']/tns1:value&quot;>&lt;tns3:MOD_FATT>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='MODALITA_FATTURAZIONE']/tns1:value&quot;/>&lt;/tns3:MOD_FATT>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='TIPO']/tns1:value&quot;>&lt;tns3:TIPO>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='TIPO']/tns1:value&quot;/>&lt;/tns3:TIPO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='BANDA_MCR']/tns1:value&quot;>&lt;tns3:BANDA_MCR>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='BANDA_MCR']/tns1:value&quot;/>&lt;/tns3:BANDA_MCR>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='BANDA_PCR']/tns1:value&quot;>&lt;tns3:BANDA_PCR>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='BANDA_PCR']/tns1:value&quot;/>&lt;/tns3:BANDA_PCR>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='NUMERO_MAX_VC']/tns1:value&quot;>&lt;tns3:NR_MAX_VC>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='NUMERO_MAX_VC']/tns1:value&quot;/>&lt;/tns3:NR_MAX_VC>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='COD_AREA_RACCOLTA']/tns1:value&quot;>&lt;tns3:ADR_CODE>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='COD_AREA_RACCOLTA']/tns1:value&quot;/>&lt;/tns3:ADR_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='DESC_AREA_RACCOLTAP']/tns1:value&quot;>&lt;tns3:DESC_ADR>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='DESC_AREA_RACCOLTAP']/tns1:value&quot;/>&lt;/tns3:DESC_ADR>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='COD_KIT']/tns1:value&quot;>&lt;tns3:TD_KIT>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='COD_KIT']/tns1:value&quot;/>&lt;/tns3:TD_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='VPI_RETE']/tns1:value&quot;>&lt;tns3:VPI_RETE>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='VPI_RETE']/tns1:value&quot;/>&lt;/tns3:VPI_RETE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='VPI']/tns1:value&quot;>&lt;tns3:VPI>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='VPI']/tns1:value&quot;/>&lt;/tns3:VPI>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='CODFC_OLO_AGCOM']/tns1:value&quot;>&lt;tns3:OLO_CODING>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='CODFC_OLO_AGCOM']/tns1:value&quot;/>&lt;/tns3:OLO_CODING>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='COD_OLO']/tns1:value&quot;>&lt;tns3:OLO_CODE>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='COD_OLO']/tns1:value&quot;/>&lt;/tns3:OLO_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='TIPO_TRASPORTO']/tns1:value&quot;>&lt;tns3:TIPO_TRASPORTO>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='TIPO_TRASPORTO']/tns1:value&quot;/>&lt;/tns3:TIPO_TRASPORTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='CLLI']/tns1:value&quot;>&lt;tns3:CLLI>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='CLLI']/tns1:value&quot;/>&lt;/tns3:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='NOME_CENTRALE']/tns1:value&quot;>&lt;tns3:NOME_CENTRALE>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='NOME_CENTRALE']/tns1:value&quot;/>&lt;/tns3:NOME_CENTRALE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='DEC_ATTIVAZIONE']/tns1:value&quot;>&lt;tns3:DEC_ATT>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='DEC_ATTIVAZIONE']/tns1:value&quot;/>&lt;/tns3:DEC_ATT>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:column[tns1:name='DEC']/tns1:value&quot;>&lt;tns3:DEC>&lt;xsl:value-of select=&quot;$currentElement/tns1:column[tns1:name='DEC']/tns1:value&quot;/>&lt;/tns3:DEC>&lt;/xsl:if>&lt;/tns3:AllineamentoVP_Dettaglio_FileScarto>&lt;/tns:Rows>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.parse.renderdata"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:parse="http://ns.tibco.com/bw/palette/parse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/parse#//RenderData"/>
                                    <value
                                    dataFormat="dataFormatResourceProperty" xsi:type="parse:RenderData"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="PathFile"
                                    name="PathFile"
                                    outputVariable="PathFile"
                                    tibex:xpdlId="eef5e4e6-3264-4a09-99a7-987f73c7ca48" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VPToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="PathFileToWriteFile"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if($Start/ns2:Tipologia_Processo='ALLINEAMENTO') then (concat($PathFileScarto_Allineamento, $NomeFileScarto, format-date(current-date(), &quot;[Y0001][M01][D01]&quot;), $Estensione)) else (concat($PathFileScartoVP, $NomeFileScarto, format-date(current-date(), &quot;[Y0001][M01][D01]&quot;), $Estensione))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="PathFile" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="WriteFile-input"
                                    name="WriteFile"
                                    outputVariable="WriteFile"
                                    tibex:xpdlId="e7274b64-d871-4a42-8342-bb5021b5c094" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="PathFileToWriteFile"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="WriteFileToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PathFile&quot;/>&lt;xsl:param name=&quot;VP&quot;/>&lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&lt;tns:WriteActivityInputTextClass>&lt;fileName>&lt;xsl:value-of select=&quot;$PathFile&quot;/>&lt;/fileName>&lt;textContent>&lt;xsl:value-of select=&quot;$VP&quot;/>&lt;/textContent>&lt;/tns:WriteActivityInputTextClass>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.file.write"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//WriteFile"/>
                                    <value
                                    append="true"
                                    compressFile="None"
                                    encoding="text" xsi:type="file:WriteFile"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="EndFileScarto-input"
                    name="EndFileScarto"
                    tibex:xpdlId="e4683777-85f2-4b99-b1ed-71e88d25e8d0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IterateToLog2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log2ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Log2-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;'fine scrittura file di scarto'&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
