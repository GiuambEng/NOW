                <bpws:extensionActivity>
                    <tibex:activityExtension
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InsertIn&quot;/>&lt;xsl:template name=&quot;VarOutput&quot; match=&quot;/&quot;>&lt;ns:Output>&lt;ns:Esito>&lt;ns:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns:Esito>&lt;ns:DescEsito>&lt;xsl:value-of select=&quot;'Aggiornamento Processo No File eseguito con successo'&quot;/>&lt;/ns:DescEsito>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:EsecuzioneNOFileProcessato/ns:COD_PROCSO_FILE&quot;>&lt;ns:COD_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:EsecuzioneNOFileProcessato/ns:COD_PROCSO_FILE&quot;/>&lt;/ns:COD_PROCSO_NO_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:EsecuzioneNOFileProcessato/ns:ID_ESEC_PROCSO_NO_FILE&quot;>&lt;ns:ID_ESEC_PROCSO_NOFILE>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:EsecuzioneNOFileProcessato/ns:ID_ESEC_PROCSO_NO_FILE&quot;/>&lt;/ns:ID_ESEC_PROCSO_NOFILE>&lt;/xsl:if>&lt;/ns:Esito>&lt;/ns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
