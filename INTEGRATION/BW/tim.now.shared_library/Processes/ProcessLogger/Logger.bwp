:Value&quot;>&#xa;                            &lt;ns:CORRELATION_ID>&#xa;                                &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:EsecuzioneNOFileProcessato/ns:CorrelationID/ns:Value&quot;/>&#xa;                            &lt;/ns:CORRELATION_ID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length(xsd:string($Sequence_CorrID/Record[1]/NEXTVAL))>0&quot;>&#xa;                        &lt;ns:CORRELATION_ID>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($Sequence_CorrID/Record[1]/NEXTVAL)&quot;/>&#xa;                        &lt;/ns:CORRELATION_ID>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ns:Esito>&#xa;        &lt;/ns:Output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
