xsd:integer($Sequence/Record[1]/NEXTVAL)&quot;/>&#xa;                    &lt;/ns:ID_FILE_PROCSTO_OUTPUT>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI&quot;>&#xa;                &lt;ns:QT_RECD_TOTALI>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI&quot;/>&#xa;                &lt;/ns:QT_RECD_TOTALI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE&quot;>&#xa;                &lt;ns:TIMSTP_CREZIONE_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE&quot;/>&#xa;                &lt;/ns:TIMSTP_CREZIONE_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessatoOutput/ns:TIMSTP_INVIO&quot;>&#xa;                &lt;ns:TIMSTP_INVIO>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessatoOutput/ns:TIMSTP_INVIO&quot;/>&#xa;                &lt;/ns:TIMSTP_INVIO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:FileProcessatoOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
