                                    sqlStatement="INSERT INTO CONTENUTO_FILE (CONTENUTO_FILE, ID_CONTENUTO_FILE, ID_FILE)&#xd;&#xa;VALUES (RAWTOHEX(?), S_CONTENUTO_FILE.nextval, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
