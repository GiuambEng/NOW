                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FindCod&quot;/>&#xa;    &lt;xsl:param name=&quot;FindIDs&quot;/>&#xa;    &lt;xsl:template name=&quot;VarLogFileProcessato&quot; match=&quot;/&quot;>&#xa;        &lt;ns:LogFileProcessato>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($InsertIn.part1/ns:LogFileProcessato/ns:COD_PROCSO)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$InsertIn.part1/ns:LogFileProcessato/ns:COD_PROCSO&quot;>&#xa;                        &lt;ns:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:LogFileProcessato/ns:COD_PROCSO&quot;/>&#xa;                        &lt;/ns:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$FindCod/Record[1]/COD_PROCSO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$FindCod/Record[1]/COD_PROCSO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($InsertIn.part1/ns:LogFileProcessato/ns:ID_ESEC_PROCSO))>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$InsertIn.part1/ns:LogFileProcessato/ns:ID_ESEC_PROCSO&quot;>&#xa;                        &lt;ns:ID_ESEC_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsertIn.part1/ns: