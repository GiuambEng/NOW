                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO FILE_PROCSTO_INPUT (DATA_ARRIVO, DIMENSIONE_FILE, ID_CAUS_SCARTO,&#xa;  ID_FILE_PROCSTO_INPUT, QT_RECD_KO, QT_RECD_OK, QT_RECD_TOTALI)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_ARRIVO"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="DIMENSIONE_FILE"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_CAUS_SCARTO"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE_PROCSTO_INPUT"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="QT_RECD_KO"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="QT_RECD_OK"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="QT_RECD_TOTALI"/>
                                    </value>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:activityExtension
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Sequence&quot;/>&lt;xsl:param name=&quot;VarFileProcessato&quot;/>&lt;xsl:param name=&quot;VarEsecuzioneFileProcessato&quot;/>&lt;xsl:param name=&quot;InsertIn&quot;/>&lt;xsl:template name=&quot;VarOutput&quot; match=&quot;/&quot;>&lt;ns:Output>&lt;ns:Esito>&lt;ns:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns:Esito>&lt;ns:DescEsito>&lt;xsl:value-of select=&quot;'Operazione di Inserimento Eseguita con Successo'&quot;/>&lt;/ns:DescEsito>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InsertIn/part1/ns:Input/ns:FileProcessato/ns:ID_FILE) and string-length($InsertIn/part1/ns:Input/ns:ContenutoFile/ns:Token)>0&quot;>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;string(xsd:int($InsertIn/part1/ns:Input/ns:FileProcessato/ns:ID_FILE))&quot;/>&lt;/ns:ID_FILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;string(xsd:int($Sequence/Record[1]/NEXTVAL))&quot;/>&lt;/ns:ID_FILE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$VarFileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;>&lt;ns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;$VarFileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;/>&lt;/ns:ID_ESEC_PROCSO_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$VarFileProcessato/ns:NOME_FILE&quot;>&lt;ns:NomeFile>&lt;xsl:value-of select=&quot;$VarFileProcessato/ns:NOME_FILE&quot;/>&lt;/ns:NomeFile>&lt;/xsl:if>&lt;xsl:if test=&quot;$VarEsecuzioneFileProcessato/ns:COD_PROCSO_FILE&quot;>&lt;ns:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;$VarEsecuzioneFileProcessato/ns:COD_PROCSO_FILE&quot;/>&lt;/ns:COD_PROCSO_FILE>&lt;/xsl:if>&lt;/ns:Esito>&lt;/ns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                        inputVariable="VarOutput" name="Output"
                        outputVariable="VarOutput"
                        tibex:xpdlId="0682e4f8-10e6-43d4-8c45-dd0b77970c91" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="LogToOutput"/>
                            <bpws:target linkName="Empty1ToOutput"/>
                            <bpws:target linkName="Log2ToOutput"/>
                            <bpws:target linkName="JDBCCallProcedureToOutput"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="OutputToLog"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Sequence&quot;/>&#xa;    &lt;xsl:param name=&quot;VarFileProcessato&quot;/>&#xa;    &lt;xsl:param name=&quot;VarEsecuzioneFileProcessato&quot;/>&#xa;    &lt;xsl:template name=&quot;VarOutput&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Output>&#xa;            &lt;ns:Esito>&#xa;                &lt;ns:Esito>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/ns:Esito>&#xa;                &lt;ns:DescEsito>&#xa;                    &lt;xsl:value-of select=&quot;'Operazione di Inserimento Eseguita con Successo'&quot;/>&#xa;                &lt;/ns:DescEsito>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertIn.part1/ns:FileProcessato/ns:ID_FILE) and string-length($InsertIn.part1/ns:ContenutoFile/ns:Token)>0&quot;>&#xa;                        &lt;ns:ID_FILE>&#xa;                            &lt;xsl:value-of select=&quot;string(xsd:int($InsertIn.part1/ns:FileProcessato/ns:ID_FILE))&quot;/>&#xa;                        &lt;/ns:ID_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ID_FILE>&#xa;                            &lt;xsl:value-of select=&quot;string(xsd:int($Sequence/Record[1]/NEXTVAL))&quot;/>&#xa;                        &lt;/ns:ID_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$VarFileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$VarFileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$VarFileProcessato/ns:NOME_FILE&quot;>&#xa;                    &lt;ns:NomeFile>&#xa;                        &lt;xsl:value-of select=&quot;$VarFileProcessato/ns:NOME_FILE&quot;/>&#xa;                    &lt;/ns:NomeFile>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$VarEsecuzioneFileProcessato/ns:COD_PROCSO_FILE&quot;>&#xa;                    &lt;ns:COD_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$VarEsecuzioneFileProcessato/ns:COD_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:COD_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:Esito>&#xa;        &lt;/ns:Output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.generalactivities.bwassign"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
