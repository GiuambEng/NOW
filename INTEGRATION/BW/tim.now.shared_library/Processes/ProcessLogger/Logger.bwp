/ns:QT_RECD_TOTALI)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessatoInput/ns:QT_RECD_TOTALI&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/QT_RECD_TOTALI>&#xa;            &lt;QT_RECD_NOW>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertIn.part1/ns:FileProcessatoInput/ns:QT_RECD_TOTALI)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessatoInput/ns:QT_RECD_TOTALI&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/QT_RECD_NOW>&#xa;            &lt;ID_FILE_PROCSTO_INPUT>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertIn.part1/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_FILE_PROCSTO_INPUT>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
