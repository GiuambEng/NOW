                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ProcessoNoFile&quot;/>&lt;xsl:param name=&quot;Sequence_NoFile&quot;/>&lt;xsl:param name=&quot;Sequence_CorrID&quot;/>&lt;xsl:param name=&quot;InsertIn&quot;/>&lt;xsl:template name=&quot;VarOutput&quot; match=&quot;/&quot;>&lt;ns:Output>&lt;ns:Esito>&lt;ns:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns:Esito>&lt;ns:DescEsito>&lt;xsl:value-of select=&quot;'Inserimento Processo No File eseguito con successo'&quot;/>&lt;/ns:DescEsito>&lt;xsl:if test=&quot;$ProcessoNoFile/Record[1]/COD_PROCSO_NO_FILE&quot;>&lt;ns:COD_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;$ProcessoNoFile/Record[1]/COD_PROCSO_NO_FILE&quot;/>&lt;/ns:COD_PROCSO_NO_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Sequence_NoFile/Record[1]/NEXTVAL&quot;>&lt;ns:ID_ESEC_PROCSO_NOFILE>&lt;xsl:value-of select=&quot;$Sequence_NoFile/Record[1]/NEXTVAL&quot;/>&lt;/ns:ID_ESEC_PROCSO_NOFILE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string($InsertIn/part1/ns:Input/ns:EsecuzioneNOFileProcessato/ns:CorrelationID/ns:Value))>0&quot;>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:EsecuzioneNOFileProcessato/ns:CorrelationID/ns:Value&quot;>&lt;ns:CORRELATION_ID>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:EsecuzioneNOFileProcessato/ns:CorrelationID/ns:Value&quot;/>&lt;/ns:CORRELATION_ID>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(xsd:string($Sequence_CorrID/Record[1]/NEXTVAL))>0&quot;>&lt;ns:CORRELATION_ID>&lt;xsl:value-of select=&quot;xsd:int($Sequence_CorrID/Record[1]/NEXTVAL)&quot;/>&lt;/ns:CORRELATION_ID>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/ns:Esito>&lt;/ns:Output>&lt;/xsl:template>&lt;