                <bpws:extensionActivity>
                    <tibex:activityExtension
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InsertIn&quot;/>&lt;xsl:param name=&quot;Sequence&quot;/>&lt;xsl:param name=&quot;VarEsecuzioneFileProcessato&quot;/>&lt;xsl:template name=&quot;VarFileProcessato&quot; match=&quot;/&quot;>&lt;ns:FileProcessato>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:COD_OLO&quot;>&lt;ns:COD_OLO>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:COD_OLO&quot;/>&lt;/ns:COD_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;>&lt;ns:CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;/>&lt;/ns:CODFC_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:DATA_FILE&quot;>&lt;ns:DATA_FILE>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:DATA_FILE&quot;/>&lt;/ns:DATA_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:DESCR_STATO_FILE&quot;>&lt;ns:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:DESCR_STATO_FILE&quot;/>&lt;/ns:DESCR_STATO_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:ESITO&quot;>&lt;ns:ESITO>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:ESITO&quot;/>&lt;/ns:ESITO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$InsertIn/part1/ns:Input/ns:TipologiaOperazione='NEW_IDFILE'&quot;>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;>&lt;ns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;/>&lt;/ns:ID_ESEC_PROCSO_FILE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$VarEsecuzioneFileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;>&lt;ns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;$VarEsecuzioneFileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;/>&lt;/ns:ID_ESEC_PROCSO_FILE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InsertIn/part1/ns:Input/ns:FileProcessato/ns:ID_FILE) and string-length($InsertIn/part1/ns:Input/ns:ContenutoFile/ns:Token)>0&quot;>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:ID_FILE&quot;>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:ID_FILE&quot;/>&lt;/ns:ID_FILE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Sequence/Record[1]/NEXTVAL)&quot;/>&lt;/ns:ID_FILE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:ID_INTRFC&quot;>&lt;ns:ID_INTRFC>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:ID_INTRFC&quot;/>&lt;/ns:ID_INTRFC>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:IDTPLG_FILE&quot;>&lt;ns:IDTPLG_FILE>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:IDTPLG_FILE&quot;/>&lt;/ns:IDTPLG_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:NOME_FILE&quot;>&lt;ns:NOME_FILE>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:NOME_FILE&quot;/>&lt;/ns:NOME_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;>&lt;ns:TIMSTP_APERTURA_FILE>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;/>&lt;/ns:TIMSTP_APERTURA_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;>&lt;ns:TIMSTP_CHIUSURA_FILE>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;/>&lt;/ns:TIMSTP_CHIUSURA_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:VERSO_DEL_FILE&quot;>&lt;ns:VERSO_DEL_FILE>&lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:VERSO_DEL_FILE&quot;/>&lt;/ns:VERSO_DEL_FILE>&lt;/xsl:if>&lt;/ns:FileProcessato>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                        inputVariable="VarFileProcessato"
                        name="InputFileProcessato"
                        outputVariable="VarFileProcessato"
                        tibex:xpdlId="dcd8c748-9987-4df9-8896-1abd3a4b7578" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="ID_FILEToInputFileProcessato"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="InputFileProcessatoToLog"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Sequence&quot;/>&#xa;    &lt;xsl:param name=&quot;VarEsecuzioneFileProcessato&quot;/>&#xa;    &lt;xsl:template name=&quot;VarFileProcessato&quot; match=&quot;/&quot;>&#xa;        &lt;ns:FileProcessato>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessato/ns:COD_OLO&quot;>&#xa;                &lt;ns:COD_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessato/ns:COD_OLO&quot;/>&#xa;                &lt;/ns:COD_OLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;>&#xa;                &lt;ns:CODFC_OLO_AGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;/>&#xa;                &lt;/ns:CODFC_OLO_AGCOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessato/ns:DATA_FILE&quot;>&#xa;                &lt;ns:DATA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessato/ns:DATA_FILE&quot;/>&#xa;                &lt;/ns:DATA_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessato/ns:DESCR_STATO_FILE&quot;>&#xa;                &lt;ns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessato/ns:DESCR_STATO_FILE&quot;/>&#xa;                &lt;/ns:DESCR_STATO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessato/ns:ESITO&quot;>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessato/ns:ESITO&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$InsertIn.part1/ns:TipologiaOperazione='NEW_IDFILE'&quot;>&#xa;                    &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;>&#xa;                        &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                        &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$VarEsecuzioneFileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;>&#xa;                        &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$VarEsecuzioneFileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                        &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($InsertIn.part1/ns:FileProcessato/ns:ID_FILE) and string-length($InsertIn.part1/ns:ContenutoFile/ns:Token)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessato/ns:ID_FILE&quot;>&#xa;                        &lt;ns:ID_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessato/ns:ID_FILE&quot;/>&#xa;                        &lt;/ns:ID_FILE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($Sequence/Record[1]/NEXTVAL)&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessato/ns:ID_INTRFC&quot;>&#xa;                &lt;ns:ID_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessato/ns:ID_INTRFC&quot;/>&#xa;                &lt;/ns:ID_INTRFC>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessato/ns:IDTPLG_FILE&quot;>&#xa;                &lt;ns:IDTPLG_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessato/ns:IDTPLG_FILE&quot;/>&#xa;                &lt;/ns:IDTPLG_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessato/ns:NOME_FILE&quot;>&#xa;                &lt;ns:NOME_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessato/ns:NOME_FILE&quot;/>&#xa;                &lt;/ns:NOME_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;>&#xa;                &lt;ns:TIMSTP_APERTURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE&quot;/>&#xa;                &lt;/ns:TIMSTP_APERTURA_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;>&#xa;                &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE&quot;/>&#xa;                &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessato/ns:VERSO_DEL_FILE&quot;>&#xa;                &lt;ns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessato/ns:VERSO_DEL_FILE&quot;/>&#xa;                &lt;/ns:VERSO_DEL_FILE>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:FileProcessato>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.generalactivities.bwassign"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VarFileProcessato" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:activityExtension
                        inputVariable="Log_IN_FileProcessato-input"
                        name="Log_IN_FileProcessato"
                        tibex:xpdlId="3f956756-9e2c-4107-ba18-b0189c1a8af7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="InputFileProcessatoToLog"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="Log_InputFileProcessatoToFileProcessato"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VarFileProcessato&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_InputFileProcessato-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInput>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($VarFileProcessato)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns1:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.generalactivities.log"
                                version="6.0.0.001"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info" xsi:type="generalactivities:Log"/>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:activityExtension
                        inputVariable="FileProcessato-input"
                        name="FileProcessato"
                        outputVariable="FileProcessato"
                        tibex:xpdlId="5b8a836d-33a5-4b50-a64f-52dc15428fdf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="Log_InputFileProcessatoToFileProcessato"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="FileProcessatoToAssign"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5b8a836d-33a5-4b50-a64f-52dc15428fdf+input&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VarFileProcessato&quot;/>&#xa;    &lt;xsl:template name=&quot;FileProcessato-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VarFileProcessato/ns:COD_OLO)>0&quot;>&#xa;                    &lt;COD_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VarFileProcessato/ns:COD_OLO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VarFileProcessato/ns:COD_OLO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/COD_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;COD_OLO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VarFileProcessato/ns:CODFC_OLO_AGCOM)>0&quot;>&#xa;                    &lt;CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VarFileProcessato/ns:CODFC_OLO_AGCOM)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VarFileProcessato/ns:CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODFC_OLO_AGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODFC_OLO_AGCOM xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(xsd:string(xsd:date($VarFileProcessato/ns:DATA_FILE)))>0&quot;>&#xa;                    &lt;DATA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($VarFileProcessato/ns:DATA_FILE)&quot;/>&#xa;                    &lt;/DATA_FILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DATA_FILE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;DESCR_STATO_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VarFileProcessato/ns:DESCR_STATO_FILE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VarFileProcessato/ns:DESCR_STATO_FILE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DESCR_STATO_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VarFileProcessato/ns:ESITO)>0&quot;>&#xa;                    &lt;ESITO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VarFileProcessato/ns:ESITO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VarFileProcessato/ns:ESITO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ESITO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ESITO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(xsd:string($VarFileProcessato/ns:ID_ESEC_PROCSO_FILE))>0&quot;>&#xa;                    &lt;ID_ESEC_PROCSO_FILE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VarFileProcessato/ns:ID_ESEC_PROCSO_FILE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VarFileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ESEC_PROCSO_FILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_ESEC_PROCSO_FILE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VarFileProcessato/ns:ID_FILE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VarFileProcessato/ns:ID_FILE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_FILE>&#xa;            &lt;ID_INTRFC>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VarFileProcessato/ns:ID_INTRFC)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VarFileProcessato/ns:ID_INTRFC&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_INTRFC>&#xa;            &lt;IDTPLG_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VarFileProcessato/ns:IDTPLG_FILE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VarFileProcessato/ns:IDTPLG_FILE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDTPLG_FILE>&#xa;            &lt;NOME_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VarFileProcessato/ns:NOME_FILE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VarFileProcessato/ns:NOME_FILE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_FILE>&#xa;            &lt;TIMSTP_APERTURA_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:dateTime($VarFileProcessato/ns:TIMSTP_APERTURA_FILE)&quot;/>&#xa;            &lt;/TIMSTP_APERTURA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(xsd:string(xsd:dateTime($VarFileProcessato/ns:TIMSTP_CHIUSURA_FILE)))>0&quot;>&#xa;                    &lt;TIMSTP_CHIUSURA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:dateTime($VarFileProcessato/ns:TIMSTP_CHIUSURA_FILE)&quot;/>&#xa;                    &lt;/TIMSTP_CHIUSURA_FILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIMSTP_CHIUSURA_FILE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;VERSO_DEL_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VarFileProcessato/ns:VERSO_DEL_FILE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VarFileProcessato/ns:VERSO_DEL_FILE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/VERSO_DEL_FILE>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
