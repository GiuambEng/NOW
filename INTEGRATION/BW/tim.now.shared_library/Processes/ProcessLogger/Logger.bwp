                                    sqlStatement="UPDATE FILE_PROCSTO_OUTPUT&#xa;  SET ESITO_INVIO = ?, TIMSTP_INVIO = ?&#xa;  WHERE ID_FILE_PROCSTO_OUTPUT = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
