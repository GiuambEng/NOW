                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e1856117-bce5-471d-900f-9f3632d06129+input&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VarFileProcessatoInput&quot;/>&#xa;    &lt;xsl:template name=&quot;FileProcInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;DATA_ARRIVO>&#xa;                &lt;xsl:value-of select=&quot;xsd:date($VarFileProcessatoInput/ns:DATA_ARRIVO)&quot;/>&#xa;            &lt;/DATA_ARRIVO>&#xa;            &lt;DIMENSIONE_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VarFileProcessatoInput/ns:DIMENSIONE_FILE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VarFileProcessatoInput/ns:DIMENSIONE_FILE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DIMENSIONE_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(xsd:string($VarFileProcessatoInput/ns:ID_CAUS_SCARTO))>0&quot;>&#xa;                    &lt;ID_CAUS_SCARTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VarFileProcessatoInput/ns:ID_CAUS_SCARTO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VarFileProcessatoInput/ns:ID_CAUS_SCARTO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_CAUS_SCARTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_CAUS_SCARTO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_FILE_PROCSTO_INPUT>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VarFileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VarFileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_FILE_PROCSTO_INPUT>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(xsd:string($VarFileProcessatoInput/ns:QT_RECD_KO))>0&quot;>&#xa;                    &lt;QT_RECD_KO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VarFileProcessatoInput/ns:QT_RECD_KO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VarFileProcessatoInput/ns:QT_RECD_KO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/QT_RECD_KO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;QT_RECD_KO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(xsd:string($VarFileProcessatoInput/ns:QT_RECD_OK))>0&quot;>&#xa;                    &lt;QT_RECD_OK>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VarFileProcessatoInput/ns:QT_RECD_OK)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VarFileProcessatoInput/ns:QT_RECD_OK&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/QT_RECD_OK>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;QT_RECD_OK xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(xsd:string($VarFileProcessatoInput/ns:QT_RECD_TOTALI))>0&quot;>&#xa;                    &lt;QT_RECD_TOTALI>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VarFileProcessatoInput/ns:QT_RECD_TOTALI)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VarFileProcessatoInput/ns:QT_RECD_TOTALI&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/QT_RECD_TOTALI>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;QT_RECD_TOTALI xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.jdbc.update"
