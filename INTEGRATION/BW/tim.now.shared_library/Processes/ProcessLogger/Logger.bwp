                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO CONTENUTO_FILE (CONTENUTO_FILE, ID_CONTENUTO_FILE, ID_FILE)&#xa;VALUES (?, S_CONTENUTO_FILE.nextval, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="2004"
                                    DataTypeDisplayValue="BLOB" ParameterName="CONTENUTO_FILE"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE"/>
                                    </value>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:activityExtension
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4e063cd3-b8e4-4d17-a086-c04890eada27+input&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReadFile&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertIn&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCCallProcedure-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:inputs>&#xa;            &lt;inputSet>&#xa;                &lt;P_CONTENUTO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ReadFile/fileContent/binaryContent&quot;/>&#xa;                &lt;/P_CONTENUTO_FILE>&#xa;                &lt;P_ID_CONTENUTO_FILE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InsertIn/part1/ns:Input/ns:LogFileProcessato/ns:ID_FILE)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:LogFileProcessato/ns:ID_FILE&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/P_ID_CONTENUTO_FILE>&#xa;                &lt;P_ID_FILE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InsertIn/part1/ns:Input/ns:FileProcessato/ns:ID_FILE)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:FileProcessato/ns:ID_FILE&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/P_ID_FILE>&#xa;                &lt;P_CHIAVE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InsertIn/part1/ns:Input/ns:ContenutoFile/ns:ID_CONTENUTO_FILE)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:ContenutoFile/ns:ID_CONTENUTO_FILE&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/P_CHIAVE>&#xa;                &lt;P_TOKEN_FILE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InsertIn/part1/ns:Input/ns:LogFileProcessato/ns:COD_PROCSO)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$InsertIn/part1/ns:Input/ns:LogFileProcessato/ns:COD_PROCSO&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/P_TOKEN_FILE>&#xa;            &lt;/inputSet>&#xa;        &lt;/tns2:inputs>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                        inputVariable="JDBCCallProcedure-input"
                        name="JDBCCallProcedure"
