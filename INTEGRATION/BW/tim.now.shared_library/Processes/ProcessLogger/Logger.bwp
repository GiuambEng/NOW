                                    sqlStatement="INSERT INTO FILE_PROCSTO (COD_OLO, CODFC_OLO_AGCOM, DATA_FILE,&#xa;  DESCR_STATO_FILE, ESITO, ID_ESEC_PROCSO_FILE, ID_FILE, ID_INTRFC,&#xa;  IDTPLG_FILE, NOME_FILE, TIMSTP_APERTURA_FILE, TIMSTP_CHIUSURA_FILE,&#xa;  VERSO_DEL_FILE)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
