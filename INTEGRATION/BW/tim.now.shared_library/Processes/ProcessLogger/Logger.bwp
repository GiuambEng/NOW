                <bpws:extensionActivity>
                    <tibex:activityExtension
                        inputVariable="FileProcOutput-input"
                        name="FileProcOutput"
                        outputVariable="FileProcOutput"
                        tibex:xpdlId="a5802966-7b00-4c93-b2da-1b411014901a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="Log_FileProcOutputToJDBCUpdate"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="FileProcOutputToLog"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a5802966-7b00-4c93-b2da-1b411014901a+input&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VarFileProcessatoOutput&quot;/>&#xa;    &lt;xsl:template name=&quot;FileProcOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($VarFileProcessatoOutput/ns:DIMENSIONE_FILE))>0&quot;>&#xa;                    &lt;DIMENSIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($VarFileProcessatoOutput/ns:DIMENSIONE_FILE)&quot;/>&#xa;                    &lt;/DIMENSIONE_FILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DIMENSIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/DIMENSIONE_FILE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VarFileProcessatoOutput/ns:ESITO_INVIO)>0&quot;>&#xa;                    &lt;ESITO_INVIO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VarFileProcessatoOutput/ns:ESITO_INVIO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VarFileProcessatoOutput/ns:ESITO_INVIO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ESITO_INVIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ESITO_INVIO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_FILE_PROCSTO_OUTPUT>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($VarFileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT)&quot;/>&#xa;            &lt;/ID_FILE_PROCSTO_OUTPUT>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($VarFileProcessatoOutput/ns:QT_RECD_TOTALI))>0&quot;>&#xa;                    &lt;QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($VarFileProcessatoOutput/ns:QT_RECD_TOTALI)&quot;/>&#xa;                    &lt;/QT_RECD_TOTALI>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/QT_RECD_TOTALI>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIMSTP_CREZIONE_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:dateTime($VarFileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE)&quot;/>&#xa;            &lt;/TIMSTP_CREZIONE_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VarFileProcessatoOutput/ns:TIMSTP_INVIO)>0&quot;>&#xa;                    &lt;TIMSTP_INVIO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:dateTime($VarFileProcessatoOutput/ns:TIMSTP_INVIO)&quot;/>&#xa;                    &lt;/TIMSTP_INVIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIMSTP_INVIO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.jdbc.update"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
