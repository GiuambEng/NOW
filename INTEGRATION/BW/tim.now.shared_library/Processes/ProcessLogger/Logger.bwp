                <bpws:correlations/>
            </bpws:receive>
            <bpws:reply name="InsertOut" operation="Insert"
                partnerLink="ProcessLog" portType="ns2:ProcessLog"
                tibex:xpdlId="2c9c605c-c19f-487b-b69b-af3fdfa180ca" variable="InsertOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" version="2.0"&gt;
    &lt;xsl:param name="VarOutput"/&gt;
    &lt;xsl:template name="InsertOut-input" match="/"&gt;
        &lt;tns2:OutputMessage&gt;
            &lt;part1&gt;
                &lt;ns:Output&gt;
                    &lt;ns:Esito&gt;
                        &lt;xsl:if test="$VarOutput/ns:Esito/ns:Esito"&gt;
                            &lt;ns:Esito&gt;
                                &lt;xsl:value-of select="$VarOutput/ns:Esito/ns:Esito"/&gt;
                            &lt;/ns:Esito&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$VarOutput/ns:Esito/ns:DescEsito"&gt;
                            &lt;ns:DescEsito&gt;
                                &lt;xsl:value-of select="$VarOutput/ns:Esito/ns:DescEsito"/&gt;
                            &lt;/ns:DescEsito&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$VarOutput/ns:Esito/ns:ID_FILE"&gt;
                            &lt;ns:ID_FILE&gt;
                                &lt;xsl:value-of select="$VarOutput/ns:Esito/ns:ID_FILE"/&gt;
                            &lt;/ns:ID_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$VarOutput/ns:Esito/ns:ID_ESEC_PROCSO_FILE"&gt;
                            &lt;ns:ID_ESEC_PROCSO_FILE&gt;
                                &lt;xsl:value-of select="$VarOutput/ns:Esito/ns:ID_ESEC_PROCSO_FILE"/&gt;
                            &lt;/ns:ID_ESEC_PROCSO_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$VarOutput/ns:Esito/ns:NomeFile"&gt;
                            &lt;ns:NomeFile&gt;
                                &lt;xsl:value-of select="$VarOutput/ns:Esito/ns:NomeFile"/&gt;
                            &lt;/ns:NomeFile&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$VarOutput/ns:Esito/ns:COD_PROCSO_FILE"&gt;
                            &lt;ns:COD_PROCSO_FILE&gt;
                                &lt;xsl:value-of select="$VarOutput/ns:Esito/ns:COD_PROCSO_FILE"/&gt;
                            &lt;/ns:COD_PROCSO_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$VarOutput/ns:Esito/ns:COD_PROCSO_NO_FILE"&gt;
                            &lt;ns:COD_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$VarOutput/ns:Esito/ns:COD_PROCSO_NO_FILE"/&gt;
                            &lt;/ns:COD_PROCSO_NO_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$VarOutput/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE"&gt;
                            &lt;ns:ID_ESEC_PROCSO_NOFILE&gt;
                                &lt;xsl:value-of select="$VarOutput/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE"/&gt;
                            &lt;/ns:ID_ESEC_PROCSO_NOFILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$VarOutput/ns:Esito/ns:CORRELATION_ID"&gt;
                            &lt;ns:CORRELATION_ID&gt;
                                &lt;xsl:value-of select="$VarOutput/ns:Esito/ns:CORRELATION_ID"/&gt;
                            &lt;/ns:CORRELATION_ID&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns:Esito&gt;
                &lt;/ns:Output&gt;
            &lt;/part1&gt;
        &lt;/tns2:OutputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
