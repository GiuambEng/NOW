In.part1/ns:FileProcessato/ns:ID_FILE&quot;/>&#xa;                        &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($Sequence/Record[1]/NEXTVAL)&quot;/>&#xa;                    &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessatoInput/ns:QT_RECD_KO&quot;>&#xa;                &lt;ns:QT_RECD_KO>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessatoInput/ns:QT_RECD_KO&quot;/>&#xa;                &lt;/ns:QT_RECD_KO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessatoInput/ns:QT_RECD_OK&quot;>&#xa;                &lt;ns:QT_RECD_OK>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessatoInput/ns:QT_RECD_OK&quot;/>&#xa;                &lt;/ns:QT_RECD_OK>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertIn.part1/ns:FileProcessatoInput/ns:QT_RECD_TOTALI&quot;>&#xa;                &lt;ns:QT_RECD_TOTALI>&#xa;                    &lt;xsl:value-of select=&quot;$InsertIn.part1/ns:FileProcessatoInput/ns:QT_RECD_TOTALI&quot;/>&#xa;                &lt;/ns:QT_RECD_TOTALI>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:FileProcessatoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
