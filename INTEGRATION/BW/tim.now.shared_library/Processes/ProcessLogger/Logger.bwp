oInput/ns:QT_RECD_OK)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VarFileProcessatoInput/ns:QT_RECD_OK&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/QT_RECD_OK>&#xa;            &lt;ID_FILE_PROCSTO_INPUT>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VarFileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VarFileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_FILE_PROCSTO_INPUT>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
