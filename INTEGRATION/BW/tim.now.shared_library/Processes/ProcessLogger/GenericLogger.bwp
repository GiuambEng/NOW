    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable name="LogString" type="xsd:string"/>
        <bpws:variable element="tns:CW_BUS_MESSAGE" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:ActivityInput"
            name="Log_Error-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ActivityInput"
            name="Log_InfoDebugWarn-input" sca-bpel:internal="true"/>
        <bpws:variable name="ActivityTimeout" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Performance/ActivityTimeout" type="xsd:int"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:FaultDetail" name="FaultDetails" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ActivityInput" name="LogFault-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="fd3ac744-d385-47fe-a711-c586c0908d4f">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="LogToExit" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="LogFault-input"
                                name="LogFault"
                                tibex:xpdlId="ee874702-efe0-4f7d-9f97-7b509f956d50" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LogToExit"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogString&quot;/>&lt;xsl:template name=&quot;LogFault-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;xsl:if test=&quot;$Start/tns1:GenericLogger/tns1:MsgCode&quot;>&lt;msgCode>&lt;xsl:value-of select=&quot;$Start/tns1:GenericLogger/tns1:MsgCode&quot;/>&lt;/msgCode>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:GenericLogger/tns1:LoggerName&quot;>&lt;loggerName>&lt;xsl:value-of select=&quot;$Start/tns1:GenericLogger/tns1:LoggerName&quot;/>&lt;/loggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:GenericLogger/tns1:LogLevel&quot;>&lt;logLevel>&lt;xsl:value-of select=&quot;$Start/tns1:GenericLogger/tns1:LogLevel&quot;/>&lt;/logLevel>&lt;/xsl:if>&lt;message>&lt;xsl:value-of select=&quot;concat('GenericLogger in exception',$LogString)&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Warning"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:exit name="ExitProcess" tibex:xpdlId="31050f6e-8398-47e5-a8a7-e88cc7ab4c02">
                            <bpws:targets>
                                <bpws:target linkName="LogToExit"/>
                            </bpws:targets>
                        </bpws:exit>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="Assign_LogStringToCheck_LogLevel" tibex:linkType="SUCCESS"/>
                <bpws:link name="Check_LogLevelToEmpty"
                    tibex:label="ELSE" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="EmptyToLog_InfoDebugWarn"
                    tibex:label="INFO-DEBUG-WARN" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="EmptyToLog_Error" tibex:label="ERROR" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Log_InfoDebugWarnToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log_ErrorToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckFlagJMSToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="c926d613-c741-45c0-95d2-e087924e7cc1"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEnd"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="102c0095-b472-4fa4-ae0d-7b4f088c2ba8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckFlagJMSToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogString"
                    name="Assign_LogString" outputVariable="LogString"
                    tibex:xpdlId="bc7bee1f-1c63-4407-9fd1-844bdcf1a26f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign_LogStringToCheck_LogLevel"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat(&#xd;&#xa;'[Application: ',$Start/tns:GenericLogger/tns:Application,'] ', '[Process: ',$Start/tns:GenericLogger/tns:Process,']', '[',$Start/tns:GenericLogger/tns:Service,']', '[',$Start/tns:GenericLogger/tns:Operation,']',&#xd;&#xa;'[',$Start/tns:GenericLogger/tns:BusinessID,']', '[',$Start/tns:GenericLogger/tns:MsgCode,']', '[',$Start/tns:GenericLogger/tns:Message,']', '[',$Start/tns:GenericLogger/tns:Payload,']')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="LogString" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Log_Error-input"
                    name="Log_Error"
                    tibex:xpdlId="5677ccf8-94bd-4748-a158-93f0560817bf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToLog_Error"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_ErrorToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogString&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Log_Error-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;xsl:if test=&quot;$Start/tns1:GenericLogger/tns1:MsgCode&quot;>&lt;msgCode>&lt;xsl:value-of select=&quot;$Start/tns1:GenericLogger/tns1:MsgCode&quot;/>&lt;/msgCode>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:GenericLogger/tns1:LoggerName&quot;>&lt;loggerName>&lt;xsl:value-of select=&quot;$Start/tns1:GenericLogger/tns1:LoggerName&quot;/>&lt;/loggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:GenericLogger/tns1:LogLevel&quot;>&lt;logLevel>&lt;xsl:value-of select=&quot;$Start/tns1:GenericLogger/tns1:LogLevel&quot;/>&lt;/logLevel>&lt;/xsl:if>&lt;message>&lt;xsl:value-of select=&quot;$LogString&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Log_InfoDebugWarn-input"
                    name="Log_InfoDebugWarn"
                    tibex:xpdlId="88de1833-a77e-4947-9666-67cc67cdfee8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToLog_InfoDebugWarn"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_InfoDebugWarnToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogString&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Log_InfoDebugWarn-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;xsl:if test=&quot;$Start/tns1:GenericLogger/tns1:MsgCode&quot;>&lt;msgCode>&lt;xsl:value-of select=&quot;$Start/tns1:GenericLogger/tns1:MsgCode&quot;/>&lt;/msgCode>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:GenericLogger/tns1:LoggerName&quot;>&lt;loggerName>&lt;xsl:value-of select=&quot;$Start/tns1:GenericLogger/tns1:LoggerName&quot;/>&lt;/loggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:GenericLogger/tns1:LogLevel&quot;>&lt;logLevel>&lt;xsl:value-of select=&quot;$Start/tns1:GenericLogger/tns1:LogLevel&quot;/>&lt;/logLevel>&lt;/xsl:if>&lt;message>&lt;xsl:value-of select=&quot;$LogString&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
