                faultVariable="ActivityTimedOutException" tibex:xpdlId="dc1528f9-68dc-475b-8251-f92466feeed7">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="LogFaultTimedoutToRethrow" tibex:linkType="SUCCESS"/>
                        </bpws:links>
