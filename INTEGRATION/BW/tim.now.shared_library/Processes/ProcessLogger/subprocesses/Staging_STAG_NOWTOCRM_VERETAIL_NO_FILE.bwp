                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2d421817-99a3-4c7b-aa82-2a922c2758d9+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;InsertStag-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;DN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:GenericStaging/tns1:DN)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:GenericStaging/tns1:DN&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DN>&lt;CONT_REQUEST>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:GenericStaging/tns1:CONTENUTO_REQUEST)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:GenericStaging/tns1:CONTENUTO_REQUEST&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONT_REQUEST>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:GenericStaging/tns1:ID_PROCSO_NO_FILE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:GenericStaging/tns1:ID_PROCSO_NO_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:decimal($Start/tns1:GenericStaging/tns1:ID_STATO_ELAB_STAG)&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;ID_TRANSAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:GenericStaging/tns1:ID_TRANSAZIONE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:GenericStaging/tns1:ID_TRANSAZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_TRANSAZIONE>&lt;TIMESTAMP_RICH>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:GenericStaging/tns1:TIMSTP_RICH)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:GenericStaging/tns1:TIMSTP_RICH&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIMESTAMP_RICH>&lt;ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:GenericStaging/tns1:ID_RICH)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:GenericStaging/tns1:ID_RICH&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_OLO>&lt;SISTEMADICOMPETENZA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:GenericStaging/tns1:SISTEMA)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:GenericStaging/tns1:SISTEMA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SISTEMADICOMPETENZA>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_NOWTOCRM_VERETAIL_NO_FILE (DN, CONT_REQUEST, ID_ESEC_PROCSO_NO_FILE,&#xa;  ID_STATO_ELAB_STAG, ID_TRANSAZIONE, TIMESTAMP_RICH, ID_RICH_OLO, SISTEMADICOMPETENZA)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
