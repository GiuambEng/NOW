                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ActivityTimedOutException&quot;/>&lt;xsl:template name=&quot;LogTimeoutException-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Staging_STAG_RET_CONTR_NOFOUT&amp;quot;&quot;/>&lt;/tns:Process>&lt;xsl:if test=&quot;$ActivityTimedOutException/msgCode&quot;>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;$ActivityTimedOutException/msgCode&quot;/>&lt;/tns:MsgCode>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;$ActivityTimedOutException/msg&quot;/>&lt;/tns:Message>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
