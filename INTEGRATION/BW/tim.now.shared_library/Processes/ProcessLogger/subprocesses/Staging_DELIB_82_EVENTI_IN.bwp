    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToJDBCUpdate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogInputToJDBCUpdate1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="InsertToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpdateToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogOutputToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="a5e02865-5d73-4ec5-8f83-e9a1229e56b4"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToGenericLogger"/>
                    </bpws:sources>
                    <tibex:eventSource>
