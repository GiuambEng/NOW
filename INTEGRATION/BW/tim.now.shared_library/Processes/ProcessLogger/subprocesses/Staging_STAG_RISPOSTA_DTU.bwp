                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_NO_FILE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
