                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3232a8b7-69eb-4f94-8d4d-ff88a8114985+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_STATO_ELAB_STAG>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:StagingIn/tns1:ID_STATO_ELAB_STAG)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:StagingIn/tns1:ID_STATO_ELAB_STAG&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_STATO_ELAB_STAG>&lt;TIME_UPDATE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:StagingIn/tns1:TIME_UPDATE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:StagingIn/tns1:TIME_UPDATE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIME_UPDATE>&lt;DESCR_ERRORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:StagingIn/tns1:DESCR_ERRORE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:StagingIn/tns1:DESCR_ERRORE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCR_ERRORE>&lt;ID_RICH_DTU>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:StagingIn/tns1:ID_RICH_DTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:StagingIn/tns1:ID_RICH_DTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_DTU>&lt;ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:StagingIn/tns1:ID_RICH_OLO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:StagingIn/tns1:ID_RICH_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_OLO>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:StagingIn/tns1:ID_PROCSO_NO_FILE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:StagingIn/tns1:ID_PROCSO_NO_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
