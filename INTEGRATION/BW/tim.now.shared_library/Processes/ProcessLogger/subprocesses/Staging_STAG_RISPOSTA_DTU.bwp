                                    sqlStatement="UPDATE STAG_RISPOSTA_DTU&#xa;  SET ID_STATO_ELAB_STAG = ?, TIME_UPDATE = ?, DESCR_ERRORE = ?&#xa;  WHERE ID_RICH_DTU = ? AND ID_RICH_OLO = ? AND ID_ESEC_PROCSO_NO_FILE = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="2"
