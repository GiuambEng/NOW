                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns1:LoggerIn/ns6:TipologiaOperazione='UPDATE']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
