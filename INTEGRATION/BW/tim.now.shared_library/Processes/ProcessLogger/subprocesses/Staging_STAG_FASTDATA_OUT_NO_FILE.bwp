                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns1:LoggerIn/ns6:TipologiaOperazione='INSERT']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogStartToJDBCUpdate1_UPDATE">
                            <tibex:DesignExpression>
                                <tibex:expression
