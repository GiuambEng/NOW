    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catch faultElement="ns6:DefaultFault"
                faultName="ns6:DefaultFault"
                faultVariable="DefaultFault" tibex:xpdlId="717db495-f983-476b-89ce-31798482aeeb">
                <bpws:scope name="scope2">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="LogToInvoke2" tibex:linkType="SUCCESS"/>
                            <bpws:link name="Invoke2ToCallProcess" tibex:linkType="SUCCESS"/>
                            <bpws:link name="StagingKOToRethrow1" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="Log-input" name="Log"
                                tibex:xpdlId="9af85b21-60a0-4b92-9d04-219c2ff2dec3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LogToInvoke2"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;DefaultFault&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.shared_library | Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;) ,&amp;quot; | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;xsl:choose>&lt;xsl:when test=&quot;$DefaultFault/message=&amp;quot;Esito KO&amp;quot;&quot;>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;Id risorsa non recuperato&amp;quot;&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;message>&lt;xsl:value-of select=&quot;$DefaultFault/message&quot;/>&lt;/message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:invoke inputVariable="Invoke2-input"
                            name="Invoke2" operation="Insert"
                            outputVariable="Invoke2"
                            partnerLink="ProcessLog"
                            portType="ns5:ProcessLog" tibex:xpdlId="c032935e-aa84-458c-8c93-65b9a712fb70">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://www.example.org/RecuperaTGUIdRisorsa/" version="2.0"&gt;
    &lt;xsl:param name="EsecProcsoNoFile"/&gt;
    &lt;xsl:param name="DefaultFault"/&gt;
    &lt;xsl:param name="RecuperaIdRisorsa"/&gt;
    &lt;xsl:template name="Invoke2-input" match="/"&gt;
        &lt;tns5:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns:Input&gt;
                    &lt;ns:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                    &lt;/ns:TipologiaProcesso&gt;
                    &lt;ns:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                    &lt;/ns:TipologiaOperazione&gt;
                    &lt;ns:EsecuzioneNOFileProcessato&gt;
                        &lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="xsd:int(xsd:decimal($EsecProcsoNoFile/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;
                        &lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$DefaultFault/msgCode=$RecuperaIdRisorsa/parameters/tns3:RecuperaTGUResponse/ESITO and $DefaultFault/message=&amp;quot;Esito KO&amp;quot;"&gt;
                                &lt;ns:STATO_ESEC&gt;
                                    &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                                &lt;/ns:STATO_ESEC&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;ns:STATO_ESEC&gt;
                                    &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;
                                &lt;/ns:STATO_ESEC&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;ns:TMSP_FINE_ELAB&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns:TMSP_FINE_ELAB&gt;
                    &lt;/ns:EsecuzioneNOFileProcessato&gt;
                &lt;/ns:Input&gt;
            &lt;/part1&gt;
        &lt;/tns5:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.example.org/RecuperaTGUIdRisorsa/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaIdRisorsa.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;EsecProcsoNoFile.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;DefaultFault&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke2-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($EsecProcsoNoFile.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$DefaultFault/msgCode=$RecuperaIdRisorsa.parameters/ESITO and $DefaultFault/message=&amp;quot;Esito KO&amp;quot;&quot;>&#xa;                        &lt;ns:STATO_ESEC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                        &lt;/ns:STATO_ESEC>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:STATO_ESEC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                        &lt;/ns:STATO_ESEC>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_FINE_ELAB>&#xa;            &lt;/ns:EsecuzioneNOFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
