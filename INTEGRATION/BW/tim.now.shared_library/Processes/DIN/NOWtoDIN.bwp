                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
            <bpws:invoke inputVariable="RecuperaIdRisorsa-input"
                name="RecuperaIdRisorsa" operation="RecuperaTGU"
                outputVariable="RecuperaIdRisorsa"
                partnerLink="RecuperaTGUIdRisorsa"
                portType="ns4:RecuperaTGUIdRisorsa" tibex:xpdlId="eb031d62-7d94-443d-bae7-c8e843849997">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.example.org/RecuperaTGUIdRisorsa/" version="2.0"&gt;
    &lt;xsl:param name="Request"/&gt;
    &lt;xsl:template name="RecuperaIdRisorsa-input" match="/"&gt;
        &lt;tns3:RecuperaTGURequest&gt;
            &lt;parameters&gt;
                &lt;xsl:copy-of select="$Request"/&gt;
            &lt;/parameters&gt;
        &lt;/tns3:RecuperaTGURequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/RecuperaTGUIdRisorsa/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaIdRisorsa-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$Request&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Log1ToRecuperaIdRisorsa"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RecuperaIdRisorsaToLog">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$RecuperaIdRisorsa/parameters/ns4:RecuperaTGUResponse/ESITO=&quot;000&quot; or $RecuperaIdRisorsa/parameters/ns4:RecuperaTGUResponse/ESITO=&quot;006&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$RecuperaIdRisorsa.parameters/ESITO="000" or $RecuperaIdRisorsa.parameters/ESITO="006"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="RecuperaIdRisorsaToThrow">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns3=&quot;http://www.example.org/RecuperaTGUIdRisorsa/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaIdRisorsa&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOK-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.shared_library | Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;) ,&amp;quot; | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RecuperaIdRisorsa/parameters/tns3:RecuperaTGUResponse/ESITO=&amp;quot;000&amp;quot;&quot;>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;Id Risorsa recuperato con successo: &amp;quot;,$RecuperaIdRisorsa/parameters/tns3:RecuperaTGUResponse/ID_RISORSA)&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Id Risorsa non trovato&amp;quot;&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogOK-input" name="LogOK"
                    tibex:xpdlId="f87fbfaa-2fef-4fe1-8d15-3f906fc72b09" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RecuperaIdRisorsaToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOKToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns3=&quot;http://www.example.org/RecuperaTGUIdRisorsa/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaIdRisorsa.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOK-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.shared_library | Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;) ,&amp;quot; | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RecuperaIdRisorsa.parameters/ESITO=&amp;quot;000&amp;quot;&quot;>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;Id Risorsa recuperato con successo: &amp;quot;,$RecuperaIdRisorsa.parameters/ID_RISORSA)&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Id Risorsa non trovato&amp;quot;&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/StagingDIN&quot; xmlns:tns3=&quot;http://www.example.org/RecuperaTGUIdRisorsa/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/NOWtoDIN&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FlowInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:param name=&quot;EsecProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaIdRisorsa&quot;/>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;StagOK-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:StagingDIN>&#xa;            &lt;tns6:target>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;RES&amp;quot;&quot;/>&#xa;            &lt;/tns6:target>&#xa;            &lt;tns6:processNoFileID>&#xa;                &lt;xsl:value-of select=&quot;$FlowInfo/tns6:processCode&quot;/>&#xa;            &lt;/tns6:processNoFileID>&#xa;            &lt;tns6:description>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;            &lt;/tns6:description>&#xa;            &lt;tns6:StagDIN>&#xa;                &lt;tns6:idRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$FlowInfo/tns6:requestID&quot;/>&#xa;                &lt;/tns6:idRichiesta>&#xa;                &lt;tns6:timestampRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$FlowInfo/tns6:transactionDate&quot;/>&#xa;                &lt;/tns6:timestampRichiesta>&#xa;                &lt;tns6:timestampRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns6:timestampRisposta>&#xa;                &lt;tns6:contenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Request,true())&quot;/>&#xa;                &lt;/tns6:contenutoRequest>&#xa;                &lt;tns6:contenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Response,true())&quot;/>&#xa;                &lt;/tns6:contenutoResponse>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($RecuperaIdRisorsa/parameters/tns3:RecuperaTGUResponse/TGU)>0&quot;>&#xa;                        &lt;tns6:DN>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperaIdRisorsa/parameters/tns3:RecuperaTGUResponse/TGU&quot;/>&#xa;                        &lt;/tns6:DN>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns7:DN)>0&quot;>&#xa;                        &lt;tns6:DN>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns7:DN&quot;/>&#xa;                        &lt;/tns6:DN>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:DN>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns7:IdRisorsa&quot;/>&#xa;                        &lt;/tns6:DN>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$RecuperaIdRisorsa/parameters/tns3:RecuperaTGUResponse/DISTRETTO&quot;>&#xa;                    &lt;tns6:DISTR>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperaIdRisorsa/parameters/tns3:RecuperaTGUResponse/DISTRETTO&quot;/>&#xa;                    &lt;/tns6:DISTR>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Esito>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperaIdRisorsa/parameters/tns3:RecuperaTGUResponse/ESITO&quot;/>&#xa;                &lt;/tns6: