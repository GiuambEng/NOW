lue-of select=&quot;tib:render-xml($Request,true())&quot;/>&#xa;                &lt;/tns6:contenutoRequest>&#xa;                &lt;tns6:DN>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns7:DN&quot;/>&#xa;                &lt;/tns6:DN>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$FaultDetails/Msg=&amp;quot;Esito KO&amp;quot;&quot;>&#xa;                        &lt;tns6:Esito>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperaIdRisorsa.parameters/ESITO&quot;/>&#xa;                        &lt;/tns6:Esito>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$FaultDetails/Msg=&amp;quot;Esito KO&amp;quot;&quot;>&#xa;                        &lt;xsl:if test=&quot;$RecuperaIdRisorsa.parameters/DESCRIZIONE&quot;>&#xa;                            &lt;tns6:descrizioneErrore>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperaIdRisorsa.parameters/DESCRIZIONE&quot;/>&#xa;                            &lt;/tns6:descrizioneErrore>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:descrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                        &lt;/tns6:descrizioneErrore>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns6:StagDIN>&#xa;            &lt;tns6:IdEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($EsecProcsoNoFile.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;            &lt;/tns6:IdEsecProcsoNoFile>&#xa;        &lt;/tns6:StagingDIN>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang: