                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="Invoke2ToCallProcess"/>
                            </bpws:sources>
                        </bpws:invoke>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/StagingDIN&quot; xmlns:tns3=&quot;http://www.example.org/RecuperaTGUIdRisorsa/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/NOWtoDIN&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FlowInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:param name=&quot;EsecProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaIdRisorsa&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;DefaultFault&quot;/>&#xa;    &lt;xsl:template name=&quot;StagingKO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:StagingDIN>&#xa;            &lt;tns6:target>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ERR&amp;quot;&quot;/>&#xa;            &lt;/tns6:target>&#xa;            &lt;tns6:processNoFileID>&#xa;                &lt;xsl:value-of select=&quot;$FlowInfo/tns6:processCode&quot;/>&#xa;            &lt;/tns6:processNoFileID>&#xa;            &lt;tns6:description>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;            &lt;/tns6:description>&#xa;            &lt;tns6:StagDIN>&#xa;                &lt;tns6:idRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$FlowInfo/tns6:requestID&quot;/>&#xa;                &lt;/tns6:idRichiesta>&#xa;                &lt;tns6:timestampRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$FlowInfo/tns6:transactionDate&quot;/>&#xa;                &lt;/tns6:timestampRichiesta>&#xa;                &lt;tns6:contenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Request,true())&quot;/>&#xa;                &lt;/tns6:contenutoRequest>&#xa;                &lt;tns6:DN>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns7:DN&quot;/>&#xa;                &lt;/tns6:DN>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$DefaultFault/message=&amp;quot;Esito KO&amp;quot;&quot;>&#xa;                        &lt;tns6:Esito>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperaIdRisorsa/parameters/tns3:RecuperaTGUResponse/ESITO&quot;/>&#xa;                        &lt;/tns6:Esito>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$DefaultFault/message=&amp;quot;Esito KO&amp;quot;&quot;>&#xa;                        &lt;xsl:if test=&quot;$RecuperaIdRisorsa/parameters/tns3:RecuperaTGUResponse/DESCRIZIONE&quot;>&#xa;                            &lt;tns6:descrizioneErrore>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperaIdRisorsa/parameters/tns3:RecuperaTGUResponse/DESCRIZIONE&quot;/>&#xa;                            &lt;/tns6:descrizioneErrore>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$DefaultFault/message&quot;>&#xa;                            &lt;tns6:descrizioneErrore>&#xa;                                &lt;xsl:value-of select=&quot;$DefaultFault/message&quot;/>&#xa;                            &lt;/tns6:descrizioneErrore>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns6:StagDIN>&#xa;            &lt;tns6:IdEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($EsecProcsoNoFile/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;            &lt;/tns6:IdEsecProcsoNoFile>&#xa;        &lt;/tns6:StagingDIN>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="StagingKO-input"
                                name="StagingKO"
                                tibex:xpdlId="66066e87-9283-4d65-a58e-f326519393a9"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
