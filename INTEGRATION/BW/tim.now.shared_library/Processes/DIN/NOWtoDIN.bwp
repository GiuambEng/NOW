                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/StagingDIN&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/NOWtoDIN&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/recuperaTguIdRisorsa_NNI&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;EsecProcsoNoFile.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FlowInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseJSON&quot;/>&#xa;    &lt;xsl:template name=&quot;StagingDIN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:StagingDIN>&#xa;            &lt;tns6:target>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;RES&amp;quot;&quot;/>&#xa;            &lt;/tns6:target>&#xa;            &lt;tns6:processNoFileID>&#xa;                &lt;xsl:value-of select=&quot;$FlowInfo/tns6:processCode&quot;/>&#xa;            &lt;/tns6:processNoFileID>&#xa;            &lt;tns6:description>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;            &lt;/tns6:description>&#xa;            &lt;tns6:StagDIN>&#xa;                &lt;tns6:idRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$FlowInfo/tns6:requestID&quot;/>&#xa;                &lt;/tns6:idRichiesta>&#xa;                &lt;tns6:timestampRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$FlowInfo/tns6:transactionDate&quot;/>&#xa;                &lt;/tns6:timestampRichiesta>&#xa;                &lt;tns6:timestampRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns6:timestampRisposta>&#xa;                &lt;tns6:contenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Request,true())&quot;/>&#xa;                &lt;/tns6:contenutoRequest>&#xa;                &lt;tns6:contenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Response,true())&quot;/>&#xa;                &lt;/tns6:contenutoResponse>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($ParseJSON/tns4:tgu)>0&quot;>&#xa;                        &lt;tns6:DN>&#xa;                            &lt;xsl:value-of select=&quot;$ParseJSON/tns4:tgu&quot;/>&#xa;                        &lt;/tns6:DN>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns7:DN)>0&quot;>&#xa;                        &lt;tns6:DN>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns7:DN&quot;/>&#xa;                        &lt;/tns6:DN>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:DN>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns7:IdRisorsa&quot;/>&#xa;                        &lt;/tns6:DN>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;not((string($ParseJSON/tns4:distretto/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($ParseJSON/tns4:distretto/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($ParseJSON/tns4:distretto)&quot;>&#xa;                    &lt;tns6:DISTR>&#xa;                        &lt;xsl:value-of select=&quot;$ParseJSON/tns4:distretto&quot;/>&#xa;                    &lt;/tns6:DISTR>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($ParseJSON/tns4:esito/tns4:codice/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($ParseJSON/tns4:esito/tns4:codice/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($ParseJSON/tns4:esito/tns4:codice)&quot;>&#xa;                    &lt;tns6:Esito>&#xa;                        &lt;xsl:value-of select=&quot;$ParseJSON/tns4:esito/tns4:codice&quot;/>&#xa;                    &lt;/tns6:Esito>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($ParseJSON/tns4:idRisorsa/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($ParseJSON/tns4:idRisorsa/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($ParseJSON/tns4:idRisorsa)&quot;>&#xa;                    &lt;tns6:IdRisorsaDN>&#xa;                        &lt;xsl:value-of select=&quot;$ParseJSON/tns4:idRisorsa&quot;/>&#xa;                    &lt;/tns6:IdRisorsaDN>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($ParseJSON/tns4:esito/tns4:messaggio/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($ParseJSON/tns4:esito/tns4:messaggio/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($ParseJSON/tns4:esito/tns4:messaggio)&quot;>&#xa;                    &lt;tns6:descrizioneErrore>&#xa;                        &lt;xsl:value-of select=&quot;$ParseJSON/tns4:esito/tns4:messaggio&quot;/>&#xa;                    &lt;/tns6:descrizioneErrore>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns6:StagDIN>&#xa;            &lt;tns6:IdEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($EsecProcsoNoFile.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;            &lt;/tns6:IdEsecProcsoNoFile>&#xa;        &lt;/tns6:StagingDIN>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
