                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/StagingDIN&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/NOWtoDIN&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/recuperaTguIdRisorsa_NNI&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FlowInfo&quot;/>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:param name=&quot;EsecProcsoNoFile&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseJSON&quot;/>&lt;xsl:template name=&quot;StagingDIN-input&quot; match=&quot;/&quot;>&lt;tns6:StagingDIN>&lt;tns6:target>&lt;xsl:value-of select=&quot;&amp;quot;RES&amp;quot;&quot;/>&lt;/tns6:target>&lt;tns6:processNoFileID>&lt;xsl:value-of select=&quot;$FlowInfo/tns6:processCode&quot;/>&lt;/tns6:processNoFileID>&lt;tns6:description>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns6:description>&lt;tns6:StagDIN>&lt;tns6:idRichiesta>&lt;xsl:value-of select=&quot;$FlowInfo/tns6:requestID&quot;/>&lt;/tns6:idRichiesta>&lt;tns6:timestampRichiesta>&lt;xsl:value-of select=&quot;$FlowInfo/tns6:transactionDate&quot;/>&lt;/tns6:timestampRichiesta>&lt;tns6:timestampRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns6:timestampRisposta>&lt;tns6:contenutoRequest>&lt;xsl:value-of select=&quot;tib:render-xml($Request,true())&quot;/>&lt;/tns6:contenutoRequest>&lt;tns6:contenutoResponse>&lt;xsl:value-of select=&quot;tib:render-xml($Response,true())&quot;/>&lt;/tns6:contenutoResponse>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ParseJSON/tns4:tgu)>0&quot;>&lt;