                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.example.org/ServicesSecurityData&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Service.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:template name=&quot;LogRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;xsl:if test=&quot;$Service.parameters/tns1:LogInfo/tns1:Application&quot;>&#xa;                    &lt;tns:Application>&#xa;                        &lt;xsl:value-of select=&quot;$Service.parameters/tns1:LogInfo/tns1:Application&quot;/>&#xa;                    &lt;/tns:Application>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LogAccessiUtenti&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;xsl:if test=&quot;$Service.parameters/tns1:LogInfo/tns1:ServiceName&quot;>&#xa;                    &lt;tns:Service>&#xa;                        &lt;xsl:value-of select=&quot;$Service.parameters/tns1:LogInfo/tns1:ServiceName&quot;/>&#xa;                    &lt;/tns:Service>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Service.parameters/tns1:LogInfo/tns1:Operation&quot;>&#xa;                    &lt;tns:Operation>&#xa;                        &lt;xsl:value-of select=&quot;$Service.parameters/tns1:LogInfo/tns1:Operation&quot;/>&#xa;                    &lt;/tns:Operation>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;**REQUEST DEL SERVIZIO LoggerServiceSecurity = &amp;quot;, tib:render-xml($Request,true(), true()), &amp;quot;**&amp;quot;)&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Service.parameters/tns1:LogInfo/tns1:LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Service.parameters/tns1:LogInfo/tns1:LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;xsl:if test=&quot;$Service.parameters/tns1:LogInfo/tns1:JMS&quot;>&#xa;                    &lt;tns:LogJMS>&#xa;                        &lt;xsl:value-of select=&quot;$Service.parameters/tns1:LogInfo/tns1:JMS&quot;/>&#xa;                    &lt;/tns:LogJMS>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCUpdate-input" name="JDBCUpdate"
                    outputVariable="JDBCUpdate"
                    tibex:xpdlId="a7ba3741-d1ed-4cb3-817e-001ef275446d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogRequestToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateToLogEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a7ba3741-d1ed-4cb3-817e-001ef275446d+input&quot; xmlns:tns1=&quot;http://www.example.org/ServicesSecurityData&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;APPLICAZIONE_CLIENT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Request/tns1:APPLICAZIONE_CLIENT)&quot;>&lt;xsl:value-of select=&quot;$Request/tns1:APPLICAZIONE_CLIENT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/APPLICAZIONE_CLIENT>&lt;DESCR_FUNZIONE>&lt;xsl:value-of select=&quot;$Request/tns1:COD_FUNZIONE&quot;/>&lt;/DESCR_FUNZIONE>&lt;HOSTNAME_CLIENT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Request/tns1:HOSTNAME_CLIENT)&quot;>&lt;xsl:value-of select=&quot;$Request/tns1:HOSTNAME_CLIENT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/HOSTNAME_CLIENT>&lt;IP_CLIENT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Request/tns1:IP_CLIENT)&quot;>&lt;xsl:value-of select=&quot;$Request/tns1:IP_CLIENT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IP_CLIENT>&lt;IP_SERVER>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Request/tns1:IP_SERVER)&quot;>&lt;xsl:value-of select=&quot;$Request/tns1:IP_SERVER&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IP_SERVER>&lt;SERVER_NAME>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Request/tns1:SERVER_NAME)&quot;>&lt;xsl:value-of select=&quot;$Request/tns1:SERVER_NAME&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SERVER_NAME>&lt;SESSION_ID>&lt;xsl:value-of select=&quot;$Request/tns1:SESSION_ID&quot;/>&lt;/SESSION_ID>&lt;SISTEMA_CHIAMANTE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Request/tns1:SISTEMA_CHIAMANTE)&quot;>&lt;xsl:value-of select=&quot;$Request/tns1:SISTEMA_CHIAMANTE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SISTEMA_CHIAMANTE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Request/tns1:ID_ESE_PROC_NO_FILE)>0&quot;>&lt;ID_ESE_PROC_NO_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Request/tns1:ID_ESE_PROC_NO_FILE)&quot;/>&lt;/ID_ESE_PROC_NO_FILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ESE_PROC_NO_FILE xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;NOME_TAB_STAGING>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Request/tns1:NOME_TAB_STAGING)&quot;>&lt;xsl:value-of select=&quot;$Request/tns1:NOME_TAB_STAGING&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME_TAB_STAGING>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="Insert into TRACC_RICHIESTE_M2M (APPLICAZIONE_CLIENT,DESCR_FUNZIONE,HOSTNAME_CLIENT,IP_CLIENT,IP_SERVER,SERVER_NAME,SESSION_ID,TIMSTP_INSMTO,SISTEMA_CHIAMANTE,ID_ESE_PROC_NO_FILE,NOME_TAB_STAGING) values (?,?,?,?,?,?,?,sysdate,?,?,?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="APPLICAZIONE_CLIENT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_FUNZIONE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="HOSTNAME_CLIENT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IP_CLIENT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IP_SERVER"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SERVER_NAME"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SESSION_ID"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SISTEMA_CHIAMANTE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESE_PROC_NO_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_TAB_STAGING"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
