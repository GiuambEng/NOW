<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:jms="http://www.tibco.com/namespaces/ws/2004/soap/binding/JMS" xmlns:ns="http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/" xmlns:ns0="http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="ContaConcrete" targetNamespace="http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/">
  <wsdl:import namespace="http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/" location="../../Schemas/Migrazione_Batch/Conta.xsd"/>
  <wsdl:message name="Conta_Request">
    <wsdl:part element="ns0:contaRecord_Input" name="part1"/>
  </wsdl:message>
  <wsdl:portType name="Conta">
    <wsdl:operation name="ContaRecord">
      <wsdl:input message="ns:Conta_Request"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="SOAPBinding_JMS_SSL_ContaServer" type="ns:Conta">
    <soap:binding style="document" transport="http://www.tibco.com/namespaces/ws/2004/soap/binding/JMS"/>
    <jms:binding messageFormat="text"/>
    <wsdl:operation name="ContaRecord">
      <soap:operation soapAction="ContaRecord" style="document"/>
      <wsdl:input>
        <soap:body parts="part1" use="literal"/>
      </wsdl:input>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="ContaConcrete">
    <wsdl:port binding="ns:SOAPBinding_JMS_SSL_ContaServer" name="ContaConcreteSOAP">
      <soap:address location="jms:jndi:tim.now.alignment.shared.conta.record.jms?targetService=ContaRecordJMS"/>
      <jms:connectionFactory>SSLQueueConnectionFactory</jms:connectionFactory>
      <jms:targetAddress destination="queue">tim.now.alignment.shared.conta.record.jms</jms:targetAddress>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>