<?xml version = "1.0" encoding = "UTF-8"?>
<definitions targetNamespace = "http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns = "http://schemas.xmlsoap.org/wsdl/" xmlns:ns = "http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns = "http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:xsd = "http://www.w3.org/2001/XMLSchema">
	<import location = "../../Schemas/ProcessLog/tim.now.sharedlibrary.processlog.xsd" namespace = "http://www.tim.now.sharedlibrary.logprocess.telecom"/>
    <types><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/wsdl/abstract/ProcessLog">
	<xsd:element name="InsertFault">
		<xsd:complexType>
			<xsd:sequence>

				<xsd:element name="InsertFault" type="xsd:string"></xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element></xsd:schema></types>
    <message name = "InputMessage">
		<part element = "ns:Input" name = "part1"/>
	</message>
	<message name = "OutputMessage">
		<part element = "ns:Output" name = "part1"/>
	</message>
	<message name="InsertFault">
		<part name="parameters" element="ns:ErrorProcessLog"></part>
	</message>
	<portType name = "ProcessLog">
		<operation name = "Insert">
			<input message = "tns:InputMessage"/>
			<output message = "tns:OutputMessage"/>
            <fault name="fault" message="tns:InsertFault"></fault>
        </operation>
	</portType>
</definitions>