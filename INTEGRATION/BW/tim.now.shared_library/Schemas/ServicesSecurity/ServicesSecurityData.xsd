<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/ServicesSecurityData" xmlns:tns="http://www.example.org/ServicesSecurityData" elementFormDefault="qualified">
	<element name="LoggerSecurityInput">
		<complexType >
			<sequence>
				<element  minOccurs="1" name="LogInfo">
					<complexType >
						<sequence>
							<element  minOccurs="1" name="LoggerName" type="string"/>
							<element  minOccurs="0" name="Application" type="string"/>
							<element  minOccurs="1" name="LogLevel" type="string"/>
							<element  minOccurs="0" name="ServiceName" type="string"/>
							<element  minOccurs="0" name="Operation" type="string"/>
							<element  minOccurs="0" name="JMS" type="boolean"/>
						</sequence>
					</complexType>
				</element>
				<element name="InputDataUserLog" type="tns:InputDataUserLog_type"/>
			</sequence>
		</complexType>
	</element>
	<complexType name="InputDataUserLog_type">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="APPLICAZIONE_CLIENT" type="string"/>
			<element maxOccurs="1" minOccurs="1" name="COD_FUNZIONE" type="string"/>
			<element maxOccurs="1" minOccurs="1" name="COD_PROFILO" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="HOSTNAME_CLIENT" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="IP_CLIENT" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="IP_SERVER" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="OS_USER" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="PARAMETRI_OPERAZIONE" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="SERVER_NAME" type="string"/>
			<element maxOccurs="1" minOccurs="1" name="COD_INTRFC" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="USER_ID" type="string"/>
			<element maxOccurs="1" minOccurs="1" name="SESSION_ID" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="TIPO_OPERAZIONE">
				<simpleType>
					<restriction base="string">
						<enumeration value="LOGIN"/>
						<enumeration value="LOGOUT"/>
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="SISTEMA_CHIAMANTE" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="ID_ESE_PROC_NO_FILE" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="NOME_TAB_STAGING" type="string"/>
		</sequence>
	</complexType>
	<element name="Request" type="tns:InputDataUserLog_type"/>
	<element name="LoggerSecurityOutput">
		<complexType>
			<sequence>
				<element  minOccurs="1" name="ReturnCode">
					<simpleType>
						<restriction base="string">
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element  minOccurs="0" name="Description" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>