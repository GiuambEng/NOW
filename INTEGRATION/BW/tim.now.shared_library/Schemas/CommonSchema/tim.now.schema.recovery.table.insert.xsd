<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns="http://www.tim.com.insert.recovery.table" 
attributeFormDefault="unqualified" elementFormDefault="qualified" 
targetNamespace="http://www.tim.com.insert.recovery.table">
	<xs:element name="RecoveryInsert_Request">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" name="Application" type="xs:string"/>
				<xs:element minOccurs="0" name="LogLevel" type="xs:string"/>
				<xs:element minOccurs="0" name="LogName" type="xs:string"/>
				<xs:element minOccurs="0" name="Nome_Staging" type="xs:string"/>		
				<xs:element minOccurs="0" name="Id_Esec_Proc" type="xs:integer"/>
				<xs:element minOccurs="0" name="Stato_Elab">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="DA_LAVORARE" />
							<xs:enumeration value="LAVORATO" />
							<xs:enumeration value="LAVORAZIONE_IN_CORSO"></xs:enumeration>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="Flag_Lavorazione">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="Y"/>
							<xs:enumeration value="N"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
		<xs:element name="RecoveryInsert_Reponse">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" name="Esito" type="xs:string"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>