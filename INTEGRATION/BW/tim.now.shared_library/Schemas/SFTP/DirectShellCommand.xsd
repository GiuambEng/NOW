<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/DirectShellCommand" xmlns:tns="http://www.example.org/DirectShellCommand" elementFormDefault="qualified">
 <element name="Input">
    	<complexType>
    		<sequence>
    			<element name="Command" type="string"></element>
    		</sequence>
    	</complexType></element>

    <element name="Output">
    	<complexType>
    		<sequence>
    			<element name="Status" type="string"></element>
    			<element name="Message" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>
</schema>