<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/SFTP_DirDetailJavaCode" elementFormDefault="qualified" targetNamespace="http://www.example.org/SFTP_DirDetailJavaCode">

    <element name="Input_SFTP_DirDetail">
    	<complexType>
    		<sequence>
    			<element name="Credentials">
    				<complexType>
    					<sequence>
    						<element name="Host" type="string" />
    						<element name="User" type="string" />
    						<element name="Password" type="string" minOccurs="0" maxOccurs="1"/>
    						<element name="Port" type="int"></element>
    					</sequence>
    				</complexType>
    			</element>

    			
    			<element name="RequestType">

                    <complexType>
                    	 <choice minOccurs="1" maxOccurs="1">
						      <element name="ListOfFilesDetails" type="tns:ListOfFilesDetail"/>
						      <element name="SingleFileDetail" type="tns:SingleFileDetail"/>
						  </choice>
                    </complexType>
                </element>

    		</sequence>
    	</complexType>
  </element>
  
  

    <element name="Output_SFTP_DirDetail">
    	<complexType>
    		<sequence>
    			<element name="Status" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element maxOccurs="unbounded" minOccurs="0"
    				name="ListOfFiles">
    				<complexType>
    					<sequence>
    						<element name="FileName" type="string" />
    						<element name="FullName" type="string" />
    						<element name="Size" type="string" />
    						<element name="LastModified" type="string" />
    					</sequence>
    				</complexType>
    			</element>

    			<element name="Message" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
  </element>

    <complexType name="ListOfFilesDetail">
    	<sequence>
    		<element name="DirectoryPath" type="string"></element>
    		<element name="FileExtensionToFilter" type="string"></element>
    	</sequence>
    </complexType>
    
    <simpleType name="SingleFileDetail">
    	<restriction base="string"></restriction>
    </simpleType>
</schema>
