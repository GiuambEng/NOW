<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/SFTP_RenameJavaCode" xmlns:tns="http://www.tim.com/NOW/xsd/SFTP_RenameJavaCode" elementFormDefault="qualified">

    <element name="SFTP_RenameJavaCodeInput">
    	<complexType>
    		<sequence>
    			<element name="source" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="dest" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="credenziali">
    				<complexType>
    					<sequence>    						
				   			<element name="Host" type="string" maxOccurs="1" minOccurs="1"></element>
				   			<element name="Port" type="int" maxOccurs="1" minOccurs="1"></element>
				   			<element name="Password" type="string" maxOccurs="1" minOccurs="1"></element>
				   			<element name="User" type="string" maxOccurs="1" minOccurs="1"></element>
				   		</sequence>  
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="SFTP_RenameJavaCodeOutput">
    	<complexType>
    		<sequence>
    			<element name="Status" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="Message" type="string" minOccurs="0" maxOccurs="1"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="SFTP_RenameJavaCodeFault">
    	<complexType>
    		<sequence>
    			<element name="msg" type="string"></element>
    			<element name="code" type="string"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>