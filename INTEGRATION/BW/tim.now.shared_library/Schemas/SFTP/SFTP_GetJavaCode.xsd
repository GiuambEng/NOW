<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/SFTP_GetJavaCode" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/SFTP_GetJavaCode">

    <element name="SFTP_GetJavaCodeInput">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="RemoteFile" type="string"/>
    			<element maxOccurs="1" minOccurs="1" name="LocalFile" type="string"/>
    			<element name="credenziali">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="1" name="Host" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="Port" type="int">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="Password" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="User" type="string">
    						</element>


    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="SFTP_GetJavaCodeOutput">
    	<complexType>
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="dir" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="status" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="message" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="lastModify" type="dateTime"/>
    	</sequence>
    	</complexType>
    </element>
    
    <element name="SFTP_GetJavaCodeFault">
    	<complexType>
    		<sequence>
    			<element name="msg" type="string"/>
    			<element name="code" type="string"/>
    		</sequence>
    	</complexType>
    </element>
</schema>
