<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/SFTP_RemoveJavaCode" xmlns:tns="http://www.tim.com/NOW/xsd/SFTP_RemoveJavaCode" elementFormDefault="qualified">

    <element name="SFTP_RemoveJavaCodeInput">
    	<complexType>
    		<sequence>
    			<element name="RemoteFile" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="credenziali">
    				<complexType>
    					<sequence>
    						<element name="Host" type="string"
    							maxOccurs="1" minOccurs="1">
    						</element>
    						<element name="Port" type="int"
    							maxOccurs="1" minOccurs="1">
    						</element>
    						<element name="Password" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="User" type="string"
    							maxOccurs="1" minOccurs="1">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="SFTP_RemoveJavaCodeOutput">
    	<complexType>
    		<sequence>
    			<element name="dir" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="status" type="string" minOccurs="0" maxOccurs="1"></element>
    			<element name="message" type="string" minOccurs="0" maxOccurs="1"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="SFTP_RemoveJavaCodeFault">
    	<complexType>
    		<sequence>
    			<element name="msg" type="string"></element>
    			<element name="code" type="string"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>