<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New">

<element name="SFTP_Put_Input">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="FileToBeSend" type="string"/>
    			<element maxOccurs="1" minOccurs="1" name="RomoteDirectory" type="string"/>
                <element name="Credentials">
    				<complexType>
    					<sequence>
				   			<element maxOccurs="1" minOccurs="1" name="Host" type="string"/>
				   			<element maxOccurs="1" minOccurs="1" name="Port" type="int"/>
				   			<element maxOccurs="1" minOccurs="1" name="User" type="string"/>
				   			<element maxOccurs="1" minOccurs="0" name="Password" type="string"/>				   			
                        </sequence>
    				</complexType>
    			</element>
            </sequence>
    	</complexType>
    </element>
    
    <element name="SFTP_Put_Output">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="Status" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="Message" type="string"/>
    		</sequence>
    	</complexType>
    </element>
</schema>
