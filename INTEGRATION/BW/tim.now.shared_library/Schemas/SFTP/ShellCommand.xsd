<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ShellCommand" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ShellCommand">

    <element name="Input_ShellCommand">
    	<complexType>
    		<sequence>
    			<element name="Host" type="string"></element>
    			<element name="User" type="string"></element>
    			<element name="Password" type="string" minOccurs="0"
    				maxOccurs="1">
    			</element>
    			<element name="Port" type="int"></element>
    			<element name="Command" type="string"></element>
    		</sequence>
    	</complexType></element>

    <element name="Output_ShellCommand">
    	<complexType>
    		<sequence>
    			<element name="Status" type="string"></element>
    			<element name="Message" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>
</schema>