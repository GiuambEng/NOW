<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/SetCommandSharedLibrary" xmlns:tns="http://www.example.org/SetCommandSharedLibrary" elementFormDefault="qualified">
<element name="Input">
<complexType>
<sequence>
<element name="Command" type="string" minOccurs="1"/>
<element name="WorkingDirectory" type="string" minOccurs="0"/>
<element name="FlagSSH" type="string" minOccurs="1"/>
<element name="SSHHost" type="string" minOccurs="0"/>
<element name="SSHPort" type="string" minOccurs="0"/>
<element name="SSHUser" type="string" minOccurs="0"/>
<element name="SSHPassword" type="string" minOccurs="0"/>
<element name="LoggerName" type="string" minOccurs="0"/>
<element name="LoggerLevel" type="string" minOccurs="0"/>
</sequence>
</complexType>
</element>
<element name="Output">
<complexType>
<sequence>
<element name="Esito" type="string" minOccurs="1"/>
<element name="DescrError" type="string" minOccurs="0"/>
</sequence>
</complexType>
</element>
</schema>