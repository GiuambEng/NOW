<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VerificaLavorabilitaIDRisorsa" xmlns:tns="http://www.example.org/VerificaLavorabilitaIDRisorsa" elementFormDefault="qualified">

    <element name="Transaction_id">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="50"></maxLength>
    		</restriction>
    	</simpleType>
    </element>

    <element name="Transaction_date" type="dateTime"></element>


    <element name="ID_RISORSA">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="3"></maxLength>
    		</restriction>
    	</simpleType>
    </element>

    <element name="VerificaLavorabilitaInput">
    	<complexType>
    		<sequence>
                <element name="Transaction_id">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
                <element ref="tns:Transaction_date" minOccurs="1"></element>
                <element ref="tns:CODICE_OLO" minOccurs="1"></element>
                <element ref="tns:CODICE_OLO_CRMWS" minOccurs="1"></element>
                <element name="ID_RISORSA" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element ref="tns:ID_UNIVOCO_NOW"></element>
    			<element ref="tns:SERVIZIO" minOccurs="1"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="VerificaLavorabilitaOutput">
    	<complexType>
    		<sequence>
    			<element ref="tns:Transaction_id" minOccurs="1"></element>
                <element name="Response_date" type="dateTime" minOccurs="1">
    			</element>
                <element name="Return_code" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="2"></maxLength>
    						<enumeration value="00"></enumeration>
    						<enumeration value="01"></enumeration>
    						<enumeration value="02"></enumeration>
    						<enumeration value="03"></enumeration>
    						<enumeration value="04"></enumeration>
    					</restriction>
    				</simpleType>
                </element>
                <element ref="tns:Descrizione_errore" maxOccurs="1"
                	minOccurs="0"></element>
                
    			<element ref="tns:ID_ORDINE" maxOccurs="1"
    				minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Descrizione_errore">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="150"></maxLength>
    		</restriction>
    	</simpleType></element>

    <element name="ID_ORDINE">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="50"></maxLength>
    		</restriction>
    	</simpleType></element>


    <element name="root">
    	<complexType>
    		<sequence>
    			<element ref="tns:VerificaLavorabilitaIDRisorsa">
    			</element>
    		</sequence>
    	</complexType>
    </element>


    <element name="Messaggio_Errore" type="string"></element>

    <element name="Codice_Errore" type="string"></element>
    <element name="Input">
    	<complexType>
    		<sequence>
    			<element ref="tns:VerificaLavorabilitaInput"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Output">
    	<complexType>
    		<sequence>
    			<element ref="tns:VerificaLavorabilitaOutput"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Fault1">
    	<complexType>
    		<sequence>
    			<element ref="tns:Messaggio_Errore"></element>
    			<element ref="tns:Codice_Errore"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="VerificaLavorabilitaIDRisorsa">
    	<complexType>
    		<sequence>
    			<element ref="tns:Input"></element>
    			<element ref="tns:Output"></element>
    			<element ref="tns:Fault1"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="CODICE_OLO">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="3"></maxLength>
    		</restriction>
    	</simpleType>
    </element>

    <element name="CODICE_OLO_CRMWS">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="3"></maxLength>
    		</restriction>
    	</simpleType>
    </element>

    <element name="ID_UNIVOCO_NOW" type="int"></element>

    <element name="SERVIZIO">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="100"></maxLength>
    		</restriction>
    	</simpleType></element>
</schema>