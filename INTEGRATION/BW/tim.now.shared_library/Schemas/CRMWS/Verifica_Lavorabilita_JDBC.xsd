<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/Verifica_Lavorabilita_JDBC" xmlns:tns="http://www.example.org/Verifica_Lavorabilita_JDBC" elementFormDefault="qualified">

    <element name="Root">
    	<complexType>
    		<sequence>
    			<element ref="tns:Input1"></element>
    			<element ref="tns:Output1"></element>
    			<element ref="tns:Fault"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Input1">
    	<complexType>
    		<sequence>
    			<element minOccurs="1" maxOccurs="1" name="ID_RISORSA"
    				type="string">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Output1">
    	<complexType>
    		<sequence>
    			<element minOccurs="1" maxOccurs="1" name="Return_code"
    				type="string">
    			</element>
    			<element name="Descrizione_errore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Fault">
    	<complexType>
    		<sequence>
    			<element name="Messaggio_Errore" type="string"></element>
    			<element name="Codice_Errore" type="string"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>