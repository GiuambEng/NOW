<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.example.org/NOWSendIDULLCOolo" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/NOWSendIDULLCOolo">

    <element name="Transaction_id">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="50"></maxLength>
    		</restriction>
    	</simpleType>
    </element>

    <element name="Transaction_date" type="dateTime"></element>



    <element name="VerificaLavorabilitaInput">
    	<complexType>
    		<sequence>
    			<element name="Transaction_id" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element ref="tns:Transaction_date" minOccurs="1"></element>
                <element name="Sistema_origine" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"></maxLength>
    					</restriction>
    				</simpleType></element>
                <element name="Azione" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="I"></enumeration>
    						<enumeration value="M"></enumeration>
    						<enumeration value="C"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element ref="tns:IDULLCO" minOccurs="1"></element>
    			<element ref="tns:OPERATORE" minOccurs="1"></element>
    			<element ref="tns:CLLI" maxOccurs="1" minOccurs="1"></element>
    			<element ref="tns:DATA_CONSEGNA_OLO" minOccurs="1"></element>
    			<element ref="tns:DATA_FINE_VALIDITA" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element ref="tns:DATA_INVIO" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			<element ref="tns:Nome" maxOccurs="1" minOccurs="1"></element>
    			<element ref="tns:DRCP" maxOccurs="1" minOccurs="0"></element>
    			<element ref="tns:Codice_GAT" maxOccurs="1"
    				minOccurs="1">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="VerificaLavorabilitaOutput">
    	<complexType>
    		<sequence>
    			<element ref="tns:Transaction_id" minOccurs="1"></element>
                <element name="Response_date" type="dateTime" minOccurs="1"></element>
                <element name="Return_code" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="2"></maxLength>
    						<enumeration value="OK"></enumeration>
    						<enumeration value="KO"></enumeration>
    					</restriction>
    				</simpleType>
                </element>
    			<element ref="tns:Descrizione_errore" maxOccurs="1"
    				minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Descrizione_errore">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="100"></maxLength>
    		</restriction>
    	</simpleType></element>



    <element name="root">
    	<complexType>
    		<sequence>
    			<element ref="tns:NOW_SEND_IDULLCO">
    			</element>
    		</sequence>
    	</complexType>
    </element>


    <element name="Messaggio_Errore" type="string"></element>

    <element name="Codice_Errore" type="string"></element>
    <element name="Input">
    	<complexType>
    		<sequence>
    			<element ref="tns:VerificaLavorabilitaInput"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Output">
    	<complexType>
    		<sequence>
    			<element ref="tns:VerificaLavorabilitaOutput"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Fault1">
    	<complexType>
    		<sequence>
    			<element ref="tns:Messaggio_Errore"></element>
    			<element ref="tns:Codice_Errore"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="NOW_SEND_IDULLCO">
    	<complexType>
    		<sequence>
    			<element ref="tns:Input"></element>
    			<element ref="tns:Output"></element>
    			<element ref="tns:Fault1"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="CODICE_OLO">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="3"></maxLength>
    		</restriction>
    	</simpleType>
    </element>

    <element name="CODICE_OLO_CRMWS">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="3"></maxLength>
    		</restriction>
    	</simpleType>
    </element>




    <element name="IDULLCO">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="100"></maxLength>
    		</restriction>
    	</simpleType></element>


    <element name="OPERATORE">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="3"></maxLength>
    		</restriction>
    	</simpleType></element>

    <element name="CLLI">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="100"></maxLength>
    		</restriction>
    	</simpleType></element>

    <element name="DATA_CONSEGNA_OLO" type="date"></element>

    <element name="DATA_FINE_VALIDITA" type="date"></element>

    <element name="DATA_INVIO" type="date"></element>

    <element name="Nome">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="255"></maxLength>
    		</restriction>
    	</simpleType></element>

    <element name="DRCP">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="30"></maxLength>
    		</restriction>
    	</simpleType></element>

    <element name="Codice_GAT">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="6"></maxLength>
    		</restriction>
    	</simpleType></element>

</schema>