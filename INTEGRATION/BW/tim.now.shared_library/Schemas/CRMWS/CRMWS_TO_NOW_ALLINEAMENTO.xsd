<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/CRMWS_TO_NOW_ALLINEAMENTO" xmlns:tns="http://www.example.org/CRMWS_TO_NOW_ALLINEAMENTO" elementFormDefault="qualified">

    <element name="root">
    	<complexType>
    		<sequence>
    			<element ref="tns:input"></element>
    			<element ref="tns:output"></element>
    			<element ref="tns:fault"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="input">
    	<complexType>
    		<sequence>
    			<element minOccurs="1" maxOccurs="1"
    				name="TRANSACTION_ID" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1"
    				name="TRANSACTION_DATE" type="dateTime">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="output">
    	<complexType>
    		<sequence>
    			<element minOccurs="1" maxOccurs="1"
    				name="TRANSACTION_ID" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1"
    				name="RESPONSE_DATE" type="date">
    			</element>
    			<element minOccurs="1" maxOccurs="1"
    				name="RETURN_CODE">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="OK"></enumeration>
    						<enumeration value="KO"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element minOccurs="0" maxOccurs="1"
    				name="DESCRIZIONE_ERRORE" type="string">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="fault">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="1"
    				name="codice_errore" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1"
    				name="messaggio_errore" type="string">
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>