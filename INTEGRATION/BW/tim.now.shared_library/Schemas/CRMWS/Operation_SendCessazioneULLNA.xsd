<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/Operation SendCessazioneULLNA" xmlns:tns="http://www.example.org/Operation SendCessazioneULLNA" elementFormDefault="qualified" xmlns:Q1="SendCessazioneULLNA">

    <element name="Input">
    	<complexType>
    		<sequence>
    			<element name="REQUEST">
    				<complexType>
    					<sequence>
    						<element minOccurs="1" maxOccurs="1"
    							name="Transaction_id">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="50"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="Transaction_date"
    							type="date">
    						</element>
    						<element name="SERVIZIO">
    							<complexType>
    								<sequence>
    									<element minOccurs="1"
    										maxOccurs="1" name="CodiceOlo">
    										<simpleType>
    											<restriction
    												base="string">
    												<maxLength
    													value="3">
    												</maxLength>
    											</restriction>
    										</simpleType>
    									</element>
    									<element minOccurs="1"
    										maxOccurs="1" name="DescOLO">
    										<simpleType>
    											<restriction
    												base="string">
    												<maxLength
    													value="3">
    												</maxLength>
    											</restriction>
    										</simpleType>
    									</element>
    									<element name="ULLLNA">
    										<complexType>
    											<sequence>
    												<element
    													minOccurs="1" maxOccurs="1" name="Servizio">
    													<simpleType>
    														<restriction
    															base="string">
    															<maxLength
    																value="2">
    															</maxLength>
    															<enumeration
    																value="01">
    															</enumeration>
    															<enumeration
    																value="02">
    															</enumeration>
    														</restriction>
    													</simpleType>
    												</element>
    											</sequence>
    										</complexType>
    									</element>
    									<element name="ULL">
    										<complexType>
    											<sequence>
    												<element
    													name="CESSAZIONE">
    													<complexType>
    														<sequence>
    															<element
    																minOccurs="1" maxOccurs="1"
    																name="CODICEORDINEOLO">
    																<simpleType>
    																	<restriction
    																		base="string">
    																		<maxLength
    																			value="11">
    																		</maxLength>
    																	</restriction>
    																</simpleType>
    															</element>
    															<element
    																minOccurs="1" maxOccurs="1"
    																name="CODICE_ORDINE_TI">
    																<simpleType>
    																	<restriction
    																		base="string">
    																		<maxLength
    																			value="31">
    																		</maxLength>
    																	</restriction>
    																</simpleType>
    															</element>
    															<element
    																minOccurs="1" maxOccurs="1" name="CONTRATTO">
    																<simpleType>
    																	<restriction
    																		base="string">
    																		<maxLength
    																			value="15">
    																		</maxLength>
    																	</restriction>
    																</simpleType>
    															</element>
    															<element
    																minOccurs="1" maxOccurs="1" name="RISORSA">
    																<simpleType>
    																	<restriction
    																		base="string">
    																		<maxLength
    																			value="10">
    																		</maxLength>
    																	</restriction>
    																</simpleType>
    															</element>
    															<element
    																minOccurs="1" maxOccurs="1" name="ID_NOW"
    																type="string">
    															</element>
    															<element
    																name="DAC" type="date">
    															</element>
    															<element
    																name="DEC" type="date">
    															</element>
    														</sequence>
    													</complexType>
    												</element>
    											</sequence>
    										</complexType>
    									</element>
    								</sequence>
    							</complexType>
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Output">
    	<complexType>
    		<sequence>
    			<element name="RESPONSE">
    				<complexType>
    					<sequence>
    						<element minOccurs="1" maxOccurs="1"
    							name="Transaction_ID">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="50"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="Response_date" type="date"></element>
    						<element minOccurs="1" maxOccurs="1"
    							name="Return_Code">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="2"></maxLength>
    									<enumeration value="OK"></enumeration>
    									<enumeration value="KO"></enumeration>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="Descrizione_errore">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="150"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Fault">
    	<complexType>
    		<sequence>
    			<element name="Messaggio_Errore" type="string"></element>
    			<element name="Codice_Errore" type="string"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>