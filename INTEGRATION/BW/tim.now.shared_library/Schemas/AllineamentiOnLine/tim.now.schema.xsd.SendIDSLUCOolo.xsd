<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/SendIDSLUCOolo" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/SendIDSLUCOolo">
    <element name="NOWSendIDSLUCOolo_input">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="Transaction_id" type="tns:Char50"/>

                <element maxOccurs="1" minOccurs="1" name="Transaction_date" type="tns:NewDataTime">
                
                </element>
                <element maxOccurs="1" minOccurs="1" name="Sistema_origine">
    				<simpleType>
    					<restriction base="tns:Char50">
    						<enumeration value="PATROCLO"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="Azione">
    				<simpleType>
    					<restriction base="tns:Char1">
    						<enumeration value="I"/>
    						<enumeration value="V"/>
    					</restriction>
    				</simpleType>
    			</element>
                <element maxOccurs="1" minOccurs="1" name="IDSLUCO" type="tns:Char100" />
                <element maxOccurs="1" minOccurs="1" name="OPERATORE" type="tns:Char3"/>
    			<element maxOccurs="1" minOccurs="1" name="CLLI" type="tns:Char100"/>
    			<element maxOccurs="1" minOccurs="1" name="DATA_CONSEGNA_OLO" type="tns:NewDataTime"/>
    			<element maxOccurs="1" minOccurs="1" name="ID_RICHIESTA">
    			<simpleType>
    			<restriction base="int">
    			<totalDigits value="10"/>
    			</restriction>
          </simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="COPPIA_DA" type="tns:Char3"/>
    			<element maxOccurs="1" minOccurs="1" name="COPPIA_A" type="tns:Char3"/>
    			<element maxOccurs="1" minOccurs="1" name="DATA_INVIO" type="tns:NewDataTime"/>
    			<element maxOccurs="1" minOccurs="1" name="TESTARMADIO" type="tns:Char2"/>
    			<element maxOccurs="1" minOccurs="1" name="PROGRESSIVO" type="int"/>
    		</sequence>
    	</complexType>
    </element>

 

    <simpleType name="Char50">
    	<restriction base="string">
    	<maxLength value="50"/>
    	</restriction>
    </simpleType>

    <simpleType name="Char1">
    	<restriction base="string">
    	<maxLength value="1"/>
    </restriction>
    </simpleType>

    <simpleType name="Char100">
    	<restriction base="string">
    	<maxLength value="100"/>
    </restriction>
    </simpleType>

    <simpleType name="Char3">
    	<restriction base="string">
    	<maxLength value="3"/>
    </restriction>
    </simpleType>

    <simpleType name="Char2">
    	<restriction base="string">
    	<maxLength value="10"/>
    </restriction>
    </simpleType>

    <element name="NOWSendIDSLUCOolo_output">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="Transaction_ID" type="tns:Char50"/>
    			<element maxOccurs="1" minOccurs="1" name="Response_date" type="tns:NewDataTime"/>
    			<element maxOccurs="1" minOccurs="1" name="Return_Code">
    				<simpleType>
    					<restriction base="tns:Char2">
    						<enumeration value="00"/>
    						<enumeration value="01"/>
    						<enumeration value="02"/>
    						<enumeration value="03"/>
    						<enumeration value="04"/>
    						<enumeration value="05"/>
    						<enumeration value="06"/>
    						<enumeration value="07"/>
        					<enumeration value="08"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="Descrizione_errore" type="tns:Char150"/>
    		</sequence>
    	</complexType>
  </element>
  <simpleType name="NewDataTime">
                <restriction base="string">
                <pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"/>
    </restriction>
                </simpleType>

    <simpleType name="Char150">
    	<restriction base="string">
    	<maxLength value="150"/>
    	</restriction>
    </simpleType>

    <element name="NOWSendIDSLUCOolo_fault">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="Codice_errore" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="Messaggio_errore" type="string"/>
    		</sequence>
    	</complexType>
  </element>







</schema>
