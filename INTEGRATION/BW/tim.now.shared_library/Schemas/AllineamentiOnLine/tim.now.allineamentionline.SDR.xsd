<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:header="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_SDR/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/NOW_SDR/">
	<import namespace="http://telecomitalia.it/SOA/SOAP/SOAPHeader" schemaLocation="../CommonSchema/SOAPHeader_v1.1.xsd"/>
	<element name="Request">
		<complexType>
			<sequence>
				<element name="TIMESTAMP" type="dateTime">				</element>
				<element name="SISTEMA_SORGENTE">
					<simpleType>
						<restriction base="string">
							<maxLength value="10"/>
							<enumeration value="SDR"/>
						</restriction>
					</simpleType>
				</element>
				<element name="ID_RISORSA">
					<simpleType>
						<restriction base="string">
							<maxLength value="16"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Fault">
		<complexType>
			<sequence>
				<element name="Messaggio_errore">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="Codice_errore">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Response" type="tns:Response_type"/>
	<element name="Output" type="tns:Output_Process"/>
	<complexType name="Response_type">
		<sequence>
			<element name="IDRISORSA">
				<simpleType>
					<restriction base="string">
						<maxLength value="16"/>
					</restriction>
				</simpleType>
			</element>
			<element name="ESITO">
				<simpleType>
					<restriction base="string">
						<maxLength value="2"/>
						<enumeration value="SI"/>
						<enumeration value="NO"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="0" name="SERVIZIO">
				<simpleType>
					<restriction base="string">
						<maxLength value="50"/>
						<enumeration value="EASYIP"/>
						<enumeration value="BITSTREAMATMASIM"/>
						<enumeration value="BITSTREAMGBEASIM"/>
						<enumeration value="BSFTTHNGA"/>
						<enumeration value="BSFTTCNGA"/>
						<enumeration value="BSFTTHVULA"/>
						<enumeration value="BSFTTCVULA"/>
						<enumeration value="ULL LNA"/>
						<enumeration value="ULL DATI LNA"/>
						<enumeration value="ULL LNA"/>
						<enumeration value="SLU LNA"/>
					</restriction>
				</simpleType>
			</element>
			<element name="RETURN_CODE">
				<simpleType>
					<restriction base="string">
						<enumeration value="OK"/>
						<enumeration value="KO"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="0" name="DESC_ERRORE">
				<simpleType>
					<restriction base="string">
						<maxLength value="255"/>
					</restriction>
				</simpleType>
			</element>
		</sequence>
	</complexType>
	<complexType name="Output_Process">
		<sequence>
			<element name="ResponseProcess" type="tns:Response_type"/>
			<element name="Header_Output" type="header:HeaderType"/>
		</sequence>
	</complexType>
</schema>
