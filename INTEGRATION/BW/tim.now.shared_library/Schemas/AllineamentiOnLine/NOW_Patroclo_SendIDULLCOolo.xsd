<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO/" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO/">
      
  <element name="NOW_Patroclo_SendIDULLCOolo_request">
            
    <complexType>
                  
      <sequence>
                        
        <element maxOccurs="1" minOccurs="1" name="Transaction_id">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <maxLength value="50"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="1" name="Transaction_date">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <length value="19"/>
                                          
              <pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="1" name="Sistema_origine">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <enumeration value="PATROCLO"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="1" name="Azione">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <length value="1"/>
                                          
              <enumeration value="I"/>
                                          
              <enumeration value="M"/>
                                          
              <enumeration value="C"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="1" name="IDULLCO">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <maxLength value="100"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="1" name="OPERATORE">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <maxLength value="3"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="1" name="CLLI">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <maxLength value="100"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="1" name="DATA_CONSEGNA_OLO">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <length value="10"/>
                                          
              <pattern value="\d\d-\d\d-\d\d\d\d"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="0" name="DATA_FINE_VALIDITA">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <length value="10"/>
                                          
              <pattern value="\d\d-\d\d-\d\d\d\d"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="1" name="DATA_INVIO">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <length value="10"/>
                                          
              <pattern value="\d\d-\d\d-\d\d\d\d"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="1" name="Nome">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <maxLength value="255"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="0" name="DRCP">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <maxLength value="30"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="1" name="Codice_GAT">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <maxLength value="6"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="0" name="TIPO_COLOCAZIONE">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <enumeration value="0"/>
                                          
              <enumeration value="1"/>
                                          
              <enumeration value="2"/>
                                          
              <enumeration value="3"/>
                                          
              <enumeration value="4"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                    
      </sequence>
              
    </complexType>
        
  </element>
  	
  <element name="NOW_Patroclo_SendIDULLCOolo_Root">
    		
    <complexType>
        
			
      <sequence>
            
				
        <element ref="tns:NOW_Patroclo_SendIDULLCOolo_request"/>
        				
        <element ref="tns:NOW_Patroclo_SendIDULLCOolo_response"/>
           
			
      </sequence>
      		
    </complexType>
        
  </element>
      
  <element name="NOW_Patroclo_SendIDULLCOolo_response">
            
    <complexType>
                  
      <sequence>
                        
        <element maxOccurs="1" minOccurs="1" name="Transaction_id">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <maxLength value="50"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="1" name="Response_date">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <length value="19"/>
                                          
              <pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="1" name="Return_Code">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <length value="2"/>
                                          
              <enumeration value="00"/>
                                          
              <enumeration value="03"/>
                                          
              <enumeration value="05"/>
                                          
              <enumeration value="06"/>
                                          
              <enumeration value="07"/>
                                          
              <enumeration value="08"/>
                                          
              <enumeration value="09"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                        
        <element maxOccurs="1" minOccurs="0" name="Descrizione_errore">
                              
          <simpleType>
                                    
            <restriction base="string">
                                          
              <maxLength value="150"/>
                                      
            </restriction>
                                
          </simpleType>
                          
        </element>
                    
      </sequence>
              
    </complexType>
        
  </element>
  	
  <element name="SoapFault">
    		
    <complexType>
      			
      <sequence>
        				
        <element minOccurs="0" name="CodiceErrore" type="string"/>
        				
        <element minOccurs="0" name="MessaggioErrore" type="string"/>
        			
      </sequence>
      		
    </complexType>
    	
  </element>
  
</schema>
