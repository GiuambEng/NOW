<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_HAL_QUADRATURA/" targetNamespace="http://www.tim.com/NOW/xsd/NOW_HAL_QUADRATURA/" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="NOW_HAL_QUADRATURA">
		<complexType>
			<sequence>
				<element ref="tns:NOW_HAL_QUADRATURA_Request"/>
				<element ref="tns:NOW_HAL_QUADRATURA_Response"/>
			</sequence>
		</complexType>
	</element>
	<simpleType name="String15">
		<restriction base="string">
			<maxLength value="15"/>
		</restriction>
	</simpleType>
	<simpleType name="String20">
		<restriction base="string">
			<maxLength value="20"/>
		</restriction>
	</simpleType>
	<simpleType name="String31">
		<restriction base="string">
			<maxLength value="31"/>
		</restriction>
	</simpleType>
	<simpleType name="String4">
		<restriction base="string">
			<maxLength value="4"/>
		</restriction>
	</simpleType>
	<simpleType name="String2">
		<restriction base="string">
			<maxLength value="2"/>
		</restriction>
	</simpleType>
	<simpleType name="String30">
		<restriction base="string">
			<maxLength value="30"/>
		</restriction>
	</simpleType>
	<simpleType name="String3">
		<restriction base="string">
			<maxLength value="3"/>
		</restriction>
	</simpleType>
	<simpleType name="String6">
		<restriction base="string">
			<maxLength value="6"/>
		</restriction>
	</simpleType>
	<simpleType name="String9">
		<restriction base="string">
			<maxLength value="9"/>
		</restriction>
	</simpleType>
	<simpleType name="date1">
		<restriction base="date"/>
	</simpleType>
	<element name="NOW_HAL_QUADRATURA_Request">
		<complexType>
			<sequence>
				<element name="DN" type="tns:String15" minOccurs="1" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="NOW_HAL_QUADRATURA_Response">
		<complexType>
			<sequence>
				<element name="Servizio" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
						<element name="ESITO" minOccurs="1" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="2"/>
										<enumeration value="OK"/>
										<enumeration value="KO"/>
									</restriction>
								</simpleType>
							</element>
						<element name="CODICE_ERRORE" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="tns:String4">
										<enumeration value="01"/>
										<enumeration value="02"/>
										<enumeration value="03"/>
										<enumeration value="04"/>
									</restriction>
								</simpleType>
							</element>
						<element name="TIMESTAMP" type="tns:String31" minOccurs="1" maxOccurs="1"/>
							<element name="NOME_SERVIZIO" minOccurs="1" maxOccurs="1" nillable="true">
								<simpleType>
									<restriction base="string">
										<maxLength value="30"/>
										<enumeration value="NPG"/>
										<enumeration value="SLU + NP"/>
										<enumeration value="ULL DATI LA+NP"/>
										<enumeration value="ULL LA + NP"/>
										<enumeration value="VULL"/>
										<enumeration value="WLR LA"/>
										<enumeration value="WLR LNA"/>
										<enumeration value="SLU LA"/>
										<enumeration value="SLU LNA"/>
										<enumeration value="ULL DATI LNA"/>
										<enumeration value="ULL DATI LA"/>
										<enumeration value="ULL LA"/>
										<enumeration value="ULL LNA"/>
										<enumeration value="CPS"/>
										<enumeration value="SHA con Manodopera"/>
										<enumeration value="SHA senza Manodopera"/>
									</restriction>
								</simpleType>
							</element>
							<element name="DESC_OLO" type="tns:String3" minOccurs="1" maxOccurs="1"/>
							<element name="CODICE_OLO" type="tns:String3" minOccurs="1" maxOccurs="1"/>
							<element name="TIPO_LINEA" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="30"/>
										<enumeration value="ISDN"/>
										<enumeration value="POTS"/>
										<enumeration value="ADSL"/>
										<enumeration value="---"/>
										<enumeration value="NA"/>
									</restriction>
								</simpleType>
							</element>
							<element name="DEC" type="tns:String31" nillable="true" minOccurs="1" maxOccurs="1"/>
							<element name="RN" type="tns:String31" minOccurs="0" maxOccurs="1"/>
							<element name="CENTRALE" type="tns:String6" minOccurs="0" maxOccurs="1"/>
							<element name="SEDE_GAT" type="tns:String6" minOccurs="0" maxOccurs="1"/>
							<element name="IDSLUCO" type="tns:String20" minOccurs="0" maxOccurs="1"/>
							<element name="COPPIA" type="tns:String6" minOccurs="0" maxOccurs="1"/>
							<element name="PERMUTATORE_OLO" type="tns:String15" minOccurs="0" maxOccurs="1"/>
							<element name="ENTITA_RIFERIMENTO" minOccurs="1" maxOccurs="1" nillable="true">
								<simpleType>
									<restriction base="string">
										<maxLength value="15"/>
										<enumeration value="ASSET"/>
										<enumeration value="ORDINE"/>
									</restriction>
								</simpleType>
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Fault_NowHalQuadratura">
		<complexType>
			<sequence>
				<element name="Codice_errore" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="Messaggio_errore" type="string" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
</schema>
