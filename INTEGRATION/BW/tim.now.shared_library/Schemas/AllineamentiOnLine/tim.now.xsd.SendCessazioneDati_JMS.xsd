<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/tim.now.xsd.SendCessazioneDati_JMS" elementFormDefault="qualified" targetNamespace="http://www.example.org/tim.now.xsd.SendCessazioneDati_JMS">
	<element name="SoapFault">
		<complexType>
			<sequence>
				<element minOccurs="0" name="CodiceErrore" type="string"/>
				<element minOccurs="0" name="MessaggioErrore" type="string"/>
				<element name="SERVIZIO" type="tns:SERVIZIO"/>
			</sequence>
		</complexType>
	</element>
	<complexType name="SERVIZIO">
		<sequence>
			<element name="CodiceOlo">
				<simpleType>
					<restriction base="string">
						<maxLength value="3">
									</maxLength>
					</restriction>
				</simpleType>
			</element>
			<element name="DescOlo">
				<simpleType>
					<restriction base="string">
						<maxLength value="3">
									</maxLength>
					</restriction>
				</simpleType>
			</element>
			<element name="CESSAZIONE" type="tns:CESSAZIONE" maxOccurs="1"/>
		</sequence>
	</complexType>
	<complexType name="CESSAZIONE">
		<sequence>
			<element name="CodiceOrdineOlo" maxOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="11">
									</maxLength>
					</restriction>
				</simpleType>
			</element>
			<element name="Codice_ordine_TI">
				<simpleType>
					<restriction base="string">
						<maxLength value="31">
									</maxLength>
					</restriction>
				</simpleType>
			</element>
			<element name="Contratto">
				<simpleType>
					<restriction base="string">
						<maxLength value="15"/>
					</restriction>
				</simpleType>
			</element>
			<element name="Risorsa">
				<simpleType>
					<restriction base="string">
						<maxLength value="100"/>
					</restriction>
				</simpleType>
			</element>
			<element name="ID_NOW" type="int"/>
			<element name="DAC" type="date" minOccurs="0"/>
			<element name="Dec" type="date"/>
			<element name="Servizio">
				<simpleType>
					<restriction base="string">
						<maxLength value="2"/>
						<enumeration value="04"/>
						<enumeration value="05"/>
						<enumeration value="06"/>
						<enumeration value="07"/>
						<enumeration value="08"/>
						<enumeration value="09"/>
						<enumeration value="10"/>
						<enumeration value="11"/>
						<enumeration value="12"/>
						<enumeration value="13"/>
						<enumeration value="14"/>
						<enumeration value="15"/>
					</restriction>
				</simpleType>
			</element>
		</sequence>
	</complexType>
	<element name="Now_SendCessazioneDati_Response">
		<complexType>
			<sequence>
				<element name="Transaction_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element name="Response_date" type="dateTime"/>
				<element name="Return_Code">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="Descrizione_errore">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Now_SendCessazioneDati_Request">
		<complexType>
			<sequence>
				<element name="SERVIZIO" type="tns:SERVIZIO" maxOccurs="1"/>
				<element name="REQUEST" type="tns:REQUEST" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="Now_SendCessazioneDati_Root">
		<complexType>
			<sequence>
				<element ref="tns:Now_SendCessazioneDati_Request"/>
				<element ref="tns:Now_SendCessazioneDati_Response"/>
			</sequence>
		</complexType>
	</element>
	<complexType name="REQUEST">
		<sequence>
			<element name="Transaction_id" maxOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="50"/>
					</restriction>
				</simpleType>
			</element>
			<element name="CorrelationID">
				<simpleType>
					<restriction base="string">
						<maxLength value="100"/>
					</restriction>
				</simpleType>
			</element>
			<element name="Transaction_date">
				<simpleType>
					<restriction base="string">
						<maxLength value="100"/>
					</restriction>
				</simpleType>
			</element>
		</sequence>
	</complexType>
</schema>
