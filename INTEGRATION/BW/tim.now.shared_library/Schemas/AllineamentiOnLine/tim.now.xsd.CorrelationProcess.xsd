<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.tim.now.WLR_CorrelationProcess" 
xmlns="http://www.tim.now.WLR_CorrelationProcess"
xmlns:tns1="http://NOW.it.telecomitalia.it/casedata"
elementFormDefault="qualified" attributeFormDefault="unqualified">
<xs:import namespace="http://NOW.it.telecomitalia.it/casedata" schemaLocation="../BOMCaseData/Casedata.xsd"/>
	<xs:element name="Input_1">
	<xs:complexType>
		<xs:sequence>
			<xs:element name="Tipologia">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Tipologia_1" />
						<xs:enumeration value="Tipologia_2" />
						<xs:enumeration value="Tipologia_3" />
						<xs:enumeration value="No_Tipologia" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DN" type="xs:string" minOccurs="0" />
			<xs:element name="IdRisorsaOLD" type="xs:string"
				minOccurs="0" />
			<xs:element name="Id_Risorsa_Correlata" type="xs:string"
				minOccurs="0" />
			<xs:element name="Offerta" type="xs:string" minOccurs="1" />
			<xs:element name="CodificaOLOAgcom" type="xs:string"
				minOccurs="1" />
			<xs:element name="Asset" type="tns1:Asset" />
			<xs:element name="ProcessName" type="xs:string"
				maxOccurs="1" minOccurs="0">
			</xs:element>
			<xs:element name="Transaction_id" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
		</xs:sequence>
	</xs:complexType>
	</xs:element>
	<xs:element name="Input_2">
	<xs:complexType>
		<xs:sequence>
			<xs:element name="Tipologia">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Tipologia_1" />
						<xs:enumeration value="Tipologia_2" />
						<xs:enumeration value="Tipologia_3" />
						<xs:enumeration value="No_Tipologia" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DN" type="xs:string" minOccurs="1" />
			<xs:element name="Asset" type="tns1:Asset" />
			<xs:element name="Transaction_id" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
		</xs:sequence>
	</xs:complexType>
	</xs:element>
	<xs:element name="CheckOfferta">
	<xs:complexType>
		<xs:sequence>
			<xs:element name="Check" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	</xs:element>
	<xs:element name="Input_Main">
	<xs:complexType>
		<xs:sequence>
			<xs:element name="IdAssetNow" type="xs:string"
				minOccurs="1" />
			<xs:element name="DN" type="xs:string" minOccurs="0" />
			<xs:element name="Asset_Now" type="tns1:Asset"
				minOccurs="1" />
			<xs:element name="ProcessName" type="xs:string"
				maxOccurs="1" minOccurs="0">
			</xs:element>
			<xs:element name="Transaction_ID" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
		</xs:sequence>
	</xs:complexType>
	</xs:element>
	<xs:element name="Output_Main">
	<xs:complexType>
		<xs:sequence>
			<xs:element name="Output_Correlazione" minOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Y"/>
						<xs:enumeration value="N"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="IdRisosaCorrelazione" type="xs:string" minOccurs="0"/>
			<xs:element name="Tipologia" maxOccurs="1" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Tipologia_1" />
						<xs:enumeration value="Tipologia_2" />
						<xs:enumeration value="Tipologia_3" />
						<xs:enumeration value="No_Tipologia" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	</xs:element>
</xs:schema>