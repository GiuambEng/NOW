<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO_JMS/" targetNamespace="http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO_JMS/" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="Now_SendIdullco_Request">
		<complexType>
			<sequence>
				<element name="Transaction_id" type="string" minOccurs="0"/>
				<element name="Azione" type="string" minOccurs="0"/>
				<element name="ID_ESEC_PROC_FILE" type="integer" minOccurs="0"/>
				<element name="CorrelationID" type="integer" minOccurs="0"/>
				<element name="PID" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="Now_SendIdullco_Response">
		<complexType>
			<sequence>
				<element name="Transaction_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element name="Response_date" type="dateTime"/>
				<element name="Return_Code">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
						</restriction>
					</simpleType>
				</element>
				<element name="Descrizione_errore" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Now_SendIdullco_Root">
		<complexType>
			<sequence>
				<element ref="tns:Now_SendIdullco_Request"/>
				<element ref="tns:Now_SendIdullco_Response"/>
			</sequence>
		</complexType>
	</element>
	<element name="SoapFault">
		<complexType>
			<sequence>
				<element name="CodiceErrore" type="string" minOccurs="0"/>
				<element name="MessaggioErrore" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>