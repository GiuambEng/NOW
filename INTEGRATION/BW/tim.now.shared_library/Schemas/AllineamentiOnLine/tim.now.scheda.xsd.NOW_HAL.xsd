<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified" attributeFormDefault="unqualified" targetNamespace="http://www.tim.com/NOW/xsd/NOW_HAL/" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_HAL/">
	<element name="NOW_HAL">
		<complexType>
			<sequence>
				<element ref="tns:NOW_HAL_Request"/>
				<element ref="tns:NOW_HAL_Response"/>
			</sequence>
		</complexType>
	</element>
	<simpleType name="String4">
		<restriction base="string">
			<maxLength value="4"/>
		</restriction>
	</simpleType>
	<simpleType name="String2">
		<restriction base="string">
			<maxLength value="2"/>
		</restriction>
	</simpleType>
	<simpleType name="String39">
		<restriction base="string"/>
	</simpleType>
	<simpleType name="String30">
		<restriction base="string">
			<maxLength value="30"/>
		</restriction>
	</simpleType>
	<simpleType name="String50">
		<restriction base="string">
			<maxLength value="50"/>
		</restriction>
	</simpleType>
	<simpleType name="String64">
		<restriction base="string"/>
	</simpleType>
	<simpleType name="String3">
		<restriction base="string">
			<maxLength value="3"/>
		</restriction>
	</simpleType>
	<simpleType name="String7">
		<restriction base="string">
			<maxLength value="7"/>
		</restriction>
	</simpleType>
	<simpleType name="String5">
		<restriction base="string">
			<maxLength value="5"/>
		</restriction>
	</simpleType>
	<simpleType name="String100">
		<restriction base="string">
			<maxLength value="100"/>
		</restriction>
	</simpleType>
	<simpleType name="String16">
		<restriction base="string">
			<maxLength value="16"/>
		</restriction>
	</simpleType>
	<simpleType name="String11">
		<restriction base="string">
			<maxLength value="11"/>
		</restriction>
	</simpleType>
	<simpleType name="String6">
		<restriction base="string">
			<maxLength value="6"/>
		</restriction>
	</simpleType>
	<simpleType name="String9">
		<restriction base="string">
			<maxLength value="9"/>
		</restriction>
	</simpleType>
	<simpleType name="int4">
		<restriction base="int">
			<totalDigits value="4"/>
		</restriction>
	</simpleType>
	<element name="NOW_HAL_Request">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="Distretto" type="tns:String4">
    			</element>
				<element maxOccurs="1" minOccurs="1" name="ID_RISORSA" type="tns:String15">
    			</element>
			</sequence>
		</complexType>
	</element>
	<element name="NOW_HAL_Response">
		<complexType>
			<sequence>
				<element name="Esito">
					<complexType>
						<sequence>
							<element maxOccurs="1" minOccurs="1" name="Esito">
								<simpleType>
									<restriction base="string">
										<enumeration value="OK"/>
										<enumeration value="KO"/>
										<maxLength value="2"/>
									</restriction>
								</simpleType>
							</element>
							<element maxOccurs="1" minOccurs="0" name="Codice_Errore">
								<simpleType>
									<restriction base="tns:String4">
										<enumeration value="1"/>
										<enumeration value="2"/>
										<enumeration value="3"/>
										<enumeration value="4"/>
									</restriction>
								</simpleType>
							</element>
							<element maxOccurs="1" minOccurs="1" name="TIMESTAMP" type="tns:String30">
    						</element>
						</sequence>
					</complexType>
				</element>
				<element maxOccurs="unbounded" minOccurs="0" name="Servizio">
					<complexType>
						<sequence>
							<element maxOccurs="unbounded" minOccurs="0" name="VC">
								<complexType>
									<sequence>
										<element maxOccurs="1" minOccurs="1" name="ID_RISORSA_VC" type="tns:String50">
    									</element>
										<element maxOccurs="1" minOccurs="1" name="CODICE_TD_OLO" type="tns:String9">
    									</element>
										<element maxOccurs="1" minOccurs="0" name="MCR_DOWNSTREAM" type="tns:String6">
    									</element>
										<element maxOccurs="1" minOccurs="0" name="MCR_UPSTREAM" type="tns:String6">
    									</element>
										<element maxOccurs="1" minOccurs="0" name="PCR_DOWNSTREAM" type="tns:String6">
    									</element>
										<element maxOccurs="1" minOccurs="0" name="PCR_UPSTREAM" type="tns:String6">
    									</element>
									</sequence>
								</complexType>
							</element>
							<element maxOccurs="4" minOccurs="0" name="UserVlan">
								<complexType>
									<sequence>
										<element maxOccurs="1" minOccurs="1" name="ID_RISORSA_USERVLAN" type="tns:String50">
    									</element>
										<element maxOccurs="1" minOccurs="0" name="SVLAN" type="tns:String16">
    									</element>
										<element maxOccurs="1" minOccurs="0" name="CODE_VLAN_SINGLE_TAG" type="tns:String16">
    									</element>
										<element maxOccurs="1" minOccurs="0" name="CVLAN" type="tns:int4">
    									</element>
										<element maxOccurs="1" minOccurs="0" name="USERVLAN" type="tns:int4">
    									</element>
										<element maxOccurs="1" minOccurs="0" name="BANDA_PICCO_DOWN" type="tns:String6">
    									</element>
										<element maxOccurs="1" minOccurs="0" name="BANDA_PICCO_UP" type="tns:String6">
    									</element>
									</sequence>
								</complexType>
							</element>
							<element maxOccurs="1" minOccurs="0" name="Linea_Riferimento" type="tns:String50">
    						</element>
							<element maxOccurs="1" minOccurs="0" name="Distretto" type="tns:String4">
    						</element>
							<element maxOccurs="1" minOccurs="0" name="Numerazione_Fittizia" type="tns:String30">
    						</element>
							<element maxOccurs="1" minOccurs="0" name="Linea_condivisa">
								<simpleType>
									<restriction base="string">
										<enumeration value="S"/>
										<enumeration value="N"/>
									</restriction>
								</simpleType>
							</element>
							<element maxOccurs="1" minOccurs="0" name="TIPO_SERVIZIO">
								<simpleType>
									<restriction base="string">
										<enumeration value="F"/>
										<enumeration value="D"/>
									</restriction>
								</simpleType>
							</element>
							<element maxOccurs="1" minOccurs="0" name="NOME_SERVIZIO">
								<simpleType>
									<restriction base="string">
										<maxLength value="64"/>
										<enumeration value="EASYIP"/>
                                        <enumeration value="BITSTREAMATMASIM"/>
                                         <enumeration value="BITSTREAMATMSIM"/>
                                         <enumeration value="BITSTREAMGBESIM"/>
                                          <enumeration value="BITSTREAMGBEASIM"/>
                                            <enumeration value="BSFTTHNGA"/>
                                             <enumeration value="BSFTTCNGA"/>
                                              <enumeration value="BSFTTHVULA"/>
                                              <enumeration value="BSFTTCVULA"/>
                                              <enumeration value= "ULL LA"/>
                                               <enumeration value="ULL LA + NP"/>
                                               <enumeration value="ULL LNA"/>
                                               <enumeration value="NPG"/>
                                               <enumeration value="SHA SENZA MANODOPERA"/>
                                                 <enumeration value="SHA CON MANODOPERA"/>
                                                  <enumeration value="VULL"/>
                                                 <enumeration value="ULL DATI LA"/>
                                                 <enumeration value="ULL DATI LA + NP"/>
                                                 <enumeration value="ULL DATI LNA"/>
                                                  <enumeration value="WLR LA"/>
                                                   <enumeration value="WLR LNA"/>
                                                    <enumeration value="SLU LA"/>
                                                    <enumeration value="SLU LA + NP"/>
                                                     <enumeration value="SLU LNA"/>
                                                     <enumeration value="BIT_SIMM"/>
                                                      <enumeration value="EASYIP-FTTC"/>
                                                       <enumeration value="EASYIP-FTTH"/>
                                                     <enumeration value="SEMIBSFTTHVULA"/>
												<enumeration value="SEMIBSFTTHNGA"/>
												<enumeration value="SEMIEASYIP-FTTH"/>
												<enumeration value="CPS"/>
									</restriction>
								</simpleType>
							</element>
							<element maxOccurs="1" minOccurs="1" name="CODICE_OLO" type="tns:String3">
    						</element>
							<element maxOccurs="1" minOccurs="0" name="MODALITA_FATTURAZIONE">
								<simpleType>
									<restriction base="tns:String7">
										<enumeration value="FLAT"/>
										<enumeration value="CONSUMO"/>
									</restriction>
								</simpleType>
							</element>
							<element maxOccurs="1" minOccurs="0" name="RO" type="tns:String2">
    						</element>
							<element maxOccurs="1" minOccurs="0" name="DR">
								<simpleType>
									<restriction base="tns:String2">
										<enumeration value="01"/>
										<enumeration value="02"/>
										<enumeration value="03"/>
										<enumeration value="04"/>
										<enumeration value="05"/>
										<enumeration value="06"/>
										<enumeration value="07"/>
										<enumeration value="08"/>
										<enumeration value="09"/>
										<enumeration value="10"/>
										<enumeration value="11"/>
										<enumeration value="12"/>
										<enumeration value="13"/>
										<enumeration value="14"/>
										<enumeration value="15"/>
										<enumeration value="16"/>
										<enumeration value="19"/>
										<enumeration value="20"/>
									</restriction>
								</simpleType>
							</element>
							<element maxOccurs="1" minOccurs="0" name="CAP" type="tns:String5">
    						</element>
							<element maxOccurs="1" minOccurs="0" name="CIVICO" type="tns:String50">
    						</element>
							<element maxOccurs="1" minOccurs="0" name="COMUNE" type="tns:String100">
    						</element>
							<element maxOccurs="1" minOccurs="0" name="PROVINCIA" type="tns:String100">
    						</element>
							<element maxOccurs="1" minOccurs="0" name="INDIRIZZO" type="tns:String100">
    						</element>
							<element maxOccurs="1" minOccurs="0" name="CODICE_FISCALE" type="tns:String16">
    						</element>
							<element maxOccurs="1" minOccurs="0" name="PARTITA_IVA" type="tns:String16">
    						</element>
							<element maxOccurs="1" minOccurs="0" name="TECNOLOGIA_ACCESSO">
								<simpleType>
									<restriction base="tns:String6">
										<enumeration value="ADSL" />
										<enumeration value="HDSL" />
										<enumeration value="SDSL" />
										<enumeration value="HSHDSL" />
										<enumeration value="SSHDSL" />
										<enumeration value="SDH"></enumeration>
									</restriction>
								</simpleType>
							</element>
							<element maxOccurs="1" minOccurs="0" name="TIPO_LINEA" type="tns:String30">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="STRUTTURA_LINEA" type="tns:String30">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="INDIRIZZO_IP_1" type="tns:String30">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="INDIRIZZO_IP_2" type="tns:String30">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="INDIRIZZO_IP_3" type="tns:String30">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="INDIRIZZO_IP_4" type="tns:String30">
    						</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<simpleType name="String15">
		<restriction base="string">
			<maxLength value="20"/>
		</restriction>
	</simpleType>
	<element name="Fault_NowHal">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="Codice_errore" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Messaggio_errore" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>