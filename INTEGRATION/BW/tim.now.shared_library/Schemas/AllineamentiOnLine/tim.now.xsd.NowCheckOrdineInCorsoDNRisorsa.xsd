<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/tim.now.xsd.NowCheckOrdineInCorsoDNRisorsa" xmlns:tns="http://www.example.org/tim.now.xsd.NowCheckOrdineInCorsoDNRisorsa" elementFormDefault="qualified">
<element name="NowCheckOrdineInCorsoDNRisorsa_Request">
		<complexType>
			<sequence>
				<element maxOccurs="1" name="Transaction_id">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="Transaction_date" type="dateTime"/>
				<element maxOccurs="1" name="CODICE_ORDINE_OLO">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				
				<element maxOccurs="unbounded" name="RISORSE" minOccurs="1">
				<complexType>
				<sequence>
				<element  name="ID_RISORSA" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DN" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="1" name="LAVORAZIONE">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
							<enumeration value="ATTIVAZIONE"/>
							<enumeration value="MIGRAZIONE"/>
							<enumeration value="CESSAZIONE"/>
							<enumeration value="VARIAZIONE"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="ID_CRMWS">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="ID_NOW" type="integer"></element>
				</sequence>
			</complexType>
			</element>
		</sequence>
	</complexType>
</element>		


	<element name="NowCheckOrdineInCorsoDNRisorsa_Response">
		<complexType>
			<sequence>
				<element maxOccurs="1" name="TRANSACTION_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="RESPONSE_DATE" type="dateTime"/>
				<element maxOccurs="1" name="CODICE_ORDINE_OLO">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				
				<element maxOccurs="1" name="RISORSE" minOccurs="1">
				<complexType>
				<sequence>
				
				<element  name="ID_RISORSA" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DN" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="1" name="Return_Code">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="00"/>
							<enumeration value="01"/>
							<enumeration value="02"/>
							<enumeration value="03"/>
							<enumeration value="04"/>
							<enumeration value="05"/>
							<enumeration value="10"/>
							<enumeration value="99"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="Descrizione_errore">
					<simpleType>
						<restriction base="string">
							<maxLength value="150"/>
							<enumeration value="NP in corso"/>
							<enumeration value="Migrazione in corso"/>
							<enumeration value="Cessazione in corso"/>
							<enumeration value="Attivazione in corso"/>
							<enumeration value="Variazione in corso"/>
							<enumeration value="Risorsa cessata"/>
							<enumeration value="KO generico"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="ID_ORDINE" type="string"></element>
				</sequence>
		</complexType>
		</element>	
			</sequence>
		</complexType>
		</element>	
			<element name="SoapFault">
		<complexType>
			<sequence>
				<element name="CodiceErrore" type="string" minOccurs="0"/>
				<element name="MessaggioErrore" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>



</schema>