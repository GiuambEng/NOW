<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/tim.now.xsd.NowCheckRaccoltaVLAN" elementFormDefault="qualified" targetNamespace="http://www.example.org/tim.now.xsd.NowCheckRaccoltaVLAN">
	<element name="NowCheckRaccoltaVLAN_Request">
		<complexType>
			<sequence>
				<element maxOccurs="1" name="Transaction_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="Transaction_Date" type="dateTime"/>
				<element minOccurs="1" name="OLO_CODING">
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="1" name="OLO_CODE">
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="4" minOccurs="1" name="CODICI_VLAN" type="tns:CODICI_VLAN"/>
			</sequence>
		</complexType>
	</element>
	<element name="NowCheckRaccoltaVLAN_Response">
		<complexType>
			<sequence>
				<element maxOccurs="1" name="Transaction_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="Response_date" type="dateTime"/>
				<element minOccurs="0" name="ID_RISORSA">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="CVLAN_ID" type="int"/>
				<element maxOccurs="1" name="Esito">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="CodiceCausale">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="00"/>
							<enumeration value="01"/>
							<enumeration value="02"/>
							<enumeration value="99"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="DescrizioneCausale">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<complexType name="CODICI_VLAN">
		<sequence>
			<element minOccurs="1" name="ID_RISORSA">
				<simpleType>
					<restriction base="string">
						<maxLength value="50"/>
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" name="CVLAN_ID" type="int"/>
		</sequence>
	</complexType>
	<element name="operationRequest">
		<complexType>
			<sequence>
				<element name="in" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="operationResponse">
		<complexType>
			<sequence>
				<element name="out" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="SoapFault">
		<complexType>
			<sequence>
				<element name="CodiceErrore" type="string" minOccurs="0"/>
				<element name="MessaggioErrore" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="Risorsa">
		<complexType>
			<sequence>
				<element name="Id_Risorsa" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
		<element name="NowCheckRaccoltaVLAN_Response_Sub">
		<complexType>
			<sequence>
				<element maxOccurs="1" name="Transaction_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="Response_date" type="dateTime"/>
				<element minOccurs="0" name="ID_RISORSA">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="CVLAN_ID" type="int"/>
				<element minOccurs="0" name="ID_Risorsa_Staging" type="string"/>
				<element maxOccurs="1" name="Esito">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="CodiceCausale">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="00"/>
							<enumeration value="01"/>
							<enumeration value="02"/>
							<enumeration value="99"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="DescrizioneCausale">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>
