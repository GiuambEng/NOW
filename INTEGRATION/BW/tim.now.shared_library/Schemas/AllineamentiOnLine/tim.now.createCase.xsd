	<xs:complexType name="input_type">
		<xs:sequence>
			<xs:element name="caseModelVersion" type="xs:string"/>
			<xs:element name="caseType" type="xs:string"/>
			<xs:element name="Asset" type="tns1:Asset" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="output_type">
		<xs:sequence>
			<xs:element name="Esito" type="xs:string"/>
			<xs:element name="DescEsito" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="Input" type="input_type"/>
	<xs:element name="Output" type="output_type"/>
</xs:schema>
