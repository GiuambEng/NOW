<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="www.tim.now.crmws.alignment.ogg.cretecase" xmlns="www.tim.now.crmws.alignment.ogg.cretecase" xmlns:tns1="http://NOW.it.telecomitalia.it/casedata" elementFormDefault="qualified" attributeFormDefault="unqualified">
