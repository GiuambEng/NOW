<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns:tns="www.tim.now.check.allineamentoconsistenze.querystring.main.ogg" 
targetNamespace="www.tim.now.check.allineamentoconsistenze.querystring.main.ogg" 
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
	<xs:element name="queryStringAPI">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="queryAPI" type="xs:string" minOccurs="1"/>
				<xs:element name="NamedParameterAssigned" minOccurs="0" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="name" type="xs:string" minOccurs="1"/>
							<xs:element name="value" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="QueryAsset">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Record" minOccurs="0" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="BDS_ID" type="xs:integer" minOccurs="0"/>
							<xs:element name="Created" type="xs:string" minOccurs="0"/>
							<xs:element name="Stato" type="xs:string" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="AccumulateBDS_ID">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="BDS_ID" type="xs:integer" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>