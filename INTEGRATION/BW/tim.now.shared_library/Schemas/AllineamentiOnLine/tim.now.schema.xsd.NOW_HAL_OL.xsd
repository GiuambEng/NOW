<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_HAL_OL/" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/NOW_HAL_OL/">

    <element name="NOW_HAL_OL">
    	<complexType>
    		<sequence>
    			<element ref="tns:NOW_HAL_OL_Request"/>
    			<element ref="tns:NOW_HAL_OL_Response"/>
    			<element name="Fault" type="string"/>
    		</sequence>
    	</complexType>
    </element>

    <simpleType name="String4">
    	<restriction base="string">
    		<maxLength value="4"/>
    	</restriction>
    </simpleType>

    <simpleType name="String15">
    	<restriction base="string">
    		<maxLength value="20"/>
    	</restriction>
    </simpleType>

    <simpleType name="String2">
    	<restriction base="string"/>
    </simpleType>

    <simpleType name="String30">
    	<restriction base="string">
    		<maxLength value="30"/>
    	</restriction>
    </simpleType>

    <simpleType name="String50">
    	<restriction base="string">
    		<maxLength value="50"/>
    	</restriction>
    </simpleType>
    <element name="NOW_HAL_OL_Request">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="Distretto" type="tns:String4">
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="ID_RISORSA" type="tns:String15">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="NOW_HAL_OL_Response">
    	<complexType>
    		<sequence>
    			<element name="Esito">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="1" name="Esito">
    							<simpleType>
    								<restriction base="tns:String2">
    									<enumeration value="OK"/>
    									<enumeration value="KO"/>
    									<maxLength value="2"/>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="Codice_Errore">
    							<simpleType>
    								<restriction base="tns:String4">
    									<enumeration value="1"/>
    									<enumeration value="2"/>
    									<enumeration value="3"/>
    									<enumeration value="4"/>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="TIMESTAMP" type="tns:String30">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element maxOccurs="unbounded" minOccurs="0" name="Asset">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="Linea_Riferimento" type="tns:String50">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="Numerazione_Fittizia" type="tns:String30">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="STATO_ASSET" type="tns:String30">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="TIPO_SERVIZIO">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="1"/>
    									<enumeration value="F"/>
    									<enumeration value="D"/>
    								</restriction>
    							</simpleType>
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="OL">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="LIneaRiferimento" type="tns:String50">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="Distretto" type="tns:String4">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="Numero_Ordine" type="tns:String30">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="Stato_Ordine" type="tns:String30">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Fault_NowHalOl">
     <complexType>
      <sequence>
       <element maxOccurs="1" minOccurs="0" name="Codice_errore" type="string"/>
       <element maxOccurs="1" minOccurs="0" name="Messaggio_errore" type="string"/>
      </sequence>
     </complexType>
  </element>

</schema>
