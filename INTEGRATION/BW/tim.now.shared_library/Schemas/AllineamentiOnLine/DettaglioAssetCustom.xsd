<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="www.tim.now.dettaglio.asset.customizzato" targetNamespace="www.tim.now.dettaglio.asset.customizzato" 
elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="DettaglioAsset_Customizzato">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="LavorazioneDettaglio">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="Update"/>
							<xs:enumeration value="NoUpdate"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="IDAsset" type="xs:integer"/>
				<xs:element name="IDDettaglioAssetParent" type="xs:int" minOccurs="0"/>
				<xs:element name="IDDettaglioAssetRoot" type="xs:int" minOccurs="0"/>
				<xs:element name="IntegrationID" type="xs:string"/>
				<xs:element name="created" type="xs:dateTime"/>
				<xs:element name="lastUpdate" type="xs:dateTime" minOccurs="0"/>
				<xs:element name="operatore" type="xs:string"/>
				<xs:element name="IDRisorsa" type="xs:string"/>
				<xs:element name="nomeComponente" type="xs:string"/>
				<xs:element name="attributidettaglioasset" minOccurs="0" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="IDAsset" type="xs:integer"/>
							<xs:element name="created" type="xs:dateTime"/>
							<xs:element name="lastUpdate" type="xs:dateTime" minOccurs="0"/>
							<xs:element name="operatore" type="xs:string"/>
							<xs:element name="nomeAttributo" type="xs:string"/>
							<xs:element name="valoreAttributo" type="xs:string"/>
							<xs:element name="tipologiaDato" type="xs:string"/>
							<xs:element name="IDDettaglioAsset" type="xs:int"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="IDRisorsaNOW" type="xs:string"/>
				<xs:element name="IDDettaglioAsset" type="xs:int"/>
				<xs:element name="statoDettaglioAsset" type="xs:string"/>
				<xs:element name="progressivo" type="xs:int"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
