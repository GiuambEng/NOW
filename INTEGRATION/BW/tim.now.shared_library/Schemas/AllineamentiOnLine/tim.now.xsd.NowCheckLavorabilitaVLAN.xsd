<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/tim.now.xsd.NowCheckLAvorabilitaVLAN" elementFormDefault="qualified" targetNamespace="http://www.example.org/tim.now.xsd.NowCheckLAvorabilitaVLAN">

	<element name="NowCheckLAvorabilitaVLAN_Request">
		<complexType>
			<sequence>
				<element maxOccurs="1" name="Transaction_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="Transaction_Date" type="dateTime"/>
				<element maxOccurs="1" name="ID_RISORSA">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="TIPO_VLAN">
					<simpleType>
						<restriction base="string">
							<maxLength value="10"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>		
	<element name="NowCheckLAvorabilitaVLAN_Response">
		<complexType>
			<sequence>
				<element maxOccurs="1" name="Transaction_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="Response_date" type="dateTime"/>
				<element maxOccurs="1" name="Esito">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="CodiceCausale">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="00"/>
							<enumeration value="01"/>
							<enumeration value="02"/>
							<enumeration value="99"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="DescrizioneCausale">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
		</element>	
			<element name="SoapFault">
		<complexType>
			<sequence>
				<element name="CodiceErrore" type="string" minOccurs="0"/>
				<element name="MessaggioErrore" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	
</schema>
