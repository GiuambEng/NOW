<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xs:schema xmlns="www.tim.now.dinamicprocess.allineamentoOggAsset" xmlns:tns1="http://NOW.it.telecomitalia.it/casedata" xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="www.tim.now.dinamicprocess.allineamentoOggAsset">
<xs:import namespace="http://NOW.it.telecomitalia.it/casedata" schemaLocation="../BOMCaseData/Casedata.xsd"/>
	<xs:element name="Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="IdOfferta" type="xs:int"
					minOccurs="0" />
				<xs:element name="NomeOffertaEsterna" type="xs:string"
					minOccurs="0" />
				<xs:element name="transactionId_CessatoVariato"
					type="xs:string" minOccurs="0" />
				<xs:element name="Created_CessatoVariato"
					type="xs:string" minOccurs="0" />
				<xs:element name="NomeProcesso" type="xs:string" />
				<xs:element name="CheckEsistenza">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="TRUE" />
							<xs:enumeration value="FALSE" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="CaseReference" type="xs:string" />
				<xs:element name="Clob_CRMWS" type="xs:string" />
				<xs:element name="Asset_Now" type="tns1:Asset"
					minOccurs="0" />
				<xs:element name="CaseType" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
				<xs:element name="CaseModelVersion" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="output">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="FlagCorrelazione" minOccurs="1">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="Y"/>
							<xs:enumeration value="N"/>
							<xs:enumeration value="KO"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="IdContrattoNOW" type="xs:string" minOccurs="0"/>
				<xs:element name="DN" type="xs:string" minOccurs="0"/>
				<xs:element name="IdAssetNow" type="xs:string" minOccurs="0"/>
				<xs:element name="OGG_Request">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Stato" type="xs:string" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="OGG_Response">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ReturnCode" type="xs:string"/>
							<xs:element name="Stato" type="xs:string" minOccurs="0"/>
							<xs:element name="DescrErrore" type="xs:string" minOccurs="0"/>
							<xs:element name="Message" type="xs:string" minOccurs="0"/>
							<xs:element name="ERROR_LOG" type="xs:string" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
		<xs:element name="transcodifica">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ProcessName" type="xs:string" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="checkAttivazione">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="IDContrattoCRMWS" type="xs:string"
					minOccurs="0" />
				<xs:element name="IdUllco" type="xs:string"
					minOccurs="0" />
				<xs:element name="IdSluco" type="xs:string"
					minOccurs="0" />
				<xs:element name="CodiceOLO" type="xs:string"
					minOccurs="0" />
				<xs:element name="Transaction_ID" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
		<xs:element name="checkAsset">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Esito" type="xs:string" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="checkCessazione_Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="IDAssetCRMWS" type="xs:string" minOccurs="0"/>
				<xs:element name="transactionId_CessatoVariato" type="xs:string" minOccurs="0"/>
				<xs:element name="Created_CessatoVariato" type="xs:string" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="checkCessazione_Output">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Stato" type="xs:string" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
		<xs:element name="findContrattoOfferta_Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="IDAssetCRMWS" type="xs:string"
					minOccurs="0" />
				<xs:element name="codServizio" type="xs:string"
					minOccurs="0" />
				<xs:element name="Transaction_id" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="findContrattoOfferta_Output">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ID_CONTRATTO" type="xs:string" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
		<xs:element name="Input_InsertUpdateOGG">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="OGG_Request">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Stato" type="xs:string" minOccurs="0"/>
							<xs:element name="TransactionID" type="xs:string" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="OGG_Response">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="COD_SRVZ" type="xs:string" minOccurs="0"/>
							<xs:element name="CODFC_OLO_AGCOM" type="xs:string" minOccurs="0"/>
							<xs:element name="CREATED" type="xs:string" minOccurs="0"/>
							<xs:element name="DESC_ERRORE" type="xs:string" minOccurs="0"/>
							<xs:element name="ROW_ID" type="xs:string" minOccurs="0"/>
							<xs:element name="ID_RISORSA" type="xs:string" minOccurs="0"/>
							<xs:element name="MESSAGGIO_KO" type="xs:string" minOccurs="0"/>
							<xs:element name="ERROR_LOG" type="xs:string" minOccurs="0"/>
						    <xs:element name="RETURN_CODE" type="xs:string" minOccurs="0"/>
							<xs:element name="STATO" type="xs:string" minOccurs="0"/>
							<xs:element name="TRANSACTION_ID" type="xs:string" minOccurs="0"/>
							<xs:element name="TRANSACTION_ID_PARENT" type="xs:string" minOccurs="0"/>
							<xs:element name="TRANSACTION_ID_ROOT" type="xs:string" minOccurs="0"/>
							<xs:element name="CREATED_BY" type="xs:string" minOccurs="0"/>
							<xs:element name="LAST_UPD" type="xs:string" minOccurs="0"/>
							<xs:element name="LAST_UPD_BY" type="xs:string" minOccurs="0"/>
							<xs:element name="MODIFICATION_NUM" type="xs:string" minOccurs="0"/>
							<xs:element name="CONFLICT_ID" type="xs:string" minOccurs="0"/>
							<xs:element name="DB_LAST_UPD" type="xs:string" minOccurs="0"/>
							<xs:element name="DB_LAST_UPD_SRC" type="xs:string" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Output_InsertUpdateOGG">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Esito" type="xs:string" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
