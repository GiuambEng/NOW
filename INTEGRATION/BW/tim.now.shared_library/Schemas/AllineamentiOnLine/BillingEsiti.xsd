<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns:tns="http://www.openaccess.it/wholesale/manager/billingEsiti/" 
targetNamespace="http://www.openaccess.it/wholesale/manager/billingEsiti/" 
elementFormDefault="unqualified" 
attributeFormDefault="unqualified">
	<xs:element name="ESITI">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="tns:TESTATA"/>
				<xs:element ref="tns:NOTIFICA"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="TESTATA">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="IDORDCRMWS" type="xs:string"/>
					<xs:attribute name="DATADRO" type="xs:string"/>
					<xs:attribute name="DATAMSG" type="xs:string"/>
					<xs:attribute name="DATADES" type="xs:string"/>
					<xs:attribute name="CODICEORDINEISP" type="xs:string"/>
					<xs:attribute name="CODICEPROGETTO" type="xs:string"/>
					<xs:attribute name="IDTRANSAZIONE" type="xs:string"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="NOTIFICA">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="CODESCARTO" type="xs:string"/>
					<xs:attribute name="CODEDETTSCARTO" type="xs:string"/>
					<xs:attribute name="TAGINERRORE" type="xs:string"/>
					<xs:attribute name="NOMEATTRIBINERRORE" type="xs:string"/>
					<xs:attribute name="IDRISORSA" type="xs:string"/>
					<xs:attribute name="OLELABOK" type="xs:string"/>
					<xs:attribute name="CATEGORIA">
						<xs:simpleType>
							<xs:restriction base="xs:string">
								<xs:enumeration value="XDSL"/>
								<xs:enumeration value="REGO"/>
								<xs:enumeration value="CONT"/>
								<xs:enumeration value="GEST"/>
								<xs:enumeration value="PREV"/>
								<xs:enumeration value="CLUS"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="body">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="tns:ESITI"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RESPONSE">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="tns:EsitoNotifica"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="EsitoNotifica">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="EsitoLavorazione">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="OK"/>
							<xs:enumeration value="KO"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="FAULT">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ErrorCode" type="xs:string"/>
				<xs:element name="MSGErrore" type="xs:string"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
