<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/VerificaLavorabilita_ID_RISORSA/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/VerificaLavorabilita_ID_RISORSA/">

    <element name="NOW_CheckLavorabilita_Idrisorsa_Input">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="Transaction_id" type="string"/>
    			<element maxOccurs="1" minOccurs="1" name="Transaction_date" type="dateTime"/>
    			<element maxOccurs="1" minOccurs="1" name="CODICE_OLO">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="CODICE_OLO_CRMWS">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="ID_RISORSA">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="ID_UNIVOCO_NOW" type="integer"/>
    			<element maxOccurs="1" minOccurs="1" name="SERVIZIO">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"/>
    						<enumeration value="SLU Linea Non Attiva"/>
    						<enumeration value="ULL Linea Non Attiva"/>
    						<enumeration value="ULL Dati Linea Non Attiva">
    						</enumeration>
    						<enumeration value="TWS Bitstream ATM Asimmetrico Flat">
    						</enumeration>
    						<enumeration value="TWS Bitstream ATM Asimmetrico HL">
    						</enumeration>
    						<enumeration value="TWS Bitstream ATM Asimmetrico Lite">
    						</enumeration>
    						<enumeration value="TWS Bitstream GBE Asimmetrico Flat">
    						</enumeration>
    						<enumeration value="TWS EasyIP BasePlus Flat">
    						</enumeration>
    						<enumeration value="TWS EasyIP BasePlus Lite">
    						</enumeration>
    						<enumeration value="TWS EasyIP SpecialProfile Flat">
    						</enumeration>
    						<enumeration value="TWS EasyIP SpecialProfile Lite">
    						</enumeration>
    						<enumeration value="Bitstream NGA - FTTCab">
    						</enumeration>
    						<enumeration value="Bitstream NGA - FTTH"/>
    						<enumeration value="VULA - FTTCab"/>
    						<enumeration value="VULA - FTTH"/>
    						<enumeration value="Numerazione Portata"/>
    						<enumeration value="VULL"/>
    						<enumeration value="WLR Linea Attiva"/>
    						<enumeration value="WLR Linea Non Attiva"/>
    						<enumeration value="SHA con Manodopera"/>
    						<enumeration value="SHA senza Manodopera"/>
    						<enumeration value="ULL Linea Attiva"/>
    						<enumeration value="SLU Linea Attiva"/>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="NOW_CheckLavorabilita_Idrisorsa_Root">
    	<complexType>
    		<sequence>
    			<element name="Root">
    				<complexType>
    					<sequence>
    						<element ref="tns:NOW_CheckLavorabilita_Idrisorsa_Input">
    						</element>
    						<element ref="tns:NOW_CheckLavorabilita_Idrisorsa_Out">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="NOW_CheckLavorabilita_Idrisorsa_Out">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="Transaction_ID">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="Response_date" type="dateTime">

    			</element>
    			<element maxOccurs="1" minOccurs="1" name="Return_Code">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="2"/>
    						<enumeration value="00"/>
    						<enumeration value="01"/>
    						<enumeration value="02"/>
    						<enumeration value="03"/>
    						<enumeration value="04"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="Descrizione_errore">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="150"/>
    						<enumeration value="ORDINE IN CORSO"/>
    						<enumeration value="RISORSA CESSATA"/>
    						<enumeration value="RISORSA NON PRESENTE"/>
    						<enumeration value="ERRORE GENERICO"/>
    						<enumeration value="RISORSA LAVORABILE"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="ID_ORDINE">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"/>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
     <element name="NOW_CheckLavorabilita_Idrisorsa_Fault">
     <complexType>
      <sequence>
       <element maxOccurs="1" minOccurs="0" name="Codice_errore" type="string"/>
       <element maxOccurs="1" minOccurs="0" name="Messaggio_errore" type="string"/>
      </sequence>
     </complexType>
  </element>
  <element name="NOWCheckLavorabilitaIDRISORSAFault">
     <complexType>
      <sequence>
       <element maxOccurs="1" minOccurs="0" name="Codice_errore" type="string"/>
       <element maxOccurs="1" minOccurs="0" name="Messaggio_errore" type="string"/>
      </sequence>
     </complexType>
  </element>


<element name="Now_CheckLavorabilitaNumero_Input">
		<complexType>
			<sequence>
				<element maxOccurs="1" name="Transaction_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="Transaction_Date" type="dateTime"/>
				<element maxOccurs="unbounded" minOccurs="1" name="LINEE">
					<complexType>
						<sequence>
							<element maxOccurs="1" name="DN">
								<simpleType>
									<restriction base="string">
									<maxLength value="15"/>
									</restriction>
							</simpleType>
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>		
	<element name="Now_CheckLavorabilitaNumero_Out">
		<complexType>
			<sequence>
			<element maxOccurs="1" name="Transaction_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="Response_date" type="dateTime"/>
				<element maxOccurs="1" name="Return_Code">
					<simpleType>
						<restriction base="string">
							<maxLength value="2" />
							<enumeration value="00" />
							<enumeration value="01" />
							<enumeration value="02" />
							<enumeration value="03" />


							<enumeration value="99" />
							<enumeration value="05"></enumeration>
							<enumeration value="06"></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Descrizione_errore">
					<simpleType>
						<restriction base="string">
							<maxLength value="150" />
							<enumeration value="OK" />
							<enumeration value="NP in corso" />


							<enumeration value="Migrazione in corso"></enumeration>
							<enumeration value="Cessazione in corso"></enumeration>
							<enumeration value="Attivazione in corso"></enumeration>
							<enumeration value="Variazione in corso"></enumeration>
							<enumeration value="Errore generico"></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="DN">
					<simpleType>
						<restriction base="string">
							<maxLength value="15"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="ID_ORDINE">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
		</element>	

 <element name="NOW_CheckLavorabilitaNumero_Fault">
     <complexType>
      <sequence>
       <element maxOccurs="1" minOccurs="0" name="Codice_errore" type="string"/>
       <element maxOccurs="1" minOccurs="0" name="Messaggio_errore" type="string"/>
      </sequence>
     </complexType>
  </element>
  
<element name="NOWCheckLavorabilitaNumeroFault">
     <complexType>
      <sequence>
       <element maxOccurs="1" minOccurs="0" name="Codice_errore" type="string"/>
       <element maxOccurs="1" minOccurs="0" name="Messaggio_errore" type="string"/>
      </sequence>
     </complexType>
  </element>
</schema>
