<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- Tracciato Check TTM Down Service versione 1.0 24-08-2018 --><xs:schema xmlns="http://www.openaccess.it/wholesale/manager/" xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="unqualified" targetNamespace="http://www.tim.com/TTM/xsd/CHECK_TTM_DOWNSERVICE/">
	<xs:element name="CheckTtDownResponse">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Esito">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="2"/>
							<xs:enumeration value="OK"/>
							<xs:enumeration value="KO"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="DescrizioneErrore">
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="flagCheckTtDown">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="2"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="CheckTtDownRequest">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="IdentificativoTT">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="10" />
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="idRisorsa" minOccurs="0"
							maxOccurs="1">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="16"></xs:maxLength>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
</xs:schema>
