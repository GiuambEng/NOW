<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="www.tim.now.dinamicSubProcess.FileScarto" xmlns="www.tim.now.dinamicSubProcess.FileScarto" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:complexType name="Input_type">
		<xs:sequence>
		<xs:element name="Tipologia_Processo" minOccurs="0"
			maxOccurs="1">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="ALLINEAMENTO"></xs:enumeration>
					<xs:enumeration value="MIGRAZIONE"></xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
		</xs:element>
		<xs:element name="row" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="column" minOccurs="0" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="name" type="xs:string" minOccurs="1"/>
									<xs:element name="value" type="xs:string" minOccurs="1"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Output_type">
		<xs:sequence>
			<xs:element name="Esito" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="Input" type="Input_type"/>
	<xs:element name="Output" type="Output_type"/>
</xs:schema>
