<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/InvioEsiti/" targetNamespace="http://www.tim.com/NOW/xsd/InvioEsiti/" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="Request">
		<complexType>
			<sequence>
				<element name="TESTATA" type="tns:TESTATA"/>
				<element name="NOTIFICA" type="tns:NOTIFICA"/>
			</sequence>
		</complexType>
	</element>
	<simpleType name="String20">
		<restriction base="string">
			<maxLength value="20"/>
		</restriction>
	</simpleType>
	<complexType name="TESTATA">
		<sequence>
			<element name="ID_ORD_CRMWS">
				<simpleType>
					<restriction base="tns:String20"/>
				</simpleType>
			</element>
			<element name="DATA_DRO" type="date"/>
			<element name="DATA_MSG" type="date"/>
			<element name="DATA_DES" type="date"/>
			<element name="CODICE_ORDINE_ISP">
				<simpleType>
					<restriction base="string">
						<maxLength value="30"/>
					</restriction>
				</simpleType>
			</element>
			<element name="CODICE_PROGETTO" minOccurs="0">
				<simpleType>
					<restriction base="string">
						<maxLength value="10"/>
					</restriction>
				</simpleType>
			</element>
		</sequence>
	</complexType>
	<complexType name="NOTIFICA">
		<sequence>
			<element name="CODE_SCARTO">
				<simpleType>
					<restriction base="string">
						<maxLength value="2"/>
					</restriction>
				</simpleType>
			</element>
			<element name="CODE_DETT_SCARTO" minOccurs="0">
				<simpleType>
					<restriction base="string">
						<maxLength value="3"/>
					</restriction>
				</simpleType>
			</element>
			<element name="TAG_IN_ERRORE" type="tns:String20" minOccurs="0"/>
			<element name="NOME_ATTRIB_IN_ERRORE" type="tns:String20" minOccurs="0"/>
			<element name="ID_RISORSA" type="tns:String20" minOccurs="0"/>
			<element name="OL_ELAB_OK" type="tns:String20" minOccurs="0"/>
		</sequence>
	</complexType>
</schema>
