<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/StagingDIN" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:Q1="http://www.example.com/namespaces/tns/1464255115306" xmlns:Q2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns="http://www.tim.com/NOW/xsd/StagingDIN">

	<element name="StagingDIN" type="tns:StagingDINType"/>

	<complexType name="StagingDINType">
		<sequence>
			<element name="target">
				<simpleType>
					<restriction base="string">
						<enumeration value="ERR"/>
						<enumeration value="REQ"/>
						<enumeration value="RES"/>
					</restriction>
				</simpleType>
			</element>
			<element name="processNoFileID" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="description" type="string">
			</element>




			<element maxOccurs="1" minOccurs="0" name="executionStatus" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="exitCode" type="string">
			</element>


			<element ref="tns:StagDIN"/>
			<element name="IdEsecProcsoNoFile" type="int"/>
		</sequence>
	</complexType>






	<element name="StagDIN" type="tns:StagDINType">
	</element>

	<complexType name="StagDINType">
		<sequence>
			<element name="idRichiesta">
				<simpleType>
					<restriction base="string">
						<maxLength value="50" />
					</restriction>
				</simpleType>
			</element>
			<element name="timestampRichiesta" type="dateTime" />
			<element maxOccurs="1" minOccurs="0"
				name="timestampRisposta" type="dateTime" />
			<element name="contenutoRequest" type="string" />
			<element maxOccurs="1" minOccurs="0"
				name="contenutoResponse" type="string" />

			<element name="Operatore" type="string" minOccurs="0"></element>
			<element maxOccurs="1" minOccurs="1" name="DN">
				<simpleType>
					<restriction base="string">
						<maxLength value="50" />
					</restriction>
				</simpleType>
			</element>
			<element name="DISTR" type="string" minOccurs="0"></element>
			<element name="Esito" type="string" minOccurs="0"></element>
			<element name="HttpResponse" type="string" minOccurs="0"></element>
			<element name="IdRisorsaDN" type="string" minOccurs="0"></element>

			<element maxOccurs="1" minOccurs="0"
				name="descrizioneErrore" type="string">
			</element>
		</sequence>
	</complexType>

	<complexType name="FlowInfoType">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="processInfoID" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="processCode" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="transactionID" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="transactionDate" type="dateTime">
			</element>
			<element maxOccurs="1" minOccurs="0" name="sourceSystem" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="idProcessInstance" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="requestID" type="long"/>
		</sequence>
	</complexType>

	<element name="FlowInfo" type="tns:FlowInfoType">
	</element>


</schema>
