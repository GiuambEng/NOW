<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/ReadCaseRequest" xmlns:tns="http://www.example.org/ReadCaseRequest" elementFormDefault="qualified">

<element name="ReadCaseRequest">
                <annotation>
                    <documentation>Request Element for readCase Operation</documentation>
                </annotation>
                <complexType>
                    <sequence>
                        <element name="caseReference" type="string" maxOccurs="unbounded"/>
                    </sequence>
                    <attribute name="includeCaseMetaData" type="boolean">
                        <annotation>
                            <documentation>If the case meta data (including the name of the attribute containing the state) should be included in the response (Default = false)</documentation>
                        </annotation>
                    </attribute>
                </complexType>
            </element>
            <element name="UpdateCaseRequest">
            	<annotation>
            		<documentation>
            			Request Element for updateCase Operation
            		</documentation>
            	</annotation>
            	<complexType>
            		<sequence>
            			<element name="caseData">
            				<complexType>
            					<sequence>
            						<element name="caseReference"
            							type="string">
            						</element>
            						<element name="casePayload"
            							type="string">
            						</element>
            					</sequence>
            				</complexType>
            			</element>
            			<element name="caseMetaData" maxOccurs="1" minOccurs="0">
            				<complexType>
            					<sequence>
            						<element name="stateName"
            							type="string" maxOccurs="1" minOccurs="0">
            						</element>
            					</sequence>
            				</complexType>
            			</element>
            		</sequence>
            	</complexType>
            </element>
<element name="CreateCaseRequest">
                <annotation>
                    <documentation>Request Element for createCase Operation</documentation>
                </annotation>
                <complexType>
                    <sequence>
                        <element name="caseType" type="string"/>
                        <element name="caseModelVersion" type="string"/>
                        <element name="casePayload" type="string" maxOccurs="unbounded"/>
                    </sequence>
                </complexType>
            </element>


</schema>