<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/StagingFindUpdateCase" xmlns:tns="http://www.example.org/StagingFindUpdateCase" elementFormDefault="qualified">

    <element name="INPUT">
    	<complexType>
    	<choice>
				<element name="Insert">
					<complexType>
						<sequence>
							<element name="TIMESTAMP_INSERIMENTO" type="string"/>
							<element name="CONTENUTO_REQUEST" type="string"/>
							<element name="ID_RISORSA" type="string" maxOccurs="1" minOccurs="0"/>
                            <element name="ID_ASSET_CRMWS" type="string" maxOccurs="1" minOccurs="0"/>
                            <element name="ID_ASSET_NOW" type="string" maxOccurs="1" minOccurs="0"/>
                             <element name="ID_ESEC_PROCSO_NOFILE" type="integer" maxOccurs="1" minOccurs="0"/>
                        
						</sequence>
					</complexType>
				</element>
				<element name="Update">
					<complexType>
						<sequence>
							<element name="CONTENUTO_RESPONSE" type="string"/>
							<element name="TIMESTAMP_AGGIORNAMENTO" type="string"/>
							<element name="ID_ESEC_PROCSO_NO_FILE" type="integer"/>
							<element name="ID_ASSET_CRMWS" type="string" maxOccurs="1" minOccurs="0"/>
                            <element name="ID_ASSET_NOW" type="string" maxOccurs="1" minOccurs="0"/>
						</sequence>
					</complexType>
				</element>
				<element name="UpdateOnError">
					<complexType>
						<sequence>
							<element name="DESCR_ERRORE" type="string"/>
							<element name="TIMSTP_RISPOSTA" type="string"/>
							<element name="ID_ESEC_PROCSO_NO_FILE" type="integer" maxOccurs="1" minOccurs="0"/>
						</sequence>
					</complexType>
				</element>
			</choice>
    	</complexType>
    </element>
</schema>