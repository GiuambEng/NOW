<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/FindUpdateCase/"
	xmlns:tns1="http://NOW.it.telecomitalia.it/casedata"
	targetNamespace="http://www.tim.com/NOW/xsd/FindUpdateCase/"
	elementFormDefault="qualified" attributeFormDefault="unqualified">

	<xsd:import schemaLocation="../BOMCaseData/Casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata"></xsd:import>
	<xsd:complexType name="output_type">
		<xsd:sequence>
			<xsd:element name="Esito" type="xsd:string" />
			<xsd:element name="DescrizioneEsito" type="xsd:string"
				minOccurs="0" />
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="fault_type">
		<xsd:sequence>
			<xsd:element name="Code" type="xsd:string" />
			<xsd:element name="ErrorCode" type="xsd:string"
				minOccurs="0" />
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="FindRisorsaRequest_type">
		<xsd:sequence>
			<xsd:element name="caseModelVersion" type="xsd:string" />
			<xsd:element name="caseType" type="xsd:string" />
			<xsd:element name="Criteria">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="queryString"
							type="xsd:string" />
						<xsd:element name="NamedParameterAssigned"
							minOccurs="0" maxOccurs="unbounded">
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="name"
										type="xsd:string" />
									<xsd:element name="value"
										type="xsd:string" minOccurs="0" maxOccurs="unbounded" />
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="PaginationOption"
							minOccurs="0">
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="startPosition"
										type="xsd:integer" minOccurs="0" />
									<xsd:element name="maxResult"
										type="xsd:integer" minOccurs="0" />
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="Output">
		<xsd:complexType>
			<xsd:choice>
				<xsd:element name="Find" minOccurs="0"
					maxOccurs="unbounded">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="CaseReference"
								type="xsd:string" minOccurs="0" />
							<xsd:element name="Asset" type="tns1:Asset"
								minOccurs="0" />
							<xsd:element name="Response"
								type="tns:output_type" />
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Update">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="Response"
								type="tns:output_type" />
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Create">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="CaseReference"
								type="xsd:string" minOccurs="0" />
							<xsd:element name="AssetNow"
								type="xsd:string" minOccurs="0" />
							<xsd:element name="Response"
								type="tns:output_type" />
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:choice>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Input">
		<xsd:complexType>
			<xsd:choice>
				<xsd:element name="Find">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="Input"
								type="tns:FindRisorsaRequest_type" />
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Update">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="Input">
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element
											name="CaseReference" type="xsd:string" />
										<xsd:element name="Asset"
											type="tns1:Asset" />
									</xsd:sequence>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Create">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="Input">
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="caseType"
											type="xsd:string" />
										<xsd:element
											name="caseModelVersion" type="xsd:string" />
										<xsd:element name="Asset"
											type="tns1:Asset" />
									</xsd:sequence>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:choice>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Fault">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Error" type="tns:fault_type" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="FindCaseJMS_Align">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="IdFile" type="xsd:string" />
				<xsd:element name="TotaliRecord" type="xsd:integer" />
				<xsd:element name="FindCaseJMS_Align_Input"
					type="tns:FindRisorsaRequest_type" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
