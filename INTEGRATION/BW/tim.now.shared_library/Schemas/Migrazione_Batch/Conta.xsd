<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns="http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/" 
targetNamespace="http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/" 
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
	<xs:complexType name="contaRecordInput_type">
		<xs:sequence>
			<xs:element name="in" type="xs:string" />
			<xs:element name="TipoSeparatore">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="ContaRecord_DoppioPipe" />
						<xs:enumeration
							value="ContaRecord_PipeCancelletto" />
						<xs:enumeration value="POSIZIONALE" />
						<xs:enumeration value="ContaRecord_Virgola" />
						<xs:enumeration value="ContaRecord_PuntoVirgola" />
						<xs:enumeration
							value="ContaRecord_PipeCancelletto_Retail">
						</xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Flusso" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
			<xs:element name="ID_FILE" type="xs:integer" minOccurs="0"/>
			<xs:element name="FULLNAME" type="xs:string" minOccurs="0"/>
			<xs:element name="FILENAME" type="xs:string" minOccurs="0"/>
			<xs:element name="ID_ESEC_PROCSO_FILE" type="xs:integer"  minOccurs="0"/>
			<xs:element name="COD_PROCSO_FILE" type="xs:string" minOccurs="0"/>
			<xs:element name="ID_TRACK" type="xs:string" minOccurs="0"/>
			<xs:element name="NomeProcesso" type="xs:string" minOccurs="0"/>
			<xs:element name="IdAnagBonificaCluster" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="contaRecordOutput_type">
		<xs:sequence>
			<xs:element name="out" type="xs:string" minOccurs="0"/>
			<xs:element name="NumeroRecord" type="xs:integer" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="contaRecord_Input" type="contaRecordInput_type"/>
	<xs:element name="contaRecord_Output" type="contaRecordOutput_type"/>
</xs:schema>