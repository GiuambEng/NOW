<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://www.tim.com/NOW/restSubprocesses/xmlToExcel"
	xmlns:tns="http://www.tim.com/NOW/restSubprocesses/xmlToExcel"
	elementFormDefault="qualified">



	<element name="Input_XmlToExcel" type="tns:Input_XmlToExcel"></element>

	<complexType name="Input_XmlToExcel">
		<sequence>
			<element name="xmlParameter" type="string"></element>

			<element name="listOfElements" type="string"></element>

			<element name="rootElementParameter" type="string"></element>
			<element name="NameOfFile" type="string"></element>
			<element name="childrootElement" type="string"></element>
			<element name="PathOfProperties" type="string"></element>
		</sequence>
	</complexType>

    <element name="Output_ExcelResult" type="hexBinary"></element>
</schema>