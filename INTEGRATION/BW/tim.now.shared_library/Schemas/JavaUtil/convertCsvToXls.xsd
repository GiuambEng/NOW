<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://www.example.org/convertCsvToXls"
	xmlns:tns="http://www.example.org/convertCsvToXls"
	elementFormDefault="qualified">



	<element name="Input_convertCsvToXls" type="tns:Input_convertCsvToXls"></element>

	<complexType name="Input_convertCsvToXls">
		<sequence>
			<element name="fileInput" type="string"></element>
		</sequence>
	</complexType>

<element name="Output_convertCsvToXls" type="tns:Output_convertCsvToXls"></element>

	<complexType name="Output_convertCsvToXls">
		<sequence>
			<element name="convertedFile" type="string"></element>
		</sequence>
	</complexType>
    
</schema>