<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema xmlns:tibex="http://www.tibco.com/bpel/2007/extensions" xmlns:tns="http://www.example.com/namespaces/tns/1466508362966" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://www.example.com/namespaces/tns/1466508362966">
  <xsd:element name="ZipFileInput">
    <xsd:complexType>
      <xsd:sequence>
      	<xsd:element maxOccurs="1" minOccurs="1"
      		name="ToBeZippedFilePathAndName" type="xsd:string" >
      		<xsd:annotation>
      			<xsd:documentation>The file name and path must be described as for example :  C:\\Folder Name(s)\\FileName.(txt)</xsd:documentation>
      		</xsd:annotation></xsd:element>
      	<xsd:element name="ZippedFilePath" type="xsd:string" minOccurs="0" maxOccurs="1">
      		<xsd:annotation>
      			<xsd:documentation>The destination folder must be described as for example :  C:\\Folder Name(s)\\ </xsd:documentation>
      		</xsd:annotation></xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

    <xsd:element name="ZipFileOutput">
    	<xsd:complexType>
    		<xsd:sequence>
    			<xsd:element name="ZipFileResult" type="xsd:string" minOccurs="1" maxOccurs="1"></xsd:element>
    		</xsd:sequence>
    	</xsd:complexType></xsd:element>
</xsd:schema>
