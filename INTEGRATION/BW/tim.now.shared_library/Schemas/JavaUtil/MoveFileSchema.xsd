<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/MoveFileSchema" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/MoveFileSchema">

    <element name="INPUT">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="fileToBeMovedWithPath" type="string"/>
    			<element maxOccurs="1" minOccurs="1" name="destinationPathWithFileName" type="string"/>
    		</sequence>
    	</complexType>
  </element>

    <element name="OUTPUT">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="Status" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="Message" type="string"/>
    		</sequence>
    	</complexType>
  </element>
</schema>
