<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ReplaceAllString/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ReplaceAllString/">
    <element name="InputString">
    	<complexType>
    		<sequence>
    			<element name="OldString" type="string"></element>
    			<element name="OldChar" type="string" maxOccurs="unbounded"/>
    			<element name="NewChar" type="string" maxOccurs="unbounded"/>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="ErrorString">
    	<complexType>
    		<sequence>
    			<element name="Msg" type="string"></element>
    			<element name="Code" type="string"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="OutputString">
    	<complexType>
    		<sequence>
    			<element name="NewString" type="string"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>