<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/Decryption" xmlns:tns="http://www.example.org/Decryption" elementFormDefault="qualified">

    <element name="Input">
    	<complexType>
    		<sequence>
    			<element name="EncryptedPassword" type="string"></element>
    		</sequence>
    	</complexType></element>

    <element name="Output">
    	<complexType>
    		<sequence>
    			<element name="DecryptedPassword" type="string"
    				minOccurs="0" maxOccurs="1">
    			</element>
    			<element name="Status">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="OK"></enumeration>
    						<enumeration value="KO"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ErrorDesc" type="string" minOccurs="0" maxOccurs="1"></element>
    		</sequence>
    	</complexType></element>
</schema>