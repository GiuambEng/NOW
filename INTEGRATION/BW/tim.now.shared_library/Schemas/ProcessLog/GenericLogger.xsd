<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/GenericLogger" targetNamespace="http://www.tim.com/NOW/xsd/GenericLogger" elementFormDefault="qualified">
	<complexType name="Generic_Logger">
		<sequence>
			<element name="Application" type="string" minOccurs="0" />
			<element name="Process" type="string" minOccurs="0" />
			<element name="Service" type="string" minOccurs="0" />
			<element name="Operation" type="string" minOccurs="0" />
			<element name="BusinessID" type="string" minOccurs="0" />
			<element name="MsgCode" type="string" minOccurs="0" />
			<element name="Message" type="string" minOccurs="0" />
			<element name="Payload" type="string" minOccurs="0" />
			<element name="LoggerName" type="string" minOccurs="0" />
			<element name="LogLevel" type="string" minOccurs="0" />
			<element name="LogJMS" type="boolean" minOccurs="0" />
		</sequence>
	</complexType>
	<complexType name="Envelope_type">
		<sequence>
			<element name="Identifier" type="tns:IdentifierType" minOccurs="0"/>
			<element name="track_position" type="string" minOccurs="0"/>
			<element name="Timestamp" type="dateTime" minOccurs="0"/>
			<element name="PayloadType" type="string" minOccurs="0"/>
			<element name="TransportInfo" type="tns:TransportInfoType" minOccurs="0"/>
			<element ref="tns:ErrorLog" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="ErrorLog_Type">
		<sequence>
			<element name="TimeStamp" type="dateTime" minOccurs="0"/>
			<element name="Descrizione" type="string" minOccurs="0"/>
			<element name="Codice" type="string" minOccurs="0"/>
			<element ref="tns:track_position" minOccurs="0"/>
			<element name="ErrorReport" type="tns:ErrorReportType" minOccurs="0"/>
			<element name="TransportInfo" type="tns:TransportInfoType" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="ErrorReportType">
		<sequence>
			<element name="StackTrace" type="string" minOccurs="0"/>
			<element name="Msg" type="string" minOccurs="0"/>
			<element name="FullClass" type="string" minOccurs="0"/>
			<element name="Class" type="string" minOccurs="0"/>
			<element name="ProcessStack" type="string" minOccurs="0"/>
			<element name="MsgCode" type="string" minOccurs="0"/>
			<element name="Data">
				<complexType>
					<sequence>
						<any minOccurs="0"/>
					</sequence>
				</complexType>
			</element>
		</sequence>
	</complexType>
	<complexType name="IdentifierType">
		<sequence>
			<element name="ServiceName" type="string" minOccurs="0"/>
			<element name="EndpointURL" type="string" minOccurs="0"/>
			<element name="Operation" type="string" minOccurs="0"/>
			<element name="Source" type="string" minOccurs="0"/>
			<element name="BusinessID" type="string" minOccurs="0"/>
			<element name="EventID" type="string" minOccurs="0"/>
			<element name="CorrelationID" type="string" minOccurs="0"/>
			<element name="EventType" type="string" minOccurs="0"/>
			<element name="trackID" type="string" minOccurs="0"/>
			<element name="ErrorId" type="string" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="LogMessage_Type">
		<sequence>
			<element name="PayloadType" minOccurs="0">
				<simpleType>
					<restriction base="string">
						<enumeration value="XML_STRING"/>
						<enumeration value="ZIPPED"/>
						<enumeration value="BINARY"/>
						<enumeration value=""/>
					</restriction>
				</simpleType>
			</element>
			<element name="TransportInfo" type="tns:TransportInfoType" minOccurs="0"/>
			<element name="TimeStamp" type="dateTime" minOccurs="0"/>
			<element name="Playload">
				<complexType>
					<sequence>
						<element name="Binary" type="base64Binary" minOccurs="0"/>
						<element name="XMLString" type="string" minOccurs="0"/>
					</sequence>
				</complexType>
			</element>
			<element ref="tns:track_position"/>
		</sequence>
	</complexType>
	<complexType name="LogType">
		<sequence>
			<element name="Timestamp" type="dateTime" minOccurs="0"/>
			<element name="severity_level" minOccurs="0">
				<simpleType>
					<restriction base="string"/>
				</simpleType>
			</element>
			<element ref="tns:track_position" minOccurs="0"/>
			<element name="message" type="string" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="TransportInfoType">
		<sequence>
			<element name="TransportType" minOccurs="0">
				<complexType>
					<attribute name="name" type="string"/>
					<attribute name="relationShip" type="string"/>
				</complexType>
			</element>
			<element name="DestinationName" type="string" minOccurs="0"/>
		</sequence>
	</complexType>
	<element name="track_position" type="string"/>
	<complexType name="TrackPosition"/>
	<complexType name="track_position"/>
	<element name="CW_BUS_MESSAGE">
		<complexType>
			<sequence>
				<element name="GenericLogger" type="tns:Generic_Logger" minOccurs="0"/>
				<element name="ActiveLoggerServices" type="tns:Active_Logger_Services" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="ErrorLog" type="tns:ErrorLog_Type"/>
	<element name="Log" type="tns:LogType"/>
	<element name="LoggerInput">
		<complexType>
			<sequence>
				<element name="Identifier" type="tns:IdentifierType" minOccurs="0"/>
				<choice>
					<element name="LogActivity" type="tns:LogType"/>
					<element name="LogError" type="tns:ErrorLog_Type"/>
					<element name="LogMsg" type="tns:LogMessage_Type"/>
				</choice>
			</sequence>
		</complexType>
	</element>
	<element name="MessageId" type="string"/>
	<complexType name="Active_Logger_Services">
			<sequence>
				<element name="Envelope" type="tns:Envelope_type" minOccurs="0"/>
				<element name="Playload" minOccurs="0">
					<complexType>
						<sequence>
							<element name="Binary" type="base64Binary" minOccurs="0"/>
							<element name="XMLString" type="string" minOccurs="0"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
</schema>
