                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="95625d99-a769-4f87-b2b3-3e75a611d993">
                <bpws:targets>
                    <bpws:target linkName="StartEstrazioniToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToLogEnd"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$StartEstrazioni/ns14:InputData/ns14:DataForProcedure" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($StartEstrazioni/ns14:InputData/ns14:DataForProcedure)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns14:Iterate_Current_Element_DataForProcedure"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToCallProcedure" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcedureToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="335220a7-71e3-4639-9ced-469e5ad4db11" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToCallProcedure"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($StartEstrazioni/ns14:InputData/ns14:DataForProcedure)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="039327c2-2897-45a2-bd8f-1f207fd6adf3">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcedureToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:ns=&quot;www.tim.now.StarterEstrazioni.DataForProcedure&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;CallProcedure-input&quot; match=&quot;/&quot;>&lt;ns:InputData>&lt;xsl:if test=&quot;$currentElement/tns:CODICE_OLO&quot;>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;$currentElement/tns:CODICE_OLO&quot;/>&lt;/ns:CODICEOLO>&lt;/xsl:if>&lt;ns:FLUSSO_ESTRAZIONE>&lt;xsl:value-of select=&quot;$currentElement/tns:FLUSSO_DI_ESTRAZIONE&quot;/>&lt;/ns:FLUSSO_ESTRAZIONE>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;$currentElement/tns:ID_FILE&quot;/>&lt;/ns:ID_FILE>&lt;ns:COD_INTRFC>&lt;xsl:value-of select=&quot;$currentElement/tns:COD_INTRFC&quot;/>&lt;/ns:COD_INTRFC>&lt;xsl:if test=&quot;$currentElement/tns:DATA_INIZIO&quot;>&lt;ns:DATA_INIZIO>&lt;xsl:value-of select=&quot;$currentElement/tns:DATA_INIZIO&quot;/>&lt;/ns:DATA_INIZIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns:DATA_FINE&quot;>&lt;ns:DATA_FINE>&lt;xsl:value-of select=&quot;$currentElement/tns:DATA_FINE&quot;/>&lt;/ns:DATA_FINE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns:DATA_ESPLETAMENTO&quot;>&lt;ns:DATA_ESPLETAMENTO>&lt;xsl:value-of select=&quot;$currentElement/tns:DATA_ESPLETAMENTO&quot;/>&lt;/ns:DATA_ESPLETAMENTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns:DESCR_FLUSSO&quot;>&lt;ns:DESCR_FLUSSO>&lt;xsl:value-of select=&quot;$currentElement/tns:DESCR_FLUSSO&quot;/>&lt;/ns:DESCR_FLUSSO>&lt;/xsl:if>&lt;/ns:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallProcedure-input"
                                    name="CallProcedure"
                                    tibex:xpdlId="067b65f9-a55a-470a-a9b3-48e4cac2c612"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCallProcedure"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcedureToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:ns=&quot;www.tim.now.StarterEstrazioni.DataForProcedure&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;CallProcedure-input&quot; match=&quot;/&quot;>&lt;ns:InputData>&lt;xsl:if test=&quot;$currentElement/tns:CODICE_OLO&quot;>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;$currentElement/tns:CODICE_OLO&quot;/>&lt;/ns:CODICEOLO>&lt;/xsl:if>&lt;ns:FLUSSO_ESTRAZIONE>&lt;xsl:value-of select=&quot;$currentElement/tns:FLUSSO_DI_ESTRAZIONE&quot;/>&lt;/ns:FLUSSO_ESTRAZIONE>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;$currentElement/tns:ID_FILE&quot;/>&lt;/ns:ID_FILE>&lt;ns:COD_INTRFC>&lt;xsl:value-of select=&quot;$currentElement/tns:COD_INTRFC&quot;/>&lt;/ns:COD_INTRFC>&lt;xsl:if test=&quot;$currentElement/tns:DATA_INIZIO&quot;>&lt;ns:DATA_INIZIO>&lt;xsl:value-of select=&quot;$currentElement/tns:DATA_INIZIO&quot;/>&lt;/ns:DATA_INIZIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns:DATA_FINE&quot;>&lt;ns:DATA_FINE>&lt;xsl:value-of select=&quot;$currentElement/tns:DATA_FINE&quot;/>&lt;/ns:DATA_FINE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns:DATA_ESPLETAMENTO&quot;>&lt;ns:DATA_ESPLETAMENTO>&lt;xsl:value-of select=&quot;$currentElement/tns:DATA_ESPLETAMENTO&quot;/>&lt;/ns:DATA_ESPLETAMENTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns:DESCR_FLUSSO&quot;>&lt;ns:DESCR_FLUSSO>&lt;xsl:value-of select=&quot;$currentElement/tns:DESCR_FLUSSO&quot;/>&lt;/ns:DESCR_FLUSSO>&lt;/xsl:if>&lt;/ns:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.batch.alignment.module.RAC.Sub_CallProcedure" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
