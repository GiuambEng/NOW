            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;getDay&quot;/>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:template name=&quot;StartEstrazioni-input&quot; match=&quot;/&quot;>&lt;ns:root>&lt;ns:InputData>&lt;ns:SystemName>&lt;xsl:value-of select=&quot;'RAC'&quot;/>&lt;/ns:SystemName>&lt;ns:IDSystem>&lt;xsl:value-of select=&quot;'30'&quot;/>&lt;/ns:IDSystem>&lt;ns:DayEstrazione>&lt;xsl:value-of select=&quot;$getDay&quot;/>&lt;/ns:DayEstrazione>&lt;ns:LogInfo>&lt;ns:ApplicationName>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/ns:ApplicationName>&lt;ns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/ns:LoggerName>&lt;ns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/ns:LogLevel>&lt;/ns:LogInfo>&lt;/ns:InputData>&lt;/ns:root>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="StartEstrazioni-input"
