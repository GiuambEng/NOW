                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2ac7a09d-82d3-440b-b304-3734e67e975a+input&quot; xmlns:tns=&quot;http://www.example.org/PresenceCommerciale&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;esito1&quot;/>&#xa;    &lt;xsl:param name=&quot;NEXTVAL&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertAPIPRESENCEINPUT-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcUpdateActivityInput>&#xa;            &lt;idRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NEXTVAL/Record[1]/NEXTVAL)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$NEXTVAL/Record[1]/NEXTVAL&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idRichiesta>&#xa;            &lt;transactionID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:TRANSACTION_ID)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/transactionID>&#xa;            &lt;codMigrazione>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:CODICE_MIGRAZIONE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:CODICE_MIGRAZIONE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codMigrazione>&#xa;            &lt;codOLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:CODICE_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:CODICE_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOLO>&#xa;            &lt;request>&#xa;                &lt;xsl:value-of select=&quot;$post&quot;/>&#xa;            &lt;/request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$esito1='0'&quot;>&#xa;                    &lt;response>&#xa;                        &lt;xsl:value-of select=&quot;'0 - ACK'&quot;/>&#xa;                    &lt;/response>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;response>&#xa;                        &lt;xsl:value-of select=&quot;'1 -NACK'&quot;/>&#xa;                    &lt;/response>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$esito1='0'&quot;>&#xa;                    &lt;idStatoElabStaging>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/idStatoElabStaging>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;idStatoElabStaging>&#xa;      