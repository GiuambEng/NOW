                                    sqlStatement="INSERT INTO ANALITICO_API_PRESENCE_ESITO (IDENTIFICATIVO_RICHIESTA, TRANSACTION_ID, CODICE_MIGRAZIONE, CODICE_ESITO, CONTENUTO_REQUEST, CONTENUTO_RESPONSE, ID_STATO_ELABORAZIONE_STAGING, REASON, REASON_CODE, TIMESTAMP_RICHIESTA, TIMESTAMP_RESPONSE)&#xd;&#xa;VALUES (?,?,?,?,?,?,?,?,?,sysdate,sysdate)"
