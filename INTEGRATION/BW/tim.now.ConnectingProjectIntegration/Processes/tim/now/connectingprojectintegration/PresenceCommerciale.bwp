                                    sqlStatement="INSERT INTO ANALITICO_API_PRESENCE_INPUT (IDENTIFICATIVO_RICHIESTA, TRANSACTION_ID, CODICE_MIGRAZIONE, CODICE_OLO, CONTENUTO_REQUEST, CONTENUTO_RESPONSE, ID_STATO_ELABORAZIONE_STAGING, DESCRIZIONE_ERRORE, TIMESTAMP_RICHIESTA, TIMESTAMP_RESPONSE)&#xd;&#xa;VALUES (?,?,?,?,?,?,?,'Campi obbligatori assenti',sysdate,sysdate)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

