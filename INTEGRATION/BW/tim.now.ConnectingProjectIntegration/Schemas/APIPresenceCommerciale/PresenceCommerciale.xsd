<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/PresenceCommerciale" xmlns:tns="http://www.example.org/PresenceCommerciale" elementFormDefault="qualified">

    <element name="PresenceCommercialeInput">
    	<complexType>
    		<sequence>
    			<element name="TRANSACTION_ID" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CODICE_MIGRAZIONE" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CODICE_OLO" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CODICE_SESSIONE" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CODICE_ORDINE_RECIPIENT" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="18"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DATA_INVIO_CS" type="dateTime" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="PresenceCommercialeOutput">
    	<complexType>
    		<sequence>
    			<element name="TRANSACTION_ID" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="CODICE_ESITO" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>