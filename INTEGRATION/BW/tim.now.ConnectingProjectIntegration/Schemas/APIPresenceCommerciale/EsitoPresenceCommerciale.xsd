<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/EsitoPresenceCommerciale" xmlns:tns="http://www.example.org/EsitoPresenceCommerciale" elementFormDefault="qualified">

    <element name="EsitoPresenceCommerciale">
    	<complexType>
    		<sequence>
    			<element name="TRANSACTION_ID" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="CODICE_MIGRAZIONE" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="CODICE_ESITO" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="REASON_CODE" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="REASON" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="EsitoPresenceCommercialeOutput">
    	<complexType>
    		<sequence>
    			<element name="request_id" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="reason_code" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="reason" type="string" maxOccurs="1" minOccurs="1"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>