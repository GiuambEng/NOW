                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/log/InsertStagingIDSLUCO/&quot; xmlns:tns=&quot;http://www.example.org/tim.now.schema.xsd.MigrazioneIDSLUCO.Noval&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Noval_Detail_Last&quot;/>&#xa;    &lt;xsl:param name=&quot;Noval_Detail&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:param name=&quot;Contenuto&quot;/>&#xa;    &lt;xsl:param name=&quot;FindFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Var_InsertStag&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($Noval_Detail_Last/Rows/tns:MigrazioneIDSLUCO_dettaglio) =0&quot;>&#xa;                &lt;ns:root>&#xa;                    &lt;xsl:for-each select=&quot;$Noval_Detail/Rows/tns:MigrazioneIDSLUCO_dettaglio&quot;>&#xa;                        &lt;ns:Input>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns:Tipo_record&quot;>&#xa;                                &lt;ns:TipoRecord>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Tipo_record&quot;/>&#xa;                                &lt;/ns:TipoRecord>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:CLLI&quot;>&#xa;                                &lt;ns:COD_CLLI_CENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns:CLLI&quot;/>&#xa;                                &lt;/ns:COD_CLLI_CENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:OPERATORE&quot;>&#xa;                                &lt;ns:CODFC_OLO_AGICOM>&#xa;                                    &lt;xsl:value-of select=&quot;tns:OPERATORE&quot;/>&#xa;                                &lt;/ns:CODFC_OLO_AGICOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:COPPIA_A&quot;>&#xa;                                &lt;ns:COPPIA_A>&#xa;                                    &lt;xsl:value-of select=&quot;tns:COPPIA_A&quot;/>&#xa;                                &lt;/ns:COPPIA_A>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:COPPIA_DA&quot;>&#xa;                                &lt;ns:COPPIA_DA>&#xa;                                    &lt;xsl:value-of select=&quot;tns:COPPIA_DA&quot;/>&#xa;                                &lt;/ns:COPPIA_DA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:DATA_CONSEGNA_OLO&quot;>&#xa;                                &lt;ns:DATAINZ_VALID>&#xa;                                    &lt;xsl:value-of select=&quot;tns:DATA_CONSEGNA_OLO&quot;/>&#xa;                                &lt;/ns:DATAINZ_VALID>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:DATA_INVIO&quot;>&#xa;                                &lt;ns:DATA_INVIO_RICH>&#xa;                                    &lt;xsl:value-of select=&quot;tns:DATA_INVIO&quot;/>&#xa;                                &lt;/ns:DATA_INVIO_RICH>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FindFile/tns1:FileName&quot;>&#xa;                                &lt;ns:NOME_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$FindFile/tns1:FileName&quot;/>&#xa;                                &lt;/ns:NOME_FILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:ID_RICHIESTA&quot;>&#xa;                                &lt;ns:ID_RICH_FATTIB>&#xa;                                    &lt;xsl:value-of select=&quot;tns:ID_RICHIESTA&quot;/>&#xa;                                &lt;/ns:ID_RICH_FATTIB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:if test=&quot;tns:IDSLUCO&quot;>&#xa;                                &lt;ns:IDSLUCO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:IDSLUCO&quot;/>&#xa;                                &lt;/ns:IDSLUCO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;tns:PROGRESSIVO&quot;>&#xa;                                &lt;ns:PROGRS>&#xa;                                    &lt;xsl:value-of select=&quot;tns:PROGRESSIVO&quot;/>&#xa;                                &lt;/ns:PROGRS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:TESTARMADIO&quot;>&#xa;                                &lt;ns:TESTARMADIO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:TESTARMADIO&quot;/>&#xa;                                &lt;/ns:TESTARMADIO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TMSP_INSMTO>