             &lt;xsl:if test=&quot;$FindFile/tns1:FileName&quot;>&#xa;                                &lt;ns:NOME_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$FindFile/tns1:FileName&quot;/>&#xa;                                &lt;/ns:NOME_FILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:ID_RICHIESTA&quot;>&#xa;                                &lt;ns:ID_RICH_FATTIB>&#xa;                                    &lt;xsl:value-of select=&quot;tns:ID_RICHIESTA&quot;/>&#xa;                                &lt;/ns:ID_RICH_FATTIB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:if test=&quot;tns:IDSLUCO&quot;>&#xa;                                &lt;ns:IDSLUCO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:IDSLUCO&quot;/>&#xa;                                &lt;/ns:IDSLUCO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;tns:PROGRESSIVO&quot;>&#xa;                                &lt;ns:PROGRS>&#xa;                                    &lt;xsl:value-of select=&quot;tns:PROGRESSIVO&quot;/>&#xa;                                &lt;/ns:PROGRS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:TESTARMADIO&quot;>&#xa;                                &lt;ns:TESTARMADIO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:TESTARMADIO&quot;/>&#xa;                                &lt;/ns:TESTARMADIO>&#xa;                            &lt;/xsl:if