<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/Testa_1" xmlns:tns="http://www.example.org/Testa_1" elementFormDefault="qualified">

    <element name="Testa">
    	<complexType>
    		<sequence>
                <element name="Tipo_record">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="1"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
                <element name="Data" >
    			<simpleType>
    			<restriction base="string">
    			<pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"></pattern></restriction>
    			</simpleType>
    			</element>
    		</sequence>
    	</complexType></element>
</schema>