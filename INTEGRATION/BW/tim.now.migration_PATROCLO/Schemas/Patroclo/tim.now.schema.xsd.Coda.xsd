<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/tim.now.schema.xsd.Coda" xmlns:tns="http://www.example.org/tim.now.schema.xsd.Coda" elementFormDefault="qualified">

    <element name="Coda">
    	<complexType>
    		<sequence>
    			<element name="Tipo_record" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>

    						<enumeration value="1"></enumeration>
    						<enumeration value="3"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Data" maxOccurs="1" minOccurs="1">
    			<simpleType>
    			<restriction base="string">
    			<pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"></pattern></restriction></simpleType></element>
    			<element name="Numero_record" type="int" maxOccurs="1" minOccurs="1"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>