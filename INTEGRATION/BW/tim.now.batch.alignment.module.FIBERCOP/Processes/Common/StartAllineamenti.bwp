            </tibex:ReferenceBinding>
        </bpws:partnerLink>
    </bpws:partnerLinks>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:TimerOutputSchema" name="Timer" sca-bpel:internal="true"/>
        <bpws:variable name="StartTime" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Timer/StartTime" type="xsd:dateTime"/>
        <bpws:variable name="IntervalloMinuti"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Timer/IntervalloMinuti" type="xsd:int"/>
        <bpws:variable element="ns1:jdbcQueryActivityInput"
            name="getFlow-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:resultSet" name="getFlow" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ActivityErrorData"
            name="_error_getFlow" sca-bpel:internal="true"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="tns:Input"
            name="VerificaLavorabilita-input" sca-bpel:internal="true"/>
        <bpws:variable element="tns:Output" name="VerificaLavorabilita" sca-bpel:internal="true"/>
        <bpws:variable name="LoggerName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LogName" type="xsd:string"/>
        <bpws:variable name="LogLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LogLevel" type="xsd:string"/>
        <bpws:variable element="ns4:Input" name="InsLogger-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:Output" name="InsLogger" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:InputData" name="MovedError-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:OutputData" name="MovedError" sca-bpel:internal="true"/>
        <bpws:variable name="PathError" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/FilePoller/PathErrorAnagraficaFormatContrattuale" type="xsd:string"/>
        <bpws:variable messageType="ns7:Conta_Request"
            name="ContaRecord-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:ActivityErrorData"
            name="_error_ContaRecord" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="getFlowToForEach" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ForEachToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="getFlowToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="Timer"
                    tibex:xpdlId="012e2193-e7e8-417b-8db5-02d5680ce6bc"
                    variable="Timer" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="StartTime"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="IntervalloMinuti"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value
                                    endTime="2023-07-21T11:32:08.389+0200"
                                    intervalUnit="Minute" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="getFlow-input"
                    name="getFlow" outputVariable="getFlow"
                    tibex:xpdlId="87c04414-b493-47f4-8db9-8944039266c5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="getFlowToForEach">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($getFlow/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($getFlow/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="getFlowToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+87c04414-b493-47f4-8db9-8944039266c5+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_FLOW, FLOW, SYSTEM&#xa;  FROM ALIGN_FILE_TRACKING&#xa;  WHERE (STATO IN ('DA LAVORARE', 'IN ATTESA') OR FLAG_REWORK = 'Y')&#xa;    AND SYSTEM IN ('FIBERCOP') AND ID_FLOW IN ('111')&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata columnIndex="1"
                                    columnName="ID_FLOW"
                                    dataType="1111"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="FLOW"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="SYSTEM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="ForEach" tibex:group="foreach" tibex:xpdlId="8e4e64f3-3936-45ec-a1f9-66cc82e37919">
                <bpws:targets>
                    <bpws:target linkName="getFlowToForEach"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ForEachToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="foreach">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="forEach"
                        parallel="no" tibex:group="foreach">
                        <tibex:DesignExpression name="final">
                            <tibex:expression
                                expression="count($getFlow/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($getFlow/Record)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToVerificaLavorabilita" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="VerificaLavorabilitaToProcessLoggerTrack" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="VerificaLavorabilitaToGroupEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="VerificaLavorabilitaToGestioneMovedFile" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="MovedErrorToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="InsLoggerToInvoke" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="InvokeToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:empty name="GroupStart"
                                    tibex:group="groupStart" tibex:xpdlId="d5fa0b07-f0b7-427c-b205-fa0bfde7c6a0">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToVerificaLavorabilita"/>
                                    </bpws:sources>
                                </bpws:empty>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="ea51bf24-586a-42c9-8c94-9c7e158ba6fa">
                                    <bpws:targets>
                                    <bpws:target linkName="VerificaLavorabilitaToGroupEnd"/>
                                    <bpws:target linkName="MovedErrorToGroupEnd"/>
                                    <bpws:target linkName="InvokeToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="VerificaLavorabilita-input"
                                    name="VerificaLavorabilita"
                                    outputVariable="VerificaLavorabilita"
                                    tibex:xpdlId="999c3596-de6d-4cf8-adde-98788a8828b6"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToVerificaLavorabilita"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VerificaLavorabilitaToProcessLoggerTrack">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VerificaLavorabilitaToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$VerificaLavorabilita/tns:STATO=('WAIT','NOFOUND')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$VerificaLavorabilita/tns:STATO=('WAIT','NOFOUND')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VerificaLavorabilitaToGestioneMovedFile">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$VerificaLavorabilita/tns:STATO='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$VerificaLavorabilita/tns:STATO='KO']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;getFlow&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaLavorabilita-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;xsl:if test=&quot;$getFlow/Record[number($index)]/FLOW&quot;>&#xa;                &lt;tns:FLUSSO>&#xa;                    &lt;xsl:value-of select=&quot;$getFlow/Record[number($index)]/FLOW&quot;/>&#xa;                &lt;/tns:FLUSSO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:ID_FLOW>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($getFlow/Record[number($index)]/ID_FLOW)&quot;/>&#xa;            &lt;/tns:ID_FLOW>&#xa;            &lt;tns:LogElement>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;            &lt;/tns:LogElement>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.VerificaLavorabilita" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="InsLogger-input"
                                    name="InsLogger"
                                    outputVariable="InsLogger"
                                    tibex:xpdlId="0fe247cc-11fa-4681-aea9-7fe9d8b45315"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VerificaLavorabilitaToProcessLoggerTrack"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InsLoggerToInvoke"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/CreateFileID&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;InsLogger-input&quot; match=&quot;/&quot;>&lt;tns2:Input>&lt;tns2:DataIn>&lt;tns2:Insert>&lt;tns2:InputFile>&lt;xsl:variable name=&quot;varCodIntrfc&quot; select=&quot;if(contains($VerificaLavorabilita/tns:NOME_FILE, &amp;quot;FormatContrattuale&amp;quot;)) then 'ID401' else ''&quot;/>&lt;tns2:CODICE_INTERFACCIA>&lt;xsl:value-of select=&quot;$varCodIntrfc&quot;/>&lt;/tns2:CODICE_INTERFACCIA>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;>&lt;tns2:NOME_FILE>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;/>&lt;/tns2:NOME_FILE>&lt;/xsl:if>&lt;tns2:DATA_FILE>&lt;xsl:value-of select=&quot;substring($VerificaLavorabilita/tns:DATA_FILE,1,10)&quot;/>&lt;/tns2:DATA_FILE>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:FILE_SIZE&quot;>&lt;tns2:SIZE>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:FILE_SIZE&quot;/>&lt;/tns2:SIZE>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;>&lt;tns2:ID_TRACK>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;/>&lt;/tns2:ID_TRACK>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;>&lt;tns2:FULL_NAME>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;/>&lt;/tns2:FULL_NAME>&lt;/xsl:if>&lt;tns2:FLAG_CONTENUTO_FILE>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns2:FLAG_CONTENUTO_FILE>&lt;/tns2:InputFile>&lt;/tns2:Insert>&lt;/tns2:DataIn>&lt;tns2:LogElement>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;/tns2:LogElement>&lt;/tns2:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.ProcessLoggerTrack" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="MovedError-input"
                                    name="MovedError"
                                    outputVariable="MovedError"
                                    tibex:xpdlId="833c35e9-2953-4056-b12f-f62bc95ec229"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VerificaLavorabilitaToGestioneMovedFile"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MovedErrorToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/ManageMoveFile&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;PathError&quot;/>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:template name=&quot;MovedError-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;>&lt;tns1:FullPathOrigine>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;/>&lt;/tns1:FullPathOrigine>&lt;/xsl:if>&lt;tns1:FolderDestinazione>&lt;xsl:value-of select=&quot;$PathError&quot;/>&lt;/tns1:FolderDestinazione>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;>&lt;tns1:NomeFile>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;/>&lt;/tns1:NomeFile>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;>&lt;tns1:ID_TRACK>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;/>&lt;/tns1:ID_TRACK>&lt;/xsl:if>&lt;tns1:LogInput>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LogName>&lt;/tns1:LogInput>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneMovedFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:invoke
                                    inputVariable="ContaRecord-input"
                                    name="ContaRecord"
                                    operation="ContaRecord"
                                    partnerLink="Conta"
                                    portType="ns7:Conta" tibex:xpdlId="aea723c2-d986-4da2-a071-78c4f5c49ba9">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/" xmlns:ns1="http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/" xmlns:tns="http://www.example.org/VerificaLavorabilita" xmlns:tns2="http://www.example.org/CreateFileID" version="2.0"&gt;&lt;xsl:param name="VerificaLavorabilita"/&gt;&lt;xsl:param name="InsLogger"/&gt;&lt;xsl:param name="getFlow"/&gt;&lt;xsl:template name="ContaRecord-input" match="/"&gt;&lt;ns:Conta_Request&gt;&lt;part1&gt;&lt;ns1:contaRecord_Input&gt;&lt;xsl:variable name="varQueue" select=" if(contains($VerificaLavorabilita/tns:NOME_FILE, &amp;quot;FormatContrattuale&amp;quot;)) then 'allineamento.anagraficaformcontr.fibercop'&amp;#xD;&amp;#xA;  else ''"/&gt;&lt;ns1:in&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns:SOURCE_FILE"/&gt;&lt;/ns1:in&gt;&lt;ns1:TipoSeparatore&gt;&lt;xsl:value-of select="'POSIZIONALE'"/&gt;&lt;/ns1:TipoSeparatore&gt;&lt;xsl:if test="$getFlow/Record[1]/FLOW"&gt;&lt;ns1:Flusso&gt;&lt;xsl:value-of select="$getFlow/Record[1]/FLOW"/&gt;&lt;/ns1:Flusso&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InsLogger/tns2:ID_FILE"&gt;&lt;ns1:ID_FILE&gt;&lt;xsl:value-of select="$InsLogger/tns2:ID_FILE"/&gt;&lt;/ns1:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns:SOURCE_FILE"&gt;&lt;ns1:FULLNAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns:SOURCE_FILE"/&gt;&lt;/ns1:FULLNAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns:NOME_FILE"&gt;&lt;ns1:FILENAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns:NOME_FILE"/&gt;&lt;/ns1:FILENAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InsLogger/tns2:ID_ESEC"&gt;&lt;ns1:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsLogger/tns2:ID_ESEC"/&gt;&lt;/ns1:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InsLogger/tns2:COD_PROCSO_FILE"&gt;&lt;ns1:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsLogger/tns2:COD_PROCSO_FILE"/&gt;&lt;/ns1:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns:ID_TRACK"&gt;&lt;ns1:ID_TRACK&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns:ID_TRACK"/&gt;&lt;/ns1:ID_TRACK&gt;&lt;/xsl:if&gt;&lt;ns1:NomeProcesso&gt;&lt;xsl:value-of select="$varQueue"/&gt;&lt;/ns1:NomeProcesso&gt;&lt;/ns1:contaRecord_Input&gt;&lt;/part1&gt;&lt;/ns:Conta_Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns2=&quot;http://www.example.org/CreateFileID&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:param name=&quot;InsLogger&quot;/>&#xa;    &lt;xsl:param name=&quot;getFlow&quot;/>&#xa;    &lt;xsl:template name=&quot;ContaRecord-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:contaRecord_Input>&#xa;            &lt;xsl:variable name=&quot;varQueue&quot; select=&quot; if(contains($VerificaLavorabilita/tns:NOME_FILE, &amp;quot;FormatContrattuale&amp;quot;)) then 'allineamento.anagraficaformcontr.fibercop'&amp;#xD;&amp;#xA;  else ''&quot;/>&#xa;            &lt;ns1:in>&#xa;                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;/>&#xa;            &lt;/ns1:in>&#xa;            &lt;ns1:TipoSeparatore>&#xa;                &lt;xsl:value-of select=&quot;'POSIZIONALE'&quot;/>&#xa;            &lt;/ns1:TipoSeparatore>&#xa;            &lt;xsl:if test=&quot;$getFlow/Record[1]/FLOW&quot;>&#xa;                &lt;ns1:Flusso>&#xa;                    &lt;xsl:value-of select=&quot;$getFlow/Record[1]/FLOW&quot;/>&#xa;                &lt;/ns1:Flusso>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsLogger/tns2:ID_FILE&quot;>&#xa;                &lt;ns1:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsLogger/tns2:ID_FILE&quot;/>&#xa;                &lt;/ns1:ID_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;>&#xa;                &lt;ns1:FULLNAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;/>&#xa;                &lt;/ns1:FULLNAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;>&#xa;                &lt;ns1:FILENAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;/>&#xa;                &lt;/ns1:FILENAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsLogger/tns2:ID_ESEC&quot;>&#xa;                &lt;ns1:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsLogger/tns2:ID_ESEC&quot;/>&#xa;                &lt;/ns1:ID_ESEC_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsLogger/tns2:COD_PROCSO_FILE&quot;>&#xa;                &lt;ns1:COD_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsLogger/tns2:COD_PROCSO_FILE&quot;/>&#xa;                &lt;/ns1:COD_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;>&#xa;                &lt;ns1:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;/>&#xa;                &lt;/ns1:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns1:NomeProcesso>&#xa;                &lt;xsl:value-of select=&quot;$varQueue&quot;/>&#xa;            &lt;/ns1:NomeProcesso>&#xa;        &lt;/ns1:contaRecord_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="InsLoggerToInvoke"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InvokeToGroupEnd"/>
                                    </bpws:sources>
                                </bpws:invoke>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="087cd5d4-bf1a-4c0d-83b9-54d540fc330b">
                <bpws:targets>
                    <bpws:target linkName="ForEachToExit"/>
                    <bpws:target linkName="getFlowToExit"/>
                </bpws:targets>
            </bpws:exit>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
