                <bpws:links>
                    <bpws:link name="GroupStart1ToWhile" tibex:linkType="SUCCESS"/>
                    <bpws:link name="WhileToGroupEnd1" tibex:linkType="SUCCESS"/>
                </bpws:links>
                <bpws:empty name="GroupStart1" tibex:group="groupStart" tibex:xpdlId="3b18d665-1204-44a8-9f12-e92788097478">
                    <bpws:sources>
                        <bpws:source linkName="GroupStart1ToWhile"/>
                    </bpws:sources>
                </bpws:empty>
                <bpws:empty name="GroupEnd1" tibex:group="groupEnd" tibex:xpdlId="f990726b-482d-46b5-829d-e36286b494d5">
                    <bpws:targets>
                        <bpws:target linkName="WhileToGroupEnd1"/>
                    </bpws:targets>
                </bpws:empty>
                <bpws:scope name="While" tibex:group="while" tibex:xpdlId="59e8136a-15be-4cd4-aca5-429b8ca9b157">
                    <bpws:targets>
                        <bpws:target linkName="GroupStart1ToWhile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="WhileToGroupEnd1"/>
                    </bpws:sources>
                    <bpws:variables>
                        <bpws:variable name="index"
                            sca-bpel:internal="true" type="xsd:int">
                            <bpws:from>
                                <bpws:literal>1</bpws:literal>
                            </bpws:from>
                        </bpws:variable>
                    </bpws:variables>
                    <bpws:sequence name="sequence" tibex:group="while">
                        <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                        <bpws:while name="while" tibex:counterName="index">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$index &lt;= ((($JMSReceiveMessage/Body/ns3:queueResponse/ns3:NumeroRecord) div $Passo) + 1)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= ((($JMSReceiveMessage/Body/ns3:queueResponse/ns3:NumeroRecord) div $Passo) + 1)]]></bpws:condition>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToParseData" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="GroupStartToParseData1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
