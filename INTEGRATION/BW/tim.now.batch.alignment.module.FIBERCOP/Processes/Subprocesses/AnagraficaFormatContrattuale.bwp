y/ns1:queueResponse/ns1:FILENAME&quot;/>&#xa;                &lt;/tns10:NomeFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns10:ID_TRACK>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_TRACK)&quot;/>&#xa;            &lt;/tns10:ID_TRACK>&#xa;            &lt;tns10:LogInput>&#xa;                &lt;tns10:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns10:LogLevel>&#xa;                &lt;tns10:LogName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns10:LogName>&#xa;            &lt;/tns10:LogInput>&#xa;        &lt;/tns10:InputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
