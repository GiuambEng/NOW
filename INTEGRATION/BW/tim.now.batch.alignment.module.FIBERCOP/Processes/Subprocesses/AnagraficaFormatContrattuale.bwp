                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="JDBCUpdate-input"
                                name="JDBCUpdate"
                                outputVariable="JDBCUpdate"
                                tibex:xpdlId="5430222d-7580-4868-a706-e05c8a94732a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
