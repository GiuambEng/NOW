                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TrackKOfunctToExit"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.example.org/InputTrackFile&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns11=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;MoveScarto&quot;/>&#xa;    &lt;xsl:template name=&quot;TrackKOfunct-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:Input>&#xa;            &lt;tns10:Update>&#xa;                &lt;tns10:FLAG_LAVORAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns10:FLAG_LAVORAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='KO'&quot;>&#xa;                        &lt;tns10:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'KO_NUMERO_RECORD'&quot;/>&#xa;                        &lt;/tns10:STATO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns10:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'COMPLETATO'&quot;/>&#xa;                        &lt;/tns10:STATO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='KO'&quot;>&#xa;                    &lt;tns10:DESCR_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;concat('***ERRORE NUMERO RECORD, RECORD CONTATI= ',string($JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord))&quot;/>&#xa;                    &lt;/tns10:DESCR_ERRORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns10:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_TRACK)&quot;/>&#xa;                &lt;/tns10:ID_TRACK>&#xa;                &lt;xsl:if test=&quot;string-length($MoveScarto/tns11:FullPathMovedFile) > 0 and $JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='KO'&quot;>&#xa;                    &lt;xsl:if test=&quot;$MoveScarto/tns11:FullPathMovedFile&quot;>&#xa;                        &lt;tns10:FOLDER_SCARTO>&#xa;                            &lt;xsl:value-of select=&quot;$MoveScarto/tns11:FullPathMovedFile&quot;/>&#xa;                        &lt;/tns10:FOLDER_SCARTO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns10:LogElement>&#xa;                    &lt;tns10:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                    &lt;/tns10:LoggerName>&#xa;                    &lt;tns10:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                    &lt;/tns10:LogLevel>&#xa;                &lt;/tns10:LogElement>&#xa;            &lt;/tns10:Update>&#xa;        &lt;/tns10:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
