                                    tibex:xpdlId="2f182b82-c0e4-4a5b-b6f6-03903b102196" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ContenutoRecdAnagraficaFormatContrattualeToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Input_StagingToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.org/InputStagingAnagraficaFormatContrattuale&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/AnagraficaFormatContrattuale&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoVal&quot;/>&#xa;    &lt;xsl:template name=&quot;InputStaging&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns5:AnagraficaFormatContrattuale)=0&quot;>&#xa;                &lt;tns4:AnagraficaFormatContrattualeStaging>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns5:AnagraficaFormatContrattuale&quot;>&#xa;                        &lt;tns4:InputStagingAnagraficaFormatContrattuale>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns5:OAO&quot;>&#xa;                                &lt;tns4:OAO>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:OAO&quot;/>&#xa;                                &lt;/tns4:OAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:AreaDiCentrale&quot;>&#xa;                                &lt;tns4:AREADICENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:AreaDiCentrale&quot;/>&#xa;                                &lt;/tns4:AREADICENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:CodiceImpresa&quot;>&#xa;                                &lt;tns4:CODICEIMPRESA>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:CodiceImpresa&quot;/>&#xa;                                &lt;/tns4:CODICEIMPRESA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DescrizioneTipologiaImpresa&quot;>&#xa;                                &lt;tns4:DESCTPLGIMPRESA>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DescrizioneTipologiaImpresa&quot;/>&#xa;                                &lt;/tns4:DESCTPLGIMPRESA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:GestAutonPA&quot;>&#xa;                                &lt;tns4:GESTAUTONPA>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:GestAutonPA&quot;/>&#xa;                                &lt;/tns4:GESTAUTONPA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DataInizioValiditaProvisioning&quot;>&#xa;                                &lt;tns4:DATAINIVALPROVISIONING>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DataInizioValiditaProvisioning&quot;/>&#xa;                                &lt;/tns4:DATAINIVALPROVISIONING>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DataFineValiditaProvisioning&quot;>&#xa;                                &lt;tns4:DATAFINVALPROVISIONING>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DataFineValiditaProvisioning&quot;/>&#xa;                                &lt;/tns4:DATAFINVALPROVISIONING>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&#xa;                                &lt;tns4:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&#xa;                                &lt;/tns4:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FULLNAME&quot;>&#xa;                                &lt;tns4:NOME_FILEPROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FULLNAME&quot;/>&#xa;                                &lt;/tns4:NOME_FILEPROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;tns4:STATO_ELAB>&#xa;                                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                            &lt;/tns4:STATO_ELAB>&#xa;                            &lt;tns4:TIMESTAMP_INSERIMENTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns4:TIMESTAMP_INSERIMENTO>&#xa;                            &lt;tns4:TIMESTAMP_AGGIORNAMENTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns4:TIMESTAMP_AGGIORNAMENTO>&#xa;                            &lt;tns4:NUMERORECORD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/tns4:NUMERORECORD>&#xa;                        &lt;/tns4:InputStagingAnagraficaFormatContrattuale>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns4:AnagraficaFormatContrattualeStaging>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns4:AnagraficaFormatContrattualeStaging>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns5:AnagraficaFormatContrattuale&quot;>&#xa;                        &lt;tns4:InputStagingAnagraficaFormatContrattuale>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns5:OAO&quot;>&#xa;                                &lt;tns4:OAO>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:OAO&quot;/>&#xa;                                &lt;/tns4:OAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:AreaDiCentrale&quot;>&#xa;                                &lt;tns4:AREADICENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:AreaDiCentrale&quot;/>&#xa;                                &lt;/tns4:AREADICENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:CodiceImpresa&quot;>&#xa;                                &lt;tns4:CODICEIMPRESA>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:CodiceImpresa&quot;/>&#xa;                                &lt;/tns4:CODICEIMPRESA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DescrizioneTipologiaImpresa&quot;>&#xa;                                &lt;tns4:DESCTPLGIMPRESA>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DescrizioneTipologiaImpresa&quot;/>&#xa;                                &lt;/tns4:DESCTPLGIMPRESA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:GestAutonPA&quot;>&#xa;                                &lt;tns4:GESTAUTONPA>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:GestAutonPA&quot;/>&#xa;                                &lt;/tns4:GESTAUTONPA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DataInizioValiditaProvisioning&quot;>&#xa;                                &lt;tns4:DATAINIVALPROVISIONING>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DataInizioValiditaProvisioning&quot;/>&#xa;                                &lt;/tns4:DATAINIVALPROVISIONING>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DataFineValiditaProvisioning&quot;>&#xa;                                &lt;tns4:DATAFINVALPROVISIONING>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DataFineValiditaProvisioning&quot;/>&#xa;                                &lt;/tns4:DATAFINVALPROVISIONING>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&#xa;                                &lt;tns4:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&#xa;                                &lt;/tns4:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FULLNAME&quot;>&#xa;                                &lt;tns4:NOME_FILEPROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FULLNAME&quot;/>&#xa;                                &lt;/tns4:NOME_FILEPROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;tns4:STATO_ELAB>&#xa;                                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                            &lt;/tns4:STATO_ELAB>&#xa;                            &lt;tns4:TIMESTAMP_INSERIMENTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns4:TIMESTAMP_INSERIMENTO>&#xa;                            &lt;tns4:TIMESTAMP_AGGIORNAMENTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns4:TIMESTAMP_AGGIORNAMENTO>&#xa;                            &lt;tns4:NUMERORECORD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/tns4:NUMERORECORD>&#xa;                        &lt;/tns4:InputStagingAnagraficaFormatContrattuale>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns4:AnagraficaFormatContrattualeStaging>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="InputStaging" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="Log_InputStaging-input"
                                    name="Log_InputStaging"
                                    tibex:xpdlId="cd125beb-9a65-42d7-8ec4-961c393d2777"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Input_StagingToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log_InputStagingToJDBCUpdate1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;InputStaging&quot;/>&lt;xsl:template name=&quot;Log_InputStaging-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'AnagraficaFormatContrattuale'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Input staging AnagraficaFormatContrattuale: &amp;quot;,tib:render-xml($InputStaging, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="InsertStaging-input"
                                    name="InsertStaging"
                                    outputVariable="InsertStaging"
                                    tibex:xpdlId="f9f42197-68f1-403a-ab17-b8e96d55e00f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Log_InputStagingToJDBCUpdate1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InsertStagingToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.org/InputStagingAnagraficaFormatContrattuale&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f9f42197-68f1-403a-ab17-b8e96d55e00f+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InputStaging&quot;/>&lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&lt;tns7:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$InputStaging/tns4:InputStagingAnagraficaFormatContrattuale&quot;>&lt;Record>&lt;OAO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns4:OAO)&quot;>&lt;xsl:value-of select=&quot;tns4:OAO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OAO>&lt;AREADICENTRALE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns4:AREADICENTRALE)&quot;>&lt;xsl:value-of select=&quot;tns4:AREADICENTRALE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/AREADICENTRALE>&lt;CODICEIMPRESA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns4:CODICEIMPRESA)&quot;>&lt;xsl:value-of select=&quot;tns4:CODICEIMPRESA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICEIMPRESA>&lt;DESCTPLGIMPRESA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns4:DESCTPLGIMPRESA)&quot;>&lt;xsl:value-of select=&quot;tns4:DESCTPLGIMPRESA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCTPLGIMPRESA>&lt;GESTAUTONPA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns4:GESTAUTONPA)&quot;>&lt;xsl:value-of select=&quot;tns4:GESTAUTONPA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/GESTAUTONPA>&lt;DATAINIVALPROVISIONING>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns4:DATAINIVALPROVISIONING)&quot;>&lt;xsl:value-of select=&quot;tns4:DATAINIVALPROVISIONING&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATAINIVALPROVISIONING>&lt;DATAFINVALPROVISIONING>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns4:DATAFINVALPROVISIONING)&quot;>&lt;xsl:value-of select=&quot;tns4:DATAFINVALPROVISIONING&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATAFINVALPROVISIONING>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal(tns4:ID_FILE_PROCSTO_INPUT)&quot;/>&lt;/ID_FILE_PROCSTO_INPUT>&lt;NOME_FILEPROCSTO_INPUT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns4:NOME_FILEPROCSTO_INPUT)&quot;>&lt;xsl:value-of select=&quot;tns4:NOME_FILEPROCSTO_INPUT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME_FILEPROCSTO_INPUT>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:decimal(tns4:ID_STATO_ELAB_STAG)&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;STATO_ELAB>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns4:STATO_ELAB)&quot;>&lt;xsl:value-of select=&quot;tns4:STATO_ELAB&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STATO_ELAB>&lt;TIMESTAMP_INSERIMENTO>&lt;xsl:value-of select=&quot;xsd:dateTime(tns4:TIMESTAMP_INSERIMENTO)&quot;/>&lt;/TIMESTAMP_INSERIMENTO>&lt;TIMESTAMP_AGGIORNAMENTO>&lt;xsl:value-of select=&quot;xsd:dateTime(tns4:TIMESTAMP_AGGIORNAMENTO)&quot;/>&lt;/TIMESTAMP_AGGIORNAMENTO>&lt;DESCRIZIONE_SCARTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns4:DESCRIZIONE_SCARTO)&quot;>&lt;xsl:value-of select=&quot;tns4:DESCRIZIONE_SCARTO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCRIZIONE_SCARTO>&lt;/Record>&lt;/xsl:for-each>&lt;/tns7:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.STG_STORICOFORMATCONTRATTUALE (OAO, AREADICENTRALE,&#xa;  CODICEIMPRESA, DESCTPLGIMPRESA, GESTAUTONPA, DATAINIVALPROVISIONING,&#xa;  DATAFINVALPROVISIONING, ID_FILE_PROCSTO_INPUT, NOME_FILEPROCSTO_INPUT,&#xa;  ID_STATO_ELAB_STAG, STATO_ELAB, TIMESTAMP_INSERIMENTO, TIMESTAMP_AGGIORNAMENTO,&#xa;  DESCRIZIONE_SCARTO)&#xa;  VALUES (?, ?, ?, ?, ?, TO_DATE(?, 'dd/mm/yyyy'), TO_DATE(?, 'dd/mm/yyyy'), ?, ?, ?, ?, ?, ?, ?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OAO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="AREADICENTRALE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICEIMPRESA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCTPLGIMPRESA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="GESTAUTONPA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINIVALPROVISIONING"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAFINVALPROVISIONING"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE_PROCSTO_INPUT"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_FILEPROCSTO_INPUT"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_STATO_ELAB_STAG"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_ELAB"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMESTAMP_INSERIMENTO"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMESTAMP_AGGIORNAMENTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCRIZIONE_SCARTO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
