                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/CreateFileID&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LoggerKOFunct-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;tns1:DataIn>&lt;tns1:Update>&lt;xsl:choose>&lt;xsl:when test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='KO'&quot;>&lt;tns1:InputFile>&lt;tns1:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE)&quot;/>&lt;/tns1:ID_FILE>&lt;tns1:STATO_ESEC>&lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&lt;/tns1:STATO_ESEC>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns1:ESITO>&lt;tns1:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;&amp;quot;ERRORE NUMERO RECORD&amp;quot;&quot;/>&lt;/tns1:DESCR_STATO_FILE>&lt;tns1:LOG_MESSAGE>&lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE INPUT PER NUMERO RECORD INCONGRUENTE&amp;quot;&quot;/>&lt;/tns1:LOG_MESSAGE>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord&quot;>&lt;tns1:RECORD_KO>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord&quot;/>&lt;/tns1:RECORD_KO>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord&quot;>&lt;tns1:RECORD_TOTALI>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord&quot;/>&lt;/tns1:RECORD_TOTALI>&lt;/xsl:if>&lt;/tns1:InputFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:InputFile>&lt;tns1:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE)&quot;/>&lt;/tns1:ID_FILE>&lt;tns1:STATO_ESEC>&lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&lt;/tns1:STATO_ESEC>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:ESITO>&lt;tns1:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&lt;/tns1:DESCR_STATO_FILE>&lt;tns1:LOG_MESSAGE>&lt;xsl:value-of select=&quot;&amp;quot;LAVORAZIONE FILE INPUT ESEGUITA CON SUCCESSO&amp;quot;&quot;/>&lt;/tns1:LOG_MESSAGE>&lt;tns1:RECORD_OK>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:RECORD_OK>&lt;tns1:RECORD_KO>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:RECORD_KO>&lt;tns1:RECORD_TOTALI>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:RECORD_TOTALI>&lt;/tns1:InputFile>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:OutputFile>&lt;tns1:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE)&quot;/>&lt;/tns1:ID_FILE>&lt;/tns1:OutputFile>&lt;/tns1:Update>&lt;/tns1:DataIn>&lt;tns1:LogElement>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;/tns1:LogElement>&lt;/tns1:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
