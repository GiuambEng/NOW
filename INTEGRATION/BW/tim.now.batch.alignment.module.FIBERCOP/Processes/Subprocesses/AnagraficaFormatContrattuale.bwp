                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.example.org/ContenutoRecdAnagraficaFormatContrattuale&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/AnagraficaFormatContrattuale&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoVal&quot;/>&#xa;    &lt;xsl:template name=&quot;ContenutoRecdAnagraficaFormatContrattuale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:InputAnagraficaFormatContrattuale_ContenutoRecord>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns5:AnagraficaFormatContrattuale)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns5:AnagraficaFormatContrattuale&quot;>&#xa;                        &lt;tns10:ContenutoRecordAnagraficaFormatContrattuale_input>&#xa;                            &lt;xsl:if test=&quot;tns5:OAO&quot;>&#xa;                                &lt;tns10:OAO>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:OAO&quot;/>&#xa;                                &lt;/tns10:OAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:AreaDiCentrale&quot;>&#xa;                                &lt;tns10:AreaDiCentrale>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:AreaDiCentrale&quot;/>&#xa;                                &lt;/tns10:AreaDiCentrale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:CodiceImpresa&quot;>&#xa;                                &lt;tns10:CodiceImpresa>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:CodiceImpresa&quot;/>&#xa;                                &lt;/tns10:CodiceImpresa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DescrizioneTipologiaImpresa&quot;>&#xa;                                &lt;tns10:DescrizioneTipologiaImpresa>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DescrizioneTipologiaImpresa&quot;/>&#xa;                                &lt;/tns10:DescrizioneTipologiaImpresa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:GestAutonPA&quot;>&#xa;                                &lt;tns10:GestAutonPA>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:GestAutonPA&quot;/>&#xa;                                &lt;/tns10:GestAutonPA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DataInizioValiditaProvisioning&quot;>&#xa;                                &lt;tns10:DataInizioValiditaProvisioning>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DataInizioValiditaProvisioning&quot;/>&#xa;                                &lt;/tns10:DataInizioValiditaProvisioning>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DataFineValiditaProvisioning&quot;>&#xa;                                &lt;tns10:DataFineValiditaProvisioning>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DataFineValiditaProvisioning&quot;/>&#xa;                                &lt;/tns10:DataFineValiditaProvisioning>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DataInizioValiditaAssurance&quot;>&#xa;                                &lt;tns10:DataInizioValiditaAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DataInizioValiditaAssurance&quot;/>&#xa;                                &lt;/tns10:DataInizioValiditaAssurance>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DataFineValiditaAssurance&quot;>&#xa;                                &lt;tns10:DataFineValiditaAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DataFineValiditaAssurance&quot;/>&#xa;                                &lt;/tns10:DataFineValiditaAssurance>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:FlagValidita&quot;>&#xa;                                &lt;tns10:FlagValidita>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:FlagValidita&quot;/>&#xa;                                &lt;/tns10:FlagValidita>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns10:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;/tns10:NumeroRecord>&#xa;                        &lt;/tns10:ContenutoRecordAnagraficaFormatContrattuale_input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns5:AnagraficaFormatContrattuale&quot;>&#xa;                        &lt;tns10:ContenutoRecordAnagraficaFormatContrattuale_input>&#xa;                            &lt;xsl:if test=&quot;tns5:OAO&quot;>&#xa;                                &lt;tns10:OAO>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:OAO&quot;/>&#xa;                                &lt;/tns10:OAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:AreaDiCentrale&quot;>&#xa;                                &lt;tns10:AreaDiCentrale>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:AreaDiCentrale&quot;/>&#xa;                                &lt;/tns10:AreaDiCentrale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:CodiceImpresa&quot;>&#xa;                                &lt;tns10:CodiceImpresa>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:CodiceImpresa&quot;/>&#xa;                                &lt;/tns10:CodiceImpresa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DescrizioneTipologiaImpresa&quot;>&#xa;                                &lt;tns10:DescrizioneTipologiaImpresa>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DescrizioneTipologiaImpresa&quot;/>&#xa;                                &lt;/tns10:DescrizioneTipologiaImpresa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:GestAutonPA&quot;>&#xa;                                &lt;tns10:GestAutonPA>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:GestAutonPA&quot;/>&#xa;                                &lt;/tns10:GestAutonPA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DataInizioValiditaProvisioning&quot;>&#xa;                                &lt;tns10:DataInizioValiditaProvisioning>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DataInizioValiditaProvisioning&quot;/>&#xa;                                &lt;/tns10:DataInizioValiditaProvisioning>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DataFineValiditaProvisioning&quot;>&#xa;                                &lt;tns10:DataFineValiditaProvisioning>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DataFineValiditaProvisioning&quot;/>&#xa;                                &lt;/tns10:DataFineValiditaProvisioning>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DataInizioValiditaAssurance&quot;>&#xa;                                &lt;tns10:DataInizioValiditaAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DataInizioValiditaAssurance&quot;/>&#xa;                                &lt;/tns10:DataInizioValiditaAssurance>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:DataFineValiditaAssurance&quot;>&#xa;                                &lt;tns10:DataFineValiditaAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:DataFineValiditaAssurance&quot;/>&#xa;                                &lt;/tns10:DataFineValiditaAssurance>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns5:FlagValidita&quot;>&#xa;                                &lt;tns10:FlagValidita>&#xa;                                    &lt;xsl:value-of select=&quot;tns5:FlagValidita&quot;/>&#xa;                                &lt;/tns10:FlagValidita>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns10:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;/tns10:NumeroRecord>&#xa;                        &lt;/tns10:ContenutoRecordAnagraficaFormatContrattuale_input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns10:InputAnagraficaFormatContrattuale_ContenutoRecord>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.ContenutoRecord.ContenutoRecdAnagraficaFormatContrattuale" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
