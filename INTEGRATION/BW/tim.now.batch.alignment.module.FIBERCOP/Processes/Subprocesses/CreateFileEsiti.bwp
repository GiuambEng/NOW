                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="Logger"/&gt;
    &lt;xsl:template name="UpdateLogger-input" match="/"&gt;
        &lt;tns4:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns:Input&gt;
                    &lt;ns:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;
                    &lt;/ns:TipologiaProcesso&gt;
                    &lt;ns:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                    &lt;/ns:TipologiaOperazione&gt;
                    &lt;ns:FileProcessato&gt;
                        &lt;ns:DESCR_STATO_FILE&gt;
                            &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                        &lt;/ns:DESCR_STATO_FILE&gt;
                        &lt;ns:ESITO&gt;
                            &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                        &lt;/ns:ESITO&gt;
                        &lt;ns:ID_ESEC_PROCSO_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer($Logger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)"/&gt;
                        &lt;/ns:ID_ESEC_PROCSO_FILE&gt;
                        &lt;ns:ID_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer($Logger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;
                        &lt;/ns:ID_FILE&gt;
                        &lt;ns:TIMSTP_CHIUSURA_FILE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns:TIMSTP_CHIUSURA_FILE&gt;
                        &lt;ns:VERSO_DEL_FILE&gt;
                            &lt;xsl:value-of select="&amp;quot;OUTPUT&amp;quot;"/&gt;
                        &lt;/ns:VERSO_DEL_FILE&gt;
                    &lt;/ns:FileProcessato&gt;
                    &lt;ns:EsecuzioneFile&gt;
                        &lt;ns:ID_ESEC_PROCSO_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer($Logger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)"/&gt;
                        &lt;/ns:ID_ESEC_PROCSO_FILE&gt;
                        &lt;ns:STATO_ESEC&gt;
                            &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                        &lt;/ns:STATO_ESEC&gt;
                        &lt;ns:TMSP_FINE_ELAB&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns:TMSP_FINE_ELAB&gt;
                    &lt;/ns:EsecuzioneFile&gt;
                    &lt;ns:FileProcessatoOutput&gt;
                        &lt;ns:ID_FILE_PROCSTO_OUTPUT&gt;
                            &lt;xsl:value-of select="xsd:integer($Logger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;
                        &lt;/ns:ID_FILE_PROCSTO_OUTPUT&gt;
                    &lt;/ns:FileProcessatoOutput&gt;
                &lt;/ns:Input&gt;
            &lt;/part1&gt;
        &lt;/tns4:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Logger.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;ns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Logger.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;ns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Logger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE>&#xa;                &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;ns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OUTPUT&amp;quot;&quot;/>&#xa;   