            <bpws:invoke inputVariable="SpostaFile-input"
                name="SpostaFile" operation="SftGetJavaCodeOperation"
                outputVariable="SpostaFile" partnerLink="SFTP_Get"
                portType="ns13:SFTPGetJavaCode" tibex:xpdlId="663bea94-1214-4a6f-8139-8d849c44a5da">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns7="http://www.tim.com/NOW/wsdl/abstract/SFTPGetJavaCode/" xmlns:tns11="http://www.tim.com/NOW/xsd/SFTP_GetJavaCode" version="2.0"&gt;
    &lt;xsl:param name="SSHHost"/&gt;
    &lt;xsl:param name="SSHUser"/&gt;
    &lt;xsl:param name="SSHPort"/&gt;
    &lt;xsl:param name="SSHPassword"/&gt;
    &lt;xsl:param name="FileNameElabOK"/&gt;
    &lt;xsl:param name="PathRoot"/&gt;
    &lt;xsl:param name="LocalPath"/&gt;
    &lt;xsl:template name="SpostaFile-input" match="/"&gt;
        &lt;tns7:SftGetJavaCodeOperationRequest&gt;
            &lt;SftpGetInput&gt;
                &lt;tns11:SFTP_GetJavaCodeInput&gt;
                    &lt;tns11:RemoteFile&gt;
                        &lt;xsl:value-of select="concat($PathRoot,'/Files/',$FileNameElabOK)"/&gt;
                    &lt;/tns11:RemoteFile&gt;
                    &lt;tns11:LocalFile&gt;
                        &lt;xsl:value-of select="concat($LocalPath,$FileNameElabOK)"/&gt;
                    &lt;/tns11:LocalFile&gt;
                    &lt;tns11:credenziali&gt;
                        &lt;tns11:Host&gt;
                            &lt;xsl:value-of select="$SSHHost"/&gt;
                        &lt;/tns11:Host&gt;
                        &lt;tns11:Port&gt;
                            &lt;xsl:value-of select="$SSHPort"/&gt;
                        &lt;/tns11:Port&gt;
                        &lt;tns11:Password&gt;
                            &lt;xsl:value-of select="$SSHPassword"/&gt;
                        &lt;/tns11:Password&gt;
                        &lt;tns11:User&gt;
                            &lt;xsl:value-of select="$SSHUser"/&gt;
                        &lt;/tns11:User&gt;
                    &lt;/tns11:credenziali&gt;
                &lt;/tns11:SFTP_GetJavaCodeInput&gt;
            &lt;/SftpGetInput&gt;
        &lt;/tns7:SftGetJavaCodeOperationRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/wsdl/abstract/SFTPGetJavaCode/&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/xsd/SFTP_GetJavaCode&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SSHHost&quot;/>&#xa;    &lt;xsl:param name=&quot;SSHUser&quot;/>&#xa;    &lt;xsl:param name=&quot;SSHPort&quot;/>&#xa;    &lt;xsl:param name=&quot;SSHPassword&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameElabOK&quot;/>&#xa;    &lt;xsl:param name=&quot;PathRoot&quot;/>&#xa;    &lt;xsl:param name=&quot;LocalPath&quot;/>&#xa;    &lt;xsl:template name=&quot;SpostaFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns11:SFTP_GetJavaCodeInput>&#xa;            &lt;tns11:RemoteFile>&#xa;                &lt;xsl:value-of select=&quot;concat($PathRoot,'/Files/',$FileNameElabOK)&quot;/>&#xa;            &lt;/tns11:RemoteFile>&#xa;            &lt;tns11:LocalFile>&#xa;                &lt;xsl:value-of select=&quot;concat($LocalPath,$FileNameElabOK)&quot;/>&#xa;            &lt;/tns11:LocalFile>&#xa;            &lt;tns11:credenziali>&#xa;                &lt;tns11:Host>&#xa;                    &lt;xsl:value-of select=&quot;$SSHHost&quot;/>&#xa;                &lt;/tns11:Host>&#xa;                &lt;tns11:Port>&#xa;                    &lt;xsl:value-of select=&quot;$SSHPort&quot;/>&#xa;                &lt;/tns11:Port>&#xa;                &lt;tns11:Password>&#xa;                    &lt;xsl:value-of select=&quot;$SSHPassword&quot;/>&#xa;                &lt;/tns11:Password>&#xa;                &lt;tns11:User>&#xa;                    &lt;xsl:value-of select=&quot;$SSHUser&quot;/>&#xa;                &lt;/tns11:User>&#xa;            &lt;/tns11:credenziali>&#xa;        &lt;/tns11:SFTP_GetJavaCodeInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:subla