<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/AllineamentoVLANretail" xmlns:tns="http://www.tim.com/NOW/xsd/AllineamentoVLANretail" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="AllineamentoVLANretail">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0"	ref="tns:AllineamentoVLANretail_Dettaglio"/>
			</sequence>
		</complexType>
	</element>
	<element name="AllineamentoVLANretail_Dettaglio">
		<complexType>
			<sequence>
				<element name="IDVLAN" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="100" />
						</restriction>
					</simpleType>
				</element>
				<element name="OLO_CODING" maxOccurs="1"
					minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="3" />
							<enumeration value="TLC"></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element name="OLO_CODE" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="3" />
							<enumeration value="002" />
						</restriction>
					</simpleType>
				</element>
				<element name="STATO" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="30" />
							<enumeration value="ACTIVE" />
							<enumeration value="INACTIVE" />
						</restriction>
					</simpleType>
				</element>
				<element name="INTERMEDIATE_AGENT" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"></maxLength>
							<enumeration value="SI"></enumeration>
							<enumeration value="NO"></enumeration>
							<enumeration value=""></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element name="CUSTOMER_RETE" maxOccurs="1"
					minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="4"></maxLength>
							<enumeration value="TLCI"></enumeration>
							<enumeration value="CSPA"></enumeration>
							<enumeration value=""></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element name="CLLI" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="10" />
						</restriction>
					</simpleType>
				</element>
				<element name="NOME_CENTRALE" maxOccurs="1"
					minOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="255" />
						</restriction>
					</simpleType>
				</element>
				<element name="DEC_ATT" type="date" maxOccurs="1"
					minOccurs="1" />
				<element name="DEC" type="date" maxOccurs="1"
					minOccurs="1" />
				<element name="Timestamp" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="FlagValidita" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="ID_FILE" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Numero_record" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
			</sequence>
		</complexType>
	</element>
</schema>