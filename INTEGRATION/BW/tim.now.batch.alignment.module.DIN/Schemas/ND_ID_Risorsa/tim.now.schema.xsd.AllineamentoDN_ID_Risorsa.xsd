<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/tim.now.schema.xsd.AllineamentoDN_ID_Risorsa" xmlns:tns="http://www.example.org/tim.now.schema.xsd.AllineamentoDN_ID_Risorsa" elementFormDefault="qualified">
<element name="AllineamentoDN_IDRisorsa">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0"	ref="tns:AllineamentoDN_IDRisorsa_Dettaglio"/>
			</sequence>
		</complexType>
	</element>
	<element name="AllineamentoDN_IDRisorsa_Dettaglio">
		<complexType>
			<sequence>

				<element name="Distretto" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"></minLength>
							<maxLength value="3"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="ID_RISORSA" maxOccurs="1"
					minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"></minLength>
							<maxLength value="13"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="ORDER_NUM" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<minLength value="1"></minLength>
							<maxLength value="13"></maxLength>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>