                                </sequence>
                            </complexType>
                        </element>
                        <element maxOccurs="1" minOccurs="0"
                            name="ServerTimeZone" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="timeout" type="long"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="maxRows" type="long"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+480d78ab-def9-4148-9103-11eaa9771f78+output"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+480d78ab-def9-4148-9103-11eaa9771f78+output">
            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="1" minOccurs="0" name="outputSet">
                            <complexType>
                                <sequence/>
                            </complexType>
                        </element>
                        <element maxOccurs="1" minOccurs="0"
                            name="UnresolvedResultsets" type="string"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+09753b70-dd72-4979-83a3-445f2cbb14e5+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+09753b70-dd72-4979-83a3-445f2cbb14e5+input">
            <element name="jdbcUpdateActivityInput">
                <complexType>
                    <sequence>
                        <element maxOccurs="1" minOccurs="1"
                            name="ID_FILE" nillable="true" type="int"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="SISTEMA" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="FLUSSO" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="DETAILS" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="DESCR_ERRORE" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="STATO" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="ID_ESEC_PROCSO_FILE" nillable="true" type="int"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="ServerTimeZone" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="timeout" type="long"/>
