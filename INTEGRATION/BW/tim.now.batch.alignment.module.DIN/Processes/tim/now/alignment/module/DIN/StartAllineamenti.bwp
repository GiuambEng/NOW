                            <bpws:invoke
                                inputVariable="ContaRecord-input"
                                name="ContaRecord"
                                operation="ContaRecord"
                                partnerLink="Conta" portType="ns6:Conta" tibex:xpdlId="e5ad18d4-c004-4c9c-ada0-1f7b9219f019">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/" xmlns:ns="http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/" xmlns:tns1="http://www.example.org/VerificaLavorabilita" xmlns:tns2="http://www.example.org/CreateFileID" version="2.0"&gt;&lt;xsl:param name="Tipo_Separatore"/&gt;&lt;xsl:param name="VerificaLavorabilita"/&gt;&lt;xsl:param name="CreateIDFile"/&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="getDINFlow"/&gt;&lt;xsl:template name="ContaRecord-input" match="/"&gt;&lt;tns:Conta_Request&gt;&lt;part1&gt;&lt;ns:contaRecord_Input&gt;&lt;xsl:variable name="varNome" select="if ($getDINFlow/Record[number($index)]/FLOW='Anagrafica VLAN Retail') then 'allineamento.vlanRetail.din' else 'allineamento.DNIDRisorsa.din'"/&gt;&lt;ns:in&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:SOURCE_FILE"/&gt;&lt;/ns:in&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$getDINFlow/Record[number($index)]/FLOW='Anagrafica VLAN Retail'"&gt;&lt;ns:TipoSeparatore&gt;&lt;xsl:value-of select="$Tipo_Separatore"/&gt;&lt;/ns:TipoSeparatore&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:TipoSeparatore&gt;&lt;xsl:value-of select="&amp;quot;POSIZIONALE&amp;quot;"/&gt;&lt;/ns:TipoSeparatore&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$CreateIDFile/tns2:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$CreateIDFile/tns2:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:SOURCE_FILE"&gt;&lt;ns:FULLNAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:SOURCE_FILE"/&gt;&lt;/ns:FULLNAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:NOME_FILE"&gt;&lt;ns:FILENAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:NOME_FILE"/&gt;&lt;/ns:FILENAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateIDFile/tns2:ID_ESEC"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$CreateIDFile/tns2:ID_ESEC"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateIDFile/tns2:COD_PROCSO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$CreateIDFile/tns2:COD_PROCSO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:ID_TRACK"&gt;&lt;ns:ID_TRACK&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:ID_TRACK"/&gt;&lt;/ns:ID_TRACK&gt;&lt;/xsl:if&gt;&lt;ns:NomeProcesso&gt;&lt;xsl:value-of select="$varNome"/&gt;&lt;/ns:NomeProcesso&gt;&lt;/ns:contaRecord_Input&gt;&lt;/part1&gt;&lt;/tns:Conta_Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns2=&quot;http://www.example.org/CreateFileID&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Tipo_Separatore&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateIDFile&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;getDINFlow&quot;/>&#xa;    &lt;xsl:template name=&quot;ContaRecord-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:contaRecord_Input>&#xa;            &lt;xsl:variable name=&quot;varNome&quot; select=&quot;if ($getDINFlow/Record[number($index)]/FLOW='Anagrafica VLAN Retail') then 'allineamento.vlanRetail.din' else 'allineamento.DNIDRisorsa.din'&quot;/>&#xa;            &lt;ns:in>&#xa;                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;/>&#xa;            &lt;/ns:in>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$getDINFlow/Record[number($index)]/FLOW='Anagrafica VLAN Retail'&quot;>&#xa;                    &lt;ns:TipoSeparatore>&#xa;                        &lt;xsl:value-of select=&quot;$Tipo_Separatore&quot;/>&#xa;                    &lt;/ns:TipoSeparatore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:TipoSeparatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;POSIZIONALE&amp;quot;&quot;/>&#xa;                    &lt;/ns:TipoSeparatore>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$CreateIDFile/tns2:ID_FILE&quot;>&#xa;                &lt;ns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$CreateIDFile/tns2:ID_FILE&quot;/>&#xa;                &lt;/ns:ID_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;>&#xa;                &lt;ns:FULLNAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;/>&#xa;                &lt;/ns:FULLNAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;>&#xa;                &lt;ns:FILENAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;/>&#xa;                &lt;/ns:FILENAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$CreateIDFile/tns2:ID_ESEC&quot;>&#xa;                &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$CreateIDFile/tns2:ID_ESEC&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$CreateIDFile/tns2:COD_PROCSO_FILE&quot;>&#xa;                &lt;ns:COD_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$CreateIDFile/tns2:COD_PROCSO_FILE&quot;/>&#xa;                &lt;/ns:COD_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&#xa;                &lt;ns:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;/>&#xa;                &lt;/ns:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:NomeProcesso>&#xa;                &lt;xsl:value-of select=&quot;$varNome&quot;/>&#xa;            &lt;/ns:NomeProcesso>&#xa;        &lt;/ns:contaRecord_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CreateIDFileToContaRecord"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ContaRecordToGroupEnd"/>
                                </bpws:sources>
                            </bpws:invoke>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:forEach>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="25e9028c-065a-48e2-83de-9a8ee865f18a">
                <bpws:targets>
                    <bpws:target linkName="IterateToExit"/>
                    <bpws:target linkName="getDINFlowToExit"/>
