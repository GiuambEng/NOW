                                <bpws:link
                                    name="VerificaLavorabilitaToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
