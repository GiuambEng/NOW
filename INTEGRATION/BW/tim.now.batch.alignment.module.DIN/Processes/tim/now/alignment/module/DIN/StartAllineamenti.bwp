                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CodIntfc_VlanRetail&quot;/>&lt;xsl:param name=&quot;CodIntfc_DNIDRis&quot;/>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;getDINFlow&quot;/>&lt;xsl:template name=&quot;CreateIDFile-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:DataIn>&lt;tns:Insert>&lt;tns:InputFile>&lt;xsl:variable name=&quot;varCodIntrfc&quot; select=&quot;if ($getDINFlow/Record[number($index)]/FLOW='Anagrafica VLAN Retail') then $CodIntfc_VlanRetail else $CodIntfc_DNIDRis&quot;/>&lt;tns:CODICE_INTERFACCIA>&lt;xsl:value-of select=&quot;$varCodIntrfc&quot;/>&lt;/tns:CODICE_INTERFACCIA>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;>&lt;tns:NOME_FILE>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;/>&lt;/tns:NOME_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:DATA_FILE&quot;>&lt;tns:DATA_FILE>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:DATA_FILE&quot;/>&lt;/tns:DATA_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:FILE_SIZE&quot;>&lt;tns:SIZE>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:FILE_SIZE&quot;/>&lt;/tns:SIZE>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;/>&lt;/tns:ID_TRACK>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;>&lt;tns:FULL_NAME>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;/>&lt;/tns:FULL_NAME>&lt;/xsl:if>&lt;tns:FLAG_CONTENUTO_FILE>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:FLAG_CONTENUTO_FILE>&lt;/tns:InputFile>&lt;/tns:Insert>&lt;/tns:DataIn>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
