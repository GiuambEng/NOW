                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns1=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;PathError&quot;/>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:template name=&quot;MovedError-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;>&lt;tns1:FullPathOrigine>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;/>&lt;/tns1:FullPathOrigine>&lt;/xsl:if>&lt;tns1:FolderDestinazione>&lt;xsl:value-of select=&quot;$PathError&quot;/>&lt;/tns1:FolderDestinazione>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;>&lt;tns1:NomeFile>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;/>&lt;/tns1:NomeFile>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;>&lt;tns1:ID_TRACK>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;/>&lt;/tns1:ID_TRACK>&lt;/xsl:if>&lt;tns1:LogInput>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LogName>&lt;/tns1:LogInput>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
