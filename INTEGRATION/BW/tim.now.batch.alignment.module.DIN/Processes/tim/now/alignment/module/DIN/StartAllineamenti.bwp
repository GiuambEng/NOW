                                <bpws:targets>
                                    <bpws:target linkName="VerificaLavorabilitaToGroupEnd"/>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                    <bpws:target linkName="ContaRecordToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;getDINFlow&quot;/>&lt;xsl:template name=&quot;VerificaLavorabilita-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;xsl:if test=&quot;$getDINFlow/Record[number($index)]/FLOW&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$getDINFlow/Record[number($index)]/FLOW&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;tns:ID_FLOW>&lt;xsl:value-of select=&quot;xsd:int($getDINFlow/Record[number($index)]/ID_FLOW)&quot;/>&lt;/tns:ID_FLOW>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
