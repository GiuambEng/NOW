                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/SFTPGetJavaCode/" xmlns:tns1="http://www.tim.com/NOW/xsd/SFTP_GetJavaCode" version="2.0"&gt;&lt;xsl:param name="PathFileNPW"/&gt;&lt;xsl:param name="HostNPW"/&gt;&lt;xsl:param name="UserNPW"/&gt;&lt;xsl:param name="PasswordNPW"/&gt;&lt;xsl:param name="PortNPW"/&gt;&lt;xsl:param name="PathFileNPWtoNOW"/&gt;&lt;xsl:param name="FileNameSenzaTappo"/&gt;&lt;xsl:template name="SFTP_GET_NPW-input" match="/"&gt;&lt;tns:SftGetJavaCodeOperationRequest&gt;&lt;SftpGetInput&gt;&lt;tns1:SFTP_GetJavaCodeInput&gt;&lt;tns1:RemoteFile&gt;&lt;xsl:value-of select="concat($PathFileNPW,$FileNameSenzaTappo)"/&gt;&lt;/tns1:RemoteFile&gt;&lt;tns1:LocalFile&gt;&lt;xsl:value-of select="concat($PathFileNPWtoNOW,$FileNameSenzaTappo)"/&gt;&lt;/tns1:LocalFile&gt;&lt;tns1:credenziali&gt;&lt;tns1:Host&gt;&lt;xsl:value-of select="$HostNPW"/&gt;&lt;/tns1:Host&gt;&lt;tns1:Port&gt;&lt;xsl:value-of select="$PortNPW"/&gt;&lt;/tns1:Port&gt;&lt;tns1:Password&gt;&lt;xsl:value-of select="$PasswordNPW"/&gt;&lt;/tns1:Password&gt;&lt;tns1:User&gt;&lt;xsl:value-of select="$UserNPW"/&gt;&lt;/tns1:User&gt;&lt;/tns1:credenziali&gt;&lt;/tns1:SFTP_GetJavaCodeInput&gt;&lt;/SftpGetInput&gt;&lt;/tns:SftGetJavaCodeOperationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
