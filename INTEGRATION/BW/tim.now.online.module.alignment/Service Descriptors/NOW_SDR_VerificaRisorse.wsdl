<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:ns="http://www.tim.com/NOW/xsd/NOW_SDR/" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NOW_SDR_VerificaRisorsa" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/wsdl/abstract/NOW_SDR_VerificaRisorsa">
	<import namespace="http://www.tim.com/NOW/xsd/NOW_SDR/" location="../../tim.now.shared_library/Schemas/AllineamentiOnLine/tim.now.allineamentionline.SDR.xsd" />
	<import namespace="http://telecomitalia.it/SOA/SOAP/SOAPHeader" location="../../tim.now.shared_library/Schemas/CommonSchema/SOAPHeader_v1.1.xsd" />
	<message name="Request">
		<part element="ns:Request" name="input"/>
		<part element="h:Header" name="header"/>
	</message>
	<message name="Response">
		<part element="ns:Response" name="output"/>
		<part element="h:Header" name="header"/>
	</message>
	<message name="Fault">
		<part element="ns:Fault" name="fault"/>
	</message>
	<portType name="VerificaRisorsa">
		<operation name="Invoke">
			<input message="tns:Request"/>
			<output message="tns:Response"/>
			<fault message="tns:Fault" name="fault"/>
		</operation>
	</portType>
</definitions>
