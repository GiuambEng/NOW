<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/tim.now.schema.xsd.stagSendIdullco" xmlns:tns="http://www.example.org/tim.now.schema.xsd.stagSendIdullco" elementFormDefault="qualified">
<element name="INPUT">
		<complexType>
			<choice>
				<element name="Insert">
					<complexType>
						<sequence>
							<element name="TRANSACTION_ID" type="string" minOccurs="0"/>
							<element name="CONTENUTO_REQUEST" type="string"/>
							<element name="TRANSACTION_DATE" type="string"/>
							<element name="DATA_ATTIVAZIONE" type="string" minOccurs="0"/>
							<element name="SYS_ORIG" type="string"/>
							<element name="ID_PROCSO_NO_FILE" type="integer"/>
							<element name="ID_RICH" type="integer"/>
							<element name="ID_STATO_ELAB_STAG" type="integer"/>
							<element name="TIMSTP_RICH" type="string"/>
							<element name="IDULLCO" type="string"/>
							<element name="OPERATORE" type="string"/>
							<element name="CLLI" type="string"/>
							<element name="DATA_CONSEGNA_OLO" type="string"/>
							<element name="DATA_FINE_VALIDITA" type="string" />
							<element name="DATA_INVIO" type="string" />
							<element name="NOME" type="string" />
							<element name="DRCP" type="string"  minOccurs="0"/>
							<element name="COD_GAT" type="string" />	
						</sequence>
					</complexType>
				</element>
				<element name="Update">
					<complexType>
						<sequence>
							<element name="CONTENUTO_RESPONSE" type="string"/>
							<element name="TIMSTP_RISPOSTA" type="string"/>
							<element name="ID_STATO_ELAB_STAG" type="integer"/>
							<element name="ID_PROCSO_NO_FILE" type="integer"/>
						</sequence>
					</complexType>
				</element>
				<element name="UpdateOnError">
					<complexType>
						<sequence>
							<element name="DESCR_ERRORE" type="string"/>
							<element name="TIMSTP_RISPOSTA" type="string"/>
							<element name="ID_STATO_ELAB_STAG" type="integer"/>
							<element name="ID_PROCSO_NO_FILE" type="integer"/>
						</sequence>
					</complexType>
				</element>
			</choice>
		</complexType>
	</element>
</schema>
