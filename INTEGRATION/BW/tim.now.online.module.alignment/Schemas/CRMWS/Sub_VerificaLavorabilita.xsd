<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
xmlns:tns="http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_ID_RISORSA/" 
elementFormDefault="qualified" 
targetNamespace="http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_ID_RISORSA/">
    <element name="NOW_CheckLavorabilita_Idrisorsa_Input">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="ID_RISORSA">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"/>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="NOW_CheckLavorabilita_Idrisorsa_Out">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="Return_Code">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="2"/>
    						<enumeration value="00"/>
    						<enumeration value="01"/>
    						<enumeration value="02"/>
    						<enumeration value="03"/>
    						<enumeration value="04"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="Descrizione_errore">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="150"/>
    						<enumeration value="ORDINE IN CORSO"/>
    						<enumeration value="RISORSA CESSATA"/>
    						<enumeration value="RISORSA NON PRESENTE"/>
    						<enumeration value="ERRORE GENERICO"/>
    						<enumeration value="RISORSA LAVORABILE"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="ID_ORDINE">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"/>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>
