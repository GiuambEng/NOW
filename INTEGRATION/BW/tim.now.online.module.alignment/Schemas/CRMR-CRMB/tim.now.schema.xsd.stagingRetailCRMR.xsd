<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/tim.now.schema.xsd.stagingRetailCRMR" xmlns:tns="http://www.example.org/tim.now.schema.xsd.stagingRetailCRMR" elementFormDefault="qualified">

 <element name="INPUT">
		<complexType>
			<choice>
				<element name="Insert">
					<complexType>
						<sequence>
							<element name="CONTENUTO_REQUEST"
								type="string" />
							<element name="ID_PROCSO_NO_FILE"
								type="integer" />
							<element name="ID_RICH" type="integer" />
							<element name="ID_STATO_ELAB_STAG"
								type="integer" />
							<element name="TIMSTP_RICH" type="string" />
							<element name="CRM_ORIGINE" type="string"></element>
							<element name="TELEFONICO" type="string"></element>
							<element name="ID_RISORSA" type="string" maxOccurs="1" minOccurs="0"></element>
						</sequence>
					</complexType>
				</element>
				<element name="Update">
					<complexType>
						<sequence>
							<element name="CONTENUTO_RESPONSE" type="string"/>
							<element name="TIMSTP_RISPOSTA" type="string"/>
							<element name="ID_STATO_ELAB_STAG" type="integer"/>
							<element name="ID_PROCSO_NO_FILE" type="integer"/>
						</sequence>
					</complexType>
				</element>
				<element name="UpdateOnError">
					<complexType>
						<sequence>
							<element name="DESCR_ERRORE" type="string"/>
							<element name="ID_STATO_ELAB_STAG" type="integer"/>
							<element name="ID_PROCSO_NO_FILE" type="integer"/>
							<element name="TIMSTP_RISPOSTA" type="string"/>
						</sequence>
					</complexType>
				</element>
			</choice>
		</complexType>
	</element>
</schema>