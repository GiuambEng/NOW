<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/tim.now.schema.GetInfo" xmlns:tns="http://www.example.org/tim.now.schema.GetInfo" elementFormDefault="qualified">
	<element name="GetInfo">
		<complexType>
			<sequence>
				<element name="Input">
					<complexType>
						<sequence>

							<element minOccurs="0"
								ref="tns:Input_GetInfo">
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="Out">
					<complexType>
						<sequence>

							<element minOccurs="0"
								ref="tns:Out_GetInfo">
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>




	<element name="Input_GetInfo">
		<complexType>
			<sequence>
				<element name="ID_RISORSA" minOccurs="0" type="string" maxOccurs="1"></element>
				<element  name="COD_TOPO" minOccurs="0" type="string" maxOccurs="1"></element>
				<element  name="IDRICHIESTA_OLO" minOccurs="0" type="string" maxOccurs="1"></element>
				<element  name="OFFERTA" minOccurs="0" type="string" maxOccurs="1"></element>
			</sequence>
		</complexType>
	</element>
	<element name="Out_GetInfo">
		<complexType>
			<sequence>
				<element minOccurs="0" name="CAP" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="COD_ISTAT_PROV" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="COD_ISTAT_COMUNE" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="NUMERO_CIVICO" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="DESCR_PROV" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="DESCR_PARTICELLA_TOPON" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="DESCR_VIA" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="OFFERTA" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="IDRICHIESTAOLO" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="NOMEREFERENTE" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="COGNOMEREFERENTE" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="TELEFONOMOBILEREFERENTE" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="TELEFONOFISSOREFERENTE" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="QUALIFICAREFERENTE" type="string" maxOccurs="1"></element>
				<element minOccurs="0" name="TIPOREFERENTEORDINE" type="string" maxOccurs="1"></element>
			</sequence>
		</complexType>
	</element>
</schema>