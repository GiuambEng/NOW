<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
targetNamespace="www.tim.now.stagingVerificaIdRisorsaMetroweb"
xmlns="www.tim.now.stagingVerificaIdRisorsaMetroweb"
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
	<xs:element name="Input">
		<xs:complexType>
			<xs:choice>
				<xs:element name="Insert">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="IdRichiestaOlo" type="xs:string"
								minOccurs="0" />
							<xs:element name="IdRisorsa" type="xs:string"
								minOccurs="0" />
							<xs:element name="ContenutoRequest"
								type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="TimestampRichiesta"
								type="xs:dateTime" />
							<xs:element name="IdEsecProcsoNoFile"
								type="xs:integer" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Update">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ContenutoResponse"
								type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="DescrizioneErrore"
								type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="IdEsecProcsoNoFile"
								type="xs:integer" />
							<xs:element name="TimestampRisposta"
								type="xs:dateTime" />
							<xs:element name="Esito"
								type="xs:string" />
							<xs:element name="Codice"
								type="xs:string" />
							<xs:element name="ReturnCode"
								type="xs:string" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="UpdateOnError">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="DescrizioneErrore"
								type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="IdEsecProcsoNoFile"
								type="xs:integer" />
							<xs:element name="TimestampRisposta"
								type="xs:dateTime" />
							<xs:element name="ReturnCode"
								type="xs:string" />
							<xs:element name="Esito"
								type="xs:string" />
							<xs:element name="Codice"
								type="xs:string" />		
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>
</xs:schema>
