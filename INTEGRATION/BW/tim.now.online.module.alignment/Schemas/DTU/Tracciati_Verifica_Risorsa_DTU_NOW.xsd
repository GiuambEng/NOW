<?xml version="1.0" encoding="UTF-8"?>
<!-- Prima emissione per servizio verifica Idrisorsa Metroweb-->
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/Tracciati_Verifica_Risorsa_DTU_NOW/" targetNamespace="http://www.tim.com/NOW/xsd/Tracciati_Verifica_Risorsa_DTU_NOW/" elementFormDefault="qualified">
	<element name="Request">
		<complexType>
			<sequence>
				<element name="ID_RICHIESTA" minOccurs="1" maxOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="31"/>
						</restriction>
					</simpleType>
				</element>
				<element name="ID_SO" minOccurs="1" maxOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="24"/>
						</restriction>
					</simpleType>
				</element>
				<element name="ID_ODR" minOccurs="1" maxOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="15"/>
						</restriction>
					</simpleType>
				</element>
				<element name="TIMESTAMP_RICHIESTA_DTU" type="dateTime"/>
			</sequence>
		</complexType>
	</element>
	<element name="Response">
		<complexType>
			<sequence>
				<element name="ID_SO" minOccurs="1" maxOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="24"/>
						</restriction>
					</simpleType>
				</element>
				<element name="ESITO" minOccurs="1" maxOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CODICE" minOccurs="0" maxOccurs="1">
					<annotation>
						<documentation>000  Risorsa non trovata      001  Risorsa trotvata           002  Errore interno  </documentation>
					</annotation>
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DESCRIZIONE" minOccurs="0" maxOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="255"/>
						</restriction>
					</simpleType>
				</element>
				<element name="TIMESTAMP_RISPOSTA_NOW" type="dateTime"/>
			</sequence>
		</complexType>
	</element>
	<element name="Fault">
		<complexType>
			<sequence>
				<element name="RETURN_CODE" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="DESCRIZIONE" type="string" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
</schema>
