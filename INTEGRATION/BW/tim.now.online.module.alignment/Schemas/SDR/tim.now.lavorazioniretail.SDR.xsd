<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_SDR_LAV_RETAIL/" targetNamespace="http://www.tim.com/NOW/xsd/NOW_SDR_LAV_RETAIL/" elementFormDefault="qualified">
	<element name="Request">
		<complexType>
			<sequence>
				<element name="TESTATA">
					<complexType>
						<sequence>
							<element name="TIMESTAMP" type="dateTime"/>
							<element name="DATA_INVIO_RICHIESTA_SDR">
								<simpleType>
									<restriction base="string">
										<maxLength value="10"/>
										<minLength value="10"/>
										<pattern value="\d{4}-\d{2}-\d{2}"/>
									</restriction>
								</simpleType>
							</element>
							<element name="CODICE_ORDINE_SDR">
								<simpleType>
									<restriction base="string">
										<maxLength value="11" />
									</restriction>
								</simpleType>
							</element>
							<element name="SISTEMA_SORGENTE">
								<simpleType>
									<restriction base="string">
										<maxLength value="8"/>
									</restriction>
								</simpleType>
							</element>
							<element name="LAVORAZIONE">
								<simpleType>
									<restriction base="string">
										<maxLength value="15"/>
										<enumeration value="CESSAZIONE_CPS"/>
										<enumeration value="SPOSTAMENTO_CPS"/>
									</restriction>
								</simpleType>
							</element>
							<element name="SOTTO_LAVORAZIONE">
								<simpleType>
									<restriction base="string">
										<maxLength value="02"/>
										<enumeration value="01"/>
										<enumeration value="02"/>
										<enumeration value="03"/>
										<enumeration value="04"/>
										<enumeration value="05"/>
										<enumeration value="06"/>
										<enumeration value="07"/>
										<enumeration value="08"/>
									</restriction>
								</simpleType>
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="CPS">
					<complexType>
						<sequence>
							<element name="DN">
								<simpleType>
									<restriction base="string">
										<maxLength value="12"/>
										<minLength value="1"/>
									</restriction>
								</simpleType>
							</element>
							<element name="DN_OLD" minOccurs="0">
								<simpleType>
									<restriction base="string">
										<maxLength value="12"/>
										<minLength value="1"/>
									</restriction>
								</simpleType>
							</element>
							<element name="DISTRETTO">
								<simpleType>
									<restriction base="string">
										<maxLength value="3"/>
									</restriction>
								</simpleType>
							</element>
							<element name="DATA_RICHIESTA_CESSAZIONE" minOccurs="0">
								<simpleType>
									<restriction base="string">
										<maxLength value="10"/>
										<minLength value="10"/>
										<pattern value="\d{4}-\d{2}-\d{2}"/>
									</restriction>
								</simpleType>
							</element>
							<element name="DATA_ESPLETAMENTO">
								<simpleType>
									<restriction base="string">
										<maxLength value="10"/>
										<minLength value="10"/>
										<pattern value="\d{4}-\d{2}-\d{2}"/>
									</restriction>
								</simpleType>
							</element>
							<element name="CLLI_CENTRALE">
								<simpleType>
									<restriction base="string">
										<maxLength value="8"/>
										<minLength value="1"/>
									</restriction>
								</simpleType>
							</element>
							<element name="CLLI_CENTRALE_OLD" minOccurs="0">
								<simpleType>
									<restriction base="string">
										<maxLength value="8"/>
									</restriction>
								</simpleType>
							</element>
							<element name="TIPO_LINEA">
								<simpleType>
									<restriction base="string">
										<maxLength value="15"/>
										<enumeration value="POTS SIMPLEX"/>
										<enumeration value="POTS PBX"/>
										<enumeration value="POTS GNR"/>
										<enumeration value="ISDN BRA MONO"/>
										<enumeration value="ISDN BRA MULTI"/>
										<enumeration value="ISDN PBX"/>
										<enumeration value="ISDN GNR"/>
									</restriction>
								</simpleType>
							</element>
							<element name="RADICALE" minOccurs="0">
								<simpleType>
									<restriction base="string">
										<maxLength value="10"/>
									</restriction>
								</simpleType>
							</element>
							<element name="QUANTITA_LINEE" minOccurs="0">
								<simpleType>
									<restriction base="string">
										<maxLength value="3"/>
									</restriction>
								</simpleType>
							</element>
							<element name="NUMERAZIONIAGGIUNTIVE" minOccurs="0" maxOccurs="unbounded">
								<complexType>
									<sequence>
										<element name="NUMERAZIONE_AGGIUNTIVA" minOccurs="0">
											<simpleType>
												<restriction base="string">
													<maxLength value="15"/>
												</restriction>
											</simpleType>
										</element>
										<element name="NUMERAZIONE_AGGIUNTIVA_OLD" minOccurs="0">
											<simpleType>
												<restriction base="string">
													<maxLength value="15"/>
												</restriction>
											</simpleType>
										</element>
									</sequence>
								</complexType>
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Fault">
		<complexType>
			<sequence>
				<element name="Messaggio_errore">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="Codice_errore">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Response">
		<complexType>
			<sequence>
				<element name="DN">
					<simpleType>
						<restriction base="string">
							<maxLength value="12"/>
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element name="ESITO">
					<simpleType>
						<restriction base="string">
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DESCRIZIONE_ESITO" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="255"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<simpleType name="DataType">
		<restriction base="string">
			<minLength value="10"/>
			<maxLength value="10"/>
			<pattern value="\d{4}-\d{2}-\d{2}"/>
		</restriction>
	</simpleType>
</schema>
