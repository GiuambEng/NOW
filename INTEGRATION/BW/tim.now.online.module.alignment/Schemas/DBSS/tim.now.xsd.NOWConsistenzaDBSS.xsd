<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/tim.now.xsd.NOWConsistenzaDBSS" elementFormDefault="qualified" targetNamespace="http://www.example.org/tim.now.xsd.NOWConsistenzaDBSS">
	<element name="NOWConsistenzaDBSS_Request">
		<complexType>
			<sequence>
				<element maxOccurs="1" name="TRANSACTION_ID" type="string"/>
				<element maxOccurs="1" name="TRANSACTION_DATE" type="dateTime"/>
				<element maxOccurs="1" name="Sistema_Competenza">
					<simpleType>
						<restriction base="string">
							<maxLength value="10"/>
							<enumeration value="DBSS"/>
							<enumeration value="CRMR"/>
							<enumeration value="CRMB"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="ACCESSO">
					<complexType>
						<sequence>
							<element minOccurs="1" name="Data_dec">
								<simpleType>
									<restriction base="date">
										<pattern
											value="((000[1-9])|(00[1-9][0-9])|(0[1-9][0-9]{2})|([1-9][0-9]{3}))-((0[1-9])|(1[012]))-((0[1-9])|([12][0-9])|(3[01]))" />
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="1" name="Ora_dec">
								<simpleType>
									<restriction base="time">
										<pattern
											value="(([01][0-9])|(2[0-3]))(:[0-5][0-9]){2}(\.[0-9]+)?" />

									</restriction>
								</simpleType>
							</element>
							<element minOccurs="1" name="ID_Risorsa">
								<simpleType>
									<restriction base="string">
										<maxLength value="30" />
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="1"
								name="Numero_Telefonico">
								<simpleType>
									<restriction base="string">
										<maxLength value="30" />
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0"
								name="ID_Risorsa_OLD">
								<simpleType>
									<restriction base="string">
										<maxLength value="30" />
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0"
								name="Numero_Telefonico_OLD">
								<simpleType>
									<restriction base="string">
										<maxLength value="30" />
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="1" name="Stato_Asset">
								<simpleType>
									<restriction base="string">
										<maxLength value="10" />
										<enumeration value="ATTIVO" />
										<enumeration value="CESSATO" />
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="1" name="Flag_FTTH">
								<simpleType>
									<restriction base="string">
										<maxLength value="1" />
										<enumeration value="Y" />
										<enumeration value="N" />
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0"
								name="Destinazione_Uso">
								<simpleType>
									<restriction base="string">
										<maxLength value="5" />
										<enumeration value="1" />
										<enumeration value="2" />
										<enumeration value="3" />




									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0"
								name="Famiglia_Tecnica">
								<simpleType>
									<restriction base="string">
										<maxLength value="30" />
										<enumeration
											value="Voce Tradizionale" />
										<enumeration value="Broadband" />
										<enumeration
											value="UltraBroadband" />
										<enumeration
											value="UltraBroadbandH" />
										<enumeration
											value="Broadband Naked" />
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0"
								name="Numero_nativo_olo">
								<simpleType>
									<restriction base="string">
										<maxLength value="1" />
										<enumeration value="Y" />
										<enumeration value="N" />
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="1"
								name="Distretto_Telefonico">
								<simpleType>
									<restriction base="string">
										<maxLength value="10" />
									</restriction>
								</simpleType>
							</element>
							<element name="Destinazione_Uso_Dati"
								maxOccurs="1" minOccurs="0">
								<simpleType>
									<restriction base="string">
										<maxLength value="5"></maxLength>
										<enumeration value="4"></enumeration>
										<enumeration value="5"></enumeration>
										<enumeration value="9"></enumeration>
										<enumeration value="10"></enumeration>
									</restriction>
								</simpleType>
							</element>
							<element name="ID_Risorsa_Correlata"
								maxOccurs="1" minOccurs="0">
								<simpleType>
									<restriction base="string">
										<maxLength value="30"></maxLength>
									</restriction>
								</simpleType>
							</element>
							<element name="ROW_ID_ORDINE_FONIA"
								maxOccurs="1" minOccurs="0">
								<simpleType>
									<restriction base="string">
										<maxLength value="30"></maxLength>
									</restriction>
								</simpleType>
							</element>
							<element name="ROW_ID_ORDINE_DATI"
								maxOccurs="1" minOccurs="0">
								<simpleType>
									<restriction base="string">
										<maxLength value="30"></maxLength>
									</restriction>
								</simpleType>
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="CLIENTE">
					<complexType>
						<sequence>
							<element name="CognomeRagioneSociale" maxOccurs="1" minOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="100" />
									</restriction>
								</simpleType>
							</element>
							<element name="Nome" maxOccurs="1" minOccurs="0">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"></maxLength>
									</restriction>
								</simpleType>
							</element>
							<element name="CF_PIVA" maxOccurs="1" minOccurs="0">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"></maxLength>
									</restriction>
								</simpleType>
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="SEDE">
					<complexType>
						<sequence>
							<element minOccurs="0" name="Particella_Toponomastica">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0" name="Indirizzo">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0" name="Civico">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0" name="Localita">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0" name="Complesso">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0" name="Scala">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0" name="Piano">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0" name="Interno">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0" name="Codice_Comune">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0" name="Codice_Via">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0" name="Codice_Provincia">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element minOccurs="0" name="Indirizzo_non_certificato">
								<simpleType>
									<restriction base="string">
										<maxLength value="256"/>
									</restriction>
								</simpleType>
							</element>
						</sequence>
					</complexType>
				</element>
            </sequence>
		</complexType>
	</element>
	<element name="NOWConsistenzaDBSS_Response">
		<complexType>
			<sequence>
				<element maxOccurs="1" name="Transaction_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" name="Response_date" type="dateTime"/>
				<element maxOccurs="1" name="Return_Code">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="0" name="Descrizione_errore">
					<simpleType>
						<restriction base="string">
							<maxLength value="150"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="SoapFault">
		<complexType>
			<sequence>
				<element minOccurs="0" name="CodiceErrore" type="string"/>
				<element minOccurs="0" name="MessaggioErrore" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>
