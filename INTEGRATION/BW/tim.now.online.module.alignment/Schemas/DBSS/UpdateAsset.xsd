<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/UpdateAsset/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/UpdateAsset/"
	xmlns:pref="http://www.tim.com/NOW/xsd/FindUpdateCase/" xmlns:pref1="http://NOW.it.telecomitalia.it/casedata">




	<import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/Casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata"></import>
	<element name="Input">
		<complexType>
			<sequence>
				<element name="Data_Dec" type="date" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Ora_Dec" type="time" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="SistemaCompetenza" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="Find" maxOccurs="unbounded" minOccurs="0">


					<complexType>
						<sequence>
							<element name="CaseReference" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="Asset" type="pref1:Asset" maxOccurs="1" minOccurs="0"></element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>

</schema>