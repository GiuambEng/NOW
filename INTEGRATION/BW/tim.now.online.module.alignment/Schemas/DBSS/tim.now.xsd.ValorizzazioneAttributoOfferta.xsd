<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/tim.now.xsd.ValorizzazioneAttributoOfferta" xmlns:tns="http://www.example.org/tim.now.xsd.ValorizzazioneAttributoOfferta" elementFormDefault="qualified">


	<element name="TrascodificaOfferta_Input">
		<complexType>
			<sequence>
		<element minOccurs="1" name="FLAG_FTTH" type="string"/>
		<element minOccurs="1" name="PROVENIENZA" type="string"/>
		<element minOccurs="1" name="ID_RISORSA" type="string"/>
			</sequence>
		</complexType>
	</element>
	
	<element name="TrascodificaOfferta_Output">
		<complexType>
			<sequence>
		<element minOccurs="1" name="ID_OFFERTA" type="integer"/>
		<element minOccurs="1" name="NOME_OFFERTA" type="string"/>
		<element minOccurs="1" name="NOME_COMPONENTE" type="string"/>
			</sequence>
		</complexType>
	</element>

</schema>