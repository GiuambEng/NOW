							<xs:element name="ID_PROCSO_NO_FILE" type="xs:integer"/>
							<xs:element name="ID_RICH_HAL" type="xs:integer"/>
							<xs:element name="ID_STATO_ELAB_STAG" type="xs:integer"/>
