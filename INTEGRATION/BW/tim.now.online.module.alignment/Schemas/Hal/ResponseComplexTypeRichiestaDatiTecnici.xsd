<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/ResponseComplexTypeRichiestaDatiTecnici" 
	xmlns:tns="http://www.example.org/ResponseComplexTypeRichiestaDatiTecnici" 
	xmlns:tns1="http://NOW.it.telecomitalia.it/casedata" elementFormDefault="qualified">
	<import namespace="http://NOW.it.telecomitalia.it/casedata" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/Casedata.xsd"/>
    <element name="ResponseComplexType">
    	<complexType>
    		<sequence>
    			<element name="VC" minOccurs="0" maxOccurs="unbounded">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="1" name="ID_RISORSA_VC" type="string" />
    						<element maxOccurs="1" minOccurs="1" name="CODICE_TD_OLO" type="string" />
    						<element maxOccurs="1" minOccurs="0" name="MCR_DOWNSTREAM" type="string" />
    						<element maxOccurs="1" minOccurs="0" name="MCR_UPSTREAM" type="string" />
    						<element maxOccurs="1" minOccurs="0" name="PCR_DOWNSTREAM" type="string" />
    						<element maxOccurs="1" minOccurs="0" name="PCR_UPSTREAM" type="string" />
    					</sequence>
    				</complexType>
    			</element>
    			<element name="UserVlan" minOccurs="0" maxOccurs="4">
    				<complexType>
						<sequence>
							<element maxOccurs="1" minOccurs="1" name="ID_RISORSA_USERVLAN" type="string" />
							<element maxOccurs="1" minOccurs="0" name="SVLAN" type="string" />
							<element maxOccurs="1" minOccurs="0" name="CODE_VLAN_SINGLE_TAG" type="string" />
							<element maxOccurs="1" minOccurs="0" name="CVLAN" type="int" />
							<element maxOccurs="1" minOccurs="0" name="USERVLAN" type="int" />
							<element maxOccurs="1" minOccurs="0" name="BANDA_PICCO_DOWN" type="string" />
							<element maxOccurs="1" minOccurs="0" name="BANDA_PICCO_UP" type="string" />
						</sequence>		    				
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="Input_subFindCaseAsset">
    	<complexType>
    		<sequence>
    			<element minOccurs="1" maxOccurs="1" type="string" name="IdRisorsa "/>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="Output_subFindCaseAsset">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="unbounded" type="tns:OutputAsset_Type" name="FindAsset" />
    		</sequence>
    	</complexType>
    </element>
    
    <complexType name="OutputAsset_Type">
    	<sequence>
    		<element minOccurs="1" maxOccurs="1" type="integer" name="idAsset" />
    		<element minOccurs="1" maxOccurs="1" type="string" name="tipologiaAccesso" />
    		<element minOccurs="1" maxOccurs="1" type="int" name="idOfferta" />
    		<element minOccurs="1" maxOccurs="1" type="string" name="offerta" />
    		<element minOccurs="1" maxOccurs="1" type="string" name="statoAsset" />
    		<element minOccurs="0" maxOccurs="1" type="string" name="idRichiestaOlo" /> 
    		<element minOccurs="0" maxOccurs="1" type="string" name="numeroTelefonico" /> 
    		<element minOccurs="0" maxOccurs="1" type="string" name="numeroFittizio" /> 
    		<element minOccurs="0" maxOccurs="1" type="string" name="distretto" /> 
    		<element minOccurs="0" maxOccurs="1" type="string" name="codiceToponomastica" />
    		<element minOccurs="0" maxOccurs="1" type="string" name="cap" /> 
    		<element minOccurs="0" maxOccurs="1" type="string" name="numeroCivico" /> 
    		<element minOccurs="0" maxOccurs="1" type="string" name="comune" /> 
    		<element minOccurs="0" maxOccurs="1" type="string" name="provincia" /> 
    		<element minOccurs="0" maxOccurs="1" type="string" name="descrizioneVia" /> 
    		<element minOccurs="0" maxOccurs="1" type="string" name="descrPartToponomastica" /> 
     		<element minOccurs="0" maxOccurs="1" type="string" name="codificaOloAgcom" />
    		<element minOccurs="0" maxOccurs="unbounded" name="DettaglioAsset">
    			<complexType>
    				<sequence>
    					<element minOccurs="1" maxOccurs="1" type="string" name="nomeComponente" />
    					<element minOccurs="0" maxOccurs="unbounded" name="AttributiDettaglioAsset">
    						<complexType>
    							<sequence>
    								<element minOccurs="0" maxOccurs="1" type="string" name="nomeAttributo" />
    								<element minOccurs="0" maxOccurs="1" type="string" name="valoreAttributo" />
    							</sequence>
    						</complexType>
    					</element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>   
     
</schema>