<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://www.example.org/tim.now.schema.xsd.stagingCheckDN_FENP"
	xmlns:tns="http://www.example.org/tim.now.schema.xsd.stagingCheckDN_FENP"
	elementFormDefault="qualified">
	
	
	<element name="Input">
	 <complexType>
	  <choice>
	   <element name="Insert" type="tns:Insert_type" />
	   <element name="Update" type="tns:Update_type" />
	   <element name="UpdateOnError" type="tns:UpdateOnError_type" />
	  </choice>
	 </complexType>
	</element>
	
	
	<complexType name="Insert_type">
	 <sequence>
	  <element name="IDENTIFICATIVO_RICHIESTA_VERIFICA_DN" type="string"/>
	  <element name="CONTENUTO_REQUEST" type="string"/>
	  <element name="IDENTIFICATIVO_ESECUZIONE_PROCESSO_NO_FILE" type="string"/>
	  <element name="OPERATORE" type="string"/>
	  <element name="TIMESTAMP_RICHIESTA" type="string"/>
	  <element name="DN" type="string"/>
	 </sequence>
	</complexType>
	
	
		<complexType name="Update_type">
	 <sequence>
	  <element name="CONTENUTO_RESPONSE" type="string"/>
	  <element name="IDENTIFICATIVO_ESECUZIONE_PROCESSO_NO_FILE" type="string"/>
	  <element name="CODICE_ESITO" type="string"/>
	  <element name="TIMESTAMP_RISPOSTA" type="string"/>
	  <element name="AMBITO_DI_COMPETENZA" type="string"/>
	 </sequence>
	</complexType>
	
	
			<complexType name="UpdateOnError_type">
	 <sequence>
	  <element name="CONTENUTO_RESPONSE" type="string"/>
	  <element name="IDENTIFICATIVO_ESECUZIONE_PROCESSO_NO_FILE" type="string"/>
	  <element name="CODICE_ESITO" type="string"/>
	  <element name="TIMESTAMP_RISPOSTA" type="string"/>
	  <element name="AMBITO_DI_COMPETENZA" type="string"/>
	 </sequence>
	</complexType>
	
	

	
</schema>