<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim-now/Schemas/CheckDN_FENP"
	xmlns:tns="http://www.tim-now/Schemas/CheckDN_FENP" elementFormDefault="qualified">
	
	
	
	<xs:element name="VerificaRientroInTI_Request"
            xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:complexType>
        <xs:sequence>
            <xs:element name="Transaction_id" minOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
						<xs:minLength value="1" />
                        <xs:maxLength value="50" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="Transaction_date" minOccurs="1">
                <xs:simpleType>
                        <xs:restriction base="xs:dateTime">
						</xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="Directory_Number" minOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:minLength value="1" />
						<xs:maxLength value="50" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:element>


	 <xs:element name="VerificaRientroInTI_Response" xmlns:xs="http://www.w3.org/2001/XMLSchema">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Data_Risposta" minOccurs="1">
                    <xs:simpleType>
                        <xs:restriction base="xs:dateTime">
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
                <xs:element name="Directory_Number" minOccurs="1">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:minLength value="1" />
                            <xs:maxLength value="50" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
                <xs:element name="AmbitoDiCompetenza" minOccurs="1">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:minLength value="1" />
                            <xs:enumeration value="NOW" />
                            <xs:enumeration value="Non di competenza NOW" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
                <xs:element name="ReturnCode" minOccurs="1">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="00" />
                            <xs:enumeration value="01" />
                            <xs:enumeration value="02" />
                            <xs:length value="2" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
                <xs:element name="ErrMsg" minOccurs="1">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:maxLength value="150" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
	
	
</schema>