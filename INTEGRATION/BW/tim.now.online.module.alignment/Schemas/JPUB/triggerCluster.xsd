<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/triggerCluster/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/triggerCluster/">

<complexType name="TriggerCluster_type">
			<sequence>
				<element name="COD_ISTAT_COMUNI" type="string"
					minOccurs="0" />
				<element name="COD_CLUSTER" type="string"
					minOccurs="0" />
				<element name="TIPOLOG_CLUSTER_COMUNE" type="string"
					minOccurs="0" />
				<element name="DATAINI_VALID_PRICING" type="string"
					minOccurs="0" />
				<element name="DATAFIN_VALID_PRICING" type="string"
					minOccurs="0" />
				<element name="DESCR_COMUNE" type="string"
					minOccurs="0" />
					<element name="TIPO_CONTR" type="string"
					minOccurs="0" />
					<element name="DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI" type="string"
					minOccurs="0" />
					<element name="DATA_FINE_MARCAGGIO_NUOVI_ACCESSI" type="string"
					minOccurs="0" />
					<element name="DATA_INIZIO_MARCAGGIO_PREGRESSO" type="string"
					minOccurs="0" />
					<element name="VERSIONING" type="string"
					minOccurs="0" />
			</sequence>
		</complexType>
			<element name="Input">
			<complexType>
				<sequence>
				     <element name="ProcessID" type="string" minOccurs="0" />
				    <element name="ID_TRANSAZIONE" type="string" minOccurs="0" />
					<element name="ID_ESEC_PROCSO_NOFILE" type="string" minOccurs="0" />
					<element name="ID_RICH_JPUB" type="integer" minOccurs="0" />
					<element name="Cluster" type="tns:TriggerCluster_type" minOccurs="0" maxOccurs="unbounded"/>
				</sequence>
			</complexType>
		</element> 
		<element name="currentElement">
			<complexType>
				<sequence>
					<element name="Cluster" type="tns:TriggerCluster_type" minOccurs="0"/>
				</sequence>
			</complexType>
		</element> 

</schema>