<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns:tns="http://tim.now.alignement.Jpub.adapter.OLO.interprocess.OnLine" 
targetNamespace="http://tim.now.alignement.Jpub.adapter.OLO.interprocess.OnLine" 
elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="root">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="AnagraficaOLO" minOccurs="0" type="tns:AnagraficaOLO_type"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="AnagraficaOLO_type">
		<xs:sequence>
			<xs:element name="TIPO_AZIONE" type="xs:string"/>
			<xs:element name="CODE_GEST" type="xs:string"/>
			<xs:element name="NOME_RAG_SOC_GEST" type="xs:string"/>
			<xs:element name="NOME_GEST_SIGLA" type="xs:string"/>
			<xs:element name="CODE_PARTITA_IVA" type="xs:string"/>
			<xs:element name="CODE_GEST_TIRKS" type="xs:string"/>
			<xs:element minOccurs="0" name="Status" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="Output">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Output_Olo" type="tns:AnagraficaOLO_type" minOccurs="0" maxOccurs="unbounded"/> 
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>