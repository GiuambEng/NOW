<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	 elementFormDefault="unqualified"
	 attributeFormDefault="unqualified" targetNamespace="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input" xmlns="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input">
	<xs:element name="REQUEST">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ID_TRANSAZIONE" type="xs:string"/>
				<xs:element ref="ANAGRAFICHE"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="ANAGRAFICHE">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="CONTRATTI" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="ANAGRAFICA_GESTORI" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="ANAGRAFICA_CLUSTER_COMUNI" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="CONTRATTI">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="CODE_CONTR" type="codeContr"/>
				<xs:element name="CODE_TIPO_CONTR" type="codeTipoContr"/>
				<xs:element name="CODE_GEST" type="codeGest"/>
				<xs:element name="DESC_CONTR" type="descContr"/>
				<xs:element name="DATA_SCAD_CONTR" type="dataOpzionale"/>
				<xs:element name="DATA_STIP_CONTR" type="xs:dateTime"/>
				<xs:element name="DATA_INIZIO_VALID" type="xs:dateTime"/>
				<xs:element name="DATA_FINE_VALID" type="dataOpzionale"/>
				<xs:element name="DATA_COINV" type="dataOpzionale" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="ANAGRAFICA_GESTORI">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TIPO_AZIONE" type="enumTipoAzione"/>
				<xs:element name="CODE_GEST" type="codeGest"/>
				<xs:element name="NOME_RAG_SOC_GEST" type="nomeRagSocGest"/>
				<xs:element name="NOME_GEST_SIGLA" type="nomeGestSigla"/>
				<xs:element name="CODE_PARTITA_IVA" type="codePartitaIva"/>
				<xs:element name="CODE_GEST_TIRKS" type="codeGestTirks"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ANAGRAFICA_CLUSTER_COMUNI">
		<xs:complexType>
		            <xs:sequence>
							<xs:element name="CODICE_ISTAT_COMUNE" type="xs:string" />
				<xs:element name="CODICE_CLUSTER" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="30" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="TIPOLOGIA_CLUSTER_COMUNE">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="CC" />
							<xs:enumeration value="LIB" />
							<xs:maxLength value="10"></xs:maxLength>
							<xs:minLength value="2"></xs:minLength>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="DATA_INIZIO_VALIDITA_PRICING"
					type="dataOpzionale" minOccurs="0" />
				<xs:element name="DATA_FINE_VALIDITA_PRICING"
					type="dataOpzionale" minOccurs="0" />
				<xs:element name="DESCRIZIONE_COMUNE">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="300" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="TIPO_CONTR" type="codeTipoContr" />
				<xs:element name="DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI"
					type="dataOpzionale" />
				<xs:element name="DATA_FINE_MARCAGGIO_NUOVI_ACCESSI"
					type="dataOpzionale" />
				<xs:element name="DATA_INIZIO_MARCAGGIO_PREGRESSO "
					type="dataOpzionale" minOccurs="0" />
				<xs:element name="VERSIONING "
					type="dataOpzionale" minOccurs="0" />
						</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	
	<xs:simpleType name="strNoSpace">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="codeContr">
		<xs:restriction base="strNoSpace">
			<xs:minLength value="1"/>
			<xs:maxLength value="6"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="codeTipoContr">
		<xs:restriction base="strNoSpace">
			<xs:minLength value="1"/>
			<xs:maxLength value="2"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="codeGest">
		<xs:restriction base="strNoSpace">
			<xs:minLength value="3"/>
			<xs:maxLength value="3"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="descContr">
		<xs:restriction base="strNoSpace">
			<xs:minLength value="1"/>
			<xs:maxLength value="255"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="enumTipoAzione">
		<xs:restriction base="strNoSpace">
			<xs:enumeration value="ATT"/>
			<xs:enumeration value="VAR"/>
			<xs:enumeration value="DIS"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="nomeRagSocGest">
		<xs:restriction base="strNoSpace">
			<xs:minLength value="1"/>
			<xs:maxLength value="50"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="nomeGestSigla">
		<xs:restriction base="strNoSpace">
			<xs:minLength value="1"/>
			<xs:maxLength value="15"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="codePartitaIva">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="strNoSpace">
					<xs:minLength value="11"/>
					<xs:maxLength value="11"/>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="strNoSpace">
					<xs:minLength value="16"/>
					<xs:maxLength value="16"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	
		<xs:simpleType name="dataOpzionale">
		<xs:union>
			<xs:simpleType >
				<xs:restriction base="xs:dateTime">
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="strNoSpace">
					<xs:minLength value="0"/>
					<xs:maxLength value="0"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>

	<xs:simpleType name="codeGestTirks">
		<xs:restriction base="strNoSpace">
			<xs:minLength value="0"/>
			<xs:maxLength value="4"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>