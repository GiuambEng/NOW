<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/GestioneSegnalazioni.NOW/" targetNamespace="http://www.tim.com/NOW/xsd/GestioneSegnalazioni.NOW/" elementFormDefault="qualified">
	<element name="NOW_AperturaSegnalazione_Output">
		<complexType>
			<sequence>
				<element name="ORDINE" minOccurs="0" maxOccurs="20">
					<complexType>
						<sequence>
							<element name="COD_ORD_TI" type="string"/>
							<element name="SERVIZIO" type="string"/>
							<element name="DATA_CREAZ_ORD" type="string"/>
							<element name="DATA_RICEZ_ORD" type="string"/>
							<element name="STATO" type="string"/>
							<element name="ID_RISORSA" type="string" minOccurs="0"/>
							<element name="INTESTAZIONE" type="string" minOccurs="0"/>
							<element name="TIPO_RICHIESTA" type="string" minOccurs="0"/>
						</sequence>
					</complexType>
				</element>
				<element name="ERROR_CODE" type="int"/>
				<element name="ERROR_DESC" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="NOW_SollecitoSegnalazione_Output">
		<complexType>
			<sequence>
				<element name="ORDINE" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="DATA_RICEZ_ORD" type="string" minOccurs="0"/>
							<element name="DATA_ATT_CONS" type="string" minOccurs="0"/>
							<element name="PROFILO_LINEA" type="string"/>
							<element name="TIPO_LINEA" type="string"/>
							<element name="CAUS_ORD" type="string"/>
							<element name="STATO" type="string"/>
						</sequence>
					</complexType>
				</element>
				<element name="ERROR_CODE" type="int"/>
				<element name="ERROR_DESC" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="NOW_CodiceProgetto_Output">
		<complexType>
			<sequence>
				<element name="Pratica" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="COD_PROGETTO" type="string"/>
							<element name="STATO" type="string"/>
						</sequence>
					</complexType>
				</element>
				<element name="ERROR_CODE" type="int"/>
				<element name="ERROR_DESC" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>
