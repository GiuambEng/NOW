<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AggiornamentoCodiciProgetto_Sub/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/AggiornamentoCodiciProgetto_Sub/">

    <element name="Input_NowSendCodiciProgetto">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0"
    				name="Transaction_id" type="string" />
    			<element maxOccurs="1" minOccurs="0"
    				name="Transaction_date" type="dateTime">
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="CODICE_PROGETTO" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="CODE_OPERATORE" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="DATA_INIZIO_PROV" type="date">
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="DATA_FINE_PROV" type="date">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="FITTIZIO">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="SI" />
    						<enumeration value="NO" />
    					</restriction>
    				</simpleType>
    			</element>

    			<element maxOccurs="1" minOccurs="0" name="REPORT">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="SI" />
    						<enumeration value="NO" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="Id_Process"
    				type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="Tip_Op_Staging">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="INSERT" />
    						<enumeration value="UPDATE" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Contenuto_Request" type="string" minOccurs="0" maxOccurs="1"></element>
    			<element maxOccurs="1" minOccurs="0"
    				name="Contenuto_Response" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="Desc_Errore"
    				type="string" />
    		</sequence>
    	</complexType>
    </element>

</schema>
