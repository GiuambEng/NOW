                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Insert-input"
                    name="Insert" outputVariable="Insert"
                    tibex:xpdlId="fb80df28-aa6d-4597-b3f0-454b7ac97fc7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToInsert"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsertToCallProcess"/>
                    </bpws:sources>
