                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="AssignToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToInvoke" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InvokeToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
