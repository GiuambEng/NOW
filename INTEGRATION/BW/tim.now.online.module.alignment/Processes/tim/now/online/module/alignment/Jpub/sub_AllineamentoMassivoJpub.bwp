                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1469551322714" xmlns:ns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns2="www.tim.now.aggiornamentomassivo.Jpub.tim.now.schema.xsd.AsincJpub.xsd" version="2.0"&gt;&lt;xsl:param name="Operation1"/&gt;&lt;xsl:param name="ProcessID"/&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:param name="TransactionID"/&gt;&lt;xsl:param name="ID_PROCSO_FILE"/&gt;&lt;xsl:param name="AllMassJPUB_JMS"/&gt;&lt;xsl:template name="Error-input" match="/"&gt;&lt;tns:Input&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$FaultDetails/ActivityName='AllMassJPUB_JMS' or $Operation1='AllMassJPUB_JMS'"&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="'AllMassJPUB_JMS'"/&gt;&lt;/ns:ActivityName&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;ns:Error&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="$FaultDetails/ActivityName"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Msg&gt;&lt;xsl:value-of select="$FaultDetails/Msg"/&gt;&lt;/ns:Msg&gt;&lt;ns:MsgCode&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/ns:MsgCode&gt;&lt;ns:ProcessStack&gt;&lt;xsl:value-of select="$FaultDetails/ProcessStack"/&gt;&lt;/ns:ProcessStack&gt;&lt;ns:StackTrace&gt;&lt;xsl:value-of select="$FaultDetails/StackTrace"/&gt;&lt;/ns:StackTrace&gt;&lt;/ns:Error&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ProcessID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;&lt;xsl:if test="$ProcessID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$ProcessID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Operation1)&gt;0"&gt;&lt;ns:ProcessName&gt;&lt;xsl:value-of select="$Operation1"/&gt;&lt;/ns:ProcessName&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;ns:JpubTransactionID&gt;&lt;xsl:value-of select="$TransactionID"/&gt;&lt;/ns:JpubTransactionID&gt;&lt;ns:CorrelationID&gt;&lt;xsl:value-of select="$AllMassJPUB_JMS/part1/ns2:Input/ns2:CorrelationID"/&gt;&lt;/ns:CorrelationID&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:Input&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns2=&quot;www.tim.now.aggiornamentomassivo.Jpub.tim.now.schema.xsd.AsincJpub.xsd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AllMassJPUB_JMS.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionID&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_FILE&quot;/>&#xa;    &lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FaultDetails/ActivityName='AllMassJPUB_JMS' or $Operation1='AllMassJPUB_JMS'&quot;>&#xa;                    &lt;ns:ActivityName>&#xa;                        &lt;xsl:value-of select=&quot;'AllMassJPUB_JMS'&quot;/>&#xa;                    &lt;/ns:ActivityName>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:Error>&#xa;                &lt;ns:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ActivityName&quot;/>&#xa;                &lt;/ns:ActivityName>&#xa;                &lt;ns:Msg>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                &lt;/ns:Msg>&#xa;                &lt;ns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/ns:MsgCode>&#xa;                &lt;ns:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                &lt;/ns:ProcessStack>&#xa;                &lt;ns:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                &lt;/ns:StackTrace>&#xa;            &lt;/ns:Error>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ProcessID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Operation1)>0&quot;>&#xa;                    &lt;ns:ProcessName>&#xa;                        &lt;xsl:value-of select=&quot;$Operation1&quot;/>&#xa;                    &lt;/ns:ProcessName>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:JpubTransactionID>&#xa;                &lt;xsl:value-of select=&quot;$TransactionID&quot;/>&#xa;            &lt;/ns:JpubTransactionID>&#xa;            &lt;ns:CorrelationID>&#xa;                &lt;xsl:value-of select=&quot;$AllMassJPUB_JMS.part1/ns2:CorrelationID&quot;/>&#xa;            &lt;/ns:CorrelationID>&#xa;            &lt;ns:ID_PROCSO_NOFILE>&#xa;                &lt;xsl:value-of select=&quot;$ID_PROCSO_FILE&quot;/>&#xa;            &lt;/ns:ID_PROCSO_NOFILE>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
