            name="_error_Error" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:INPUT" name="Err_Resp_Staging-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:CW_BUS_MESSAGE"
            name="ResponseLog-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:CW_BUS_MESSAGE" name="Errore-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns1:NOW_HAL_QUADRATURAResponse"
            name="Reply-input" sca-bpel:internal="true"/>
        <bpws:variable name="InviatoEsitoKO" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/InviatoEsitoKO" type="xsd:int"/>
        <bpws:variable messageType="ns1:NOW_HAL_QUADRATURARequest"
            name="sub_RichiestaQuadratura-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns1:NOW_HAL_QUADRATURAResponse"
            name="sub_RichiestaQuadratura" sca-bpel:internal="true"/>
        <bpws:variable name="IdProcFile" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/ID_ProcsoFile/Hal_RichQuad" type="xsd:int"/>
        <bpws:variable element="ns11:Element" name="GetLocalIP" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="d5348640-e57d-441a-a0bf-f222eca424d2">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="LogErrorToError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="ErrorToErrorResponse" tibex:linkType="SUCCESS"/>
                            <bpws:link name="FaultToErrorResponse" tibex:linkType="SUCCESS"/>
                            <bpws:link name="ErrorToFault" tibex:linkType="ERROR"/>
                            <bpws:link name="ErrorResponseToResponseLog" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            <bpws:link
                                name="ErrorResponseToErr_Resp_Staging" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link
                                name="Err_Resp_StagingToResponseLog" tibex:linkType="SUCCESS"/>
                            <bpws:link name="Err_Resp_StagingToErrore" tibex:linkType="ERROR"/>
                            <bpws:link name="ErroreToResponseLog" tibex:linkType="SUCCESS"/>
                            <bpws:link name="ResponseLogToReply" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="LogError-input"
                                name="LogError"
                                tibex:xpdlId="58535487-ed39-4d16-8abe-5fb338a8565d"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LogErrorToError"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;ErrorLoggerLevel&quot;/>&lt;xsl:template name=&quot;LogError-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'HAL_RichiestaQuadratura'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(),true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$ErrorLoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:invoke inputVariable="Error-input"
                            name="Error" operation="Invoke"
                            outputVariable="Error"
                            partnerLink="GestioneErrore"
                            portType="ns8:GenericError" tibex:xpdlId="4e60e568-2dd2-4bb5-8f22-68e7844ca33e">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1469551322714" xmlns:ns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns1="http://www.tim.com/NOW/xsd/NOW_HAL_QUADRATURA/" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:param name="IdProcFile"/&gt;&lt;xsl:param name="ProcessLogger"/&gt;&lt;xsl:param name="NOW_HAL_QUADRATURAIn"/&gt;&lt;xsl:template name="Error-input" match="/"&gt;&lt;tns:Input&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="'HalQuadratura'"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Error&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="$FaultDetails/ActivityName"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Msg&gt;&lt;xsl:value-of select="$FaultDetails/Msg"/&gt;&lt;/ns:Msg&gt;&lt;ns:MsgCode&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/ns:MsgCode&gt;&lt;ns:ProcessStack&gt;&lt;xsl:value-of select="$FaultDetails/ProcessStack"/&gt;&lt;/ns:ProcessStack&gt;&lt;ns:StackTrace&gt;&lt;xsl:value-of select="$FaultDetails/StackTrace"/&gt;&lt;/ns:StackTrace&gt;&lt;/ns:Error&gt;&lt;xsl:if test="$ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;ns:ID_Risorsa&gt;&lt;xsl:value-of select="$NOW_HAL_QUADRATURAIn/parameters/tns1:NOW_HAL_QUADRATURA_Request/tns1:DN"/&gt;&lt;/ns:ID_Risorsa&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$IdProcFile"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:Input&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_HAL_QUADRATURA/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;NOW_HAL_QUADRATURAIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:ActivityName>&#xa;                &lt;xsl:value-of select=&quot;'HalQuadratura'&quot;/>&#xa;            &lt;/ns:ActivityName>&#xa;            &lt;ns:Error>&#xa;                &lt;ns:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ActivityName&quot;/>&#xa;                &lt;/ns:ActivityName>&#xa;                &lt;ns:Msg>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                &lt;/ns:Msg>&#xa;                &lt;ns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/ns:MsgCode>&#xa;                &lt;ns:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                &lt;/ns:ProcessStack>&#xa;                &lt;ns:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                &lt;/ns:StackTrace>&#xa;            &lt;/ns:Error>&#xa;            &lt;xsl:if test=&quot;$ProcessLogger.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                &lt;ns:ID_Esec_Proc>&#xa;                    &lt;xsl:value-of select=&quot;$ProcessLogger.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                &lt;/ns:ID_Esec_Proc>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:ID_Risorsa>&#xa;                &lt;xsl:value-of select=&quot;$NOW_HAL_QUADRATURAIn.parameters/tns1:DN&quot;/>&#xa;            &lt;/ns:ID_Risorsa>&#xa;            &lt;ns:ID_PROCSO_NOFILE>&#xa;                &lt;xsl:value-of select=&quot;$IdProcFile&quot;/>&#xa;            &lt;/ns:ID_PROCSO_NOFILE>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="LogErrorToError"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="ErrorToErrorResponse"/>
                                <bpws:source linkName="ErrorToFault"
                                    tibex:faultDetailsVar="Error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                        </bpws:invoke>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="ErrorResponse-input"
                                name="ErrorResponse"
                                outputVariable="ErrorResponse"
                                tibex:xpdlId="80d1e510-e97a-4b33-b8d9-f08b6e390686" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="ErrorToErrorResponse"/>
                                    <bpws:target linkName="FaultToErrorResponse"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ErrorResponseToResponseLog">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="ErrorResponseToErr_Resp_Staging">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($Error/part1/ns10:Output/ns10:ID_ESEC_PROCSO_NOFILE)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Error.part1/ns10:ID_ESEC_PROCSO_NOFILE)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_HAL_QUADRATURA/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;ErrorResponse-input&quot; match=&quot;/&quot;>&lt;tns:NOW_HAL_QUADRATURA_Response>&lt;tns:Servizio>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:ESITO>&lt;tns:CODICE_ERRORE>&lt;xsl:value-of select=&quot;'03'&quot;/>&lt;/tns:CODICE_ERRORE>&lt;tns:TIMESTAMP>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]-[M01]-[YYYY] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/tns:TIMESTAMP>&lt;tns:NOME_SERVIZIO xsi:nil=&quot;true&quot;/>&lt;tns:DESC_OLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:DESC_OLO>&lt;tns:CODICE_OLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CODICE_OLO>&lt;tns:DEC xsi:nil=&quot;true&quot;/>&lt;tns:ENTITA_RIFERIMENTO xsi:nil=&quot;true&quot;/>&lt;/tns:Servizio>&lt;/tns:NOW_HAL_QUADRATURA_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:NOW_HAL_QUADRATURA="http://www.tim.com/NOW/xsd/NOW_HAL_QUADRATURA/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="NOW_HAL_QUADRATURA:NOW_HAL_QUADRATURA_Response" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="Fault-input" name="Fault"
                                tibex:xpdlId="f9eefded-88e9-4a98-8007-e965438749e9"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="ErrorToFault"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="FaultToErrorResponse"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;ErrorLoggerLevel&quot;/>&lt;xsl:template name=&quot;Fault-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'HAL_RichiestaQuadratura'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($_error, true(),true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$ErrorLoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="Err_Resp_Staging-input"
                                name="Err_Resp_Staging"
                                tibex:xpdlId="ebd8ad84-0397-452c-a42a-d7d16feeee55"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="ErrorResponseToErr_Resp_Staging"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Err_Resp_StagingToResponseLog"/>
                                    <bpws:source
                                    linkName="Err_Resp_StagingToErrore"
                                    tibex:faultDetailsVar="Err_Resp_Staging" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.stagingHAL&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ErrorResponse&quot;/>&lt;xsl:param name=&quot;InviatoEsitoKO&quot;/>&lt;xsl:param name=&quot;IdProcFile&quot;/>&lt;xsl:template name=&quot;Err_Resp_Staging-input&quot; match=&quot;/&quot;>&lt;tns:INPUT>&lt;tns:UpdateOnError>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($ErrorResponse)&quot;/>&lt;/tns:DESCR_ERRORE>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$InviatoEsitoKO&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;tns:ID_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;$IdProcFile&quot;/>&lt;/tns:ID_PROCSO_NO_FILE>&lt;tns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_RISPOSTA>&lt;/tns:UpdateOnError>&lt;/tns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    subProcessName="tim.now.online.module.alignment.Hal.sub_Staging" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="ResponseLog-input"
                                name="ResponseLog"
                                tibex:xpdlId="5afc13d5-e57c-4153-a7c4-6fb28598e1f5"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="ErrorResponseToResponseLog"/>
                                    <bpws:target linkName="Err_Resp_StagingToResponseLog"/>
                                    <bpws:target linkName="ErroreToResponseLog"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ResponseLogToReply"/>
                                </bpws:sources>
