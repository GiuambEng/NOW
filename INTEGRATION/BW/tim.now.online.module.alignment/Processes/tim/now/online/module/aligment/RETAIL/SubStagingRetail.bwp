                    tibex:xpdlId="75c62454-b22b-4595-829b-e2e0190e76bf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToEnd"/>
                        <bpws:target linkName="CallProcess1ToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="StartLog-input"
                    name="StartLog"
                    tibex:xpdlId="7b7edc37-ce97-4f41-b45c-7bba127bc94b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartLogToJDBCUpdate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length(xsd:string($Start/ns0:Insert/ns0:ID_PROCSO_NO_FILE))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length(xsd:string($Start/ns0:Insert/ns0:ID_PROCSO_NO_FILE))>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartLogToJDBCUpdate1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length(xsd:string($Start/ns0:Update/ns0:ID_PROCSO_NO_FILE))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length(xsd:string($Start/ns0:Update/ns0:ID_PROCSO_NO_FILE))>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartLogToJDBCUpdate2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:UpdateOnError/ns0:TIMSTP_RISPOSTA)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Start/ns0:UpdateOnError/ns0:TIMSTP_RISPOSTA)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
