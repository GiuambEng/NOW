                    <bpws:sources>
                        <bpws:source linkName="Mapper_IdRis1ToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ResponseComplexTypeRichiestaDatiTecnici&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Asset_IdRis1&quot;/>&lt;xsl:param name=&quot;Compon_IdRis1&quot;/>&lt;xsl:template name=&quot;Mapper_IdRis1-input&quot; match=&quot;/&quot;>&lt;tns:Output_subFindCaseAsset>&lt;xsl:for-each select=&quot;$Asset_IdRis1/Record&quot;>&lt;tns:FindAsset>&lt;xsl:variable name=&quot;indexAsset1&quot; select=&quot;number(position())&quot;/>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:idAsset>&lt;tns:tipologiaAccesso>&lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&lt;/tns:tipologiaAccesso>&lt;tns:idOfferta>&lt;xsl:value-of select=&quot;xsd:int(IDOFFERTA)&quot;/>&lt;/tns:idOfferta>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;tns:statoAsset>&lt;xsl:value-of select=&quot;STATOASSET&quot;/>&lt;/tns:statoAsset>&lt;xsl:if test=&quot;IDRICHIESTAOLO&quot;>&lt;tns:idRichiestaOlo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:idRichiestaOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&lt;tns:numeroTelefonico>&lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&lt;/tns:numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&lt;tns:numeroFittizio>&lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&lt;/tns:numeroFittizio>&lt;/xsl:if>&lt;xsl:if test=&quot;DISTRETTO&quot;>&lt;tns:distretto>&lt;xsl:value-of select=&quot;DISTRETTO&quot;/>&lt;/tns:distretto>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICETOPONOMASTICA&quot;>&lt;tns:codiceToponomastica>&lt;xsl:value-of select=&quot;CODICETOPONOMASTICA&quot;/>&lt;/tns:codiceToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;CAP&quot;>&lt;tns:cap>&lt;xsl:value-of select=&quot;CAP&quot;/>&lt;/tns:cap>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROCIVICO&quot;>&lt;tns:numeroCivico>&lt;xsl:value-of select=&quot;NUMEROCIVICO&quot;/>&lt;/tns:numeroCivico>&lt;/xsl:if>&lt;xsl:if test=&quot;COMUNE&quot;>&lt;tns:comune>&lt;xsl:value-of select=&quot;COMUNE&quot;/>&lt;/tns:comune>&lt;/xsl:if>&lt;xsl:if test=&quot;PROVINCIA&quot;>&lt;tns:provincia>&lt;xsl:value-of select=&quot;PROVINCIA&quot;/>&lt;/tns:provincia>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRIZIONEVIA&quot;>&lt;tns:descrizioneVia>&lt;xsl:value-of select=&quot;DESCRIZIONEVIA&quot;/>&lt;/tns:descrizioneVia>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRPARTTOPONOMASTICA&quot;>&lt;tns:descrPartToponomastica>&lt;xsl:value-of select=&quot;DESCRPARTTOPONOMASTICA&quot;/>&lt;/tns:descrPartToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:codificaOloAgcom>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codificaOloAgcom>&lt;/xsl:if>&lt;xsl:for-each-group select=&quot;$Compon_IdRis1/Record/DTTGLSST_TTRBTIDTTGLISST_BDSID&quot; group-by=&quot;.&quot;>&lt;xsl:if test=&quot;../BDS_ID = $Asset_IdRis1/Record[$indexAsset1]/BDS_ID&quot;>&lt;tns:DettaglioAsset>&lt;xsl:variable name=&quot;var_DTTGLSST_TTRBTIDTTGLISST&quot; select=&quot;.&quot;/>&lt;tns:nomeComponente>&lt;xsl:value-of select=&quot;../NOMECOMPONENTE&quot;/>&lt;/tns:nomeComponente>&lt;xsl:for-each select=&quot;$Compon_IdRis1/Record[$var_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/NOMEATTRIBUTO&quot;>&lt;xsl:variable name=&quot;var_NomeAttr&quot; select=&quot;.&quot;/>&lt;tns:AttributiDettaglioAsset>&lt;xsl:if test=&quot;$Compon_IdRis1/Record[$var_NomeAttr = NOMEATTRIBUTO and $var_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/NOMEATTRIBUTO&quot;>&lt;tns:nomeAttributo>&lt;xsl:value-of select=&quot;$Compon_IdRis1/Record[$var_NomeAttr = NOMEATTRIBUTO and $var_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/NOMEATTRIBUTO&quot;/>&lt;/tns:nomeAttributo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Compon_IdRis1/Record[$var_NomeAttr = NOMEATTRIBUTO and $var_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/VALOREATTRIBUTO&quot;>&lt;tns:valoreAttributo>&lt;xsl:value-of select=&quot;$Compon_IdRis1/Record[$var_NomeAttr = NOMEATTRIBUTO and $var_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/VALOREATTRIBUTO&quot;/>&lt;/tns:valoreAttributo>&lt;/xsl:if>&lt;/tns:AttributiDettaglioAsset>&lt;/xsl:for-each>&lt;/tns:DettaglioAsset>&lt;/xsl:if>&lt;/xsl:for-each-group>&lt;/tns:FindAsset>&lt;/xsl:for-each>&lt;/tns:Output_subFindCaseAsset>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:ResponseComplexTypeRichiestaDatiTecnici="http://www.example.org/ResponseComplexTypeRichiestaDatiTecnici"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="ResponseComplexTypeRichiestaDatiTecnici:Output_subFindCaseAsset" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Compon_IdRis1-input"
                    name="Compon_IdRis1" outputVariable="Compon_IdRis1"
                    tibex:xpdlId="6ffaae85-32d0-49eb-a805-b7963475fb9b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
