                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ass.BDS_ID, att.DTTGLSST_TTRBTIDTTGLISST_BDSID, dett.NOMECOMPONENTE, att.NOMEATTRIBUTO, att.VALOREATTRIBUTO&#xd;&#xa;FROM BDS_1_CASEDATA_ASSET ass, BDS_1_CASEDATA_DETTAGLIOASSET dett, BDS_1_CASEDATA_ATTRIBTDTTGLSST att&#xd;&#xa;WHERE ass.BDS_ID = dett.ASSET_DETTAGLIOASSET_BDSID and&#xd;&#xa;&#x9;dett.BDS_ID = att.DTTGLSST_TTRBTIDTTGLISST_BDSID and&#xd;&#xa;&#x9;(ass.IDRISORSA = ? OR ass.NUMEROTELEFONICO = ? OR ass.NUMEROFITTIZIO LIKE ?) AND ass.STATOASSET&lt;>'CESSATO'&#xd;&#xa;ORDER BY att.DTTGLSST_TTRBTIDTTGLISST_BDSID" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRisorsa"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="numerotelefonico"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="numerofittizio"/>
                                    <columnMetadata
                                    columnName="BDS_ID"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DTTGLSST_TTRBTIDTTGLISST_BDSID"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Log_Componenti2-input"
                    name="Log_Componenti2"
                    tibex:xpdlId="5af09c7f-9c2e-4a28-bab8-bc83d265ae51"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQuery1ToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_Componenti2ToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Compon_IdRis2&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_Componenti2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Sub_FindCaseAssetDati'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Log informazioni componenti (2) recuperate: &amp;quot;, tib:render-xml($Compon_IdRis2, true(), true()))&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Mapper_IdRis2-input"
                    name="Mapper_IdRis2" outputVariable="Mapper_IdRis2"
                    tibex:xpdlId="6105042f-afa5-4af9-a2da-7daded291e4f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log_Componenti2ToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Mapper_IdRis2ToEmpty1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ResponseComplexTypeRichiestaDatiTecnici&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Asset_IdRis2&quot;/>&lt;xsl:param name=&quot;Compon_IdRis2&quot;/>&lt;xsl:template name=&quot;Mapper_IdRis2-input&quot; match=&quot;/&quot;>&lt;tns:Output_subFindCaseAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Asset_IdRis2/Record[OFFERTA='NP'])>0 and count($Asset_IdRis2/Record[OFFERTA!='NP'])=0&quot;>&lt;xsl:for-each select=&quot;$Asset_IdRis2/Record[OFFERTA='NP']&quot;>&lt;tns:FindAsset>&lt;xsl:variable name=&quot;bds_id&quot; select=&quot;BDS_ID&quot;/>&lt;xsl:variable name=&quot;indexAsset2&quot; select=&quot;number(position())&quot;/>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:idAsset>&lt;tns:tipologiaAccesso>&lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&lt;/tns:tipologiaAccesso>&lt;tns:idOfferta>&lt;xsl:value-of select=&quot;xsd:int(IDOFFERTA)&quot;/>&lt;/tns:idOfferta>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;tns:statoAsset>&lt;xsl:value-of select=&quot;STATOASSET&quot;/>&lt;/tns:statoAsset>&lt;xsl:if test=&quot;IDRICHIESTAOLO&quot;>&lt;tns:idRichiestaOlo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:idRichiestaOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&lt;tns:numeroTelefonico>&lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&lt;/tns:numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&lt;tns:numeroFittizio>&lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&lt;/tns:numeroFittizio>&lt;/xsl:if>&lt;xsl:if test=&quot;DISTRETTO&quot;>&lt;tns:distretto>&lt;xsl:value-of select=&quot;DISTRETTO&quot;/>&lt;/tns:distretto>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICETOPONOMASTICA&quot;>&lt;tns:codiceToponomastica>&lt;xsl:value-of select=&quot;CODICETOPONOMASTICA&quot;/>&lt;/tns:codiceToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;CAP&quot;>&lt;tns:cap>&lt;xsl:value-of select=&quot;CAP&quot;/>&lt;/tns:cap>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROCIVICO&quot;>&lt;tns:numeroCivico>&lt;xsl:value-of select=&quot;NUMEROCIVICO&quot;/>&lt;/tns:numeroCivico>&lt;/xsl:if>&lt;xsl:if test=&quot;COMUNE&quot;>&lt;tns:comune>&lt;xsl:value-of select=&quot;COMUNE&quot;/>&lt;/tns:comune>&lt;/xsl:if>&lt;xsl:if test=&quot;PROVINCIA&quot;>&lt;tns:provincia>&lt;xsl:value-of select=&quot;PROVINCIA&quot;/>&lt;/tns:provincia>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRIZIONEVIA&quot;>&lt;tns:descrizioneVia>&lt;xsl:value-of select=&quot;DESCRIZIONEVIA&quot;/>&lt;/tns:descrizioneVia>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRPARTTOPONOMASTICA&quot;>&lt;tns:descrPartToponomastica>&lt;xsl:value-of select=&quot;DESCRPARTTOPONOMASTICA&quot;/>&lt;/tns:descrPartToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:codificaOloAgcom>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codificaOloAgcom>&lt;/xsl:if>&lt;xsl:for-each-group select=&quot;$Compon_IdRis2/Record/DTTGLSST_TTRBTIDTTGLISST_BDSID&quot; group-by=&quot;.&quot;>&lt;xsl:if test=&quot;../BDS_ID = $bds_id&quot;>&lt;tns:DettaglioAsset>&lt;xsl:variable name=&quot;var_DTTGLSST_TTRBTIDTTGLISST&quot; select=&quot;.&quot;/>&lt;tns:nomeComponente>&lt;xsl:value-of select=&quot;../NOMECOMPONENTE&quot;/>&lt;/tns:nomeComponente>&lt;xsl:for-each select=&quot;$Compon_IdRis2/Record[$var_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/NOMEATTRIBUTO&quot;>&lt;xsl:variable name=&quot;var_NomeAttr&quot; select=&quot;.&quot;/>&lt;tns:AttributiDettaglioAsset>&lt;xsl:if test=&quot;$Compon_IdRis2/Record[$var_NomeAttr = NOMEATTRIBUTO and $var_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/NOMEATTRIBUTO&quot;>&lt;tns:nomeAttributo>&lt;xsl:value-of select=&quot;$Compon_IdRis2/Record[$var_NomeAttr = NOMEATTRIBUTO and $var_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/NOMEATTRIBUTO&quot;/>&lt;/tns:nomeAttributo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Compon_IdRis2/Record[$var_NomeAttr = NOMEATTRIBUTO and $var_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/VALOREATTRIBUTO&quot;>&lt;tns:valoreAttributo>&lt;xsl:value-of select=&quot;$Compon_IdRis2/Record[$var_NomeAttr = NOMEATTRIBUTO and $var_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/VALOREATTRIBUTO&quot;/>&lt;/tns:valoreAttributo>&lt;/xsl:if>&lt;/tns:AttributiDettaglioAsset>&lt;/xsl:for-each>&lt;/tns:DettaglioAsset>&lt;/xsl:if>&lt;/xsl:for-each-group>&lt;/tns:FindAsset>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$Asset_IdRis2/Record[OFFERTA!='NP']&quot;>&lt;tns:FindAsset>&lt;xsl:variable name=&quot;bds_id2&quot; select=&quot;BDS_ID&quot;/>&lt;xsl:variable name=&quot;indexAss2&quot; select=&quot;number(position())&quot;/>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:idAsset>&lt;tns:tipologiaAccesso>&lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&lt;/tns:tipologiaAccesso>&lt;tns:idOfferta>&lt;xsl:value-of select=&quot;xsd:int(IDOFFERTA)&quot;/>&lt;/tns:idOfferta>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;tns:statoAsset>&lt;xsl:value-of select=&quot;STATOASSET&quot;/>&lt;/tns:statoAsset>&lt;xsl:if test=&quot;IDRICHIESTAOLO&quot;>&lt;tns:idRichiestaOlo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:idRichiestaOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&lt;tns:numeroTelefonico>&lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&lt;/tns:numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&lt;tns:numeroFittizio>&lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&lt;/tns:numeroFittizio>&lt;/xsl:if>&lt;xsl:if test=&quot;DISTRETTO&quot;>&lt;tns:distretto>&lt;xsl:value-of select=&quot;DISTRETTO&quot;/>&lt;/tns:distretto>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICETOPONOMASTICA&quot;>&lt;tns:codiceToponomastica>&lt;xsl:value-of select=&quot;CODICETOPONOMASTICA&quot;/>&lt;/tns:codiceToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;CAP&quot;>&lt;tns:cap>&lt;xsl:value-of select=&quot;CAP&quot;/>&lt;/tns:cap>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROCIVICO&quot;>&lt;tns:numeroCivico>&lt;xsl:value-of select=&quot;NUMEROCIVICO&quot;/>&lt;/tns:numeroCivico>&lt;/xsl:if>&lt;xsl:if test=&quot;COMUNE&quot;>&lt;tns:comune>&lt;xsl:value-of select=&quot;COMUNE&quot;/>&lt;/tns:comune>&lt;/xsl:if>&lt;xsl:if test=&quot;PROVINCIA&quot;>&lt;tns:provincia>&lt;xsl:value-of select=&quot;PROVINCIA&quot;/>&lt;/tns:provincia>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRIZIONEVIA&quot;>&lt;tns:descrizioneVia>&lt;xsl:value-of select=&quot;DESCRIZIONEVIA&quot;/>&lt;/tns:descrizioneVia>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRPARTTOPONOMASTICA&quot;>&lt;tns:descrPartToponomastica>&lt;xsl:value-of select=&quot;DESCRPARTTOPONOMASTICA&quot;/>&lt;/tns:descrPartToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:codificaOloAgcom>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codificaOloAgcom>&lt;/xsl:if>&lt;xsl:for-each-group select=&quot;$Compon_IdRis2/Record/DTTGLSST_TTRBTIDTTGLISST_BDSID&quot; group-by=&quot;.&quot;>&lt;xsl:if test=&quot;../BDS_ID = $bds_id2&quot;>&lt;tns:DettaglioAsset>&lt;xsl:variable name=&quot;var2_DTTGLSST_TTRBTIDTTGLISST&quot; select=&quot;.&quot;/>&lt;tns:nomeComponente>&lt;xsl:value-of select=&quot;../NOMECOMPONENTE&quot;/>&lt;/tns:nomeComponente>&lt;xsl:for-each select=&quot;$Compon_IdRis2/Record[$var2_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/NOMEATTRIBUTO&quot;>&lt;xsl:variable name=&quot;var2_NomeAttr&quot; select=&quot;.&quot;/>&lt;tns:AttributiDettaglioAsset>&lt;xsl:if test=&quot;$Compon_IdRis2/Record[$var2_NomeAttr = NOMEATTRIBUTO and $var2_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/NOMEATTRIBUTO&quot;>&lt;tns:nomeAttributo>&lt;xsl:value-of select=&quot;$Compon_IdRis2/Record[$var2_NomeAttr = NOMEATTRIBUTO and $var2_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/NOMEATTRIBUTO&quot;/>&lt;/tns:nomeAttributo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Compon_IdRis2/Record[$var2_NomeAttr = NOMEATTRIBUTO and $var2_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/VALOREATTRIBUTO&quot;>&lt;tns:valoreAttributo>&lt;xsl:value-of select=&quot;$Compon_IdRis2/Record[$var2_NomeAttr = NOMEATTRIBUTO and $var2_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/VALOREATTRIBUTO&quot;/>&lt;/tns:valoreAttributo>&lt;/xsl:if>&lt;/tns:AttributiDettaglioAsset>&lt;/xsl:for-each>&lt;/tns:DettaglioAsset>&lt;/xsl:if>&lt;/xsl:for-each-group>&lt;/tns:FindAsset>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Output_subFindCaseAsset>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:ResponseComplexTypeRichiestaDatiTecnici="http://www.example.org/ResponseComplexTypeRichiestaDatiTecnici"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="ResponseComplexTypeRichiestaDatiTecnici:Output_subFindCaseAsset" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Log_End-input"
                    name="Log_End"
                    tibex:xpdlId="b6815391-7df6-4abb-af84-8f09f6d52017"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToLog_End"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_EndToCopy_1_Endxxxxxx"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Output&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Sub_FindCaseAssetDati'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('End Sub-Process HAL Sub_FindCaseAsset: ', tib:render-xml($Output, true(), true()))&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Output"
                    name="Assign_Asset" outputVariable="Output"
                    tibex:xpdlId="25cf1bc4-f58d-402a-8b22-a92e422517c8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Mapper_IdRis1ToAssign"/>
                        <bpws:target linkName="Empty1ToAssign_Asset"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLog_End">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Output/tns:FindAsset)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Output/tns:FindAsset)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Assign_AssetToLog_NoAsset">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ResponseComplexTypeRichiestaDatiTecnici&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Mapper_IdRis1&quot;/>&lt;xsl:param name=&quot;Mapper_IdRis2&quot;/>&lt;xsl:param name=&quot;Mapper_IdRis3&quot;/>&lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&lt;tns:Output_subFindCaseAsset>&lt;xsl:if test=&quot;exists($Mapper_IdRis1/tns:FindAsset)&quot;>&lt;xsl:copy-of select=&quot;$Mapper_IdRis1/tns:FindAsset&quot;/>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Mapper_IdRis2/tns:FindAsset)&quot;>&lt;xsl:copy-of select=&quot;$Mapper_IdRis2/tns:FindAsset&quot;/>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Mapper_IdRis3/tns:FindAsset)&quot;>&lt;xsl:copy-of select=&quot;$Mapper_IdRis3/tns:FindAsset&quot;/>&lt;/xsl:if>&lt;/tns:Output_subFindCaseAsset>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Output" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Asset_IdRis2-input"
                    name="Asset_IdRis2" outputVariable="Asset_IdRis2"
                    tibex:xpdlId="5798ca40-c000-44a1-b1bb-c4f0762a3f06" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToAsset_IdRis2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Asset_Name">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5798ca40-c000-44a1-b1bb-c4f0762a3f06+input&quot; xmlns:tns=&quot;http://www.example.org/ResponseComplexTypeRichiestaDatiTecnici&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Asset_IdRis2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idrisorsa>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:IdRisorsa&quot;/>&#xa;            &lt;/idrisorsa>&#xa;            &lt;numerotelefonico>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:IdRisorsa&quot;/>&#xa;            &lt;/numerotelefonico>&#xa;            &lt;numerofittizio>&#xa;                &lt;xsl:value-of select=&quot;concat($Start/tns:IdRisorsa, '%')&quot;/>&#xa;            &lt;/numerofittizio>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ASS.BDS_ID, ASS.IDRISORSA, ASS.IDASSET, ASS.OFFERTA, ASS.IDOFFERTA, ASS.TIPOLOGIAACCESSO, ASS.STATOASSET, ASS.IDRICHIESTAOLO, ASS.NUMEROTELEFONICO, ASS.NUMEROFITTIZIO, ASS.DISTRETTO, ASS.CODICETOPONOMASTICA, ASS.CAP, ASS.NUMEROCIVICO, ASS.COMUNE, ASS.PROVINCIA, &#xa;    ASS.DESCRIZIONEVIA, ASS.DESCRPARTTOPONOMASTICA, ASS.CODIFICAOLOAGCOM&#xa;    FROM BDS_1_CASEDATA_ASSET ASS&#xa;    WHERE (ASS.IDRISORSA = ? or ASS.NUMEROTELEFONICO = ? or ASS.NUMEROFITTIZIO LIKE ?) AND ASS.STATOASSET&lt;>'CESSATO'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idrisorsa"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="numerotelefonico"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="numerofittizio"/>
                                    <columnMetadata
                                    columnName="BDS_ID"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDOFFERTA"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIPOLOGIAACCESSO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATOASSET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROTELEFONICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROFITTIZIO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DISTRETTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICETOPONOMASTICA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnName="CAP"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROCIVICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="COMUNE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="PROVINCIA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONEVIA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRPARTTOPONOMASTICA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="d26e1607-d087-4107-a447-4722a11098fe"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToAsset_IdRis2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInputToAsset_IdRisorsastartswithU">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($Start/tns:IdRisorsa, 'U')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[starts-with($Start/tns:IdRisorsa, 'U')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Sub_FindCaseAssetDati'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Start Sub-Process HAL Sub_FindCaseAsset: ', tib:render-xml($Start,true(),true()))&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogQuery2-input"
                    name="LogQuery2"
                    tibex:xpdlId="48aa0451-ccf2-4295-8e6a-2cca9dda1e24"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Asset_Name"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogQuery2ToCompon_IdRis2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogQuery2ToNormalizzaIdRisorsa_Norecord">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Asset_IdRis2/Record)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Asset_IdRis2/Record)=0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Asset_IdRis2&quot;/>&#xa;    &lt;xsl:template name=&quot;LogQuery2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Sub_FindCaseAssetDati'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Log informazioni recuperate da asset: &amp;quot;, tib:render-xml($Asset_IdRis2, true(), true()))&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Log_NoQuery-input"
                    name="Log_NoQuery"
                    tibex:xpdlId="21b26e15-55cd-43df-91e5-3e09dd5e52b1"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Assign_AssetToLog_NoAsset"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_NoQueryToCopy_1_Endxxxxxx"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_NoQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Sub_FindCaseAssetDati'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Nessun risultato recuperato.&amp;quot;&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="83129bf6-42f0-4c99-bd11-1b2542939ec8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log_EndToCopy_1_Endxxxxxx"/>
                        <bpws:target linkName="Log_NoQueryToCopy_1_Endxxxxxx"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ResponseComplexTypeRichiestaDatiTecnici&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Output&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Output/tns:FindAsset)&quot;>&lt;tns:Output_subFindCaseAsset>&lt;xsl:copy-of select=&quot;$Output/tns:FindAsset&quot;/>&lt;/tns:Output_subFindCaseAsset>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Output_subFindCaseAsset/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="0929842f-bc75-4869-9c9c-ab4c7e84ec60">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToAsset_IdRis2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToAsset_IdRis2"/>
                </bpws:sources>
            </bpws:empty>
            <bpws:empty name="Empty1" tibex:xpdlId="da2b04c0-570d-48f0-ac65-693fadc27c58">
                <bpws:targets>
                    <bpws:target linkName="Mapper_IdRis2ToEmpty1"/>
                    <bpws:target linkName="Mapper_IdRis3ToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToAssign_Asset"/>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="IdRisorsaNormalizzato"
                    name="NormalizzaIdRisorsa"
                    outputVariable="IdRisorsaNormalizzato"
                    tibex:xpdlId="202a14c9-91b9-4c6e-93dd-c0f5a94922a0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogQuery2ToNormalizzaIdRisorsa_Norecord"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="NormalizzaIdRisorsaToAsset_IdRis3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (substring($Start/tns:IdRisorsa, 2, 1)=('2','6')) then concat('0', $Start/tns:IdRisorsa) else if (substring($Start/tns:IdRisorsa, 3, 1)=('0','1','5','9')) then $Start/tns:IdRisorsa else substring($Start/tns:IdRisorsa, 2)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="IdRisorsaNormalizzato" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Asset_IdRis3-input"
                    name="Asset_IdRis3" outputVariable="Asset_IdRis3"
                    tibex:xpdlId="750098f2-8776-4e39-8ca0-2c62dfc9cc39" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="NormalizzaIdRisorsaToAsset_IdRis3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Asset_IdRis3ToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+750098f2-8776-4e39-8ca0-2c62dfc9cc39+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IdRisorsaNormalizzato&quot;/>&#xa;    &lt;xsl:template name=&quot;Asset_IdRis3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idrisorsa>&#xa;                &lt;xsl:value-of select=&quot;$IdRisorsaNormalizzato&quot;/>&#xa;            &lt;/idrisorsa>&#xa;            &lt;numerotelefonico>&#xa;                &lt;xsl:value-of select=&quot;$IdRisorsaNormalizzato&quot;/>&#xa;            &lt;/numerotelefonico>&#xa;            &lt;numerofittizio>&#xa;                &lt;xsl:value-of select=&quot;concat($IdRisorsaNormalizzato, '%')&quot;/>&#xa;            &lt;/numerofittizio>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ASS.BDS_ID, ASS.IDRISORSA, ASS.IDASSET, ASS.OFFERTA, ASS.IDOFFERTA, ASS.TIPOLOGIAACCESSO, ASS.STATOASSET, ASS.IDRICHIESTAOLO, ASS.NUMEROTELEFONICO, ASS.NUMEROFITTIZIO, ASS.DISTRETTO, ASS.CODICETOPONOMASTICA, ASS.CAP, ASS.NUMEROCIVICO, ASS.COMUNE, ASS.PROVINCIA, &#xa;    ASS.DESCRIZIONEVIA, ASS.DESCRPARTTOPONOMASTICA, ASS.CODIFICAOLOAGCOM&#xa;    FROM BDS_1_CASEDATA_ASSET ASS&#xa;    WHERE (ASS.IDRISORSA = ? or ASS.NUMEROTELEFONICO = ? or ASS.NUMEROFITTIZIO LIKE ?) AND ASS.STATOASSET&lt;>'CESSATO'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idrisorsa"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="numerotelefonico"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="numerofittizio"/>
                                    <columnMetadata
                                    columnName="BDS_ID"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDOFFERTA"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIPOLOGIAACCESSO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATOASSET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROTELEFONICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROFITTIZIO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DISTRETTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICETOPONOMASTICA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnName="CAP"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROCIVICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="COMUNE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="PROVINCIA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONEVIA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRPARTTOPONOMASTICA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogQuery3-input"
                    name="LogQuery3"
                    tibex:xpdlId="b49473a4-153d-49b4-a883-681b52b0f7e9"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Asset_IdRis3ToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogQuery3ToCompon_IdRis3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Asset_IdRis3&quot;/>&#xa;    &lt;xsl:template name=&quot;LogQuery3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Sub_FindCaseAssetDati'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Log informazioni recuperate da asset: &amp;quot;, tib:render-xml($Asset_IdRis3, true(), true()))&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Compon_IdRis3-input"
                    name="Compon_IdRis3" outputVariable="Compon_IdRis3"
                    tibex:xpdlId="73de3b82-172a-4238-b261-ebfc934f6a5b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogQuery3ToCompon_IdRis3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Compon_IdRis3ToLog_Componenti3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+73de3b82-172a-4238-b261-ebfc934f6a5b+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IdRisorsaNormalizzato&quot;/>&#xa;    &lt;xsl:template name=&quot;Compon_IdRis3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idRisorsa>&#xa;                &lt;xsl:value-of select=&quot;$IdRisorsaNormalizzato&quot;/>&#xa;            &lt;/idRisorsa>&#xa;            &lt;numerotelefonico>&#xa;                &lt;xsl:value-of select=&quot;$IdRisorsaNormalizzato&quot;/>&#xa;            &lt;/numerotelefonico>&#xa;            &lt;numerofittizio>&#xa;                &lt;xsl:value-of select=&quot;concat($IdRisorsaNormalizzato, '%')&quot;/>&#xa;            &lt;/numerofittizio>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ass.BDS_ID, att.DTTGLSST_TTRBTIDTTGLISST_BDSID, dett.NOMECOMPONENTE, att.NOMEATTRIBUTO, att.VALOREATTRIBUTO&#xd;&#xa;FROM BDS_1_CASEDATA_ASSET ass, BDS_1_CASEDATA_DETTAGLIOASSET dett, BDS_1_CASEDATA_ATTRIBTDTTGLSST att&#xd;&#xa;WHERE ass.BDS_ID = dett.ASSET_DETTAGLIOASSET_BDSID and&#xd;&#xa;&#x9;dett.BDS_ID = att.DTTGLSST_TTRBTIDTTGLISST_BDSID and&#xd;&#xa;&#x9;(ass.IDRISORSA = ? OR ass.NUMEROTELEFONICO = ? OR ass.NUMEROFITTIZIO LIKE ?) AND ass.STATOASSET&lt;>'CESSATO'&#xd;&#xa;ORDER BY att.DTTGLSST_TTRBTIDTTGLISST_BDSID" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRisorsa"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="numerotelefonico"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="numerofittizio"/>
                                    <columnMetadata
                                    columnName="BDS_ID"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DTTGLSST_TTRBTIDTTGLISST_BDSID"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Log_Componenti3-input"
                    name="Log_Componenti3"
                    tibex:xpdlId="ab287997-4381-4fdb-9044-e7216f5532eb"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Compon_IdRis3ToLog_Componenti3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_Componenti3ToCopy_1_Mapper_IdRis2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Compon_IdRis3&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_Componenti3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Sub_FindCaseAssetDati'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Log informazioni componenti (2) recuperate: &amp;quot;, tib:render-xml($Compon_IdRis3, true(), true()))&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Mapper_IdRis3-input"
                    name="Mapper_IdRis3" outputVariable="Mapper_IdRis3"
                    tibex:xpdlId="bd4d70b2-2081-42e8-bcd1-89d794176385" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log_Componenti3ToCopy_1_Mapper_IdRis2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Mapper_IdRis3ToEmpty1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ResponseComplexTypeRichiestaDatiTecnici&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Asset_IdRis3&quot;/>&lt;xsl:param name=&quot;Compon_IdRis3&quot;/>&lt;xsl:template name=&quot;Mapper_IdRis3-input&quot; match=&quot;/&quot;>&lt;tns:Output_subFindCaseAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Asset_IdRis3/Record[OFFERTA='NP'])>0 and count($Asset_IdRis3/Record[OFFERTA!='NP'])=0&quot;>&lt;xsl:for-each select=&quot;$Asset_IdRis3/Record[OFFERTA='NP']&quot;>&lt;tns:FindAsset>&lt;xsl:variable name=&quot;bds_id3&quot; select=&quot;BDS_ID&quot;/>&lt;xsl:variable name=&quot;indexAsset3&quot; select=&quot;number(position())&quot;/>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:idAsset>&lt;tns:tipologiaAccesso>&lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&lt;/tns:tipologiaAccesso>&lt;tns:idOfferta>&lt;xsl:value-of select=&quot;xsd:int(IDOFFERTA)&quot;/>&lt;/tns:idOfferta>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;tns:statoAsset>&lt;xsl:value-of select=&quot;STATOASSET&quot;/>&lt;/tns:statoAsset>&lt;xsl:if test=&quot;IDRICHIESTAOLO&quot;>&lt;tns:idRichiestaOlo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:idRichiestaOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&lt;tns:numeroTelefonico>&lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&lt;/tns:numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&lt;tns:numeroFittizio>&lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&lt;/tns:numeroFittizio>&lt;/xsl:if>&lt;xsl:if test=&quot;DISTRETTO&quot;>&lt;tns:distretto>&lt;xsl:value-of select=&quot;DISTRETTO&quot;/>&lt;/tns:distretto>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICETOPONOMASTICA&quot;>&lt;tns:codiceToponomastica>&lt;xsl:value-of select=&quot;CODICETOPONOMASTICA&quot;/>&lt;/tns:codiceToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;CAP&quot;>&lt;tns:cap>&lt;xsl:value-of select=&quot;CAP&quot;/>&lt;/tns:cap>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROCIVICO&quot;>&lt;tns:numeroCivico>&lt;xsl:value-of select=&quot;NUMEROCIVICO&quot;/>&lt;/tns:numeroCivico>&lt;/xsl:if>&lt;xsl:if test=&quot;COMUNE&quot;>&lt;tns:comune>&lt;xsl:value-of select=&quot;COMUNE&quot;/>&lt;/tns:comune>&lt;/xsl:if>&lt;xsl:if test=&quot;PROVINCIA&quot;>&lt;tns:provincia>&lt;xsl:value-of select=&quot;PROVINCIA&quot;/>&lt;/tns:provincia>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRIZIONEVIA&quot;>&lt;tns:descrizioneVia>&lt;xsl:value-of select=&quot;DESCRIZIONEVIA&quot;/>&lt;/tns:descrizioneVia>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRPARTTOPONOMASTICA&quot;>&lt;tns:descrPartToponomastica>&lt;xsl:value-of select=&quot;DESCRPARTTOPONOMASTICA&quot;/>&lt;/tns:descrPartToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:codificaOloAgcom>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codificaOloAgcom>&lt;/xsl:if>&lt;xsl:for-each-group select=&quot;$Compon_IdRis3/Record/DTTGLSST_TTRBTIDTTGLISST_BDSID&quot; group-by=&quot;.&quot;>&lt;xsl:if test=&quot;../BDS_ID = $bds_id3&quot;>&lt;tns:DettaglioAsset>&lt;xsl:variable name=&quot;var3_DTTGLSST_TTRBTIDTTGLISST&quot; select=&quot;.&quot;/>&lt;tns:nomeComponente>&lt;xsl:value-of select=&quot;../NOMECOMPONENTE&quot;/>&lt;/tns:nomeComponente>&lt;xsl:for-each select=&quot;$Compon_IdRis3/Record[$var3_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/NOMEATTRIBUTO&quot;>&lt;xsl:variable name=&quot;var3_NomeAttr&quot; select=&quot;.&quot;/>&lt;tns:AttributiDettaglioAsset>&lt;xsl:if test=&quot;$Compon_IdRis3/Record[$var3_NomeAttr = NOMEATTRIBUTO and $var3_DTTGLSST_TTRBTIDTTGLISST = DTTGLSST_TTRBTIDTTGLISST_BDSID]/NOMEATTRIBUTO&quot;>&lt;tns:nomeAttributo>&lt;xsl:value-of select=&quot;$Compon_