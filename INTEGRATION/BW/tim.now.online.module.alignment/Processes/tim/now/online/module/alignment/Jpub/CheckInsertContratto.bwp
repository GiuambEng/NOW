        <bpws:variable element="ns0:Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:currentElement" name="Current"/>
        <bpws:variable name="Check" type="xsd:string"/>
        <bpws:variable name="Counter" type="xsd:integer">
            <bpws:from>
                <bpws:literal>1</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns2:CONTRATTI" name="Validate-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:CONTRATTI" name="Validate" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:root" name="Input-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:root" name="Input" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogError-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:jdbcUpdateActivityInput"
            name="Insert-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:jdbcUpdateActivityOutput"
            name="Insert" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns6:AccumulatedOutput" name="Accumulate" sca-bpel:internal="true"/>
        <bpws:variable name="Application" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/Application" type="xsd:string"/>
        <bpws:variable name="LoggerName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable name="LoggerLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerLevel" type="xsd:string"/>
        <bpws:variable name="ErrorLoggerLevel"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Log/ErrorLoggerLevel" type="xsd:string"/>
        <bpws:variable name="OK_ELAB_STAG" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/OKElabStaging" type="xsd:int"/>
        <bpws:variable name="KO_ELAB_STAG" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/KOElabStaging" type="xsd:int"/>
        <bpws:variable element="ns3:Output" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="TimeOut" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/JDBC/TimeOut" type="xsd:int"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogValidate-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="1aca13c9-57be-4dd9-8a20-2d5e1c849a6c"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToWhile"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="f5e15a3b-7fa0-4fce-ba56-8ea0b49b8d7b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tim.now.alignement.Jpub.adapter.Contratto.interProcess.OnLine.input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;xsl:for-each select=&quot;$Accumulate/tns:root[tns:AnagraficaContratto/tns:Status='OK']&quot;>&lt;tns:Output_Contratto>&lt;xsl:if test=&quot;tns:AnagraficaContratto/tns:CODE_CONTR&quot;>&lt;tns:CODE_CONTR>&lt;xsl:value-of select=&quot;tns:AnagraficaContratto/tns:CODE_CONTR&quot;/>&lt;/tns:CODE_CONTR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AnagraficaContratto/tns:CODE_TIPO_CONTR&quot;>&lt;tns:CODE_TIPO_CONTR>&lt;xsl:value-of select=&quot;tns:AnagraficaContratto/tns:CODE_TIPO_CONTR&quot;/>&lt;/tns:CODE_TIPO_CONTR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AnagraficaContratto/tns:CODE_GEST&quot;>&lt;tns:CODE_GEST>&lt;xsl:value-of select=&quot;tns:AnagraficaContratto/tns:CODE_GEST&quot;/>&lt;/tns:CODE_GEST>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AnagraficaContratto/tns:DESC_CONTR&quot;>&lt;tns:DESC_CONTR>&lt;xsl:value-of select=&quot;tns:AnagraficaContratto/tns:DESC_CONTR&quot;/>&lt;/tns:DESC_CONTR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AnagraficaContratto/tns:DATA_SCAD_CONTR&quot;>&lt;tns:DATA_SCAD_CONTR>&lt;xsl:value-of select=&quot;tns:AnagraficaContratto/tns:DATA_SCAD_CONTR&quot;/>&lt;/tns:DATA_SCAD_CONTR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AnagraficaContratto/tns:DATA_STIP_CONTR&quot;>&lt;tns:DATA_STIP_CONTR>&lt;xsl:value-of select=&quot;tns:AnagraficaContratto/tns:DATA_STIP_CONTR&quot;/>&lt;/tns:DATA_STIP_CONTR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AnagraficaContratto/tns:DATA_INIZIO_VALID&quot;>&lt;tns:DATA_INIZIO_VALID>&lt;xsl:value-of select=&quot;tns:AnagraficaContratto/tns:DATA_INIZIO_VALID&quot;/>&lt;/tns:DATA_INIZIO_VALID>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AnagraficaContratto/tns:DATA_FINE_VALID&quot;>&lt;tns:DATA_FINE_VALID>&lt;xsl:value-of select=&quot;tns:AnagraficaContratto/tns:DATA_FINE_VALID&quot;/>&lt;/tns:DATA_FINE_VALID>&lt;/xsl:if>&lt;/tns:Output_Contratto>&lt;/xsl:for-each>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="1c5d0f83-ba28-4cc0-a4ac-7cc812fc6c8f">
                <bpws:targets>
                    <bpws:target linkName="StartToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+20c09309-bf6c-434e-ab0b-7f7f9cd91e1d" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Counter &lt;= count($Start/ns0:Contratto)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Counter <= count($Start/ns0:Contratto)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="CurrentToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ValidateToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ValidateToAssign" tibex:linkType="ERROR"/>
                                <bpws:link name="InputToJDBCUpdate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CheckErrorToLogError" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogErrorToInput" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InsertToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToCurrent" tibex:linkType="SUCCESS"/>
                                <bpws:link name="SetCheckToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToInput" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="655067c2-166d-4d1c-abad-ca920b0b944b">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToCurrent"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="20c09309-bf6c-434e-ab0b-7f7f9cd91e1d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SetCheckToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Input</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Current"
                                    name="Current"
                                    outputVariable="Current"
                                    tibex:xpdlId="485dee60-0919-4cc2-ad97-c515b9a46f17" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCurrent"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CurrentToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.telecom.Now.outputtriggerContratto.onLine&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Counter&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Current&quot; match=&quot;/&quot;>&lt;ns:currentElement>&lt;ns:Contratto>&lt;xsl:if test=&quot;$Start/ns:Contratto[number($Counter)]/ns:COD_CONTRATTO&quot;>&lt;ns:COD_CONTRATTO>&lt;xsl:value-of select=&quot;$Start/ns:Contratto[number($Counter)]/ns:COD_CONTRATTO&quot;/>&lt;/ns:COD_CONTRATTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Contratto[number($Counter)]/ns:COD_OFFERTA_JPUB&quot;>&lt;ns:COD_OFFERTA_JPUB>&lt;xsl:value-of select=&quot;$Start/ns:Contratto[number($Counter)]/ns:COD_OFFERTA_JPUB&quot;/>&lt;/ns:COD_OFFERTA_JPUB>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Contratto[number($Counter)]/ns:COD_OLO_AGCOM&quot;>&lt;ns:COD_OLO_AGCOM>&lt;xsl:value-of select=&quot;$Start/ns:Contratto[number($Counter)]/ns:COD_OLO_AGCOM&quot;/>&lt;/ns:COD_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Contratto[number($Counter)]/ns:DESCRIZIONE&quot;>&lt;ns:DESCRIZIONE>&lt;xsl:value-of select=&quot;$Start/ns:Contratto[number($Counter)]/ns:DESCRIZIONE&quot;/>&lt;/ns:DESCRIZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Contratto[number($Counter)]/ns:NOME_CONTRATTO&quot;>&lt;ns:NOME_CONTRATTO>&lt;xsl:value-of select=&quot;$Start/ns:Contratto[number($Counter)]/ns:NOME_CONTRATTO&quot;/>&lt;/ns:NOME_CONTRATTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Contratto[number($Counter)]/ns:DATAFI_VALID&quot;>&lt;ns:DATAFI_VALID>&lt;xsl:value-of select=&quot;$Start/ns:Contratto[number($Counter)]/ns:DATAFI_VALID&quot;/>&lt;/ns:DATAFI_VALID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Contratto[number($Counter)]/ns:DATAIN_VALID&quot;>&lt;ns:DATAIN_VALID>&lt;xsl:value-of select=&quot;$Start/ns:Contratto[number($Counter)]/ns:DATAIN_VALID&quot;/>&lt;/ns:DATAIN_VALID>&lt;/xsl:if>&lt;/ns:Contratto>&lt;/ns:currentElement>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Current" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Validate-input"
                                    name="Validate"
                                    outputVariable="Validate"
                                    tibex:xpdlId="ea37e361-0cf4-4f98-a364-9356e1c7a0e2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CurrentToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ValidateToCallProcess"/>
                                    <bpws:source
                                    linkName="ValidateToAssign"
                                    tibex:faultDetailsVar="Validate" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; xmlns:ns=&quot;www.telecom.Now.outputtriggerContratto.onLine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Current&quot;/>&lt;xsl:template name=&quot;Validate-input&quot; match=&quot;/&quot;>&lt;tns:CONTRATTI>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;$Current/ns:Contratto/ns:COD_CONTRATTO&quot;/>&lt;/CODE_CONTR>&lt;CODE_TIPO_CONTR>&lt;xsl:value-of select=&quot;$Current/ns:Contratto/ns:COD_OFFERTA_JPUB&quot;/>&lt;/CODE_TIPO_CONTR>&lt;CODE_GEST>&lt;xsl:value-of select=&quot;$Current/ns:Contratto/ns:COD_OLO_AGCOM&quot;/>&lt;/CODE_GEST>&lt;DESC_CONTR>&lt;xsl:value-of select=&quot;$Current/ns:Contratto/ns:NOME_CONTRATTO&quot;/>&lt;/DESC_CONTR>&lt;DATA_SCAD_CONTR>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/DATA_SCAD_CONTR>&lt;DATA_STIP_CONTR>&lt;xsl:value-of select=&quot;xsd:dateTime($Current/ns:Contratto/ns:DATAIN_VALID)&quot;/>&lt;/DATA_STIP_CONTR>&lt;DATA_INIZIO_VALID>&lt;xsl:value-of select=&quot;xsd:dateTime($Current/ns:Contratto/ns:DATAIN_VALID)&quot;/>&lt;/DATA_INIZIO_VALID>&lt;DATA_FINE_VALID>&lt;xsl:value-of select=&quot;$Current/ns:Contratto/ns:DATAFI_VALID&quot;/>&lt;/DATA_FINE_VALID>&lt;xsl:if test=&quot;$Current/ns:Contratto/ns:DATA_COINV&quot;>&lt;DATA_COINV>&lt;xsl:value-of select=&quot;$Current/ns:Contratto/ns:DATA_COINV&quot;/>&lt;/DATA_COINV>&lt;/xsl:if>&lt;/tns:CONTRATTI>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:AggiornamentoMassiveAnagrafiche_Input="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="AggiornamentoMassiveAnagrafiche_Input:CONTRATTI" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Input-input"
                                    name="Input" outputVariable="Input"
                                    tibex:xpdlId="8db46003-225a-4bfd-8241-fe6d0a423464" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogErrorToInput"/>
                                    <bpws:target linkName="CallProcessToInput"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InputToJDBCUpdate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
