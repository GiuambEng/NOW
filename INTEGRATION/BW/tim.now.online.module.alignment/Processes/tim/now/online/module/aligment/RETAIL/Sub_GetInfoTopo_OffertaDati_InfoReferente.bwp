_DATI&quot;/>&lt;/tns:OFFERTA>&lt;/xsl:if>&lt;xsl:if test=&quot;$GetOffertaDati/Record[1]/IDRICHIESTAOLO_DATI&quot;>&lt;tns:IDRICHIESTAOLO>&lt;xsl:value-of select=&quot;$GetOffertaDati/Record[1]/IDRICHIESTAOLO_DATI&quot;/>&lt;/tns:IDRICHIESTAOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$GetReferente/Record[1]/NOMEREFERENTE&quot;>&lt;tns:NOMEREFERENTE>&lt;xsl:value-of select=&quot;$GetReferente/Record[1]/NOMEREFERENTE&quot;/>&lt;/tns:NOMEREFERENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;$GetReferente/Record[1]/COGNOMEREFERENTE&quot;>&lt;tns:COGNOMEREFERENTE>&lt;xsl:value-of select=&quot;$GetReferente/Record[1]/COGNOMEREFERENTE&quot;/>&lt;/tns:COGNOMEREFERENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;$GetReferente/Record[1]/TELEFONOMOBILEREFERENTE&quot;>&lt;tns:TELEFONOMOBILEREFERENTE>&lt;xsl:value-of select=&quot;$GetReferente/Record[1]/TELEFONOMOBILEREFERENTE&quot;/>&lt;/tns:TELEFONOMOBILEREFERENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;$GetReferente/Record[1]/TELEFONOFISSOREFERENTE&quot;>&lt;tns:TELEFONOFISSOREFERENTE>&lt;xsl:value-of select=&quot;$GetReferente/Record[1]/TELEFONOFISSOREFERENTE&quot;/>&lt;/tns:TELEFONOFISSOREFERENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;$GetReferente/Record[1]/QUALIFICAREFERENTE&quot;>&lt;tns:QUALIFICAREFERENTE>&lt;xsl:value-of select=&quot;$GetReferente/Record[1]/QUALIFICAREFERENTE&quot;/>&lt;/tns:QUALIFICAREFERENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;$GetReferente/Record[1]/TIPOREFERENTEORDINE&quot;>&lt;tns:TIPOREFERENTEORDINE>&lt;xsl:value-of select=&quot;$GetReferente/Record[1]/TIPOREFERENTEORDINE&quot;/>&lt;/tns:TIPOREFERENTEORDINE>&lt;/xsl:if>&lt;/tns:Out_GetInfo>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
