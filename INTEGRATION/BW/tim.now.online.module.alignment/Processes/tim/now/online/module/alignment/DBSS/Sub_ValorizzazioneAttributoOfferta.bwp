    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/tim.now.xsd.ValorizzazioneAttributoOfferta"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:TrascodificaOfferta_Input"
            name="Start" sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:TrascodificaOfferta_Output"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="ServiceName" type="xsd:string"/>
        <bpws:variable element="ns1:jdbcQueryActivityInput"
            name="FindIDOfferta-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:resultSet" name="FindIDOfferta" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns3:jdbcQueryActivityInput"
            name="FindServiceName-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:resultSet" name="FindServiceName" sca-bpel:internal="true"/>
        <bpws:variable name="TimeOut" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/JDBC/TimeOut" type="xsd:int"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckFlagToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ServiceVULAFTTHToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="FindIDOffertaToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckFlagToJDBCQuery" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="FindServiceNameToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="ServiceSLU_ULLToFindIDOfferta" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="a3950066-d548-4811-bcea-e61b13f2ef22"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEnd"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="21360af6-8db2-4cd4-923b-f7e413f8cffc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FindIDOffertaToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.xsd.ValorizzazioneAttributoOfferta&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FindIDOfferta&quot;/>&lt;xsl:param name=&quot;ServiceName&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:TrascodificaOfferta_Output>&lt;tns:ID_OFFERTA>&lt;xsl:value-of select=&quot;xsd:integer($FindIDOfferta/Record[1]/ID_OFFERTA)&quot;/>&lt;/tns:ID_OFFERTA>&lt;tns:NOME_OFFERTA>&lt;xsl:value-of select=&quot;if( $FindIDOfferta/Record[1]/OFFERTA= 'ULL LINEA NON ATTIVA') then 'ULLLINEANONATTIVA' else if( $FindIDOfferta/Record[1]/OFFERTA= 'SLU LINEA NON ATTIVA') then 'SLULINEANONATTIVA' else 'VULAFTTH'&quot;/>&lt;/tns:NOME_OFFERTA>&lt;tns:NOME_COMPONENTE>&lt;xsl:value-of select=&quot;if( $ServiceName='ULL_LNA' ) then 'ACCESSOULL'&amp;#xD;&amp;#xA;else if ($ServiceName='SLU_LNA') then 'ACCESSOSLU'&amp;#xD;&amp;#xA;else 'ACCESSOVULAFTTH'&quot;/>&lt;/tns:NOME_COMPONENTE>&lt;/tns:TrascodificaOfferta_Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="CheckFlag" tibex:xpdlId="ffdf9d79-5f13-4422-a04a-0be8ba0b70da">
                <bpws:targets>
                    <bpws:target linkName="StartToEnd"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckFlagToAssign">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:FLAG_FTTH='Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:FLAG_FTTH='Y']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckFlagToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ServiceName"
                    name="ServiceVULAFTTH" outputVariable="ServiceName"
                    tibex:xpdlId="48f1de36-b23b-4de6-b9fb-532797c7fb76" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckFlagToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ServiceVULAFTTHToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="'VULAFTTH'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="ServiceName" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="FindIDOfferta-input"
                    name="FindIDOfferta" outputVariable="FindIDOfferta"
                    tibex:xpdlId="ab061e7d-7355-4c2a-b7c7-df74385daf97" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ServiceVULAFTTHToJDBCQuery"/>
                        <bpws:target linkName="ServiceSLU_ULLToFindIDOfferta"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FindIDOffertaToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ab061e7d-7355-4c2a-b7c7-df74385daf97+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ServiceName&quot;/>&lt;xsl:template name=&quot;FindIDOfferta-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;$ServiceName&quot;/>&lt;/NOME_OFFERTA_ESTERNA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select t.id_offerta, a.offerta from TRASCODFC_OFFERTA t, OFFERTA a&#xd;&#xa;where t.NOME_OFFERTA_ESTERNA=? and t.PROVENIENZA='RETAIL'&#xd;&#xa;and&#xd;&#xa;t.id_offerta=a.id_offerta"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <columnMetadata
                                    columnName="ID_OFFERTA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="FindServiceName-input"
                    name="FindServiceName"
                    outputVariable="FindServiceName"
                    tibex:xpdlId="d6f78bfb-acf2-43ca-8020-7d78f6e84c8f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckFlagToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FindServiceNameToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d6f78bfb-acf2-43ca-8020-7d78f6e84c8f+input&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.xsd.ValorizzazioneAttributoOfferta&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;FindServiceName-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_RISORSA>&lt;xsl:value-of select=&quot;$Start/tns1:ID_RISORSA&quot;/>&lt;/ID_RISORSA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select dec_attivazione, dec_cessazione from ANAG_UNICARA_SLU where ID_RISORSA_UNICA_RA=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>
                                    <columnMetadata
                                    columnName="DEC_ATTIVAZIONE"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DEC_CESSAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ServiceName"
                    name="ServiceSLU_ULL" outputVariable="ServiceName"
                    tibex:xpdlId="acd89699-b273-4ce3-b175-3c9c5f89228d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FindServiceNameToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ServiceSLU_ULLToFindIDOfferta"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (string-length(string($FindServiceName/Record[1]/DEC_CESSAZIONE))>0 or count($FindServiceName/Record)=0) then 'ULL_LNA' else if (string-length(string($FindServiceName/Record[1]/DEC_ATTIVAZIONE))>0 and count($FindServiceName/Record)>0) then 'SLU_LNA' else ''" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="ServiceName" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
