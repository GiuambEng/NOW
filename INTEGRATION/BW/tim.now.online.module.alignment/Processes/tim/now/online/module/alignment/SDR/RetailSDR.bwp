                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SDR_LAV_RETAIL/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RetailSDRIn.Request&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;upper-case($RetailSDRIn.Request/tns:TESTATA/tns:LAVORAZIONE)='SPOSTAMENTO_CPS'  and (string-length($RetailSDRIn.Request/tns:CPS/tns:DN_OLD)=0 or string-length($RetailSDRIn.Request/tns:CPS/tns:DN_OLD)&amp;lt;6)&quot;>&#xa;                &lt;tns:Response>&#xa;                    &lt;tns:DN>&#xa;                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                    &lt;/tns:DN>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                    &lt;tns:DESCRIZIONE_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'INCONGRUENZA TRA PARAMETRI IN INPUT'&quot;/>&#xa;                    &lt;/tns:DESCRIZIONE_ESITO>&#xa;                &lt;/tns:Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;upper-case($RetailSDRIn.Request/tns:TESTATA/tns:LAVORAZIONE)='CESSAZIONE_CPS'  and $RetailSDRIn.Request/tns:TESTATA/tns:SOTTO_LAVORAZIONE!='01' and $RetailSDRIn.Request/tns:TESTATA/tns:SOTTO_LAVORAZIONE!='02' and $RetailSDRIn.Request/tns:TESTATA/tns:SOTTO_LAVORAZIONE!='03' and $RetailSDRIn.Request/tns:TESTATA/tns:SOTTO_LAVORAZIONE!='04' &quot;>&#xa;                &lt;tns:Response>&#xa;                    &lt;tns:DN>&#xa;                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                    &lt;/tns:DN>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;K