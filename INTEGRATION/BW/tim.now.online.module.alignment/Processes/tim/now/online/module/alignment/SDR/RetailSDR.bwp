                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SDR_LAV_RETAIL/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RetailSDRIn.Request&quot;/>&#xa;    &lt;xsl:param name=&quot;CaseType&quot;/>&#xa;    &lt;xsl:param name=&quot;CaseModel&quot;/>&#xa;    &lt;xsl:template name=&quot;FindAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Find>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:caseModelVersion>&#xa;                        &lt;xsl:value-of select=&quot;$CaseModel&quot;/>&#xa;                    &lt;/tns:caseModelVersion>&#xa;                    &lt;tns:caseType>&#xa;                        &lt;xsl:value-of select=&quot;$CaseType&quot;/>&#xa;                    &lt;/tns:caseType>&#xa;                    &lt;tns:Criteria>&#xa;                        &lt;tns:queryString>&#xa;                            &lt;xsl:value-of select=&quot;'IDRisorsa=:IDRis'&quot;/>&#xa;                        &lt;/tns:queryString>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;upper-case($RetailSDRIn.Request/tns1:TESTATA/tns1:LAVORAZIONE)='SPOSTAMENTO_CPS'&quot;>&#xa;                                &lt;tns:NamedParameterAssigned>&#xa;                                    &lt;tns:name>&#xa;                                        &lt;xsl:value-of select=&quot;'IDRis'&quot;/>&#xa;                                    &lt;/tns:name>&#xa;                                    &lt;xsl:if test=&quot;$RetailSDRIn.Request/tns1:CPS/tns1:DN_OLD&quot;>&#xa;                                        &lt;tns:value>&#xa;                                            &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns1:CPS/tns1:DN_OLD&quot;/>&#xa;                                        &lt;/tns:value>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns:NamedParameterAssigned>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:NamedParameterAssigned>&#xa;                                    &lt;tns:name>&#xa;                                        &lt;xsl:value-of select=&quot;'IDRis'&quot;/>&#xa;                                    &lt;/tns:name>&#xa;                                    &lt;tns:value>&#xa;                                        &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns1:CPS/tns1:DN&quot;/>&#xa;                                    &lt;/tns:value>&#xa;                                &lt;/tns:NamedParameterAssigned>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns:Criteria>&#xa;                &lt;/tns:Input>&#xa;            &lt;/tns:Find>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
