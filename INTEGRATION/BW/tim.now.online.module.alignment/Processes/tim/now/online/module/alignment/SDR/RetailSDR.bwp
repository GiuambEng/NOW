herwise>&lt;DN_OLD xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DISTR_DEL_DN>&lt;xsl:value-of select=&quot;$RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:DISTRETTO&quot;/>&lt;/DISTR_DEL_DN>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:DATA_RICHIESTA_CESSAZIONE)>0&quot;>&lt;DATA_CESS_SDR>&lt;xsl:value-of select=&quot;xsd:date($RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:DATA_RICHIESTA_CESSAZIONE)&quot;/>&lt;/DATA_CESS_SDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_CESS_SDR xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DATA_ESPL_SDR>&lt;xsl:value-of select=&quot;xsd:date($RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:DATA_ESPLETAMENTO)&quot;/>&lt;/DATA_ESPL_SDR>&lt;CLLI>&lt;xsl:value-of select=&quot;$RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:CLLI_CENTRALE&quot;/>&lt;/CLLI>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:CLLI_CENTRALE_OLD)>0&quot;>&lt;CLLI_OLD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:CLLI_CENTRALE_OLD)&quot;>&lt;xsl:value-of select=&quot;$RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:CLLI_CENTRALE_OLD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CLLI_OLD>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CLLI_OLD xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;TIPO_LINEA>&lt;xsl:value-of select=&quot;$RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:TIPO_LINEA&quot;/>&lt;/TIPO_LINEA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:RADICALE)>0&quot;>&lt;RADICALE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:RADICALE)&quot;>&lt;xsl:value-of select=&quot;$RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:RADICALE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/RADICALE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;RADICALE xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:QUANTITA_LINEE)&quot;>&lt;QUANTITA_AGGIUNTIVI>&lt;xsl:value-of select=&quot;xsd:decimal($RetailSDRIn/Request/tns1:Request/tns1:CPS/tns1:QUANTITA_LINEE)&quot;/>&lt;/QUANTITA_AGGIUNTIVI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;QUANTITA_AGGIUNTIVI xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Response/tns1:ESITO='OK' and $Response/tns1:DESCRIZIONE_ESITO='OK' &quot;>&lt;STATO_RICH_SDR>&lt;xsl:value-of select=&quot;'DA_ELABORARE'&quot;/>&lt;/STATO_RICH_SDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;STATO_RICH_SDR>&lt;xsl:value-of select=&quot;'NON DA ELABORARE'&quot;/>&lt;/STATO_RICH_SDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($Logger/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, &amp;quot;.&amp;quot;))&quot;/>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;TIMESTAMP_INS>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMESTAMP_INS>&lt;ID_RICH_SDR_CPS>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($Logger/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, &amp;quot;.&amp;quot;))&quot;/>&lt;/ID_RICH_SDR_CPS>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
