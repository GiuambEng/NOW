            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingVerificaRisorsaSDR&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SDR_LAV_RETAIL/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RetailSDRIn&quot;/>&lt;xsl:param name=&quot;Logger&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:template name=&quot;StagingRetailSDR-input&quot; match=&quot;/&quot;>&lt;ns:INPUT>&lt;ns:Insert>&lt;ns:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($RetailSDRIn/Request/tns:Request,true(),true())&quot;/>&lt;/ns:CONTENUTO_REQUEST>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($Logger/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, &amp;quot;.&amp;quot;))&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;11&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RICH>&lt;ns:DN>&lt;xsl:value-of select=&quot;$RetailSDRIn/Request/tns:Request/tns:CPS/tns:DN&quot;/>&lt;/ns:DN>&lt;ns:LAVORAZIONESDR>&lt;xsl:value-of select=&quot;$RetailSDRIn/Request/tns:Request/tns:TESTATA/tns:LAVORAZIONE&quot;/>&lt;/ns:LAVORAZIONESDR>&lt;ns:SOTTOLAVORAZIONESDR>&lt;xsl:value-of select=&quot;$RetailSDRIn/Request/tns:Request/tns:TESTATA/tns:SOTTO_LAVORAZIONE&quot;/>&lt;/ns:SOTTOLAVORAZIONESDR>&lt;xsl:if test=&quot;exists($RetailSDRIn/Request/tns:Request/tns:CPS/tns:DN_OLD)&quot;>&lt;xsl:if test=&quot;$RetailSDRIn/Request/tns:Request/tns:CPS/tns:DN_OLD&quot;>&lt;ns:DNOLD>&lt;xsl:value-of select=&quot;$RetailSDRIn/Request/tns:Request/tns:CPS/tns:DN_OLD&quot;/>&lt;/ns:DNOLD>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Response/tns:ESITO='KO'&quot;>&lt;ns:RETURNCODE>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/ns:RETURNCODE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:RETURNCODE>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns:RETURNCODE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:DATA_INVIO_RICHISTA>&lt;xsl:value-of select=&quot;$RetailSDRIn/Request/tns:Request/tns:TESTATA/tns:DATA_INVIO_RICHIESTA_SDR&quot;/>&lt;/ns:DATA_INVIO_RICHISTA>&lt;ns:CODICE_ORDINE_SDR>&lt;xsl:value-of select=&quot;$RetailSDRIn/Request/tns:Request/tns:TESTATA/tns:CODICE_ORDINE_SDR&quot;/>&lt;/ns:CODICE_ORDINE_SDR>&lt;/ns:Insert>&lt;/ns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="StagingRetailSDR-input"
                    name="StagingRetailSDR"
                    tibex:xpdlId="9fc04631-772f-468a-9cab-bc77c70d1ccc"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Assign3ToStagingRetailSDR"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StagingRetailSDRToAssign2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingVerificaRisorsaSDR&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SDR_LAV_RETAIL/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Logger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;RetailSDRIn.Request&quot;/>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:template name=&quot;StagingRetailSDR-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:INPUT>&#xa;            &lt;ns:Insert>&#xa;                &lt;ns:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($RetailSDRIn.Request,true(),true())&quot;/>&#xa;                &lt;/ns:CONTENUTO_REQUEST>&#xa;                &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Logger.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, &amp;quot;.&amp;quot;))&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                &lt;ns:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_RICH>&#xa;                &lt;ns:DN>&#xa;                    &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns:CPS/tns:DN&quot;/>&#xa;                &lt;/ns:DN>&#xa;                &lt;ns:LAVORAZIONESDR>&#xa;                    &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns:TESTATA/tns:LAVORAZIONE&quot;/>&#xa;                &lt;/ns:LAVORAZIONESDR>&#xa;                &lt;ns:SOTTOLAVORAZIONESDR>&#xa;                    &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns:TESTATA/tns:SOTTO_LAVORAZIONE&quot;/>&#xa;                &lt;/ns:SOTTOLAVORAZIONESDR>&#xa;                &lt;xsl:if test=&quot;exists($RetailSDRIn.Request/tns:CPS/tns:DN_OLD)&quot;>&#xa;                    &lt;xsl:if test=&quot;$RetailSDRIn.Request/tns:CPS/tns:DN_OLD&quot;>&#xa;                        &lt;ns:DNOLD>&#xa;                            &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns:CPS/tns:DN_OLD&quot;/>&#xa;                        &lt;/ns:DNOLD>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Response/tns:ESITO='KO'&quot;>&#xa;                        &lt;ns:RETURNCODE>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/ns:RETURNCODE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:RETURNCODE>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/ns:RETURNCODE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:DATA_INVIO_RICHISTA>&#xa;                    &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns:TESTATA/tns:DATA_INVIO_RICHIESTA_SDR&quot;/>&#xa;                &lt;/ns:DATA_INVIO_RICHISTA>&#xa;                &lt;ns:CODICE_ORDINE_SDR>&#xa;                    &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns:TESTATA/tns:CODICE_ORDINE_SDR&quot;/>&#xa;                &lt;/ns:CODICE_ORDINE_SDR>&#xa;            &lt;/ns:Insert>&#xa;        &lt;/ns:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
