                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8e0055f1-3c95-4b37-9977-4ad1e03ded1e+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SDR_LAV_RETAIL/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Logger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;RetailSDRIn.Request&quot;/>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:template name=&quot;RICHIESTA_SDR_CPS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;DATA_INVIO_RICH_SDR>&#xa;                &lt;xsl:value-of select=&quot;xsd:date($RetailSDRIn.Request/tns1:TESTATA/tns1:DATA_INVIO_RICHIESTA_SDR)&quot;/>&#xa;            &lt;/DATA_INVIO_RICH_SDR>&#xa;            &lt;COD_ORDINE_SDR>&#xa;                &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns1:TESTATA/tns1:CODICE_ORDINE_SDR&quot;/>&#xa;            &lt;/COD_ORDINE_SDR>&#xa;            &lt;LAV_SDR>&#xa;                &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns1:TESTATA/tns1:LAVORAZIONE&quot;/>&#xa;            &lt;/LAV_SDR>&#xa;            &lt;SOTTO_LAV_SDR>&#xa;                &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns1:TESTATA/tns1:SOTTO_LAVORAZIONE&quot;/>&#xa;            &lt;/SOTTO_LAV_SDR>&#xa;            &lt;DN>&#xa;                &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns1:CPS/tns1:DN&quot;/>&#xa;            &lt;/DN>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RetailSDRIn.Request/tns1:CPS/tns1:DN_OLD)>0&quot;>&#xa;                    &lt;DN_OLD>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RetailSDRIn.Request/tns1:CPS/tns1:DN_OLD)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns1:CPS/tns1:DN_OLD&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DN_OLD>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DN_OLD xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;DISTR_DEL_DN>&#xa;                &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns1:CPS/tns1:DISTRETTO&quot;/>&#xa;            &lt;/DISTR_DEL_DN>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RetailSDRIn.Request/tns1:CPS/tns1:DATA_RICHIESTA_CESSAZIONE)>0&quot;>&#xa;                    &lt;DATA_CESS_SDR>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($RetailSDRIn.Request/tns1:CPS/tns1:DATA_RICHIESTA_CESSAZIONE)&quot;/>&#xa;                    &lt;/DATA_CESS_SDR>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DATA_CESS_SDR xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;DATA_ESPL_SDR>&#xa;                &lt;xsl:value-of select=&quot;xsd:date($RetailSDRIn.Request/tns1:CPS/tns1:DATA_ESPLETAMENTO)&quot;/>&#xa;            &lt;/DATA_ESPL_SDR>&#xa;            &lt;CLLI>&#xa;                &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns1:CPS/tns1:CLLI_CENTRALE&quot;/>&#xa;            &lt;/CLLI>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RetailSDRIn.Request/tns1:CPS/tns1:CLLI_CENTRALE_OLD)>0&quot;>&#xa;                    &lt;CLLI_OLD>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RetailSDRIn.Request/tns1:CPS/tns1:CLLI_CENTRALE_OLD)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns1:CPS/tns1:CLLI_CENTRALE_OLD&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CLLI_OLD>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CLLI_OLD xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIPO_LINEA>&#xa;                &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns1:CPS/tns1:TIPO_LINEA&quot;/>&#xa;            &lt;/TIPO_LINEA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RetailSDRIn.Request/tns1:CPS/tns1:RADICALE)>0&quot;>&#xa;                    &lt;RADICALE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RetailSDRIn.Request/tns1:CPS/tns1:RADICALE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RetailSDRIn.Request/tns1:CPS/tns1:RADICALE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/RADICALE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;RADICALE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RetailSDRIn.Request/tns1:CPS/tns1:QUANTITA_LINEE)&quot;>&#xa;                    &lt;QUANTITA_AGGIUNTIVI>&#xa;                        &lt;xsl:value-of select=&quot;xsd:decimal($RetailSDRIn.Request/tns1:CPS/tns1:QUANTITA_LINEE)&quot;/>&#xa;                    &lt;/QUANTITA_AGGIUNTIVI>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;QUANTITA_AGGIUNTIVI xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Response/tns1:ESITO='OK' and $Response/tns1:DESCRIZIONE_ESITO='OK' &quot;>&#xa;                    &lt;STATO_RICH_SDR>&#xa;                        &lt;xsl:value-of select=&quot;'DA_ELABORARE'&quot;/>&#xa;                    &lt;/STATO_RICH_SDR>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO_RICH_SDR>&#xa;                        &lt;xsl:value-of select=&quot;'NON DA ELABORARE'&quot;/>&#xa;                    &lt;/STATO_RICH_SDR>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Logger.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, &amp;quot;.&amp;quot;))&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO_NO_FILE>&#xa;            &lt;TIMESTAMP_INS>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMESTAMP_INS>&#xa;            &lt;ID_RICH_SDR_CPS>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Logger.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, &amp;quot;.&amp;quot;))&quot;/>&#xa;            &lt;/ID_RICH_SDR_CPS>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
