                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$GetIDRisorsa.part1/tns:Find[1]/tns:Response/tns:Esito='OK'  and count($GetIDRisorsa.part1/tns:Find[tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE')])>0]]></bpws:transitionCondition>
