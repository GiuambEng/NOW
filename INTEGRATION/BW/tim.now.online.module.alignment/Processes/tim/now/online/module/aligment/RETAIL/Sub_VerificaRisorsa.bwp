                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaRisorsa&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.NOWAllineamentiRetail&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns1:NOWAllineamentoRetailResponse>&lt;tns1:RESPONSE>&lt;tns1:Transaction_ID>&lt;xsl:value-of select=&quot;$Start/tns:Transaction_ID&quot;/>&lt;/tns1:Transaction_ID>&lt;tns1:Response_date>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:00&amp;quot;))&quot;/>&lt;/tns1:Response_date>&lt;tns1:Return_Code>&lt;xsl:value-of select=&quot;'01'&quot;/>&lt;/tns1:Return_Code>&lt;tns1:Descrizione_errore>&lt;xsl:value-of select=&quot;'Risorsa/Telefonico non trovati'&quot;/>&lt;/tns1:Descrizione_errore>&lt;/tns1:RESPONSE>&lt;/tns1:NOWAllineamentoRetailResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
