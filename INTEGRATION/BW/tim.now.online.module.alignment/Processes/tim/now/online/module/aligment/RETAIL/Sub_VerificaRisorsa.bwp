cchetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDCorrelazione&quot;>&#xa;                                &lt;IDCorrelazione>&#xa;                                    &lt;xsl:value-of select=&quot;IDCorrelazione&quot;/>&#xa;                                &lt;/IDCorrelazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;numTelPrincipale&quot;>&#xa;                                &lt;numTelPrincipale>&#xa;                                    &lt;xsl:value-of select=&quot;numTelPrincipale&quot;/>&#xa;                                &lt;/numTelPrincipale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;codiceFatturazioneJPUB&quot;>&#xa;                                &lt;codiceFatturazioneJPUB>&#xa;                                    &lt;xsl:value-of select=&quot;codiceFatturazioneJPUB&quot;/>&#xa;                                &lt;/codiceFatturazioneJPUB>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CRMEstrattore&quot;>&#xa;                                &lt;CRMEstrattore>&#xa;                                    &lt;xsl:value-of select=&quot;CRMEstrattore&quot;/>&#xa;                                &lt;/CRMEstrattore>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDRichiestaOLD&quot;>&#xa;                                &lt;IDRichiestaOLD>&#xa;                                    &lt;xsl:value-of select=&quot;IDRichiestaOLD&quot;/>&#xa;                                &lt;/IDRichiestaOLD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:copy-of select=&quot;cliente&quot;/>&#xa;                            &lt;xsl:if test=&quot;LNA_LA&quot;>&#xa;                                &lt;LNA_LA>&#xa;                                    &lt;xsl:value-of select=&quot;LNA_LA&quot;