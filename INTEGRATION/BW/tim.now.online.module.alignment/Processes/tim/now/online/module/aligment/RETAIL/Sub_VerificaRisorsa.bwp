                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogSetAsset_2ToCallProcess"/>
                        <bpws:target linkName="LogSetAsset_1ToCallProcess"/>
                        <bpws:target linkName="LogSetAsset_3ToConsistenza"/>
