                    <bpws:sources>
                        <bpws:source linkName="ConsistenzaToOKResponse">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ConsistenzaToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Consistenza/ns6:ESITO='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Consistenza/ns6:ESITO='KO']]></bpws:transitionCondition>
