                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.schema.xsd.NOWAllineamentiRetail&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:NOWAllineamentoRetailResponse>&lt;tns:RESPONSE>&lt;tns:Transaction_ID>&lt;xsl:value-of select=&quot;$Response/tns:RESPONSE/tns:Transaction_ID&quot;/>&lt;/tns:Transaction_ID>&lt;tns:Response_date>&lt;xsl:value-of select=&quot;$Response/tns:RESPONSE/tns:Response_date&quot;/>&lt;/tns:Response_date>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;$Response/tns:RESPONSE/tns:Return_Code&quot;/>&lt;/tns:Return_Code>&lt;xsl:if test=&quot;$Response/tns:RESPONSE/tns:Descrizione_errore&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;$Response/tns:RESPONSE/tns:Descrizione_errore&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$Response/tns:RESPONSE/tns:CONSISTENZA&quot;/>&lt;/tns:RESPONSE>&lt;/tns:NOWAllineamentoRetailResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
