                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaRisorsa&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;DIN&quot;/>&lt;xsl:template name=&quot;VerificaRisorsa-input&quot; match=&quot;/&quot;>&lt;tns:InputData>&lt;xsl:if test=&quot;$Start/tns:Transaction_ID&quot;>&lt;tns:Transaction_ID>&lt;xsl:value-of select=&quot;$Start/tns:Transaction_ID&quot;/>&lt;/tns:Transaction_ID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;matches($DIN/ID_RISORSA,&amp;quot;[0-9]*&amp;quot;)&quot;>&lt;xsl:if test=&quot;$DIN/ID_RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$DIN/ID_RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;substring($DIN/ID_RISORSA,4)&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
