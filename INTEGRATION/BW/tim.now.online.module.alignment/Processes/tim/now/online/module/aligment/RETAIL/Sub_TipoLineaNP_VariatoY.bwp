                    <bpws:sources>
                        <bpws:source linkName="NUMTELEFONICO_ASSOCZ_DN_IDRISORSA_DINToRepeatOnError">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($NUMTELEFONICO_ASSOCZ_DN_IDRISORSA_DIN/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($NUMTELEFONICO_ASSOCZ_DN_IDRISORSA_DIN/Record) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="NUMTELEFONICO_ASSOCZ_DN_IDRISORSA_DINToLogEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1c7754fb-e59d-448d-afe4-2dde4756aa3e+input&quot; xmlns:tns1=&quot;http://www.example.org/Sub_TipoLineaNp&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_RISORSA_DIN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:Id_Risorsa_Input)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:Id_Risorsa_Input&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA_DIN>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
