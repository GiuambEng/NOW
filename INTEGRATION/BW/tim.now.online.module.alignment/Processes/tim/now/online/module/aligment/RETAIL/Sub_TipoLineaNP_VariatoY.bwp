        &lt;impl:ReperimentoServizioRequest&gt;
            &lt;parameters&gt;
                &lt;impl:ReperimentoServizio&gt;
                    &lt;impl:request&gt;
                        &lt;tns1:body&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="not(contains($Check_Id_Risorsa, 'NaN'))"&gt;
                                    &lt;tns1:DN&gt;
                                        &lt;xsl:choose&gt;
                                            &lt;xsl:when test="exists($Start/tns:Id_Risorsa_Input)"&gt;
                                                &lt;xsl:value-of select="$Start/tns:Id_Risorsa_Input"/&gt;
                                            &lt;/xsl:when&gt;
                                            &lt;xsl:otherwise&gt;
                                                &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                                            &lt;/xsl:otherwise&gt;
                                        &lt;/xsl:choose&gt;
                                    &lt;/tns1:DN&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns1:DN&gt;
                                        &lt;xsl:choose&gt;
                                            &lt;xsl:when test="exists($NUMTELEFONICO_ASSOCZ_DN_IDRISORSA_DIN/Record[1]/NUMERO_TELEFONICO)"&gt;
                                                &lt;xsl:value-of select="$NUMTELEFONICO_ASSOCZ_DN_IDRISORSA_DIN/Record[1]/NUMERO_TELEFONICO"/&gt;
                                            &lt;/xsl:when&gt;
                                            &lt;xsl:otherwise&gt;
                                                &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                                            &lt;/xsl:otherwise&gt;
                                        &lt;/xsl:choose&gt;
                                    &lt;/tns1:DN&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;tns1:distretto&gt;
                                &lt;xsl:value-of select="$DISTRETTO"/&gt;
                            &lt;/tns1:distretto&gt;
                        &lt;/tns1:body&gt;
                        &lt;tns1:header&gt;
                            &lt;tns1:transaction_date&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($InfoStagAlinneamentiRetail/Record[1]/TIMSTP_RICH)"&gt;
                                        &lt;xsl:value-of select="$InfoStagAlinneamentiRetail/Record[1]/TIMSTP_RICH"/&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/tns1:transaction_date&gt;
                            &lt;tns1:transaction_id&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($InfoStagAlinneamentiRetail/Record[1]/ID_RICH)"&gt;
                                        &lt;xsl:value-of select="$InfoStagAlinneamentiRetail/Record[1]/ID_RICH"/&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/tns1:transaction_id&gt;
                        &lt;/tns1:header&gt;
