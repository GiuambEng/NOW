                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="DISTRETTO"
                    name="Distretto" outputVariable="DISTRETTO"
                    tibex:xpdlId="bf869e44-dac4-4f07-888a-9cf517119e54" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToDistretto"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToCheck_Numeric_Id_risorsa"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (substring($Start/tns:Id_Risorsa_Input, 2, 1)=('2','6')) then concat('0',substring($Start/tns:Id_Risorsa_Input, 1,2)) else if( substring($Start/tns:Id_Risorsa_Input,3, 1)=('0','1','5','9')) then substring($Start/tns:Id_Risorsa_Input, 1, 3) else substring($Start/tns:Id_Risorsa_Input,2, 3)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
