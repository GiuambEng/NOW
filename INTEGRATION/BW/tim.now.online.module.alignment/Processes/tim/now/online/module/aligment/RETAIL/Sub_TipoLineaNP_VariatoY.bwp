            &lt;/parameters&gt;
        &lt;/impl:ReperimentoServizioRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:impl=&quot;http://getdatiinventory.unicac.telecomitalia.it&quot; xmlns:tns1=&quot;http://types.getdatiinventory.unicac.telecomitalia.it&quot; xmlns:tns=&quot;http://www.example.org/Sub_TipoLineaNp&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Check_Id_Risorsa&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;NUMTELEFONICO_ASSOCZ_DN_IDRISORSA_DIN&quot;/>&#xa;    &lt;xsl:param name=&quot;DISTRETTO&quot;/>&#xa;    &lt;xsl:param name=&quot;InfoStagAlinneamentiRetail&quot;/>&#xa;    &lt;xsl:template name=&quot;UnicaGetDatiInvetory-input&quot; match=&quot;/&quot;>&#xa;        &lt;impl:ReperimentoServizio>&#xa;            &lt;impl:request>&#xa;                &lt;tns1:body>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;not(contains($Check_Id_Risorsa, 'NaN'))&quot;>&#xa;                            &lt;tns1:DN>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns:Id_Risorsa_Input)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:Id_Risorsa_Input&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/tns1:DN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:DN>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($NUMTELEFONICO_ASSOCZ_DN_IDRISORSA_DIN/Record[1]/NUMERO_TELEFONICO)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$NUMTELEFONICO_ASSOCZ_DN_IDRISORSA_DIN/Record[1]/NUMERO_TELEFONICO&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/tns1:DN>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns1:distretto>&#xa;                        &lt;xsl:value-of select=&quot;$DISTRETTO&quot;/>&#xa;                    &lt;/tns1:distretto>&#xa;                &lt;/tns1:body>&#xa;                &lt;tns1:header>&#xa;                    &lt;tns1:transaction_date>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($InfoStagAlinneamentiRetail/Record[1]/TIMSTP_RICH)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$InfoStagAlinneamentiRetail/Record[1]/TIMSTP_RICH&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:transaction_date>&#xa;                    &lt;tns1:transaction_id>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($InfoStagAlinneamentiRetail/Record[1]/ID_RICH)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$InfoStagAlinneamentiRetail/Record[1]/ID_RICH&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:transaction_id>&#xa;                &lt;/tns1:header>&#xa;            &lt;/impl:request>&#xa;        &lt;/impl:ReperimentoServizio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToUnicaGetDatiInvetory"/>
