                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/LoggerServiceSecurityDataServices/" xmlns:tns1="http://www.example.org/ServicesSecurityData" xmlns:ns="www.tim.now.HeaderConnection" xmlns:tns4="http://www.tim.com/NOW/xsd/NOW_HAL/" xmlns:tns2="http://www.example.com/namespaces/tns/1564740682912" xmlns:bw="http://www.tibco.com/bw/xpath/bw-custom-functions" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" version="2.0"&gt;&lt;xsl:param name="LoggerName"/&gt;&lt;xsl:param name="GetContext"/&gt;&lt;xsl:param name="Application"/&gt;&lt;xsl:param name="LoggerLevel"/&gt;&lt;xsl:param name="NOW_HALIn"/&gt;&lt;xsl:param name="GetLocalIP"/&gt;&lt;xsl:param name="ProcessIstance"/&gt;&lt;xsl:template name="SecurityLogger-input" match="/"&gt;&lt;tns:NewOperationRequest&gt;&lt;parameters&gt;&lt;tns1:LoggerSecurityInput&gt;&lt;tns1:LogInfo&gt;&lt;tns1:LoggerName&gt;&lt;xsl:value-of select="$LoggerName"/&gt;&lt;/tns1:LoggerName&gt;&lt;tns1:Application&gt;&lt;xsl:value-of select="$Application"/&gt;&lt;/tns1:Application&gt;&lt;tns1:LogLevel&gt;&lt;xsl:value-of select="$LoggerLevel"/&gt;&lt;/tns1:LogLevel&gt;&lt;tns1:ServiceName&gt;&lt;xsl:value-of select="'NOW_HAL_RichiestaDatiTecniciConsistenza'"/&gt;&lt;/tns1:ServiceName&gt;&lt;tns1:Operation&gt;&lt;xsl:value-of select="'NOW_HAL'"/&gt;&lt;/tns1:Operation&gt;&lt;tns1:JMS&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns1:JMS&gt;&lt;/tns1:LogInfo&gt;&lt;tns1:InputDataUserLog&gt;&lt;tns1:APPLICAZIONE_CLIENT&gt;&lt;xsl:value-of select="'RICHIESTA ONLINE DATI TECNICI CONSISTENZA DA HAL A NOW'"/&gt;&lt;/tns1:APPLICAZIONE_CLIENT&gt;&lt;tns1:COD_FUNZIONE&gt;&lt;xsl:value-of select="'Monitoraggio Accessi M2M'"/&gt;&lt;/tns1:COD_FUNZIONE&gt;&lt;tns1:COD_PROFILO&gt;&lt;xsl:value-of select="'M2M'"/&gt;&lt;/tns1:COD_PROFILO&gt;&lt;xsl:if test="$GetContext/ns:remoteaddress"&gt;&lt;tns1:HOSTNAME_CLIENT&gt;&lt;xsl:value-of select="$GetContext/ns:remoteaddress"/&gt;&lt;/tns1:HOSTNAME_CLIENT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetContext/ns:remoteaddress"&gt;&lt;tns1:IP_CLIENT&gt;&lt;xsl:value-of select="$GetContext/ns:remoteaddress"/&gt;&lt;/tns1:IP_CLIENT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetLocalIP/tns2:IPAddress"&gt;&lt;tns1:IP_SERVER&gt;&lt;xsl:value-of select="$GetLocalIP/tns2:IPAddress"/&gt;&lt;/tns1:IP_SERVER&gt;&lt;/xsl:if&gt;&lt;tns1:OS_USER&gt;&lt;xsl:value-of select="bw:getSystemProperty(&amp;quot;os.name&amp;quot;)"/&gt;&lt;/tns1:OS_USER&gt;&lt;tns1:SERVER_NAME&gt;&lt;xsl:value-of select="bw:getHostName()"/&gt;&lt;/tns1:SERVER_NAME&gt;&lt;tns1:COD_INTRFC&gt;&lt;xsl:value-of select="'HAL_INFO_OL_IN_CORSO_OL'"/&gt;&lt;/tns1:COD_INTRFC&gt;&lt;tns1:SESSION_ID&gt;&lt;xsl:value-of select="concat('HalRichiestaDatiTecnici_',$NOW_HALIn/parameters/tns4:NOW_HAL_Request/tns4:ID_RISORSA)"/&gt;&lt;/tns1:SESSION_ID&gt;&lt;tns1:TIPO_OPERAZIONE&gt;&lt;xsl:value-of select="'LOGIN'"/&gt;&lt;/tns1:TIPO_OPERAZIONE&gt;&lt;tns1:SISTEMA_CHIAMANTE&gt;&lt;xsl:value-of select="'HAL'"/&gt;&lt;/tns1:SISTEMA_CHIAMANTE&gt;&lt;xsl:if test="$ProcessIstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;tns1:ID_ESE_PROC_NO_FILE&gt;&lt;xsl:value-of select="$ProcessIstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/tns1:ID_ESE_PROC_NO_FILE&gt;&lt;/xsl:if&gt;&lt;tns1:NOME_TAB_STAGING&gt;&lt;xsl:value-of select="'STAG_HAL'"/&gt;&lt;/tns1:NOME_TAB_STAGING&gt;&lt;/tns1:InputDataUserLog&gt;&lt;/tns1:LoggerSecurityInput&gt;&lt;/parameters&gt;&lt;/tns:NewOperationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/LoggerServiceSecurityDataServices/&quot; xmlns:tns1=&quot;http://www.example.org/ServicesSecurityData&quot; xmlns:ns=&quot;www.tim.now.HeaderConnection&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/NOW_HAL/&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOW_HALIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessIstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;GetContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:template name=&quot;SecurityLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:LoggerSecurityInput>&#xa;            &lt;tns1:LogInfo>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:ServiceName>&#xa;                    &lt;xsl:value-of select=&quot;'NOW_HAL_RichiestaDatiTecniciConsistenza'&quot;/>&#xa;                &lt;/tns1:ServiceName>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'NOW_HAL'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:JMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:JMS>&#xa;            &lt;/tns1:LogInfo>&#xa;            &lt;tns1:InputDataUserLog>&#xa;                &lt;tns1:APPLICAZIONE_CLIENT>&#xa;                    &lt;xsl:value-of select=&quot;'RICHIESTA ONLINE DATI TECNICI CONSISTENZA DA HAL A NOW'&quot;/>&#xa;                &lt;/tns1:APPLICAZIONE_CLIENT>&#xa;                &lt;tns1:COD_FUNZIONE>&#xa;                    &lt;xsl:value-of select=&quot;'Monitoraggio Accessi M2M'&quot;/>&#xa;                &lt;/tns1:COD_FUNZIONE>&#xa;                &lt;tns1:COD_PROFILO>&#xa;                    &lt;xsl:value-of select=&quot;'M2M'&quot;/>&#xa;                &lt;/tns1:COD_PROFILO>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns:remoteaddress&quot;>&#xa;                    &lt;tns1:HOSTNAME_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns:remoteaddress&quot;/>&#xa;                    &lt;/tns1:HOSTNAME_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns:remoteaddress&quot;>&#xa;                    &lt;tns1:IP_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns:remoteaddress&quot;/>&#xa;                    &lt;/tns1:IP_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns2:IPAddress&quot;>&#xa;                    &lt;tns1:IP_SERVER>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns2:IPAddress&quot;/>&#xa;                    &lt;/tns1:IP_SERVER>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:OS_USER>&#xa;                    &lt;xsl:value-of select=&quot;bw:getSystemProperty(&amp;quot;os.name&amp;quot;)&quot;/>&#xa;                &lt;/tns1:OS_USER>&#xa;                &lt;tns1:SERVER_NAME>&#xa;                    &lt;xsl:value-of select=&quot;bw:getHostName()&quot;/>&#xa;                &lt;/tns1:SERVER_NAME>&#xa;                &lt;tns1:COD_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;'HAL_INFO_OL_IN_CORSO_OL'&quot;/>&#xa;                &lt;/tns1:COD_INTRFC>&#xa;                &lt;tns1:SESSION_ID>&#xa;                    &lt;xsl:value-of select=&quot;concat('HalRichiestaDatiTecnici_',$NOW_HALIn.parameters/tns4:ID_RISORSA)&quot;/>&#xa;                &lt;/tns1:SESSION_ID>&#xa;                &lt;tns1:TIPO_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;'LOGIN'&quot;/>&#xa;                &lt;/tns1:TIPO_OPERAZIONE>&#xa;                &lt;tns1:SISTEMA_CHIAMANTE>&#xa;                    &lt;xsl:value-of select=&quot;'HAL'&quot;/>&#xa;                &lt;/tns1:SISTEMA_CHIAMANTE>&#xa;                &lt;xsl:if test=&quot;$ProcessIstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                    &lt;tns1:ID_ESE_PROC_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ProcessIstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                    &lt;/tns1:ID_ESE_PROC_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:NOME_TAB_STAGING>&#xa;                    &lt;xsl:value-of select=&quot;'STAG_HAL'&quot;/>&#xa;                &lt;/tns1:NOME_TAB_STAGING>&#xa;            &lt;/tns1:InputDataUserLog>&#xa;        &lt;/tns1:LoggerSecurityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
