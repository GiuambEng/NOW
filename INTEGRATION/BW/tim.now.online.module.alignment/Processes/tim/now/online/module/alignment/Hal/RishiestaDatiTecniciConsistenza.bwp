                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_HAL/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/NOW_HAL_RichiestaDatiTecniciConsistenza/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="NOW_HALIn"/&gt;&lt;xsl:template name="sub_RichDatiTecn-input" match="/"&gt;&lt;tns1:NOW_HALRequest&gt;&lt;parameters&gt;&lt;tns:NOW_HAL_Request&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains($NOW_HALIn/parameters/tns:NOW_HAL_Request/tns:ID_RISORSA, &amp;quot;W&amp;quot;)"&gt;&lt;tns:ID_RISORSA&gt;&lt;xsl:value-of select="tib:trim(substring-before($NOW_HALIn/parameters/tns:NOW_HAL_Request/tns:ID_RISORSA, &amp;quot;W&amp;quot;))"/&gt;&lt;/tns:ID_RISORSA&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns:ID_RISORSA&gt;&lt;xsl:value-of select="$NOW_HALIn/parameters/tns:NOW_HAL_Request/tns:ID_RISORSA"/&gt;&lt;/tns:ID_RISORSA&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns:NOW_HAL_Request&gt;&lt;/parameters&gt;&lt;/tns1:NOW_HALRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_HAL/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_HAL_RichiestaDatiTecniciConsistenza/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOW_HALIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;sub_RichDatiTecn-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NOW_HAL_Request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($NOW_HALIn.parameters/tns:ID_RISORSA, &amp;quot;W&amp;quot;)&quot;>&#xa;                    &lt;tns:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(substring-before($NOW_HALIn.parameters/tns:ID_RISORSA, &amp;quot;W&amp;quot;))&quot;/>&#xa;                    &lt;/tns:ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$NOW_HALIn.parameters/tns:ID_RISORSA&quot;/>&#xa;                    &lt;/tns:ID_RISORSA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:NOW_HAL_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
