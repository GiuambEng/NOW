            name="SecurityLogger-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns16:NewOperationResponse"
            name="SecurityLogger" sca-bpel:internal="true"/>
        <bpws:variable element="ns9:INPUT" name="Err_Resp_Staging-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns1:NOW_HALRequest"
            name="sub_RichDatiTecn-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns1:NOW_HALResponse"
            name="sub_RichDatiTecn" sca-bpel:internal="true"/>
        <bpws:variable name="InviatoEsitoKO" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
