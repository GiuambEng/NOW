    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/Sub_TipoLineaNp"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="www.tim.now.stagingAllinemanetoIDSLUCO"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="www.tim.now.storedProcedureAllineamentoIDSluco"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/SendIDSLUCOolo"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="www.tim.now.genereciErrorGestioneSegnalazione"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema"
        location="../../../../../../../Schemas/Patroclo/stagingSendIdullco.xsd" namespace="www.tim.now.stagingSendIdullco"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns3:jdbcQueryActivityInput"
            name="Check-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:resultSet" name="Check" sca-bpel:internal="true"/>
        <bpws:variable name="TimeOut" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/JDBC/TimeOut" type="xsd:int"/>
        <bpws:variable element="ns5:INPUT"
            name="Up_StagingIdUllco-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:INPUT"
            name="In_StagingIdUllco-input" sca-bpel:internal="true"/>
        <bpws:variable name="InvioEsitoKO" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/InviatoEsitoKO" type="xsd:int"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="EmptyToCheck" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CheckToUp_StagingIdUllco" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CheckToIn_StagingIdUllco" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="EmptyToIn_StagingIdUllco" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="In_StagingIdUllcoToUp_StagingIdUllco" tibex:linkType="SUCCESS"/>
                <bpws:link name="Up_StagingIdUllcoToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToEmpty" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="7426842c-e6d0-414a-aab9-82714fbc236b"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEmpty"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="d885af1e-4fb1-42bd-8ee0-d0f2219dfaaf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Up_StagingIdUllcoToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="87f01e97-987f-4d49-9d81-49af1fd5ba8b">
                <bpws:targets>
                    <bpws:target linkName="StartToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToCheck">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($Start/ns0:ID_Esec_Proc)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Start/ns0:ID_Esec_Proc)>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToIn_StagingIdUllco">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Check-input"
                    name="Check" outputVariable="Check"
                    tibex:xpdlId="566610f4-f889-468e-8db0-23fded114b76" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToCheck"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckToUp_StagingIdUllco">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckToIn_StagingIdUllco">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Check/Record[1]/COUNT=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Check/Record[1]/COUNT=0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+566610f4-f889-468e-8db0-23fded114b76+input&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Check-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(*)&#xa;  FROM STAG_CLC_IDULLCO_NOFIN&#xa;  WHERE ID_ESEC_PROCSO_NO_FILE = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_NO_FILE"/>
                                    <columnMetadata
                                    columnName="COUNT(*)"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="Up_StagingIdUllco-input"
                    name="Up_StagingIdUllco"
                    tibex:xpdlId="af0a1e0a-1070-466a-93b3-d01f0eb66ef1"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckToUp_StagingIdUllco"/>
                        <bpws:target linkName="In_StagingIdUllcoToUp_StagingIdUllco"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Up_StagingIdUllcoToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingSendIdullco&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;InvioEsitoKO&quot;/>&lt;xsl:template name=&quot;Up_StagingIdUllco-input&quot; match=&quot;/&quot;>&lt;ns:INPUT>&lt;ns:UpdateOnError>&lt;ns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat($Start/ns1:Error/ns1:MsgCode, '-',$Start/ns1:Error/ns1:Msg)&quot;/>&lt;/ns:DESCR_ERRORE>&lt;ns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RISPOSTA>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$InvioEsitoKO&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;/ns:UpdateOnError>&lt;/ns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.online.module.alignment.Patroclo.sub_StagingIdUllco" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="In_StagingIdUllco-input"
                    name="In_StagingIdUllco"
                    tibex:xpdlId="b069fa5a-694f-4996-8e35-cbc4af7a8c94"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckToIn_StagingIdUllco"/>
                        <bpws:target linkName="EmptyToIn_StagingIdUllco"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="In_StagingIdUllcoToUp_StagingIdUllco"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingSendIdullco&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;InvioEsitoKO&quot;/>&lt;xsl:template name=&quot;In_StagingIdUllco-input&quot; match=&quot;/&quot;>&lt;ns:INPUT>&lt;ns:Insert>&lt;ns:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;'NULL'&quot;/>&lt;/ns:CONTENUTO_REQUEST>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;ns:ID_RICH_CLC_IDULLCO>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ns:ID_RICH_CLC_IDULLCO>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$InvioEsitoKO&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RICH>&lt;/ns:Insert>&lt;/ns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.online.module.alignment.Patroclo.sub_StagingIdUllco" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
