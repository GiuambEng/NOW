                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Insert-input"
                                    name="Insert"
                                    outputVariable="Insert"
                                    tibex:xpdlId="da0806d8-cf2f-47c6-9b71-f90c667ce8ac" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InputToJDBCUpdate"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToCounter"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+da0806d8-cf2f-47c6-9b71-f90c667ce8ac+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns=&quot;www.telecom.Now.outputtriggerOLO.onLine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OK_ELAB_STAG&quot;/>&lt;xsl:param name=&quot;KO_ELAB_STAG&quot;/>&lt;xsl:param name=&quot;Check&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Input&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;Insert-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;COD_DETT_SCARTO xsi:nil=&quot;true&quot;/>&lt;COD_SCARTO xsi:nil=&quot;true&quot;/>&lt;NOME_ATTR_IN_ERRORE xsi:nil=&quot;true&quot;/>&lt;TAG_IN_ERRORE xsi:nil=&quot;true&quot;/>&lt;CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($Input)&quot;/>&lt;/CONTENUTO_REQUEST>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:ID_RICH_JPUB)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:ID_RICH_JPUB&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;ID_RICH_JPUB_RISPOSTE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:ID_RICH_JPUB)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:ID_RICH_JPUB&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_JPUB_RISPOSTE>&lt;xsl:choose>&lt;xsl:when test=&quot;$Check='ERRORE'&quot;>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$KO_ELAB_STAG&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_STAG&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_RICH>&lt;xsl:choose>&lt;xsl:when test=&quot;$Check='ERRORE'&quot;>&lt;CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;'OloNonValido'&quot;/>&lt;/CONTENUTO_RESPONSE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;'OloValido'&quot;/>&lt;/CONTENUTO_RESPONSE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_RISPOSTA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Check='ERRORE'&quot;>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($_error)&quot;/>&lt;/DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_ERRORE xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_TIPOLG_MESSG>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/ID_TIPOLG_MESSG>&lt;ID_TRANSAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:ID_TRANSAZIONE)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:ID_TRANSAZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_TRANSAZIONE>&lt;ANAG_FULL>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/ANAG_FULL>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_JPUB_IN (COD_DETT_SCARTO, COD_SCARTO,&#xa;  NOME_ATTR_IN_ERRORE, TAG_IN_ERRORE, CONTENUTO_REQUEST, ID_ESEC_PROCSO_NO_FILE,&#xa;  ID_RICH_JPUB_RISPOSTE, ID_STATO_ELAB_STAG, OPERATORE, TIMSTP_RICH,&#xa;  CONTENUTO_RESPONSE, TIMSTP_RISPOSTA, DESCR_ERRORE,ID_TIPOLG_MESSG,ID_TRANSAZIONE,ANAG_FULL)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'AUTOMATICO', ?, ?, ?, ?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_DETT_SCARTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_SCARTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_ATTR_IN_ERRORE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TAG_IN_ERRORE"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_REQUEST"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_NO_FILE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_RICH_JPUB_RISPOSTE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_STATO_ELAB_STAG"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_RICH"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_RESPONSE"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_RISPOSTA"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DESCR_ERRORE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TIPOLG_MESSG"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_TRANSAZIONE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ANAG_FULL"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogValidate-input"
                                    name="LogValidate"
                                    tibex:xpdlId="7a14e3cf-fb38-440f-bdd6-343a67bc9c05"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
