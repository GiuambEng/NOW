    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="www.telecom.Now.outputtriggerOLO.onLine"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://tim.now.alignement.Jpub.adapter.OLO.interprocess.OnLine"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:currentElement" name="Current"/>
        <bpws:variable element="ns1:ANAGRAFICA_GESTORI"
            name="Validate-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:ANAGRAFICA_GESTORI" name="Validate" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:root" name="Input-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:root" name="Input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:Output" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="Check" type="xsd:string"/>
        <bpws:variable element="ns4:CW_BUS_MESSAGE"
            name="LogError-input" sca-bpel:internal="true"/>
        <bpws:variable name="Counter" type="xsd:integer">
            <bpws:from>
                <bpws:literal>1</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="Application" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/Application" type="xsd:string"/>
        <bpws:variable name="LoggerName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable name="LoggerLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerLevel" type="xsd:string"/>
        <bpws:variable name="ErrorLoggerLevel"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Log/ErrorLoggerLevel" type="xsd:string"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable name="OK_ELAB_STAG" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/OKElabStaging" type="xsd:int"/>
        <bpws:variable name="KO_ELAB_STAG" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/KOElabStaging" type="xsd:int"/>
        <bpws:variable element="ns5:jdbcUpdateActivityInput"
            name="Insert-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:jdbcUpdateActivityOutput"
            name="Insert" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns7:AccumulatedOutput" name="Accumulate" sca-bpel:internal="true"/>
        <bpws:variable name="TimeOut" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/JDBC/TimeOut" type="xsd:int"/>
        <bpws:variable element="ns4:CW_BUS_MESSAGE"
            name="LogValidate-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="e2afabb1-e47b-4ec0-bb42-b7d052a2c6b6"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToWhile"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="b7c74669-4139-438f-9e33-6e6cc2521380" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tim.now.alignement.Jpub.adapter.OLO.interprocess.OnLine&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;xsl:for-each select=&quot;$Accumulate/tns:root[tns:AnagraficaOLO/tns:Status='OK']&quot;>&lt;tns:Output_Olo>&lt;tns:TIPO_AZIONE>&lt;xsl:value-of select=&quot;tns:AnagraficaOLO/tns:TIPO_AZIONE&quot;/>&lt;/tns:TIPO_AZIONE>&lt;tns:CODE_GEST>&lt;xsl:value-of select=&quot;tns:AnagraficaOLO/tns:CODE_GEST&quot;/>&lt;/tns:CODE_GEST>&lt;tns:NOME_RAG_SOC_GEST>&lt;xsl:value-of select=&quot;tns:AnagraficaOLO/tns:NOME_RAG_SOC_GEST&quot;/>&lt;/tns:NOME_RAG_SOC_GEST>&lt;tns:NOME_GEST_SIGLA>&lt;xsl:value-of select=&quot;tns:AnagraficaOLO/tns:NOME_GEST_SIGLA&quot;/>&lt;/tns:NOME_GEST_SIGLA>&lt;tns:CODE_PARTITA_IVA>&lt;xsl:value-of select=&quot;tns:AnagraficaOLO/tns:CODE_PARTITA_IVA&quot;/>&lt;/tns:CODE_PARTITA_IVA>&lt;tns:CODE_GEST_TIRKS>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CODE_GEST_TIRKS>&lt;/tns:Output_Olo>&lt;/xsl:for-each>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="282b7c4e-b775-44bd-be9a-6433b637c4fc">
                <bpws:targets>
                    <bpws:target linkName="StartToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+96dfc401-b457-4d66-a10d-c3bc1c1df084" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Counter &lt;=count($Start/ns0:Olo)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Counter <=count($Start/ns0:Olo)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="CurrentToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ValidateToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ValidateToAssign" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="CheckErroreToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogErrorToInput" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToCurrent" tibex:linkType="SUCCESS"/>
                                <bpws:link name="SetCheckToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InputToJDBCUpdate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdateToCounter" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToInput" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="04caf584-3596-42d0-91cf-bf61e303bc00">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToCurrent"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="96dfc401-b457-4d66-a10d-c3bc1c1df084" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SetCheckToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Input</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Current"
                                    name="Current"
                                    outputVariable="Current"
                                    tibex:xpdlId="02e52f49-f860-4e4c-bc35-4a0be791abf6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCurrent"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CurrentToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.telecom.Now.outputtriggerOLO.onLine&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Counter&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Current&quot; match=&quot;/&quot;>&lt;ns:currentElement>&lt;ns:Olo>&lt;xsl:if test=&quot;$Start/ns:Olo[number($Counter)]/ns:COD_OLO_AGCOM&quot;>&lt;ns:COD_OLO_AGCOM>&lt;xsl:value-of select=&quot;$Start/ns:Olo[number($Counter)]/ns:COD_OLO_AGCOM&quot;/>&lt;/ns:COD_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Olo[number($Counter)]/ns:NOME&quot;>&lt;ns:NOME>&lt;xsl:value-of select=&quot;$Start/ns:Olo[number($Counter)]/ns:NOME&quot;/>&lt;/ns:NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Olo[number($Counter)]/ns:PARTITA_IVA&quot;>&lt;ns:PARTITA_IVA>&lt;xsl:value-of select=&quot;$Start/ns:Olo[number($Counter)]/ns:PARTITA_IVA&quot;/>&lt;/ns:PARTITA_IVA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:Olo[number($Counter)]/ns:RAGIONE_SOCIALE&quot;>&lt;ns:RAGIONE_SOCIALE>&lt;xsl:value-of select=&quot;$Start/ns:Olo[number($Counter)]/ns:RAGIONE_SOCIALE&quot;/>&lt;/ns:RAGIONE_SOCIALE>&lt;/xsl:if>&lt;/ns:Olo>&lt;/ns:currentElement>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Current" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Validate-input"
                                    name="Validate"
                                    outputVariable="Validate"
                                    tibex:xpdlId="9b6146f6-f806-43cb-95d1-2658393abbbd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CurrentToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ValidateToCallProcess"/>
                                    <bpws:source
                                    linkName="ValidateToAssign"
                                    tibex:faultDetailsVar="Validate" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.telecom.Now.outputtriggerOLO.onLine&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Current&quot;/>&lt;xsl:template name=&quot;Validate-input&quot; match=&quot;/&quot;>&lt;ns2:ANAGRAFICA_GESTORI>&lt;TIPO_AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;ATT&amp;quot;&quot;/>&lt;/TIPO_AZIONE>&lt;CODE_GEST>&lt;xsl:value-of select=&quot;$Current/ns1:Olo/ns1:COD_OLO_AGCOM&quot;/>&lt;/CODE_GEST>&lt;NOME_RAG_SOC_GEST>&lt;xsl:value-of select=&quot;$Current/ns1:Olo/ns1:RAGIONE_SOCIALE&quot;/>&lt;/NOME_RAG_SOC_GEST>&lt;NOME_GEST_SIGLA>&lt;xsl:value-of select=&quot;$Current/ns1:Olo/ns1:NOME&quot;/>&lt;/NOME_GEST_SIGLA>&lt;CODE_PARTITA_IVA>&lt;xsl:value-of select=&quot;$Current/ns1:Olo/ns1:PARTITA_IVA&quot;/>&lt;/CODE_PARTITA_IVA>&lt;CODE_GEST_TIRKS>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CODE_GEST_TIRKS>&lt;/ns2:ANAGRAFICA_GESTORI>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:AggiornamentoMassiveAnagrafiche_Input="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="AggiornamentoMassiveAnagrafiche_Input:ANAGRAFICA_GESTORI" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Input-input"
                                    name="Input" outputVariable="Input"
                                    tibex:xpdlId="7b2c0436-5568-4793-bce4-c798568a0d61" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogErrorToInput"/>
                                    <bpws:target linkName="CallProcessToInput"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InputToJDBCUpdate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tim.now.alignement.Jpub.adapter.OLO.interprocess.OnLine&quot; xmlns:ns=&quot;www.telecom.Now.outputtriggerOLO.onLine&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Current&quot;/>&lt;xsl:param name=&quot;Check&quot;/>&lt;xsl:template name=&quot;Input-input&quot; match=&quot;/&quot;>&lt;tns:root>&lt;tns:AnagraficaOLO>&lt;tns:TIPO_AZIONE>&lt;xsl:value-of select=&quot;'ATT'&quot;/>&lt;/tns:TIPO_AZIONE>&lt;tns:CODE_GEST>&lt;xsl:value-of select=&quot;$Current/ns:Olo/ns:COD_OLO_AGCOM&quot;/>&lt;/tns:CODE_GEST>&lt;tns:NOME_RAG_SOC_GEST>&lt;xsl:value-of select=&quot;$Current/ns:Olo/ns:RAGIONE_SOCIALE&quot;/>&lt;/tns:NOME_RAG_SOC_GEST>&lt;tns:NOME_GEST_SIGLA>&lt;xsl:value-of select=&quot;$Current/ns:Olo/ns:NOME&quot;/>&lt;/tns:NOME_GEST_SIGLA>&lt;tns:CODE_PARTITA_IVA>&lt;xsl:value-of select=&quot;$Current/ns:Olo/ns:PARTITA_IVA&quot;/>&lt;/tns:CODE_PARTITA_IVA>&lt;tns:CODE_GEST_TIRKS>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CODE_GEST_TIRKS>&lt;xsl:choose>&lt;xsl:when test=&quot;$Check='ERRORE'&quot;>&lt;tns:Status>&lt;xsl:value-of select=&quot;'ERRORE'&quot;/>&lt;/tns:Status>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Status>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Status>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:AnagraficaOLO>&lt;/tns:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
