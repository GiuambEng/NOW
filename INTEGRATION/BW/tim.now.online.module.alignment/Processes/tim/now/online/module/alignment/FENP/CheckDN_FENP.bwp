                                inputVariable="Response"
                                name="Response_Error"
                                outputVariable="Response"
                                tibex:xpdlId="e8ebd191-7351-43c9-ae55-d0312a7551c2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="GestioneErroreToResponse_Error_Interface"/>
                                    <bpws:target linkName="GenericLogger1ToResponse_Error_Interface"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Assign1ToResponseLog">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Response_ErrorToUpdateOnErrorStaging">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($GestioneErrore/part1/ns11:Output/ns11:ID_ESEC_PROCSO_NOFILE)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($GestioneErrore.part1/ns11:ID_ESEC_PROCSO_NOFILE)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim-now/Schemas/CheckDN_FENP&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;xsl:choose>&#xa;                &lt;!--&quot;Errore d'interfaccia&quot;-->&lt;xsl:when test=&quot;$FaultDetails/ActivityName=&amp;quot;VerificaRientroInTI&amp;quot;&quot;>&lt;tns:VerificaRientroInTI_Response>&lt;tns:Data_Risposta>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:Data_Risposta>&lt;tns:Directory_Number>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:Directory_Number>&lt;tns:AmbitoDiCompetenza>&lt;xsl:value-of select=&quot;'Non di competenza NOW'&quot;/>&lt;/tns:AmbitoDiCompetenza>&lt;tns:ReturnCode>&lt;xsl:value-of select=&quot;&amp;quot;02&amp;quot;&quot;/>&lt;/tns:ReturnCode>&lt;tns:ErrMsg>&lt;xsl:value-of select=&quot;&amp;quot;Errore d'input&amp;quot;&quot;/>&lt;/tns:ErrMsg>&lt;/tns:VerificaRientroInTI_Response>&lt;/xsl:when>&#xa;                                                                &lt;!--&quot;Errore generico&quot;-->&lt;xsl:otherwise>&lt;tns:VerificaRientroInTI_Response>&lt;tns:Data_Risposta>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:Data_Risposta>&lt;tns:Directory_Number>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:Directory_Number>&lt;tns:AmbitoDiCompetenza>&lt;xsl:value-of select=&quot;'Non di competenza NOW'&quot;/>&lt;/tns:AmbitoDiCompetenza>&lt;tns:ReturnCode>&lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&lt;/tns:ReturnCode>&lt;tns:ErrMsg>&lt;xsl:value-of select=&quot;&amp;quot;Errore generico&amp;quot;&quot;/>&lt;/tns:ErrMsg>&lt;/tns:VerificaRientroInTI_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
