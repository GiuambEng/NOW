                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim-now.it/WSDL/CheckDN_FENP" version="2.0"&gt;&lt;xsl:param name="Response"/&gt;&lt;xsl:template name="Reply_ErrorInterface-input" match="/"&gt;&lt;tns:VerificaRientroInTI_Response&gt;&lt;Out&gt;&lt;xsl:copy-of select="$Response"/&gt;&lt;/Out&gt;&lt;/tns:VerificaRientroInTI_Response&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim-now.it/WSDL/CheckDN_FENP&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply_ErrorInterface-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$Response&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
