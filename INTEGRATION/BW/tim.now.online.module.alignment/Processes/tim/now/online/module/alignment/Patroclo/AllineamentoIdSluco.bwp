                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendIDSLUCOolo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SendIDSLUCOoloIn&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;ErrorResponse-input&quot; match=&quot;/&quot;>&lt;tns:NOWSendIDSLUCOolo_output>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($SendIDSLUCOoloIn/parameters/tns:NOWSendIDSLUCOolo_input/tns:Transaction_id)>0&quot;>&lt;tns:Transaction_ID>&lt;xsl:value-of select=&quot;$SendIDSLUCOoloIn/parameters/tns:NOWSendIDSLUCOolo_input/tns:Transaction_id&quot;/>&lt;/tns:Transaction_ID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Transaction_ID>&lt;xsl:value-of select=&quot;'NULL'&quot;/>&lt;/tns:Transaction_ID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:Response_date>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]-[M01]-[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/tns:Response_date>&lt;xsl:choose>&lt;xsl:when test=&quot;$FaultDetails/ActivityName='Throw1'&quot;>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;&amp;quot;05&amp;quot;&quot;/>&lt;/tns:Return_Code>&lt;/xsl:when>&lt;xsl:when test=&quot;$FaultDetails/ActivityName='Throw'&quot;>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;&amp;quot;03&amp;quot;&quot;/>&lt;/tns:Return_Code>&lt;/xsl:when>&lt;xsl:when test=&quot;$FaultDetails/ActivityName='SendIDSLUCOoloIn'&quot;>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;&amp;quot;07&amp;quot;&quot;/>&lt;/tns:Return_Code>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;&amp;quot;06&amp;quot;&quot;/>&lt;/tns:Return_Code>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$FaultDetails/ActivityName='Throw'&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;'Data consegna OLO non valida'&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:when>&lt;xsl:when test=&quot;$FaultDetails/ActivityName='Throw1'&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;'Data invio non valida'&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:when>&lt;xsl:when test=&quot;$FaultDetails/ActivityName='SendIDSLUCOoloIn'&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;'Errore validazione messaggio'&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;'Errore generico'&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:NOWSendIDSLUCOolo_output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
