                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendIDSLUCOolo&quot; xmlns:ns=&quot;www.tim.now.storedProcedureAllineamentoIDSluco&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SendIDSLUCOoloIn&quot;/>&lt;xsl:param name=&quot;transactionDate&quot;/>&lt;xsl:param name=&quot;Sub_Allineamento&quot;/>&lt;xsl:template name=&quot;VarResponse&quot; match=&quot;/&quot;>&lt;tns:NOWSendIDSLUCOolo_output>&lt;tns:Transaction_ID>&lt;xsl:value-of select=&quot;$SendIDSLUCOoloIn/parameters/tns:NOWSendIDSLUCOolo_input/tns:Transaction_id&quot;/>&lt;/tns:Transaction_ID>&lt;tns:Response_date>&lt;xsl:value-of select=&quot;$transactionDate&quot;/>&lt;/tns:Response_date>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;$Sub_Allineamento/ns:Return_Code&quot;/>&lt;/tns:Return_Code>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;$Sub_Allineamento/ns:Descrizione_Errore&quot;/>&lt;/tns:Descrizione_errore>&lt;/tns:NOWSendIDSLUCOolo_output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
