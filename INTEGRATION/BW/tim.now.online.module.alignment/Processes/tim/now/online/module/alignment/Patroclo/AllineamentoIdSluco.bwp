                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendIDSLUCOolo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendIDSLUCOoloIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NOWSendIDSLUCOolo_output>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($SendIDSLUCOoloIn.parameters/tns:Transaction_id)>0&quot;>&#xa;                    &lt;tns:Transaction_ID>&#xa;                        &lt;xsl:value-of select=&quot;$SendIDSLUCOoloIn.parameters/tns:Transaction_id&quot;/>&#xa;                    &lt;/tns:Transaction_ID>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:Transaction_ID>&#xa;                        &lt;xsl:value-of select=&quot;'NULL'&quot;/>&#xa;                    &lt;/tns:Transaction_ID>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:Response_date>&#xa;                &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]-[M01]-[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;            &lt;/tns:Response_date>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FaultDetails/ActivityName='Throw1'&quot;>&#xa;                    &lt;tns:Return_Code>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;05&amp;quot;&quot;/>&#xa;                    &lt;/tns:Return_Code>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FaultDetails/ActivityName='Throw'&quot;>&#xa;                    &lt;tns:Return_Code>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;03&amp;quot;&quot;/>&#xa;                    &lt;/tns:Return_Code>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FaultDetails/ActivityName='SendIDSLUCOoloIn'&quot;>&#xa;                    &lt;tns:Return_Code>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;07&amp;quot;&quot;/>&#xa;                    &lt;/tns:Return_Code>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:Return_Code>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;06&amp;quot;&quot;/>&#xa;                    &lt;/tns:Return_Code>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FaultDetails/ActivityName='Throw'&quot;>&#xa;                    &lt;tns:Descrizione_errore>&#xa;                        &lt;xsl:value-of select=&quot;'Data consegna OLO non valida'&quot;/>&#xa;                    &lt;/tns:Descrizione_errore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FaultDetails/ActivityName='Throw1'&quot;>&#xa;                    &lt;tns:Descrizione_errore>&#xa;                        &lt;xsl:value-of select=&quot;'Data invio non valida'&quot;/>&#xa;                    &lt;/tns:Descrizione_errore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FaultDetails/ActivityName='SendIDSLUCOoloIn'&quot;>&#xa;                    &lt;tns:Descrizione_errore>&#xa;                        &lt;xsl:value-of select=&quot;'Errore validazione messaggio'&quot;/>&#xa;                    &lt;/tns:Descrizione_errore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:Descrizione_errore>&#xa;                        &lt;xsl:value-of select=&quot;'Errore generico'&quot;/>&#xa;                    &lt;/tns:Descrizione_errore>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:NOWSendIDSLUCOolo_output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
