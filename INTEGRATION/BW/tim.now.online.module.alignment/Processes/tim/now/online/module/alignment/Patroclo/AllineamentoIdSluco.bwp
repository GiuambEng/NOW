                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendIDSLUCOolo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendIDSLUCOoloIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessIstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_Procso_noFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:ActivityName>&#xa;                &lt;xsl:value-of select=&quot;'AllineamentoPatroclo'&quot;/>&#xa;            &lt;/ns:ActivityName>&#xa;            &lt;ns:Error>&#xa;                &lt;ns:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ActivityName&quot;/>&#xa;                &lt;/ns:ActivityName>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$FaultDetails/ActivityName='Throw'&quot;>&#xa;                        &lt;ns:Msg>&#xa;                            &lt;xsl:value-of select=&quot;'Data consegna OLO non valida'&quot;/>&#xa;                        &lt;/ns:Msg>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$FaultDetails/ActivityName='Throw1'&quot;>&#xa;                        &lt;ns:Msg>&#xa;                            &lt;xsl:value-of select=&quot;'Data invio non valida'&quot;/>&#xa;                        &lt;/ns:Msg>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:Msg>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                        &lt;/ns:Msg>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$FaultDetails/ActivityName='Throw'&quot;>&#xa;                        &lt;ns:MsgCode>&#xa;                            &lt;xsl:value-of select=&quot;'03'&quot;/>&#xa;                        &lt;/ns:MsgCode>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$FaultDetails/ActivityName='Throw1'&quot;>&#xa;                        &lt;ns:MsgCode>&#xa;                            &lt;xsl:value-of select=&quot;'05'&quot;/>&#xa;                        &lt;/ns:MsgCode>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:MsgCode>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/ns:MsgCode>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                &lt;/ns:ProcessStack>&#xa;                &lt;ns:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                &lt;/ns:StackTrace>&#xa;            &lt;/ns:Error>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ProcessIstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessIstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessIstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($SendIDSLUCOoloIn.parameters/tns1:Transaction_id)>0&quot;>&#xa;                    &lt;ns:PatrocloTransactionID>&#xa;                        &lt;xsl:value-of select=&quot;$SendIDSLUCOoloIn.parameters/tns1:Transaction_id&quot;/>&#xa;                    &lt;/ns:PatrocloTransactionID>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:ID_PROCSO_NOFILE>&#xa;                &lt;xsl:value-of select=&quot;$ID_Procso_noFile&quot;/>&#xa;            &lt;/ns:ID_PROCSO_NOFILE>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
