                        </bpws:invoke>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NOW_Patroclo_SendIDULLCOoloIn&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;ErrorResponse-input&quot; match=&quot;/&quot;>&lt;tns2:NOW_Patroclo_SendIDULLCOolo_response>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:Transaction_id)>0&quot;>&lt;tns2:Transaction_id>&lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:Transaction_id&quot;/>&lt;/tns2:Transaction_id>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Transaction_id>&lt;xsl:value-of select=&quot;'Null'&quot;/>&lt;/tns2:Transaction_id>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:Response_date>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]-[M01]-[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/tns2:Response_date>&lt;xsl:choose>&lt;xsl:when test=&quot;$FaultDetails/ActivityName='NOW_Patroclo_SendIDULLCOoloIn'&quot;>&lt;tns2:Return_Code>&lt;xsl:value-of select=&quot;'07'&quot;/>&lt;/tns2:Return_Code>&lt;/xsl:when>&lt;xsl:when test=&quot;$FaultDetails/ActivityName='AssignDataInvio'&quot;>&lt;tns2:Return_Code>&lt;xsl:value-of select=&quot;'05'&quot;/>&lt;/tns2:Return_Code>&lt;/xsl:when>&lt;xsl:when test=&quot;$FaultDetails/ActivityName='AssignDataConsegnaOLO'&quot;>&lt;tns2:Return_Code>&lt;xsl:value-of select=&quot;'03'&quot;/>&lt;/tns2:Return_Code>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Return_Code>&lt;xsl:value-of select=&quot;'06'&quot;/>&lt;/tns2:Return_Code>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$FaultDetails/ActivityName='NOW_Patroclo_SendIDULLCOoloIn'&quot;>&lt;tns2:Descrizione_errore>&lt;xsl:value-of select=&quot;'Errore validazione messaggio'&quot;/>&lt;/tns2:Descrizione_errore>&lt;/xsl:when>&lt;xsl:when test=&quot;$FaultDetails/ActivityName='AssignDataInvio'&quot;>&lt;tns2:Descrizione_errore>&lt;xsl:value-of select=&quot;'Data invio non valida'&quot;/>&lt;/tns2:Descrizione_errore>&lt;/xsl:when>&lt;xsl:when test=&quot;$FaultDetails/ActivityName='AssignDataConsegnaOLO'&quot;>&lt;tns2:Descrizione_errore>&lt;xsl:value-of select=&quot;'Data consegna OLO non valida'&quot;/>&lt;/tns2:Descrizione_errore>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Descrizione_errore>&lt;xsl:value-of select=&quot;'ErroreGenerico'&quot;/>&lt;/tns2:Descrizione_errore>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:NOW_Patroclo_SendIDULLCOolo_response>&lt;/xsl:template>&lt;/xsl:stylesheet>"
