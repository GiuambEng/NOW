Context/ns2:remoteaddress"/&gt;&lt;/tns5:HOSTNAME_CLIENT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetContext/ns2:remoteaddress"&gt;&lt;tns5:IP_CLIENT&gt;&lt;xsl:value-of select="$GetContext/ns2:remoteaddress"/&gt;&lt;/tns5:IP_CLIENT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetLocalIP/tns6:IPAddress"&gt;&lt;tns5:IP_SERVER&gt;&lt;xsl:value-of select="$GetLocalIP/tns6:IPAddress"/&gt;&lt;/tns5:IP_SERVER&gt;&lt;/xsl:if&gt;&lt;tns5:OS_USER&gt;&lt;xsl:value-of select="bw:getSystemProperty(&amp;quot;os.name&amp;quot;)"/&gt;&lt;/tns5:OS_USER&gt;&lt;tns5:SERVER_NAME&gt;&lt;xsl:value-of select="bw:getHostName()"/&gt;&lt;/tns5:SERVER_NAME&gt;&lt;tns5:COD_INTRFC&gt;&lt;xsl:value-of select="'ID375'"/&gt;&lt;/tns5:COD_INTRFC&gt;&lt;tns5:SESSION_ID&gt;&lt;xsl:value-of select="concat('AllineamentoIdUllco_', $NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:Transaction_id)"/&gt;&lt;/tns5:SESSION_ID&gt;&lt;tns5:TIPO_OPERAZIONE&gt;&lt;xsl:value-of select="&amp;quot;LOGIN&amp;quot;"/&gt;&lt;/tns5:TIPO_OPERAZIONE&gt;&lt;tns5:SISTEMA_CHIAMANTE&gt;&lt;xsl:value-of select="'PATROCLO'"/&gt;&lt;/tns5:SISTEMA_CHIAMANTE&gt;&lt;xsl:if test="$ProcessIstance/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE"&gt;&lt;tns5:ID_ESE_PROC_NO_FILE&gt;&lt;xsl:value-of select="$ProcessIstance/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/tns5:ID_ESE_PROC_NO_FILE&gt;&lt;/xsl:if&gt;&lt;tns5:NOME_TAB_STAGING&gt;&lt;xsl:value-of select="'STAG_CLC_IDULLCO_NOFIN'"/&gt;&lt;/tns5:NOME_TAB_STAGING&gt;&lt;/tns5:InputDataUserLog&gt;&lt;/tns5:LoggerSecurityInput&gt;&lt;/parameters&gt;&lt;/tns4:NewOperationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/LoggerServiceSecurityDataServices/&quot; xmlns:tns5=&quot;http://www.example.org/ServicesSecurityData&quot; xmlns:ns2=&quot;www.tim.now.HeaderConnection&quot; xmlns:tns6=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOW_Patroclo_SendIDULLCOoloIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessIstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;GetContext&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:template name=&quot;SecurityLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:LoggerSecurityInput>&#xa;            &lt;tns5:LogInfo>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:ServiceName>&#xa;                    &lt;xsl:value-of select=&quot;'NOW_Patroclo_SendIdColocazione'&quot;/>&#xa;                &lt;/tns5:ServiceName>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'NOW_Patroclo_SendIDULLCOolo'&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;tns5:JMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:JMS>&#xa;            &lt;/tns5:LogInfo>&#xa;            &lt;tns5:InputDataUserLog>&#xa;                &lt;tns5:APPLICAZIONE_CLIENT>&#xa;                    &lt;xsl:value-of select=&quot;'RICHIESTA ONLINE ALLINEAMENTO IDULLCO DA PATROCLO A NOW'&quot;/>&#xa;                &lt;/tns5:APPLICAZIONE_CLIENT>&#xa;                &lt;tns5:COD_FUNZIONE>&#xa;                    &lt;xsl:value-of select=&quot;'Monitoraggio Accessi M2M'&quot;/>&#xa;                &lt;/tns5:COD_FUNZIONE>&#xa;                &lt;tns5:COD_PROFILO>&#xa;                    &lt;xsl:value-of select=&quot;'M2M'&quot;/>&#xa;                &lt;/tns5:COD_PROFILO>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns2:remoteaddress&quot;>&#xa;                    &lt;tns5:HOSTNAME_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns2:remoteaddress&quot;/>&#xa;                    &lt;/tns5:HOSTNAME_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns2:remoteaddress&quot;>&#xa;                    &lt;tns5:IP_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns2:remoteaddress&quot;/>&#xa;                    &lt;/tns5:IP_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns6:IPAddress&quot;>&#xa;                    &lt;tns5:IP_SERVER>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns6:IPAddress&quot;/>&#xa;                    &lt;/tns5:IP_SERVER>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:OS_USER>&#xa;                    &lt;xsl:value-of select=&quot;bw:getSystemProperty(&amp;quot;os.name&amp;quot;)&quot;/>&#xa;                &lt;/tns5:OS_USER>&#xa;                &lt;tns5:SERVER_NAME>&#xa;                    &lt;xsl:value-of select=&quot;bw:getHostName()&quot;/>&#xa;                &lt;/tns5:SERVER_NAME>&#xa;                &lt;tns5:COD_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;'ID375'&quot;/>&#xa;                &lt;/tns5:COD_INTRFC>&#xa;                &lt;tns5:SESSION_ID>&#xa;                    &lt;xsl:value-of select=&quot;concat('AllineamentoIdUllco_', $NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:Transaction_id)&quot;/>&#xa;                &lt;/tns5:SESSION_ID>&#xa;                &lt;tns5:TIPO_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LOGIN&amp;quot;&quot;/>&#xa;                &lt;/tns5:TIPO_OPERAZIONE>&#xa;                &lt;tns5:SISTEMA_CHIAMANTE>&#xa;                    &lt;xsl:value-of select=&quot;'PATROCLO'&quot;/>&#xa;                &lt;/tns5:SISTEMA_CHIAMANTE>&#xa;                &lt;xsl:if test=&quot;$ProcessIstance.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                    &lt;tns5:ID_ESE_PROC_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ProcessIstance.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                    &lt;/tns5:ID_ESE_PROC_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:NOME_TAB_STAGING>&#xa;                    &lt;xsl:value-of select=&quot;'STAG_CLC_IDULLCO_NOFIN'&quot;/>&#xa;                &lt;/tns5:NOME_TAB_STAGING>&#xa;            &lt;/tns5:InputDataUserLog>&#xa;        &lt;/tns5:LoggerSecurityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
