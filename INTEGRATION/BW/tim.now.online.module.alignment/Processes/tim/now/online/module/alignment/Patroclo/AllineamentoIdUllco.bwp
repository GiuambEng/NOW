                                <bpws:target linkName="ErrorLogToGestioneErrore"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source
                                    linkName="ErrorToGenericLogger"
                                    tibex:faultDetailsVar="Error" tibex:faultNameVar="FaultName">
