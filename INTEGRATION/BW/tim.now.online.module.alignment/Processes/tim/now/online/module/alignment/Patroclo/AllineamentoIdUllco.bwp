                            partnerLink="GestioneErrore"
                            portType="ns11:GenericError" tibex:xpdlId="a6c0a063-3668-4130-8077-be9a3e4a895b">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns9="http://xmlns.example.com/1469551322714" xmlns:ns3="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO/" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:param name="ProcessIstance"/&gt;&lt;xsl:param name="NOW_Patroclo_SendIDULLCOoloIn"/&gt;&lt;xsl:param name="ID_Procso_noFile"/&gt;&lt;xsl:template name="Error-input" match="/"&gt;&lt;tns9:Input&gt;&lt;part1&gt;&lt;ns3:Input&gt;&lt;ns3:ActivityName&gt;&lt;xsl:value-of select="'AllineamentoIdUllco'"/&gt;&lt;/ns3:ActivityName&gt;&lt;ns3:Error&gt;&lt;ns3:ActivityName&gt;&lt;xsl:value-of select="$FaultDetails/ActivityName"/&gt;&lt;/ns3:ActivityName&gt;&lt;ns3:Msg&gt;&lt;xsl:value-of select="$FaultDetails/Msg"/&gt;&lt;/ns3:Msg&gt;&lt;ns3:MsgCode&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/ns3:MsgCode&gt;&lt;ns3:ProcessStack&gt;&lt;xsl:value-of select="$FaultDetails/ProcessStack"/&gt;&lt;/ns3:ProcessStack&gt;&lt;ns3:StackTrace&gt;&lt;xsl:value-of select="$FaultDetails/StackTrace"/&gt;&lt;/ns3:StackTrace&gt;&lt;/ns3:Error&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ProcessIstance/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;&lt;xsl:if test="$ProcessIstance/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns3:ID_Esec_Proc&gt;&lt;xsl:value-of select="$ProcessIstance/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns3:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:Transaction_id)&gt;0"&gt;&lt;ns3:PatrocloTransactionID&gt;&lt;xsl:value-of select="$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:Transaction_id"/&gt;&lt;/ns3:PatrocloTransactionID&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;ns3:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$ID_Procso_noFile"/&gt;&lt;/ns3:ID_PROCSO_NOFILE&gt;&lt;/ns3:Input&gt;&lt;/part1&gt;&lt;/tns9:Input&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns3=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOW_Patroclo_SendIDULLCOoloIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessIstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_Procso_noFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Input>&#xa;            &lt;ns3:ActivityName>&#xa;                &lt;xsl:value-of select=&quot;'AllineamentoIdUllco'&quot;/>&#xa;            &lt;/ns3:ActivityName>&#xa;            &lt;ns3:Error>&#xa;                &lt;ns3:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ActivityName&quot;/>&#xa;                &lt;/ns3:ActivityName>&#xa;                &lt;ns3:Msg>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                &lt;/ns3:Msg>&#xa;                &lt;ns3:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/ns3:MsgCode>&#xa;                &lt;ns3:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                &lt;/ns3:ProcessStack>&#xa;                &lt;ns3:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                &lt;/ns3:StackTrace>&#xa;            &lt;/ns3:Error>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ProcessIstance.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessIstance.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns3:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessIstance.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns3:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:Transaction_id)>0&quot;>&#xa;                    &lt;ns3:PatrocloTransactionID>&#xa;                        &lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:Transaction_id&quot;/>&#xa;                    &lt;/ns3:PatrocloTransactionID>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns3:ID_PROCSO_NOFILE>&#xa;                &lt;xsl:value-of select=&quot;$ID_Procso_noFile&quot;/>&#xa;            &lt;/ns3:ID_PROCSO_NOFILE>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
