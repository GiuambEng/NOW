            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;www.tim.now.stagingSendIdullco&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ProcessIstance&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;NOW_Patroclo_SendIDULLCOoloIn&quot;/>&lt;xsl:param name=&quot;RicevutaRichiesta&quot;/>&lt;xsl:template name=&quot;sub_StagingIdUllco-input&quot; match=&quot;/&quot;>&lt;ns1:INPUT>&lt;ns1:Insert>&lt;ns1:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request)&quot;/>&lt;/ns1:CONTENUTO_REQUEST>&lt;ns1:OLO>&lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:OPERATORE&quot;/>&lt;/ns1:OLO>&lt;ns1:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE,'.'))&quot;/>&lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&lt;ns1:ID_RICH_CLC_IDULLCO>&lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:Transaction_id&quot;/>&lt;/ns1:ID_RICH_CLC_IDULLCO>&lt;ns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$RicevutaRichiesta&quot;/>&lt;/ns1:ID_STATO_ELAB_STAG>&lt;ns1:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns1:TIMSTP_RICH>&lt;ns1:IDULLCO>&lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:IDULLCO&quot;/>&lt;/ns1:IDULLCO>&lt;ns1:CLLI>&lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:CLLI&quot;/>&lt;/ns1:CLLI>&lt;ns1:DATA_CONSEGNA_OLO>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;dd-MM-yyyy&amp;quot;, $NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:DATA_CONSEGNA_OLO), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/ns1:DATA_CONSEGNA_OLO>&lt;ns1:DATA_FINE_VALIDITA>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;dd-MM-yyyy&amp;quot;, $NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:DATA_FINE_VALIDITA), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/ns1:DATA_FINE_VALIDITA>&lt;ns1:DATA_INVIO>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;dd-MM-yyyy&amp;quot;, $NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:DATA_INVIO), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/ns1:DATA_INVIO>&lt;ns1:NOME>&lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:Nome&quot;/>&lt;/ns1:NOME>&lt;xsl:if test=&quot;$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:DRCP&quot;>&lt;ns1:DRCP>&lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:DRCP&quot;/>&lt;/ns1:DRCP>&lt;/xsl:if>&lt;ns1:COD_GAT>&lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:Codice_GAT&quot;/>&lt;/ns1:COD_GAT>&lt;ns1:PID>&lt;xsl:value-of select=&quot;concat ( 'PID = ', $_processContext/ProcessInstanceId)&quot;/>&lt;/ns1:PID>&lt;ns1:AZIONE>&lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:Azione&quot;/>&lt;/ns1:AZIONE>&lt;ns1:SISTEMA_SORGENTE>&lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:Sistema_origine&quot;/>&lt;/ns1:SISTEMA_SORGENTE>&lt;xsl:if test=&quot;$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:TIPO_COLOCAZIONE&quot;>&lt;ns1:TIPOLOGIA_COLOCAZIONE>&lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn/parameters/tns2:NOW_Patroclo_SendIDULLCOolo_request/tns2:TIPO_COLOCAZIONE&quot;/>&lt;/ns1:TIPOLOGIA_COLOCAZIONE>&lt;/xsl:if>&lt;/ns1:Insert>&lt;/ns1:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
