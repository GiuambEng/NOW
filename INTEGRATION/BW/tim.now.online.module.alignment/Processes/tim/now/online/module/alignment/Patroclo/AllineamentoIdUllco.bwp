                    <bpws:sources>
                        <bpws:source linkName="sub_StagingIdUllcoToAllineamentoIdUllco"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;www.tim.now.stagingSendIdullco&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOW_Patroclo_SendIDULLCOoloIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessIstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;RicevutaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;sub_StagingIdUllco-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:INPUT>&#xa;            &lt;ns1:Insert>&#xa;                &lt;ns1:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($NOW_Patroclo_SendIDULLCOoloIn.parameters)&quot;/>&#xa;                &lt;/ns1:CONTENUTO_REQUEST>&#xa;                &lt;ns1:OLO>&#xa;                    &lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:OPERATORE&quot;/>&#xa;                &lt;/ns1:OLO>&#xa;                &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE,'.'))&quot;/>&#xa;                &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns1:ID_RICH_CLC_IDULLCO>&#xa;                    &lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:Transaction_id&quot;/>&#xa;                &lt;/ns1:ID_RICH_CLC_IDULLCO>&#xa;                &lt;ns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$RicevutaRichiesta&quot;/>&#xa;                &lt;/ns1:ID_STATO_ELAB_STAG>&#xa;                &lt;ns1:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns1:TIMSTP_RICH>&#xa;                &lt;ns1:IDULLCO>&#xa;                    &lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:IDULLCO&quot;/>&#xa;                &lt;/ns1:IDULLCO>&#xa;                &lt;ns1:CLLI>&#xa;                    &lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:CLLI&quot;/>&#xa;                &lt;/ns1:CLLI>&#xa;                &lt;ns1:DATA_CONSEGNA_OLO>&#xa;                    &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;dd-MM-yyyy&amp;quot;, $NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:DATA_CONSEGNA_OLO), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&#xa;                &lt;/ns1:DATA_CONSEGNA_OLO>&#xa;                &lt;ns1:DATA_FINE_VALIDITA>&#xa;                    &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;dd-MM-yyyy&amp;quot;, $NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:DATA_FINE_VALIDITA), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&#xa;                &lt;/ns1:DATA_FINE_VALIDITA>&#xa;                &lt;ns1:DATA_INVIO>&#xa;                    &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;dd-MM-yyyy&amp;quot;, $NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:DATA_INVIO), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&#xa;                &lt;/ns1:DATA_INVIO>&#xa;                &lt;ns1:NOME>&#xa;                    &lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:Nome&quot;/>&#xa;                &lt;/ns1:NOME>&#xa;                &lt;xsl:if test=&quot;$NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:DRCP&quot;>&#xa;                    &lt;ns1:DRCP>&#xa;                        &lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:DRCP&quot;/>&#xa;                    &lt;/ns1:DRCP>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns1:COD_GAT>&#xa;                    &lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:Codice_GAT&quot;/>&#xa;                &lt;/ns1:COD_GAT>&#xa;                &lt;ns1:PID>&#xa;                    &lt;xsl:value-of select=&quot;concat ( 'PID = ', $_processContext/ProcessInstanceId)&quot;/>&#xa;                &lt;/ns1:PID>&#xa;                &lt;ns1:AZIONE>&#xa;                    &lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:Azione&quot;/>&#xa;                &lt;/ns1:AZIONE>&#xa;                &lt;ns1:SISTEMA_SORGENTE>&#xa;                    &lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:Sistema_origine&quot;/>&#xa;                &lt;/ns1:SISTEMA_SORGENTE>&#xa;                &lt;xsl:if test=&quot;$NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:TIPO_COLOCAZIONE&quot;>&#xa;                    &lt;ns1:TIPOLOGIA_COLOCAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$NOW_Patroclo_SendIDULLCOoloIn.parameters/tns2:TIPO_COLOCAZIONE&quot;/>&#xa;                    &lt;/ns1:TIPOLOGIA_COLOCAZIONE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns1:Insert>&#xa;        &lt;/ns1:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
