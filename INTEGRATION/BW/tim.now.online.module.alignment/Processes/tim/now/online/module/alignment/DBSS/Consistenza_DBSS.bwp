                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.StagingNOWConsistenzaDBSS&quot; xmlns:tns=&quot;http://www.example.org/tim.now.xsd.NOWConsistenzaDBSS&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/ProcessIstance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AggiornamentoConsistenzaIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;OKElabStaging&quot;/>&#xa;    &lt;xsl:param name=&quot;InsProcessIstance&quot;/>&#xa;    &lt;xsl:template name=&quot;InsStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:INPUT>&#xa;            &lt;ns:Insert>&#xa;                &lt;ns:ID_RICH>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:TRANSACTION_ID&quot;/>&#xa;                &lt;/ns:ID_RICH>&#xa;                &lt;ns:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:TRANSACTION_DATE&quot;/>&#xa;                &lt;/ns:TIMSTP_RICH>&#xa;                &lt;ns:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($AggiornamentoConsistenzaIn.parameters, true(), true())&quot;/>&#xa;                &lt;/ns:CONTENUTO_REQUEST>&#xa;                &lt;ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$OKElabStaging&quot;/>&#xa;                &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($InsProcessIstance/tns1:ID_ESEC_PROCSO_NO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns:Sistema_Competenza>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:Sistema_Competenza&quot;/>&#xa;                &lt;/ns:Sistema_Competenza>&#xa;                &lt;ns:Data_dec>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Data_dec&quot;/>&#xa;                &lt;/ns:Data_dec>&#xa;                &lt;ns:Ora_dec>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Ora_dec&quot;/>&#xa;                &lt;/ns:Ora_dec>&#xa;                &lt;ns:ID_Risorsa>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:ID_Risorsa&quot;/>&#xa;                &lt;/ns:ID_Risorsa>&#xa;                &lt;ns:Numero_Telefonico>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Numero_Telefonico&quot;/>&#xa;                &lt;/ns:Numero_Telefonico>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:ID_Risorsa_OLD&quot;>&#xa;                    &lt;ns:ID_Risorsa_OLD>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:ID_Risorsa_OLD&quot;/>&#xa;                    &lt;/ns:ID_Risorsa_OLD>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Numero_Telefonico_OLD&quot;>&#xa;                    &lt;ns:Numero_Telefonico_OLD>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Numero_Telefonico_OLD&quot;/>&#xa;                    &lt;/ns:Numero_Telefonico_OLD>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:Stato_Asset>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Stato_Asset&quot;/>&#xa;                &lt;/ns:Stato_Asset>&#xa;                &lt;ns:Flag_FTTH>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Flag_FTTH&quot;/>&#xa;                &lt;/ns:Flag_FTTH>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Destinazione_Uso&quot;>&#xa;                    &lt;ns:Destinazione_Uso>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Destinazione_Uso&quot;/>&#xa;                    &lt;/ns:Destinazione_Uso>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Famiglia_Tecnica&quot;>&#xa;                    &lt;ns:Famiglia_Tecnica>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Famiglia_Tecnica&quot;/>&#xa;                    &lt;/ns:Famiglia_Tecnica>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Numero_nativo_olo&quot;>&#xa;                    &lt;ns:Numero_nativo_olo>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Numero_nativo_olo&quot;/>&#xa;                    &lt;/ns:Numero_nativo_olo>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:Distretto_Telefonico>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:Distretto_Telefonico&quot;/>&#xa;                &lt;/ns:Distretto_Telefonico>&#xa;                &lt;ns:CognomeRagioneSociale>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:CLIENTE/tns:CognomeRagioneSociale&quot;/>&#xa;                &lt;/ns:CognomeRagioneSociale>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:SEDE/tns:Particella_Toponomastica&quot;>&#xa;                    &lt;ns:Particella_Toponomastica>&#xa;              