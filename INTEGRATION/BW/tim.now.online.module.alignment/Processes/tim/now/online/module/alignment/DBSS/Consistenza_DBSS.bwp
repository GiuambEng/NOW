test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:SEDE/tns:Piano&quot;>&#xa;                    &lt;ns:Piano>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:SEDE/tns:Piano&quot;/>&#xa;                    &lt;/ns:Piano>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:SEDE/tns:Interno&quot;>&#xa;                    &lt;ns:Interno>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:SEDE/tns:Interno&quot;/>&#xa;                    &lt;/ns:Interno>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:SEDE/tns:Codice_Comune&quot;>&#xa;                    &lt;ns:Codice_Comune>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:SEDE/tns:Codice_Comune&quot;/>&#xa;                    &lt;/ns:Codice_Comune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:SEDE/tns:Codice_Via&quot;>&#xa;                    &lt;ns:Codice_Via>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:SEDE/tns:Codice_Via&quot;/>&#xa;                    &lt;/ns:Codice_Via>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:SEDE/tns:Codice_Provincia&quot;>&#xa;                    &lt;ns:Codice_Provincia>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:SEDE/tns:Codice_Provincia&quot;/>&#xa;                    &lt;/ns:Codice_Provincia>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:SEDE/tns:Indirizzo_non_certificato&quot;>&#xa;                    &lt;ns:Indirizzo_non_certificato>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:SEDE/tns:Indirizzo_non_certificato&quot;/>&#xa;                    &lt;/ns:Indirizzo_non_certificato>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:CLIENTE/tns:CF_PIVA&quot;>&#xa;                    &lt;ns:COD_FISCALE_PIVA>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:CLIENTE/tns:CF_PIVA&quot;/>&#xa;                    &lt;/ns:COD_FISCALE_PIVA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:CLIENTE/tns:Nome&quot;>&#xa;                    &lt;ns:NOME>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:CLIENTE/tns:Nome&quot;/>&#xa;                    &lt;/ns:NOME>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:ROW_ID_ORDINE_FONIA&quot;>&#xa;                    &lt;ns:ROW_ID_ORDINE_FONIA>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:ROW_ID_ORDINE_FONIA&quot;/>&#xa;                    &lt;/ns:ROW_ID_ORDINE_FONIA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:ROW_ID_ORDINE_DATI&quot;>&#xa;                    &lt;ns:ROW_ID_ORDINE_DATI>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns:ACCESSO/tns:ROW_ID_ORDINE_DATI&quot;/>&#xa;                    &lt;/ns:ROW_ID_ORDINE_DATI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:Insert>&#xa;        &lt;/ns:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
