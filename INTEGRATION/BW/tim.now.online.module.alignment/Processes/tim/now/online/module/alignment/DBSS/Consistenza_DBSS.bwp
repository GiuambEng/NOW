              &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns1:SEDE/tns1:Scala&quot;/>&#xa;                            &lt;/tns2:Scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns1:SEDE/tns1:Piano&quot;>&#xa;                            &lt;tns2:Piano>&#xa;                                &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns1:SEDE/tns1:Piano&quot;/>&#xa;                            &lt;/tns2:Piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns1:SEDE/tns1:Interno&quot;>&#xa;                            &lt;tns2:Interno>&#xa;                                &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns1:SEDE/tns1:Interno&quot;/>&#xa;                            &lt;/tns2:Interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns1:SEDE/tns1:Codice_Comune&quot;>&#xa;                            &lt;tns2:Codice_Comune>&#xa;                                &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns1:SEDE/tns1:Codice_Comune&quot;/>&#xa;                            &lt;/tns2:Codice_Comune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns1:SEDE/tns1:Codice_Via&quot;>&#xa;                            &lt;tns2:Codice_Via>&#xa;                                &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns1:SEDE/tns1:Codice_Via&quot;/>&#xa;                            &lt;/tns2:Codice_Via>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns1:SEDE/tns1:Codice_Provincia&quot;>&#xa;                            &lt;tns2:Codice_Provincia>&#xa;                                &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns1:SEDE/tns1:Codice_Provincia&quot;/>&#xa;                            &lt;/tns2:Codice_Provincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn.parameters/tns1:SEDE/tns1:Indirizzo_non_certificato&quot;>&#xa;                            &lt;tns2:Indirizzo_non_certificato>&#xa;                                &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn.parameters/tns1:SEDE/tns1:Indirizzo_non_certificato&quot;/>&#xa;                            &lt;/tns2:Indirizzo_non_certificato>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns2:SEDE>&#xa;                    &lt;xsl:if test=&quot;$InsProcessIstance/tns3:ID_ESEC_PROCSO_NO_FILE&quot;>&#xa;                        &lt;tns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsProcessIstance/tns3:ID_ESEC_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/tns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:ProcessName>&#xa;                        &lt;xsl:value-of select=&quot;$ProcessName&quot;/>&#xa;                    &lt;/tns2:ProcessName>&#xa;                &lt;/tns2:Input>&#xa;            &lt;/Body>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
