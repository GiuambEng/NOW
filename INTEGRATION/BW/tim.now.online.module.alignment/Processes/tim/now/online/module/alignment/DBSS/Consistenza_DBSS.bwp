                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/LoggerServiceSecurityDataServices/&quot; xmlns:tns1=&quot;http://www.example.org/ServicesSecurityData&quot; xmlns:ns=&quot;www.tim.now.HeaderConnection&quot; xmlns:tns2=&quot;http://www.example.org/tim.now.xsd.NOWConsistenzaDBSS&quot; xmlns:tns3=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tns4=&quot;http://www.example.com/namespaces/ProcessIstance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AggiornamentoConsistenzaIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;GetContext&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;InsProcessIstance&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAccessoUtenti-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:LoggerSecurityInput>&#xa;            &lt;tns1:LogInfo>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:ServiceName>&#xa;                    &lt;xsl:value-of select=&quot;'NOWConsistenzaDBSS'&quot;/>&#xa;                &lt;/tns1:ServiceName>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'AggiornamentoConsistenza'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:JMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:JMS>&#xa;            &lt;/tns1:LogInfo>&#xa;            &lt;tns1:InputDataUserLog>&#xa;                &lt;tns1:APPLICAZIONE_CLIENT>&#xa;                    &lt;xsl:value-of select=&quot;'Processo di allineamento online di consistenza da DBSS'&quot;/>&#xa;                &lt;/tns1:APPLICAZIONE_CLIENT>&#xa;                &lt;tns1:COD_FUNZIONE>&#xa;                    &lt;xsl:value-of select=&quot;'Monitoraggio Accessi M2M'&quot;/>&#xa;                &lt;/tns1:COD_FUNZIONE>&#xa;                &lt;tns1:COD_PROFILO>&#xa;                    &lt;xsl:value-of select=&quot;'M2M'&quot;/>&#xa;                &lt;/tns1:COD_PROFILO>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns:remoteaddress&quot;>&#xa;                    &lt;tns1:HOSTNAME_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns:remoteaddress&quot;/>&#xa;                    &lt;/tns1:HOSTNAME_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns:remoteaddress&quot;>&#xa;                    &lt;tns1:IP_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns:remoteaddress&quot;/>&#xa;                    &lt;/tns1:IP_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns3:IPAddress&quot;>&#xa;                    &lt;tns1:IP_SERVER>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns3:IPAddress&quot;/>&#xa;                    &lt;/tns1:IP_SERVER>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:OS_USER>&#xa;                    &lt;xsl:value-of select=&quot;bw:getSystemProperty(&amp;quot;os.name&amp;quot;)&quot;/>&#xa;                &lt;/tns1:OS_USER>&#xa;                &lt;tns1:SERVER_NAME>&#xa;                    &lt;xsl:value-of select=&quot;bw:getHostName()&quot;/>&#xa;                &lt;/tns1:SERVER_NAME>&#xa;                &lt;tns1:COD_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;'ID169'&quot;/>&#xa;                &lt;/tns1:COD_INTRFC>&#xa;                &lt;tns1:SESSION_ID>&#xa;                    &lt;xsl:value-of select=&quot;concat('DBSS_',$AggiornamentoConsistenzaIn.parameters/tns2:TRANSACTION_ID)&quot;/>&#xa;                &lt;/tns1:SESSION_ID>&#xa;                &lt;tns1:TIPO_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LOGIN&amp;quot;&quot;/>&#xa;                &lt;/tns1:TIPO_OPERAZIONE>&#xa;                &lt;tns1:SISTEMA_CHIAMANTE>&#xa;                    &lt;xsl:value-of select=&quot;'DBSS'&quot;/>&#xa;                &lt;/tns1:SISTEMA_CHIAMANTE>&#xa;                &lt;xsl:if test=&quot;$InsProcessIstance/tns4:ID_ESEC_PROCSO_NO_FILE&quot;>&#xa;                    &lt;tns1:ID_ESE_PROC_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$InsProcessIstance/tns4:ID_ESEC_PROCSO_NO_FILE&quot;/>&#xa;                    &lt;/tns1:ID_ESE_PROC_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:NOME_TAB_STAGING>&#xa;                    &lt;xsl:value-of select=&quot;'STAG_DBSS_NO_FILE'&quot;/>&#xa;                &lt;/tns1:NOME_TAB_STAGING>&#xa;            &lt;/tns1:InputDataUserLog>&#xa;        &lt;/tns1:LoggerSecurityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="InsProcessIstanceToLogAccessoUtenti"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LogAccessoUtentiToEmpty"
                        tibex:faultDetailsVar="LogAccessoUtenti" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="LogAccessoUtentiToLogMsgReceived"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.xsd.NOWConsistenzaDBSS&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;AggiornamentoConsistenzaIn&quot;/>&lt;xsl:template name=&quot;LogMsgReceived-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Consistenza_DBSS'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('**Messaggio Ricevuto da DBSS**',   tib:render-xml($AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request, true(), true()) )&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogMsgReceived-input"
                    name="LogMsgReceived"
                    tibex:xpdlId="76a3f6cf-632d-4cf8-8161-fc0750eaaa8d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
