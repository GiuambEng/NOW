                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1469551322714" xmlns:ns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:tns1="http://www.example.com/namespaces/ProcessIstance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.example.org/tim.now.xsd.NOWConsistenzaDBSS" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:param name="InsProcessIstance"/&gt;&lt;xsl:param name="ProcessName"/&gt;&lt;xsl:param name="AggiornamentoConsistenzaIn"/&gt;&lt;xsl:template name="GestioneErrore-input" match="/"&gt;&lt;tns:Input&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="'ConsistenzaDBSS'"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Error&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="$FaultDetails/ActivityName"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Msg&gt;&lt;xsl:value-of select="$FaultDetails/Msg"/&gt;&lt;/ns:Msg&gt;&lt;ns:MsgCode&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/ns:MsgCode&gt;&lt;ns:ProcessStack&gt;&lt;xsl:value-of select="$FaultDetails/ProcessStack"/&gt;&lt;/ns:ProcessStack&gt;&lt;ns:StackTrace&gt;&lt;xsl:value-of select="$FaultDetails/StackTrace"/&gt;&lt;/ns:StackTrace&gt;&lt;/ns:Error&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ProcessName)&gt;0"&gt;&lt;xsl:if test="$InsProcessIstance/tns1:ID_ESEC_PROCSO_NO_FILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$InsProcessIstance/tns1:ID_ESEC_PROCSO_NO_FILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="''"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="34"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($AggiornamentoConsistenzaIn/parameters/tns2:NOWConsistenzaDBSS_Request/tns2:TRANSACTION_ID)&gt;0"&gt;&lt;ns:DBSSTransactionID&gt;&lt;xsl:value-of select="xsd:integer($Aggiornamento