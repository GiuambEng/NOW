                                    sqlStatement="INSERT INTO ALGNMT_ONLINE_DBSS&#xa;(BODY,TIMSTP_INSMTO,FLAG_ELABORAZIONE,ID_ESEC_PROCSO_NO_FILE,TRANSACTION_ID)&#xa;VALUES&#xa;(?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
