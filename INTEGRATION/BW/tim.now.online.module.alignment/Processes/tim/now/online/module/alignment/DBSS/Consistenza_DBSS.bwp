            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Oscuramento-input" name="Oscuramento"
                    outputVariable="Oscuramento"
                    tibex:xpdlId="fe19993e-19c3-4719-be4e-3e044486f5e6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogSendMessageToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToJMSSendMessage">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBCQueryToMapper">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Oscuramento/Record)=0 or (count($Oscuramento/Record)>0 and $Oscuramento/Record[1]/FLAG_OSCURMENTO='0')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Oscuramento/Record)=0 or (count($Oscuramento/Record)>0 and $Oscuramento/Record[1]/FLAG_OSCURMENTO='0')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fe19993e-19c3-4719-be4e-3e044486f5e6+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLAG_OSCURMENTO,COD_AGESP FROM OSCURAMENTO_AGESP &#xa;WHERE COD_AGESP IN ('CR430')&#xa;&#xa;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="FLAG_OSCURMENTO"
                                    dataType="1" typeName="CHAR"/>
                                    <columnMetadata
                                    columnName="COD_AGESP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CheckJMSBodyDBSS&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.xsd.NOWConsistenzaDBSS&quot; xmlns:tns3=&quot;http://www.example.com/namespaces/ProcessIstance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AggiornamentoConsistenzaIn&quot;/>&#xa;    &lt;xsl:param name=&quot;InsProcessIstance&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessName&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:TRANSACTION_ID&quot;/>&#xa;            &lt;/tns:TRANSACTION_ID>&#xa;            &lt;tns:TRANSACTION_DATE>&#xa;                &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:TRANSACTION_DATE&quot;/>&#xa;            &lt;/tns:TRANSACTION_DATE>&#xa;            &lt;tns:Sistema_Competenza>&#xa;                &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:Sistema_Competenza&quot;/>&#xa;            &lt;/tns:Sistema_Competenza>&#xa;            &lt;tns:ACCESSO>&#xa;                &lt;tns:Data_dec>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:ACCESSO/tns1:Data_dec&quot;/>&#xa;                &lt;/tns:Data_dec>&#xa;                &lt;tns:Ora_dec>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:ACCESSO/tns1:Ora_dec&quot;/>&#xa;                &lt;/tns:Ora_dec>&#xa;                &lt;tns:ID_Risorsa>&#xa;                    &lt;xsl:value-of select=&quot