             &lt;tns:Destinazione_Uso>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:ACCESSO/tns1:Destinazione_Uso&quot;/>&#xa;                    &lt;/tns:Destinazione_Uso>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:ACCESSO/tns1:Famiglia_Tecnica&quot;>&#xa;                    &lt;tns:Famiglia_Tecnica>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:ACCESSO/tns1:Famiglia_Tecnica&quot;/>&#xa;                    &lt;/tns:Famiglia_Tecnica>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:ACCESSO/tns1:Numero_nativo_olo&quot;>&#xa;                    &lt;tns:Numero_nativo_olo>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:ACCESSO/tns1:Numero_nativo_olo&quot;/>&#xa;                    &lt;/tns:Numero_nativo_olo>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Distretto_Telefonico>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:ACCESSO/tns1:Distretto_Telefonico&quot;/>&#xa;                &lt;/tns:Distretto_Telefonico>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:ACCESSO/tns1:Destinazione_Uso_Dati&quot;>&#xa;                    &lt;tns:Destinazione_Uso_Dati>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:ACCESSO/tns1:Destinazione_Uso_Dati&quot;/>&#xa;                    &lt;/tns:Destinazione_Uso_Dati>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:ACCESSO/tns1:ID_Risorsa_Correlata&quot;>&#xa;                    &lt;tns:ID_Risorsa_Correlata>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:ACCESSO/tns1:ID_Risorsa_Correlata&quot;/>&#xa;                    &lt;/tns:ID_Risorsa_Correlata>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:ACCESSO>&#xa;            &lt;tns:CLIENTE>&#xa;                &lt;tns:CognomeRagioneSociale>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:CLIENTE/tns1:CognomeRagioneSociale&quot;/>&#xa;                &lt;/tns:CognomeRagioneSociale>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:CLIENTE/tns1:Nome&quot;>&#xa;                    &lt;tns:Nome>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:CLIENTE/tns1:Nome&quot;/>&#xa;                    &lt;/tns:Nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:CLIENTE/tns1:CF_PIVA&quot;>&#xa;                    &lt;tns:CF_PIVA>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:CLIENTE/tns1:CF_PIVA&quot;/>&#xa;                    &lt;/tns:CF_PIVA>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:CLIENTE>&#xa;            &lt;tns:SEDE>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoConsistenzaIn/parameters/tns1:NOWConsistenzaDBSS_Request/tns1:SEDE/tns1:Particella_Toponomastica&quot;>&#xa;                    &lt;tns:Particella_Toponomastica>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoConsistenzaIn