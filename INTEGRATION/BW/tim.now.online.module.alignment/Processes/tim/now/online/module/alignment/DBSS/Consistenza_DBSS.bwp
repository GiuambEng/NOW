                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6cf0a22a-b89f-4e70-87f4-276ed9a640dd+input&quot; xmlns:tns1=&quot;http://www.example.org/CheckJMSBodyDBSS&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:param name=&quot;QueryPARAMConfig&quot;/>&lt;xsl:template name=&quot;ALGNMT_ONLINE_DBSS-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;BODY>&lt;xsl:value-of select=&quot;tib:render-xml($Mapper, true(), true())&quot;/>&lt;/BODY>&lt;TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_INSMTO>&lt;xsl:choose>&lt;xsl:when test=&quot;$QueryPARAMConfig/Record[1]/VALORE_STRINGA='Y'&quot;>&lt;FLAG_ELABORAZIONE>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/FLAG_ELABORAZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_ELABORAZIONE>&lt;xsl:value-of select=&quot;'DISABILITATO'&quot;/>&lt;/FLAG_ELABORAZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Mapper/tns1:ID_ESEC_PROCSO_NO_FILE)>0&quot;>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Mapper/tns1:ID_ESEC_PROCSO_NO_FILE)&quot;/>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ESEC_PROCSO_NO_FILE xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;TRANSACTION_ID>&lt;xsl:value-of select=&quot;$Mapper/tns1:TRANSACTION_ID&quot;/>&lt;/TRANSACTION_ID>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
