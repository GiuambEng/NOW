            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.schema.xsd.stagingRetailCRMR&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.NOWAllineamentiRetail&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InviatoEsitoOK&quot;/>&lt;xsl:param name=&quot;Invoke&quot;/>&lt;xsl:param name=&quot;ProcessIstance&quot;/>&lt;xsl:template name=&quot;UpStaging-input&quot; match=&quot;/&quot;>&lt;tns:INPUT>&lt;tns:Update>&lt;tns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($Invoke/parameters/tns1:NOWAllineamentoRetailResponse)&quot;/>&lt;/tns:CONTENUTO_RESPONSE>&lt;tns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_RISPOSTA>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$InviatoEsitoOK&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;tns:ID_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/tns:ID_PROCSO_NO_FILE>&lt;/tns:Update>&lt;/tns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
