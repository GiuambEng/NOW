            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.schema.xsd.stagingRetailCRMR&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.NOWAllineamentiRetail&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AllineamentoRetailIn&quot;/>&lt;xsl:param name=&quot;ProcessIstance&quot;/>&lt;xsl:param name=&quot;RicevutaRichiesta&quot;/>&lt;xsl:template name=&quot;InsStaging-input&quot; match=&quot;/&quot;>&lt;tns:INPUT>&lt;tns:Insert>&lt;tns:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($AllineamentoRetailIn/parameters/tns1:NOWAllineamentoRetailRequest/tns1:REQUEST)&quot;/>&lt;/tns:CONTENUTO_REQUEST>&lt;tns:ID_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/tns:ID_PROCSO_NO_FILE>&lt;tns:ID_RICH>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/tns:ID_RICH>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$RicevutaRichiesta&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;tns:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_RICH>&lt;tns:CRM_ORIGINE>&lt;xsl:value-of select=&quot;$AllineamentoRetailIn/parameters/tns1:NOWAllineamentoRetailRequest/tns1:REQUEST/tns1:CRM_ORIGINE&quot;/>&lt;/tns:CRM_ORIGINE>&lt;tns:TELEFONICO>&lt;xsl:value-of select=&quot;$AllineamentoRetailIn/parameters/tns1:NOWAllineamentoRetailRequest/tns1:REQUEST/tns1:Telefonico&quot;/>&lt;/tns:TELEFONICO>&lt;xsl:if test=&quot;$AllineamentoRetailIn/parameters/tns1:NOWAllineamentoRetailRequest/tns1:REQUEST/tns1:ID_Risorsa&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$AllineamentoRetailIn/parameters/tns1:NOWAllineamentoRetailRequest/tns1:REQUEST/tns1:ID_Risorsa&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;/tns:Insert>&lt;/tns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
