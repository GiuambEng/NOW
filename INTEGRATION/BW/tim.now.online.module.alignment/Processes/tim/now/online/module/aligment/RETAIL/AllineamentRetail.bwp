                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.schema.xsd.stagingRetailCRMR&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.NOWAllineamentiRetail&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessIstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoRetailIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RicevutaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;InsStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:INPUT>&#xa;            &lt;tns:Insert>&#xa;                &lt;tns:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($AllineamentoRetailIn.parameters/tns1:REQUEST)&quot;/>&#xa;                &lt;/tns:CONTENUTO_REQUEST>&#xa;                &lt;tns:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/tns:ID_PROCSO_NO_FILE>&#xa;                &lt;tns:ID_RICH>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/tns:ID_RICH>&#xa;                &lt;tns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$RicevutaRichiesta&quot;/>&#xa;                &lt;/tns:ID_STATO_ELAB_STAG>&#xa;                &lt;tns:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_RICH>&#xa;                &lt;tns:CRM_ORIGINE>&#xa;                    &lt;xsl:value-of select=&quot;$AllineamentoRetailIn.parameters/tns1:REQUEST/tns1:CRM_ORIGINE&quot;/>&#xa;                &lt;/tns:CRM_ORIGINE>&#xa;                &lt;tns:TELEFONICO>&#xa;                    &lt;xsl:value-of select=&quot;$AllineamentoRetailIn.parameters/tns1:REQUEST/tns1:Telefonico&quot;/>&#xa;                &lt;/tns:TELEFONICO>&#xa;                &lt;xsl:if test=&quot;$AllineamentoRetailIn.parameters/tns1:REQUEST/tns1:ID_Risorsa&quot;>&#xa;                    &lt;tns:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$AllineamentoRetailIn.parameters/tns1:REQUEST/tns1:ID_Risorsa&quot;/>&#xa;                    &lt;/tns:ID_RISORSA>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:Insert>&#xa;        &lt;/tns:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
