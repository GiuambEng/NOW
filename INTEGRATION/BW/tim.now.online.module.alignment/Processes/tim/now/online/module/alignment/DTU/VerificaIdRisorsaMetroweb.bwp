                    <bpws:targets>
                        <bpws:target linkName="RichiestaToLogRichiesta"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogRichiestaToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:template name=&quot;LogRichiesta-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'VerificaIdRisorsaMetroweb'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Output query su Richiesta: ', tib:render-xml($Richiesta))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Tracciati_Verifica_Risorsa_DTU_NOW/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaRisorsaDTUNOWIn&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;Asset&quot;/>&lt;xsl:template name=&quot;MapperResponce-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Asset/Record)>0 and $Asset/Record[1]/STATOASSET='CESSATO'&quot;>&lt;tns:Response>&lt;tns:ID_SO>&lt;xsl:value-of select=&quot;$VerificaRisorsaDTUNOWIn/Input/tns:Request/tns:ID_SO&quot;/>&lt;/tns:ID_SO>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:ESITO>&lt;tns:CODICE>&lt;xsl:value-of select=&quot;'000'&quot;/>&lt;/tns:CODICE>&lt;tns:TIMESTAMP_RISPOSTA_NOW>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMESTAMP_RISPOSTA_NOW>&lt;/tns:Response>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Asset/Record)>0 and $Asset/Record[1]/STATOASSET!='CESSATO'&quot;>&lt;tns:Response>&lt;tns:ID_SO>&lt;xsl:value-of select=&quot;$VerificaRisorsaDTUNOWIn/Input/tns:Request/tns:ID_SO&quot;/>&lt;/tns:ID_SO>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:ESITO>&lt;tns:CODICE>&lt;xsl:value-of select=&quot;'001'&quot;/>&lt;/tns:CODICE>&lt;tns:DESCRIZIONE>&lt;xsl:value-of select=&quot;'RISORSA DUPLICATA'&quot;/>&lt;/tns:DESCRIZIONE>&lt;tns:TIMESTAMP_RISPOSTA_NOW>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMESTAMP_RISPOSTA_NOW>&lt;/tns:Response>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Richiesta/Record)>0 and $Richiesta/Record[1]/LAVORAZIONE='ATTIVAZIONE'&quot;>&lt;tns:Response>&lt;tns:ID_SO>&lt;xsl:value-of select=&quot;$VerificaRisorsaDTUNOWIn/Input/tns:Request/tns:ID_SO&quot;/>&lt;/tns:ID_SO>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:ESITO>&lt;tns:CODICE>&lt;xsl:value-of select=&quot;'001'&quot;/>&lt;/tns:CODICE>&lt;tns:DESCRIZIONE>&lt;xsl:value-of select=&quot;'RISORSA DUPLICATA'&quot;/>&lt;/tns:DESCRIZIONE>&lt;tns:TIMESTAMP_RISPOSTA_NOW>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMESTAMP_RISPOSTA_NOW>&lt;/tns:Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Response>&lt;tns:ID_SO>&lt;xsl:value-of select=&quot;$VerificaRisorsaDTUNOWIn/Input/tns:Request/tns:ID_SO&quot;/>&lt;/tns:ID_SO>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:ESITO>&lt;tns:CODICE>&lt;xsl:value-of select=&quot;'000'&quot;/>&lt;/tns:CODICE>&lt;tns:TIMESTAMP_RISPOSTA_NOW>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMESTAMP_RISPOSTA_NOW>&lt;/tns:Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperResponce-input"
                    name="MapperResponce"
                    outputVariable="MapperResponce"
                    tibex:xpdlId="e7577f6c-42de-45a0-99f2-43843929aa23" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogAssetToMapper"/>
                        <bpws:target linkName="LogRichiestaToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperResponceToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Tracciati_Verifica_Risorsa_DTU_NOW/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaRisorsaDTUNOWIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Asset&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperResponce-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($Asset/Record)>0 and $Asset/Record[1]/STATOASSET='CESSATO'&quot;>&#xa;                &lt;tns:Response>&#xa;                    &lt;tns:ID_SO>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRisorsaDTUNOWIn.Input/tns:ID_SO&quot;/>&#xa;                    &lt;/tns:ID_SO>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                    &lt;tns:CODICE>&#xa;                        &lt;xsl:value-of select=&quot;'000'&quot;/>&#xa;                    &lt;/tns:CODICE>&#xa;                    &lt;tns:TIMESTAMP_RISPOSTA_NOW>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:TIMESTAMP_RISPOSTA_NOW>&#xa;                &lt;/tns:Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($Asset/Record)>0 and $Asset/Record[1]/STATOASSET!='CESSATO'&quot;>&#xa;                &lt;tns:Response>&#xa;                    &lt;tns:ID_SO>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRisorsaDTUNOWIn.Input/tns:ID_SO&quot;/>&#xa;                    &lt;/tns:ID_SO>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                    &lt;tns:CODICE>&#xa;                        &lt;xsl:value-of select=&quot;'001'&quot;/>&#xa;                    &lt;/tns:CODICE>&#xa;                    &lt;tns:DESCRIZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'RISORSA DUPLICATA'&quot;/>&#xa;                    &lt;/tns:DESCRIZIONE>&#xa;                    &lt;tns:TIMESTAMP_RISPOSTA_NOW>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:TIMESTAMP_RISPOSTA_NOW>&#xa;                &lt;/tns:Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($Richiesta/Record)>0 and $Richiesta/Record[1]/LAVORAZIONE='ATTIVAZIONE'&quot;>&#xa;                &lt;tns:Response>&#xa;                    &lt;tns:ID_SO>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRisorsaDTUNOWIn.Input/tns:ID_SO&quot;/>&#xa;                    &lt;/tns:ID_SO>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                    &lt;tns:CODICE>&#xa;                        &lt;xsl:value-of select=&quot;'001'&quot;/>&#xa;                    &lt;/tns:CODICE>&#xa;                    &lt;tns:DESCRIZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'RISORSA DUPLICATA'&quot;/>&#xa;                    &lt;/tns:DESCRIZIONE>&#xa;                    &lt;tns:TIMESTAMP_RISPOSTA_NOW>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:TIMESTAMP_RISPOSTA_NOW>&#xa;                &lt;/tns:Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:Response>&#xa;                    &lt;tns:ID_SO>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRisorsaDTUNOWIn.Input/tns:ID_SO&quot;/>&#xa;                    &lt;/tns:ID_SO>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                    &lt;tns:CODICE>&#xa;                        &lt;xsl:value-of select=&quot;'000'&quot;/>&#xa;                    &lt;/tns:CODICE>&#xa;                    &lt;tns:TIMESTAMP_RISPOSTA_NOW>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:TIMESTAMP_RISPOSTA_NOW>&#xa;                &lt;/tns:Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:Tracciati_Verifica_Risorsa_DTU_NOW="http://www.tim.com/NOW/xsd/Tracciati_Verifica_Risorsa_DTU_NOW/"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
