        <bpws:partnerLink name="Logger"
            partnerLinkType="ns0:partnerLinkType2" partnerRole="use"
            sca-bpel:ignore="true" sca-bpel:reference="Logger" sca-bpel:wiredByImpl="false">
            <tibex:ReferenceWire dynamic="false" inline="false"
                processConfigurationName=""
                processName="ProcessLogger.Logger" serviceName="ProcessLog"/>
        </bpws:partnerLink>
        <bpws:partnerLink name="GestioneErrore"
            partnerLinkType="ns0:partnerLinkType3" partnerRole="use"
            sca-bpel:ignore="true" sca-bpel:reference="GestioneErrore" sca-bpel:wiredByImpl="false">
