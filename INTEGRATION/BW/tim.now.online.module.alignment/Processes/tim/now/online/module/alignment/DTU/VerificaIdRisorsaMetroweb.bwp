                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT IDRISORSA, LAVORAZIONE FROM BDS_1_CASEDATA_RICHIESTA WHERE IDRISORSA=? AND STATORICHIESTANOW='ESPLETAMENTOTECNICO' ORDER BY LASTUPDATE DESC&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
