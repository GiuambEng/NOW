                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingVerificaIdRisorsaMetroweb&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Tracciati_Verifica_Risorsa_DTU_NOW/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ProcessIstance&quot;/>&lt;xsl:param name=&quot;MapperResponce&quot;/>&lt;xsl:template name=&quot;Up_Staging-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:Update>&lt;ns:ContenutoResponse>&lt;xsl:value-of select=&quot;tib:render-xml($MapperResponce)&quot;/>&lt;/ns:ContenutoResponse>&lt;xsl:if test=&quot;$MapperResponce/tns:DESCRIZIONE&quot;>&lt;ns:DescrizioneErrore>&lt;xsl:value-of select=&quot;$MapperResponce/tns:DESCRIZIONE&quot;/>&lt;/ns:DescrizioneErrore>&lt;/xsl:if>&lt;ns:IdEsecProcsoNoFile>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/ns:IdEsecProcsoNoFile>&lt;ns:TimestampRisposta>&lt;xsl:value-of select=&quot;$MapperResponce/tns:TIMESTAMP_RISPOSTA_NOW&quot;/>&lt;/ns:TimestampRisposta>&lt;ns:Esito>&lt;xsl:value-of select=&quot;$MapperResponce/tns:ESITO&quot;/>&lt;/ns:Esito>&lt;ns:Codice>&lt;xsl:value-of select=&quot;$MapperResponce/tns:CODICE&quot;/>&lt;/ns:Codice>&lt;ns:ReturnCode>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns:ReturnCode>&lt;/ns:Update>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Up_Staging-input" name="Up_Staging"
                    tibex:xpdlId="d83c0e22-7639-406f-b690-03cc58e9823f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperResponceToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Up_StagingToInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingVerificaIdRisorsaMetroweb&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Tracciati_Verifica_Risorsa_DTU_NOW/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessIstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperResponce&quot;/>&#xa;    &lt;xsl:template name=&quot;Up_Staging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:Update>&#xa;                &lt;ns:ContenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperResponce)&quot;/>&#xa;                &lt;/ns:ContenutoResponse>&#xa;                &lt;xsl:if test=&quot;$MapperResponce/tns:DESCRIZIONE&quot;>&#xa;                    &lt;ns:DescrizioneErrore>&#xa;                        &lt;xsl:value-of select=&quot;$MapperResponce/tns:DESCRIZIONE&quot;/>&#xa;                    &lt;/ns:DescrizioneErrore>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:IdEsecProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns:IdEsecProcsoNoFile>&#xa;                &lt;ns:TimestampRisposta>&#xa;                    &lt;xsl:value-of select=&quot;$MapperResponce/tns:TIMESTAMP_RISPOSTA_NOW&quot;/>&#xa;                &lt;/ns:TimestampRisposta>&#xa;                &lt;ns:Esito>&#xa;                    &lt;xsl:value-of select=&quot;$MapperResponce/tns:ESITO&quot;/>&#xa;                &lt;/ns:Esito>&#xa;                &lt;ns:Codice>&#xa;                    &lt;xsl:value-of select=&quot;$MapperResponce/tns:CODICE&quot;/>&#xa;                &lt;/ns:Codice>&#xa;                &lt;ns:ReturnCode>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/ns:ReturnCode>&#xa;            &lt;/ns:Update>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.online.module.alignment.DTU.sub_Staging" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="UpProcessID-input"
                name="UpProcessID" operation="Insert"
                outputVariable="UpProcessID" partnerLink="Logger"
                portType="ns5:ProcessLog" tibex:xpdlId="eca163d6-dc9d-4020-97e1-90f9b262c734">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="ProcessIstance"/&gt;&lt;xsl:template name="UpProcessID-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(substring-before($ProcessIstance/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE, &amp;quot;.&amp;quot;))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessIstance.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;UpProcessID-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE, &amp;quot;.&amp;quot;))&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_FINE_ELAB>&#xa;            &lt;/ns:EsecuzioneNOFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Up_StagingToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpProcessIDToCallProcess"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="EndLog-input"
                    name="EndLog"
                    tibex:xpdlId="8f9b17a7-15c5-4bc5-978f-092ba55e28e7"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpProcessIDToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToVerificaRisorsaDTUNOWOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Tracciati_Verifica_Risorsa_DTU_NOW/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;MapperResponce&quot;/>&lt;xsl:template name=&quot;EndLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'VerificaIdRisorsaMetroweb'&quot;/>&lt;/tns:Process>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;concat('Output VerificaIdRisorsaMetroweb: ',tib:render-xml($MapperResponce))&quot;/>&lt;/tns:MsgCode>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
