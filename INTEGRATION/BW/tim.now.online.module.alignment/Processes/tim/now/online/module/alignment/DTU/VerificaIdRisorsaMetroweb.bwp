                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+280252ec-d413-43fc-a661-a9ee94e03268+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Tracciati_Verifica_Risorsa_DTU_NOW/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaRisorsaDTUNOWIn&quot;/>&lt;xsl:template name=&quot;Asset-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRISORSA>&lt;xsl:value-of select=&quot;$VerificaRisorsaDTUNOWIn/Input/tns1:Request/tns1:ID_ODR&quot;/>&lt;/IDRISORSA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
