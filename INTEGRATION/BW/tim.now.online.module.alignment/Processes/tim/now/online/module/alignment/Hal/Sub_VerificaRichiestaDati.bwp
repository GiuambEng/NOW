                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (contains($Map_StatoAttivo/ns23:FindAsset[number($index)]/ns23:distretto, &quot;00&quot;)) then substring($Map_StatoAttivo/ns23:FindAsset[number($index)]/ns23:distretto, 2, 3) else if (not(contains($Map_StatoAttivo/ns23:FindAsset[number($index)]/ns23:distretto, &quot;0&quot;))) then concat(&quot;0&quot;, $Map_StatoAttivo/ns23:FindAsset[number($index)]/ns23:distretto) else $Map_StatoAttivo/ns23:FindAsset[number($index)]/ns23:distretto" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
