                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_HAL/&quot; xmlns:tns2=&quot;http://www.example.org/ResponseComplexTypeRichiestaDatiTecnici&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Map_StatoAttivo&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NOW_HAL_Response>&#xa;            &lt;tns:Esito>&#xa;                &lt;tns:Esito>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/tns:Esito>&#xa;                &lt;tns:TIMESTAMP>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns:TIMESTAMP>&#xa;            &lt;/tns:Esito>&#xa;            &lt;tns:Servizio>&#xa;                &lt;tns:CODICE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns:CODICE_OLO>&#xa;                &lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:cap&quot;>&#xa;                    &lt;tns:CAP>&#xa;                        &lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:cap&quot;/>&#xa;                    &lt;/tns:CAP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:numeroCivico&quot;>&#xa;                    &lt;tns:CIVICO>&#xa;                        &lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:numeroCivico&quot;/>&#xa;                    &lt;/tns:CIVICO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:comune&quot;>&#xa;                    &lt;tns:COMUNE>&#xa;                        &lt;xsl:value-of select=&