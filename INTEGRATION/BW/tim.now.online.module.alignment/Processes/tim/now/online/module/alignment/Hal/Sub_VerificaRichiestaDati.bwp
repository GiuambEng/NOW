                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="TranscodOfferta-input"
                                    name="TranscodOfferta"
                                    outputVariable="TranscodOfferta"
                                    tibex:xpdlId="7765b502-05e6-4fac-a1c4-08c986ba8509" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
