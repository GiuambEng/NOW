                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="IndirizzoCertificato-input"
                                    name="IndirizzoCertificato"
                                    outputVariable="IndirizzoCertificato"
                                    tibex:xpdlId="ca6fae9b-f57e-485f-a811-9e896baf0dc4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
