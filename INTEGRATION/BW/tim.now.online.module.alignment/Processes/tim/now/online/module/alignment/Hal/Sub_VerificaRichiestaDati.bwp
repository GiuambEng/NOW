                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT MCR_DOWN, MCR_UP, PCR_DOWN, PCR_UP  FROM PROFILO_VC WHERE ID_PRFL_VC=?" xsi:type="jdbcPalette:JDBCQueryActivity">

