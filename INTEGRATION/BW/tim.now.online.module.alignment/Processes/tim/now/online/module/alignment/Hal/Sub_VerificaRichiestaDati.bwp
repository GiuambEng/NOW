            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="IntermediateLog-input"
                    name="IntermediateLog"
                    tibex:xpdlId="e856ce54-b6ba-4810-b61d-7ab3f21b2002"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="call_subFindCaseAssetToIntermediateLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEsitoNoData">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="IntermediateLogToMapper1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($call_subFindCaseAsset/ns23:FindAsset[ns23:statoAsset = ('ATTIVO','INLAVORAZIONE')]) > 0 and count($call_subFindCaseAsset/ns23:FindAsset[ns23:tipologiaAccesso = 'FONIA' and ns23:statoAsset = 'ATTIVO' and not(contains(ns23:offerta, 'NP'))]) !=2 and count($call_subFindCaseAsset/ns23:FindAsset[ns23:tipologiaAccesso = 'DATI' and ns23:statoAsset= 'ATTIVO' ]) != 2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($call_subFindCaseAsset/ns23:FindAsset[ns23:statoAsset = ('ATTIVO','INLAVORAZIONE')]) > 0 and count($call_subFindCaseAsset/ns23:FindAsset[ns23:tipologiaAccesso = 'FONIA' and ns23:statoAsset = 'ATTIVO' and not(contains(ns23:offerta, 'NP'))]) !=2 and count($call_subFindCaseAsset/ns23:FindAsset[ns23:tipologiaAccesso = 'DATI' and ns23:statoAsset= 'ATTIVO' ]) != 2]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="IntermediateLogToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($call_subFindCaseAsset/ns23:FindAsset[ns23:tipologiaAccesso = 'FONIA' and ns23:statoAsset = ('ATTIVO','INLAVORAZIONE') and not(contains(ns23:offerta, 'NP'))]) = 2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($call_subFindCaseAsset/ns23:FindAsset[ns23:tipologiaAccesso = 'FONIA' and ns23:statoAsset = ('ATTIVO','INLAVORAZIONE') and not(contains(ns23:offerta, 'NP'))]) = 2]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="IntermediateLogToAssign1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($call_subFindCaseAsset/ns23:FindAsset[ns23:tipologiaAccesso = 'DATI' and ns23:statoAsset = ('ATTIVO','INLAVORAZIONE')]) = 2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($call_subFindCaseAsset/ns23:FindAsset[ns23:tipologiaAccesso = 'DATI' and ns23:statoAsset = ('ATTIVO','INLAVORAZIONE')]) = 2]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;call_subFindCaseAsset&quot;/>&lt;xsl:template name=&quot;IntermediateLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Sub_VerificaRichiestaDati'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('FindID: ',tib:render-xml($call_subFindCaseAsset,true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
