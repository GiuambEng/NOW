                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_HAL/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/ResponseComplexTypeRichiestaDatiTecnici&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TranscodOfferta&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:param name=&quot;SelectCFPiva&quot;/>&lt;xsl:param name=&quot;RO&quot;/>&lt;xsl:param name=&quot;DISTRETTO&quot;/>&lt;xsl:param name=&quot;CODEDR&quot;/>&lt;xsl:param name=&quot;DR&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;index1&quot;/>&lt;xsl:param name=&quot;Map_StatoAttivo&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns:NOW_HAL_Response>&lt;tns:Esito>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Esito>&lt;tns:TIMESTAMP>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(),&amp;quot;[D01]-[M01]-[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/tns:TIMESTAMP>&lt;/tns:Esito>&lt;tns:Servizio>&lt;xsl:if test=&quot;$TranscodOfferta/Record[1]/OFFERTA = ('EASYIP', 'BITSTREAMATMASIM', 'BIT_SIMM') and $Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:nomeComponente = 'ATMVC'&quot;>&lt;tns:VC>&lt;tns:ID_RISORSA_VC>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'IDRISORSAVC']/tns2:valoreAttributo&quot;/>&lt;/tns:ID_RISORSA_VC>&lt;tns:CODICE_TD_OLO>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'CODICETD']/tns2:valoreAttributo&quot;/>&lt;/tns:CODICE_TD_OLO>&lt;/tns:VC>&lt;/xsl:if>&lt;xsl:if test=&quot;$TranscodOfferta/Record[1]/OFFERTA = ('BSFTTCVULA', 'BSFTTHVULA', 'BSFTTCNGA', 'BSFTTHNGA', 'BITSTREAMGBEASIM') and $Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:nomeComponente = ('GBEVC', 'USERVLAN')&quot;>&lt;tns:UserVlan>&lt;xsl:choose>&lt;xsl:when test=&quot;$TranscodOfferta/Record[1]/OFFERTA = ('BITSTREAMGBEASIM')&quot;>&lt;tns:ID_RISORSA_USERVLAN>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'IDRISORSAVC']/tns2:valoreAttributo&quot;/>&lt;/tns:ID_RISORSA_USERVLAN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ID_RISORSA_USERVLAN>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'IDRISORSAUSERVLAN']/tns2:valoreAttributo&quot;/>&lt;/tns:ID_RISORSA_USERVLAN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$TranscodOfferta/Record[1]/OFFERTA = ('BITSTREAMGBEASIM')&quot;>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;>&lt;tns:SVLAN>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;/>&lt;/tns:SVLAN>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;>&lt;tns:SVLAN>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;/>&lt;/tns:SVLAN>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:nomeComponente = 'GBEVC' and string-length($Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo) > 0 &quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$TranscodOfferta/Record[1]/OFFERTA= ('BITSTREAMGBEASIM')&quot;>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;>&lt;tns:CODE_VLAN_SINGLE_TAG>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;/>&lt;/tns:CODE_VLAN_SINGLE_TAG>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;>&lt;tns:CODE_VLAN_SINGLE_TAG>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;/>&lt;/tns:CODE_VLAN_SINGLE_TAG>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'CVLANID']/tns2:valoreAttributo) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$TranscodOfferta/Record[1]/OFFERTA= ('BITSTREAMGBEASIM')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'CVLANID']/tns2:valoreAttributo)>0&quot;>&lt;tns:CVLAN>&lt;xsl:value-of select=&quot;xsd:int($Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'CVLANID']/tns2:valoreAttributo)&quot;/>&lt;/tns:CVLAN>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'CVLANID']/tns2:valoreAttributo)>0&quot;>&lt;tns:CVLAN>&lt;xsl:value-of select=&quot;xsd:int($Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'CVLANID']/tns2:valoreAttributo)&quot;/>&lt;/tns:CVLAN>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$TranscodOfferta/Record/OFFERTA= ('BSFTTCVULA', 'BSFTTHVULA', 'BSFTTCNGA', 'BSFTTHNGA')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'USERVLANID']/tns2:valoreAttributo)>0&quot;>&lt;tns:USERVLAN>&lt;xsl:value-of select=&quot;xsd:int($Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'USERVLANID']/tns2:valoreAttributo)&quot;/>&lt;/tns:USERVLAN>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$TranscodOfferta/Record/OFFERTA= ('BSFTTCVULA', 'BSFTTHVULA', 'BSFTTCNGA', 'BSFTTHNGA')&quot;>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'BANDAPICCODOWN']/tns2:valoreAttributo&quot;>&lt;tns:BANDA_PICCO_DOWN>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'BANDAPICCODOWN']/tns2:valoreAttributo&quot;/>&lt;/tns:BANDA_PICCO_DOWN>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$TranscodOfferta/Record/OFFERTA= ('BSFTTCVULA','BSFTTHVULA', 'BSFTTCNGA', 'BSFTTHNGA')&quot;>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'BANDAPICCOUP']/tns2:valoreAttributo&quot;>&lt;tns:BANDA_PICCO_UP>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'BANDAPICCOUP']/tns2:valoreAttributo&quot;/>&lt;/tns:BANDA_PICCO_UP>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns:UserVlan>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$TranscodOfferta/Record/OFFERTA = 'BIT_SIMM'  and $Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:nomeComponente = 'ATMVC'&quot;>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'CODICETD']/tns2:valoreAttributo&quot;>&lt;tns:Linea_Riferimento>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'CODICETD']/tns2:valoreAttributo&quot;/>&lt;/tns:Linea_Riferimento>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:numeroTelefonico&quot;>&lt;tns:Linea_Riferimento>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:numeroTelefonico&quot;/>&lt;/tns:Linea_Riferimento>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;$DISTRETTO&quot;/>&lt;/tns:Distretto>&lt;xsl:choose>&lt;xsl:when test=&quot;$TranscodOfferta/Record/OFFERTA = 'BIT_SIMM' and $Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:nomeComponente = 'ATMVC'&quot;>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'CODICETD']/tns2:valoreAttributo&quot;>&lt;tns:Numerazione_Fittizia>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'CODICETD']/tns2:valoreAttributo&quot;/>&lt;/tns:Numerazione_Fittizia>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:numeroFittizio&quot;>&lt;tns:Numerazione_Fittizia>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:numeroFittizio&quot;/>&lt;/tns:Numerazione_Fittizia>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;($Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:offerta = ('BITSTREAMGBEASIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOHL', 'BITSTREAMATMASIMMETRICOLITE', 'BITSTREAMNGAFTTCAB', 'BITSTREAMNGAFTTH', 'BITSTREAMATMASIMMETRICO', 'BITSTREAMATMSIMMETRICOFLAT', 'BITSTREAMATMSIMMETRICOHL', 'BITSTREAMGBESIMMETRICOFLAT', 'BITSTREAMATMSIMMETRICO', 'BITSTREAMGBESIMMETRICO', 'VULAFTTCAB', 'VULAFTTH', 'SHACONMANODOPERA', 'SHASENZAMANODOPERA', 'EASYIPBASEPLUSFLAT', 'EASYIPBASEPLUSLITE', 'EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','EASYIPBASEPLUS','EASYIPSPECIALPROFILE','EASYIPNGAFTTCAB','EASYIPNGAFTTH','SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH','SEMIEASYIPNGAFTTH')) and $Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[starts-with(tns2:nomeComponente,'ACCESSO')]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'TIPOLINEA']/tns2:valoreAttributo=('ISDN','POTS','LineaNonFonia')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[starts-with(tns2:nomeComponente,'ACCESSO')]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'TIPOLINEA']/tns2:valoreAttributo=('ISDN','POTS')&quot;>&lt;tns:Linea_condivisa>&lt;xsl:value-of select=&quot;'S'&quot;/>&lt;/tns:Linea_condivisa>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Linea_condivisa>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:Linea_condivisa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:offerta = ('ULLLINEAATTIVA', 'ULLLINEAATTIVANP', 'ULLLINEANONATTIVA', 'NP', 'CPS', 'VULL', 'ULLDATILINEAATTIVA', 'ULLDATILINEAATTIVANP', 'ULLDATILINEANONATTIVA', 'WLRLINEANONATTIVA', 'SLULINEAATTIVA', 'SLULINEAATTIVANP', 'SLULINEANONATTIVA', 'WLRLINEAATTIVA')&quot;>&lt;tns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;'F'&quot;/>&lt;/tns:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:offerta = ('EASYIPBASEPLUSFLAT', 'EASYIPBASEPLUSLITE', 'EASYIPSPECIALPROFILEFLAT', 'EASYIPSPECIALPROFILELITE', 'BITSTREAMATMASIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOHL', 'BITSTREAMATMASIMMETRICOLITE', 'BITSTREAMATMSIMMETRICOFLAT', 'BITSTREAMATMSIMMETRICOHL', 'BITSTREAMGBEASIMMETRICOFLAT', 'BITSTREAMGBESIMMETRICOFLAT', 'BITSTREAMNGAFTTCAB', 'BITSTREAMNGAFTTH', 'VULAFTTCAB', 'VULAFTTH', 'SHACONMANODOPERA', 'SHASENZAMANODOPERA', 'EASYIPNGAFTTH', 'EASYIPNGAFTTCAB','SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH','SEMIEASYIPNGAFTTH') &quot;>&lt;tns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;'D'&quot;/>&lt;/tns:TIPO_SERVIZIO>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Map_StatoAttivo/tns2:FindAsset/tns2:DettaglioAsset[tns2:nomeComponente = ('ACCESSOATMSIMFLAT', 'ACCESSOATMSIMHL')]) > 0&quot;>&lt;tns:NOME_SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMSIM&amp;quot;&quot;/>&lt;/tns:NOME_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Map_StatoAttivo/tns2:FindAsset/tns2:DettaglioAsset[tns2:nomeComponente = 'ACCESSOGBESIMFLAT']) > 0&quot;>&lt;tns:NOME_SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMGBESIM&amp;quot;&quot;/>&lt;/tns:NOME_SERVIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$TranscodOfferta/Record/OFFERTA&quot;>&lt;tns:NOME_SERVIZIO>&lt;xsl:value-of select=&quot;$TranscodOfferta/Record/OFFERTA&quot;/>&lt;/tns:NOME_SERVIZIO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:CODICE_OLO>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:codificaOloAgcom&quot;/>&lt;/tns:CODICE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:offerta = 'CPS'&quot;>&lt;tns:MODALITA_FATTURAZIONE>&lt;xsl:value-of select=&quot;'FLAT'&quot;/>&lt;/tns:MODALITA_FATTURAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;$TranscodOfferta/Record/MOD_FATTURAZIONE=('FLAT', 'CONSUMO')&quot;>&lt;xsl:if test=&quot;$TranscodOfferta/Record/MOD_FATTURAZIONE&quot;>&lt;tns:MODALITA_FATTURAZIONE>&lt;xsl:value-of select=&quot;$TranscodOfferta/Record/MOD_FATTURAZIONE&quot;/>&lt;/tns:MODALITA_FATTURAZIONE>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($DISTRETTO)>0 and count($RO/Record)>0&quot;>&lt;xsl:if test=&quot;$RO/Record[1]/RO&quot;>&lt;tns:RO>&lt;xsl:value-of select=&quot;$RO/Record[1]/RO&quot;/>&lt;/tns:RO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($CODEDR)>0 and count($DR/Record)>0&quot;>&lt;xsl:if test=&quot;$DR/Record[1]/COD_NUMERICO&quot;>&lt;tns:DR>&lt;xsl:value-of select=&quot;$DR/Record[1]/COD_NUMERICO&quot;/>&lt;/tns:DR>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Response/tns:Servizio/tns:CAP&quot;>&lt;tns:CAP>&lt;xsl:value-of select=&quot;$Response/tns:Servizio/tns:CAP&quot;/>&lt;/tns:CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;$Response/tns:Servizio/tns:CIVICO&quot;>&lt;tns:CIVICO>&lt;xsl:value-of select=&quot;$Response/tns:Servizio/tns:CIVICO&quot;/>&lt;/tns:CIVICO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Response/tns:Servizio/tns:COMUNE&quot;>&lt;tns:COMUNE>&lt;xsl:value-of select=&quot;$Response/tns:Servizio/tns:COMUNE&quot;/>&lt;/tns:COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Response/tns:Servizio/tns:PROVINCIA&quot;>&lt;tns:PROVINCIA>&lt;xsl:value-of select=&quot;$Response/tns:Servizio/tns:PROVINCIA&quot;/>&lt;/tns:PROVINCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Response/tns:Servizio/tns:INDIRIZZO&quot;>&lt;tns:INDIRIZZO>&lt;xsl:value-of select=&quot;$Response/tns:Servizio/tns:INDIRIZZO&quot;/>&lt;/tns:INDIRIZZO>&lt;/xsl:if>&lt;xsl:if test=&quot;$SelectCFPiva/Record/CF&quot;>&lt;tns:CODICE_FISCALE>&lt;xsl:value-of select=&quot;$SelectCFPiva/Record/CF&quot;/>&lt;/tns:CODICE_FISCALE>&lt;/xsl:if>&lt;xsl:if test=&quot;$SelectCFPiva/Record/PIVA&quot;>&lt;tns:PARTITA_IVA>&lt;xsl:value-of select=&quot;$SelectCFPiva/Record/PIVA&quot;/>&lt;/tns:PARTITA_IVA>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$TranscodOfferta/Record/OFFERTA = 'BIT_SIMM' and $Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[tns2:nomeComponente = ('ACCESSOATMSIMFLAT', 'ACCESSOGBESIMFLAT', 'ACCESSOATMSIMHL')]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'TECNOLOGIADELIVERY']/tns2:valoreAttributo = 'H'&quot;>&lt;tns:TECNOLOGIA_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;HDSL&amp;quot;&quot;/>&lt;/tns:TECNOLOGIA_ACCESSO>&lt;/xsl:when>&lt;xsl:when test=&quot;$TranscodOfferta/Record/OFFERTA = 'BIT_SIMM' and $Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[tns2:nomeComponente = ('ACCESSOATMSIMFLAT', 'ACCESSOGBESIMFLAT', 'ACCESSOATMSIMHL')]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'TECNOLOGIADELIVERY']/tns2:valoreAttributo = 'S'&quot;>&lt;tns:TECNOLOGIA_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;SDSL&amp;quot;&quot;/>&lt;/tns:TECNOLOGIA_ACCESSO>&lt;/xsl:when>&lt;xsl:when test=&q