       &lt;xsl:if test=&quot;tns1:INDIRIZZO&quot;>&#xa;                                &lt;tns1:INDIRIZZO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:INDIRIZZO&quot;/>&#xa;                                &lt;/tns1:INDIRIZZO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CODICE_FISCALE&quot;>&#xa;                                &lt;tns1:CODICE_FISCALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CODICE_FISCALE&quot;/>&#xa;                                &lt;/tns1:CODICE_FISCALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:PARTITA_IVA&quot;>&#xa;                                &lt;tns1:PARTITA_IVA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:PARTITA_IVA&quot;/>&#xa;                                &lt;/tns1:PARTITA_IVA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TECNOLOGIA_ACCESSO&quot;>&#xa;                                &lt;tns1:TECNOLOGIA_ACCESSO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TECNOLOGIA_ACCESSO&quot;/>&#xa;                                &lt;/tns1:TECNOLOGIA_ACCESSO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:TIPO_LINEA&quot;>&#xa;                                &lt;tns1:TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:TIPO_LINEA&quot;/>&#xa;                                &lt;/tns1:TIPO_LINEA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:STRUTTURA_LINEA&quot;>&#xa;                                &lt;tns1:STRUTTURA_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:STRUTTURA_LINEA&quot;/>&#xa;                                &lt;/tns1:STRUTTURA_LINEA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:INDIRIZZO_IP_1&quot;>&#xa;                                &lt;tns1:INDIRIZZO_IP_1>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:INDIRIZZO_IP_1&quot;/>&#xa;                                &lt;/tns1:INDIRIZZO_IP_1>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:INDIRIZZO_IP_2&quot;>&#xa;                                &lt;tns1:INDIRIZZO_IP_2>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:INDIRIZZO_IP_2&quot;/>&#xa;                                &lt;/tns1:INDIRIZZO_IP_2>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:INDIRIZZO_IP_3&quot;>&#xa;                                &lt;tns1:INDIRIZZO_IP_3>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:INDIRIZZO_IP_3&quot;/>&#xa;                                &lt;/tns1:INDIRIZZO_IP_3>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:INDIRIZZO_IP_4&quot;>&#xa;                                &lt;tns1:INDIRIZZO_IP_4>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:INDIRIZZO_IP_4&quot;/>&#xa;                                &lt;/tns1:INDIRIZZO_IP_4>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:Servizio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:NOW_HAL_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
