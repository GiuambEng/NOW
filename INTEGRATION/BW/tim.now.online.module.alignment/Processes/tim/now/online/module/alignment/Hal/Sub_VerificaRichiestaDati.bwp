                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="DESCR_COMUNE"
                                    dataType="12" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="NUMERO_CIVICO"
                                    dataType="12" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="DESCR_PROV"
                                    dataType="12" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="DESCR_PARTICELLA_TOPON"
                                    dataType="12" typeName="VARCHAR2"/>

                                    <columnMetadata
