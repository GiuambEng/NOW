                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select t.nome_offerta_esterna as OFFERTA, f.DESCR_PAGAMENTO as MOD_FATTURAZIONE&#xa;from TRASCODFC_OFFERTA  t, OFFERTA off&#xa;  left outer join TIPOLG_PAGAMENTO_ACCS f on off.IDTPLG_PAGAMENTO_ACCS = f.IDTPLG_PAGAMENTO_ACCS&#xa;where t.ID_OFFERTA=?&#xa;and t.PROVENIENZA='HAL'&#xa;and off.ID_OFFERTA=t.ID_OFFERTA" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_OFFERTA"/>

                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="MOD_FATTURAZIONE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
