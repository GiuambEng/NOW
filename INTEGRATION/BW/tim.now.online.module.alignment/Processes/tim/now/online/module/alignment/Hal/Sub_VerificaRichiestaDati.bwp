                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Response"
                                    name="IndirizzoNonCertificato"
                                    outputVariable="Response"
                                    tibex:xpdlId="d294b2d1-8f36-456c-a9c5-ad3b649e1b5e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
