                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_HAL/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/ResponseComplexTypeRichiestaDatiTecnici&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryVC&quot;/>&lt;xsl:param name=&quot;TranscodOfferta&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:param name=&quot;SelectCFPiva&quot;/>&lt;xsl:param name=&quot;RO&quot;/>&lt;xsl:param name=&quot;DISTRETTO&quot;/>&lt;xsl:param name=&quot;CODEDR&quot;/>&lt;xsl:param name=&quot;DR&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;index1&quot;/>&lt;xsl:param name=&quot;Map_StatoAttivo&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns:NOW_HAL_Response>&lt;tns:Esito>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Esito>&lt;tns:TIMESTAMP>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(),&amp;quot;[D01]-[M01]-[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/tns:TIMESTAMP>&lt;/tns:Esito>&lt;tns:Servizio>&lt;xsl:if test=&quot;$TranscodOfferta/Record[1]/OFFERTA = ('EASYIP', 'BITSTREAMATMASIM', 'BIT_SIMM') and $Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:nomeComponente = 'ATMVC'&quot;>&lt;tns:VC>&lt;tns:ID_RISORSA_VC>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'IDRISORSAVC']/tns2:valoreAttributo&quot;/>&lt;/tns:ID_RISORSA_VC>&lt;tns:CODICE_TD_OLO>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'CODICETD']/tns2:valoreAttributo&quot;/>&lt;/tns:CODICE_TD_OLO>&lt;tns:MCR_DOWNSTREAM>&lt;xsl:value-of select=&quot;xsd:string($QueryVC/Record[1]/MCR_DOWN)&quot;/>&lt;/tns:MCR_DOWNSTREAM>&lt;tns:MCR_UPSTREAM>&lt;xsl:value-of select=&quot;xsd:string($QueryVC/Record[1]/MCR_UP)&quot;/>&lt;/tns:MCR_UPSTREAM>&lt;tns:PCR_DOWNSTREAM>&lt;xsl:value-of select=&quot;xsd:string($QueryVC/Record[1]/PCR_DOWN)&quot;/>&lt;/tns:PCR_DOWNSTREAM>&lt;tns:PCR_UPSTREAM>&lt;xsl:value-of select=&quot;xsd:string($QueryVC/Record[1]/PCR_UP)&quot;/>&lt;/tns:PCR_UPSTREAM>&lt;/tns:VC>&lt;/xsl:if>&lt;xsl:if test=&quot;$TranscodOfferta/Record[1]/OFFERTA = ('BSFTTCVULA', 'BSFTTHVULA', 'BSFTTCNGA', 'BSFTTHNGA', 'BITSTREAMGBEASIM') and $Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:nomeComponente = ('GBEVC', 'USERVLAN')&quot;>&lt;tns:UserVlan>&lt;xsl:choose>&lt;xsl:when test=&quot;$TranscodOfferta/Record[1]/OFFERTA= 'BITSTREAMGBEASIM'&quot;>&lt;tns:ID_RISORSA_USERVLAN>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'IDRISORSAVC']/tns2:valoreAttributo&quot;/>&lt;/tns:ID_RISORSA_USERVLAN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ID_RISORSA_USERVLAN>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'IDRISORSAUSERVLAN']/tns2:valoreAttributo&quot;/>&lt;/tns:ID_RISORSA_USERVLAN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$TranscodOfferta/Record[1]/OFFERTA= 'BITSTREAMGBEASIM'&quot;>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;>&lt;tns:SVLAN>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;/>&lt;/tns:SVLAN>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;>&lt;tns:SVLAN>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;/>&lt;/tns:SVLAN>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:nomeComponente = 'USERVLAN' and (string-length($Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo) > 0 or string-length($Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'CVLANID']/tns2:valoreAttributo) > 0 )&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$TranscodOfferta/Record[1]/OFFERTA = 'BITSTREAMGBEASIM'&quot;>&lt;xsl:if test=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[tns2:nomeComponente = 'USERVLAN' and number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;>&lt;tns:CODE_VLAN_SINGLE_TAG>&lt;xsl:value-of select=&quot;$Map_StatoAttivo/tns2:FindAsset[number($index)]/tns2:DettaglioAsset[tns2:nomeComponente = 'USERVLAN' and number($index1)]/tns2:AttributiDettaglioAsset[tns2:nomeAttributo = 'SVLANCODE']/tns2:valoreAttributo&quot;/>&lt;/tns:CODE_VLAN_SINGLE_TAG>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Map