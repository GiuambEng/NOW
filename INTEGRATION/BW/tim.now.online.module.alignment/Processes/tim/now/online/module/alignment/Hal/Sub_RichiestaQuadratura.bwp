            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+75e31d0a-788c-4263-a2bb-0bdfc1dae68d+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_HAL_QUADRATURA/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NOW_HAL_QUADRATURAIn&quot;/>&lt;xsl:template name=&quot;Ordini_DN-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRISORSA>&lt;xsl:value-of select=&quot;$NOW_HAL_QUADRATURAIn/parameters/tns1:NOW_HAL_QUADRATURA_Request/tns1:DN&quot;/>&lt;/IDRISORSA>&lt;NUMEROTELEFONICO>&lt;xsl:value-of select=&quot;$NOW_HAL_QUADRATURAIn/parameters/tns1:NOW_HAL_QUADRATURA_Request/tns1:DN&quot;/>&lt;/NUMEROTELEFONICO>&lt;NUMEROFITTIZIO>&lt;xsl:value-of select=&quot;$NOW_HAL_QUADRATURAIn/parameters/tns1:NOW_HAL_QUADRATURA_Request/tns1:DN&quot;/>&lt;/NUMEROFITTIZIO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Ordini_DN-input" name="Ordini_DN"
                    outputVariable="Ordini_DN"
                    tibex:xpdlId="75e31d0a-788c-4263-a2bb-0bdfc1dae68d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToOrdini_DN"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Ordini_DNToLogOutputQueryOrdini"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+75e31d0a-788c-4263-a2bb-0bdfc1dae68d+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_HAL_QUADRATURA/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOW_HAL_QUADRATURAIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;Ordini_DN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;IDRISORSA>&#xa;                &lt;xsl:value-of select=&quot;$NOW_HAL_QUADRATURAIn.parameters/tns1:DN&quot;/>&#xa;            &lt;/IDRISORSA>&#xa;            &lt;NUMEROTELEFONICO>&#xa;                &lt;xsl:value-of select=&quot;$NOW_HAL_QUADRATURAIn.parameters/tns1:DN&quot;/>&#xa;            &lt;/NUMEROTELEFONICO>&#xa;            &lt;NUMEROFITTIZIO>&#xa;                &lt;xsl:value-of select=&quot;$NOW_HAL_QUADRATURAIn.parameters/tns1:DN&quot;/>&#xa;            &lt;/NUMEROFITTIZIO>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select ord.offerta,ord.numerofittizio,ord.numerotelefonico,ord.idrisorsa, ol.codfc_olo_agcom, ol.cod_olo, ord.des, ord.idullco, ord.idsluco, ric.statorichiestaolo, ric.statorichiestanow, ord.tipologialavorazione, ord.bds_id, ord.idrichiestaolo, ric.routingnumber&#xa;from bds_1_casedata_ordine ord,olo ol, bds_1_casedata_richiesta ric&#xa;where ric.idrichiestaolo=ord.idrichiestaolo and ord.codificaolonow=ol.cod_olo and (ord.idrisorsa=? or ord.numerotelefonico=? or ord.numerofittizio=?) and ord.offerta in ('NP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP','ULLLINEAATTIVANP','VULL','VULLLINEANONATTIVA','WLRLINEAATTIVA','WLRLINEANONATTIVA','SLULINEAATTIVA','SLULINEANONATTIVA','ULLLINEAATTIVA','ULLLINEANONATTIVA','ULLDATILINEANONATTIVA','ULLDATILINEAATTIVA','CPS','SHACONMANODOPERA','SHASENZAMANODOPERA')" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROTELEFONICO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROFITTIZIO"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROFITTIZIO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROTELEFONICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnName="DES"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="IDULLCO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDSLUCO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLOGIALAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="BDS_ID"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="ROUTINGNUMBER"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ResponseComplexQuadratura&quot; xmlns:ns5=&quot;http://www.tim.com/NOW/xsd/NOW_HAL_QUADRATURA/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Ordini&quot;/>&lt;xsl:param name=&quot;NOW_HAL_QUADRATURAIn&quot;/>&lt;xsl:param name=&quot;Ordini_DN&quot;/>&lt;xsl:param name=&quot;OrdineAsset&quot;/>&lt;xsl:template name=&quot;OrdineAsset&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($NOW_HAL_QUADRATURAIn/parameters/ns5:NOW_HAL_QUADRATURA_Request/ns5:DN,'U')&quot;>&lt;tns:OrdineComplexType>&lt;xsl:copy-of select=&quot;$OrdineAsset/tns:OrdineAsset&quot;/>&lt;xsl:for-each select=&quot;$Ordini/Record&quot;>&lt;tns:OrdineAsset>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:NomeServizio>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:NomeServizio>&lt;/xsl:if>&lt;tns:DescOlo>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:DescOlo>&lt;tns:CodiceOlo>&lt;xsl:value-of select=&quot;COD_OLO&quot;/>&lt;/tns:CodiceOlo>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string(DES))>0&quot;>&lt;tns:Dec>&lt;xsl:value-of select=&quot;format-dateTime(DES,&amp;quot;[D01]/[M01]/[YYYY]&amp;quot;)&quot;/>&lt;/tns:Dec>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;ROUTINGNUMBER&quot;>&lt;tns:Rn>&lt;xsl:value-of select=&quot;ROUTINGNUMBER&quot;/>&lt;/tns:Rn>&lt;/xsl:if>&lt;xsl:if test=&quot;IDSLUCO&quot;>&lt;tns:IdsLuco>&lt;xsl:value-of select=&quot;IDSLUCO&quot;/>&lt;/tns:IdsLuco>&lt;/xsl:if>&lt;xsl:if test=&quot;IDULLCO&quot;>&lt;tns:Idullco>&lt;xsl:value-of select=&quot;IDULLCO&quot;/>&lt;/tns:Idullco>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPOLOGIALAVORAZIONE&quot;>&lt;tns:TipologiaLavorazione>&lt;xsl:value-of select=&quot;TIPOLOGIALAVORAZIONE&quot;/>&lt;/tns:TipologiaLavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&lt;tns:StatoRichiestaOlo>&lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&lt;/tns:StatoRichiestaOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&lt;tns:StatoRichiestaNow>&lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&lt;/tns:StatoRichiestaNow>&lt;/xsl:if>&lt;tns:BdsIdOrd>&lt;xsl:value-of select=&quot;BDS_ID&quot;/>&lt;/tns:BdsIdOrd>&lt;xsl:if test=&quot;IDRICHIESTAOLO&quot;>&lt;tns:IdRichiestaOlo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:IdRichiestaOlo>&lt;/xsl:if>&lt;tns:Entita>&lt;xsl:value-of select=&quot;'ORDINE'&quot;/>&lt;/tns:Entita>&lt;/tns:OrdineAsset>&lt;/xsl:for-each>&lt;/tns:OrdineComplexType>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OrdineComplexType>&lt;xsl:copy-of select=&quot;$OrdineAsset/tns:OrdineAsset&quot;/>&lt;xsl:for-each select=&quot;$Ordini_DN/Record&quot;>&lt;tns:OrdineAsset>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:NomeServizio>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:NomeServizio>&lt;/xsl:if>&lt;tns:DescOlo>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:DescOlo>&lt;tns:CodiceOlo>&lt;xsl:value-of select=&quot;COD_OLO&quot;/>&lt;/tns:CodiceOlo>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string(DES))>0&quot;>&lt;tns:Dec>&lt;xsl:value-of select=&quot;format-dateTime(DES,&amp;quot;[D01]/[M01]/[YYYY]&amp;quot;)&quot;/>&lt;/tns:Dec>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;ROUTINGNUMBER&quot;>&lt;tns:Rn>&lt;xsl:value-of select=&quot;ROUTINGNUMBER&quot;/>&lt;/tns:Rn>&lt;/xsl:if>&lt;xsl:if test=&quot;IDSLUCO&quot;>&lt;tns:IdsLuco>&lt;xsl:value-of select=&quot;IDSLUCO&quot;/>&lt;/tns:IdsLuco>&lt;/xsl:if>&lt;xsl:if test=&quot;IDULLCO&quot;>&lt;tns:Idullco>&lt;xsl:value-of select=&quot;IDULLCO&quot;/>&lt;/tns:Idullco>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPOLOGIALAVORAZIONE&quot;>&lt;tns:TipologiaLavorazione>&lt;xsl:value-of select=&quot;TIPOLOGIALAVORAZIONE&quot;/>&lt;/tns:TipologiaLavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&lt;tns:StatoRichiestaOlo>&lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&lt;/tns:StatoRichiestaOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&lt;tns:StatoRichiestaNow>&lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&lt;/tns:StatoRichiestaNow>&lt;/xsl:if>&lt;tns:BdsIdOrd>&lt;xsl:value-of select=&quot;BDS_ID&quot;/>&lt;/tns:BdsIdOrd>&lt;xsl:if test=&quot;IDRICHIESTAOLO&quot;>&lt;tns:IdRichiestaOlo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:IdRichiestaOlo>&lt;/xsl:if>&lt;tns:Entita>&lt;xsl:value-of select=&quot;'ORDINE'&quot;/>&lt;/tns:Entita>&lt;/tns:OrdineAsset>&lt;/xsl:for-each>&lt;/tns:OrdineComplexType>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="OrdineAsset" name="QueryOrdini"
                    outputVariable="OrdineAsset"
                    tibex:xpdlId="a6a54add-328e-4cb3-9026-8cc377e068d4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogOutputQueryOrdiniToQueryOrdini"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OrdinToEsito_In_ORDINEINDELIVERY">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="boolean($OrdineAsset/ns9:OrdineAsset/ns9:StatoRichiestaOlo=('INDELIVERY','INVIATOADELIVERY','ACCODATO','SOSPESO')) &#xd;&#xa;and &#xd;&#xa;not(boolean($OrdineAsset/ns9:OrdineAsset[ns9:TipologiaLavorazione='CESSAZIONE' and ns9:StatoRichiestaNow=('ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE','FATTURAZIONEKO')]))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[boolean($OrdineAsset/ns9:OrdineAsset/ns9:StatoRichiestaOlo=('INDELIVERY','INVIATOADELIVERY','ACCODATO','SOSPESO')) 
and 
not(boolean($OrdineAsset/ns9:OrdineAsset[ns9:TipologiaLavorazione='CESSAZIONE' and ns9:StatoRichiestaNow=('ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE','FATTURAZIONEKO')]))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="OrdinToEsito_NESSUNAOCCORRENZA">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="QueryOrdiniToCopy_1_LogOutputRemove">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(boolean($OrdineAsset/ns9:OrdineAsset[ns9:TipologiaLavorazione=('ATTIVAZIONE','MIGRAZIONE') and ns9:StatoRichiestaNow=('ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE','FATTURAZIONEKO')]) &#xd;&#xa;&#x9;or count($OrdineAsset/ns9:OrdineAsset[ns9:Entita='ASSET'])>0)&#xd;&#xa;and &#xd;&#xa;&#x9;not(boolean($OrdineAsset/ns9:OrdineAsset/ns9:StatoRichiestaOlo=('INDELIVERY','INVIATOADELIVERY','ACCODATO','SOSPESO'))) &#xd;&#xa;and &#xd;&#xa;&#x9;not(boolean($OrdineAsset/ns9:OrdineAsset[ns9:TipologiaLavorazione='CESSAZIONE' and ns9:StatoRichiestaNow=('ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE','FATTURAZIONEKO')]))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[(boolean($OrdineAsset/ns9:OrdineAsset[ns9:TipologiaLavorazione=('ATTIVAZIONE','MIGRAZIONE') and ns9:StatoRichiestaNow=('ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE','FATTURAZIONEKO')]) 
	or count($OrdineAsset/ns9:OrdineAsset[ns9:Entita='ASSET'])>0)
and 
	not(boolean($OrdineAsset/ns9:OrdineAsset/ns9:StatoRichiestaOlo=('INDELIVERY','INVIATOADELIVERY','ACCODATO','SOSPESO'))) 
and 
	not(boolean($OrdineAsset/ns9:OrdineAsset[ns9:TipologiaLavorazione='CESSAZIONE' and ns9:StatoRichiestaNow=('ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE','FATTURAZIONEKO')]))]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ResponseComplexQuadratura&quot; xmlns:ns5=&quot;http://www.tim.com/NOW/xsd/NOW_HAL_QUADRATURA/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOW_HAL_QUADRATURAIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Ordini&quot;/>&#xa;    &lt;xsl:param name=&quot;Ordini_DN&quot;/>&#xa;    &lt;xsl:param name=&quot;OrdineAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;OrdineAsset&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;starts-with($NOW_HAL_QUADRATURAIn.parameters/ns5:DN,'U')&quot;>&#xa;                &lt;tns:OrdineComplexType>&#xa;                    &lt;xsl:copy-of select=&quot;$OrdineAsset/tns:OrdineAsset&quot;/>&#xa;                    &lt;xsl:for-each select=&quot;$Ordini/Record&quot;>&#xa;                        &lt;tns:OrdineAsset>&#xa;                            &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                &lt;tns:NomeServizio>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns:NomeServizio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:DescOlo>&#xa;                                &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns:DescOlo>&#xa;                            &lt;tns:CodiceOlo>&#xa;                                &lt;xsl:value-of select=&quot;COD_OLO&quot;/>&#xa;                            &lt;/tns:CodiceOlo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(xsd:string(DES))>0&quot;>&#xa;                                    &lt;tns:Dec>&#xa;                                        &lt;xsl:value-of select=&quot;format-dateTime(DES,&amp;quot;[D01]/[M01]/[YYYY]&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:Dec>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;ROUTINGNUMBER&quot;>&#xa;                                &lt;tns:Rn>&#xa;                                    &lt;xsl:value-of select=&quot;ROUTINGNUMBER&quot;/>&#xa;                                &lt;/tns:Rn>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDSLUCO&quot;>&#xa;                                &lt;tns:IdsLuco>&#xa;                                    &lt;xsl:value-of select=&quot;IDSLUCO&quot;/>&#xa;                                &lt;/tns:IdsLuco>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDULLCO&quot;>&#xa;                                &lt;tns:Idullco>&#xa;                                    &lt;xsl:value-of select=&quot;IDULLCO&quot;/>&#xa;                                &lt;/tns:Idullco>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPOLOGIALAVORAZIONE&quot;>&#xa;                                &lt;tns:TipologiaLavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;TIPOLOGIALAVORAZIONE&quot;/>&#xa;                                &lt;/tns:TipologiaLavorazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&#xa;                                &lt;tns:StatoRichiestaOlo>&#xa;                                    &lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&#xa;                                &lt;/tns:StatoRichiestaOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&#xa;                                &lt;tns:StatoRichiestaNow>&#xa;                                    &lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&#xa;                                &lt;/tns:StatoRichiestaNow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:BdsIdOrd>&#xa;                                &lt;xsl:value-of select=&quot;BDS_ID&quot;/>&#xa;                            &lt;/tns:BdsIdOrd>&#xa;                            &lt;xsl:if test=&quot;IDRICHIESTAOLO&quot;>&#xa;                                &lt;tns:IdRichiestaOlo>&#xa;                                    &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                                &lt;/tns:IdRichiestaOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:Entita>&#xa;                                &lt;xsl:value-of select=&quot;'ORDINE'&quot;/>&#xa;                            &lt;/tns:Entita>&#xa;                        &lt;/tns:OrdineAsset>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:OrdineComplexType>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:OrdineComplexType>&#xa;                    &lt;xsl:copy-of select=&quot;$OrdineAsset/tns:OrdineAsset&quot;/>&#xa;                    &lt;xsl:for-each select=&quot;$Ordini_DN/Record&quot;>&#xa;                        &lt;tns:OrdineAsset>&#xa;                            &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                &lt;tns:NomeServizio>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns:NomeServizio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:DescOlo>&#xa;                                &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns:DescOlo>&#xa;                            &lt;tns:CodiceOlo>&#xa;                                &lt;xsl:value-of select=&quot;COD_OLO&quot;/>&#xa;                            &lt;/tns:CodiceOlo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(xsd:string(DES))>0&quot;>&#xa;                                    &lt;tns:Dec>&#xa;                                        &lt;xsl:value-of select=&quot;format-dateTime(DES,&amp;quot;[D01]/[M01]/[YYYY]&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:Dec>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;ROUTINGNUMBER&quot;>&#xa;                                &lt;tns:Rn>&#xa;                                    &lt;xsl:value-of select=&quot;ROUTINGNUMBER&quot;/>&#xa;                                &lt;/tns:Rn>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDSLUCO&quot;>&#xa;                                &lt;tns:IdsLuco>&#xa;                                    &lt;xsl:value-of select=&quot;IDSLUCO&quot;/>&#xa;                                &lt;/tns:IdsLuco>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDULLCO&quot;>&#xa;                                &lt;tns:Idullco>&#xa;                                    &lt;xsl:value-of select=&quot;IDULLCO&quot;/>&#xa;                                &lt;/tns:Idullco>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPOLOGIALAVORAZIONE&quot;>&#xa;                                &lt;tns:TipologiaLavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;TIPOLOGIALAVORAZIONE&quot;/>&#xa;                                &lt;/tns:TipologiaLavorazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&#xa;                                &lt;tns:StatoRichiestaOlo>&#xa;                                    &lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&#xa;                                &lt;/tns:StatoRichiestaOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&#xa;                                &lt;tns:StatoRichiestaNow>&#xa;                                    &lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&#xa;                                &lt;/tns:StatoRichiestaNow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:BdsIdOrd>&#xa;                                &lt;xsl:value-of select=&quot;BDS_ID&quot;/>&#xa;                            &lt;/tns:BdsIdOrd>&#xa;                            &lt;xsl:if test=&quot;IDRICHIESTAOLO&quot;>&#xa;                                &lt;tns:IdRichiestaOlo>&#xa;                                    &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                                &lt;/tns:IdRichiestaOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:Entita>&#xa;                                &lt;xsl:value-of select=&quot;'ORDINE'&quot;/>&#xa;                            &lt;/tns:Entita>&#xa;                        &lt;/tns:OrdineAsset>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:OrdineComplexType>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
