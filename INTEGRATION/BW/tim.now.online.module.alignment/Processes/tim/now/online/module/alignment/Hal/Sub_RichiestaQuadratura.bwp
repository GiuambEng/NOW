                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ResponseComplexQuadratura&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OrdineAsset&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;GetAttributi&quot;/>&lt;xsl:param name=&quot;GetSedeGat&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:OrdineComplexType>&lt;xsl:choose>&lt;xsl:when test=&quot;$OrdineAsset/tns:OrdineAsset[number($index)]/tns:Entita='ORDINE'&quot;>&lt;tns:OrdineAsset>&lt;xsl:if test=&quot;$OrdineAsset/tns:OrdineAsset[number($index)]/tns:NomeServizio&quot;>&lt;tns:NomeServizio>&lt;xsl:value-of select=&quot;$OrdineAsset/tns:OrdineAsset[number($index)]/tns:NomeServizio&quot;/>&lt;/tns:NomeServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdineAsset/tns:OrdineAsset[number($index)]/tns:DescOlo&quot;>&lt;tns:DescOlo>&lt;xsl:value-of select=&quot;$OrdineAsset/tns:OrdineAsset[number($index)]/tns:DescOlo&quot;/>&lt;/tns:DescOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdineAsset/tns:OrdineAsset[number($index)]/tns:CodiceOlo&quot;>&lt;tns:CodiceOlo>&lt;xsl:value-of select=&quot;$OrdineAsset/tns:OrdineAsset[number($index)]/tns:CodiceOlo&quot;/>&lt;/tns:CodiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$GetAttributi/Record[NOMEATTRIBUTO='TIPOLINEA' and starts-with(NOMECOMPONENTE,'ACCESSO')]/VALOREATTRIBUTO&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;$GetAttributi/Record[NOMEATTRIBUTO='TIPOLINEA' and starts-with(NOMECOMPONENTE,'ACCESSO')]/VALOREATTRIBUTO&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdineAsset/tns:OrdineAsset[number($index)]/tns:Dec&quot;>&lt;tns:Dec>&lt;xsl:copy-of select=&quot;$OrdineAsset/tns:OrdineAsset[number($index)]/tns:Dec/