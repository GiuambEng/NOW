                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ResponseComplexQuadratura&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OrdineAsset&quot;/>&lt;xsl:template name=&quot;OrdineAsset&quot; match=&quot;/&quot;>&lt;tns:OrdineComplexType>&lt;xsl:for-each select=&quot;$OrdineAsset/tns:OrdineAsset[tns:NomeServizio!='NP' and tns:NomeServizio!='CPS']&quot;>&lt;tns:OrdineAsset>&lt;xsl:if test=&quot;tns:NomeServizio&quot;>&lt;tns:NomeServizio>&lt;xsl:value-of select=&quot;tns:NomeServizio&quot;/>&lt;/tns:NomeServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DescOlo&quot;>&lt;tns:DescOlo>&lt;xsl:value-of select=&quot;tns:DescOlo&quot;/>&lt;/tns:DescOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:CodiceOlo&quot;>&lt;tns:CodiceOlo>&lt;xsl:value-of select=&quot;tns:CodiceOlo&quot;/>&lt;/tns:CodiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TipoLinea&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;tns:TipoLinea&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Dec&quot;>&lt;tns:Dec>&lt;xsl:copy-of select=&quot;tns:Dec/@xsi:nil&quot;/>&lt;xsl:value-of select=&quot;tns:Dec&quot;/>&lt;/tns:Dec>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Rn&quot;>&lt;tns:Rn>&lt;xsl:value-of select=&quot;tns:Rn&quot;/>&lt;/tns:Rn>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Centrale&quot;>&lt;tns:Centrale>&lt;xsl:value-of select=&quot;tns:Centrale&quot;/>&lt;/tns:Centrale>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:SedeGat&quot;>&lt;tns:SedeGat>&lt;xsl:value-of select=&quot;tns:SedeGat&quot;/>&lt;/tns:SedeGat>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:IdsLuco&quot;>&lt;tns:IdsLuco>&lt;xsl:value-of select=&quot;tns:IdsLuco&quot;/>&lt;/tns:IdsLuco>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Idullco&quot;>&lt;tns:Idullco>&lt;xsl:value-of select=&quot;tns:Idullco&quot;/>&lt;/tns:Idullco