                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ResponseComplexQuadratura&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OrdineAsset&quot;/>&lt;xsl:param name=&quot;FindAsset&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;OrdineAsset&quot; match=&quot;/&quot;>&lt;tns:OrdineComplexType>&lt;xsl:copy-of select=&quot;$OrdineAsset/tns:OrdineAsset&quot;/>&lt;xsl:if test=&quot;$FindAsset/part1/tns1:Output/tns1:Find[number($index)]/tns1:Asset/statoAsset!='CESSATO' and $FindAsset/part1/tns1:Output/tns1:Find[number($index)]/tns1:Asset/offerta=('NP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP','ULLLINEAATTIVANP','VULL','VULLLINEANONATTIVA','WLRLINEAATTIVA','WLRLINEANONATTIVA','SLULINEAATTIVA','SLULINEANONATTIVA','ULLLINEAATTIVA','ULLLINEANONATTIVA','ULLDATILINEANONATTIVA','ULLDATILINEAATTIVA','CPS','SHACONMANODOPERA','SHASENZAMANODOPERA')&quot;>&lt;tns:OrdineAsset>&lt;xsl:if test=&quot;$FindAsset/part1/tns1:Output/tns1:Find[number($index)]/tns1:Asset/offerta&quot;>&lt;tns:NomeServizio>&lt;xsl:value-of select=&quot;$FindAsset/part1/tns1:Output/tns1:Find[number($index)]/tns1:Asset/offerta&quot;/>&lt;/tns:NomeServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindAsset/part1/tns1:Output/tns1:Find[number($index)]/tns1:Asset/codificaOLOAGCOM&quot;>&lt;tns:DescOlo>&lt;xsl:value-of select=&quot;$FindAsset/part1/tns1:Output/tns1:Find[number($index)]/tns1:Asset/codificaOLOAGCOM&quot;/>&lt;/tns:DescOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/COD_OLO&quot;>&lt;tns:CodiceOlo>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_OLO&quot;/>&lt;/tns:CodiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindAsset