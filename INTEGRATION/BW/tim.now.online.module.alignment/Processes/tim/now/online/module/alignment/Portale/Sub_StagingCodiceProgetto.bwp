                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="StartStaging-input"
                    name="StartStaging"
                    tibex:xpdlId="ac096e5e-efe8-4f99-804d-4341d9c8ed5f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToJDBCUpdate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:Insert/ns0:CONTENUTO_REQUEST)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Start/ns0:Insert/ns0:CONTENUTO_REQUEST)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToJDBCUpdate1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:Update/ns0:CONTENUTO_RESPONSE)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Start/ns0:Update/ns0:CONTENUTO_RESPONSE)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToJDBCUpdate2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:UpdateOnError/ns0:DESCR_ERRORE)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Start/ns0:UpdateOnError/ns0:DESCR_ERRORE)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
