    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToJDBCUpdate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToJDBCUpdate1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToJDBCUpdate2" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="JDBCUpdateToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCUpdate1ToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCUpdate2ToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCUpdate2ToCallProcess2" tibex:linkType="ERROR"/>
