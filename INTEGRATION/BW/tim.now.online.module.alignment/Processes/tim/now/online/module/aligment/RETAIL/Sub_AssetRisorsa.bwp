;$GetInfo/tns2:QUALIFICAREFERENTE&quot;/>&lt;/tns1:QUALIFICA_REFERENTE_OLO1>&lt;/xsl:if>&lt;/tns1:REFERENTEOLO>&lt;tns1:CLIENTE>&lt;xsl:if test=&quot;$Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/cliente/nome&quot;>&lt;tns1:NOME_CLI>&lt;xsl:value-of select=&quot;$Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/cliente/nome&quot;/>&lt;/tns1:NOME_CLI>&lt;/xsl:if>&lt;tns1:COGNOME_RAGSOC_CLI>&lt;xsl:value-of select=&quot;$Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/cliente/cognomeRagioneSociale&quot;/>&lt;/tns1:COGNOME_RAGSOC_CLI>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/cliente/codiceFiscale)>0&quot;>&lt;xsl:if test=&quot;$Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/cliente/codiceFiscale&quot;>&lt;tns1:CODICE_FISCALE_PIVA>&lt;xsl:value-of select=&quot;$Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/cliente/codiceFiscale&quot;/>&lt;/tns1:CODICE_FISCALE_PIVA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/cliente/partitaIVA)>0&quot;>&lt;xsl:if test=&quot;$Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/cliente/partitaIVA&quot;>&lt;tns1:CODICE_FISCALE_PIVA>&lt;xsl:value-of select=&quot;$Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/cliente/partitaIVA&quot;/>&lt;/tns1:CODICE_FISCALE_PIVA>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns1:CLIENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/IDRichiestaOLO)>0 or (string-length($GetInfo/tns2:OFFERTA)>0 and string-length($GetInfo/tns2:IDRICHIESTAOLO)>0)&quot;>&lt;tns1:VARIATO_NOW>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns1:VARIATO_NOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:VARIATO_NOW>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns1:VARIATO_NOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:CONSISTENZA>&lt;/tns1:RESPONSE>&lt;/tns1:NOWAllineamentoRetailResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
