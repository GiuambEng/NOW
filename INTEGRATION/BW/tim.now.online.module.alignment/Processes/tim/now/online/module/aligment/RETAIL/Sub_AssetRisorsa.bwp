            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="CallProcess-input"
                    name="CallProcess"
                    tibex:xpdlId="e921d696-fafa-446d-873e-e20fbacdf829"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToWhile">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(count($Start/tns:Find[tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta='ULLLINEANONATTIVA' and tns:Asset/codificaOLOAGCOM ='TLC'])=2 or count($Start/tns:Find[tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta='SLULINEANONATTIVA' and tns:Asset/codificaOLOAGCOM ='TLC'])=2) and $Start/tns:Find[(tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta='ULLLINEANONATTIVA' and tns:Asset/codificaOLOAGCOM ='TLC') or (tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta='SLULINEANONATTIVA' and tns:Asset/codificaOLOAGCOM ='TLC')]/tns:Asset/dettaglioasset[attributidettaglioasset/nomeAttributo='DESTINAZIONEUSO']/attributidettaglioasset[nomeAttributo='DESTINAZIONEUSO']/valoreAttributo='2' and $Start/tns:Find[(tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta='ULLLINEANONATTIVA' and tns:Asset/codificaOLOAGCOM ='TLC') or (tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta='SLULINEANONATTIVA' and tns:Asset/codificaOLOAGCOM ='TLC')]/tns:Asset/dettaglioasset[attributidettaglioasset/nomeAttributo='DESTINAZIONEUSO']/attributidettaglioasset[nomeAttributo='DESTINAZIONEUSO']/valoreAttributo='4'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[(count($Start/tns:Find[tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta='ULLLINEANONATTIVA' and tns:Asset/codificaOLOAGCOM ='TLC'])=2 or count($Start/tns:Find[tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta='SLULINEANONATTIVA' and tns:Asset/codificaOLOAGCOM ='TLC'])=2) and $Start/tns:Find[(tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta='ULLLINEANONATTIVA' and tns:Asset/codificaOLOAGCOM ='TLC') or (tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta='SLULINEANONATTIVA' and tns:Asset/codificaOLOAGCOM ='TLC')]/tns:Asset/dettaglioasset[attributidettaglioasset/nomeAttributo='DESTINAZIONEUSO']/attributidettaglioasset[nomeAttributo='DESTINAZIONEUSO']/valoreAttributo='2' and $Start/tns:Find[(tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta='ULLLINEANONATTIVA' and tns:Asset/codificaOLOAGCOM ='TLC') or (tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta='SLULINEANONATTIVA' and tns:Asset/codificaOLOAGCOM ='TLC')]/tns:Asset/dettaglioasset[attributidettaglioasset/nomeAttributo='DESTINAZIONEUSO']/attributidettaglioasset[nomeAttributo='DESTINAZIONEUSO']/valoreAttributo='4']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToGetInfo">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Start/tns:Find[tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE')])=1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/tns:Find[tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE')])=1]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToWhile1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Start/tns:Find[tns:Asset/offerta='NP'  and tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE')])=1 and count($Start/tns:Find[tns:Asset/offerta=('BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','VULAFTTCAB','VULAFTTH','ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP','ULLDATILINEAATTIVANP','ULLLINEANONATTIVA')  and tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE')])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/tns:Find[tns:Asset/offerta='NP'  and tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE')])=1 and count($Start/tns:Find[tns:Asset/offerta=('BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','VULAFTTCAB','VULAFTTH','ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP','ULLDATILINEAATTIVANP','ULLLINEANONATTIVA')  and tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE')])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToWhile2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Start/tns:Find[tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta=('ULLLINEANONATTIVA','ULLLINEAATTIVA','ULLLINEAATTIVANP','SLULINEANONATTIVA','SLULINEAATTIVANP','SLULINEAATTIVA', 'VULL','VULLLINEANONATTIVA','WLRLINEANONATTIVA','WLRLINEAATTIVA','ULLDATILINEAATTIVANP','ULLDATILINEAATTIVA','ULLDATILINEAATTIVANP')])>0 and count($Start/tns:Find[tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta=('BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','SHACONMANODOPERA','SHASENZAMANODOPERA','VULAFTTCAB','VULAFTTH')])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/tns:Find[tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta=('ULLLINEANONATTIVA','ULLLINEAATTIVA','ULLLINEAATTIVANP','SLULINEANONATTIVA','SLULINEAATTIVANP','SLULINEAATTIVA', 'VULL','VULLLINEANONATTIVA','WLRLINEANONATTIVA','WLRLINEAATTIVA','ULLDATILINEAATTIVANP','ULLDATILINEAATTIVA','ULLDATILINEAATTIVANP')])>0 and count($Start/tns:Find[tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE') and tns:Asset/offerta=('BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','SHACONMANODOPERA','SHASENZAMANODOPERA','VULAFTTCAB','VULAFTTH')])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToCallProcess10">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Sub_AssetRisorsa'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('START SUB_ASSET RISORSA', tib:render-xml($Start, true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
