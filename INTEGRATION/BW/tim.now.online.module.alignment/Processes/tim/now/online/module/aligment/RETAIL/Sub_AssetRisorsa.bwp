                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:tns1=&quot;http://www.example.org/Sub_TipoLineaNp&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Sub_TipoLinea_VariatoN-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;xsl:if test=&quot;$Start/tns:Find[tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE')]/tns:Asset/IDRisorsa&quot;>&lt;tns1:Id_Risorsa_Input>&lt;xsl:value-of select=&quot;$Start/tns:Find[tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE')]/tns:Asset/IDRisorsa&quot;/>&lt;/tns1:Id_Risorsa_Input>&lt;/xsl:if>&lt;/tns1:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
