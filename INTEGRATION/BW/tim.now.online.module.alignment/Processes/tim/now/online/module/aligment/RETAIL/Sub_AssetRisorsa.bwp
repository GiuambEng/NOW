                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="a6b8ea1d-3a05-4e9e-9d34-e7d96fe68a22">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToAssign3"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+654428fd-5548-4284-9b45-aa892810cab8" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Var_Conteggio&lt;=count($Start/tns:Find)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Var_Conteggio<=count($Start/tns:Find)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Assign1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToGroupEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Assign6ToAccumulate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign7ToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GetInfoISDN_ADSL_TLCToConsistenzaISDN_ADSL_TLC" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess1ToAccumulate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcess2ToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess3ToStopConteggio" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess4ToAccumulate" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="468a7d10-4608-4155-9b07-cf5b8f5bad52">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Start/tns:Find[number($index)]/tns:Asset/dettaglioasset[nomeComponente='ACCESSOULL']/attributidettaglioasset[nomeAttributo='DESTINAZIONEUSO']/valoreAttributo='2'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/tns:Find[number($index)]/tns:Asset/dettaglioasset[nomeComponente='ACCESSOULL']/attributidettaglioasset[nomeAttributo='DESTINAZIONEUSO']/valoreAttributo='2']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="654428fd-5548-4284-9b45-aa892810cab8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToAccumulate"/>
                                    <bpws:target linkName="CallProcess4ToAccumulate"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Var_Conteggio"
                                    name="StopConteggio"
                                    outputVariable="Var_Conteggio"
                                    tibex:xpdlId="d377c80a-f8e4-4c3e-bff8-98fee5ec6002" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess3ToStopConteggio"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="count($Start/tns:Find) + 1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Var_Conteggio" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Var_Conteggio"
                                    name="Conteggio"
                                    outputVariable="Var_Conteggio"
                                    tibex:xpdlId="d7f4da82-0987-4b55-bd50-0dcc2e2d82b5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToGroupEnd"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign6ToAccumulate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="$Var_Conteggio + 1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Var_Conteggio" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Consistenza"
                                    name="ConsistenzaISDN_ADSL_TLC"
                                    outputVariable="Consistenza"
                                    tibex:xpdlId="7edc222a-f9c6-4365-a2b6-1826cfa7fd44" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GetInfoISDN_ADSL_TLCToConsistenzaISDN_ADSL_TLC"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign7ToAssign1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.NOWResponseAllineamentoRetail&quot; xmlns:tns2=&quot;http://www.example.org/tim.now.schema.GetInfo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;GetInfoISDN_ADSL_TLC&quot;/>&lt;xsl:template name=&quot;Consistenza&quot; match=&quot;/&quot;>&lt;tns1:NOWAllineamentoRetailResponse>&lt;tns1:RESPONSE>&lt;tns1:CONSISTENZA>&lt;tns1:CODICE_OLO>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/codificaOLOAGCOM&quot;/>&lt;/tns1:CODICE_OLO>&lt;xsl:if test=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta&quot;>&lt;tns1:SERVIZIO_FONIA>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta&quot;/>&lt;/tns1:SERVIZIO_FONIA>&lt;/xsl:if>&lt;tns1:CODE_RICHIESTA_TI>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/codiceOrdineTI&quot;/>&lt;/tns1:CODE_RICHIESTA_TI>&lt;tns1:DATA_ESPLETAMENTO>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/DES&quot;/>&lt;/tns1:DATA_ESPLETAMENTO>&lt;tns1:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;ISDN+ADSL&amp;quot;&quot;/>&lt;/tns1:TIPO_LINEA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GetInfoISDN_ADSL_TLC/tns2:DESCR_PARTICELLA_TOPON) > 0&quot;>&lt;xsl:if test=&quot;$GetInfoISDN_ADSL_TLC/tns2:DESCR_PARTICELLA_TOPON&quot;>&lt;tns1:PART_TOPONOMASTICA_OLO>&lt;xsl:value-of select=&quot;$GetInfoISDN_ADSL_TLC/tns2:DESCR_PARTICELLA_TOPON&quot;/>&lt;/tns1:PART_TOPONOMASTICA_OLO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns:Find[number($index)]/tns:Asset/descrPartToponomastica&quot;>&lt;tns1:PART_TOPONOMASTICA_OLO>&lt;xsl:value-o