            <bpws:scope name="While2" tibex:group="while" tibex:xpdlId="30b3c138-1c19-46cf-ade5-c27317a1c750">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While2ToAssign10"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence2" tibex:group="while">
                    <bpws:assign name="GroupInit2"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+3aa1345a-efdd-47b4-aa6c-0e7ef1c07d50" version="2.0"> <xsl:template name="Accumulate2" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate2"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while2" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Var_Conteggio&lt;=count($Start/tns:Find)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Var_Conteggio<=count($Start/tns:Find)]]></bpws:condition>
                        <bpws:flow name="flow3">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStart2ToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Assign5ToAssign8" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="GroupStart2ToAssign7" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Assign7ToAssign8" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Assign8ToMapper2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Mapper2ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign7ToAssign9" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Assign9ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign5ToAssign9" tibex:linkType="SUCCESSWITHNOCONDITION"/>
