            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Consistenza"
                    name="Consistenza_TipoLinea_VariatoY"
                    outputVariable="Consistenza"
                    tibex:xpdlId="d44d0d67-a7b7-47b5-90e9-8d55fe43a26b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Sub_TipoLinea_VariatoYToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Consistenza_TipoLinea_VariatoYToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
