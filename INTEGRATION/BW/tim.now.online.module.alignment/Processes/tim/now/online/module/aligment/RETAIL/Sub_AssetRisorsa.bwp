                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.NOWResponseAllineamentoRetail&quot; xmlns:tns2=&quot;http://www.example.org/tim.now.schema.GetInfo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;GetInfo&quot;/>&lt;xsl:template name=&quot;Consistenza&quot; match=&quot;/&quot;>&lt;tns1:NOWAllineamentoRetailResponse>&lt;tns1:RESPONSE>&lt;tns1:CONSISTENZA>&lt;tns1:CODICE_OLO>&lt;xsl:value-of select=&quot;$Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/codificaOLOAGCOM&quot;/>&lt;/tns1:CODICE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/tipologiaAccesso='FONIA'&quot;>&lt;xsl:if test=&quot;$Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/offerta&quot;>&lt;tns1:SERVIZIO_FONIA>&lt;xsl:value-of select=&quot;$Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/offerta&quot;/>&lt;/tns1:SERVIZIO_FONIA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/offerta=('NP','ULLLINEANONATTIVA','ULLLINEAATTIVA','ULLLINEAATTIVANP','SLULINEANONATTIVA','SLULINEAATTIVANP','SLULINEAATTIVA', 'VULL','VULLLINEANONATTIVA','WLRLINEANONATTIVA','WLRLINEAATTIVA','ULLDATILINEAATTIVANP','ULLDATILINEAATTIVA','ULLDATILINEAATTIVANP')&quot;>&lt;xsl:if test=&quot;$GetInfo/tns2:OFFERTA&quot;>&lt;tns1:SERVIZIO_DATI>&lt;xsl:value-of select=&quot;$GetInfo/tns2:OFFERTA&quot;/>&lt;/tns1:SERVIZIO_DATI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Find/tns:Asset[statoAsset=('ATTIVO','INLAVORAZIONE')]/offerta!=('NP','ULLLINEANONATTIVA','ULLLINEAATTIVA','ULLLINEAATTIVANP','SLULINEANONATTIV