            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="51a28aea-e604-4085-9773-87a318d23ad3">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToAssign4"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:assign name="GroupInit1"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+1ed0484a-404c-444e-9c2d-0227793e4378" version="2.0"> <xsl:template name="Accumulate1" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate1"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Var_Conteggio&lt;=count($Start/tns:Find)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Var_Conteggio<=count($Start/tns:Find)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStart1ToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Consistenza1ToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToMapper1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Mapper1ToAccumulate1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStart1ToAssign2" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Assign2ToAccumulate1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GetInfoBUNDLENPToConsistenzaBUNDLENP" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess5ToAccumulate1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess6ToAccumulate1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcess7ToMapper1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess8ToConteggi1" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="45cc99cd-4472-49b1-9ced-7c4507346940">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Start/tns:Find[number($index)]/tns:Asset/offerta=('BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','SHACONMANODOPERA','SHASENZAMANODOPERA','VULAFTTCAB','VULAFTTH','ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP','ULLDATILINEAATTIVANP','ULLLINEANONATTIVA') and $Start/tns:Find[number($index)]/tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/tns:Find[number($index)]/tns:Asset/offerta=('BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','SHACONMANODOPERA','SHASENZAMANODOPERA','VULAFTTCAB','VULAFTTH','ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP','ULLDATILINEAATTIVANP','ULLLINEANONATTIVA') and $Start/tns:Find[number($index)]/tns:Asset/statoAsset=('ATTIVO','INLAVORAZIONE')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart1ToAssign2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate1"
                                    outputVariable="Accumulate1"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="1ed0484a-404c-444e-9c2d-0227793e4378" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess5ToAccumulate1"/>
                                    <bpws:target linkName="CallProcess6ToAccumulate1"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper1</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Consistenza"
                                    name="ConsistenzaBUNDLENP"
                                    outputVariable="Consistenza"
                                    tibex:xpdlId="b0fa89cb-5c53-4d0b-8f00-7b5fbfe72dec" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GetInfoBUNDLENPToConsistenzaBUNDLENP"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Consistenza1ToAssign1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.NOWResponseAllineamentoRetail&quot; xmlns:tns2=&quot;http://www.example.org/tim.now.schema.GetInfo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;GetInfoBUNDLENP&quot;/>&lt;xsl:template name=&quot;Consistenza&quot; match=&quot;/&quot;>&lt;tns1:NOWAllineamentoRetailResponse>&lt;tns1:RESPONSE>&lt;tns1:CONSISTENZA>&lt;tns1:CODICE_OLO>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/codificaOLOAGCOM&quot;/>&lt;/tns1:CODICE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta=('ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP','ULLDATILINEAATTIVANP','ULLLINEANONATTIVA')&quot;>&lt;xsl:if test=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta&quot;>&lt;tns1:SERVIZIO_FONIA>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta&quot;/>&lt;/tns1:SERVIZIO_FONIA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta=('BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','SHACONMANODOPERA','SHASENZAMANODOPERA','VULAFTTCAB','VULAFTTH')&quot;>&lt;tns1:SERVIZIO_FONIA>&lt;xsl:value-of select=&quot;'NP'&quot;/>&lt;/tns1:SERVIZIO_FONIA>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta=('BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','SHACONMANODOPERA','SHASENZAMANODOPERA','VULAFTTCAB','VULAFTTH')&quot;>&lt;xsl:if test=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta&quot;>&lt;tns1:SERVIZIO_DATI>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta&quot;/>&lt;/tns1:SERVIZIO_DATI>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;tns1:CODE_RICHIESTA_TI>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/codiceOrdineTI&quot;/>&lt;/tns1:CODE_RICHIESTA_TI>&lt;tns1:DATA_ESPLETAMENTO>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/DES&quot;/>&lt;/tns1:DATA_ESPLETAMENTO>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta='ULLLINEANONATTIVA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns:Find[number($index)]/tns:Asset/dettaglioasset[attributidettaglioasset/nomeAttributo='DESTINAZIONEUSO']/attributidettaglioasset[nomeAttributo='DESTINAZIONEUSO']/valoreAttributo,'|') and substring-before($Start/tns:Find[number($index)]/tns:Asset/dettaglioasset[attributidettaglioasset/nomeAttributo='DESTINAZIONEUSO']/attributidettaglioasset[nomeAttributo='DESTINAZIONEUSO']/valoreAttributo, '|')='1'&quot;>&lt;tns1:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;POTS&amp;quot;&quot;/>&lt;/tns1:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($Start/tns:Find[number($index)]/tns:Asset/dettaglioasset[attributidettaglioasset/nomeAttributo='DESTINAZIONEUSO']/attributidettaglioasset[nomeAttributo='DESTINAZIONEUSO']/valoreAttributo,'|') and substring-before($Start/tns:Find[number($index)]/tns:Asset/dettaglioasset[attributidettaglioasset/nomeAttributo='DESTINAZIONEUSO']/attributidettaglioasset[nomeAttributo='DESTINAZIONEUSO']/valoreAttributo, '|')='2'&amp;#xD;&amp;#xA;&quot;>&lt;tns1:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;ISDN BRA&amp;