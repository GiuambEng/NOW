                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.NOWResponseAllineamentoRetail&quot; xmlns:tns2=&quot;http://www.example.org/tim.now.schema.GetInfo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;GetInfoCONDIVISIOLO&quot;/>&lt;xsl:template name=&quot;Consistenza&quot; match=&quot;/&quot;>&lt;tns1:NOWAllineamentoRetailResponse>&lt;tns1:RESPONSE>&lt;tns1:CONSISTENZA>&lt;tns1:CODICE_OLO>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/codificaOLOAGCOM&quot;/>&lt;/tns1:CODICE_OLO>&lt;xsl:if test=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta&quot;>&lt;tns1:SERVIZIO_FONIA>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta&quot;/>&lt;/tns1:SERVIZIO_FONIA>&lt;/xsl:if>&lt;tns1:CODE_RICHIESTA_TI>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/codiceOrdineTI&quot;/>&lt;/tns1:CODE_RICHIESTA_TI>&lt;tns1:DATA_ESPLETAMENTO>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/DES&quot;/>&lt;/tns1:DATA_ESPLETAMENTO>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta=('SLULINEAATTIVA','SLULINEAATTIVANP','ULLLINEAATTIVA','ULLLINEAATTIVANP','VULL','WLRLINEAATTIVA','WLRLINEANONATTIVA','NP','ULLDATILINEAATTIVA','ULLDATILINEAATTIVANP')&quot;>&lt;tns1:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;ISDN+ADSL&amp;quot;&quot;/>&lt;/tns1:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta=('SLULINEANONATTIVA','ULLLINEANONATTIVA','VULLLINEANONATTIVA')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns:Find[number($index)]/tns:Asset/dettaglioasset[attri