(upper-case($Start/tns:Find[number($index)]/tns:Asset/dettaglioasset[attributidettaglioasset/nomeAttributo='TIPOLINEA']/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo),' ', upper-case($Start/tns:Find[number($index)]/tns:Asset/dettaglioasset[attributidettaglioasset/nomeAttributo='STRUTTURALINEA']/attributidettaglioasset[nomeAttributo='STRUTTURALINEA']/valoreAttributo))&quot;/>&lt;/tns1:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Find[number($index)]/tns:Asset/offerta=('BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','SHACONMANODOPERA','SHASENZAMANODOPERA','VULAFTTCAB','VULAFTTH')&quot;>&lt;tns1:TIPO_LINEA>&lt;xsl:value-of select=&quot;upper-case($Start/tns:Find[number($index)]/tns:Asset/dettaglioasset[attributidettaglioasset/nomeAttributo='TIPOLINEA']/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo)&quot;/>&lt;/tns1:TIPO_LINEA>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GetInfoBUNDLENP/tns2:DESCR_PARTICELLA_TOPON)>0&quot;>&lt;xsl:if test=&quot;$GetInfoBUNDLENP/tns2:DESCR_PARTICELLA_TOPON&quot;>&lt;tns1:PART_TOPONOMASTICA_OLO>&lt;xsl:value-of select=&quot;$GetInfoBUNDLENP/tns2:DESCR_PARTICELLA_TOPON&quot;/>&lt;/tns1:PART_TOPONOMASTICA_OLO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns:Find[number($index)]/tns:Asset/descrPartToponomastica&quot;>&lt;tns1:PART_TOPONOMASTICA_OLO>&lt;xsl:value-of select=&quot;$Start/tns:Find[number($index)]/tns:Asset/descrPartToponomastica&quot;/>&lt;/tns1:PART_TOPONOMASTICA_OLO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GetInfoBUNDLENP/tns2:DESCR_VIA)>0&quot;>&lt;xsl:if test=&quot;$GetInfoBUNDLENP/tns2:DESCR_VIA&quot;>&lt;tns1:VIA_OLO>&lt;xsl:value-of select