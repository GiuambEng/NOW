                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.schema.xsd.stagingCheckRisorsaFWA&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWCheckRisorsaFWA/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendCheckRisorsaFWA.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessIstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaRicevuta&quot;/>&#xa;    &lt;xsl:template name=&quot;Insert_Staging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Insert>&#xa;                &lt;tns:ID_RIC_VERIFICA_RIS_FWA>&#xa;                    &lt;xsl:value-of select=&quot;$SendCheckRisorsaFWA.parameters/tns1:Transaction_id&quot;/>&#xa;                &lt;/tns:ID_RIC_VERIFICA_RIS_FWA>&#xa;                &lt;tns:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($SendCheckRisorsaFWA.parameters, true(), true())&quot;/>&#xa;                &lt;/tns:CONTENUTO_REQUEST>&#xa;                &lt;tns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ProcessIstance.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                &lt;/tns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;tns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$RichiestaRicevuta&quot;/>&#xa;                &lt;/tns:ID_STATO_ELAB_STAG>&#xa;                &lt;tns:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                &lt;/tns:OPERATORE>&#xa;                &lt;tns:IDRISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$SendCheckRisorsaFWA.parameters/tns1:IDRI