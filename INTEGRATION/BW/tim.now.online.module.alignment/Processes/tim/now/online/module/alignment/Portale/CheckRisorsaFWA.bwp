IENT&gt;&lt;xsl:value-of select="$GetContext/ns:remoteaddress"/&gt;&lt;/tns1:IP_CLIENT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetLocalIP/tns3:IPAddress"&gt;&lt;tns1:IP_SERVER&gt;&lt;xsl:value-of select="$GetLocalIP/tns3:IPAddress"/&gt;&lt;/tns1:IP_SERVER&gt;&lt;/xsl:if&gt;&lt;tns1:OS_USER&gt;&lt;xsl:value-of select="bw:getSystemProperty(&amp;quot;os.name&amp;quot;)"/&gt;&lt;/tns1:OS_USER&gt;&lt;tns1:SERVER_NAME&gt;&lt;xsl:value-of select="bw:getHostName()"/&gt;&lt;/tns1:SERVER_NAME&gt;&lt;tns1:COD_INTRFC&gt;&lt;xsl:value-of select="'ID382'"/&gt;&lt;/tns1:COD_INTRFC&gt;&lt;tns1:SESSION_ID&gt;&lt;xsl:value-of select="$_processContext/JobId"/&gt;&lt;/tns1:SESSION_ID&gt;&lt;tns1:TIPO_OPERAZIONE&gt;&lt;xsl:value-of select="&amp;quot;LOGIN&amp;quot;"/&gt;&lt;/tns1:TIPO_OPERAZIONE&gt;&lt;tns1:SISTEMA_CHIAMANTE&gt;&lt;xsl:value-of select="'PORTALE'"/&gt;&lt;/tns1:SISTEMA_CHIAMANTE&gt;&lt;xsl:if test="$ProcessIstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;tns1:ID_ESE_PROC_NO_FILE&gt;&lt;xsl:value-of select="$ProcessIstance/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/tns1:ID_ESE_PROC_NO_FILE&gt;&lt;/xsl:if&gt;&lt;tns1:NOME_TAB_STAGING&gt;&lt;xsl:value-of select="&amp;quot;AN_VERIFICA_RIS_FWA_NOFILE&amp;quot;"/&gt;&lt;/tns1:NOME_TAB_STAGING&gt;&lt;/tns1:InputDataUserLog&gt;&lt;/tns1:LoggerSecurityInput&gt;&lt;/parameters&gt;&lt;/tns:NewOperationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
