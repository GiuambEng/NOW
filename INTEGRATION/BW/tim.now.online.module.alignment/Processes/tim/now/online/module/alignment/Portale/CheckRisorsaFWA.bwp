                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+dcf57c01-b93c-4df8-9f7b-9bcf9f33f264+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWCheckRisorsaFWA/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Query&quot;/>&lt;xsl:template name=&quot;CheckRisorsaFWA-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;SqlStatement>&lt;xsl:value-of select=&quot;$Query&quot;/>&lt;/SqlStatement>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    overrideSQLSTMT="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT&#xd;&#xa;&#x9;dett.NOMECOMPONENTE,&#xd;&#xa;&#x9;att.VALOREATTRIBUTO,&#xd;&#xa;&#x9;att.IDASSET,&#xd;&#xa;&#x9;ass.CODIFICAOLOAGCOM&#xd;&#xa;FROM&#xd;&#xa;&#x9;APPUSER.BDS_1_CASEDATA_DETTAGLIOASSET dett,&#xd;&#xa;&#x9;APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST att ,&#xd;&#xa;&#x9;APPUSER.bds_1_casedata_asset ass"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWCheckRisorsaFWA/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SendCheckRisorsaFWA&quot;/>&lt;xsl:param name=&quot;CheckRisorsaFWA&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$SendCheckRisorsaFWA/parameters/tns:NOWCheckRisorsaFWA_Input/tns:CODE_OPERATORE != $CheckRisorsaFWA/Record[1]/CODIFICAOLOAGCOM&quot;>&lt;tns:NOWCheckRisorsaFWA_Output>&lt;tns:Transaction_id>&lt;xsl:value-of select=&quot;$SendCheckRisorsaFWA/parameters/tns:NOWCheckRisorsaFWA_Input/tns:Transaction_id&quot;/>&lt;/tns:Transaction_id>&lt;tns:Response_date>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]-[M01]-[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/tns:Response_date>&lt;tns:Return_code>&lt;xsl:value-of select=&quot;&amp;quot;XX&amp;quot;&quot;/>&lt;/tns:Return_code>&lt;tns:Desc_err>&lt;xsl:value-of select=&quot;&amp;quot;Risorsa trovata ma con OLO differente&amp;quot;&quot;/>&lt;/tns:Desc_err>&lt;/tns:NOWCheckRisorsaFWA_Output>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NOWCheckRisorsaFWA_Output>&lt;tns:Transaction_id>&lt;xsl:value-of select=&quot;$SendCheckRisorsaFWA/parameters/tns:NOWCheckRisorsaFWA_Input/tns:Transaction_id&quot;/>&lt;/tns:Transaction_id>&lt;tns:Response_date>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]-[M01]-[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/tns:Response_date>&lt;xsl:if test=&quot;$CheckRisorsaFWA/Record[1]/VALOREATTRIBUTO&quot;>&lt;tns:Msisdn>&lt;xsl:value-of select=&quot;$CheckRisorsaFWA/Record[1]/VALOREATTRIBUTO&quot;/>&lt;/tns:Msisdn>&lt;/xsl:if>&lt;tns:Return_code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Return_code>&lt;/tns:NOWCheckRisorsaFWA_Output>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Response"
                                    name="Response_OK"
                                    outputVariable="Response"
                                    tibex:xpdlId="2d588f2a-4a17-4a54-82b3-bac66d5e1fac" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
