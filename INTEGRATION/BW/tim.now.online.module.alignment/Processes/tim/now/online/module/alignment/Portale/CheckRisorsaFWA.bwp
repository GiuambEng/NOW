                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.schema.xsd.stagingCheckRisorsaFWA&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWCheckRisorsaFWA/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SendCheckRisorsaFWA&quot;/>&lt;xsl:param name=&quot;ProcessIstance&quot;/>&lt;xsl:param name=&quot;RichiestaRicevuta&quot;/>&lt;xsl:template name=&quot;Insert_Staging-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Insert>&lt;tns:ID_RIC_VERIFICA_RIS_FWA>&lt;xsl:value-of select=&quot;$SendCheckRisorsaFWA/parameters/tns1:NOWCheckRisorsaFWA_Input/tns1:Transaction_id&quot;/>&lt;/tns:ID_RIC_VERIFICA_RIS_FWA>&lt;tns:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($SendCheckRisorsaFWA/parameters/tns1:NOWCheckRisorsaFWA_Input, true(), true())&quot;/>&lt;/tns:CONTENUTO_REQUEST>&lt;tns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;$ProcessIstance/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE&quot;/>&lt;/tns:ID_ESEC_PROCSO_NO_FILE>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$RichiestaRicevuta&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/tns:OPERATORE>&lt;tns:IDRISORSA>&lt;xsl:value-of select=&quot;$SendCheckRisorsaFWA/parameters/tns1:NOWCheckRisorsaFWA_Input/tns1:IDRISORSA&quot;/>&lt;/tns:IDRISORSA>&lt;tns:CODIFICAOLOAGCOM>&lt;xsl:value-of select=&quot;$SendCheckRisorsaFWA/parameters/tns1:NOWCheckRisorsaFWA_Input/tns1:CODE_OPERATORE&quot;/>&lt;/tns:CODIFICAOLOAGCOM>&lt;/tns:Insert>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
