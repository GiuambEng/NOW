                                    expression="concat(&quot;SELECT dett.NOMECOMPONENTE, att.VALOREATTRIBUTO, att.IDASSET, ass.CODIFICAOLOAGCOM FROM APPUSER.BDS_1_CASEDATA_DETTAGLIOASSET dett, APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST att , APPUSER.bds_1_casedata_asset ass where att.DTTGLSST_TTRBTIDTTGLISST_BDSID=dett.BDS_ID and dett.asset_dettaglioasset_bdsid=ass.bds_id and ass.IDRISORSA = '&quot;, $SendCheckRisorsaFWA.parameters/tns:IDRISORSA ,&quot;' and ass.OFFERTA = 'FIXEDWIRELESSACCESS' AND att.NOMEATTRIBUTO= 'MSISDN' and dett.NOMECOMPONENTE= 'ACCESSOFWA'&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
