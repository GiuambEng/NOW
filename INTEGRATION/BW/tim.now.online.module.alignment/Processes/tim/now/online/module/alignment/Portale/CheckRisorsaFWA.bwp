                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWCheckRisorsaFWA/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendCheckRisorsaFWA.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckRisorsaFWA&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$SendCheckRisorsaFWA.parameters/tns:CODE_OPERATORE != $CheckRisorsaFWA/Record[1]/CODIFICAOLOAGCOM&quot;>&#xa;                &lt;tns:NOWCheckRisorsaFWA_Output>&#xa;                    &lt;tns:Transaction_id>&#xa;                        &lt;xsl:value-of select=&quot;$SendCheckRisorsaFWA.parameters/tns:Transaction_id&quot;/>&#xa;                    &lt;/tns:Transaction_id>&#xa;                    &lt;tns:Response_date>&#xa;                        &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]-[M01]-[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                    &lt;/tns:Response_date>&#xa;                    &lt;tns:Return_code>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;XX&amp;quot;&quot;/>&#xa;                    &lt;/tns:Return_code>&#xa;                    &lt;tns:Desc_err>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Risorsa trovata ma con OLO differente&amp;quot;&quot;/>&#xa;                    &lt;/tns:Desc_err>&#xa;                &lt;/tns:NOWCheckRisorsaFWA_Output>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:NOWCheckRisorsaFWA_Output>&#xa;                    &lt;tns:Transaction_id>&#xa;                        &lt;xsl:value-of select=&quot;$SendCheckRisorsaFWA.parameters/tns:Transaction_id&quot;/>&#xa;                    &lt;/tns:Transaction_id>&#xa;                    &lt;tns:Response_date>&#xa;                        &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]-[M01]-[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                    &lt;/tns:Response_date>&#xa;                    &lt;xsl:if test=&quot;$CheckRisorsaFWA/Record[1]/VALOREATTRIBUTO&quot;>&#xa;                        &lt;tns:Msisdn>&#xa;                            &lt;xsl:value-of select=&quot;$CheckRisorsaFWA/Record[1]/VALOREATTRIBUTO&quot;/>&#xa;                        &lt;/tns:Msisdn>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:Return_code>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/tns:Return_code>&#xa;                &lt;/tns:NOWCheckRisorsaFWA_Output>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
