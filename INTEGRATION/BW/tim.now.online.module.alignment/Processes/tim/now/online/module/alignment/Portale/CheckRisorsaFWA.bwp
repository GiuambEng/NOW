                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($CheckRisorsaFWA/Record)>0 " expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
