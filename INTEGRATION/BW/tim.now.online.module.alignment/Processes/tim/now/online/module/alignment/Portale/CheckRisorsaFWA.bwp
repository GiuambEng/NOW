    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="b7dcfccd-31f9-4337-a25e-568d6b38a1c3">
                <bpws:scope name="scope2">
                    <bpws:flow name="flow2">
