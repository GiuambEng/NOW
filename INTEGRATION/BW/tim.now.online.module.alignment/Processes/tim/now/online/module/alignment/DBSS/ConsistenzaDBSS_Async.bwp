                       &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                                                &lt;/statoDettaglioAsset>&#xa;                                                &lt;progressivo>&#xa;                                                    &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                                &lt;/progressivo>&#xa;                                            &lt;/dettaglioasset>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/DESPrimoOrdine&quot;>&#xa;                                    &lt;DESPrimoOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/DESPrimoOrdine&quot;/>&#xa;                                    &lt;/DESPrimoOrdine>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/CAP&quot;>&#xa;                                    &lt;CAP>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/CAP&quot;/>&#xa;                                    &lt;/CAP>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;codiceISTATComune>&#xa;                                    &lt;xsl:value-of select=&quot;concat($JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Provincia,$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Comune)&quot;/>&#xa;                                &lt;/codiceISTATComune>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Provincia&quot;>&#xa;                                    &lt;codiceISTATProvincia>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Provincia&quot;/>&#xa;                                    &lt;/codiceISTATProvincia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($CodiceToponomastica)>0&quot;>&#xa;                                        &lt;codiceToponomastica>&#xa;                                            &lt;xsl:value-of select=&quot;$CodiceToponomastica&quot;/>&#xa;                                        &lt;/codiceToponomastica>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/codiceToponomastica&quot;>&#xa;                                            &lt;codiceToponomastica>&#xa;                                                &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/codiceToponomastica&quot;/>&#xa;                                            &lt;/codiceToponomastica>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/comune&quot;>&#xa;                                    &lt;comune>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/comune&quot;/>&#xa;                                    &lt;/comune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Particella_Toponomastica&quot;>&#xa;                                    &lt;descrPartToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Particella_Toponomastica&quot;/>&#xa;                                    &lt;/descrPartToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Indirizzo&quot;>&#xa;                                    &lt;descrizioneVia>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Indirizzo&quot;/>&#xa;                                    &lt;/descrizioneVia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Localita&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Localita&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Civico&quot;>&#xa;                                    &lt;numeroCivico>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Civico&quot;/>&#xa;                                    &lt;/numeroCivico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/provincia&quot;>&#xa;                                    &lt;provincia>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/provincia&quot;/>&#xa;                                    &lt;/provincia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/siglaProvincia&quot;>&#xa;                                    &lt;siglaProvincia>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/siglaProvincia&quot;/>&#xa;                                    &lt;/siglaProvincia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;$Distretto&quot;/>&#xa;                                &lt;/distretto>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/CLLI&quot;>&#xa;                                    &lt;CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/CLLI&quot;/>&#xa;                                    &lt;/CLLI>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;CRMOrigine>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:Sistema_Competenza&quot;/>&#xa;                                &lt;/CRMOrigine>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/codiceSLAAssurance&quot;>&#xa;                                    &lt;codiceSLAAssurance>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/codiceSLAAssurance&quot;/>&#xa;                                    &lt;/codiceSLAAssurance>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;IDRisorsaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/IDRisorsaNOW&quot;/>&#xa;                                &lt;/IDRisorsaNOW>&#xa;                                &lt;IDOfferta>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($AttributoOfferta/tns2:ID_OFFERTA)&quot;/>&#xa;                                &lt;/IDOfferta>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Indirizzo_non_certificato&quot;>&#xa;                                    &lt;indirizzoEstesoNonCert>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Indirizzo_non_certificato&quot;/>&#xa;                                    &lt;/indirizzoEstesoNonCert>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/numeroFittizio&quot;>&#xa;                                    &lt;numeroFittizio>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/numeroFittizio&quot;/>&#xa;                                    &lt;/numeroFittizio>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;CRMEstrattore>&#xa;                                    &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                                &lt;/CRMEstrattore>&#xa;                                &lt;cliente>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/cliente/IDAsset&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/cliente/created&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/cliente/lastUpdate&quot;>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/cliente/lastUpdate&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/cliente/codiceFiscale&quot;>&#xa;                                        &lt;codiceFiscale>&#xa;                                            &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/cliente/codiceFiscale&quot;/>&#xa;                                        &lt;/codiceFiscale>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/cliente/cognomeRagioneSociale&quot;>&#xa;                                        &lt;cognomeRagioneSociale>&#xa;                                            &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/cliente/cognomeRagioneSociale&quot;/>&#xa;                                        &lt;/cognomeRagioneSociale>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/cliente/nome&quot;>&#xa;                                        &lt;nome>&#xa;                                            &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/cliente/nome&quot;/>&#xa;                                        &lt;/nome>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/cliente/partitaIVA&quot;>&#xa;                                        &lt;partitaIVA>&#xa;                                            &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/cliente/partitaIVA&quot;/>&#xa;                                        &lt;/partitaIVA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/cliente>&#xa;                            &lt;/tns:Asset>&#xa;                        &lt;/tns:Input>&#xa;                    &lt;/tns:Update>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
