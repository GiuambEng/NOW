                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:tns2=&quot;http://www.example.org/CheckJMSBodyDBSS&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindID_VULA_WXX.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FindID_VULAFTTH.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloAsset&quot;/>&#xa;    &lt;xsl:param name=&quot;AssetWxx&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateAsset&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Update>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$AssetWxx='True' and $ControlloAsset='True' &quot;>&#xa;                        &lt;tns:Input>&#xa;                            &lt;tns:CaseReference>&#xa;                                &lt;xsl:value-of select=&quot;$FindID_VULA_WXX.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC']/tns:CaseReference&quot;/>&#xa;                            &lt;/tns:CaseReference>&#xa;                            &lt;tns:Asset>&#xa;                                &lt;xsl:if test=&quot;$FindID_VULA_WXX.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC']/tns:Asset/IDAsset&quot;>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID_VULA_WXX.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC']/tns:Asset/IDAsset&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;codiceOrdineOLO>&#xa;                                    &lt;xsl:value-of select=&quot;$FindID_VULA_WXX.part1/tns:Find[tns:Asset/s