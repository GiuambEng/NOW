;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDRichiestaOLO&quot;>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDPrimoOrdine&quot;>&#xa;                                    &lt;IDPrimoOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDPrimoOrdine&quot;/>&#xa;                                    &lt;/IDPrimoOrdine>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;IDContratto>&#xa;                                    &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDContratto&quot;/>&#xa;                                &lt;/IDContratto>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/DEC&quot;>&#xa;                                    &lt;DEC>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/DEC&quot;/>&#xa;                                    &lt;/DEC>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;statoAsset>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Stato_Asset&quot;/>&#xa;                                &lt;/statoAsset>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                                &lt;numeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_Telefonico&quot;/>&#xa;                                &lt;/numeroTelefonico>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDAssetCRMWS&quot;>&#xa;                                    &lt;IDAssetCRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDAssetCRMWS&quot;/>&#xa;                                    &lt;/IDAssetCRMWS>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDAssetDa&quot;>&#xa;                                    &lt;IDAssetDa>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsse