                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="UpdateAsset"
                    name="CreateRecord" outputVariable="UpdateAsset"
                    tibex:xpdlId="06ec7f7c-7eea-4716-b26c-8d6f5a305847" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToCreateRecord"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CreateRecordToCreateAsset"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/tim.now.xsd.ValorizzazioneAttributoOfferta&quot; xmlns:tns3=&quot;http://www.example.org/CheckJMSBodyDBSS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AttributoOfferta&quot;/>&lt;xsl:param name=&quot;CodiceToponomastica&quot;/>&lt;xsl:param name=&quot;Check_IdContratto&quot;/>&lt;xsl:param name=&quot;CheckCLLI&quot;/>&lt;xsl:param name=&quot;Distretto&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;ID_ASSET&quot;/>&lt;xsl:param name=&quot;CheckCOD_FISCALE_PIVA&quot;/>&lt;xsl:template name=&quot;UpdateAsset&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Update>&lt;tns:Input>&lt;tns:CaseReference>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CaseReference>&lt;tns:Asset>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;'MIG-'&quot;/>&lt;/codiceOrdineOLO>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/codificaOLOAGCOM>&lt;invariante>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/invariante>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string($Check_IdContratto/Record[1]/ID_CONTRATTO))>0&quot;>&lt;IDContratto>&lt;xsl:value-of select=&quot;xsd:int($Check_IdContratto/Record[1]/ID_CONTRATTO)&quot;/>&lt;/IDContratto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDContratto>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDContratto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;statoAsset>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Stato_Asset&quot;/>&lt;/statoAsset>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:ID_Risorsa&quot;/>&lt;/IDRisorsa>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_Telefonico&quot;/>&lt;/numeroTelefonico>&lt;DES>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Data_dec&quot;/>&lt;/DES>&lt;ORA_DES>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Ora_dec&quot;/>&lt;/ORA_DES>&lt;tipologiaAccesso>&lt;xsl:value-of select=&quot;if($AttributoOfferta/tns2:NOME_OFFERTA=('ULLLINEANONATTIVA','SLULINEANONATTIVA'))then 'FONIA' else 'DATI'&quot;/>&lt;/tipologiaAccesso>&lt;offerta>&lt;xsl:value-of select=&quot;$AttributoOfferta/tns2:NOME_OFFERTA&quot;/>&lt;/offerta>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Complesso&quot;>&lt;complesso>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Complesso&quot;/>&lt;/complesso>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Interno&quot;>&lt;interno>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Interno&quot;/>&lt;/interno>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Piano&quot;>&lt;piano>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Piano&quot;/>&lt;/piano>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Scala&quot;>&lt;scala>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Scala&quot;/>&lt;/scala>&lt;/xsl:if>&lt;dettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;xsd:int($ID_ASSET)&quot;/>&lt;/IDAsset>&lt;integrationID>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:ID_Risorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;$AttributoOfferta/tns2:NOME_COMPONENTE&quot;/>&lt;/nomeComponente>&lt;xsl:choose>&lt;xsl:when test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_nativo_olo='Y'&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;xsd:int($ID_ASSET)&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'NUMERONATIVOOLO'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_Telefonico&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;($AttributoOfferta/tns2:NOME_OFFERTA=('ULLLINEANONATTIVA','SLULINEANONATTIVA')) and (string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso)>0 or string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati)>0)&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;xsd:int($ID_ASSET)&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;