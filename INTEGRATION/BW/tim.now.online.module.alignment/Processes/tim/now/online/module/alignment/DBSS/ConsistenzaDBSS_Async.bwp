                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8728822e-48d0-4bda-8c82-1bb8399d3dda+input&quot; xmlns:ns4=&quot;http://www.example.org/tim.now.xsd.NOWConsistenzaDBSS&quot; xmlns:tns1=&quot;http://www.example.org/CheckJMSBodyDBSS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;CheckCodTopon-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;codice_toponomastica>&lt;xsl:value-of select=&quot;concat($JMSReceiveMessage/Body/tns1:Input/tns1:SEDE/tns1:Codice_Provincia,'_',$JMSReceiveMessage/Body/tns1:Input/tns1:SEDE/tns1:Codice_Comune,'_',$JMSReceiveMessage/Body/tns1:Input/tns1:SEDE/tns1:Codice_Via,'_',$JMSReceiveMessage/Body/tns1:Input/tns1:SEDE/tns1:Civico)&quot;/>&lt;/codice_toponomastica>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
