                    <bpws:sources>
                        <bpws:source linkName="CreateRecord_NoTLCToCreateAsset"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/tim.now.xsd.ValorizzazioneAttributoOfferta&quot; xmlns:tns3=&quot;http://www.example.org/CheckJMSBodyDBSS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CodiceToponomastica&quot;/>&lt;xsl:param name=&quot;Distretto&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;ID_ASSET&quot;/>&lt;xsl:param name=&quot;Attr_Offerta&quot;/>&lt;xsl:param name=&quot;Check_IdContra&quot;/>&lt;xsl:param name=&quot;CLLI&quot;/>&lt;xsl:param name=&quot;CheckCOD_FISCALE_PIVA&quot;/>&lt;xsl:template name=&quot;UpdateAsset&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Update>&lt;tns:Input>&lt;tns:CaseReference>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CaseReference>&lt;tns:Asset>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;&amp;quot;MIG-&amp;quot;&quot;/>&lt;/codiceOrdineOLO>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/codificaOLOAGCOM>&lt;invariante>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/invariante>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string($Check_IdContra/Record[1]/ID_CONTRATTO))>0&quot;>&lt;IDContratto>&lt;xsl:value-of select=&quot;xsd:int($Check_IdContra/Record[1]/ID_CONTRATTO)&quot;/>&lt;/IDContratto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDContratto>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDContratto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;statoAsset>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Stato_Asset&quot;/>&lt;/statoAsset>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:ID_Risorsa&quot;/>&lt;/IDRisorsa>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_Telefonico&quot;/>&lt;/numeroTelefonico>&lt;DES>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Data_dec&quot;/>&lt;/DES>&lt;ORA_DES>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Ora_dec&quot;/>&lt;/ORA_DES>&lt;tipologiaAccesso>&lt;xsl:value-of select=&quot;if($Attr_Offerta/tns2:NOME_OFFERTA=('ULLLINEANONATTIVA','SLULINEANONATTIVA'))then 'FONIA' else 'DATI'&quot;/>&lt;/tipologiaAccesso>&lt;offerta>&lt;xsl:value-of select=&quot;$Attr_Offerta/tns2:NOME_OFFERTA&quot;/>&lt;/offerta>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Complesso&quot;>&lt;complesso>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Complesso&quot;/>&lt;/complesso>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Interno&quot;>&lt;interno>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Interno&quot;/>&lt;/interno>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Piano&quot;>&lt;piano>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Piano&quot;/>&lt;/piano>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Scala&quot;>&lt;scala>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Scala&quot;/>&lt;/scala>&lt;/xsl:if>&lt;dettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;xsd:int($ID_ASSET)&quot;/>&lt;/IDAsset>&lt;integrationID>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:ID_Risorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;$Attr_Offerta/tns2:NOME_COMPONENTE&quot;/>&lt;/nomeComponente>&lt;xsl:choose>&lt;xsl:when test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_nativo_olo='Y'&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;xsd:int($ID_ASSET)&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;NUMERONATIVOOLO&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_Telefonico&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Flag_FTTH='Y'&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;xsd:int($ID_ASSET)&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'TIPOLINEA'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;'LineaNonFonia'&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Attr_Offerta/tns2:NOME_OFFERTA=('ULLLINEANONATTIVA','SLULINEANONATTIVA')  and string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati)>0&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;xsd:int($ID_ASSET)&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;DESTINAZIONEUSO&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati='4'and $Attr_Offerta/tns2:NOME_OFFERTA='SLULINEANONATTIVA' &quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;'10'&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;/xsl:when>&lt;/xsl:choose>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDRisorsaNOW>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioAsset>&lt;statoDettaglioAsset>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Stato_Asset&quot;/>&lt;/statoDettaglioAsset>&lt;progressivo>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/progressivo>&lt;/dettaglioasset>&lt;DESPrimoOrdine>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Data_dec&quot;/>&lt;/DESPrimoOrdine>&lt;codiceISTATComune>&lt;xsl:value-of select=&quot;concat($JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Provincia, $JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Comune)&quot;/>&lt;/codiceISTATComune>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Provincia&quot;>&lt;codiceISTATProvincia>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Provincia&quot;/>&lt;/codiceISTATProvincia>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CodiceToponomastica)>0 &quot;>&lt;codiceToponomastica>&lt;xsl:value-of select=&quot;$CodiceToponomastica&quot;/>&lt;/codiceToponomastica>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Particella_Toponomastica&quot;>&lt;descrPartToponomastica>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Particella_Toponomastica&quot;/>&lt;/descrPartToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Indirizzo&quot;>&lt;descrizioneVia>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Indirizzo&quot;/>&lt;/descrizioneVia>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Localita&quot;>&lt;localita>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Localita&quot;/>&lt;/localita>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Civico&quot;>&lt;numeroCivico>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Civico&quot;/>&lt;/numeroCivico>&lt;/xsl:if>&lt;distretto>&lt;xsl:value-of select=&quot;$Distretto&quot;/>&lt;/distretto>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CLLI/Record[1]/CLLI)>1&quot;/>&lt;xsl:when test=&quot;string-length($CLLI/Record[1]/CLLI)>0 and string-length($CodiceToponomastica)>0 &quot;>&lt;xsl:if test=&quot;$CLLI/Record[1]/CLLI&quot;>&lt;CLLI>&lt;xsl:value-of select=&quot;$CLLI/Record[1]/CLLI&quot;/>&lt;/CLLI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;CRMOrigine>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:Sistema_Competenza&quot;/>&lt;/CRMOrigine>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:ID_Risorsa&quot;/>&lt;/IDRisorsaNOW>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Attr_Offerta/tns2:ID_OFFERTA))&quot;/>&lt;/IDOfferta>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Indirizzo_non_certificato&quot;>&lt;indirizzoEstesoNonCert>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Indirizzo_non_certificato&quot;/>&lt;/indirizzoEstesoNonCert>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:ID_Risorsa, ' ')&quot;>&lt;numeroFittizio>&lt;xsl:value-of select=&quot;substring-before($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:ID_Risorsa,' ')&quot;/>&lt;/numeroFittizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;numeroFittizio>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:ID_Risorsa&quot;/>&lt;/numeroFittizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CRMEstrattore>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/CRMEstrattore>&lt;cliente>&lt;IDAsset>&lt;xsl:value-of select=&quot;xsd:int($ID_ASSET)&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($CheckCOD_FISCALE_PIVA, 'NaN') and string-length($JMSReceiveMessage/Body/tns3:Input/tns3:CLIENTE/tns3:CF_PIVA)>0&quot;>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:CLIENTE/tns3:CF_PIVA&quot;>&lt;codiceFiscale>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:CLIENTE/tns3:CF_PIVA&quot;/>&lt;/codiceFiscale>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;cognomeRagioneSociale>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:CLIENTE/tns3:CognomeRagioneSociale&quot;/>&lt;/cognomeRagioneSociale>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:CLIENTE/tns3:Nome&quot;>&lt;nome>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:CLIENTE/tns3:Nome&quot;/>&lt;/nome>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;not(contains($CheckCOD_FISCALE_PIVA, 'NaN')) and string-length($JMSReceiveMessage/Body/tns3:Input/tns3:CLIENTE/tns3:CF_PIVA)>0&quot;>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:CLIENTE/tns3:CF_PIVA&quot;>&lt;partitaIVA>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:CLIENTE/tns3:CF_PIVA&quot;/>&lt;/partitaIVA>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/cliente>&lt;/tns:Asset>&lt;/tns:Input>&lt;/tns:Update>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="UpdateAsset" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Attr_Offerta-input"
                    name="Attr_Offerta" outputVariable="Attr_Offerta"
                    tibex:xpdlId="4b63b34f-3636-47f7-bc72-f347b5ea22cf"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty7ToAttr_Offerta"/>
                        <bpws:target linkName="RisorsaPesenteTLCToAttr_Offerta"/>
                        <bpws:target linkName="Empty2ToAttr_Offerta"/>
                        <bpws:target linkName="CallProcess2ToAttr_Offerta"/>
                        <bpws:target linkName="AssignToAttr_Offerta"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Attr_OffertaToControl_Distretto"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.xsd.NOWConsistenzaDBSS&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.xsd.ValorizzazioneAttributoOfferta&quot; xmlns:tns2=&quot;http://www.example.org/CheckJMSBodyDBSS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;AttributoOfferta-input&quot; match=&quot;/&quot;>&lt;tns1:TrascodificaOfferta_Input>&lt;tns1:FLAG_FTTH>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns2:Input/tns2:ACCESSO/tns2:Flag_FTTH&quot;/>&lt;/tns1:FLAG_FTTH>&lt;tns1:PROVENIENZA>&lt;xsl:value-of select=&quot;'RETAIL'&quot;/>&lt;/tns1:PROVENIENZA>&lt;tns1:ID_RISORSA>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns2:Input/tns2:ACCESSO/tns2:ID_Risorsa&quot;/>&lt;/tns1:ID_RISORSA>&lt;/tns1:TrascodificaOfferta_Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.online.module.alignment.DBSS.Sub_ValorizzazioneAttributoOfferta" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Distretto"
                    name="Control_Distretto" outputVariable="Distretto"
                    tibex:xpdlId="e7f8584e-55d7-4fac-8427-ae859a882833" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Attr_OffertaToControl_Distretto"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Control_DistrettoToCodTopon"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (string-length($JMSReceiveMessage/Body/tns1:Input/tns1:ACCESSO/tns1:Distretto_Telefonico)=2) then tib:pad-front($JMSReceiveMessage/Body/tns1:Input/tns1:ACCESSO/tns1:Distretto_Telefonico, 3, '0') else if (string-length($JMSReceiveMessage/Body/tns1:Input/tns1:ACCESSO/tns1:Distretto_Telefonico)=3 )then $JMSReceiveMessage/Body/tns1:Input/tns1:ACCESSO/tns1:Distretto_Telefonico else substring($JMSReceiveMessage/Body/tns1:Input/tns1:ACCESSO/tns1:Distretto_Telefonico,2,3)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Distretto" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="CodTopon-input"
                    name="CodTopon" outputVariable="CodTopon"
                    tibex:xpdlId="955804ce-4f4a-44d7-b95d-6a9e66f49fdb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess5ToCodTopon"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CodToponToCodToponomastica">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$CodTopon/Record[1]/COUNTCODTOPON>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$CodTopon/Record[1]/COUNTCODTOPON>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CodToponToCLLI">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
