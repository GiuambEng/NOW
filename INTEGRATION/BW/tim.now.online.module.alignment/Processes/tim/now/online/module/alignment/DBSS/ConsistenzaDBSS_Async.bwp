                               &lt;/xsl:if>&#xa;                                &lt;IDRisorsaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDRisorsaNOW&quot;/>&#xa;                                &lt;/IDRisorsaNOW>&#xa;                                &lt;IDOfferta>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($AttributoOfferta/tns2:ID_OFFERTA)&quot;/>&#xa;                                &lt;/IDOfferta>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Indirizzo_non_certificato&quot;>&#xa;                                    &lt;indirizzoEstesoNonCert>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Indirizzo_non_certificato&quot;/>&#xa;                                    &lt;/indirizzoEstesoNonCert>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/numeroFittizio&quot;>&#xa;                                    &lt;numeroFittizio>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/numeroFittizio&quot;/>&#xa;                                    &lt;/numeroFittizio>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;CRMEstrattore>&#xa;                                    &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                                &lt;/CRMEstrattore>&#xa;                                &lt;cliente>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns