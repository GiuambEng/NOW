                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:tns3=&quot;http://www.example.org/CheckJMSBodyDBSS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogNameApplication&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:param name=&quot;FindID&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;ControlloAsset&quot;/>&lt;xsl:template name=&quot;LogScarto-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LogNameApplication&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'ConsistenzaDBSS_Async'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'ConsistenzaDBSS_Async'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'ConsistenzaDBSS_Async'&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;$ControlloAsset='True'&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('***Asset non aggionato - Data_dec   ',  string($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Data_dec), '  &amp;lt; = DES  ', string($FindID/part1/tns2:Output/tns2:Find[tns2:Asset/statoAsset='ATTIVO' and tns2:Asset/codificaOLOAGCOM='TLC'][1]/tns2:Asset/DES))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:when test=&quot;count($FindID/part1/tns2:Output/tns2:Find)>1 and ((not(exists($FindID/part1/tns2:Output/tns2:Find[tns2:Asset/codificaOLOAGCOM!='TLC']))) or (count($FindID/part1/tns2:Output/tns2:Find[tns2:Asset/statoAsset='ATTIVO' and tns2:Asset/codificaOLOAGCOM='TLC'])>1))&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;'***Presenti piu Asset tutti TLC'&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Stato_Asset)='ATTIVO' and starts-with($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:ID_Risorsa,'U6')&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('***Asset non aggionato - ID RISORSA:   ', $JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:ID_Risorsa )&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('***Asset non aggionato - Data_dec   ',  string($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Data_dec), '  &amp;lt; = DES  ', string($FindID/part1/tns2:Output/tns2:Find[1]/tns2:Asset/DES))&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogScarto-input" name="LogScarto"
                    tibex:xpdlId="103dfc69-0524-46fb-ac7a-b8a2939396db"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToLogScarto"/>
                        <bpws:target linkName="RisorsaU6ToLogScarto_RisorsaU6attivo"/>
                        <bpws:target linkName="CompareDateAssetMultipliToLogScarto"/>
                        <bpws:target linkName="Empty5ToLogScarto_AssetAttiviTLC"/>
                        <bpws:target linkName="Empty6ToLogScarto_AssetAttiviTLC"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogScartoToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:tns3=&quot;http://www.example.org/CheckJMSBodyDBSS&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogNameApplication&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;LogScarto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$LogNameApplication&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'ConsistenzaDBSS_Async'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'ConsistenzaDBSS_Async'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ConsistenzaDBSS_Async'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ControlloAsset='True'&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('***Asset non aggionato - Data_dec   ',  string($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Data_dec), '  &amp;lt; = DES  ', string($FindID.part1/tns2:Find[tns2:Asset/statoAsset='ATTIVO' and tns2:Asset/codificaOLOAGCOM='TLC'][1]/tns2:Asset/DES))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($FindID.part1/tns2:Find)>1 and ((not(exists($FindID.part1/tns2:Find[tns2:Asset/codificaOLOAGCOM!='TLC']))) or (count($FindID.part1/tns2:Find[tns2:Asset/statoAsset='ATTIVO' and tns2:Asset/codificaOLOAGCOM='TLC'])>1))&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;'***Presenti piu Asset tutti TLC'&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Stato_Asset)='ATTIVO' and starts-with($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:ID_Risorsa,'U6')&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('***Asset non aggionato - ID RISORSA:   ', $JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:ID_Risorsa )&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('***Asset non aggionato - Data_dec   ',  string($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Data_dec), '  &amp;lt; = DES  ', string($FindID.part1/tns2:Find[1]/tns2:Asset/DES))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="tib:compare-date($JMSReceiveMessage/Body/tns1:Input/tns1:ACCESSO/tns1:Data_dec, $FindID/part1/tns:Output/tns:Find[1]/tns:Asset/DES)"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="CompareDES" name="CompareDate"
                    outputVariable="CompareDES"
                    tibex:xpdlId="4020f6dd-9e6b-4af8-8f10-288ff262c83c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
