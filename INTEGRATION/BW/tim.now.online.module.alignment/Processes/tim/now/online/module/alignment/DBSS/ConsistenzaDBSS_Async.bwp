                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindID_VULA_WXX.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FindID_VULAFTTH.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogNameApplication&quot;/>&#xa;    &lt;xsl:param name=&quot;LogInfoLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;AssetWxx&quot;/>&#xa;    &lt;xsl:template name=&quot;LogScartoVULA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$LogNameApplication&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'ConsistenzaDBSS_Async'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'ConsistenzaDBSS_Async'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ConsistenzaDBSS_Async'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$AssetWxx='True' and not(exists($FindID_VULA_WXX.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO'])) and not(exists($FindID_VULA_WXX.part1/tns1:Find[tns1:Asset/statoAsset='INLAVORAZIONE']))&quot;>&#xa;                        &lt;tns:MsgCode>&#xa;                            &lt;xsl:value-of select=&quot;'***Presenti piu Asset tutti TLC Cessati con input Cessato'&quot;/>&#xa;                        &lt;/tns:MsgCode>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;not(exists($FindID_VULAFTTH.part1/tns1:Find[tns1:Asset/statoAsset='ATTIVO'])) and not(exists($FindID_VULAFTTH.part1/tns1:Find[tns1:Asset/statoAsset='INLAVORAZIONE']))&quot;>&#xa;                        &lt;tns:MsgCode>&#xa;                            &lt;xsl:value-of select=&quot;'***Presenti piu Asset tutti TLC Cessati con input Cessato'&quot;/>&#xa;                        &lt;/tns:MsgCode>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:MsgCode>&#xa;                            &lt;xsl:value-of select=&quot;'***Presenti piu Asset tutti TLC'&quot;/>&#xa;                        &lt;/tns:MsgCode>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
