                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogNameApplication&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;FindID_VULAFTTH&quot;/>&lt;xsl:param name=&quot;AssetWxx&quot;/>&lt;xsl:param name=&quot;FindID_VULA_WXX&quot;/>&lt;xsl:template name=&quot;LogScartoVULA-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LogNameApplication&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'ConsistenzaDBSS_Async'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'ConsistenzaDBSS_Async'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'ConsistenzaDBSS_Async'&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;$AssetWxx='True' and not(exists($FindID_VULA_WXX/part1/tns1:Output/tns1:Find[tns1:Asset/statoAsset='ATTIVO'])) and not(exists($FindID_VULA_WXX/part1/tns1:Output/tns1:Find[tns1:Asset/statoAsset='INLAVORAZIONE']))&quot;>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;'***Presenti piu Asset tutti TLC Cessati con input Cessato'&quot;/>&lt;/tns:MsgCode>&lt;/xsl:when>&lt;xsl:when test=&quot;not(exists($FindID_VULAFTTH/part1/tns1:Output/tns1:Find[tns1:Asset/statoAsset='ATTIVO'])) and not(exists($FindID_VULAFTTH/part1/tns1:Output/tns1:Find[tns1:Asset/statoAsset='INLAVORAZIONE']))&quot;>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;'***Presenti piu Asset tutti TLC Cessati con input Cessato'&quot;