l:value-of select="''"/&gt;&lt;/ns:ProcessName&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="34"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($JMSReceiveMessage/Body/tns3:Input/tns3:TRANSACTION_ID)&gt;0"&gt;&lt;ns:DBSSTransactionID&gt;&lt;xsl:value-of select="xsd:integer($JMSReceiveMessage/Body/tns3:Input/tns3:TRANSACTION_ID)"/&gt;&lt;/ns:DBSSTransactionID&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($JMSReceiveMessage/Body/tns3:Input/tns3:TRANSACTION_ID)=0"&gt;&lt;ns:Return_Code&gt;&lt;xsl:value-of select="'KO_ACK'"/&gt;&lt;/ns:Return_Code&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:Return_Code&gt;&lt;xsl:value-of select="'KO'"/&gt;&lt;/ns:Return_Code&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:Input&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
