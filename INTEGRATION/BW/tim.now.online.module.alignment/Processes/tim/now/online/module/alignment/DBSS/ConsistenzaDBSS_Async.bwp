                              &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/IDAsset&quot;>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/IDAsset&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;codiceOrdineOLO>&#xa;                                    &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/codiceOrdineOLO&quot;/>&#xa;                                &lt;/codiceOrdineOLO>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/codiceOrdineTI&quot;>&#xa;                                    &lt;codiceOrdineTI>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/codiceOrdineTI&quot;/>&#xa;                                    &lt;/codiceOrdineTI>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;codificaOLOAGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;                                &lt;/codificaOLOAGCOM>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find/tns:Asset/invariante&quot;>&#xa;                                    &lt;invariante>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/invariante&quot;/>&#xa;                                    &lt;/invariante>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find/tns:Asset/created&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#