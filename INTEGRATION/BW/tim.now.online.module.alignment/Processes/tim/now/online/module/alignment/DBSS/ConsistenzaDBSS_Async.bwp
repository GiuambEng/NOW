                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/tim.now.xsd.ValorizzazioneAttributoOfferta&quot; xmlns:tns3=&quot;http://www.example.org/CheckJMSBodyDBSS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FindID&quot;/>&lt;xsl:param name=&quot;AttributoOfferta&quot;/>&lt;xsl:param name=&quot;CodiceToponomastica&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;Distretto&quot;/>&lt;xsl:param name=&quot;ControlloAsset&quot;/>&lt;xsl:template name=&quot;UpdateAsset&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;xsl:choose>&lt;xsl:when test=&quot;$ControlloAsset='True'&quot;>&lt;tns:Update>&lt;tns:Input>&lt;tns:CaseReference>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:CaseReference&quot;/>&lt;/tns:CaseReference>&lt;tns:Asset>&lt;xsl:if test=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDAsset&quot;>&lt;IDAsset>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDAsset&quot;/>&lt;/IDAsset>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/codiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/codiceOrdineTI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/codiceOrdineTI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/invariante&quot;>&lt;invariante>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/invariante&quot;/>&lt;/invariante>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/operatore&quot;/>&lt;/operatore>&lt;xsl:if test=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDRichiestaOLO&quot;>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDPrimoOrdine&quot;>&lt;IDPrimoOrdine>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDPrimoOrdine&quot;/>&lt;/IDPrimoOrdine>&lt;/xsl:if>&lt;IDContratto>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/IDContratto&quot;/>&lt;/IDContratto>&lt;xsl:if test=&quot;$FindID/part1/tns:Output/tns:Find[tns:Asset/