                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a283155f-7217-4ba4-a2cf-fcfe778e4246+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CreateAsset&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;CODICEORDINEOLO>&lt;xsl:value-of select=&quot;concat('MIG-', $CreateAsset/part1/tns1:Output/tns1:Create/tns1:AssetNow)&quot;/>&lt;/CODICEORDINEOLO>&lt;BDS_ID>&lt;xsl:value-of select=&quot;xsd:int($CreateAsset/part1/tns1:Output/tns1:Create/tns1:AssetNow)&quot;/>&lt;/BDS_ID>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
